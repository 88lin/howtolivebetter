","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"В избранное"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Поделиться советом"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Скрыть подробности"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Затраты"]},{"tag":"p","props":{},"children":["Упаковка ибупрофена стоит чуть больше десяти юаней; принимать его нужно только в дни боли. Если требуется гинеколог, запись и УЗИ потребуют некоторой суммы и примерно половины дня."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Польза"]},{"tag":"p","props":{},"children":["Систематический обзор Cochrane объединил 80 рандомизированных контролируемых испытаний с участием 5820 женщин с первичной дисменореей. Первичная дисменорея — менструальная боль, при которой не выявлено другого заболевания. Нестероидные противовоспалительные препараты лучше облегчали боль, чем плацебо (OR 4.37, 95% ДИ 3.76–5.09, доверительный интервал). В абсолютных числах как минимум умеренное облегчение получили 18% принимавших плацебо и от 45% до 53% принимавших эти препараты. Цена — больше побочных эффектов (OR 1.29, 1.11–1.51). В группе плацебо они возникали у 10%, в группе этих препаратов — у 11–14%. Дополнительные реакции были в основном желудочно-кишечными (OR 1.58) и со стороны нервной системы (OR 2.74). Эти препараты также лучше облегчали боль, чем парацетамол (OR 1.89, 1.05–3.43), но сравнение основано лишь на 3 испытаниях. Различий, позволяющих выбрать лучший препарат этой группы, не выявлено. Британские рекомендации NICE (обновлены в 2024 году) перечисляют ситуации, когда следует заподозрить эндометриоз: хроническая тазовая боль, менструальная боль, влияющая на повседневную активность и качество жизни, глубокая боль во время или после полового акта. Также это болезненная дефекация во время менструации, кровь в моче или боль при мочеиспускании во время менструации, а также бесплодие в сочетании с этими симптомами. Девочки 17 лет и младше тоже включены. Рекомендации предлагают сначала попробовать парацетамол или такие препараты, например в течение 3 месяцев. Если обезболивания недостаточно, направить на дальнейшее обследование. Нормальные результаты гинекологического осмотра и УЗИ не исключают заболевание. Одно исследование опросило 1418 женщин, проходивших лапароскопию в 16 больницах 10 стран. От появления симптомов до хирургического подтверждения эндометриоза в среднем проходило 6.7 года; основная задержка приходилась на этап первичной медицинской помощи. Женщины с подтверждённым диагнозом в среднем теряли 10.8 рабочего часа в неделю, главным образом из-за снижения продуктивности при присутствии на работе. Нидерландский интернет-опрос охватил 32748 женщин от 15 до 45 лет. Из них 13.8% брали отгулы из-за менструации, в среднем 1.3 дня в год. Во время менструации 80.7% присутствовали на работе, но работали менее продуктивно; это соответствовало потере 8.9 рабочего дня в год."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Первоисточники"]},{"tag":"p","props":{"className":"life-citations"},"children":["Marjoribanks J, Ayeleke RO, Farquhar C, Proctor M (2015). Nonsteroidal anti-inflammatory drugs for dysmenorrhoea. Cochrane Database of Systematic Reviews, (7):CD001751. ",{"tag":"a","props":{"href":"https://doi.org/10.1002/14651858.CD001751.pub3","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1002/14651858.CD001751.pub3"]},"；National Institute for Health and Care Excellence (2017, updated 2024). Endometriosis: diagnosis and management (NG73), recommendations 1.3.1, 1.4.2, 1.4.3, 1.5.4. ",{"tag":"a","props":{"href":"https://www.nice.org.uk/guidance/ng73/chapter/Recommendations","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.nice.org.uk/guidance/ng73/chapter/Recommendations"]},"；Nnoaham KE, Hummelshoj L, Webster P, et al.; World Endometriosis Research Foundation Global Study of Women's Health consortium (2011). Impact of endometriosis on quality of life and work productivity: a multicenter study across ten countries. Fertility and Sterility, 96(2):366-373.e8. ",{"tag":"a","props":{"href":"https://doi.org/10.1016/j.fertnstert.2011.05.090","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1016/j.fertnstert.2011.05.090"]},"；Schoep ME, Adang EMM, Maas JWM, De Bie B, Aarts JWM, Nieboer TE (2019). Productivity loss due to menstruation-related symptoms: a nationwide cross-sectional survey among 32 748 women. BMJ Open, 9(6):e026186. ",{"tag":"a","props":{"href":"https://doi.org/10.1136/bmjopen-2018-026186","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1136/bmjopen-2018-026186"]},"；Haleon (2026). Advil (ibuprofen capsule, liquid filled), OTC drug label: Warnings. DailyMed. ",{"tag":"a","props":{"href":"https://dailymed.nlm.nih.gov/dailymed/drugInfo.cfm?setid=1f01c10a-9434-91a4-2ee4-352315a6b610","target":"_blank","rel":"noopener noreferrer"},"children":["https://dailymed.nlm.nih.gov/dailymed/drugInfo.cfm?setid=1f01c10a-9434-91a4-2ee4-352315a6b610"]}]},{"tag":"a","props":{"href":"https://doi.org/10.1002/14651858.CD001751.pub3","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Открыть источник"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Примечание автора"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["Если вам больше 60 лет, было желудочное кровотечение или вы принимаете антикоагулянты либо стероиды, перед применением этих препаратов спросите врача. Подробнее см. пункт 3 раздела 34 (обезболивающие вроде ибупрофена). Американская инструкция к ибупрофену указывает, что он может вызвать тяжёлую аллергическую реакцию, более вероятную у людей с аллергией на аспирин; среди проявлений — приступы астмы. При астме тоже нужно сначала спросить врача. Если возможна беременность, сначала посоветуйтесь с врачом; после 20 недель беременности не принимайте препарат самостоятельно, см. пункт 5 раздела 34 (после 20 недель беременности). Если эти препараты принимать нельзя, можно использовать парацетамол; суточный предел см. в пункте 1 раздела 34 (парацетамол). При менструальной боли лекарства принимают только в дни менструации. Порог из пункта 9 раздела 34 (не принимать обезболивающие больше 15 дней в месяц) относится к головной боли; число дней приёма при менструальной боли намного ниже. Уровень A присвоен потому, что обезболивающий эффект подтверждён множеством рандомизированных испытаний. Авторы оценили качество доказательств большинства сравнений как низкое, главным образом из-за неясного описания методов; 59% испытаний финансировали фармацевтические компании. Оценка пользы как «средней» — суждение: обзор измерял боль, а не уменьшение числа отгулов. В нидерландском опросе потери из-за менструации соответствовали примерно 10 дням в год, то есть часам в неделю при пересчёте. Участницы исследования эндометриоза уже были направлены на лапароскопию; это не означает, что у большинства людей с менструальной болью есть это заболевание. Основную пользу получаете вы сами."]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Моя заметка"]},{"tag":"button","props":{"type":"button"},"children":["Запишите напоминание…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/ru/tip/03-24"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Предыдущий"]},"Можно несколько дней подряд записывать свои мысли и чувства, если на сердце лежит какая-то забота, но не стоит рассчитывать, что это вылечит болезнь"]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["Другие советы по этой теме"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/03-18"},"children":[{"tag":"strong","props":{},"children":["Что сделать при подавленном настроении: подвигаться, позагорать, соблюдать режим сна, поговорить с кем-то, позвонить на 12356"]},{"tag":"span","props":{},"children":["согласно метаанализу, объединившему 218 рандомизированных исследовани…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/03-19"},"children":[{"tag":"strong","props":{},"children":["Воспринимайте полицейских, врачей и кассиров как людей, выполняющих свои должностные обязанности по правилам, а не как персонажей: движущей силой решения вопросов являются документы и сроки, а не эмоции"]},{"tag":"span","props":{},"children":["Дети думают так: «Полицейские ловят плохих людей, а врачи лечат». Взр…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/03-20"},"children":[{"tag":"strong","props":{},"children":["Не делайте «как живут другие» своим ежедневным чтением: ограничьте время пользования приложениями или отключите их вовсе"]},{"tag":"span","props":{},"children":["Люди, которые привыкли сравнивать себя с другими в интернете, чаще ис…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/03-21"},"children":[{"tag":"strong","props":{},"children":["Когда кажется, что «все видели, как я опозорился», разделите свою оценку пополам"]},{"tag":"span","props":{},"children":["Представьте, что человек надевает неловкую футболку и заходит в комна…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/03-22"},"children":[{"tag":"strong","props":{},"children":["Воспринимайте мысль «окружающие требуют от меня совершенства» как симптом, а не как факт"]},{"tag":"span","props":{},"children":["Связь между чувством «окружающие требуют от меня совершенства, иначе …"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/03-23"},"children":[{"tag":"strong","props":{},"children":["В гневе не стоит вымещать эмоции, разбивая вещи, бью по боксерской груше или пробегаясь — сначала нужно успокоить тело"]},{"tag":"span","props":{},"children":["Способы вымещения гнева, которые дополнительно возбуждают организм — …"]}]}]}]},{"tag":"a","props":{"className":"life-text-link","href":"/ru/book/03"},"children":["Читать всю тему: Не тратьте силы впустую"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"15","height":"15","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]}]}]},{"tag":"nav","props":{"className":"life-tabbar","aria-label":"Основная навигация"},"children":[{"tag":"a","props":{"className":"","href":"/ru/book"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"21","height":"21","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","stro