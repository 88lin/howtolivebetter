0 0-12 0"},"children":[]},{"tag":"circle","props":{"cx":"12","cy":"10","r":"4"},"children":[]},{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},{"tag":"span","props":{},"children":["Sign in to sync"]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/en/book/03"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"Back to index"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["Don’t waste your energy"]},{"tag":"nav","props":{"aria-label":"Chapter entries"},"children":[{"tag":"a","props":{"href":"/en/tip/03-01"},"children":[{"tag":"span","props":{},"children":["01"]},"Turn off non‑essential notifications and keep your phone out of sight while working"]},{"tag":"a","props":{"href":"/en/tip/03-02"},"children":[{"tag":"span","props":{},"children":["02"]},"Keep a fixed wake-up time, even on weekends"]},{"tag":"a","props":{"href":"/en/tip/03-03"},"children":[{"tag":"span","props":{},"children":["03"]},"Getting 7 to 8 hours of sleep each night — don’t settle for just 6 hours"]},{"tag":"a","props":{"href":"/en/tip/03-04"},"children":[{"tag":"span","props":{},"children":["04"]},"Avoid caffeine after 2 p.m"]},{"tag":"a","props":{"href":"/en/tip/03-05"},"children":[{"tag":"span","props":{},"children":["05"]},"Batch-process emails and messages a few times per day"]},{"tag":"a","props":{"href":"/en/tip/03-06"},"children":[{"tag":"span","props":{},"children":["06"]},"When doing tasks that require continuous thinking, keep out even brief interruptions"]},{"tag":"a","props":{"href":"/en/tip/03-07"},"children":[{"tag":"span","props":{},"children":["07"]},"Do one thing at a time — don’t reply to messages while in a meeting"]},{"tag":"a","props":{"href":"/en/tip/03-08"},"children":[{"tag":"span","props":{},"children":["08"]},"Avoid glowing screens one hour before bed; if you must, read paper books or e-ink devices instead"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/en/tip/03-09","data-status":"active"},"children":[{"tag":"span","props":{},"children":["09"]},"Go to bed at a set time — avoid staying up late for games, short videos, or porn"]},{"tag":"a","props":{"href":"/en/tip/03-10"},"children":[{"tag":"span","props":{},"children":["10"]},"Don’t make major decisions or send important messages late at night"]},{"tag":"a","props":{"href":"/en/tip/03-11"},"children":[{"tag":"span","props":{},"children":["11"]},"Take a 10‑minute nap in the afternoon — don’t sleep half an hour"]},{"tag":"a","props":{"href":"/en/tip/03-12"},"children":[{"tag":"span","props":{},"children":["12"]},"Using earplugs or finding a quiet room for memory-heavy tasks in open offices"]},{"tag":"a","props":{"href":"/en/tip/03-13"},"children":[{"tag":"span","props":{},"children":["13"]},"Do not keep adding weekly work hours: beyond roughly 49 hours, each extra hour produces less additional output"]},{"tag":"a","props":{"href":"/en/tip/03-14"},"children":[{"tag":"span","props":{},"children":["14"]},"When you notice yourself endlessly replaying a distressing memory, do something hands‑on instead"]},{"tag":"a","props":{"href":"/en/tip/03-15"},"children":[{"tag":"span","props":{},"children":["15"]},"Treat thoughts like “things will definitely get worse” as symptoms, not as facts"]},{"tag":"a","props":{"href":"/en/tip/03-16"},"children":[{"tag":"span","props":{},"children":["16"]},"Cut back on draining relationships and learn to say no to unwanted requests"]},{"tag":"a","props":{"href":"/en/tip/03-17"},"children":[{"tag":"span","props":{},"children":["17"]},"Walk away when angry; treat the other person as weather, not an enemy"]},{"tag":"a","props":{"href":"/en/tip/03-18"},"children":[{"tag":"span","props":{},"children":["18"]},"Best low-cost actions when you’re feeling down: move, get sunlight, stick to a schedule, talk to someone, call 12356"]},{"tag":"a","props":{"href":"/en/tip/03-19"},"children":[{"tag":"span","props":{},"children":["19"]},"Treat police officers, doctors, and bank tellers as rule‑following workers, not as archetypes: paperwork and deadlines — not emotions — drive results"]},{"tag":"a","props":{"href":"/en/tip/03-20"},"children":[{"tag":"span","props":{},"children":["20"]},"Don’t make “how others are doing” a daily habit: set limits on apps that show peers’ updates or turn them off"]},{"tag":"a","props":{"href":"/en/tip/03-21"},"children":[{"tag":"span","props":{},"children":["21"]},"When you feel like “everyone saw me make a fool of myself,” cut that estimate in half"]},{"tag":"a","props":{"href":"/en/tip/03-22"},"children":[{"tag":"span","props":{},"children":["22"]},"Treat “others expect me to be perfect” as a symptom, not a fact"]},{"tag":"a","props":{"href":"/en/tip/03-23"},"children":[{"tag":"span","props":{},"children":["23"]},"When angry, don’t try to vent by smashing things, punching a bag, or going for a run — first calm your body down"]},{"tag":"a","props":{"href":"/en/tip/03-24"},"children":[{"tag":"span","props":{},"children":["24"]},"Writing down thoughts and feelings about a troubling issue over several days can be helpful, but don’t expect it to cure anything"]},{"tag":"a","props":{"href":"/en/tip/03-25"},"children":[{"tag":"span","props":{},"children":["25"]},"Use painkillers such as ibuprofen for period pain instead of just enduring it; if pain disrupts work or school or remains uncontrolled after three months of medication, see a gynecologist"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"Breadcrumb"},"children":[{"tag":"a","props":{"href":"/en/book"},"children":["Explore the book"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/en/book/03"},"children":["Chapter 3"," ·"," ","Don’t waste your energy"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"03-09"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["09"]},{"tag":"span","props":{"className":"life-evidence grade-b"},"children":["Evidence"," ","B"]}]},{"tag":"h1","props":{"lang":"en"},"children":["Go to bed at a set time — avoid staying up late for games, short videos, or porn"]},{"tag":"p","props":{"lang":"en","className":"life-entry-summary"},"children":["In 2025, Chinese people slept an average of 6.97 hours per night, with an average bedtime of 12:10 a.m. Those who used phones or tablets before bed were more than twice as likely to get insufficient sleep and 2.7 times more likely to feel drowsy during the day. Even simply having such devices in the bedroom — without using them — produced similar results. Thus, keeping phones out of the bedroom is the simplest way to improve sleep."]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Cost"]},{"tag":"p","props":{},"children":["No monetary cost. The real challenge is overcoming the hab…"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Benefit"]},{"tag":"p","props":{},"children":["In 2025, Chinese residents averaged 6.97 hours of nighttime sleep, with an average bedtime of 12:10 a.m. (Chin…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"Mark: Go to bed at a set time — avoid staying up late for games, short videos, or porn"},"children"