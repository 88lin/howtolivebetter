ops":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"加入待做"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"收藏"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"分享这条建议"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"收起详情"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["成本"]},{"tag":"p","props":{},"children":["不花钱。只是先知道这件事。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["收益"]},{"tag":"p","props":{},"children":["一篇百草枯中毒的系统综述：病死率极高，原因是它本身毒性强，又缺乏有效治疗。它被逆着浓度差主动搬进肺组织，学名叫逆浓度梯度主动摄取，结果是肺炎和肺纤维化，同时还造成肾损伤和肝损伤。综述写明：不应进行洗胃。血液透析和血液灌流不大可能改变临床病程。激素与免疫抑制剂的疗效证据很弱。综述还写了一句：「所有中心的病死率都很高，尽管治疗差异很大」。孟加拉 10 家三级医院 2013 至 2024 年收了 1420 例，其中可分析的 257 例：病死率 43.2%。常见表现是急性肾衰引起的下肢肿胀 71.2%、呕吐 65.8%、腹痛 58.0%。急性一氧化碳中毒的试验是双盲随机分组，两组各 76 人。医生和病人都不知道进的是哪一组。六周时留下认知后遗症的，高压氧组 19/76（25.0%）。常压氧组 35/76（46.1%），P=0.007。把其他因素校正之后 OR 0.45（95% CI 0.22 至 0.92，括号里是这个数的可信范围）。另一项研究连续观察了 73 例：30% 有认知后遗症，12% 出现脑白质高信号。中国自 2014 年 7 月 1 日起撤销百草枯水剂的登记和生产许可，并停止生产。2016 年 7 月 1 日起，水剂在国内停止销售和使用。2020 年 9 月 26 日起，禁止可溶胶剂在境内销售、使用。文件写明，「致使服用百草枯自杀事件时有发生」是加强监管的直接原因"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["原始出处"]},{"tag":"p","props":{"className":"life-citations"},"children":["Gawarammana IB, Buckley NA (2011). Medical management of paraquat ingestion. British Journal of Clinical Pharmacology, 72(5), 745-757. ",{"tag":"a","props":{"href":"https://doi.org/10.1111/j.1365-2125.2011.04026.x","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1111/j.1365-2125.2011.04026.x"]},"；Chowdhury FR 等 (2026). Clinical and Laboratory Profile of Paraquat Poisoning: A Toxicological Crisis in Bangladesh. American Journal of Tropical Medicine and Hygiene, 115, 176-182. ",{"tag":"a","props":{"href":"https://doi.org/10.4269/ajtmh.25-0719","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.4269/ajtmh.25-0719"]},"；Weaver LK, Hopkins RO, Chan KJ, et al. (2002). Hyperbaric oxygen for acute carbon monoxide poisoning. New England Journal of Medicine, 347(14), 1057-1067. ",{"tag":"a","props":{"href":"https://doi.org/10.1056/NEJMoa013121","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1056/NEJMoa013121"]},"；Parkinson RB, Hopkins RO, Cleavinger HB, et al. (2002). White matter hyperintensities and neuropsychological outcome following carbon monoxide poisoning. Neurology, 58(10), 1525-1532. ",{"tag":"a","props":{"href":"https://doi.org/10.1212/wnl.58.10.1525","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1212/wnl.58.10.1525"]},"；农业农村部办公厅 (2018). 关于切实加强百草枯监督管理的通知（农办农〔2018〕17 号）. ",{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/2018-12/31/content_5442594.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/zhengce/zhengceku/2018-12/31/content_5442594.htm"]}]},{"tag":"a","props":{"href":"https://doi.org/10.1111/j.1365-2125.2011.04026.x","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["打开来源链接"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["原书备注"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["给 B 的原因：这几项研究的对象是中毒病人，不是单一的自杀未遂人群，一氧化碳那项试验里还含意外中毒的人。所以上面的后遗症比例，不能直接当成「自杀未遂者的后果概率」。能确定的是，没有哪一种方式能不留后遗症。一氧化碳的现场处置见第 13 节第 19 条。误服农药和药物先别催吐、带上瓶子就医，见第 13 节第 20 条。家里不囤农药和安眠药见本节第 25 条。本书不比较不同方式的致死率，也不写任何具体做法"]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["我的备注"]},{"tag":"button","props":{"type":"button"},"children":["写下对自己有用的提醒…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/tip/01-32"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["上一条"]},"自杀念头一冒出来先告诉身边的一个人，把这几十分钟交出去"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/tip/01-34"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["下一条"]},"别拿「躺几天就好」赌高处坠落：进了创伤 ICU 的人多数活下来，代价按年算"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["本主题的其他建议"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/01-29"},"children":[{"tag":"strong","props":{},"children":["减重、戒烟、把血压血糖控住，勃起功能能跟着好转"]},{"tag":"span","props":{},"children":["把心血管的危险因素管起来，勃起功能本身会好转。用一份问卷打分，平均能多 2 到 3 分。这份问卷总分 25 分，22 分以上算正常。"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/01-30"},"children":[{"tag":"strong","props":{},"children":["性行为全程用安全套，不和别人共用针具"]},{"tag":"span","props":{},"children":["每一次都全程戴，异性之间传染艾滋病的概率大约降七成以上。「大部分时候戴」的效果，和不戴差不了多少。梅毒、淋病这些也一并挡住。"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/01-31"},"children":[{"tag":"strong","props":{},"children":["有过高危行为就去查一次艾滋病，疾控中心免费、结果保密"]},{"tag":"span","props":{},"children":["去疾控查艾滋病不花钱。没有你本人同意，任何单位和个人都不得公开你的姓名、住址、工作单位和病史。查出来也不是判死刑：坚持吃药把病毒压到测不出…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/01-35"},"children":[{"tag":"strong","props":{},"children":["别拿「少一个肾没什么」换钱：剩下那个要替两个干活，卖过肾的人事后 86% 说身体变差"]},{"tag":"span","props":{},"children":["捐肾前层层筛查、捐后有人复查的正规捐献者，15 年后走到尿毒症的是每万人 31 人，同样健康但没捐的人是每万人 4 人。卖肾的人没有筛查也…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/01-36"},"children":[{"tag":"strong","props":{},"children":["不捡、不拆、不卖来路不明的金属件，带三叶草警示标志的离远点"]},{"tag":"span","props":{},"children":["辐射没有气味、颜色和温度，多数放射源就是一截普通金属，所以「看着没事」不能当判断。普通人撞上的概率极低，每年每万枚放射源出事不到 1 起。…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/01-37"},"children":[{"tag":"strong","props":{},"children":["赌到借钱还赌、心情一直低落时，先打 12356，再把银行卡