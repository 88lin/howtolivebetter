"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"分享这条建议"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"收起详情"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["成本"]},{"tag":"p","props":{"className":"life-citations"},"children":["先陪老人去眼科查一次，由医生判断该不该做。一只眼做一次手术，很多医院按日间手术做，当天就能回家。两只眼都有白内障的，要分两次做。自己掏多少钱，看换进眼里的人工晶体（人造镜片）选哪种、当地医保怎么报，术前问清楚。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["收益"]},{"tag":"p","props":{"className":"life-citations"},"children":["一项随机试验找了 306 名 70 岁以上、有白内障的女性。一半在约 4 周内做第一只眼的手术，另一半按常规等 12 个月。一年里，尽快做手术的人跌倒次数少约 34%。原值是跌倒率之比 0.66，可信范围 95% CI 0.45 到 0.96。跌过至少一次的人，手术组 49%，等待组 45%，没有少。跌过两次以上的人，手术组 18%，等待组 25%。手术组 4 人骨折（3%），等待组 12 人（8%）。Cochrane 综述收了这项试验，结论是女性第一只眼的手术减少了跌倒次数，第二只眼的手术没有。第二只眼的随机试验找了 239 名 70 岁以上的女性。手术组跌倒率低 32%，但差别可能是碰巧（跌倒率之比 0.68，95% CI 0.39 到 1.19）。美国医保 5% 抽样里，有 1113640 名 65 岁以上的白内障病人（2002 到 2009 年）。这项研究只是跟踪记录，没有分组对照。做了手术的人，一年内髋部骨折的几率低约 16%（OR 0.84，95% CI 0.81 到 0.87）。绝对差是 0.20 个百分点，约每 1000 人少 2 例"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["来源"]},{"tag":"p","props":{"className":"life-citations"},"children":["Harwood RH, Foss AJ, Osborn F, Gregson RM, Zaman A, Masud T (2005). Falls and health status in elderly women following first eye cataract surgery: a randomised controlled trial. British Journal of Ophthalmology, 89(1), 53-59. ",{"tag":"a","props":{"href":"https://doi.org/10.1136/bjo.2004.049478","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1136/bjo.2004.049478"]}," ; Foss AJ, Harwood RH, Osborn F, Gregson RM, Zaman A, Masud T (2006). Falls and health status in elderly women following second eye cataract surgery: a randomised controlled trial. Age and Ageing, 35(1), 66-71. ",{"tag":"a","props":{"href":"https://doi.org/10.1093/ageing/afj005","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1093/ageing/afj005"]}," ; Gillespie LD, Robertson MC, Gillespie WJ, et al. (2012). Interventions for preventing falls in older people living in the community. Cochrane Database of Systematic Reviews, 9, CD007146. ",{"tag":"a","props":{"href":"https://doi.org/10.1002/14651858.CD007146.pub3","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1002/14651858.CD007146.pub3"]}," ; Tseng VL, Yu F, Lum F, Coleman AL (2012). Risk of fractures following cataract surgery in Medicare beneficiaries. JAMA, 308(5), 493-501. ",{"tag":"a","props":{"href":"https://doi.org/10.1001/jama.2012.9014","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1001/jama.2012.9014"]}," ; Desapriya E, Subzwari S, Scime-Beltrano G, et al. (2010). Vision improvement and reduction in falls after expedited cataract surgery: systematic review and metaanalysis. Journal of Cataract and Refractive Surgery, 36(1), 13-19. ",{"tag":"a","props":{"href":"https://doi.org/10.1016/j.jcrs.2009.07.032","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1016/j.jcrs.2009.07.032"]}," ; Meuleners LB, Lee AH, Ng JQ, Morlet N, Fraser ML (2012). First eye cataract surgery and hospitalization from injuries due to a fall: a population-based study. Journal of the American Geriatrics Society, 60(9), 1730-1733. ",{"tag":"a","props":{"href":"https://doi.org/10.1111/j.1532-5415.2012.04098.x","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1111/j.1532-5415.2012.04098.x"]}," ; Meuleners LB, Fraser ML, Ng J, Morlet N (2014). The impact of first- and second-eye cataract surgery on injurious falls that require hospitalisation: a whole-population study. Age and Ageing, 43(3), 341-346. ",{"tag":"a","props":{"href":"https://doi.org/10.1093/ageing/aft177","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1093/ageing/aft177"]}," ; Keay L, Ho KC, Rogers K, et al. (2022). The incidence of falls after first and second eye cataract surgery: a longitudinal cohort study. Medical Journal of Australia, 217(2), 94-99. ",{"tag":"a","props":{"href":"https://doi.org/10.5694/mja2.51611","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.5694/mja2.51611"]}," ; 国家卫生健康委 (2022). 「十四五」全国眼健康规划（2021-2025年）. ",{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/2022-01/17/content_5668951.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/zhengce/zhengceku/2022-01/17/content_5668951.htm"]},""]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["原书备注"]},{"tag":"p","props":{"className":"life-citations"},"children":["争议：两项随机试验合起来算，摔过跤的人数没有明显减少（OR 0.81，95% CI 0.55 到 1.17）。澳大利亚西部的全人群住院记录里，做完第一只眼后的一年，因跌倒受伤住院的反而多了 27%。两次手术之间那段，这类住院是术前的 2.14 倍。这类前后对比分不开手术的影响和人变老的影响。另一项澳大利亚的跟踪研究里，做完第二只眼以后，跌倒次数降得最多。所以两只眼都有白内障的，第二只别拖太久。两次手术之间那段，走路和上下楼要格外小心。Cochrane 还收了一项帮老人处理视力问题的试验，跌倒次数反而多了约五成七。手术管的是看不看得清，少摔跤还要靠第 1 节第 13 条（平衡和腿部力量）。骨头经不经得起摔，见第 1 节第 39 条（骨密度检查）和第 1 节第 40 条（查出骨质疏松就用药）。国家眼健康规划写明，白内障复明手术已在县域普遍开展，不一定要去大城市的医院。受益人主要是你的父母和祖父母。"]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["我的备注"]},{"tag":"button","props":{"type":"button"},"children":["写下对自己有用的提醒…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/tip/17-08"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["上一条"]},"家里有人长期卧床，把压疮当头号敌人：上电动气垫床、定时翻身、每天看一遍骨头突出的地方"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/tip/17-10"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["下一条"]},"家里老人遛狗，把牵绳握在手心、别缠在手上，绳子收短，狗先训练到牵着不往前猛冲"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["本主题的其他建议"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/17-02"},"children":[{"tag":"strong","props":{},"children":["把遗嘱立了，记住后立的推翻先立的，公证遗嘱不再优先"]},{"tag":"span","props":{},"children":["法律认六种遗嘱，但形式写错了整份作废，这是最常见的翻车点。自己手写的那种，要本人从头到尾手写，签上名，写清年月日。立了好几份、内容互相打架的，按最后立的那份算。…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/17-03"},"children":[{"tag":"strong","props":{},"children":["老人的钱单独放一个账户，大额支出定一个双人确认的规矩"]},{"tag":"span","props":{},"children":["骗老人的人常先送小礼物、嘘寒问暖，把信任攒足，再一次骗走大钱。骗子还常叮嘱「不要告诉任何人」。事先约好一条规矩：超过多少钱的支出，要先跟某个人说一声。这样家里人…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/17-04"},"children":[{"tag":"strong","props":{},"children":["给老人备好一句随时能说出口的推辞：「我要回去和家里人商量」"]},{"tag":"span","props":{},"children":["推销和诈骗靠的是现场压力，要你来不及想就掏钱。人一激动，就更容易信夸大的广告，老人比年轻人更容易被说动。事先和老人商量好一句「我要回去和家里人商量」。他随时能说…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/17-05"},"children":[{"tag":"strong","props":{},"children":["凡是让老人先交钱的「投资养老」都别碰：办卡、买床位、买养老公寓、旅居养老、买老年产品是同一套非法集资"]},{"tag":"span","props":{},"children":["让老人先交钱、又许诺回报的养老名目，都是同一套骗局：办卡、买床位、买养老公寓、旅居养老、开会卖老年产品。按规定，这种钱亏了只能自己认。有人借预定养老公寓床位收走…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/17-06"},"children":[{"tag":"strong","props":{},"children":["除了保险公司的住房反向抵押养老保险，其他「以房养老」都别碰，绝不抵押房子去买理财"]},{"tag":"span","props":{},"children":["正规的以房养老只有一种，就是保险公司的住房反向抵押养老保险，还在试点。上门推销的那种和它毫无关系，是骗老人抵押房子，再拿借来的钱买它推荐的理财。有人连房子被抵押…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/17-07"},"children":[{"tag":"strong","props":{},"children":["家里老人长期卧床或重度失能，去参保地医保部门申请长期护理保险；它不是只发给老人"]},{"tag":"span","props":{},"children":["长期护理保险帮你出请人照护的钱。家里有人重度失能、持续半年以上，就去参保地医保部门申请。护理费不用先自己垫，职工参保的报七成左右，城乡居民参保的报五成左右，床位…"]}]}]}]},{"tag":"a","props":{"className":"life-text-link","href":"/book/17"},"children":["阅读整个主题：家里有老人 ",{"tag":"svg","pro