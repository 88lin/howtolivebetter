pan","props":{},"children":["05"]},"Tìm việc thì dùng dịch vụ việc làm công cộng miễn phí và thị trường việc lẻ trước, đừng qua môi giới thu phí"]},{"tag":"a","props":{"href":"/vi/tip/07-06"},"children":[{"tag":"span","props":{},"children":["06"]},"Gặp biến cố đột ngột thì xin trợ cấp tạm thời trước"]},{"tag":"a","props":{"href":"/vi/tip/07-07"},"children":[{"tag":"span","props":{},"children":["07"]},"Thu nhập thấp hơn mức trợ cấp người có thu nhập thấp ở địa phương thì xin trợ cấp người có thu nhập thấp"]},{"tag":"a","props":{"href":"/vi/tip/07-08"},"children":[{"tag":"span","props":{},"children":["08"]},"Người có giấy chứng nhận người khuyết tật thì đi xin hai khoản trợ cấp cho người khuyết tật"]},{"tag":"a","props":{"href":"/vi/tip/07-09"},"children":[{"tag":"span","props":{},"children":["09"]},"Đừng để bảo hiểm y tế cư dân bị đứt quãng mỗi năm 400 tệ, hộ khó khăn được miễn giảm"]},{"tag":"a","props":{"href":"/vi/tip/07-10"},"children":[{"tag":"span","props":{},"children":["10"]},"Mắc bệnh nặng thì đi theo bảo hiểm y tế, bảo hiểm bệnh nan y, trợ cấp y tế và đăng ký khám ngoài tỉnh trước, đừng đụng vào vay tiền trên mạng"]},{"tag":"a","props":{"href":"/vi/tip/07-11"},"children":[{"tag":"span","props":{},"children":["11"]},"Mất thẻ căn cước thì đi làm lại ngay, gấp thì xin thẻ tạm trước"]},{"tag":"a","props":{"href":"/vi/tip/07-12"},"children":[{"tag":"span","props":{},"children":["12"]},"Làm xong đăng ký thất nghiệp thì hãy xin công nhận là người khó khăn việc làm, để nhận trợ cấp bảo hiểm xã hội hoặc làm công việc công ích"]},{"tag":"a","props":{"href":"/vi/tip/07-13"},"children":[{"tag":"span","props":{},"children":["13"]},"Trong thời gian thất nghiệp thì đi nhận trợ cấp đào tạo nghề, trợ cấp thực tập việc làm và trợ cấp bảo hiểm xã hội, đừng tự bỏ tiền học khóa"]},{"tag":"a","props":{"href":"/vi/tip/07-14"},"children":[{"tag":"span","props":{},"children":["14"]},"Tìm việc đừng chỉ nộp hồ sơ, hãy dùng cách có hệ thống: học kỹ thuật, đặt mục tiêu, nhờ người khác giúp"]},{"tag":"a","props":{"href":"/vi/tip/07-15"},"children":[{"tag":"span","props":{},"children":["15"]},"Không nộp tiền cọc, không giữ giấy tờ, không ký「培训贷」, không vào đa cấp, không vay lãi cao"]},{"tag":"a","props":{"href":"/vi/tip/07-16"},"children":[{"tag":"span","props":{},"children":["16"]},"Khó ở nhà thì xếp hàng chờ nhà ở công lập trước"]},{"tag":"a","props":{"href":"/vi/tip/07-17"},"children":[{"tag":"span","props":{},"children":["17"]},"Ép chi phí ở và ăn xuống mức thấp nhất: thuê chung theo tháng thay vì thuê theo ngày, tự nấu ăn và bếp ăn trợ giúp thay cho đồ ăn giao"]},{"tag":"a","props":{"href":"/vi/tip/07-18"},"children":[{"tag":"span","props":{},"children":["18"]},"Bảo hiểm xã hội đứt quãng thì đừng hoảng: lương hưu tính theo số năm tích luỹ, bảo hiểm y tế nộp bù theo quy định"]},{"tag":"a","props":{"href":"/vi/tip/07-19"},"children":[{"tag":"span","props":{},"children":["19"]},"Từng vào tù, từng phá sản, từng bị đưa vào danh sách không thi hành án, pháp luật vẫn còn đường bắt đầu lại, trước hết làm hết thủ tục"]},{"tag":"a","props":{"href":"/vi/tip/07-20"},"children":[{"tag":"span","props":{},"children":["20"]},"Trước khi mắc bệnh nặng, ngoài bảo hiểm y tế cơ bản thì mua một bảo hiểm y tế hoặc bảo hiểm bệnh hiểm nặng hạn một năm, và đọc kỹ bốn chữ「保证续保」"]},{"tag":"a","props":{"href":"/vi/tip/07-21"},"children":[{"tag":"span","props":{},"children":["21"]},"Thật sự không có chỗ ngủ, nơi mở cửa 24 giờ chỉ cứu vãn được một đêm, ưu tiên đến trạm cứu hộ"]},{"tag":"a","props":{"href":"/vi/tip/07-22"},"children":[{"tag":"span","props":{},"children":["22"]},"Bị nợ lương công nhân, trước hết phân biệt ai là người thuê bạn"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"Breadcrumbs"},"children":[{"tag":"a","props":{"href":"/vi/book"},"children":["Khám phá cuốn sách"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/vi/book/07"},"children":["Chương 7"," ·"," ","Sống thế nào khi hết tiền"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"07-04"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["04"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["Bằng chứng"," ","A"]}]},{"tag":"h1","props":{"lang":"vi"},"children":["Không còn đường lui thì đến trạm cứu hộ, ở ăn ở và có vé về quê"]},{"tag":"p","props":{"lang":"vi","className":"life-entry-summary"},"children":["Trạm cứu hộ lo ăn, lo ở, bị bệnh thì đưa đi bệnh viện, còn giúp liên hệ người nhà. Không có tiền về nhà thì cấp vé. Thường ở không quá 10 ngày. Đến tự nguyện, đi tự nguyện, không phải trại tạm giam, cũng không phát tiền mặt. Vé cấp theo nơi đăng ký hộ khẩu hoặc nơi cư trú, trước khi đi hãy nghĩ kỹ mình về đâu."]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Chi phí"]},{"tag":"p","props":{},"children":["Không tốn tiền. Tự đến trạm quản lý cứu hộ địa phương xin…"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Lợi ích"]},{"tag":"p","props":{},"children":["Trạm cứu hộ cung cấp thức ăn và chỗ ở đáp ứng yêu cầu vệ sinh. Ở trong trạm mà phát bệnh thì đưa đi bệnh viện…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"Đánh dấu: Không còn đường lui thì đến trạm cứu hộ, ở ăn ở và có vé về quê"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"Hoàn tất"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"Kế hoạch thực hiện"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"Lưu"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Chia sẻ mẹo này"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Ẩn chi tiết"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Chi phí"]},{"tag":"p","props":{},"children":["Không tốn tiền. Tự đến trạm quản lý cứu hộ địa phương xin giúp, cũng có thể nói với công an hoặc bộ phận dân vụ để họ đưa bạn đi. Khi vào phải khai trung thực họ tên và đồ đạc mang theo. Khó ở chỗ phải nói với người khác rằng mình không có tiền, không có chỗ đi."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Lợi ích"]},{"tag":"p","props":{},"children":["Trạm cứu hộ cung cấp thức ăn và chỗ ở đáp ứng yêu cầu vệ sinh. Ở trong trạm mà phát bệnh thì đưa đi bệnh viện chữa. Trạm còn giúp liên hệ với người thân và cơ quan. Không có tiền mua vé về nơi đăng ký hộ khẩu hoặc nơi cư trú thì cấp chứng từ đi xe (đi tàu), tức là vé tàu xe. Nơi đăng ký hộ khẩu là quê, nơi cư trú là chỗ đang ở. Thời hạn cứu hộ thường không quá 10 ngày. Chờ người nhà đón, chờ điều trị, chờ sắp xếp thì có thể kéo dài. Công an và nhân viên cơ quan hành chính khác khi thực hiện công vụ mà gặp người lang thang xin ăn thì phải báo cho người đó biết có thể đi xin giúp. Với người khuyết tật, chưa thành niên, người cao tuổi và người khó di chuyển, phải hướng dẫn và đưa đi (toàn quốc, từ năm 2003)"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Nguồn gốc"]},{"tag":"p","props":{"className":"life-citations"},"children":["国务院 (2003). 城市生活无着的流浪乞讨人员救助管理办法（国务院令第 381 号，第五、六、七条）. ",{"tag":"a","props":{"href":"https://www.gov.cn/gongbao/content/2003/content_62246.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/gongbao/content/2003/content_62246.htm"]},"；民政部 (2003). 城市生活无着的流浪乞讨人员救助管理办法实施细则（民政部令第 24 号，第十一、十二条）. ",{"tag":"a","props":{"href":"https://www.gov.cn/gongbao/content/2003/content_62510.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/gongbao/content/2003/content_62510.htm"]}]},{"tag":"a","props":{"href":"https://www.gov.cn/gongbao/content/2003/content_62246.htm","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Liên kết mở nguồn"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Ghi chú sách"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["Tự nguyện xin giúp đỡ và tự nguyện rời trạm, không phải bị thu gom giữ lại. Trạm cung cấp ăn ở cơ bản, không phát tiền mặt. Giấy đi xe được cấp theo nơi đăng ký hộ khẩu hoặc nơi ở; trước khi xin hãy nghĩ rõ mình muốn đi đâu. Hỗ trợ ban đêm và mùa đông xem điều 21 (thật sự không có chỗ ngủ)."]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Ghi chú của tôi"]},{"tag":"button","props":{"type":"button"},"children":["Viết một lời nhắc cho chính bạn…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/vi/tip/07-03"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Trước"]},"Không đủ tiền kiện tụng thì xin trợ giúp pháp lý, các vụ đòi lương, cấp dưỡng, tai nạn lao động vốn đã nằm trong phạm vi"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/vi/tip/07-05"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Tiếp theo"]},"Tìm việc thì dùng dịch vụ việc làm công cộng miễn phí và thị trường việc lẻ trước, đừng qua môi giới thu phí"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children"