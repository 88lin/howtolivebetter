ops":{},"children":["往楼下扔东西，没砸到人也能拘留 5 日、罚 1000 元，情节严重的拘留 10 到 15 日。砸到人就换罪名了：有人在 21 楼酒后把空酒瓶、玻璃杯扔到楼下操场…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/09-10"},"children":[{"tag":"strong","props":{},"children":["不网购仿真枪、钢珠枪、气枪，不买来路不明的「玩具枪」"]},{"tag":"span","props":{},"children":["网上买的钢珠枪、气枪，枪口比动能到了 1.8 焦耳/平方厘米，就按枪支认定。没有许可拿在手里，判 3 年以下，情节严重的判 3 到 7 年。有对夫妇卖「玩具枪」…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/09-11"},"children":[{"tag":"strong","props":{},"children":["买了无人机先实名登记，机场、军事区和城市管制空域不飞，不破解限高"]},{"tag":"span","props":{},"children":["没实名登记就飞，罚 200 元以下，情节严重的罚 2000 到 2 万元。没批准在管制空域飞，罚 500 元以下，情节严重的没收无人机，再罚 1000 到 1…"]}]}]}]},{"tag":"a","props":{"className":"life-text-link","href":"/book/09"},"children":["阅读整个主题：普通人容易踩的法律红线 ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"15","height":"15","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]}]}]}]},{"tag":"aside","props":{"className":"life-ad-space life-ad-space-sponsored","data-ad-placement":"ad_footer","data-ad-group":"reading","data-ad-creative":"read_product","data-ad-ready":"false","aria-label":"广告 · 社区推荐"},"children":[{"tag":"div","props":{"className":"life-ad-space-brand"},"children":[{"tag":"img","props":{"src":"/sites/howtolivebetter/images/shengcai/logo.png","width":"565","height":"144","alt":"生财有术官方 Logo","decoding":"async"},"children":[]}]},{"tag":"div","props":{"className":"life-ad-space-copy"},"children":[{"tag":"span","props":{"className":"life-ad-space-label"},"children":["广告 · 社区推荐"]},{"tag":"strong","props":{},"children":["读过的知识，能不能做成有用的产品？"]},{"tag":"p","props":{},"children":["从电子书、资料到小工具，看看圈友怎样发现需求，把内容变成实际交付。"]}]},{"tag":"div","props":{"className":"life-ad-space-