e-circle-user-round","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M18 20a6 6 0 0 0-12 0"},"children":[]},{"tag":"circle","props":{"cx":"12","cy":"10","r":"4"},"children":[]},{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},{"tag":"span","props":{},"children":["Đăng nhập để đồng bộ hóa"]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/vi/book/26"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"Quay lại mục lục"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["Làm một trang web hoặc nền tảng: giấy phép, đăng ký, máy chủ"]},{"tag":"nav","props":{"aria-label":"Các mục trong chương"},"children":[{"tag":"a","props":{"href":"/vi/tip/26-01"},"children":[{"tag":"span","props":{},"children":["01"]},"Để tiền không đi vào tài khoản của nền tảng rồi mới chuyển cho người bán, hãy cho tiền đi thẳng qua tổ chức thanh toán được cấp phép"]},{"tag":"a","props":{"href":"/vi/tip/26-02"},"children":[{"tag":"span","props":{},"children":["02"]},"Trang web thu phí thì cần giấy phép, bên tự bán hàng không cho người khác tham gia thì không cần, bên trung gian kết nối giao dịch là loại giấy phép khác, trang web miễn phí chỉ cần đăng ký khai báo"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/vi/tip/26-03","data-status":"active"},"children":[{"tag":"span","props":{},"children":["03"]},"Phát trực tiếp thì cần giấy phép kinh doanh văn hóa trên mạng, còn giấy phép chương trình nghe nhìn thì công ty tư nhân gần như không xin được"]},{"tag":"a","props":{"href":"/vi/tip/26-04"},"children":[{"tag":"span","props":{},"children":["04"]},"Máy chủ đặt trong nước thì phải đăng ký khai báo, và nhà cung cấp dịch vụ truy cập phải tự có giấy phép viễn thông giá trị gia tăng"]},{"tag":"a","props":{"href":"/vi/tip/26-05"},"children":[{"tag":"span","props":{},"children":["05"]},"Cho người dùng lên bán hàng thì nền tảng phải kiểm tra đăng ký, báo thông tin và lưu giữ ba năm"]},{"tag":"a","props":{"href":"/vi/tip/26-06"},"children":[{"tag":"span","props":{},"children":["06"]},"Nội dung người dùng đăng lên là bạn phải quản: có cơ chế duyệt, có cửa sổ báo việc, thấy nội dung vi phạm thì dừng truyền ngay và báo cáo"]},{"tag":"a","props":{"href":"/vi/tip/26-07"},"children":[{"tag":"span","props":{},"children":["07"]},"Cung cấp dịch vụ đăng thông tin và nhắn tin tức thì phải yêu cầu người dùng cung cấp thông tin danh tính thật"]},{"tag":"a","props":{"href":"/vi/tip/26-08"},"children":[{"tag":"span","props":{},"children":["08"]},"Không mở phát trực tiếp cho người chưa đủ 16 tuổi, tiền thưởng xử lý theo bậc tuổi"]},{"tag":"a","props":{"href":"/vi/tip/26-09"},"children":[{"tag":"span","props":{},"children":["09"]},"Nhận được thông báo vi phạm thì phải xử lý kịp thời, chuyển bản giải trình mà sau 15 ngày không có động tĩnh thì khôi phục lại"]},{"tag":"a","props":{"href":"/vi/tip/26-10"},"children":[{"tag":"span","props":{},"children":["10"]},"Đừng tùy tiện đặt thông tin người dùng ra nước ngoài, việc chuyển dữ liệu ra nước ngoài có điều kiện luật định và có ngưỡng số người"]},{"tag":"a","props":{"href":"/vi/tip/26-11"},"children":[{"tag":"span","props":{},"children":["11"]},"Chọn máy chủ thì xem sập có chịu được không, xem có ai trực vận hành không, cuối cùng mới so giá"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"Breadcrumbs"},"children":[{"tag":"a","props":{"href":"/vi/book"},"children":["Khám phá cuốn sách"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/vi/book/26"},"children":["Chương 26"," ·"," ","Làm một trang web hoặc nền tảng: giấy phép, đăng ký, máy chủ"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"26-03"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["03"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["Bằng chứng"," ","A"]}]},{"tag":"h1","props":{"lang":"vi"},"children":["Phát trực tiếp thì cần giấy phép kinh doanh văn hóa trên mạng, còn giấy phép chương trình nghe nhìn thì công ty tư nhân gần như không xin được"]},{"tag":"p","props":{"lang":"vi","className":"life-entry-summary"},"children":["Phát trực tiếp hay thuyết minh trò chơi thì cần giấy phép kinh doanh văn hóa trên mạng do cơ quan văn hóa cấp tỉnh cấp. Trên giấy phép, phạm vi kinh doanh phải có ghi biểu diễn trên mạng. Trong 20 ngày kể từ khi nhận hồ sơ sẽ có kết quả, giấy phép dùng 3 năm. Video đã phát thì bạn tự giữ đủ 60 ngày. Không có giấy phép mà mở, sẽ bị yêu cầu dừng, bị cảnh cáo, rồi phạt tiền dưới 3 vạn tệ; không dừng thì vào danh sách đen."]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Chi phí"]},{"tag":"p","props":{},"children":["Giấy phép kinh doanh văn hóa trên mạng (网络文化经营许可证), gọi tắ…"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Lợi ích"]},{"tag":"p","props":{},"children":["Đơn vị làm biểu diễn trên mạng phải xin giấy phép trước. Nguyên văn quy chế là「应当根据《互联网文化管理暂行规定》，向省级文化行政部门申请取得…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"Đánh dấu: Phát trực tiếp thì cần giấy phép kinh doanh văn hóa trên mạng, còn giấy phép chương trình nghe nhìn thì công ty tư nhân gần như không xin được"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"Hoàn tất"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"Kế hoạch thực hiện"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"Lưu"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Chia sẻ mẹo này"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Ẩn chi tiết"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Chi phí"]},{"tag":"p","props":{},"children":["Giấy phép kinh doanh văn hóa trên mạng (网络文化经营许可证), gọi tắt là giấy phép văn hóa mạng, quyết định「能不能靠直播、游戏解说这类网络表演赚钱」— có được kiếm tiền từ biểu diễn trên mạng như phát trực tiếp hay thuyết minh trò chơi hay không. Cơ quan quản lý văn hóa cấp tỉnh phê duyệt, phải có kết quả trong 20 ngày kể từ khi nhận hồ sơ, giấy phép có hiệu lực 3 năm, phải đi gia hạn trước khi hết hạn 30 ngày. Giấy phép chương trình nghe nhìn (视听节目许可) quyết định「能不能在网上放节目」— có được phát chương trình trên mạng hay không, và nó đòi hỏi người xin là đơn vị sở hữu toàn phần của nhà nước hoặc đơn vị do nhà nước kiểm soát phần lớn"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Lợi ích"]},{"tag":"p","props":{},"children":["Đơn vị làm biểu diễn trên mạng phải xin giấy phép trước. Nguyên văn quy chế là「应当根据《互联网文化管理暂行规定》，向省级文化行政部门申请取得《网络文化经营许可证》，许可证的经营范围应当明确包括网络表演」. Chơi trò chơi cho người ta xem hoặc thuyết minh cũng bị quản lý theo bộ này, nguyên văn quy chế là「参照本办法进行管理」. Toàn bộ tư liệu video của các buổi biểu diễn trên mạng「保存时间不得少于60日」— thời gian lưu giữ không được ít hơn 60 ngày, nên video đã phát bạn phải tự giữ đủ 60 ngày. Không được phê duyệt mà làm hoạt động văn hóa Internet có tính thương mại thì bị yêu cầu dừng, bị cảnh cáo, rồi phạt tiền dưới 3 vạn tệ. Bị yêu cầu dừng mà vẫn không dừng thì bị đưa vào danh sách đen của thị trường văn hóa. Phát chương trình trên mạng là một giấy phép khác:「应当取得《信息网络传播视听节目许可证》」. Người xin phải「具备法人资格，为国有独资或国有控股单位」— có tư cách pháp nhân và là đơn vị sở hữu toàn phần của nhà nước hoặc do nhà nước kiểm soát phần lớn, tức là phải là đơn vị do nhà nước làm chủ sở hữu toàn phần hoặc phần lớn, công ty tư nhân về cơ bản không xin được. Không có giấy phép mà làm thì bị cảnh cáo, bị buộc sửa, có thể còn phạt tiền dưới 3 vạn tệ. Nghiêm trọng thì xử phạt theo Quy chế quản lý phát thanh truyền hình và truyền thanh (广播电视管理条例) (toàn quốc)"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Nguồn gốc"]},{"tag":"p","props":{"className":"life-citations"},"children":["文化部 (2016). 网络表演经营活动管理办法（文市发〔2016〕33 号，第二、四、六、十三、二十条）. ",{"tag":"a","props":{"href":"https://zwgk.mct.gov.cn/zfxxgkml/scgl/202012/t20201206_918194.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://zwgk.mct.gov.cn/zfxxgkml/scgl/202012/t20201206_918194.html"]}," ; 文化部 (2011). 互联网文化管理暂行规定（文化部令第 51 号，2017 年经文化部令第 57 号修订，第七、八、九、十六、二十一、二十八条）. ",{"tag":"a","props":{"href":"https://zwgk.mct.gov.cn/zfxxgkml/zcfg/bmgz/202012/t20201204_905340.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://zwgk.mct.gov.cn/zfxxgkml/zcfg/bmgz/202012/t20201204_905340.html"]}," ; 广电总局、信息产业部 (2007). 互联网视听节目服务管理规定（第 56 号令，2015 年修订，第二、七、八、二十四条）. ",{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/2022-08/23/content_5722664.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/zhengce/2022-08/23/content_5722664.htm"]}," ; 国家网信办等七部门 (2021). 关于加强网络直播规范管理工作的指导意见（国信办发文〔2021〕3 号，第 9 项）. ",{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/2021-02/10/content_5586472.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/zhengce/zhengceku/2021-02/10/content_5586472.htm"]}]},{"tag":"a","props":{"href":"https://zwgk.mct.gov.cn/zfxxgkml/scgl/202012/t20201206_918194.html","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Liên kết mở nguồn"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Ghi chú sách"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["Ngành nghề nào hợp với giấy phép nào thì văn bản của bảy cơ quan đó viết rõ nhất. Nền tảng kiếm tiền bằng phát trực tiếp cần giấy phép văn hóa mạng cộng thêm đăng ký ICP, đăng ký ICP là thủ tục đăng ký trang web với Bộ Công nghiệp và Thông tin (工业和信息化部). Phát chương trình trên mạng thì cần giấy phép chương trình nghe nhìn, hoặc hoàn tất đăng ký. Đăng tin tức thì cần giấy phép dịch vụ thông tin tin tức Internet. Ngoài ra,《互联网文化管理暂行规定》mà trang chính phủ Trung Quốc đăng lại năm 2025 là bản gốc năm 2011 chưa sửa đổi, khi trích dẫn phải theo văn bản đang có hiệu lực của Bộ Văn hóa và Du lịch (文化和旅游部)"]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Ghi chú của tôi"]},{"tag":"button","props":{"type":"button"},"children":["Viết một lời nhắc cho chính bạn…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/vi/tip/26-02"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Trước"]},"Trang web thu phí thì cần giấy phép, bên tự bán hàng không cho người khác tham gia thì không cần, bên trung gian kết nối giao dịch là loại giấy phép khác, trang web miễn phí chỉ cần đăng ký khai báo"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/vi/tip/26-04"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Tiếp theo"]},"Máy chủ đặt trong nước thì phải đăng ký khai báo, và nhà cung cấp dịch vụ truy cập phải tự có giấy phép viễn thông giá trị gia tăng"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16"