an","props":{},"children":["09"]},"不要为了「更健康」花溢价买有机食品"]},{"tag":"a","props":{"href":"/tip/06-10","className":""},"children":[{"tag":"span","props":{},"children":["10"]},"不要花大钱买保健品、膏方、滋补品来「调理身体」"]},{"tag":"a","props":{"href":"/tip/06-11","className":""},"children":[{"tag":"span","props":{},"children":["11"]},"不要在没有肠道问题时长期吃益生菌"]},{"tag":"a","props":{"href":"/tip/06-12","className":""},"children":[{"tag":"span","props":{},"children":["12"]},"不要为了「增强免疫力」逼自己洗冷水澡"]},{"tag":"a","props":{"href":"/tip/06-13","className":""},"children":[{"tag":"span","props":{},"children":["13"]},"不要买排毒、清肠、酵素、碱性水这类产品"]},{"tag":"a","props":{"href":"/tip/06-14","className":""},"children":[{"tag":"span","props":{},"children":["14"]},"不要为了凑够「每天 8 杯水」强迫自己喝水"]},{"tag":"a","props":{"href":"/tip/06-15","className":""},"children":[{"tag":"span","props":{},"children":["15"]},"不要花钱算命、看塔罗、看星座来做决定"]},{"tag":"a","props":{"href":"/tip/06-16","className":""},"children":[{"tag":"span","props":{},"children":["16"]},"不要买防蓝光眼镜来「保护视力」，也不要相信「对着屏幕干几个月眼睛就废了」，但眼睛胀痛发红要当急症"]},{"tag":"a","props":{"href":"/tip/06-17","className":""},"children":[{"tag":"span","props":{},"children":["17"]},"不要把献血当保健：「排毒、降血脂、防心梗」没有随机试验支持，频繁献倒是真会缺铁"]},{"tag":"a","props":{"href":"/tip/06-18","className":""},"children":[{"tag":"span","props":{},"children":["18"]},"不要靠通用体检套餐防病，按年龄性别做那几项有证据的筛查"]},{"tag":"a","props":{"href":"/tip/06-19","className":""},"children":[{"tag":"span","props":{},"children":["19"]},"不要因为体检查出尿酸高、但从没痛过，就开始吃降尿酸药"]},{"tag":"a","props":{"href":"/tip/06-20","className":""},"children":[{"tag":"span","props":{},"children":["20"]},"不要因为体检查出胆囊结石、但从没疼过，就去预防性切胆囊"]},{"tag":"a","props":{"href":"/tip/06-21","className":""},"children":[{"tag":"span","props":{},"children":["21"]},"不要为了防肾结石把钙戒掉"]},{"tag":"a","props":{"href":"/tip/06-22","className":""},"children":[{"tag":"span","props":{},"children":["22"]},"不要为了「转运」「招财」「养人」买水晶、手串、貔貅这类物件"]},{"tag":"a","props":{"href":"/tip/06-23","className":""},"children":[{"tag":"span","props":{},"children":["23"]},"不要指望买东西改善心情或身份感"]},{"tag":"a","props":{"href":"/tip/06-24","className":""},"children":[{"tag":"span","props":{},"children":["24"]},"不要为了「在周围人里往上挪一档」多花钱换房、换车、换圈子"]},{"tag":"a","props":{"href":"/tip/06-25","className":""},"children":[{"tag":"span","props":{},"children":["25"]},"不要相信「意志力像肌肉，用一会儿就没了」"]},{"tag":"a","props":{"href":"/tip/06-26","className":""},"children":[{"tag":"span","props":{},"children":["26"]},"不要指望吃早餐或 16:8 轻断食帮你控制体重，吃饭时间挑你能长期坚持的"]},{"tag":"a","props":{"href":"/tip/06-27","className":""},"children":[{"tag":"span","props":{},"children":["27"]},"不要相信「手淫伤身」「戒色才能变好」，真正要看的是有没有耽误睡觉、工作和关系"]},{"tag":"a","props":{"href":"/tip/06-28","className":""},"children":[{"tag":"span","props":{},"children":["28"]},"不要花钱做「性取向矫正」「同性恋治疗」，也不要把家里人送去"]},{"tag":"a","props":{"href":"/tip/06-29","className":""},"children":[{"tag":"span","props":{},"children":["29"]},"不要指望学会「正确搬运姿势」、上搬运培训就能防腰痛，要减的是搬的重量和次数，平时多锻炼"]},{"tag":"a","props":{"href":"/tip/06-30","className":""},"children":[{"tag":"span","props":{},"children":["30"]},"不要指望骨折之后猛补钙、喝骨头汤能让骨头长得更快"]},{"tag":"a","props":{"href":"/tip/06-31","className":""},"children":[{"tag":"span","props":{},"children":["31"]},"不要指望靠 AI 聊天机器人自己判断病情和法律问题，看病、打官司、花大钱之前，把它说的依据找到原文核一遍"]},{"tag":"a","props":{"href":"/tip/06-32","className":"active"},"children":[{"tag":"span","props":{},"children":["32"]},"不要因为「人随时会死，早点把钱花完才快乐」就不存钱，三十岁的人约九成能活到六十岁"]}]}]},{"tag":"div","props":{"className":"life-tip-page","data-tip-locales":"zh"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"当前位置"},"children":[{"tag":"a","props":{"href":"/book"},"children":["阅读全书"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/book/06"},"children":["第 6 章 · 反面清单"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"06-32"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["32"]},{"tag":"span","props":{"className":"life-evidence grade-b"},"children":["证据 B"]}]},{"tag":"h1","props":{"lang":"zh"},"children":["不要因为「人随时会死，早点把钱花完才快乐」就不存钱，三十岁的人约九成能活到六十岁"]},{"tag":"p","props":{"lang":"zh","className":"life-entry-summary"},"children":["按世界卫生组织给中国算的数，三十岁的人约九成二能活到六十岁，一半以上能活到八十岁。年轻人普遍把自己早死的可能估得太高，照这个感觉过日子，存下的钱比该存的少约四分之一。多数人该担心的是钱比人先没了。"]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["成本"]},{"tag":"p","props":{},"children":["不花钱。要做的是在冒出「反正说不定哪天就没了」的念头时，先想一下自己活到六十岁的概率。难在周围人都这么说，想买的东西又就在眼前。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["收益"]},{"tag":"p","props":{},"children":["先看能活到多少岁。世界卫生组织的全球卫生观察站给中国算了 2023 年的生命表。生命表是按当年各个年龄的死亡率，推算一群人能活多久的表。按这张表，30 岁的人活到 60 岁的概率是 92.0%（男 89.2%，女 94.9%）。活到 65 岁是 87.4%（男 83.0%，女 92.0%）。活到 8…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"标记：不要因为「人随时会死，早点把钱花完才快乐」就不存钱，三十岁的人约九成能活到六十岁"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"已做到"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"加入待做"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"收藏"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"分享这条建议"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"收起详情"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["成本"]},{"tag":"p","props":{"className":"life-citations"},"children":["不花钱。要做的是在冒出「反正说不定哪天就没了」的念头时，先想一下自己活到六十岁的概率。难在周围人都这么说，想买的东西又就在眼前。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["收益"]},{"tag":"p","props":{"className":"life-citations"},"children":["先看能活到多少岁。世界卫生组织的全球卫生观察站给中国算了 2023 年的生命表。生命表是按当年各个年龄的死亡率，推算一群人能活多久的表。按这张表，30 岁的人活到 60 岁的概率是 92.0%（男 89.2%，女 94.9%）。活到 65 岁是 87.4%（男 83.0%，女 92.0%）。活到 80 岁是 55.6%（男 45.8%，女 66.1%）。这三组数是拿表里各年龄还活着的人数相除算出来的。活到 65 岁的人，平均还能再活 17.5 年。再看人们自己怎么估。2019 年《金融学杂志》（The Journal of Finance）上的一项研究做了问卷，请人估自己能活多久。结果是年轻人低估自己活下去的概率，老人高估。论文早先的工作稿举过一个例子：一名 28 岁男性实际活过 5 年的概率是 99.4%，他自己估的是 92.8%。作者把人们自己估的概率放进一个标准的「一辈子怎么存钱花钱」的模型里算。和按实际死亡率算相比，年轻人少存 26%，退休的人花存款慢 27%。问卷里把生死估得越歪的人，存钱的做法也越偏，扣掉风险偏好、认知能力和家庭条件之后仍然如此。作者认为，一个原因是人们把少见、让人印象深的死法看得太重"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["来源"]},{"tag":"p","props":{"className":"life-citations"},"children":["World Health Organization, Global Health Observatory. Life tables: lx - number of people left alive at age x, China, 2023（指标 LIFE_0000000031）. ",{"tag":"a","props":{"href":"https://ghoapi.azureedge.net/api/LIFE_0000000031?$filter=SpatialDim%20eq%20'CHN'%20and%20TimeDim%20eq%202023","target":"_blank","rel":"noopener noreferrer"},"children":["https://ghoapi.azureedge.net/api/LIFE_0000000031?$filter=SpatialDim%20eq%20'CHN'%20and%20TimeDim%20eq%202023"]},"；World Health Organization, Global Health Observatory. Life tables: ex - expectation of life at age x, China, 2023（指标 LIFE_0000000035）. ",{"tag":"a","props":{"href":"https://ghoapi.azureedge.net/api/LIFE_0000000035?$filter=SpatialDim%20eq%20'CHN'%20and%20TimeDim%20eq%202023","target":"_blank","rel":"noopener noreferrer"},"children":["https://ghoapi.azureedge.net/api/LIFE_0000000035?$filter=SpatialDim%20eq%20'CHN'%20and%20TimeDim%20eq%202023"]},"；Heimer RZ, Myrseth KOR, Schoenle RS (2019). YOLO: Mortality Beliefs and Household Finance Puzzles. The Journal of Finance, 74(6), 2957-2996. ",{"tag":"a","props":{"href":"https://doi.org/10.1111/jofi.12828","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1111/jofi.12828"]},"；Heimer RZ, Myrseth KOR, Schoenle RS (2016). YOLO: Mortality Beliefs and Household Finance Puzzles. SSRN 工作稿（28 岁男性那个例子出自这一版）. ",{"tag":"a","props":{"href":"https://doi.org/10.2139/ssrn.2749543","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.2139/ssrn.2749543"]},""]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["原书备注"]},{"tag":"p","props":{"className":"life-citations"},"children":["定 B 级有几条理由。生命表是世界卫生组织的模型估算，不是国家统计局公布的数。「少存 26%」是模型算出来的，不是跟踪真人数出来的。估生死那项只有一项研究，中国人群没有可以引用的同类数据。收益量级定中，沿用本节第 23 条（别指望买东西改善心情）的口径。少存的钱可能到万元级，但没有数字说明它换回多少，所以不记成大。同一项研究也发现，老人反过来把自己活多久估得太高，存款花得太慢，所以这条主要写给年轻人和中年人。这里不反对为喜欢的东西和经历花钱，要拦的只是「反正会死」这一个理由。真被意外或重病撞上，用得上的是应急金和保险，见第 5 节第 27 条（应急金）和第 5 节第 39 条（扛不住的损失买保险）。家里有人靠你的收入过日子的，见第 5 节第 40 条（定期寿险）。心情差就下单的，见本节第 23 条（买东西改善心情）。受益人是你自己。"]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["我的备注"]},{"tag":"button","props":{"type":"button"},"children":["写下对自己有用的提醒…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/tip/06-31"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["上一条"]},"不要指望靠 AI 聊天机器人自己判断病情和法律问题，看病、打官司、花大钱之前，把它说的依据找到原文核一遍"]}]},{"tag":"span","props":{},"children":[]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["本主题的其他建议"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/06-03"},"children":[{"tag":"strong","props":{},"children":["不要为了长寿给不缺维生素 D 的人补维生素 D"]},{"tag":"span","props":{},"children":["本来就不缺维 D 的人补上 5 年，得癌症、得心血管病和死亡的人数，都和不补的人一样。很少出门、晒不到太阳的成人，可以每天补 400 IU，一天别超过 2000…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/06-04"},"children":[{"tag":"strong","props":{},"children":["不要为了防癌吃抗氧化补剂（β 胡萝卜素、维生素 E、维生素 A）"]},{"tag":"span","props":{},"children":["这一条不只是没用。78 项试验、近 30 万人合起来算，吃抗氧化补剂的人死亡率反而略高一点。两项专门找吸烟者做的大试验里，β 胡萝卜素让得肺癌的比例高了 18%…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/06-05"},"children":[{"tag":"strong","props":{},"children":["不要指望氨糖（葡萄糖胺）/软骨素治膝关节炎"]},{"tag":"span","props":{},"children":["膝盖有骨关节炎的人吃 24 周假药，也有六成说没那么疼了。吃氨糖或软骨素的人只比这多出四五个百分点，小到可能只是碰巧。一年花七百到一千八，买到的基本就是那六成的…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/06-06"},"children":[{"tag":"strong","props":{},"children":["不要靠维生素 C 预防感冒"]},{"tag":"span","props":{},"children":["天天吃维 C 基本不会让你少得感冒，感冒了才开始吃，效果也时有时无。天天吃能把一次感冒缩短约 8%，也就是少难受半天，值不值一年三五百自己算。马拉松选手和在寒冷…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/06-07"},"children":[{"tag":"strong","props":{},"children":["不要给没有症状的自己做「全身 PET-CT」或「肿瘤标志物套餐」"]},{"tag":"span","props":{},"children":["没症状的人去查，查出来最多的是虚惊一场。做全身 CT 的人八成多至少查出一处「异常」，将近四成被叫回去复查，可大多数是良性的。女性查卵巢癌标志物，死于卵巢癌的反…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/06-08"},"children":[{"tag":"strong","props":{},"children":["不要指望手环/手表的运动量化帮你减重"]},{"tag":"span","props":{},"children":["超重的人做同样的饮食和运动安排，戴运动手环的人两年减了 3.5 公斤，不戴的人反而减了 5.9 公斤。想减重，花钱买设备帮不上忙，真正管用的是运动本身。"]}]}]}]},{"tag":"a","props":{"className":"life-text-link","href":"/book/06"},"children":["阅读整个主题：反面清单 ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"15","height":"15","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]}]}]},{"tag":"nav","props":{"className":"life-tabbar","aria-label":"主导航"},"children":[{"tag":"a","props":{"className":"","href":"/book"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"21","height":"21","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-book-open","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M12 7v14"},"children":[]},{"tag":"path","props":{"d":"M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z"},"children":[]}]},{"tag":"span","props":{},"children":["全书"]}]},{"tag":"a","props":{"className":"","href":"/top-50"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"21","height":"21","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-star","aria-hidden":"true"},"children":[{"tag":"path","props":{"d"