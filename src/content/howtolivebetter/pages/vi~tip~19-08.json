cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Chia sẻ mẹo này"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Ẩn chi tiết"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Chi phí"]},{"tag":"p","props":{},"children":["Không tốn tiền. Dành nửa tiếng để lưu lại hồ sơ. Chỗ khó là phải nhớ lưu trước khi rời đi."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Lợi ích"]},{"tag":"p","props":{},"children":["Trả máy tính và tài khoản rồi sẽ không lấy lại được tài liệu này. Tranh chấp lao động ở Trung Quốc theo «ai yêu cầu thì người ấy chứng minh»: điều bạn nêu cần bằng chứng. Bằng chứng do đơn vị giữ thì họ phải cung cấp, không cung cấp chịu hậu quả bất lợi. Trọng tài có thể yêu cầu đơn vị nộp tài liệu bạn không tiếp cận được trong thời hạn. Tranh chấp khai trừ, sa thải, chấm dứt hợp đồng, giảm lương, tính thâm niên do đơn vị chịu trách nhiệm chứng minh. Tiền làm thêm khác: bạn phải chứng minh có làm. Chỉ khi chứng minh hồ sơ làm thêm do đơn vị giữ mà họ không giao thì đơn vị chịu hậu quả bất lợi. Đơn vị chỉ có nghĩa vụ lưu hồ sơ trả lương trên hai năm, và khi trả phải cấp bảng lương cá nhân. Chưa ký hợp đồng bằng văn bản thì hồ sơ trả lương, đóng bảo hiểm xã hội, thẻ nhân viên, đăng ký tuyển dụng, chấm công và lời khai đồng nghiệp đều có thể chứng minh quan hệ lao động. Tin nhắn là dữ liệu điện tử, dùng làm chứng cứ được. Phải nộp bản gốc; bản in trực tiếp từ hồ sơ gốc cũng tính là gốc. Một vụ Viện Kiểm sát Thượng Hải xử lý: công nhân đòi chênh lệch lương tối thiểu mười năm, sơ thẩm và phúc thẩm chỉ công nhận hai năm cuối trước nghỉ. Tòa cho rằng đơn vị chỉ phải lưu hai năm, tám năm trước công nhân tự chứng minh. Anh giữ phiếu lương và sao kê mười năm nhưng đơn vị phủ nhận phiếu lương thật. Tháng 8 năm 2024 anh xin kiểm sát giám sát. Sau kháng nghị, đơn vị trả thêm 19000 nhân dân tệ theo hòa giải. Anh đã kiện khi công ty cho nhân viên nghỉ năm 2021, đến xin giám sát đã khoảng ba năm (toàn Trung Quốc)."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Nguồn gốc"]},{"tag":"p","props":{"className":"life-citations"},"children":["全国人大常委会 (2007). 劳动争议调解仲裁法（第六、三十九条）. ",{"tag":"a","props":{"href":"https://rsj.ankang.gov.cn/Content-2150407.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://rsj.ankang.gov.cn/Content-2150407.html"]},"（安康市人力资源和社会保障局转载）；最高人民法院 (2020). 关于审理劳动争议案件适用法律问题的解释（一）（法释〔2020〕26 号，第四十二、四十四条）. ",{"tag":"a","props":{"href":"https://www.court.gov.cn/fabu/xiangqing/282121.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.court.gov.cn/fabu/xiangqing/282121.html"]},"；最高人民法院 (2019). 关于民事诉讼证据的若干规定（法释〔2019〕19 号，第十四、十五条）. ",{"tag":"a","props":{"href":"https://www.court.gov.cn/zixun/xiangqing/212721.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.court.gov.cn/zixun/xiangqing/212721.html"]},"；劳动部 (1994). 工资支付暂行规定（第六条），黑龙江省人民政府「政策帮你问」引述. ",{"tag":"a","props":{"href":"https://www.hlj.gov.cn/hlj/c116413/202402/c00_31712524.shtml","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.hlj.gov.cn/hlj/c116413/202402/c00_31712524.shtml"]},"；劳动和社会保障部 (2005). 关于确立劳动关系有关事项的通知（劳社部发〔2005〕12 号），黑龙江省人民政府「政策帮你问」引述. ",{"tag":"a","props":{"href":"https://hlj.gov.cn/hlj/c116413/202408/c00_31757488.shtml","target":"_blank","rel":"noopener noreferrer"},"children":["https://hlj.gov.cn/hlj/c116413/202408/c00_31757488.shtml"]},"；郭勇辉, 边琬茹 (2025). 两年之外的工资支付情况举证责任应由谁承担？检察日报. ",{"tag":"a","props":{"href":"https://www.spp.gov.cn/spp/llyj/202508/t20250806_703164.shtml","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.spp.gov.cn/spp/llyj/202508/t20250806_703164.shtml"]},"（最高人民检察院网站刊载）；维权路径见第 7 节"]},{"tag":"a","props":{"href":"https://rsj.ankang.gov.cn/Content-2150407.html","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Liên kết mở nguồn"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Ghi chú sách"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["Lưu tài liệu quan hệ lao động của chính mình. Đừng tiện mang mã nguồn, danh sách khách hàng và tài liệu kỹ thuật công ty; rủi ro xem phần 11. Tin nhắn đừng chỉ chụp màn hình, giữ bản gốc trong điện thoại. Phiếu lương, sao kê tốt nhất lưu mỗi tháng; nhiều năm sau nghỉ việc đòi khoản cũ thì đơn vị không còn phải giữ hồ sơ trước hai năm. Vụ Thượng Hải lật được nhờ kiểm sát kháng nghị, đa số không đi tới bước ấy. Khi nghỉ còn phải yêu cầu giấy xác nhận chấm dứt việc làm, xem điều 17 phần này (giấy xác nhận nghỉ việc)."]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Ghi chú của tôi"]},{"tag":"button","props":{"type":"button"},"children":["Viết một lời nhắc cho chính bạn…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/vi/tip/19-07"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Trước"]},"Đừng ký「tự nguyện nghỉ việc vì lý do cá nhân」, ký là mất trắng cả khoản N"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/vi/tip/19-09"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Tiếp theo"]},"Trước khi vào chỗ có bụi, tiếng ồn, hoá chất thì xem trong hợp đồng đã ghi nguy cơ chưa; ba kỳ khám sức khoẻ nghề nghiệp do đơn vị sắp xếp và bỏ tiền"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props"