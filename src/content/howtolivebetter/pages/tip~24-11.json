"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"收藏"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"分享这条建议"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"收起详情"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["成本"]},{"tag":"p","props":{"className":"life-citations"},"children":["不花钱。写一封感谢信，或者在满意度平台上填一次，十几分钟。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["收益"]},{"tag":"p","props":{"className":"life-citations"},"children":["《医疗机构工作人员廉洁从业九项准则》（国卫医发〔2021〕41 号）第七项：「维护诊疗秩序，不破坏就医公平。坚持平等原则，共建公平就医环境。严禁利用号源、床源、紧缺药品耗材等医疗资源或者检查、手术等诊疗安排收受好处、损公肥私」。第八项：「共建和谐关系，不收受患方『红包』。恪守医德、严格自律」。同一项还写明「严禁索取或者收受患者及其亲友的礼品、礼金、消费卡和有价证券、股权、其他金融产品等财物」。患方出钱的饭局和娱乐也一样：「严禁参加其安排、组织或者支付费用的宴请或者旅游、健身、娱乐等活动安排」。文件同时要求医疗机构落实主体责任、开展督查、「坚决查处违规行为」。满意度评价被写进了三级公立医院的绩效考核。依据是《国务院办公厅关于加强三级公立医院绩效考核工作的意见》（国办发〔2019〕4 号）。文件说：「三级公立医院绩效考核指标体系由医疗质量、运营效率、持续发展、满意度评价等 4 个方面的指标构成」。文件还写明：「医院满意度由患者满意度和医务人员满意度两部分组成……」。后面接着说，要「通过门诊患者、住院患者和医务人员满意度评价，衡量患者获得感及医务人员积极性」。这套评价还有全国统一的平台：「国家建立公立医院满意度管理制度……」。时间表是：「2019 年 3 月底前，全国三级公立医院全部纳入国家卫生健康委满意度调查平台。各地要应用国家卫生健康委满意度调查平台，将调查结果纳入三级公立医院绩效考核」。医院还必须管投诉。依据是《医疗机构投诉管理办法》（国家卫生健康委令第 3 号，2019 年施行）第二条。投诉管理是指患者就医疗服务行为、医疗管理、医疗质量安全等方面「提出意见、建议或者投诉请求」。医院要负责调查、处理和反馈。「二级以上医疗机构应当设置医患关系办公室或者指定部门（以下统称投诉管理部门）统一承担投诉管理工作」。投诉管理部门的职责包括「统一受理投诉，调查、核实投诉事项，提出处理意见，及时答复患者」。医疗机构「应当鼓励工作人员主动收集患者对医疗服务、医疗质量安全等方面的意见和建议」（全国）"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["来源"]},{"tag":"p","props":{"className":"life-citations"},"children":["国家卫生健康委、国家医保局、国家中医药局 (2021). 关于印发医疗机构工作人员廉洁从业九项准则的通知（国卫医发〔2021〕41 号）. 国务院公报 ",{"tag":"a","props":{"href":"http://www.gov.cn/gongbao/content/2022/content_5678098.htm","target":"_blank","rel":"noopener noreferrer"},"children":["http://www.gov.cn/gongbao/content/2022/content_5678098.htm"]},"；国务院办公厅 (2019). 关于加强三级公立医院绩效考核工作的意见（国办发〔2019〕4 号）. ",{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/2019-01/30/content_5362266.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/zhengce/zhengceku/2019-01/30/content_5362266.htm"]},"；国家卫生健康委 (2019). 医疗机构投诉管理办法（委令第 3 号）. ",{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/2019-10/08/content_5436976.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/zhengce/zhengceku/2019-10/08/content_5436976.htm"]},""]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["原书备注"]},{"tag":"p","props":{"className":"life-citations"},"children":["受益人是你自己，也是救了你的那个人。通宵抢救之后想谢是人之常情，可以谢，要改的只是形式。红包和烟酒把风险转给了对方，感谢信、锦旗和满意度评价是制度里认可的方式。已经送出去、对方推回来的，别当成嫌少或者摆架子，那是他按规定必须做的。另外分清楚两件事：送医生红包归行业纪律和医院管，送办案、执法人员财物是刑法上的行贿罪，两件事不是一个量级，后者见第 8 节第 40 条。写感谢信、送锦旗医院普遍接受，但「会进个人和科室记录」是经验之谈，没有文件规定。有文件依据的是满意度调查结果纳入三级公立医院绩效考核这一条。对诊疗本身有疑问，就当场要求封存病历（见本节第 6 条，封存病历），并留存病历与影像（第 5 条，病历和影像自己存一份）"]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["我的备注"]},{"tag":"button","props":{"type":"button"},"children":["写下对自己有用的提醒…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/tip/24-10"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["上一条"]},"治完之后确实留下功能障碍，去户籍地县级残联申请残疾人证"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/tip/24-12"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["下一条"]},"种牙之前先问清包干价含哪些项目，优先找承诺参与价格治理的机构，别信低价广告"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["本主题的其他建议"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/24-04"},"children":[{"tag":"strong","props":{},"children":["跨省异地就医之前先在本地问一句，必要性原则上要副主任医师以上评估"]},{"tag":"span","props":{},"children":["要不要去外地看病，原则上由二、三级医院副主任医师以上的医生评估。临时外出就医报销多少，和在参保地同级别医院会有差别，具体看本地规定。出发前在本地问一句，比人到了…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/24-05"},"children":[{"tag":"strong","props":{},"children":["每次看完病，把病历、检查报告和影像自己存一份"]},{"tag":"span","props":{},"children":["查阅和复制自己的病历，是法律给你的权利。门诊病历、住院志、化验单、影像、手术和麻醉记录、病理资料、费用清单都能复制。医院要指定专门的部门或人员受理，只能收工本费…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/24-06"},"children":[{"tag":"strong","props":{},"children":["对诊疗有疑问就当场要求封存病历，双方在场、开清单、各执一份"]},{"tag":"span","props":{},"children":["对治疗有疑问，可以要求把病历封存起来。封存要医患双方都在场，开清单、签字盖章、各拿一份。病历还没写完的，先封已经写完的那部分。怀疑是输液、输血、打针、用药出的问…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/24-07"},"children":[{"tag":"strong","props":{},"children":["急重的伤病直奔急诊预检分诊台，别去挂号窗口排队"]},{"tag":"span","props":{},"children":["急诊不按先来后到，按病情轻重分四级排。定级的地方是急诊入口的预检分诊台，不是挂号窗口。到了先报最危险的那一条：大出血、喘不上气、意识不清、像心脏病那样的胸痛、疼…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/24-08"},"children":[{"tag":"strong","props":{},"children":["没带钱、没带证件、说不清自己是谁，急诊也必须先救"]},{"tag":"span","props":{},"children":["国家有一笔疾病应急救助基金，专付两种人的急救费：身份查不出来的，和掏不出钱的。医院不能拒绝或拖延抢救，急救中心也不能因为钱的问题不出车。所以别因为没钱在家硬扛，…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/24-09"},"children":[{"tag":"strong","props":{},"children":["伤残鉴定要等治疗终结或者临床治疗效果稳定之后再做"]},{"tag":"span","props":{},"children":["赔多少钱主要看评几级，评几级看的是治完之后还剩多少功能障碍。标准写明要在治疗终结、或者临床治疗效果稳定之后再做。骨头还没长好就去评，不合这条要求。长好了、不影响…"]}]}]}]},{"tag":"a","props":{"className":"life-text-link","href":"/book/24"},"children":["阅读整个主题：看病：怎么少花钱少走弯路 ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"15","height":"15","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]}]}]},{"tag":"nav","props":{"className":"life-tabbar","aria-label":"主导航"},"children":[{"tag":"a","props":{"className":"","href":"/book"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"21","height":"21","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-book-open","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M12 7v14"},"children":[]},{"tag":"path","props":{"d":"M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z"},"children":[]}]},{"tag":"span","props":{},"children":["全书"]}]},{"tag":"a","props":{"className":"","href":"/top-50"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"21","height":"21","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-star","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.7