-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["成本"]},{"tag":"p","props":{"className":"life-citations"},"children":["多数地区免费，或者几十元。有些扩展项目要自己掏钱。孩子出生后扎一次足跟"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["收益"]},{"tag":"p","props":{"className":"life-citations"},"children":["《新生儿疾病筛查管理办法》第三条：「全国新生儿疾病筛查病种包括先天性甲状腺功能减低症、苯丙酮尿症等新生儿遗传代谢病和听力障碍。」这两类病有个共同点：早期完全看不出异常，等到症状明显的时候，智力损害已经不可逆了。而早发现早干预效果很好，办法是补充甲状腺素、喝特殊配方奶、戴助听器或者装人工耳蜗。第十条规定，筛查结果是阳性的，机构应当及时通知监护人去确诊"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["来源"]},{"tag":"p","props":{"className":"life-citations"},"children":["卫生部 (2009). 新生儿疾病筛查管理办法（卫生部令第 64 号，第三、十、十一条）. ",{"tag":"a","props":{"href":"http://www.gov.cn/gongbao/content/2009/content_1371363.htm","target":"_blank","rel":"noopener noreferrer"},"children":["http://www.gov.cn/gongbao/content/2009/content_1371363.htm"]},""]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["原书备注"]},{"tag":"p","props":{"className":"life-citations"},"children":["办法第十一条要求，筛查前要把项目、条件、方式、灵敏度（能查出多少）和费用如实告诉监护人，并签字同意。所以你会拿到一张知情同意书。签之前看清楚：哪些是国家规定的病种，哪些是自费的加项。初筛阳性不等于确诊，绝大多数复查一次就排除了，别在这一步先崩溃。听力初筛没过的要按通知去复筛，别自己判断「孩子听得见就算了」"]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["我的备注"]},{"tag":"button","props":{"type":"button"},"children":["写下对自己有用的提醒…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/tip/27-12"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["上一条"]},"出院前把《出生医学证明》办掉，名字提前想好、别写错字"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/tip/27-14"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["下一条"]},"拿到出生医学证明就给孩子办居民医保，别等落完户"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["本主题的其他建议"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/27-09"},"children":[{"tag":"strong","props":{},"children":["想要无痛分娩就直接说，它不增加剖宫产的风险"]},{"tag":"span","props":{},"children":["无痛分娩就是在腰上打一针麻药，把生孩子的疼压下去。它比别的止疼办法更管用，也不会让你更可能挨一刀。「打了无痛腰疼一辈子」同样没有依据。现在它有了单独的收费项目，…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/27-10"},"children":[{"tag":"strong","props":{},"children":["没有医学指征就别主动要求剖宫产，也别为了挑日子开刀"]},{"tag":"span","props":{},"children":["世界卫生组织的说法是，一个地方的剖宫产比例超过 10% 以后，母亲和新生儿的死亡就不再继续下降。该剖的一定要剖。为了挑日子、怕疼去剖，只是白挨一次腹部大手术。"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/27-11"},"children":[{"tag":"strong","props":{},"children":["怀孕前就确认生育保险的参保状态，未就业的配偶也能报生育医疗费用"]},{"tag":"span","props":{},"children":["单位交了生育保险，生孩子的医疗费和产假期间的津贴都从这笔基金里出。配偶没工作的，医疗费这一块也能报。参保月数够不够、在外地生要不要先备案，都得提前问，事后补不了…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/27-15"},"children":[{"tag":"strong","props":{},"children":["孩子出生后一个月以内去派出所申报出生登记"]},{"tag":"span","props":{},"children":["法律给的是一个月，不是「有空再说」。落户卡着后面的打疫苗、入园、入学和办身份证。越往后拖，要补的材料越多。"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/27-16"},"children":[{"tag":"strong","props":{},"children":["产后 42 天那次复查别跳过，它同时是产后抑郁的筛查"]},{"tag":"span","props":{},"children":["这次复查不花钱，含血常规、白带常规，还包含一次产后抑郁筛查。产后一年内都可能出大问题，别觉得出了月子就安全了。"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/27-17"},"children":[{"tag":"strong","props":{},"children":["怀孕了不用把猫送走，猫砂换别人每天铲，肉要做熟、碰土戴手套"]},{"tag":"span","props":{},"children":["弓形虫是一种寄生虫。怀孕时第一次染上，可能流产，孩子也可能眼睛和脑子受损。家里养猫并不让人更容易染上，猫不用送走。更要防的是吃没熟透的肉、碰土不洗手，猫砂换别人…"]}]}]}]},{"tag":"a","props":{"className":"life-text-link","href":"/book/27"},"children":["阅读整个主题：怀孕和生产：从发现怀孕到出院办证 ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"15","height":"15","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]}]}]},{"tag":"nav","props":{"className":"life-tabbar","aria-label":"主导航"},"children":[{"tag":"a","props":{"className":"","href":"/book"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"21","height":"21","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-book-open","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M12 7v14"},"children":[]},{"tag":"path","props":{"d":"M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z"},"children":[]