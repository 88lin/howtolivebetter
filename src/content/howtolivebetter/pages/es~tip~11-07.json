 12h2"},"children":[]},{"tag":"path","props":{"d":"M20 12h2"},"children":[]},{"tag":"path","props":{"d":"m6.34 17.66-1.41 1.41"},"children":[]},{"tag":"path","props":{"d":"m19.07 4.93-1.41 1.41"},"children":[]}]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"17","height":"17","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-moon life-theme-icon-dark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"},"children":[]}]}]},{"tag":"button","props":{"type":"button","className":"life-language-switch","aria-label":"Español Elegir idioma","aria-haspopup":"menu","aria-expanded":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-globe","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]},{"tag":"path","props":{"d":"M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"},"children":[]},{"tag":"path","props":{"d":"M2 12h20"},"children":[]}]},{"tag":"span","props":{},"children":["Español"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]}]},{"tag":"a","props":{"className":"life-account","href":"/es/sign-in"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"17","height":"17","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle-user-round","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M18 20a6 6 0 0 0-12 0"},"children":[]},{"tag":"circle","props":{"cx":"12","cy":"10","r":"4"},"children":[]},{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},{"tag":"span","props":{},"children":["Iniciar sesión"]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/es/book/11"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"Volver al índice"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["Las líneas rojas que los programadores y los técnicos suelen pisar"]},{"tag":"nav","props":{"aria-label":"Consejos del capítulo"},"children":[{"tag":"a","props":{"href":"/es/tip/11-01"},"children":[{"tag":"span","props":{},"children":["01"]},"Antes de actuar, pregunta: ¿denunciarán el fabricante, la plataforma o la empresa? Si te investigan penalmente, busca enseguida un abogado penalista"]},{"tag":"a","props":{"href":"/es/tip/11-02"},"children":[{"tag":"span","props":{},"children":["02"]},"No crees ni vendas trampas o ayudas para videojuegos, incluidas las de IA que «solo leen la pantalla sin tocar la memoria», ni versiones modificadas que añadan funciones a aplicaciones como WeChat"]},{"tag":"a","props":{"href":"/es/tip/11-03"},"children":[{"tag":"span","props":{},"children":["03"]},"No escribas ni vendas scripts de reventa de entradas, compras relámpago, pedidos falsos ni aprovechamiento de promociones, aunque sea solo «apretar botones de forma automatizada»"]},{"tag":"a","props":{"href":"/es/tip/11-04"},"children":[{"tag":"span","props":{},"children":["04"]},"Los rastreadores solo rastrean páginas públicas que no piden inicio de sesión; sin saltarse el antirrastreo, sin tocar datos personales, y los datos rastreados no se venden"]},{"tag":"a","props":{"href":"/es/tip/11-05"},"children":[{"tag":"span","props":{},"children":["05"]},"No aceptes encargos de desarrollo de Apps de juego, estafa o pornografía, ni montes canales de pago ni desbloquees cuentas para el «cliente»"]},{"tag":"a","props":{"href":"/es/tip/11-06"},"children":[{"tag":"span","props":{},"children":["06"]},"Al irte de la empresa entrega todas las cuentas y permisos; no borres bases de datos, no dejes puertas traseras, no cambies contraseñas para dejar el sistema bloqueado, aunque la empresa te deba dinero"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/es/tip/11-07","data-status":"active"},"children":[{"tag":"span","props":{},"children":["07"]},"Al irte no te lleves el código fuente, las listas de clientes ni la documentación técnica; no los subas a una nube personal y no los reutilices en el siguiente empleo"]},{"tag":"a","props":{"href":"/es/tip/11-08"},"children":[{"tag":"span","props":{},"children":["08"]},"No ejecutes tus programas en ordenadores, servidores o cámaras ajenos, ni uses las máquinas de la empresa para minar criptomonedas"]},{"tag":"a","props":{"href":"/es/tip/11-09"},"children":[{"tag":"span","props":{},"children":["09"]},"Sin autorización por escrito, no testes los sistemas ajenos; ni las «buenas intenciones» ni el «aviso posterior» son motivo para quedar fuera del delito"]},{"tag":"a","props":{"href":"/es/tip/11-10"},"children":[{"tag":"span","props":{},"children":["10"]},"Reporta las vulnerabilidades conforme a las normas; antes del parche, ni detalles públicos, ni herramientas de explotación, ni entrega al extranjero"]},{"tag":"a","props":{"href":"/es/tip/11-11"},"children":[{"tag":"span","props":{},"children":["11"]},"No vendas herramientas para saltar el bloqueo ni cuentas de VPN, ni montes nodos de ese tipo para otros"]},{"tag":"a","props":{"href":"/es/tip/11-12"},"children":[{"tag":"span","props":{},"children":["12"]},"Si firmaste un pacto de no competencia, reclámalo por escrito cuando la empresa no pague la compensación mensual tras tu salida; si pasan 3 meses sin pagar puedes rescindirlo; en un puesto sin contacto con secretos comerciales puedes pedir que se declare que la cláusula no surte efecto"]},{"tag":"a","props":{"href":"/es/tip/11-13"},"children":[{"tag":"span","props":{},"children":["13"]},"El código escrito en horario de trabajo y con recursos de la empresa es de la empresa; tus proyectos de código abierto hazlos con tu tiempo y tus equipos, y no mezcles código de la empresa"]},{"tag":"a","props":{"href":"/es/tip/11-14"},"children":[{"tag":"span","props":{},"children":["14"]},"El uso de código abierto como GPL para crear productos: es obligatorio abrir el código o cambiar la licencia según lo exija la licencia; no se puede alegar que «nadie se entera»"]},{"tag":"a","props":{"href":"/es/tip/11-15"},"children":[{"tag":"span","props":{},"children":["15"]},"Una App solo recoge los datos personales que el negocio necesita de verdad; los menores de 14 años necesitan el consentimiento del tutor; la política de privacidad se escribe con claridad"]},{"tag":"a","props":{"href":"/es/tip/11-16"},"children":[{"tag":"span","props":{},"children":["16"]},"Antes de lanzar un sitio web o app, hay que registrarlo en el sistema ICP y conservar los registros durante al menos 6 meses según los requisitos de protección de niveles"]},{"tag":"a","props":{"href":"/es/tip/11-17"},"children":[{"tag":"span","props":{},"children":["17"]},"Antes de ofrecer al público un servicio de IA generativa, haz la evaluación de seguridad y el registro de algoritmo conforme a las normas, y marca el contenido generado"]},{"tag":"a","props":{"href":"/es/tip/11-18"},"children":[{"tag":"span","props":{},"children":["18"]},"No crees ni distribuyas herramientas que omitan o bloqueen automáticamente anuncios de otras aplicaciones: aunque sean gratuitas y no se conecten a internet, pueden constituir competencia desleal"]},{"tag":"a","props":{"href":"/es/tip/11-19"},"children":[{"tag":"span","props":{},"children":["19"]},"No montes un «intermediario de IA» para revender a bajo precio interfaces de modelos extranjeros: un responsable en Shanghái ya ha sido detenido penalmente"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"Ruta de navegación"},"children":[{"tag":"a","props":{"href":"/es/book"},"children":["Libro"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/es/book/11"},"children":["Capítulo 11"," ·"," ","Las líneas rojas que los programadores y los técnicos suelen pisar"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"11-07"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["07"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["Evidencia"," ","A"]}]},{"tag":"h1","props":{"lang":"es"},"children":["Al irte no te lleves el código fuente, las listas de clientes ni la documentación técnica; no los subas a una nube personal y no los reutilices en el siguiente empleo"]},{"tag":"p","props":{"lang":"es","className":"life-entry-summary"},"children":["El código que escribiste tú también tiene los derechos de autor de la empresa; llevártelo es llevarse lo de la empresa. Las listas de clientes cuentan igualmente como secreto comercial. Unos empleados que se fueron llevaron a la nueva empresa el código fuente de un sistema de inspección de seguridad y su algoritmo central: el protagonista fue condenado a 5 años y 500 000 yuanes de multa, y la nueva empresa a 4 000 000 de yuanes. Alguien aprovechó una vulnerabilidad del sistema para descargar más de 33 000 archivos de diseño: condena de 1 año y 10 meses y 100 000 yuanes de multa. Además de la condena penal, la empresa puede reclamar por la vía civil por separado."]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Coste"]},{"tag":"p","props":{},"children":["No cuesta dinero. Antes de irte, borra del todo el materia…"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Beneficio"]},{"tag":"p","props":{},"children":["Quebrantar el deber de confidencialidad y divulgar secretos comerciales o usarlos por cuenta propia: si las ci…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"Marcar: Al irte no te lleves el código fuente, las listas de clientes ni la documentación técnica; no los subas a una nube personal y no los reutilices en el siguiente empleo"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"Hecho"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"Por hacer"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"Guardar"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Compartir consejo"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Ocultar detalles"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Coste"]},{"tag":"p","props":{},"children":["No cuesta dinero. Antes de irte, borra del todo el material de la empresa de tu ordenador personal y de tu nube. Lo difícil es que algunos archivos los escribiste línea a línea tú, y cuesta soltarlos."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Beneficio"]},{"tag":"p","props":{},"children":["Quebrantar el deber de confidencialidad y divulgar secretos comerciales o usarlos por cuenta propia: si las circunstancias son graves, menos de 3 años de prisión, con multa conjunta o única; si son especialmente graves, de 3 a 10 años con multa. La ley de competencia desleal lista además como infracciones dos cosas: usar la «intrusión electrónica», es decir, entrar en sistemas por medios técnicos para conseguir secretos comerciales, e incitar o ayudar a otros a quebrantar el deber de confidencialidad. Casos oficiales: Sun Ming y otros empleados que se fueron llevaron el código fuente del sistema de inspección de seguridad y su algoritmo central y los usaron en los productos de su nueva empresa; Sun Ming fue condenado a 5 años y 500 000 yuanes de multa, y la nueva empresa a 4 000 000 de yuanes. Tian aprovechó una vulnerabilidad del sistema para descargar más de 33 000 archivos de diseño; condena de 1 año y 10 meses y 100 000 yuanes de multa. Yang, ingeniero, guardó el código fuente de módulos de una App