n":["ログイン"]}]}]}]},{"tag":"main","props":{"className":"checkup-page"},"children":[{"tag":"section","props":{"className":"checkup-intro"},"children":[{"tag":"div","props":{"className":"life-eyebrow"},"children":["5つの質問・3分"]},{"tag":"h1","props":{},"children":["人生チェック"]},{"tag":"p","props":{},"children":["654件すべてを読む必要はありません。5つの質問に答えれば、原書のコスパ順に、あなたが最初にやるべき10件を選びます。"]},{"tag":"div","props":{"className":"checkup-intro-actions"},"children":[{"tag":"button","props":{"type":"button","className":"life-button dark"},"children":["チェックを始める",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"18","height":"18","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"div","props":{"className":"checkup-parents"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"20","height":"20","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-heart-handshake","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"},"children":[]},{"tag":"path","props":{"d":"M12 5 9.04 7.96a2.17 2.17 0 0 0 0 3.08c.82.82 2.13.85 3 .07l2.07-1.9a2.82 2.82 0 0 1 3.79 0l2.96 2.66"},"children":[]},{"tag":"path","props":{"d":"m18 15-2-2"},"children":[]},{"tag":"path","props":{"d":"m15 18-2-2"},"children":[]}]},{"tag":"div","props":{},"children":[{"tag":"p","props":{},"children":["親の代わりに5つの質問に答えて、親がまずやるべきことを選びます。高齢者を狙う詐欺、家庭の常備薬の安全な使い方、検診、任意後見、介護保険など。"]},{"tag":"div","props":{"className":"checkup-intro-actions"},"children":[{"tag":"button","props":{"type":"button","className":"life-button ghost"},"children":["親の分をつくる",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]},{"tag":"a","props":{"className":"checkup-retake","href":"/ja/checkup/plans"},"children":["マイ行動プラン"]}]}]}]},{"tag":"p","props":{"className":"checkup-fine"},"children":["回答はまずこの端末に保存されます。親の行動プランはログインしてアカウントに保存すると、別の端末で続けられます。統計を許可すると選択肢は匿名の集計に含まれます。"]}]},{"tag":"div","props":{"className":"page-guide"},"children":[{"tag":"section","props":{"aria-labelledby":"checkup-about-title"},"children":[{"tag":"div","props":{"className":"life-eyebrow"},"children":["人生チェックについて"]},{"tag":"h2","props":{"id":"checkup-about-title"},"children":["人生チェックとは？"]},{"tag":"p","props":{},"children":["人生チェックは、5つの質問に答える無料のセルフチェックです。年齢層、移動手段、家庭の状況、仕事、いちばん改善したいことから、原書の677件の提案のうち、あなたが最初にやるべき10件を選びます。"]},{"tag":"p","props":{},"children":["選び方の基準は、原書が各提案に付けているコストと効果です。お金も時間も意志の力もあまり要らず、効果が大きいものほど上位に来ます。1つのテーマからは最大2件まで、実行済みのものは除外されます。"]}]},{"tag":"section","props":{"aria-labelledby":"checkup-steps-title"},"children":[{"tag":"h2","props":{"id":"checkup-steps-title"},"children":["3分で、677件からあなたの10件へ"]},{"tag":"ol","props":{"className":"page-guide-steps"},"children":[{"tag":"li","props":{},"children":[{"tag":"span","props":{},"children":["0","1"]},{"tag":"h3","props":{},"children":["5つの質問に答える"]},{"tag":"p","props":{},"children":["すべて選択式で、多くは複数選択できます。個人情報の入力はありません。"]}]},{"tag":"li","props":{},"children":[{"tag":"span","props":{},"children":["0","2"]},{"tag":"h3","props":{},"children":["最初の10件を見る"]},{"tag":"p","props":{},"children":["各提案に一言の説明と原文へのリンクがあり、その場で実行済み・やることにできます。"]}]},{"tag":"li","props":{},"children":[{"tag":"span","props":{},"children":["0","3"]},{"tag":"h3","props":{},"children":["まとめてやることへ"]},{"tag":"p","props":{},"children":["すべて「マイリスト」に入り、進み具合の確認や、週1件ずつのカレンダー書き出しができます。"]}]}]}]},{"tag":"section","props":{"className":"page-guide-faq","aria-labelledby":"checkup-faq-title"},"children":[{"tag":"h2","props":{"id":"checkup-faq-title"},"children":["人生チェックのよくある質問"]},{"tag":"details","props":{},"children":[{"tag":"summary","props":{},"children":["登録や料金は必要ですか？"]},{"tag":"p","props":{},"children":["不要です。チェック、結果の確認、やることへの追加はログインなしで使え、リストはこのブラウザに保存されます。ログインすると複数の端末で同期できます。"]}]},{"tag":"details","props":{},"children":[{"tag":"summary","props":{},"children":["回答は送信されますか？"]},{"tag":"p","props":{},"children":["送信されません。次に開いたとき前回の結果を表示するため、このブラウザにだけ保存されます。共有リンクにも回答は含まれません。"]}]},{"tag":"details","props":{},"children":[{"tag":"summary","props":{},"children":["結果はどう決まりますか？"]},{"tag":"p","props":{},"children":["回答ごとに関連テーマの重みが上がり、原書が記した効果・費用・時間・意志の力と、テーマ内の並び順をもとに点数を付けます。透明なルールであり、医療・法律・お金に関する個別の助言ではありません。"]}]},{"tag":"details","props":{},"children":[{"tag":"summary","props":{},"children":["自分に合わない提案があるのはなぜ？"]},{"tag":"p","props":{},"children":["5つの質問ではすべての状況をカバーできません。合わないものは飛ばし、テーマや根拠レベルから原書で選び直してください。"]}]},{"tag":"details","props":{},"children":[{"tag":"summary","props":{},"children":["どのくらいの頻度で受ければいい？"]},{"tag":"p","props":{},"children":["転職、引っ越し、出産など、生活が変わったときに受け直してください。実行済みの提案は除外され、次にやるべきものが選ばれます。"]}]}]}]}]},{"tag":"nav","props":{"className":"life-tabbar","aria-label":"メインナビゲーション"},"children":[{"tag":"a","props":{"className":"","href":"/ja/book"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"21","height":"21","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-book-open","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M12 7v14"},"children":[]},{"tag":"path","props":{"d":"M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0