section-heading"},"children":[{"tag":"div","props":{},"children":[{"tag":"div","props":{"className":"life-eyebrow"},"children":["CÁC THÀNH CÔNG NHỎ CỦA BẠN"]},{"tag":"h2","props":{},"children":["Mỗi ngày bạn xuất hiện đều được tính"]},{"tag":"p","props":{},"children":["Lịch sử kiểm tra của bạn trong năm qua. Những ngày trống cũng được chấp nhận. Bạn có thể bắt đầu lại hôm nay."]}]}]},{"tag":"div","props":{"className":"daily-sync"},"children":[{"tag":"p","props":{},"children":["Được lưu trong trình duyệt này. Sau khi đăng nhập, các lần kiểm tra mới sẽ đồng bộ với tài khoản của bạn. Các bản ghi địa phương cũ vẫn ở đây và không được tính vào bảng xếp hạng công khai."]},{"tag":"button","props":{"type":"button","className":"life-text-link"},"children":["Đăng nhập để đồng bộ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"14","height":"14","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]}]},{"tag":"section","props":{"className":"daily-panel daily-leaderboard"},"children":[{"tag":"div","props":{"className":"daily-section-heading"},"children":[{"tag":"div","props":{},"children":[{"tag":"div","props":{"className":"life-eyebrow"},"children":["MỘT LẦN, THƯỜNG"]},{"tag":"h2","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"25","height":"25","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-trophy","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M6 9H4.5a2.5 2.5 0 0 1 0-5H6"},"children":[]},{"tag":"path","props":{"d":"M18 9h1.5a2.5 2.5 0 0 0 0-5H18"},"children":[]},{"tag":"path","props":{"d":"M4 22h16"},"children":[]},{"tag":"path","props":{"d":"M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22"},"children":[]},{"tag":"path","props":{"d":"M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22"},"children":[]},{"tag":"path","props":{"d":"M18 2H6v7a6 6 0 0 0 12 0V2Z"},"children":[]}]},"Tiếp tục xuất hiện, cùng nhau"]},{"tag":"p","props":{},"children":["Top 50 theo tổng số ngày, chuỗi ngày hiện tại hoặc số ngày trong tháng này. Những người có cùng số ngày sẽ chia sẻ hạng. Độ khó và tốc độ không ảnh hưởng đến điểm số của bạn."]}]}]},{"tag":"div","props":{"className":"daily-rank-grid"},"children":[{"tag":"div","props":{},"children":[{"tag":"p","props":{"role":"status"},"children":["Đang tải bản ghi..."]}]},{"tag":"div","props":{"className":"daily-join"},"children":[{"tag":"a","props":{"className":"life-button dark","href":"/vi/sign-in?callbackUrl=%2Fdaily"},"children":["Đăng nhập để tham gia bảng xếp hạng tùy chọn",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]},{"tag":"p","props":{"className":"daily-small"},"children":["Việc tham gia là tùy chọn. Chỉ biệt danh và số ngày (tổng, chuỗi và tháng này) của bạn được công khai. Bạn có thể rời khỏi bất kỳ lúc nào và giữ lại các bản ghi của mình."]}]}]}]},{"tag":"div","props":{"className":"page-guide"},"children":[{"tag":"section","props":{"aria-labelledby":"daily-about-title"},"children":[{"tag":"div","props":{"className":"life-eyebrow"},"children":["Về các công việc hàng ngày"]},{"tag":"h2","props":{"id":"daily-about-title"},"children":["Các công việc hàng ngày là gì?"]},{"tag":"p","props":{},"children":["Các công việc hàng ngày là những hành động nhỏ, miễn phí, mất 1 đến 5 phút, như đi bộ ba phút, tắt một thông báo bạn không cần, hoặc để ngày mai là điểm bắt đầu. Có tổng cộng 30 công việc như vậy; mỗi ngày chọn một ngẫu nhiên và đánh dấu là đã làm khi hoàn thành."]},{"tag":"p","props":{},"children":["Chúng phù hợp với bất kỳ ai chưa quyết định lời khuyên nào để bắt đầu, hoặc muốn xây dựng một thói quen nhỏ trước. Các công việc là những gợi ý thực hành mà trang này thiết kế xung quanh các chủ đề của sách, không phải trích dẫn từ sách; mỗi thẻ liên kết đến một chủ đề liên quan nếu bạn muốn xem bằng chứng đằng sau nó."]}]},{"tag":"section","props":{"className":"page-guide-faq","aria-labelledby":"daily-faq-title"},"children":[{"tag":"h2","props":{"id":"daily-faq-title"},"children":["Câu hỏi thường gặp về các công việc hàng ngày"]},{"tag":"details","props":{},"children":[{"tag":"summary","props":{},"children":["Tôi có cần đăng nhập không?"]},{"tag":"p","props":{},"children":["Không. Các lần kiểm tra sẽ được lưu trữ trong trình duyệt mặc định. Một lần bạn đăng nhập, các lần kiểm tra mới sẽ đồng bộ hóa vào tài khoản của bạn và theo bạn đến các thiết bị khác."]}]},{"tag":"details","props":{},"children":[{"tag":"summary","props":{},"children":["Bỏ qua một ngày có làm mất hết mọi thứ không?"]},{"tag":"p","props":{},"children":["Không. Tổng số ngày của bạn sẽ được giữ lại; chỉ chuỗi ngày hiện tại bắt đầu lại. Các ngày trống là hoàn toàn ổn, và hôm nay là một ngày tốt để bắt đầu."]}]},{"tag":"details","props":{},"children":[{"tag":"summary","props":{},"children":["Bảng xếp hạng cho biết điều gì?"]},{"tag":"p","props":{},"children":["Tham gia là tùy chọn và yêu cầu đăng nhập. Nó chỉ hiển thị tên biệt danh bạn chọn và tổng số ngày của bạn, không bao giờ là các công việc của bạn. Bạn có thể rời khỏi bất kỳ lúc nào và giữ lại bản ghi riêng của mình."]}]},{"tag":"details","props":{},"children":[{"tag":"summary","props":{},"children":["Tôi có thể kiểm tra bao nhiêu lần mỗi ngày?"]},{"tag":"p","props":{},"children":["Mỗi ngày chỉ được tính một lần. Thay đổi công việc không 