olor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"返回目录"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["恋爱和结婚划不划算"]},{"tag":"div","props":{"data-ad-dock-host":"true"},"children":[]},{"tag":"nav","props":{"aria-label":"章节条目"},"children":[{"tag":"a","props":{"href":"/tip/10-01"},"children":[{"tag":"span","props":{},"children":["01"]},"认识更多人，而不是死磕一个：两个人合不合得来，见面之前预测不出来"]},{"tag":"a","props":{"href":"/tip/10-02"},"children":[{"tag":"span","props":{},"children":["02"]},"对方明确拒绝之后就停下，继续纠缠是治安违法，不是「诚意」"]},{"tag":"a","props":{"href":"/tip/10-03"},"children":[{"tag":"span","props":{},"children":["03"]},"判断对方有没有兴趣，看行为不看「信号」：谁主动、谁安排、谁跟进"]},{"tag":"a","props":{"href":"/tip/10-04"},"children":[{"tag":"span","props":{},"children":["04"]},"关系好不好，主要看你自己在这段关系里的感受，不是看对方条件"]},{"tag":"a","props":{"href":"/tip/10-05"},"children":[{"tag":"span","props":{},"children":["05"]},"想拉近距离就轮流回答一组由浅入深的问题，别学话术"]},{"tag":"a","props":{"href":"/tip/10-06"},"children":[{"tag":"span","props":{},"children":["06"]},"异地恋不比同城差，真正的坎是搬到一起之后的头三个月"]},{"tag":"a","props":{"href":"/tip/10-07"},"children":[{"tag":"span","props":{},"children":["07"]},"先看登记数据再听长辈：结婚率、离婚率各是什么口径"]},{"tag":"a","props":{"href":"/tip/10-08"},"children":[{"tag":"span","props":{},"children":["08"]},"把结婚的健康收益算进去，但按观察性数据打折"]},{"tag":"a","props":{"href":"/tip/10-09"},"children":[{"tag":"span","props":{},"children":["09"]},"时间账按「无酬劳动」算，谈清分工再领证"]},{"tag":"a","props":{"href":"/tip/10-10"},"children":[{"tag":"span","props":{},"children":["10"]},"结婚的钱账先看法律默认规则，再决定要不要书面约定"]},{"tag":"a","props":{"href":"/tip/10-11"},"children":[{"tag":"span","props":{},"children":["11"]},"父母出资买房，在转账的时候就把是借是送写清楚"]},{"tag":"a","props":{"href":"/tip/10-12"},"children":[{"tag":"span","props":{},"children":["12"]},"配偶一方大额借的钱，你没签字也没追认，不自动变成你的债"]},{"tag":"a","props":{"href":"/tip/10-13"},"children":[{"tag":"span","props":{},"children":["13"]},"领证只要身份证加一份签字声明，不用户口簿，不收钱，当场发证"]},{"tag":"a","props":{"href":"/tip/10-14"},"children":[{"tag":"span","props":{},"children":["14"]},"婚前做一次婚检，有重大疾病必须在登记前如实告诉对方"]},{"tag":"a","props":{"href":"/tip/10-15"},"children":[{"tag":"span","props":{},"children":["15"]},"算退出成本：协议离婚有 30 天冷静期，诉讼离婚有法定条件"]},{"tag":"a","props":{"href":"/tip/10-16"},"children":[{"tag":"span","props":{},"children":["16"]},"给「为长辈结婚」单独记一笔账，别和自己的账混在一起"]},{"tag":"a","props":{"href":"/tip/10-17"},"children":[{"tag":"span","props":{},"children":["17"]},"把关系好坏当成一笔健康账：吵架对事不对人，别骂人、别挖苦"]},{"tag":"a","props":{"href":"/tip/10-18"},"children":[{"tag":"span","props":{},"children":["18"]},"同性伴侣趁两个人都清醒，办好授权委托、意定监护和遗嘱：法律上你们不是近亲属，不办就没有签字权和继承权"]},{"tag":"a","props":{"href":"/tip/10-19"},"children":[{"tag":"span","props":{},"children":["19"]},"别靠隐瞒性取向结婚，也别把形婚当成省事的办法：法律上它就是一段真婚姻，想退出只能走离婚"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/tip/10-20","data-status":"active"},"children":[{"tag":"span","props":{},"children":["20"]},"关系卡在反复吵架和冷战里，两个人一起去做伴侣治疗：干等着基本不会自己好"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"当前位置"},"children":[{"tag":"a","props":{"href":"/book"},"children":["阅读全书"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/book/10"},"children":["第 10 章"," ·"," ","恋爱和结婚划不划算"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"10-20"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["20"]},{"tag":"span","props":{"className":"life-evidence grade-a（争议）"},"children":["证据"," ","A（争议）"]}]},{"tag":"h1","props":{"lang":"zh"},"children":["关系卡在反复吵架和冷战里，两个人一起去做伴侣治疗：干等着基本不会自己好"]},{"tag":"p","props":{"lang":"zh","className":"life-entry-summary"},"children":["关系卡住的伴侣一起做完伴侣治疗，对这段关系明显满意多了，大约七成有好转。光排队干等的伴侣，基本没变化。但效果会变淡：跟到第 5 年，约一半还明显好着，约四分之一已经分居或离婚。"]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["成本"]},{"tag":"p","props":{},"children":["要花钱。按次收费，各地各医院不一样，本条不写数字。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["收益"]},{"tag":"p","props":{},"children":["2020 年一项荟萃分析汇总了 58 项研究、2092 对伴侣。做完伴侣治疗，关系满意度的前后变化 g = 1.12（可信范围 0.92–1.31），作者说是大效应。"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"标记：关系卡在反复吵架和冷战里，两个人一起去做伴侣治疗：干等着基本不会自己好"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"已做到"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"加入待做"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"收藏"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"分享这条建议"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"收起详情"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["成本"]},{"tag":"p","props":{},"children":["要花钱。按次收费，各地各医院不一样，本条不写数字。研究里一般每周去一次，一项试验前后做了约 8 个月。难在两个人都得去，还得坚持做完。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["收益"]},{"tag":"p","props":{},"children":["2020 年一项荟萃分析汇总了 58 项研究、2092 对伴侣。做完伴侣治疗，关系满意度的前后变化 g = 1.12（可信范围 0.92–1.31），作者说是大效应。g 是效应量，见 README 术语表。分到排队等候的伴侣，同一段时间 g = 0.12（−0.04 到 0.29），没有明显改善。开始时关系越差的，改善反而越多。2012 年一篇综述写的是，伴侣治疗让 70% 接受治疗的伴侣有好转。另一项随机试验找了 134 对长期、严重不和的夫妻，做了约 8 个月的两种行为伴侣治疗。做完时满意度变化 d = 0.90 和 0.71。到第 5 年，两种做法分别有 50.0% 和 45.9% 的夫妻仍有明显好转。这里的明显好转，作者叫「有临床意义的改善」。同时有 25.7% 和 27.9% 已经分居或离婚"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["原始出处"]},{"tag":"p","props":{"className":"life-citations"},"children":["Roddy MK, Walsh LM, Rothman K, Hatch SG, Doss BD (2020). Meta-analysis of couple therapy: effects across outcomes, designs, timeframes, and other moderators. Journal of Consulting and Clinical Psychology, 88(7), 583-596. ",{"tag":"a","props":{"href":"https://doi.org/10.1037/ccp0000514","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1037/ccp0000514"]},"；Lebow JL, Chambers AL, Christensen A, Johnson SM (2012). Research on the treatment of couple distress. Journal of Marital and Family Therapy, 38(1), 145-168. ",{"tag":"a","props":{"href":"https://doi.org/10.1111/j.1752-0606.2011.00249.x","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1111/j.1752-0606.2011.00249.x"]},"；Christensen A, Atkins DC, Baucom B, Yi J (2010). Marital status and satisfaction five years following a randomized clinical trial comparing traditional versus integrative behavioral couple therapy. Journal of Consulting and Clinical Psychology, 78(2), 225-235. ",{"tag":"a","props":{"href":"https://doi.org/10.1037/a0018132","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1037/a0018132"]},"；Rathgeber M, Bürkner PC, Schiller EM, Holling H (2019). The efficacy of emotionally focused couples therapy and behavioral couples therapy: a meta-analysis. Journal of Marital and Family Therapy, 45(3), 447-463. ",{"tag":"a","props":{"href":"https://doi.org/10.1111/jmft.12336","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1111/jmft.12336"]},"（争议方）；Shadish WR, Baldwin SA (2003). Meta-analysis of MFT interventions. Journal of Marital and Family Therapy, 29(4), 547-570. ",{"tag":"a","props":{"href":"https://doi.org/10.1111/j.1752-0606.2003.tb01694.x","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1111/j.1752-0606.2003.tb01694.x"]},"（争议方）；Karakurt G, Whiting K, van Esch C, Bolen SD, Calabrese JR (2016). Couples therapy for intimate partner violence: a systematic review and meta-analysis. Journal of Marital and Family Therapy, 42(4), 567-583. ",{"tag":"a","props":{"href":"https://doi.org/10.1111/jmft.12178","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1111/jmft.12178"]},"；全国人大常委会 (2018 修正). 精神卫生法（第二十三、五十一条）. ",{"tag":"a","props":{"href":"https://flk.npc.gov.cn/detail?id=2c909fdd678bf17901678bf7448a066d","target":"_blank","rel":"noopener noreferrer"},"children":["https://flk.npc.gov.cn/detail?id=2c909fdd678bf17901678bf7448a066d"]},"（国家法律法规数据库）"]},{"tag":"a","props":{"href":"https://doi.org/10.1037/ccp0000514","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["打开来源链接"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["原书备注"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["争议在效果能保持多久。只收随机试验的另一项荟萃分析里，做完时 g = 0.60，半年后 0.44。到 12 个月只剩行为伴侣治疗有数据，g = 0.06，几乎没保住。另一篇汇总 20 项荟萃分析的综述说，有临床意义的效果出现在 40% 到 50% 的人身上。「七成好转」和「四到五成明显好转」用的标准不一样，别混着比。5 年那项试验没有不做治疗的对照，所以说不清离婚是变多还是变少了。2020 年那项汇总的全是异性伴侣，本条也没有找到国内的随机试验，套到自己身上要打折。国内去哪做：精神卫生法规定心理治疗要在医疗机构里做，心理咨询人员不得做心理治疗。可以去医院的精神科、心理科问有没有夫妻治疗。在医院外找机构，先问清对方的资质和受过什么训练。有家暴的先别一起做。2016 年那项荟萃分析写明，结论只适用于轻到中度、双方因冲突动手的情况。以控制对方、严重伤害为特征的暴力不在其内。业内也担心谈完回家遭报复。被打了先看第 8 节第 43 条（被家暴了）。吵架时怎么说话见本节第 17 条（吵架对事不对人），想清楚要不要走见本节第 15 条（退出成本）。受益人是你自己和配偶。"]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["我的备注"]},{"tag":"button","props":{"type":"button"},"children":["写下对自己有用的提醒…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/tip/10-19"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["上一条"]},"别靠隐瞒性取向结婚，也别把形婚当成省事的办法：法律上它就是一段真婚姻，想退出只能走离婚"]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["本主题的其他建议"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/10-13"},"children":[{"tag":"strong","props":{},"children":["领证只要身份证加一份签字声明，不用户口簿，不收钱，当场发证"]},{"tag":"span","props":{},"children":["2025 年 5 月起领证只要两样东西：本人身份证，加一份签字声明。声明里写明本人没有配偶，和对方没有直系血亲、三代以内旁系血亲关系。户口…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/10-14"},"children":[{"tag":"strong","props":{},"children":["婚前做一次婚检，有重大疾病必须在登记前如实告诉对方"]},{"tag":"span","props":{},"children":["有重大疾病，没在登记前如实告诉对方，对方可以去法院请求撤销这段婚姻。要在知道之日起一年内提出。婚检本身从 2003 年起就不是领证的前置条…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/10-15"},"children":[{"tag":"strong","props":{},"children":["算退出成本：协议离婚有 30 天冷静期，诉讼离婚有法定条件"]},{"tag":"span","props":{},"children":["协议离婚不是签完就完。交了申请后 30 天内，任何一方都能撤回。期满还要在 30 天内两人亲自去领离婚证，不去就当撤回。对方不同意，只能起…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/10-16"},"children":[{"tag":"strong","props":{},"children":["给「为长辈结婚」单独记一笔账，别和自己的账混在一起"]},{"tag":"span","props":{},"children":["长辈那份收益，也就是安心、面子、不再催，是真的。但它不会自动变成你的健康收益或关系质量。而时间账、钱账和退出成本这三笔，全部由你自己承担。…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/10-17"},"children":[{"tag":"strong","props":{},"children":["把关系好坏当成一笔健康账：吵架对事不对人，别骂人、别挖苦"]},{"tag":"span","props":{},"children":["夫妻关系好的，身体好一些，死亡风险也低一些。这个关联不大，和饮食对健康的关联差不多大。一项实验里，吵架时一直带着敌意的夫妻，实验做出的小伤…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/10-18"},"children":[{"tag":"strong","props":{},"children":["同性伴侣趁两个人都清醒，办好授权委托、意定监护和遗嘱：法律上你们不是近亲属，不办就没有签字权和继承权"]},{"tag":"span","props":{},"children":["法律上的近亲属是配偶、父母、子女、兄弟姐妹这些人，伴侣不算。不提前办文件，一方病重时，另一方替他做不了主。一方去世时，另一方一分遗产也继承…"]}]}]}]},{"tag":"a","props":{"className":"life-text-link","href":"/book/10"},"children":["阅读整个主题：恋爱和结婚划不划算"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"15","height":"15","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right