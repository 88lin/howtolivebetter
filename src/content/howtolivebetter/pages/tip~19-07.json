eft","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["上一条"]},"公司违法解除的，赔偿金是经济补偿标准的二倍"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/tip/19-08"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["下一条"]},"离职前把工资条、考勤、劳动合同、社保记录和聊天记录先存下来"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["本主题的其他建议"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/19-03"},"children":[{"tag":"strong","props":{},"children":["试用期有法定上限、工资不得低于 80%，而且只能约定一次"]},{"tag":"span","props":{},"children":["合同签 1 年以内的，试用期最多 1 个月。签 1 到 3 年的最多 2 个月。签 3 年以上的最多 6 个月。同一家公司只能试用你一次，转正后调个岗再来一次是…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/19-04"},"children":[{"tag":"strong","props":{},"children":["被裁先算清 N：每满一年一个月工资，不满六个月按半个月"]},{"tag":"span","props":{},"children":["被裁时公司要给的经济补偿这样算：干满一年给一个月工资，满半年不满一年按一年算，不满半年给半个月。这里的月工资是走人前 12 个月的平均数，奖金、津贴、补贴都要算…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/19-05"},"children":[{"tag":"strong","props":{},"children":["公司辞退你没提前 30 天通知，还要多付一个月工资"]},{"tag":"span","props":{},"children":["公司因为你病后干不了、干不了工作或者情况大变而辞退你，没有提前 30 天书面通知，要在 N 之外再多给一个月工资，这就是常说的 N+1。谈的时候把这一个月单独列…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/19-09"},"children":[{"tag":"strong","props":{},"children":["进有粉尘、噪声、化学品的岗位之前，先看合同里写没写危害；三次职业健康检查由单位安排并掏钱"]},{"tag":"span","props":{},"children":["签合同时，单位必须把岗位有什么职业病危害、怎么防护、有什么待遇如实写进合同。瞒了你，你可以拒绝干这个活，单位不能因此辞退你。上岗前、在岗时、离岗时三次职业健康检…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/19-10"},"children":[{"tag":"strong","props":{},"children":["粉尘、噪声、化学毒物造成的损伤不可逆：防护用品单位必须给，没有防护措施的作业可以拒绝"]},{"tag":"span","props":{},"children":["尘肺、噪声聋、化学性眼灼伤都是法定职业病，肺和听力坏了就治不回来。你有权知道岗位有什么危害，有权要单位给防护设施和防护用品。没有防护的活你可以不干。单位因此给你…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/19-11"},"children":[{"tag":"strong","props":{},"children":["上班受伤、上下班路上被撞，第一件事是做工伤认定，单位不报你自己报"]},{"tag":"span","props":{},"children":["上班受伤算工伤。上下班路上被撞、主要责任不在你的，也算工伤。但不做工伤认定，医药费、养伤期间照发的工资、伤残补助金就全部落空。单位应当在 30 天内申报。单位不…"]}]}]}]},{"tag":"a","props":{"className":"life-text-link","href":"/book/19"},"children":["阅读整个主题：在职、离职和工伤 ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"15","height":"15","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]}]}]}]},{"tag":"aside","props":{"className":"life-ad-space life-ad-space-sponsored","data-ad-placement":"ad_footer","data-ad-group":"reading","data-ad-creative":"read_product","data-ad-ready":"false","aria-label":"广告 · 社区推荐"},"children":[{"tag":"div","props":{"className":"life-ad-space-brand"},"children":[{"tag":"img","props":{"src":"/sites/howtolivebetter/images/shengcai/logo.png","width":"565","height":"144","alt":"生财有术官方 Logo","decoding":"async"},"children":[]}]},{"tag":"div","props":{"className":"life-ad-space-copy"},"children":[{"tag":"span","props":{"className":"life-ad-space-label"},"children":["广告 · 社区推荐"]},{"tag":"strong","props":{},"children":["读过的知识，能不能做成有用的产品？"]},{"tag":"p","props":{},"ch