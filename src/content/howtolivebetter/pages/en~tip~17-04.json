ref":"/en/book/17"},"children":["Chapter 17"," ·"," ","Having elderly family members at home"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"17-04"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["04"]},{"tag":"span","props":{"className":"life-evidence grade-b"},"children":["Evidence"," ","B"]}]},{"tag":"h1","props":{"lang":"en"},"children":["A ready-made phrase for seniors to deflect unwanted offers"]},{"tag":"p","props":{"lang":"en","className":"life-entry-summary"},"children":["Sales pitches and scams use on-the-spot pressure to make you pay before thinking. Excited people are more susceptible to exaggerated advertising, and older people are more susceptible than younger people. Agree in advance on ‘I need to go home and discuss this with my family’. It gives the older person a ready way out and time to decide calmly at home."]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Cost"]},{"tag":"p","props":{},"children":["No cost at all. It only takes a few minutes to discuss thi…"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Benefit"]},{"tag":"p","props":{},"children":["Sales pitches and scams rely on immediate pressure. The US Federal Trade Commission's fraud guide says scammer…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"Mark: A ready-made phrase for seniors to deflect unwanted offers"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"Done"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"Plan to do"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"Save"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Share this tip"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Hide details"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Cost"]},{"tag":"p","props":{},"children":["No cost at all. It only takes a few minutes to discuss this with the senior once."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Benefit"]},{"tag":"p","props":{},"children":["Sales pitches and scams rely on immediate pressure. The US Federal Trade Commission's fraud guide says scammers want action before you have time to think. On the phone they tell you not to hang up so you cannot verify their claims. The guide advises telling someone first—a friend, family member or neighbor; saying it aloud may reveal the scam. China's former banking and insurance regulator likewise advised older people in a 2021 warning to consult family before buying financial products. One experiment recruited 116 people aged 65 to 85 and 115 aged 30 to 40. A win-or-lose game aroused some participants emotionally before they viewed misleading exaggerated advertisements. Those actually aroused were more willing to buy. Regardless of arousal, older participants were more willing than younger participants. The authors recommended waiting until emotions settled before spending. Another experiment involved previous victims of mail fraud, mostly older people. Without a prior warning, nearly half immediately agreed during a simulated fraudulent sales call. Those warned by phone 2 to 4 weeks beforehand were significantly less likely to agree immediately. Agreeing on ‘I need to go home and discuss this with my family’ provides a graceful exit without deciding on the spot."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Original sources"]},{"tag":"p","props":{"className":"life-citations"},"children":["Federal Trade Commission (2023). How To Avoid a Scam. ",{"tag":"a","props":{"href":"https://consumer.ftc.gov/articles/how-avoid-scam","target":"_blank","rel":"noopener noreferrer"},"children":["https://consumer.ftc.gov/articles/how-avoid-scam"]},"；中国银保监会消费者权益保护局 (2021). 关于警惕「投资养老」「以房养老」金融诈骗的风险提示（2021 年第三期）. ",{"tag":"a","props":{"href":"https://dfjrjgj.hunan.gov.cn/dfjrjgj/yhlj/202106/t20210608_19450856.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://dfjrjgj.hunan.gov.cn/dfjrjgj/yhlj/202106/t20210608_19450856.html"]},"（湖南省地方金融监督管理局转载）；Kircanski K, Notthoff N, DeLiema M, et al. (2018). Emotional arousal may increase susceptibility to fraud in older and younger adults. Psychology and Aging, 33(2), 325-337. ",{"tag":"a","props":{"href":"https://doi.org/10.1037/pag0000228","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1037/pag0000228"]},"；Scheibe S, Notthoff N, Menkin J, et al. (2014). Forewarning reduces fraud susceptibility in vulnerable consumers. Basic and Applied Social Psychology, 36(3), 272-279. ",{"tag":"a","props":{"href":"https://doi.org/10.1080/01973533.2014.903844","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1080/01973533.2014.903844"]}]},{"tag":"a","props":{"href":"https://consumer.ftc.gov/articles/how-avoid-scam","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Open source link"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Book note"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["Rated B because neither experiment tested this phrase itself. One tested willingness to buy under emotional arousal; the other tested advance warnings. No study compared fraud losses among older people prepared with this phrase. Use it with item 3 (keep older people's money in a separate account). Also make home fall-prevention changes; see Section 1. The phrase gives the older person a way out without having to resist on the spot; it is not a device for controlling them. Surrounded by salespeople, refusing before a roomful of people can be harder than judging truthfulness."]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["My note"]},{"tag":"button","props":{"type":"button"},"children":["Write a reminder for yourself…"]}]}]}]},{"tag":"nav","props":{"className