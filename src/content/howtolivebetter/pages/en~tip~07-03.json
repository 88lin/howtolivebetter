0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-up-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M7 7h10v10"},"children":[]},{"tag":"path","props":{"d":"M7 17 17 7"},"children":[]}]}]}]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/en/book/07"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"Back to index"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["How to get by when you have little money"]},{"tag":"div","props":{"data-ad-dock-host":"true"},"children":[]},{"tag":"nav","props":{"aria-label":"Chapter entries"},"children":[{"tag":"a","props":{"href":"/en/tip/07-01"},"children":[{"tag":"span","props":{},"children":["01"]},"Apply online for unemployment benefits if you’ve lost your job"]},{"tag":"a","props":{"href":"/en/tip/07-02"},"children":[{"tag":"span","props":{},"children":["02"]},"First file a complaint with the Human Resources and Social Security Bureau, then apply for final and binding one-instance arbitration — both options are free, and most cases yield results within a few months"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/en/tip/07-03","data-status":"active"},"children":[{"tag":"span","props":{},"children":["03"]},"If you can’t afford legal fees, apply for free legal aid – cases involving unpaid wages, alimony, or workplace injuries all qualify"]},{"tag":"a","props":{"href":"/en/tip/07-04"},"children":[{"tag":"span","props":{},"children":["04"]},"When you have nowhere else to turn, go to a shelter – they provide food, lodging, and even a ticket home"]},{"tag":"a","props":{"href":"/en/tip/07-05"},"children":[{"tag":"span","props":{},"children":["05"]},"Use free public employment services and gig platforms first — avoid paid agencies"]},{"tag":"a","props":{"href":"/en/tip/07-06"},"children":[{"tag":"span","props":{},"children":["06"]},"Apply for emergency assistance when unexpected crises occur"]},{"tag":"a","props":{"href":"/en/tip/07-07"},"children":[{"tag":"span","props":{},"children":["07"]},"Apply for dibao if your household income falls below the local threshold"]},{"tag":"a","props":{"href":"/en/tip/07-08"},"children":[{"tag":"span","props":{},"children":["08"]},"Apply for the two disability subsidies using a disability certificate"]},{"tag":"a","props":{"href":"/en/tip/07-09"},"children":[{"tag":"span","props":{},"children":["09"]},"Do not miss the annual 400‑yuan payment for basic medical insurance; subsidies are available for low‑income households"]},{"tag":"a","props":{"href":"/en/tip/07-10"},"children":[{"tag":"span","props":{},"children":["10"]},"When suffering from a serious illness, first use yibao, dibao, medical assistance, and register for cross‑regional treatment — avoid online loans"]},{"tag":"a","props":{"href":"/en/tip/07-11"},"children":[{"tag":"span","props":{},"children":["11"]},"Replace a lost ID card immediately; get a temporary ID if you need it urgently"]},{"tag":"a","props":{"href":"/en/tip/07-12"},"children":[{"tag":"span","props":{},"children":["12"]},"After registering as unemployed, seek recognition as a person facing employment difficulties to receive social insurance subsidies or placement in public-interest jobs"]},{"tag":"a","props":{"href":"/en/tip/07-13"},"children":[{"tag":"span","props":{},"children":["13"]},"Apply for vocational training subsidies, employment internship subsidies, and social insurance subsidies during unemployment — don’t pay for training courses out of pocket"]},{"tag":"a","props":{"href":"/en/tip/07-14"},"children":[{"tag":"span","props":{},"children":["14"]},"Job hunting isn’t just about sending resumes — use a systematic approach: learn skills, set goals, and ask for help"]},{"tag":"a","props":{"href":"/en/tip/07-15"},"children":[{"tag":"span","props":{},"children":["15"]},"No deposits, no ID retention, no “training loans”, no pyramid schemes, no usurious loans"]},{"tag":"a","props":{"href":"/en/tip/07-16"},"children":[{"tag":"span","props":{},"children":["16"]},"Public rental housing for those with housing difficulties"]},{"tag":"a","props":{"href":"/en/tip/07-17"},"children":[{"tag":"span","props":{},"children":["17"]},"Keep food and housing costs to a minimum: opt for monthly shared housing instead of daily rentals, and cook at home or use senior meal services rather than ordering takeout"]},{"tag":"a","props":{"href":"/en/tip/07-18"},"children":[{"tag":"span","props":{},"children":["18"]},"Don’t panic if your social insurance lapses: pension is calculated cumulatively, medical insurance is restored per rules"]},{"tag":"a","props":{"href":"/en/tip/07-19"},"children":[{"tag":"span","props":{},"children":["19"]},"Even those who have served time, filed for bankruptcy, or ended up on a blacklist still have legal avenues to start over — provided they complete all required procedures"]},{"tag":"a","props":{"href":"/en/tip/07-20"},"children":[{"tag":"span","props":{},"children":["20"]},"Before facing a serious illness, consider adding a one‑year medical or critical‑illness policy to your basic medical insurance; make sure it includes the phrase “guaranteed renewal”"]},{"tag":"a","props":{"href":"/en/tip/07-21"},"children":[{"tag":"span","props":{},"children":["21"]},"If there’s nowhere else to sleep, 24‑hour venues can only serve as a temporary overnight stop; shelters should be the first choice"]},{"tag":"a","props":{"href":"/en/tip/07-22"},"children":[{"tag":"span","props":{},"children":["22"]},"If wages are owed to you, first figure out who actually employed you: unlicensed workshops and labor subcontractors still go through labor inspection; only work for a household or individual as a private helper belongs in court"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"Breadcrumb"},"children":[{"tag":"a","props":{"href":"/en/book"},"children":["Explore the book"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/en/book/07"},"children":["Chapter 7"," ·"," ","How to get by when you have little money"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"07-03"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["03"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["Evidence"," ","A"]}]},{"tag":"h1","props":{"lang":"en"},"children":["If you can’t afford legal fees, apply for free legal aid – cases involving unpaid wages, alimony, or workplace injuries all qualify"]},{"tag":"p","props":{"lang":"en","className":"life-entry-summary"},"children":["If you’re trying to recover unpaid wages, claim alimony, secure social insurance or dibao benefits, or seek compensation after acting in defense of others, you’re eligible for free legal aid. Just call 12348 or visit your local legal aid center. Since 2022, you no longer need to return to your hometown to obtain proof of financial hardship – a simple, honest statement of your financial situation is enough. For defendants facing the death penalty, or those who are blind, deaf, mute, or minors, a lawyer is assigned regardless of their financial status."]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Cost"]},{"tag":"p","props":{},"children":["Zero. Legal aid costs nothing for those who receive it."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Benefit"]},{"tag":"p","props":{},"children":["The State Council’s regulations explicitly list six categories of civil cases covered by legal aid. They read:…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"Mark: If you can’t afford legal fees, apply for free legal aid – cases involving unpaid wages, alimony, or workplace injuries all qualify"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"Done"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"Plan to do"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"Save"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Share this tip"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Hide details"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Cost"]},{"tag":"p","props":{},"children":["Zero. Legal aid costs nothing for those who receive it."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Benefit"]},{"tag":"p","props":{},"children":["The State Council’s regulations explicitly list six categories of civil cases covered by legal aid. They read: “Requests for state compensation; claims for social insurance or dibao benefits; applications for pensions or relief funds; demands for alimony, child support, or spousal maintenance; claims for unpaid labor wages; and cases involving civil rights resulting from acts of civic courage.” In short, this covers all the above situations. In criminal cases, defendants facing the death penalty, as well as blind, deaf, mute, and minor defendants, are all guaranteed a lawyer regardless of their financial standing."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Original sources"]},{"tag":"p","props":{"className":"life-citations"},"children":["国务院 (2003). 法律援助条例（国令第 385 号，第十条、第十一条、第十二条）. ",{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/2008-03/28/content_6944.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/zhengce/zhengceku/2008-03/28/content_6944.htm"]},"；司法部有关负责人 (2021). 就贯彻实施法律援助法答记者问. ",{"tag":"a","props":{"href":"http://www.gov.cn/zhengce/2021-12/29/content_5665114.htm","target":"_blank","rel":"noopener noreferrer"},"children":["http://www.gov.cn/zhengce/2021-12/29/content_5665114.htm"]}]},{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/2008-03/28/content_6944.htm","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Open source link"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/20