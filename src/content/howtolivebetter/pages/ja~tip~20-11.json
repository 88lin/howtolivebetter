"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"お気に入り"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"このヒントを共有"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"詳細を閉じる"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["費用・手間"]},{"tag":"p","props":{},"children":["追加の出費は不要で、節約できる金額は通常、千元単位になります。難しいのは、一度にすべてを揃えたい気持ちを抑えることです"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["効果"]},{"tag":"p","props":{},"children":["ベビーカー、ベビーベッド、おくるみ、おもちゃは使用期間が短く、中古市場では供給が需要を大きく上回ります。ただし安全の境界が3つあります。第一はチャイルドシート。米国NHTSAは中度・重度の事故後は必ず交換し、再使用しないよう勧めます。軽微な事故は、車が自走可能、最も近いドアに損傷なし、車内に負傷者なし、エアバッグ未展開、シートに目に見える損傷なし、の5条件すべてを満たす場合です。中古の使用には、中度以上の事故歴なし、製造日と型番の表示あり、リコールなし、部品完備、説明書あり、の5点を確認します。日付と型番はリコールや古さの確認に使います。第二はマットレス。スコットランドの症例対照研究で、突然死した乳児と同年齢の健康な乳児の寝具をさかのぼって調べると、普段ほかの子が使ったマットレスで寝る乳児の乳幼児突然死症候群のオッズが高くなっていました（OR 3.07、約3倍、95% CI 1.51–6.22）。他の家庭からのものは4.78、自家のものは1.64で、後者には明確な差がありませんでした。著者はマットレスそのものが原因かを判断する証拠は不十分としています。第三はベビーベッド。米国では2011年6月28日から新しい強制基準が施行され、中古にも適用されます。片側の柵が上下する従来型は廃止されました。米国消費者製品安全委員会によると、古いベッドは破壊試験でなければ適合性を判定できず、自分で確認する方法は示せません。2007年11月〜2010年4月の米国では標準サイズのベッド関連死147件が報告され、35件は構造の問題、18件は上下式の柵の故障でした。ねじの緩みは少なくとも10件の死につながりました。米国法は傾斜型乳児用スリーパーを製造年にかかわらず販売禁止とし、2023年に規則へ明記しました（米国、英国）。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["出典"]},{"tag":"p","props":{"className":"life-citations"},"children":["省钱部分为作者经验，无直接文献；US NHTSA. Car Seat Use After a Crash. ",{"tag":"a","props":{"href":"https://www.nhtsa.gov/car-seats-and-booster-seats/car-seat-use-after-crash","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.nhtsa.gov/car-seats-and-booster-seats/car-seat-use-after-crash"]},"；US NHTSA. Used Car Seat Safety Checklist. ",{"tag":"a","props":{"href":"https://www.nhtsa.gov/car-seats-and-booster-seats/used-car-seat-safety-checklist","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.nhtsa.gov/car-seats-and-booster-seats/used-car-seat-safety-checklist"]},"；Tappin D, Brooke H, Ecob R, Gibson A (2002). Used infant mattresses and sudden infant death syndrome in Scotland: case-control study. BMJ, 325(7371), 1007. ",{"tag":"a","props":{"href":"https://doi.org/10.1136/bmj.325.7371.1007","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1136/bmj.325.7371.1007"]},"；Blair P, Fleming P, Smith I (1997). Case-control study of sudden infant death syndrome in Scotland. Income level or bed sharing would confound any effect of previous use of mattress. BMJ, 315(7111), 812. ",{"tag":"a","props":{"href":"https://doi.org/10.1136/bmj.315.7111.812a","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1136/bmj.315.7111.812a"]},"；US Consumer Product Safety Commission (2010). Safety Standards for Full-Size Baby Cribs and Non-Full-Size Baby Cribs; Final Rule. Federal Register 2010-32178. ",{"tag":"a","props":{"href":"https://www.federalregister.gov/documents/2010/12/28/2010-32178/safety-standards-for-full-size-baby-cribs-and-non-full-size-baby-cribs-final-rule","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.federalregister.gov/documents/2010/12/28/2010-32178/safety-standards-for-full-size-baby-cribs-and-non-full-size-baby-cribs-final-rule"]},"；US Consumer Product Safety Commission (2023). Ban of Inclined Sleepers for Infants. Federal Register 2023-17350. ",{"tag":"a","props":{"href":"https://www.federalregister.gov/documents/2023/08/16/2023-17350/ban-of-inclined-sleepers-for-infants","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.federalregister.gov/documents/2023/08/16/2023-17350/ban-of-inclined-sleepers-for-infants"]},"；冲动消费见第 5 节"]},{"tag":"a","props":{"href":"https://www.nhtsa.gov/car-seats-and-booster-seats/car-seat-use-after-crash","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["出典を開く"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["著者の注記"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["節約部分には文献がないため証拠等級はCのままです。安全の3条件には各出典がありますが、すべて米国・英国のものです。中国の中古ベッド・中古チャイルドシートに特化した公式注意喚起は見つかりませんでした。マットレス研究には異論があり、1997年の学者の書簡は世帯収入や添い寝が影響を交絡すると指摘しています。チャイルドシートの理由は第1節第10条、乳児の寝方と寝床の物は本節第1条を参照。産後ケア施設、早期教育教室、乳児スイミングは推奨も否定もしませんが、任意の大きな出費なので第5節の24時間の冷却期間を使ってください。"]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["自分のメモ"]},{"tag":"button","props":{"type":"button"},"children":["自分へのメモを書く…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/ja/tip/20-10"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["前へ"]},"おむつ選びはブランドではなく3つのポイントを見る：サイズ感、交換頻度、抜き打ち検査の通知歴"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/ja/tip/20-12"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["次へ"]},"重度の湿疹や卵アレルギーがある場合、ピーナッツを