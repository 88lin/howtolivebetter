rk","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"收藏"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"分享这条建议"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"收起详情"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["成本"]},{"tag":"p","props":{"className":"life-citations"},"children":["不花钱。要提前写好一份出事时的处置预案：谁拍板，先堵哪个口子，通知用户的话怎么写。难在出事那一刻的本能是捂住，不想让用户知道"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["收益"]},{"tag":"p","props":{"className":"life-citations"},"children":["个人信息保护法原话是「发生或者可能发生个人信息泄露、篡改、丢失的，个人信息处理者应当立即采取补救措施，并通知履行个人信息保护职责的部门和个人」。通知要写三样：泄露了哪类信息、原因和可能的危害；你做了什么补救、用户自己能做什么来减轻危害；你的联系方式。你的补救确实能避免危害的，可以不通知用户。但主管部门认为可能造成危害的，有权要求你通知。网络数据安全管理条例说，通知可以用「电话、短信、即时通信工具、电子邮件或者公告等方式」。处置时发现涉嫌犯罪线索的，要向公安机关、国家安全机关报案。不履行这些义务的，责令改正、警告、没收违法所得，违法的 App 可以被责令暂停或者终止服务。拒不改正的，罚 100 万元以下，直接负责的人罚 1 万到 10 万元。情节严重的，罚 5000 万元以下或者上一年营业额 5% 以下，负责人罚 10 万到 100 万元。民事上，用户因此受了损害，你「不能证明自己没有过错的，应当承担损害赔偿等侵权责任」。泄露规模大的还要按时报告。国家网信办的办法规定，泄露 100 万人以上个人信息算「较大网络安全事件」。这类事件，一般网站和 App 要向所在省的网信部门报告，「最迟不得超过4小时」，渠道之一是 12387 热线。处置结束后 30 日内还要交一份总结报告。迟报、漏报、谎报、瞒报造成重大危害后果的，从重处罚。反过来，已经采取合理必要的防护、按预案处置、并且及时报告的，「可视情从轻或不予追究」（全国，报告办法 2025 年 11 月起）"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["来源"]},{"tag":"p","props":{"className":"life-citations"},"children":["全国人大常委会 (2021). 个人信息保护法（第五十七、六十六、六十九条）. ",{"tag":"a","props":{"href":"https://www.spp.gov.cn/spp/fl/202108/t20210820_527244.shtml","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.spp.gov.cn/spp/fl/202108/t20210820_527244.shtml"]}," ; 全国人大常委会 (2025). 网络安全法（2025 年修正，2026 年 1 月 1 日施行，第二十七、四十四、七十一条；2016 年文本为第二十五、四十二条）. ",{"tag":"a","props":{"href":"https://www.cac.gov.cn/2025-12/29/c_1768735112911946.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.cac.gov.cn/2025-12/29/c_1768735112911946.htm"]}," ; 国务院 (2024). 网络数据安全管理条例（国务院令第 790 号，第十一条）. ",{"tag":"a","props":{"href":"https://www.gov.cn/gongbao/2024/issue_11646/202410/content_6980863.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/gongbao/2024/issue_11646/202410/content_6980863.html"]}," ; 国家互联网信息办公室 (2025). 国家网络安全事件报告管理办法（第四、八、九、十、十一条，附件《网络安全事件分级指南》）. ",{"tag":"a","props":{"href":"https://www.cac.gov.cn/2025-09/15/c_1759583017717009.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.cac.gov.cn/2025-09/15/c_1759583017717009.htm"]},""]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["原书备注"]},{"tag":"p","props":{"className":"life-citations"},"children":["小站泄露几百、几千人，也要按个人信息保护法补救和通知，只是达不到 4 小时报告那道门槛。通知用户时，把能做的事写具体：改哪个密码，提防冒充客服打来的电话。日志留够 6 个月，出事时才查得清是从哪里漏的，见第 11 节第 16 条（按等级保护要求留日志）。用户被泄露之后自己怎么防，见第 14 节"]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["我的备注"]},{"tag":"button","props":{"type":"button"},"children":["写下对自己有用的提醒…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/tip/26-11"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["上一条"]},"选服务器先看停机能不能忍，再看有没有人运维，最后才比价"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/tip/26-13"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["下一条"]},"卖自动续费会员的，开通前和每次扣钱前都要显著提醒用户，取消入口要好找"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["本主题的其他建议"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/26-03"},"children":[{"tag":"strong","props":{},"children":["做直播要网络文化经营许可证，做视听节目的那张证民营基本拿不到"]},{"tag":"span","props":{},"children":["做直播、做游戏解说，要省级文化部门发的网络文化经营许可证，经营范围里得写明网络表演。受理后 20 日内出结果，证管 3 年。播过的视频自己要留满 60 天。没办…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/26-04"},"children":[{"tag":"strong","props":{},"children":["服务器放境内就要备案，App 和小程序上架前也要备案，接入商必须自己持有增值电信许可"]},{"tag":"span","props":{},"children":["服务器放在境内，开站前就要备案，不花钱，一般几天到几周。没备案先责令改正、罚 1 万元，不改就关站。App 和小程序也要先备案，没备案的，应用商店和小程序平台不…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/26-05"},"children":[{"tag":"strong","props":{},"children":["让用户上来卖东西，平台就要核验登记、报送信息、留存三年"]},{"tag":"span","props":{},"children":["让别人上你的平台卖东西，你就要先核卖家的身份、地址、联系方式和许可证，再登记建档。建完档，至少每六个月回头再核一次。卖家是谁要报给市场监管，纳税的情况每季度报给…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/26-06"},"children":[{"tag":"strong","props":{},"children":["用户发的内容你要管：审核机制、举报入口、发现违法立即停传并报告"]},{"tag":"span","props":{},"children":["用户发的东西，平台要负责管，注册、发帖审核、评论审核、每天巡查、出事处置都要有制度。页面显眼的地方放举报入口。看到违法信息，马上停止传播、留好记录、报给主管部门…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/26-07"},"children":[{"tag":"strong","props":{},"children":["提供信息发布、即时通讯服务，必须要求用户提供真实身份信息"]},{"tag":"span","props":{},"children":["你的网站能发帖，或者能聊天，就要在用户开通服务时要他的真实身份信息。不给的，不能让他用。直播的规定是后台存真名，页面上显示什么昵称由他自己定，可以用手机号核验。…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/26-08"},"children":[{"tag":"strong","props":{},"children":["不给未满 16 周岁的人开直播，打赏按年龄分档处理"]},{"tag":"span","props":{},"children":["不满 16 周岁的人，不能在你这里注册开播账号。满 16 周岁的要核验身份，还要父母或其他监护人同意。打赏分三档：不满 8 岁不能打赏，8 到 16 岁要监护人…"]}]}]}]},{"tag":"a","props":{"className":"life-text-lin