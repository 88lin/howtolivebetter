idden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"收起详情"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["成本"]},{"tag":"p","props":{"className":"life-citations"},"children":["不花钱。签单位之前花半小时，把想考的那几场考试的公告找出来看一遍。难在各地说法不一样，要一场一场查。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["收益"]},{"tag":"p","props":{"className":"life-citations"},"children":["国考 2027 年度招考公告写着，中央机关的「市（地）级及以下直属机构主要招录应届高校毕业生」。同年度的报考指南第 3 问专门回答往届生算不算应届生。原文是：「国家统一招生的普通高校毕业生离校时和在择业期内（国家规定择业期为二年）未落实工作单位，其户口、档案、组织关系仍保留在原毕业学校，或者保留在各级毕业生就业主管部门（毕业生就业指导服务中心）、各级人才交流服务机构和各级公共就业服务机构的毕业生，可按应届高校毕业生对待」。择业期就是毕业后找工作的那两年。所以国考要同时满足两件事：两年里没落实工作单位，档案、户口和组织关系也没转到用人单位去。各省考试由省里自己定。福建 2023 年的通知写着：「当年度应届生签订就业协议、劳动合同、缴交社保等均不影响其应届生身份认定；上年度毕业生具有工作经历以及社保缴交记录的，可报考应届生岗位」。这一条管福建的公务员、事业单位、国企和央企在闽机构。重庆 2025 年的通知把两种考试分开写。考重庆的公务员，照搬国考上面那句原话。考重庆的事业单位和国企，只要两年内没被编制内岗位录用过，「其就业合同（协议）签订、工作经历、社保缴纳等情况不影响其报考」（全国，各省另定）"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["来源"]},{"tag":"p","props":{"className":"life-citations"},"children":["国家公务员局 (2026). 中央机关及其直属机构 2027 年度考试录用公务员公告，及同年度报考指南（第 3、11、21、48 问），铜仁市人民政府网转载. ",{"tag":"a","props":{"href":"https://www.trs.gov.cn/xwzx/tzgg/zkxx/202610/t20261013_90984626.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.trs.gov.cn/xwzx/tzgg/zkxx/202610/t20261013_90984626.html"]},"；国家公务员局 (2025). 中央机关及其直属机构 2026 年度考试录用公务员报考指南（第 3 问同文），北京市人民政府网转载. ",{"tag":"a","props":{"href":"https://www.beijing.gov.cn/fuwu/bmfw/sy/jrts/202510/t20251014_4222424.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.beijing.gov.cn/fuwu/bmfw/sy/jrts/202510/t20251014_4222424.html"]},"；中共福建省委组织部等四部门 (2023). 关于应届高校毕业生就业有关政策的通知（闽人社文〔2023〕84 号，第一条）. ",{"tag":"a","props":{"href":"https://rst.fujian.gov.cn/zw/zfxxgk/zfxxgkml/zyywgz/zynljs/202307/t20230706_6201113.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://rst.fujian.gov.cn/zw/zfxxgk/zfxxgkml/zyywgz/zynljs/202307/t20230706_6201113.htm"]},"；中共重庆市委组织部等四部门 (2025). 关于高校毕业生就业有关事项的通知（试行）（渝人社规〔2025〕5 号，第一、二、三条）. ",{"tag":"a","props":{"href":"https://rlsbj.cq.gov.cn/zwgk_182/zfxxgkml/zcwj_145360/jfxzgfxwj/202504/t20250418_14533212.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://rlsbj.cq.gov.cn/zwgk_182/zfxxgkml/zcwj_145360/jfxzgfxwj/202504/t20250418_14533212.html"]},"；中共中央组织部 (2019). 公务员录用规定（第四条）. ",{"tag":"a","props":{"href":"https://www.12371.cn/2020/01/08/ARTI1578447606460158.shtml","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.12371.cn/2020/01/08/ARTI1578447606460158.shtml"]},"（共产党员网刊登）"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["原书备注"]},{"tag":"p","props":{"className":"life-citations"},"children":["国考指南没写签了劳动合同、交了社保算不算「落实工作单位」。拿不准就打招考简章上那个招录机关的咨询电话问，指南第 21 问让考生直接找招录机关。网上常说「交了社保就不算应届生」，这是部分考试的口径，不是全国统一的规定。前面引的福建、重庆两份只是例子，各省每年都可能改，以你要考那年的公告为准。参加三支一扶这类基层服务项目的，期满两年内也能报应届生职位，见本节第 7 条（基层服务项目）。同一份报考指南还写明，这场考试不指定辅导书，也不举办或委托任何机构、个人办辅导班。《公务员录用规定》第四条写明，录用公务员采取「公开考试、严格考察、平等竞争、择优录取的办法」。所以有人收钱许诺「内部指标」「包进编」，就当骗局报警，见第 8 节第 3 条（反诈硬规则）。国考的口径按截至 2026 年 10 月的 2027 年度公告写，以后每年也看当年的公告。"]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["我的备注"]},{"tag":"button","props":{"type":"button"},"children":["写下对自己有用的提醒…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/tip/31-16"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["上一条"]},"不进单位自己干，起步钱先看创业担保贷款：个人最高 30 万、财政贴一半利息"]}]},{"tag":"span","props":{},"children":[]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["本主题的其他建议"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/31-03"},"children":[{"tag":"strong","props":{},"children":["应征之后拒服兵役，两年内不准出境或升学复学，还进不了公务员和国企"]},{"tag":"span","props":{},"children":["报了名又拒绝去当兵、责令改正后还不改的，后果是一串。公务员不能录用你，国有企业和事业单位也不能招你。两年内不准出境，不准升学和复学，还会被列进履行国防义务严重失…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/31-04"},"children":[{"tag":"strong","props":{},"children":["大学生当兵最实的两块：学费每年补最高 20000 元，学籍保留到退役后两年、考研有专项计划"]},{"tag":"span","props":{},"children":["在校生、应届毕业生和新生去当兵，国家替你出读书那几年的学费。本专科生每年最高 20000 元，研究生最高 25000 元，学费本来就低的只补实际交的那么多。服役…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/31-05"},"children":[{"tag":"strong","props":{},"children":["退役后只有六种情况由政府安排工作；自主就业的 30 日内必须报到"]},{"tag":"span","props":{},"children":["「当兵包分配」早就不是普遍情况。现在只有六种情况由政府安排工作，义务兵服两年退役，绝大多数不在这六种里面。不由政府安排工作的那一档叫自主就业，它有个硬期限：退出…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/31-06"},"children":[{"tag":"strong","props":{},"children":["退役后的三笔账：一次性退役金、军龄算工龄、自己干每年扣减 20000 元税"]},{"tag":"span","props":{},"children":["退役之后有三笔账。第一笔是自主就业的一次性退役金，按服现役年限发，立过功的还增发。第二笔是军龄算工龄，缴费年限跟入伍前和退役后合着算。第三笔是税：自己开店做生意…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/31-07"},"children":[{"tag":"strong","props":{},"children":["想进体制内不止考公一条：基层服务项目干满两年，能报每年 10% 的定向考录计划"]},{"tag":"span","props":{},"children":["想进体制内，不是只有考公一条路。「三支一扶」这类基层服务项目干满两年、考核合格，就能报只面向这些人的定向考录计划。各省每年要拿出公务员考录计划的 10% 左右招…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/31-08"},"children":[{"tag":"strong","props":{},"children":["特岗教师三年服务期满、考核合格又愿意留下的，应当及时入编"]},{"tag":"span","props":{},"children":["特岗计划是少数几条写明「期满入编」的路。条件是本科及以上学历、以师范类专业为主，年龄不超过 30 周岁，还要有相应的教师资格证。服务期三年，这三年同等条件下的待…"]}]}]}]},{"tag":"a","props":{"className":"life-text-link","href":"/book/31"},"children":["阅读整个主题：十八岁之后有哪几条路 ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"15","height":"15","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]}]}]},{"tag":"nav","props":{"className":"life-tabbar","aria-label":"主导航"},"children":[{"tag":"a","props":{"className":"","href":"/book"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"21","height":"21","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-book-open","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M12 7v14"},"children":[]},{"tag":"path","props":{"d":"M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z"},"children":[]}]},{"tag":"span","props":{},"children":["全书"]}]},{"tag":"a","props":{"className":"","href":"/top-50"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"21","height":"21","viewBox":"0 0 24 24",