ht":"18","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-up-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M7 7h10v10"},"children":[]},{"tag":"path","props":{"d":"M7 17 17 7"},"children":[]}]}]}]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/en/book/24"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"Back to index"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["Seeking medical care: How to save money and avoid unnecessary hassle"]},{"tag":"div","props":{"data-ad-dock-host":"true"},"children":[]},{"tag":"nav","props":{"aria-label":"Chapter entries"},"children":[{"tag":"a","props":{"href":"/en/tip/24-01"},"children":[{"tag":"span","props":{},"children":["01"]},"For common illnesses, patients should first visit community clinics; referrals then proceed stepwise to larger hospitals, after which the hospital deductible is calculated only once"]},{"tag":"a","props":{"href":"/en/tip/24-02"},"children":[{"tag":"span","props":{},"children":["02"]},"Within the same medical insurance region, the lower the hospital level, the higher the reimbursement rate — the difference is roughly 10 percentage points"]},{"tag":"a","props":{"href":"/en/tip/24-03"},"children":[{"tag":"span","props":{},"children":["03"]},"Go to a major hospital via a referral from a local clinic or the hospital’s referral center — don’t turn to scalpers"]},{"tag":"a","props":{"href":"/en/tip/24-04"},"children":[{"tag":"span","props":{},"children":["04"]},"Before seeking medical care outside your home province, ask locally first — the need for such care should ideally be assessed by an associate chief physician or higher"]},{"tag":"a","props":{"href":"/en/tip/24-05"},"children":[{"tag":"span","props":{},"children":["05"]},"Stop treating tertiary hospitals as mere prescription hubs — stable chronic disease patients should turn to primary care"]},{"tag":"a","props":{"href":"/en/tip/24-06"},"children":[{"tag":"span","props":{},"children":["06"]},"If you have doubts about treatment, request to seal the medical records on the spot; both parties must be present, a list must be drawn up, and each side gets a copy"]},{"tag":"a","props":{"href":"/en/tip/24-07"},"children":[{"tag":"span","props":{},"children":["07"]},"After every medical visit, keep a personal copy of your medical records, test reports, and imaging scans"]},{"tag":"a","props":{"href":"/en/tip/24-08"},"children":[{"tag":"span","props":{},"children":["08"]},"Even without money or ID, and unable to identify yourself, emergency care must be provided first"]},{"tag":"a","props":{"href":"/en/tip/24-09"},"children":[{"tag":"span","props":{},"children":["09"]},"Disability assessments must be conducted only after treatment is complete; doing it too early results in a lower rating"]},{"tag":"a","props":{"href":"/en/tip/24-10"},"children":[{"tag":"span","props":{},"children":["10"]},"After treatment, functional impairments may indeed remain; apply for a disability certificate at the county-level disability association in your hukou area"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/en/tip/24-11","data-status":"active"},"children":[{"tag":"span","props":{},"children":["11"]},"Thank the doctors who saved you — send thank-you letters, banners, or satisfaction ratings instead of cash gifts. The rules prohibit money, not gratitude"]},{"tag":"a","props":{"href":"/en/tip/24-12"},"children":[{"tag":"span","props":{},"children":["12"]},"Before getting a dental implant, ask what the package price includes; prioritize providers committed to price regulation, and do not trust low-price ads"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"Breadcrumb"},"children":[{"tag":"a","props":{"href":"/en/book"},"children":["Explore the book"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/en/book/24"},"children":["Chapter 24"," ·"," ","Seeking medical care: How to save money and avoid unnecessary hassle"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"24-11"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["11"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["Evidence"," ","A"]}]},{"tag":"h1","props":{"lang":"en"},"children":["Thank the doctors who saved you — send thank-you letters, banners, or satisfaction ratings instead of cash gifts. The rules prohibit money, not gratitude"]},{"tag":"p","props":{"lang":"en","className":"life-entry-summary"},"children":["Offering money beforehand to “jump the queue” won’t work — allocating appointment slots, beds, scarce medicines, tests, or surgeries is strictly forbidden. After treatment, it’s perfectly fine to show gratitude toward doctors who saved your life, but the method matters. Accepting cash or alcohol gifts puts them in violation of professional ethics. Three proper ways to thank them are: completing a satisfaction survey, writing a personalized thank-you letter, or presenting a commemorative banner, plus following medical advice for follow-up care."]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","p