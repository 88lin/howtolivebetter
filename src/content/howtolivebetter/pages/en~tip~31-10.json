2000/svg","width":"18","height":"18","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-up-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M7 7h10v10"},"children":[]},{"tag":"path","props":{"d":"M7 17 17 7"},"children":[]}]}]}]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/en/book/31"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"Back to index"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["What options are available after turning 18?"]},{"tag":"div","props":{"data-ad-dock-host":"true"},"children":[]},{"tag":"nav","props":{"aria-label":"Chapter entries"},"children":[{"tag":"a","props":{"href":"/en/tip/31-01"},"children":[{"tag":"span","props":{},"children":["01"]},"First, check the eligibility criteria: the age and education requirements for all twelve pathways are clearly stated in official documents"]},{"tag":"a","props":{"href":"/en/tip/31-02"},"children":[{"tag":"span","props":{},"children":["02"]},"Men who turn 18 must complete military service registration by October 31; mandatory active duty lasts two years"]},{"tag":"a","props":{"href":"/en/tip/31-03"},"children":[{"tag":"span","props":{},"children":["03"]},"Refusing military service after enlistment: no travel abroad, no further education, and barred from civil service and state-owned enterprises for two years"]},{"tag":"a","props":{"href":"/en/tip/31-04"},"children":[{"tag":"span","props":{},"children":["04"]},"Two main benefits for college students joining the military: up to 20,000 RMB per year for tuition, two-year extension of student status, and a special postgraduate admission program"]},{"tag":"a","props":{"href":"/en/tip/31-05"},"children":[{"tag":"span","props":{},"children":["05"]},"Only six scenarios allow the government to assign jobs after discharge; those opting for self-employment must register within 30 days"]},{"tag":"a","props":{"href":"/en/tip/31-06"},"children":[{"tag":"span","props":{},"children":["06"]},"Three key financial aspects after discharge: one-time separation pay, military service counting toward work seniority, and tax deductions for self-employed veterans"]},{"tag":"a","props":{"href":"/en/tip/31-07"},"children":[{"tag":"span","props":{},"children":["07"]},"There’s more than just civil service exams to get into the government system: serving two years in grassroots programs qualifies you for a special recruitment quota of 10% each year"]},{"tag":"a","props":{"href":"/en/tip/31-08"},"children":[{"tag":"span","props":{},"children":["08"]},"Teachers in the Special Post Program who complete three years of service, pass evaluations, and wish to stay should be promptly added to the official teaching staff"]},{"tag":"a","props":{"href":"/en/tip/31-09"},"children":[{"tag":"span","props":{},"children":["09"]},"Firefighters and civilian personnel in the military represent two additional pathways for public recruitment, with lower entry requirements than civil service exams"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/en/tip/31-10","data-status":"active"},"children":[{"tag":"span","props":{},"children":["10"]},"Education is not a one-time deal: self-study exams have no age or prior education limits; both adult college entrance exams and open universities offer pathways to further education"]},{"tag":"a","props":{"href":"/en/tip/31-11"},"children":[{"tag":"span","props":{},"children":["11"]},"Not joining a company means you must arrange your own social insurance: you’ll need to enroll in pension and medical plans at your place of work, as household registration restrictions have now been lifted"]},{"tag":"a","props":{"href":"/en/tip/31-12"},"children":[{"tag":"span","props":{},"children":["12"]},"Food delivery workers, ride‑hailing drivers, and local freight carriers all get occupational injury coverage paid for by the platform on a per‑order basis — at no cost to them"]},{"tag":"a","props":{"href":"/en/tip/31-13"},"children":[{"tag":"span","props":{},"children":["13"]},"Two pathways to secure a government job on the day you fill out college applications: government-funded teacher training and targeted medical student programs, at the cost of a six-year service commitment"]},{"tag":"a","props":{"href":"/en/tip/31-14"},"children":[{"tag":"span","props":{},"children":["14"]},"Before going abroad to work, check whether the company has a license for international labor cooperation: it is illegal for them to demand a deposit from you"]},{"tag":"a","props":{"href":"/en/tip/31-15"},"children":[{"tag":"span","props":{},"children":["15"]},"Working remotely for a foreign company from home: this income is considered domestic earnings for tax purposes; you must file your own individual income tax returns, and incoming payments should be reported as “employee compensation”"]},{"tag":"a","props":{"href":"/en/tip/31-16"},"children":[{"tag":"span","props":{},"children":["16"]},"Starting a business without joining a company? First look at startup guarantee loans: up to 300,000 RMB per individual, with the government covering half the interest"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"Breadcrumb"},"children":[{"tag":"a","props":{"href":"/en/book"},"children":["Explore the book"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/en/book/31"},"children":["Chapter 31"," ·"," ","What options are available after turning 18?"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"31-10"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["10"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["Evidence"," ","A"]}]},{"tag":"h1","props":{"lang":"en"},"children":["Education is not a one-time deal: self-study exams have no age or prior education limits; both adult college entrance exams and open universities offer pathways to further education"]},{"tag":"p","props":{"lang":"en","className":"life-entry-summary"},"children":["If you missed out on higher education at age 18, there are three legitimate options available: self-study exams, adult college entrance exams, and open universities. Self-study exams impose no age restrictions or limits on prior educational attainment, though full-time students are ineligible to apply. Adult college entrance exams require applicants to hold a high school diploma or equivalent. All three routes take time, but none depend on how well you performed academically at age 18."]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Cost"]},{"tag":"p","props":{},"children":["Registration and textbook fees amount to only a few hundre…"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Benefit"]},{"tag":"p","props":{},"children":["The Regulations on Self-Study Examinations for Higher Education explicitly state in Article 3: “All citizens o…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"Mark: Education is not a one-time deal: self-study exams have no age or prior education limits; both adult college entrance exams and open universities offer pathways to further education"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"Done"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"Plan to do"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"Save"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Share this tip"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Hide details"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Cost"]},{"tag":"p","props":{},"children":["Registration and textbook fees amount to only a few hundred yuan per year. The trade-off is the need for long-term self-study or part-time classes; for those pursuing a bachelor’s degree while still working, the minimum study period is two and a half years, which requires consistent dedication over time."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Benefit"]},{"tag":"p","props":{},"children":["The Regulations on Self-Study Examinations for Higher Education explicitly state in Article 3: “All citizens of the People’s Republic of China, regardless of gender, age, ethnicity, race, or prior educational background, may participate in self-study examinations for higher education in accordance with these regulations.” Article 20 adds that full-time students at all levels of education are barred from taking these exams. Article 25 outlines three requirements for earning a diploma: successfully completing all required courses, finishing a graduation thesis or practical assignment, and meeting criteria for moral conduct. Once these conditions are met, a diploma is granted. It further notes that “diplomas awarded for associate or bachelor’s degrees are recognized by the state.” Article 32 guarantees that non-working graduates receive the same salary treatment as peers from regular higher education institutions. Article 21 of the Higher Education Law also affirms that self-study examinations are a state-recognized pathway to higher education, with successful candidates receiving corresponding academic credentials. The 2025 National Enrollment Rules for Adult Higher Education state that eligible applicants must be “working professionals and other members of society who are not currently enrolled in any nationally recognized high or secondary schools.” Those applying for undergraduate or associate programs must hold a high school diploma or equivalent, while applicants for bachelor’s degrees must already hold an associate diploma, bachelor’s certificate, or higher. Full-time study requires a minimum of four years for undergraduates and two years for associate or bachelor’s degree candidates; part-time study demands five years for undergraduates and two and a half years for the other two pathways. Full-time study means leaving one’s job to attend classes full-time, while part-time study allows individuals to continue working while pursuing their degree. The Ministry of Education’s guidelines on open universities specify that registration is open to all; upon completing required coursework and earning sufficient credits, students receive course certificates, and those meeting all academic and conduct criteria earn academic or non-academic credentials, with degrees awarded where applicable (nationwide)."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Original sources"]},{"tag":"p","props":{"className":"life-citations"},"children":["国务院 (1988, 2014 修订). 高等教育自学考试暂行条例（第三、二十、二十五、三十二条）. ",{"tag":"a","props":{"href":"https://flk.npc.gov.cn/detail?id=ff8080816f3cbb3c016f415d64e5236d","target":"_blank","rel":"noopener noreferrer"},"children":["https://flk.npc.gov.cn/detail?id=ff8080816f3cbb3c016f415d64e5236d"]},"（国家法律法规数据库）；全国人大常委会 (2018). 高等教育法（第二十一条）. ",{"tag":"a","props":{"href":"https://flk.npc.gov.cn/detail?id=ff8080816f135f46016f20df64ec16c5","target":"_blank","rel":"noopener noreferrer"},"children":["https://flk.npc.gov.cn/detail?id=ff8080816f135f46016f20df64ec16c5"]},"（国家法律法规数据库）；教育部办公厅 (2025). 关于做好 2025 年全国成人高校招生工作的通知（教学厅〔2025〕6 号）及附件《2025 年全国成人高校招生办法》. ",{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/202509/content_7040877.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/zhengce/zhengceku/202509/content_7040877.htm"]},"；教育部 (2016). 关于办好开放大学的意见（教职成〔2016〕2 号）. ",{"tag":"a","props":{"href":"http://www.gov.cn/gongbao/content/2016/content_5067956.htm","target":"_blank","rel":"noopener noreferrer"},"children":["http://www.gov.cn/gongbao/content/2016/content_5067956.htm"]},"；教育部 (2007). 关于进一步做好高等学校各类招生管理工作的通知（教发〔2007〕13 号）：「普通专升本招生计划按不超过当年应届普通高职（专科）毕业生5%的比例安排」. ",{"tag":"a","props":{"href":"http://www.moe.gov.cn/s78/A03/s7050/201006/t20100607_88782.html","target":"_blank","rel":"noopener noreferrer"},"children":["http://www.moe.gov.cn/s78/A03/s7050/201006/t20100607_88782.html"]},"；中国政府网 (2020). 今年扩招硕士18.9万，专升本32.2万——毕业生就业帮扶发力，教育部副部长翁铁慧：「扩大普通高校专升本的规模，同比争取增加32.2万人」. ",{"tag":"a","props":{"href":"http://www.gov.cn/zhengce/2020-02/29/content_5484774.htm","target":"_blank","rel":"noopener noreferrer"},"children":["http://www.gov.cn/zhengce/2020-02/29/content_5484774.htm"]},"；福建省教育考试院 (2026). 转发时引「教育部高校学生司《关于做好2026年普通高等学校专升本考试招生工作的通知》（教学司函〔2025〕53号）」. ",{"tag":"a","props":{"href":"https://www.eeafj.cn/gkzsb/20260310/14437.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.eeafj.cn/gkzsb/20260310/14437.html"]}]},{"tag":"a","props":{"href":"https://flk.npc.gov.cn/detail?id=ff8080816f3cbb3c016f415d64e5236d","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Open source link"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Book note"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["There is another type of ordinary top-up program (Zhuanshengben) for fresh full-time junior college graduates. The publicly available document at the national level is a notice from the Ministry of Education in 2007, which states that the top-up program plan does not exceed 5% of the number of junior college graduates in the same year. Since 2020, the Ministry of Education has expanded the scale of the top-up program, with a year-on-year increase of 32.2 ten thousand people; the 5% threshold is actually no longer strictly enforced. The specific arrangements for each year are issued via official letters from the Department of Higher Education of the Ministry of Education; for example, in 2026, it was the letter from the Department of Education [2025] No. 53. This letter is not released to the public, and the document number can only be seen in the documents forwarded by various provinces. The target of recruitment is determined by each province itself, and it basically only accepts full-time junior college graduates from the current year within that province, so the main text does not specify its requirements. Starting from the autumn of 2025, higher education continuing education is no longer referred to as \"correspondence\" or \"part-time\"; it is now uniformly called \"non-full-time.\" Higher education continuing education refers to the category of adult education used to obtain advanced degrees later in life; be cautious of advertisements still using old terminology. Obtaining a degree and \"which skill is more cost-effective to learn\" are two different matters; see section 23 for the latter. For information on \"fast-track certification\" purchased with money and counterfeit certificates, see item 8 in section 23."]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["My note"]},{"tag":"button","props":{"type":"button"},"children":["Write a reminder for yourself…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/en/tip/31-09"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide luc