svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"目次に戻る"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["お金を無駄にしない"]},{"tag":"div","props":{"data-ad-dock-host":"true"},"children":[]},{"tag":"nav","props":{"aria-label":"この章のヒント"},"children":[{"tag":"a","props":{"href":"/ja/tip/05-01"},"children":[{"tag":"span","props":{},"children":["01"]},"すべての自動更新をオフにし、期限切れ後に手動更新へ切り替える"]},{"tag":"a","props":{"href":"/ja/tip/05-02"},"children":[{"tag":"span","props":{},"children":["02"]},"毎年3月から6月にかけて確定申告を行い、特別控除の項目は漏れなく記入する"]},{"tag":"a","props":{"href":"/ja/tip/05-03"},"children":[{"tag":"span","props":{},"children":["03"]},"積立金（公積金）は住宅購入のためだけではない：賃貸、リフォーム、管理費の引き出しも可能、2026 年 9 月 20 日より新条例に基づき実施"]},{"tag":"a","props":{"href":"/ja/tip/05-04"},"children":[{"tag":"span","props":{},"children":["04"]},"携帯電話とブロードバンドのプランを年に一度見直す。不要なものはダウングレードし、キャリアが転出を拒むなら苦情を。"]},{"tag":"a","props":{"href":"/ja/tip/05-05"},"children":[{"tag":"span","props":{},"children":["05"]},"宝くじは買わない"]},{"tag":"a","props":{"href":"/ja/tip/05-06"},"children":[{"tag":"span","props":{},"children":["06"]},"「高収益」「元本保証」「確実な利益」という言葉を見たら、すぐに立ち去る"]},{"tag":"a","props":{"href":"/ja/tip/05-07"},"children":[{"tag":"span","props":{},"children":["07"]},"クレジットカードの最小支払いを利用しない、分割払いや消費者ローンを利用しない。借りる必要がある場合は、まず利息を年利（年換算利率）に直して比較する"]},{"tag":"a","props":{"href":"/ja/tip/05-08"},"children":[{"tag":"span","props":{},"children":["08"]},"配信者への投げ銭をしない、ゲームへの課金をしない、衝動買いをしない"]},{"tag":"a","props":{"href":"/ja/tip/05-09"},"children":[{"tag":"span","props":{},"children":["09"]},"子供によるスマホでの課金・投げ銭：8歳以上の高額な支出は、親の追認がない場合、返還を請求できる可能性がある"]},{"tag":"a","props":{"href":"/ja/tip/05-10"},"children":[{"tag":"span","props":{},"children":["10"]},"子供に教えるべき一言：「誰かに親のスマホを操作させたり、認証コードを伝えさせようとしたら、それは詐欺師です」"]},{"tag":"a","props":{"href":"/ja/tip/05-11"},"children":[{"tag":"span","props":{},"children":["11"]},"電子製品の延長保証（延保）を断る"]},{"tag":"a","props":{"href":"/ja/tip/05-12"},"children":[{"tag":"span","props":{},"children":["12"]},"一致性評価を通過したジェネリック医薬品や、集中調達（集采）の採用薬を優先的に選ぶ"]},{"tag":"a","props":{"href":"/ja/tip/05-13"},"children":[{"tag":"span","props":{},"children":["13"]},"医療保険Appで「家族共済」の紐付けを行えば、従業員医療保険の個人口座の資金を配偶者、父母、子供の通院や薬代に利用可能に"]},{"tag":"a","props":{"href":"/ja/tip/05-14"},"children":[{"tag":"span","props":{},"children":["14"]},"水道水は沸騰させて飲み、ウォーターサーバー用の大容量ボトルの水を定期注文したり、小瓶の水を常時買ったりしない"]},{"tag":"a","props":{"href":"/ja/tip/05-15"},"children":[{"tag":"span","props":{},"children":["15"]},"株式の頻繁な取引を避ける。相場が急騰・急落している時こそ、より動きを控えるべきである"]},{"tag":"a","props":{"href":"/ja/tip/05-16"},"children":[{"tag":"span","props":{},"children":["16"]},"借金による投資、レバレッジの使用、理解できない銘柄の購入は避ける"]},{"tag":"a","props":{"href":"/ja/tip/05-17"},"children":[{"tag":"span","props":{},"children":["17"]},"長期的なコア資産（長期保有し続ける資金）として、アクティブファンドの代わりに広範なインデックスファンドを活用する"]},{"tag":"a","props":{"href":"/ja/tip/05-18"},"children":[{"tag":"span","props":{},"children":["18"]},"同種のファンドなら、より低い信託報酬率のものを優先的に選ぶ"]},{"tag":"a","props":{"href":"/ja/tip/05-19"},"children":[{"tag":"span","props":{},"children":["19"]},"一つの銘柄、一つのプラットフォーム、一つの不動産に全財産を投じない"]},{"tag":"a","props":{"href":"/ja/tip/05-20"},"children":[{"tag":"span","props":{},"children":["20"]},"所得税を支払っており、税率が 10% 以上の人は個人年金口座を開設すれば、年間最大 12000 元を課税前控除できる。所得税を支払っていない、または税率が 3% の人は、開設しても割に合わない"]},{"tag":"a","props":{"href":"/ja/tip/05-21"},"children":[{"tag":"span","props":{},"children":["21"]},"ジムの都度払い、または短期契約は、1年以上の継続的な利用実績がない限り避けるべき"]},{"tag":"a","props":{"href":"/ja/tip/05-22"},"children":[{"tag":"span","props":{},"children":["22"]},"前払金の請求には書面契約を；事業者にリスクが生じた場合は支払いを停止、失踪に備え未消費残高の返金を求める権利があります"]},{"tag":"a","props":{"href":"/ja/tip/05-23"},"children":[{"tag":"span","props":{},"children":["23"]},"高額な非必需品の購入には 24 時間のクーリングオフ期間を、ネットショッピングでは「7日間の無理由返品」を賢く活用"]},{"tag":"a","props":{"href":"/ja/tip/05-24"},"children":[{"tag":"span","props":{},"children":["24"]},"「打ち消し線価格」やセール時の買い溜めに惑わされない"]},{"tag":"a","props":{"href":"/ja/tip/05-25"},"children":[{"tag":"span","props":{},"children":["25"]},"保険は掛け捨て型を優先し、「返戻金」「配当金」は不確実なものとして扱う"]},{"tag":"a","props":{"href":"/ja/tip/05-26"},"children":[{"tag":"span","props":{},"children":["26"]},"第三者賠償責任保険は十分な額を：交強保険の限度額は全国一律で低く、超過分は自己負担となる"]},{"tag":"a","props":{"href":"/ja/tip/05-27"},"children":[{"tag":"span","props":{},"children":["27"]},"まずは 3 から 6 ヶ月分の生活費を、いつでも引き出せる場所に緊急資金として貯める"]},{"tag":"a","props":{"href":"/ja/tip/05-28"},"children":[{"tag":"span","props":{},"children":["28"]},"住宅ローンを繰り上げ返済する前に、感覚ではなく比較検討を"]},{"tag":"a","props":{"href":"/ja/tip/05-29"},"children":[{"tag":"span","props":{},"children":["29"]},"ネットショッピングではプラットフォームのルールと法条を確認し、配信者や「高評価」を信じない"]},{"tag":"a","props":{"href":"/ja/tip/05-30"},"children":[{"tag":"span","props":{},"children":["30"]},"ライブコマースで購入した商品に問題が発生した場合、まずはプラットフォームに販売者と配信者の情報を請求してください。プラットフォームは提供する義務があります"]},{"tag":"a","props":{"href":"/ja/tip/05-31"},"children":[{"tag":"span","props":{},"children":["31"]},"不安全な食品を購入した場合、返金に加えて10倍の賠償を請求可能。賠償額が1,000元に満たない場合は1,000元として計算"]},{"tag":"a","props":{"href":"/ja/tip/05-32"},"children":[{"tag":"span","props":{},"children":["32"]},"大型家電を購入する前に、国の抜き取り検査通知、3C認証、および省エネラベルを確認しましょう"]},{"tag":"a","props":{"href":"/ja/tip/05-33"},"children":[{"tag":"span","props":{},"children":["33"]},"ブレスレット、宝石、高級時計、アートトイは「使ったお金」として計算し、「貯まったお金」として計算しないこと"]},{"tag":"a","props":{"href":"/ja/tip/05-34"},"children":[{"tag":"span","props":{},"children":["34"]},"宝石・貴金属はCMAマーク付きの検査報告書のみを信頼し、発行機関の公式サイトでその機関を必ず確認すること"]},{"tag":"a","props":{"href":"/ja/tip/05-35"},"children":[{"tag":"span","props":{},"children":["35"]},"ブラインドボックスやカードガチャなどのランダム販売は、「このお金は戻ってこない」と考えて扱うこと"]},{"tag":"a","props":{"href":"/ja/tip/05-36"},"children":[{"tag":"span","props":{},"children":["36"]},"食品の添加物が気になるなら、包装済み製品を買うこと：バラ売りカウンターは法律上、原材料表示が義務付けられていない"]},{"tag":"a","props":{"href":"/ja/tip/05-37"},"children":[{"tag":"span","props":{},"children":["37"]},"損失が出ている銘柄も事前に決めたルールに従って売却すべきであり、ナンピン買いで平均取得単価を下げることで挽回しようとしてはならない"]},{"tag":"a","props":{"href":"/ja/tip/05-38"},"children":[{"tag":"span","props":{},"children":["38"]},"米国株などの海外資産を購入したい場合は、QDII基金または香港株通を利用しましょう。海外証券会社での口座開設や、毎年の外貨両替枠の利用は避けてください"]},{"tag":"a","props":{"href":"/ja/tip/05-39"},"children":[{"tag":"span","props":{},"children":["39"]},"自分では耐えられない損失に対してのみ保険を購入し、耐えられる損失は予備費でカバーする"]},{"tag":"a","props":{"href":"/ja/tip/05-40"},"children":[{"tag":"span","props":{},"children":["40"]},"家族の生活をあなたの収入に依存している人がいるなら、子供より先に稼ぎ手に対して定期死亡保険を検討すべきです"]},{"tag":"a","props":{"href":"/ja/tip/05-41"},"children":[{"tag":"span","props":{},"children":["41"]},"1年以上契約の人身保険を後悔し、猶予期間内に解約した場合、保険料はほぼ全額返金される"]},{"tag":"a","props":{"href":"/ja/tip/05-42"},"children":[{"tag":"span","props":{},"children":["42"]},"銀行窓口で署名する前に、手元にあるのが預金か保険かを必ず確認すること"]},{"tag":"a","props":{"href":"/ja/tip/05-43"},"children":[{"tag":"span","props":{},"children":["43"]},"解約したいなら自分で保険会社に手続きしましょう。「代理解約」は利用せず、誤解を招いたと感じたら12378に苦情を申し立ててください"]},{"tag":"a","props":{"href":"/ja/tip/05-44"},"children":[{"tag":"span","props":{},"children":["44"]},"保険証券の受益者には具体的な個人名を記載しましょう。万が一の際は、期限内に請求を：生命保険は 5 年、その他の保険は 2 年以内"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/ja/tip/05-45","data-status":"active"},"children":[{"tag":"span","props":{},"children":["45"]},"ビットコイン、テザーなどの暗号資産を買わず、誘われても投資しない。取引は法的保護を受けず、損失は訴えても取り戻せない"]},{"tag":"a","props":{"href":"/ja/tip/05-46"},"children":[{"tag":"span","props":{},"children":["46"]},"勤務先がない人が従業員基本年金保険を自分で納付するなら、最低水準で必要な年数を満たすのが最も有利。すぐに得をするわけではなく、最低水準でも払った分の回収に約 10 年の受給が必要"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"現在地"},"children":[{"tag":"a","props":{"href":"/ja/book"},"children":["本を読む"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/ja/book/05"},"children":["第5章"," ·"," ","お金を無駄にしない"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"05-45"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["45"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["エビデンス"," ","A"]}]},{"tag":"h1","props":{"lang":"ja"},"children":["ビットコイン、テザーなどの暗号資産を買わず、誘われても投資しない。取引は法的保護を受けず、損失は訴えても取り戻せない"]},{"tag":"p","props":{"lang":"ja","className":"life-entry-summary"},"children":["中国では暗号資産を通貨と認めず、個人の購入取引が無効となり、損失は自己負担です。テザーを買って約 44.8 万元払った人は、その後出金できず返還を求めましたが、法院に退けられました。盗難は別で、窃盗犯は窃盗罪で処罰されます。"]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["費用・手間"]},{"tag":"p","props":{},"children":["お金はかかりません。購入せず、「取引指示」「必ず儲かる」のグループに入らないでください。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["効果"]},{"tag":"p","props":{},"children":["2026 年 2 月、人民銀行など 8 部門が銀発〔2026〕42 号通知を出しました。"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"記録する：ビットコイン、テザーなどの暗号資産を買わず、誘われても投資しない。取引は法的保護を受けず、損失は訴えても取り戻せない"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"できている"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"やることに追加"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"お気に入り"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"このヒントを共有"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"詳細を閉じる"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["費用・手間"]},{"tag":"p","props":{},"children":["お金はかかりません。購入せず、「取引指示」「必ず儲かる」のグループに入らないでください。代償は価格上昇時の利益を得られないことです。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["効果"]},{"tag":"p","props":{},"children":["2026 年 2 月、人民銀行など 8 部門が銀発〔2026〕42 号通知を出しました。ビットコイン、イーサリアム、テザーなどは法定通貨としての効力がなく、通貨として市場で流通させてはならないとしています。人民元との交換、暗号資産同士の交換、トークン発行による資金調達は不法金融活動として一律厳禁で、海外機関も中国国内の人に提供できません。個人投資については、組織・個人の暗号資産、現実世界資産トークン、関連金融商品への投資が公序良俗に反する場合、その民事法律行為は無効で損失は自己負担としています。銀発〔2021〕237 号は廃止されましたが、この規定は残りました。法院事例では、湯某が 2018 年 2 月～2019 年 7 月、取引所業者を名乗る 2 人からテザーを買い、約 44.8 万元（正確には 448000 元）払いました。その後出金もログインもできず返還請求しました。法院は人民元からの交換投資を無効、損失は自己負担とし、訴えを退け、二審も維持しました（江蘇宜興、2025 年 3 月公表）。盗難は別です。口座の 400 万元超の暗号資産がハッカーに盗まれ、犯人の 1 人が窃盗罪で 7 年、罰金 2 万元となりました（河南鄭州）。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["出典"]},{"tag":"p","props":{"className":"life-citations"},"children":["中国人民银行、国家发展改革委、工业和信息化部、公安部、市场监管总局、金融监管总局、中国证监会、国家外汇局 (2026). 关于进一步防范和处置虚拟货币等相关风险的通知（银发〔2026〕42 号，第一、十九条）. ",{"tag":"a","props":{"href":"https://www.csrc.gov.cn/csrc/c100028/c7614318/content.shtml","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.csrc.gov.cn/csrc/c100028/c7614318/content.shtml"]},"（中国证监会发布）；宜兴市人民法院 (2025). 投资虚拟货币受损 风险责任自行承担. ",{"tag":"a","props":{"href":"https://yx.wxfy.gov.cn/article/detail/2025/09/id/8970543.shtml","target":"_blank","rel":"noopener noreferrer"},"children":["https://yx.wxfy.gov.cn/article/detail/2025/09/id/8970543.shtml"]},"；【新时代检察好故事】偷了虚拟币 被判盗窃罪 (2024). ",{"tag":"a","props":{"href":"https://www.yw.gov.cn/art/2024/2/2/art_1229143073_59471301.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.yw.gov.cn/art/2024/2/2/art_1229143073_59471301.html"]},"（义乌市人民政府网转载）；人民法院报 (2024). 非法窃取虚拟货币行为的刑法定性. ",{"tag":"a","props":{"href":"http://www.sdcourt.gov.cn/jningzcfy/386500/386502/31441533/index.html","target":"_blank","rel":"noopener noreferrer"},"children":["http://www.sdcourt.gov.cn/jningzcfy/386500/386502/31441533/index.html"]},"（邹城市人民法院网转载）；Federal Bureau of Investigation (2022). Scammers Target and Exploit Owners of Cryptocurrencies in Liquidity Mining Scam (Alert Number I-072122-PSA). ",{"tag":"a","props":{"href":"https://www.ic3.gov/PSA/2022/PSA220721","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.ic3.gov/PSA/2022/PSA220721"]}]},{"tag":"a","props":{"href":"https://www.csrc.gov.cn/csrc/c100028/c7614318/content.shtml","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["出典を開く"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["著者の注記"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["自己負担は売り手や取引指示者との金銭紛争の話で、法院は投資金の回収を助けないので、事後の提訴を頼りにしないでください。盗難・詐取は刑事事件なので通報してください。すでに持つ人は QR コード盗難にも注意が必要です。江蘇漣水で相手と会いコードを読み、約 5.7 万テザー、約 39.4 万元（正確には 393665.461434 元）が移転されました。人民法院報の記事は窃盗罪として扱うべきとしています。米 FBI は 2022 年、ウォレットに表示された権限を承認すると相手が上限なしに移せる類似手口を警告しました。対策は不確かなサイトに接続せず、第三者の承認確認ツールでどのサイトに送金権限を与えたか定期確認することです。自分の銀行カードで他人の入金を受け、暗号資産を買って移すのは別の行為で、刑事罰の可能性があります。第9節第5項（副業で自分のカードに入金させる）を参照してください。高利回りの話は第6項（高利回り、元本保証、必ず儲かるなら離れる）、海外資産の合法な購入は第38項（米国株は QDII ファンドや港股通）を参照してください。投資助言ではありません。"]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["自分のメモ"]},{"tag":"button","props":{"type":"button"},"children":["自分へのメモを書く…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/ja/tip/05-44"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["前へ"]},"保険証券の受益者には具体的な個人名を記載しましょう。万が一の際は、期限内に請求を：生命保険は 5 年、その他の保険は 2 年以内"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/ja/tip/05-46"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["次へ"]},"勤務先がない人が従業員基本年金保険を自分で納付するなら、最低水準で必要な年数を満たすのが最も有利。すぐに得をするわけではなく、最低水準でも払った分の回収に約 10 年の受給が必要"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"1