ap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Chia sẻ mẹo này"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Ẩn chi tiết"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Chi phí"]},{"tag":"p","props":{},"children":["Không thu phí. Người vừa hết án tù thì đến văn phòng tư pháp hoặc đường phố nơi đăng ký hộ khẩu hay nơi đang ở báo cáo, xin điều trợ cấp tổ chức lại cuộc sống (việc chính quyền sắp xếp và giúp đỡ). Người đã bị đưa vào danh sách người bị thi hành án không thi hành thì trả xong phần phải trả, rồi xin tòa án thi hành án xoá tên. Cá nhân tham gia bảo hiểm đủ 3 năm ở Thâm Quyến thì có thể xin phá sản cá nhân. Mỗi bước đều phải chuẩn bị giấy tờ, trình bày đối diện, rồi còn có thời gian quan sát 1 đến 3 năm. Khó ở chỗ phải kể lại chuyện đã qua nhiều lần, và thời gian quan sát vẫn phải chịu."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Lợi ích"]},{"tag":"p","props":{},"children":["Người vừa hết án tù theo pháp luật có quyền ngang bằng công dân khác, không bị phân biệt đối xử về việc làm, học tập và hưởng bảo hiểm xã hội. Người khó khăn về sinh hoạt do chính quyền nơi đăng ký hộ khẩu hay nơi đang ở giúp sắp xếp, cứu giúp và hỗ trợ theo pháp luật (Luật Cải tạo nhà tù sửa đổi năm 2026, áp dụng từ ngày 1 tháng 11). Văn bản năm 2010 của Trung ương yêu cầu tăng cường đào tạo nghề cho họ, đưa người đủ điều kiện vào diện trợ cấp người có thu nhập thấp, và lập các cơ sở tạm trú chuyển tiếp. Người khi phạm tội chưa đầy 18 tuổi và bị phán không quá 5 năm thì lý lịch phạm tội được niêm phong, khi nhập quân hay tìm việc không phải khai; người đó tự xin giấy chứng nhận không có tiền án thì được cấp trong 3 ngày làm việc. Thời hạn bị đưa vào danh sách không thi hành án là 2 năm. Trả xong tiền, hoặc đã hoà giải với bên kia và các trường hợp tương tự, thì tòa án phải xoá tên trong 3 ngày làm việc. Quy định về phá sản cá nhân của Khu kinh tế đặc biệt Thâm Quyến là văn bản phá sản cá nhân duy nhất hiện có, tuyên bố phá sản rồi chịu đủ 3 năm thời gian quan sát thì phần nợ chưa trả có thể được xoá. Doanh nghiệp pháp nhân không trả được nợ đến hạn, lại nợ nhiều hơn tài sản có (gọi là vốn không đủ nợ), thì có thể xin tái cơ cấu, hoà giải hoặc tuyên bố phá sản thanh toán, các khoản nợ chấm dứt cùng doanh nghiệp này (toàn quốc, phá sản cá nhân chỉ có ở Thâm Quyến)"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Nguồn gốc"]},{"tag":"p","props":{"className":"life-citations"},"children":["全国人大常委会 (2026). 监狱法（2026 年修订，第五十九、六十、六十二条）. ",{"ta