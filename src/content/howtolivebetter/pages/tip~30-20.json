ound","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"已做到"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"加入待做"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"收藏"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"分享这条建议"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"收起详情"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["成本"]},{"tag":"p","props":{"className":"life-citations"},"children":["不花钱，但要换个上学的法子，家长接送、坐公交或者走路。难在同学都骑，孩子会闹。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["收益"]},{"tag":"p","props":{"className":"life-citations"},"children":["《道路交通安全法实施条例》第七十二条规定，在道路上「驾驶自行车、三轮车必须年满12周岁」。同一条还规定，「驾驶电动自行车和残疾人机动轮椅车必须年满16周岁」。违反了，按《道路交通安全法》第八十九条处警告或者 5 到 50 元罚款，不接受罚款的可以扣车。罚款不多，要紧的是出事以后的账。《民法典》第一千一百八十八条规定，未成年人造成他人损害，由监护人承担侵权责任。孩子自己有财产的，先从他的财产里赔，不够的由监护人赔。福建连江县法院判过一案。2022 年 5 月，刚满 14 周岁的孩子用母亲的账户扫码，租了共享电动自行车。他撞上一个骑电动自行车的人，对方十级伤残，交警认定孩子全责。出租公司和保险公司说，用户协议要求 16 周岁以上，孩子不是合法的骑车人，所以不赔。法院判孩子父母赔约 18.7 万元（精确值 187017.83 元）。孩子自己被撞也吃亏。北京一位法官写过一案：10 岁孩子放学骑自行车，被电动自行车撞成十级伤残，交警认定对方全责。《民法典》第一千一百七十三条规定，被侵权人对损害的发生有过错的，可以减轻侵权人的责任。法院据此认定孩子未满 12 周岁上路、监护人没制止，判孩子这边自担一部分损失。伤情也更重。以色列一家创伤中心 2014 到 2016 年收住院 337 名交通伤孩子。骑电动自行车伤的，脑外伤占 13%，骑普通自行车的占 3%。把别的因素一起算进去后，伤情偏重的机会约是骑普通自行车的 2.6 倍（OR 2.56，95% CI 1.1–5.88，可信范围）（全国 / 福建 / 北京 / 以色列）"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["来源"]},{"tag":"p","props":{"className":"life-citations"},"children":["国务院 (2017 年修订). 道路交通安全法实施条例（第七十二条）. ",{"tag":"a","props":{"href":"https://flk.npc.gov.cn/detail?id=ff8080816f3cbb3c016f40f566c10e23","target":"_blank","rel":"noopener noreferrer"},"children":["https://flk.npc.gov.cn/detail?id=ff8080816f3cbb3c016f40f566c10e23"]},"；全国人大常委会 (2021 年修正). 道路交通安全法（第八十九条）. ",{"tag":"a","props":{"href":"https://flk.npc.gov.cn/detail?id=ff8081817ab231eb017abd617ef70519","target":"_blank","rel":"noopener noreferrer"},"children":["https://flk.npc.gov.cn/detail?id=ff8081817ab231eb017abd617ef70519"]},"；全国人大 (2020). 民法典（第一千一百七十三、一千一百八十八条）. ",{"tag":"a","props":{"href":"https://flk.npc.gov.cn/detail?id=ff808081729d1efe01729d50b5c500bf","target":"_blank","rel":"noopener noreferrer"},"children":["https://flk.npc.gov.cn/detail?id=ff808081729d1efe01729d50b5c500bf"]},"；广州市司法局 (2024-11-28). 14岁孩子骑共享电动车，竟把人撞致十级伤残……（转载央视网等）. ",{"tag":"a","props":{"href":"https://sfj.gz.gov.cn/ztlm/fzxc/yasf/content/post_9915896.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://sfj.gz.gov.cn/ztlm/fzxc/yasf/content/post_9915896.html"]},"（网页存档 ",{"tag":"a","props":{"href":"http://web.archive.org/web/20250421103222/https://sfj.gz.gov.cn/ztlm/fzxc/yasf/content/post_9915896.html","target":"_blank","rel":"noopener noreferrer"},"children":["http://web.archive.org/web/20250421103222/https://sfj.gz.gov.cn/ztlm/fzxc/yasf/content/post_9915896.html"]},"）；秦鹏博 (2024-08-29). “半大孩子”怎样骑行才安全又合规. 北京政法网（来源京法网事）. ",{"tag":"a","props":{"href":"https://www.bj148.org/123/202408/t20240829_1667638.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.bj148.org/123/202408/t20240829_1667638.html"]},"；Zmora O, Peleg K, Klein Y (2019). Pediatric electric bicycle injuries and comparison to other pediatric traffic injuries. Traffic Injury Prevention, 20(5), 540-543. ",{"tag":"a","props":{"href":"https://doi.org/10.1080/15389588.2019.1608361","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1080/15389588.2019.1608361"]},""]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["原书备注"]},{"tag":"p","props":{"className":"life-citations"},"children":["给 B 是因为法条和两起判例都核过，但伤情的数字只来自国外一家医院，国内没找到按年龄算的伤亡统计。连江那案取自司法局普法栏目的转载，判决书原文没找到。收益定大，是按那案 18.7 万元的赔偿套金钱口径，不是每起事故都赔这么多。共享电动自行车的用户协议也要求 16 周岁以上，别把自己的账号给孩子扫码。到了年龄再骑，也要戴头盔，见第 1 节第 2 条（戴头盔并扣好）和第 22 节第 12 条（骑山地车时戴头盔）。受益人主要是孩子，赔钱的是父母自己。"]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["我的备注"]},{"tag":"button","props":{"type":"button"},"children":["写下对自己有用的提醒…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/tip/30-19"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["上一条"]},"教孩子认识身体的隐私部位，被人碰了、被要求保密都要回家说；孩子说了先信、别骂，带去报警和就医"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/tip/30-21"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["下一条"]},"孩子运动时撞了头、之后头痛头晕或者发懵，当天别再上场；吐了又吐、越来越困、头痛越来越重，立刻去急诊"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["本主题的其他建议"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/30-03"},"children":[{"tag":"strong","props":{},"children":["孩子被欺凌，当天就报到学校并要求书面处理，涉及打人、抢钱、传谣的直接报警"]},{"tag":"span","props":{},"children":["被同伴欺凌的孩子，冒出自杀念头的可能约是没被欺凌的 2.2 倍，有过自杀行为的约 2.6 倍。学校接到报告要立即调查，认定是欺凌就要惩戒或处分，严重的不许瞒，必…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/30-04"},"children":[{"tag":"strong","props":{},"children":["让孩子每天在户外待够 2 小时，这是目前不花钱、不用药的办法里，唯一有随机试验支持的防近视办法"]},{"tag":"span","props":{},"children":["小学一年级每天多上 40 分钟户外课，三年后新近视的孩子从约四成降到约三成。卫健委给的量是每天白天在户外不少于 2 小时，或者一周加起来 14 小时。阴天也算数…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/30-05"},"children":[{"tag":"strong","props":{},"children":["0 到 3 岁不给屏幕，3 到 6 岁尽量不给，中小学生非学习用途每天不超过 1 小时"]},{"tag":"span","props":{},"children":["国家卫健委要求 0 到 3 岁不给屏幕，3 到 6 岁尽量别碰。中小学生不为学习用的，一次不超过 15 分钟、一天不超过 1 小时。理由是长时间近距离用眼会让近…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/30-06"},"children":[{"tag":"strong","props":{},"children":["把近视当成会留下的损伤：度数越深，将来视网膜脱离、黄斑病变、青光眼越多"]},{"tag":"span","props":{},"children":["近视不会自己好，度数也降不回去。它也不只是「戴个眼镜」的事。和不近视的人比，得近视性黄斑病变的可能，轻度近视高十几倍，600 度以上高几百倍。视网膜脱离，轻度高…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/30-07"},"children":[{"tag":"strong","props":{},"children":["每年那次学生体检的报告单要自己看一遍，异常项当年带去医院查"]},{"tag":"span","props":{},"children":["中小学校每年组织一次学生体检。报告单上要重点看的是超重、肥胖、营养不良、脊柱弯曲异常、视力不良、龋齿。别只看一眼身高体重就收起单子。这几项有异常，当年就带孩子去…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/30-08"},"children":[{"tag":"strong","props":{},"children":["12 到 18 岁的孩子做一次抑郁筛查，别拿学校的心理测评当诊断"]},{"tag":"span","props":{},"children":["美国的预防指南建议给 12 到 18 岁的孩子筛查重度抑郁，11 岁及以下证据不够。在美国，自杀是 10 到 19 岁孩子的第二位死因。学校每年的心理测评只是普…"]}]}]}]},{"tag":"a","props":{"className":"life-text-link","href":"/book/30"},"children":["阅读整个主题：上学以后的孩子 ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"15","height":"15","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]}]}]},{"tag":"nav","props":{"className":"life-tabbar","aria-label":"主导航"},"children":[{"tag":"a","props":{"className":"","href":"/book"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"21","height":"21","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-book-open","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M12 7v14"},"children":[]},{"tag":"path","props":{"d":"M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z"},"children":[]}]},{"tag":"span","props":{},"children":["全书"]}]},{"tag":"a","props":{"className":"","href":"/top-50"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"21","height":"21","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-star","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l