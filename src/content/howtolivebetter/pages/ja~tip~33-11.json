/book/33"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"目次に戻る"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["障害を負った後の生き方"]},{"tag":"div","props":{"data-ad-dock-host":"true"},"children":[]},{"tag":"nav","props":{"aria-label":"この章のヒント"},"children":[{"tag":"a","props":{"href":"/ja/tip/33-01"},"children":[{"tag":"span","props":{},"children":["01"]},"脊髄損傷の後に突然の激しい頭痛や発汗が見られたら、まずは体を起こして座らせ、衣服を緩め、同時に 120 を呼ぶ"]},{"tag":"a","props":{"href":"/ja/tip/33-02"},"children":[{"tag":"span","props":{},"children":["02"]},"障害を負った後の最初の10年間は自殺のハイリスク期です。「前向きに考えれば大丈夫」で済ませないでください"]},{"tag":"a","props":{"href":"/ja/tip/33-03"},"children":[{"tag":"span","props":{},"children":["03"]},"精神障害の入院は自発的な意思を原則とし、本人の同意なしで行えるのは以下の2つのケースのみである"]},{"tag":"a","props":{"href":"/ja/tip/33-04"},"children":[{"tag":"span","props":{},"children":["04"]},"在自宅で障害者を介護している人は、自身の健康管理を怠らないこと"]},{"tag":"a","props":{"href":"/ja/tip/33-05"},"children":[{"tag":"span","props":{},"children":["05"]},"車椅子を長時間使用する場合は、クッションを減圧型に交換し、毎日坐骨と尾骨の状態を確認すること"]},{"tag":"a","props":{"href":"/ja/tip/33-06"},"children":[{"tag":"span","props":{},"children":["06"]},"「麻痺、失明、難聴を治せる」といった療法や器具を買わないこと"]},{"tag":"a","props":{"href":"/ja/tip/33-07"},"children":[{"tag":"span","props":{},"children":["07"]},"障害者手帳の交付後、県級の残聯（障害者連合会）へ行き、申請可能な事項を一度にすべて確認する"]},{"tag":"a","props":{"href":"/ja/tip/33-08"},"children":[{"tag":"span","props":{},"children":["08"]},"7 歳未満で、新たに障害や自閉症（孤独症）が判明した子供については、県級の残聯へリハビリ救済を申請する"]},{"tag":"a","props":{"href":"/ja/tip/33-09"},"children":[{"tag":"span","props":{},"children":["09"]},"自宅のスロープ、手すり、浴室のリフォームについては、県級以上の政府に補助金を申請できる"]},{"tag":"a","props":{"href":"/ja/tip/33-10"},"children":[{"tag":"span","props":{},"children":["10"]},"中国で仕事を探すときは障害者証の所持を伝える。採用で企業の負担金を減らせる"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/ja/tip/33-11","data-status":"active"},"children":[{"tag":"span","props":{},"children":["11"]},"障害者の個人所得税は軽減される可能性があります。軽減額については、各省の税務局へ電話でご確認ください。"]},{"tag":"a","props":{"href":"/ja/tip/33-12"},"children":[{"tag":"span","props":{},"children":["12"]},"盲導犬は公共施設や公共交通機関への同伴が可能で、視覚障害者は市内のバスに無料で乗車できます"]},{"tag":"a","props":{"href":"/ja/tip/33-13"},"children":[{"tag":"span","props":{},"children":["13"]},"障害のある受験生は大学入試（高考）において合理的配慮を申請でき、点字答案を使用する場合、試験時間は1.5倍に延長される"]},{"tag":"a","props":{"href":"/ja/tip/33-14"},"children":[{"tag":"span","props":{},"children":["14"]},"障害のある子供の入学申請に対し、学校は拒否してはならない。登校が困難な場合は、教育局が訪問指導の手配を行う"]},{"tag":"a","props":{"href":"/ja/tip/33-15"},"children":[{"tag":"span","props":{},"children":["15"]},"右下肢または両下肢を欠損していても運転免許の取得は可能。準拠車種は C5 と呼ばれる"]},{"tag":"a","props":{"href":"/ja/tip/33-16"},"children":[{"tag":"span","props":{},"children":["16"]},"リハビリはリハビリテーション科のある正規の機関で行うこと。強度は療法士の指示に従う。激しければ良いというものではない"]},{"tag":"a","props":{"href":"/ja/tip/33-17"},"children":[{"tag":"span","props":{},"children":["17"]},"難聴を感じたら補聴器を検討すること。補聴器を使用する理由は「聞こえるようにするため」であり、「認知症予防のため」ではない"]},{"tag":"a","props":{"href":"/ja/tip/33-18"},"children":[{"tag":"span","props":{},"children":["18"]},"成人が「自身の事柄を管理できない」と判断するには、裁判所に申し立てて認定を受ける必要があり、家族の判断だけでは不十分である"]},{"tag":"a","props":{"href":"/ja/tip/33-19"},"children":[{"tag":"span","props":{},"children":["19"]},"成人の後見人は法定順序に従って定められます。被後見人が他人に損害を与えた場合、後見人が賠償します"]},{"tag":"a","props":{"href":"/ja/tip/33-20"},"children":[{"tag":"span","props":{},"children":["20"]},"障害を理由とした採用拒否、正社員登用拒否、給与の過少支払いは訴えることが可能ですが、まずはプロセスに伴うコストを計算してください"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"現在地"},"children":[{"tag":"a","props":{"href":"/ja/book"},"children":["本を読む"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/ja/book/33"},"children":["第33章"," ·"," ","障害を負った後の生き方"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"33-11"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["11"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["エビデンス"," ","A"]}]},{"tag":"h1","props":{"lang":"ja"},"children":["障害者の個人所得税は軽減される可能性があります。軽減額については、各省の税務局へ電話でご確認ください。"]},{"tag":"p","props":{"lang":"ja","className":"life-entry-summary"},"children":["個人所得税法には、障害者の所得に対して個人所得税を軽減できる旨が記載されています。ただし、軽減額や軽減期間については、法律によって各省政府に決定権が委ねられているため、省によって異なります。年度ごとに軽減限度額を定めている省もあれば、一定の割合で軽減する省もあります。確認方法は、12366 に電話して現地の税務局に問い合わせるか、個人所得税 App 内の軽減項目を確認してください。"]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["費用・手間"]},{"tag":"p","props":{},"children":["費用はかかりません。申告時に項目にチェックを入れるか、一度届出書類を提出するだけです。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["効果"]},{"tag":"p","props":{},"children":["『個人所得税法』第五条：「次のいずれかに該当する場合、個人所得税を軽減することができる。"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"記録する：障害者の個人所得税は軽減される可能性があります。軽減額については、各省の税務局へ電話でご確認ください。"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"できている"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","p