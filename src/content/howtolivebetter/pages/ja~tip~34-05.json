34-07"},"children":[{"tag":"span","props":{},"children":["07"]},"風邪のときに抗生物質を医師に求めないでください"]},{"tag":"a","props":{"href":"/ja/tip/34-08"},"children":[{"tag":"span","props":{},"children":["08"]},"下痢の際はまず経口補水液で水分補給を。5 歳未満の子供には止瀉薬を与えないでください"]},{"tag":"a","props":{"href":"/ja/tip/34-09"},"children":[{"tag":"span","props":{},"children":["09"]},"鎮痛薬は月に 15 日を超えて服用しないでください。配合鎮痛薬は 10 日を超えないように。さもないと、頭痛そのものが薬によって引き起こされる可能性があります"]},{"tag":"a","props":{"href":"/ja/tip/34-10"},"children":[{"tag":"span","props":{},"children":["10"]},"期限切れの薬や不要な残薬は定期的に処分しましょう。包装ごと有害ゴミとして捨て、家に残さないでください"]},{"tag":"a","props":{"href":"/ja/tip/34-11"},"children":[{"tag":"span","props":{},"children":["11"]},"セファロスポリン系やメトロニダゾールなどの抗菌薬の使用期間中および服用終了後7日間は、飲酒を控えること。藿香正気水（カッコウセイキスイ）や咳止めシロップなど、アルコールを含む薬も避けること"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"現在地"},"children":[{"tag":"a","props":{"href":"/ja/book"},"children":["本を読む"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/ja/book/34"},"children":["第34章"," ·"," ","家庭常備薬の誤用による事故を防ぐ"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"34-05"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["05"]},{"tag":"span","props":{"className":"life-evidence grade-b"},"children":["エビデンス"," ","B"]}]},{"tag":"h1","props":{"lang":"ja"},"children":["妊娠 20 週以降は、イブプロフェンなどの鎮痛薬を自己判断で服用しないでください"]},{"tag":"p","props":{"lang":"ja","className":"life-entry-summary"},"children":["妊娠 20 週以降、羊水の大部分は胎児の腎臓によって作られます。この時期にイブプロフェンのような薬を服用すると、胎児の腎臓にダメージを与え、羊水が減少する可能性があります。米国で報告された事例の中には、新生児死亡のケースも含まれています。医師が処方する低用量アスピリンは、このケースには含まれません。"]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["費用・手間"]},{"tag":"p","props":{},"children":["