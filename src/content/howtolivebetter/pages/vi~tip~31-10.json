18","height":"18","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-up-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M7 7h10v10"},"children":[]},{"tag":"path","props":{"d":"M7 17 17 7"},"children":[]}]}]}]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/vi/book/31"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"Quay lại mục lục"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["Sau mười tám tuổi có những con đường nào"]},{"tag":"div","props":{"data-ad-dock-host":"true"},"children":[]},{"tag":"nav","props":{"aria-label":"Các mục trong chương"},"children":[{"tag":"a","props":{"href":"/vi/tip/31-01"},"children":[{"tag":"span","props":{},"children":["01"]},"Đối chiếu điều kiện trước đã: yêu cầu về tuổi và trình độ của mười hai con đường đều được viết thành văn bản"]},{"tag":"a","props":{"href":"/vi/tip/31-02"},"children":[{"tag":"span","props":{},"children":["02"]},"Năm thứ mười tám tuổi phải đăng ký nghĩa vụ quân sự trước ngày 31 tháng 10; quân nhân lính nghĩa vụ nhập ngũ đúng hai năm"]},{"tag":"a","props":{"href":"/vi/tip/31-03"},"children":[{"tag":"span","props":{},"children":["03"]},"Sau khi được truy xuất mà từ chối nghĩa vụ quân sự thì trong hai năm không được xuất cảnh, không được học tiếp, và không vào được cơ quan công chức hay doanh nghiệp nhà nước"]},{"tag":"a","props":{"href":"/vi/tip/31-04"},"children":[{"tag":"span","props":{},"children":["04"]},"Hai điều thật nhất khi sinh viên đại học đi nghĩa vụ quân sự: học phí mỗi năm bù tối đa 20000 tệ, giữ học vị hai năm, và có một kế hoạch riêng cho tuyển sinh cao học"]},{"tag":"a","props":{"href":"/vi/tip/31-05"},"children":[{"tag":"span","props":{},"children":["05"]},"Sau khi giải ngũ chỉ có sáu trường hợp được chính quyền bố trí việc làm; người tự tìm việc phải đến đăng ký trong vòng 30 ngày"]},{"tag":"a","props":{"href":"/vi/tip/31-06"},"children":[{"tag":"span","props":{},"children":["06"]},"Ba khoản sau khi giải ngũ: tiền trở cấp một lần, thời gian phục vụ tính vào thâm niên công, và tự làm ăn thì mỗi năm giảm 20000 tệ thuế"]},{"tag":"a","props":{"href":"/vi/tip/31-07"},"children":[{"tag":"span","props":{},"children":["07"]},"Muốn vào hệ thống cơ quan công chức không chỉ có thi cao công chức: làm đủ hai năm ở chương trình phục vụ cơ sở thì dự được kế hoạch tuyển định hướng dành riêng cho 10% mỗi năm"]},{"tag":"a","props":{"href":"/vi/tip/31-08"},"children":[{"tag":"span","props":{},"children":["08"]},"Giáo viên vị trí đặc biệt hết hạn ba năm, đạt kết quả đánh giá và còn muốn ở lại thì phải được chuyển thành biên chế đúng thời hạn"]},{"tag":"a","props":{"href":"/vi/tip/31-09"},"children":[{"tag":"span","props":{},"children":["09"]},"Lính cứu hộ và nhân sự văn chứng quân đội là hai cửa tuyển công khai khác, ngưỡng thấp hơn thi công chức"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/vi/tip/31-10","data-status":"active"},"children":[{"tag":"span","props":{},"children":["10"]},"Bằng cấp không phải việc mua một lần là xong: thi tự học không giới hạn tuổi cũng không xem trình độ đã học, thi lớn và đại học mở đều bổ sung được"]},{"tag":"a","props":{"href":"/vi/tip/31-11"},"children":[{"tag":"span","props":{},"children":["11"]},"Không vào cơ quan công chức thì làm việc linh hoạt: hưu trí và y tế phải tự tham gia bảo hiểm ở nơi làm việc, hạn chế về hộ khẩu đã được nới"]},{"tag":"a","props":{"href":"/vi/tip/31-12"},"children":[{"tag":"span","props":{},"children":["12"]},"Giao đồ ăn, chạy xe ô tô công nghệ, chở hàng trong thành phố: sàn trả phí bảo hiểm tai nạn lao động theo từng đơn, bạn không phải đóng"]},{"tag":"a","props":{"href":"/vi/tip/31-13"},"children":[{"tag":"span","props":{},"children":["13"]},"Hai con đường chốt được chỗ làm việc có biên chế ngay từ ngày điền nguyện vọng kỳ thi gaokao: sinh viên sư phạm có học phí và sinh viên y khoa định hướng, cái giá là thực hiện cam kết 6 năm"]},{"tag":"a","props":{"href":"/vi/tip/31-14"},"children":[{"tag":"span","props":{},"children":["14"]},"Muốn đi làm công ăn nước ngoài, trước hết tra công ty này có giấy phép hợp tác lao động ngoài biên giới không: công ty không được đòi bạn đặt tiền"]},{"tag":"a","props":{"href":"/vi/tip/31-15"},"children":[{"tag":"span","props":{},"children":["15"]},"Làm việc từ xa cho công ty nước ngoài ngay tại nhà, khoản tiền này theo luật thuế tính là thu nhập trong nước: thuế thu nhập cá nhân tự kê khai, tiền về nước đi theo khoản「thù lao lao động」"]},{"tag":"a","props":{"href":"/vi/tip/31-16"},"children":[{"tag":"span","props":{},"children":["16"]},"Không vào cơ quan mà tự làm ăn, tiền khởi đầu hãy xem khoản vay bảo đảm khởi nghiệp: cá nhân tối đa 30 vạn, Nhà nước trợ một nửa lãi suất"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"Breadcrumbs"},"children":[{"tag":"a","props":{"href":"/vi/book"},"children":["Khám phá cuốn sách"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/vi/book/31"},"children":["Chương 31"," ·"," ","Sau mười tám tuổi có những con đường nào"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"31-10"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["10"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["Bằng chứng"," ","A"]}]},{"tag":"h1","props":{"lang":"vi"},"children":["Bằng cấp không phải việc mua một lần là xong: thi tự học không giới hạn tuổi cũng không xem trình độ đã học, thi lớn và đại học mở đều bổ sung được"]},{"tag":"p","props":{"lang":"vi","className":"life-entry-summary"},"children":["Năm mười tám tuổi không học được thì phía sau vẫn còn ba cửa chính thức: thi tự học, thi lớn cho người lớn, và đại học mở. Thi tự học không giới hạn tuổi, cũng không xem bạn đã học tới bậc nào, nhưng học sinh toàn thời gian thì không được thi. Thi lớn cho người lớn thì phải có bằng tốt nghiệp trung học hoặc cao đẳng. Cả ba đường đều chậm, nhưng không đường nào xem kết quả năm mười tám tuổi của bạn thế nào."]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Chi phí"]},{"tag":"p","props":{},"children":["Phí đăng ký và giáo trình mỗi năm mấy trăm tệ. Cái giá là…"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Lợi ích"]},{"tag":"p","props":{},"children":["Thi tự học thì xem《Quy chế lâm thời về thi tự học bậc đại học》. Điều ba:「中华人民共和国公民，不受性别、年龄、民族、种族和已受教育程度的限制，均可依…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"Đánh dấu: Bằng cấp không phải việc mua một lần là xong: thi tự học không giới hạn tuổi cũng không xem trình độ đã học, thi lớn và đại học mở đều bổ sung được"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"Hoàn tất"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"Kế hoạch thực hiện"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"Lưu"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Chia sẻ mẹo này"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Ẩn chi tiết"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Chi phí"]},{"tag":"p","props":{},"children":["Phí đăng ký và giáo trình mỗi năm mấy trăm tệ. Cái giá là học tự thọn lâu dài, hoặc đi học buổi tối; bậc đại học học song song với việc làm (không rời việc) tối thiểu phải học hai năm rưỡi. Chỗ khó là phải kiên trì lâu dài."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Lợi ích"]},{"tag":"p","props":{},"children":["Thi tự học thì xem《Quy chế lâm thời về thi tự học bậc đại học》. Điều ba:「中华人民共和国公民，不受性别、年龄、民族、种族和已受教育程度的限制，均可依照本条例的规定参加高等教育自学考试」, tức công dân Trung Quốc, không phân biệt giới tính, tuổi, dân tộc, chủng tộc và trình độ đã được giáo dục, đều có thể dự thi tự học bậc đại học theo quy định của quy chế này. Điều hai mươi:「各级各类全日制学校的在校生不得报考」, tức học sinh của mọi loại trường toàn thời gian không được dự thi. Điều hai mươi lăm nêu ba điều kiện để được cấp bằng: học xong và đạt tất cả các môn, hoàn thành luận văn tốt nghiệp hoặc nhiệm vụ thực hành, và đạt kết quả nhận xét về đạo đức. Làm đủ cả ba thì được cấp chứng chỉ tốt nghiệp. Điều đó còn viết「获得专科（基础科）或本科毕业证书者，国家承认其学历」, tức ai có bằng cao đẳng (phần cơ sở) hoặc bằng đại học thì Nhà nước công nhận trình độ đó. Điều ba mươi hai nêu mức lương của người có bằng:「非在职人员录用后，与普通高等学校同类毕业生相同」, tức người không đang làm việc sau khi được tuyển thì như người tốt nghiệp cùng loại của trường đại học thường. Điều hai mươi mốt của《Luật Giáo dục bậc cao》:「国家实行高等教育自学考试制度，经考试合格的，发给相应的学历证书或者其他学业证书」, tức Nhà nước thực hiện chế độ thi tự học bậc đại học, ai đỗ thì được cấp chứng chỉ trình độ hoặc chứng chỉ học vụ tương ứng. Thi lớn cho người lớn thì xem《Cách thức tuyển sinh các trường đại học dành cho người lớn toàn quốc năm 2025》. Đối tượng dự thi là「国家承认学历的各类高、中等学校在校生以外的从业人员和社会其他人员」, tức người lao động và người dân khác ngoài học sinh các trường trung học, trung cấp chính quy thừa nhận trình độ của Nhà nước. 「报考高起本或高起专的考生应高级中等教育学校毕业或者具有同等学力。报考专升本的考生必须是已取得……专科毕业证书、本科结业证书或以上证书的人员」, tức thí sinh dự thi khóa đại học hoặc cao đẳng bắt đầu từ trung học thì phải tốt nghiệp trường trung học phổ thông hoặc có trình độ tương đương; thí sinh dự thi bậc đại học phải là người đã có bằng cao đẳng, bằng hoàn thành bậc đại học hoặc giấy chứng nhận cao hơn. 「脱产最短学习时间为：高起本四年、高起专和专升本两年，非脱产最短学习时间为：高起本五年、高起专和专升本两年半」, tức thời gian học ngắn nhất khi rời việc học: khóa đại học bắt đầu từ trung học bốn năm, khóa cao đẳng bắt đầu từ trung học và khóa đại học hai năm; khi học song song với việc làm: khóa đại học bắt đầu từ trung học năm năm, khóa cao đẳng bắt đầu từ trung học và khóa đại học hai năm rưỡi. Rời việc học là bỏ việc ra trường học cả ngày, không rời việc là vừa đi làm vừa học. Đại học mở thì xem《Ý kiến của Bộ Giáo dục về việc làm tốt đại học mở》. Nó viết:「开放大学实行注册入学，学生修完课程并获得相应学分，即可获得课程证书，修满规定的学分并达到相关要求，即可获得相应的学历与非学历证书，符合学位授予条件的应授予相应学位」, tức đại học mở nhận đăng ký theo kiểu đăng ký trước, học sinh học xong môn và đạt đủ số tín chỉ thì có chứng chỉ môn học, tích lũy đủ số tín chỉ quy định và đạt các yêu cầu liên quan thì có chứng chỉ trình độ và chứng chỉ không phải trình độ, ai đủ điều kiện cấp bằng thì được cấp bằng tương ứng (toàn quốc)"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Nguồn gốc"]},{"tag":"p","props":{"className":"life-citations"},"children":["国务院 (1988, 2014 修订). 高等教育自学考试暂行条例（第三、二十、二十五、三十二条）. ",{"tag":"a","props":{"href":"https://flk.npc.gov.cn/detail?id=ff8080816f3cbb3c016f415d64e5236d","target":"_blank","rel":"noopener noreferrer"},"children":["https://flk.npc.gov.cn/detail?id=ff8080816f3cbb3c016f415d64e5236d"]},"（国家法律法规数据库）；全国人大常委会 (2018). 高等教育法（第二十一条）. ",{"tag":"a","props":{"href":"https://flk.npc.gov.cn/detail?id=ff8080816f135f46016f20df64ec16c5","target":"_blank","rel":"noopener noreferrer"},"children":["https://flk.npc.gov.cn/detail?id=ff8080816f135f46016f20df64ec16c5"]},"（国家法律法规数据库）；教育部办公厅 (2025). 关于做好 2025 年全国成人高校招生工作的通知（教学厅〔2025〕6 号）及附件《2025 年全国成人高校招生办法》. ",{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/202509/content_7040877.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/zhengce/zhengceku/202509/content_7040877.htm"]},"；教育部 (2016). 关于办好开放大学的意见（教职成〔2016〕2 号）. ",{"tag":"a","props":{"href":"http://www.gov.cn/gongbao/content/2016/content_5067956.htm","target":"_blank","rel":"noopener noreferrer"},"children":["http://www.gov.cn/gongbao/content/2016/content_5067956.htm"]},"；教育部 (2007). 关于进一步做好高等学校各类招生管理工作的通知（教发〔2007〕13 号）：「普通专升本招生计划按不超过当年应届普通高职（专科）毕业生5%的比例安排」. ",{"tag":"a","props":{"href":"http://www.moe.gov.cn/s78/A03/s7050/201006/t20100607_88782.html","target":"_blank","rel":"noopener noreferrer"},"children":["http://www.moe.gov.cn/s78/A03/s7050/201006/t20100607_88782.html"]},"；中国政府网 (2020). 今年扩招硕士18.9万，专升本32.2万——毕业生就业帮扶发力，教育部副部长翁铁慧：「扩大普通高校专升本的规模，同比争取增加32.2万人」. ",{"tag":"a","props":{"href":"http://www.gov.cn/zhengce/2020-02/29/content_5484774.htm","target":"_blank","rel":"noopener noreferrer"},"children":["http://www.gov.cn/zhengce/2020-02/29/content_5484774.htm"]},"；福建省教育考试院 (2026). 转发时引「教育部高校学生司《关于做好2026年普通高等学校专升本考试招生工作的通知》（教学司函〔2025〕53号）」. ",{"tag":"a","props":{"href":"https://www.eeafj.cn/gkzsb/20260310/14437.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.eeafj.cn/gkzsb/20260310/14437.html"]}]},{"tag":"a","props":{"href":"https://flk.npc.gov.cn/detail?id=ff8080816f3cbb3c016f415d64e5236d","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Liên kết mở nguồn"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Ghi chú sách"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["Còn một hình thức đại học cử nhân dành cho sinh viên tốt nghiệp cao đẳng toàn thời gian. Văn bản công khai ở cấp quốc gia là thông báo năm 2007 của Bộ Giáo dục, trong đó ghi kế hoạch đại học cử nhân không quá 5% số sinh viên tốt nghiệp cao đẳng của năm đó. Từ năm 2020 Bộ Giáo dục mở rộng quy mô đại học cử nhân, năm đó tăng thêm 32.2 vạn người so với năm trước, mức 5% thực tế không còn được áp dụng. Công tác cụ thể hằng năm do Cục Quản lý Sinh viên trường đại học của Bộ Giáo dục phát công văn, năm 2026 là 教学司函〔2025〕53 号. Công văn đó không công bố ra ngoài, chỉ thấy được số văn bản trong các văn bản mà tỉnh chuyển tiếp. Đối tượng tuyển do từng tỉnh tự quy định, về cơ bản chỉ nhận tốt nghiệp cao đẳng toàn thời gian của chính tỉnh trong năm đó, nên phần nội dung không viết điều kiện của nó. Từ mùa thu năm 2025, giáo dục tiếp tục bậc đại học không còn gọi là「函授」「业余」mà thống nhất gọi là「非脱产」. Giáo dục tiếp tục bậc đại học chính là loại học bổ sung trình độ sau này, còn dùng tên cũ trong quảng cáo thì phải cảnh giác. Bổ sung trình độ và「học kỹ năng gì thì đáng tiền」là hai việc khác nhau, về sau xem phần 23. Chứng chỉ bán「lấy nhanh」và chứng chỉ chếch mạch xem mục 8 ở phần 23."]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Ghi chú của tôi"]},{"tag":"button","props":{"type":"button"},"children":["Viết một lời nhắc cho chính bạn…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/vi/tip/31-09"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Trước"]},"Lính cứu hộ và nhân sự văn chứng quân đội là hai cửa tuyển công khai khác, ngưỡng thấp hơn thi công chức"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/vi/tip/31-11"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Tiếp theo"]},"Không vào cơ quan công chức thì làm việc linh hoạt: hưu trí và y tế phải tự tham gia bảo hiểm ở nơi làm việc, hạn chế về hộ khẩu đã được nới"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["Thêm trong chủ đề này"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/31-06"},"children":[{"tag":"strong","props":{},"children":["Ba khoản sau khi giải ngũ: tiền trở cấp một lần, thời gian phục vụ tính vào thâm niên công, và tự làm ăn thì mỗi năm giảm 20000 tệ thuế"]},{"tag":"span","props":{},"children":["Sau khi giải ngũ có ba khoản. Một là tiền trở cấp một lần cho người t…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/31-07"},"children":[{"tag":"strong","props":{},"children":["Muốn vào hệ thống cơ quan công chức không chỉ có thi cao công chức: làm đủ hai năm ở chương trình phục vụ cơ sở thì dự được kế hoạch tuyển định hướng dành riêng cho 10% mỗi năm"]},{"tag":"span","props":{},"children":["Muốn vào hệ thống cơ quan công chức thì không chỉ có thi cao công chứ…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/31-08"},"children":[{"tag":"strong","props":{},"children":["Giáo viên vị trí đặc biệt hết hạn ba năm, đạt kết quả đánh giá và còn muốn ở lại thì phải được chuyển thành biên chế đúng thời hạn"]},{"tag":"span","props":{},"children":["Kế hoạch vị trí đặc biệt là một trong số ít con đường mà văn bản ghi …"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/31-12"},"children":[{"tag":"strong","props":{},"children":["Giao đồ ăn, chạy xe ô tô công nghệ, chở hàng trong thành phố: sàn trả phí bảo hiểm tai nạn lao động theo từng đơn, bạn không phải đóng"]},{"tag":"span","props":{},"children":["Người giao đồ ăn, chạy xe ô tô công nghệ, chở hàn