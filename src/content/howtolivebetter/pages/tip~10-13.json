v","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["我的备注"]},{"tag":"button","props":{"type":"button"},"children":["写下对自己有用的提醒…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/tip/10-12"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["上一条"]},"配偶一方大额借的钱，你没签字也没追认，不自动变成你的债"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/tip/10-14"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["下一条"]},"婚前做一次婚检，有重大疾病必须在登记前如实告诉对方"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["本主题的其他建议"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/10-09"},"children":[{"tag":"strong","props":{},"children":["时间账按「无酬劳动」算，谈清分工再领证"]},{"tag":"span","props":{},"children":["全国时间利用调查里，家务和陪伴照料家人这类没报酬的活，男性每天平均 1 小时 52 分，女性 3 小时 29 分。调查没按结没结婚分组，所以「结了婚家务会多多少…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/10-10"},"children":[{"tag":"strong","props":{},"children":["结婚的钱账先看法律默认规则，再决定要不要书面约定"]},{"tag":"span","props":{},"children":["不签书面约定的话，法律默认婚后挣的工资奖金、经营和投资收益、继承或受赠的财产都归两人共有。婚前财产、遗嘱或赠与合同写明只给一方的，才是个人的。两个人可以书面约定…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/10-11"},"children":[{"tag":"strong","props":{},"children":["父母出资买房，在转账的时候就把是借是送写清楚"]},{"tag":"span","props":{},"children":["婚前父母出钱买房，默认只给自己孩子。婚后出的钱没约定，按夫妻共同财产算。2025 年 2 月起，婚后一方父母全额出资、又没写明只给自己孩子的，离婚时法院可以把房…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/10-15"},"children":[{"tag":"strong","props":{},"children":["算退出成本：协议离婚有 30 天冷静期，诉讼离婚有法定条件"]},{"tag":"span","props":{},"children":["协议离婚不是签完就完。交了申请后 30 天内，任何一方都能撤回。期满还要在 30 天内两人亲自去领离婚证，不去就当撤回。对方不同意，只能起诉。法院先调解，要有家…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/10-16"},"children":[{"tag":"strong","props":{},"children":["给「为长辈结婚」单独记一笔账，别和自己的账混在一起"]},{"tag":"span","props":{},"children":["长辈那份收益，也就是安心、面子、不再催，是真的。但它不会自动变成你的健康收益或关系质量。而时间账、钱账和退出成本这三笔，全部由你自己承担。在纸上分两栏，把哪些收…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/10-17"},"children":[{"tag":"strong","props":{},"children":["把关系好坏当成一笔健康账：吵架对事不对人，别骂人、别挖苦"]},{"tag":"span","props":{},"children":["夫妻关系好的，身体好一些，死亡风险也低一些。这个关联不大，和饮食对健康的关联差不多大。一项实验里，吵架时一直带着敌意的夫妻，实验做出的小伤口愈合速度只有平和夫妻…"]}]}]}]},{"tag":"a","props":{"className":"life-text-link","href":"/book/10"},"children":["阅读整个主题：恋爱和结婚划不划算 ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"15","height":"15","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]}]}]}]},{"tag":"aside","props":{"className":"life-ad-space life-ad-space-sponsored","data-ad-placement":"ad_footer","data-ad-group":"reading","data-