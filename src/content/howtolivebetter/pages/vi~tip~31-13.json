ns":"http://www.w3.org/2000/svg","width":"18","height":"18","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-up-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M7 7h10v10"},"children":[]},{"tag":"path","props":{"d":"M7 17 17 7"},"children":[]}]}]}]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/vi/book/31"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"Quay lại mục lục"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["Sau mười tám tuổi có những con đường nào"]},{"tag":"div","props":{"data-ad-dock-host":"true"},"children":[]},{"tag":"nav","props":{"aria-label":"Các mục trong chương"},"children":[{"tag":"a","props":{"href":"/vi/tip/31-01"},"children":[{"tag":"span","props":{},"children":["01"]},"Đối chiếu điều kiện trước đã: yêu cầu về tuổi và trình độ của mười hai con đường đều được viết thành văn bản"]},{"tag":"a","props":{"href":"/vi/tip/31-02"},"children":[{"tag":"span","props":{},"children":["02"]},"Năm thứ mười tám tuổi phải đăng ký nghĩa vụ quân sự trước ngày 31 tháng 10; quân nhân lính nghĩa vụ nhập ngũ đúng hai năm"]},{"tag":"a","props":{"href":"/vi/tip/31-03"},"children":[{"tag":"span","props":{},"children":["03"]},"Sau khi được truy xuất mà từ chối nghĩa vụ quân sự thì trong hai năm không được xuất cảnh, không được học tiếp, và không vào được cơ quan công chức hay doanh nghiệp nhà nước"]},{"tag":"a","props":{"href":"/vi/tip/31-04"},"children":[{"tag":"span","props":{},"children":["04"]},"Hai điều thật nhất khi sinh viên đại học đi nghĩa vụ quân sự: học phí mỗi năm bù tối đa 20000 tệ, giữ học vị hai năm, và có một kế hoạch riêng cho tuyển sinh cao học"]},{"tag":"a","props":{"href":"/vi/tip/31-05"},"children":[{"tag":"span","props":{},"children":["05"]},"Sau khi giải ngũ chỉ có sáu trường hợp được chính quyền bố trí việc làm; người tự tìm việc phải đến đăng ký trong vòng 30 ngày"]},{"tag":"a","props":{"href":"/vi/tip/31-06"},"children":[{"tag":"span","props":{},"children":["06"]},"Ba khoản sau khi giải ngũ: tiền trở cấp một lần, thời gian phục vụ tính vào thâm niên công, và tự làm ăn thì mỗi năm giảm 20000 tệ thuế"]},{"tag":"a","props":{"href":"/vi/tip/31-07"},"children":[{"tag":"span","props":{},"children":["07"]},"Muốn vào hệ thống cơ quan công chức không chỉ có thi cao công chức: làm đủ hai năm ở chương trình phục vụ cơ sở thì dự được kế hoạch tuyển định hướng dành riêng cho 10% mỗi năm"]},{"tag":"a","props":{"href":"/vi/tip/31-08"},"children":[{"tag":"span","props":{},"children":["08"]},"Giáo viên vị trí đặc biệt hết hạn ba năm, đạt kết quả đánh giá và còn muốn ở lại thì phải được chuyển thành biên chế đúng thời hạn"]},{"tag":"a","props":{"href":"/vi/tip/31-09"},"children":[{"tag":"span","props":{},"children":["09"]},"Lính cứu hộ và nhân sự văn chứng quân đội là hai cửa tuyển công khai khác, ngưỡng thấp hơn thi công chức"]},{"tag":"a","props":{"href":"/vi/tip/31-10"},"children":[{"tag":"span","props":{},"children":["10"]},"Bằng cấp không phải việc mua một lần là xong: thi tự học không giới hạn tuổi cũng không xem trình độ đã học, thi lớn và đại học mở đều bổ sung được"]},{"tag":"a","props":{"href":"/vi/tip/31-11"},"children":[{"tag":"span","props":{},"children":["11"]},"Không vào cơ quan công chức thì làm việc linh hoạt: hưu trí và y tế phải tự tham gia bảo hiểm ở nơi làm việc, hạn chế về hộ khẩu đã được nới"]},{"tag":"a","props":{"href":"/vi/tip/31-12"},"children":[{"tag":"span","props":{},"children":["12"]},"Giao đồ ăn, chạy xe ô tô công nghệ, chở hàng trong thành phố: sàn trả phí bảo hiểm tai nạn lao động theo từng đơn, bạn không phải đóng"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/vi/tip/31-13","data-status":"active"},"children":[{"tag":"span","props":{},"children":["13"]},"Hai con đường chốt được chỗ làm việc có biên chế ngay từ ngày điền nguyện vọng kỳ thi gaokao: sinh viên sư phạm có học phí và sinh viên y khoa định hướng, cái giá là thực hiện cam kết 6 năm"]},{"tag":"a","props":{"href":"/vi/tip/31-14"},"children":[{"tag":"span","props":{},"children":["14"]},"Muốn đi làm công ăn nước ngoài, trước hết tra công ty này có giấy phép hợp tác lao động ngoài biên giới không: công ty không được đòi bạn đặt tiền"]},{"tag":"a","props":{"href":"/vi/tip/31-15"},"children":[{"tag":"span","props":{},"children":["15"]},"Làm việc từ xa cho công ty nước ngoài ngay tại nhà, khoản tiền này theo luật thuế tính là thu nhập trong nước: thuế thu nhập cá nhân tự kê khai, tiền về nước đi theo khoản「thù lao lao động」"]},{"tag":"a","props":{"href":"/vi/tip/31-16"},"children":[{"tag":"span","props":{},"children":["16"]},"Không vào cơ quan mà tự làm ăn, tiền khởi đầu hãy xem khoản vay bảo đảm khởi nghiệp: cá nhân tối đa 30 vạn, Nhà nước trợ một nửa lãi suất"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"Breadcrumbs"},"children":[{"tag":"a","props":{"href":"/vi/book"},"children":["Khám phá cuốn sách"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/vi/book/31"},"children":["Chương 31"," ·"," ","Sau mười tám tuổi có những con đường nào"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"31-13"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["13"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["Bằng chứng"," ","A"]}]},{"tag":"h1","props":{"lang":"vi"},"children":["Hai con đường chốt được chỗ làm việc có biên chế ngay từ ngày điền nguyện vọng kỳ thi gaokao: sinh viên sư phạm có học phí và sinh viên y khoa định hướng, cái giá là thực hiện cam kết 6 năm"]},{"tag":"p","props":{"lang":"vi","className":"life-entry-summary"},"children":["Cả hai con đường đều là Nhà nước trả hộ bạn trước, sau khi tốt nghiệp bạn đi làm đúng chỗ đã cam kết trong 6 năm. Sinh viên sư phạm có học phí chỉ tuyển ở sáu trường đại học sư phạm trực thuộc Bộ Giáo dục, nhận theo lô trước. Sinh viên y khoa định hướng phải ký thỏa thuận ba bên trước khi nhận được giấy báo nhập học. Vi phạm thì hoàn tiền, nộp phạt, còn bị ghi vào lịch sử tín dụng. Hãy nghĩ kỹ chuyện có chịu được 6 năm ấy không rồi mới điền nguyện vọng."]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Chi phí"]},{"tag":"p","props":{},"children":["Không tốn tiền. Cả học phí và tiền ở trong cũng do Nhà nướ…"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Lợi ích"]},{"tag":"p","props":{},"children":["Phần sinh viên sư phạm có học phí thì xem《Biện pháp thực hiện chế độ giáo dục có học phí cho sinh viên sư phạm…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"Đánh dấu: Hai con đường chốt được chỗ làm việc có biên chế ngay từ ngày điền nguyện vọng kỳ thi gaokao: sinh viên sư phạm có học phí và sinh viên y khoa định hướng, cái giá là thực hiện cam kết 6 năm"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"Hoàn tất"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"Kế hoạch thực hiện"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"Lưu"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Chia sẻ mẹo này"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Ẩn chi tiết"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Chi phí"]},{"tag":"p","props":{},"children":["Không tốn tiền. Cả học phí và tiền ở trong cũng do Nhà nước chi trả, lại còn có trợ cấp sinh hoạt. Cái giá là 6 năm sau khi tốt nghiệp không được tự do chọn việc, vi phạm thì phải hoàn tiền, nộp phạt và bị ghi vào lịch sử tín dụng. Chỗ khó là trong 6 năm ấy không đổi được nơi."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Lợi ích"]},{"tag":"p","props":{},"children":["Phần sinh viên sư phạm có học phí thì xem《Biện pháp thực hiện chế độ giáo dục có học phí cho sinh viên sư phạm liên thông bậc đại học và sau đại học của các trường đại học sư phạm trực thuộc Bộ Giáo dục》(năm 2024, biện pháp năm 2018 bãi bỏ cùng lúc). Điều hai: học phí và tiền ở trong trong thời gian học do ngân sách trung ương chi trả, có trợ cấp sinh hoạt. Điều ba: chủ yếu đào tạo ở các địa phương cấp địa (tỉnh, khu, thành phố, châu) và cấp dưới, ngoài các thủ phố của khu vực trung và phía Tây. Điều đó còn viết「不得定向到直辖市、计划单列市或省会城市主城区任教（五个自治区、陆地边境省份、海南省、贵州省、青海省除外）」, tức không được định hướng dạy ở khu chính thành của thành phố trực thuộc trung ương, thành phố tách riêng theo kế hoạch, hoặc thủ phủ tỉnh (trừ năm khu tự trị, các tỉnh biên giới trên mặt đất, tỉnh Hải Nam, tỉnh Quý Châu, tỉnh Thanh Hải). Điều chín: sau khi tốt nghiệp thì về dạy ở trường tiểu học và trung học của tỉnh gốc theo định hướng đã cam kết,「承诺从事中小学教育工作 6 年以上」, tức cam kết dạy ở trường tiểu học và trung học từ 6 năm trở lên. Người đi làm ở trường ở đô thị thì「应到农村义务教育学校任教服务至少 1 年」, tức phải dạy ở trường giáo dục bắt buộc nông thôn ít nhất 1 năm. Điều mười ba: không thực hiện hoặc không đủ thời gian thực hiện thì chịu trách nhiệm theo thỏa thuận. Một hậu quả là「违约行为纳入信用记录，并及时与全国信用信息共享平台共享，违约相关材料归入本人人事档案」, tức hành vi vi phạm được ghi vào lịch sử tín dụng và kịp thời chia sẻ với nền tảng thông tin tín dụng toàn quốc, hồ sơ liên quan đến vi phạm đưa vào hồ sơ nhân sự của chính người đó. Câu khác là「履约任务完成前不得到定向地（市、州、盟）之外从教，不得被招录（聘用）为其他公务人员。完成履约任务后即修复相关信用」, tức chưa hoàn thành nghĩa vụ thì không được dạy ở ngoài địa phương định hướng, không được tuyển hay bổ nhiệm làm công chức khác; hoàn thành nghĩa vụ thì lịch sử tín dụng liên quan được khôi phục. Chưa đủ thời gian phục vụ ghi trong thỏa thuận thì không dự được chức vụ công lập khác, đủ thời gian thì lịch sử tín dụng mới trở lại. Điều sáu: sau khi nhập học mà xét thấy không phù hợp làm giáo viên thì trong 1 năm nhập học phải hoàn lại chi phí giáo dục có học phí đã được hưởng, và chuyển sang chuyên ngành phi sư phạm. Điều mười bốn: không có bằng thạc sĩ giáo dục và giấy chứng nhận giáo viên trong thời gian học quy định thì coi như vi phạm, hoàn tiền và nộp phạt. Điều hai mươi mốt: các địa phương phải giải quyết chỗ làm việc cần thiết cho sinh viên sư phạm có học phí dạy ở trường tiểu học và trung học trong tổng số biên chế sự vệ hiện có. Phần sinh viên y khoa định hướng miễn phí theo đơn đặt hàng nông thôn thì xem một thông báo khác. Sau khi nhập học, trước khi nhận được giấy báo nhập học, phải ký thỏa thuận với trường đào tạo và cơ quan quản lý y tế, nhân sự xã hội cấp huyện nơi định hướng việc làm. Trong thỏa thuận phải「承诺毕业后到定向农村基层医疗卫生机构服务 6 年」, tức cam kết sau khi tốt nghiệp sẽ làm việc 6 năm tại cơ sở y tế cơ sở nông thôn được chỉ định. Thực hiện cam kết nghĩa là đi đúng chỗ đã hẹn làm đủ thời gian. Sau khi đến báo cáo và làm việc, phải tham gia đào tạo chuyên khoa bác sĩ đa khoa hồi sức theo tiêu chuẩn thống nhất trong 3 năm, gọi tắt là đào tạo quy chuẩn. Đào tạo quy chuẩn là giai đoạn sau khi tốt nghiệp tiếp tục rèn nghề trong bệnh viện theo tiêu chuẩn thống nhất. Trong thời gian đào tạo thì quan hệ nhân sự và lương cũ giữ nguyên. Hồ sơ vi phạm đưa vào hồ sơ nhân sự cá nhân và làm căn cứ đánh giá lòng tin trong tuyển dụng công khai của các cơ quan hành chính sự vệ như cơ quan y tế, trong tuyển dục bác sĩ đa khoa hồi sức và trong tuyển sinh sau đại học. Người vi phạm cố ý sẽ được niêm yết toàn quốc qua trang「信用中国」, và bị trừng phạt liên ngành vì mất uy tín. Thời gian đào tạo bị vi phạm thì không tính vào thời gian phục vụ. Người không hoàn lại phí và tiền phạt theo thỏa thuận thì cơ quan quản lý y tế cấp huyện truy thu qua đường pháp lý (toàn quốc)"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Nguồn gốc"]},{"tag":"p","props":{"className":"life-citations"},"children":["国务院办公厅 (2024). 关于转发教育部等部门《教育部直属师范大学本研衔接师范生公费教育实施办法》的通知（国办发〔2024〕27 号，第二、三、六、九、十三、十四、二十一条）. ",{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/202406/content_6957261.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/zhengce/zhengceku/202406/content_6957261.htm"]},"；国家卫生健康委、中央编办、国家发展改革委、教育部、财政部、人力资源社会保障部、国家中医药局 (2019). 关于做好农村订单定向免费培养医学生就业安置和履约管理工作的通知. ",{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/2019-11/13/content_5451684.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/zhengce/zhengceku/2019-11/13/content_5451684.htm"]}]},{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/202406/content_6957261.htm","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Liên kết mở nguồn"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Ghi chú sách"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["Bản năm 2024 đã đổi sinh viên sư phạm có học phí thành hình thức「liên thông», tức học xong bậc đại học thì học tiếp thạc sĩ giáo dục. Biện pháp cũ năm 2018 đã bãi bỏ, cái「tốt nghiệp đại học là dạy thẳng」còn truyền trên mạng là cách nói cũ. Người đã ký thỏa thuận trước khi bản này ban hành thì theo thỏa thuận cũ.「Có biên chế」không có nghĩa là「vào là xong」: biên chế phải bố trí được trong tổng số hiện có, vị trí cụ thể do thành phố tổ chức trường tuyển dụng riêng, bạn và trường cùng chọn nhau. Sinh viên y khoa định hướng hết hạn mà muốn đi thì được, văn bản ghi「服务期满，对自主择业的应予同意」. Người đã vi phạm cũng có cách xoá hồ sơ vi phạm, cái giá là theo thỏa thuận cũ, hoặc đổi sang cơ sở khác trong tỉnh và làm đủ ít nhất 6 năm nữa, phí và tiền phạt đã nộp không hoàn lại. Sinh viên y khoa còn phải tính thêm thời gian đào tạo quy chuẩn 3 năm, nên toàn chu kỳ dài hơn ngành sư phạm. Mỗi tỉnh còn có kế hoạch riêng cho sinh viên sư phạm có học phí và sinh viên y khoa định hướng, điều kiện do tỉnh quy định, trước khi điền nguyện vọng hãy xem tài liệu tuyển sinh năm đó của tỉnh mình."]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Ghi chú của tôi"]},{"tag":"button","props":{"type":"button"},"children":["Viết một lời nhắc cho chính bạn…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/vi/tip/31-12"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Trước"]},"Giao đồ ăn, chạy xe ô tô công nghệ, chở hàng trong thành phố: sàn trả phí bảo hiểm tai nạn lao động theo từng đơn, bạn không phải đóng"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/vi/tip/31-14"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Tiếp theo"]},"Muốn đi làm công ăn nước ngoài, trước hết tra công ty này có giấy phép hợp tác lao động ngoài biên giới không: công ty không được đòi bạn đặt tiền"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"chil