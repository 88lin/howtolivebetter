ildren":[]},{"tag":"path","props":{"d":"M20 12h2"},"children":[]},{"tag":"path","props":{"d":"m6.34 17.66-1.41 1.41"},"children":[]},{"tag":"path","props":{"d":"m19.07 4.93-1.41 1.41"},"children":[]}]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"17","height":"17","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-moon life-theme-icon-dark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"},"children":[]}]}]},{"tag":"button","props":{"type":"button","className":"life-language-switch","aria-label":"Русский Выбрать язык","aria-haspopup":"menu","aria-expanded":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-globe","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]},{"tag":"path","props":{"d":"M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"},"children":[]},{"tag":"path","props":{"d":"M2 12h20"},"children":[]}]},{"tag":"span","props":{},"children":["Русский"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]}]},{"tag":"a","props":{"className":"life-account","href":"/ru/sign-in"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"17","height":"17","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle-user-round","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M18 20a6 6 0 0 0-12 0"},"children":[]},{"tag":"circle","props":{"cx":"12","cy":"10","r":"4"},"children":[]},{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},{"tag":"span","props":{},"children":["Войти"]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/ru/book/33"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"К содержанию"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["Как жить после инвалидности"]},{"tag":"nav","props":{"aria-label":"Советы главы"},"children":[{"tag":"a","props":{"href":"/ru/tip/33-01"},"children":[{"tag":"span","props":{},"children":["01"]},"Внезапная сильная головная боль и потоотделение после травмы спинного мозга: сначала помогите пострадавшему сесть прямо, ослабьте одежду и вызовите скорую помощь"]},{"tag":"a","props":{"href":"/ru/tip/33-02"},"children":[{"tag":"span","props":{},"children":["02"]},"Первые десять лет после инвалидизации — период высокого риска суицида; это нельзя списывать на «просто нужно настроиться на позитивный лад»"]},{"tag":"a","props":{"href":"/ru/tip/33-03"},"children":[{"tag":"span","props":{},"children":["03"]},"Госпитализация при психических расстройствах основывается на добровольном согласии; существуют лишь два исключения, когда допускается госпитализация без согласия пациента"]},{"tag":"a","props":{"href":"/ru/tip/33-04"},"children":[{"tag":"span","props":{},"children":["04"]},"За тем, кто долгое время ухаживает за инвалидом в семье, нужно присматривать и за собственным здоровьем"]},{"tag":"a","props":{"href":"/ru/tip/33-05"},"children":[{"tag":"span","props":{},"children":["05"]},"Для людей, которые долгое время пользуются инвалидной коляской, стоит заменить сиденье на специальное противопролежневое и каждый день проверять состояние седалищной и копчиковой костей"]},{"tag":"a","props":{"href":"/ru/tip/33-06"},"children":[{"tag":"span","props":{},"children":["06"]},"Не покупайте методы лечения и приборы, которые «излечивают паралич, слепоту и глухоту»"]},{"tag":"a","props":{"href":"/ru/tip/33-07"},"children":[{"tag":"span","props":{},"children":["07"]},"После получения удостоверения инвалида сходите в органы гражданской администрации на уровне уезда и уточните сразу все доступные льготы"]},{"tag":"a","props":{"href":"/ru/tip/33-08"},"children":[{"tag":"span","props":{},"children":["08"]},"Для детей младше 7 лет с инвалидностью или аутизмом необходимо обратиться в органы гражданской администрации на уровне уезда для получения помощи по реабилитации"]},{"tag":"a","props":{"href":"/ru/tip/33-09"},"children":[{"tag":"span","props":{},"children":["09"]},"За модернизацию пандусов, поручней и ванных комнат в доме можно подать заявку на субсидию в органы гражданской администрации на уровне уезда и выше"]},{"tag":"a","props":{"href":"/ru/tip/33-10"},"children":[{"tag":"span","props":{},"children":["10"]},"При трудоустройстве стоит самостоятельно упомянуть о наличии удостоверения инвалида — это позволит работодателю сэкономить деньги"]},{"tag":"a","props":{"href":"/ru/tip/33-11"},"children":[{"tag":"span","props":{},"children":["11"]},"Налог на доходы физических лиц для людей с инвалидностью может быть уменьшен; сколько именно — уточните по телефону в налоговой службе вашего региона"]},{"tag":"a","props":{"href":"/ru/tip/33-12"},"children":[{"tag":"span","props":{},"children":["12"]},"Собак-поводырей можно приводить в общественные места и на общественный транспорт; слепые люди могут бесплатно ездить на городском общественном транспорте"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/ru/tip/33-13","data-status":"active"},"children":[{"tag":"span","props":{},"children":["13"]},"Лица с инвалидностью, сдающие вступительные экзамены, могут получить необходимые удобства; при использовании шрифта Брайля время экзамена увеличивается на 50%"]},{"tag":"a","props":{"href":"/ru/tip/33-14"},"children":[{"tag":"span","props":{},"children":["14"]},"Органы гражданской администрации не вправе отказывать в зачислении детям с инвалидностью; для тех, кто не может посещать школу, местные органы образования организуют обучение на дому"]},{"tag":"a","props":{"href":"/ru/tip/33-15"},"children":[{"tag":"span","props":{},"children":["15"]},"Люди без правой или обеих нижних конечностей тоже могут получить водительские права категории C5"]},{"tag":"a","props":{"href":"/ru/tip/33-16"},"children":[{"tag":"span","props":{},"children":["16"]},"Реабилитацию следует проходить в специализированных учреждениях, где есть отделение реабилитологии; интенсивность занятий определяет врач-реабилитолог, и она не обязательно должна быть максимальной"]},{"tag":"a","props":{"href":"/ru/tip/33-17"},"children":[{"tag":"span","props":{},"children":["17"]},"Снижение слуха — повод подобрать слуховой аппарат. Его назначают ради того, чтобы слышать, а не для профилактики слабоумия"]},{"tag":"a","props":{"href":"/ru/tip/33-18"},"children":[{"tag":"span","props":{},"children":["18"]},"Если говорят, что взрослый человек «не может самостоятельно распоряжаться своими делами», для этого нужно подать в суд заявление о признании его недееспособным или ограниченно дееспособным; мнение родственников здесь не имеет значения"]},{"tag":"a","props":{"href":"/ru/tip/33-19"},"children":[{"tag":"span","props":{},"children":["19"]},"Порядок назначения опекунов для совершеннолетних определяется законом; если подопечный причинил вред другим, ответственность несет опекун"]},{"tag":"a","props":{"href":"/ru/tip/33-20"},"children":[{"tag":"span","props":{},"children":["20"]},"Если вас не взяли на работу, не перевели на постоянную ставку или урезали зарплату из‑за инвалидности, вы можете подать в суд, но сначала рассчитайте все связанные расходы"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"Навигация"},"children":[{"tag":"a","props":{"href":"/ru/book"},"children":["Книга"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/ru/book/33"},"children":["Глава 33"," ·"," ","Как жить после инвалидности"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"33-13"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["13"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["Доказательства"," ","A"]}]},{"tag":"h1","props":{"lang":"ru"},"children":["Лица с инвалидностью, сдающие вступительные экзамены, могут получить необходимые удобства; при использовании шрифта Брайля время экзамена увеличивается на 50%"]},{"tag":"p","props":{"lang":"ru","className":"life-entry-summary"},"children":["Для абитуриентов с инвалидностью существует ряд льгот, прописанных в документе Министерства образования и Китайской федерации инвалидов. К ним относятся экзаменационные листы на шрифте Брайля или крупным шрифтом, освобождение от теста на аудирование иностранного языка, увеличение времени на сдачу, выделение отдельного аудиторного помещения, возможность принести слуховые аппараты и инвалидные коляски. Эти льготы не предоставляются автоматически — их нужно запросить в установленный срок и по утвержденной процедуре в органе регионального образования, приложив удостоверение инвалида нового образца. Если результаты запроса не устраивают, можно подать апелляцию в региональное управление образования."]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Затраты"]},{"tag":"p","props":{},"children":["Бесплатно. Необходимо в установленный в регионе срок подат…"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Польза"]},{"tag":"p","props":{},"children":["В статье 5 «Положения об обеспечении удобств для лиц с инвалидностью при сдаче всекитайских вступительных экза…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"Отметить: Лица с инвалидностью, сдающие вступительные экзамены, могут получить необходимые удобства; при использовании шрифта Брайля время экзамена увеличивается на 50%"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"Сделано"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"В планах"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"В избранное"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Поделиться советом"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Скрыть подробности"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Затраты"]},{"tag":"p","props":{},"children":["Бесплатно. Необходимо в установленный в регионе срок подать письменное заявление и пройти личное подтверждение."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Польза"]},{"tag":"p","props":{},"children":["В статье 5 «Положения об обеспечении удобств для лиц с инвалидностью при сдаче всекитайских вступительных экзаменов» перечислены 12 видов льгот. Среди них предоставление экзаменационных листов на шрифте Брайля, крупным шрифтом или обычных листов для слабовидящих; освобождение от теста на аудирование иностранного языка для слабослышащих; разрешение приносить в аудиторию специальные приспособления: планшеты для письма шрифтом Брайля, пишущие машинки без функции записи, электронные увеличители изображения, трости, увеличительные очки; разрешение приносить слуховые аппараты и кохлеарные имплантаты; разрешение использовать инвалидные коляски и ходунки, а также специальные столы и стулья при наличии особых потребностей. В пункте 6 статьи 5 указано, на сколько увеличивается время экзамена: «Для слабовидящих абитуриентов, сдающих экзамен на листах шрифта Брайля, время экзамена по каждому предмету увеличивается на 50% от установленного общего лимита; для слабовидящих, сдающих на листах крупным шрифтом или обычных, а также для тех, у кого из-за церебрального паралича или других заболеваний нарушена способность писать или нет конечностей, время экзамена увеличивается на 30%». Кроме того, предусмотрены приоритетный вход в аудиторию, выделение отдельного стандартизированного помещения, сопровождение гидом и сурдопереводчиком. Процедура подачи заявления описана в статье 7: нужно в установленный срок и по месту, указанному региональным органом образования, подать письменное заявление с приложением удостоверения инвалида нового образца; после этого экспертная комиссия проводит проверку и оценку, а орган образования выдает уведомление. В статье 8 указано, что при несогласии с уведомлением можно подать апелляцию в региональное управление образования. В статье 9 сказано, что при освобождении от аудирования иностранного языка его итоговая оценка рассчитывается по формуле: «Оценка за письменную часть × общий балл по предмету / балл за письменную часть». В статье 18 указано, что аналогичные льготы можно запросить и при сдаче других государственных экзаменов (вступительных экзаменов в магистратуру, экзаменов для взрослых и т.д.) — документ вступил в силу 7 апреля 2017 года по всей стране."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Первоисточники"]},{"tag":"p","props":{"className":"life-citations"},"children":["教育部、中国残联 (2017). 残疾人参加普通高等学校招生全国统一考试管理规定（教学〔2017〕4 号，第五条、第七条、第八条、第九条、第十八条）. ",{"tag":"a","props":{"href":"http://www.gov.cn/zhengce/zhengceku/2017-04/12/content_5650060.htm","target":"_blank","rel":"noopener noreferrer"},"children":["http://www.gov.cn/zhengce/zhengceku/2017-04/12/content_5650060.htm"]}]},{"tag":"a","props":{"href":"http://www.gov.cn/zhengce/zhengceku/2017-04/12/content_5650060.htm","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Открыть источник"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Примечание автора"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["Сроки подачи заявления устанавливаются каждым регионом и прописаны в правилах регистрации на вступительные экзамены текущего года; пропустить их нельзя. Поэтому уже в первом семестре старшей школы нужно проверить на официальном сайте регионального органа образования актуальные даты. Пункт 18 дает дополнительную возможность: аналогичные льготы можно запросить и при сдаче вступительных экзаменов в магистратуру, экзаменов для взрослых и других государственных экзаменов. Пункт 14 этого же раздела гарантирует, что учебные заведения не имеют права отказать в зачислении таким абитуриентам. Эти льготы полезны в первую очередь вам или вашим детям."]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Моя заметка"]},{"tag":"button","props":{"type":"button"},"children":["Запишите напоминание…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/ru/tip/33-12"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Предыдущий"]},"Собак-поводырей можно приводить в общественные места и на общественный транспорт; слепые люди могут бесплатно ездить на городском общественном транспорте"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/ru/tip/33-14"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Следующий"]},"Органы гражданской администрации не вправе отказывать в зачислении детям с инвалидностью; для тех, кто не может посещать школу, местные органы образования организуют обучение на дому"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["Другие советы по этой теме"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/33-09"},"children":[{"tag":"strong","props":{},"children":["За модернизацию пандусов, поручней и ванных комнат в доме можно подать заявку на субсидию в органы гражданской администрации на уровне уезда и выше"]},{"tag":"span","props":{},"children":["В «Законе о создании безбарьерной среды» указано: органы гражданской …"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/33-10"},"children":[{"tag":"strong","props":{},"children":["При трудоустройстве стоит самостоятельно упомянуть о наличии удостоверения инвалида — это позволит работодателю сэкономить деньги"]},{"tag":"span","props":{},"children":["Работодатели обязаны трудоустраивать инвалидов в количестве не менее …"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/33-11"},"children":[{"tag":"strong","props":{},"children":["Налог на доходы физических лиц для людей с инвалидностью может быть уменьшен; сколько именно — уточните по телефону в налоговой службе вашего региона"]},{"tag":"span","props":{},"children":["В Налоговом кодексе РФ указано, что доходы людей с инвалидностью могу…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/33-15"},"children":[{"tag":"strong","props":{},"children":["Люди без правой или обеих нижних конечностей тоже могут получить водительские права категории C5"]},{"tag":"span","props":{},"children":["В правилах МВД существует специальная категория водительских прав — «…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/33-16"},"children":[{"tag":"strong","props":{},"children":["Реабилитацию следует проходить в специализированных учреждениях, где есть отделение реабилитологии; интенсивность занятий определяет врач-реабилитолог, и она не обязательно должна быть максимальной"]},{"tag":"span","props":{},"children":["Самая распространённая ошибка — оставлять пациента дома, пусть он про…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/33-17"},"children":[{"tag":"strong","props":{},"children":["Снижение слуха — повод подобрать слуховой аппарат. Его назначают ради того, чтобы слышать, а не для профилактики слабоумия"]},{"tag":"span","props":{},"children":["Утверждение «ношение слухового аппарата помогает предотвратить слабоу…"]}]}]}]},{"tag":"a","props":{"className":"life-text-link","href":"/ru/book/33"},"children":["Читать всю тему: Как жить после инвалидности"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"15","height":"15","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]}]}]},{"tag":"nav","props":{"className":"life-tabbar","aria-label":"Основная навигация"},"children":[{"tag":"a","props":{"class