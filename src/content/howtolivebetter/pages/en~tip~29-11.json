eLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"Save"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Share this tip"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Hide details"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Cost"]},{"tag":"p","props":{},"children":["No cost involved. Both hotlines are free to call. Psychology clinic visits are billed at standard outpatient rates."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Benefit"]},{"tag":"p","props":{},"children":["A 2026 plan jointly issued by 25 government departments including the National Health Commission calls for improving operational rules for the 12356 mental health helpline. Goals include ensuring stable service delivery, raising call connection rates, developing a provincial-level digital platform for 12356, and strengthening coordination between 12356 and other emergency hotlines such as 110. The plan also aims to expand and optimize the 12355 youth support service, integrating it with 12356. By 2030, three key targets must be met: over 80% of administrative villages and urban communities must have mental health counseling rooms or social service centers offering relevant services; every county-level area must have at least one public psychiatric hospital or medical facility providing psychology clinic services; and all provinces must have their own provincial 12356 platforms. The mental health crisis response and support workforce includes psychiatrists, psychotherapists, counselors, social workers, and volunteers. The plan also specifies three groups who must stay alert to early warning signs of mental health risks: community grid workers, social workers, and volunteers. They are tasked with promptly identifying situations such as family crises, job loss, or school dropout. (Source: National policy document issued March 2026)"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Original sources"]},{"tag":"p","props":{"className":"life-citations"},"children":["国家卫生健康委等 25 部门 (2026). 关于印发健全社会心理服务体系和危机干预机制实施方案的通知（国卫医政发〔2026〕8 号）. ",{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/202604/content_7065035.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/zhengce/zhengceku/202604/content_7065035.htm"]}]},{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/202604/content_7065035.htm","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Open source link"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Book note"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["This grade is assigned because the establishment of counseling rooms in villages and communities and psychology clinics at county level are only planned targets for 2030, not yet universally available nationwide. Both 12356 and 12355 are already operational. Details on the launch date and daily operating hours of 12356 can be found in Section 1, Article 25. It is also important to note that psychological counseling and psychotherapy are distinct services: only licensed psychiatrists can make diagnoses and prescribe medication, and psychotherapy must be delivered at qualified medical institutions. Private, hourly-fee “healing” or “spiritual counseling” services fall outside this official framework."]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props"