:"div","props":{"className":"life-ad-rail","data-dock-active":"false","style":{"top":"94px"}},"children":[{"tag":"div","props":{"className":"life-ad-dock","hidden":true},"children":[{"tag":"aside","props":{"className":"life-ad-space life-ad-space-sponsored life-ad-space-compact","data-ad-placement":"ad_dock","data-ad-group":"reading","data-ad-creative":"read_product","data-ad-ready":"false","aria-label":"Реклама · Рекомендация сообщества"},"children":[{"tag":"button","props":{"type":"button","className":"life-ad-dismiss","aria-label":"Закрыть рекламу"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-x","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M18 6 6 18"},"children":[]},{"tag":"path","props":{"d":"m6 6 12 12"},"children":[]}]}]},{"tag":"div","props":{"className":"life-ad-space-brand"},"children":[{"tag":"img","props":{"src":"/sites/howtolivebetter/images/shengcai/logo.png","width":"565","height":"144","alt":"Официальный логотип Shengcai Youshu","decoding":"async"},"children":[]}]},{"tag":"div","props":{"className":"life-ad-space-copy"},"children":[{"tag":"span","props":{"className":"life-ad-space-label"},"children":["Реклама · Рекомендация сообщества"]},{"tag":"strong","props":{},"children":["Могут ли ваши знания стать полезным продуктом?"]},{"tag":"p","props":{},"children":["От электронных книг до инструментов: как участники находят потребности и создают то, чем можно пользоваться."]}]},{"tag":"div","props":{"className":"life-ad-space-actions"},"children":[{"tag":"a","props":{"className":"life-ad-space-link","href":"/ru/shengcaiyoushu?sc_group=reading&sc_creative=read_product&sc_placement=ad_dock"},"children":["О сообществе и примерах",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"18","height":"18","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-up-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M7 7h10v10"},"children":[]},{"tag":"path","props":{"d":"M7 17 17 7"},"children":[]}]}]}]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/ru/book/01"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"К содержанию"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["Как не умереть раньше времени"]},{"tag":"div","props":{"data-ad-dock-host":"true"},"children":[]},{"tag":"nav","props":{"aria-label":"Советы главы"},"children":[{"tag":"a","props":{"href":"/ru/tip/01-01"},"children":[{"tag":"span","props":{},"children":["01"]},"Пристегните ремень безопасности — как спереди, так и сзади"]},{"tag":"a","props":{"href":"/ru/tip/01-02"},"children":[{"tag":"span","props":{},"children":["02"]},"Надевание шлема при езде на мотоцикле и электровелосипеде"]},{"tag":"a","props":{"href":"/ru/tip/01-03"},"children":[{"tag":"span","props":{},"children":["03"]},"Установка дымовых извещателей; зимой в домах с отоплением углём или газом — ещё и извещателей на угарный газ"]},{"tag":"a","props":{"href":"/ru/tip/01-04"},"children":[{"tag":"span","props":{},"children":["04"]},"Заменяйте газовые шланги и плиты по истечении срока службы, не вносите изменения в трубопровод самостоятельно, а при навязчивых предложениях от газовой компании смело отказывайтесь"]},{"tag":"a","props":{"href":"/ru/tip/01-05"},"children":[{"tag":"span","props":{},"children":["05"]},"Не собирайте, не покупайте и не ешьте дикие грибы; никакие «народные способы» их распознавания не работают"]},{"tag":"a","props":{"href":"/ru/tip/01-06"},"children":[{"tag":"span","props":{},"children":["06"]},"Электровелосипеды нельзя везти в подъезды, в лифты и заряжать дома"]},{"tag":"a","props":{"href":"/ru/tip/01-07"},"children":[{"tag":"span","props":{},"children":["07"]},"Измерение давления и приём лекарств для его снижения до нормы"]},{"tag":"a","props":{"href":"/ru/tip/01-08"},"children":[{"tag":"span","props":{},"children":["08"]},"После 35 лет при наличии избыточного веса стоит сдать анализ на уровень глюкозы в крови; если результат в норме, повторять исследование раз в три года"]},{"tag":"a","props":{"href":"/ru/tip/01-09"},"children":[{"tag":"span","props":{},"children":["09"]},"Не превышать скорость и не садиться за руль в нетрезвом виде"]},{"tag":"a","props":{"href":"/ru/tip/01-10"},"children":[{"tag":"span","props":{},"children":["10"]},"Использование при поездках детских автокресел для детей младше 4 лет, а не держание их на руках"]},{"tag":"a","props":{"href":"/ru/tip/01-11"},"children":[{"tag":"span","props":{},"children":["11"]},"Установите ограничители на окна и балконы, если в доме есть дети; москитные сетки не являются защитой"]},{"tag":"a","props":{"href":"/ru/tip/01-12"},"children":[{"tag":"span","props":{},"children":["12"]},"Детей у воды нужно держать под присмотром; при катании на лодках и плавании в естественных водоемах следует надевать спасательные жилеты"]},{"tag":"a","props":{"href":"/ru/tip/01-13"},"children":[{"tag":"span","props":{},"children":["13"]},"Упражнения на равновесие и силу ног для людей старше 60 лет, а также модернизация ванной комнаты и лестниц в доме"]},{"tag":"a","props":{"href":"/ru/tip/01-14"},"children":[{"tag":"span","props":{},"children":["14"]},"Анализ на наличие антител к гепатиту B и вакцинация при их отсутствии"]},{"tag":"a","props":{"href":"/ru/tip/01-15"},"children":[{"tag":"span","props":{},"children":["15"]},"При уколе гвоздем, занозе или загрязнении раны землёй необходимо сразу обратиться за помощью и спросить, нужна ли прививка от столбняка"]},{"tag":"a","props":{"href":"/ru/tip/01-16"},"children":[{"tag":"span","props":{},"children":["16"]},"Чем раньше женщины получают вакцину против ВПЧ, тем лучше"]},{"tag":"a","props":{"href":"/ru/tip/01-17"},"children":[{"tag":"span","props":{},"children":["17"]},"Скрининг рака молочной железы для женщин: маммография каждые два года начиная с 40 лет"]},{"tag":"a","props":{"href":"/ru/tip/01-18"},"children":[{"tag":"span","props":{},"children":["18"]},"Женщинам старше 30 лет для скрининга рака шейки матки рекомендуется тестирование на ВПЧ"]},{"tag":"a","props":{"href":"/ru/tip/01-19"},"children":[{"tag":"span","props":{},"children":["19"]},"Скрининг колоректального рака с 45–50 лет: иммунохимический тест на скрытую кровь в кале или колоноскопия"]},{"tag":"a","props":{"href":"/ru/tip/01-20"},"children":[{"tag":"span","props":{},"children":["20"]},"Людям с сердечно-сосудистыми заболеваниями и пожилым людям стоит делать прививку от гриппа каждый год"]},{"tag":"a","props":{"href":"/ru/tip/01-21"},"children":[{"tag":"span","props":{},"children":["21"]},"Вакцинация против опоясывающего герпеса после 50 лет"]},{"tag":"a","props":{"href":"/ru/tip/01-22"},"children":[{"tag":"span","props":{},"children":["22"]},"Вакцинация против пневмококковой инфекции для людей старше 65 лет"]},{"tag":"a","props":{"href":"/ru/tip/01-23"},"children":[{"tag":"span","props":{},"children":["23"]},"Обследование на наличие хеликобактера пилори и его эрадикация"]},{"tag":"a","props":{"href":"/ru/tip/01-24"},"children":[{"tag":"span","props":{},"children":["24"]},"Тяжелым курильщикам раз в год следует делать низкодозовую КТ грудной клетки"]},{"tag":"a","props":{"href":"/ru/tip/01-25"},"children":[{"tag":"span","props":{},"children":["25"]},"При возникновении депрессии или суицидальных мыслей звоните по номеру 12356; дома не храните снотворные и пестициды"]},{"tag":"a","props":{"href":"/ru/tip/01-26"},"children":[{"tag":"span","props":{},"children":["26"]},"Подготовьте огнетушитель, огнезащитное одеяло, респиратор для эвакуации и аптечку первой помощи, проверяя их раз в год"]},{"tag":"a","props":{"href":"/ru/tip/01-27"},"children":[{"tag":"span","props":{},"children":["27"]},"Появление в моче крови, видимой невооруженным глазом — даже если нет боли и даже если кровь исчезает на следующий день — требует обязательного обследования"]},{"tag":"a","props":{"href":"/ru/tip/01-28"},"children":[{"tag":"span","props":{},"children":["28"]},"Проблемы с эрекцией? Сначала проверьте сердечно-сосудистую систему, а не списывайте это лишь на «сексуальные трудности»"]},{"tag":"a","props":{"href":"/ru/tip/01-29"},"children":[{"tag":"span","props":{},"children":["29"]},"Снижение веса, отказ от курения и контроль уровня сахара и давления способствуют улучшению эректильной функции"]},{"tag":"a","props":{"href":"/ru/tip/01-30"},"children":[{"tag":"span","props":{},"children":["30"]},"Использование презервативов на протяжении всего полового акта, а также отказ от совместного использования игл"]},{"tag":"a","props":{"href":"/ru/tip/01-31"},"children":[{"tag":"span","props":{},"children":["31"]},"Пройдите тестирование на ВИЧ, если у вас были рискованные контакты: Центр по контролю заболеваний делает это бесплатно, а результаты остаются конфиденциальными"]},{"tag":"a","props":{"href":"/ru/tip/01-32"},"children":[{"tag":"span","props":{},"children":["32"]},"Как только возникла мысль о самоубийстве, сразу расскажите об этом близкому человеку и отдайте эти несколько десятков минут ему"]},{"tag":"a","props":{"href":"/ru/tip/01-33"},"children":[{"tag":"span","props":{},"children":["33"]},"Не стоит воспринимать «спасение жизни» как гарантию: при отравлении паракватом или угарным газом в отделении неотложной помощи удаётся спасти жизнь, но лёгкие и мозг часто повреждаются необратимо"]},{"tag":"a","props":{"href":"/ru/tip/01-34"},"children":[{"tag":"span","props":{},"children":["34"]},"Не стоит рассчитывать на быстрое выздоровление после падения с высоты: большинство пациентов, попавших в травматологическое отделение интенсивной терапии, выживают, но цена этого — годы жизни"]},{"tag":"a","props":{"href":"/ru/tip/01-35"},"children":[{"tag":"span","props":{},"children":["35"]},"Не стоит обменивать «отсутствие одной почки» на деньги: оставшаяся почка теперь выполняет работу за две, а 86% людей, продавших почку, позже отмечают ухудшение здоровья"]},{"tag":"a","props":{"href":"/ru/tip/01-36"},"children":[{"tag":"span","props":{},"children":["36"]},"Не подбирайте, не разбирайте и не продавайте металлические детали неизвестного происхождения; держитесь подальше от зон с предупреждающими знаками в виде клевера"]},{"tag":"a","props":{"href":"/ru/tip/01-37"},"children":[{"tag":"span","props":{},"children":["37"]},"Когда вы берете в долг, чтобы продолжить играть, и находитесь в подавленном состоянии, сначала позвоните по номеру 12356, а затем передайте свои банковские карты и пароли от платежных систем членам семьи для контроля"]},{"tag":"a","props":{"href":"/ru/tip/01-38"},"children":[{"tag":"span","props":{},"children":["38"]},"Для МСМ с высоким риском сексуального контакта: обращение в специализированные центры по вопросам ПКП (доконтактной профилактики) позволяет снизить риск заражения ВИЧ более чем на 70%"]},{"tag":"a","props":{"href":"/ru/tip/01-39"},"children":[{"tag":"span","props":{},"children":["39"]},"Женщинам 65 лет и старше сделайте рентгеновскую денситометрию (DXA); женщинам после менопаузы с факторами риска остеопороза не обязательно ждать 65 лет"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/ru/tip/01-40","data-status":"active"},"children":[{"tag":"span","props":{},"children":["40"]},"При остеопорозе или переломе от лёгкого падения попросите врача назначить противоостеопоротические препараты и принимайте их, не заменяя лечение одними кальцием"]},{"tag":"a","props":{"href":"/ru/tip/01-41"},"children":[{"tag":"span","props":{},"children":["41"]},"Перед выходом на дикий лёд необходимо просверлить отверстия и измерить его толщину — не стоит выходить, если она меньше 15 см. Избегайте льда на реках и вблизи лунок для ловли рыбы"]},{"tag":"a","props":{"href":"/ru/tip/01-42"},"children":[{"tag":"span","props":{},"children":["42"]},"Перед работой с болгаркой установите кожух, наденьте защитные очки и лицевой щиток, держите ее двумя руками и не ставьте пильный диск для дерева"]},{"tag":"a","props":{"href":"/ru/tip/01-43"},"children":[{"tag":"span","props":{},"children":["43"]},"Прямо спросите человека, чьё состояние вызывает тревогу: «Ты думал о самоубийстве?» Вопрос не усиливает это желание"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"Навигация"},"children":[{"tag":"a","props":{"href":"/ru/book"},"children":["Книга"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/ru/book/01"},"children":["Глава 1"," ·"," ","Как не умереть раньше времени"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"01-40"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["40"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["Доказательства"," ","A"]}]},{"tag":"h1","props":{"lang":"ru"},"children":["При остеопорозе или переломе от лёгкого падения попросите врача назначить противоостеопоротические препараты и принимайте их, не заменяя лечение одними кальцием"]},{"tag":"p","props":{"lang":"ru","className":"life-entry-summary"},"children":["При подтверждённом остеопорозе или уже случившемся переломе от лёгкого удара схема врача снижает риск перелома бедра примерно вдвое, симптоматических переломов позвоночника — больше чем вдвое. У пожилых, которым после операции на бедре начали ежегодную инфузию в первые 90 дней, за два года новых переломов было примерно на 35 % меньше. Одних добавок кальция этим не заменить."]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Затраты"]},{"tag":"p","props":{},"children":["Нужен рецепт, курс — годами. Часто — таблетки раз в неделю…"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Польза"]},{"tag":"p","props":{},"children":["Хрупкий перелом — перелом от слабого удара или в быту. Руководство Китайского медицинского общества 2017 года…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"Отметить: При остеопорозе или переломе от лёгкого падения попросите врача назначить противоостеопоротические препараты и принимайте их, не заменяя лечение одними кальцием"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"Сделано"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"В планах"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"В избранное"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Поделиться советом"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Скрыть подробности"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Затраты"]},{"tag":"p","props":{},"children":["Нужен рецепт, курс — годами. Часто — таблетки раз в неделю или инфузия раз в год. Сначала плотность кости проверяют ежегодно, потом раз в 1–2 года. Сложно продолжать, когда «ничего не болит»."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Польза"]},{"tag":"p","props":{},"children":["Хрупкий перелом — перелом от слабого удара или в быту. Руководство Китайского медицинского общества 2017 года выделяет три группы для лечения: перелом позвоночника или бедра в прошлом; T-критерий плотности кости −2,5 и ниже, независимо от переломов; пониженная масса кости плюс хрупкий перелом запястья, плеча или таза или высокий расчётный риск перелома. В руководстве прямо сказано: «В настоящее время нет достаточных доказательств, что одна лишь добавка кальция может заменить другую противоостеопоротическую терапию». Обновление Cochrane 2025 года по алендроновой кислоте у постменопаузальных женщин с остеопорозом или переломом в прошлом: переломы бедра в группе лечения ниже примерно на 51 % (RR 0,49, 95 % ДИ 0,25–0,96), симптоматические переломы позвоночника — примерно на 55 % (RR 0,45, 95 % ДИ 0,28–0,73). Испытание HORIZON включило 2127 человек со средним возрастом 74,5 года после операции на переломе бедра; ежегодная золедроновая кислота с началом в течение 90 дней после операции, медиана наблюдения 1,9 года. Новые переломы снизились с 13,9 % до 8,6 % (относительное снижение около 35 %). Смертность — с 13,3 % до 9,6 % (относительное снижение около 28 %). В руководстве указано, что в течение года после перелома бедра около 20 % погибают от осложнений. В обследовании 2017–2018 годов лекарства принимали только 1,4 % женщин и 0,3 % мужчин с диагнозом остеопороза или переломом в прошлом (Китай)."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Первоисточники"]},{"tag":"p","props":{"className":"life-citations"},"children":["中华医学会骨质疏松和骨矿盐疾病分会 (2017). 原发性骨质疏松症诊疗指南(2017). 中华骨质疏松和骨矿盐疾病杂志, 10(5), 413-443（表 10 抗骨质疏松症药物治疗适应证；钙剂一节；疗效监测一节）. ",{"tag":"a","props":{"href":"https://html.rhhz.net/GUSS/html/cc825127-29a3-47c1-9a95-7a212fdcce55.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://html.rhhz.net/GUSS/html/cc825127-29a3-47c1-9a95-7a212fdcce55.htm"]}," ; Wells GA, Hsieh SC, Peterson J, et al. (2025). Alendronate for the primary and secondary prevention of osteoporotic fractures in postmenopausal women. Cochrane Database of Systematic Reviews. ",{"tag":"a","props":{"href":"https://doi.org/10.1002/14651858.CD001155.pub3","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1002/14651858.CD001155.pub3"]}," ; Lyles KW, Colón-Emeric CS, Magaziner JS, et al. (2007). Zoledronic acid and clinical fractures and mortality after hip fracture. New England Journal of Medicine. ",{"tag":"a","props":{"href":"https://doi.org/10.1056/NEJMoa074941","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1056/NEJMoa074941"]}," ; Cummings SR, Lui LY, Eastell R, Allen IE (2019). Association Between Drug Treatments for Patients With Osteoporosis and Overall Mortality Rates: A Meta-analysis. JAMA Internal Medicine. ",{"tag":"a","props":{"href":"https://doi.org/10.1001/jamainternmed.2019.2779","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1001/jamainternmed.2019.2779"]}," ; Kahwati LC, Kistler CE, Booth G, et al. (2025). Screening for Osteoporosis to Prevent Fractures: A Systematic Evidence Review for the US Preventive Services Task Force. JAMA. ",{"tag":"a","props":{"href":"https://doi.org/10.1001/jama.2024.21653","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1001/jama.2024.21653"]}," ; Wang L, Yu W, Yin X, et al. (2021). Prevalence of Osteoporosis and Fracture in China: The China Osteoporosis Prevalence Study. JAMA Network Open. ",{"tag":"a","props":{"href":"https://doi.org/10.1001/jamanetworkopen.2021.21106","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1001/jamanetworkopen.2021.21106"]}]},{"tag":"a","props":{"href":"https://html.rhhz.net/GUSS/html/cc825127-29a3-47c1-9a95-7a212fdcce55.htm","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Открыть источник"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Примечание автора"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["Спорный вопрос: метаанализ 38 испытаний не выявил снижения общей смертности при применении этих препаратов (RR 0.98, 95% ДИ от 0.91 до 1.05). Для одной только золедроновой кислоты результат тоже не был статистически значимым (RR 0.88, 95% ДИ от 0.68 до 1.13). Авторы заключили, что эти препараты следует применять только ради уменьшения числа переломов. Достоверность приведённых оценок Cochrane также была оценена от низкой до умеренной. У женщин, ещё не перенёсших перелом и имеющих относительно низкий риск переломов, алендронат не показал явного влияния на переломы бедра (RR 0.76, 95% ДИ от 0.43 до 1.32). Испытания продолжительностью несколько лет не позволяют полностью оценить редкие нежелательные эффекты, например остеонекроз челюсти и атипичные переломы бедренной кости. Поэтому проходите контрольные осмотры вовремя и не увеличивайте дозу и не отменяйте препарат самостоятельно. Одним подходят инъекции, другим — таблетки; выбор делает врач. Как выявляют остеопороз, см. пункт 39 (исследование плотности костей). Менопаузальная гормональная терапия тоже уменьшает число переломов, но обычно её рассматривают лишь тогда, когда другие препараты не подходят. О гормонах при приливах и ночной потливости см. пункт 43 раздела 2 (оценить возможность гормональной терапии при приливах в период менопаузы). Основную пользу получаете вы сами; ваши родители также могут получить пользу."]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Моя заметка"]},{"tag":"button","props":{"type":"button"},"children":["Запишите напоминание…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/ru/tip/01-39"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Предыдущий"]},"Женщинам 65 лет и старше сделайте рентгеновскую денситометрию (DXA); женщинам после менопаузы с факторами риска остеопороза не обязательно ждать 65 лет"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/ru/tip/01-41"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Следующий"]},"Перед выходом на дикий лёд необходимо просверлить отверстия и измерить его толщину — не стоит выходить, если она меньше 15 см. Избегайте льда на реках и вблизи лунок для ловли рыбы"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["Другие советы по этой теме"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/01-35"},"children":[{"tag":"strong","props":{},"children":["Не стоит обменивать «отсутствие одной почки» на деньги: оставшаяся почка теперь выполняет работу за две, а 86% людей, продавших почку, позже отмечают ухудшение здоровья"]},{"tag":"span","props":{},"children":["Начнём с самого лучшего варианта: официальные доноры, прошедшие тщате…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/01-36"},"children":[{"tag":"strong","props":{},"children":["Не подбирайте, не разбирайте и не продавайте металлические детали неизвестного происхождения; держитесь подальше от зон с предупреждающими знаками в виде клевера"]},{"tag":"span","props":{},"children":["Излучение не имеет запаха, цвета и температуры; большинство радиоакти…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/01-37"},"children":[{