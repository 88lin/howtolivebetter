ucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"分享这条建议"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"收起详情"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["成本"]},{"tag":"p","props":{},"children":["不花钱。每天要难受 30 到 90 秒，冬天想坚持得靠毅力。有心血管病的人还要当心，冷刺激对他们有风险。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["收益"]},{"tag":"p","props":{},"children":["荷兰做过一项随机分组对照试验，3,018 人，洗完热水澡之后再冲 30 秒、60 秒或 90 秒冷水。这些人请病假的次数少了 29%（IRR 0.71，这是次数之比）。但原文写明「病假天数没有显著组间差异」：总共病了多少天，两边一样。生活质量、工作效率、焦虑也都没看出有意义的差别。2025 年一篇系统综述把 11 项随机分组试验、3,177 人合起来算。泡完冷水的当下和 1 小时后，身体发炎的指标反而升高。免疫指标没变化。压力只在 12 小时那个时间点降低。作者自己说证据「受限于 RCT 少、样本小」，意思是这类随机分组试验数量太少、每项人也不多。它看起来划算，是因为不花钱，而且「吃苦就有效」这个直觉太顺"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["原始出处"]},{"tag":"p","props":{"className":"life-citations"},"children":["Buijze GA et al. (2016). The Effect of Cold Showering on Health and Work: A Randomized Controlled Trial. PLOS ONE. ",{"tag":"a","props":{"href":"https://doi.org/10.1371/journal.pone.0161749","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1371/journal.pone.0161749"]},"；Cain T et al. (2025). Effects of cold-water immersion on health and wellbeing: A systematic review and meta-analysis. PLOS ONE. ",{"tag":"a","props":{"href":"https://doi.org/10.1371/journal.pone.0317615","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1371/journal.pone.0317615"]}]},{"tag":"a","props":{"href":"https://doi.org/10.1371/journal.pone.0161749","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["打开来源链接"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["原书备注"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["争议：请病假的次数确实少了 29%，这个差距不像是碰巧。但生病的总天数并没有少，所以更像是「病了也照常去上班」，而不是真的少生病。运动员训练完之后用冷水帮助恢复，那是另一个问题，这里不管。冷水澡本身对健康人没有害处，只是别把它当成健康投资"]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["我的备注"]},{"tag":"button","props":{"type":"button"},"children":["写下对自己有用的提醒…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/tip/06-11"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["上一条"]},"不要在没有肠道问题时长期吃益生菌"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/tip/06-13"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["下一条"]},"不要买排毒、清肠、酵素、碱性水这类产品"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["本主题的其他建议"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/06-08"},"children":[{"tag":"strong","props":{},"children":["不要指望手环/手表的运动量化帮你减重"]},{"tag":"span","props":{},"children":["超重的人做同样的饮食和运动安排，戴运动手环的人两年减了 3.5 公斤，不戴的人反而减了 5.9 公斤。想减重，花钱买设备帮不上忙，真正管用…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/06-09"},"children":[{"tag":"strong","props":{},"children":["不要为了「更健康」花溢价买有机食品"]},{"tag":"span","props":{},"children":["没有有力的证据说有机食品更有营养。真正看了人吃完以后健康怎么样的研究只有 3 项，都没看出差别。有机农产品被检出农药残留的比例确实低 30…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/06-10"},"children":[{"tag":"strong","props":{},"children":["不要花大钱买保健品、膏方、滋补品来「调理身体」"]},{"tag":"span","props":{},"children":["多维、鱼油、维 D 这些常见成分，本节前六条已经一样样查过，都没看出管用。包装上那句「保健食品不是药物，不能代替药物治疗疾病」，是管保健食…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/06-14"},"children":[{"tag":"strong","props":{},"children":["不要为了凑够「每天 8 杯水」强迫自己喝水"]},{"tag":"span","props":{},"children":["有人专门去追「每天 8 杯水」的出处，一项支持它的研究都没找到。食物和别的饮料里本来就带着大量水分，所以用不着喝那么多。渴了就喝，看看尿的…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/06-15"},"children":[{"tag":"strong","props":{},"children":["不要花钱算命、看塔罗、看星座来做决定"]},{"tag":"span","props":{},"children":["有个经典的课堂实验：学生拿到的「个人性格分析」其实人手一份、一模一样，大家却普遍觉得很准。算命显得准，道理就在这里。占星师挑对的次数和瞎猜…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/06-16"},"children":[{"tag":"strong","props":{},"children":["不要买防蓝光眼镜来「保护视力」，也不要相信「对着屏幕干几个月眼睛就废了」，但眼睛胀痛发红要当急症"]},{"tag":"span","props":{},"children":["防蓝光镜片没用，不买能省下几百到上千的加价。和普通镜片比，戴它的人眼睛累不累、能看多清都没差别，也没找到它护眼底的证据。看屏幕看得眼酸眼干…"]}]}]}]},{"tag":"a","props":{"className":"life-text-link","href":"/book/06"},"children":["阅读整个主题：反面清单"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"15","height":"15","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]}]}]}]},{"tag":"aside","props":{"className":"life-ad-space life-ad-space-sponsored","data-ad-placement":"ad_footer","data-ad-group":"reading","data-ad-creative":"read_product","data-ad-ready":"false","aria-label":"广告 · 社区推荐"},"children":[{"tag":"div","props":{"className":"life-ad-space-brand"},"children