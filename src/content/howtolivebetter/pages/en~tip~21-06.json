roke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-up-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M7 7h10v10"},"children":[]},{"tag":"path","props":{"d":"M7 17 17 7"},"children":[]}]}]}]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/en/book/21"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"Back to index"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["Traveling abroad, trips, and safety overseas"]},{"tag":"div","props":{"data-ad-dock-host":"true"},"children":[]},{"tag":"nav","props":{"aria-label":"Chapter entries"},"children":[{"tag":"a","props":{"href":"/en/tip/21-01"},"children":[{"tag":"span","props":{},"children":["01"]},"Check the Ministry of Foreign Affairs safety advisories before you travel; steer clear of any locations marked “Do Not Travel”"]},{"tag":"a","props":{"href":"/en/tip/21-02"},"children":[{"tag":"span","props":{},"children":["02"]},"Save the 12308 hotline number and your local embassy/consulate’s consular protection number in your phone, then write them down and keep a copy in your wallet — don’t wait until an emergency to look them up"]},{"tag":"a","props":{"href":"/en/tip/21-03"},"children":[{"tag":"span","props":{},"children":["03"]},"Understanding what consular protection can and cannot do: it can visit you, but cannot bail you out, and you still have to pay the costs"]},{"tag":"a","props":{"href":"/en/tip/21-04"},"children":[{"tag":"span","props":{},"children":["04"]},"Purchase insurance covering overseas medical care and medical evacuation — don’t settle for just flight delay coverage"]},{"tag":"a","props":{"href":"/en/tip/21-05"},"children":[{"tag":"span","props":{},"children":["05"]},"Treat all “high-paying overseas jobs” as scams — getting caught can lead to a 6‑month to 3‑year travel ban"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/en/tip/21-06","data-status":"active"},"children":[{"tag":"span","props":{},"children":["06"]},"The annual limit of 100,000 RMB for cash withdrawals abroad applies to all cards under your name combined"]},{"tag":"a","props":{"href":"/en/tip/21-07"},"children":[{"tag":"span","props":{},"children":["07"]},"Take photos of your passport, visa, and ID card and store them in the cloud; if lost, report to police first and then apply for a travel document"]},{"tag":"a","props":{"href":"/en/tip/21-08"},"children":[{"tag":"span","props":{},"children":["08"]},"Before driving abroad, verify whether local authorities recognize Chinese driver’s licenses; most “international driver’s permits” sold online are legally worthless"]},{"tag":"a","props":{"href":"/en/tip/21-09"},"children":[{"tag":"span","props":{},"children":["09"]},"When hiring an agency for visas, study abroad, or immigration, first check whether it is registered with immigration authorities"]},{"tag":"a","props":{"href":"/en/tip/21-10"},"children":[{"tag":"span","props":{},"children":["10"]},"Don’t issue invitation letters for strangers, and don’t let others use your name for immigration paperwork"]},{"tag":"a","props":{"href":"/en/tip/21-11"},"children":[{"tag":"span","props":{},"children":["11"]},"Before traveling abroad, send your itinerary, accommodation details, and travel companions’ information to a family member, and agree on how often you’ll stay in touch"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"Breadcrumb"},"children":[{"tag":"a","props":{"href":"/en/book"},"children":["Explore the book"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/en/book/21"},"children":["Chapter 21"," ·"," ","Traveling abroad, trips, and safety overseas"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"21-06"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["06"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["Evidence"," ","A"]}]},{"tag":"h1","props":{"lang":"en"},"children":["The annual limit of 100,000 RMB for cash withdrawals abroad applies to all cards under your name combined"]},{"tag":"p","props":{"lang":"en","className":"life-entry-summary"},"children":["The annual cash withdrawal limit of 100,000 RMB for overseas use applies to all bank cards registered under your name, including supplementary cards. This limit resets on January 1 each calendar year. Once you reach it, you cannot make any more overseas cash withdrawals for the remainder of that year or in the following year. Note that this restriction only affects cash withdrawals; regular card purchases remain unaffected, and it does not count against your annual foreign exchange quota of $50,000."]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Cost"]},{"tag":"p","props":{},"children":["There is no direct cost. Estimate how much cash you’ll nee…"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Benefit"]},{"tag":"p","props":{},"children":["This rule is set out in the Notice on Regulating Large-Scale Cash Withdrawals via Bank Cards Abroad issued by…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"Mark: The annual limit of 100,000 RMB for cash withdrawals abroad applies to all cards under your name combined"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"Done"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"Plan to do"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"Save"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Share this tip"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Hide details"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Cost"]},{"tag":"p","props":{},"children":["There is no direct cost. Estimate how much cash you’ll need before you travel, then rely on card payments for the rest. The real challenge is breaking the habit of withdrawing cash whenever possible."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Benefit"]},{"tag":"p","props":{},"children":["This rule is set out in the Notice on Regulating Large-Scale Cash Withdrawals via Bank Cards Abroad issued by the State Administration of Foreign Exchange (SAFE, Document No. 29 [2017], effective January 1, 2018). Key provisions include: (1) The combined annual cash withdrawal limit for all cards under a person’s name is 100,000 RMB; exceeding this limit results in a suspension of overseas cash withdrawal rights for both the current and next calendar years. It is also prohibited to bypass this rule by using someone else’s card or lending one’s own card to others. (2) SAFE provides a list of affected individuals to issuing banks daily, which must then block all overseas cash withdrawals for those customers by 5 PM Beijing time on the same day. (3) Affected individuals can request a full breakdown of their overseas cash withdrawal history by presenting valid ID at local SAFE branches. (4) The daily withdrawal limit for foreign currency cards is raised from $1,000 to 10,000 RMB equivalent, while the same daily limit for RMB cards remains at 10,000 RMB equivalent. (5) Violations of these rules are subject to penalties under the Foreign Exchange Administration Regulations of the People’s Republic of China. SAFE also clarifies that this notice does not restrict regular overseas spending on travel, business, or education, which can all be paid for via card without using the annual $50,000 foreign exchange quota. To ensure smooth transactions, SAFE uses delayed control mechanisms rather than immediate blocking of transactions. Statistics show that 81% of domestic cardholders withdrew less than 30,000 RMB abroad in 2016."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Original sources"]},{"tag":"p","props":{"className":"life-citations"},"children":["国家外汇管理局 (2017). 关于规范银行卡境外大额提取现金交易的通知（汇发〔2017〕29 号，第一、二、三、四、六、七条，2018 年 1 月 1 日起实施）. ",{"tag":"a","props":{"href":"https://www.safe.gov.cn/safe/2017/1230/21873.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.safe.gov.cn/safe/2017/1230/21873.html"]},"；国家外汇管理局 (2017). 外汇局有关负责人就规范银行卡境外大额提取现金交易有关问题答记者问. ",{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/2017-12/31/content_5251958.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/zhengce/2017-12/31/content_5251958.htm"]},"；中国银联国际. 境外ATM取款. ",{"tag":"a","props":{"href":"https://m.unionpayintl.com/wap/cn/serviceCenter/cardUsingInstructions/805.shtml","target":"_blank","rel":"noopener noreferrer"},"children":["https://m.unionpayintl.com/wap/cn/serviceCenter/cardUsingInstructions/805.shtml"]}]},{"tag":"a","props":{"href":"https://www.safe.gov.cn/safe/2017/1230/21873.html","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Open source link"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Book note"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["The annual limit resets on January 1 each year. As mentioned, only cash withdrawals are restricted; regular card purchases are unaffected. If you absolutely need to carry large amounts of cash overseas, you must first apply for foreign exchange under the Individual Foreign Exchange Management Measures before taking the cash out. Two additional caveats apply to cash withdrawals: (1) For dual-brand cards, some ATMs in certain countries do not offer a UnionPay withdrawal option. (2) Some overseas ATMs display extra surcharge fees, which are charged by local acquirers and have no relation to UnionPay. UnionPay also advises that credit card cash withdrawals incur interest charges, so using a UnionPay debit card is preferable for overseas withdrawals. For guidance on what to do if your card is lost, swallowed by an ATM, or fraudulently used, refer to Section 14, Item 5."]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["My note"]},{"tag":"button","props":{"type":"button"},"children":["Write a reminder for yourself…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/en/tip/21-05"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Previous"]},"Treat all “high-paying overseas jobs” as scams — getting caught can lead to a 6‑month to 3‑year travel ban"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/en/tip/21-07"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Next"]},"Take photos of your passport, visa, and ID card and store them in the cloud; if lost, report to police first and then apply for a travel document"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"