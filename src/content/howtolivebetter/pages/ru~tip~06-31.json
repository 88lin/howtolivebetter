"strokeLinejoin":"round","className":"lucide lucide-circle-user-round","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M18 20a6 6 0 0 0-12 0"},"children":[]},{"tag":"circle","props":{"cx":"12","cy":"10","r":"4"},"children":[]},{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},{"tag":"span","props":{},"children":["Войти"]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/ru/book/06"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"К содержанию"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["Перечень вредных средств"]},{"tag":"nav","props":{"aria-label":"Советы главы"},"children":[{"tag":"a","props":{"href":"/ru/tip/06-01"},"children":[{"tag":"span","props":{},"children":["01"]},"Не стоит принимать поливитамины ради долголетия или профилактики сердечно-сосудистых заболеваний"]},{"tag":"a","props":{"href":"/ru/tip/06-02"},"children":[{"tag":"span","props":{},"children":["02"]},"Не стоит принимать обычное рыбье масло ради профилактики сердечно-сосудистых заболеваний"]},{"tag":"a","props":{"href":"/ru/tip/06-03"},"children":[{"tag":"span","props":{},"children":["03"]},"Не стоит давать витамин D людям, у которых его уровень в норме, ради долголетия"]},{"tag":"a","props":{"href":"/ru/tip/06-04"},"children":[{"tag":"span","props":{},"children":["04"]},"Не стоит принимать антиоксидантные добавки ради профилактики рака (бета-каротин, витамин E, витамин A)"]},{"tag":"a","props":{"href":"/ru/tip/06-05"},"children":[{"tag":"span","props":{},"children":["05"]},"Не стоит рассчитывать на глюкозамин и хондроитин при лечении артрита коленного сустава"]},{"tag":"a","props":{"href":"/ru/tip/06-06"},"children":[{"tag":"span","props":{},"children":["06"]},"Не стоит использовать витамин C для профилактики простуды"]},{"tag":"a","props":{"href":"/ru/tip/06-07"},"children":[{"tag":"span","props":{},"children":["07"]},"Не стоит делать себе «полный ПЭТ-КТ» или «панель онкомаркеров», если у вас нет симптомов"]},{"tag":"a","props":{"href":"/ru/tip/06-08"},"children":[{"tag":"span","props":{},"children":["08"]},"Не стоит рассчитывать, что трекеры активности помогут вам похудеть"]},{"tag":"a","props":{"href":"/ru/tip/06-09"},"children":[{"tag":"span","props":{},"children":["09"]},"Не стоит переплачивать за органические продукты ради «большего здоровья»"]},{"tag":"a","props":{"href":"/ru/tip/06-10"},"children":[{"tag":"span","props":{},"children":["10"]},"Не стоит тратить большие деньги на БАДы, пастообразные смеси и пищевые добавки для «укрепления здоровья»"]},{"tag":"a","props":{"href":"/ru/tip/06-11"},"children":[{"tag":"span","props":{},"children":["11"]},"Не стоит долго принимать пробиотики при отсутствии проблем с кишечником"]},{"tag":"a","props":{"href":"/ru/tip/06-12"},"children":[{"tag":"span","props":{},"children":["12"]},"Не стоит заставлять себя принимать холодный душ ради «укрепления иммунитета»"]},{"tag":"a","props":{"href":"/ru/tip/06-13"},"children":[{"tag":"span","props":{},"children":["13"]},"Не стоит покупать продукты для детоксикации, очищения кишечника, энзимные добавки или щелочную воду"]},{"tag":"a","props":{"href":"/ru/tip/06-14"},"children":[{"tag":"span","props":{},"children":["14"]},"Не стоит заставлять себя пить воду лишь ради достижения цели «8 стаканов в день»"]},{"tag":"a","props":{"href":"/ru/tip/06-15"},"children":[{"tag":"span","props":{},"children":["15"]},"Не тратьте деньги на гадания, Таро или астрологию, чтобы принимать решения"]},{"tag":"a","props":{"href":"/ru/tip/06-16"},"children":[{"tag":"span","props":{},"children":["16"]},"Не стоит покупать очки с защитой от синего света, чтобы «охранять зрение», и не верьте утверждениям, будто «после нескольких месяцев работы за экраном зрение испортится». Однако сильная боль, отёчность и покраснение глаз — это повод для срочного обращения к врачу"]},{"tag":"a","props":{"href":"/ru/tip/06-17"},"children":[{"tag":"span","props":{},"children":["17"]},"Не стоит рассматривать донорство крови как способ укрепить здоровье: утверждения о «детоксикации, снижении уровня холестерина и профилактике инфаркта» не подтверждены рандомизированными исследованиями, а частое донорство действительно приводит к дефициту железа"]},{"tag":"a","props":{"href":"/ru/tip/06-18"},"children":[{"tag":"span","props":{},"children":["18"]},"Не стоит полагаться на стандартные пакеты медосмотров для профилактики — достаточно проводить те обследования, эффективность которых подтверждена данными, с учётом возраста и пола"]},{"tag":"a","props":{"href":"/ru/tip/06-19"},"children":[{"tag":"span","props":{},"children":["19"]},"Не стоит принимать препараты для снижения уровня мочевой кислоты только потому, что анализы показали её повышение, а боли никогда не было"]},{"tag":"a","props":{"href":"/ru/tip/06-20"},"children":[{"tag":"span","props":{},"children":["20"]},"Не стоит делать профилактическую операцию по удалению желчного пузыря только потому, что при обследовании обнаружили камни, а боли никогда не было"]},{"tag":"a","props":{"href":"/ru/tip/06-21"},"children":[{"tag":"span","props":{},"children":["21"]},"Не стоит отказываться от кальция ради профилактики камней в почках"]},{"tag":"a","props":{"href":"/ru/tip/06-22"},"children":[{"tag":"span","props":{},"children":["22"]},"Не стоит покупать кристаллы, браслеты или фигурки пи-сюй ради «улучшения удачи», «привлечения богатства» или «помощи в саморазвитии»"]},{"tag":"a","props":{"href":"/ru/tip/06-23"},"children":[{"tag":"span","props":{},"children":["23"]},"Не стоит рассчитывать, что покупки улучшат настроение или самооценку"]},{"tag":"a","props":{"href":"/ru/tip/06-24"},"children":[{"tag":"span","props":{},"children":["24"]},"Не тратьте лишние деньги на новую квартиру, машину или круг общения лишь ради того, чтобы «подняться в социальном статусе»"]},{"tag":"a","props":{"href":"/ru/tip/06-25"},"children":[{"tag":"span","props":{},"children":["25"]},"Не верьте утверждению «воля — это как мышца, которая быстро устает»"]},{"tag":"a","props":{"href":"/ru/tip/06-26"},"children":[{"tag":"span","props":{},"children":["26"]},"Не стоит рассчитывать, что завтрак или режим питания 16:8 помогут вам контролировать вес — выбирайте тот график, который сможете соблюдать долгое время"]},{"tag":"a","props":{"href":"/ru/tip/06-27"},"children":[{"tag":"span","props":{},"children":["27"]},"Не верьте в то, что «мастурбация вредит здоровью» или что «нужно воздерживаться, чтобы стать лучше»; на самом деле важно лишь то, не мешает ли это вашему сну, работе и отношениям"]},{"tag":"a","props":{"href":"/ru/tip/06-28"},"children":[{"tag":"span","props":{},"children":["28"]},"Не тратьте деньги на «исправление сексуальной ориентации» или «лечение гомосексуальности», и не отправляйте туда своих близких"]},{"tag":"a","props":{"href":"/ru/tip/06-29"},"children":[{"tag":"span","props":{},"children":["29"]},"Не рассчитывайте предотвратить боль в пояснице «правильной техникой подъема» и курсами: уменьшайте вес и число подъемов, регулярно занимайтесь физической нагрузкой"]},{"tag":"a","props":{"href":"/ru/tip/06-30"},"children":[{"tag":"span","props":{},"children":["30"]},"Не рассчитывайте, что большие дозы кальция и костный бульон ускорят сращение перелома"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/ru/tip/06-31","data-status":"active"},"children":[{"tag":"span","props":{},"children":["31"]},"Не стоит полагаться на ИИ-чат-бот в одиночку, когда нужно оценить болезнь или юридический вопрос: прежде чем идти к врачу, в суд или тратить большие деньги, найдите первоисточник, на который он ссылается, и проверьте по оригиналу"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"Навигация"},"children":[{"tag":"a","props":{"href":"/ru/book"},"children":["Книга"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/ru/book/06"},"children":["Глава 6"," ·"," ","Перечень вредных средств"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"06-31"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["31"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["Доказательства"," ","A"]}]},{"tag":"h1","props":{"lang":"ru"},"children":["Не стоит полагаться на ИИ-чат-бот в одиночку, когда нужно оценить болезнь или юридический вопрос: прежде чем идти к врачу, в суд или тратить большие деньги, найдите первоисточник, на который он ссылается, и проверьте по оригиналу"]},{"tag":"p","props":{"lang":"ru","className":"life-entry-summary"},"children":["Если дать ИИ полное описание случая, он в девяти случаях из десяти и чаще называет правильную болезнь. Но обычные люди, спрашивая его о симптомах, определяли болезнь даже реже, чем те, кто искал в интернете, и не точнее решали, нужна ли скорая помощь. В юридических вопросах универсальный ИИ выдумывает как минимум в 58% ответов и охотно продолжает рассуждать, опираясь на ошибочную посылку из вашего вопроса."]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Затраты"]},{"tag":"p","props":{},"children":["Ничего не стоит. Каждая проверка занимает от нескольких ми…"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Польза"]},{"tag":"p","props":{},"children":["Сначала о болезнях. В 2026 году в Nature Medicine опубликовали рандомизированное испытание с предварительно за…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"Отметить: Не стоит полагаться на ИИ-чат-бот в одиночку, когда нужно оценить болезнь или юридический вопрос: прежде чем идти к врачу, в суд или тратить большие деньги, найдите первоисточник, на который он ссылается, и проверьте по оригиналу"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"Сделано"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"В планах"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"В избранное"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Поделиться советом"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Скрыть подробности"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Затраты"]},{"tag":"p","props":{},"children":["Ничего не стоит. Каждая проверка занимает от нескольких минут до получаса. Попросите ИИ назвать закон, клиническое руководство или статью, на которые он опирается, откройте оригинал сами и найдите эту фразу. Нужно отказаться от привычки делать так, как сказано, только потому, что ответ звучит уверенно."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Польза"]},{"tag":"p","props":{},"children":["Сначала о болезнях. В 2026 году в Nature Medicine опубликовали рандомизированное испытание с предварительно зарегистрированным планом, в нём участвовали 1298 обычных жителей Великобритании. Каждый получил два придуманных случая и должен был определить, что это за болезнь и куда обращаться: в скорую или наблюдаться дома. Часть участников пользовалась ИИ-чат-ботом (GPT-4o, Llama 3, Command R+). Контрольная группа действовала как обычно: в основном искала в интернете или заглядывала на сайт Национальной службы здравоохранения Великобритании (NHS). Когда полное описание случая подавали ИИ напрямую, он в 94,9% случаев называл соответствующую болезнь и в 56,3% правильно определял, куда обращаться. Обычные люди с теми же ИИ называли соответствующую болезнь менее чем в 34,5% случаев, а правильно определяли, куда обращаться, менее чем в 44,2%. Шанс назвать соответствующую болезнь в контрольной группе был в 1,76 раза выше, чем у пользователей ИИ (95% ДИ 1,45–2,13, диапазон вероятных значений). Шанс распознать тяжёлую болезнь с опасными признаками — в 1,57 раза выше (1,28–1,92). По выбору, куда обращаться, группы почти не различались. Авторы изучили переписки: проблемы возникали с обеих сторон. Одни пользователи не описывали симптомы полностью, а в других случаях ИИ упоминал правильную болезнь, но пользователь этому не следовал. Теперь о праве. В 2024 году американская исследовательская группа задавала ChatGPT 4 и другим общедоступным моделям вопросы о решениях федеральных судов США. У ChatGPT 4 в 58% ответов было выдуманное содержание, у Llama 2 — целых 88%. Выдумкой называют содержание, не совпадающее с юридическими фактами; в статье это названо «галлюцинацией». Модель не отличает, какие её фразы выдуманы. Если в вопросе заложена ошибочная юридическая посылка, она часто принимает её как есть. Та же группа в 2025 году проверила профессиональные юридические ИИ-инструменты, которыми пользуются юристы. Они заявляют, что не выдумывают, но на деле в 17–33% ответов выдумка была. Выглядит выгодно потому, что ИИ доступен в любую минуту, бесплатен и говорит так же уверенно, как врач или юрист."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Первоисточники"]},{"tag":"p","props":{"className":"life-citations"},"children":["Bean AM, Payne RE, Parsons G, et al. (2026). Reliability of LLMs as medical assistants for the general public: a randomized preregistered study. Nature Medicine, 32(2), 609–615. ",{"tag":"a","props":{"href":"https://doi.org/10.1038/s41591-025-04074-y","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1038/s41591-025-04074-y"]},"；Dahl M, Magesh V, Suzgun M, Ho DE (2024). Large Legal Fictions: Profiling Legal Hallucinations in Large Language Models. Journal of Legal Analysis, 16(1), 64–93. ",{"tag":"a","props":{"href":"https://doi.org/10.1093/jla/laae003","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1093/jla/laae003"]},"；Magesh V, Surani F, Dahl M, Suzgun M, Manning CD, Ho DE (2025). Hallucination-Free? Assessing the Reliability of Leading AI Legal Research Tools. Journal of Empirical Legal Studies, 22(2), 216–242. ",{"tag":"a","props":{"href":"https://doi.org/10.1111/jels.12413","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1111/jels.12413"]},"；Kalai AT, Nachum O, Vempala SS, Zhang E (2025). Why Language Models Hallucinate. arXiv:2509.04664（预印本，备注里那项）. ",{"tag":"a","props":{"href":"https://arxiv.org/abs/2509.04664","target":"_blank","rel":"noopener noreferrer"},"children":["https://arxiv.org/abs/2509.04664"]},"；反方：Ayers JW, Poliak A, Dredze M, et al. (2023). Comparing Physician and Artificial Intelligence Chatbot Responses to Patient Questions Posted to a Public Social Media Forum. JAMA Internal Medicine, 183(6), 589. ",{"tag":"a","props":{"href":"https://doi.org/10.1001/jamainternmed.2023.1838","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1001/jamainternmed.2023.1838"]}]},{"tag":"a","props":{"href":"https://doi.org/10.1038/s41591-025-04074-y","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Открыть источник"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Примечание автора"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["Спорный момент. В исследовании 2023 года из американского форума отобрали 195 вопросов пациентов, а медицинские работники оценивали ответы, не зная, кто их написал. По 78,6% оценок ответ ChatGPT был признан лучше ответа врача. Но сравнивали, насколько хорошо написан ответ, а не то, правильно ли в итоге рассудил задавший вопрос. В описанном выше испытании использовали модели 2024 года, новые модели могут быть сильнее. Впрочем, то же испытание показало: результат ИИ на экзамене сам по себе не предсказывает, насколько хорошо им пользуются обычные люди. Почему ИИ выдумывает, исследователи OpenAI объяснили в 2025 году в статье, не прошедшей рецензирование: способ обучения и оценки поощряет «угадать ответ», а ответ «не знаю» очков не приносит, поэтому при неуверенности модель всё равно говорит уверенно. Способ проверки: попросите назвать закон с номером статьи, клиническое руководство или название статьи, откройте оригинал на официальном сайте и найдите эту фразу; не нашли — считайте, что её не было. Задавая вопрос, не вписывайте в него собственный вывод: спрашивайте «как закон регулирует такую ситуацию», а не «я ведь точно выиграю?». При внезапном перекосе лица, слабости с одной стороны или давящей боли в груди сначала не спрашивайте ИИ, а сразу звоните 120, см. раздел 13, пункт 3 (перекос лица, слабость в руке) и раздел 13, пункт 7 (давящая боль в груди). Если нет денег на адвоката для суда, см. раздел 7, пункт 3 (заявление на юридическую помощь). Польза оценена как малая, потому что есть только промежуточные показатели вроде «распознал ли болезнь», а данных о снижении смертности нет. Выгодополучатель — вы сами и ваша семья."]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Моя заметка"]},{"tag":"button","props":{"type":"button"},"children":["Запишите напоминание…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/ru/tip/06-30"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Предыдущий"]},"Не рассчитывайте, что большие дозы кальция и костный бульон ускорят сращение перелома"]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["Другие советы по этой теме"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/06-24"},"children":[{"tag":"strong","props":{},"children":["Не тратьте лишние деньги на новую квартиру, машину или круг общения лишь ради того, чтобы «подняться в социальном статусе»"]},{"tag":"span","props":{},"children":["Если сравнивать людей с одинаковым доходом, то чем выше доход у сосед…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/06-25"},"children":[{"tag":"strong","props":{},"children":["Не верьте утверждению «воля — это как мышца, которая быстро устает»"]},{"tag":"span","props":{},"children":["Существует популярная теория: если сначала выполнить действие, требую…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/06-26"},"children":[{"tag":"strong","props":{},"children":["Не стоит рассчитывать, что завтрак или режим питания 16:8 помогут вам контролировать вес — выбирайте тот график, который сможете соблюдать долгое время"]},{"tag":"span","props":{},"children":["Согласно популярным представлениям, отказ от завтрака приводит к пере…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/06-27"},"children":[{"tag":"strong","props":{},"children":["Не верьте в то, что «мастурбация вредит здоровью» или что «нужно воздерживаться, чтобы стать лучше»; на самом деле важно лишь то, не мешает ли это вашему сну, работе и отношениям"]},{"tag":"span","props":{},"children":["Исследования не говорят, что мастурбация вредит здоровью. У мужчин с …"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/06-28"},"children":[{"tag":"strong","props":{},"children":["Не тратьте деньги на «исправление сексуальной ориентации» или «лечение гомосексуальности», и не отправляйте туда своих близких"]},{"tag":"span","props":{},"children":["Группа экспертов Американской психологической ассоциации, изучив иссл…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/06-29"},"children":[{"tag":"strong","props":{},"children":["Не рассчитывайте предотвратить боль в пояснице «правильной техникой подъема» и курсами: уменьшайте вес и число подъемов, регулярно занимайтесь физической нагрузкой"]},{"tag":"span","props":{},"children":["У работников, прошедших обучение технике подъема, последующая боль в …"]}]}]}]},{"tag":"a","props":{"className":"life-text-link","href":"/ru/book/06"},"children":["Читать всю тему: Перечень вредных средств"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"15","height":"15","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]}]}]},{"tag":"nav","props":{"className":"life-tabbar","aria-label":"Основная навигация"},"children":[{"tag":"a","props":{"className":"","href":"/ru/book"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"21","height":"21","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-book-open","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M12 7v14"},"children":[]},{"tag":"path","props":{"d":"M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z"},"children":[]}]},{"tag":"span","props":{},"children":["Книга"]}]},{"tag":"a","props":{"className":"","href":"/ru/top-50"},"children":[{"tag":"svg","props":{"xmlns":"http://www