,"children":["教育部は、特定の国や地域において、近年の治安や政策が中国人留学生にとって不利である場合、専用の警告を発令します。これは公式に公開されている…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/32-07"},"children":[{"tag":"strong","props":{},"children":["オーストラリア：OSHCは全滞在期間をカバーし、中断がないことが必須。入国時に保険を提示できないと入国拒否の可能性あり"]},{"tag":"span","props":{},"children":["オーストラリアでは留学生医療保険（OSHC）がビザの条件となっており、任意ではなく加入が義務付けられています。保険は滞在期間全体をカバーし…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/32-08"},"children":[{"tag":"strong","props":{},"children":["イギリス：ビザ申請料のほかに、年単位で支払う医療附加金があり、学生は毎年 776 ポンド、申請時に一括払い"]},{"tag":"span","props":{},"children":["イギリスへ行く際にかかる費用はビザ申請料だけではありません。ビザの期間に応じて医療附加金を前払いする必要があり、これを支払うことでイギリス…"]}]}]}]},{"tag":"a","props":{"className":"life-text-link","href":"/ja/book/32"},"children":["テーマ全体を読む：海外留学：ビザのステータス、アルバイト、保険、そして学位の認証"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"15","height":"15","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]}]}]},{"tag":"nav","props":{"className":"life-tabbar","aria-label":"メインナビゲーション"},"children":[{"tag":"a","props":{"className":"","href":"/ja/book"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"21","height":"21","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-book-open","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M12 7v14"},"children":[]},{"tag":"path","props":{"d":"M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z"},"children":[]}]},{"tag":"span","props":{},"children":["本"]}]},{"tag":"a","props":{"className":"","h