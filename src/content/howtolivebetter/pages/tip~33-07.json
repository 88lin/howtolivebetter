:"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["成本"]},{"tag":"p","props":{"className":"life-citations"},"children":["不花钱。去一趟县级残联，问一上午。后面要跑的部门不止一个。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["收益"]},{"tag":"p","props":{"className":"life-citations"},"children":["证接上的待遇至少六项，各有各的出处。一是困难残疾人生活补贴和重度残疾人护理补贴，见第 7 节第 8 条（两项补贴）。二是残疾儿童康复救助，见本节第 8 条（康复救助）。三是基本型辅助器具配置补贴，依据是《残疾预防和残疾人康复条例》第二十六条。四是家庭无障碍设施改造补贴，见本节第 9 条（坡道扶手和浴室改造）。五是按比例就业和就业服务，见本节第 10 条（主动说明持证）。六是个人所得税减征，见本节第 11 条（个税减征）。《残疾预防和残疾人康复条例》第二十六条还写明，国家通过实施重点康复项目为城乡贫困残疾人、重度残疾人提供基本康复服务，「按照国家有关规定对基本型辅助器具配置给予补贴」。第二十条规定，县级以上人民政府有关部门和残联应当利用社区资源，设立康复场所或者购买服务，开展康复指导、日常生活能力训练、康复护理、辅助器具配置、信息咨询和转介等社区康复工作（全国，2017 年 7 月 1 日起施行）"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["来源"]},{"tag":"p","props":{"className":"life-citations"},"children":["国务院 (2017). 残疾预防和残疾人康复条例（第二十条、第二十六条）. ",{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/2017-02/27/content_5171308.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/zhengce/zhengceku/2017-02/27/content_5171308.htm"]},""]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["原书备注"]},{"tag":"p","props":{"className":"life-citations"},"children":["办证本身的流程见第 24 节第 10 条（残疾人证）。补贴标准和具体办法多数由省一级定，同一项在两个省能差出好几倍。问的时候把每一项的名字记下来，回家按名字在当地残联官网和政府网站上再查一遍原文件，不要只听柜台上的口头说法。别指望一次问全，隔一年再去问一次，政策会变。"]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["我的备注"]},{"tag":"button","props":{"type":"button"},"children":["写下对自己有用的提醒…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/tip/33-06"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["上一条"]},"别买「能治好瘫痪、失明、耳聋」的疗法和器械"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/tip/33-08"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["下一条"]},"孩子不满 7 岁又有残疾或者孤独症的，去县级残联申请康复救助"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["本主题的其他建议"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/33-03"},"children":[{"tag":"strong","props":{},"children":["精神障碍住院以自愿为原则，只有两种情形可以不经本人同意"]},{"tag":"span","props":{},"children":["家属或单位一句话，不能把一个人留在精神病院住院。法律只认两种情况：已经伤害自己或有这个危险，已经危害别人或有这个危险。第一种要监护人同意才能收。对诊断有异议的，…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/33-04"},"children":[{"tag":"strong","props":{},"children":["长期照护家里残疾人的那个人，自己的身体要有人盯着"]},{"tag":"span","p