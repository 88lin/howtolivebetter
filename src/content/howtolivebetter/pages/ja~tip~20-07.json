den":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["費用・手間"]},{"tag":"p","props":{},"children":["0 元から数十元です。この費用は通常、入院・出産費用に含まれているため、別途支払う必要はありません"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["効果"]},{"tag":"p","props":{},"children":["新生児の体内にあるビタミンKは非常に少ないです。補充を行わないとビタミンK欠乏性出血症を引き起こす可能性があり、遅発型の場合は頭蓋内出血（脳内出血）として現れることがよくあります。ベルギーのコンセンサスでは、「出生時に1または2mgのビタミンKを1回筋肉内注射すること」を推奨しています。予防策が体系的に提供されていない地域では、ビタミンK欠乏性出血の発症率は10万人あたり478例であり、この数値はタシュケントの4.2万人の新生児に基づいています。著者は、予防を行うことで発症率を「78.5%以上」低下させることができると推定しています。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["出典"]},{"tag":"p","props":{"className":"life-citations"},"children":["Fiesack S, Smits A, Rayyan M, et al. (2021). Nutrients, 13(11), 4109. ",{"tag":"a","props":{"href":"https://doi.org/10.3390/nu13114109","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.3390/nu13114109"]},"；Tursunov D, Yoshida Y, Yrysov K, et al. (2018). Nagoya Journal of Medical Science, 80(1), 11. ",{"tag":"a","props":{"href":"https://doi.org/10.18999/nagjms.80.1.11","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.18999/nagjms.80.1.11"]}]},{"tag":"a","props":{"href":"https://doi.org/10.3390/nu13114109","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["出典を開く"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["著者の注記"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["中国の正規の病院で出産する場合、病院が通常この注射を接種するため、自分で心配する必要はありません。自宅での出産や、非正規の施設での出産の場合は、自分から確認する必要があります。経口摂取の効果は注射よりも劣ります。ここで言う注射は筋肉内注射を指します"]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["自分のメモ"]},{"tag":"button","props":{"type":"button"},"children":["自分へのメモを書く…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/ja/tip/20-06"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["前へ"]},"1歳未満には蜂蜜を与えない"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/ja/tip/20-08"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["次へ"]},"3ヶ月未満の乳児は、体温が 38 ℃ に達したら、自宅で様子を見ず、すぐに病院へ行ってください"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5