"props":{"src":"/sites/howtolivebetter/images/book-chapters/16-chronic-care-editorial.webp","srcSet":"/sites/howtolivebetter/images/book-chapters/16-chronic-care-editorial-thumb.webp 600w, /sites/howtolivebetter/images/book-chapters/16-chronic-care-editorial-md.webp 900w, /sites/howtolivebetter/images/book-chapters/16-chronic-care-editorial.webp 1200w","sizes":"(max-width: 760px) 100vw, 450px","alt":"","width":"1200","height":"800","fetchPriority":"high"},"children":[]}]},{"tag":"div","props":{"className":"life-longread-layout"},"children":[{"tag":"aside","props":{"className":"life-longread-toc"},"children":[{"tag":"details","props":{"open":true},"children":[{"tag":"summary","props":{},"children":["В этой статье"]},{"tag":"nav","props":{"aria-label":"В этой статье"},"children":[{"tag":"a","props":{"href":"#неделя-диагноза"},"children":["Неделя диагноза"]},{"tag":"a","props":{"href":"#первые-три-месяца"},"children":["Первые три месяца"]},{"tag":"a","props":{"href":"#когда-состояние-стабилизировалось"},"children":["Когда состояние стабилизировалось"]}]}]}]},{"tag":"div","props":{"className":"life-longread-main"},"children":[{"tag":"article","props":{"className":"life-article-body","lang":"ru"},"children":[{"tag":"blockquote","props":{},"children":["\n",{"tag":"p","props":{},"children":["Неофициальный перевод файла ",{"tag":"a","props":{"href":"/articles/new-chronic-diagnosis"},"children":["docs/刚确诊慢性病之后.md"]},". При расхождениях приоритет у китайского оригинала."]},"\n"]},"\n",{"tag":"p","props":{},"children":[{"tag":"a","props":{"href":"https://github.com/dlgrv/HowToLiveBetter/blob/5a8aac6e715851066661ab6524c3a4e650f7e9d7/README.ru.md","target":"_blank","rel":"noopener noreferrer"},"children":["← К оглавлению"]}]},"\n",{"tag":"p","props":{},"children":["Список для недавнего диагноза хронических состояний — гипертония, диабет, повышенные липиды, подагра и т. п. Связанные пункты книги разбросаны по разделам; здесь они по времени. В каждой строке — только действие; обоснование, цифры и источники — в указанном пункте. Пропускайте то, что не относится к вашему диагнозу."]},"\n",{"tag":"h2","props":{"id":"неделя-диагноза"},"children":["Неделя диагноза"]},"\n",{"tag":"ol","props":{},"children":["\n",{"tag":"li","props":{},"children":["Если болезнь серьёзная — пусть с вами придут за заключением; в этот день не оставайтесь дома одни. Отложите увольнение, продажу жилья и подобное. См. ",{"tag":"a","props":{"href":"/ru/book/29"},"children":["пункт 2 раздела 29"]}," (неделя после тяжёлого диагноза)."]},"\n",{"tag":"li","props":{},"children":["Если врач назначил лекарства — начните сегодня по рецепту; не бросайте, когда станет легче. См. ",{"tag":"a","props":{"href":"/ru/book/16"},"children":["пункт 1 раздела 16"]}," (принимать лекарства по назначению)."]},"\n",{"tag":"li","props":{},"children":["При гипертонии и высоких липидах принимайте препараты регулярно; сами не отменяйте. См. ",{"tag":"a","props":{"href":"/ru/book/02"},"children":["пункт 12 раздела 2"]}," (гипертония и липиды: лекарства по назначению)."]},"\n",{"tag":"li","props":{},"children":["При гипертонии купите домашний тонометр и меряйте дома, пока цифры не выйдут на цель. См. ",{"tag":"a","props":{"href":"/ru/book/01"},"children":["пункт 7 раздела 1"]}," (давление дома и лечение до цели)."]},"\n",{"tag":"li","props":{},"children":["При выдаче рецептов спросите, есть ли препараты централизованных закупок или дженерики. См. ",{"tag":"a","props":{"href":"/ru/book/05"},"children":["пункт 12 раздела 5"]}," (дженерики и централизованные закупки)."]},"\n",{"tag":"li","props":{},"children":["При диагнозе сахарного диабета 2-го типа один раз пройдите осмотр глаз с расширением зрачка; при 1-м типе — с пятого года болезни. См. ",{"tag":"a","props":{"href":"/ru/book/16"},"children":["пункт 7 раздела 16"]}," (осмотр глаз при диабете)."]},"\n",{"tag":"li","props":{},"children":["При диагнозе подагры начните длительную терапию снижением мочевой кислоты и держите сывороточную мочевую кислоту ниже 360 мкмоль/л. См. ",{"tag":"a","props":{"href":"/ru/book/16"},"children":["пункт 9 раздела 16"]}," (длительное снижение мочевой кислоты при подагре)."]},"\n",{"tag":"li","props":{},"children":["Перед аллопуринолом у людей ханской этничности уточните, нужен ли тест генотипа HLA-B*5801. См. ",{"tag":"a","props":{"href":"/ru/book/16"},"children":["пункт 9 раздела 16"]}," (длительное снижение мочевой кислоты при подагре)."]},"\n",{"tag":"li","props":{},"children":["Высокая мочевая кислота только при диспансеризации, без когда‑либо приступов подагры — это ещё не подагра; препараты снижения мочевой кислоты пока не начинайте. См. ",{"tag":"a","props":{"href":"/ru/book/06"},"children":["пункт 19 раздела 6"]}," (высокая мочевая кислота без боли)."]},"\n",{"tag":"li","props":{},"children":["Если курите — назначьте дату отказа и в этот день бросьте полностью. См. ",{"tag":"a","props":{"href":"/ru/book/02"},"children":["пункт 4 раздела 2"]}," (назначить дату отказа)."]},"\n",{"tag":"li","props":{},"children":["На одной силе воли не рассчитывайте; идите в кабинет отказа от курения или к пульмонологу за препаратами. См. ",{"tag":"a","props":{"href":"/ru/book/02"},"children":["пункт 3 раздела 2"]}," (лекарства для отказа от курения)."]},"\n"]},"\n",{"tag":"h2","props":{"id":"первые-три-месяца"},"children":["Первые три месяца"]},"\n",{"tag":"ol","props":{},"children":["\n",{"tag":"li","props":{},"children":["Заведите блокнот: на каждом контрольном визите — дата, анализы, препараты и дозы. См. ",{"tag":"a","props":{"href":"/ru/book/16"},"children":["пункт 3 раздела 16"]}," (один блокнот на все показатели)."]},"\n",{"tag":"li","props":{},"children":["После каждого визита храните свою копию записей, анализов и снимков. См. ",{"tag":"a","props":{"href":"/ru/book/24"},"children":["пункт 5 раздела 24"]}," (свои медицинские документы)."]},"\n",{"tag":"li","props":{},"children":["В регионе страхования оформите амбулаторное наблюдение по хроническому/особому заболеванию; если часто лечитесь в другом месте — также межрегиональное лечение. См. ",{"tag":"a","props":{"href":"/ru/book/16"},"children":["пункт 2 раздела 16"]}," (хроническое амбулаторное наблюдение и межрегиональная регистрация)."]},"\n",{"tag":"li","props":{},"children":["Если у родственника медстрахование работника — попросите подключить семейное использование счёта, чтобы платить за ваше лечение и лекарства. См. ",{"tag":"a","props":{"href":"/ru/book/05"},"children":["пункт 13 раздела 5"]}," (семейное использование счёта)."]},"\n",{"tag":"li","props":{},"children":["Перед договором с семейным врачом участка спросите, что покрывает страховка, а что за свой счёт. См. ",{"tag":"a","props":{"href":"/ru/book/16"},"children":["пункт 6 раздела 16"]}," (спросить перед договором с семейным врачом)."]},"\n",{"tag":"li","props":{},"children":["Перейдите на малосоденную соль. При нарушении функции почек или при приёме калийсберегающих препаратов — сначала врач. См. ",{"tag":"a","props":{"href":"/ru/book/02"},"children":["пункт 9 раздела 2"]}," (малосоденная соль)."]},"\n",{"tag":"li","props":{},"children":["Начните ежедневные прогулки; ориентир — 7000–8000 шагов или 150–300 минут быстрой ходьбы в неделю. См. ",{"tag":"a","props":{"href":"/ru/book/02"},"children":["пункт 11 раздела 2"]}," (7000–8000 шагов в день)."]},"\n",{"tag":"li","props":{},"children":["Алкоголя меньше; лучше — ни капли. См. ",{"tag":"a","props":{"href":"/ru/book/02"},"children":["пункт 19 раздела 2"]}," (меньше алкоголя или без него)."]},"\n",{"tag":"li","props":{},"children":["Если пьёте каждый день и при отмене дрожь или сердцебиение — не бросайте сами; сначала больница. См. ",{"tag":"a","props":{"href":"/ru/book/02"},"children":["пункт 20 раздела 2"]}," (не бросать алкоголь резко в одиночку)."]},"\n",{"tag":"li","props":{},"children":["Если уговаривают бросить таблетки ради «народных» средств — не бросайте; любую добавку согласуйте с лечащим врачом. См. ",{"tag":"a","props":{"href":"/ru/book/16"},"children":["пункт 4 раздела 16"]}," (не отменять лечение ради народных средств и БАД)."]},"\n",{"tag":"li","props":{},"children":["Не тратьте крупные суммы на БАД и «тонизирующие» составы для «поддержки» организма. См. ",{"tag":"a","props":{"href":"/ru/book/06"},"children":["пункт 10 раздела 6"]}," (дорогие БАД и тоники)."]},"\n",{"tag":"li","props":{},"children":["В первые 3–6 месяцев после начала снижения мочевой кислоты при подагре приступы чаще. При обострении добавьте противовоспалительное по назначению; препараты снижения мочевой кислоты не отменяйте. См. ",{"tag":"a","props":{"href":"/ru/book/16"},"children":["пункт 9 раздела 16"]}," (длительное снижение мочевой кислоты при подагре)."]},"\n",{"tag":"li","props":{},"children":["Покупая простудные или обезболивающие сами — читайте состав; парацетамол должен быть только в одном препарате. См. ",{"tag":"a","props":{"href":"/ru/book/34"},"children":["пункт 1 раздела 34"]}," (парацетамол только в одном продукте)."]},"\n",{"tag":"li","props":{},"children":["На антикоагулянтах или стероидах — спросите врача перед обезболивающими типа ибупрофена. См. ",{"tag":"a","props":{"href":"/ru/book/34"},"children":["пункт 3 раздела 34"]}," (ибупрофен с антикоагулянтами или стероидами)."]},"\n"]},"\n",{"tag":"h2","props":{"id":"когда-состояние-стабилизировалось"},"children":["Когда состояние стабилизировалось"]},"\n",{"tag":"ol","props":{},"children":["\n",{"tag":"li","props":{},"children":["При стабильности и без смены схемы — до 12 недель лекарств за один визит в участковую поликлинику. См. ",{"tag":"a","props":{"href":"/ru/book/16"},"children":["пункт 5 раздела 16"]}," (рецепты на 12 недель в участковой поликлинике)."]},"\n",{"tag":"li","props":{},"children":["Соблюдайте интервал контроля, который задал врач; каждый визит — в тот же блокнот. См. ",{"tag":"a","props":{"href":"/ru/book/16"},"children":["пункт 3 раздела 16"]}," (контроль по графику)."]},"\n",{"tag":"li","props":{},"children":["После перехода на препараты централизованных закупок следите за показателями в блокноте; если они правда ухудшились — к врачу, сами не отменяйте. См. ",{"tag":"a","props":{"href":"/ru/book/05"},"children":["пункт 12 раздела 5"]}," (дженерики и централизованные закупки)."]},"\n",{"tag":"li","props":{},"children":["При диабете — осмотр стоп раз в год и осмотр глаз с интервалом, который назначил врач. См. ",{"tag":"a","props":{"href":"/ru/book/16"},"children":["пункт 7 раздела 16"]}," (осмотр глаз при диабете; ежегодный осмотр стоп)."]},"\n",{"tag":"li","props":{},"children":["При подагре продолжайте снижение мочевой кислоты, даже когда показатель в цели. См. ",{"tag":"a","props":{"href":"/ru/book/16"},"children":["пункт 9 раздела 16"]}," (длительное снижение мочевой кислоты при подагре)."]},"\n",{"tag":"li","props":{},"children":["После камней в почках — 2,5–3 л воды в день и соль меньше 6 г. См. ",{"tag":"a","props":{"href":"/ru/book/16"},"children":["пункт 8 раздела 16"]}," (вода после камней в почках)."]},"\n",{"tag":"li","props":{},"children":["При сердечно-сосудистых заболеваниях каждую осень — прививка от гриппа. См. ",{"tag":"a","props":{"href":"/ru/book/01"},"children":["пункт 20 раздела 1"]}," (ежегодная прививка от гриппа)."]},"\n",{"tag":"li","props":{},"children":["При обычных болезнях начинайте с участка; при госпитализации — по направлению вверх, чтобы непрерывность франшизы сохранилась. См. ",{"tag":"a","props":{"href":"/ru/book/24"},"children":["пункт 1 раздела 24"]}," (сначала участок, ступенчатое направление)."]},"\n",{"tag":"li","props":{},"children":["В одном страховом пуле каждый уровень больницы выше снижает возмещение примерно на десять процентных пунктов — не идите выше без нужды. См. ",{"tag":"a","props":{"href":"/ru/book/24"},"children":["пункт 2 раздела 24"]}," (ниже уровень — выше возмещение)."]},"\n",{"tag":"li","props":{},"children":["К узкому специалисту в крупной больнице — через направление участка или центр направлений; не через перекупщиков. См. ",{"tag":"a","props":{"href":"/ru/book/24"},"children":["пункт 3 раздела 24"]}," (центр направлений)."]},"\n",{"tag":"li","props":{},"children":["Перед лечением в другой провинции уточните дома, сколько вернут — может быть меньше, чем лечиться локально. См. ",{"tag":"a","props":{"href":"/ru/book/24"},"children":["пункт 4 раздела 24"]}," (спросить перед межпровинциальным лечением)."]},"\n"]},"\n"]},{"tag":"footer","props":{"className":"life-article-attribution"},"children":[{"tag":"p","props":{},"children":["Статья воспроизведена из открытого проекта HowToLiveBetter с сохранением формулировок и примечаний. Обновления смотрите в исходном репозитории."]},{"tag":"a","props":{"href":"https://github.com/dlgrv/HowToLiveBetter/blob/5a8aac6e715851066661ab6524c3a4e650f7e9d7/docs/research/ru/%D0%A1%D1%80%D0%B0%D0%B7%D1%83-%D0%BF%D0%BE%D1%81%D0%BB%D0%B5-%D0%B4%D0%B8%D0%B0%D0%B3%D0%BD%D0%BE%D0%B7%D0%B0-%D1%85%D1%80%D0%BE%D0%BD%D0%B8%D1%87%D0%B5%D1%81%D0%BA%D0%BE%D0%B9-%D0%B1%D0%BE%D0%BB%D0%B5%D0%B7%D0%BD%D0%B8.md","target":"_blank","rel":"noopener noreferrer"},"children":["Открыть исходную версию · 5a8aac6",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"14","height":"14","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]},{"tag":"span","props":{},"children":["Импортировано: 2026-10-11"]},{"tag":"p","props":{},"children":["Ссылки ведут к соответствующим советам в нашей версии; номера в источнике могут отличаться."]}]},{"tag":"div","props":{"className":"life-quick-share"},"children":[{"tag":"button","props":{"type":"button"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24",