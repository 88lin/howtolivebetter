.org/2000/svg","width":"18","height":"18","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-up-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M7 7h10v10"},"children":[]},{"tag":"path","props":{"d":"M7 17 17 7"},"children":[]}]}]}]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/es/book/31"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"Volver al índice"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["Qué caminos hay después de los 18 años"]},{"tag":"div","props":{"data-ad-dock-host":"true"},"children":[]},{"tag":"nav","props":{"aria-label":"Consejos del capítulo"},"children":[{"tag":"a","props":{"href":"/es/tip/31-01"},"children":[{"tag":"span","props":{},"children":["01"]},"Primero repasa los umbrales: los requisitos de edad y de estudios de las doce rutas están fijados por escrito"]},{"tag":"a","props":{"href":"/es/tip/31-02"},"children":[{"tag":"span","props":{},"children":["02"]},"El año en que cumples 18, antes del 31 de octubre hay que hacer el registro de servicio militar; el servicio activo del conscripto son dos años"]},{"tag":"a","props":{"href":"/es/tip/31-03"},"children":[{"tag":"span","props":{},"children":["03"]},"Tras aceptar el reclutamiento, negarse al servicio militar impide salir del país o retomar los estudios durante dos años, y cierra la puerta al funcionariado y a las empresas estatales"]},{"tag":"a","props":{"href":"/es/tip/31-04"},"children":[{"tag":"span","props":{},"children":["04"]},"Dos beneficios prácticos para estudiantes universitarios que se alistan: compensación anual de matrícula de hasta 20 000 yuanes, conservación de la matrícula por dos años y un plan especial para el acceso a posgrados"]},{"tag":"a","props":{"href":"/es/tip/31-05"},"children":[{"tag":"span","props":{},"children":["05"]},"Tras la baja, solo en seis casos el gobierno asigna un puesto de trabajo; quien queda en empleo por cuenta propia debe presentarse dentro de los 30 días"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/es/tip/31-06","data-status":"active"},"children":[{"tag":"span","props":{},"children":["06"]},"Tres cuentas tras la baja: prima única por baja, los años de servicio militar cuentan como antigüedad laboral y deducción fiscal de 20 000 yuanes al año para quienes trabajan por cuenta propia"]},{"tag":"a","props":{"href":"/es/tip/31-07"},"children":[{"tag":"span","props":{},"children":["07"]},"El sector público no se entra solo por el examen de funcionario: dos años en un programa de servicio de base dan acceso al plan anual de admisión dirigida del 10 %"]},{"tag":"a","props":{"href":"/es/tip/31-08"},"children":[{"tag":"span","props":{},"children":["08"]},"El maestro de Puesto Especial que termina tres años de servicio, aprueba la evaluación y quiere quedarse debe ser incorporado a la plantilla sin demora"]},{"tag":"a","props":{"href":"/es/tip/31-09"},"children":[{"tag":"span","props":{},"children":["09"]},"Bombero y personal civil del ejército son otras dos puertas de contratación pública, con umbrales más bajos que el funcionariado"]},{"tag":"a","props":{"href":"/es/tip/31-10"},"children":[{"tag":"span","props":{},"children":["10"]},"La formación académica no es una decisión única: el examen de autoestudio no impone límites de edad ni de nivel educativo previo; el examen de ingreso para adultos y la Universidad Abierta también permiten completar estudios"]},{"tag":"a","props":{"href":"/es/tip/31-11"},"children":[{"tag":"span","props":{},"children":["11"]},"Si no entras en una unidad de trabajo, eres empleo flexible: pensión y salud se afilian por tu cuenta en el lugar de empleo, y la restricción de registro de hogar ya se levantó"]},{"tag":"a","props":{"href":"/es/tip/31-12"},"children":[{"tag":"span","props":{},"children":["12"]},"Reparto de comida, auto de pasajeros, transporte urbano de carga: la plataforma paga la prima de protección contra daños profesionales por pedido, y tú no pagas"]},{"tag":"a","props":{"href":"/es/tip/31-13"},"children":[{"tag":"span","props":{},"children":["13"]},"Dos rutas que te aseguran la plantilla el mismo día en que rellenas las preferencias de la admisión a la universidad: normalistas a cuenta del Estado y estudiantes de medicina con destino asignado, al precio de 6 años de compromiso"]},{"tag":"a","props":{"href":"/es/tip/31-14"},"children":[{"tag":"span","props":{},"children":["14"]},"Quieres trabajar en el extranjero: comprueba primero si la empresa tiene la licencia de cooperación laboral con el exterior; no puede cobrarte depósito"]},{"tag":"a","props":{"href":"/es/tip/31-15"},"children":[{"tag":"span","props":{},"children":["15"]},"Trabajo remoto desde casa para una empresa extranjera: para la ley fiscal es renta de origen nacional; el impuesto sobre la renta lo declaras tú y el dinero entra por la vía de «remuneración de trabajadores»"]},{"tag":"a","props":{"href":"/es/tip/31-16"},"children":[{"tag":"span","props":{},"children":["16"]},"Sin entrar en una unidad, tú a lo tuyo: para el dinero de arranque mira primero el préstamo con garantía de emprendimiento — hasta 300 000 yuanes por persona y el Tesoro paga la mitad del interés"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"Ruta de navegación"},"children":[{"tag":"a","props":{"href":"/es/book"},"children":["Libro"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/es/book/31"},"children":["Capítulo 31"," ·"," ","Qué caminos hay después de los 18 años"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"31-06"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["06"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["Evidencia"," ","A"]}]},{"tag":"h1","props":{"lang":"es"},"children":["Tres cuentas tras la baja: prima única por baja, los años de servicio militar cuentan como antigüedad laboral y deducción fiscal de 20 000 yuanes al año para quienes trabajan por cuenta propia"]},{"tag":"p","props":{"lang":"es","className":"life-entry-summary"},"children":["Después de la baja hay tres aspectos a tener en cuenta. El primero es la prima única por empleo independiente, que se otorga según los años de servicio activo; quienes hayan recibido condecoraciones reciben un monto adicional. El segundo es que esos años de servicio militar no quedan fuera del seguro social: se consideran como antigüedad laboral y se suman a los años de cotización previos y posteriores a la baja. El tercero es fiscal: quienes abran su propio negocio podrán deducir hasta 20 000 yuanes al año de sus impuestos durante tres años."]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Coste"]},{"tag":"p","props":{},"children":["No cuesta nada. Al momento de la baja, el ejército transfi…"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Beneficio"]},{"tag":"p","props":{},"children":["El primer punto se rige por el “Reglamento de reasentamiento de veteranos militares”. Allí se establece: “A lo…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"Marcar: Tres cuentas tras la baja: prima única por baja, los años de servicio militar cuentan como antigüedad laboral y deducción fiscal de 20 000 yuanes al año para quienes trabajan por cuenta propia"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"Hecho"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"Por hacer"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"Guardar"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Compartir consejo"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Ocultar detalles"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Coste"]},{"tag":"p","props":{},"children":["No cuesta nada. Al momento de la baja, el ejército transfiere tu seguro social y los fondos correspondientes. Luego solo debes acudir a la oficina de seguridad social del lugar de reasentamiento para continuar con el trámite."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Beneficio"]},{"tag":"p","props":{},"children":["El primer punto se rige por el “Reglamento de reasentamiento de veteranos militares”. Allí se establece: “A los soldados y suboficiales que opten por el empleo independiente se les otorgará una prima única según sus años de servicio activo”. El financiamiento proviene de fondos especiales del gobierno central; los criterios exactos los determinan los organismos competentes del Consejo de Estado y del Comité Militar Central, y pueden ajustarse con el tiempo. Existen cinco niveles de incremento: quienes hayan recibido medallas o títulos honoríficos obtienen un 25 % adicional; los con mérito de primera clase o reconocimiento de nivel uno, un 20 %; los con mérito de segunda clase, reconocimiento de nivel dos o mérito de primera clase, un 15 %; los con mérito de tercera clase o reconocimiento de nivel dos, un 10 %; y los con mérito de cuarta clase o reconocimiento de nivel tres, un 5 %. El mismo reglamento indica que los veteranos que no encuentren empleo de inmediato pueden solicitar prestaciones de desempleo en la oficina de empleo y seguridad social de su lugar de hukou; esos años de servicio se consideran como periodos cotizados, salvo para quienes sean reasentados mediante jubilación o asistencia estatal. El segundo punto se basa en la “Ley de protección de veteranos militares”: “Los años de servicio activo se computan como antigüedad laboral y se suman a los años de trabajo posteriores a la baja”. Asimismo, dichos años se combinan con los periodos de cotización previos y posteriores en los regímenes de pensiones, salud y desempleo, y la experiencia militar se considera como experiencia laboral de base. La “Ley del seguro militar” añade que esos años también se suman a los periodos cotizados al seguro médico básico. El tercer punto se rige por la circular conjunta del Ministerio de Finanzas, la Administración Tributaria y el Departamento de Asuntos de Veteranos, de 2023, que establece que quienes ejerzan actividades comerciales individuales podrán deducir hasta 20 000 yuanes al año de los impuestos correspondientes durante tres años; este límite puede elevarse hasta un 20 %. La deducción se aplica sucesivamente a los impuestos mencionados hasta agotar el tope, sin constituir un pago directo. Para empresas que contraten veteranos, el límite es de 6 000 yuanes por persona al año, con posibilidad de aumento del 50 %. El periodo de vigencia es del 1 de enero de 2023 al 31 de diciembre de 2027; quienes no hayan completado tres años al finalizar dicho periodo podrán seguir disfrutando del beneficio hasta cumplirlo."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Fuentes originales"]},{"tag":"p","props":{"className":"life-citations"},"children":["国务院、中央军委 (2024). 退役军人安置条例（国务院、中央军委令第 787 号，第二十一、二十二、七十四、八十一、八十五条）. ",{"tag":"a","props":{"href":"https://www.gov.cn/gongbao/2024/issue_11526/202408/content_6969192.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/gongbao/2024/issue_11526/202408/content_6969192.html"]},"；退役军人事务部 (2020). 关于一次性退役金的十个问题（转载《中国退役军人》2020 年第 10 期）：「基本标准。士兵服现役每满一年，发给4500元」「退役金标准适时调整」. ",{"tag":"a","props":{"href":"https://www.mva.gov.cn/sy/zzxc/202011/t20201113_43153.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.mva.gov.cn/sy/zzxc/202011/t20201113_43153.html"]},"；贵州省退役军人事务厅 (2024). 一次性退役金增发，重要变化！：「现在执行的标准是：士兵服现役每满一年，发给4500元」. ",{"tag":"a","props":{"href":"http://tyjrswt.guizhou.gov.cn/zfxxgk/fdzdgknr/zdlyxx_5621158/tyaz_5621161/202408/t20240809_85367194.html","target":"_blank","rel":"noopener noreferrer"},"children":["http://tyjrswt.guizhou.gov.cn/zfxxgk/fdzdgknr/zdlyxx_5621158/tyaz_5621161/202408/t20240809_85367194.html"]},"；烟台市牟平区人民政府 (2025). 答复中引《烟台市退役军人事务局、烟台市财政局关于调整自主就业退役士兵一次性经济补助标准的通知》：「2024年退出现役的每服役一年补助6000元」. ",{"tag":"a","props":{"href":"https://www.muping.gov.cn/art/2025/11/10/art_105032_2960250.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.muping.gov.cn/art/2025/11/10/art_105032_2960250.html"]},"；全国人大常委会 (2020). 退役军人保障法（第四十二、四十四、五十条）. ",{"tag":"a","props":{"href":"http://www.mod.gov.cn/gfbw/fgwx/flfg/16048597.html","target":"_blank","rel":"noopener noreferrer"},"children":["http://www.mod.gov.cn/gfbw/fgwx/flfg/16048597.html"]},"（国防部刊登）；全国人大常委会 (2012). 军人保险法（第十六、二十三条）. ",{"tag":"a","props":{"href":"https://flk.npc.gov.cn/detail?id=2c909fdd678bf17901678bf73e160645","target":"_blank","rel":"noopener noreferrer"},"children":["https://flk.npc.gov.cn/detail?id=2c909fdd678bf17901678bf73e160645"]},"（国家法律法规数据库）；财政部、税务总局、退役军人事务部 (2023). 关于进一步扶持自主就业退役士兵创业就业有关税收政策的公告（2023 年第 14 号）. ",{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/202308/content_6896456.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/zhengce/zhengceku/202308/content_6896456.htm"]}]},{"tag":"a","props":{"href":"https://www.gov.cn/gongbao/2024/issue_11526/202408/content_6969192.html","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Abrir fuente"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Nota del autor"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["El reglamento solo establece que el monto será determinado por la autoridad competente. La cifra oficial que se puede consultar es la publicada en el boletín anual de 2020 del sitio web oficial del Ministerio de Asuntos de Veteranos: «por cada año completo de servicio activo, se otorgarán 4500 yuanes»; el mismo artículo también indica que se «ajustará oportunamente». La proporción de aumento mencionada en dicho artículo ya no coincide con el reglamento vigente, por lo que debe prevalecer lo establecido en el reglamento. La Oficina de Asuntos de Veteranos de la provincia de Guizhou publicó en 2024 de 8, bajo el nuevo reglamento, que «el estándar que se aplica actualmente es: por cada año completo de servicio activo de un soldado, se otorgarán 4500 yuanes». TODO (Pendiente de verificar: no se ha encontrado el documento oficial de estándares, solo se puede confirmar que hasta 2024, 8, los departamentos provinciales seguían escribiendo esto). Además, no confunda la «subvención económica de pago único» local con este concepto. Ese es otro pago determinado y distribuido por cada localidad; por ejemplo, en Yantai, 2024 yuanes de subsidio por cada año de servicio para quienes se jubilaron en 6000. La mayoría de las nuevas cifras que aparecen en las guías no tienen una fuente clara, y algunas simplemente han mezclado estos dos pagos. Durante el periodo de servicio como soldado conscripto, la familia también puede recibir un subsidio de preferencia familiar adicional. La Ley de Servicio Militar solo establece que «el estándar será determinado por el gobierno popular a nivel local, y el tesoro central otorgará un subsidio fijo»; para saber la cantidad exacta, debe consultar al gobierno popular a nivel de condado que aprobó su alistamiento. En cuanto a los impuestos, se refiere a cuánto se puede reducir el pago de impuestos como máximo cada año. Si el negocio no prospera, no se utilizará el monto completo, por lo que el nivel de ingresos de todo el esquema solo se define como «medio». El «Reglamento para la Promoción del Empleo y el Emprendimiento de Veteranos» que entró en vigor el 1 de 8 de 2026 añadió otra disposición: los certificados de cualificación profesional de personal técnico obtenidos durante el servicio son válidos en todo el país tras la baja."]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Mi nota"]},{"tag":"button","props":{"type":"button"},"children":["Escribe un recordatorio…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/es/tip/31-05"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Anterior"]},"Tras la baja, solo en seis casos el gobierno asigna un puesto de trabajo; quien queda en empleo por cuenta propia debe presentarse dentro de los 30 días"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/es/tip/31-07"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Siguiente"]},"El sector público no se entra solo por el examen de funcionario: dos años en un programa de servicio de base dan acceso al plan anual de admisión dirigida del 10 %"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"t