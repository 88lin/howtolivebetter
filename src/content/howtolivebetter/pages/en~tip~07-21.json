ildren":[{"tag":"path","props":{"d":"M18 20a6 6 0 0 0-12 0"},"children":[]},{"tag":"circle","props":{"cx":"12","cy":"10","r":"4"},"children":[]},{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},{"tag":"span","props":{},"children":["Sign in to sync"]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/en/book/07"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"Back to index"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["How to get by when you have little money"]},{"tag":"nav","props":{"aria-label":"Chapter entries"},"children":[{"tag":"a","props":{"href":"/en/tip/07-01"},"children":[{"tag":"span","props":{},"children":["01"]},"Apply online for unemployment benefits if you’ve lost your job"]},{"tag":"a","props":{"href":"/en/tip/07-02"},"children":[{"tag":"span","props":{},"children":["02"]},"First file a complaint with the Human Resources and Social Security Bureau, then apply for final and binding one-instance arbitration — both options are free, and most cases yield results within a few months"]},{"tag":"a","props":{"href":"/en/tip/07-03"},"children":[{"tag":"span","props":{},"children":["03"]},"If you can’t afford legal fees, apply for free legal aid – cases involving unpaid wages, alimony, or workplace injuries all qualify"]},{"tag":"a","props":{"href":"/en/tip/07-04"},"children":[{"tag":"span","props":{},"children":["04"]},"When you have nowhere else to turn, go to a shelter – they provide food, lodging, and even a ticket home"]},{"tag":"a","props":{"href":"/en/tip/07-05"},"children":[{"tag":"span","props":{},"children":["05"]},"Use free public employment services and gig platforms first — avoid paid agencies"]},{"tag":"a","props":{"href":"/en/tip/07-06"},"children":[{"tag":"span","props":{},"children":["06"]},"Apply for emergency assistance when unexpected crises occur"]},{"tag":"a","props":{"href":"/en/tip/07-07"},"children":[{"tag":"span","props":{},"children":["07"]},"Apply for dibao if your household income falls below the local threshold"]},{"tag":"a","props":{"href":"/en/tip/07-08"},"children":[{"tag":"span","props":{},"children":["08"]},"Apply for the two disability subsidies using a disability certificate"]},{"tag":"a","props":{"href":"/en/tip/07-09"},"children":[{"tag":"span","props":{},"children":["09"]},"Do not miss the annual 400‑yuan payment for basic medical insurance; subsidies are available for low‑income households"]},{"tag":"a","props":{"href":"/en/tip/07-10"},"children":[{"tag":"span","props":{},"children":["10"]},"When suffering from a serious illness, first use yibao, dibao, medical assistance, and register for cross‑regional treatment — avoid online loans"]},{"tag":"a","props":{"href":"/en/tip/07-11"},"children":[{"tag":"span","props":{},"children":["11"]},"Replace a lost ID card immediately; get a temporary ID if you need it urgently"]},{"tag":"a","props":{"href":"/en/tip/07-12"},"children":[{"tag":"span","props":{},"children":["12"]},"After registering as unemployed, seek recognition as a person facing employment difficulties to receive social insurance subsidies or placement in public-interest jobs"]},{"tag":"a","props":{"href":"/en/tip/07-13"},"children":[{"tag":"span","props":{},"children":["13"]},"Apply for vocational training subsidies, employment internship subsidies, and social insurance subsidies during unemployment — don’t pay for training courses out of pocket"]},{"tag":"a","props":{"href":"/en/tip/07-14"},"children":[{"tag":"span","props":{},"children":["14"]},"Job hunting isn’t just about sending resumes — use a systematic approach: learn skills, set goals, and ask for help"]},{"tag":"a","props":{"href":"/en/tip/07-15"},"children":[{"tag":"span","props":{},"children":["15"]},"No deposits, no ID retention, no “training loans”, no pyramid schemes, no usurious loans"]},{"tag":"a","props":{"href":"/en/tip/07-16"},"children":[{"tag":"span","props":{},"children":["16"]},"Public rental housing for those with housing difficulties"]},{"tag":"a","props":{"href":"/en/tip/07-17"},"children":[{"tag":"span","props":{},"children":["17"]},"Keep food and housing costs to a minimum: opt for monthly shared housing instead of daily rentals, and cook at home or use senior meal services rather than ordering takeout"]},{"tag":"a","props":{"href":"/en/tip/07-18"},"children":[{"tag":"span","props":{},"children":["18"]},"Don’t panic if your social insurance lapses: pension is calculated cumulatively, medical insurance is restored per rules"]},{"tag":"a","props":{"href":"/en/tip/07-19"},"children":[{"tag":"span","props":{},"children":["19"]},"Even those who have served time, filed for bankruptcy, or ended up on a blacklist still have legal avenues to start over — provided they complete all required procedures"]},{"tag":"a","props":{"href":"/en/tip/07-20"},"children":[{"tag":"span","props":{},"children":["20"]},"Before facing a serious illness, consider adding a one‑year medical or critical‑illness policy to your basic medical insurance; make sure it includes the phrase “guaranteed renewal”"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/en/tip/07-21","data-status":"active"},"children":[{"tag":"span","props":{},"children":["21"]},"If there’s nowhere else to sleep, 24‑hour venues can only serve as a temporary overnight stop; shelters should be the first choice"]},{"tag":"a","props":{"href":"/en/tip/07-22"},"children":[{"tag":"span","props":{},"children":["22"]},"If