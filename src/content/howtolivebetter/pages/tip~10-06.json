div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["成本"]},{"tag":"p","props":{},"children":["要花路费，还要花来回路上的时间。见面次数比同城少。难在长期扛住见不着面。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["收益"]},{"tag":"p","props":{},"children":["两项研究的结论一致。异地恋在分开期间反而比同城恋更稳定。原因是异地关系里把对方想得比实际更好的程度明显更高，研究测的是理想化失真、浪漫爱、关系回忆、感知到的一致这几项。而且见面越少，想得越美。但这种稳定只在双方仍然分开时成立，一旦变成同城，异地伴侣更容易分手。追踪异地转同城的那项研究给出的比例是：约一半异地伴侣走到了搬到一起这一步，另一半在分开期间就结束了。在重聚的这一半里，三分之一在重聚后 3 个月内分手。分开期间见面间隔越长、理想化越强，重聚后越不稳"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["原始出处"]},{"tag":"p","props":{"className":"life-citations"},"children":["Stafford L, Merolla AJ, Castle JD (2006). When long-distance dating partners become geographically close. Journal of Social and Personal Relationships, 23(6), 901-919. ",{"tag":"a","props":{"href":"https://doi.org/10.1177/0265407506070472","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1177/0265407506070472"]},"；Stafford L, Merolla AJ (2007). Idealization, reunions, and stability in long-distance dating relationships. Journal of Social and Personal Relationships, 24(1), 37-54. ",{"tag":"a","props":{"href":"https://doi.org/10.1177/0265407507072578","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1177/0265407507072578"]},"；Dargie E 等 (2015). Journal of Sex & Marital Therapy, 41(2), 181-202. ",{"tag":"a","props":{"href":"https://doi.org/10.1080/0092623X.2013.864367","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1080/0092623X.2013.864367"]},"（备注里那项异地研究）"]},{"tag":"a","props":{"href":"https://doi.org/10.1177/0265407506070472","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["打开来源链接"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["原书备注"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["对象是美国大学生的恋爱关系，不含婚姻，年代也较早，绝对比例别直接套。另一项研究调查了 717 人异地、425 人同城。两类关系的质量差别很小，关系好不好主要看两个人各自的情况和这段关系本身。所以决定要不要异地时，别拿「异地一定散」当理由。要提前准备的是重聚后那几个月，那时自主空间变少，彼此了解变多，冲突和吃醋也变多"]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["我的备注"]},{"tag":"button","props":{"type":"button"},"children":["写下对自己有用的提醒…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/tip/10-05"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["上一条"]},"想拉近距离就轮流回答一组由浅入深的问题，别学话术"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/tip/10-07"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["下一条"]},"先看登记数据再听长辈：结婚率、离婚率各是什么口径"]},{"tag":"svg","props":{"xmlns":"http://www.w3.