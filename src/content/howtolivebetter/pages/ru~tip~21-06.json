idth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-up-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M7 7h10v10"},"children":[]},{"tag":"path","props":{"d":"M7 17 17 7"},"children":[]}]}]}]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/ru/book/21"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"К содержанию"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["Выезд за границу, путешествия и безопасность за рубежом"]},{"tag":"div","props":{"data-ad-dock-host":"true"},"children":[]},{"tag":"nav","props":{"aria-label":"Советы главы"},"children":[{"tag":"a","props":{"href":"/ru/tip/21-01"},"children":[{"tag":"span","props":{},"children":["01"]},"Перед поездкой стоит посмотреть официальные рекомендации МИД по безопасности — в тех местах, где указано «временно не рекомендуется посещать», лучше не ехать"]},{"tag":"a","props":{"href":"/ru/tip/21-02"},"children":[{"tag":"span","props":{},"children":["02"]},"Сохраните номер 12308 и телефон консульской защиты местного посольства в телефоне, а затем запишите их от руки и положите в кошелек — не ждите беды, чтобы искать их"]},{"tag":"a","props":{"href":"/ru/tip/21-03"},"children":[{"tag":"span","props":{},"children":["03"]},"Что может, а чего не может сделать консульская защита: может навестить, но не может вызволить, а расходы придётся оплачивать самому"]},{"tag":"a","props":{"href":"/ru/tip/21-04"},"children":[{"tag":"span","props":{},"children":["04"]},"Оформите полис медстраховки, покрывающий лечение за границей и транспортировку пострадавших — не ограничивайтесь страховкой от задержек рейсов"]},{"tag":"a","props":{"href":"/ru/tip/21-05"},"children":[{"tag":"span","props":{},"children":["05"]},"«Высокооплачиваемая работа за границей» — всё это мошенничество; за участие в телефонных аферах можно лишиться права на выезд из страны"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/ru/tip/21-06","data-status":"active"},"children":[{"tag":"span","props":{},"children":["06"]},"Годовой лимит на снятие наличных за границей — 100 000 юаней, рассчитывается по всем картам, оформленным на ваше имя"]},{"tag":"a","props":{"href":"/ru/tip/21-07"},"children":[{"tag":"span","props":{},"children":["07"]},"Сделайте фотографии паспорта, виз и удостоверения личности и сохраните их в облаке; в случае утери сначала обратитесь в полицию, а затем оформите временное разрешение на выезд"]},{"tag":"a","props":{"href":"/ru/tip/21-08"},"children":[{"tag":"span","props":{},"children":["08"]},"Перед тем как садиться за руль за границей, убедитесь, признают ли там китайские водительские права; большинство так называемых «международных водительских удостоверений», продающихся в интернете, юридической силы не имеют"]},{"tag":"a","props":{"href":"/ru/tip/21-09"},"children":[{"tag":"span","props":{},"children":["09"]},"При обращении к посредникам за оформлением виз, учебы за границей или иммиграции сначала уточните, зарегистрированы ли они в органах иммиграционного контроля"]},{"tag":"a","props":{"href":"/ru/tip/21-10"},"children":[{"tag":"span","props":{},"children":["10"]},"Не выписывайте приглашения для незнакомцев и не позволяйте использовать ваши данные для оформления виз и разрешений на въезд"]},{"tag":"a","props":{"href":"/ru/tip/21-11"},"children":[{"tag":"span","props":{},"children":["11"]},"Перед выездом отправьте своему родственнику маршрут, адрес проживания и эти спутников, а также договоритесь, как часто будете связываться"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"Навигация"},"children":[{"tag":"a","props":{"href":"/ru/book"},"children":["Книга"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/ru/book/21"},"children":["Глава 21"," ·"," ","Выезд за границу, путешествия и безопасность за рубежом"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"21-06"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["06"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["Доказательства"," ","A"]}]},{"tag":"h1","props":{"lang":"ru"},"children":["Годовой лимит на снятие наличных за границей — 100 000 юаней, рассчитывается по всем картам, оформленным на ваше имя"]},{"tag":"p","props":{"lang":"ru","className":"life-entry-summary"},"children":["Лимит на снятие наличных за границей рассчитывается не для каждой отдельной карты, а для всех банковских карт (включая дополнительные) на ваше имя в совокупности. В течение одного календарного года этот лимит составляет 100 000 юаней. Как только вы его исчерпаете, в оставшееся время текущего года и в следующем году снимать наличные за границей уже нельзя. При этом снятие денег блокируется только, а оплата покупок картой остаётся возможной, и это не уменьшает ваш годовой лимит на покупку валюты в размере 50 000 долларов США."]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Затраты"]},{"tag":"p","props":{},"children":["Никаких расходов нет. Перед поездкой прикиньте, сколько на…"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Польза"]},{"tag":"p","props":{},"children":["Правила установлены Государственным управлением валютного контроля в «Уведомлении о нормализации операций по к…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"Отметить: Годовой лимит на снятие наличных за границей — 100 000 юаней, рассчитывается по всем картам, оформленным на ваше имя"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"Сделано"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"В планах"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"В избранное"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Поделиться советом"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Скрыть подробности"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Затраты"]},{"tag":"p","props":{},"children":["Никаких расходов нет. Перед поездкой прикиньте, сколько наличных вам понадобится, а остальную сумму тратите по карте. Сложнее всего — отучиться от привычки снимать деньги, когда можно просто расплатиться картой."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Польза"]},{"tag":"p","props":{},"children":["Правила установлены Государственным управлением валютного контроля в «Уведомлении о нормализации операций по крупным снятиям наличных с банковских карт за границей» (Хуйфа [2017] № 29, вступило в силу 1 января 2018 года). В первом пункте указано: «Граждане, использующие внутренние банковские карты для снятия наличных за границей, не должны превышать в течение одного календарного года совокупный лимит в 100 000 юаней по всем картам (включая дополнительные) на своё имя. При превышении этого лимита в текущем и следующем году снятие наличных за границей по этим картам будет заблокировано». Во втором пункте говорится: «Запрещается обходить или помогать обходить ограничения на снятие наличных за границей путём использования чужих карт или передачи своих карт другим лицам». Третий пункт предписывает: ежедневно Управление валютного контроля направляет список заблокированных лиц эмитентам карт, которые обязаны не позднее 17:00 по пекинскому времени того же дня заблокировать снятие наличных за границей для этих людей. Четвёртый пункт уточняет: дневной лимит для иностранных валютных карт снижен с 1000 долларов США до 10 000 юаней; для юаневых карт он остаётся на уровне 10 000 юаней в день. Шестой пункт предусматривает наказание для банков, платёжных систем и граждан, нарушающих эти правила, согласно «Положением о валютном контроле КНР». В ответах на вопросы журналистов Управление подчеркнуло, что это уведомление не ограничивает возможность оплаты товаров и услуг за границей по карте — все расходы на питание, проживание, транспорт и покупки при обычных поездок не уменьшают годовой лимит в 50 000 долларов США. Для оперативного контроля Управление применяет отложенные меры, а не мгновенную блокировку. Статистика показывает, что в 2016 году у 81% владельцев карт сумма снятых за границей средств не превысила 30 000 юаней."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Первоисточники"]},{"tag":"p","props":{"className":"life-citations"},"children":["国家外汇管理局 (2017). 关于规范银行卡境外大额提取现金交易的通知（汇发〔2017〕29 号，第一、二、三、四、六、七条，2018 年 1 月 1 日起实施）. ",{"tag":"a","props":{"href":"https://www.safe.gov.cn/safe/2017/1230/21873.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.safe.gov.cn/safe/2017/1230/21873.html"]},"；国家外汇管理局 (2017). 外汇局有关负责人就规范银行卡境外大额提取现金交易有关问题答记者问. ",{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/2017-12/31/content_5251958.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/zhengce/2017-12/31/content_5251958.htm"]},"；中国银联国际. 境外ATM取款. ",{"tag":"a","props":{"href":"https://m.unionpayintl.com/wap/cn/serviceCenter/cardUsingInstructions/805.shtml","target":"_blank","rel":"noopener noreferrer"},"children":["https://m.unionpayintl.com/wap/cn/serviceCenter/cardUsingInstructions/805.shtml"]}]},{"tag":"a","props":{"href":"https://www.safe.gov.cn/safe/2017/1230/21873.html","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Открыть источник"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Примечание автора"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["Лимит рассчитывается по календарному году, 1 января он сбрасывается в ноль. Снятие наличных блокируется только, а оплата покупок картой остаётся возможной. Если вам действительно нужна крупная сумма наличных, сначала оформите покупку валюты по «Правилам обращения с личными валютными средствами», а затем вывезите её за границу. Существуют ещё два нюанса: на сайте UnionPay International в разделе «Снятие наличных в банкоматах за границей» указано, что на некоторых банкоматах в отдельных странах карты с двумя платёжными системами не позволяют выбрать канал UnionPay; также на экранах некоторых банкоматов может отображаться дополнительная комиссия (surcharge), которую взимает местный эквайер, и она не связана с UnionPay. На том же сайте рекомендуют использовать для снятия наличных за границей дебетовую карту UnionPay, так как при снятии по кредитной карте начисляются проценты за кредит. Что делать, если карта потеряна, застряла в банкомате или по ней произведена несанкционированная транзакция, описано в пункте 5 раздела 14 (сначала заблокируйте карту, затем подайте заявление в полицию)."]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Моя заметка"]},{"tag":"button","props":{"type":"button"},"children":["Запишите напоминание…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/ru/tip/21-05"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Предыдущий"]},"«Высокооплачиваемая работа за границей» — всё это мошенничество; за участие в телефонных аферах можно лишиться права на выезд из страны"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/ru/tip/21-07"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Следующий"]},"Сделайте фотографии паспорта, виз и удостоверения личности и сохраните их в облаке; в случае утери сначала обратитесь в полицию, а затем оформите временное разрешение на выезд"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["Другие советы по этой теме"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/21-02"},"children":[{"tag":"strong","props":{},"children":["Сохраните номер 12308 и телефон консульской защиты местного посольства в телефоне, а затем запишите их от руки и положите в кошелек — не ждите беды, чтобы искать их"]},{"tag":"span","props":{},"children":["В случае непредвиденных обстоятельств есть только один номер, по кото…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/21-03"},"children":[{"tag":"strong","props":{},"children":["Что может, а чего не может сделать консульская защита: может навестить, но не может вызволить, а расходы придётся оплачивать самому"]},{"tag":"span","props":{},"children":["Если вас арестовали за границей, консульство может: уточнить ситуацию…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/21-04"},"children":[{"tag":"strong","props":{},"children":["Оформите полис медстраховки, покрывающий лечение за границей и транспортировку пострадавших — не ограничивайтесь страховкой от задержек рейсов"]},{"tag":"span","props":{},"children":["За лечение за границей придётся платить самостоятельно. Медстраховка …"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/21-08"},"children":[{"tag":"strong","props":{},"children":["Перед тем как садиться за руль за границей, убедитесь, признают ли там китайские водительские права; большинство так называемых «международных водительских удостоверений», продающихся в интернете, юридической силы не имеют"]},{"tag":"span","props":{},"children":["В интернете предлагаемые «международные водительские удостоверения» в…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/21-09"},"children":[{"tag":"strong","props":{},"children":["При обращении к посредникам за оформлением виз, учебы за границей или иммиграции сначала уточните, зарегистрированы ли они в органах иммиграционного контроля"]},{"tag":"span","props":{},"children":["С 15 сентября 2026 года посредники, занимающиеся оформлением виз, уче…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/21-10"},"children":[{"tag":"strong","props":{},"children":["Не выписывайте приглашения для незнакомцев и не позволяйте использовать ваши данные для оформления виз и разрешений на въезд"]},{"tag":"span","props":{},"children":["Если вы выписываете приглашение или подготавливаете документы от чужо…"]}]}]}]},{"tag":"a","props":{"className":"life-text-link","href":"/ru/book/21"},"children":["Читать всю тему: Выезд за границу, путешествия и безопасность за рубежом"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"15","height":"15","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","classNam