ewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-up-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M7 7h10v10"},"children":[]},{"tag":"path","props":{"d":"M7 17 17 7"},"children":[]}]}]}]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/vi/book/31"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"Quay lại mục lục"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["Sau mười tám tuổi có những con đường nào"]},{"tag":"div","props":{"data-ad-dock-host":"true"},"children":[]},{"tag":"nav","props":{"aria-label":"Các mục trong chương"},"children":[{"tag":"a","props":{"href":"/vi/tip/31-01"},"children":[{"tag":"span","props":{},"children":["01"]},"Đối chiếu điều kiện trước đã: yêu cầu về tuổi và trình độ của mười hai con đường đều được viết thành văn bản"]},{"tag":"a","props":{"href":"/vi/tip/31-02"},"children":[{"tag":"span","props":{},"children":["02"]},"Năm thứ mười tám tuổi phải đăng ký nghĩa vụ quân sự trước ngày 31 tháng 10; quân nhân lính nghĩa vụ nhập ngũ đúng hai năm"]},{"tag":"a","props":{"href":"/vi/tip/31-03"},"children":[{"tag":"span","props":{},"children":["03"]},"Sau khi được truy xuất mà từ chối nghĩa vụ quân sự thì trong hai năm không được xuất cảnh, không được học tiếp, và không vào được cơ quan công chức hay doanh nghiệp nhà nước"]},{"tag":"a","props":{"href":"/vi/tip/31-04"},"children":[{"tag":"span","props":{},"children":["04"]},"Hai điều thật nhất khi sinh viên đại học đi nghĩa vụ quân sự: học phí mỗi năm bù tối đa 20000 tệ, giữ học vị hai năm, và có một kế hoạch riêng cho tuyển sinh cao học"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/vi/tip/31-05","data-status":"active"},"children":[{"tag":"span","props":{},"children":["05"]},"Sau khi giải ngũ chỉ có sáu trường hợp được chính quyền bố trí việc làm; người tự tìm việc phải đến đăng ký trong vòng 30 ngày"]},{"tag":"a","props":{"href":"/vi/tip/31-06"},"children":[{"tag":"span","props":{},"children":["06"]},"Ba khoản sau khi giải ngũ: tiền trở cấp một lần, thời gian phục vụ tính vào thâm niên công, và tự làm ăn thì mỗi năm giảm 20000 tệ thuế"]},{"tag":"a","props":{"href":"/vi/tip/31-07"},"children":[{"tag":"span","props":{},"children":["07"]},"Muốn vào hệ thống cơ quan công chức không chỉ có thi cao công chức: làm đủ hai năm ở chương trình phục vụ cơ sở thì dự được kế hoạch tuyển định hướng dành riêng cho 10% mỗi năm"]},{"tag":"a","props":{"href":"/vi/tip/31-08"},"children":[{"tag":"span","props":{},"children":["08"]},"Giáo viên vị trí đặc biệt hết hạn ba năm, đạt kết quả đánh giá và còn muốn ở lại thì phải được chuyển thành biên chế đúng thời hạn"]},{"tag":"a","props":{"href":"/vi/tip/31-09"},"children":[{"tag":"span","props":{},"children":["09"]},"Lính cứu hộ và nhân sự văn chứng quân đội là hai cửa tuyển công khai khác, ngưỡng thấp hơn thi công chức"]},{"tag":"a","props":{"href":"/vi/tip/31-10"},"children":[{"tag":"span","props":{},"children":["10"]},"Bằng cấp không phải việc mua một lần là xong: thi tự học không giới hạn tuổi cũng không xem trình độ đã học, thi lớn và đại học mở đều bổ sung được"]},{"tag":"a","props":{"href":"/vi/tip/31-11"},"children":[{"tag":"span","props":{},"children":["11"]},"Không vào cơ quan công chức thì làm việc linh hoạt: hưu trí và y tế phải tự tham gia bảo hiểm ở nơi làm việc, hạn chế về hộ khẩu đã được nới"]},{"tag":"a","props":{"href":"/vi/tip/31-12"},"children":[{"tag":"span","props":{},"children":["12"]},"Giao đồ ăn, chạy xe ô tô công nghệ, chở hàng trong thành phố: sàn trả phí bảo hiểm tai nạn lao động theo từng đơn, bạn không phải đóng"]},{"tag":"a","props":{"href":"/vi/tip/31-13"},"children":[{"tag":"span","props":{},"children":["13"]},"Hai con đường chốt được chỗ làm việc có biên chế ngay từ ngày điền nguyện vọng kỳ thi gaokao: sinh viên sư phạm có học phí và sinh viên y khoa định hướng, cái giá là thực hiện cam kết 6 năm"]},{"tag":"a","props":{"href":"/vi/tip/31-14"},"children":[{"tag":"span","props":{},"children":["14"]},"Muốn đi làm công ăn nước ngoài, trước hết tra công ty này có giấy phép hợp tác lao động ngoài biên giới không: công ty không được đòi bạn đặt tiền"]},{"tag":"a","props":{"href":"/vi/tip/31-15"},"children":[{"tag":"span","props":{},"children":["15"]},"Làm việc từ xa cho công ty nước ngoài ngay tại nhà, khoản tiền này theo luật thuế tính là thu nhập trong nước: thuế thu nhập cá nhân tự kê khai, tiền về nước đi theo khoản「thù lao lao động」"]},{"tag":"a","props":{"href":"/vi/tip/31-16"},"children":[{"tag":"span","props":{},"children":["16"]},"Không vào cơ quan mà tự làm ăn, tiền khởi đầu hãy xem khoản vay bảo đảm khởi nghiệp: cá nhân tối đa 30 vạn, Nhà nước trợ một nửa lãi suất"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"Breadcrumbs"},"children":[{"tag":"a","props":{"href":"/vi/book"},"children":["Khám phá cuốn sách"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/vi/book/31"},"children":["Chương 31"," ·"," ","Sau mười tám tuổi có những con đường nào"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"31-05"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["05"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["Bằng chứng"," ","A"]}]},{"tag":"h1","props":{"lang":"vi"},"children":["Sau khi giải ngũ chỉ có sáu trường hợp được chính quyền bố trí việc làm; người tự tìm việc phải đến đăng ký trong vòng 30 ngày"]},{"tag":"p","props":{"lang":"vi","className":"life-entry-summary"},"children":["Chuyện「đi quân được xếp việc」lâu nay đã không còn phổ biến. Giờ chỉ có sáu trường hợp do chính quyền bố trí việc làm, còn quân nhân lính nghĩa vụ phục vụ hai năm rồi giải ngũ thì đa số không nằm trong sáu trường hợp đó. Nhóm không được chính quyền bố trí gọi là tự tìm việc, và có một thời hạn cứng: sau khi rời khỏi quân đội phải đến đăng ký trong vòng 30 ngày. Quá 30 ngày mà không có lý do chính đáng thì coi như bạn tự bỏ chế độ sắp xếp."]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Chi phí"]},{"tag":"p","props":{},"children":["Không tốn tiền. Mang theo giấy chứng nhận giải ngũ, đến cơ…"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Lợi ích"]},{"tag":"p","props":{},"children":["Điều hai mươi lăm của《Quy chế sắp xếp cựu chiến binh》《退役军人安置条例》liệt kê sáu trường hợp do chính quyền nơi sắp x…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"Đánh dấu: Sau khi giải ngũ chỉ có sáu trường hợp được chính quyền bố trí việc làm; người tự tìm việc phải đến đăng ký trong vòng 30 ngày"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"Hoàn tất"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"Kế hoạch thực hiện"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"Lưu"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Chia sẻ mẹo này"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Ẩn chi tiết"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Chi phí"]},{"tag":"p","props":{},"children":["Không tốn tiền. Mang theo giấy chứng nhận giải ngũ, đến cơ quan công tác cựu chiến binh ở nơi sắp xếp làm một chuyến."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Lợi ích"]},{"tag":"p","props":{},"children":["Điều hai mươi lăm của《Quy chế sắp xếp cựu chiến binh》《退役军人安置条例》liệt kê sáu trường hợp do chính quyền nơi sắp xếp bố trí việc làm. Nguyên văn là:「（一）军士服现役满 12 年的；（二）服现役期间个人获得勋章、荣誉称号的；（三）服现役期间个人荣获三等战功、二等功以上奖励的；（四）服现役期间个人获得一级表彰的；（五）因战致残被评定为 5 级至 8 级残疾等级的；（六）是烈士子女的」, tức một là quân nhân cấp bậc đã phục vụ đủ 12 năm; hai là trong thời gian phục vụ, cá nhân được tặng huân chương hoặc danh hiệu tôn vinh; ba là trong thời gian phục vụ, cá nhân được tuyên dương chiến công cấp ba hoặc được khen thưởng từ cấp hai trở lên; bốn là trong thời gian phục vụ, cá nhân được tuyên dương cấp một; năm là bị thương vì chiến đấu mà xếp hạng khuyết tật từ cấp 5 đến cấp 8; sáu là là con của liệt sĩ. Quy chế đó còn viết:「安置地人民政府应当在接收退役军士和义务兵的 6 个月内完成安排退役军士和义务兵工作的任务」, tức chính quyền nơi sắp xếp phải hoàn thành việc sắp xếp quân nhân cấp bậc và quân nhân lính nghĩa vụ giải ngũ trong vòng 6 tháng kể từ khi tiếp nhận họ. Đơn vị sử dụng lao động「应当按照规定与其签订不少于 3 年的中长期聘用合同或者劳动合同。其中，企业接收军龄 10 年以上的退役军士的，应当与其签订无固定期限劳动合同」, tức phải ký với họ hợp đồng thuê mướn dài hạn hoặc hợp đồng lao động không dưới 3 năm; trong đó, doanh nghiệp tiếp nhận quân nhân cấp bậc có thời gian phục vụ từ 10 năm trở lên thì phải ký hợp đồng lao động không xác định thời hạn. Hợp đồng không xác định thời hạn là hợp đồng không ghi ngày hết hạn. Trong lúc chờ được sắp xếp việc làm thì「按照当地月最低工资标准逐月发放生活补助」, tức mỗi tháng phát trợ cấp sinh hoạt theo mức lương tối thiểu hằng tháng tại địa phương. Người không lên việc đúng quy định vì lý do không phải từ phía mình thì「按照不低于本单位同等条件人员平均工资 80% 的标准，逐月发放生活费直至上岗为止」, tức mỗi tháng phát chi phí sinh hoạt theo mức không thấp hơn 80% mức lương trung bình của người cùng điều kiện trong cùng đơn vị, cho tới khi lên việc. Những trường hợp không được sắp xếp theo hình thức bố trí việc làm gồm bị khai trừ Đảng phái và từng bị kết án hình sự. Thời hạn của nhóm tự tìm việc xem Điều năm mươi mốt:「自主就业的退役军士和义务兵，应当自被批准退出现役之日起 30 日内，到安置地人民政府退役军人工作主管部门报到。无正当理由不按照规定时间报到超过 30 日的，视为放弃安置待遇。」, tức quân nhân cấp bậc và quân nhân lính nghĩa vụ giải ngũ tự tìm việc thì phải từ ngày được duyệt rời khỏi quân đội, đến cơ quan quản lý công tác cựu chiến binh của chính quyền nơi sắp xếp, trong vòng 30 ngày; không có lý do chính đáng mà quá 30 ngày không đến đúng thời hạn quy định thì coi như từ bỏ chế độ sắp xếp (toàn quốc, áp dụng từ ngày 1 tháng 9 năm 2024)"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Nguồn gốc"]},{"tag":"p","props":{"className":"life-citations"},"children":["国务院、中央军委 (2024). 退役军人安置条例（国务院、中央军委令第 787 号，2024 年 7 月 29 日公布、9 月 1 日施行；第二十五、三十一、三十二、三十五、五十一、七十五条）. ",{"tag":"a","props":{"href":"https://www.gov.cn/gongbao/2024/issue_11526/202408/content_6969192.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/gongbao/2024/issue_11526/202408/content_6969192.html"]},"；全国人大常委会 (2020). 退役军人保障法（第十三、十四、十五条）. ",{"tag":"a","props":{"href":"http://www.mod.gov.cn/gfbw/fgwx/flfg/16048597.html","target":"_blank","rel":"noopener noreferrer"},"children":["http://www.mod.gov.cn/gfbw/fgwx/flfg/16048597.html"]},"（国防部刊登）"]},{"tag":"a","props":{"href":"https://www.gov.cn/gongbao/2024/issue_11526/202408/content_6969192.html","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Liên kết mở nguồn"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Ghi chú sách"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["Đúng ngày quy chế này áp dụng, 《Quy chế sắp xếp quân nhân giải ngũ》năm 2011（国务院、中央军委令第 608 号）bị bãi bỏ. Rất nhiều hướng dẫn trên mạng vẫn dẫn quy chế cũ, cách diễn đạt điều kiện đã thay đổi, bản cũ viết là「平时荣获二等功以上奖励或者战时荣获三等功以上奖励」. Thời hạn 30 ngày chỉ áp cho nhóm tự tìm việc, các hình thức sắp xếp khác thì「按照规定时间」mà đến đăng ký. Khi đăng ký sẽ được cấp thẻ ưu đãi cựu chiến binh, các khoản trợ cấp giải ngũ, hỗ trợ việc làm khởi nghiệp và trợ cấp học vấn về sau đều nối tiếp từ đó."]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Ghi chú của tôi"]},{"tag":"button","props":{"type":"button"},"children":["Viết một lời nhắc cho chính bạn…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/vi/tip/31-04"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Trước"]},"Hai điều thật nhất khi sinh viên đại học đi nghĩa vụ quân sự: học phí mỗi năm bù tối đa 20000 tệ, giữ học vị hai năm, và có một kế hoạch riêng cho tuyển sinh cao học"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/vi/tip/31-06"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Tiếp theo"]},"Ba khoản sau khi giải ngũ: tiền trở cấp một lần, thời gian phục vụ tính vào thâm niên công, và tự làm ăn thì mỗi năm giảm 20000 tệ thuế"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["Thêm trong chủ đề này"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/31-01"},"children":[{"tag":"strong","props":{},"children":["Đối chiếu điều kiện trước đã: yêu cầu về tuổi và trình độ của mười hai con đường đều được viết thành văn bản"]},{"tag":"span","props":{},"children":["Điều kiện về tuổi và trình độ của mười hai con đường đều được viết tr…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/31-02"},"children":[{"tag":"strong","props":{},"children":["Năm thứ mười tám tuổi phải đăng ký nghĩa vụ quân sự trước ngày 31 tháng 10; quân nhân lính nghĩa vụ nhập ngũ đúng hai năm"]},{"tag":"span","props":{},"children":["Đăng ký nghĩa vụ quân sự là nghĩa vụ theo luật, không phải đăng ký th…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/31-03"},"children":[{"tag":"strong","props":{},"children":["Sau khi được truy xuất mà từ chối nghĩa vụ quân sự thì trong hai năm không được xuất cảnh, không được học tiếp, và không vào được cơ quan công chức hay doanh nghiệp nhà nước"]},{"tag":"span","props":{},"children":["Đã đăng ký rồi lại từ chối đi nhập ngũ thì hậu quả là một loạt. Không…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/31-07"},"children":[{"tag":"strong","props":{},"children":["Muốn vào hệ thống cơ quan công chức không chỉ có thi cao công chức: làm đủ hai năm ở chương trình phục vụ cơ sở thì dự được kế hoạch tuyển định hướng dành riêng cho 10% mỗi năm"]},{"tag":"span","props":{},"children":["Muốn vào hệ thống cơ quan công chức thì không chỉ có thi cao công chứ…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/31-08"},"children":[{"tag":"strong","props":{},"children":["Giáo viên vị trí đặc biệt hết hạn ba năm, đạt kết quả đánh giá và còn muốn ở lại thì phải được chuyển thành biên chế đúng thời hạn"]},{"tag":"span","props":{},"children":["Kế hoạch vị trí đặc biệt là một trong số ít con đường mà văn bản ghi …"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/31-09"},"children":[{"tag":"strong","props":{