":"p","props":{"className":"life-citations"},"children":["美国疾病控制与预防中心. 癫痫发作急救：「Don't hold the person down or stop their movements」「Don't put anything in their mouth. This can hurt their teeth or jaw」「Don't offer water or food until they are fully alert」「Time the seizure to track if it lasts more than 5 minutes. If it does, seek immediate medical attention or call 911」. ",{"tag":"a","props":{"href":"https://www.cdc.gov/epilepsy/first-aid-for-seizures/index.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.cdc.gov/epilepsy/first-aid-for-seizures/index.html"]}]},{"tag":"a","props":{"href":"https://www.cdc.gov/epilepsy/first-aid-for-seizures/index.html","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["打开来源链接"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["原书备注"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["同一页还列了另外几种要立刻叫救护车的情况：一次结束后很快又发作、发作后叫不醒或者呼吸困难、发作中受了伤、在水里发作、这是第一次发作。发作停了让他侧躺、嘴朝下，等人完全清醒再给水。家里有癫痫病人的，这套动作最用得上。对陌生人做同样的动作，好处回到你身上的机会小一些，但也不会让你担责（民法典第一百八十四条，见本节第 2 条，别急着把人扶起来）。"]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["我的备注"]},{"tag":"button","props":{"type":"button"},"children":["写下对自己有用的提醒…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"