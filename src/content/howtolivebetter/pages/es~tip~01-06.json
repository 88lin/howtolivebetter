ath","props":{"d":"m6.34 17.66-1.41 1.41"},"children":[]},{"tag":"path","props":{"d":"m19.07 4.93-1.41 1.41"},"children":[]}]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"17","height":"17","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-moon life-theme-icon-dark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"},"children":[]}]}]},{"tag":"button","props":{"type":"button","className":"life-language-switch","aria-label":"Español Elegir idioma","aria-haspopup":"menu","aria-expanded":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-globe","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]},{"tag":"path","props":{"d":"M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"},"children":[]},{"tag":"path","props":{"d":"M2 12h20"},"children":[]}]},{"tag":"span","props":{},"children":["Español"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]}]},{"tag":"a","props":{"className":"life-account","href":"/es/sign-in"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"17","height":"17","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle-user-round","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M18 20a6 6 0 0 0-12 0"},"children":[]},{"tag":"circle","props":{"cx":"12","cy":"10","r":"4"},"children":[]},{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},{"tag":"span","props":{},"children":["Iniciar sesión"]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/es/book/01"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"Volver al índice"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["No mueras antes de tiempo"]},{"tag":"nav","props":{"aria-label":"Consejos del capítulo"},"children":[{"tag":"a","props":{"href":"/es/tip/01-01"},"children":[{"tag":"span","props":{},"children":["01"]},"Abróchate el cinturón, también en los asientos traseros"]},{"tag":"a","props":{"href":"/es/tip/01-02"},"children":[{"tag":"span","props":{},"children":["02"]},"Ponte casco en moto y bicicleta eléctrica, y abróchalo"]},{"tag":"a","props":{"href":"/es/tip/01-03"},"children":[{"tag":"span","props":{},"children":["03"]},"Instala detector de humo; si en invierno calientas con carbón o gas dentro de casa, añade también detector de monóxido de carbono"]},{"tag":"a","props":{"href":"/es/tip/01-04"},"children":[{"tag":"span","props":{},"children":["04"]},"Cambia las mangueras y estufas de gas cuando caduquen; no modifiques tú mismo las tuberías y puedes rechazar directamente cualquier venta a domicilio de la compañía de gas"]},{"tag":"a","props":{"href":"/es/tip/01-05"},"children":[{"tag":"span","props":{},"children":["05"]},"No recojas, no compres y no comas setas silvestres; ningún «truco casero para identificarlas» es válido"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/es/tip/01-06","data-status":"active"},"children":[{"tag":"span","props":{},"children":["06"]},"No introducir bicicletas eléctricas en pasillos, ascensores ni cargarlas en casa"]},{"tag":"a","props":{"href":"/es/tip/01-07"},"children":[{"tag":"span","props":{},"children":["07"]},"Mide la tensión y, si está alta, tómate la medicación hasta llegar al objetivo"]},{"tag":"a","props":{"href":"/es/tip/01-08"},"children":[{"tag":"span","props":{},"children":["08"]},"A partir de los 35 años, si tienes sobrepeso, hazte una glucemia en ayunas; aunque salga normal, repite cada tres años"]},{"tag":"a","props":{"href":"/es/tip/01-09"},"children":[{"tag":"span","props":{},"children":["09"]},"No corras al conducir y no bebas si vas a conducir"]},{"tag":"a","props":{"href":"/es/tip/01-10"},"children":[{"tag":"span","props":{},"children":["10"]},"En el coche, silla infantil homologada para menores de 4 años, no en brazos"]},{"tag":"a","props":{"href":"/es/tip/01-11"},"children":[{"tag":"span","props":{},"children":["11"]},"Con niños en casa, pon limitadores en ventanas y balcones; la mosquitera no es protección"]},{"tag":"a","props":{"href":"/es/tip/01-12"},"children":[{"tag":"span","props":{},"children":["12"]},"Junto al agua, no apartes los ojos de los niños; en barca o bañándose en el campo, chaleco salvavidas"]},{"tag":"a","props":{"href":"/es/tip/01-13"},"children":[{"tag":"span","props":{},"children":["13"]},"A partir de los 60 años, entrena equilibrio y fuerza de piernas, y adapta el baño y las escaleras de casa"]},{"tag":"a","props":{"href":"/es/tip/01-14"},"children":[{"tag":"span","props":{},"children":["14"]},"Hazte la analítica de hepatitis B (cinco marcadores) y, si no tienes anticuerpos, vacúnate"]},{"tag":"a","props":{"href":"/es/tip/01-15"},"children":[{"tag":"span","props":{},"children":["15"]},"Si te pincha un clavo o una astilla, o si la herida se contamina con tierra, acude al médico ese mismo día y pregunta si necesitas la vacuna contra el tétanos"]},{"tag":"a","props":{"href":"/es/tip/01-16"},"children":[{"tag":"span","props":{},"children":["16"]},"Vacúnate del VPH si eres mujer; cuanto antes, mejor"]},{"tag":"a","props":{"href":"/es/tip/01-17"},"children":[{"tag":"span","props":{},"children":["17"]},"A partir de los 40 años, cribado de mama cada dos años con mamografía"]},{"tag":"a","props":{"href":"/es/tip/01-18"},"children":[{"tag":"span","props":{},"children":["18"]},"A partir de los 30 años, cribado de cuello uterino en mujeres, priorizando la prueba del VPH"]},{"tag":"a","props":{"href":"/es/tip/01-19"},"children":[{"tag":"span","props":{},"children":["19"]},"A partir de los 45 o 50 años, cribado de cáncer colorrectal: test inmunológico de sangre oculta en heces o colonoscopia"]},{"tag":"a","props":{"href":"/es/tip/01-20"},"children":[{"tag":"span","props":{},"children":["20"]},"Personas con enfermedad cardiovascular y mayores: vacuna antigripal cada año"]},{"tag":"a","props":{"href":"/es/tip/01-21"},"children":[{"tag":"span","props":{},"children":["21"]},"Vacuna del herpes zóster a partir de los 50 años"]},{"tag":"a","props":{"href":"/es/tip/01-22"},"children":[{"tag":"span","props":{},"children":["22"]},"Vacuna neumocócica a partir de los 65 años"]},{"tag":"a","props":{"href":"/es/tip/01-23"},"children":[{"tag":"span","props":{},"children":["23"]},"Hazte la prueba de Helicobacter pylori y, si sale positiva, erradícalo"]},{"tag":"a","props":{"href":"/es/tip/01-24"},"children":[{"tag":"span","props":{},"children":["24"]},"Fumadores fuertes: TAC torácico de baja dosis una vez al año"]},{"tag":"a","props":{"href":"/es/tip/01-25"},"children":[{"tag":"span","props":{},"children":["25"]},"En depresión o con ideas de suicidio, llama al 12356; en casa no acumules somníferos ni pesticidas"]},{"tag":"a","props":{"href":"/es/tip/01-26"},"children":[{"tag":"span","props":{},"children":["26"]},"Ten a punto extintor, manta ignífuga, mascarilla de escape y botiquín, y revísalos una vez al año"]},{"tag":"a","props":{"href":"/es/tip/01-27"},"children":[{"tag":"span","props":{},"children":["27"]},"Si ves sangre en la orina a simple vista, aunque no duela y aunque al día siguiente ya esté limpia, hazte una revisión"]},{"tag":"a","props":{"href":"/es/tip/01-28"},"children":[{"tag":"span","props":{},"children":["28"]},"Si la erección falla, revisa primero el corazón; no lo tomes como un simple «asunto de eso»"]},{"tag":"a","props":{"href":"/es/tip/01-29"},"children":[{"tag":"span","props":{},"children":["29"]},"Perder peso, dejar el tabaco y controlar tensión y glucosa mejora la función eréctil"]},{"tag":"a","props":{"href":"/es/tip/01-30"},"children":[{"tag":"span","props":{},"children":["30"]},"Preservativo durante toda la relación sexual, y nunca compartas jeringuillas"]},{"tag":"a","props":{"href":"/es/tip/01-31"},"children":[{"tag":"span","props":{},"children":["31"]},"Tras una práctica de riesgo, hazte la prueba del VIH: gratis en el centro de control de enfermedades y con resultado confidencial"]},{"tag":"a","props":{"href":"/es/tip/01-32"},"children":[{"tag":"span","props":{},"children":["32"]},"En cuanto aparezca la idea de suicidarte, díselo primero a una persona de tu alrededor y entrega esos minutos"]},{"tag":"a","props":{"href":"/es/tip/01-33"},"children":[{"tag":"span","props":{},"children":["33"]},"No tomes «salvarse a tiempo» como red de seguridad: tras beber pesticida o inhalar gas, la urgencia salva la vida, pero no los pulmones ni el cerebro"]},{"tag":"a","props":{"href":"/es/tip/01-34"},"children":[{"tag":"span","props":{},"children":["34"]},"No apuestes a que «unos días en la cama y listo» con una caída de altura: la mayoría de los que entran en una UCI de traumatología sobrevive, pero el precio se paga por años"]},{"tag":"a","props":{"href":"/es/tip/01-35"},"children":[{"tag":"span","props":{},"children":["35"]},"No cambies dinero por que «con un solo riñón se vive igual»: el que queda trabaja por dos, y el 86 % de quienes vendieron un riñón dicen que su salud empeoró"]},{"tag":"a","props":{"href":"/es/tip/01-36"},"children":[{"tag":"span","props":{},"children":["36"]},"No recoja, no desmonte ni venda piezas metálicas de procedencia desconocida; manténgase alejado de las zonas señalizadas con el símbolo del trébol"]},{"tag":"a","props":{"href":"/es/tip/01-37"},"children":[{"tag":"span","props":{},"children":["37"]},"Cuando apuestas hasta el punto de pedir prestado para seguir jugando y te sientes deprimido, primero llama al 12356 y luego entrega tus tarjetas bancarias y contraseñas de pago a un familiar para que las gestione"]},{"tag":"a","props":{"href":"/es/tip/01-38"},"children":[{"tag":"span","props":{},"children":["38"]},"Hombres que tienen relaciones sexuales con hombres con conductas de alto riesgo: consultar en hospitales designados para el VIH sobre la profilaxis preexposición puede reducir el riesgo de infección en más del 70%"]},{"tag":"a","props":{"href":"/es/tip/01-39"},"children":[{"tag":"span","props":{},"children":["39"]},"A partir de los 65 años, las mujeres deben hacerse una densitometría ósea con rayos X de doble energía (DXA); las posmenopáusicas con factores de riesgo de osteoporosis no tienen que esperar a los 65"]},{"tag":"a","props":{"href":"/es/tip/01-40"},"children":[{"tag":"span","props":{},"children":["40"]},"Si le diagnostican osteoporosis o se fracturó con una caída leve, pida al médico fármacos contra la osteoporosis y manténgalos; no sustituya el tratamiento solo con calcio"]},{"tag":"a","props":{"href":"/es/tip/01-41"},"children":[{"tag":"span","props":{},"children":["41"]},"Antes de pisar el hielo natural, haga agujeros para medir su grosor; si es inferior a 15 cm, no lo haga. Evite el hielo de ríos y los bordes de los agujeros de pesca"]},{"tag":"a","props":{"href":"/es/tip/01-42"},"children":[{"tag":"span","props":{},"children":["42"]},"Antes de usar una amoladora angular, coloca el protector y ponte gafas y pantalla facial; sujétala con ambas manos y no montes una hoja de sierra para cortar madera"]},{"tag":"a","props":{"href":"/es/tip/01-43"},"children":[{"tag":"span","props":{},"children":["43"]},"Pregunta directamente a alguien cercano cuyo ánimo preocupa: «¿Has pensado en suicidarte?». Preguntar no aumenta esas ideas"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"Ruta de navegación"},"children":[{"tag":"a","props":{"href":"/es/book"},"children":["Libro"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/es/book/01"},"children":["Capítulo 1"," ·"," ","No mueras antes de tiempo"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"01-06"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["06"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["Evidencia"," ","A"]}]},{"tag":"h1","props":{"lang":"es"},"children":["No introducir bicicletas eléctricas en pasillos, ascensores ni cargarlas en casa"]},{"tag":"p","props":{"lang":"es","className":"life-entry-summary"},"children":["Según el Reglamento de gestión de la seguridad contra incendios en edificios residenciales de gran altura del Ministerio de Gestión de Emergencias, está terminantemente prohibido introducir bicicletas eléctricas en pasillos, ascensores o cargarlas en el hogar. Quienes incumplan esta norma se exponen a una multa de 500 a 1000 yuanes si son particulares, y de 2000 a 10000 yuanes si son empresas. Pero lo más grave no es la multa: un incendio originado de esta forma podría afectar precisamente a la única vía de evacuación del edificio."]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Coste"]},{"tag":"p","props":{},"children":["No supone ningún gasto. Lo complicado es tener que llevarl…"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Beneficio"]},{"tag":"p","props":{},"children":["El citado reglamento prohíbe taxativamente «aparcar bicicletas eléctricas o cargarlas en vestíbulos públicos,…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"Marcar: No introducir bicicletas eléctricas en pasillos, ascensores ni cargarlas en casa"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"Hecho"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"Por hacer"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"Guardar"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Compartir consejo"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Ocultar detalles"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Coste"]},{"tag":"p","props":{},"children":["No supone ningún gasto. Lo complicado es tener que llevarlas cada vez hasta el punto de carga colectivo que hay abajo, lo que implica caminar unos cuantos metros más."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Beneficio"]},{"tag":"p","props":{},"children":["El citado reglamento prohíbe taxativamente «aparcar bicicletas eléctricas o cargarlas en vestíbulos públicos, pasillos de evacuación, escaleras y salidas de emergencia de edificios residenciales de gran altura». En dichos espacios no se permite ni el aparcamiento ni la carga. Quienes desobedezcan la norma recibirán multas similares a las mencionadas anteriormente."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Fuentes originales"]},{"tag":"p","props":{"className":"life-citations"},"children":["应急管理部 (2021). 高层民用建筑消防安全管理规定（应急管理部令第 5 号，第三十七条、第四十七条）. ",{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/2021-08/01/content_5628815.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/zhengce/zhengceku/2021-08/01/content_5628815.htm"]},"；应急管理部 (2023). 关于政协第十三届全国委员会第五次会议第00969号提案答复的函：「2021年，全国共接报电动自行车火灾1.8万起，造成65人死亡、222人受伤，直接财产损失达2.21亿元，其中发生在建筑物内3782起，造成60人死亡、175人受伤」. ",{"tag":"a","props":{"href":"https://www.mem.gov.cn/gk/jytabljggk/zxwytadfzy/2022zx/202301/t20230119_440918.shtml","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.mem.gov.cn/gk/jytabljggk/zxwytadfzy/2022zx/202301/t20230119_440918.shtml"]},"；应急管理部 (2025). 2025年1月15日新闻发布会：「火灾起数同比下降42.2%，伤亡人数下降超过90%」. ",{"tag":"a","props":{"href":"https://www.mem.gov.cn/xw/xwfbh/2025n01y15xwfbh_6337/","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.mem.gov.cn/xw/xwfbh/2025n01y15xwfbh_6337/"]}]}