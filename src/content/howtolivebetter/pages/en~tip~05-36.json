:"path","props":{"d":"M20 12h2"},"children":[]},{"tag":"path","props":{"d":"m6.34 17.66-1.41 1.41"},"children":[]},{"tag":"path","props":{"d":"m19.07 4.93-1.41 1.41"},"children":[]}]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"17","height":"17","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-moon life-theme-icon-dark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"},"children":[]}]}]},{"tag":"button","props":{"type":"button","className":"life-language-switch","aria-label":"English Choose language","aria-haspopup":"menu","aria-expanded":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-globe","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]},{"tag":"path","props":{"d":"M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"},"children":[]},{"tag":"path","props":{"d":"M2 12h20"},"children":[]}]},{"tag":"span","props":{},"children":["English"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]}]},{"tag":"a","props":{"className":"life-account","href":"/en/sign-in"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"17","height":"17","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle-user-round","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M18 20a6 6 0 0 0-12 0"},"children":[]},{"tag":"circle","props":{"cx":"12","cy":"10","r":"4"},"children":[]},{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},{"tag":"span","props":{},"children":["Sign in to sync"]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/en/book/05"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"Back to index"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["Don’t waste money"]},{"tag":"nav","props":{"aria-label":"Chapter entries"},"children":[{"tag":"a","props":{"href":"/en/tip/05-01"},"children":[{"tag":"span","props":{},"children":["01"]},"Turn off all automatic renewals and switch to manual renewal upon expiry"]},{"tag":"a","props":{"href":"/en/tip/05-02"},"children":[{"tag":"span","props":{},"children":["02"]},"Conduct the annual tax reconciliation from March to June; be sure to include all eligible special deductions"]},{"tag":"a","props":{"href":"/en/tip/05-03"},"children":[{"tag":"span","props":{},"children":["03"]},"Housing provident fund isn’t just for buying a home: it can be used for renting, home renovations, and paying property taxes, effective from September 20, 2026 under new regulations"]},{"tag":"a","props":{"href":"/en/tip/05-04"},"children":[{"tag":"span","props":{},"children":["04"]},"Recalculate your mobile and broadband plans annually: downgrade unused services, and file a complaint if the carrier refuses to comply"]},{"tag":"a","props":{"href":"/en/tip/05-05"},"children":[{"tag":"span","props":{},"children":["05"]},"Not buying lottery tickets"]},{"tag":"a","props":{"href":"/en/tip/05-06"},"children":[{"tag":"span","props":{},"children":["06"]},"Walk away the moment you see “high returns,” “guaranteed returns,” or “sure profits”"]},{"tag":"a","props":{"href":"/en/tip/05-07"},"children":[{"tag":"span","props":{},"children":["07"]},"Avoid making minimum payments on credit cards, and never sign up for installment plans or consumer loans for purchases; if borrowing is unavoidable, first convert the interest rate to an annual percentage rate before comparing options"]},{"tag":"a","props":{"href":"/en/tip/05-08"},"children":[{"tag":"span","props":{},"children":["08"]},"Don’t give streamers tips, don’t make in‑game purchases, and don’t make impulsive buys"]},{"tag":"a","props":{"href":"/en/tip/05-09"},"children":[{"tag":"span","props":{},"children":["09"]},"When kids make in-app purchases or send gifts, parents can demand refunds for large sums spent by kids over eight if they never gave consent"]},{"tag":"a","props":{"href":"/en/tip/05-10"},"children":[{"tag":"span","props":{},"children":["10"]},"Teaching kids one key phrase: anyone who asks them to use a parent’s phone to enter verification codes is a scammer"]},{"tag":"a","props":{"href":"/en/tip/05-11"},"children":[{"tag":"span","props":{},"children":["11"]},"Skipping extended warranties for electronics"]},{"tag":"a","props":{"href":"/en/tip/05-12"},"children":[{"tag":"span","props":{},"children":["12"]},"Prefer generic drugs that have passed consistency evaluation and those selected in centralized procurement"]},{"tag":"a","props":{"href":"/en/tip/05-13"},"children":[{"tag":"span","props":{},"children":["13"]},"Once you set up family medical expense sharing in the yibao app, funds from your individual medical insurance account can be used to pay for your spouse, parents, and children’s medical care and medication"]},{"tag":"a","props":{"href":"/en/tip/05-14"},"children":[{"tag":"span","props":{},"children":["14"]},"Drink boiled tap water instead of routinely ordering large water-dispenser bottles or buying small bottled water"]},{"tag":"a","props":{"href":"/en/tip/05-15"},"children":[{"tag":"span","props":{},"children":["15"]},"Infrequent stock trading"]},{"tag":"a","props":{"href":"/en/tip/05-16"},"children":[{"tag":"span","props":{},"children":["16"]},"Don’t borrow money to invest, avoid leverage, and never buy assets you don’t understand"]},{"tag":"a","props":{"href":"/en/tip/05-17"},"children":[{"tag":"span","props":{},"children":["17"]},"Using broad-market index funds instead of actively managed funds as a long-term core holding (the portion of money you keep invested for years)"]},{"tag":"a","props":{"href":"/en/tip/05-18"},"children":[{"tag":"span","props":{},"children":["18"]},"When picking similar funds, go for those with lower fees"]},{"tag":"a","props":{"href":"/en/tip/05-19"},"children":[{"tag":"span","props":{},"children":["19"]},"Don’t put all your money into one stock, one platform, or one property"]},{"tag":"a","props":{"href":"/en/tip/05-20"},"children":[{"tag":"span","props":{},"children":["20"]},"Individuals paying income tax at a rate of 10% or higher can open a private pension account; up to 12,000 yuan per year can be deducted from taxable income. For those paying no tax or only a 3% rate, opening such an account is not worthwhile"]},{"tag":"a","props":{"href":"/en/tip/05-21"},"children":[{"tag":"span","props":{},"children":["21"]},"Paying for gym visits individually or on short-term plans is only worthwhile if you have a consistent attendance record spanning over a year"]},{"tag":"a","props":{"href":"/en/tip/05-22"},"children":[{"tag":"span","props":{},"children":["22"]},"Sign a written contract before paying a deposit; if a business faces risks, it must stop taking payments, and you have the right to get back any unused balance if it shuts down"]},{"tag":"a","props":{"href":"/en/tip/05-23"},"children":[{"tag":"span","props":{},"children":["23"]},"Implementing a 24-hour cooling-off period for non-essential big-ticket purchases; making full use of the seven-day no-questions-asked return policy for online shopping"]},{"tag":"a","props":{"href":"/en/tip/05-24"},"children":[{"tag":"span","props":{},"children":["24"]},"Don’t fall for “strikethrough prices” or impulse buying during sales"]},{"tag":"a","props":{"href":"/en/tip/05-25"},"children":[{"tag":"span","props":{},"children":["25"]},"It’s better to choose a non‑return insurance plan and treat any “refunds” or dividends as non‑guaranteed benefits"]},{"tag":"a","props":{"href":"/en/tip/05-26"},"children":[{"tag":"span","props":{},"children":["26"]},"Get sufficient third‑party liability coverage: the mandatory insurance limits are uniform nationwide and relatively low, so any excess must be paid out of your own pocket"]},{"tag":"a","props":{"href":"/en/tip/05-27"},"children":[{"tag":"span","props":{},"children":["27"]},"Set aside an emergency fund equal to 3–6 months of living expenses in a readily accessible account"]},{"tag":"a","props":{"href":"/en/tip/05-28"},"children":[{"tag":"span","props":{},"children":["28"]},"Run a quick comparison before paying off your mortgage — don’t rely on gut feeling"]},{"tag":"a","props":{"href":"/en/tip/05-29"},"children":[{"tag":"span","props":{},"children":["29"]},"When shopping online, follow platform rules and laws — not influencers or “positive reviews”"]},{"tag":"a","props":{"href":"/en/tip/05-30"},"children":[{"tag":"span","props":{},"children":["30"]},"If something goes wrong after buying from a livestream, first ask the platform for the seller’s and influencer’s details — they’re required to provide them"]},{"tag":"a","props":{"href":"/en/tip/05-31"},"children":[{"tag":"span","props":{},"children":["31"]},"If you buy unsafe food, you can demand ten times the purchase price as compensation; if the amount is under 1,000 yuan, you’re still entitled to 1,000 yuan"]},{"tag":"a","props":{"href":"/en/tip/05-32"},"children":[{"tag":"span","props":{},"children":["32"]},"Check national inspection reports, 3C certification, and energy labels before buying big-ticket items"]},{"tag":"a","props":{"href":"/en/tip/05-33"},"children":[{"tag":"span","props":{},"children":["33"]},"Bracelets, jade, luxury watches, and collectibles should be judged by “how much you spend” rather than “how much you save”"]},{"tag":"a","props":{"href":"/en/tip/05-34"},"children":[{"tag":"span","props":{},"children":["34"]},"For jewelry and gemstones, only test reports bearing the CMA mark are acceptable; you must also verify the issuing agency on the regulator’s official website"]},{"tag":"a","props":{"href":"/en/tip/05-35"},"children":[{"tag":"span","props":{},"children":["35"]},"Random sales such as blind boxes and gacha games are treated as “money that won’t come back”"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/en/tip/05-36","data-status":"active"},"children":[{"tag":"span","props":{},"children":["36"]},"If you care about what’s in your food, buy pre-packaged products: loose goods at retail counters aren’t legally required to list ingredients"]},{"tag":"a","props":{"href":"/en/tip/05-37"},"children":[{"tag":"span","props":{},"children":["37"]},"Stocks that have lost value should also be sold according to pre‑set rules — don’t try to even out costs by buying more"]},{"tag":"a","props":{"href":"/en/tip/05-38"},"children":[{"tag":"span","props":{},"children":["38"]},"Planning to invest in overseas assets such as U.S. stocks? Use QDII funds or the Hong Kong Stock Connect program — don’t open accounts with foreign brokers, and don’t use your annual foreign exchange quota for buying foreign stocks"]},{"tag":"a","props":{"href":"/en/tip/05-39"},"children":[{"tag":"span","props":{},"children":["39"]},"Only buy insurance for losses your savings can’t cover; use an emergency fund for losses you can afford"]},{"tag":"a","props":{"href":"/en/tip/05-40"},"children":[{"tag":"span","props":{},"children":["40"]},"If someone at home depends on your income, buy term life insurance for the breadwinner first — not for your kids"]},{"tag":"a","props":{"href":"/en/tip/05-41"},"children":[{"tag":"span","props":{},"children":["41"]},"Regretting a personal insurance policy signed for over a year? You can cancel it during the cooling-off period and get most of your premium back"]},{"tag":"a","props":{"href":"/en/tip/05-42"},"children":[{"tag":"span","props":{},"children":["42"]},"Before signing at the bank counter, check whether it’s a deposit or insurance"]},{"tag":"a","props":{"href":"/en/tip/05-43"},"children":[{"tag":"span","props":{},"children":["43"]},"To cancel your insurance policy, contact the insurer directly — don’t use “policy cancellation agents.” If you feel misled, call 12378 for free assistance"]},{"tag":"a","props":{"href":"/en/tip/05-44"},"children":[{"tag":"span","props":{},"children":["44"]},"Writing a specific beneficiary on the policy lets family claim the payout: 5 years for life insurance, 2 years for other policies"]},{"tag":"a","props":{"href":"/en/tip/05-45"},"children":[{"tag":"span","props":{},"children":["45"]},"Do not buy cryptocurrencies such as Bitcoin or Tether, or join others’ investment schemes: trades lack legal protection, and suing will not recover investment losses"]},{"tag":"a","props":{"href":"/en/tip/05-46"},"children":[{"tag":"span","props":{},"children":["46"]},"If you have no employer, pay into China’s employee pension scheme yourself at the lowest contribution tier and first meet the minimum contribution period; even at the lowest tier, it takes about 10 years of pension payments to recover the cost"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"Breadcrumb"},"children":[{"tag":"a","props":{"href":"/en/book"},"children":["Explore the book"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/en/book/05"},"children":["Chapter 5"," ·"," ","Don’t waste money"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"05-36"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["36"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["Evidence"," ","A"]}]},{"tag":"h1","props":{"lang":"en"},"children":["If you care about what’s in your food, buy pre-packaged products: loose goods at retail counters aren’t legally required to list ingredients"]},{"tag":"p","props":{"lang":"en","className":"life-entry-summary"},"children":["The law only mandates ingredient lists for pre-packaged foods; loose goods have no such requirement. For loose products, retailers only need to display the product name, production date, shelf life, and manufacturer details. So, the absence of any mention of additives does not mean they were not added — it simply means the law does not require them to be listed. If you care about what’s in your food, opt for pre-packaged versions where both the full ingredient list and additive details are clearly printed."]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Cost"]},{"tag":"p","props":{},"children":["No cost at all. Pre-packaged versions of the same items ar…"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Benefit"]},{"tag":"p","props":{},"children":["Article 67 of China’s Food Safety Law stipulates that all pre-packaged foods must carry a label containing nin…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"Mark: If you care about what’s in your food, buy pre-packaged products: loose goods at retail counters aren’t legally required to list ingredients"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"Done"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"Plan to do"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"Save"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Share this tip"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Hide details"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Cost"]},{"tag":"p","props":{},"children":["No cost at all. Pre-packaged versions of the same items are usually a bit pricier than loose ones. Checking the ingredient list takes just a few seconds."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Benefit"]},{"tag":"p","props":{},"children":["Article 67 of China’s Food Safety Law stipulates that all pre-packaged foods must carry a label containing nine mandatory pieces of information. The second item on this list is the “list of ingredients or components,” and the seventh item is “the generic names of any food additives used, as defined in national standards.” Article 68 contains far fewer requirements for loose foods: it only requires retailers to display the product name, production date or batch number, shelf life, and the manufacturer’s name, address, and contact details on the packaging or container. There is no mention of ingredient lists or additives here. This distinction is most evident in frozen seafood products. GB 2760—2024 permits the use of phosphoric acid and phosphates as moisture retention agents — commonly referred to as water-retaining agents — in frozen seafood, with a maximum permitted usage level of 5.0 g/kg calculated as phosphate. Use within this limit is fully legal. The main issues arise from excessive usage and the practice of adding ice to increase product weight. Following a 2025 exposé by China Central Television’s 3·15 Gala, which revealed that some shrimp producers illegally added excessive amounts of water-retaining agents (composite phosphates) and added extra ice to boost weight, regulatory authorities mandated that all such products must clearly list water-retaining agents like phosphates, net weight (excluding ice coating weight), and full ingredient lists on their labels (this requirement applies nationwide, per the third 2025 amendment to China’s Food Safety Law, effective 1 December 2025)."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Original sources"]},{"tag":"p","props":{"className":"life-citations"},"children":["全国人大常委会 (2025 年第三次修正). 中华人民共和国食品安全法（第六十七、六十八条，2025 年 9 月 12 日公布，2025 年 12 月 1 日施行）. ",{"tag":"a","props":{"href":"https://flk.npc.gov.cn/detail?id=7b5a76d0461745a08d3f964916b87ef3","target":"_blank","rel":"noopener noreferrer"},"children":["https://flk.npc.gov.cn/detail?id=7b5a76d0461745a08d3f964916b87ef3"]},"；国家卫生健康委员会、国家市场监督管理总局 (2024). 食品安全国家标准 食品添加剂使用标准（GB 2760—2024，附录 A 表 A.1「磷酸及磷酸盐」项下食品分类号 09.02.01 冷冻水产品；A.3 规定表 A.1 列出的食品添加剂按照规定的使用范围和最大使用量使用）. ",{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/202403/content_7001729.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/zhengce/zhengceku/202403/content_7001729.htm"]},"；六安市市场监督管理局 (2025). 关于水产制品及使用保水剂的相关企业提醒告诫函（2025 年 3 月 24 日）. ",{"tag":"a","props":{"href":"https://scjgj.luan.gov.cn/zwzx/tzgg/5414606.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://scjgj.luan.gov.cn/zwzx/tzgg/5414606.html"]}]},{"tag":"a","props":{"href":"https://flk.npc.gov.cn/detail?id=7b5a76d0461745a08d3f964916b87ef3","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Open source link"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Book note"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["The fact that additives are not listed on a product does not mean they were not added — it simply means the law does not require them to be disclosed. If you want to know exactly what a product contains, always choose pre-packaged versions. For frozen shrimp, fish fillets, and similar items, the net weight listed on pre-packaged packaging already excludes ice coating weight; using this figure to calculate unit price gives a much more accurate cost estimate. For loose products priced by weight, the actual edible weight after thawing may drop significantly. Water-retaining agents are legal and not a safety hazard as long as they are used within permitted limits — do not mistake them for toxic substances. Excessive usage and added ice are purely commercial issues: you end up paying a premium price for mostly water content. Conversely, loose goods counters may also fail to display the four mandatory details required by Article 68: product name, production date, shelf life, and manufacturer contact information. Failure to display any of these constitutes a violation of the law. Consumers can choose not to purchase such products or file a complaint via the 12315 hotline. For business owners looking to sell packaged foods, specific labeling requirements are outlined in Section 12, Article 9 of this guide. This item delivers the highest level of benefit to both you and your family."]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["My note"]},{"tag":"button","props":{"type":"button"},"children":["Write a reminder for yourself…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/en/tip/05-35"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Previous"]},"Random sales such as blind boxes and gacha games are treated as “money t