hildren":[{"tag":"div","props":{"className":"life-ad-rail","data-dock-active":"false","style":{"top":"94px"}},"children":[{"tag":"div","props":{"className":"life-ad-dock","hidden":true},"children":[{"tag":"aside","props":{"className":"life-ad-space life-ad-space-sponsored life-ad-space-compact","data-ad-placement":"ad_dock","data-ad-group":"reading","data-ad-creative":"read_product","data-ad-ready":"false","aria-label":"Publicidad · Comunidad recomendada"},"children":[{"tag":"button","props":{"type":"button","className":"life-ad-dismiss","aria-label":"Cerrar anuncio"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-x","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M18 6 6 18"},"children":[]},{"tag":"path","props":{"d":"m6 6 12 12"},"children":[]}]}]},{"tag":"div","props":{"className":"life-ad-space-brand"},"children":[{"tag":"img","props":{"src":"/sites/howtolivebetter/images/shengcai/logo.png","width":"565","height":"144","alt":"Logotipo oficial de Shengcai Youshu","decoding":"async"},"children":[]}]},{"tag":"div","props":{"className":"life-ad-space-copy"},"children":[{"tag":"span","props":{"className":"life-ad-space-label"},"children":["Publicidad · Comunidad recomendada"]},{"tag":"strong","props":{},"children":["¿Podría lo que sabes convertirse en un producto útil?"]},{"tag":"p","props":{},"children":["De libros digitales a herramientas: descubre cómo detectan necesidades y crean algo que otros pueden usar."]}]},{"tag":"div","props":{"className":"life-ad-space-actions"},"children":[{"tag":"a","props":{"className":"life-ad-space-link","href":"/es/shengcaiyoushu?sc_group=reading&sc_creative=read_product&sc_placement=ad_dock"},"children":["Ver la comunidad y ejemplos",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"18","height":"18","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-up-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M7 7h10v10"},"children":[]},{"tag":"path","props":{"d":"M7 17 17 7"},"children":[]}]}]}]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/es/book/05"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"Volver al índice"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["No desperdicies el dinero"]},{"tag":"div","props":{"data-ad-dock-host":"true"},"children":[]},{"tag":"nav","props":{"aria-label":"Consejos del capítulo"},"children":[{"tag":"a","props":{"href":"/es/tip/05-01"},"children":[{"tag":"span","props":{},"children":["01"]},"Desactiva todas las renovaciones automáticas y cambia a renovación manual al vencimiento"]},{"tag":"a","props":{"href":"/es/tip/05-02"},"children":[{"tag":"span","props":{},"children":["02"]},"Cada año, de marzo a junio, se realiza la liquidación del impuesto sobre la renta; hay que rellenar los apartados de deducciones especiales correspondientes"]},{"tag":"a","props":{"href":"/es/tip/05-03"},"children":[{"tag":"span","props":{},"children":["03"]},"El fondo de vivienda no sirve solo para comprar una vivienda: se puede retirar para alquilar, reformar o pagar la cuota de mantenimiento; a partir del 20 de septiembre de 2026 se aplicará el nuevo reglamento"]},{"tag":"a","props":{"href":"/es/tip/05-04"},"children":[{"tag":"span","props":{},"children":["04"]},"Revisar anualmente los planes de móvil y banda ancha: baja el nivel si no los usas; si el operador se niega, presenta una queja"]},{"tag":"a","props":{"href":"/es/tip/05-05"},"children":[{"tag":"span","props":{},"children":["05"]},"No comprar lotería"]},{"tag":"a","props":{"href":"/es/tip/05-06"},"children":[{"tag":"span","props":{},"children":["06"]},"Al ver frases como «altos rendimientos», «capital garantizado» o «ganancias seguras», mejor alejarse de inmediato"]},{"tag":"a","props":{"href":"/es/tip/05-07"},"children":[{"tag":"span","props":{},"children":["07"]},"No realice pagos mínimos con la tarjeta de crédito, ni contrate planes de pago fraccionado o préstamos de consumo; si no le queda más remedio que pedir dinero prestado, calcule primero la tasa de interés anual equivalente antes de comparar"]},{"tag":"a","props":{"href":"/es/tip/05-08"},"children":[{"tag":"span","props":{},"children":["08"]},"No dar propinas a los streamers, no hacer compras dentro de los juegos y no realizar compras impulsivas"]},{"tag":"a","props":{"href":"/es/tip/05-09"},"children":[{"tag":"span","props":{},"children":["09"]},"Si un niño usa el móvil para hacer compras o donaciones, los gastos elevados de niños mayores de 8 años que no cuenten con la autorización de sus padres pueden ser reclamados para su devolución"]},{"tag":"a","props":{"href":"/es/tip/05-10"},"children":[{"tag":"span","props":{},"children":["10"]},"Cómo enseñar a los niños una frase clave: cualquiera que les pida usar el móvil de sus padres para operar o dar el código de verificación es un estafador"]},{"tag":"a","props":{"href":"/es/tip/05-11"},"children":[{"tag":"span","props":{},"children":["11"]},"Rechazar la garantía extendida para productos electrónicos"]},{"tag":"a","props":{"href":"/es/tip/05-12"},"children":[{"tag":"span","props":{},"children":["12"]},"Priorice los medicamentos genéricos que hayan superado la evaluación de equivalencia y los incluidos en los lotes de adquisición centralizada"]},{"tag":"a","props":{"href":"/es/tip/05-13"},"children":[{"tag":"span","props":{},"children":["13"]},"Al vincular a su familia en la app de la medstraховка, el dinero de su cuenta individual de yibao podrá usarse para atender a su cónyuge, padres e hijos"]},{"tag":"a","props":{"href":"/es/tip/05-14"},"children":[{"tag":"span","props":{},"children":["14"]},"Bebe agua del grifo hervida, en vez de pedir garrafas para el dispensador o comprar botellas todo el año"]},{"tag":"a","props":{"href":"/es/tip/05-15"},"children":[{"tag":"span","props":{},"children":["15"]},"Acciones con poca negociación"]},{"tag":"a","props":{"href":"/es/tip/05-16"},"children":[{"tag":"span","props":{},"children":["16"]},"No pedir préstamos para invertir, no usar apalancamiento y no comprar lo que no se entiende"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/es/tip/05-17","data-status":"active"},"children":[{"tag":"span","props":{},"children":["17"]},"Usar fondos indexados de ampla base en lugar de fondos gestionados activamente como base a largo plazo (el dinero que se mantiene invertido sin moverlo)"]},{"tag":"a","props":{"href":"/es/tip/05-18"},"children":[{"tag":"span","props":{},"children":["18"]},"Al elegir fondos similares, priorice los de menor comisión"]},{"tag":"a","props":{"href":"/es/tip/05-19"},"children":[{"tag":"span","props":{},"children":["19"]},"No invierta todo su dinero en una sola acción, plataforma o vivienda"]},{"tag":"a","props":{"href":"/es/tip/05-20"},"children":[{"tag":"span","props":{},"children":["20"]},"Las personas que pagan impuestos y tienen una tasa impositiva del 10 % o superior pueden abrir una cuenta de pensiones individuales; hasta 12 000 yuanes al año pueden deducirse antes de calcular el impuesto. Para quienes no pagan impuestos o tienen una tasa del 3 %, abrir esta cuenta no resulta rentable"]},{"tag":"a","props":{"href":"/es/tip/05-21"},"children":[{"tag":"span","props":{},"children":["21"]},"Pago por sesión o contratos a corto plazo en gimnasios, salvo que se cuente con un historial estable de al menos un año"]},{"tag":"a","props":{"href":"/es/tip/05-22"},"children":[{"tag":"span","props":{},"children":["22"]},"Al pagar un anticipo, hay que firmar un contrato por escrito; si el negocio entra en crisis, debe dejar de cobrar y, antes de cerrar, debe devolver el saldo no consumido"]},{"tag":"a","props":{"href":"/es/tip/05-23"},"children":[{"tag":"span","props":{},"children":["23"]},"Imponer un periodo de reflexión de 24 horas para compras no esenciales de alto valor; aprovechar la política de devolución sin motivo en 7 días para compras online"]},{"tag":"a","props":{"href":"/es/tip/05-24"},"children":[{"tag":"span","props":{},"children":["24"]},"No compres por el «precio tachado» ni durante las promociones"]},{"tag":"a","props":{"href":"/es/tip/05-25"},"children":[{"tag":"span","props":{},"children":["25"]},"Es mejor optar por seguros de tipo consumo y tratar los «reembolsos» y «dividendos» como elementos no garantizados"]},{"tag":"a","props":{"href":"/es/tip/05-26"},"children":[{"tag":"span","props":{},"children":["26"]},"Contrate suficiente seguro de responsabilidad civil: el límite del seguro obligatorio es el mismo en todo el país y no es muy alto; lo que supere deberá pagarlo usted mismo"]},{"tag":"a","props":{"href":"/es/tip/05-27"},"children":[{"tag":"span","props":{},"children":["27"]},"Guarde una reserva de emergencia equivalente a 3 a 6 meses de gastos, en un lugar donde pueda retirarla en cualquier momento"]},{"tag":"a","props":{"href":"/es/tip/05-28"},"children":[{"tag":"span","props":{},"children":["28"]},"Antes de amortizar la hipoteca, haga una comparación numérica en lugar de guiarse por la intuición"]},{"tag":"a","props":{"href":"/es/tip/05-29"},"children":[{"tag":"span","props":{},"children":["29"]},"Al comprar online, hay que atenerse a las reglas y leyes de la plataforma, no a los presentadores ni a las «reseñas positivas»"]},{"tag":"a","props":{"href":"/es/tip/05-30"},"children":[{"tag":"span","props":{},"children":["30"]},"Si algo comprado en una transmisión en vivo sale mal, primero pida a la plataforma la información del vendedor y del influencer; la plataforma está obligada a proporcionarla"]},{"tag":"a","props":{"href":"/es/tip/05-31"},"children":[{"tag":"span","props":{},"children":["31"]},"Al comprar alimentos inseguros, además de obtener el reembolso, puede reclamar diez veces el precio pagado; si el monto resultante es inferior a 1.000 yuanes, se considerará 1.000 yuanes"]},{"tag":"a","props":{"href":"/es/tip/05-32"},"children":[{"tag":"span","props":{},"children":["32"]},"Antes de comprar artículos grandes, consulte los informes de inspección estatal, la certificación 3C y las etiquetas de eficiencia energética"]},{"tag":"a","props":{"href":"/es/tip/05-33"},"children":[{"tag":"span","props":{},"children":["33"]},"Los brazaletes, piedras preciosas, relojes de lujo y figuras de colección se deben valorar según el dinero que se gasta, no según el dinero que se ahorra"]},{"tag":"a","props":{"href":"/es/tip/05-34"},"children":[{"tag":"span","props":{},"children":["34"]},"Para joyas y piedras preciosas solo se aceptan informes de pruebas con el sello CMA; además, hay que comprobar en la web del organismo emisor si dicha entidad está autorizada"]},{"tag":"a","props":{"href":"/es/tip/05-35"},"children":[{"tag":"span","props":{},"children":["35"]},"Las ventas aleatorias como las cajas sorpresa o los sorteos se rigen por el principio de que «ese dinero no se recupera»"]},{"tag":"a","props":{"href":"/es/tip/05-36"},"children":[{"tag":"span","props":{},"children":["36"]},"Si le importa lo que llevan los alimentos, compre productos preenvasados: por ley no se exige incluir la lista de ingredientes en los productos a granel"]},{"tag":"a","props":{"href":"/es/tip/05-37"},"children":[{"tag":"span","props":{},"children":["37"]},"Hay que vender las acciones que han perdido dinero siguiendo reglas previamente establecidas, sin intentar recuperar la inversión mediante compras adicionales para bajar el coste medio"]},{"tag":"a","props":{"href":"/es/tip/05-38"},"children":[{"tag":"span","props":{},"children":["38"]},"Si desea invertir en activos extranjeros como acciones estadounidenses, opte por fondos QDII o el programa Stock Connect de Hong Kong; no abra cuentas en corredores extranjeros ni utilice su cuota anual de cambio para comprar acciones"]},{"tag":"a","props":{"href":"/es/tip/05-39"},"children":[{"tag":"span","props":{},"children":["39"]},"Solo contrata seguros para pérdidas que tu familia no podría asumir; para las demás, usa un fondo de emergencia"]},{"tag":"a","props":{"href":"/es/tip/05-40"},"children":[{"tag":"span","props":{},"children":["40"]},"Si hay alguien en casa que depende de tus ingresos, compra primero un seguro de vida a término para quien gana el dinero, no para los niños"]},{"tag":"a","props":{"href":"/es/tip/05-41"},"children":[{"tag":"span","props":{},"children":["41"]},"Si te arrepientes de haber contratado un seguro de vida por más de un año y lo cancelas durante el período de reflexión, casi todo el importe pagado te será devuelto"]},{"tag":"a","props":{"href":"/es/tip/05-42"},"children":[{"tag":"span","props":{},"children":["42"]},"Antes de firmar en la ventanilla del banco, compruebe si lo que tiene en la mano es un depósito o un seguro"]},{"tag":"a","props":{"href":"/es/tip/05-43"},"children":[{"tag":"span","props":{},"children":["43"]},"Para cancelar un seguro, acuda usted mismo a la compañía aseguradora; no recurra a «agentes de cancelación». Si cree que ha sido engañado, llame al 12378 para presentar una queja"]},{"tag":"a","props":{"href":"/es/tip/05-44"},"children":[{"tag":"span","props":{},"children":["44"]},"Si en la póliza se indica un beneficiario concreto, recuerde reclamar el dinero tras un siniestro: para seguros de vida, el plazo es de 5 años; para otros seguros, de 2 años"]},{"tag":"a","props":{"href":"/es/tip/05-45"},"children":[{"tag":"span","props":{},"children":["45"]},"No gastes dinero en Bitcoin, Tether u otras criptomonedas ni sigas a quien te invite a invertir: las operaciones no tienen protección legal y una demanda no recupera las pérdidas"]},{"tag":"a","props":{"href":"/es/tip/05-46"},"children":[{"tag":"span","props":{},"children":["46"]},"Si no tienes empleador y pagas por tu cuenta el seguro de pensiones de empleados, lo más rentable es cotizar en el nivel mínimo y completar primero los años exigidos; no recuperas lo pagado de inmediato: incluso en el nivel mínimo necesitas cobrar unos 10 años"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"Ruta de navegación"},"children":[{"tag":"a","props":{"href":"/es/book"},"children":["Libro"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/es/book/05"},"children":["Capítulo 5"," ·"," ","No desperdicies el dinero"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"05-17"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["17"]},{"tag":"span","props":{"className":"life-evidence grade-b"},"children":["Evidencia"," ","B"]}]},{"tag":"h1","props":{"lang":"es"},"children":["Usar fondos indexados de ampla base en lugar de fondos gestionados activamente como base a largo plazo (el dinero que se mantiene invertido sin moverlo)"]},{"tag":"p","props":{"lang":"es","className":"life-entry-summary"},"children":["El conjunto de acciones que compran los fondos gestionados activamente ya se acerca mucho al mercado en su totalidad. Pero la comisión de gestión adicional que cobran se resta directamente de tus ganancias netas. Si se recalculan una y otra vez los resultados de los fondos como si fueran fruto del azar, muy pocos logran generar ganancias suficientes para cubrir esos costos extra."]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Coste"]},{"tag":"p","props":{},"children":["No cuesta nada. El precio a pagar es renunciar a la posibi…"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Beneficio"]},{"tag":"p","props":{},"children":["El conjunto de fondos de acciones estadounidenses gestionados activamente se asemeja al portafolio del mercado…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"Marcar: Usar fondos indexados de ampla base en lugar de fondos gestionados activamente como base a largo plazo (el dinero que se mantiene invertido sin moverlo)"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"Hecho"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"Por hacer"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"Guardar"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Compartir consejo"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Ocultar detalles"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Coste"]},{"tag":"p","props":{},"children":["No cuesta nada. El precio a pagar es renunciar a la posibilidad de elegir a un gestor de fondos estrella. Lo difícil es que, cuando el índice baja, también debes soportar esa caída sin poder retirarte a mitad del camino."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Beneficio"]},{"tag":"p","props":{},"children":["El conjunto de fondos de acciones estadounidenses gestionados activamente se asemeja al portafolio del mercado: las acciones que poseen en conjunto son prácticamente las mismas que componen el mercado entero. No obstante, los altos costos de la gestión activa se traducen directamente en menores retornos netos para los inversores (ganancias después de deducir las comisiones). Un estudio aplicó el método bootstrap para reordenar aleatoriamente los resultados y determinar hasta dónde podría llegar el azar. Los resultados indican que muy pocos fondos logran generar ganancias extra suficientes para compensar sus costos: la ventaja que obtienen sobre el mercado no alcanza para cubrir las comisiones que cobran (Estados Unidos, publicado en 2010). S&P Dow Jones Index realiza este cálculo anualmente: en 2024, el 65 % de los fondos de acciones de gran capitalización gestionados activamente en EE. UU. obtuvieron peores resultados que el S&P 500. En los últimos 24 años, el promedio anual de fondos que quedaron por debajo del índice fue del 64 %. En los últimos 15 años, hasta finales de 2024, en ninguna categoría la mayoría de los fondos gestionados activamente superaron al índice."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Fuentes originales"]},{"tag":"p","props":{"className":"life-citations"},"children":["Fama EF, French KR (2010). Luck versus Skill in the Cross-Section of Mutual Fund Returns. The Journal of Finance 65(5):1915-1947. ",{"tag":"a","props":{"href":"https://doi.org/10.1111/j.1540-6261.2010.01598.x","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1111/j.1540-6261.2010.01598.x"]},"；S&P Dow Jones Indices (2025). SPIVA U.S. Scorecard Year-End 2024. ",{"tag":"a","props":{"href":"https://www.spglobal.com/spdji/en/spiva/article/spiva-us/","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.spglobal.com/spdji/en/spiva/article/spiva-us/"]},"（官网拒绝自动抓取，数字按 2025-05-12 的存档核对：",{"tag":"a","props":{"href":"https://web.archive.org/web/20250512071051/https://www.spglobal.com/spdji/en/spiva/article/spiva-us/","target":"_blank","rel":"noopener noreferrer"},"children":["https://web.archive.org/web/20250512071051/https://www.spglobal.com/spdji/en/spiva/article/spiva-us/"]},"）；S&P Dow Jones Indices (2025). SPIVA Asia Ex-Japan Scorecard Mid-Year 2025（Report 1a，China Large-Cap 对 S&P China A 300 的跑输比例：1 年 60.5%、3 年 69.6%、5 年 50.8%）. ",{"tag":"a","props":{"href":"https://web.archive.org/web/20251103165922/https://www.spglobal.com/spdji/en/documents/spiva/spiva-asia-ex-japan-mid-year-2025.pdf","target":"_blank","rel":"noopener noreferrer"},"children":["https://web.archive.org/web/20251103165922/https://www.spglobal.com/spdji/en/documents/spiva/spiva-asia-ex-japan-mid-year-2025.pdf"]},"（官网拒绝自动抓取，按存档核对）；Harvey CR, Liu Y (2022). Luck versus Skill in the Cross Section of Mutual Fund Returns: Reexamining the Evidence. The Journal of Finance, 77(3). ",{"tag":"a","props":{"href":"https://doi.org/10.1111/jofi.13123","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1111/jofi.13123"]},"（争议方）"]},{"tag":"a","props":{"href":"https://doi.org/10.1111/j.1540-6261.2010.01598.x","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Abrir fuente"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Nota del autor"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["Controversia: un artículo ha reexaminado esta conclusión. Señala que el método de prueba de Fama-French, basado en el remuestreo repetido, no es lo suficientemente exhaustivo. Según su algoritmo, incluso si la parte de ganancias adicionales de un fondo es claramente evidente, podría ser clasificada como «indistinguible de la suerte». Por lo tanto, la conclusión de que «casi ningún fondo posee habilidades» podría ser demasiado severa. Las cifras de China no son tan unilaterales como las de Estados Unidos. Según las estadísticas de S&P Dow Jones hasta 2025 de 6, la proporción de fondos activos del mercado principal de acciones A que han tenido un rendimiento inferior al índice S&P China A 300, en 1, fue del 60.5%, en 3, del 69.6%, y en 5, del 50.8%. Estas estadísticas solo llegan hasta el año 5 y no disponen de datos de un periodo más largo. Por lo tanto, en China, aún no hay una conclusión definitiva sobre si los fondos activos no logran superar al índice a largo plazo, pero el hecho de que las comisiones de los fondos indexados sean más bajas sigue siendo cierto. Esto no constituye un consejo de inversión."]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Mi nota"]},{"tag":"button","props":{"type":"button"},"children":["Escribe un recordatorio…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/es/tip/05-16"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Anterior"]},"No pedir préstamos para invertir, no usar apalancamiento y no comprar lo que no se entiende"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/es/tip/05-18"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Siguiente"]},"Al elegir fondos similares, priorice los de menor comisión"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["Más en este tema"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/es/tip/05-13"},"children":[{"tag":"strong","props":{},"children":["Al vincular a su familia en la app de la 