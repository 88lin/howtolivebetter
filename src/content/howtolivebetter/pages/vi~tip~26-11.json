"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Chia sẻ mẹo này"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Ẩn chi tiết"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Chi phí"]},{"tag":"p","props":{},"children":["Máy chủ ảo của các nhà cung cấp dịch vụ đám mây lớn, mỗi tháng từ vài trăm đến vài nghìn tệ. VPS của nhà cung cấp nhỏ, mỗi tháng bắt đầu từ mấy chục tệ. VPS là một máy chủ ảo nhỏ. Thuê chỗ đặt máy chủ riêng thì mỗi năm bắt đầu từ vài nghìn tệ, và phần cứng phải tự mua."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Lợi ích"]},{"tag":"p","props":{},"children":["Ba bậc không khác nhau ở giá, mà khác nhau ở chỗ ngày xảy ra sự cố thì trong tay bạn có cái gì. Các nhà cung cấp dịch vụ đám mây lớn có kênh đăng ký khai báo, tư cách được công khai, có sự cố thì có thông báo, trong hợp đồng có điều khoản bồi thường, xảy ra chuyện thì tìm được người. Giá của nhà cung cấp nhỏ có thể thấp hơn một nửa, nhưng khi nó bán vượt sức chứa, bỏ trốn, hoặc bị phía trên chặn thì bạn không có đối tượng khiếu nại, nên trước khi bàn giá hãy tra hệ thống của Bộ Công nghiệp và Thông tin xem nó đã có giấy phép kinh doanh dịch vụ viễn thông giá trị gia tăng chưa. Thuê chỗ đặt máy chủ riêng chỉ đáng tiền khi cả hai điều kiện cùng đúng: băng thông hoặc chi phí phần cứng rẻ hơn hẳn, và bạn có người của mình trực vận hành. Cách chọn: trang web tĩnh không có dữ liệu người dùng thì VPS rẻ nhất là đủ. Trang web có đăng ký người dùng và giao dịch thì chọn máy chủ ảo co giãn theo nhu cầu và có ảnh chụp dự phòng, dữ liệu dự phòng để ở ít nhất hai chỗ."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Nguồn gốc"]},{"tag":"p","props":{"className":"life-citations"},"children":["作者经验，无直接文献；服务商资质与备案的法定要求见本节第 4 条，日志留存 6 个月和等级保护义务见第 11 节第 16 条"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Ghi chú sách"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["Phần trên là phán đoán từ kinh nghiệm, không có bằng chứng từ tài liệu. Chỉ có một việc kiểm chứng được thật sự: giấy phép của nhà cung cấp. Muốn tiết kiệm thì tiết kiệm ở cấu hình và băng thông, đừng tiết kiệm ở tư cách pháp lý"]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Ghi chú của tôi"]},{"tag":"button","props":{"type":"button"},"children":["Viết một lời nhắc cho chính bạn…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className"