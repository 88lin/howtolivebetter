{"tag":"div","props":{"className":"life-ad-rail","data-dock-active":"false","style":{"top":"94px"}},"children":[{"tag":"div","props":{"className":"life-ad-dock","hidden":true},"children":[{"tag":"aside","props":{"className":"life-ad-space life-ad-space-sponsored life-ad-space-compact","data-ad-placement":"ad_dock","data-ad-group":"reading","data-ad-creative":"read_product","data-ad-ready":"false","aria-label":"Quảng cáo · Giới thiệu cộng đồng"},"children":[{"tag":"button","props":{"type":"button","className":"life-ad-dismiss","aria-label":"Đóng quảng cáo"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-x","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M18 6 6 18"},"children":[]},{"tag":"path","props":{"d":"m6 6 12 12"},"children":[]}]}]},{"tag":"div","props":{"className":"life-ad-space-brand"},"children":[{"tag":"img","props":{"src":"/sites/howtolivebetter/images/shengcai/logo.png","width":"565","height":"144","alt":"Logo chính thức của Shengcai Youshu","decoding":"async"},"children":[]}]},{"tag":"div","props":{"className":"life-ad-space-copy"},"children":[{"tag":"span","props":{"className":"life-ad-space-label"},"children":["Quảng cáo · Giới thiệu cộng đồng"]},{"tag":"strong","props":{},"children":["Kiến thức bạn có thể thành sản phẩm hữu ích không?"]},{"tag":"p","props":{},"children":["Từ sách điện tử đến công cụ nhỏ: xem cách thành viên tìm nhu cầu và biến kiến thức thành thứ dùng được."]}]},{"tag":"div","props":{"className":"life-ad-space-actions"},"children":[{"tag":"a","props":{"className":"life-ad-space-link","href":"/vi/shengcaiyoushu?sc_group=reading&sc_creative=read_product&sc_placement=ad_dock"},"children":["Xem cộng đồng và các ví dụ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"18","height":"18","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-up-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M7 7h10v10"},"children":[]},{"tag":"path","props":{"d":"M7 17 17 7"},"children":[]}]}]}]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/vi/book/13"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"Quay lại mục lục"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["Tình huống khẩn cấp: làm gì trước"]},{"tag":"div","props":{"data-ad-dock-host":"true"},"children":[]},{"tag":"nav","props":{"aria-label":"Các mục trong chương"},"children":[{"tag":"a","props":{"href":"/vi/tip/13-01"},"children":[{"tag":"span","props":{},"children":["01"]},"Người ngã xuống đất không thở: ấn thật mạnh vào giữa ngực ngay, bảo người bên cạnh gọi 120 và tìm máy AED"]},{"tag":"a","props":{"href":"/vi/tip/13-02"},"children":[{"tag":"span","props":{},"children":["02"]},"Người cao tuổi ngã hoặc ai đó nằm gục: ngồi xuống gọi họ, gọi 120 ở Trung Quốc, đừng vội đỡ dậy; với người lạ, bỏ đi ở Trung Quốc cũng hợp pháp, đã dừng thì đừng tự di chuyển họ"]},{"tag":"a","props":{"href":"/vi/tip/13-03"},"children":[{"tag":"span","props":{},"children":["03"]},"Miệng lệch, một bên tay không có lực, nói không rõ: gọi 120 ngay, đừng chờ, đừng tự lái xe đi"]},{"tag":"a","props":{"href":"/vi/tip/13-04"},"children":[{"tag":"span","props":{},"children":["04"]},"Chóng mặt xoay tròn không đứng vững, nhìn thấy hai hình, một mắt tối đi, hoặc chỉ tay không trúng mũi mình: vẫn coi như đột quỵ và gọi 120"]},{"tag":"a","props":{"href":"/vi/tip/13-05"},"children":[{"tag":"span","props":{},"children":["05"]},"Một mắt tối đi đột ngột như kéo xuống rèm, dù chỉ vài phút rồi tự hết thì vẫn đi cấp cứu ngay trong ngày theo đường đột quỵ"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/vi/tip/13-06","data-status":"active"},"children":[{"tag":"span","props":{},"children":["06"]},"Một mắt sưng đau, đỏ, nhìn đèn thấy một vòng cầu vồng, kèm đau đầu buồn nôn, nôn ói: đi cấp cứu mắt trong ngày"]},{"tag":"a","props":{"href":"/vi/tip/13-07"},"children":[{"tag":"span","props":{},"children":["07"]},"Đau tức ngực kiểu bóp nghẽn, khó thở, cứng ngực quá 15 phút không dịu: gọi 120, đừng chịu đựng và đừng tự lái xe"]},{"tag":"a","props":{"href":"/vi/tip/13-08"},"children":[{"tag":"span","props":{},"children":["08"]},"Đau dữ dội như bị xé toạc, lan từ ngực ra sau lưng và xuống thắt lưng: gọi 120 và nói rõ「cơn đau đang di chuyển」"]},{"tag":"a","props":{"href":"/vi/tip/13-09"},"children":[{"tag":"span","props":{},"children":["09"]},"Đột nhiên một cơn「đau đầu nặng nhất đời», trong vòng một giờ đã tới lúc đau nhất: đi cấp cứu ngay để chụp CT sọ"]},{"tag":"a","props":{"href":"/vi/tip/13-10"},"children":[{"tag":"span","props":{},"children":["10"]},"Người cao tuổi va đầu rồi hai ba tuần đến vài tháng sau mà đi loạng, uể oải, ngủ gật hoặc một bên không có lực: đi chụp CT sọ"]},{"tag":"a","props":{"href":"/vi/tip/13-11"},"children":[{"tag":"span","props":{},"children":["11"]},"Một chân sưng, căng, ấn vào thì đau: đi khám càng sớm càng tốt; thêm khó thở đột ngột hoặc đau ngực thì gọi 120 ngay"]},{"tag":"a","props":{"href":"/vi/tip/13-12"},"children":[{"tag":"span","props":{},"children":["12"]},"Máu chảy nhiều: dùng tay ấn thật chặt vào vết thương, tứ chi ấn không được thì dùng gar, đồng thời gọi 120"]},{"tag":"a","props":{"href":"/vi/tip/13-13"},"children":[{"tag":"span","props":{},"children":["13"]},"Bị chó, mèo cắn hoặc cào rách da: xịt xen kẽ nước xà phòng và nước chảy trong 15 phút, trong ngày đi tiêm vắc-xin"]},{"tag":"a","props":{"href":"/vi/tip/13-14"},"children":[{"tag":"span","props":{},"children":["14"]},"Bị bỏng: xả ngay bằng nước mát chảy trong 20 phút, đừng bôi kem đánh răng hay nước tương"]},{"tag":"a","props":{"href":"/vi/tip/13-15"},"children":[{"tag":"span","props":{},"children":["15"]},"Nổi mề đay toàn thân, khó thở hoặc choáng váng: xử lý như sốc phản vệ, gọi 120 ngay và nói rõ chuyện gì"]},{"tag":"a","props":{"href":"/vi/tip/13-16"},"children":[{"tag":"span","props":{},"children":["16"]},"Người ta co giật rồi ngã xuống: dọn chỗ xung quanh, cho nằm nghiêng, nhìn đồng hồ đếm thời gian, không đưa gì vào miệng"]},{"tag":"a","props":{"href":"/vi/tip/13-17"},"children":[{"tag":"span","props":{},"children":["17"]},"Người bị tiểu đường đột nhiên run, đổ mồ hôi lạnh, nói không rõ: cho 15 gram đường trước, 15 phút sau đo lại"]},{"tag":"a","props":{"href":"/vi/tip/13-18"},"children":[{"tag":"span","props":{},"children":["18"]},"Người ta bị điện giật: cắt điện trước, rồi dùng gậy khô hay thứ gì tương tự gạp nguồn điện ra, tuyệt đối không kéo bằng tay"]},{"tag":"a","props":{"href":"/vi/tip/13-19"},"children":[{"tag":"span","props":{},"children":["19"]},"Báo động carbon monoxide kêu, hoặc cả nhà cùng đau đầu buồn nôn: ra ngoài trước rồi mới gọi"]},{"tag":"a","props":{"href":"/vi/tip/13-20"},"children":[{"tag":"span","props":{},"children":["20"]},"Uống nhầm chất tẩy rửa, thuốc trừ sâu, thuốc: đừng gây nôn, cầm theo chai vào viện ngay; dính vào mắt hoặc da thì xịt nhiều nước sạch ít nhất 15 phút"]},{"tag":"a","props":{"href":"/vi/tip/13-21"},"children":[{"tag":"span","props":{},"children":["21"]},"Hóa chất axít, bazơ bắn vào người: cởi ngay quần áo bị nhiễm, xịt nhiều nước sạch chảy, mắt thì kéo mí mắt ra xịt, xịt đủ thời gian rồi hãy đi"]},{"tag":"a","props":{"href":"/vi/tip/13-22"},"children":[{"tag":"span","props":{},"children":["22"]},"Chóng mặt, buồn nôn, không ra mồ hôi hoặc không tỉnh khi trời nóng: chuyển ngay ra chỗ mát, cởi áo quần xả nước để hạ nhiệt; người không tỉnh thì không cho uống nước, gọi 120"]},{"tag":"a","props":{"href":"/vi/tip/13-23"},"children":[{"tag":"span","props":{},"children":["23"]},"Người bị say nắng mà còn tỉnh: uống nhiều lần mỗi lần ít, nước muối loãng mát hoặc nước thể thao; đừng uống hùng hục, đừng uống rượu và đồ uống nhiều đường"]},{"tag":"a","props":{"href":"/vi/tip/13-24"},"children":[{"tag":"span","props":{},"children":["24"]},"Khi hoảng hoạt: bò sát đất, sờ cửa rồi mới mở, cửa nóng thì đừng mở, đi cầu thang chứ đừng đi thang máy, ra ngoài rồi đừng quay lại"]},{"tag":"a","props":{"href":"/vi/tip/13-25"},"children":[{"tag":"span","props":{},"children":["25"]},"Thấy có người đuối nước: gọi người và gọi 110/120, đưa gậy, thả vật nổi, bản thân đừng xuống nước"]},{"tag":"a","props":{"href":"/vi/tip/13-26"},"children":[{"tag":"span","props":{},"children":["26"]},"Người bị hóc không nói được: trên 1 tuổi thì đứng phía sau, vỗ lưng 5 lần rồi ép bụng 5 lần; ngã xuống thì hồi sức tim phổi"]},{"tag":"a","props":{"href":"/vi/tip/13-27"},"children":[{"tag":"span","props":{},"children":["27"]},"Lạc đường hoặc xe hỏng ở sa mạc Gobi, sa mạc, vùng không người ở: ở lại tại chỗ hoặc cạnh xe, báo vị trí trước, rồi tìm bóng mát và giữ ấm, tiết kiệm nước, đừng đi lang thang"]},{"tag":"a","props":{"href":"/vi/tip/13-28"},"children":[{"tag":"span","props":{},"children":["28"]},"Run, nói không rõ, đi lảo đảo là thân nhiệt tụt: thay quần áo ướt, quấn lại, làm ấm thân trước, uống đồ uống nóng có đường, không uống rượu"]},{"tag":"a","props":{"href":"/vi/tip/13-29"},"children":[{"tag":"span","props":{},"children":["29"]},"Bị rắn cắn: ngồi yên, tháo nhẫn và đồng hồ, đưa đi bệnh viện tiêm huyết thanh kháng nọc càng nhanh càng tốt; không rạch, không hút, không buộc chặt"]},{"tag":"a","props":{"href":"/vi/tip/13-30"},"children":[{"tag":"span","props":{},"children":["30"]},"Khi động đất, trước hết xem mình đang ở trong loại nhà nào: nhà xây đúng tiêu chuẩn chống chấn thì nằm tại chỗ, nhà cũ có thể sập và cửa cách vài bước thì ra ngoài"]},{"tag":"a","props":{"href":"/vi/tip/13-31"},"children":[{"tag":"span","props":{},"children":["31"]},"Gặp gấu, lợn rừng, đàn chó hoang thì đừng chạy, nghiêng người chậm rãi lùi ra"]},{"tag":"a","props":{"href":"/vi/tip/13-32"},"children":[{"tag":"span","props":{},"children":["32"]},"Gặp giông ngoài hoang dã: chui vào xe có nóc cứng hoặc vào công trình, tránh đường sống lưng, cây đứng một mình, mặt nước và kim loại"]},{"tag":"a","props":{"href":"/vi/tip/13-33"},"children":[{"tag":"span","props":{},"children":["33"]},"Lên cao nguyên thì tăng dần theo độ cao ngủ (đêm đó ngủ ở cao bao nhiêu); triệu chứng nặng thì hạ xuống, đừng gắng chịu"]},{"tag":"a","props":{"href":"/vi/tip/13-34"},"children":[{"tag":"span","props":{},"children":["34"]},"Bị ve cắn: dùng nhíp mỏm nhọn áp sát da rồi kéo ra thật đều, đừng bôi dầu, đừng đốt bằng lửa"]},{"tag":"a","props":{"href":"/vi/tip/13-35"},"children":[{"tag":"span","props":{},"children":["35"]},"Nước ngoài hoang dã thì cứ đun sôi rồi uống, sôi thêm một phút là đủ, không cần nấu lâu hơn vì ở cao"]},{"tag":"a","props":{"href":"/vi/tip/13-36"},"children":[{"tag":"span","props":{},"children":["36"]},"Bị người lạ đòi tiền ngoài hoang đương: đưa tiền cho họ, không ra tay, ghi nhớ đặc điểm, thoát ra thì báo công an"]},{"tag":"a","props":{"href":"/vi/tip/13-37"},"children":[{"tag":"span","props":{},"children":["37"]},"Gặp một nhóm đánh nhau: lùi ra rồi bỏ đi, đừng vào rách, đừng đứng xem, đừng nhặt đồ nằm trên mặt đất; nếu báo công an thì lùi tới khoảng cách an toàn rồi gọi 110"]},{"tag":"a","props":{"href":"/vi/tip/13-38"},"children":[{"tag":"span","props":{},"children":["38"]},"Có thể đã bị phơi nhiễm HIV: trong 72 giờ đi lấy thuốc ngăn chặn, càng sớm càng tốt"]},{"tag":"a","props":{"href":"/vi/tip/13-39"},"children":[{"tag":"span","props":{},"children":["39"]},"Cứu người mà bị thương, mất tiền: tìm người gây hại và bảo hiểm y tế trước, rồi đi khai báo hành động dũng cảm để được xác nhận"]},{"tag":"a","props":{"href":"/vi/tip/13-40"},"children":[{"tag":"span","props":{},"children":["40"]},"Dao, thép, kính đâm vào người: ấn cầm máu quanh vật lạ, đừng rút nó ra"]},{"tag":"a","props":{"href":"/vi/tip/13-41"},"children":[{"tag":"span","props":{},"children":["41"]},"Nghi gãy xương thì đừng cử động chỗ đó nữa, đỡ cho yên, chườm lạnh không quá 20 phút, đừng tự bẻ lại"]},{"tag":"a","props":{"href":"/vi/tip/13-42"},"children":[{"tag":"span","props":{},"children":["42"]},"Sau khi bị cưỡng ép tình dục: tới nơi an toàn rồi gọi 110; trước khi khám lạm dụng thì đừng tắm, đừng giặt quần áo, đừng dọn phòng, trong 72 giờ hãy tới bệnh viện"]},{"tag":"a","props":{"href":"/vi/tip/13-43"},"children":[{"tag":"span","props":{},"children":["43"]},"Trẻ sơ sinh dưới 1 tuổi bị nghẽn khóc không ra tiếng: úp sấp xuống vỗ lưng 5 cái, lật lại ấn ngực 5 cái, làm xen kẽ, đừng ấn bụng"]},{"tag":"a","props":{"href":"/vi/tip/13-44"},"children":[{"tag":"span","props":{},"children":["44"]},"Trẻ sơ sinh dưới 1 tuổi không phản ứng, thở không bình thường: bật loa ngoài gọi 120, làm hồi sinh tim phổi trẻ sơ sinh: ấn 30 cái thổi 2 hơi"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"Breadcrumbs"},"children":[{"tag":"a","props":{"href":"/vi/book"},"children":["Khám phá cuốn sách"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/vi/book/13"},"children":["Chương 13"," ·"," ","Tình huống khẩn cấp: làm gì trước"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"13-06"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["06"]},{"tag":"span","props":{"className":"life-evidence grade-b"},"children":["Bằng chứng"," ","B"]}]},{"tag":"h1","props":{"lang":"vi"},"children":["Một mắt sưng đau, đỏ, nhìn đèn thấy một vòng cầu vồng, kèm đau đầu buồn nôn, nôn ói: đi cấp cứu mắt trong ngày"]},{"tag":"p","props":{"lang":"vi","className":"life-entry-summary"},"children":["Đây là cơn glô-cô-mơ phát cấp. Dịch nước trong mắt không thoát ra được, nhãn áp bị đẩy lên đột ngột. Kéo dài bao lâu thì dây thần kinh thị giác bị tổn thương nặng dần, tổn thương rồi thì không hồi lại được. Người bệnh trong thời gian phong tỏa ở Vũ Hán phải chờ trung bị 241 giờ mới được điều trị, tỷ lệ mù là 21.87%. Năm sau cùng kỳ không phong tỏa, chờ trung bị 121 giờ, tỷ lệ mù là 7.84%."]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Chi phí"]},{"tag":"p","props":{},"children":["Không tốn tiền. Cấp cứu mắt đo nhãn áp và soi tiền đồ chiế…"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Lợi ích"]},{"tag":"p","props":{},"children":["Một bệnh viện mắt ở Vũ Hán so hai giai đoạn bệnh nhân glô-cô-mơ góc đóng nguyên phát cấp. Trong 76 ngày phong…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"Đánh dấu: Một mắt sưng đau, đỏ, nhìn đèn thấy một vòng cầu vồng, kèm đau đầu buồn nôn, nôn ói: đi cấp cứu mắt trong ngày"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"Hoàn tất"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"Kế hoạch thực hiện"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"Lưu"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Chia sẻ mẹo này"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Ẩn chi tiết"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Chi phí"]},{"tag":"p","props":{},"children":["Không tốn tiền. Cấp cứu mắt đo nhãn áp và soi tiền đồ chiếm nửa ngày."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Lợi ích"]},{"tag":"p","props":{},"children":["Một bệnh viện mắt ở Vũ Hán so hai giai đoạn bệnh nhân glô-cô-mơ góc đóng nguyên phát cấp. Trong 76 ngày phong tỏa năm 2020 có 54 người, 64 mắt; cùng kỳ năm 2021 có 46 người, 51 mắt; đặc điểm dân số hai nhóm tương đương. Từ lúc xuất hiện triệu chứng đến lúc được điều trị, nhóm phong tỏa là 241.84±211.95 giờ, nhóm đối chứng là 121.53±96.12 giờ (P=0.001). Nhãn áp lúc đến khám là 52.63±12.45 mmHg so với 45.16±9.79 mmHg (P=0.001). Tỷ lệ mù là 21.87% so với 7.84%. Tổn thương dây thần kinh thị giác do glô-cô-mơ gặp ở 20/64 mắt (31.25%) so với 7/51 mắt (13.73%) (P=0.03). Một bệnh viện ở Hàn Quốc rà lại 50 con mắt từng lên cơn một lần rồi sau đó bị lấy thủy tinh thể. Sau một năm, 25 con mắt (50%) còn lại tổn khuyết thị trường ở các mức độ khác nhau. Khoảng thời gian từ lúc có triệu chứng đến lúc hạ được nhãn áp càng dài thì khả năng để lại tổn khuyết càng lớn (P=0.005). Một nghiên cứu tiền cứu khác cho 43 người có tiền đồ nông nằm sấp trong phòng tối 1 giờ. Nhãn áp ở cả hai mắt đều tăng rõ rệt (P<0.01). Ở con mắt chủ yếu dùng hằng ngày, mức tăng trung vị là 3.60 mmHg, con mắt còn lại tăng 2.70 mmHg (P<0.05)"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Nguồn gốc"]},{"tag":"p","props":{"className":"life-citations"},"children":["Zhou L, Wu S, Wang Y, Bao X, Peng T, Luo W, Ortega-Usobiaga J (2022). Clinical presentation of acute primary angle closure during the COVID-19 epidemic lockdown. Frontiers in Medicine, 9, 1078237. ",{"tag":"a","props":{"href":"https://doi.org/10.3389/fmed.2022.1078237","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.3389/fmed.2022.1078237"]}," ; Sung MS, Kim HJ, Park SW (2023). Predictors of long-term visual field outcome after an episode of acute primary angle closure. Clinical & Experimental Ophthalmology, 51(4), 291-299. ",{"tag":"a","props":{"href":"https://doi.org/10.1111/ceo.14206","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1111/ceo.14206"]}," ; Wang J, Wang J, Ng TK, Huang C (2025). Asymmetric intraocular pressure changes in dominant and contralateral eyes: the dark room prone provocative test. Seminars in Ophthalmology, 40(4), 325-331. ",{"tag":"a","props":{"href":"https://doi.org/10.1080/08820538.2024.2443972","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1080/08820538.2024.2443972"]}]},{"tag":"a","props":{"href":"https://doi.org/10.3389/fmed.2022.1078237","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Liên kết mở nguồn"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Ghi chú sách"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["Có hai lý do để ở mức B. Một là hai nhóm ở Vũ Hán được so bằng cách đọc lại hồ sơ bệnh cũ, bản thân việc phong tỏa còn tạo ra những khác biệt khác, không tách được khỏi yếu tố「kéo dài」. Hai là nhóm ở Hàn Quốc chỉ có 50 con mắt, cũng là nghiên cứu hồi cứu. Yếu tố kích thích không phải là nhìn màn hình, mà là hai việc chồng lên nhau: ở chỗ tối đồng tử giãn ra, còn cúi đầu hoặc nằm sấp lâu lại đẩy thủy tinh thể ra phía trước. Người vốn đã có tiền đồ nông thì dễ bị kích thích như vậy, nên nhóm thật sự có nguy cơ cao là người trên 50 tuổi, người viễn thị, và người có người thân trong nhà từng bị glô-cô-mơ góc đóng. Người trẻ thức cả đêm chơi game hầu như không lên cơn như vậy. Sai lệch dễ gặp nhất lúc lên cơn là nhầm sang viêm dạ dày ruột, đau nửa đầu, hoặc huyết áp cao, vì đau đầu và nôn biểu hiện rõ hơn triệu chứng ở mắt. Một mắt mất thị lực mà không đau không đỏ là chuyện khác, xem mục 5 (một mắt tối đi đột ngột). Kính chống ánh sáng xanh có ích không, xem mục 16 ở phần 6 (kính chống ánh sáng xanh)."]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Ghi chú của tôi"]},{"tag":"button","props":{"type":"button"},"children":["Viết một lời nhắc cho chính bạn…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/vi/tip/13-05"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Trước"]},"Một mắt tối đi đột ngột như kéo xuống rèm, dù chỉ vài phút rồi tự hết thì vẫn đi cấp cứu ngay trong ngày theo đường đột quỵ"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/vi/tip/13-07"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Tiếp theo"]},"Đau tức ngực kiểu bóp nghẽn, khó thở, cứng ngực quá 15 phút không dịu: gọi 120, đừng chịu đựng và đừng tự lái xe"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["Thêm trong chủ đề này"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/13-02"},"children":[{"tag":"strong","props":{},"children":["Người cao tuổi ngã hoặc ai đó nằm gục: ngồi xuống gọi họ, gọi 120 ở Trung Quốc, đừng vội đỡ dậy; với người lạ, bỏ đi ở Trung Quốc cũng hợp pháp, đã dừng thì đừng tự di chuyển họ"]},{"tag":"span","props":{},"children":["Chủ đạo của mục này là người cao tuổi trong nhà và người quen xung qu…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/13-03"},"children":[{"tag":"strong","props":{},"children":["Miệng lệch, một bên tay không có lực, nói không rõ: gọi 120 ngay, đừng chờ, đừng tự lái xe đi"]},{"tag":"span","props":{},"children":["Miệng lệch, một bên không giơ nổi tay lên, nói không rõ, gọi 120 ngay…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/13-04"},"children":[{"tag":"strong","props":{},"children":["Chóng mặt xoay tròn không đứng vững, nhìn thấy hai hình, một mắt tối đi, hoặc chỉ tay không trúng mũi mình: vẫn coi như đột quỵ và gọi 120"]},{"tag":"span","props":{},"children":["Chỉ nhìn ba dấu hiệu「miệng lệch, giơ tay, nói」thì hơn một phần mười s…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/13-08"},"children":[{"tag":"strong","props":{},"children":["Đau dữ dội như bị xé toạc, lan từ ngực ra sau lưng và xuống thắt lưng: gọi 120 và nói rõ「cơn đau đang di chuyển」"]},{"tag":"span","props":{},"children":["Đau dữ dội như bị xé từ ngực lan ra sau lưng và xuống thắt lưng, thì …"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/13-09"},"children":[{"tag":"strong","props":{},"children":["Đột nhiên một cơn「đau đầu nặng nhất đời», trong vòng một giờ đã tới lúc đau nhất: đi cấp cứu ngay để chụp CT sọ"]},{"tag":"span","props":{},"children":["Cần xem là phải nhanh bao lâu thì đau tới mức nặng nhất. Với đau đầu …"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/13-10"},"children":[{"tag":"strong","props":{},"children":["Người cao tuổi va đầu rồi hai ba tuần đến vài tháng sau mà đi loạng, uể oải, ngủ gật hoặc một bên không có lực: đi chụp CT sọ"]},{"tag":"span","props":{},"children":["Sau khi người cao tuổi va đầu, máu thường đến tuần thứ ba mới tích lạ…"]}]}]}]},{"tag":"a","props":{"className":"life-text-link","href":"/vi/book/13"},"children":["Đọc toàn bộ chủ đề: Tình huống khẩn cấp: làm gì trước"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"15","height":"15","viewBox":"0 0 24 24","fill