.org/2000/svg","width":"18","height":"18","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-up-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M7 7h10v10"},"children":[]},{"tag":"path","props":{"d":"M7 17 17 7"},"children":[]}]}]}]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/ru/book/02"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"К содержанию"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["Не умирайте медленно"]},{"tag":"div","props":{"data-ad-dock-host":"true"},"children":[]},{"tag":"nav","props":{"aria-label":"Советы главы"},"children":[{"tag":"a","props":{"href":"/ru/tip/02-01"},"children":[{"tag":"span","props":{},"children":["01"]},"Бросайте курить — чем раньше, тем лучше"]},{"tag":"a","props":{"href":"/ru/tip/02-02"},"children":[{"tag":"span","props":{},"children":["02"]},"Не курите дома и в машине, а также не позволяйте гостям курить в вашем доме"]},{"tag":"a","props":{"href":"/ru/tip/02-03"},"children":[{"tag":"span","props":{},"children":["03"]},"Отказ от курения: не обходитесь только силой воли, сначала возьмите лекарства — шанс успеха вырастет более чем вдвое"]},{"tag":"a","props":{"href":"/ru/tip/02-04"},"children":[{"tag":"span","props":{},"children":["04"]},"Выберите день для полного отказа от курения — в этот день бросьте сразу, не уменьшайте дозу постепенно"]},{"tag":"a","props":{"href":"/ru/tip/02-05"},"children":[{"tag":"span","props":{},"children":["05"]},"Обратитесь в клинику по отказу от курения или позвоните на горячую линию 12320, чтобы узнать, есть ли такие услуги в вашем регионе"]},{"tag":"a","props":{"href":"/ru/tip/02-06"},"children":[{"tag":"span","props":{},"children":["06"]},"Курящим, уже не способным бросить, можно попробовать электронные сигареты, а некурящим — лучше не прикасаться к ним"]},{"tag":"a","props":{"href":"/ru/tip/02-07"},"children":[{"tag":"span","props":{},"children":["07"]},"Отказ от сладких напитков, даже безсахарных, не решает проблему"]},{"tag":"a","props":{"href":"/ru/tip/02-08"},"children":[{"tag":"span","props":{},"children":["08"]},"Не жевать бетель"]},{"tag":"a","props":{"href":"/ru/tip/02-09"},"children":[{"tag":"span","props":{},"children":["09"]},"Замена обычной соли на низконатриевую (калийную) соль дома"]},{"tag":"a","props":{"href":"/ru/tip/02-10"},"children":[{"tag":"span","props":{},"children":["10"]},"Регулярно чистите зубы и ежедневно удаляйте остатки пищи из межзубных промежутков; при потере зубов своевременно обращайтесь к стоматологу"]},{"tag":"a","props":{"href":"/ru/tip/02-11"},"children":[{"tag":"span","props":{},"children":["11"]},"Ежедневно нужно делать 7000–8000 шагов или набирать 150–300 минут быстрой ходьбы в неделю"]},{"tag":"a","props":{"href":"/ru/tip/02-12"},"children":[{"tag":"span","props":{},"children":["12"]},"При гипертонии и повышенном уровне холестерина следует принимать лекарства строго по назначению врача, не прекращая терапию самостоятельно"]},{"tag":"a","props":{"href":"/ru/tip/02-13"},"children":[{"tag":"span","props":{},"children":["13"]},"Спать примерно 7 часов в сутки и соблюдать режим"]},{"tag":"a","props":{"href":"/ru/tip/02-14"},"children":[{"tag":"span","props":{},"children":["14"]},"Регулярно занимайтесь ракеточными видами спорта: теннисом, бадминтоном, настольным теннисом"]},{"tag":"a","props":{"href":"/ru/tip/02-15"},"children":[{"tag":"span","props":{},"children":["15"]},"Соберите несколько коротких физических нагрузок вроде подъема по лестнице или быстрой ходьбы в суммарный объем в 4–5 минут в день"]},{"tag":"a","props":{"href":"/ru/tip/02-16"},"children":[{"tag":"span","props":{},"children":["16"]},"30–60 минут силовых тренировок в неделю"]},{"tag":"a","props":{"href":"/ru/tip/02-17"},"children":[{"tag":"span","props":{},"children":["17"]},"Не сидите подряд слишком долго — время от времени вставайте и двигайтесь"]},{"tag":"a","props":{"href":"/ru/tip/02-18"},"children":[{"tag":"span","props":{},"children":["18"]},"Меньше употреблять переработанное мясо (ветчину, бекон, колбасу, консервированное мясо)"]},{"tag":"a","props":{"href":"/ru/tip/02-19"},"children":[{"tag":"span","props":{},"children":["19"]},"Пейте как можно меньше или вообще не пейте"]},{"tag":"a","props":{"href":"/ru/tip/02-20"},"children":[{"tag":"span","props":{},"children":["20"]},"Людям, которые ежедневно пьют алкоголь и при прекращении приема испытывают дрожь и тревогу, не стоит самостоятельно бросать пить"]},{"tag":"a","props":{"href":"/ru/tip/02-21"},"children":[{"tag":"span","props":{},"children":["21"]},"Хотите пить меньше? Сначала посчитайте, сколько выпили за неделю, а потом поговорите с врачом несколько минут"]},{"tag":"a","props":{"href":"/ru/tip/02-22"},"children":[{"tag":"span","props":{},"children":["22"]},"Ежедневное употребление небольшой горсти орехов"]},{"tag":"a","props":{"href":"/ru/tip/02-23"},"children":[{"tag":"span","props":{},"children":["23"]},"Замена части красного мяса на рыбу и птицу"]},{"tag":"a","props":{"href":"/ru/tip/02-24"},"children":[{"tag":"span","props":{},"children":["24"]},"Замените часть белого риса и пшеничной муки на цельнозерновые продукты"]},{"tag":"a","props":{"href":"/ru/tip/02-25"},"children":[{"tag":"span","props":{},"children":["25"]},"Пить чай более трёх раз в неделю"]},{"tag":"a","props":{"href":"/ru/tip/02-26"},"children":[{"tag":"span","props":{},"children":["26"]},"Три–четыре чашки кофе в день без сахара и сливок"]},{"tag":"a","props":{"href":"/ru/tip/02-27"},"children":[{"tag":"span","props":{},"children":["27"]},"Съедать по 5 порций (около 400 г) фруктов и овощей в день"]},{"tag":"a","props":{"href":"/ru/tip/02-28"},"children":[{"tag":"span","props":{},"children":["28"]},"Меньше употреблять сверхобработанные продукты (чипсы, быстрые лапша, выпечка, полуфабрикаты)"]},{"tag":"a","props":{"href":"/ru/tip/02-29"},"children":[{"tag":"span","props":{},"children":["29"]},"Переход с угля и дров на электричество или газ для приготовления пищи и отопления"]},{"tag":"a","props":{"href":"/ru/tip/02-30"},"children":[{"tag":"span","props":{},"children":["30"]},"Дайте горячему напитку остыть, прежде чем пить — не пейте слишком горячий чай, суп или кофе"]},{"tag":"a","props":{"href":"/ru/tip/02-31"},"children":[{"tag":"span","props":{},"children":["31"]},"Выходите на солнце днём — не сидите всё время в помещении"]},{"tag":"a","props":{"href":"/ru/tip/02-32"},"children":[{"tag":"span","props":{},"children":["32"]},"Поддерживайте ИМТ в пределах 20–25: при избыточном весе нужно худеть"]},{"tag":"a","props":{"href":"/ru/tip/02-33"},"children":[{"tag":"span","props":{},"children":["33"]},"Употребление перца чили более четырех раз в неделю"]},{"tag":"a","props":{"href":"/ru/tip/02-34"},"children":[{"tag":"span","props":{},"children":["34"]},"Выпивать по одной-две порции молока или йогурта в день"]},{"tag":"a","props":{"href":"/ru/tip/02-35"},"children":[{"tag":"span","props":{},"children":["35"]},"Яйца можно есть, но не стоит употреблять по три-четыре штуки в день"]},{"tag":"a","props":{"href":"/ru/tip/02-36"},"children":[{"tag":"span","props":{},"children":["36"]},"При возможности принимайте ванну, а не ограничивайтесь душем"]},{"tag":"a","props":{"href":"/ru/tip/02-37"},"children":[{"tag":"span","props":{},"children":["37"]},"Ограничьте дневной сон полчаса — не более часа; если вам необходимо спать по часу-два, чтобы чувствовать себя нормально, стоит выяснить причину"]},{"tag":"a","props":{"href":"/ru/tip/02-38"},"children":[{"tag":"span","props":{},"children":["38"]},"После бессонной ночи ложитесь спать пораньше на следующий вечер — не откладывайте это на выходные"]},{"tag":"a","props":{"href":"/ru/tip/02-39"},"children":[{"tag":"span","props":{},"children":["39"]},"Чем дольше человек работает в ночную смену, тем выше риск сердечно-сосудистых заболеваний; при возможности стоит сменить работу"]},{"tag":"a","props":{"href":"/ru/tip/02-40"},"children":[{"tag":"span","props":{},"children":["40"]},"Покупайте готовую упакованную растительную нефть с номером разрешения SC, а не самодельное арахисовое масло из частных мастерских"]},{"tag":"a","props":{"href":"/ru/tip/02-41"},"children":[{"tag":"span","props":{},"children":["41"]},"Замена свиного и сливочного жира на растительное масло в приготовлении пищи — не требует покупки разных видов масел ради здоровья, а льняное масло не защищает сердце"]},{"tag":"a","props":{"href":"/ru/tip/02-42"},"children":[{"tag":"span","props":{},"children":["42"]},"Включайте вытяжку при жарке и тушении — с момента зажигания плиты и до конца готовки"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/ru/tip/02-43","data-status":"active"},"children":[{"tag":"span","props":{},"children":["43"]},"Если приливы и ночная потливость в период менопаузы мешают жить, обратитесь к гинекологу для оценки гормональной терапии: не терпите и не покупайте лекарства самостоятельно, а для профилактики болезней сердца её не используйте"]},{"tag":"a","props":{"href":"/ru/tip/02-44"},"children":[{"tag":"span","props":{},"children":["44"]},"Если собаку и так хотели завести, засчитывайте ежедневные прогулки с ней в норму шагов, но не заводите собаку ради долголетия"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"Навигация"},"children":[{"tag":"a","props":{"href":"/ru/book"},"children":["Книга"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/ru/book/02"},"children":["Глава 2"," ·"," ","Не умирайте медленно"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"02-43"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["43"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["Доказательства"," ","A"]}]},{"tag":"h1","props":{"lang":"ru"},"children":["Если приливы и ночная потливость в период менопаузы мешают жить, обратитесь к гинекологу для оценки гормональной терапии: не терпите и не покупайте лекарства самостоятельно, а для профилактики болезней сердца её не используйте"]},{"tag":"p","props":{"lang":"ru","className":"life-entry-summary"},"children":["При приливах и ночной потливости в период менопаузы гормональная терапия уменьшает число приливов примерно на 75% по сравнению с плацебо. Цена — небольшое увеличение числа случаев рака молочной железы, тромбов и инсульта: примерно по 8 дополнительных случаев каждого на 10 000 женщин в год. У начавших лечение в возрасте от 50 до 59 лет общая смертность не выросла. Использовать эту терапию для профилактики болезней сердца и деменции нельзя."]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Затраты"]},{"tag":"p","props":{},"children":["Обратитесь к гинекологу или в клинику менопаузы. Врач спро…"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Польза"]},{"tag":"p","props":{},"children":["Cochrane объединил 24 рандомизированных испытания с участием 3329 человек, в которых сравнивали пероральные го…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"Отметить: Если приливы и ночная потливость в период менопаузы мешают жить, обратитесь к гинекологу для оценки гормональной терапии: не терпите и не покупайте лекарства самостоятельно, а для профилактики болезней сердца её не используйте"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"Сделано"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"В планах"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"В избранное"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Поделиться советом"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Скрыть подробности"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Затраты"]},{"tag":"p","props":{},"children":["Обратитесь к гинекологу или в клинику менопаузы. Врач спросит о перенесённых заболеваниях, проверит, нет ли состояний, при которых гормоны не подходят, и при необходимости выпишет рецепт. После начала лечения проходите контрольные осмотры по назначению врача. Трудность — отказаться от страха «любые гормоны сразу вызывают рак»; но и покупать их самостоятельно, услышав об омоложении, не следует."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Польза"]},{"tag":"p","props":{},"children":["Cochrane объединил 24 рандомизированных испытания с участием 3329 человек, в которых сравнивали пероральные гормоны с плацебо. При приёме гормонов число приливов в неделю было примерно на 75% меньше, чем при плацебо (95% ДИ 64.3–82.3, доверительный интервал). Выраженность приливов также заметно уменьшалась (OR 0.13, 0.07–0.23). В группе плацебо приливов тоже стало примерно на 57.7% меньше, поэтому любое средство, которому приписывают лечение приливов, нужно сравнивать с плацебо. Риски оценены по американскому рандомизированному испытанию WHI. За 16608 женщинами от 50 до 79 лет с сохранённой маткой, принимавшими эстроген вместе с прогестогеном, наблюдали в среднем 5.2 года. Ишемическая болезнь сердца встречалась примерно на 29% чаще (HR 1.29, 1.02–1.63). Инвазивный рак молочной железы — примерно на 26% чаще (HR 1.26, 1.00–1.59). Инсульт — примерно на 41% чаще (HR 1.41, 1.07–1.85). Тромбоэмболия лёгочной артерии — примерно в 2.13 раза чаще (HR 2.13, 1.39–3.25). В абсолютных числах на 10 000 женщин в год приходилось дополнительно 7 случаев ишемической болезни сердца, 8 инсультов, 8 тромбоэмболий лёгочной артерии и 8 случаев инвазивного рака молочной железы. Одновременно было на 6 случаев колоректального рака и на 5 переломов бедра меньше. У женщин после удаления матки, получавших только эстроген, за совокупные 13 лет наблюдения рак молочной железы, напротив, встречался примерно на 21% реже (HR 0.79, 0.65–0.97). В двух испытаниях вместе за 18 лет наблюдения общая смертность не изменилась (HR 0.99, 0.94–1.03). При разделении по возрасту начала лечения в группе от 50 до 59 лет общая смертность за годы приёма была примерно на 31% ниже (HR 0.69, 0.51–0.94). Для возраста от 60 до 69 лет оценка составляла 1.04 (0.87–1.25), для возраста от 70 до 79 лет — 1.13 (0.94–1.36); оба результата статистически незначимы. Через 18 лет в группе от 50 до 59 лет оценка составила 0.89 (0.79–1.01) и также перестала быть статистически значимой. В обзоре Cochrane 2017 года отдельно для женщин от 50 до 59 лет единственным явно повышенным риском были тромбы при сочетании эстрогена с прогестогеном; абсолютный риск составлял менее 1/500. У женщин старше 65 лет, получавших эстроген вместе с прогестогеном, за 4 года число случаев деменции выросло с 9 на тысячу до 11–30 на тысячу. В 2022 году Рабочая группа США по профилактике заболеваний рекомендовала не применять гормоны для профилактики хронических болезней (рекомендация степени D), заключив, что суммарной пользы нет."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Первоисточники"]},{"tag":"p","props":{"className":"life-citations"},"children":["MacLennan AH, Broadbent JL, Lester S, Moore V (2004). Oral oestrogen and combined oestrogen/progestogen therapy versus placebo for hot flushes. Cochrane Database of Systematic Reviews, (4), CD002978. ",{"tag":"a","props":{"href":"https://doi.org/10.1002/14651858.CD002978.pub2","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1002/14651858.CD002978.pub2"]},"；Writing Group for the Women's Health Initiative Investigators, Rossouw JE, Anderson GL, Prentice RL, 等 (2002). Risks and benefits of estrogen plus progestin in healthy postmenopausal women: principal results from the Women's Health Initiative randomized controlled trial. JAMA, 288(3), 321-333. ",{"tag":"a","props":{"href":"https://doi.org/10.1001/jama.288.3.321","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1001/jama.288.3.321"]},"；Manson JE, Chlebowski RT, Stefanick ML, 等 (2013). Menopausal hormone therapy and health outcomes during the intervention and extended poststopping phases of the Women's Health Initiative randomized trials. JAMA, 310(13), 1353-1368. ",{"tag":"a","props":{"href":"https://doi.org/10.1001/jama.2013.278040","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1001/jama.2013.278040"]},"；Manson JE, Aragaki AK, Rossouw JE, 等 (2017). Menopausal hormone therapy and long-term all-cause and cause-specific mortality: the Women's Health Initiative randomized trials. JAMA, 318(10), 927-938. ",{"tag":"a","props":{"href":"https://doi.org/10.1001/jama.2017.11217","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1001/jama.2017.11217"]},"；Marjoribanks J, Farquhar C, Roberts H, 等 (2017). Long-term hormone therapy for perimenopausal and postmenopausal women. Cochrane Database of Systematic Reviews, (1), CD004143. ",{"tag":"a","props":{"href":"https://doi.org/10.1002/14651858.CD004143.pub5","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1002/14651858.CD004143.pub5"]},"；US Preventive Services Task Force, Mangione CM, Barry MJ, 等 (2022). Hormone therapy for the primary prevention of chronic conditions in postmenopausal persons: US Preventive Services Task Force recommendation statement. JAMA, 328(17), 1740-1746. ",{"tag":"a","props":{"href":"https://doi.org/10.1001/jama.2022.18625","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1001/jama.2022.18625"]}]},{"tag":"a","props":{"href":"https://doi.org/10.1002/14651858.CD002978.pub2","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Открыть источник"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Примечание автора"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["Спорный вопрос: средний возраст женщин в WHI был 63 года, и применялась одна фиксированная пероральная схема. Сейчас большинство начинает лечение ради облегчения симптомов в возрасте около 50 лет, вскоре после менопаузы, и не полностью соответствует участницам испытания. Более низкая смертность в возрасте от 50 до 59 лет выявлена при анализе возрастных подгрупп; к 18 годам наблюдения результат перестал быть статистически значимым. Поэтому утверждать, что гормоны продлевают жизнь, нельзя. Cochrane также прямо указывает, что масштаба испытаний недостаточно для ясной оценки рисков у женщин в первые 10 лет после менопаузы. Обычно терапия не подходит перенёсшим рак молочной железы или тромбоз, людям с высоким сердечно-сосудистым риском и выраженным ожирением; конкретное решение принимает врач. При сохранённой матке один эстроген повышает риск рака эндометрия, поэтому одновременно нужен прогестоген; только после удаления матки можно применять один эстроген. Гормоны также уменьшают число переломов, но обычно их рассматривают лишь тогда, когда другие препараты от остеопороза не подходят. По остеопорозу сначала см. пункт 39 раздела 1 (исследование плотности костей) и пункт 40 раздела 1 (при выявленном остеопорозе принимать лекарства). Польза оценена как «большая» по уменьшению числа приливов примерно на 75%; конечный показатель — симптомы, а не общая смертность. Основную пользу получаете вы сами; также её могут получить ваша мать и супруг или супруга."]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Моя заметка"]},{"tag":"button","props":{"type":"button"},"children":["Запишите напоминание…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/ru/tip/02-42"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Предыдущий"]},"Включайте вытяжку при жарке и тушении — с момента зажигания плиты и до конца готовки"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/ru/tip/02-44"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Следующий"]},"Если собаку и так хотели завести, засчитывайте ежедневные прогулки с ней в норму шагов, но не заводите собаку ради долголетия"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["Другие советы по этой теме"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/02-36"},"children":[{"tag":"strong","props":{},"children":["При возможности принимайте ванну, а не ограничивайтесь душем"]},{"tag":"span","props":{},"children":["У людей, которые почти ежедневно принимают ванну, риск развития серде…"]}]}]},