":{},"children":["ログイン"]}]}]}]},{"tag":"main","props":{"className":"life-longread"},"children":[{"tag":"a","props":{"className":"life-back-link active","href":"/ja/articles","data-status":"active","aria-current":"page"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"記事一覧へ"]},{"tag":"header","props":{"className":"life-longread-header"},"children":[{"tag":"div","props":{},"children":[{"tag":"div","props":{"className":"life-eyebrow"},"children":["詳しく読む"]},{"tag":"h1","props":{"lang":"ja"},"children":["家庭用非常持品リスト：何を買うべきか、どこに置くべきか、どのくらいの頻度で点検すべきか"]},{"tag":"p","props":{"lang":"ja"},"children":["家庭に備えておくべきもの、保管場所、点検の頻度、そして購入する必要のないものについて。"]},{"tag":"a","props":{"className":"life-longread-chapter","href":"/ja/book/01"},"children":["関連する章"," · ","早死を避けるために",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"img","props":{"src":"/sites/howtolivebetter/images/book-chapters/01-safety-editorial.webp","srcSet":"/sites/howtolivebetter/images/book-chapters/01-safety-editorial-thumb.webp 600w, /sites/howtolivebetter/images/book-chapters/01-safety-editorial-md.webp 900w, /sites/howtolivebetter/images/book-chapters/01-safety-editorial.webp 1200w","sizes":"(max-width: 760px) 100vw, 450px","alt":"","width":"1200","height":"800","fetchPriority":"high"},"children":[]}]},{"tag":"div","props":{"className":"life-longread-layout"},"children":[{"tag":"aside","props":{"className":"life-longread-toc"},"children":[{"tag":"details","props":{"open":true},"children":[{"tag":"summary","props":{},"children":["この記事の目次"]},{"tag":"nav","props":{"aria-label":"この記事の目次"},"children":[{"tag":"a","props":{"href":"#一公式リストの原文"},"children":["一、公式リストの原文"]},{"tag":"a","props":{"href":"#二消防三点セット"},"children":["二、消防三点セット"]},{"tag":"a","props":{"href":"#三救急箱に入れるもの"},"children":["三、救急箱に入れるもの"]},{"tag":"a","props":{"href":"#四照明通信および救助要請"},"children":["四、照明、通信、および救助要請"]},{"tag":"a","props":{"href":"#五年に一度10分間の点検"},"children":["五、年に一度、10分間の点検"]},{"tag":"a","props":{"href":"#六購入不要なもの"},"children":["六、購入不要なもの"]},{"tag":"a","props":{"href":"#七これらの装備は一体どれほど役に立つのか"},"children":["七、これらの装備は一体どれほど役に立つのか"]}]}]}]},{"tag":"div","props":{"className":"life-longread-main"},"children":[{"tag":"article","props":{"className":"life-article-body","lang":"ja"},"children":[{"tag":"p","props":{},"children":["READMEの",{"tag":"a","props":{"href":"/ja/book/01#01-26","title":"消火器、消火毯、避難用マスク、救急セットを揃え、年に一度点検する"},"children":["第 1 節第 26 条"]},"（消火器、防火ブランケット、避難用呼吸マスク、救急セットの備え）に対応しています。このリストは、家庭に何を常備しておくべきかを記載したものであり、防火ブランケットを除き、使用方法については説明していません。火災からの避難、心肺蘇生、大量出血、火傷、一酸化炭素中毒の際にその場で何をすべきかは、",{"tag":"a","props":{"href":"/ja/book/13","title":"緊急事態：まず何をすべきか"},"children":["第 13 節"]},"に記載されています。煙感知器および一酸化炭素警報器の選び方と設置方法については、",{"tag":"a","props":{"href":"/ja/book/01#01-03","title":"煙感知器を設置する。冬場に室内で石炭やガスを使用する場合は、一酸化炭素警報器も併せて設置する"},"children":["第 1 節第 3 条"]},"を参照してください。ガスホースとコンロについては、",{"tag":"a","props":{"href":"/ja/book/01#01-04","title":"ガスホースとコンロは期限が来たら交換。配管の自作改造はNG。ガス会社による訪問販売は断ってOK"},"children":["第 1 節第 4 条"]},"を参照してください。"]},"\n",{"tag":"p","props":{},"children":["本節では、死傷者を減らすための計算を行っており、不慮の事故による負傷のみを対象とし、疾病については対象外としています。装備を購入すること自体にどれほどの効果があるかについては、決定的な証拠は不十分ですが、その理由を最終節に記載しています。読み進める前に、その段落を先に確認してください。"]},"\n",{"tag":"h2","props":{"id":"一公式リストの原文"},"children":["一、公式リストの原文"]},"\n",{"tag":"p","props":{},"children":["緊急管理部は「全国基礎版家庭用緊急物資備蓄推奨リスト」を公開しており、全部で 11 項目あります。以下の表は原文の解説です。"]},"\n",{"tag":"div","props":{"className":"article-table-scroll","tabIndex":"0"},"children":[{"tag":"table","props":{},"children":[{"tag":"thead","props":{},"children":["\n",{"tag":"tr","props":{},"children":["\n",{"tag":"th","props":{},"children":["番号"]},"\n",{"tag":"th","props":{},"children":["品目"]},"\n",{"tag":"th","props":{},"children":["原文の説明"]},"\n"]},"\n"]},"\n",{"tag":"tbody","props":{},"children":["\n",{"tag":"tr","props":{},"children":["\n",{"tag":"td","props":{},"children":["1"]},"\n",{"tag":"td","props":{},"children":["飲料水"]},"\n",{"tag":"td","props":{},"children":["各自の 3 日間の基本飲水ニーズを保障、少なくとも 3 リットル/人"]},"\n"]},"\n",{"tag":"tr","props":{},"children":["\n",{"tag":"td","props":{},"children":["2"]},"\n",{"tag":"td","props":{},"children":["非常食"]},"\n",{"tag":"td","props":{},"children":["各自の 3 日間の基本食糧ニーズを保障。非常食は小型で高カロリーである"]},"\n"]},"\n",{"tag":"tr","props":{},"children":["\n",{"tag":"td","props":{},"children":["3"]},"\n",{"tag":"td","props":{},"children":["消火器および防火ブランケット"]},"\n",{"tag":"td","props":{},"children":["初期消火に使用。防火ブランケットは避難時に身に纏うことができる"]},"\n"]},"\n",{"tag":"tr","props":{},"children":["\n",{"tag":"td","props":{},"children":["4"]},"\n",{"tag":"td","props":{},"children":["呼吸マスク"]},"\n",{"tag":"td","props":{},"children":["消防用フィルタ式自救呼吸器、火災避難時に使用する"]},"\n"]},"\n",{"tag":"tr","props":{},"children":["\n",{"tag":"td","props":{},"children":["5"]},"\n",{"tag":"td","props":{},"children":["懐中電灯"]},"\n",{"tag":"td","props":{},"children":["防水・防爆懐中電灯。定期的な充電または電池交換が必要"]},"\n"]},"\n",{"tag":"tr","props":{},"children":["\n",{"tag":"td","props":{},"children":["6"]},"\n",{"tag":"td","props":{},"children":["マルチツール"]},"\n",{"tag":"td","props":{},"children":["ナイフ、鋸、ドライバー、ペンチなどの複合機能を持つ"]},"\n"]},"\n",{"tag":"tr","props":{},"children":["\n",{"tag":"td","props":{},"children":["7"]},"\n",{"tag":"td","props":{},"children":["ラジオ"]},"\n",{"tag":"td","props":{},"children":["緊急放送を受信するために使用"]},"\n"]},"\n",{"tag":"tr","props":{},"children":["\n",{"tag":"td","props":{},"children":["8"]},"\n",{"tag":"td","props":{},"children":["ホイッスル"]},"\n",{"tag":"td","props":{},"children":["高周波の救助信号を出すことができる"]},"\n"]},"\n",{"tag":"tr","props":{},"children":["\n",{"tag":"td","props":{},"children":["9"]},"\n",{"tag":"td","props":{},"children":["外用薬"]},"\n",{"tag":"td","props":{},"children":["止血粉、絆創膏、ガーゼ、包帯など、傷口の処置に使用する"]},"\n"]},"\n",{"tag":"tr","props":{},"children":["\n",{"tag":"td","props":{},"children":["10"]},"\n",{"tag":"td","props":{},"children":["除菌ウェットティッシュ"]},"\n",{"tag":"td","props":{},"children":["個人の衛生管理に使用する"]},"\n"]},"\n",{"tag":"tr","props":{},"children":["\n",{"tag":"td","props":{},"children":["11"]},"\n",{"tag":"td","props":{},"children":["サージカルマスク"]},"\n",{"tag":"td","props":{},"children":["ウイルス防護用"]},"\n"]},"\n"]},"\n"]}]},{"tag":"p","props":{},"children":["出典：緊急管理部 (2020). 全国基礎版家庭用緊急物資備蓄推奨リスト. ",{"tag":"a","props":{"href":"https://www.mem.gov.cn/kp/shaq/202011/t20201129_372149.shtml","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.mem.gov.cn/kp/shaq/202011/t20201129_372149.shtml"]}]},"\n",{"tag":"p","props":{},"children":["地方版はより詳細に記載されています。北京市応急管理局が一般家庭向けに提示しているリストは、基本版と拡張版の2段階に分かれています。基本版は「応急用品、応急用具、応急用医薬品 3 類」に分類されます。具体的な内容は以下の通りです：ラジオ機能付き手回し充電式懐中電灯、ホイッスル、タオル・ティッシュまたはウェットティッシュ、呼吸用マスク、多機能マルチツール、避難用ロープ、消火器または防火ブランケット。医薬品および医療材料は別途カウントされます：抗感染薬および抗感冒薬、医療用サージカルマスク、ガーゼ・包帯などの医療材料、ポビドンヨード綿棒。拡張版は「食品、個人用品、避難・救助用具、医療救急用品、重要書類・資料 5 類」の応急物資に分類されます。同局はまた、3つのアドバイスを提示しています。第一に、「購入資格が合法で、信頼性の高い製造・販売企業が提供する応急物資を選ぶこと」。第二に、「基本版の応急物資の品目を優先的に備蓄すること」。第三に、「応急物資の正しい使用方法を習熟し、定期的に応急物資の状態を点検し、使用期限が切れた応急物資は速やかに交換すること」です。"]},"\n",{"tag":"p","props":{},"children":["出典：北京市応急管理局 (2020)。北京市、住民家庭向け応急物資備蓄推奨リストを改訂・発表。 ",{"tag":"a","props":{"href":"https://yjglj.beijing.gov.cn/art/2020/12/23/art_6058_664632.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://yjglj.beijing.gov.cn/art/2020/12/23/art_6058_664632.html"]}," ；北京市西城区人民政府による転載の品目詳細。 ",{"tag":"a","props":{"href":"https://www.bjxch.gov.cn/zt/kpzc/xxxq/pnidpv858729.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.bjxch.gov.cn/zt/kpzc/xxxq/pnidpv858729.html"]}]},"\n",{"tag":"p","props":{},"children":["国家レベルでは 2024 年に再度更新されています。文書は、国家防災減災救災委員会弁公室による『応急救助・災害救済物資の保障体系および能力建設のさらなる強化に関する指導意見』（国防減救办発〔2024〕13 号、2024 年 9 月 23 日）です。その付録 2 は『家庭用応急物資備蓄指導目録』と呼ばれます。この目録は 5 類に分かれています：応急食品、生活用品、応急用具、応急用医薬品および医療用品、重要資料。基本版は 16 品目、拡張版は 31 品目です。TODO（要確認：これら 16 個と 31 個の品目の名称はそれぞれ何か。公式の付録はwpsファイルであり、スキャンされた画像形式のPDFもあるため、今回は一字一句照合可能なテキストを取得できなかった）。"]},"\n",{"tag":"h2","props":{"id":"二消防三点セット"},"children":["二、消防三点セット"]},"\n",{"tag":"p","props":{},"children":[{"tag":"strong","props":{},"children":["消火器。"]}," 携帯用消火器は国の強制認証を受けた製品です。合格品には瓶の表面にCCCマークが印字されています。適用される規格は GB 4351—2023《携帯用消火器》です。あらかじめ加圧されているタイプ（二酸化炭素消火器を除く）は、瓶の表面に圧力計が付いています。圧力計の指針が緑色の範囲内に止まっている必要があります。指針が赤色または黄色の範囲を指している場合は、その消火器は使用不能であることを意味します。耐用年数（廃棄時期）は XF 95 の規格に基づき、水系は 6 年、粉末は 10 年、二酸化炭素は 12 年と定められています。耐用年数は製造日から起算されます。製造日は瓶の表面の刻印で確認できます。家庭用には一般的にABC粉末タイプを購入します。キッチンの入り口に1つ、玄関に1つ置いておきましょう。コンロの真上の棚の中に押し込まないでください。実際に火災が発生した際、手が届かなくなります。"]},"\n",{"tag":"p","props":{},"children":[{"tag":"strong","props":{},"children":["防火ブランケット。"]}," 公式のリストでは、消火器と同じ項目に記載されています。用途は2つあります。燃え始めた小さな火を覆うか、身にまとって避難するために使用します。キッチンの引き出しに1枚入れておくだけで十分です。場所を取らず、使用期限もありません。"]},"\n",{"tag":"p","props":{},"children":["使用するときは、ブランケットに付いている2本の黒い引き出し用ストラップを両手でつかんで下に引き、ブランケットを取り出して広げ、盾のように体の前に構えます。次に、自分に近い側から外側へ、火に向かってかぶせます。火のある側から自分の方へ引かないでください。ブランケットを押し下げるときに、炎が人の方へ吹き寄せるためです。隙間なく覆ったら、すぐにめくらないでください。身にまとって避難するときは、避難用マスクも着けてください。ブランケットは火を遮りますが、煙は遮れません。"]},"\n",{"tag":"p","props":{},"children":["防火ブランケットの多くはガラス繊維を織って作られています。繊維は非常に細く、折ったりもんだりすると切れ、切れた繊維が皮膚に刺さって、かゆみや痛みを起こします。そのため、ストラップだけを持ち、布の表面には素手で触れず、子どもに遊ばせないでください。2026年には、広東省の男の子が自宅で防火ブランケットをいじり、顔、首、脚にガラス繊維が多数刺さったとメディアが報じています。"]},"\n",{"tag":"p","props":{},"children":["油鍋に火がついたら、まずコンロの火を止め、適切な大きさの鍋のふたをかぶせてください。水をかけたり、小麦粉をまいたりしないでください。油鍋を防火ブランケットで覆う使い方には議論があります。中国の消防当局は、油鍋の火を防火ブランケットの主な用途としています。しかし、オランダの製品安全規制機関は2014年に市販の22ブランドを試験しました。一般の人の使い方では、油鍋の火を安定して消せるブランドは一つもありませんでした。ブランケット自体が燃えたものもあれば、17分間覆った後、めくると油が再び燃え出したものもありました。試験されたのは欧州規格に従って製造されたブランケットです。中国でXF 1205に従って製造されたブランケットについては、同様の試験は見つかっていません。鍋のふたはもともとコンロのそばにあるので、油鍋に火がついたら、まずそれを使ってください。"]},"\n",{"tag":"p","props":{},"children":[{"tag":"strong","props":{},"children":["避難用呼吸マスク。"]}," 公式名称は「消防用ろ過式自救呼吸器」です。適用される規格は GB 21976.7—2012《建築火災避難用器具 第 7 部：ろ過式消防用自救呼吸器》です。これは現在有効な強制的な国家規格です。この規格は 2013 年 6 月 1 日から施行され、2023 年の再審査の結果、引き続き有効とされています。購入の際は、この規格番号とCCCマークを確認してください。家族の人数分を購入しましょう。寝室の枕元など、手が届く場所に置いてください。倉庫の中に鍵をかけて保管してはいけません。内部の防毒缶が煙に含まれる毒ガスを吸着する仕組みですが、一度使用すると使い捨てとなり、また、表示されている保護時間を超えては使えないため、装着したらすぐに避難する必要があります。TODO（要確認：この規格における、使用可能な最低酸素濃度および公称保護時間に関する記述。今回は規格の名称、状態、施行日のみを確認しており、条文本文までは取得できていない）。"]},"\n",{"tag":"p","props":{},"children":["火災において最も致命的なのは煙です。避難方法（床を這って移動する、ドアに触れてから開ける、エレベーターは使わず階段を使うなど）については、",{"tag":"a","props":{"href":"/ja/book/13","title":"緊急事態：まず何をすべきか"},"children":["第 13 節"]}," 第 24 条を参照してください。煙感知器については、",{"tag":"a","props":{"href":"/ja/book/01","title":"早死を避けるために"},"children":["第 1 節"]}," 第 3 条を参照してください。これら2つの備えは、上記の3点セットよりも優先して行うべき事項です。"]},"\n",{"tag":"p","props":{},"children":["出典：贵州省消防救援总队 (2025). 居家必备灭火毯 功能用法全攻略（北京消防からの転載）. ",{"tag":"a","props":{"href":"https://gz.119.gov.cn/xfkp/xfcs/202503/t20250313_87157898.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://gz.119.gov.cn/xfkp/xfcs/202503/t20250313_87157898.html"]}," ; 大兴安岭地区市场监督管理局 (2024). 灭火毯消费提示. ",{"tag":"a","props":{"href":"https://dxal.gov.cn/dxal/c100095/202404/c13_280495.shtml","target":"_blank","rel":"noopener noreferrer"},"children":["https://dxal.gov.cn/dxal/c100095/202404/c13_280495.shtml"]}," ; 北京市门头沟区人民政府问答知识库 (2022). 油锅起火千万别用水来灭. ",{"tag":"a","props":{"href":"https://www.bjmtg.gov.cn/bjmtg/c102899/202211/1a0b00ff4b3b47b0b5400a5e3883dd51.shtml","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.bjmtg.gov.cn/bjmtg/c102899/202211/1a0b00ff4b3b47b0b5400a5e3883dd51.shtml"]}," ; NVWA (2014). Blusdekens oktober 2014（オランダ食品・消費者製品安全庁の検査報告。元のページは削除されており、リンク先は2021年10月20日のウェブアーカイブ）. ",{"tag":"a","props":{"href":"https://web.archive.org/web/20211020154732/https://www.nvwa.nl/binaries/nvwa/documenten/consument/consumentenartikelen/non-food/overige-non-food/blusdekens-oktober-2014/Factsheet+Blusdekens+Oktober+2014.pdf","target":"_blank","rel":"noopener noreferrer"},"children":["https://web.archive.org/web/20211020154732/https://www.nvwa.nl/binaries/nvwa/documenten/consument/consumentenartikelen/non-food/overige-non-food/blusdekens-oktober-2014/Factsheet+Blusdekens+Oktober+2014.pdf"]}," ; NVWA. Jaarverslag 2014: Vlam in de pan – blusdeken niet veilig（元のページは削除されており、リンク先は2019年7月16日のウェブアーカイブ）. ",{"tag":"a","props":{"href":"https://web.archive.org/web/20190716185137/https://www.nvwa.nl/over-de-nvwa/organisatie/jaarverslagen-en-jaarplannen-nvwa/jaarverslag-2014/vlam-in-de-pan-blusdeken-niet-veilig","target":"_blank","rel":"noopener noreferrer"},"children":["https://web.archive.org/web/20190716185137/https://www.nvwa.nl/over-de-nvwa/organisatie/jaarverslagen-en-jaarplannen-nvwa/jaarverslag-2014/vlam-in-de-pan-blusdeken-niet-veilig"]}," ; 马涛 (2026). 一摸满手刺 灭火毯这么“渣”？消防员：你搞错了！宁波晚报，中国宁波网. ",{"tag":"a","props":{"href":"http://news.cnnb.com.cn/system/2026/04/04/030760706.shtml","target":"_blank","rel":"noopener noreferrer"},"children":["http://news.cnnb.com.cn/system/2026/04/04/030760706.shtml"]},"（アーカイブ ",{"tag":"a","props":{"href":"https://web.archive.org/web/20261007024155/http://news.cnnb.com.cn/system/2026/04/04/030760706.shtml","target":"_blank","rel":"noopener noreferrer"},"children":["https://web.archive.org/web/20261007024155/http://news.cnnb.com.cn/system/2026/04/04/030760706.shtml"]},"；この件についてはメディア報道のみで、公式発表の原文はありません）"]},"\n",{"tag":"h2","props":{"id":"三救急箱に入れるもの"},"children":["三、救急箱に入れるもの"]},"\n",{"tag":"p","props":{},"children":["公式のリストでは、この項目について「外用薬：止血粉、止血パッド、ガーゼ、包帯など、傷口の処置に使用するもの」と一文だけ記載されています。",{"tag":"a","props":{"href":"/ja/book/13","title":"緊急事態：まず何をすべきか"},"children":["第 13 節"]},"において、現場で行うべき動作については既に確認済みです。それらの動作に基づき、家庭用救急箱には以下のものを入れておくのが合理的です。"]},"\n",{"tag":"ul","props":{},"children":["\n",{"tag":"li","props":{},"children":["止血：止血帯（ターニケット）1本。回転式で、ロッドを回して締め付けるタイプのこと。その他、滅菌ガーゼ、包帯、三角巾、医療用テープ。止血帯の使い方、使用禁止のケース、なぜ「緩めてはいけないのか」については、",{"tag":"a","props":{"href":"/ja/book/13#13-12","title":"大量出血時はまず手で傷口を強く圧迫し、四肢で抑えきれない場合は止血帯を使用、同時に 120 を呼ぶ"},"children":["第 13 節第 12 条"]},"を参照"]},"\n",{"tag":"li","props":{},"children":["清創（傷口の洗浄）：ポビドンヨード綿棒、生理食塩水、絆創膏、滅菌ドレッシング材、使い捨て手袋、ハサミ、ピンセット"]},"\n",{"tag":"li","props":{},"children":["火傷：いかなる軟膏も使用せず、現場で行うことはただ一つ、冷たい水道水で 20 分間流し続けること。",{"tag":"a","props":{"href":"/ja/book/13#13-14","title":"火傷の後はすぐに冷たい流水で 20 分間流してください。歯磨き粉や醤油は塗らないこと"},"children":["第 13 節第 14 条"]},"を参照（火傷の後は、冷たい流水で 20 分間流す）"]},"\n",{"tag":"li","props":{},"children":["記録：カードを1枚用意する。そこには家族の既往症（アレルギー歴）、持病、常用薬を明記しておく。救急隊員が到着したら、そのままカードを渡す"]},"\n"]},"\n",{"tag":"p","props":{},"children":["家族の中に重度のアレルギー体質であることが分かっている人がいる場合は、別途エピペン（アドレナリン自己注射器）を備えておくこと。これは処方薬であり、医師の処方が必要である。",{"tag":"a","props":{"href":"/ja/book/13#13-15","title":"突然、全身に発疹が出たり、息苦しさやめまいを感じたりした場合は、アナフィラキシー・ショックとして対処し、直ちに 120 を呼び、状況を明確に伝えてください"},"children":["第 13 節第 15 条"]},"を参照（アナフィラキシーショックの見分け方と打ち方）。"]},"\n",{"tag":"p","props":{},"children":["この救急セットのリストは、エビデンスレベルCです。レベルCとは、直接的な文献的根拠はなく、経験とコンセンサスに基づいて作成されたことを意味します。なぜなら、公的な文書において、この項目には「外用薬」という4文字しか記載されていないためです。具体的に何を購入すべきかは、本書ですでに検証済みの救急処置から逆算して導き出しています。"]},"\n",{"tag":"h2","props":{"id":"四照明通信および救助要請"},"children":["四、照明、通信、および救助要請"]},"\n",{"tag":"p","props":{},"children":["懐中電灯は、メーカーの指示に従い、防水・防爆仕様のものを購入すること。定期的に充電するか、電池を交換すること。ホイッスルは、閉じ込められた際に継続的に信号を送るために使用します。叫ぶよりも笛を吹く方が体力の消耗を抑えられ、騒音の中でも音が伝わりやすくなります。ラジオは緊急放送を受信するために使用します。北京版のリストには、緊急脱出用ロープと多機能マルチツール（ハサミ）も含まれています。このカテゴリーの中で最もコストパフォーマンスが良いのはモバイルバッテリーであり、多くの家庭には既に備わっているはずです。"]},"\n",{"tag":"h2","props":{"id":"五年に一度10分間の点検"},"children":["五、年に一度、10分間の点検"]},"\n",{"tag":"ul","props":{},"children":["\n",{"tag":"li","props":{},"children":["消火器：圧力計の指針が緑色の範囲内にあるか確認する。また、本体に記載された製造日を確認し、使用期限が切れていないか計算する"]},"\n",{"tag":"li","props":{},"children":["煙感知器および一酸化炭素警報器：テストボタンを押す。電池は年に一度交換すること。",{"tag":"a","props":{"href":"/ja/book/01#01-03","title":"煙感知器を設置する。冬場に室内で石炭やガスを使用する場合は、一酸化炭素警報器も併せて設置する"},"children":["第 1 節第 3 条"]},"を参照（煙感知器と一酸化炭素警報器の設置について）"]},"\n",{"tag":"li","props":{},"children":["防塵マスク（呼吸用マスク）：パッケージに破損がないか、使用期限が過ぎていないかを確認する"]},"\n",{"tag":"li","props":{},"children":["救急セット：薬品やドレッシング材の期限切れがないか、止血帯のロックが機能するかを確認する"]},"\n",{"tag":"li","props":{},"children":["懐中電灯およびモバイルバッテリー：残量があるか確認する"]},"\n"]},"\n",{"tag":"p","props":{},"children":["北京市応急管理局の原文によれば、「定期的に応急物資の状態を点検し、使用期限が切れた応急物資は速やかに交換すること」とされています。この点検作業は、警報器の電池を交換する日に合わせて、まとめて行うように設定するとよいでしょう。"]},"\n",{"tag":"h2","props":{"id":"六購入不要なもの"},"children":["六、購入不要なもの"]},"\n",{"tag":"ul","props":{},"children":["\n",{"tag":"li","props":{},"children":[{"tag":"strong","props":{},"children":["家庭用AED（自動体外式除細動器）。"]}," 1台あたり数万円（数千元）もします。また、家庭で自ら購入することを支持するエビデンスはありません。心停止時には、直ちに胸骨圧迫を行い、120へ通報すると同時に、最寄りの公共施設へAEDを取りに行くべきです。",{"tag":"a","props":{"href":"/ja/book/13#13-01","title":"人が倒れて呼吸をしていない場合は、すぐに胸を強く圧迫し、周囲の人に 120 を呼び、AEDを探すよう指示してください"},"children":["第 13 節第 1 条"]},"を参照。"]},"\n",{"tag":"li","props":{},"children":[{"tag":"strong","props":{},"children":["CCCマークのない「消防マスク」「防毒マスク」。"]}," 消防法第24条の規定により、強制性製品認証（CCC認証）の範囲に含まれる消防製品は、「法定の資格を持つ認証機関が、国家標準および業界標準の強制的な要求事項に従って認証に合格した後、初めて製造、販売、使用することができる」とされています。つまり、認証を受けていないものは販売も使用もできません。また、工業用の防毒缶は作業場内の毒物に対処するためのものであり、火災現場の煙とは別物です。"]},"\n",{"tag":"li","props":{},"children":[{"tag":"strong","props":{},"children":["セット販売の「防災キット」。"]}," このようなキットの多くは、安価な懐中電灯やマスクを詰め合わせて数を稼いでいるものです。消火器、消火マット、マスク、救急セットは、個別に購入する方が安上がりであり、一つひとつの認証を確認することも容易です。"]},"\n",{"tag":"li","props":{},"children":[{"tag":"strong","props":{},"children":["3日分以上の食料と水の備蓄。"]}," 公式のリストでは、1人あたり 3 日分として計算されています。それ以上に備蓄した分は、最終的に期限切れで廃棄されることがほとんどです。",{"tag":"a","props":{"href":"/ja/book/05#05-24","title":"「打ち消し線価格」やセール時の買い溜めに惑わされない"},"children":["第 5 節第 24 条"]},"を参照（セールに合わせて買い溜めしないこと）。"]},"\n"]},"\n",{"tag":"p","props":{},"children":["出典：全国人民代表大会常務委員会 (2021)。中華人民共和国消防法（2021 修正、第二十四条）。",{"tag":"a","props":{"href":"https://www.beijing.gov.cn/zhengce/zhengcefagui/qtwj/202307/t20230726_3207767.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.beijing.gov.cn/zhengce/zhengcefagui/qtwj/202307/t20230726_3207767.html"]}]},"\n",{"tag":"h2","props":{"id":"七これらの装備は一体どれほど役に立つのか"},"children":["七、これらの装備は一体どれほど役に立つのか"]},"\n",{"tag":"p","props":{},"children":["本節のエビデンスは、本書の",{"tag":"a","props":{"href":"/ja/book/01","title":"早死を避けるために"},"children":["第 1 節"]},"の他の項目よりも弱いです。"]},"\n",{"tag":"p","props":{},"children":["あるコクラン（Cochrane）の系統的レビューでは、98 件の研究、2,605,044 人のデータを統合して算出しています。これは、家庭への安全教育の実施や安全装備の配布が、果たして有効であるかを評価したものです。結果として、こうした取り組みは負傷の発生率をわずかに低下させる可能性があるものの、IRR 0.89（95% CI 0.78 から 1.01）であり、約1割の低下にとどまります。しかし、信頼区間の上限が 1（1 は差がないことを示す）を跨いでいるため、全く差がない可能性もあります。そのうち、戸別訪問による実施は、IRR 0.75（95% CI 0.62 から 0.91）であり、約2割5分低下と、やや高い効果が見られました。一方で、配布を行わず教育のみを行った場合は、IRR 0.78（95% CI 0.66 から 0.92）であり、約2割の低下でした。効果があるのは、物品の配布そのものというよりは、戸別訪問による指導や改修に近いと考えられます。このレビューにはもう一つの結論があります。こうした取り組みが、火傷や中毒を減少させるというエビデンスはない、ということです。"]},"\n",{"tag":"p","props":{},"children":["同一のレビューにおいて、このような取り組みは実際に人々の安全習慣を改善させています。機能する煙探知器を設置している家庭の割合は、OR 1.81（95% CI 1.30 から 2.52）と、約8割高くなっています。事前に避難計画を立てている割合は、OR 2.01（1.45 から 2.77）と、約2倍高くなっています。薬品を適切に保管している割合は、OR 1.53（1.27 から 1.84）と、約5割高くなっています。階段の入り口に防護扉を設置している割合は、OR 1.61（1.19 から 2.17）と、約6割高くなっています。"]},"\n",{"tag":"p","props":{},"children":["出典：Kendrick D et al. (2012). Home safety education and provision of safety equipment for injury prevention. Cochrane Database of Systematic Reviews. ",{"tag":"a","props":{"href":"https://doi.org/10.1002/14651858.CD005014.pub3","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1002/14651858.CD005014.pub3"]}]},"\n",{"tag":"p","props":{},"children":["したがって、公式のチェックリストに従って一度にすべてを揃えることは、それほど費用もかからず、合理的な備えと言えます。しかし、すべてを揃えれば安全だと思い込まないでください。研究が繰り返し証明している、効果のある3つの事柄は、「煙探知器の設置」、「避難経路の事前検討」、「家庭内の危険物の除去」です。これら3つの事柄は、ショッピングリストに全く含まれていないか、あるいはリストの極めてわずかな部分しか占めていません。"]},"\n"]},{"tag":"footer","props":{"className":"life-article-attribution"},"children":[{"tag":"p","props":{},"children":["このページには当サイトが中国語原文から機械翻訳した文章が含まれ、専門家による校閲は行っていません。医療・法律・金融情報は原文と出典を確認してください。"]},{"tag":"a","props":{"href":"https://github.com/eternity4719/HowToLiveBetter/blob/33362aff50f97f413b22ddfcdb355d2a536a5700/docs/%E5%AE%B6%E5%BA%AD%E5%BA%94%E6%80%A5%E8%A3%85%E5%A4%87%E6%B8%85%E5%8D%95.md","target":"_blank","rel":"noopener noreferrer"},"children":["出典の版を見る · 33362af",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"14","height":"14","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]},{"tag":"span","props":{},"children":["取り込み日：2026-10-11"]},{"tag":"p","props":{},"children":["参照リンクは当サイトの版で対応するヒントに移動します。原文の番号とは異なる場合があります。"]}]},{"tag":"div","props":{"className":"life-quick-share"},"children":[{"tag":"button","props":{"type":"button"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-copy","aria-hidden":"true"},"children":[{"tag":"rect","props":{"width":"14","height":"14","x":"8","y":"8","rx":"2","ry":"2"},"children":[]},{"tag":"path","props":{"d":"M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"},"children":[]}]},"リンクをコピー"]},{"tag":"span","props":{"role":"status"},"children":[]}]}," ",{"tag":"section","props":{"className":"social-share-strip","aria-label":"役立つヒントを共有しよう"},"chi