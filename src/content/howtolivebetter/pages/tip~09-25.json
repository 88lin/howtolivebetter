dth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"分享这条建议"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"收起详情"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["成本"]},{"tag":"p","props":{"className":"life-citations"},"children":["不花钱。拿去出版、卖钱之前，先找原作的权利人谈授权。谈不下来，就把借来的人物名字、性格和人物关系换成自己的。书名、副标题和宣传语里，也别蹭原作的名头。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["收益"]},{"tag":"p","props":{"className":"life-citations"},"children":["江南的小说《此间的少年》，用了郭靖、黄蓉、乔峰、令狐冲等金庸小说里的人物名字。书里讲的是这些人在大学校园里的故事。2002 年出版时，副标题是「射雕英雄的大学生涯」。到起诉时，这本书出了多个版本，发行上百万册。金庸 2016 年起诉江南和出版方，索赔 500 万元。一审认为不构成著作权侵权。理由是：离开了具体情节，光是人物名字、关系和性格，很难算受保护的具体表达。但一审认定，江南借原作名气吸引读者，构成不正当竞争。按历年版税 560 万元的 30%，判赔 168 万元，外加律师费 20 万元。二审由广州知识产权法院审理，改判构成著作权侵权。二审认为，两本书的故事情节不算实质性相似，也就是情节没有抄。但 60 多个人物合起来的「人物群像」，名字、性格、关系和背景都是金庸的选择和安排。这属于著作权法保护的表达，江南侵害了金庸四部小说的著作权。副标题故意和《射雕英雄传》挂钩，另外构成不正当竞争。二审判江南停止不正当竞争、登报消除影响，赔 168 万元和合理开支 20 万元。两家出版发行公司对其中 33 万元承担连带责任，也就是这部分要一起赔。二审没有判停止侵权，但要求以后再版，按再版版税收入的 30% 付给原作权利人。二审之后，双方都向广东省高级人民法院申请再审。2025 年 9 月 19 日，各方在广东高院主持下达成和解。和解里，各方同意不把这件事定性为「剽窃」。江南承认，他创作时缺乏著作权法律知识，没有事先取得金庸的改编许可，给金庸造成了损害。江南同意不再原样再版这本书。以后再版，不再用金庸作品里的独创人物名字和相关内容。各方确认，那个副标题构成不正当竞争。二审判的赔偿，江南已经付了。调解书签收后，原来的一审、二审判决都不再有法律效力。另一个案子的被告是《鬼吹灯》作者张牧野，笔名天下霸唱。2006 年，他把这套小说著作权里的财产权全部转让给了上海玄霆娱乐信息科技有限公司。后来他授权出版新书《摸金校尉》，书里用了《鬼吹灯》的人物名字、人物关系和盗墓规矩。新书封面用了《寻龙诀》的电影海报，这部电影是从《鬼吹灯》改编的。玄霆公司起诉，索赔 2000 万元。上海浦东法院认为，新书有自己独立的情节，不算侵犯著作权。但封面让读者误以为这本书和《寻龙诀》原著有关，构成虚假宣传。法院判两家出版发行公司赔 90 万元，出版社对其中 60 万元承担连带责任，二审维持。法条上，改编权是改变作品、创作出有独创性的新作品的权利。没经著作权人许可，用改编、翻译、注释等方式使用作品，要承担停止侵害、赔偿损失等民事责任（全国）"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["来源"]},{"tag":"p","props":{"className":"life-citations"},"children":["广州知识产权法院 (2023). 金庸诉江南「同人作品第一案」有何深意（转载《法制与新闻》2023 年 7 月上期）. ",{"tag":"a","props":{"href":"https://www.gipc.gov.cn/front/content.action?id=7b7cb9a7b2cc45f286199fd427fc6b1f","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gipc.gov.cn/front/content.action?id=7b7cb9a7b2cc45f286199fd427fc6b1f"]},"；广东省高级人民法院 (2025). 「金庸诉江南」著作权及不正当竞争纠纷案在粤达成和解. ",{"tag":"a","props":{"href":"https://www.gdcourts.gov.cn/xwzx/fayuanxinmeiti/content/post_1843458.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gdcourts.gov.cn/xwzx/fayuanxinmeiti/content/post_1843458.html"]},"；国家版权局 (2020). 2019 年度上海十大版权典型案件发布（上海市版权局发布，案例六：「鬼吹灯」著作权侵权及不正当竞争纠纷案）. ",{"tag":"a","props":{"href":"https://www.ncac.gov.cn/xxfb/ywxx/202004/t20200430_47269.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.ncac.gov.cn/xxfb/ywxx/202004/t20200430_47269.html"]},"；全国人大常委会 (2020). 著作权法（2020 年修正，第三条，第十条第一款第十四项，第五十二条第六项，第五十四条）. ",{"tag":"a","props":{"href":"http://www.npc.gov.cn/npc/c2/c30834/202011/t20201119_308796.html","target":"_blank","rel":"noopener noreferrer"},"children":["http://www.npc.gov.cn/npc/c2/c30834/202011/t20201119_308796.html"]},""]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["原书备注"]},{"tag":"p","props":{"className":"life-citations"},"children":["受益人是你自己。定 B 级，是因为同人的法律边界还没有定论。这个案子两审结论不一样，最后以调解结案，两份判决都不再生效。广东高院的承办法官答问时说，和解协议只约束这个案子的当事人。同人是否侵权，「要具体情况具体分析，不能一概而论」。法官给的判断顺序是三步。先看两部作品相同的是抽象的想法，还是具体的表达。再看这些表达是不是原作者独创的。最后看是不是属于合理使用这类不侵权的情形。所以只借一个题材、一种设定，和成套借走人物名字、性格和关系，风险不一样。免费贴在网上的同人，本书没有找到法院下判的官方案例。著作权法里也没有「不收钱就不算侵权」的例外。过程成本要算进去：这个案子从 2016 年 7 月起诉，到 2025 年 9 月和解，前后 9 年。中间经过一审、二审和再审审查，金庸本人在二审期间去世。原作者把版权卖掉以后，自己写续作照样可能被买家告，天下霸唱那次就是。著作权官司里，赢的一方为制止侵权花的合理开支可以算进赔偿，这个案子一审判的 20 万元就是律师费。汉化、搬运、分享别人作品的风险，见本节第 24 条（汉化漫画、搬运影视剧）。"]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["我的备注"]},{"tag":"button","props":{"type":"button"},"children":["写下对自己有用的提醒…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/tip/09-24"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["上一条"]},"汉化漫画、搬运影视剧、分享网盘资源和盗版电子书，不收钱也是侵权；挂广告、收会员费就可能判刑"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/tip/09-26"},"children"