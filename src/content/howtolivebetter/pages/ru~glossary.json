ne","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]}]},{"tag":"section","props":{"className":"life-glossary-content","aria-label":"Понимайте цифры в книге."},"children":[{"tag":"div","props":{"className":"life-glossary-toolbar"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-glossary-count"},"children":["41"]},{"tag":"span","props":{},"children":["терминов"]}]},{"tag":"label","props":{"className":"life-glossary-search"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"18","height":"18","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-search","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m21 21-4.34-4.34"},"children":[]},{"tag":"circle","props":{"cx":"11","cy":"11","r":"8"},"children":[]}]},{"tag":"input","props":{"placeholder":"Поиск термина или значения","aria-label":"Поиск термина или значения","value":""},"children":[]}]}]},{"tag":"div","props":{"className":"life-glossary-list"},"children":[{"tag":"article","props":{"className":"life-glossary-row","id":"term-01","lang":"ru"},"children":[{"tag":"span","props":{"className":"life-glossary-number"},"children":["01"]},{"tag":"h2","props":{},"children":["Общая смертность"]},{"tag":"p","props":{},"children":["Доля умерших от любых причин за период, без разделения по причинам. Книга использует её как меру «долго ли живут». В первоисточниках — «смертность от всех причин», английское сокращение ACM"]}]},{"tag":"article","props":{"className":"life-glossary-row","id":"term-02","lang":"ru"},"children":[{"tag":"span","props":{"className":"life-glossary-number"},"children":["02"]},{"tag":"h2","props":{},"children":["HR"]},{"tag":"p","props":{},"children":["Отношение рисков (hazard ratio). Скорость, с которой в двух группах за одно и то же время наступает событие (смерть, болезнь). HR 0.87 — на 13% ниже контрольной группы, HR 1.21 — на 21% выше"]}]},{"tag":"article","props":{"className":"life-glossary-row","id":"term-03","lang":"ru"},"children":[{"tag":"span","props":{"className":"life-glossary-number"},"children":["03"]},{"tag":"h2","props":{},"children":["RR"]},{"tag":"p","props":{},"children":["Относительный риск (relative risk). Отношение вероятностей события в двух группах; читается как HR"]}]},{"tag":"article","props":{"className":"life-glossary-row","id":"term-04","lang":"ru"},"children":[{"tag":"span","props":{"className":"life-glossary-number"},"children":["04"]},{"tag":"h2","props":{},"children":["OR"]},{"tag":"p","props":{},"children":["Отношение шансов (odds ratio). Отношение «шансов» события в двух группах; при редких событиях близко к RR, при частых преувеличивает различия"]}]},{"tag":"article","props":{"className":"life-glossary-row","id":"term-05","lang":"ru"},"children":[{"tag":"span","props":{"className":"life-glossary-number"},"children":["05"]},{"tag":"h2","props":{},"children":["IRR"]},{"tag":"p","props":{},"children":["Отношение показателей заболеваемости; читается как RR"]}]},{"tag":"article","props":{"className":"life-glossary-row","id":"term-06","lang":"ru"},"children":[{"tag":"span","props":{"className":"life-glossary-number"},"children":["06"]},{"tag":"h2","props":{},"children":["RaR"]},{"tag":"p","props":{},"children":["Отношение числа событий (например, числа падений); читается как RR"]}]},{"tag":"article","props":{"className":"life-glossary-row","id":"term-07","lang":"ru"},"children":[{"tag":"span","props":{"className":"life-glossary-number"},"children":["07"]},{"tag":"h2","props":{},"children":["Стандартизованное отношение смертности"]},{"tag":"p","props":{},"children":["SMR. Фактическое число умерших в группе, делённое на ожидаемое число, рассчитанное по коэффициентам смертности обычных людей того же возраста. 5.86 означает, что смертей в 5.86 раза больше, чем у сверстников"]}]},{"tag":"article","props":{"className":"life-glossary-row","id":"term-08","lang":"ru"},"children":[{"tag":"span","props":{"className":"life-glossary-number"},"children":["08"]},{"tag":"h2","props":{},"children":["Разница рисков"]},{"tag":"p","props":{},"children":["Вероятности события в двух группах вычитаются, сразу видно «сколько лишних случаев на тысячу человек». Отношение говорит только «во сколько раз», разница рисков — на сколько человек абсолютно больше"]}]},{"tag":"article","props":{"className":"life-glossary-row","id":"term-09","lang":"ru"},"children":[{"tag":"span","props":{"className":"life-glossary-number"},"children":["09"]},{"tag":"h2","props":{},"children":["95% ДИ"]},{"tag":"p","props":{},"children":["95%-й доверительный интервал — диапазон, внутри которого с большой вероятностью лежит истинное значение. Если интервал для отношения переходит через 1, а для разности — через 0, различие может оказаться случайным; в тексте тогда пишут «статистически незначимо»"]}]},{"tag":"article","props":{"className":"life-glossary-row","id":"term-10","lang":"ru"},"children":[{"tag":"span","props":{"className":"life-glossary-number"},"children":["10"]},{"tag":"h2","props":{},"children":["RCT (РКИ)"]},{"tag":"p","props":{},"children":["Рандомизированное контролируемое испытание. Людей случайно делят на две группы: одна получает вмешательство, другая нет — и сравнивают результат. Лучше всего показывает причинность"]}]},{"tag":"article","props":{"className":"life-glossary-row","id":"term-11","lang":"ru"},"children":[{"tag":"span","props":{"className":"life-glossary-number"},"children":["11"]},{"tag":"h2","props":{},"children":["Метаанализ"]},{"tag":"p","props":{},"children":["Объединённая статистическая обработка результатов нескольких исследований, дающая одну общую оценку. Называется также meta-анализом"]}]},{"tag":"article","props":{"className":"life-glossary-row","id":"term-12","lang":"ru"},"children":[{"tag":"span","props":{"className":"life-glossary-number"},"children":["12"]},{"tag":"h2","props":{},"children":["Когорта"]},{"tag":"p","props":{},"children":["Когортное исследование. Группу людей наблюдают годами и смотрят, у кого что случилось. Показывает связь, но не доказывает причинность полностью"]}]},{"tag":"article","props":{"className":"life-glossary-row","id":"term-13","lang":"ru"},"children":[{"tag":"span","props":{"className":"life-glossary-number"},"children":["13"]},{"tag":"h2","props":{},"children":["Наблюдательное"]},{"tag":"p","props":{},"children":["Наблюдательное исследование. Исследователи только наблюдают, не вмешиваясь; на результат могут влиять смешивающие факторы и обратная причинность, к цифрам нужна скидка"]}]},{"tag":"article","props":{"className":"life-glossary-row","id":"term-14","lang":"ru"},"children":[{"tag":"span","props":{"className":"life-glossary-number"},"children":["14"]},{"tag":"h2","props":{},"children":["Смешивающие факторы"]},{"tag":"p","props":{},"children":["Третий фактор одновременно влияет и на причину, и на следствие, и связь выглядит как причинность. Кто ест больше овощей, обычно и больше двигается"]}]},{"tag":"article","props":{"className":"life-glossary-row","id":"term-15","lang":"ru"},"children":[{"tag":"span","props":{"className":"life-glossary-number"},"children":["15"]},{"tag":"h2","props":{},"children":["Обратная причинность"]},{"tag":"p","props":{},"children":["Не A вызывает B, а B вызывает A. Не долгий сон приводит к ранней смерти, а тяжелобольные дольше спят"]}]},{"tag":"article","props":{"className":"life-glossary-row","id":"term-16","lang":"ru"},"children":[{"tag":"span","props":{"className":"life-glossary-number"},"children":["16"]},{"tag":"h2","props":{},"children":["d, g"]},{"tag":"p","props":{},"children":["Величина эффекта. На сколько стандартных отклонений различаются средние двух групп. 0.2 — малое, 0.5 — среднее, 0.8 — большое"]}]},{"tag":"article","props":{"className":"life-glossary-row","id":"term-17","lang":"ru"},"children":[{"tag":"span","props":{"className":"life-glossary-number"},"children":["17"]},{"tag":"h2","props":{},"children":["r"]},{"tag":"p","props":{},"children":["Коэффициент корреляции. Насколько согласованно меняются две величины, от −1 до 1: 0.1 — слабая, 0.3 — средняя, 0.5 — сильная"]}]},{"tag":"article","props":{"className":"life-glossary-row","id":"term-18","lang":"ru"},"children":[{"tag":"span","props":{"className":"life-glossary-number"},"children":["18"]},{"tag":"h2","props":{},"children":["MET"]},{"tag":"p","props":{},"children":["Единица интенсивности нагрузки. 1 MET — спокойное сидение, быстрая ходьба — примерно 3–4 MET. MET·ч — интенсивность, умноженная на часы"]}]},{"tag":"article","props":{"className":"life-glossary-row","id":"term-19","lang":"ru"},"children":[{"tag":"span","props":{"className":"life-glossary-number"},"children":["19"]},{"tag":"h2","props":{},"children":["GRADE"]},{"tag":"p","props":{},"children":["Международный стандарт оценки качества доказательств; четыре ступени: высокая, средняя, низкая, очень низкая"]}]},{"tag":"article","props":{"className":"life-glossary-row","id":"term-20","lang":"ru"},"children":[{"tag":"span","props":{"className":"life-glossary-number"},"children":["20"]},{"tag":"h2","props":{},"children":["Анализ по приглашению"]},{"tag":"p","props":{},"children":["Эффект считается по тем, «кого пригласили на скрининг», а не по тем, «кто реально прошёл»; такой подсчёт занижает пользу скрининга для тех, кто его реально прошёл"]}]},{"tag":"article","props":{"className":"life-glossary-row","id":"term-21","lang":"ru"},"children":[{"tag":"span","props":{"className":"life-glossary-number"},"children":["21"]},{"tag":"h2","props":{},"children":["Пачка-лет"]},{"tag":"p","props":{},"children":["Единица курительного стажа: число пачек в день, умноженное на число лет курения. 30 пачка-лет — пачка в день на протяжении 30 лет"]}]},{"tag":