"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},{"tag":"span","props":{},"children":["ログイン"]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/ja/book/07"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"目次に戻る"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["お金がない時をどう生き抜くか"]},{"tag":"nav","props":{"aria-label":"この章のヒント"},"children":[{"tag":"a","props":{"href":"/ja/tip/07-01"},"children":[{"tag":"span","props":{},"children":["01"]},"失業した際は、まずオンラインで失業保険金の申請を"]},{"tag":"a","props":{"href":"/ja/tip/07-02"},"children":[{"tag":"span","props":{},"children":["02"]},"賃金未払いの場合は、まず労働監察へ通報、次に労働仲裁を申請。どちらのルートも費用は無料で、多くの案件は数ヶ月以内に結果が出ます"]},{"tag":"a","props":{"href":"/ja/tip/07-03"},"children":[{"tag":"span","props":{},"children":["03"]},"訴訟費用が払えない場合は法律扶助を申請。賃金請求、扶養料、労災などの案件は、もともと対象範囲に含まれています"]},{"tag":"a","props":{"href":"/ja/tip/07-04"},"children":[{"tag":"span","props":{},"children":["04"]},"行き場を失った時は救助施設へ。食事・宿泊・帰路のチケットを支給"]},{"tag":"a","props":{"href":"/ja/tip/07-05"},"children":[{"tag":"span","props":{},"children":["05"]},"仕事探しはまず無料の公共雇用サービスやギグワーク市場を利用。有料の仲介業者は避ける"]},{"tag":"a","props":{"href":"/ja/tip/07-06"},"children":[{"tag":"span","props":{},"children":["06"]},"不測の事態には、まず臨時救助を申請"]},{"tag":"a","props":{"href":"/ja/tip/07-07"},"children":[{"tag":"span","props":{},"children":["07"]},"収入が地域の最低生活保障基準を下回る場合は、低保（最低生活保障）を申請する"]},{"tag":"a","props":{"href":"/ja/tip/07-08"},"children":[{"tag":"span","props":{},"children":["08"]},"障害者手帳を所持している方は、障害者向け2つの補助金を申請する"]},{"tag":"a","props":{"href":"/ja/tip/07-09"},"children":[{"tag":"span","props":{},"children":["09"]},"住民医療保険の年間 400 元の支払いを中断させないこと。困難世帯は免除・減額が可能"]},{"tag":"a","props":{"href":"/ja/tip/07-10"},"children":[{"tag":"span","props":{},"children":["10"]},"重病になったら、まず医療保険、大病保険、医療扶助、そして他地域での受診登録を行い、ネットローンには手を出さないこと"]},{"tag":"a","props":{"href":"/ja/tip/07-11"},"children":[{"tag":"span","props":{},"children":["11"]},"身分証を紛失したらすぐに再発行手続きを、急ぎの場合は臨時身分証を先に受け取る"]},{"tag":"a","props":{"href":"/ja/tip/07-12"},"children":[{"tag":"span","props":{},"children":["12"]},"失業登録後、就労困難者認定を目指し、社会保険補助金または公益的雇用枠を獲得する"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/ja/tip/07-13","data-status":"active"},"children":[{"tag":"span","props":{},"children":["13"]},"失業期間に職業訓練手当、就業インターン手当、社会保険補助を申請しましょう。自費で講習に通わないでください"]},{"tag":"a","props":{"href":"/ja/tip/07-14"},"children":[{"tag":"span","props":{},"children":["14"]},"就職活動は履歴書を送るだけでは不十分です。システム的な方法を使いましょう：スキルを学び、目標を定め、周囲の助けを借りる"]},{"tag":"a","props":{"href":"/ja/tip/07-15"},"children":[{"tag":"span","props":{},"children":["15"]},"保証金を取られない、身分証を預けない、「訓練ローン」に手を出さない、マルチ商法に入らない、高利貸しから借りない"]},{"tag":"a","props":{"href":"/ja/tip/07-16"},"children":[{"tag":"span","props":{},"children":["16"]},"住居に困っているなら、公営賃貸住宅（公租房）の優先枠を"]},{"tag":"a","props":{"href":"/ja/tip/07-17"},"children":[{"tag":"span","props":{},"children":["17"]},"住居費と食費を最小限に抑える：シェアハウスの月極利用で日極利用を代替、自炊と食堂利用でデリバリーを代替"]},{"tag":"a","props":{"href":"/ja/tip/07-18"},"children":[{"tag":"span","props":{},"children":["18"]},"社会保険の未加入（断缴）に慌てない：年金は累計で計算、医療保険はルールに従って追加入金"]},{"tag":"a","props":{"href":"/ja/tip/07-19"},"children":[{"tag":"span","props":{},"children":["19"]},"服役、破産、信用ブラックリストへの登録など、法律上はやり直す道があります。まずは手続きを完了させましょう"]},{"tag":"a","props":{"href":"/ja/tip/07-20"},"children":[{"tag":"span","props":{},"children":["20"]},"重病に備え、基本医療保険に加えて1年更新の医療保険または重大疾病保険を検討する際は、「継続保証」の4文字を必ず確認すること"]},{"tag":"a","props":{"href":"/ja/tip/07-21"},"children":[{"tag":"span","props":{},"children":["21"]},"本当に寝る場所がない場合、24 時間だけ利用できる場所はあくまで緊急避難用です。まずは救助所を優先してください"]},{"tag":"a","props":{"href":"/ja/tip/07-22"},"children":[{"tag":"span","props":{},"children":["22"]},"賃金未払いの際は、まず雇い主が誰かを確認すること：無免許の作業場や請負業者（工頭）に対しても労働監察を請求可能、家庭や個人向けの私的な仕事の場合のみ裁判所へ"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"現在地"},"children":[{"tag":"a","props":{"href":"/ja/book"},"children":["本を読む"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/ja/book/07"},"children":["第7章"," ·"," ","お金がない時をどう生き抜くか"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"07-13"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["13"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["エビデンス"," ","A"]}]},{"tag":"h1","props":{"lang":"ja"},"children":["失業期間に職業訓練手当、就業インターン手当、社会保険補助を申請しましょう。自費で講習に通わないでください"]},{"tag":"p","props":{"lang":"ja","className":"life-entry-summary"},"children":["訓練に自腹で払う必要はありません。訓練に参加して規定の資格を取得すれば、職業訓練手当が支給されます。同一人物が受け取れるのは最大 3 回までです。卒業後2年以内に仕事が見つかっていない大卒者、および 16 歳から 24 歳の失業中の若者は、就業インターンシップに参加でき、インターン期間中は基本生活費が支給されます。まずは現地のの人事局（人社局）の公式サイトで「職業訓練手当目録」を確認してください。自費で講習に申し込まないようにしましょう。"]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["費用・手間"]},{"tag":"p","props":{},"children":["費用はかかりません。ただし、訓練自体にはかなりの時間を要します。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["効果"]},{"tag":"p","props":{},"children":["財政部および人社部の規定には、一連の就業支援資金プロジェクトが記載されています。"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"記録する：失業期間に職業訓練手当、就業インターン手当、社会保険補助を申請しましょう。自費で講習に通わないでください"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"できている"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"やることに追加"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"お気に入り"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"このヒントを共有"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"詳細を閉じる"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["費用・手間"]},{"tag":"p","props":{},"children":["費用はかかりません。ただし、訓練自体にはかなりの時間を要します。手当を受け取るためには、授業を最後まで受講し、資格試験に合格する必要があります。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["効果"]},{"tag":"p","props":{},"children":["財政部および人社部の規定には、一連の就業支援資金プロジェクトが記載されています。これは、財政が就業支援のために特別に割り当てた資金です。訓練に参加し、規定に適合する資格を取得すれば、職業訓練手渡が支給されます。同一人物が受け取れるのは最大 3 回までです。就業困難者が自ら社会保険に加入する場合（フレキシブル雇用）の補助は最長 3 年間。法定定年まで残り 5 年を切っている場合は、定年まで延長可能です。大卒者が自ら社会保険に加入する場合の補助は最長 2 年間、企業に採用された場合は最長 1 年間。卒業後 2 年以内に仕事が見つかっていない大卒者、および 16 歳から 24 歳の失業中の若者は、就業インターンシップに参加でき、インターン期間中は基本生活費が支給されます。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["出典"]},{"tag":"p","props":{"className":"life-citations"},"children":["财政部、人力资源社会保障部 (2023). 就业补助资金管理办法（第五条、第七条、第十条）. ",{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/202401/content_6926462.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/zhengce/zhengceku/202401/content_6926462.htm"]}]},{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/202401/content_6926462.htm","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["出典を開く"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["著者の注記"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["具体的な補助目録や金額は各省によって定められているため、まずは現地のの人事局（人社局）の公式サイトで「職業訓練手当目録」を確認してください。低所得世帯や無職世帯の卒業年度の大卒者、および学生ローンの返済がある方、障がいのある方には、別途、一回限りの求職・起業補助があります。"]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["自分のメモ"]},{"tag":"button","props":{"type":"button"},"children":["自分へのメモを書く…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/ja/tip/07-12"