},"children":[{"tag":"a","props":{"href":"/ru/tip/27-12"},"children":[{"tag":"strong","props":{},"children":["Оформите «Свидетельство о рождении» до выписки из больницы, заранее продумайте имя ребёнка и не допустите опечаток"]},{"tag":"span","props":{},"children":["Это свидетельство — обязательный документ для регистрации хукоу, офор…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/27-13"},"children":[{"tag":"strong","props":{},"children":["Не отказывайтесь от скрининга крови из пяточки и проверки слуха у новорожденных"]},{"tag":"span","props":{},"children":["Один укол крови из пяточки и одна проверка слуха позволяют выявить у …"]}]}]}]},{"tag":"a","props":{"className":"life-text-link","href":"/ru/book/27"},"children":["Читать всю тему: Беременность и роды: от обнаружения беременности до выписки из больницы и оформления документов"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"15","height":"15","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]}]}]},{"tag":"nav","props":{"className":"life-tabbar","aria-label":"Основная навигация"},"children":[{"tag":"a","props":{"className":"","href":"/ru/book"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"21","height":"21","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-book-open","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M12 7v14"},"children":[]},{"tag":"path","props":{"d":"M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z"},"children":[]}]},{"tag":"span","props":{},"children