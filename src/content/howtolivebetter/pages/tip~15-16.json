nd","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"加入待做"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"收藏"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"分享这条建议"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"收起详情"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["成本"]},{"tag":"p","props":{"className":"life-citations"},"children":["不花钱。要多跑公积金中心或受托银行一两趟，放款可能比单做商贷晚几天。前提是你已经连续交了一段时间公积金"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["收益"]},{"tag":"p","props":{"className":"life-citations"},"children":["人民银行 2025 年 5 月 7 日发文下调公积金贷款利率，从 5 月 8 日起执行。5 年以上的首套公积金贷款利率是 2.6%，5 年以下（含 5 年）是 2.1%。第二套的 5 年以上不低于 3.075%，5 年以下不低于 2.525%。截至 2026 年 10 月，这仍是最近一次调整。商业房贷利率按 LPR 加点或减点定，LPR 是贷款市场报价利率。2026 年 9 月 20 日，5 年期以上 LPR 为 3.5%。人民银行 2026 年第二季度货币政策执行报告写明，6 月「新发放个人住房贷款利率约为3.1%」。能省多少，下面是按等额本息公式自己算的例子。贷 100 万元、30 年，利率 2.6% 时月供约 4003 元，3.1% 时约 4270 元。每月少约 267 元，30 年少付利息约 9.6 万元。额度只够贷 60 万元公积金、另外 40 万元走商贷的，也比全走商贷划算。每月少约 160 元，30 年少付利息约 5.8 万元。第二套房的公积金利率下限 3.075%，和商贷的 3.1% 差不多，省不了多少钱"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["来源"]},{"tag":"p","props":{"className":"life-citations"},"children":["中国人民银行 (2025). 关于下调个人住房公积金贷款利率的通知（2025 年 5 月 7 日）. ",{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/202505/content_7022708.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/zhengce/zhengceku/202505/content_7022708.htm"]},"；中国人民银行 (2025). 同上（人民银行官网原文）. ",{"tag":"a","props":{"href":"https://www.pbc.gov.cn/zhengwugongkai/4081330/4406346/4693549/2025120618351696797/index.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.pbc.gov.cn/zhengwugongkai/4081330/4406346/4693549/2025120618351696797/index.html"]},"；全国银行间同业拆借中心受中国人民银行授权 (2026). 贷款市场报价利率（LPR），2026-09-20 公布 5 年期以上 3.50%. ",{"tag":"a","props":{"href":"https://www.chinamoney.com.cn/chinese/bklpr/","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.chinamoney.com.cn/chinese/bklpr/"]},"；中国人民银行 (2026). 2026 年第二季度中国货币政策执行报告. ",{"tag":"a","props":{"href":"https://www.pbc.gov.cn/zhengcehuobisi/125207/125227/125957/2026nhbzczxbg/2026081218435062865/index.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.pbc.gov.cn/zhengcehuobisi/125207/125227/125957/2026nhbzczxbg/2026081218435062865/index.html"]},"；国务院 (2026). 住房公积金管理条例（国务院令第 844 号第三次修订后重新公布，2026 年 9 月 20 日起施行；第九条第（三）项「确定住房公积金的最高贷款额度」，第二十六条「缴存住房公积金的职工，在购买、建造、翻建、大修自住住房时，可以向住房公积金管理中心申请住房公积金贷款」「应当自受理申请之日起10日内作出准予贷款或者不准贷款的决定」，第二十七条）. ",{"tag":"a","props":{"href":"https://www.gov.cn/gongbao/2026/issue_12946/202608/content_7079363.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/gongbao/2026/issue_12946/202608/content_7079363.html"]},"；住房城乡建设部、财政部、中国人民银行 (2014). 关于发展住房公积金个人住房贷款业务的通知（建金〔2014〕148 号，北京住房公积金管理中心转载）. ",{"tag":"a","props":{"href":"https://gjj.beijing.gov.cn/web/zwgk61/_300587/_300688/375516/index.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://gjj.beijing.gov.cn/web/zwgk61/_300587/_300688/375516/index.html"]},"；北京市住房和城乡建设委员会、北京市规划和自然资源委员会、北京住房公积金管理中心 (2026). 关于进一步优化调整本市房地产政策的通知（京建发〔2026〕400 号，第三部分）. ",{"tag":"a","props":{"href":"https://gjj.beijing.gov.cn/web/zwgk61/2024zcwj/436433464/436433467/744089355/index.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://gjj.beijing.gov.cn/web/zwgk61/2024zcwj/436433464/436433467/744089355/index.html"]},"；广州住房公积金管理中心 (2026). 个人住房公积金贷款服务指南（普通公积金贷款），第十到十二部分. ",{"tag":"a","props":{"href":"https://gjj.gz.gov.cn/bsfw/qtfw/content/post_5748060.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://gjj.gz.gov.cn/bsfw/qtfw/content/post_5748060.html"]},""]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["原书备注"]},{"tag":"p","props":{"className":"life-citations"},"children":["用公积金贷款有四道门槛。先要交够公积金。住建部等三部门 2014 年的文件写明，连续足额缴存 6 个月以上才能申请，在外地交过的可以合并算。额度和年限各地不同，最高额度由当地公积金管理委员会定。比如北京一人缴存的首套最高 120 万元，每缴存一年能贷 20 万元。广州一人最高 100 万元，期限不超过 30 年，二手房的楼龄加贷款年限不超过 50 年。买二手房的，按网签价和评估价里低的那个算房价，评估价低，能贷的就少。最后是手续多。条例要求公积金中心受理后 10 日内给结论，之后还要办抵押登记。放款比商贷慢是作者经验，卖方急着收钱的，签合同前就说好用公积金贷款。组合贷的首付比例要同时满足公积金和商贷两边的要求。公积金余额还能提出来还贷，见第 5 节第 3 条（公积金不只用来买房）。已经全做了商贷的，可以找银行谈降利率，见本节第 15 条（协商降利率）。"]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["我的备注"]},{"tag":"button","props":{"type":"button"},"children":["写下对自己有用的提醒…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/tip/15-15"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["上一条"]},"背着浮动利率房贷的，利率比新发放的房贷高出一截时，找银行协商降利率或者申请置换"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/tip/15-17"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["下一条"]},"住小区被物业停水、停电、停暖、停气逼交物业费的，向当地房地产主管部门投诉；自己欠了物业费，物业只能催告、起诉或者申请仲裁"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["本主题的其他建议"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/15-03"},"children":[{"tag":"strong","props":{},"children":["中介不得代收代付租金和押金，钱直接给房东"]},{"tag":"span","props":{},"children":["按规定，房租和押金不能由中介代收代付，钱直接付给房东。钱在中介手里过一道，就多一次它卷款跑路的机会。付款前核对收款人是不是产权证上的名字。"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/15-04"},"children":[{"tag":"strong","props":{},"children":["租长租公寓先查它的资金监管账户，别图便宜一次性付一年"]},{"tag":"span","props":{},"children":["一次性付一年，拿到的折扣就那么点。公司一旦跑路，你的押金和剩下十几个月的房租可能一起没。绑了租金贷更糟：公寓跑了，贷款还是你按月还完。签约前先查它有没有公示资金…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/15-05"},"children":[{"tag":"strong","props":{},"children":["房子租期内被卖掉，租约继续有效，不用搬"]},{"tag":"span","props":{},"children":["租期内房子被卖掉，你的租约照样有效。新房东要按原来的合同让你住到期满。不用搬，也不用重新谈价钱。前提是你已经合法住在里面，合同、转账记录、入住时间的证据都留好。"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/15-06"},"children":[{"tag":"strong","props":{},"children":["租房签约前核对产权证和抵押情况，所有款项走转账并备注用途"]},{"tag":"span","props":{},"children":["签约前让房东拿出身份证和产权证。再带身份证去不动产登记机构，查房子有没有抵押、有没有被查封，没签合同也能查。出租前就抵押或者查封的房子，被拍卖换了主人，你没法要…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/15-07"},"children":[{"tag":"strong","props":{},"children":["二手房让中介代收房款的，必须走中介在银行开的交易资金专用存款账户"]},{"tag":"span","props":{},"children":["中介代收房款的，按规定必须走它在银行开的专用账户。这个账户受监管，钱不能打进中介自己的账户，也不能转给经纪人个人。"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/15-08"},"children":[{"tag":"strong","props":{},"children":["别租隔断房：最小出租单位是原设计的房间，厨房、卫生间、阳台不得住人"]},{"tag":"span","props":{},"children":["按规定，最小的出租单位是原来设计好的那间房。厨房、卫生间、阳台和地下储藏室不能住人。另外，租期内房东也不能自己说涨租就涨租。"]}]}]}]},{"tag":"a","props":{"className":"life-text-link","href":"/book/15"},"children":["阅读整个主题：租房与买房 ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"15","height":"15","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]}]}]},{"tag":"nav","props":{"className":"life-tabbar","aria-label":"主导航"},"children":[{"tag":"a","props":{"className":"","href":"/book"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"21","height":"21","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-book-open","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M12 7v14"},"children":[]},{"tag":"path","props":{"d":"M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z"},"children":[]}]},{"tag":"span","props":{},"children":["全书"]}]},{"tag":"a","props":{"className":"","href":"/top-50"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"21","height":"21","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-star","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.