"div","props":{"className":"life-ad-rail","data-dock-active":"false","style":{"top":"94px"}},"children":[{"tag":"div","props":{"className":"life-ad-dock","hidden":true},"children":[{"tag":"aside","props":{"className":"life-ad-space life-ad-space-sponsored life-ad-space-compact","data-ad-placement":"ad_dock","data-ad-group":"reading","data-ad-creative":"read_product","data-ad-ready":"false","aria-label":"Quảng cáo · Giới thiệu cộng đồng"},"children":[{"tag":"button","props":{"type":"button","className":"life-ad-dismiss","aria-label":"Đóng quảng cáo"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-x","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M18 6 6 18"},"children":[]},{"tag":"path","props":{"d":"m6 6 12 12"},"children":[]}]}]},{"tag":"div","props":{"className":"life-ad-space-brand"},"children":[{"tag":"img","props":{"src":"/sites/howtolivebetter/images/shengcai/logo.png","width":"565","height":"144","alt":"Logo chính thức của Shengcai Youshu","decoding":"async"},"children":[]}]},{"tag":"div","props":{"className":"life-ad-space-copy"},"children":[{"tag":"span","props":{"className":"life-ad-space-label"},"children":["Quảng cáo · Giới thiệu cộng đồng"]},{"tag":"strong","props":{},"children":["Kiến thức bạn có thể thành sản phẩm hữu ích không?"]},{"tag":"p","props":{},"children":["Từ sách điện tử đến công cụ nhỏ: xem cách thành viên tìm nhu cầu và biến kiến thức thành thứ dùng được."]}]},{"tag":"div","props":{"className":"life-ad-space-actions"},"children":[{"tag":"a","props":{"className":"life-ad-space-link","href":"/vi/shengcaiyoushu?sc_group=reading&sc_creative=read_product&sc_placement=ad_dock"},"children":["Xem cộng đồng và các ví dụ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"18","height":"18","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-up-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M7 7h10v10"},"children":[]},{"tag":"path","props":{"d":"M7 17 17 7"},"children":[]}]}]}]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/vi/book/13"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"Quay lại mục lục"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["Tình huống khẩn cấp: làm gì trước"]},{"tag":"div","props":{"data-ad-dock-host":"true"},"children":[]},{"tag":"nav","props":{"aria-label":"Các mục trong chương"},"children":[{"tag":"a","props":{"href":"/vi/tip/13-01"},"children":[{"tag":"span","props":{},"children":["01"]},"Người ngã xuống đất không thở: ấn thật mạnh vào giữa ngực ngay, bảo người bên cạnh gọi 120 và tìm máy AED"]},{"tag":"a","props":{"href":"/vi/tip/13-02"},"children":[{"tag":"span","props":{},"children":["02"]},"Người cao tuổi ngã hoặc ai đó nằm gục: ngồi xuống gọi họ, gọi 120 ở Trung Quốc, đừng vội đỡ dậy; với người lạ, bỏ đi ở Trung Quốc cũng hợp pháp, đã dừng thì đừng tự di chuyển họ"]},{"tag":"a","props":{"href":"/vi/tip/13-03"},"children":[{"tag":"span","props":{},"children":["03"]},"Miệng lệch, một bên tay không có lực, nói không rõ: gọi 120 ngay, đừng chờ, đừng tự lái xe đi"]},{"tag":"a","props":{"href":"/vi/tip/13-04"},"children":[{"tag":"span","props":{},"children":["04"]},"Chóng mặt xoay tròn không đứng vững, nhìn thấy hai hình, một mắt tối đi, hoặc chỉ tay không trúng mũi mình: vẫn coi như đột quỵ và gọi 120"]},{"tag":"a","props":{"href":"/vi/tip/13-05"},"children":[{"tag":"span","props":{},"children":["05"]},"Một mắt tối đi đột ngột như kéo xuống rèm, dù chỉ vài phút rồi tự hết thì vẫn đi cấp cứu ngay trong ngày theo đường đột quỵ"]},{"tag":"a","props":{"href":"/vi/tip/13-06"},"children":[{"tag":"span","props":{},"children":["06"]},"Một mắt sưng đau, đỏ, nhìn đèn thấy một vòng cầu vồng, kèm đau đầu buồn nôn, nôn ói: đi cấp cứu mắt trong ngày"]},{"tag":"a","props":{"href":"/vi/tip/13-07"},"children":[{"tag":"span","props":{},"children":["07"]},"Đau tức ngực kiểu bóp nghẽn, khó thở, cứng ngực quá 15 phút không dịu: gọi 120, đừng chịu đựng và đừng tự lái xe"]},{"tag":"a","props":{"href":"/vi/tip/13-08"},"children":[{"tag":"span","props":{},"children":["08"]},"Đau dữ dội như bị xé toạc, lan từ ngực ra sau lưng và xuống thắt lưng: gọi 120 và nói rõ「cơn đau đang di chuyển」"]},{"tag":"a","props":{"href":"/vi/tip/13-09"},"children":[{"tag":"span","props":{},"children":["09"]},"Đột nhiên một cơn「đau đầu nặng nhất đời», trong vòng một giờ đã tới lúc đau nhất: đi cấp cứu ngay để chụp CT sọ"]},{"tag":"a","props":{"href":"/vi/tip/13-10"},"children":[{"tag":"span","props":{},"children":["10"]},"Người cao tuổi va đầu rồi hai ba tuần đến vài tháng sau mà đi loạng, uể oải, ngủ gật hoặc một bên không có lực: đi chụp CT sọ"]},{"tag":"a","props":{"href":"/vi/tip/13-11"},"children":[{"tag":"span","props":{},"children":["11"]},"Một chân sưng, căng, ấn vào thì đau: đi khám càng sớm càng tốt; thêm khó thở đột ngột hoặc đau ngực thì gọi 120 ngay"]},{"tag":"a","props":{"href":"/vi/tip/13-12"},"children":[{"tag":"span","props":{},"children":["12"]},"Máu chảy nhiều: dùng tay ấn thật chặt vào vết thương, tứ chi ấn không được thì dùng gar, đồng thời gọi 120"]},{"tag":"a","props":{"href":"/vi/tip/13-13"},"children":[{"tag":"span","props":{},"children":["13"]},"Bị chó, mèo cắn hoặc cào rách da: xịt xen kẽ nước xà phòng và nước chảy trong 15 phút, trong ngày đi tiêm vắc-xin"]},{"tag":"a","props":{"href":"/vi/tip/13-14"},"children":[{"tag":"span","props":{},"children":["14"]},"Bị bỏng: xả ngay bằng nước mát chảy trong 20 phút, đừng bôi kem đánh răng hay nước tương"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/vi/tip/13-15","data-status":"active"},"children":[{"tag":"span","props":{},"children":["15"]},"Nổi mề đay toàn thân, khó thở hoặc choáng váng: xử lý như sốc phản vệ, gọi 120 ngay và nói rõ chuyện gì"]},{"tag":"a","props":{"href":"/vi/tip/13-16"},"children":[{"tag":"span","props":{},"children":["16"]},"Người ta co giật rồi ngã xuống: dọn chỗ xung quanh, cho nằm nghiêng, nhìn đồng hồ đếm thời gian, không đưa gì vào miệng"]},{"tag":"a","props":{"href":"/vi/tip/13-17"},"children":[{"tag":"span","props":{},"children":["17"]},"Người bị tiểu đường đột nhiên run, đổ mồ hôi lạnh, nói không rõ: cho 15 gram đường trước, 15 phút sau đo lại"]},{"tag":"a","props":{"href":"/vi/tip/13-18"},"children":[{"tag":"span","props":{},"children":["18"]},"Người ta bị điện giật: cắt điện trước, rồi dùng gậy khô hay thứ gì tương tự gạp nguồn điện ra, tuyệt đối không kéo bằng tay"]},{"tag":"a","props":{"href":"/vi/tip/13-19"},"children":[{"tag":"span","props":{},"children":["19"]},"Báo động carbon monoxide kêu, hoặc cả nhà cùng đau đầu buồn nôn: ra ngoài trước rồi mới gọi"]},{"tag":"a","props":{"href":"/vi/tip/13-20"},"children":[{"tag":"span","props":{},"children":["20"]},"Uống nhầm chất tẩy rửa, thuốc trừ sâu, thuốc: đừng gây nôn, cầm theo chai vào viện ngay; dính vào mắt hoặc da thì xịt nhiều nước sạch ít nhất 15 phút"]},{"tag":"a","props":{"href":"/vi/tip/13-21"},"children":[{"tag":"span","props":{},"children":["21"]},"Hóa chất axít, bazơ bắn vào người: cởi ngay quần áo bị nhiễm, xịt nhiều nước sạch chảy, mắt thì kéo mí mắt ra xịt, xịt đủ thời gian rồi hãy đi"]},{"tag":"a","props":{"href":"/vi/tip/13-22"},"children":[{"tag":"span","props":{},"children":["22"]},"Chóng mặt, buồn nôn, không ra mồ hôi hoặc không tỉnh khi trời nóng: chuyển ngay ra chỗ mát, cởi áo quần xả nước để hạ nhiệt; người không tỉnh thì không cho uống nước, gọi 120"]},{"tag":"a","props":{"href":"/vi/tip/13-23"},"children":[{"tag":"span","props":{},"children":["23"]},"Người bị say nắng mà còn tỉnh: uống nhiều lần mỗi lần ít, nước muối loãng mát hoặc nước thể thao; đừng uống hùng hục, đừng uống rượu và đồ uống nhiều đường"]},{"tag":"a","props":{"href":"/vi/tip/13-24"},"children":[{"tag":"span","props":{},"children":["24"]},"Khi hoảng hoạt: bò sát đất, sờ cửa rồi mới mở, cửa nóng thì đừng mở, đi cầu thang chứ đừng đi thang máy, ra ngoài rồi đừng quay lại"]},{"tag":"a","props":{"href":"/vi/tip/13-25"},"children":[{"tag":"span","props":{},"children":["25"]},"Thấy có người đuối nước: gọi người và gọi 110/120, đưa gậy, thả vật nổi, bản thân đừng xuống nước"]},{"tag":"a","props":{"href":"/vi/tip/13-26"},"children":[{"tag":"span","props":{},"children":["26"]},"Người bị hóc không nói được: trên 1 tuổi thì đứng phía sau, vỗ lưng 5 lần rồi ép bụng 5 lần; ngã xuống thì hồi sức tim phổi"]},{"tag":"a","props":{"href":"/vi/tip/13-27"},"children":[{"tag":"span","props":{},"children":["27"]},"Lạc đường hoặc xe hỏng ở sa mạc Gobi, sa mạc, vùng không người ở: ở lại tại chỗ hoặc cạnh xe, báo vị trí trước, rồi tìm bóng mát và giữ ấm, tiết kiệm nước, đừng đi lang thang"]},{"tag":"a","props":{"href":"/vi/tip/13-28"},"children":[{"tag":"span","props":{},"children":["28"]},"Run, nói không rõ, đi lảo đảo là thân nhiệt tụt: thay quần áo ướt, quấn lại, làm ấm thân trước, uống đồ uống nóng có đường, không uống rượu"]},{"tag":"a","props":{"href":"/vi/tip/13-29"},"children":[{"tag":"span","props":{},"children":["29"]},"Bị rắn cắn: ngồi yên, tháo nhẫn và đồng hồ, đưa đi bệnh viện tiêm huyết thanh kháng nọc càng nhanh càng tốt; không rạch, không hút, không buộc chặt"]},{"tag":"a","props":{"href":"/vi/tip/13-30"},"children":[{"tag":"span","props":{},"children":["30"]},"Khi động đất, trước hết xem mình đang ở trong loại nhà nào: nhà xây đúng tiêu chuẩn chống chấn thì nằm tại chỗ, nhà cũ có thể sập và cửa cách vài bước thì ra ngoài"]},{"tag":"a","props":{"href":"/vi/tip/13-31"},"children":[{"tag":"span","props":{},"children":["31"]},"Gặp gấu, lợn rừng, đàn chó hoang thì đừng chạy, nghiêng người chậm rãi lùi ra"]},{"tag":"a","props":{"href":"/vi/tip/13-32"},"children":[{"tag":"span","props":{},"children":["32"]},"Gặp giông ngoài hoang dã: chui vào xe có nóc cứng hoặc vào công trình, tránh đường sống lưng, cây đứng một mình, mặt nước và kim loại"]},{"tag":"a","props":{"href":"/vi/tip/13-33"},"children":[{"tag":"span","props":{},"children":["33"]},"Lên cao nguyên thì tăng dần theo độ cao ngủ (đêm đó ngủ ở cao bao nhiêu); triệu chứng nặng thì hạ xuống, đừng gắng chịu"]},{"tag":"a","props":{"href":"/vi/tip/13-34"},"children":[{"tag":"span","props":{},"children":["34"]},"Bị ve cắn: dùng nhíp mỏm nhọn áp sát da rồi kéo ra thật đều, đừng bôi dầu, đừng đốt bằng lửa"]},{"tag":"a","props":{"href":"/vi/tip/13-35"},"children":[{"tag":"span","props":{},"children":["35"]},"Nước ngoài hoang dã thì cứ đun sôi rồi uống, sôi thêm một phút là đủ, không cần nấu lâu hơn vì ở cao"]},{"tag":"a","props":{"href":"/vi/tip/13-36"},"children":[{"tag":"span","props":{},"children":["36"]},"Bị người lạ đòi tiền ngoài hoang đương: đưa tiền cho họ, không ra tay, ghi nhớ đặc điểm, thoát ra thì báo công an"]},{"tag":"a","props":{"href":"/vi/tip/13-37"},"children":[{"tag":"span","props":{},"children":["37"]},"Gặp một nhóm đánh nhau: lùi ra rồi bỏ đi, đừng vào rách, đừng đứng xem, đừng nhặt đồ nằm trên mặt đất; nếu báo công an thì lùi tới khoảng cách an toàn rồi gọi 110"]},{"tag":"a","props":{"href":"/vi/tip/13-38"},"children":[{"tag":"span","props":{},"children":["38"]},"Có thể đã bị phơi nhiễm HIV: trong 72 giờ đi lấy thuốc ngăn chặn, càng sớm càng tốt"]},{"tag":"a","props":{"href":"/vi/tip/13-39"},"children":[{"tag":"span","props":{},"children":["39"]},"Cứu người mà bị thương, mất tiền: tìm người gây hại và bảo hiểm y tế trước, rồi đi khai báo hành động dũng cảm để được xác nhận"]},{"tag":"a","props":{"href":"/vi/tip/13-40"},"children":[{"tag":"span","props":{},"children":["40"]},"Dao, thép, kính đâm vào người: ấn cầm máu quanh vật lạ, đừng rút nó ra"]},{"tag":"a","props":{"href":"/vi/tip/13-41"},"children":[{"tag":"span","props":{},"children":["41"]},"Nghi gãy xương thì đừng cử động chỗ đó nữa, đỡ cho yên, chườm lạnh không quá 20 phút, đừng tự bẻ lại"]},{"tag":"a","props":{"href":"/vi/tip/13-42"},"children":[{"tag":"span","props":{},"children":["42"]},"Sau khi bị cưỡng ép tình dục: tới nơi an toàn rồi gọi 110; trước khi khám lạm dụng thì đừng tắm, đừng giặt quần áo, đừng dọn phòng, trong 72 giờ hãy tới bệnh viện"]},{"tag":"a","props":{"href":"/vi/tip/13-43"},"children":[{"tag":"span","props":{},"children":["43"]},"Trẻ sơ sinh dưới 1 tuổi bị nghẽn khóc không ra tiếng: úp sấp xuống vỗ lưng 5 cái, lật lại ấn ngực 5 cái, làm xen kẽ, đừng ấn bụng"]},{"tag":"a","props":{"href":"/vi/tip/13-44"},"children":[{"tag":"span","props":{},"children":["44"]},"Trẻ sơ sinh dưới 1 tuổi không phản ứng, thở không bình thường: bật loa ngoài gọi 120, làm hồi sinh tim phổi trẻ sơ sinh: ấn 30 cái thổi 2 hơi"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"Breadcrumbs"},"children":[{"tag":"a","props":{"href":"/vi/book"},"children":["Khám phá cuốn sách"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/vi/book/13"},"children":["Chương 13"," ·"," ","Tình huống khẩn cấp: làm gì trước"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"13-15"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["15"]},{"tag":"span","props":{"className":"life-evidence grade-b（指南强推荐，但底层证据等级低）"},"children":["Bằng chứng"," ","B（指南强推荐，但底层证据等级低）"]}]},{"tag":"h1","props":{"lang":"vi"},"children":["Nổi mề đay toàn thân, khó thở hoặc choáng váng: xử lý như sốc phản vệ, gọi 120 ngay và nói rõ chuyện gì"]},{"tag":"p","props":{"lang":"vi","className":"life-entry-summary"},"children":["Đột nhiên nổi mề đay toàn thân, kèm khó thở hoặc choáng váng, thì xử lý như sốc phản vệ. Gọi 120 ngay, nói thẳng「怀疑过敏性休克」 — nghi ngờ sốc phản vệ — và bảo xe cứu thương mang adrenaline đến. Thuốc chống dị ứng và hormone tác dụng chậm, không thay được adrenaline. Người đã từng bị thì xin bác sĩ kê bút tiêm tự động, tiêm vào phần giữa phía ngoài đùi, xuyên qua cả quần vẫn tiêm được."]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Chi phí"]},{"tag":"p","props":{},"children":["Không tốn tiền. Người đã biết mình dị ứng nặng thì phải tố…"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Lợi ích"]},{"tag":"p","props":{},"children":["Adrenaline là thuốc lựa chọn đầu tiên (thuốc tuyến một) cho sốc phản vệ mức II trở lên, và hướng dẫn xếp nó là…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"Đánh dấu: Nổi mề đay toàn thân, khó thở hoặc choáng váng: xử lý như sốc phản vệ, gọi 120 ngay và nói rõ chuyện gì"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"Hoàn tất"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"Kế hoạch thực hiện"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"Lưu"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Chia sẻ mẹo này"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Ẩn chi tiết"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Chi phí"]},{"tag":"p","props":{},"children":["Không tốn tiền. Người đã biết mình dị ứng nặng thì phải tốn tiền mua bút adrenaline, và đó là thuốc kê đơn."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Lợi ích"]},{"tag":"p","props":{},"children":["Adrenaline là thuốc lựa chọn đầu tiên (thuốc tuyến một) cho sốc phản vệ mức II trở lên, và hướng dẫn xếp nó là khuyến cáo mạnh. Thuốc chống dị ứng và hormone tác dụng chậm, không đứng được chỗ của nó"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Nguồn gốc"]},{"tag":"p","props":{"className":"life-citations"},"children":["中国医药教育协会等 (2022). 过敏性休克急救临床实践指南（2020）. Frontiers in Pharmacology：「Epinephrine is the first-line medicine in GRADE II to IV anaphylaxis」「Intramuscular epinephrine should be injected in the mid-anterolateral thigh」，成人肌注上限 0.5 mg、14 岁以下 0.3 mg，无反应可每 5–15 分钟重复一次. ",{"tag":"a","props":{"href":"https://doi.org/10.3389/fphar.2022.845689","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.3389/fphar.2022.845689"]},"；Muraro A, et al. (2022). EAACI guidelines: Anaphylaxis (2021 update). Allergy. ",{"tag":"a","props":{"href":"https://doi.org/10.1111/all.15032","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1111/all.15032"]}]},{"tag":"a","props":{"href":"https://doi.org/10.3389/fphar.2022.845689","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Liên kết mở nguồn"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Ghi chú sách"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["Bản hướng dẫn dị ứng này (EAACI) tự viết rằng trong lĩnh vực đó「证据大多停留在很低的等级」 — bằng chứng phần lớn dừng ở mức rất thấp. Nó xếp khuyến cáo mạnh vì lợi ích lớn hơn rủi ro nhiều, không phải vì có thử nghiệm lớn. Adrenaline ở Trung Quốc là thuốc kê đơn, người thường không có trong tay. Việc làm được là gọi 120, nói「怀疑过敏性休克」 — nghi ngờ sốc phản vệ — và bảo xe cứu thương mang thuốc đến. Người đã từng dị ứng nặng thì xin bác sĩ kê bút tiêm tự động, và học cách tiêm vào phần giữa phía ngoài đùi (phía ngoại, hơi chếch trước), xuyên qua cả quần vẫn tiêm được."]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Ghi chú của tôi"]},{"tag":"button","props":{"type":"button"},"children":["Viết một lời nhắc cho chính bạn…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/vi/tip/13-14"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Trước"]},"Bị bỏng: xả ngay bằng nước mát chảy trong 20 phút, đừng bôi kem đánh răng hay nước tương"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/vi/tip/13-16"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Tiếp theo"]},"Người ta co giật rồi ngã xuống: dọn chỗ xung quanh, cho nằm nghiêng, nhìn đồng hồ đếm thời gian, không đưa gì vào miệng"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["Thêm trong chủ đề này"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/13-11"},"children":[{"tag":"strong","props":{},"children":["Một chân sưng, căng, ấn vào thì đau: đi khám càng sớm càng tốt; thêm khó thở đột ngột hoặc đau ngực thì gọi 120 ngay"]},{"tag":"span","props":{},"children":["Một chân sưng đột 