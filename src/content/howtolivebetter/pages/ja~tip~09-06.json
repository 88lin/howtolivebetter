hevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["費用・手間"]},{"tag":"p","props":{},"children":["費用はかかりません。直接拒否してください。身分証明書や自身の信用情報を他人に貸さないこと、内容を確認していない融資契約書には署名しないこと、そして他人のために銀行での対面署名手続きを行わないことが重要です。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["効果"]},{"tag":"p","props":{},"children":["詐欺の手口を用いて、銀行またはその他の金融機関から融資、手形引受、信用状、保証状などを取得する行為。銀行またはその他の金融機関に重大な損失を与えた場合、3 年以下の懲役。併科または単科の罰金が科される。刑罰とともに罰金が科される場合もあれば、罰金のみの場合もある。特別に重大な損失を与えた場合、またはその他の特別に重大な情状がある場合は、3 年から 7 年の懲役および罰金。警察が立件・捜査を開始する基準は、直接的な経済損失が 50 万元以上である。返済の意思がない状態で、捏造した資金導入プロジェクトの理由、偽の経済契約、偽の証明書類、または偽の権利証明を用いて融資を詐取する行為は、融資詐欺罪に該当する。この項目については、5 万元の詐取で立件され、5 年以下の懲役および 2 万から 20 万元の罰金が科される。金額が多額であるか、その他重大な情状がある場合は、5年から10年の懲役、特に多額である場合は10年以上の懲役から無期懲役とする。国家機関の公文書、証明書、印章を偽造、改ざん、または売買した場合は、3年以下の懲役とし、情状が重い場合は3年から10年の懲役とする。検察の事例：126人のグループが、16の省・市において、無職の人々を「優良顧客」として偽装し、80箇所以上の銀行支店で3000万元余りの融資詐欺を行った。融資を受ける「白戸（信用履歴のない人）」は、融資額の3割の報酬を受け取っていた。検察は105名の「白戸」を訴追した。2026年の第一審で判決が下された80人のうち、76人は融資詐欺罪により、1年4ヶ月から6年6ヶ月の懲役および罰金刑に処された。また、4 人が犯罪グループの現金引き出しを代行したとして、貸金詐欺罪およびマネーロンダリング罪などの数罪併合（複数の罪を合算して刑期を算定）により、全国で 2 年 4 ヶ月から 7 年 6 ヶ月の判決を受けました（4 人）。本条の貸金詐欺罪については、刑法修正案（十一）の 2021 年 3 月以降の条文に基づいています。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["出典"]},{"tag":"p","props":{"className":"life-citations"},"children":["全国人大常委会 (2020). 刑法修正案（十一）（第十一条，修改刑法第一百七十五条之一）. ",{"tag":"a","props":{"href":"https://www.spp.gov.cn/spp/fl/202012/t20201227_503700.shtml","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.spp.gov.cn/spp/fl/202012/t20201227_503700.shtml"]},"；全国人大 (1997). 刑法（第八十八、一百九十三、二百八十条）. ",{"tag":"a","props":{"href":"https://www.spp.gov.cn/spp/fl/201802/t20180206_364975.shtml","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.spp.gov.cn/spp/fl/201802/t20180206_364975.shtml"]},"；最高人民检察院、公安部 (2022). 关于公安机关管辖的刑事案件立案追诉标准的规定（二）（第二十二、四十五条）. ",{"tag":"a","props":{"href":"https://www.spp.gov.cn/spp/xwfbh/wsfbt/202204/t20220429_555906.shtml","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.spp.gov.cn/spp/xwfbh/wsfbt/202204/t20220429_555906.shtml"]},"；最高人民检察院 (2026). 骗贷流水线背后藏洗钱黑手（检察日报）. ",{"tag":"a","props":{"href":"https://www.spp.gov.cn/spp/zdgz/202604/t20260428_726494.shtml","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.spp.gov.cn/spp/zdgz/202604/t20260428_726494.shtml"]},"；全国人大常委会 (2012). 出境入境管理法（第十二条）. ",{"tag":"a","props":{"href":"https://www.nia.gov.cn/n741440/n741547/c1013311/content.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.nia.gov.cn/n741440/n741547/c1013311/content.html"]},"（国家移民管理局）；全国人大常委会 (2023 修正). 民事诉讼法（第二百六十六条）. ",{"tag":"a","props":{"href":"https://amr.guizhou.gov.cn/zwgk/xxgkml/jcxxgk/zcfg/fl/202401/t20240129_83645867.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://amr.guizhou.gov.cn/zwgk/xxgkml/jcxxgk/zcfg/fl/202401/t20240129_83645867.html"]},"（贵州省市场监管局转载）"]},{"tag":"a","props":{"href":"https://www.spp.gov.cn/spp/fl/202012/t20201227_503700.shtml","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["出典を開く"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["著者の注記"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["「当時は返済するつもりだった」という言葉は、あの事件では採用されませんでした。検察当局の調査により、これらの人物は仕事がなく、固定資産も持たず、そもそも返済する能力がなく、分配された金もすべて使い果たしていることが判明しており、これに基づき、当初から返済の意思がなかったと認定されました。グループのために金を引き出した者は、別途マネーロンダリング罪に問われる可能性もあります。金が誰の名義で貸し出され、契約書に誰が署名したかによって、その人が借入人となります。たとえ犯罪が成立しないとしても、この債務と信用情報の記録は本人のものです。金を持って海外へ逃げたとしても、解決にはなりません。立件された後に逃亡しても、何年経っても追及は可能です。刑期が終了していない者、あるいは現在犯罪容疑者や被告人として扱われている者は、出国が禁止されています。民事訴訟が未解決の場合、裁判所は出国の禁止を命じることができ、債務者が義務を履行していない場合も、裁判所は出国制限を行うことができます。他人のための現金引き出しや送金については、本節の第 5 条（「副業」として自分のカードで代金を受け取るよう指示されるケース）を参照してください。また、自分の名義がなりすましローンに利用された場合の発見方法については、第 8 節の第 9 条を参照してください。"]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["自分のメモ"]},{"tag":"button","props":{"type":"button"},"children":["自分へのメモを書く…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/ja/tip/09-05"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["前へ"]},"「副業」として自分のカードで入金、出金、送金を行うよう指示される案件、どんなに報酬が高くても断ること"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/ja/tip/09-07"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["次へ"]},"拾得銀行カードをそのままにせず、携帯電話や財布を拾った際は持ち去らず、持ち主に連絡するか警察に届ける"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["このテーマの他の提案"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/09-02"},"children":[{"tag":"strong","props":{},"children":["英烈を侮辱する画像、絵文字、コメントを投稿・転送しないこと。国旗や国歌をネタにしないこと。"]},{"tag":"span","props":{},"children":["英烈、国旗、国歌をネタにした場合、軽度な場合は 5 日から 10 日の拘留、または 1000 元から 3000 元の罰金が科せられます。よ…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/09-03"},"children":[{"tag":"strong","props":{},"children":["海外サイトの内容は見た後に閉じるだけ。スクリーンショットも、転送も、グループへの持ち込みも、コメント欄での追随もせず。"]},{"tag":"span","props":{},"children":["これらの法条が罰するのは「外部への伝播」であり、「閲覧」を罰するものではありません。転送、グループへの持ち込み、コメント欄での追随は、捜査…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/09-04"},"children":[{"tag":"strong","props":{},"children":["アダルト動画は個人で楽しむ分には自由ですが、グループ内に投稿したり、「素材」を販売したり、グループを作成したりしないでください。"]},{"tag":"span","props":{},"children":["個人で視聴すること自体は罰則の対象に含まれません。グループ内に一度でも投稿すれば、グループ全体への拡散とみなされ、10日から15日の拘留、…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/09-08"},"children":[{"tag":"strong","props":{},"children":["特典は自身の真の身分で受け取る。仮想番号による大量のサブアカウント登録や、脆弱性を利用した繰り返し取得は行わない"]},{"tag":"span","props":{},"children":["自身の真の身分を用い、一つのアカウントで一度だけクーポンを受け取ることは、処罰の範囲には含まれません。偽ユーザーを大量に登録し、自分で注文…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/09-09"},"children":[{"tag":"strong","props":{},"children":["バルコニーや窓からいかなる物も投げ出さない。吸い殻、ゴミ袋、酒瓶もすべて対象"]},{"tag":"span","props":{},"children":["階下へ物を投げ捨てる行為は、人に当たらない場合でも 5 日の拘留および 1000 元の罰金が科せられ、悪質な場合は 10 日から 15 日…"]