ldren":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Ẩn chi tiết"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Chi phí"]},{"tag":"p","props":{},"children":["Phí khám và phí kính từ mấy chục tới mấy trăm tệ. Sau khi nhỏ mắt, trẻ sợ ánh sáng và nhìn gần bị mờ, phải nửa ngày đến một hai ngày mới hết."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Lợi ích"]},{"tag":"p","props":{},"children":["《Mười điểm cốt lõi về phòng và kiểm soát cận thị ở trẻ em và thanh thiếu niên》《防控儿童青少年近视核心知识十条》giải thích rõ khám khúc xạ sau khi nhỏ mắt là gì. Trước tiên dùng thuốc làm liệt cơ thần kinh thị giác, rồi đo khúc xạ. Thuốc làm liệt cơ thần kinh thị giác là thuốc nhỏ mắt làm cơ điều tiêu trong mắt thả lỏng. Khám khúc xạ sau khi nhỏ mắt là đo khúc xạ bằng y học tại bệnh viện, là「tiêu chuẩn vàng」để chẩn đoán cận thị (cách chính xác nhất). Thuốc nhỏ mắt không gây tổn thương cho con mắt khỏe mạnh, sau khi dùng có thể xuất hiện tạm thời sợ ánh sáng và nhìn gói không rõ, ngừng thuốc là trở lại bình thường. Đã chẩn đoán cận thị thì phải can thiệp khoa học kịp thời, đeo kính và các cách khác để nắn chỉnh. Đeo kính đúng số có thể nắn chỉnh hiệu quả tình trạng nhìn mờ và làm chậm tiến trình cận thị. Người đeo kính mà thị lực bình thường thì trẻ mẫu giáo và học sinh tiểu học tái khám mỗi 3 đến 6 tháng một lần, học sinh trung học và trung học phổ thông tái khám mỗi 6 đến 12 tháng một lần, tuỳ tình hình cụ thể mà quyết định có đổi kính hay không. Trẻ em ở độ tuổi 1 đến 3, 4 đến 6, và sau 7 tuổi nên được khám khúc xạ định kỳ (đo độ), theo dõi dự trữ thị lực còn lại (toàn quốc, ban hành tháng 7 năm 2023)"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Nguồn gốc"]},{"tag":"p","props":{"className":"life-citations"},"children":["国家卫生健康委办公厅 (2023). 防控儿童青少年近视核心知识十条（国卫办妇幼函〔2023〕278 号）. ",{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/202307/content_6894284.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/zhengce/zhengceku/202307/content_6894284.htm"]}]},{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/202307/content_6894284.htm","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Liên kết mở nguồn"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Ghi chú sách"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["Để mức B là vì đây là cách làm do tài liệu phổ biến chính thức đưa ra, không phải nghiên cứu gốc có số liệu cụ thể. Cận thị nặng sẽ kéo theo những bệnh như bong võng mạc, nên tái khám không chỉ để đổi kính. Kết quả「nhìn kém」trong khám sức khoẻ học sinh chỉ là kết quả sàng lọc ban đầu, vẫn còn mang con đi bệnh viện làm một lần khám mắt đầy đủ, xem mục 7 của phần này."]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Ghi chú của tôi"]},{"tag":"button","props":{"type":"button"},"children":["Viết một lời nhắc cho chính bạn…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/vi/tip/30-11"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Trước"]},"Con không chịu nổi thì có thể xin nghỉ học, trường bắt buộc giữ học vị cho cháu, tối đa 1 năm"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/vi/tip/30-13"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Tiếp theo"]},"Sau khi răng cối chính mọc lên thì làm hàn khe răng"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h