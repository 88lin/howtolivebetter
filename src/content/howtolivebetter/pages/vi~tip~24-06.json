"a","props":{"href":"/vi/tip/24-04"},"children":[{"tag":"strong","props":{},"children":["Trước khi đi khám chữa bệnh ở tỉnh khác, hỏi một câu ở nơi bạn đang sống, tính cần thiết về nguyên tắc phải có bác sĩ phó trưởng khoa đánh giá"]},{"tag":"span","props":{},"children":["Có đi khám chữa bệnh ở nơi khác hay không, về nguyên tắc do bác sĩ ph…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/24-08"},"children":[{"tag":"strong","props":{},"children":["Không có tiền, không có giấy tờ, không nói rõ mình là ai, cấp cứu vẫn phải cứu trước"]},{"tag":"span","props":{},"children":["Nhà nước có một quỹ cứu hộ khẩn cấp khi bệnh, dùng riêng để trả chi p…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/24-09"},"children":[{"tag":"strong","props":{},"children":["Giám định thương tật phải đợi điều trị kết thúc rồi hãy làm, làm sớm thì cấp độ bị chấp thấp"]},{"tag":"span","props":{},"children":["Đền bao nhiêu phần lớn tùy cấp độ được xếp, còn cấp độ thì tùy còn lạ…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/24-10"},"children":[{"tag":"strong","props":{},"children":["Sau khi chữa xong mà thật sự còn tổn thương chức năng, đi tới hội liên hiệp người khuyết tật cấp huyện nơi có hộ khẩu để xin giấy chứng nhận người khuyết tật"]},{"tag":"span","props":{},"children":["Giấy chứng nhận người khuyết tật là ngưỡng để nhận các chế độ dành ch…"]}]}]}]},{"tag":"a","props":{"className":"life-text-link","href":"/vi/book/24"},"children":["Đọc toàn bộ chủ đề: Khám bệnh: tốn ít tiền hơn và đi lại ít hơn"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"15","height":"15","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]}]}]