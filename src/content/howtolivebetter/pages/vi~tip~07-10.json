":[{"tag":"span","props":{},"children":["05"]},"Tìm việc thì dùng dịch vụ việc làm công cộng miễn phí và thị trường việc lẻ trước, đừng qua môi giới thu phí"]},{"tag":"a","props":{"href":"/vi/tip/07-06"},"children":[{"tag":"span","props":{},"children":["06"]},"Gặp biến cố đột ngột thì xin trợ cấp tạm thời trước"]},{"tag":"a","props":{"href":"/vi/tip/07-07"},"children":[{"tag":"span","props":{},"children":["07"]},"Thu nhập thấp hơn mức trợ cấp người có thu nhập thấp ở địa phương thì xin trợ cấp người có thu nhập thấp"]},{"tag":"a","props":{"href":"/vi/tip/07-08"},"children":[{"tag":"span","props":{},"children":["08"]},"Người có giấy chứng nhận người khuyết tật thì đi xin hai khoản trợ cấp cho người khuyết tật"]},{"tag":"a","props":{"href":"/vi/tip/07-09"},"children":[{"tag":"span","props":{},"children":["09"]},"Đừng để bảo hiểm y tế cư dân bị đứt quãng mỗi năm 400 tệ, hộ khó khăn được miễn giảm"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/vi/tip/07-10","data-status":"active"},"children":[{"tag":"span","props":{},"children":["10"]},"Mắc bệnh nặng thì đi theo bảo hiểm y tế, bảo hiểm bệnh nan y, trợ cấp y tế và đăng ký khám ngoài tỉnh trước, đừng đụng vào vay tiền trên mạng"]},{"tag":"a","props":{"href":"/vi/tip/07-11"},"children":[{"tag":"span","props":{},"children":["11"]},"Mất thẻ căn cước thì đi làm lại ngay, gấp thì xin thẻ tạm trước"]},{"tag":"a","props":{"href":"/vi/tip/07-12"},"children":[{"tag":"span","props":{},"children":["12"]},"Làm xong đăng ký thất nghiệp thì hãy xin công nhận là người khó khăn việc làm, để nhận trợ cấp bảo hiểm xã hội hoặc làm công việc công ích"]},{"tag":"a","props":{"href":"/vi/tip/07-13"},"children":[{"tag":"span","props":{},"children":["13"]},"Trong thời gian thất nghiệp thì đi nhận trợ cấp đào tạo nghề, trợ cấp thực tập việc làm và trợ cấp bảo hiểm xã hội, đừng tự bỏ tiền học khóa"]},{"tag":"a","props":{"href":"/vi/tip/07-14"},"children":[{"tag":"span","props":{},"children":["14"]},"Tìm việc đừng chỉ nộp hồ sơ, hãy dùng cách có hệ thống: học kỹ thuật, đặt mục tiêu, nhờ người khác giúp"]},{"tag":"a","props":{"href":"/vi/tip/07-15"},"children":[{"tag":"span","props":{},"children":["15"]},"Không nộp tiền cọc, không giữ giấy tờ, không ký「培训贷」, không vào đa cấp, không vay lãi cao"]},{"tag":"a","props":{"href":"/vi/tip/07-16"},"children":[{"tag":"span","props":{},"children":["16"]},"Khó ở nhà thì xếp hàng chờ nhà ở công lập trước"]},{"tag":"a","props":{"href":"/vi/tip/07-17"},"children":[{"tag":"span","props":{},"children":["17"]},"Ép chi phí ở và ăn xuống mức thấp nhất: thuê chung theo tháng thay vì thuê theo ngày, tự nấu ăn và bếp ăn trợ giúp thay cho đồ ăn giao"]},{"tag":"a","props":{"href":"/vi/tip/07-18"},"children":[{"tag":"span","props":{},"children":["18"]},"Bảo hiểm xã hội đứt quãng thì đừng hoảng: lương hưu tính theo số năm tích luỹ, bảo hiểm y tế nộp bù theo quy định"]},{"tag":"a","props":{"href":"/vi/tip/07-19"},"children":[{"tag":"span","props":{},"children":["19"]},"Từng vào tù, từng phá sản, từng bị đưa vào danh sách không thi hành án, pháp luật vẫn còn đường bắt đầu lại, trước hết làm hết thủ tục"]},{"tag":"a","props":{"href":"/vi/tip/07-20"},"children":[{"tag":"span","props":{},"children":["20"]},"Trước khi mắc bệnh nặng, ngoài bảo hiểm y tế cơ bản thì mua một bảo hiểm y tế hoặc bảo hiểm bệnh hiểm nặng hạn một năm, và đọc kỹ bốn chữ「保证续保」"]},{"tag":"a","props":{"href":"/vi/tip/07-21"},"children":[{"tag":"span","props":{},"children":["21"]},"Thật sự không có chỗ ngủ, nơi mở cửa 24 giờ chỉ cứu vãn được một đêm, ưu tiên đến trạm cứu hộ"]},{"tag":"a","props":{"href":"/vi/tip/07-22"},"children":[{"tag":"span","props":{},"children":["22"]},"Bị nợ lương công nhân, trước hết phân biệt ai là người thuê bạn"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"Breadcrumbs"},"children":[{"tag":"a","props":{"href":"/vi/book"},"children":["Khám phá cuốn sách"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/vi/book/07"},"children":["Chương 7"," ·"," ","Sống thế nào khi hết tiền"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"07-10"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["10"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["Bằng chứng"," ","A"]}]},{"tag":"h1","props":{"lang":"vi"},"children":["Mắc bệnh nặng thì đi theo bảo hiểm y tế, bảo hiểm bệnh nan y, trợ cấp y tế và đăng ký khám ngoài tỉnh trước, đừng đụng vào vay tiền trên mạng"]},{"tag":"p","props":{"lang":"vi","className":"life-entry-summary"},"children":["Thứ tự là cố định. Trước khi nằm viện ở tỉnh khác thì đăng ký trong tài khoản WeChat của Cục Quản lý bảo hiểm y tế quốc gia, ra viện là quyết toán thẳng, không phải ứng trước toàn bộ. Hoàn trả xong mà bạn vẫn không đủ thì xin trợ cấp y tế ở chính quyền xã, thị trấn hoặc văn phòng đại diện khu phố. Đang làm việc thì tuổi công quyết định thời gian nghỉ chữa bệnh, từ 3 đến 24 tháng, trong thời gian đó công ty không được sa thải bạn. Đừng vay tiền trên mạng và đừng vay tiền lãi cao ngoài ngân hàng."]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Chi phí"]},{"tag":"p","props":{},"children":["Không tốn tiền. Thứ tự là cố định, làm từng bước một. Bước…"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Lợi ích"]},{"tag":"p","props":{},"children":["Nhà nước gộp bảo hiểm y tế cơ bản, bảo hiểm bệnh nan y và trợ cấp y tế lại gọi là「ba lớp chế độ」, đỡ từng lớp…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"Đánh dấu: Mắc bệnh nặng thì đi theo bảo hiểm y tế, bảo hiểm bệnh nan y, trợ cấp y tế và đăng ký khám ngoài tỉnh trước, đừng đụng vào vay tiền trên mạng"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"Hoàn tất"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"Kế hoạch thực hiện"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"Lưu"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Chia sẻ mẹo này"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Ẩn chi tiết"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Chi phí"]},{"tag":"p","props":{},"children":["Không tốn tiền. Thứ tự là cố định, làm từng bước một. Bước một, trước khi nằm viện ở tỉnh khác, đăng ký qua tiện ích nhỏ「国家异地就医备案」trong tài khoản WeChat chính thức của Cục Quản lý bảo hiểm y tế quốc gia. Bước hai, quyết toán thẳng khi ra viện. Bước ba, sau khi bảo hiểm hoàn trả mà phần bạn tự bỏ ra vẫn quá nặng, thì xin trợ cấp y tế ở chính quyền xã, thị trấn hoặc văn phòng đại diện khu phố. Bước bốn, đang làm việc thì xin nghỉ bệnh theo thời gian nghỉ chữa bệnh, tức khoảng thời gian nghỉ làm vì bệnh mà không bị sa thải; thuộc tai nạn lao động thì đi theo bảo hiểm tai nạn lao động. Bước năm, không trả nổi thẻ tín dụng thì chủ động tìm ngân hàng thương lượng trả góp. Bước sáu, thật sự không đủ thì mới lên nền tảng cầu viện tư nhân do Bộ Dân vụ chỉ định để quyên góp. Hồ sơ chủ yếu là giấy chẩn đoán, bảng chi phí và phiếu quyết toán, phải chạy 2 đến 4 chuyến. Khó ở chỗ đang nằm bệnh mà vẫn phải chạy từng chuyến làm thủ tục."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Lợi ích"]},{"tag":"p","props":{},"children":["Nhà nước gộp bảo hiểm y tế cơ bản, bảo hiểm bệnh nan y và trợ cấp y tế lại gọi là「ba lớp chế độ」, đỡ từng lớp xuống dưới. Người thuộc diện trợ cấp người có thu nhập thấp và người khó khăn đặc biệt, phần chi phí khám chữa hợp quy định được trợ cấp ở mức không thấp hơn 70%. Người mắc bệnh nặng vốn không nghèo mà chữa bệnh thì nghèo, có thể tự mình đề nghị trợ cấp thêm. Đăng ký trước khi nằm viện ở tỉnh khác thì ra viện quyết toán thẳng, không phải ứng trước toàn bộ rồi về nơi tham gia bảo hiểm mà hoàn trả. Nghỉ làm vì bệnh có thời gian nghỉ chữa bệnh từ 3 đến 24 tháng, cụ thể bao lâu tùy tuổi công. Trong thời gian đó công ty không được chấm dứt hợp đồng lao động, tiền lương nghỉ bệnh không được thấp hơn 80% mức lương tối thiểu địa phương. Công nhân bị tai nạn lao động có thời gian nghỉ lương để chữa thương, tức khoảng thời gian chữa thương không đi làm, lương và phúc lợi cũ vẫn được trả như cũ, do đơn vị trả hàng tháng, thường không quá 12 tháng. Dư nợ thẻ tín dụng vượt khả năng trả mà bản thân vẫn muốn trả thì có thể thương lượng với ngân hàng một khoản trả góp theo nhu cầu, sắp lại kế hoạch trả nợ, dài nhất 5 năm, đã ký thỏa thuận thì ngân hàng phải ngừng đòi. Nền tảng cầu viện tư nhân quyên góp thay cho chính người đó phải được Bộ Dân vụ của Hội đồng Nhà nước chỉ định. Nền tảng phải xác minh thông tin cầu viện có thật không. Tiền quyên góp chỉ được chuyển cho chính người cầu viện, hoặc tài khoản do người đó cung cấp (toàn quốc)"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Nguồn gốc"]},{"tag":"p","props":{"className":"life-citations"},"children":["国务院办公厅 (2021). 关于健全重特大疾病医疗保险和救助制度的意见（国办发〔2021〕42 号）. ",{"tag":"a","props":{"href":"https://www.gov.cn/gongbao/content/2021/content_5659514.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/gongbao/content/2021/content_5659514.htm"]},"；国家医保局 (2025). 跨省异地就医如何直接报销？. ",{"tag":"a","props":{"href":"https://www.nhsa.gov.cn/art/2025/3/16/art_14_16010.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.nhsa.gov.cn/art/2025/3/16/art_14_16010.html"]},"；劳动部 (1994). 企业职工患病或非因工负伤医疗期规定（劳部发〔1994〕479 号，第二、三条）. ",{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/2022-08/31/content_5711269.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/zhengce/2022-08/31/content_5711269.htm"]},"；劳动部 (1995). 关于贯彻执行《劳动法》若干问题的意见（劳部发〔1995〕309 号，第 59 条）. ",{"tag":"a","props":{"href":"http://hrss.jl.gov.cn/ldgx/ldyggl/201608/t20160824_2401358.html","target":"_blank","rel":"noopener noreferrer"},"children":["http://hrss.jl.gov.cn/ldgx/ldyggl/201608/t20160824_2401358.html"]},"（吉林省人社厅转载）；国务院 (2010 修订). 工伤保险条例（国务院令第 586 号，第三十、三十三条）. ",{"tag":"a","props":{"href":"https://www.gov.cn/gongbao/content/2011/content_1778064.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/gongbao/content/2011/content_1778064.htm"]},"；银监会 (2011). 商业银行信用卡业务监督管理办法（银监会令 2011 年第 2 号，第七十条）. ",{"tag":"a","props":{"href":"https://www.gov.cn/gongbao/content/2011/content_1893974.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/gongbao/content/2011/content_1893974.htm"]},"；全国人大常委会 (2023). 关于修改慈善法的决定（第一百二十四条）. ",{"tag":"a","props":{"href":"https://www.gov.cn/yaowen/liebiao/202312/content_6923390.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/yaowen/liebiao/202312/content_6923390.htm"]},"；民政部等五部门 (2024). 个人求助网络服务平台管理办法（令第 75 号，第三、十一、十三、十七条）. ",{"tag":"a","props":{"href":"https://www.gov.cn/gongbao/2024/issue_11646/202410/content_6980857.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/gongbao/2024/issue_11646/202410/content_6980857.html"]}]},{"tag":"a","props":{"href":"https://www.gov.cn/gongbao/content/2021/content_5659514.htm","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Liên kết mở nguồn"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Ghi chú sách"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["Trợ cấp y tế hoàn trả bao nhiêu phần trăm, một năm nhiều nhất bao nhiêu, thì nơi bạn tham gia bảo hiểm tự quy định. Thời gian nghỉ chữa bệnh chia sáu bậc, tuỳ bạn đã làm việc tổng cộng bao nhiêu năm và ở đơn vị này bao nhiêu năm. Thời gian nghỉ chữa bệnh hết thì công ty có thể hợp pháp chấm dứt hợp đồng, nên xem trước mình đang ở bậc nào. Người được cấp cứu cũng nằm trong danh sách phải đăng ký. Trang của Cục Quản lý bảo hiểm y tế quốc gia không nói cấp cứu có tính là đăng ký tự động không, có bổ sung sau được không, hãy gọi hỏi nơi bạn tham gia bảo hiểm. Đừng vay tiền trên mạng và đừng vay tiền lãi cao ngoài ngân hàng. Tòa chỉ bảo vệ tới mức bằng 4 lần LPR kỳ hạn một năm (đừng vay tiền lãi cao, xem mục 15). Phần vượt mức đó không được bảo vệ, vốn vẫn phải trả đầy đủ. Nằm giường bệnh cũng không có sức để đánh kiện loại đó. Bệnh nặng do tai nạn lại là chuyện khác: không có tiền vẫn phải gọi 120, bệnh viện không được từ chối, đẩy trách nhiệm hoặc chậm trễ cứu chữa, phần cấp cứu ấy do quỹ trợ cấp khẩn cấp khi bệnh chi trả, xem mục 8 ở phần 24 (cấp cứu cũng phải cứu trước). Trang nguyên văn công văn 309 năm 1995 không mở được trên website Bộ Nhân sự và Xã hội, nội dung lấy từ bản đăng lại của sở nhân sự và xã hội các tỉnh."]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Ghi chú của tôi"]},{"tag":"button","props":{"type":"button"},"children":["Viết một lời nhắc cho chính bạn…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/vi/tip/07-09"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Trước"]},"Đừng để bảo hiểm y tế cư dân bị đứt quãng mỗi năm 400 tệ, hộ khó khăn được miễn giảm"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/vi/tip/07-11"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Tiếp theo"]},"Mất thẻ căn cước thì đi làm lại ngay, gấp thì xin thẻ tạm trước"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["Thêm trong chủ đề này"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/07-06"},"children":[{"tag":"strong","props":{},"children":["Gặp biến cố đột ngột thì xin trợ cấp tạm thời trước"]},{"tag":"span","props":{},"children":["Nhà đột ngột gặp chuyện, như hỏa hoạn, tai nạn, người nhà đột ngột mắ…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/07-07"},"children":[{"tag":"strong","props":{},"children":["Thu nhập thấp hơn mức trợ cấp người có thu nhập thấp ở địa phương thì xin trợ cấp người có thu nhập thấp"]},{"tag":"span","props":{},"children":["Tổng thu nhập của cả nhà chia cho số người, thấp hơn mức trợ cấp ngườ…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/07-08"},"children":[{"tag":"strong","props":{},"children":["Người có giấy chứng nhận người khuyết tật thì đi xin hai khoản trợ cấp cho người khuyết tật"]},{"tag":"span","props":{},"children":["Người khuyết tật trong hộ nghèo có thể nhận trợ cấp sinh hoạt. Mức kh…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/07-12"},"children":[{"tag":"strong","props":{},"children":["Làm xong đăng ký thất nghiệp thì hãy xin công nhận là người khó khăn việc làm, để nhận trợ cấp bảo hiểm xã hội hoặc làm công việc công ích"]},{"tag":"span","props":{},"children":["Được công nhận rồi, bạn tự đóng bảo hiểm xã hội thì nhận được trợ cấp…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/07-13"},"children":[{"tag":"strong","props":{},"children":[