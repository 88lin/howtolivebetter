Linecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["成本"]},{"tag":"p","props":{"className":"life-citations"},"children":["不花钱。上坟改成献花、除草、种花，纸钱、香烛和鞭炮不在山上点。地里的杂草、秸秆不放火烧。野炊带不用明火的吃的，烟头带下山。难在家里老人觉得上坟不烧纸不算数。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["收益"]},{"tag":"p","props":{"className":"life-citations"},"children":["森林草原防灭火条例 2026 年 1 月 1 日起施行，原来的森林防火条例和草原防火条例同时废止。条例第二十七条：防火期内，禁止在防火区内野外用火，任何人不得在防火区内丢弃火种。遇到高温、干旱、大风天气，地方政府可以下令严禁一切野外用火。第五十四条：防火期内没经批准，擅自在防火区内野外用火的，责令停止。对个人罚 300 到 5000 元，对单位罚 2 万到 10 万元。第三十四条：任何人发现森林草原火情，应当立即报警。应急管理部写明，全国统一的森林火警电话是 12119。烧起来、达到立案标准的，就是刑事案件。刑法第一百一十五条第二款是失火罪：过失引起火灾，判 3 到 7 年，情节较轻的判 3 年以下或者拘役。立案标准里，有一项和山火直接相关。烧掉的有林地达到 2 公顷，或者疏林地、灌木林地、未成林地、苗圃地达到 4 公顷，就要立案。死 1 人、重伤 3 人、直接损失 50 万元、烧毁 10 户人家的房屋，也都够立案。国家林草局转载的新华社稿件里，专家说祭祀、农事用火这类人为原因，占起火原因的九成以上。历史数据里，祭祀用火排第一位。官方案例一：谢某军 2021 年 2 月在祁连山国家级自然保护区上坟烧纸钱，引燃杂草和灌木。过火面积 39.2156 公顷，大部分是天然灌木林地。他起火后打电话报警、一起救火，主动投案，算自首。他还在别处先补种了 9420 株青海云杉。即便这样，他仍以失火罪被判有期徒刑 1 年，缓刑 2 年。法院还判他分三期造林 32.05 公顷，做不完就按评估数额出钱。官方案例二：王某前 2022 年 5 月参加民俗活动，用打火机点燃祭祀用的「煨桑」用品。他用石块盖住火种，没确认熄灭就走了。火种引燃干草，烧了 121.69 亩，损失约 46.9 万元（精确值 468578 元）。他被判有期徒刑 9 个月，缓刑 1 年 6 个月。他要按方案补种，做不完就承担 98.67 万元修复费用（全国，条例 2026 年 1 月 1 日起施行）"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["来源"]},{"tag":"p","props":{"className":"life-citations"},"children":["国务院 (2025). 森林草原防灭火条例（国务院令第 822 号，第二十五、二十七、三十、三十四、五十四、六十三条）. ",{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/202511/content_7049205.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/zhengce/zhengceku/202511/content_7049205.htm"]},"；全国人大 (1997). 刑法（第一百一十五条第二款，此款未经修正案修改）. ",{"tag":"a","props":{"href":"https://www.spp.gov.cn/spp/fl/201802/t20180206_364975.shtml","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.spp.gov.cn/spp/fl/201802/t20180206_364975.shtml"]},"；最高人民检察院、公安部 (2008). 关于公安机关管辖的刑事案件立案追诉标准的规定（一）（第一条）. ",{"tag":"a","props":{"href":"http://www.dongyang.gov.cn/art/2021/9/23/art_1229565353_59487311.html","target":"_blank","rel":"noopener noreferrer"},"children":["http://www.dongyang.gov.cn/art/2021/9/23/art_1229565353_59487311.html"]},"（东阳市人民政府转载）；应急管理部 (2019). 森林火灾小知识. ",{"tag":"a","props":{"href":"https://www.mem.gov.cn/kp/zrzh/201904/t20190401_366181.shtml","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.mem.gov.cn/kp/zrzh/201904/t20190401_366181.shtml"]},"；应急管理部 (2026-04-04). 黑龙江消防救援机动总队开展清明节防火专项行动. ",{"tag":"a","props":{"href":"https://www.mem.gov.cn/xw/jyll/202604/t20260404_599136.shtml","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.mem.gov.cn/xw/jyll/202604/t20260404_599136.shtml"]},"；国家林业和草原局转载新华社 (2025-03-26). 森林火灾怎么防、如何逃生避险 专家来支招. ",{"tag":"a","props":{"href":"https://www.forestry.gov.cn/c/www/zhzs/616962.jhtml","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.forestry.gov.cn/c/www/zhzs/616962.jhtml"]},"；最高人民法院 (2025). 人民法院守护以国家公园为主体的自然保护地生态环境典型案例（案例四）. ",{"tag":"a","props":{"href":"https://www.court.gov.cn/zixun/xiangqing/452491.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.court.gov.cn/zixun/xiangqing/452491.html"]},"；最高人民法院 (2023). 青藏高原生态保护典型案例（案例二）. ",{"tag":"a","props":{"href":"https://www.court.gov.cn/zixun/xiangqing/398782.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.court.gov.cn/zixun/xiangqing/398782.html"]},""]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["原书备注"]},{"tag":"p","props":{"className":"life-citations"},"children":["受益人是你自己。防火区和防火期由县级以上地方政府划定并公布，各地不一样，上山前查一下当地的公告。应急管理部写明，清明节是森林火灾多发期和高发期。罚款只管防火期、防火区。失火罪不看这些，只要不小心烧起来、达到立案标准就算。两个案例都是自首或者主动救火、补种之后，才拿到缓刑。修复林子的钱另算，可能比罚款多得多。报警时说清在哪个县、乡、村，哪座山，火有多大，再留下自己的电话。打 119 也行，谢某军案里写的就是他起火后主动拨打消防救援电话。网上很多文章引的罚款数，出自 2008 年的两部防火条例，2026 年起已经废止。火大了别自己硬扑，往没有草木的空地、烧过的地方或者溪边躲，别顺风跑。"]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["我的备注"]},{"tag":"button","props":{"type":"button"},"children":["写下对自己有用的提醒…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/tip/09-27"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["上一条"]},"捕鱼、钓鱼时，禁渔期和禁渔区不下网，任何时候都不电鱼、毒鱼、炸鱼，不用禁用渔具"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/tip/09-29"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["下一条"]},"考公、考研、考驾照和考职业资格时，不替人考、不找人替考，不买卖答案，不帮人组织作弊"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["本主题的其他建议"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/09-03"},"children":[{"tag":"strong","props":{},"children":["境外网站上的东西看完就关，不截图、不转发、不搬进群里，也不在评论区跟着说"]},{"tag":"span","props":{},"children":["这些法条罚的是往外传，不罚看。你转发、搬进群、在评论区跟着说，办案时都算传播。传到煽动颠覆、煽动分裂这一档，判 5 年以下，带头的 5 年以上。恐怖主义、极端主…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/09-04"},"children":[{"tag":"strong","props":{},"children":["黄色视频自己看归自己，别往群里发、别卖「资源」、别建群"]},{"tag":"span","props":{},"children":["自己看不在处罚条款里。往群里发就是在网上传播，条文没要求发几次，拘留 10 到 15 日，还可以再罚 5000 元以下，情节严重的判 2 年以下。卖「资源」挣钱…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/09-05"},"children":[{"tag":"strong","props":{},"children":["「兼职」要你用自己的卡收钱、取现、转账，不管给多少好处费都不做"]},{"tag":"span","props":{},"children":["这类兼职挣的是几百块，代价是留一份案底。有人带着身份证和 1 张银行卡去指定地点，配合转账取款，挣了 500 多元。检察院没起诉他，公安还是拘留 10 日、罚…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/09-06"},"children":[{"tag":"strong","props":{},"children":["有人拉你去「包装材料」贷款、按贷款额分你好处费，一个都不做"]},{"tag":"span","props":{},"children":["帮人「包装材料」去贷款、拿分成，按诈骗办。有个 126 人的团伙，把没工作的人包装成「优质客户」，在 80 多家银行网点骗贷 3000 多万元。出面签字的按贷款…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/09-07"},"children":[{"tag":"strong","props":{},"children":["捡到银行卡不取钱，捡到手机、钱包联系失主或交给警察，不揣走"]},{"tag":"span","props":{},"children":["捡到东西留着自己用，金额到了「数额较大」又不肯交出来，判 2 年以下，数额巨大的判 2 到 5 年。拿捡来的银行卡去 ATM 取钱更重，算冒用别人的信用卡，数额…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/09-08"},"children":[{"tag":"strong","props":{},"children":["优惠用自己的真实身份领，不买虚拟号批量注册小号，不靠漏洞重复领"]},{"tag":"span","props":{},"children":["用真实身份、一个号领一次券，不在处罚范围里。批量注册假用户、自己下单自己接单去多领，按诈骗办。骗到各省定的起点（3000 到 1 万元）判 3 年以下，到 3…"]}]}]}]},{"tag":"a","props":{"className":"life-text-link","href":"/book/09"},"children":["阅读整个主题：普通人容易踩的法律红线 ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"15","height":"15","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","c