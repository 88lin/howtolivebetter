,"width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"收藏"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"分享这条建议"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"收起详情"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["成本"]},{"tag":"p","props":{"className":"life-citations"},"children":["每半年去一次肝病科或感染科，抽血再做个 B 超，费用各地不同。要吃抗病毒药的，国家医保局说恩替卡韦集采后一年药费降到 100 多元。难在没感觉的时候也要按时去查，药也要一直吃下去。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["收益"]},{"tag":"p","props":{"className":"life-citations"},"children":["上海一项随机分组试验，18816 名 35 到 59 岁的人，都感染了乙肝病毒或有慢性肝炎病史。筛查组每 6 个月受邀查一次甲胎蛋白和 B 超，对照组不筛查。甲胎蛋白是抽血查的一项指标，得了肝癌常会升高。筛查组死于肝癌 32 人，对照组 54 人。肝癌死亡率是每 10 万人 83.2 对 131.5。筛查组是对照组的 0.63 倍（95% CI 0.41–0.98，可信范围），低约 37%。筛查组查出的肝癌有 46.5% 做了切除手术，对照组只有 7.5%。台湾一项跟踪研究，3653 名 30 到 65 岁、表面抗原阳性的人，平均跟踪 11.4 年，只记录、不分组。入组时血里病毒越多，后来得肝癌的越多。病毒量每毫升低于 300 拷贝的，每 10 万人年有 108 例肝癌。每毫升 100 万拷贝以上的，有 1152 例。累计得肝癌的比例分别是 1.3% 和 14.9%。扣掉性别、年龄、抽烟、喝酒、转氨酶和肝硬化之后，病毒越多、肝癌越多的规律仍然成立。亚洲一项随机分组试验，651 名已有严重肝纤维化或肝硬化的慢性乙肝病人。一组吃拉米夫定，一组吃安慰剂，中位吃了 32.4 个月。肝癌是 3.9% 对 7.4%，风险约低一半（HR 0.49，P=0.047）。病情加重是 7.8% 对 17.7%（HR 0.45，低约 55%）。中华医学会 2022 年版指南写明，慢性乙肝病毒感染者每 6 个月做一次腹部 B 超和甲胎蛋白，筛查肝癌。高危的人至少每 3 到 6 个月一次。暂时不用吃药的携带者，血常规、肝功能、病毒指标、甲胎蛋白、B 超每 6 到 12 个月查一次。一旦够了用药条件，就马上开始治。血里查得到病毒的，年龄超过 30 岁就建议抗病毒治疗，不管转氨酶高不高。家里有人因乙肝得了肝硬化或肝癌的，也一样。指南推荐的口服药是恩替卡韦、替诺福韦这一类。指南写明，大多数人要长期吃药，停药后病毒反弹的比例高"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["来源"]},{"tag":"p","props":{"className":"life-citations"},"children":["Zhang BH, Yang BH, Tang ZY (2004). Randomized controlled trial of screening for hepatocellular carcinoma. Journal of Cancer Research and Clinical Oncology, 130(7), 417-422. ",{"tag":"a","props":{"href":"https://doi.org/10.1007/s00432-004-0552-0","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1007/s00432-004-0552-0"]},"；Chen CJ, Yang HI, Su J, et al.; REVEAL-HBV Study Group (2006). Risk of hepatocellular carcinoma across a biological gradient of serum hepatitis B virus DNA level. JAMA, 295(1), 65-73. ",{"tag":"a","props":{"href":"https://doi.org/10.1001/jama.295.1.65","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1001/jama.295.1.65"]},"；Liaw YF, Sung JJ, Chow WC, et al.; Cirrhosis Asian Lamivudine Multicentre Study Group (2004). Lamivudine for patients with chronic hepatitis B and advanced liver disease. New England Journal of Medicine, 351(15), 1521-1531. ",{"tag":"a","props":{"href":"https://doi.org/10.1056/NEJMoa033364","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1056/NEJMoa033364"]},"；中华医学会肝病学分会, 中华医学会感染病学分会 (2022). 慢性乙型肝炎防治指南（2022 年版）. 中华肝脏病杂志, 30(12), 1309-1331. ",{"tag":"a","props":{"href":"https://doi.org/10.3760/cma.j.cn501113-20221204-00607","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.3760/cma.j.cn501113-20221204-00607"]},"；同一指南的英文版：You H, Wang F, Li T, et al. (2023). Guidelines for the Prevention and Treatment of Chronic Hepatitis B (version 2022). Journal of Clinical and Translational Hepatology, 11(6), 1425-1442. ",{"tag":"a","props":{"href":"https://doi.org/10.14218/JCTH.2023.00320","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.14218/JCTH.2023.00320"]},"；Wun YT, Dickinson JA (2003). Alpha-fetoprotein and/or liver ultrasonography for liver cancer screening in patients with chronic hepatitis B. Cochrane Database of Systematic Reviews, CD002799. ",{"tag":"a","props":{"href":"https://doi.org/10.1002/14651858.CD002799","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1002/14651858.CD002799"]},"（反方）；Aghoram R, Cai P, Dickinson JA (2012). Alpha-foetoprotein and/or liver ultrasonography for screening of hepatocellular carcinoma in patients with chronic hepatitis B. Cochrane Database of Systematic Reviews, CD002799.pub2. ",{"tag":"a","props":{"href":"https://doi.org/10.1002/14651858.CD002799.pub2","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1002/14651858.CD002799.pub2"]},"（反方）；国家医疗保障局 (2025). 中国医保惠民生 积跬步、至长远（七）：医药集采规范化制度化常态化：「乙肝治疗一线用药恩替卡韦，过去患者吃一年的费用大约5000元……集采后恩替卡韦年费用降到100多元」. ",{"tag":"a","props":{"href":"https://www.nhsa.gov.cn/art/2025/12/29/art_14_19172.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.nhsa.gov.cn/art/2025/12/29/art_14_19172.html"]},""]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["原书备注"]},{"tag":"p","props":{"className":"life-citations"},"children":["争议：上海那项试验的结论有人不认。Cochrane 2003 年的综述按自己的算法重算了一遍。算出来肝癌死亡的差别不显著（OR 0.81，0.54–1.22）。2012 年的更新版说，这项试验偏倚风险高，几份报告给的数字对不上，下不了结论。所以「每半年查一次」靠的是这一项有争议的试验，加上各国指南。拉米夫定是老药，试验里 49% 的人出了耐药突变，现在指南推荐的是恩替卡韦这类。要不要吃药、能不能停，看病毒量、转氨酶、肝纤维化程度和家族史，由医生定。还没感染的人查两对半、打疫苗，见第 1 节第 14 条（查乙肝两对半）。丙肝是另一种病，见第 1 节第 45 条（丙肝抗体）。喝酒伤肝，见第 2 节第 19 条（少喝或不喝酒）。受益人主要是你自己。"]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["我的备注"]},{"tag":"button","props":{"type":"button"},"children":["写下对自己有用的提醒…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/tip/16-10"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["上一条"]},"得过痛风的，吃烧烤、聚餐时别一顿吃下大量肉和海鲜，酒也要少喝"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/tip/16-12"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["下一条"]},"确诊慢阻肺的，复诊时让医生或药师看你当面用一遍吸入剂；因为急性加重住过院的，出院后去做肺康复"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["本主题的其他建议"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/16-03"},"children":[{"tag":"strong","props":{},"children":["复查按医生给的间隔做，把每次的指标记在同一个本子上"]},{"tag":"span","props":{},"children":["慢性病看的是一段时间里的变化，不是某一次的数值。光自己在家量血压，看不出血压因此降下来。把读数带给医生、让医生照着调药，血压才降得多一些。换医院时，标着互认标志…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/16-04"},"children":[{"tag":"strong","props":{},"children":["别为了试偏方、保健品停掉正规治疗"]},{"tag":"span","props":{},"children":["本来能治的癌症，只用替代疗法、不做正规治疗的人，死亡风险是正规治疗的 2.5 倍。边治边用补充疗法的人更常拒绝手术、化疗和放疗，多出来的死亡就出在这里。有的草药…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/16-05"},"children":[{"tag":"strong","props":{},"children":["病情稳定的慢性病，在社区医院一次可以开到 12 周的药"]},{"tag":"span","props":{},"children":["病情稳定、吃的药也没换的人，在社区卫生服务中心一次最多能开 12 周的药。省掉每月往返大医院排队挂号的半天。在同一个参保地里，住基层医院的报销比例原则上要比上一…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/16-06"},"children":[{"tag":"strong","props":{},"children":["在社区签家庭医生之前，问清楚哪些进医保、哪些自费"]},{"tag":"span","props":{},"children":["签约的基本服务包按规定走医保。个性化服务包的钱要全部自己出。有人推销「升级包」的时候，先问清楚这是基本包还是个性化包、备没备案、一年多少钱。"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/16-07"},"children":[{"tag":"strong","props":{},"children":["确诊糖尿病就去查一次眼底，之后按医生给的间隔查；每年查一次脚"]},{"tag":"span","props":{},"children":["糖尿病伤到眼底、伤到脚，在坏到看不见、烂起来之前几乎没有感觉。早查出来还有得治。2 型糖尿病确诊当时就查一次散瞳眼底，1 型在发病 5 年后开始查。查过一两次没…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/16-08"},"children":[{"tag":"strong","props":{},"children":["得过肾结石就把水喝到每天 2.5–3 升，盐降到 6 克以内"]},{"tag":"span","props":{},"children":["第一次长了钙结石、又查不出原因的人，什么都不做的话，五年里约四分之一会再长。每天把水喝够的人，五年里复发的只有一成多，少了一半多。英国指南给的量是每天喝 2.5…"]}]}]}]},{"tag":"a","props":{"className":"life-text-link","href":"/book/16"},"children":["阅读整个主题：得了慢性病之后怎么活 ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"15","height":"15","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]}]}]},{"tag":"nav","props":{"className":"life-tabbar","aria-label":"主导航"},"children":[{"tag":"a","props":{"className":"","href":"/book"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"21","height":"21","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-book-open","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M12 7v14"},"children":[]},{"tag":"path","props":{"d":"M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z"},"children":[]}]},{"tag":"span","props":{},"children":["全书"]}]},{"tag":"a","props":{"className":"","href":"/top-50"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"21","height":"21","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-star","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a