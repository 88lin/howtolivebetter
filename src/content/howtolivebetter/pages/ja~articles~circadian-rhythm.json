stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"記事一覧へ"]},{"tag":"header","props":{"className":"life-longread-header"},"children":[{"tag":"div","props":{},"children":[{"tag":"div","props":{"className":"life-eyebrow"},"children":["詳しく読む"]},{"tag":"h1","props":{"lang":"ja"},"children":["身体はどのように時間を認識しているのか、そしてなぜ夜勤は体に害を及ぼすのか"]},{"tag":"p","props":{"lang":"ja"},"children":["身体がどのように時間を認識しているのか、夜勤がどのようにリズムを乱すのか、そして原文で議論されている対処法とその限界について。"]},{"tag":"a","props":{"className":"life-longread-chapter","href":"/ja/book/02"},"children":["関連する章"," · ","ゆっくり死なないために",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"img","props":{"src":"/sites/howtolivebetter/images/book-chapters/02-health-editorial.webp","srcSet":"/sites/howtolivebetter/images/book-chapters/02-health-editorial-thumb.webp 600w, /sites/howtolivebetter/images/book-chapters/02-health-editorial-md.webp 900w, /sites/howtolivebetter/images/book-chapters/02-health-editorial.webp 1200w","sizes":"(max-width: 760px) 100vw, 450px","alt":"","width":"1200","height":"800","fetchPriority":"high"},"children":[]}]},{"tag":"div","props":{"className":"life-longread-layout"},"children":[{"tag":"aside","props":{"className":"life-longread-toc"},"children":[{"tag":"details","props":{"open":true},"children":[{"tag":"summary","props":{},"children":["この記事の目次"]},{"tag":"nav","props":{"aria-label":"この記事の目次"},"children":[{"tag":"a","props":{"href":"#一身体の中には確かに時を刻む器官が存在する"},"children":["一、身体の中には、確かに時を刻む器官が存在する"]},{"tag":"a","props":{"href":"#二この時計は光によって時刻合わせを行うが物を見る経路とは異なる"},"children":["二、この時計は光によって時刻合わせを行うが、「物を見る」経路とは異なる"]},{"tag":"a","props":{"href":"#三鍵となるのは時計は一つではないということ"},"children":["三、鍵となるのは：時計は一つではないということ"]},{"tag":"a","props":{"href":"#四夜勤の問題は徹夜ではなく二つの時計が引き裂かれることにある"},"children":["四、夜勤の問題は「徹夜」ではなく、「二つの時計が引き裂かれる」ことにある"]},{"tag":"a","props":{"href":"#五しかもあなたは適応できない"},"children":["五、しかも、あなたは適応できない"]},{"tag":"a","props":{"href":"#六単なる睡眠不足ではなくズレそのものが害を及ぼしているとどう判断するか"},"children":["六、単なる睡眠不足ではなく、ズレそのものが害を及ぼしているとどう判断するか"]},{"tag":"a","props":{"href":"#七変えられる第一の要素食事の時間を昼間にずらす"},"children":["七、変えられる第一の要素：食事の時間を昼間にずらす"]},{"tag":"a","props":{"href":"#8-体内時計を移動させることはできるのか"},"children":["8. 体内時計を移動させることはできるのか"]},{"tag":"a","props":{"href":"#九本稿では触れないこと"},"children":["九、本稿では触れないこと"]}]}]}]},{"tag":"div","props":{"className":"life-longread-main"},"children":[{"tag":"article","props":{"className":"life-article-body","lang":"ja"},"children":[{"tag":"p","props":{},"children":["これは",{"tag":"a","props":{"href":"/ja/book/02#02-39","title":"夜勤の期間が長いほど心血管リスクは高まる。配置転換ができるなら早めに検討を"},"children":["第 2 節第 39 条"]},"（夜勤は長く続けるほど心血管リスクが高まる）のロングバージョンです。本文の条項では計算（リスクの数値化）のみを行っていますが、本稿ではその背後にある理屈を解説します。"]},"\n",{"tag":"p","props":{},"children":["問いとなるのは、「身体は本当に今が何時かを知ることができるのか？」ということです。もし可能であるならば、なぜ夜勤は「何度か徹夜すれば慣れる」というものではないのでしょうか？"]},"\n",{"tag":"h2","props":{"id":"一身体の中には確かに時を刻む器官が存在する"},"children":["一、身体の中には、確かに時を刻む器官が存在する"]},"\n",{"tag":"p","props":{},"children":["ヒトの脳の視床下部には、視交叉上核と呼ばれる、約2万個の細胞からなる小さな神経細胞の集まりがあります。これが全身の「主時計」です。"]},"\n",{"tag":"p","props":{},"children":["この時計が時を刻む仕組みは、一連の「時計遺伝子」による相互抑制に基づいています。CLOCKとBMAL1と呼ばれる2つのタンパク質が、別の2つの遺伝子であるPERとCRYの転写を開始します。PERとCRYのタンパク質が蓄積されると、それらの開始を担った一対のタンパク質を抑制します。これらのタンパク質が分解されると、再びサイクルが始まります。一巡には約 24 時間を要します。"]},"\n",{"tag":"p","props":{},"children":["したがって、この時計は外界を観察して時間を推算しているわけではありません。光も時計も、社会的手がかりもない完全に閉ざされた部屋に人を閉じ込めても、このリズムはそのまま刻まれ続けます。ただし、周期は正確に 24 時間ではなく、日々少しずつズレていきます。2017 年のノーベル生理学・医学賞は、この分子メカニズムを発見した3人の研究者に授与されました。"]},"\n",{"tag":"h2","props":{"id":"二この時計は光によって時刻合わせを行うが物を見る経路とは異なる"},"children":["二、この時計は光によって時刻合わせを行うが、「物を見る」経路とは異なる"]},"\n",{"tag":"p","props":{},"children":["網膜には、像を結ぶことを担う細胞のほかに、光に特化した光受容細胞が存在します。これらはメラノプシンという色素を含んでおり、物を見えるようにするのではなく、光の強弱を直接、視交叉上核へと伝達します。"]},"\n",{"tag":"p","props":{},"children":["そのため、光が生物時計を校正（リセット）できるかどうかは、目が物を見えるかどうかとは直接関係ありません。視力を完全に失った盲人であっても、生物時計は光によって校正されることがあります。"]},"\n",{"tag":"p","props":{},"children":["これが、",{"tag":"a","props":{"href":"/ja/book/03#03-02","title":"起床時間を固定する、週末も同様に"},"children":["第 3 節第 2 条"]},"（起床時間を固定する、週末も同様に）において、朝に光を浴びることが推奨されている理由でもあります。"]},"\n",{"tag":"h2","props":{"id":"三鍵となるのは時計は一つではないということ"},"children":["三、鍵となるのは：時計は一つではないということ"]},"\n",{"tag":"p","props":{},"children":["肝臓、腸、心臓、脂肪組織には、それぞれ独自の「末梢時計」が存在します。"]},"\n",{"tag":"p","props":{},"children":["主時計は光によって時刻合わせを行います。",{"tag":"strong","props":{},"children":["末梢時計は、大部分において「いつ食事をするか」によって時刻合わせが行われます。"]}]},"\n",{"tag":"p","props":{},"children":["規則正しい生活下では、これら二つは同期しています。日中に光を浴び、日中に食事を摂ることで、主時計と末梢時計は同じ時刻を指します。そのため、普段はこれらが別々の仕組みであることに気づくことはほとんどありません。"]},"\n",{"tag":"h2","props":{"id":"四夜勤の問題は徹夜ではなく二つの時計が引き裂かれることにある"},"children":["四、夜勤の問題は「徹夜」ではなく、「二つの時計が引き裂かれる」ことにある"]},"\n",{"tag":"p","props":{},"children":["夜勤に従事する人は、日中も光を浴び、日中の社会生活を送ります。そのため、主時計は基本的に依然として外界の昼夜周期にロックされています。"]},"\n",{"tag":"p","props":{},"children":["しかし、生物学的な意味での深夜に、食事をし、働き、代謝を動かしています。これにより、末梢時計は反対側へと引き寄せられます。"]},"\n",{"tag":"p","props":{},"children":["この状態を「概日リズムのズレ（サーカディアン・ミスアライメント）」と呼びます。問題は、睡眠時間が数時間減ることではなく、全身の時計が互いに一致しなくなることにあるのです。"]},"\n",{"tag":"h2","props":{"id":"五しかもあなたは適応できない"},"children":["五、しかも、あなたは適応できない"]},"\n",{"tag":"p","props":{},"children":["「長期間、固定の夜勤を続けていれば、いつかは適応できるのではないか」と考える人がいるかもしれません。"]},"\n",{"tag":"p","props":{},"children":["あるレビュー論文では、6つの研究をまとめ、メラトニンの分泌リズムを用いて、長期間固定の夜勤に従事している人を測定しています。メラトニンのリズムは、内因性生物時計の状態を判断する最も信頼できる指標です。"]},"\n",{"tag":"p","props":{},"children":["結果は、 「完全に」適応できた人は 3% 未満でした。「かなりの程度」適応できた人も、4分の1に満たない結果となりました。"]},"\n",{"tag":"p","props":{},"children":["勤続年数がどれほど長くても同じです。その理由は前段にあります。あなたは日中に光を浴び、日中の社会生活を送らなければならず、これらの手がかり（光など）が常に主時計を（本来のリズムへ）引き戻そうとするからです。"]},"\n",{"tag":"p","props":{},"children":["出典：Folkard S (2008). Do permanent night workers show circadian adjustment? A review based on the endogenous melatonin rhythm. Chronobiology International. ",{"tag":"a","props":{"href":"https://doi.org/10.1080/07420520802106835","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1080/07420520802106835"]}]},"\n",{"tag":"h2","props":{"id":"六単なる睡眠不足ではなくズレそのものが害を及ぼしているとどう判断するか"},"children":["六、単なる睡眠不足ではなく、ズレそのものが害を及ぼしているとどう判断するか"]},"\n",{"tag":"p","props":{},"children":["これは、この問題において最も問うべき核心的な部分です。夜勤の人は睡眠不足、不規則な食事、ストレス、喫煙の多さなど、これらすべてが真の原因である可能性があります。"]},"\n",{"tag":"p","props":{},"children":["幸いなことに、このことは実験室内で単独で検証することが可能です。"]},"\n",{"tag":"p","props":{},"children":["Scheerらによる 2009 年の研究では、10 名の成人が実験室に 10 日間滞在しました。研究者は、意図的に「一日」を 28 時間に設定し、彼らの食事と睡眠が生物時計のあらゆる時刻を通過するように強制しました。",{"tag":"strong","props":{},"children":["一日の食事は4回、摂取カロリーは固定されています。"]}]},"\n",{"tag":"p","props":{},"children":["行動と生物時計が約 12 時間ズレたとき、結果は以下の通りでした："]},"\n",{"tag":"ul","props":{},"children":["\n",{"tag":"li","props":{},"children":["レプチン（満腹感を感じさせるホルモン）が 17% 低下"]},"\n",{"tag":"li","props":{},"children":["血糖値が 6% 上昇（しかも、インスリンがすでに 22% 上昇している状態において）"]},"\n",{"tag":"li","props":{},"children":["コルチゾールの日内リズムが完全に逆転"]},"\n",{"tag":"li","props":{},"children":["平均動脈圧が 3% 上昇"]},"\n",{"tag":"li","props":{},"children":["睡眠効率が 20% 低下"]},"\n"]},"\n",{"tag":"p","props":{},"children":["最も重大な点は、十分なデータが得られた 8 人のうち、3 人の食後血糖値が糖尿病前症の範囲に達したことで、これにはわずか 10 日しかかかりませんでした。"]},"\n",{"tag":"p","props":{},"children":["摂取カロリーは固定されており、実験も実験室内で制御されているため、これらの変化を「睡眠不足」や「食べ過ぎ」のせいにはできません。",{"tag":"strong","props":{},"children":["単なる「ズレ」だけで、これらの変化を引き起こすには十分なのです。"]}]},"\n",{"tag":"p","props":{},"children":["出典：Scheer FA, Hilton MF, Mantzoros CS, Shea SA (2009). Adverse metabolic and cardiovascular consequences of circadian misalignment. PNAS, 106(11), 4453-4458. ",{"tag":"a","props":{"href":"https://doi.org/10.1073/pnas.0808180106","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1073/pnas.0808180106"]}]},"\n",{"tag":"h2","props":{"id":"七変えられる第一の要素食事の時間を昼間にずらす"},"children":["七、変えられる第一の要素：食事の時間を昼間にずらす"]},"\n",{"tag":"p","props":{},"children":["末梢時計は食事の時間に合わせて同期するため、試してみる価値のある方向性があります。それは、夜勤のシフトは維持したまま、夜間には食べないという方法です。"]},"\n",{"tag":"p","props":{},"children":["あるランダム化比較試験がこれを行っています（登録番号 NCT02291952）。20 名の健康な被験者が模擬夜勤を行い、ランダムに2つのグループに分けられました。一方のグループは夜勤労働者の一般的な習慣に従い、夜間と昼間の両方で食事を摂ります。もう一方のグループは昼間のみ食事を摂ります。"]},"\n",{"tag":"p","props":{},"children":["主要アウトカムに関する報告では、夜間に食事をしたグループは、中枢のリズムと末梢の血糖リズムが乖離し、糖耐性が悪化しました。一方、昼間のみ食事をしたグループには、これら両方の変化は見られませんでした。"]},"\n",{"tag":"p","props":{},"children":["心血管に関する論文（同試験の二次解析）では、夜間に食事をしたグループにおいて、心臓の迷走神経調節指標であるpNN50が 25.7% 低下し、RMSSDが 14.3% 低下、交感神経と迷走神経のバランスを反映するLF/HFが 5.5% 上昇、血栓形成因子であるPAI-1が 23.9% 上昇しました。昼間のみ食事をしたグループでは、これらの変化は見られませんでした。"]},"\n",{"tag":"p","props":{},"children":[{"tag":"strong","props":{},"children":["しかし、これはわずか 20 人を対象としたものであり、かつ実際の夜勤労働者ではなく、模擬夜勤によるものです。"]}]},"\n",{"tag":"p","props":{},"children":["このようなランダム化比較試験を専門に調査した系統的レビューでは、6つのデータベースを検索した結果、わずか 4 件の試験しか見つかりませんでした。結果も一貫していません。空腹時インスリンやインスリン抵抗性の改善が見られた試験もあれば、見られなかった試験もあります。高密度リポタンパク質（HDL）については、4つの試験すべてにおいて変化は見られませんでした。食後血糖については、夜間に 10.75 時間絶食する手法は、夜間に食事と夜食を摂る手法よりも確かに優れていることが示されました。レビューの著者は、試験数が少なすぎるため、一般化するには不十分であると述べています。"]},"\n",{"tag":"p","props":{},"children":["したがって、現時点で言えることはこれだけです：",{"tag":"strong","props":{},"children":["夜勤中、食事をできるだけ昼間に集中させることは、ランダム化比較試験によって支持されていますが、エビデンスはまだ非常に希薄です。"]}," これは費用もかからず、実行も難しくありません。試してみたい方は試してみてください。次に試せる第二の要素は、次節で紹介します：光を使って生物時計そのものを移動させる方法です。"]},"\n",{"tag":"p","props":{},"children":["出典：Chellappa SL 他 (",{"tag":"strong","props":{},"children":["2021"]},")。Daytime eating prevents internal circadian misalignment and glucose intolerance in night work. Science Advances. ",{"tag":"a","props":{"href":"https://doi.org/10.1126/sciadv.abg9910","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1126/sciadv.abg9910"]},"；Chellappa SL 他 (",{"tag":"strong","props":{},"children":["2025"]},")。Daytime eating during simulated night work mitigates changes in cardiovascular risk factors: secondary analyses of a randomized controlled trial. Nature Communications. ",{"tag":"a","props":{"href":"https://doi.org/10.1038/s41467-025-57846-y","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1038/s41467-025-57846-y"]},"；Wulandari F 他 (",{"tag":"strong","props":{},"children":["2026"]},")。Cardiometabolic status among shift workers under meal time regulation: A systematic review of randomized controlled trials. Nutrition and Health. ",{"tag":"a","props":{"href":"https://doi.org/10.1177/02601060261464874","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1177/02601060261464874"]}]},"\n",{"tag":"h2","props":{"id":"8-体内時計を移動させることはできるのか"},"children":["8. 体内時計を移動させることはできるのか"]},"\n",{"tag":"p","props":{},"children":["これまで述べてきたのは「ズレは有害である」ということだ。では逆に、体内時計そのものを夜勤の時間帯へと丸ごと移動させることは、果たして可能なのだろうか？"]},"\n",{"tag":"p","props":{},"children":[{"tag":"strong","props":{},"children":["理論上は可能であり、実際に成功例もある。しかし、光に対する要求水準は、多くの人が想像するよりも一桁高い。"]}]},"\n",{"tag":"p","props":{},"children":["Czeislerらによる1990年の研究：8名の若い男性を対象に、1週間の夜勤における2つの条件を比較した。"]},"\n",{"tag":"p","props":{},"children":["対照群の条件では、夜間の照明は一般的な室内照明であり、約150ルクスであった。ルクスは照度の単位であり、一般的な蛍光灯の部屋ではおよそ100〜200ルクス程度である。その結果、6晩連続で夜勤を行ったにもかかわらず、体温の最低点は依然として午前3時半前後であった。体温の最低点は、体内時計がどこを指しているかを判断するための標準的な指標である。このことは、体内時計が微動だにしていなかったことを示している。"]},"\n",{"tag":"p","props":{},"children":["治療条件下、夜間に 7000 から 12000 ルクスの強光を浴び、日中はほぼ真っ暗な環境で眠る。4日後、体温の最低点が午後の 3 時頃へと移動した。つまり、完全に逆転したのである。"]},"\n",{"tag":"p","props":{},"children":["出典：Czeisler CA, Johnson MP, Duffy JF, Brown EN, Ronda JM, Kronauer RE (1990). Exposure to bright light and darkness to treat physiologic maladaptation to night work. New England Journal of Medicine, 322(18), 1253-1259. ",{"tag":"a","props":{"href":"https://doi.org/10.1056/NEJM199005033221801","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1056/NEJM199005033221801"]}]},"\n",{"tag":"h3","props":{"id":"欠けてはならない3つの要素"},"children":["欠けてはならない3つの要素"]},"\n",{"tag":"p","props":{},"children":[{"tag":"strong","props":{},"children":["第一、夜間の光は十分に明るくなければならない。"]}," 普通の蛍光灯の下で仕事をするのは、前述の「何も起こらなかった」対照群と同じである。効果を得るには、専用の光療法用ライトボックスを使用する必要がある。"]},"\n",{"tag":"p","props":{},"children":[{"tag":"strong","props":{},"children":["第二、日中の睡眠は厳格に遮光しなければならない。"]}," 遮光カーテンとアイマスクを使用すること。前述の実験は「夜間の強光」と「日中のほぼ全暗」の2つを同時に行ったものであり、どちらか一方を選べばよいというものではない。"]},"\n",{"tag":"p","props":{},"children":[{"tag":"strong","props":{},"children":["第三、退勤時にはサングラスを着用しなければならない。"]}," これが最も忘れがちな要素であり、これを怠ると基本的に無意味に終わる。"]},"\n",{"tag":"p","props":{},"children":["なぜ第三の要素がこれほど重要なのか、光の作用の仕組みを見る必要がある。同じ光であっても、浴びるタイミングが異なれば、体内時計を動かす方向は逆になる。体温の最低点の",{"tag":"strong","props":{},"children":["前"]},"に光を浴びると、時計は後ろに遅れる。最低点の",{"tag":"strong","props":{},"children":["後"]},"に光を浴びると、時計は前に進む。"]},"\n",{"tag":"p","props":{},"children":["夜勤を終えて帰宅する際、ちょうど体温の最低点を過ぎたタイミングになる。",{"tag":"strong","props":{},"children":["この朝の光がもたらす作用は、一晩中ライトボックスの前に座っていた時の作用とは正反対の方向に向かうのである。"]}]},"\n",{"tag":"h3","props":{"id":"実験室では可能だが日常生活では不可能"},"children":["実験室では可能だが、日常生活では不可能"]},"\n",{"tag":"p","props":{},"children":["実験室の被験者たちは、一週間外出しない。しかし現実には、休日は子供の迎えや家族との時間、用事など、日中の生活を送らなければならない。一度でもそうすると、時計は引き戻されてしまう。これが",{"tag":"a","props":{"href":"/ja/book/05","title":"お金を無駄にしない"},"children":["第5節"]},"に登場した数字の由来である。長期的な固定夜勤労働者のうち、完全に適応できる人は 3% に満たない。"]},"\n",{"tag":"p","props":{},"children":["したがって、現実世界においては、完全に逆転させることを追求するのではなく、時計を「勤務中に十分な覚醒度を保て、かつ休日も完全に台無しにならない」という中間地点に留めることを目指すのが一般的である。"]},"\n",{"tag":"h3","props":{"id":"現実的にどこまで達成できるか"},"children":["現実的にどこまで達成できるか"]},"\n",{"tag":"p","props":{},"children":["11 件の研究をまとめたメタ解析：光療法により、シフトワーカーの総睡眠時間は約 32.5 分増加し、睡眠効率は約 2.91 向上する。有効な用量は 900 から 6000 ルクス、1晩につき少なくとも 1 時間である。"]},"\n",{"tag":"p","props":{},"children":["別の実験室研究では、断続的な強光を用いた。治療群ではメラトニン分泌が予定された睡眠時間と 4.90 時間重なっていたのに対し、対照群ではわずか 2.62 時間であった（P=0.002）。対照群で見られた最終夜勤時における認知機能の低下は、治療群では抑制されていた。著者は結論において、この手法は実際のシフトワーカーに対して検証する必要があると明言している。"]},"\n",{"tag":"p","props":{},"children":["出典：Zhao C, Li N, Miao W, He Y, Lin Y (2025). A systematic review and meta-analysis on light therapy for sleep disorders in shift workers. Scientific Reports. ",{"tag":"a","props":{"href":"https://doi.org/10.1038/s41598-024-83789-3","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1038/s41598-024-83789-3"]},"；Lammers-van der Holst HM et al. (2021). Efficacy of intermittent exposure to bright light for treating maladaptation to night work on a counterclockwise shift work rotation. Scandinavian Journal of Work, Environment & Health. ",{"tag":"a","props":{"href":"https://doi.org/10.5271/sjweh.3953","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.5271/sjweh.3953"]}]},"\n",{"tag":"h3","props":{"id":"まだ誰も検証していないこと"},"children":["まだ誰も検証していないこと"]},"\n",{"tag":"p","props":{},"children":["「体内時計を正しく調整すれば、心血管リスクも共に低下するのか」——",{"tag":"strong","props":{},"children":["これを検証した試験は存在しない"]},"。"]},"\n",{"tag":"p","props":{},"children":["ズレが生じることの有害性は、",{"tag":"a","props":{"href":"/ja/book/06","title":"アンチ・リスト"},"children":["第6節"]},"の実験によって既に判明している。しかし、これは逆の「正しく調整すれば安全である」ということと同義ではない。また、休日に時計を元に戻す際、このような往復の変動が善い影響を与えるのか悪影響を与えるのかについても、同様に誰も検証していない。"]},"\n",{"tag":"p","props":{},"children":["上述の2つの対策の終着点は、一方は代謝および心血管指標、もう一方は睡眠に関するものであり、いずれも発症や死亡にまで及んだものではない。"]},"\n",{"tag":"h2","props":{"id":"九本稿では触れないこと"},"children":["九、本稿では触れないこと"]},"\n",{"tag":"p","props":{},"children":["夜勤が具体的にどれほど心血管リスクを高めるのか、また年数による計算方法は、",{"tag":"a","props":{"href":"/ja/book/02","title":"ゆっくり死なないために"},"children":["第 2 節"]}," 第 39 条（夜勤の期間が長いほど心血管リスクが高まる）に記載されています。"]},"\n",{"tag":"p","props":{},"children":["徹夜した後にどのように睡眠を補うべきかは、",{"tag":"a","props":{"href":"/ja/book/02","title":"ゆっくり死なないために"},"children":["第 2 節"]}," 第 38 条（徹夜した翌日の夜には睡眠を補う）に記載されています。"]},"\n",{"tag":"p","props":{},"children":["夜間の睡眠時間や生活リズムの不規則さについては、",{"tag":"a","props":{"href":"/ja/book/02","title":"ゆっくり死なないために"},"children":["第 2 節"]}," 第 13 条（毎晩 7 時間程度の睡眠をとり、規則正しい生活を送る）に記載されています。"]},"\n",{"tag":"p","props":{},"children":["朝の光を浴びることと起床時間の固定については、",{"tag":"a","props":{"href":"/ja/book/03","title":"エネルギーを無駄にしない"},"children":["第 3 節"]}," 第 2 条（起床時間を固定し、週末も同様にする）に記載されています。"]},"\n"]},{"tag":"footer","props":{"className":"life-article-attribution"},"children":[{"tag":"p","props":{},"children":["このページには当サイトが中国語原文から機械翻訳した文章が含まれ、専門家による校閲は行っていません。医療・法律・金融情報は原文と出典を確認してください。"]},{"tag":"a","props":{"href":"https://github.com/eternity4719/HowToLiveBetter/blob/33362aff50f97f413b22ddfcdb355d2a536a5700/docs/%E7%94%9F%E7%89%A9%E9%92%9F%E5%92%8C%E5%A4%9C%E7%8F%AD.md","target":"_blank","rel":"noopener noreferrer"},"children":["出典の版を見る · 33362af",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"14","height":"14","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]},{"tag":"span","props":{},"children":["取り込み日：2026-10-11"]},{"tag":"p","props":{},"children":["参照リンクは当サイトの版で対応するヒントに移動します。原文の番号とは異なる場合があります。"]}]},{"tag":"div","props":{"className":"life-quick-share"},"children":[{"tag":"button","props":{"type":"button"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-copy","aria-hidden":"true"},"children":[{"tag":"rect","props":{"width":"14","height":"14","x":"8","y":"8","rx":"2","ry":"