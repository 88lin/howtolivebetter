tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"加入待做"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"收藏"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"分享这条建议"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"收起详情"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["成本"]},{"tag":"p","props":{"className":"life-citations"},"children":["不花钱，还省下一辆学步车的钱。没轮子的游戏站台、游戏围栏要另买，也可以借。难在长辈送了或者已经买了，要舍得扔"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["收益"]},{"tag":"p","props":{"className":"life-citations"},"children":["美国 1990 到 2014 年，不满 15 个月的孩子因学步车受伤去急诊的，估计约 23 万人次（精确值 230676）。其中 90.6% 伤在头部或脖子，74.1% 是坐在学步车里摔下楼梯。受伤后住院的占 4.5%，住院的孩子里 37.8% 是颅骨骨折。美国 2010 年起实行学步车强制安全标准。之后 4 年，每年平均受伤数比之前 4 年少了 22.7%。但作者说，学步车仍是孩子受伤的一个重要来源，而且是可以避免的。美国儿科学会 2001 年的立场声明说，美国 1973 到 1998 年报告了 34 起和学步车有关的死亡。警示标签、宣传教育、大人在旁边看着、装楼梯门，都被证明防不住这类伤。学步车又没有明确的好处，所以学会主张禁止生产和销售带轮子的学步车，推荐用没轮子的固定游戏站台代替。学会给家长的说明写道，大多数学步车伤害发生时，大人就在旁边看着。孩子坐在学步车里，1 秒能冲出 3 英尺（约 0.9 米）以上。学步车能不能帮孩子学走路，学会的说法是不能，反而可能推迟。会推迟走路这一点，证据不硬。爱尔兰一项 190 名婴儿的调查里，用学步车的孩子独立走路平均晚约 3 周（61.12 周对 58.14 周）。用得越多，晚得越多。但这只是一次性问卷调查，没有分组对照。2002 年一篇小综述找到两项随机分组的试验，都没看出对开始走路有明显影响。把四项研究合起来算，晚 11 到 26 天，研究质量都偏低"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["来源"]},{"tag":"p","props":{"className":"life-citations"},"children":["Sims A, Chounthirath T, Yang J, Hodges NL, Smith GA (2018). Infant Walker-Related Injuries in the United States. Pediatrics, 142(4), e20174332. ",{"tag":"a","props":{"href":"https://doi.org/10.1542/peds.2017-4332","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1542/peds.2017-4332"]},"；American Academy of Pediatrics, Committee on Injury and Poison Prevention (2001). Injuries Associated With Infant Walkers. Pediatrics, 108(3), 790-792. ",{"tag":"a","props":{"href":"https://doi.org/10.1542/peds.108.3.790","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1542/peds.108.3.790"]},"；American Academy of Pediatrics (2022). Baby Walkers: A Dangerous Choice. HealthyChildren.org. ",{"tag":"a","props":{"href":"https://www.healthychildren.org/English/safety-prevention/at-home/Pages/baby-walkers-a-dangerous-choice.aspx","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.healthychildren.org/English/safety-prevention/at-home/Pages/baby-walkers-a-dangerous-choice.aspx"]},"；Garrett M, McElroy AM, Staines A (2002). Locomotor milestones and babywalkers: cross sectional study. BMJ, 324(7352), 1494. ",{"tag":"a","props":{"href":"https://doi.org/10.1136/bmj.324.7352.1494","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1136/bmj.324.7352.1494"]},"；Burrows P, Griffiths P (2002). Do baby walkers delay onset of walking in young children? British Journal of Community Nursing, 7(11), 581-586. ",{"tag":"a","props":{"href":"https://doi.org/10.12968/bjcn.2002.7.11.10889","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.12968/bjcn.2002.7.11.10889"]},"；Health Canada (2004-04-07). Minister Pettigrew announces a ban on baby walkers. News Release 2004-15. ",{"tag":"a","props":{"href":"https://www.canada.ca/en/news/archive/2004/04/minister-pettigrew-announces-ban-baby-walkers.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.canada.ca/en/news/archive/2004/04/minister-pettigrew-announces-ban-baby-walkers.html"]},"；Canada Consumer Product Safety Act (S.C. 2010, c. 21), section 5 and Schedule 2 item 3. ",{"tag":"a","props":{"href":"https://laws-lois.justice.gc.ca/eng/acts/C-1.68/FullText.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://laws-lois.justice.gc.ca/eng/acts/C-1.68/FullText.html"]},"；全国标准信息公共服务平台. GB 14749-2006 婴儿学步车安全要求. ",{"tag":"a","props":{"href":"https://std.samr.gov.cn/gb/search/gbDetailed?id=71F772D7639DD3A7E05397BE0A0AB82A","target":"_blank","rel":"noopener noreferrer"},"children":["https://std.samr.gov.cn/gb/search/gbDetailed?id=71F772D7639DD3A7E05397BE0A0AB82A"]},""]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["原书备注"]},{"tag":"p","props":{"className":"life-citations"},"children":["加拿大 2004 年 4 月 7 日起禁止销售、广告和进口学步车。二手的也不许在跳蚤市场和车库甩卖上卖，家里已有的，官方建议拆掉扔了。现行的加拿大消费品安全法把它列进禁售清单，任何人不得生产、进口、广告或销售。国内没查到禁售的规定，婴儿学步车按现行国家标准 GB 14749-2006 生产。标准管的是产品本身，管不住孩子冲向楼梯。美国 1997 年起，学步车要么做得比门宽，要么带台阶边的刹车，学会仍认为不够。孩子坐在里面够得更高，还会拉下桌布打翻热咖啡、抓到灶上的锅柄，或者连车掉进水池、浴缸。学会建议的替代品有三样：没轮子的固定游戏站台（座椅能转、能弹）、游戏围栏、高脚餐椅。送孩子去托育机构或别人家时，也要确认那里没在用学步车。添置大件的顺序见本节第 11 条（大件按「借、买二手、买新」的顺序考虑）。"]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["我的备注"]},{"tag":"button","props":{"type":"button"},"children":["写下对自己有用的提醒…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/tip/20-14"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["上一条"]},"怀孕、喂奶时在吃素，就补维生素 B12 或吃强化食品；孩子的辅食要有动物性食物，非要全素先找医生"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/tip/20-16"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["下一条"]},"孩子出生后就每天喂 400 国际单位维生素 D，吃母乳的尤其别漏，足月的 6 个月内一般不用另补钙"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["本主题的其他建议"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/20-03"},"children":[{"tag":"strong","props":{},"children":["按国家免疫规划把该打的疫苗打齐，全程免费，错过了只补没打完的剂次"]},{"tag":"span","props":{},"children":["国家免疫规划里的疫苗全程免费，接种单位不能收钱。孩子入托、入学都要查预防接种证，漏打的一般会被查出来补上。错过了只补没打完的那几剂，不用从头再打，换了厂家也能接…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/20-04"},"children":[{"tag":"strong","props":{},"children":["前 6 个月只喂母乳，连水都不用喂，6 个月起加辅食并继续母乳"]},{"tag":"span","props":{},"children":["孩子出生后第一个小时里就开始喂奶。前 6 个月只喂母乳，连水都不用喂。满 6 个月起加辅食，每天要有含铁多的动物性食物，母乳接着喂到 2 岁或更久。母乳不够或者…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/20-05"},"children":[{"tag":"strong","props":{},"children":["冲奶粉用 70 ℃ 以上的水，冲好放凉再喂，喝剩的倒掉"]},{"tag":"span","props":{},"children":["奶粉不是无菌的，可能带一种细菌，新生儿感染后四成到八成会死。先倒热水，等降到约 73.8 ℃ 再放奶粉，多数情况下能把这种菌杀到原来的十万分之一以下。热水会让维…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/20-06"},"children":[{"tag":"strong","props":{},"children":["不满 1 岁不喂蜂蜜"]},{"tag":"span","props":{},"children":["孩子不满 1 岁，不要喂蜂蜜。蜂蜜水、拌进辅食里的蜂蜜、含蜂蜜的糕点，都算。蜂蜜里可能带有引起肉毒中毒的细菌。大人肚子里的菌群能压住它，婴儿压不住。"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/20-07"},"children":[{"tag":"strong","props":{},"children":["出生时的维生素 K 针一定要打"]},{"tag":"span","props":{},"children":["新生儿身体里存的维生素 K 很少，不补可能出血，晚出现的那种常常是脑子里出血。塔什干没普遍做这种预防，每 10 万个新生儿有 478 个出这种血。做了预防，估计…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/20-08"},"children":[{"tag":"strong","props":{},"children":["不满 3 个月的婴儿体温到 38 ℃ 就直接去医院，不在家观察"]},{"tag":"span","props":{},"children":["孩子不满 3 个月，体温到 38 ℃ 就直接去医院。不要在家观察，也不要先喂退烧药再等等看。美国儿科学会专门给看着状态还可以的发热婴儿定了处理办法，所以「看着精…"]}]}]}]},{"tag":"a","props":{"className":"life-text-link","href":"/book/20"},"children":["阅读整个主题：刚出生的孩子怎么带 ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"15","height":"15","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]}]}]},{"tag":"nav","props":{"className":"life-tabbar","aria-label":"主导航"},"children":[{"tag":"a","props":{"className":"","href":"/book"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"21","height":"21","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-book-open","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M12 7v14"},"children":[]},{"tag":"path","props":{"d":"M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z"},"children":[]}]},{"tag":"span","props":{},"children":["全书"]}]},{"tag":"a","props":{"className":"","href":"/top-50"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"21","height":"21","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-star","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.42