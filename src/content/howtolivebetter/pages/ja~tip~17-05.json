tip/17-07"},"children":[{"tag":"span","props":{},"children":["07"]},"家族内に長期臥床または重度の障害がある人がいる場合、加入先の医療保険部門へ長期介護保険を申請してください。これは高齢者だけに支給されるものではありません"]},{"tag":"a","props":{"href":"/ja/tip/17-08"},"children":[{"tag":"span","props":{},"children":["08"]},"家族内に長期臥床の人がいる場合、褥瘡（床ずれ）を最大の敵と見なしましょう：電動エアマットレスの使用、定期的な体位変換、毎日、骨の突出部をチェックする"]},{"tag":"a","props":{"href":"/ja/tip/17-09"},"children":[{"tag":"span","props":{},"children":["09"]},"高齢者の白内障が視界に影響しているなら、眼科で手術の検討を。両目に症状がある場合は、二枚目の手術をあまり遅らせないこと"]},{"tag":"a","props":{"href":"/ja/tip/17-10"},"children":[{"tag":"span","props":{},"children":["10"]},"高齢者の犬の散歩ではリードを手に巻かず手のひらで握り、短く保つ。引っ張って飛び出さないよう犬を訓練する"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"現在地"},"children":[{"tag":"a","props":{"href":"/ja/book"},"children":["本を読む"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/ja/book/17"},"children":["第17章"," ·"," ","家族に高齢者がいる場合"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"17-05"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["05"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["エビデンス"," ","A"]}]},{"tag":"h1","props":{"lang":"ja"},"children":["高齢者に先払いを求める「投資型老後プラン」には一切手を出さないこと：カード作成、ベッド確保、介護マンション、移住型老後生活、高齢者向け製品の購入は、すべて同一の違法集金の手口です"]},{"tag":"p","props":{"lang":"ja","className":"life-entry-summary"},"children":["高齢者に先払いを求め、かつリターンを約束する老後プランは、すべて同じ詐欺の手口です。カード作成、ベッド確保、介護マンション、移住型老後生活、セミナーでの高齢者向け製品販売など。規定により、このような資金の損失は自己責任となります。介護マンションのベッド予約を名目に 1.36 億元を回収し、 2100 人以上を被害に遭わせたケースもあります。防げる唯一のタイミングは、お金を支払う直前です。"]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["費用・手間"]},{"tag":"p","props":{},"children":["費用はかかりません。以下の手口を高齢者に一度読み聞かせてください、数分で済みます。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["効果"]},{"tag":"p","props":{},"children":["民政部は5つの形態を挙げており、人物を特定するよりも名目を確認する方が信頼性が高い。"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"記録する：高齢者に先払いを求める「投資型老後プラン」には一切手を出さないこと：カード作成、ベッド確保、介護マンション、移住型老後生活、高齢者向け製品の購入は、すべて同一の違法集金の手口です"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"できている"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"やることに追加"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"お気に入り"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"このヒントを共有"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"詳細を閉じる"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["費用・手間"]},{"tag":"p","props":{},"children":["費用はかかりません。以下の手口を高齢者に一度読み聞かせてください、数分で済みます。今後、これらに遭遇したら、セミナーには行かない、見学には行かない、電話番号は教えない、と直接拒否してください。難しいのは、高齢者がすでに数回参加しており、相手と親しくなってしまっている場合、引き戻すのが容易ではないことです"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["効果"]},{"tag":"p","props":{},"children":["民政部は5つの形態を挙げており、人物を特定するよりも名目を確認する方が信頼性が高い。第一に、介護サービス機関の名を借りるケース：実体を持たず、一時的に会場を借り、介護機関と提携契約を結んでいると称して「詐欺的な請求（碰瓷）」を行う。第二に、「介護サービス」の提供を名目とするケース：「VIPカード」「会員カード」「プリペイドカード」を販売し、介護サービス費用の前払いを促すが、約束されたサービス内容は明らかに自社のベッド供給能力を超えている。第三に、介護「プロジェクト」への投資を名目とするケース：養生・介護拠点の出資や、架空の介護マンションの販売などがよくある名目である。その他、介護ベッドの長期賃貸や、「タイムバンク」による相互扶助型の介護などもある。これらは、元本回収型販売、アフターリース、買い戻し合意などの口実を用いている。4つ目は、「高齢者向け製品」の販売を名目とするもの：商品の買い戻し、預かり販売、キャッシュバック、無料健康診断、ギフトの贈呈、会議型マーケティング、健康セミナー、専門家による無料診療など。5つ目は、「移住型養老（高齢者向け居住サービス）」の享受を名目とするもの：低価格または無料の旅行、プリペイド式キャッシュバック、ポイントによる養老サービス。回収できないお金については、条例に明記されています。「違法集金防止および処置に関する条例」第25条では、「違法集金への参加によって被った損失は、参加者が自ら負担するものとする」と規定されており、失ったお金は自ら責任を負うしかありません。当局が発表した事例では、戴某平らが養老アパートのベッド予約を名目として 1.36 億元に及ぶ違法集金を行い、被害者は 2100 人以上にのぼりました。戴某平は集金詐欺罪により 15 年の懲役刑に処され、さらに 40 万元の罰金が科せられました。曹某銘は、養老産業への投資を名目に132.07億元の資金詐欺を行い、11万人以上が被害に遭った。同被告には無期懲役、政治的権利の終身剥奪、および個人資産の全額没収が言い渡された。健康食品の販売会が行っているのは詐欺罪である。倪某栄は、無料の宴会、景品の贈呈、送迎サービスを利用して、高齢者を講習会へと誘い込んだ。講師は「虚偽の人物像、虚偽の事例、不当に高い値引き」を用いて、抗がん効果を捏造した。高齢者たちは、原価の数十倍もの価格で「ジヒドロクエルセチン」を購入するよう騙された。販売額は62万元余りにのぼる。倪某栄には10年3か月の懲役と、12万元の罰金が科せられた（全国、条例は2021年5月1日より施行）"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["出典"]},{"tag":"p","props":{"className":"life-citations"},"children":["民政部 (2023). 关于养老服务领域非法集资的风险提示. ",{"tag":"a","props":{"href":"https://www.gov.cn/lianbo/bumen/202306/content_6886556.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/lianbo/bumen/202306/content_6886556.htm"]},"（中国政府网发布）；民政部、中国银保监会 (2021). 关于养老领域非法集资的风险提示. ",{"tag":"a","props":{"href":"https://www.mca.gov.cn/n152/n164/c36171/content.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.mca.gov.cn/n152/n164/c36171/content.html"]},"；国务院 (2021). 防范和处置非法集资条例（国务院令第 737 号，第二、二十五、三十条）. ",{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/2021-02/10/content_5586632.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/zhengce/zhengceku/2021-02/10/content_5586632.htm"]},"；最高人民检察院 (2022). 检察机关打击整治养老诈骗犯罪典型案例. ",{"tag":"a","props":{"href":"https://www.spp.gov.cn/xwfbh/wsfbt/202206/t20220617_560010.shtml","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.spp.gov.cn/xwfbh/wsfbt/202206/t20220617_560010.shtml"]},"；最高人民法院 (2025). 依法惩治涉民生领域诈骗犯罪典型案例（案例五 倪某荣诈骗案）. ",{"tag":"a","props":{"href":"https://www.court.gov.cn/zixun/xiangqing/482861.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.court.gov.cn/zixun/xiangqing/482861.html"]}]},{"tag":"a","props":{"href":"https://www.gov.cn/lianbo/bumen/202306/content_6886556.htm","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["出典を開く"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["著者の注記"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["判断基準は「見た目がまともか」ではなく、「先払いを求められているか」「リターンを約束されているか」です。介護施設は本来サービスを販売するものであり、そこに「投資」「配当」「元本回収」といった言葉が混じっていたら、信じてはいけません。高齢者がセミナー、旅行、無料診療などに連れて行かれること自体は違法ではなく、止めるのも困難です。防げるのは支払いの段階であり、第 3 条の「二人体制での確認ルール」と併せて活用してください。すでに支払ってしまった場合は、直ちに第 8 節第 2 条に従い、 110 または 96110 に連絡して支払停止を要求すると同時に、現地の違法集金対策を担う主管部門に通報してください。「リバースモーゲージ（自宅を活用した老後資金）」は別の仕組みです。第 6 条（住宅リバースモーゲージ型年金保険）を参照してください。"]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["自分のメモ"]},{"tag":"button","props":{"type":"button"},"children":["自分へのメモを書く…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/ja/tip/17-04"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["前へ"]},"高齢者がいつでも使える、断るためのフレーズ：「家族と相談させてください」"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/ja/tip/17-06"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["次へ"]},"保険会社による住宅リバースモーゲージ型年金保険を除き、他の「自宅を活用した老後プラン」には一切手を出さないこと。絶対に住宅を担保に理財商品を買ってはいけない"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["このテーマの他の提案"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/17-01"},"children":[{"tag":"strong","props":{},"children":["高齢なうちに、将来の後見人を書面で指定しておく"]},{"tag":"span","props":{},"children":["意識がはっきりしているうちに、数百元をかけて公証役場へ行き、将来誰が後見人になるかを明記した書面を作成しておきましょう。この書面がないと、…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/17-02"},"children":[{"tag":"strong","props":{},"children":["遺言を作成しましょう。後から作成したものが前のものを覆すため、公証遺言が優先されるとは限りません"]},{"tag":"span","props":{},"children":["法律は6種類の遺言を認めていますが、形式を間違えると書面全体が無効になります。これが最もよくある失敗です。自筆によるものは、本人が最初から…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/17-03"},"children":[{"tag":"strong","props":{},"children":["高齢者の資金は別口座で管理し、高額支出には二人確認のルールを設ける"]},{"tag":"span","props":{},"children":["高齢者を狙う詐欺では、贈り物や親身な言葉で信頼を積み上げてから大金を奪います。「誰にも言わないで」と口止めするのも典型です。一定額以上の支…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/17-07"},"children":[{"tag":"strong","props":{},"children":["家族内に長期臥床または重度の障害がある人がいる場合、加入先の医療保険部門へ長期介護保険を申請してください。これは高齢者だけに支給されるものではありません"]},{"tag":"span","props":{},"children":["長期介護保険は、介護を依頼するための費用を補助してくれます。家族に重度の障害があり、半年以上継続している場合は、加入先の医療保険部門へ申請…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/17-08"},"children":[{"tag":"strong","props":{},"children":["家族内に長期臥床の人がいる場合、褥瘡（床ずれ）を最大の敵と見なしましょう：電動エアマットレスの使用、定期的な体位変換、毎日、骨の突出部をチェックする"]},{"tag":"span","props":{},"children":["股関節骨折の手術前に褥瘡がある高齢者は、30 日以内に亡くなる可能性が約2割高まります。電動エアマットレスに交換することで、新しい褥瘡がで…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/17-09"},"children":[{"tag":"strong","props":{},"children":["高齢者の白内障が視界に影響しているなら、眼科で手術の検討を。両目に症状がある場合は、二枚目の手術をあまり遅らせないこと"]},{"tag":"span","props":{},"children":["70 歳以上の女性が、できるだけ早く片目の白内障手術を受けると、一年間の転倒回数が約3割4減少し、骨折する人も減少します。ただし、転倒した…"]}]}]}]},{"tag":"a","props":{"className":"life-text-link","href":"/ja/book/17"},"children":["テーマ全体を読む：家族に高齢者がいる場合"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"15","height":"15","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-righ