cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"分享这条建议"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"收起详情"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["成本"]},{"tag":"p","props":{"className":"life-citations"},"children":["不花钱，还省下买保健品的钱。不占时间。难在别人反复劝你试的时候能顶住。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["收益"]},{"tag":"p","props":{"className":"life-citations"},"children":["美国癌症登记数据里有两项研究，看的都是没转移、本来能治的乳腺癌、前列腺癌、肺癌和结直肠癌病人。第一项看只用替代疗法、手术放化疗和内分泌治疗一样都不做的人。和条件配对的正规治疗病人比，他们的死亡风险是 2.5 倍（HR 2.50，95% CI 1.88–3.27，高约 1.5 倍）。乳腺癌是 5.68 倍（3.22–10.04），肺癌是 2.17 倍（1.42–3.32），结直肠癌是 4.57 倍（1.66–12.61）。第二项看一边正规治疗、一边用补充疗法的人。他们拒绝手术的比例是 7.0% 对 0.1%，拒绝化疗是 34.1% 对 3.2%。拒绝放疗是 53.0% 对 2.3%，拒绝内分泌治疗是 33.7% 对 2.8%。5 年存活率是 82.2% 对 86.6%，死亡风险是 2.08 倍（HR 2.08，1.50–2.90，高约一倍）。把拖延和拒绝治疗算进去以后，补充疗法本身和死亡就看不出关系了（HR 1.39，0.83–2.33）。作者的结论是，多出来的死亡来自拒绝正规治疗。国家市场监管总局要求保健食品标签上标注：「保健食品不是药物，不能代替药物治疗疾病」。美国国家补充与整合健康中心（NCCIH）写明，贯叶连翘（也叫圣约翰草）会减弱多种药的作用。其中包括防器官移植排异的环孢素，和抗凝药华法林"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["来源"]},{"tag":"p","props":{"className":"life-citations"},"children":["Johnson SB, Park HS, Gross CP, Yu JB (2018). Use of Alternative Medicine for Cancer and Its Impact on Survival. Journal of the National Cancer Institute, 110(1), 121-124. ",{"tag":"a","props":{"href":"https://doi.org/10.1093/jnci/djx145","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1093/jnci/djx145"]},"；Johnson SB, Park HS, Gross CP, Yu JB (2018). Complementary Medicine, Refusal of Conventional Cancer Therapy, and Survival Among Patients With Curable Cancers. JAMA Oncology, 4(10), 1375-1381. ",{"tag":"a","props":{"href":"https://doi.org/10.1001/jamaoncol.2018.2487","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1001/jamaoncol.2018.2487"]},"；国家市场监督管理总局 (2019). 市场监管总局就《保健食品标注警示用语指南》和《保健食品原料目录与保健功能目录管理办法》有关情况举办专题新闻发布会. ",{"tag":"a","props":{"href":"https://www.samr.gov.cn/tssps/sjdt/tpxw/art/2023/art_4b658b824b1b4b0ba57c09a56cc93aad.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.samr.gov.cn/tssps/sjdt/tpxw/art/2023/art_4b658b824b1b4b0ba57c09a56cc93aad.html"]},"；National Center for Complementary and Integrative Health (2025). St. John's Wort. ",{"tag":"a","props":{"href":"https://www.nccih.nih.gov/health/st-johns-wort","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.nccih.nih.gov/health/st-johns-wort"]},""]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["原书备注"]},{"tag":"p","props":{"className":"life-citations"},"children":["只给 B 级。两项研究都只看了癌症，是从登记数据里跟踪下来的，没有分组对照，选替代疗法的人在别的方面也可能不一样。高血压、糖尿病这类病停药的账，见第 1 条（药按医嘱吃满）。想试补充剂就先告诉主治医生。保健品要不要花钱买，见第 6 节第 10 条（保健品、膏方、滋补品）"]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["我的备注"]},{"tag":"button","props":{"type":"button"},"children":["写下对自己有用的提醒…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/tip/16-03"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["上一条"]},"复查按医生给的间隔做，把每次的指标记在同一个本子上"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/tip/16-05"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["下一条"]},"病情稳定的慢性病，在社区医院一次可以开到 12 周的药"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["本主题的其他建议"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/16-01"},"children":[{"tag":"strong","props":{},"children":["药按医嘱吃满，别感觉好了就停"]},{"tag":"span","props":{},"children":["按医生说的把药吃满的人，同期死亡的可能性大约只有断断续续吃药的人的一半。这个数要打折看。连假药都吃满的人死亡率也低，说明有一部分好处来自「能坚持吃药的人本来就更…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/16-02"},"children":[{"tag":"strong","props":{},"children":["先办门诊慢特病认定再办异地备案，高血压、糖尿病、放化疗、透析、抗排异就能异地直接结算"]},{"tag":"span","props":{},"children":["高血压、糖尿病、恶性肿瘤门诊放化疗、尿毒症透析、器官移植后抗排异，这五种在外地看门诊也能直接刷医保。不用先自己垫钱，再回参保地报销。但要先在参保地办门诊慢特病认…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/16-06"},"children":[{"tag":"strong","props":{},"children":["在社区签家庭医生之前，问清楚哪些进医保、哪些自费"]},{"tag":"span","props":{},"children":["签约的基本服务包按规定走医保。个性化服务包的钱要全部自己出。有人推销「升级包」的时候，先问清楚这是基本包还是个性化包、备没备案、一年多少钱。"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/16-07"},"children":[{"tag":"strong","props":{},"children":["确诊糖尿病就去查一次眼底，之后按医生给的间隔查；每年查一次脚"]},{"tag":"span","props":{},"children":["糖尿病伤到眼底、伤到脚，在坏到看不见、烂起来之前几乎没有感觉。早查出来还有得治。2 型糖尿病确诊当时就查一次散瞳眼底，1 型在发病 5 年后开始查。查过一两次没…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/16-08"},"children":[{"tag":"strong","props":{},"children":["得过肾结石就把水喝到每天 2.5–3 升，盐降到 6 克以内"]},{"tag":"span","props":{},"children":["第一次长了钙结石的人，什么都不做的话，五年里约四分之一会再长。每天把水喝够的人，五年里复发的只有一成多，少了一半多。英国指南给的量是每天喝 2.5 到 3 升水…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/16-09"},"children":[{"tag":"strong","props":{},"children":["确诊痛风就长期吃降尿酸药，把血尿酸压到 360 µmol/L 以下并一直维持"]},{"tag":"span","props":{},"children":["痛风要长期吃降尿酸药，把尿酸压到 360 µmol/L 以下，不能只在疼的时候吃止痛药。由护士按化验结果帮着调药量的病人，两年后 95% 达标，照常看病的只有…"]}]}]}]},{"tag":"a","props":{"className":"life-text-link","href":"/book/16"},"children":["阅读整个主题：得了慢性病之后怎么活 ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"15","height":"15","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]}]}]},{"tag":"nav","props":{"className":"life-tabbar","aria-label":"主导航"},"children":[{"