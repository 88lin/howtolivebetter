n":[]},{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},{"tag":"span","props":{},"children":["ログイン"]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/ja/book/26"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"目次に戻る"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["ウェブサイトやプラットフォームの構築：資格、届出、サーバー"]},{"tag":"nav","props":{"aria-label":"この章のヒント"},"children":[{"tag":"a","props":{"href":"/ja/tip/26-01"},"children":[{"tag":"span","props":{},"children":["01"]},"プラットフォームが自ら代金を受け取ってから販売者に送金するのではなく、ライセンスを持つ決済機関を通じて直接決済される仕組みにすること"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/ja/tip/26-02","data-status":"active"},"children":[{"tag":"span","props":{},"children":["02"]},"有料サイトの多くは許可証が必要。自社販売のみ（他者の出店不可）なら不要。仲介取引は別の許可が必要。無料なら届出のみでOK"]},{"tag":"a","props":{"href":"/ja/tip/26-03"},"children":[{"tag":"span","props":{},"children":["03"]},"ライブ配信にはネットワーク文化経営許可証が必要。視聴覚番組用の許可証は民間企業ではほぼ取得不可能"]},{"tag":"a","props":{"href":"/ja/tip/26-04"},"children":[{"tag":"span","props":{},"children":["04"]},"サーバーを国内に置く場合は备案（届出）が必要であり、接続事業者は自ら付加価値通信許可を保有していなければならない"]},{"tag":"a","props":{"href":"/ja/tip/26-05"},"children":[{"tag":"span","props":{},"children":["05"]},"ユーザーに販売を許可する場合、プラットフォームは登録情報の照合、情報の報告、および3年間の保存を行う義務がある"]},{"tag":"a","props":{"href":"/ja/tip/26-06"},"children":[{"tag":"span","props":{},"children":["06"]},"ユーザーが投稿したコンテンツの管理義務：審査メカニズム、通報窓口、違法発見時の即時停止および報告"]},{"tag":"a","props":{"href":"/ja/tip/26-07"},"children":[{"tag":"span","props":{},"children":["07"]},"情報提供・即時通信サービスを提供する場合、ユーザーに真実の身元情報の提供を義務付けなければならない"]},{"tag":"a","props":{"href":"/ja/tip/26-08"},"children":[{"tag":"span","props":{},"children":["08"]},"16歳未満の者へのライブ配信許可禁止、投げ銭（ギフティング）は年齢に応じて段階的に処理"]},{"tag":"a","props":{"href":"/ja/tip/26-09"},"children":[{"tag":"span","props":{},"children":["09"]},"権利侵害の通知を受けた際は速やかに処理すること。異議申し立ての転送後、15日以内に進展がなければ復旧させる"]},{"tag":"a","props":{"href":"/ja/tip/26-10"},"children":[{"tag":"span","props":{},"children":["10"]},"ユーザー情報は安易に国外へ持ち出さないでください。国外への持ち出しには法的な条件と人数制限があります"]},{"tag":"a","props":{"href":"/ja/tip/26-11"},"children":[{"tag":"span","props":{},"children":["11"]},"サーバー選びは、まずダウンタイムに耐えられるか、次に運用担当者がいるかを確認し、最後に価格を比較すること"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"現在地"},"children":[{"tag":"a","props":{"href":"/ja/book"},"children":["本を読む"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/ja/book/26"},"children":["第26章"," ·"," ","ウェブサイトやプラットフォームの構築：資格、届出、サーバー"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"26-02"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["02"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["エビデンス"," ","A"]}]},{"tag":"h1","props":{"lang":"ja"},"children":["有料サイトの多くは許可証が必要。自社販売のみ（他者の出店不可）なら不要。仲介取引は別の許可が必要。無料なら届出のみでOK"]},{"tag":"p","props":{"lang":"ja","className":"life-entry-summary"},"children":["ユーザーから料金を徴収するサイトは、多くの場合、事前に「増値電信業務経営許可証」を取得する必要があります。この許可証は個人では取得できません。自社のサイトやApp内でのみ商品を販売し、他者の出店を許可しない場合は、取得の必要はありません。WeChatやAlipayのミニプログラム、またはネットショップのみを運営する場合も不要です。許可が必要な場合に無許可で料金を徴収してサイトを運営すると、収益の没収に加え罰金が科せられ、重大な場合はサイトの閉鎖に至ります。"]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["費用・手間"]},{"tag":"p","props":{},"children":["届出費用は無料です。付加価値通信業務営業許可証には費用がかかります。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["効果"]},{"tag":"p","props":{},"children":["法規の原文には「国家は営利目的のインターネット情報サービスに対して許可制度を、非営利目的のインターネット情報サービスに対して届出制度を実施する。"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"記録する：有料サイトの多くは許可証が必要。自社販売のみ（他者の出店不可）なら不要。仲介取引は別の許可が必要。無料なら届出のみでOK"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"できている"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"やることに追加"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"お気に入り"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"このヒントを共有"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"詳細を閉じる"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["費用・手間"]},{"tag":"p","props":{},"children":["届出費用は無料です。付加価値通信業務営業許可証には費用がかかります。これは「ユーザーから料金を徴収するサイトの運営が可能かどうか」を管理するものです。この許可証を取得するには、まず法人である必要があります。省内のみで運営する場合は、資本金が 100 万元以上であること。省をまたいで運営する場合は、1000 万元以上であること。審査期間は 60 日、許可証の有効期間は 5 年です。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["効果"]},{"tag":"p","props":{},"children":["法規の原文には「国家は営利目的のインターネット情報サービスに対して許可制度を、非営利目的のインターネット情報サービスに対して届出制度を実施する。許可を取得していない、または届出の手続きを行っていない場合は、インターネット情報サービスに従事してはならない」とあります。料金を受け取る場合は、まず許可証を取得しなければならず、受け取らない場合は、まず届出（备案）を行わなければなりません。どちらも行わない状態ではサイトを開設できません。「営利目的」とは何を指すのでしょうか？法規では「インターネットを通じて、インターネットユーザーに対し、有益な情報提供やウェブページ制作などのサービス活動を有償で行うこと」とされています。簡単に言えば、ユーザーからお金を取ることです。取引を仲介するタイプは「オンラインデータ処理および取引処理業務」と呼ばれ、業界内では「EDI」と略されます。法規による定義は、「公衆通信網またはインターネットに接続された各種データおよび取引/事務処理アプリケーションプラットフォームを利用し、公衆通信網またはインターネットを通じてユーザーにオンラインデータ処理および取引/事務処理を提供する業務」です。これには「取引処理業務、電子データ交換業務、およびネットワーク/電子機器データ処理業務」も含まれます。つまり、ウェブサイトがユーザーに代わってオンラインでデータを処理したり、買い手と売り手の間の取引を仲介・処理したりすることを指します。無許可での営業、または許可範囲を超えた営業（許可証に記載された範囲外の業務を行うこと）を行った場合は、不当な利益を没収した上で、その不当な利益の3倍から5倍の罰金が科せられます。不当な利益がない場合、または不当な利益が5万元に満たない場合は、10万元から100万元の罰金が科せられます。事態が重大な場合は、ウェブサイトの閉鎖（全国規模）が命じられます。ただし、料金を受け取ることが必ずしも許可証の取得を意味するわけではありません。広東省通信管理局が2025年10月に発行したQ&Aによると、工信部の要求に基づき、以下の3つのケースではこの許可証は不要とされています。第一に、企業が自社のサイトやAppにおいて「自社運営方式で、自社または他社の商品・サービスを直接販売」しており、かつ他の団体や個人による出店を許可していない場合。第二に、企業が自社のサイトやAppにおいて自社の情報のみを発信し、他者に情報発信プラットフォームを提供していない場合。第三に、企業がWeChatやAlipayなどのプラットフォーム上のミニプログラム、公式アカウント、動画アカウント、ネットショップのみでビジネスを行っており、「かつ他に独立した運営プラットフォームを持たない」場合。逆に、他者の出店を許可したり、ユーザーに情報の投稿を許可したりする場合は、これら3つのケースには該当しません。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["出典"]},{"tag":"p","props":{"className":"life-citations"},"children":["广东省通信管理局 (2025). 关于办理增值电信业务经营许可证的常见问题解答（2025 年 10 月 17 日，第一项）. ",{"tag":"a","props":{"href":"https://gdca.miit.gov.cn/bsfw/bszn/jyxk/tzgg/art/2025/art_6bcbfa4f041247868c0de08e765b33e9.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://gdca.miit.gov.cn/bsfw/bszn/jyxk/tzgg/art/2025/art_6bcbfa4f041247868c0de08e765b33e9.html"]}," ; 国务院 (2000). 互联网信息服务管理办法（国务院令第 292 号，2024 年 12 月 6 日第二次修订，第三、四、七、十九条）. ",{"tag":"a","props":{"href":"https://www.gov.cn/gongbao/content/2011/content_1860864.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/gongbao/content/2011/content_1860864.htm"]}," ; 国务院 (2024). 关于修改和废止部分行政法规的决定（国务院令第 797 号，第十八项）. ",{"tag":"a","props":{"href":"https://www.gov.cn/gongbao/2025/issue_11786/202501/content_6997034.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/gongbao/2025/issue_11786/202501/content_6997034.html"]}," ; 国务院 (2000). 电信条例（2016 年第二次修订，第七、九、十三、六十九条）. ",{"tag":"a","props":{"href":"https://www.gov.cn/gongbao/content/2016/content_5139478.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/gongbao/content/2016/content_5139478.htm"]}," ; 工业和信息化部 (2017). 电信业务经营许可管理办法（工信部令第 42 号，第六、九、十一、十四条）. ",{"tag":"a","props":{"href":"https://www.gov.cn/gongbao/content/2017/content_5240090.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/gongbao/content/2017/content_5240090.htm"]}]},{"tag":"a","props":{"href":"https://gdca.miit.gov.cn/bsfw/bszn/jyxk/tzgg/art/2025/art_6bcbfa4f041247868c0de08e765b33e9.html","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["出典を開く"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["著者の注記"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["あなたが検討している事業がEDIに該当するかどうかは、『電気通信業務分類目録』の定義に照らし合わせて自身で判断してください。当局は「仲介や資金決済を伴うECプラットフォームは必ずEDI許可を取得しなければならない」とは一言も明言していません。工信部の業務ガイドラインには「業務の定義に従って、相応の電気通信業務営業許可を申請すること」と記されているのみです。したがって、取得の要否は定義に基づき自身で判断するしかありません。もう一点、この許可証は個人では取得できず、申請者は法律に基づいて設立された法人である必要があります。自社販売で許可が不要な3つのケースは、広東省通信管理局のQ&QAに基づいています。そこには工信部の要求に従う旨が明記されていますが、他の省では同様の公開文書は見当たりませんでした。判断に迷う場合は、まず現地の通信管理局に電話で問い合わせてください。また、このQ&Aでは、許可申請に仲介業者を利用する必要はなく、工信部の「電気通信業務市場総合管理情報システム」上で直接資料を提出すること、および公式の手続きに費用はかからないことも注意喚起されています。"]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["自分のメモ"]},{"tag":"button","props":{"type":"button"},"children":["自分へのメモを書く…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/ja/tip/26-01"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["前へ"]},"プラットフォームが自ら代金を受け取ってから販売者に送金するのではなく、ライセンスを持つ決済機関を通じて直接決済される仕組みにすること"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/ja/tip/26-03"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["次へ"]},"ライブ配信にはネットワーク文化経営許可証が必要。視聴覚番組用の許可証は民間企業ではほぼ取得不可能"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["このテーマの他の提案"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/26-04"},"children":[{"tag":"strong","props":{},"children":["サーバーを国内に置く場合は备案（届出）が必要であり、接続事業者は自ら付加価値通信許可を保有していなければならない"]},{"tag":"span","props":{},"children":["サーバーを国内に置く場合、サイト開設前に备案（届出）を行う必要があります。备案に費用はかからず、サーバーと一緒にサービスプロバイダーを通じ…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/26-05"},"children":[{"tag":"strong","props":{},"children":["ユーザーに販売を許可する場合、プラットフォームは登録情報の照合、情報の報告、および3年間の保存を行う義務がある"]},{"tag":"span","props":{},"children":["他者に自社プラットフォームでの販売を許可する場合、まず販売者の身元、住所、連絡先、および許可証を照合し、登録・アーカイブ化する必要がありま…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/26-06"},"children":[{"tag":"strong","props":{},"children":["ユーザーが投稿したコンテンツの管理義務：審査メカニズム、通報窓口、違法発見時の即時停止および報告"]},{"tag":"span","props":{},"children":["ユーザーが投稿した内容に関して、問題が発生した場合はプラットフォームが責任を負います。以下の制度を構築する必要があります：登録、投稿審査、…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/26-07"},"children":[{"tag":"strong","props":{},"children":["情報提供・即時通信サービスを提供する場合、ユーザーに真実の身元情報の提供を義務付けなければならない"]},{"tag":"span","props":{},"children":["あなたのサイトで投稿やチャットができる場合、ユーザーがサービスを開始する際に真実の身元情報を取得する必要があります。提供しない場合は、利用…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/26-08"},"children":[{"tag":"strong","props":{},"children":["16歳未満の者へのライブ配信許可禁止、投げ銭（ギフティング）は年齢に応じて段階的に処理"]},{"tag":"span","props":{},"children":["16歳未満の者は、あなたのサイトで配信アカウントを登録することはできません。16歳以上の場合は、身元認証に加え、親またはその他の保護者の同…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/26-09"},"children":[{"tag":"strong","props":{},"children":["権利侵害の通知を受けた際は速やかに処理すること。異議申し立ての転送後、15日以内に進展がなければ復旧させる"]},{"tag":"span","props":{},"children":["権利侵害の通知が届き、初歩的な証拠が添付されている場合は、速やかにコンテンツを削除、ブロック、またはリンクを遮断し、同時にその通知を販売者…"]}]}]}]},{"tag":"a","props":{"className":"life-text-link","href":"/ja/book/26"},"children":["テーマ全体を読む：ウェブサイトやプラットフォームの構築：資格、届出、サーバー"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"15","height":"15","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]}]}]},{"tag":"nav","props":{"className":"life-tabbar","aria-label":"メインナビゲーション"},"children":[{"tag":"a","props":{"className":"","href":"/ja/book"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"21","height":"21","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-book-open","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M12 7v14"},"children":[]},{"tag":"path","props":{"d":"M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z"},"children":[]}]},{"tag":"span","props":{},"children":["本"]}]},{"tag":"a","props":{"className":"","href":"/ja/top-50"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"21","height":"21","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-star","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.6