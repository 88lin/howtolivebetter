]},{"tag":"a","props":{"href":"/vi/tip/06-17"},"children":[{"tag":"span","props":{},"children":["17"]},"Đừng coi hiến máu là cách giữ sức khoẻ: 「giải độc, hạ mỡ máu, phòng nhồi máu cơ tim」 không có thử nghiệm chia nhóm ngẫu nhiên nào đỡ, hiến thường xuyên thì đúng là dễ thiếu sắt"]},{"tag":"a","props":{"href":"/vi/tip/06-18"},"children":[{"tag":"span","props":{},"children":["18"]},"Đừng dựa vào gói khám sức khoẻ tổng quát để phòng bệnh, hãy làm đúng mấy xét nghiệm sàng lọc có bằng chứng theo tuổi và giới"]},{"tag":"a","props":{"href":"/vi/tip/06-19"},"children":[{"tag":"span","props":{},"children":["19"]},"Đừng bắt đầu uống thuốc hạ acid uric chỉ vì xét sức khoẻ ra acid uric cao mà chưa từng đau lần nào"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/vi/tip/06-20","data-status":"active"},"children":[{"tag":"span","props":{},"children":["20"]},"Đừng cắt túi mật phòng bệnh chỉ vì khám ra sỏi mật mà chưa từng đau"]},{"tag":"a","props":{"href":"/vi/tip/06-21"},"children":[{"tag":"span","props":{},"children":["21"]},"Đừng bỏ canxi hoàn toàn để phòng sỏi thận"]},{"tag":"a","props":{"href":"/vi/tip/06-22"},"children":[{"tag":"span","props":{},"children":["22"]},"Đừng mua tinh thể, chuỗi tay, tượng Pixiu chỉ để 「đổi vận」「kéo tài」「dưỡng người」"]},{"tag":"a","props":{"href":"/vi/tip/06-23"},"children":[{"tag":"span","props":{},"children":["23"]},"Đừng trông chờ mua sắm để cải thiện tâm trạng hay cảm giác về vị thế của mình"]},{"tag":"a","props":{"href":"/vi/tip/06-24"},"children":[{"tag":"span","props":{},"children":["24"]},"Đừng bỏ thêm tiền đổi nhà, đổi xe, đổi giới xung quanh chỉ để「được lên một bậc」"]},{"tag":"a","props":{"href":"/vi/tip/06-25"},"children":[{"tag":"span","props":{},"children":["25"]},"Đừng tin「ý chí giống cơ, dùng một lát là hết」"]},{"tag":"a","props":{"href":"/vi/tip/06-26"},"children":[{"tag":"span","props":{},"children":["26"]},"Đừng trông chờ ăn sáng hay chế độ ăn 16:8 giúp bạn kiểm soát cân nặng, hãy chọn khung giờ ăn mà bạn theo được lâu dài"]},{"tag":"a","props":{"href":"/vi/tip/06-27"},"children":[{"tag":"span","props":{},"children":["27"]},"Đừng tin 「thủ dâm tổn hại sức khoẻ」「nhịn thái dâm mới được cải thiện」, điều cần xem thật sự là có làm lỡ giấc ngủ, công việc và quan hệ hay không"]},{"tag":"a","props":{"href":"/vi/tip/06-28"},"children":[{"tag":"span","props":{},"children":["28"]},"Đừng bỏ tiền làm 「điều chỉnh xu hướng tính dục」「chữa chứng đồng tính」, cũng đừng đưa người nhà đi"]},{"tag":"a","props":{"href":"/vi/tip/06-29"},"children":[{"tag":"span","props":{},"children":["29"]},"Đừng mong «tư thế nâng đúng» hay lớp huấn luyện bốc vác ngăn được đau lưng; hãy giảm trọng lượng và số lần nâng, tập thể dục đều đặn"]},{"tag":"a","props":{"href":"/vi/tip/06-30"},"children":[{"tag":"span","props":{},"children":["30"]},"Đừng mong bổ sung thật nhiều canxi hay uống nước hầm xương sau khi gãy xương sẽ giúp xương liền nhanh hơn"]},{"tag":"a","props":{"href":"/vi/tip/06-31"},"children":[{"tag":"span","props":{},"children":["31"]},"Đừng dựa vào chatbot AI để tự chẩn đoán hay phán đoán pháp lý; trước khi chữa bệnh, kiện tụng hoặc chi nhiều tiền, tìm văn bản gốc kiểm tra căn cứ nó nêu"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"Breadcrumbs"},"children":[{"tag":"a","props":{"href":"/vi/book"},"children":["Khám phá cuốn sách"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/vi/book/06"},"children":["Chương 6"," ·"," ","Danh sách phản tác dụng"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"06-20"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["20"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["Bằng chứng"," ","A"]}]},{"tag":"h1","props":{"lang":"vi"},"children":["Đừng cắt túi mật phòng bệnh chỉ vì khám ra sỏi mật mà chưa từng đau"]},{"tag":"p","props":{"lang":"vi","className":"life-entry-summary"},"children":["Người có sỏi trong túi mật mà chưa từng đau, trong gần chín năm nay khoảng tám phần trăm không có triệu chứng. Không đụng vào nó, mỗi năm tỷ lệ gặp viêm túi mật, viêm tụy cấp loại này khoảng một phần nghìn đến ba phần nghìn. Cắt túi mật cũng không có rủi ro bằng không, khoảng 1.5% người bị tổn thương đường mật. Nên cả hướng dẫn của châu Âu lẫn của nước Anh đều nói không có triệu chứng thì chưa cắt."]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Chi phí"]},{"tag":"p","props":{},"children":["Không tốn tiền, còn tiết kiệm một ca mổ gây mê toàn thân v…"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Lợi ích"]},{"tag":"p","props":{},"children":["Khảo sát dân số MICOL của Ý siêu âm cho 11.229 người từ 29 đến 69 tuổi. Ra sỏi ở 856 người, trong đó 580 người…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"Đánh dấu: Đừng cắt túi mật phòng bệnh chỉ vì khám ra sỏi mật mà chưa từng đau"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"Hoàn tất"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"Kế hoạch thực hiện"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"Lưu"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Chia sẻ mẹo này"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Ẩn chi tiết"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Chi phí"]},{"tag":"p","props":{},"children":["Không tốn tiền, còn tiết kiệm một ca mổ gây mê toàn thân và một lần nằm viện. Cái đổi lại là phải nhớ những dấu hiệu nào vừa xuất hiện là phải đi bệnh viện ngay."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Lợi ích"]},{"tag":"p","props":{},"children":["Khảo sát dân số MICOL của Ý siêu âm cho 11.229 người từ 29 đến 69 tuổi. Ra sỏi ở 856 người, trong đó 580 người không có triệu chứng, theo dõi trung bình 8.7 năm. Trong 580 người đó, 453 người (78.1%) không có triệu chứng, 61 người (10.5%) xuất hiện triệu chứng nhẹ, 66 người (11.4%) xuất hiện triệu chứng nặng. Trong thời gian theo dõi có tổng cộng 189 ca cắt túi mật, trong đó 41.3% làm trên người không có triệu chứng. Kết luận của tác giả là「theo dõi chờ vẫn là cách xử lý có hiệu quả với phần lớn bệnh nhân」, theo dõi chờ nghĩa là quan sát trước, không mổ. Một tổ chức y tế có trả phí ở Mỹ làm thống kê theo dõi, đây là một kiểu cơ sở khám chữa bệnh có quản lý, 691 người được xác nhận có sỏi mật, theo dõi trung bình 78±61.6 tháng. Trong đó 135 người không có triệu chứng được theo dõi 58±50.2 tháng (trung vị 46.3 tháng), chỉ 10% xuất hiện triệu chứng sỏi mật, 7% phải mổ. Trong 50 ca tử vong của toàn nhóm chỉ 2 ca liên quan đến đường mật, và cả hai đều ở nhóm có triệu chứng. Kết luận của tác giả là「bệnh nhân có sỏi không triệu chứng không cần mổ trước khi xuất hiện triệu chứng」, sỏi không triệu chứng là sỏi không kêu, không phát. Hướng dẫn CG188 của NICE tại khoản 1.2.1 viết rằng「Với người có túi mật và đường mật bình thường, phát hiện tình cờ có sỏi túi mật không triệu chứng, cần thông báo là không cần điều trị trước khi xuất hiện triệu chứng」. Hướng dẫn về sỏi mật năm 2016 của Hiệp hội Nghiên cứu bệnh gan châu Âu viết rõ rủi ro của cả hai bên cạnh nhau. Người không có triệu chứng mỗi năm khoảng 0.7% đến 2.5% xuất hiện triệu chứng. Mỗi năm gặp viêm túi mật cấp, viêm tụy cấp, vàng da do tắc mật (đường mật bị nghẽn, người ửng vàng) hoặc viêm đường mật là 0.1% đến 0.3%. Sau cơn đau quặn đầu tiên, biến chứng mới lên tới 1% đến 3% mỗi năm, nên phần lớn người sẽ đau một lần trước khi xảy ra chuyện nặng. Phía cắt trung, trong 51041 ca cắt túi mật ghi trong sổ đăng ký toàn quốc của Thụy Điển có 1.5% bị tổn thương đường mật. Trong đó khoảng một phần năm (0.3%) là đường mật đứt một phần hoặc hoàn toàn. Người bị tổn thương đường mật có tỷ lệ tử vong trong một năm là 3.9%, người không bị là 1.1%. Hướng dẫn còn viết, sau khi cắt có 10% đến 40% bệnh nhân vẫn khó chịu, hoặc khỏi một thời gian rồi lại tái phát. Kết luận của hướng dẫn là: người không có triệu chứng mà mổ, dù mổ hở hay mổ nội soi, đều không kéo dài tuổi thọ, vì rủi ro tử vong và biến chứng của bản thân ca mổ vượt quá rủi ro khi không cắt. Chờ có triệu chứng rồi mới xử lý thì tổng chi phí cũng thấp hơn. Một tính toán năm 1983 đã đưa ra con số cụ thể: ở nam giới 30 tuổi, cắt phòng bệnh so với theo dõi chờ thì sống ít đi trung bình 4 ngày; ở tuổi 50 thì ít đi 18 ngày. Đến nay chưa có thử nghiệm đối chứng chia nhóm ngẫu nhiên nào so cắt với không cắt. Cắt phòng bệnh trông như đáng vì trực giác「đã sớm muộn cũng đau, thà cắt một lần lúc còn trẻ」"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Nguồn gốc"]},{"tag":"p","props":{"className":"life-citations"},"children":["Festi D, Reggiani ML, Attili AF, et al. (2010). Natural history of gallstone disease: Expectant management or active treatment? Results from a population-based cohort study. Journal of Gastroenterology and Hepatology, 25(4), 719-724. ",{"tag":"a","props":{"href":"https://doi.org/10.1111/j.1440-1746.2009.06146.x","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1111/j.1440-1746.2009.06146.x"]},"；McSherry CK, Ferstenberg H, Calhoun WF, Lahman E, Virshup M (1985). The natural history of diagnosed gallstone disease in symptomatic and asymptomatic patients. Annals of Surgery, 202(1), 59-63. ",{"tag":"a","props":{"href":"https://doi.org/10.1097/00000658-198507000-00009","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1097/00000658-198507000-00009"]},"；National Institute for Health and Care Excellence (2014). Gallstone disease: diagnosis and management. NICE guideline CG188，第 1.2.1、1.3.1 条. ",{"tag":"a","props":{"href":"https://www.nice.org.uk/guidance/cg188/chapter/Recommendations","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.nice.org.uk/guidance/cg188/chapter/Recommendations"]},"；European Association for the Study of the Liver (2016). EASL Clinical Practice Guidelines on the prevention, diagnosis and treatment of gallstones. Journal of Hepatology, 65(1), 146-181. ",{"tag":"a","props":{"href":"https://doi.org/10.1016/j.jhep.2016.03.005","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1016/j.jhep.2016.03.005"]},"；Törnqvist B, Strömberg C, Persson G, Nilsson M (2012). Effect of intended intraoperative cholangiography and early detection of bile duct injury on survival after cholecystectomy: population based cohort study. BMJ, 345, e6457. ",{"tag":"a","props":{"href":"https://doi.org/10.1136/bmj.e6457","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1136/bmj.e6457"]},"；Ransohoff DF, Gracie WA, Wolfenson LB, Neuhauser D (1983). Prophylactic cholecystectomy or expectant management for silent gallstones. A decision analysis to assess survival. Annals of Internal Medicine, 99(2), 199-204. ",{"tag":"a","props":{"href":"https://doi.org/10.7326/0003-4819-99-2-199","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.7326/0003-4819-99-2-199"]},"；Gurusamy KS, Samraj K (2007). Cholecystectomy versus no cholecystectomy in patients with silent gallstones. Cochrane Database of Systematic Reviews, CD006230. ",{"tag":"a","props":{"href":"https://doi.org/10.1002/14651858.CD006230.pub2","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1002/14651858.CD006230.pub2"]},"；反方：Venneman NG, Buskens E, Besselink MG, et al. (2005). Small gallstones are associated with increased risk of acute pancreatitis: potential benefits of prophylactic cholecystectomy? American Journal of Gastroenterology, 100(11), 2540-2550. ",{"tag":"a","props":{"href":"https://doi.org/10.1111/j.1572-0241.2005.00317.x","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1111/j.1572-0241.2005.00317.x"]},"；中华医学会外科学分会胆道外科学组, 中国医师协会外科医师分会胆道外科医师委员会 (2022). 胆囊良性疾病外科治疗的专家共识（2021版）. 中华外科杂志, 60(1), 4-9. ",{"tag":"a","props":{"href":"https://doi.org/10.3760/cma.j.cn112139-20210811-00373","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.3760/cma.j.cn112139-20210811-00373"]},"（全文需订阅，未取得）；同上 (2022). 《胆囊良性疾病外科治疗的专家共识（2021版）》解读. 中华外科杂志, 60(4), 337-342. ",{"tag":"a","props":{"href":"https://doi.org/10.3760/cma.j.cn112139-20220119-00031","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.3760/cma.j.cn112139-20220119-00031"]}]},{"tag":"a","props":{"href":"https://doi.org/10.1111/j.1440-1746.2009.06146.x","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Liên kết mở nguồn"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Ghi chú sách"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["Tranh cãi. Chuyên đồng thuận của các chuyên gia bản 2021 trong phẫu thuật ngoại khoa đường mật tại Trung Quốc xếp một phần sỏi túi mật không triệu chứng vào chỉ định phẫu thuật. Bài giải thích trong cùng tạp chí nói rõ một trong các điểm còn tranh cãi nằm ở đây. Bản toàn văn chuyên đồng thuận phải trả phí để đọc, cụ thể là mấy trường hợp nào thì chưa đối chiếu được với nguyên văn (TODO: cần đối chiếu). Ý kiến phản biện ở một chỗ khác là sỏi nhỏ: sỏi kích thước dưới 5 milimét liên quan nhiều hơn với viêm tụy. Một tính toán ở Hà Lan nói loại người này cắt phòng bệnh có thể sống thêm hoặc sống ít hơn, tuỳ viêm tụy phổ biến đến đâu và chết người đến đâu. Hướng dẫn của châu Âu cũng liệt kê ngoại lệ: vỏ túi mật vôi hoá (túi mật sứ), có đồng thời polyp túi mật trên 1 centimet, hai loại này nên cắt. Khi cần mổ bụng lớn vì lý do khác, có thể cân nhắc cắt luôn. Mục này nói về đúng một tình huống: sỏi nằm trong túi mật và chưa từng đau. ",{"tag":"strong","props":{},"children":["Sỏi ở ống mật chủ là chuyện khác"]},". Khoản 1.3.1 của cùng hướng dẫn đó viết rõ, sỏi ở ống mật chủ dù có triệu chứng hay không đều phải làm sạch sỏi trong đường mật và cắt túi mật. Gặp các tình huống sau thì ngày hôm đó phải đi bệnh viện, đừng cứ dựa vào kết luận này mà chịu: đau quặn kéo dài ở hạ sườn phải hoặc vùng thượng bụng, sốt điên rối, lòng trắng mắt hoặc da vàng, nước tiểu sậm màu. Khi bác sĩ xem ảnh rồi khuyên mổ thì hỏi rõ ông ta căn cứ vào lý do nào, chẳng hạn đường mật bị ảnh hưởng, có polyp đi kèm, vỏ túi mật bất thường, đừng dùng kết luận này để phản bác ông ta. Nó chỉ chặn việc「không có lý do gì, chỉ vì thấy sỏi là cắt」. Hai nghiên cứu nêu trên đều chỉ theo dõi một nhóm người đi tiếp, không có nhóm đối chứng. Nhưng chúng muốn trả lời là「không đụng vào thì sẽ ra sao」, chứ không phải「cách điều trị nào tốt hơn」, dùng ở đây là hợp lý. Ngoài ra hai nghiên cứu này theo dõi từ 4 đến 9 năm, nếu lâu hơn nữa thì tỷ lệ xuất hiện triệu chứng sẽ tăng lên"]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Ghi chú của tôi"]},{"tag":"button","props":{"type":"button"},"children":["Viết một lời nhắc cho chính bạn…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/vi/tip/06-19"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Trước"]},"Đừng bắt đầu uống thuốc hạ acid uric chỉ vì xét sức khoẻ ra acid uric cao mà chưa từng đau lần nào"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/vi/tip/06-21"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Tiếp theo"]},"Đừng bỏ canxi hoàn toàn để phòng sỏi thận"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["Thêm trong chủ đề này"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/06-16"},"children":[{"tag":"strong","props":{},"children":["Đừng mua kính chống ánh sáng xanh để「bảo vệ thị lực」, cũng đừng tin「nhìn màn hình mấy tháng là mắt mù」, nhưng mắt nhức sưng đỏ thì coi là cấp cứu"]},{"tag":"span","props":{},"children":["Kính chống ánh sáng xanh không có tác dụng, không mua thì tiết kiệm đ…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/06-17"},"children":[{"tag":"strong","props":{},"children":["Đừng coi hiến máu là cách giữ sức khoẻ: 「giải độc, hạ mỡ máu, phòng nhồi máu cơ tim」 không có thử nghiệm chia nhóm ngẫu nhiên nào đỡ, hiến thường xuyên thì đúng là dễ thiếu sắt"]},{"tag":"span","props":{},"children":["Nói hiến máu giải độc, hạ mỡ máu, phòng nhồi máu cơ tim thì không đán…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/06-18"},"children":[{"tag":"strong","props":{},"children":["Đừng dựa vào gói khám sức khoẻ tổng quát để phòng bệnh, hãy làm đúng mấy xét nghiệm sàng lọc có bằng chứng theo tuổi và giới"]},{"tag":"span","props":{},"children":["Người đi khám sức khoẻ tổng quát định kỳ có tỷ lệ tử vong y như người…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/06-22"},"children":[{"tag":"strong","props":{},"children":["Đừng mua tinh thể, chuỗi tay, tượng Pixiu chỉ để 「đổi vận」「kéo tài」「dưỡng người」"]},{"tag":"span","props":{},"children":["Nói đeo vào thì đổi được vận, kéo được tài, dưỡng được người thì khôn…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/06-23"},"children":[{"tag":"strong","props":{},"children":["Đừng trông chờ mua sắm để cải thiện tâm trạng hay cảm giác về vị thế của mình"]},{"tag":"span","props":{},"children":["Người coi trọng tiền và vật chất càng nặng thì tự đánh giá mình càng …"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/06-24"},"children":[{"tag":"strong","props":{},"children":["Đừng bỏ thêm tiền đổi nhà, đổi xe, đổi giới xung quanh chỉ để「được lên một bậc」"]},{"tag":"span","props":{},"children":["So với những người có thu nhập bằng nhau, hàng xóm kiếm càng nhiều th…"]}]}]}]},{"tag":"a","props":{"className":"life-text-link","href":"/vi/book/06"},"children":["Đọc toàn bộ chủ đề: Danh sách phản tác dụng"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"15","height":"15","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]}]}]}]},{"tag":"aside","props":{"className":"life-ad-space life-ad-space-sponsored","data-ad-placement":"ad_footer","data-ad-group":"reading","data-ad-creative":"read_product","data-ad-ready":"false","aria-label":"Quảng cáo · Giới thiệu cộng đồng"},"children":[{"tag":"div","props":{"className":"life-ad-space-brand"},"children":[{"tag":"img","props":{"src":"/sites/howtolivebetter/images/shengcai/logo.png","width":"565","height":"144","alt":"Logo chính thức của Shengcai Youshu","decoding":"async"},"children":[]}]},{"tag":"div","props":{"className":"life-ad-space-copy"},"children":[{"tag":"span","props":{"className":"life-ad-space-label"},"children":["Quảng cáo · Giới thiệu cộng đồng"]},{"tag":"strong","props":{},"children":[