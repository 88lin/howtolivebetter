rops":{"cx":"12","cy":"10","r":"4"},"children":[]},{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},{"tag":"span","props":{},"children":["Войти"]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/ru/book/02"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"К содержанию"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["Не умирайте медленно"]},{"tag":"nav","props":{"aria-label":"Советы главы"},"children":[{"tag":"a","props":{"aria-current":"page","className":"active","href":"/ru/tip/02-01","data-status":"active"},"children":[{"tag":"span","props":{},"children":["01"]},"Бросайте курить — чем раньше, тем лучше"]},{"tag":"a","props":{"href":"/ru/tip/02-02"},"children":[{"tag":"span","props":{},"children":["02"]},"Не курите дома и в машине, а также не позволяйте гостям курить в вашем доме"]},{"tag":"a","props":{"href":"/ru/tip/02-03"},"children":[{"tag":"span","props":{},"children":["03"]},"Отказ от курения: не обходитесь только силой воли, сначала возьмите лекарства — шанс успеха вырастет более чем вдвое"]},{"tag":"a","props":{"href":"/ru/tip/02-04"},"children":[{"tag":"span","props":{},"children":["04"]},"Выберите день для полного отказа от курения — в этот день бросьте сразу, не уменьшайте дозу постепенно"]},{"tag":"a","props":{"href":"/ru/tip/02-05"},"children":[{"tag":"span","props":{},"children":["05"]},"Обратитесь в клинику по отказу от курения или позвоните на горячую линию 12320, чтобы узнать, есть ли такие услуги в вашем регионе"]},{"tag":"a","props":{"href":"/ru/tip/02-06"},"children":[{"tag":"span","props":{},"children":["06"]},"Курящим, уже не способным бросить, можно попробовать электронные сигареты, а некурящим — лучше не прикасаться к ним"]},{"tag":"a","props":{"href":"/ru/tip/02-07"},"children":[{"tag":"span","props":{},"children":["07"]},"Отказ от сладких напитков, даже безсахарных, не решает проблему"]},{"tag":"a","props":{"href":"/ru/tip/02-08"},"children":[{"tag":"span","props":{},"children":["08"]},"Не жевать бетель"]},{"tag":"a","props":{"href":"/ru/tip/02-09"},"children":[{"tag":"span","props":{},"children":["09"]},"Замена обычной соли на низконатриевую (калийную) соль дома"]},{"tag":"a","props":{"href":"/ru/tip/02-10"},"children":[{"tag":"span","props":{},"children":["10"]},"Регулярно чистите зубы и ежедневно удаляйте остатки пищи из межзубных промежутков; при потере зубов своевременно обращайтесь к стоматологу"]},{"tag":"a","props":{"href":"/ru/tip/02-11"},"children":[{"tag":"span","props":{},"children":["11"]},"Ежедневно нужно делать 7000–8000 шагов или набирать 150–300 минут быстрой ходьбы в неделю"]},{"tag":"a","props":{"href":"/ru/tip/02-12"},"children":[{"tag":"span","props":{},"children":["12"]},"При гипертонии и повышенном уровне холестерина следует принимать лекарства строго по назначению врача, не прекращая терапию самостоятельно"]},{"tag":"a","props":{"href":"/ru/tip/02-13"},"children":[{"tag":"span","props":{},"children":["13"]},"Спать примерно 7 часов в сутки и соблюдать режим"]},{"tag":"a","props":{"href":"/ru/tip/02-14"},"children":[{"tag":"span","props":{},"children":["14"]},"Регулярно занимайтесь ракеточными видами спорта: теннисом, бадминтоном, настольным теннисом"]},{"tag":"a","props":{"href":"/ru/tip/02-15"},"children":[{"tag":"span","props":{},"children":["15"]},"Соберите несколько коротких физических нагрузок вроде подъема по лестнице или быстрой ходьбы в суммарный объем в 4–5 минут в день"]},{"tag":"a","props":{"href":"/ru/tip/02-16"},"children":[{"tag":"span","props":{},"children":["16"]},"30–60 минут силовых тренировок в неделю"]},{"tag":"a","props":{"href":"/ru/tip/02-17"},"children":[{"tag":"span","props":{},"children":["17"]},"Не сидите подряд слишком долго — время от времени вставайте и двигайтесь"]},{"tag":"a","props":{"href":"/ru/tip/02-18"},"children":[{"tag":"span","props":{},"children":["18"]},"Меньше употреблять переработанное мясо (ветчину, бекон, колбасу, консервированное мясо)"]},{"tag":"a","props":{"href":"/ru/tip/02-19"},"children":[{"tag":"span","props":{},"children":["19"]},"Пейте как можно меньше или вообще не пейте"]},{"tag":"a","props":{"href":"/ru/tip/02-20"},"children":[{"tag":"span","props":{},"children":["20"]},"Людям, которые ежедневно пьют алкоголь и при прекращении приема испытывают дрожь и тревогу, не стоит самостоятельно бросать пить"]},{"tag":"a","props":{"href":"/ru/tip/02-21"},"children":[{"tag":"span","props":{},"children":["21"]},"Хотите пить меньше? Сначала посчитайте, сколько выпили за неделю, а потом поговорите с врачом несколько минут"]},{"tag":"a","props":{"href":"/ru/tip/02-22"},"children":[{"tag":"span","props":{},"children":["22"]},"Ежедневное употребление небольшой горсти орехов"]},{"tag":"a","props":{"href":"/ru/tip/02-23"},"children":[{"tag":"span","props":{},"children":["23"]},"Замена части красного мяса на рыбу и птицу"]},{"tag":"a","props":{"href":"/ru/tip/02-24"},"children":[{"tag":"span","props":{},"children":["24"]},"Замените часть белого риса и пшеничной муки на цельнозерновые продукты"]},{"tag":"a","props":{"href":"/ru/tip/02-25"},"children":[{"tag":"span","props":{},"children":["25"]},"Пить чай более трёх раз в неделю"]},{"tag":"a","props":{"href":"/ru/tip/02-26"},"children":[{"tag":"span","props":{},"children":["26"]},"Три–четыре чашки кофе в день без сахара и сливок"]},{"tag":"a","props":{"href":"/ru/tip/02-27"},"children":[{"tag":"span","props":{},"children":["27"]},"Съедать по 5 порций (около 400 г) фруктов и овощей в день"]},{"tag":"a","props":{"href":"/ru/tip/02-28"},"children":[{"tag":"span","props":{},"children":["28"]},"Меньше употреблять сверхобработанные продукты (чипсы, быстрые лапша, выпечка, полуфабрикаты)"]},{"tag":"a","props":{"href":"/ru/tip/02-29"},"children":[{"tag":"span","props":{},"children":["29"]},"Переход с угля и дров на электричество или газ для приготовления пищи и отопления"]},{"tag":"a","props":{"href":"/ru/tip/02-30"},"children":[{"tag":"span","props":{},"children":["30"]},"Дайте горячему напитку остыть, прежде чем пить — не пейте слишком горячий чай, суп или кофе"]},{"tag":"a","props":{"href":"/ru/tip/02-31"},"children":[{"tag":"span","props":{},"children":["31"]},"Выходите на солнце днём — не сидите всё время в помещении"]},{"tag":"a","props":{"href":"/ru/tip/02-32"},"children":[{"tag":"span","props":{},"children":["32"]},"Поддерживайте ИМТ в пределах 20–25: при избыточном весе нужно худеть"]},{"tag":"a","props":{"href":"/ru/tip/02-33"},"children":[{"tag":"span","props":{},"children":["33"]},"Употребление перца чили более четырех раз в неделю"]},{"tag":"a","props":{"href":"/ru/tip/02-34"},"children":[{"tag":"span","props":{},"children":["34"]},"Выпивать по одной-две порции молока или йогурта в день"]},{"tag":"a","props":{"href":"/ru/tip/02-35"},"children":[{"tag":"span","props":{},"children":["35"]},"Яйца можно есть, но не стоит употреблять по три-четыре штуки в день"]},{"tag":"a","props":{"href":"/ru/tip/02-36"},"children":[{"tag":"span","props":{},"children":["36"]},"При возможности принимайте ванну, а не ограничивайтесь душем"]},{"tag":"a","props":{"href":"/ru/tip/02-37"},"children":[{"tag":"span","props":{},"children":["37"]},"Ограничьте дневной сон полчаса — не более часа; если вам необходимо спать по часу-два, чтобы чувствовать себя нормально, стоит выяснить причину"]},{"tag":"a","props":{"href":"/ru/tip/02-38"},"children":[{"tag":"span","props":{},"children":["38"]},"После бессонной ночи ложитесь спать пораньше на следующий вечер — не откладывайте это на выходные"]},{"tag":"a","props":{"href":"/ru/tip/02-39"},"children":[{"tag":"span","props":{},"children":["39"]},"Чем дольше человек работает в ночную смену, тем выше риск сердечно-сосудистых заболеваний; при возможности стоит сменить работу"]},{"tag":"a","props":{"href":"/ru/tip/02-40"},"children":[{"tag":"span","props":{},"children":["40"]},"Покупайте готовую упакованную растительную нефть с номером разрешения SC, а не самодельное арахисовое масло из частных мастерских"]},{"tag":"a","props":{"href":"/ru/tip/02-41"},"children":[{"tag":"span","props":{},"children":["41"]},"Замена свиного и сливочного жира на растительное масло в приготовлении пищи — не требует покупки разных видов масел ради здоровья, а льняное масло не защищает сердце"]},{"tag":"a","props":{"href":"/ru/tip/02-42"},"children":[{"tag":"span","props":{},"children":["42"]},"Включайте вытяжку при жарке и тушении — с момента зажигания плиты и до конца готовки"]},{"tag":"a","props":{"href":"/ru/tip/02-43"},"children":[{"tag":"span","props":{},"children":["43"]},"Если приливы и ночная потливость в период менопаузы мешают жить, обратитесь к гинекологу для оценки гормональной терапии: не терпите и не покупайте лекарства самостоятельно, а для профилактики болезней сердца её не используйте"]},{"tag":"a","props":{"href":"/ru/tip/02-44"},"children":[{"tag":"span","props":{},"children":["44"]},"Если собаку и так хотели завести, засчитывайте ежедневные прогулки с ней в норму шагов, но не заводите собаку ради долголетия"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"Навигация"},"children":[{"tag":"a","props":{"href":"/ru/book"},"children":["Книга"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/ru/book/02"},"children":["Глава 2"," ·"," ","Не умирайте медленно"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"02-01"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["01"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["Доказательства"," ","A"]}]},{"tag":"h1","props":{"lang":"ru"},"children":["Бросайте курить — чем раньше, тем лучше"]},{"tag":"p","props":{"lang":"ru","className":"life-entry-summary"},"children":["Курильщики в среднем живут более чем на 10 лет меньше некурящих. Отказ от курения до 40 лет устраняет около 90% дополнительного риска смерти, связанного с продолжением курения. Чем раньше вы бросите, тем больше лет вернете. Если продолжать курить после перелома, шансы несращения кости примерно в 2,3 раза выше, поэтому до заживления кости не курите."]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Затраты"]},{"tag":"p","props":{},"children":["Это ничего не стоит и даже экономит деньги. Пачка сигарет…"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Польза"]},{"tag":"p","props":{},"children":["Американское исследование, в котором за людьми наблюдали без распределения по группам, показало: ожидаемая про…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"Отметить: Бросайте курить — чем раньше, тем лучше"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"Сделано"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"В планах"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"В избранное"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Поделиться советом"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Скрыть подробности"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Затраты"]},{"tag":"p","props":{},"children":["Это ничего не стоит и даже экономит деньги. Пачка сигарет в день обходится примерно в 20–30 юаней; после отказа эти деньги останутся у вас. Трудность — пережить синдром отмены, который обычно длится от нескольких недель до нескольких месяцев."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Польза"]},{"tag":"p","props":{},"children":["Американское исследование, в котором за людьми наблюдали без распределения по группам, показало: ожидаемая продолжительность жизни нынешних курильщиков более чем на 10 лет меньше, чем у никогда не куривших. Отказ до 40 лет устраняет около 90% дополнительного риска смерти, связанного с продолжением курения. Отказ в 25–34 года дает около 10 дополнительных лет жизни, в 35–44 — около 9, в 45–54 — около 6 (в оригинале результат указан в годах жизни). Аналогичные китайские исследования: в 2010-х риск смерти у городских мужчин-курильщиков был в 1,65 раза выше, чем у некурящих (RR 1.65), у сельских — в 1,22 раза. Через 10 лет после добровольного отказа эта дополнительная часть риска почти исчезала. Это важно и после перелома. Объединение 19 наблюдательных исследований показало: шансы несращения перелома у курильщиков примерно в 2,3 раза выше, чем у некурящих (OR 2.32, 95% CI 1.76–3.06, с поправкой на другие факторы). Они были повышены и при переломах большеберцовой кости, и при открытых переломах. В шведском рандомизированном испытании среди 50 человек, прошедших 6-недельную программу отказа от курения после экстренной операции по поводу перелома, хотя бы одно послеоперационное осложнение возникло у 20%. Среди 55 человек без программы — у 38%. Перед плановой операцией можно начать отказ за 4–8 недель, с еженедельными консультациями и никотинзаместительной терапией. Такой подход снижал частоту послеоперационных осложнений примерно на 58% (RR 0.42, 95% CI 0.27–0.65; 2 испытания, 210 человек)."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Первоисточники"]},{"tag":"p","props":{"className":"life-citations"},"children":["Jha P 等 (2013). 21st-century hazards of smoking and benefits of cessation in the United States. NEJM. ",{"tag":"a","props":{"href":"https://doi.org/10.1056/NEJMsa1211128","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1056/NEJMsa1211128"]},"；Chen Z 等 (2015). Contrasting male and female trends in tobacco-attributed mortality in China: evidence from successive nationwide prospective cohort studies. Lancet. ",{"tag":"a","props":{"href":"https://doi.org/10.1016/S0140-6736(15)00340-2","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1016/S0140-6736(15)00340-2"]},"；Oberg M 等 (2011). Worldwide burden of disease from exposure to second-hand smoke: a retrospective analysis of data from 192 countries. Lancet. ",{"tag":"a","props":{"href":"https://doi.org/10.1016/S0140-6736(10)61388-8","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1016/S0140-6736(10)61388-8"]},"（二手烟那两个数字）；Scolaro JA 等 (2014). Cigarette smoking increases complications following fracture: a systematic review. J Bone Joint Surg Am. ",{"tag":"a","props":{"href":"https://doi.org/10.2106/JBJS.M.00081","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.2106/JBJS.M.00081"]},"；Nåsell H 等 (2010). Effect of smoking cessation intervention on results of acute fracture surgery: a randomized controlled trial. J Bone Joint Surg Am. ",{"tag":"a","props":{"href":"https://doi.org/10.2106/JBJS.I.00627","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.2106/JBJS.I.00627"]},"；Thomsen T 等 (2014). Interventions for preoperative smoking cessation. Cochrane Database Syst Rev. ",{"tag":"a","props":{"href":"https://doi.org/10.1002/14651858.CD002294.pub4","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1002/14651858.CD002294.pub4"]},"（骨折和手术那几个数字）"]},{"tag":"a","props":{"href":"https://doi.org/10.1056/NEJMsa1211128","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Открыть источник"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Примечание автора"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["Пассивное курение тоже убивает: в 2004 году от него умерло около 603 тысяч человек во всем мире — примерно 1% всех смертей за тот год. Даже если сами не курите, избегайте чужого дыма, особенно не позволяйте детям дышать им. Конкретные способы отказа описаны в следующих четырех пунктах: пункт 3 (лекарства для отказа от курения), пункт 4 (назначить день отказа), пункт 5 (обратиться в кабинет помощи в отказе от курения), пункт 6 (электронные сигареты). Оценка несращения получена из наблюдательных исследований: курильщики могут отличаться от некурящих и по другим характеристикам, полностью учесть которые невозможно. В испытании отказа после перелома участвовало лишь 105 человек; при другом способе расчета различие уже не было статистически значимым."]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Моя заметка"]},{"tag":"button","props":{"type":"button"},"children":["Запишите напоминание…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"span","props":{},"children":[]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/ru/tip/02-02"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Следующий"]},"Не курите дома и в машине, а также не позволяйте гостям курить в вашем доме"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["Другие советы по этой теме"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/02-03"},"children":[{"tag":"strong","props":{},"children":["Отказ от курения: не обходитесь только силой воли, сначала возьмите лекарства — шанс успеха вырастет более чем вдвое"]},{"tag":"span","props":{},"children":["Ограничившись только силой воли, большинство людей не смогут бросить …"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/02-04"},"children":[{"tag":"strong","props":{},"children":["Выберите день для полного отказа от курения — в этот день бросьте сразу, не уменьшайте дозу постепенно"]},{"tag":"span","props":{},"children":["Большинство людей планируют сначала сокращать количество выкуриваемых…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/02-05"},"children":[{"tag":"strong","props":{},"children":["Обратитесь в клинику по отказу от курения или позвоните на горячую линию 12320, чтобы узнать, есть ли такие услуги в вашем регионе"]},{"tag":"span","props":{},"children":["Лекарства и регулярная поддержка со стороны специалистов — это два ра…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/02-06"},"children":[{"tag":"strong","props":{},"children":["Курящим, уже не способным бросить, можно попробовать электронные сигареты, а некурящим — лучше не прикасаться к ним"]},{"tag":"span","props":{},"children":["Среди людей, перешедших на электронные сигареты с никотином, доля тех…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/02-07"},"children":[{"tag":"strong","props":{},"children":["Отказ от сладких напитков, даже безсахарных, не решает проблему"]},{"tag":"span","props":{},"children":["У людей, выпивающих более двух бутылок сладких напитков в день, вероя…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/02-08"},"children":[{"tag":"strong","props":{},"children":["Не жевать бетель"]},{"tag":"span","props":{},"children":["У людей, регулярно жующих бетель, вероятность смерти в течение того ж…"]}]}]}]},{"tag":"a","props":{"className":"life-text-link","href":"/r