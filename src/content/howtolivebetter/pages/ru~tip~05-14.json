sName":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"В избранное"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Поделиться советом"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Скрыть подробности"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Затраты"]},{"tag":"p","props":{},"children":["Понадобится купить чайник. На каждый раз кипячения уйдёт немного времени, а также небольшие расходы на газ или электричество."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Польза"]},{"tag":"p","props":{},"children":["Первая ступень бытового тарифа в Пекине — 5 юаней за кубометр, или 0.005 юаня за литр. Бутыль для домашнего кулера вмещает 18.9 литра; при условной цене 20 юаней это около 1.06 юаня за литр, примерно в 210 раз дороже водопроводной воды. Одна бутыль в неделю — 52 бутыли, около 983 литров за год: примерно 1040 юаней за бутыли против примерно 4.9 юаня за столько же водопроводной воды. Небольшие бутылки по 1 юаню за 500 мл обходятся в 2 юаня за литр, в 400 раз дороже водопроводной воды. Для питьевой воды действует обязательный национальный стандарт GB 5749-2022, опубликованный 15 марта 2022 года и вступивший в силу 1 апреля 2023 года. Ответственное ведомство — Национальное управление контроля и профилактики заболеваний (Китай; тариф 2015 года и стандарт 2022 года)."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Первоисточники"]},{"tag":"p","props":{"className":"life-citations"},"children":["北京市发展和改革委员会. 居民用水价格表. ",{"tag":"a","props":{"href":"https://fgw.beijing.gov.cn/bmcx/djcx/jzldj/202003/t20200331_1752796.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://fgw.beijing.gov.cn/bmcx/djcx/jzldj/202003/t20200331_1752796.htm"]},"；国家市场监督管理总局 国家标准全文公开系统. GB 5749-2022 生活饮用水卫生标准. ",{"tag":"a","props":{"href":"https://openstd.samr.gov.cn/bzgk/std/newGbInfo?hcno=99E9C17E3547A3C0CE2FD1FFD9F2F7BE","target":"_blank","rel":"noopener noreferrer"},"children":["https://openstd.samr.gov.cn/bzgk/std/newGbInfo?hcno=99E9C17E3547A3C0CE2FD1FFD9F2F7BE"]},"；杭州市联合调查组 (2025). 关于杭州市余杭区部分小区供水异常调查情况通报（2025 年 7 月 23 日），新华网转载 ",{"tag":"a","props":{"href":"http://www.news.cn/20250723/1be62dac3b0b4461a643791ff552e93d/c.html","target":"_blank","rel":"noopener noreferrer"},"children":["http://www.news.cn/20250723/1be62dac3b0b4461a643791ff552e93d/c.html"]},"；杭州市余杭区人民政府. 余杭区 2025 年 4 月／5 月／6 月水源水水质监测数据（杭州余杭水务控股集团公开，检测单位杭州嘉澍环境监测有限公司，附件 PDF 表 1 第 24 项「粪大肠菌群」） ",{"tag":"a","props":{"href":"https://www.yuhang.gov.cn/art/2025/5/8/art_1229204072_59140140.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.yuhang.gov.cn/art/2025/5/8/art_1229204072_59140140.html"]},"、",{"tag":"a","props":{"href":"https://www.yuhang.gov.cn/art/2025/6/5/art_1229204072_59142885.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.yuhang.gov.cn/art/2025/6/5/art_1229204072_59142885.html"]},"、",{"tag":"a","props":{"href":"https://www.yuhang.gov.cn/art/2025/7/3/art_1229204072_59146464.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.yuhang.gov.cn/art/2025/7/3/art_1229204072_59146464.html"]},"；公安部网络安全保卫局 (2025). 编造虚假「警情通报」，捏造「粪水」谣言，邵某豪被刑事拘留 ",{"tag":"a","props":{"href":"http://www.news.cn/politics/20250722/3178b3bd189c4eb4b293982e92aab438/c.html","target":"_blank","rel":"noopener noreferrer"},"children":["http://www.news.cn/politics/20250722/3178b3bd189c4eb4b293982e92aab438/c.html"]},"；重庆市市场监督管理局 (2022). 桶装饮用水消费提示（2022 年 10 月 25 日） ",{"tag":"a","props":{"href":"https://scjgj.cq.gov.cn/bkzs/spbk/202210/t20221025_11222964.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://scjgj.cq.gov.cn/bkzs/spbk/202210/t20221025_11222964.html"]}]},{"tag":"a","props":{"href":"https://fgw.beijing.gov.cn/bmcx/djcx/jzldj/202003/t20200331_1752796.htm","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Открыть источник"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Примечание автора"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["Спор состоит в том, что «соответствие нормам» проверяют для воды на выходе с водоочистной станции и на концах водопроводной сети. При проблемах источника или трубопроводов защита может временно нарушиться. 16 июля 2025 года исходная вода на станции Рэньхэ в районе Юйхан города Ханчжоу имела необычный запах, и вода в некоторых кварталах Рэньхэ и Лянчжу стала неприятно пахнуть. По официальному заключению, разложение водорослей в условиях недостатка кислорода породило тиоэфирные соединения. После смены источника в воде на выходе не обнаружили общих колиформ и Escherichia coli, все показатели соответствовали GB 5749-2022. К ответственности привлекли 7 чиновников, оплату воды за июль полностью отменили, фильтрующие картриджи заменили бесплатно. Но в этом же источнике фекальные колиформы росли уже несколько месяцев до происшествия: на водозаборе Юншэн реки Тяоси в апреле было 10 на литр, в мае 7300, в июне 16000. Предел для поверхностных вод класса III по GB 3838 — 10000 на литр. В том же месяце его превышали и водохранилища Сылин — 28000 на литр — и Мантоушань — 24000 на литр. Кипячение лишь убивает микроорганизмы, но не удаляет вещества, вызывающие запах, и растворённые химикаты. Если вода необычно пахнет, пожелтела или помутнела, прекратите пить, сообщите поставщику и в службу 12345, временно перейдите на бутилированную воду; дополнительные минуты кипячения не решат проблему. Но это локальные редкие происшествия с компенсацией на месте, а не основание покупать бутилированную воду круглый год. Интернет-сообщение о «перепутанном подключении канализационных труб» было поддельным полицейским сообщением; автор задержан по уголовному делу (см. раздел 9). Цены 20 юаней за бутыль и 1 юань за 500 мл взяты условно для расчёта: пересчитайте по реальным ценам своего города. Большие бутыли тоже не обязательно чище: управление рыночного надзора Чунцина предупреждает, что чем дольше вода хранится после открытия, тем выше риск микробного загрязнения, а кулер нужно мыть не реже раза в 2–3 месяца. В старых кварталах с не соответствующими нормам системами вторичного водоснабжения можно установить фильтрацию или покупать питьевую воду только в этом случае. Тарифы различаются по местностям; пекинская цифра служит лишь для оценки порядка величины."]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Моя заметка"]},{"tag":"button","props":{"type":"button"},"children":["Запишите напоминание…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/ru/tip/05-13"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Предыдущий"]},"После однократной привязки семейного счёта в приложении медстраховки (ибао) средства с вашего личного счёта в рамках программы медстрахования работников можно использовать для лечения и покупки лекарств супругу, родителям и детям"]}]},{"tag":"a","props":{"className":"life-tip-pager-link 