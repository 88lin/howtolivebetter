","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"加入待做"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"收藏"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"分享这条建议"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"收起详情"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["成本"]},{"tag":"p","props":{},"children":["不花钱。把下面这几种名目念给老人听一遍，几分钟。以后遇上就直接拒绝：不去听课，不去参观，不留电话。难在老人要是已经去过几次、和人处熟了，就不容易劝回来"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["收益"]},{"tag":"p","props":{},"children":["民政部列了五种表现形式，认名目比认人可靠。第一种，假借养老服务机构之名：没有实体，临时租个场地，宣称和养老机构签了合作协议来「碰瓷」。第二种，以提供「养老服务」为名：卖「贵宾卡」「会员卡」「预付卡」，让人预交「养老服务费用」，承诺的服务明显超过自己的床位供给能力。第三种，以投资「养老项目」为名。常见名目有入股养生养老基地、销售虚构的养老公寓。还有长期出租养老床位、「时间银行」互助养老。打的幌子是返本销售、售后返租、约定回购。第四种，以销售「老年产品」为名：商品回购、寄存代售、消费返利、免费体检、赠送礼品、会议营销、养生讲座、专家义诊。第五种，以享受「旅居养老」为名：低价或免费旅游、储值返利、积分养老。钱追不回来，条例里写明了。防范和处置非法集资条例第二十五条规定，「因参与非法集资受到的损失，由集资参与人自行承担」，亏掉的钱只能自己认。官方通报过的案子里，戴某平等人以预定养老公寓床位名义非法集资 1.36 亿元，被害人 2100 余人，戴某平以集资诈骗罪判 15 年，并处罚金 40 万元。曹某铭以投资养老产业为名集资诈骗 132.07 亿元，涉及 11 万余人，判无期徒刑、剥夺政治权利终身、没收个人全部财产。保健品会销走的是诈骗罪。倪某荣用免费宴请、赠送礼品、专车接送，把老年人拉去听课。讲师用「虚假人设、虚假案例、虚高砍价」编造防癌抗癌功效。老人被诱骗以成本价的数十倍买「二氢槲皮素」。销售金额 62 万余元。倪某荣判 10 年 3 个月，并处罚金 12 万元（全国，条例 2021 年 5 月 1 日起施行）"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["原始出处"]},{"tag":"p","props":{"className":"life-citations"},"children":["民政部 (2023). 关于养老服务领域非法集资的风险提示. ",{"tag":"a","props":{"href":"https://www.gov.cn/lianbo/bumen/202306/content_6886556.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/lianbo/bumen/202306/content_6886556.htm"]},"（中国政府网发布）；民政部、中国银保监会 (2021). 关于养老领域非法集资的风险提示. ",{"tag":"a","props":{"href":"https://www.mca.gov.cn/n152/n164/c36171/content.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.mca.gov.cn/n152/n164/c36171/content.html"]},"；国务院 (2021). 防范和处置非法集资条例（国务院令第 737 号，第二、二十五、三十条）. ",{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/2021-02/10/content_5586632.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/zhengce/zhengceku/2021-02/10/content_5586632.htm"]},"；最高人民检察院 (2022). 检察机关打击整治养老诈骗犯罪典型案例. ",{"tag":"a","props":{"href":"https://www.spp.gov.cn/xwfbh/wsfbt/202206/t20220617_560010.shtml","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.spp.gov.cn/xwfbh/wsfbt/202206/t20220617_560010.shtml"]},"；最高人民法院 (2025). 依法惩治涉民生领域诈骗犯罪典型案例（案例五 倪某荣诈骗案）. ",{"tag":"a","props":{"href":"https://www.court.gov.cn/zixun/xiangqing/482861.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.court.gov.cn/zixun/xiangqing/482861.html"]}]},{"tag":"a","props":{"href":"https://www.gov.cn/lianbo/bumen/202306/content_6886556.htm","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["打开来源链接"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["原书备注"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["判断不靠「这家看着正规」，靠「有没有让你先交钱、有没有承诺回报」。养老机构本来是卖服务的，话里一带上投资、返利、回本，就别信。老人被拉去听课、旅游、义诊，本身不违法，也很难拦住。能拦的是掏钱那一步，配合第 3 条的双人确认规矩用。已经交了钱，就立刻按第 8 节第 2 条打 110 或 96110 要求止付，同时向当地负责处置非法集资的牵头部门举报。以房养老是另一套路径，见第 6 条（住房反向抵押养老保险）。"]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["我的备注"]},{"tag":"button","props":{"type":"button"},"children":["写下对自己有用的提醒…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/tip/17-04"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["上一条"]},"给老人备好一句随时能说出口的推辞：「我要回去和家里人商量」"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/tip/17-06"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["下一条"]},"除了保险公司的住房反向抵押养老保险，其他「以房养老」都别碰，绝不抵押房子去买理财"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["本主题的其他建议"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/17-01"},"children":[{"tag":"strong","props":{},"children":["趁老人清醒，书面指定将来的监护人"]},{"tag":"span","props":{},"children":["趁老人头脑还清楚，花几百元去公证处办一份书面文件，写明将来谁当他的监护人。没有这份文件，等老人不能自己做决定了，谁替他签字、谁替他管钱，要…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/17-02"},"children":[{"tag":"strong","props":{},"children":["把遗嘱立了，记住后立的推翻先立的，公证遗嘱不再优先"]},{"tag":"span","props":{},"children":["法律认六种遗嘱，但形式写错了整份作废，这是最常见的翻车点。自己手写的那种，要本人从头到尾手写，签上名，写清年月日。立了好几份、内容互相打架…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/17-03"},"children":[{"tag":"strong","props":{},"children":["老人的钱单独放一个账户，大额支出定一个双人确认的规矩"]},{"tag":"span","props":{},"children":["骗老人的人常先送小礼物、嘘寒问暖，把信任攒足，再一次骗走大钱。骗子还常叮嘱「不要告诉任何人」。事先约好一条规矩：超过多少钱的支出，要先跟某…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/17-07"},"children":[{"tag":"strong","props":{},"children":["家里老人长期卧床或重度失能，去参保地医保部门申请长期护理保险；它不是只发给老人"]},{"tag":"span","props":{},"children":["长期护理保险帮你出请人照护的钱。家里有人重度失能、持续半年以上，就去参保地医保部门申请。护理费不用先自己垫，职工参保的报七成左右，城乡居民…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/17-08"},"children":[{"tag":"strong","props":{},"children":["家里有人长期卧床，把压疮当头号敌人：上电动气垫床、定时翻身、每天看一遍骨头突出的地方"]},{"tag":"span","props":{},"children":["髋部骨折开刀前就有压疮的老人，30 天内去世的可能性高约两成。换电动气垫床，新长压疮的少约六成。按时翻身真正做到位，少约七成。别让人长时间…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/17-09"},"children":[{"tag":"strong","props":{},"children":["老人的白内障已经影响看路，就去眼科评估做手术；两只眼都有的，第二只别拖太久"]},{"tag":"span","props":{},"children":["70 岁以上的女性尽快做第一只眼的白内障手术，一年里跌倒的次数少约三成四，骨折的人也少了。但摔过跤的人数没有少。第二只眼做不做，跌倒上没看…"]}]}]}]},{"tag":"a","props":{"className":"life-text-link","href":"/book/17"},"children":["阅读整个主题：家里有老人"," ",{"tag":"svg",