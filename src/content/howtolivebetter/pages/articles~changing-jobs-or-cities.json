de","props":{"className":"life-longread-toc"},"children":[{"tag":"details","props":{"open":true},"children":[{"tag":"summary","props":{},"children":["本文目录"]},{"tag":"nav","props":{"aria-label":"本文目录"},"children":[{"tag":"a","props":{"href":"#拿主意之前健康账"},"children":["拿主意之前：健康账"]},{"tag":"a","props":{"href":"#拿主意之前人和关系"},"children":["拿主意之前：人和关系"]},{"tag":"a","props":{"href":"#拿主意之前时间账"},"children":["拿主意之前：时间账"]},{"tag":"a","props":{"href":"#拿主意之前钱账"},"children":["拿主意之前：钱账"]},{"tag":"a","props":{"href":"#递辞职之前"},"children":["递辞职之前"]},{"tag":"a","props":{"href":"#离开旧单位那几天"},"children":["离开旧单位那几天"]},{"tag":"a","props":{"href":"#新单位签合同时"},"children":["新单位签合同时"]},{"tag":"a","props":{"href":"#在新城市找住处"},"children":["在新城市找住处"]},{"tag":"a","props":{"href":"#搬过去以后社保医保和看病"},"children":["搬过去以后：社保、医保和看病"]}]}]}]},{"tag":"div","props":{"className":"life-longread-main"},"children":[{"tag":"article","props":{"className":"life-article-body","lang":"zh"},"children":[{"tag":"p","props":{},"children":["换工作、换城市牵动的事，散在第 2、4、5、7、11、15、19 节和别的几节里。下面先按健康、人和关系、时间、钱四本账，列出拿主意之前要核对的项。再按时间先后，列出走之前、入职时和搬过去以后要办的手续。每一项只写核对什么、做什么，数字和依据在括号前指的那一条里。走不走、去哪，由你自己算，这里不替你下结论。被公司裁掉的，按另一篇长文 ",{"tag":"a","props":{"href":"/articles/after-a-layoff"},"children":["被裁了之后先做什么"]}," 走。"]},"\n",{"tag":"h2","props":{"id":"拿主意之前健康账"},"children":["拿主意之前：健康账"]},"\n",{"tag":"ol","props":{},"children":["\n",{"tag":"li","props":{},"children":["新岗位要上夜班的，按年数算账。每多上 5 年夜班，心血管病再多约 7%。挑工作时就把这笔账算进去，成本是零。见",{"tag":"a","props":{"href":"/book/02#02-39","title":"上夜班干得越久心血管风险越高，能转岗就趁早转"},"children":["第 2 节第 39 条"]},"（上夜班干得越久心血管风险越高）。"]},"\n",{"tag":"li","props":{},"children":["问清每周实际要干多少小时。一周干 70 小时和干 56 小时，出的活几乎一样。见",{"tag":"a","props":{"href":"/book/03#03-13","title":"别把每周工作时间一味往上加：过了 49 小时上下，多干一小时多出的活越来越少"},"children":["第 3 节第 13 条"]},"（别把每周工作时间一味往上加）。"]},"\n",{"tag":"li","props":{},"children":["岗位要接触粉尘、噪声、化学品的，面试时问三句：有没有职业病危害，合同里写不写，上岗前体检谁出钱。见",{"tag":"a","props":{"href":"/book/19#19-09","title":"进有粉尘、噪声、化学品的岗位之前，先看合同里写没写危害；三次职业健康检查由单位安排并掏钱"},"children":["第 19 节第 9 条"]},"（进有粉尘、噪声、化学品的岗位之前）。"]},"\n",{"tag":"li","props":{},"children":["新单位的上岗前、在岗时、离岗时三次职业健康检查，都由单位安排并掏钱。见",{"tag":"a","props":{"href":"/book/19#19-09","title":"进有粉尘、噪声、化学品的岗位之前，先看合同里写没写危害；三次职业健康检查由单位安排并掏钱"},"children":["第 19 节第 9 条"]},"（三次职业健康检查由单位安排并掏钱）。"]},"\n"]},"\n",{"tag":"h2","props":{"id":"拿主意之前人和关系"},"children":["拿主意之前：人和关系"]},"\n",{"tag":"ol","props":{},"children":["\n",{"tag":"li","props":{},"children":["想走是因为在单位长期被欺负的，先记下来留证据。被欺负的人后来得心脏病、中风的风险高约六成。换工作的代价最高，走不走由你自己算。见",{"tag":"a","props":{"href":"/book/19#19-16","title":"在单位长期被欺负、辱骂、刁难，别硬扛：先记下来留证据，再按性质走投诉、报警或者仲裁"},"children":["第 19 节第 16 条"]},"（在单位长期被欺负）。"]},"\n",{"tag":"li","props":{},"children":["搬去新城市，原来常见面的人就远了。很少和人来往的人，同期死亡的概率高约三成。到了新地方，把定期和人见面当成一笔健康支出。见",{"tag":"a","props":{"href":"/book/22#22-09","title":"把「定期和人见面」当成健康支出，别只在心情差时才找人"},"children":["第 22 节第 9 条"]},"（把「定期和人见面」当成健康支出）。"]},"\n",{"tag":"li","props":{},"children":["为了和异地的伴侣住到一起才换城市的，坎在搬到一起之后的头三个月。重聚的伴侣里，三分之一在 3 个月内分手。见",{"tag":"a","props":{"href":"/book/10#10-06","title":"异地恋不比同城差，真正的坎是搬到一起之后的头三个月"},"children":["第 10 节第 6 条"]},"（搬到一起之后的头三个月）。"]},"\n",{"tag":"li","props":{},"children":["刚遇上丧亲、失业这类变故的，有人劝你辞职去外地重新开始，就推后三个月再定。先讲给一个跟这件事没利益关系的人听。见",{"tag":"a","props":{"href":"/book/29#29-12","title":"变故后的头三个月，凡是不可逆的大决定一律往后推"},"children":["第 29 节第 12 条"]},"（不可逆的大决定一律往后推）。"]},"\n",{"tag":"li","props":{},"children":["要紧的决定推到睡醒之后再拍板，别在深夜定。见",{"tag":"a","props":{"href":"/book/03#03-10","title":"深夜不做重大决定、不发要紧的消息"},"children":["第 3 节第 10 条"]},"（深夜不做重大决定）。"]},"\n"]},"\n",{"tag":"h2","props":{"id":"拿主意之前时间账"},"children":["拿主意之前：时间账"]},"\n",{"tag":"ol","props":{},"children":["\n",{"tag":"li","props":{},"children":["先看新住处到单位的单程要多久。单程少 30 分钟，一周就省出 5 小时。见",{"tag":"a","props":{"href":"/book/04#04-18","title":"选住处时把通勤时长放在前面，缩短单程通勤"},"children":["第 4 节第 18 条"]},"（选住处时把通勤时长放在前面）。"]},"\n",{"tag":"li","props":{},"children":["通勤这笔账有争议。也有研究说，长通勤能被更好的工作或住房换回来。见",{"tag":"a","props":{"href":"/book/04#04-18","title":"选住处时把通勤时长放在前面，缩短单程通勤"},"children":["第 4 节第 18 条"]},"（缩短单程通勤）。"]},"\n",{"tag":"li","props":{},"children":["在现单位已经干了多少年，不进这道题。只算往后还要投多少、还能拿回多少。见",{"tag":"a","props":{"href":"/book/04#04-03","title":"决定是否继续时，只看未来投入和未来回报，不看已投入多少"},"children":["第 4 节第 3 条"]},"（只看未来投入和未来回报）。"]},"\n",{"tag":"li","props":{},"children":["打算先去新城市试一段的，出发前写好一句话：到某月某日还没达到某个指标就停。见",{"tag":"a","props":{"href":"/book/04#04-02","title":"开工前写下退出条件"},"children":["第 4 节第 2 条"]},"（开工前写下退出条件）。"]},"\n"]},"\n",{"tag":"h2","props":{"id":"拿主意之前钱账"},"children":["拿主意之前：钱账"]},"\n",{"tag":"ol","props":{},"children":["\n",{"tag":"li","props":{},"children":["辞职时下一份工作还没定的，先看手上有没有 3 到 6 个月生活费的应急金。见",{"tag":"a","props":{"href":"/book/05#05-27","title":"先存出 3 到 6 个月生活费的应急金，放在随时能取的地方"},"children":["第 5 节第 27 条"]},"（3 到 6 个月生活费的应急金）。"]},"\n",{"tag":"li","props":{},"children":["别把「网上说工资高」当成那个工种缺人。去查目标城市的紧缺职业目录和补贴目录。见",{"tag":"a","props":{"href":"/book/23#23-12","title":"别把「网上说工资高」当成缺人，去查当地的紧缺职业目录和补贴目录"},"children":["第 23 节第 12 条"]},"（紧缺职业目录和补贴目录）。"]},"\n",{"tag":"li","props":{},"children":["2025 年全国人均消费里，吃占 29.3%，住占 21.7%。找工作时问清包不包吃住，包的岗位等于把这两大项抹掉。见",{"tag":"a","props":{"href":"/book/07#07-17","title":"把住和吃压到最低：合租月租代替日租，自炊和助餐食堂代替外卖"},"children":["第 7 节第 17 条"]},"（把住和吃压到最低）。"]},"\n",{"tag":"li","props":{},"children":["打算不进单位、灵活就业的，养老和医疗要全额自己缴。按当地缴费基数算，每月上千元。见",{"tag":"a","props":{"href":"/book/31#31-11","title":"不进单位就是灵活就业：养老和医疗要自己在就业地参保，户籍限制已经放开"},"children":["第 31 节第 11 条"]},"（不进单位就是灵活就业）。"]},"\n",{"tag":"li","props":{},"children":["想辞职回去读书的，把这件事算成一道题。早挣的几年工资，对上往后几十年的年收入差。见",{"tag":"a","props":{"href":"/book/23#23-06","title":"把「读书还是打工」算成一道题：先去打工早挣的三年工资，对上接着读书换来的、往后几十年的年收入差"},"children":["第 23 节第 6 条"]},"（把「读书还是打工」算成一道题）。"]},"\n",{"tag":"li","props":{},"children":["是因为公司欠薪、不缴社保才走的，自己提出离职也可能有经济补偿。别签「个人原因主动辞职」。见",{"tag":"a","props":{"href":"/book/19#19-07","title":"不要签「个人原因主动辞职」，那一签就没有 N 了"},"children":["第 19 节第 7 条"]},"（不要签「个人原因主动辞职」）。"]},"\n"]},"\n",{"tag":"h2","props":{"id":"递辞职之前"},"children":["递辞职之前"]},"\n",{"tag":"ol","props":{},"children":["\n",{"tag":"li","props":{},"children":["签过竞业协议的，先看清它管不管得着你。竞业只能约束高管、高级技术人员和负有保密义务的人，最长 2 年。见",{"tag":"a","props":{"href":"/book/11#11-12","title":"签了竞业协议，离职后公司不按月给补偿就书面催告，满 3 个月没给可以解除；没接触过商业秘密的岗位可请求确认条款不生效"},"children":["第 11 节第 12 条"]},"（签了竞业协议）。"]},"\n",{"tag":"li","props":{},"children":["竞业期间公司要按月给补偿。没约定数额的，按离职前 12 个月平均工资的 30% 给。见",{"tag":"a","props":{"href":"/book/11#11-12","title":"签了竞业协议，离职后公司不按月给补偿就书面催告，满 3 个月没给可以解除；没接触过商业秘密的岗位可请求确认条款不生效"},"children":["第 11 节第 12 条"]},"（签了竞业协议）。"]},"\n",{"tag":"li","props":{},"children":["协议有效、公司也按月付了钱，你还去竞品上班，就要掏违约金。见",{"tag":"a","props":{"href":"/book/11#11-12","title":"签了竞业协议，离职后公司不按月给补偿就书面催告，满 3 个月没给可以解除；没接触过商业秘密的岗位可请求确认条款不生效"},"children":["第 11 节第 12 条"]},"（签了竞业协议）。"]},"\n",{"tag":"li","props":{},"children":["没休完的年休假，离职时按当年已经干了多久折算结清。「自愿放弃年休假」的表别签。见",{"tag":"a","props":{"href":"/book/19#19-02","title":"年休假按累计工龄算 5、10、15 天，没休成的按日工资 300% 折钱"},"children":["第 19 节第 2 条"]},"（年休假按累计工龄算）。"]},"\n",{"tag":"li","props":{},"children":["欠着的加班费一起算清。工资、加班费的劳动仲裁，要在离职后 1 年内提出。见",{"tag":"a","props":{"href":"/book/19#19-01","title":"加班费按 1.5 倍、2 倍、3 倍三档算，不给就投诉劳动监察，逾期不付还要加付 50% 到 100%"},"children":["第 19 节第 1 条"]},"（加班费）和",{"tag":"a","props":{"href":"/book/08#08-19","title":"维权有期限：民事诉讼时效 3 年，劳动仲裁 1 年，过了对方一句「超过时效」就够"},"children":["第 8 节第 19 条"]},"（劳动仲裁 1 年）。"]},"\n",{"tag":"li","props":{},"children":["交回电脑和账号之前，把工资条、考勤、劳动合同、社保记录和聊天记录存下来。见",{"tag":"a","props":{"href":"/book/19#19-08","title":"离职前把工资条、考勤、劳动合同、社保记录和聊天记录先存下来"},"children":["第 19 节第 8 条"]},"（离职前存下来）。"]},"\n",{"tag":"li","props":{},"children":["可能翻脸的谈话，直接开录音。你自己参加的谈话，不用先征得对方同意。见",{"tag":"a","props":{"href":"/book/08#08-41","title":"可能翻脸的电话和面谈，直接开录音：自己参加的谈话，不用先征得对方同意"},"children":["第 8 节第 41 条"]},"（直接开录音）。"]},"\n"]},"\n",{"tag":"h2","props":{"id":"离开旧单位那几天"},"children":["离开旧单位那几天"]},"\n",{"tag":"ol","props":{},"children":["\n",{"tag":"li","props":{},"children":["找单位要离职证明，写明合同期限、离职日期、岗位和在这家干了几年。单位还要在 15 天内转走你的档案和社保。见",{"tag":"a","props":{"href":"/book/19#19-17","title":"离职时找单位要一份离职证明，写明合同期限、离职日期、岗位和工作年限"},"children":["第 19 节第 17 条"]},"（离职证明）。"]},"\n",{"tag":"li","props":{},"children":["离职证明是你已经和原单位解除合同的书面凭据。新单位招了没解除合同的人，给原单位造成损失要连带赔。见",{"tag":"a","props":{"href":"/book/19#19-17","title":"离职时找单位要一份离职证明，写明合同期限、离职日期、岗位和工作年限"},"children":["第 19 节第 17 条"]},"（离职证明）。"]},"\n",{"tag":"li","props":{},"children":["账号权限交清，不删数据，不改密码，哪怕公司欠你钱。见",{"tag":"a","props":{"href":"/book/11#11-06","title":"离职时交清账号权限，不删库、不留后门、不改密码锁系统，哪怕公司欠你钱"},"children":["第 11 节第 6 条"]},"（交清账号权限）。"]},"\n",{"tag":"li","props":{},"children":["公司的源码、客户名单和技术文档不带走，也不传个人网盘。见",{"tag":"a","props":{"href":"/book/11#11-07","title":"离职不带走源码、客户名单和技术文档，不上传个人网盘，不在下家复用"},"children":["第 11 节第 7 条"]},"（不带走源码）。"]},"\n",{"tag":"li","props":{},"children":["干的是有粉尘、噪声、化学品的岗位，走之前做离岗体检，再要一份职业健康监护档案的复印件。没做离岗体检，单位不能和你解除合同。见",{"tag":"a","props":{"href":"/book/19#19-09","title":"进有粉尘、噪声、化学品的岗位之前，先看合同里写没写危害；三次职业健康检查由单位安排并掏钱"},"children":["第 19 节第 9 条"]},"（职业健康检查）。"]},"\n",{"tag":"li","props":{},"children":["拿到解除合同的一次性补偿，先看个税。当地上年职工平均工资 3 倍以内的部分免税。见",{"tag":"a","props":{"href":"/book/19#19-18","title":"拿到离职补偿先看个税：当地上年职工平均工资 3 倍以内免税，超出的部分单独算，不并进当年工资"},"children":["第 19 节第 18 条"]},"（离职补偿先看个税）。"]},"\n",{"tag":"li","props":{},"children":["中间要空一段、又不是你主动辞职的，去办失业登记、领失业保险金。交满 1 年才能领。见",{"tag":"a","props":{"href":"/book/07#07-01","title":"失业了先在线申领失业保险金"},"children":["第 7 节第 1 条"]},"（失业保险金）。"]},"\n",{"tag":"li","props":{},"children":["空档期把作息固定下来，按点起床，把找工作排进固定日程。见",{"tag":"a","props":{"href":"/book/29#29-03","title":"失业之后先把作息、医保和找工作的节奏固定下来，别整天待在家里"},"children":["第 29 节第 3 条"]},"（失业之后先把作息固定下来）。"]},"\n"]},"\n",{"tag":"h2","props":{"id":"新单位签合同时"},"children":["新单位签合同时"]},"\n",{"tag":"ol","props":{},"children":["\n",{"tag":"li","props":{},"children":["入职文件从头读到尾，看不懂的当场问，再拍照留底。见",{"tag":"a","props":{"href":"/book/08#08-17","title":"签字前把纸看完，不替人签字，不在空白纸上签"},"children":["第 8 节第 17 条"]},"（签字前把纸看完）。"]},"\n",{"tag":"li","props":{},"children":["对一遍试用期。合同签 1 年以内的最多 1 个月，1 到 3 年的最多 2 个月，3 年以上的最多 6 个月。见",{"tag":"a","props":{"href":"/book/19#19-03","title":"试用期有法定上限、工资不得低于 80%，而且只能约定一次"},"children":["第 19 节第 3 条"]},"（试用期有法定上限）。"]},"\n",{"tag":"li","props":{},"children":["试用期工资不能低于同岗位最低档或者合同约定工资的 80%，也不能低于当地最低工资。同一家公司只能试用你一次。见",{"tag":"a","props":{"href":"/book/19#19-03","title":"试用期有法定上限、工资不得低于 80%，而且只能约定一次"},"children":["第 19 节第 3 条"]},"（试用期有法定上限）。"]},"\n",{"tag":"li","props":{},"children":["社保从上班第一天起交，和试不试用无关。见",{"tag":"a","props":{"href":"/book/19#19-03","title":"试用期有法定上限、工资不得低于 80%，而且只能约定一次"},"children":["第 19 节第 3 条"]},"（试用期有法定上限）。"]},"\n",{"tag":"li","props":{},"children":["写代码、做设计的，把合同里的知识产权条款看清楚。主要靠公司设备、内网或业务数据写出、由公司担责的软件，著作权归公司。见",{"tag":"a","props":{"href":"/book/11#11-13","title":"上班时间、用公司资源写的代码归公司，自己的开源项目用自己的时间和设备做，不混公司代码"},"children":["第 11 节第 13 条"]},"（用公司资源写的代码归公司）。"]},"\n",{"tag":"li","props":{},"children":["新单位要你在职期间就签竞业的，公司不另外给钱也算数。见",{"tag":"a","props":{"href":"/book/11#11-12","title":"签了竞业协议，离职后公司不按月给补偿就书面催告，满 3 个月没给可以解除；没接触过商业秘密的岗位可请求确认条款不生效"},"children":["第 11 节第 12 条"]},"（签了竞业协议）。"]},"\n"]},"\n",{"tag":"h2","props":{"id":"在新城市找住处"},"children":["在新城市找住处"]},"\n",{"tag":"ol","props":{},"children":["\n",{"tag":"li","props":{},"children":["选住处时把周边绿地算进去，成本为零。别读成去公园就能延寿。见",{"tag":"a","props":{"href":"/book/22#22-10","title":"选住处时把周边绿地算进去，但别指望「多去公园」就延寿"},"children":["第 22 节第 10 条"]},"（把周边绿地算进去）。"]},"\n",{"tag":"li","props":{},"children":["押金多少、什么时候退、什么情况下能扣，签字前写进合同。见",{"tag":"a","props":{"href":"/book/15#15-01","title":"租房时押金的数额、退还时间和扣减情形，必须写进合同"},"children":["第 15 节第 1 条"]},"（押金的数额、退还时间和扣减情形）。"]},"\n",{"tag":"li","props":{},"children":["签约前去不动产登记中心查产权和抵押。所有钱走转账，备注写「某某房屋某月租金」。见",{"tag":"a","props":{"href":"/book/15#15-06","title":"租房签约前核对产权证和抵押情况，所有款项走转账并备注用途"},"children":["第 15 节第 6 条"]},"（核对产权证和抵押情况）。"]},"\n",{"tag":"li","props":{},"children":["房租和押金直接付给房东，不经中介的手。见",{"tag":"a","props":{"href":"/book/15#15-03","title":"中介不得代收代付租金和押金，钱直接给房东"},"children":["第 15 节第 3 条"]},"（中介不得代收代付租金和押金）。"]},"\n",{"tag":"li","props":{},"children":["租长租公寓的，先查它有没有公示资金监管账户，别图便宜一次付一年。见",{"tag":"a","props":{"href":"/book/15#15-04","title":"租长租公寓先查它的资金监管账户，别图便宜一次性付一年"},"children":["第 15 节第 4 条"]},"（资金监管账户）。"]},"\n",{"tag":"li","props":{},"children":["别租隔断房。厨房、卫生间、阳台和地下储藏室不能住人。见",{"tag":"a","props":{"href":"/book/15#15-08","title":"别租隔断房：最小出租单位是原设计的房间，厨房、卫生间、阳台不得住人"},"children":["第 15 节第 8 条"]},"（别租隔断房）。"]},"\n",{"tag":"li","props":{},"children":["租期内房子被卖掉，租约照样有效，不用搬。见",{"tag":"a","props":{"href":"/book/15#15-05","title":"房子租期内被卖掉，租约继续有效，不用搬"},"children":["第 15 节第 5 条"]},"（租约继续有效）。"]},"\n",{"tag":"li","props":{},"children":["房东断水断电、换锁、上门威胁赶人，先报警留下出警记录。见",{"tag":"a","props":{"href":"/book/15#15-02","title":"被断水断电、换锁、上门威胁赶人，先报警留证：法规禁止用这些方式逼你腾房"},"children":["第 15 节第 2 条"]},"（先报警留证）。"]},"\n",{"tag":"li","props":{},"children":["公积金能提出来付房租。交了申请，公积金中心要在 3 天内答复。见",{"tag":"a","props":{"href":"/book/05#05-03","title":"公积金不只用来买房：租房、装修、物业费都能提，2026 年 9 月 20 日起按新条例办"},"children":["第 5 节第 3 条"]},"（公积金不只用来买房）。"]},"\n",{"tag":"li","props":{},"children":["外来务工的，在当地稳定就业满规定年限，才能申请公租房。排队不花钱，早报名早轮到。见",{"tag":"a","props":{"href":"/book/07#07-16","title":"住房困难先排公租房"},"children":["第 7 节第 16 条"]},"（住房困难先排公租房）。"]},"\n",{"tag":"li","props":{},"children":["在新城市买二手房，中介代收房款的，必须走它在银行开的交易资金专用存款账户。见",{"tag":"a","props":{"href":"/book/15#15-07","title":"二手房让中介代收房款的，必须走中介在银行开的交易资金专用存款账户"},"children":["第 15 节第 7 条"]},"（交易资金专用存款账户）。"]},"\n",{"tag":"li","props":{},"children":["城镇户口想搬去乡下长住的，只租农房，一次最长签 20 年。别买宅基地和上面的房子。见",{"tag":"a","props":{"href":"/book/15#15-09","title":"城镇户口想搬去乡下住，只租农房，别买宅基地和宅基地上的房子"},"children":["第 15 节第 9 条"]},"（只租农房）。"]},"\n"]},"\n",{"tag":"h2","props":{"id":"搬过去以后社保医保和看病"},"children":["搬过去以后：社保、医保和看病"]},"\n",{"tag":"ol","props":{},"children":["\n",{"tag":"li","props":{},"children":["换地方就业，养老关系跟着人走，缴费年限接着往上累计。断过也不清零。见",{"tag":"a","props":{"href":"/book/07#07-18","title":"社保断缴不要慌：养老按累计算，医保按规则补"},"children":["第 7 节第 18 条"]},"（社保断缴不要慌）。"]},"\n",{"tag":"li","props":{},"children":["在新地方参保缴费以后，由新单位或你自己向新参保地申请，把养老和医保关系转过去。见",{"tag":"a","props":{"href":"/book/19#19-19","title":"换城市工作时，把养老和医保关系转到新参保地，缴费年限接着累计，别办退保"},"children":["第 19 节第 19 条"]},"（养老保险关系转移）。"]},"\n",{"tag":"li","props":{},"children":["没到领养老金的年龄，不能办退保把钱取出来。见",{"tag":"a","props":{"href":"/book/19#19-19","title":"换城市工作时，把养老和医保关系转到新参保地，缴费年限接着累计，别办退保"},"children":["第 19 节第 19 条"]},"（别办退保）。"]},"\n",{"tag":"li","props":{},"children":["职工医保断交超过 3 个月，到新地方可能要等最多 6 个月才能报销，所以中间别空太久。见",{"tag":"a","props":{"href":"/book/19#19-19","title":"换城市工作时，把养老和医保关系转到新参保地，缴费年限接着累计，别办退保"},"children":["第 19 节第 19 条"]},"（把养老和医保关系转到新参保地）。"]},"\n",{"tag":"li","props":{},"children":["跨省去的不是户口所在省，而且男的满 50 岁、女的满 40 岁，养老关系会留在原参保地。新地方只开一个临时账户。见",{"tag":"a","props":{"href":"/book/19#19-19","title":"换城市工作时，把养老和医保关系转到新参保地，缴费年限接着累计，别办退保"},"children":["第 19 节第 19 条"]},"（养老和医保关系）。"]},"\n",{"tag":"li","props":{},"children":["断缴主要影响当地买房、落户、积分这些要求连续缴费的资格。规则各地自己定，去新城市查。见",{"tag":"a","props":{"href":"/book/07#07-18","title":"社保断缴不要慌：养老按累计算，医保按规则补"},"children":["第 7 节第 18 条"]},"（社保断缴不要慌）。"]},"\n",{"tag":"li","props":{},"children":["灵活就业的，可以在就业地参加养老和医疗保险，户籍限制已经放开。个别超大城市还在逐步放开，去当地问。见",{"tag":"a","props":{"href":"/book/31#31-11","title":"不进单位就是灵活就业：养老和医疗要自己在就业地参保，户籍限制已经放开"},"children":["第 31 节第 11 条"]},"（户籍限制已经放开）。"]},"\n",{"tag":"li","props":{},"children":["中间要自己交居民医保的，别断。断缴后重新交上，有 3 个月看病不给报。见",{"tag":"a","props":{"href":"/book/07#07-09","title":"居民医保每年 400 元不要断，困难户可减免"},"children":["第 7 节第 9 条"]},"（居民医保每年 400 元不要断）。"]},"\n",{"tag":"li","props":{},"children":["有高血压、糖尿病这类慢性病，医保又留在原参保地的，要办两件事。先在参保地办门诊慢特病认定，再办异地就医备案。见",{"tag":"a","props":{"href":"/book/16#16-02","title":"先办门诊慢特病认定再办异地备案，高血压、糖尿病、放化疗、透析、抗排异就能异地直接结算"},"children":["第 16 节第 2 条"]},"（先办门诊慢特病认定再办异地备案）。"]},"\n",{"tag":"li","props":{},"children":["「临时外出就医」和「长期异地居住」是两种不同的备案，报销水平不一样。见",{"tag":"a","props":{"href":"/book/24#24-04","title":"跨省异地就医之前先在本地问一句，必要性原则上要副主任医师以上评估"},"children":["第 24 节第 4 条"]},"（跨省异地就医之前先在本地问一句）。"]},"\n",{"tag":"li","props":{},"children":["走之前把病历、检查报告和影像自己存一份。换医院、找新医生再看，凭的都是这一摞材料。见",{"tag":"a","props":{"href":"/book/24#24-05","title":"每次看完病，把病历、检查报告和影像自己存一份"},"ch