ucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"分享这条建议"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"收起详情"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["成本"]},{"tag":"p","props":{},"children":["不花钱。要做的只是在加预算之前多问一句：这笔加价买的是东西本身，还是我在这群人里的位置。难在周围人都换了的时候，自己不跟。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["收益"]},{"tag":"p","props":{},"children":["美国全国家庭与住户调查（NSFH）两轮回访了同一批人。作者把这份数据和本地平均收入对上。本地平均收入（PUMA）是按 1990 年人口普查 5% 抽样推算出来的。把本人收入和一系列个人特征都扣掉之后，结果是：邻居收入越高，自己报告的幸福感越低。这个效应大，换一种算法也稳，而且高度显著。作者的表述是，「邻居收入上升」和「本人收入下降同样幅度」带来的幸福感下降处于同一数量级。改成同一个人前后自己跟自己比之后（这叫加个体固定效应），系数方向不变、大小也相近，只是显著性降到了 10% 的水平。再限定在同一个州、同一轮调查之间比（这叫加州和调查轮次的固定效应），结果基本不变。这说明它不是「爱搬去穷地方的人本来就更快乐」造成的，也不是州一级某些没测到的因素造成的。效应在常和邻居来往的人身上更强，在只和社区外朋友来往的人身上不显著。租房的人和自己有房的人没有差异，这一点不支持「贵地方房价高，所以实际可花的钱少」这种解释。幸福感只随学历相同的邻居的收入而下降，对学历不同的邻居的收入几乎没有反应。而且它主要是通过「对自己物质处境的满意度」传过去的，不是通过对家庭生活等其他方面的满意度。最后，如果本人和邻居的收入按同样比例一起上升，幸福感仍然上升"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["原始出处"]},{"tag":"p","props":{"className":"life-citations"},"children":["Luttmer EFP (2005). Neighbors as Negatives: Relative Earnings and Well-Being. The Quarterly Journal of Economics, 120(3), 963–1002. ",{"tag":"a","props":{"href":"https://doi.org/10.1093/qje/120.3.963","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1093/qje/120.3.963"]},"；Luttmer EFP (2004). Neighbors as Negatives: Relative Earnings and Well-Being. NBER Working Paper No. 10667（本条引用的表述与数量级按这一版逐字核对）. ",{"tag":"a","props":{"href":"https://www.nber.org/papers/w10667","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.nber.org/papers/w10667"]}]},{"tag":"a","props":{"href":"https://doi.org/10.1093/qje/120.3.963","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["打开来源链接"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["原书备注"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["定 B 级的理由有几条：数据来自反复回访同一批人的问卷，只有这一项研究，样本又在国外；看的结果是受访者自己报的幸福感，不是钱。作者确实用统计手段排掉了几类干扰，比如同一个人前后比、同一个州同一轮之间比，但终究不是随机试验。中国人群也没有可以引用的同类数据。收益量级定「中」，是沿用本节第 23 条（别指望买东西改善心情）的口径。省下的钱确实可能到万元级。但「省下这笔钱能换来多少幸福感」没有数字支撑，所以不按万元级记成「大」。这里不反对为更大的房子、更安静的小区、更短的通勤花钱，那些买的是东西本身。要拦的是「同事都换了，我不能比他们差」这一个理由。住处该按什么排序见第 4 节第 18 条（选住处时把通勤时长放在前面）。买东西调情绪见本节第 23 条（别指望买东西改善心情）。在网上老往上比见第 3 节第 20 条（别把「别人过得怎么样」当每日必读）"]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["我的备注"]},{"tag":"button","props":{"type":"button"},"children":["写下对自己有用的提醒…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/tip/06-23"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["上一条"]},"不要指望买东西改善心情或身份感"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/tip/06-25"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["下一条"]},"不要相信「意志力像肌肉，用一会儿就没了」"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["本主题的其他建议"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/06-20"},"children":[{"tag":"strong","props":{},"children":["不要因为体检查出胆囊结石、但从没疼过，就去预防性切胆囊"]},{"tag":"span","props":{},"children":["胆囊里有石头、但从没疼过的人，近九年里约八成一直没出症状。不动它，每年出胆囊炎、胰腺炎这类急症的约千分之一到千分之三。切胆囊也不是零风险，…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/06-21"},"children":[{"tag":"strong","props":{},"children":["不要为了防肾结石把钙戒掉"]},{"tag":"span","props":{},"children":["长过草酸钙结石的人常被劝少吃钙，试验的结果正好反过来。反复长结石的男性正常吃钙、同时少吃动物蛋白和盐，五年里复发的人只有吃低钙饮食的一半。…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/06-22"},"children":[{"tag":"strong","props":{},"children":["不要为了「转运」「招财」「养人」买水晶、手串、貔貅这类物件"]},{"tag":"span","props":{},"children":["说戴了能改运、能招财、能养人，没有可以核查的证据。它和算命显得准是一个道理，话说得足够笼统，你会自己往身上套。商家把话说到治病的功效上就是…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/06-26"},"children":[{"tag":"strong","props":{},"children":["不要指望吃早餐或 16:8 轻断食帮你控制体重，吃饭时间挑你能长期坚持的"]},{"tag":"span","props":{},"children":["流行说法是不吃早餐会让人午饭晚饭暴食，一天总量反而更多。试验里不是这样：不吃早餐的人一天少吃了两百多千卡，体重还略轻一点。16:8 和单纯…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/06-27"},"children":[{"tag":"strong","props":{},"children":["不要相信「手淫伤身」「戒色才能变好」，真正要看的是有没有耽误睡觉、工作和关系"]},{"tag":"span","props":{},"children":["没有研究说手淫伤身。射精多的男性前列腺癌少约两成，但也有研究看到年轻时次数多的人风险偏高。少数人每次射精后都会没力气、像感冒，几天才好，这…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/06-28"},"children":[{"tag":"strong","props":{},"children":["不要花钱做「性取向矫正」「同性恋治疗」，也不要把家里人送去"]},{"tag":"span","props":{},"children":["美国心理学会的专家组看完研究后说，这类矫正改不了性取向，还可能伤人。美国一项调查里，做过矫正的人有过自杀念头的多了近九成。国内有精神病院以…"]}]}]}]},{"tag":"a","props":{"className":"life-text-link","href":"/book/06"},"children":["阅读整个主题：反面清单"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"15","height":"15","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","cla