rel":"noopener noreferrer","className":"life-source-link"},"children":["Liên kết mở nguồn"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Ghi chú sách"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["Tiền án của người thành niên không niêm phong. Điều 100 của Bộ luật Hình sự đòi hỏi phải khai trung thực việc mình đã bị xử phạt hình sự khi nhập quân hay tìm việc. Các nghề công chức, thẩm phán, luật sư, giáo viên và việc thẩm tra lý lịch chính trị có hạn chế riêng theo pháp luật. Bản đang hiệu hành của Luật Cải tạo nhà tù trước ngày 1 tháng 11 năm 2026 tương ứng với điều 37, 38, số điều lấy theo bản có hiệu lực. Văn bản 中办发〔2010〕5 号 không tìm thấy trang gốc trên cổng Chính phủ trung ương, lấy từ trang sao chép của chính quyền quận. Trong thời gian quan sát của phá sản cá nhân thì không được đi hạng nhất máy bay, không được tiêu vào cao, không được mua nhà; các khoản nợ như bồi thường do cố ý xâm phạm thân thể người khác thuộc 8 loại không được xoá; phần miễn trừ giành được bằng gian lận còn có thể bị thu hồi. Được xoá khỏi danh sách không thi hành án không có nghĩa lịch sử tín dụng cũng sạch theo, đó là hai hệ thống khác nhau."]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Ghi chú của tôi"]},{"tag":"button","props":{"type":"button"},"children":["Viết một lời nhắc cho chính bạn…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/vi/tip/07-18"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Trước"]},"Bảo hiểm xã hội đứt quãng thì đừng hoảng: lương hưu tính theo số năm tích luỹ, bảo hiểm y tế nộp bù theo quy định"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/vi/tip/07-20"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Tiếp theo"]},"Trước khi mắc bệnh nặng, ngoài bảo hiểm y tế cơ bản thì mua một bảo hiểm y tế hoặc bảo hiểm bệnh hiểm nặng hạn một năm, và đọc kỹ bốn chữ「保证续保」"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["Thêm trong chủ đề này"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/07-14"},"children":[{"tag":"strong","props":{},"children":["Tìm việc đừng chỉ nộp hồ sơ, hãy dùng cách có hệ thống: học kỹ thuật, đặt mục tiêu, nhờ người khác giúp"]},{"tag":"span","props":{},"childre