{"path":"/ru/tip/19-19","title":"Переезжая в другой город для работы, переведите пенсионное и медицинское страхование по новому месту участия: годы взносов суммируются, выходить из пенсионного страхования не нужно | HowToLiveBetter","description":"При переезде в другой город для работы пенсионное и медицинское страхование могут переехать вместе с вами, а прежние годы взносов продолжают учитыват…","lang":"ru","styles":["/sites/howtolivebetter/styles/bca54bebe9c1bd3b.css"],"bodyClass":"font-sans antialiased","nodes":[{"tag":"div","props":{"className":"life-site"},"children":[{"tag":"div","props":{"className":"life-header-slot","aria-hidden":"true"},"children":[]},{"tag":"header","props":{"className":"life-header"},"children":[{"tag":"div","props":{"className":"life-header-inner"},"children":[{"tag":"a","props":{"className":"life-brand","aria-label":"H ✳ HowToLiveBetter — главная","href":"/ru"},"children":[{"tag":"span","props":{"className":"life-brand-mark","aria-hidden":"true"},"children":["H",{"tag":"span","props":{},"children":["✳"]}]},{"tag":"span","props":{},"children":["HowToLive",{"tag":"span","props":{},"children":["Better"]}]}]},{"tag":"nav","props":{"className":"life-nav","aria-label":"Основная навигация"},"children":[{"tag":"a","props":{"className":"life-nav-link","href":"/ru/book"},"children":[{"tag":"span","props":{},"children":["Книга"]}]},{"tag":"a","props":{"className":"life-nav-link","href":"/ru/top-50"},"children":[{"tag":"span","props":{},"children":["Топ-50"]}]},{"tag":"a","props":{"className":"life-nav-link","href":"/ru/daily"},"children":[{"tag":"span","props":{},"children":["Задание дня"]}]},{"tag":"a","props":{"className":"life-nav-link","href":"/ru/dashboard"},"children":[{"tag":"span","props":{},"children":["Мой список"]}]},{"tag":"button","props":{"type":"button","className":"life-nav-link life-nav-more","aria-haspopup":"menu","aria-expanded":"false"},"children":[{"tag":"span","props":{},"children":["Ещё"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"15","height":"15","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]}]},{"tag":"div","props":{"className":"life-header-tools"},"children":[{"tag":"button","props":{"type":"button","className":"life-sound-toggle","aria-label":"Выключить звуки","aria-pressed":"true","title":"Выключить звуки"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-volume2 lucide-volume-2","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M11 4.702a.705.705 0 0 0-1.203-.498L6.413 7.587A1.4 1.4 0 0 1 5.416 8H3a1 1 0 0 0-1 1v6a1 1 0 0 0 1 1h2.416a1.4 1.4 0 0 1 .997.413l3.383 3.384A.705.705 0 0 0 11 19.298z"},"children":[]},{"tag":"path","props":{"d":"M16 9a5 5 0 0 1 0 6"},"children":[]},{"tag":"path","props":{"d":"M19.364 18.364a9 9 0 0 0 0-12.728"},"children":[]}]}]},{"tag":"button","props":{"type":"button","className":"life-theme-trigger","aria-label":"Системная","aria-haspopup":"menu","aria-expanded":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"17","height":"17","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-sun life-theme-icon-light","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"4"},"children":[]},{"tag":"path","props":{"d":"M12 2v2"},"children":[]},{"tag":"path","props":{"d":"M12 20v2"},"children":[]},{"tag":"path","props":{"d":"m4.93 4.93 1.41 1.41"},"children":[]},{"tag":"path","props":{"d":"m17.66 17.66 1.41 1.41"},"children":[]},{"tag":"path","props":{"d":"M2 12h2"},"children":[]},{"tag":"path","props":{"d":"M20 12h2"},"children":[]},{"tag":"path","props":{"d":"m6.34 17.66-1.41 1.41"},"children":[]},{"tag":"path","props":{"d":"m19.07 4.93-1.41 1.41"},"children":[]}]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"17","height":"17","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-moon life-theme-icon-dark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"},"children":[]}]}]},{"tag":"button","props":{"type":"button","className":"life-language-switch","aria-label":"Русский Выбрать язык","aria-haspopup":"menu","aria-expanded":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-globe","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]},{"tag":"path","props":{"d":"M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"},"children":[]},{"tag":"path","props":{"d":"M2 12h20"},"children":[]}]},{"tag":"span","props":{},"children":["Русский"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]}]},{"tag":"a","props":{"className":"life-account","href":"/ru/sign-in"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"17","height":"17","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle-user-round","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M18 20a6 6 0 0 0-12 0"},"children":[]},{"tag":"circle","props":{"cx":"12","cy":"10","r":"4"},"children":[]},{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},{"tag":"span","props":{},"children":["Войти"]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/ru/book/19"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"К содержанию"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["Заработная плата, увольнение и производственные травмы"]},{"tag":"nav","props":{"aria-label":"Советы главы"},"children":[{"tag":"a","props":{"href":"/ru/tip/19-01"},"children":[{"tag":"span","props":{},"children":["01"]},"Оплата сверхурочной работы рассчитывается по трём ставкам: 1,5-кратной, 2-кратной и 3-кратной. Если компания отказывается платить, можно подать жалобу в трудовую инспекцию; при невыплате в установленный срок ей придётся доплатить ещё от 50% до 100% от суммы долга"]},{"tag":"a","props":{"href":"/ru/tip/19-02"},"children":[{"tag":"span","props":{},"children":["02"]},"Ежегодный оплачиваемый отпуск рассчитывается по суммарному стажу: 5, 10 или 15 дней; за неиспользованные дни выплачивается компенсация в размере 300% от дневной зарплаты"]},{"tag":"a","props":{"href":"/ru/tip/19-03"},"children":[{"tag":"span","props":{},"children":["03"]},"Законодательно установлены предельные сроки испытательного периода, его оплата не может быть ниже 80% от обычной зарплаты, а назначать его можно лишь один раз"]},{"tag":"a","props":{"href":"/ru/tip/19-04"},"children":[{"tag":"span","props":{},"children":["04"]},"Как рассчитать N: за каждый отработанный год — один месячный оклад, за период менее полугода — полмесяца"]},{"tag":"a","props":{"href":"/ru/tip/19-05"},"children":[{"tag":"span","props":{},"children":["05"]},"Компания увольняет вас без предварительного уведомления за 30 дней и обязана выплатить дополнительную зарплату за месяц"]},{"tag":"a","props":{"href":"/ru/tip/19-06"},"children":[{"tag":"span","props":{},"children":["06"]},"Незаконное расторжение трудового договора работодателем: компенсация равна двукратному размеру экономической выплаты"]},{"tag":"a","props":{"href":"/ru/tip/19-07"},"children":[{"tag":"span","props":{},"children":["07"]},"Не стоит подписывать заявление об увольнении по собственному желанию — после этого вы теряете все полагающиеся выплаты"]},{"tag":"a","props":{"href":"/ru/tip/19-08"},"children":[{"tag":"span","props":{},"children":["08"]},"Сохраните справки о зарплате, учёт рабочего времени, трудовой договор, эти соцстраха и переписку до увольнения"]},{"tag":"a","props":{"href":"/ru/tip/19-09"},"children":[{"tag":"span","props":{},"children":["09"]},"Прежде чем приступать к работе в условиях пыли, шума и химических веществ, проверьте, указаны ли в договоре сведения об опасностях; три медосмотра по охране труда должна организовать и оплатить компания"]},{"tag":"a","props":{"href":"/ru/tip/19-10"},"children":[{"tag":"span","props":{},"children":["10"]},"Повреждения, вызванные пылью, шумом и химическими токсинами, необратимы: работодатель обязан предоставлять средства защиты, а от работы без них можно отказаться"]},{"tag":"a","props":{"href":"/ru/tip/19-11"},"children":[{"tag":"span","props":{},"children":["11"]},"При получении травмы на работе или в ДТП по пути на работу/с работы первым делом нужно оформить признание случая производственной травмой; если работодатель этого не делает, это должны сделать вы сами"]},{"tag":"a","props":{"href":"/ru/tip/19-12"},"children":[{"tag":"span","props":{},"children":["12"]},"Не верьте утверждению, будто «если дойти до рабочего места — это считается производственной травмой»: при внезапном недомогании сначала звоните 120, а не спешите на работу"]},{"tag":"a","props":{"href":"/ru/tip/19-13"},"children":[{"tag":"span","props":{},"children":["13"]},"Если работодатель не оформил страховку от несчастных случаев, вы всё равно имеете право на положенные выплаты — он обязан оплатить их в полном объёме по тем же стандартам"]},{"tag":"a","props":{"href":"/ru/tip/19-14"},"children":[{"tag":"span","props":{},"children":["14"]},"После стабилизации состояния пострадавшего проводится экспертиза трудоспособности, по результатам которой определяется размер компенсации"]},{"tag":"a","props":{"href":"/ru/tip/19-15"},"children":[{"tag":"span","props":{},"children":["15"]},"Три вида выплат при смерти на работе: пособие на погребение, пенсия иждивенцам и единовременная компенсация"]},{"tag":"a","props":{"href":"/ru/tip/19-16"},"children":[{"tag":"span","props":{},"children":["16"]},"Если на работе вас долгое время унижают, оскорбляют и притесняют, не пытайтесь терпеть: сначала зафиксируйте всё как доказательства, а затем действуйте в зависимости от ситуации — подавайте жалобы, вызывайте полицию или обращайтесь в суд"]},{"tag":"a","props":{"href":"/ru/tip/19-17"},"children":[{"tag":"span","props":{},"children":["17"]},"При увольнении попросите у работодателя справку об увольнении с указанием срока договора, даты увольнения, должности и стажа"]},{"tag":"a","props":{"href":"/ru/tip/19-18"},"children":[{"tag":"span","props":{},"children":["18"]},"Получив компенсацию при увольнении, сначала проверьте НДФЛ: в пределах трёхкратной средней зарплаты работников региона за прошлый год — без налога; сверх — отдельный расчёт, не вместе с годовой зарплатой"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/ru/tip/19-19","data-status":"active"},"children":[{"tag":"span","props":{},"children":["19"]},"Переезжая в другой город для работы, переведите пенсионное и медицинское страхование по новому месту участия: годы взносов суммируются, выходить из пенсионного страхования не нужно"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"Навигация"},"children":[{"tag":"a","props":{"href":"/ru/book"},"children":["Книга"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/ru/book/19"},"children":["Глава 19"," ·"," ","Заработная плата, увольнение и производственные травмы"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"19-19"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["19"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["Доказательства"," ","A"]}]},{"tag":"h1","props":{"lang":"ru"},"children":["Переезжая в другой город для работы, переведите пенсионное и медицинское страхование по новому месту участия: годы взносов суммируются, выходить из пенсионного страхования не нужно"]},{"tag":"p","props":{"lang":"ru","className":"life-entry-summary"},"children":["При переезде в другой город для работы пенсионное и медицинское страхование могут переехать вместе с вами, а прежние годы взносов продолжают учитываться. Пока не достигнут возраст получения пенсии, выйти из пенсионного страхования и забрать деньги нельзя. Если взносы на медицинское страхование работников не платились более 3 месяцев, на новом месте возмещения, возможно, придётся ждать до 6 месяцев, поэтому не оставляйте большой перерыв."]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Затраты"]},{"tag":"p","props":{},"children":["Бесплатно. После регистрации и уплаты взносов на новом мес…"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Польза"]},{"tag":"p","props":{},"children":["Закон о социальном страховании устанавливает: при смене места работы (официально — при переходе между территор…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"Отметить: Переезжая в другой город для работы, переведите пенсионное и медицинское страхование по новому месту участия: годы взносов суммируются, выходить из пенсионного страхования не нужно"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"Сделано"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"В планах"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"В избранное"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Поделиться советом"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Скрыть подробности"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Затраты"]},{"tag":"p","props":{},"children":["Бесплатно. После регистрации и уплаты взносов на новом месте заявление о переводе подаёт новый работодатель или вы сами — в окне обслуживания либо онлайн. Пенсионный перевод на всех этапах занимает несколько десятков рабочих дней, медицинский — около 15 рабочих дней."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Польза"]},{"tag":"p","props":{},"children":["Закон о социальном страховании устанавливает: при смене места работы (официально — при переходе между территориями объединённого страхового фонда) пенсионное страхование переводится вместе с человеком, а годы уплаты взносов суммируются. То же относится к медицинскому страхованию работников: страховое участие следует за человеком, стаж суммируется. При выходе на пенсию выплаты рассчитываются по отдельным периодам, но выплачиваются в едином порядке. Межпровинциальный перевод пенсионного страхования проводится по правилам перевода и сохранения страхового участия, разосланным Канцелярией Госсовета. До достижения возраста получения выплат нельзя прекращать пенсионное страхование и выходить из него. Закон о социальном страховании также запрещает досрочное снятие денег с личного счёта. Вся сумма личного счёта вместе с процентами переводится целиком. Часть, которую платит работодатель, называется объединённым фондом; из неё переводится 12% фактической зарплаты, с которой начислялись взносы, за каждый год начиная с 1998-го. При начислении пенсии учитываются зарплаты для расчёта взносов за каждый год, стаж уплаты и средние зарплаты за соответствующие годы в месте получения пенсии. После регистрации и уплаты взносов на новом месте работодатель или вы сами подаёте туда письменное заявление. Новое место рассматривает его за 15 рабочих дней. Получив письмо о согласии принять перевод, прежнее место оформляет передачу за 15 рабочих дней. После получения страхового дела и денег новое место завершает оформление ещё за 15 рабочих дней. По перечню межпровинциальных услуг 2020 года эта услуга должна была стать доступной между провинциями до конца того года. Достаточно обратиться по месту перевода: возвращаться в прежнее место не нужно. Для перевода медицинского страхования работников необходимо сначала прекратить участие по прежнему месту и уже зарегистрироваться по новому. Заявление можно подать онлайн на Национальной платформе услуг медицинского страхования или в окне обслуживания. Прежнее место передаёт страхование за 10 рабочих дней, новое принимает за 5 рабочих дней; остаток личного счёта переводится вместе с ним. Если до перевода перерыв во взносах составил не более 3 месяцев, после доплаты по правилам нового места периода ожидания нет: расходы возмещаются уже в месяце уплаты, а расходы за перерыв можно возместить задним числом. При перерыве более 3 месяцев период ожидания определяется местными правилами и, как правило, не должен превышать 6 месяцев (по всей территории Китая)."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Первоисточники"]},{"tag":"p","props":{"className":"life-citations"},"children":["全国人大常委会 (2010, 2018 修正). 社会保险法（第十四、十九、三十二条）. ",{"tag":"a","props":{"href":"https://www.gov.cn/guoqing/2021-10/29/content_5647616.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/guoqing/2021-10/29/content_5647616.htm"]},"；人力资源社会保障部、财政部 (2009). 城镇企业职工基本养老保险关系转移接续暂行办法（国办发〔2009〕66 号转发，第二、三、四、五、六、七、八、十一条）. ",{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/2009-12/29/content_8104.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/zhengce/zhengceku/2009-12/29/content_8104.htm"]},"；国务院办公厅 (2020). 关于加快推进政务服务「跨省通办」的指导意见（国办发〔2020〕35 号，附件第 7 项）. ",{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/2020-09/29/content_5548125.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/zhengce/zhengceku/2020-09/29/content_5548125.htm"]},"；国家医保局办公室、财政部办公厅 (2021). 基本医疗保险关系转移接续暂行办法（医保办发〔2021〕43 号，第五、六、八、九、十一、十二、十三条）. ",{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/2021-11/28/content_5653856.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/zhengce/zhengceku/2021-11/28/content_5653856.htm"]},"；国家医保局 (2021). 《基本医疗保险关系转移接续暂行办法》政策解读（国家医保服务平台网址 fuwu.nhsa.gov.cn）. ",{"tag":"a","props":{"href":"http://www.gov.cn/zhengce/2021-11/28/content_5653855.htm","target":"_blank","rel":"noopener noreferrer"},"children":["http://www.gov.cn/zhengce/2021-11/28/content_5653855.htm"]}]},{"tag":"a","props":{"href":"https://www.gov.cn/guoqing/2021-10/29/content_5647616.htm","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Открыть источник"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Примечание автора"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["Если вы переезжаете в другую провинцию, которая не является провинцией регистрации вашего места жительства, и мужчине уже исполнилось 50 лет, а женщине 40 лет, пенсионное страхование остаётся по прежнему месту участия. На новом месте открывают лишь временный счёт, где учитывают все взносы работника и работодателя. Место получения пенсии определяется так. Если пенсионное страхование находится в провинции регистрации места жительства, пенсию получают там. Если оно находится в другой провинции, но в месте его нахождения накоплено 10 лет взносов, пенсию получают там. Если там нет 10 лет, страхование возвращают в предыдущее место, где накоплено 10 лет, и получают пенсию там. Если нигде нет 10 лет, все взносы объединяют по месту регистрации жительства и получают пенсию там. От места получения зависит средняя зарплата, используемая для расчёта пенсии. Переводы между городами одной провинции регулируются правилами этой провинции; уточните в местном учреждении социального страхования. Тем, кто уже получает пенсию, страхование больше не переводят. Как считается стаж после перерыва и для каких прав нужны непрерывные взносы, см. в разделе 7, пункте 18 (перерыв во взносах на социальное страхование). О самостоятельной уплате без работодателя см. раздел 31, пункт 11 (гибкая занятость)."]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Моя заметка"]},{"tag":"button","props":{"type":"button"},"children":["Запишите напоминание…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/ru/tip/19-18"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Предыдущий"]},"Получив компенсацию при увольнении, сначала проверьте НДФЛ: в пределах трёхкратной средней зарплаты работников региона за прошлый год — без налога; сверх — отдельный расчёт, не вместе с годовой зарплатой"]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["Другие советы по этой теме"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/19-12"},"children":[{"tag":"strong","props":{},"children":["Не верьте утверждению, будто «если дойти до рабочего места — это считается производственной травмой»: при внезапном недомогании сначала звоните 120, а не спешите на работу"]},{"tag":"span","props":{},"children":["Если вы спешите на работу при внезапном недомогании, это не принесёт …"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/19-13"},"children":[{"tag":"strong","props":{},"children":["Если работодатель не оформил страховку от несчастных случаев, вы всё равно имеете право на положенные выплаты — он обязан оплатить их в полном объёме по тем же стандартам"]},{"tag":"span","props":{},"children":["Даже если работодатель не застраховал вас от несчастных случаев, вы в…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/19-14"},"children":[{"tag":"strong","props":{},"children":["После стабилизации состояния пострадавшего проводится экспертиза трудоспособности, по результатам которой определяется размер компенсации"]},{"tag":"span","props":{},"children":["Как только состояние пострадавшего стабилизируется, проводится экспер…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/19-15"},"children":[{"tag":"strong","props":{},"children":["Три вида выплат при смерти на работе: пособие на погребение, пенсия иждивенцам и единовременная компенсация"]},{"tag":"span","props":{},"children":["При смерти работника полагаются три вида выплат, и нельзя упоминать т…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/19-16"},"children":[{"tag":"strong","props":{},"children":["Если на работе вас долгое время унижают, оскорбляют и притесняют, не пытайтесь терпеть: сначала зафиксируйте всё как доказательства, а затем действуйте в зависимости от ситуации — подавайте жалобы, вызывайте полицию или обращайтесь в суд"]},{"tag":"span","props":{},"children":["Люди, подвергающиеся травле на работе, в будущем имеют примерно на 60…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/19-17"},"children":[{"tag":"strong","props":{},"children":["При увольнении попросите у работодателя справку об увольнении с указанием срока договора, даты увольнения, должности и стажа"]},{"tag":"span","props":{},"children":["При увольнении по любой причине — сокращение, истечение срока договор…"]}]}]}]},{"tag":"a","props":{"className":"life-text-link","href":"/ru/book/19"},"children":["Читать всю тему: Заработная плата, увольнение и производственные травмы"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"15","height":"15","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]}]}]},{"tag":"nav","props":{"className":"life-tabbar","aria-label":"Основная навигация"},"children":[{"tag":"a","props":{"className":"","href":"/ru/book"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"21","height":"21","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-book-open","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M12 7v14"},"children":[]},{"tag":"path","props":{"d":"M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z"},"children":[]}]},{"tag":"span","props":{},"children":["Книга"]}]},{"tag":"a","props":{"className":"","href":"/ru/top-50"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"21","height":"21","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-star","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 2.122 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.122 2.122 0 0 0 1.597-1.16z"},"children":[]}]},{"tag":"span","props":{},"children":["Топ-50"]}]},{"tag":"a","props":{"className":"","href":"/ru/daily"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"21","height":"21","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-calendar-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M8 2v4"},"children":[]},{"tag":"path","props":{"d":"M16 2v4"},"children":[]},{"tag":"rect","props":{"width":"18","height":"18","x":"3","y":"4","rx":"2"},"children":[]},{"tag":"path","props":{"d":"M3 10h18"},"children":[]},{"tag":"path","props":{"d":"m9 16 2 2 4-4"},"children":[]}]},{"tag":"span","props":{},"children":["День"]}]},{"tag":"a","props":{"className":"","href":"/ru/dashboard"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"21","height":"21","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-checks","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d