:"a","props":{"href":"/tip/12-12"},"children":[{"tag":"span","props":{},"children":["12"]},"领了执照就开始有申报义务，没有收入也要按期零申报（照报一张全是零的表）"]},{"tag":"a","props":{"href":"/tip/12-13"},"children":[{"tag":"span","props":{},"children":["13"]},"发票只按真实交易开，小规模纳税人用足免税额"]},{"tag":"a","props":{"href":"/tip/12-14"},"children":[{"tag":"span","props":{},"children":["14"]},"自称税务局催你交钱报税的都是骗子，办税只走电子税务局和 12366"]},{"tag":"a","props":{"href":"/tip/12-15"},"children":[{"tag":"span","props":{},"children":["15"]},"收钱写「定金」不写「订金」，违约金写明数，账期当放贷来审"]},{"tag":"a","props":{"href":"/tip/12-16"},"children":[{"tag":"span","props":{},"children":["16"]},"用人第一个月内签书面合同，30 日内办社保登记"]},{"tag":"a","props":{"href":"/tip/12-17"},"children":[{"tag":"span","props":{},"children":["17"]},"工资按合同和法律给，加薪、借款、奖金都走书面"]},{"tag":"a","props":{"href":"/tip/12-18"},"children":[{"tag":"span","props":{},"children":["18"]},"先卖再造：用预售和小订单验证有人买，再投钱生产"]},{"tag":"a","props":{"href":"/tip/12-19"},"children":[{"tag":"span","props":{},"children":["19"]},"样品做出来先过一遍量产清单，再谈开工"]},{"tag":"a","props":{"href":"/tip/12-20"},"children":[{"tag":"span","props":{},"children":["20"]},"进货一批留一批票据和上家信息，进货价明显低于市场价的不进：员工进的假货，老板是被判的那个"]},{"tag":"a","props":{"href":"/tip/12-21"},"children":[{"tag":"span","props":{},"children":["21"]},"商品、包装、吊牌和宣传图上的图案要么自己做要么买授权，改个颜色、加个图标不算「改过了」"]},{"tag":"a","props":{"href":"/tip/12-22"},"children":[{"tag":"span","props":{},"children":["22"]},"在岗位上按规程办事，规程之外的好意先想清楚责任归谁"]},{"tag":"a","props":{"href":"/tip/12-23"},"children":[{"tag":"span","props":{},"children":["23"]},"亏了就按程序退场：能简易注销就注销，资不抵债走破产，别放着不管"]},{"tag":"a","props":{"href":"/tip/12-24"},"children":[{"tag":"span","props":{},"children":["24"]},"花钱请人代运营网店、上开店培训、做「无货源」之前，先问清后面还要不要加钱、销量从哪来"]},{"tag":"a","props":{"href":"/tip/12-25"},"children":[{"tag":"span","props":{},"children":["25"]},"开公司、当个体户的，每年 1 月 1 日到 6 月 30 日上网报上一年的年报，没生意也要报，年报不收费"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"当前位置"},"children":[{"tag":"a","props":{"href":"/book"},"children":["阅读全书"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/book/12"},"children":["第 12 章"," ·"," ","创业与做生意：别把家底赔进去"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"12-08"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["08"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["证据"," ","A"]}]},{"tag":"h1","props":{"lang":"zh"},"children":["做食品先看自己落在哪一档：生产和做餐饮要许可，只卖预包装的改备案，卖生鲜肉菜不用证"]},{"tag":"p","props":{"lang":"zh","className":"life-entry-summary"},"children":["自己做东西去卖，像小吃店、卤味、烘焙、自制酱菜，都要办许可。只卖别人做好的整包装食品不用许可，到县级以上市场监管部门备案就行。卖生鲜肉、蔬菜这类不用证。没证就干，最低也罚 5 万到 10 万，比多数小本生意的本钱还高。"]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["成本"]},{"tag":"p","props":{},"children":["许可证本身不收费。但场地和设施要达标，现场核查加上办证要几个星期。卖肉的还要每批留好检疫证明和肉品品质检验合格证。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["收益"]},{"tag":"p","props":{},"children":["食品安全法：做食品生意要先拿许可。自己生产食品、卖食品、做餐饮，都要依法拿到许可。"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"标记：做食品先看自己落在哪一档：生产和做餐饮要许可，只卖预包装的改备案，卖生鲜肉菜不用证"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"已做到"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w