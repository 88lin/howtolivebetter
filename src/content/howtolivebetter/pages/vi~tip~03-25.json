tton","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Chia sẻ mẹo này"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Ẩn chi tiết"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Chi phí"]},{"tag":"p","props":{},"children":["Một hộp ibuprofen giá hơn mười nhân dân tệ, chỉ uống trong những ngày đau. Nếu cần khám phụ khoa, tiền khám và siêu âm tốn một ít tiền cùng nửa ngày."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Lợi ích"]},{"tag":"p","props":{},"children":["Một tổng quan hệ thống Cochrane tổng hợp 80 thử nghiệm ngẫu nhiên có đối chứng với 5820 phụ nữ đau bụng kinh nguyên phát. Đau bụng kinh nguyên phát là đau bụng kinh mà không tìm thấy bệnh khác. So với giả dược, thuốc chống viêm không steroid giảm đau hiệu quả hơn (OR 4.37, 95% CI 3.76–5.09, khoảng tin cậy). Quy ra tỷ lệ, 18% người dùng giả dược giảm đau ít nhất ở mức vừa, còn người dùng các thuốc này là 45% đến 53%. Đổi lại, tác dụng phụ tăng một chút (OR 1.29, 1.11–1.51). 10% người dùng giả dược có tác dụng phụ, còn với các thuốc này là 11% đến 14%. Phần tăng thêm chủ yếu là khó chịu ở đường tiêu hóa (OR 1.58) và phản ứng của hệ thần kinh (OR 2.74). So với paracetamol, các thuốc này cũng giảm đau hiệu quả hơn (OR 1.89, 1.05–3.43), nhưng chỉ có 3 thử nghiệm. Không thấy khác biệt để xác định thuốc nào trong nhóm này tốt nhất. Hướng dẫn NICE của Anh, cập nhật năm 2024, liệt kê những tình huống cần nghi ngờ lạc nội mạc tử cung: đau vùng chậu kéo dài, đau bụng kinh ảnh hưởng đến hoạt động thường ngày và chất lượng cuộc sống, đau sâu trong hoặc sau quan hệ tình dục. Còn có đau khi đại tiện trong kỳ kinh, tiểu ra máu hoặc tiểu đau trong kỳ kinh, và vô sinh kèm các triệu chứng này. Bao gồm cả các em gái từ 17 tuổi trở xuống. Hướng dẫn khuyên thử paracetamol hoặc các thuốc này trước, chẳng hạn trong 3 tháng. Nếu giảm đau không đủ, chuyển để kiểm tra thêm. Khám phụ khoa và siêu âm đều bình thường cũng không loại trừ được bệnh này. Một nghiên cứu khảo sát 1418 phụ nữ được nội soi ổ bụng tại 16 bệnh viện ở 10 quốc gia. Từ khi có triệu chứng đến khi được phẫu thuật xác nhận lạc nội mạc tử cung, trung bình mất 6.7 năm, phần lớn chậm trễ ở giai đoạn khám tại tuyến ban đầu. Phụ nữ được chẩn đoán mất trung bình 10.8 giờ làm việc mỗi tuần, chủ yếu là có mặt ở nơi làm việc nhưng năng suất giảm. Một khảo sát trực tuyến ở Hà Lan hỏi 32748 phụ nữ từ 15 đến 45 tuổi. 13.8% từng nghỉ vì kinh nguyệt, trung bình 1.3 ngày mỗi năm. 80.7% vẫn có mặt ở nơi làm việc khi hành kinh nhưng năng suất giảm, tương đương mất 8.9 ngày làm việc mỗi năm."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Nguồn gốc"]},{"tag":"p","props":{"className":"life-citations"},"children":["Marjoribanks J, Ayeleke RO, Farquhar C, Proctor M (2015). Nonsteroidal anti-inflammatory drugs for dysmenorrhoea. Cochrane Database of Systematic Reviews, (7):CD001751. ",{"tag":"a","props":{"href":"https://doi.org/10.1002/14651858.CD001751.pub3","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1002/14651858.CD001751.pub3"]},"；National Institute for Health and Care Excellence (2017, updated 2024). Endometriosis: diagnosis and management (NG73), recommendations 1.3.1, 1.4.2, 1.4.3, 1.5.4. ",{"tag":"a","props":{"href":"https://www.nice.org.uk/guidance/ng73/chapter/Recommendations","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.nice.org.uk/guidance/ng73/chapter/Recommendations"]},"；Nnoaham KE, Hummelshoj L, Webster P, et al.; World Endometriosis Research Foundation Global Study of Women's Health consortium (2011). Impact of endometriosis on quality of life and work productivity: a multicenter study across ten countries. Fertility and Sterility, 96(2):366-373.e8. ",{"tag":"a","props":{"href":"https://doi.org/10.1016/j.fertnstert.2011.05.090","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1016/j.fertnstert.2011.05.090"]},"；Schoep ME, Adang EMM, Maas JWM, De Bie B, Aarts JWM, Nieboer TE (2019). Productivity loss due to menstruation-related symptoms: a nationwide cross-sectional survey among 32 748 women. BMJ Open, 9(6):e026186. ",{"tag":"a","props":{"href":"https://doi.org/10.1136/bmjopen-2018-026186","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1136/bmjopen-2018-026186"]},"；Haleon (2026). Advil (ibuprofen capsule, liquid filled), OTC drug label: Warnings. DailyMed. ",{"tag":"a","props":{"href":"https://dailymed.nlm.nih.gov/dailymed/drugInfo.cfm?setid=1f01c10a-9434-91a4-2ee4-352315a6b610","target":"_blank","rel":"noopener noreferrer"},"children":["https://dailymed.nlm.nih.gov/dailymed/drugInfo.cfm?setid=1f01c10a-9434-91a4-2ee4-352315a6b610"]}]},{"tag":"a","props":{"href":"https://doi.org/10.1002/14651858.CD001751.pub3","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Liên kết mở nguồn"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Ghi chú sách"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["Người trên 60 tuổi, từng chảy máu dạ dày hoặc đang dùng thuốc chống đông hay corticosteroid phải hỏi bác sĩ trước khi dùng các thuốc này. Chi tiết xem mục 3, phần 34 (thuốc giảm đau như ibuprofen). Hướng dẫn sử dụng ibuprofen của Mỹ ghi rõ thuốc có thể gây dị ứng nghiêm trọng, dễ xảy ra hơn ở người dị ứng aspirin, trong đó có cơn hen. Người bị hen cũng phải hỏi bác sĩ trước khi dùng. Nếu có thể đang mang thai, hãy hỏi bác sĩ trước; sau 20 tuần thai, đừng tự uống, xem mục 5, phần 34 (sau 20 tuần thai). Người không dùng được các thuốc này có thể chuyển sang paracetamol; giới hạn mỗi ngày xem mục 1, phần 34 (paracetamol). Với đau bụng kinh, chỉ uống thuốc trong những ngày hành kinh. Ngưỡng ở mục 9, phần 34 (đừng uống thuốc giảm đau quá 15 ngày một tháng) áp dụng cho đau đầu; số ngày uống thuốc vì đau bụng kinh cũng còn rất xa ngưỡng đó. Xếp A vì hiệu quả giảm đau đến từ nhiều thử nghiệm ngẫu nhiên. Các tác giả xếp chất lượng bằng chứng của đa số so sánh là thấp, chủ yếu vì phương pháp thử nghiệm được mô tả không rõ; 59% thử nghiệm do hãng dược tài trợ. Xếp lợi ích «vừa» là một nhận định: tổng quan chỉ đo mức đau, không đo bớt bao nhiêu ngày nghỉ. Trong khảo sát Hà Lan, thiệt hại do kinh nguyệt tương đương khoảng 10 ngày mỗi năm, chia ra mỗi tuần là mức vài giờ. Nhóm lạc nội mạc tử cung là những người đã đi nội soi ổ bụng, không có nghĩa đa số người đau bụng kinh đều mắc bệnh này. Người hưởng lợi chủ yếu là chính bạn."]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Ghi chú của tôi"]},{"tag":"button","props":{"type":"button"},"children":["Viết một lời nhắc cho chính bạn…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/vi/tip/03-24"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Trước"]},"Có một chuyện đè nặng trong lòng, có thể viết suốt mấy ngày liền tư tưởng và cảm xúc của mình ra, nhưng đừng trông chờ nó chữa bệnh"]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["Thêm trong chủ đề này"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/03-18"},"children":[{"tag":"strong","props":{},"children":["Khi tâm trạng tụt, làm trước mấy việc hiệu quả chi phí nhất: vận động, phơi nắng, ngủ đúng giờ, nói với ai đó, gọi 12356"]},{"tag":"span","props":{},"children":["Với bệnh trầm cảm, đi bộ nhanh và chạy bộ hiệu quả nhất, càng mạnh cà…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/03-19"},"children":[{"tag":"strong","props":{},"children":["Xem cảnh sát, bác sĩ và nhân viên giao dịch là người đi làm theo quy định, đừng xem là một vai diễn: thứ đẩy việc tới đích là giấy tờ và thời hạn, không phải cảm xúc"]},{"tag":"span","props":{},"children":["Cảnh sát, bác sĩ và nhân viên giao dịch đều là người đi làm theo quy …"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/03-20"},"children":[{"tag":"strong","props":{},"children":["Đừng coi việc「xem người khác sống thế nào」là phần bắt buộc phải đọc mỗi ngày: giới hạn hoặc tắt luôn các app lướt bảng tin của người cùng tuổi"]},{"tag":"span","props":{},"children":["Người quen so sánh mình với người khác trên mạng thường tâm trạng tệ …"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/03-21"},"children":[{"tag":"strong","props":{},"children":["Khi thấy「ai cũng thấy mình mất mặt」thì chia đôi con số ước lượng đó"]},{"tag":"span","props":{},"children":["Bước vào phòng có người mặc chiếc T-shirt đáng xấu hổ, người mặc nghĩ…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/03-22"},"children":[{"tag":"strong","props":{},"children":["Xem câu「người khác đòi tôi hoàn hảo」là triệu chứng, không phải sự thật"]},{"tag":"span","props":{},"children":["Người luôn thấy「người quanh tôi đòi tôi hoàn hảo, không đạt thì sẽ bị…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/03-23"},"children":[{"tag":"strong","props":{},"children":["Khi giận đừng trút bằng cách đập đồ, đấm bao cát, chạy 