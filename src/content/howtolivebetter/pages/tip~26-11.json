-citations"},"children":["作者经验，无直接文献；服务商资质与备案的法定要求见本节第 4 条，日志留存 6 个月和等级保护义务见第 11 节第 16 条"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["原书备注"]},{"tag":"p","props":{"className":"life-citations"},"children":["上面是经验判断，没有文献证据。能真正核查的只有一件事：服务商的许可证。要省钱就在配置和带宽上省，别在资质上省\n\n## 许可\n\n正文按 [CC BY 4.0](../LICENSE) 发布，转载、改编要写明出处并附原文链接。代码用 [MIT](../LICENSE-CODE)。"]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["我的备注"]},{"tag":"button","props":{"type":"button"},"children":["写下对自己有用的提醒…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/tip/26-10"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["上一条"]},"用户信息不要随手放到境外，出境有法定条件和人数门槛"]}]},{"tag":"span","props":{},"children":[]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["本主题的其他建议"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/26-04"},"children":[{"tag":"strong","props":{},"children":["服务器放境内就要备案，接入商必须自己持有增值电信许可"]},{"tag":"span","props":{},"children":["服务器放在境内，开站前就要备案。备案不花钱，跟着服务器在服务商那里提交，一般几天到几周。没备案会被责令限期改正，再罚 1 万元，不改就关站。主页上不挂备案号，另…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/26-05"},"children":[{"tag":"strong","props":{},"children":["让用户上来卖东西，平台就要核验登记、报送信息、留存三年"]},{"tag":"span","props":{},"children":["让别人上你的平台卖东西，你就要先核卖家的身份、地址、联系方式和许可证，再登记建档。建完档，至少每六个月回头再核一次。卖家是谁要报给市场监管，纳税的情况每季度报给…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/26-06"},"children":[{"tag":"strong","props":{},"children":["用户发的内容你要管：审核机制、举报入口、发现违法立即停传并报告"]},{"tag":"span","props":{},"children":["用户发的东西，出了事由平台负责。你要把这套制度建起来：注册、发帖审核、评论审核、每天巡查、出事怎么处置。页面显眼的地方放举报入口。看到违法信息，马上停止传播、留…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/26-07"},"children":[{"tag":"strong","props":{},"children":["提供信息发布、即时通讯服务，必须要求用户提供真实身份信息"]},{"tag":"span","props":{},"children":["你的网站能发帖，或者能聊天，就要在用户开通服务时要他的真实身份信息。不给的，不能让他用。做法是后台存真名，页面上显示什么昵称由他自己定，核验用手机号就行。不做实…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/26-08"},"children":[{"tag":"strong","props":{},"children":["不给未满 16 周岁的人开直播，打赏按年龄分档处理"]},{"tag":"span","props":{},"children":["不满 16 周岁的人，不能在你这里注册开播账号。满 16 周岁的要核验身份，还要父母或其他监护人同意。打赏分三档：不满 8 岁不能打赏，8 到 16 岁要监护人…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/26-09"},"children":[{"tag":"strong","props":{},"children":["接到侵权通知要及时处理，转送声明后 15 日没有下文就恢复"]},{"tag":"span","props":{},"children":["有人发来侵权通知，还附了初步证据，你要及时把东西删掉、屏蔽或者断开链接，同时把通知转给卖家。拖着不办，多出来的那部分损失你要和卖家一起赔。卖家申辩了，你把申辩转…"]}]}]}]},{"tag":"a","props":{"className":"life-text-link","href":"/book/26"},"children":["阅读整个主题：做一个网站或平台：资质、备案和服务器 ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"15","height":"15","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]}]}]}]},{"tag":"aside","props":{"className":"life-ad-space life-ad-space-sponsored","data-ad-placement":"ad_footer","data-ad-group":"reading","data-ad-creative":"read_product","data-ad-ready":"false","aria-label":"广告 · 社区推荐"},"children":[{"tag":"div","props":{"cl