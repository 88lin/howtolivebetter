ing","data-ad-creative":"read_product","data-ad-ready":"false","aria-label":"広告 · コミュニティ紹介"},"children":[{"tag":"button","props":{"type":"button","className":"life-ad-dismiss","aria-label":"広告を閉じる"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-x","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M18 6 6 18"},"children":[]},{"tag":"path","props":{"d":"m6 6 12 12"},"children":[]}]}]},{"tag":"div","props":{"className":"life-ad-space-brand"},"children":[{"tag":"img","props":{"src":"/sites/howtolivebetter/images/shengcai/logo.png","width":"565","height":"144","alt":"生財有術の公式ロゴ","decoding":"async"},"children":[]}]},{"tag":"div","props":{"className":"life-ad-space-copy"},"children":[{"tag":"span","props":{"className":"life-ad-space-label"},"children":["広告 · コミュニティ紹介"]},{"tag":"strong","props":{},"children":["学んだ知識は、役立つ製品になる？"]},{"tag":"p","props":{},"children":["電子書籍や小さなツール。需要を見つけ、知識を使える形にする参加者の実践を紹介します。"]}]},{"tag":"div","props":{"className":"life-ad-space-actions"},"children":[{"tag":"a","props":{"className":"life-ad-space-link","href":"/ja/shengcaiyoushu?sc_group=reading&sc_creative=read_product&sc_placement=ad_dock"},"children":["コミュニティと事例を見る",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"18","height":"18","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-up-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M7 7h10v10"},"children":[]},{"tag":"path","props":{"d":"M7 17 17 7"},"children":[]}]}]}]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/ja/book/08"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"目次に戻る"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["自分を犠牲にしないために：法律と財産の安全を守る"]},{"tag":"div","props":{"data-ad-dock-host":"true"},"children":[]},{"tag":"nav","props":{"aria-label":"この章のヒント"},"children":[{"tag":"a","props":{"href":"/ja/tip/08-01"},"children":[{"tag":"span","props":{},"children":["01"]},"交通事故に遭ったら、まずは停車、救護、通報。逃走してはいけない"]},{"tag":"a","props":{"href":"/ja/tip/08-02"},"children":[{"tag":"span","props":{},"children":["02"]},"詐欺に気づいたら、すぐに 110 または 96110 に電話して支払停止を依頼すること。自分で調べるのは後回しに"]},{"tag":"a","props":{"href":"/ja/tip/08-03"},"children":[{"tag":"span","props":{},"children":["03"]},"詐欺防止の鉄則を覚えよう：電話を鵜呑みにしない、情報を明かさない、リンクをクリックしない、送金は必ず確認する。最も一般的な7つの詐欺はこのパターンです"]},{"tag":"a","props":{"href":"/ja/tip/08-04"},"children":[{"tag":"span","props":{},"children":["04"]},"ビデオで顔を見ること、電話で声を聞くことは「本人確認」とはみなさない。送金が絡む場合は一旦電話を切り、自分の連絡先に登録されている古い番号にかけ直すこと"]},{"tag":"a","props":{"href":"/ja/tip/08-05"},"children":[{"tag":"span","props":{},"children":["05"]},"容疑をかけられた、または召喚された場合は、まず弁護士を依頼すること。示談はせず、記録を削除しないこと"]},{"tag":"a","props":{"href":"/ja/tip/08-06"},"children":[{"tag":"span","props":{},"children":["06"]},"問題が起きたら自ら説明しに行く：自首すれば刑期を最大4割減刑できる可能性があり、軽い犯罪ならさらに減刑や免罰もあり得る。「公訴時効を逃れる」という道は閉ざされている"]},{"tag":"a","props":{"href":"/ja/tip/08-07"},"children":[{"tag":"span","props":{},"children":["07"]},"飲酒した後はハンドルに触れない。電気自動車や「少しだけ動かす」場合も含む"]},{"tag":"a","props":{"href":"/ja/tip/08-08"},"children":[{"tag":"span","props":{},"children":["08"]},"銀行カード、SIMカード、決済アカウントを他人に貸さない。「資金洗浄（跑分）」は副業ではない"]},{"tag":"a","props":{"href":"/ja/tip/08-09"},"children":[{"tag":"span","props":{},"children":["09"]},"年に2回、無料で自分の信用報告書をチェックし、身に覚えのないローンやカードがないか確認する"]},{"tag":"a","props":{"href":"/ja/tip/08-10"},"children":[{"tag":"span","props":{},"children":["10"]},"衝突が起きたら、手を出さずにまず通報すること。先に手を出した側が、ほぼ確実に損をする"]},{"tag":"a","props":{"href":"/ja/tip/08-11"},"children":[{"tag":"span","props":{},"children":["11"]},"避けられない侵害に対しては反撃可能だが、現在手を出し続けている人物に対してのみ行うこと。相手が止まれば、あなたも止めること"]},{"tag":"a","props":{"href":"/ja/tip/08-12"},"children":[{"tag":"span","props":{},"children":["12"]},"誰と恨みができたとしても（賃金未払い、解雇、金銭トラブルなど）―― 復讐ではなく、苦情申し立て、仲裁、訴訟の手続きを踏むこと"]},{"tag":"a","props":{"href":"/ja/tip/08-13"},"children":[{"tag":"span","props":{},"children":["13"]},"どれほど恨みがあっても無関係な人には手を出さない：車で群衆に突っ込む行為や公共の場での凶行は「危険な方法による公共の安全への危害罪」となり、刑期は3年から。死者が出れば10年以上、最高で死刑"]},{"tag":"a","props":{"href":"/ja/tip/08-14"},"children":[{"tag":"span","props":{},"children":["14"]},"「道連れにしてやる」「共倒れになってやる」といった考えが浮かんだら、緊急事態として対処：その場を離れ、車の鍵や刃物を他人に預け、12356 に電話する"]},{"tag":"a","props":{"href":"/ja/tip/08-15"},"children":[{"tag":"span","props":{},"children":["15"]},"周囲の人が「誰も幸せになれないようにしてやる」「子供を連れて逃げる」と言い出した時、感情的な言葉だと思わないで：近親者は直接受診させることができ、警察は通報を受けたら必ず対応しなければなりません"]},{"tag":"a","props":{"href":"/ja/tip/08-16"},"children":[{"tag":"span","props":{},"children":["16"]},"ネット上では誹謗中傷やデマ、未確認情報の拡散をしないこと。ネットリンチを受けた際は、まず証拠を残してから警察へ通報すること"]},{"tag":"a","props":{"href":"/ja/tip/08-17"},"children":[{"tag":"span","props":{},"children":["17"]},"署名前に書類を最後まで読み、代理署名はせず、白紙には署名しない"]},{"tag":"a","props":{"href":"/ja/tip/08-18"},"children":[{"tag":"span","props":{},"children":["18"]},"借金の際は借用書を明記すること。他人への保証人になる前には、代わりに返済する意思があるかよく考えること"]},{"tag":"a","props":{"href":"/ja/tip/08-19"},"children":[{"tag":"span","props":{},"children":["19"]},"権利保護には期限があります：民事訴訟時効は 3 年、労働仲裁は 1 年、期限を過ぎると相手の「時効超過」の一言で十分です"]},{"tag":"a","props":{"href":"/ja/tip/08-20"},"children":[{"tag":"span","props":{},"children":["20"]},"提訴された、強制執行された場合は、財産を正直に報告し、支払える分だけ支払うこと。不動産や現金を親族や会社に移してはいけません"]},{"tag":"a","props":{"href":"/ja/tip/08-21"},"children":[{"tag":"span","props":{},"children":["21"]},"消費制限または失信リストへの掲載を受けた場合は、まずどの条項に基づいて掲載されたのかを確認し、訂正可能な場合は訂正を申請すること"]},{"tag":"a","props":{"href":"/ja/tip/08-22"},"children":[{"tag":"span","props":{},"children":["22"]},"ネットショッピングや中古取引で詐欺に遭ったら、まずはプラットフォームへ通報、次に警察へ通報、その上で訴訟を起こす価値があるかを検討"]},{"tag":"a","props":{"href":"/ja/tip/08-23"},"children":[{"tag":"span","props":{},"children":["23"]},"恋愛および婚姻における高額な贈与は、交付する前に慎重に検討を。交付後は原則として取り消せません"]},{"tag":"a","props":{"href":"/ja/tip/08-24"},"children":[{"tag":"span","props":{},"children":["24"]},"結納金は振込で行い、用途を明記し、チャット履歴を保存すること。結婚を口実とした金銭要求は返還請求が可能"]},{"tag":"a","props":{"href":"/ja/tip/08-25"},"children":[{"tag":"span","props":{},"children":["25"]},"婚前財産を恐れる必要はありません。不動産の名義追加や親の出資は事前に明確に書き留めておくこと"]},{"tag":"a","props":{"href":"/ja/tip/08-26"},"children":[{"tag":"span","props":{},"children":["26"]},"結婚前に相手の婚姻状況を確認すること。結婚を口実にお金を騙し取る行為は詐欺罪として追及されます"]},{"tag":"a","props":{"href":"/ja/tip/08-27"},"children":[{"tag":"span","props":{},"children":["27"]},"出張修理、車両点検、リフォームなどは、作業前に必ず価格を確認し、全工程を傍らで見守ること"]},{"tag":"a","props":{"href":"/ja/tip/08-28"},"children":[{"tag":"span","props":{},"children":["28"]},"「名義上の代表者」にならないこと。会社設立のために身分証を他人に貸さないこと"]},{"tag":"a","props":{"href":"/ja/tip/08-29"},"children":[{"tag":"span","props":{},"children":["29"]},"出入国時に見知らぬ人の荷物を預からないこと。出所不明の小包を代理受領しないこと"]},{"tag":"a","props":{"href":"/ja/tip/08-30"},"children":[{"tag":"span","props":{},"children":["30"]},"中国で犬を飼うなら必ずリードを使う。未装着の事故は無過失責任で賠償する。狂犬病ワクチンと飼育登録も忘れない"]},{"tag":"a","props":{"href":"/ja/tip/08-31"},"children":[{"tag":"span","props":{},"children":["31"]},"相手が意識不明、睡眠中、または 14 歳未満である可能性がある場合は、性交渉を行わないこと"]},{"tag":"a","props":{"href":"/ja/tip/08-32"},"children":[{"tag":"span","props":{},"children":["32"]},"性交渉やビデオチャットの後、相手が通報、写真の拡散、勤務先への連絡を盾に金銭を要求してきた場合、一銭も払わず、記録も削除せず、直ちに警察へ通報すること"]},{"tag":"a","props":{"href":"/ja/tip/08-33"},"children":[{"tag":"span","props":{},"children":["33"]},"事実を捏造して通報された場合、以下の追及が可能です：治安行政処分に該当する場合は 5 日からの拘留、犯罪に該当する場合は 3 年以下の懲役"]},{"tag":"a","props":{"href":"/ja/tip/08-34"},"children":[{"tag":"span","props":{},"children":["34"]},"証拠不十分であれば本来無罪とされるべきであり、強要された自白は排除されるべきである。判決後には上訴や再審の道がある"]},{"tag":"a","props":{"href":"/ja/tip/08-35"},"children":[{"tag":"span","props":{},"children":["35"]},"勾留後に不起訴、不起訴処分または無罪判決を受けた場合、国家賠償を申請できます。賠償額は日割り計算されます"]},{"tag":"a","props":{"href":"/ja/tip/08-36"},"children":[{"tag":"span","props":{},"children":["36"]},"被害者として賠償を請求する場合、12315、訴訟、または弁護士を通じて行い、相手と二人きりで会う約束をしないこと。「金を払えば、公表しない」という言い方をセットにしないこと"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/ja/tip/08-37","data-status":"active"},"children":[{"tag":"span","props":{},"children":["37"]},"ネット炎上（ネットいじめ）に遭ったら：まずは防御設定、証拠保全、そしてプラットフォームへの通報・禁止命令・警察への通報の3つの道から選択"]},{"tag":"a","props":{"href":"/ja/tip/08-38"},"children":[{"tag":"span","props":{},"children":["38"]},"「保険をかけてから手を下す」という道は、法律上最初から完全に塞がれています：金銭は一切受け取れず、罪は殺人罪と保険詐欺罪の併合罪として処罰されます"]},{"tag":"a","props":{"href":"/ja/tip/08-39"},"children":[{"tag":"span","props":{},"children":["39"]},"警察への通報時はその場で受理票を受け取ること、不立案（事件化しない）の場合は書面での通知が必要：7 日以内に再審査を申請でき、さらに 7 日以内に再審査請求が可能。検察庁は警察に立案を通知できます"]},{"tag":"a","props":{"href":"/ja/tip/08-40"},"children":[{"tag":"span","props":{},"children":["40"]},"捜査・執行官への金銭やカードの贈賄は避けること：贈賄側も処罰の対象となり、監察・執行・司法関係者への贈賄はより重い刑が科される"]},{"tag":"a","props":{"href":"/ja/tip/08-41"},"children":[{"tag":"span","props":{},"children":["41"]},"トラブルに発展しそうな電話や面談は、直接録音する：自分が参加している会話なら、相手の事前の同意は不要"]},{"tag":"a","props":{"href":"/ja/tip/08-42"},"children":[{"tag":"span","props":{},"children":["42"]},"現場で事故が起きたら、まず全景、次に位置関係、最後に損傷と怪我の状況を撮影すること。元の写真や動画は削除しないでください"]},{"tag":"a","props":{"href":"/ja/tip/08-43"},"children":[{"tag":"span","props":{},"children":["43"]},"ドメスティック・バイオレンス（DV）を受けた時：まずは警察に通報して出動記録を残し、その後に裁判所へ人身安全保護命令を申請しましょう。離婚を先に済ませる必要はなく、費用もかかりません"]},{"tag":"a","props":{"href":"/ja/tip/08-44"},"children":[{"tag":"span","props":{},"children":["44"]},"家族がギャンブルで借金を作った場合、すぐに肩代わりして返済しないでください：ギャンブルの借金は法律で保護されず、ギャンブルのために借りたお金も夫婦の共同債務とはみなされません"]},{"tag":"a","props":{"href":"/ja/tip/08-45"},"children":[{"tag":"span","props":{},"children":["45"]},"知人から「顔認証の協力や証人になってほしい」と融資の手伝いを頼まれたら、決して応じてはいけない：これは「ABローン」と呼ばれ、借り手はあなたであり、保証人ではありません"]},{"tag":"a","props":{"href":"/ja/tip/08-46"},"children":[{"tag":"span","props":{},"children":["46"]},"ドアと窓に錠を付け、玄関外にセンサーライトを設置し、外出時は必ず施錠する。侵入窃盗の予防はこの組み合わせで、警報器だけの効果は認められない"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"現在地"},"children":[{"tag":"a","props":{"href":"/ja/book"},"children":["本を読む"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/ja/book/08"},"children":["第8章"," ·"," ","自分を犠牲にしないために：法律と財産の安全を守る"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"08-37"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["37"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["エビデンス"," ","A"]}]},{"tag":"h1","props":{"lang":"ja"},"children":["ネット炎上（ネットいじめ）に遭ったら：まずは防御設定、証拠保全、そしてプラットフォームへの通報・禁止命令・警察への通報の3つの道から選択"]},{"tag":"p","props":{"lang":"ja","className":"life-entry-summary"},"children":["その場ですぐにすべき3つのこと：プラットフォームの防御設定を有効にする、クイック証拠保全機能を使って内容を保存する、そしてショートカットから通報する。その後、裁判所に禁止命令を申請し、相手の行為を停止させることが可能です。自ら裁判所に訴えることもでき、証拠収集が困難な場合は警察の協力を仰ぐこともできます。被害が極めて深刻で影響が甚大な場合は、検察庁が起訴するため、自身で立証する必要はありません。"]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["費用・手間"]},{"tag":"p","props":{},"children":["費用はかかりません。その場で防御と証拠保全を行うのに十数分必要です。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["効果"]},{"tag":"p","props":{},"children":["法発〔2023〕14 号第 15 条は禁止命令について述べています。権利者が、行為者がその人格権を侵害する違法行為を行っている、または行おうとしていることを証明する証拠を有しており、かつ、速やかに制止しなければ、その正当…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"記録する：ネット炎上（ネットいじめ）に遭ったら：まずは防御設定、証拠保全、そしてプラットフォームへの通報・禁止命令・警察への通報の3つの道から選択"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"できている"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"やることに追加"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"お気に入り"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"このヒントを共有"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"詳細を閉じる"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["費用・手間"]},{"tag":"p","props":{},"children":["費用はかかりません。その場で防御と証拠保全を行うのに十数分必要です。禁止命令の申請や自訴の段階に進む場合は、裁判所へ行く必要があり、弁護士への依頼が必要になる場合もあります。難しいのは、罵倒されている最中に言い返さず、まず証拠を保存することです。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["効果"]},{"tag":"p","props":{},"children":["法発〔2023〕14 号第 15 条は禁止命令について述べています。権利者が、行為者がその人格権を侵害する違法行為を行っている、または行おうとしていることを証明する証拠を有しており、かつ、速やかに制止しなければ、その正当な権利および利益に回復困難な損害が生じる場合、権利者が民法典第997条に基づき申請すれば、人民法院は法律に従って人格権侵害禁止命令を出すことができます。人格権侵害禁止命令とは、相手方に対してまず行為を停止するよう命じる裁判所の命令です。同解釈の第 11 条は証拠収集について述べています。自訴事件において、「被害者が証拠の提供に困難がある場合、公安機関に協力の要請をすることができる」とされています。公安機関は、速やかに行為主体を特定し、拡散状況や影響などの証拠資料を収集しなければなりません。ネットワークサービス提供者は、必要な技術的支援を提供しなければなりません。「公安機関の証拠収集の援助を受け、自訴案件の受理条件を満たす場合、人民法院は立案を決定しなければならない」。収集不可能な場合、公安機関は書面でその理由を説明しなければならない。自訴案件とは、被害者自身が裁判所に訴えを起こす案件のことである。当該解釈の第 12 条には、刑法第246条第2項に規定される「社会秩序に深刻な危害を及ぼす」と認定されるべき5つの状況が列挙されている。第一に、被害者またはその近親者に精神異常や自殺などの深刻な結果をもたらし、かつ社会的影響が極めて悪質な場合。第二に、不特定多数の一般市民を侵害対象とし、情報の広範囲な拡散により大量の低俗で悪意のあるコメントを誘発し、かつ社会的影響が極めて悪質な場合。第三に、複数人に対する侮辱・誹謗、または複数回の流布が行われ、かつ社会的影響が極めて悪質な場合。第四に、複数のプラットフォームにおいて人員を組織・指示して大量に流布させ、かつ社会的影響が極めて悪質な場合。第五に、その他。この解説の第 4 条：組織的な「ネット私刑（ドクシング）」を行い、違法に個人情報を収集し、不特定多数に公開する行為は、事態が重大な場合は個人情報侵害罪として処罰の対象となります。『ネットワーク暴力情報管理規定』第23条は、プラットフォームに対して以下の保護オプションを提供することを求めています。見知らぬユーザーや特定のユーザーをブロックすること。情報の公開範囲を本人限定に制限すること。転載やコメントを禁止すること。友達からのダイレクトメッセージのみを受け取る、あるいはすべてのダイレクトメッセージの受信を拒否すること。第25条は、迅速な証拠収集機能の提供を求めています。第26条は、目立つ場所に迅速な通報・告発窓口を設置することを求めています。第15条は、プラットフォームが違法行為や犯罪の疑いを発見した場合、速やかに公安機関に通報することを求めています"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["出典"]},{"tag":"p","props":{"className":"life-citations"},"children":["最高人民法院、最高人民检察院、公安部 (2023). 关于依法惩治网络暴力违法犯罪的指导意见（法发〔2023〕14 号，第 4、11、12、15 条）. ",{"tag":"a","props":{"href":"https://www.court.gov.cn/zixun/xiangqing/412992.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.court.gov.cn/zixun/xiangqing/412992.html"]},"；全国人大 (2020). 民法典（第九百九十七条）. 最高人民检察院转载全文 ",{"tag":"a","props":{"href":"https://www.spp.gov.cn/spp/fl/202006/t20200602_463888.shtml","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.spp.gov.cn/spp/fl/202006/t20200602_463888.shtml"]},"；国家互联网信息办公室、公安部、文化和旅游部、国家广播电视总局 (2024). 网络暴力信息治理规定（第十五、二十三、二十五、二十六条，2024 年 8 月 1 日施行）. 国务院公报 ",{"tag":"a","props":{"href":"https://www.gov.cn/gongbao/2024/issue_11526/202408/content_6969181.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/gongbao/2024/issue_11526/202408/content_6969181.html"]}]},{"tag":"a","props":{"href":"https://www.court.gov.cn/zixun/xiangqing/412992.html","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["出典を開く"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["著者の注記"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["順序は「迅速かつ安価」な順に並べています：プラットフォームへの対応が最も速く、コストも最小限で、まずは証拠保全、次に通報です。裁判所は最も時間がかかり、費用も高額になるため、最後に訴訟を起こすかどうかを判断します。3つのルートいずれにおいても、プロセスにかかるコストは自己負担となります。差止命令は自ら裁判所に申し立てる必要があります。自訴は自ら裁判所に提訴し、自ら証拠を提出することです。検察庁に引き継いでもらい、公訴への切り替えを希望する場合は、法発〔2023〕14号第 12 条に列挙されている5つの状況のいずれかに該当する必要があります。該当しない場合は、自分で訴えるしかありません。やってはいけないことが2つあります。一つは、言い返さないこと。言い返してしまうと、あなた自身が本節第 16 条（ネット上での誹謗中傷・デマの禁止）で罰せられる対象になってしまいます。二つ目は、自分のアカウント内のコンテンツを削除しないこと。それが証拠になります。耐えられなくなった時は 12356 をしてください。第 1 節第 25 条を参照してください。プラットフォームに個人情報の削除を要求するには、第 14 節第 8 条を参照してください。見知らぬ人を助けたことで撮影されたり、ネット上に拡散されたりした場合については、",{"tag":"a","props":{"href":"/ja/articles/helping-a-stranger"},"children":["docs/遇到陌生人出事该不该停.md"]}," を参照してください。"]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["自分のメモ"]},{"tag":"button","props":{"type":"button"},"children":["自分へのメモを書く…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/ja/tip/08-36"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["前へ"]},"被害者として賠償を請求する場合、12315、訴訟、または弁護士を通じて行い、相手と二人きりで会う約束をしないこと。「金を払えば、公表しない」という言い方をセットにしないこと"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/ja/tip/08-38"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["次へ"]},"「保険をかけてから手を下す」という道は、法律上最初から完全に塞がれています：金銭は一切受け取れず、罪は殺人罪と保険詐欺罪の併合罪として処罰されます"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["このテーマの他の提案"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/08-33"},"children":[{"tag":"strong","props":{},"children":["事実を捏造して通報された場合、以下の追及が可能です：治安行政処分に該当する場合は 5 日からの拘留、犯罪に該当する場合は 3 年以下の懲役"]},{"tag":"span","props":{},"children":["事実を捏造して他人を誣告（むこく）し、刑事責任や治安行政処分を受けさせようとすることは、それ自体が違法です。この場合、5 日以下の拘留、ま…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/08-34"},"children":[{"tag":"strong","props":{},"children":["証拠不十分であれば本来無罪とされるべきであり、強要された自白は排除されるべきである。判決後には上訴や再審の道がある"]},{"tag":"span","props":{},"children":["有罪判決の基準は刑事訴訟法に明記されている。確定的な証拠は法定の手続きを経て真実であることが確認され、かつ全証拠を総合して合理的な疑いを排…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/08-35"},"children":[{"tag":"strong","props":{},"children":["勾留後に不起訴、不起訴処分または無罪判決を受けた場合、国家賠償を申請できます。賠償額は日割り計算されます"]},{"tag":"span","props":{},"children":["拘留または逮捕された後、不起訴、不起訴処分、あるいは無罪判決を受けた場合、国家賠償を申請することが可能です。拘束された日数は日割りで賠償さ…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/08-39"},"children":[{"tag":"strong","props":{},"children":["警察への通報時はその場で受理票を受け取ること、不立案（事件化しない）の場合は書面での通知が必要：7 日以内に再審査を申請でき、さらに 7 日以内に再審査請求が可能。検察庁は警察に立案を通知できます"]},{"tag":"span","props":{},"children":["通報した際は、その場で受理票を受け取ってください。これは通報した唯一の証拠となります。警察が立案しない（事件化しない）と決定した場合、書面…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/08-40"},"children":[{"tag":"strong","props":{},"children":["捜査・執行官への金銭やカードの贈賄は避けること：贈賄側も処罰の対象となり、監察・執行・司法関係者への贈賄はより重い刑が科される"]},{"tag":"span","props":{},"children":["「金を払って事態を収める」ことは、刑法において独立した罪であり、逮捕されるのは金を受け取った側だけではありません。贈賄は 3 年以下の懲役…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/08-41"},"children":[{"tag":"strong","props":{},"children":["トラブルに発展しそうな電話や面談は、直接録音する：自分が参加している会話なら、相手の事前の同意は不要"]},{"tag":"span","props":{},"children":["借金、未払い、賠償、返金、労働紛争など、電話で明確に話したものの記録が残っていない場合、数ヶ月後に双方の言い分が食い違う可能性があります。…"]}]}]}]},{"tag":"a","props":{"className":"life-text-link","href":"/ja/book/08"},"children":["テーマ全体を読む：自分を犠牲にしないために：法律と財産の安全を守る"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"15","height":"15","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 