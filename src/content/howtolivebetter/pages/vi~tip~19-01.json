cide-circle-user-round","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M18 20a6 6 0 0 0-12 0"},"children":[]},{"tag":"circle","props":{"cx":"12","cy":"10","r":"4"},"children":[]},{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},{"tag":"span","props":{},"children":["Đăng nhập để đồng bộ hóa"]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/vi/book/19"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"Quay lại mục lục"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["Đi làm, nghỉ việc và tai nạn lao động"]},{"tag":"nav","props":{"aria-label":"Các mục trong chương"},"children":[{"tag":"a","props":{"aria-current":"page","className":"active","href":"/vi/tip/19-01","data-status":"active"},"children":[{"tag":"span","props":{},"children":["01"]},"Tiền làm thêm giờ tính theo ba mức 1.5 lần, 2 lần, 3 lần; không trả thì báo thanh tra lao động, quá hạn không trả còn phải cộng thêm 50% đến 100%"]},{"tag":"a","props":{"href":"/vi/tip/19-02"},"children":[{"tag":"span","props":{},"children":["02"]},"Nghỉ phép năm tính theo thâm niên cộng dồn: 5, 10, 15 ngày; nghỉ không được thì đổi thành tiền bằng 300% lương ngày"]},{"tag":"a","props":{"href":"/vi/tip/19-03"},"children":[{"tag":"span","props":{},"children":["03"]},"Thời gian thử việc có trần theo luật, lương không được dưới 80%, và chỉ được thỏa thuận một lần"]},{"tag":"a","props":{"href":"/vi/tip/19-04"},"children":[{"tag":"span","props":{},"children":["04"]},"Bị sa thải thì tính rõ N trước: cứ mỗi năm làm đủ một năm thì một tháng lương, chưa đủ sáu tháng thì tính nửa tháng"]},{"tag":"a","props":{"href":"/vi/tip/19-05"},"children":[{"tag":"span","props":{},"children":["05"]},"Công ty sa thải bạn mà không báo trước 30 ngày thì còn phải trả thêm một tháng lương"]},{"tag":"a","props":{"href":"/vi/tip/19-06"},"children":[{"tag":"span","props":{},"children":["06"]},"Công ty chấm dứt hợp đồng sai luật thì tiền bồi thường bằng hai lần mức bồi thường kinh tế"]},{"tag":"a","props":{"href":"/vi/tip/19-07"},"children":[{"tag":"span","props":{},"children":["07"]},"Đừng ký「tự nguyện nghỉ việc vì lý do cá nhân」, ký là mất trắng cả khoản N"]},{"tag":"a","props":{"href":"/vi/tip/19-08"},"children":[{"tag":"span","props":{},"children":["08"]},"Trước khi nghỉ việc thì lưu trước phiếu lương, bản chấm công, hợp đồng lao động, hồ sơ bảo hiểm xã hội và lịch sử trò chuyện"]},{"tag":"a","props":{"href":"/vi/tip/19-09"},"children":[{"tag":"span","props":{},"children":["09"]},"Trước khi vào chỗ có bụi, tiếng ồn, hoá chất thì xem trong hợp đồng đã ghi nguy cơ chưa; ba kỳ khám sức khoẻ nghề nghiệp do đơn vị sắp xếp và bỏ tiền"]},{"tag":"a","props":{"href":"/vi/tip/19-10"},"children":[{"tag":"span","props":{},"children":["10"]},"Tổn thương do bụi, tiếng ồn, chất độc hoá học thì không hồi phục được: đơn vị phải cấp đồ dùng bảo vệ, công việc không có biện pháp bảo vệ thì được từ chối"]},{"tag":"a","props":{"href":"/vi/tip/19-11"},"children":[{"tag":"span","props":{},"children":["11"]},"Bị thương lúc làm việc, hay bị xe đâm trên đường đi làm về: việc đầu tiên là xin xác nhận tai nạn lao động, đơn vị không báo thì bạn tự báo"]},{"tag":"a","props":{"href":"/vi/tip/19-12"},"children":[{"tag":"span","props":{},"children":["12"]},"Đừng tin「leo tới bàn giấy là được coi là tai nạn lao động」: thấy khó chịu đột ngột thì gọi 120 trước, đừng chạy tới chấm công"]},{"tag":"a","props":{"href":"/vi/tip/19-13"},"children":[{"tag":"span","props":{},"children":["13"]},"Đơn vị không đóng bảo hiểm tai nạn lao động cho bạn thì ưu đãi tai nạn lao động vẫn có, và do đơn vị trả đủ theo đúng tiêu chuẩn"]},{"tag":"a","props":{"href":"/vi/tip/19-14"},"children":[{"tag":"span","props":{},"children":["14"]},"Khi tình trạng thương tích đã ổn định thì đi đánh giá năng lực lao động, hạng khuyết tật quy đổi thẳng thành tiền"]},{"tag":"a","props":{"href":"/vi/tip/19-15"},"children":[{"tag":"span","props":{},"children":["15"]},"Phải phân biệt ba khoản tiền khi chết vì tai nạn lao động: tiền trợ cấp mai táng, tiền trợ cấp hưu trí người được nuôi dưỡng, tiền trợ cấp một lần khi chết vì tai nạn lao động"]},{"tag":"a","props":{"href":"/vi/tip/19-16"},"children":[{"tag":"span","props":{},"children":["16"]},"Ở công ty lâu ngày bị bắt nạt, mắng, gây khó, đừng gồng chịu: ghi lại để có chứng cứ, rồi tuỳ tính chất mà khiếu nại, báo công an hoặc đi hoà giải"]},{"tag":"a","props":{"href":"/vi/tip/19-17"},"children":[{"tag":"span","props":{},"children":["17"]},"Lúc nghỉ việc thì xin đơn vị một giấy xác nhận nghỉ việc, ghi rõ thời hạn hợp đồng, ngày nghỉ việc, vị trí và số năm đã làm"]},{"tag":"a","props":{"href":"/vi/tip/19-18"},"children":[{"tag":"span","props":{},"children":["18"]},"Nhận tiền bồi thường khi nghỉ việc thì xem thuế thu nhập cá nhân trước: phần trong 3 mức lương bình quân người lao động của năm trước ở địa phương thì miễn thuế, phần vượt ra tính riêng, không gộp vào thu nhập của năm đó"]},{"tag":"a","props":{"href":"/vi/tip/19-19"},"children":[{"tag":"span","props":{},"children":["19"]},"Đổi thành phố làm việc thì chuyển quan hệ bảo hiểm hưu trí và y tế sang nơi tham gia mới, số năm đóng tiếp tục cộng dồn, đừng hủy bảo hiểm để rút tiền"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"Breadcrumbs"},"children":[{"tag":"a","props":{"href":"/vi/book"},"children":["Khám phá cuốn sách"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/vi/book/19"},"children":["Chương 19"," ·"," ","Đi làm, nghỉ việc và tai nạn lao động"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"19-01"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["01"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["Bằng chứng"," ","A"]}]},{"tag":"h1","props":{"lang":"vi"},"children":["Tiền làm thêm giờ tính theo ba mức 1.5 lần, 2 lần, 3 lần; không trả thì báo thanh tra lao động, quá hạn không trả còn phải cộng thêm 50% đến 100%"]},{"tag":"p","props":{"lang":"vi","className":"life-entry-summary"},"children":["Làm thêm giờ trong ngày thì trả gấp 1.5 lần lương. Ngày nghỉ lễ mà không được bù ngày nghỉ thì gấp 2 lần. Ngày lễ tết theo luật như Tết Nguyên Đán, Tết Nguyên Tiêu, Quốc tế Lao động, Quốc khánh thì gấp 3 lần, và không được lấy ngày nghỉ bù để thay. Công ty không trả thì báo thanh tra lao động. Sau khi bị yêu cầu trả trong thời hạn mà vẫn không trả, công ty còn phải trả thêm từ một nửa đến một lần khoản còn nợ."]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Chi phí"]},{"tag":"p","props":{},"children":["Không tốn tiền. Tiện tay lưu một bản bản chấm điểm giờ ra…"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Lợi ích"]},{"tag":"p","props":{},"children":["Luật quy định giờ làm việc bình thường không quá 8 giờ mỗi ngày, tính trung bình không quá 44 giờ mỗi tuần. Là…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"Đánh dấu: Tiền làm thêm giờ tính theo ba mức 1.5 lần, 2 lần, 3 lần; không trả thì báo thanh tra lao động, quá hạn không trả còn phải cộng thêm 50% đến 100%"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"Hoàn tất"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"Kế hoạch thực hiện"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"Lưu"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Chia sẻ mẹo này"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Ẩn chi tiết"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Chi phí"]},{"tag":"p","props":{},"children":["Không tốn tiền. Tiện tay lưu một bản bản chấm điểm giờ ra vào, lịch trực và đơn xin làm thêm giờ. Tin nhắn phân công việc của sếp trong nhóm chat thì chụp màn hình lưu lại. Chỗ khó là phải nhớ lưu mỗi tháng."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Lợi ích"]},{"tag":"p","props":{},"children":["Luật quy định giờ làm việc bình thường không quá 8 giờ mỗi ngày, tính trung bình không quá 44 giờ mỗi tuần. Làm thêm giờ trong ngày thì thường không quá 1 giờ mỗi ngày. Có lý do đặc biệt phải làm thêm thì không quá 3 giờ mỗi ngày, và cộng lại trong tháng không quá 36 giờ. Tiền làm thêm giờ chia ba mức. Bố trí bạn làm thêm giờ trong ngày thì trả không dưới 150% lương. Bố trí bạn đi làm ngày nghỉ mà không bù được ngày nghỉ thì không dưới 200%. Bố trí bạn đi làm ngày lễ tết theo luật thì không dưới 300%. Riêng mức ngày lễ tết, trong luật không có lựa chọn「lấy ngày nghỉ bù để thay cho tiền」. Đơn vị bố trí làm thêm giờ mà không trả tiền thì bị cơ quan quản lý lao động buộc phải trả đủ trong thời hạn. Quá thời hạn vẫn không trả thì bị buộc phải trả thêm cho người lao động một khoản bồi thường, từ 50% đến 100% trên số tiền phải trả, tính ngoài khoản còn nợ (toàn quốc)"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Nguồn gốc"]},{"tag":"p","props":{"className":"life-citations"},"children":["全国人大常委会 (2018). 劳动法（2018 年第二次修正，第三十六、四十一、四十三、四十四条）. ",{"tag":"a","props":{"href":"https://www.samr.gov.cn/zw/zfxxgk/fdzdgknr/bgt/art/2023/art_d9aa750028b14b99a776cb93726a360d.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.samr.gov.cn/zw/zfxxgk/fdzdgknr/bgt/art/2023/art_d9aa750028b14b99a776cb93726a360d.html"]},"（国家市场监督管理总局刊登）；全国人大常委会 (2007). 劳动合同法（第八十五条第三项）. ",{"tag":"a","props":{"href":"http://www.gov.cn/gongbao/content/2007/content_711013.htm","target":"_blank","rel":"noopener noreferrer"},"children":["http://www.gov.cn/gongbao/content/2007/content_711013.htm"]}]},{"tag":"a","props":{"href":"https://www.samr.gov.cn/zw/zfxxgk/fdzdgknr/bgt/art/2023/art_d9aa750028b14b99a776cb93726a360d.html","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Liên kết mở nguồn"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Ghi chú sách"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["Ngày nghỉ và ngày lễ tết theo luật phải tính riêng. Ngày lễ tết theo luật cả năm chỉ có Tết Nguyên Đán, Tết Nguyên Tiêu, Quốc tế Lao động, Quốc khánh và mấy ngày lễ hợp pháp khác. Ngày nghỉ liên tục do điều chỉnh lịch nghỉ để bù thì tính là ngày nghỉ, trả 200%. Hai câu「công ty quy định làm thêm giờ phải được duyệt」và「tôi tự nguyện ở lại」không có nghĩa công ty được phép không trả tiền, nhưng chúng làm bạn khó lấy bằng chứng hơn, nên phải giữ lại lệnh phân công và hồ sơ duyệt. Công ty muốn áp dụng hai chế độ giờ làm đặc biệt là tính giờ tổng hợp và giờ không xác định thì phải được cơ quan quản lý lao động chấp thuận trước, không tự quyết được. Thời hiệu khởi kiện khi còn tranh cãi xem mục 19 ở phần 8."]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Ghi chú của tôi"]},{"tag":"button","props":{"type":"button"},"children":["Viết một lời nhắc cho chính bạn…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"span","props":{},"children":[]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/vi/tip/19-02"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Tiếp theo"]},"Nghỉ phép năm tính theo thâm niên cộng dồn: 5, 10, 15 ngày; nghỉ không được thì đổi thành tiền bằng 300% lương ngày"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["Thêm trong chủ đề này"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/19-03"},"children":[{"tag":"strong","props":{},"children":["Thời gian thử việc có trần theo luật, lương không được dưới 80%, và chỉ được thỏa thuận một lần"]},{"tag":"span","props":{},"children":["Hợp đồng dưới hoặc bằng 1 năm thì thời gian thử việc tối đa 1 tháng. …"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/19-04"},"children":[{"tag":"strong","props":{},"children":["Bị sa thải thì tính rõ N trước: cứ mỗi năm làm đủ một năm thì một tháng lương, chưa đủ sáu tháng thì tính nửa tháng"]},{"tag":"span","props":{},"children":["Tiền bồi thường kinh tế mà công ty phải trả cho bạn khi bị sa thải tí…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/19-05"},"children":[{"tag":"strong","props":{},"children":["Công ty sa thải bạn mà không báo trước 30 ngày thì còn phải trả thêm một tháng lương"]},{"tag":"span","props":{},"children":["Công ty sa thải bạn vì sau khi ốm không làm nổi, không làm nổi công v…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/19-06"},"children":[{"tag":"strong","props":{},"children":["Công ty chấm dứt hợp đồng sai luật thì tiền bồi thường bằng hai lần mức bồi thường kinh tế"]},{"tag":"span","props":{},"children":["Nếu công ty chấm dứt hợp đồng sai luật thì tiền bồi thường gấp đôi mứ…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/19-07"},"children":[{"tag":"strong","props":{},"children":["Đừng ký「tự nguyện nghỉ việc vì lý do cá nhân」, ký là mất trắng cả khoản N"]},{"tag":"span","props":{},"children":["Ký xác nhận「tự nguyện nghỉ việc vì lý do cá nhân」thì bồi thường kinh …"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/19-08"},"children":[{"tag":"strong","props":{},"children":["Trước khi nghỉ việc thì lưu trước phiếu lương, bản chấm công, hợp đồng lao động, hồ sơ bảo hiểm xã hội và lịch sử trò chuyện"]},{"tag":"span","props":{},"children":["Ở Trung Quốc, tranh chấp sa thải, giảm lương do đơn vị chứng minh, nh…"]}]}]}]},{"tag":"a","props":{"className":"life-text-link","href":"/vi/book/19"},"children":["Đọc toàn bộ chủ đề: Đi làm, nghỉ việc và tai nạn lao động"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"15","height":"15","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]}]}]},{"tag":"nav","props":{"className":"life-tabbar","aria-label":"Điều hướng chính"},"children":[{"tag":"a","props":{"className":"","href":"/vi/book"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"21","height":"21","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-book-open","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M12 7v14"},"children":[]},{"tag":"path","props":{"d":"M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z"},"children":[]}]},{"tag":"span","props":{},"children":["Sách"]}]},{"tag":"a","props":{"className":"","href":"/vi/top-50"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"21","heigh