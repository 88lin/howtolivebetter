e","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-up-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M7 7h10v10"},"children":[]},{"tag":"path","props":{"d":"M7 17 17 7"},"children":[]}]}]}]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/ru/book/06"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"К содержанию"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["Перечень вредных средств"]},{"tag":"div","props":{"data-ad-dock-host":"true"},"children":[]},{"tag":"nav","props":{"aria-label":"Советы главы"},"children":[{"tag":"a","props":{"href":"/ru/tip/06-01"},"children":[{"tag":"span","props":{},"children":["01"]},"Не стоит принимать поливитамины ради долголетия или профилактики сердечно-сосудистых заболеваний"]},{"tag":"a","props":{"href":"/ru/tip/06-02"},"children":[{"tag":"span","props":{},"children":["02"]},"Не стоит принимать обычное рыбье масло ради профилактики сердечно-сосудистых заболеваний"]},{"tag":"a","props":{"href":"/ru/tip/06-03"},"children":[{"tag":"span","props":{},"children":["03"]},"Не стоит давать витамин D людям, у которых его уровень в норме, ради долголетия"]},{"tag":"a","props":{"href":"/ru/tip/06-04"},"children":[{"tag":"span","props":{},"children":["04"]},"Не стоит принимать антиоксидантные добавки ради профилактики рака (бета-каротин, витамин E, витамин A)"]},{"tag":"a","props":{"href":"/ru/tip/06-05"},"children":[{"tag":"span","props":{},"children":["05"]},"Не стоит рассчитывать на глюкозамин и хондроитин при лечении артрита коленного сустава"]},{"tag":"a","props":{"href":"/ru/tip/06-06"},"children":[{"tag":"span","props":{},"children":["06"]},"Не стоит использовать витамин C для профилактики простуды"]},{"tag":"a","props":{"href":"/ru/tip/06-07"},"children":[{"tag":"span","props":{},"children":["07"]},"Не стоит делать себе «полный ПЭТ-КТ» или «панель онкомаркеров», если у вас нет симптомов"]},{"tag":"a","props":{"href":"/ru/tip/06-08"},"children":[{"tag":"span","props":{},"children":["08"]},"Не стоит рассчитывать, что трекеры активности помогут вам похудеть"]},{"tag":"a","props":{"href":"/ru/tip/06-09"},"children":[{"tag":"span","props":{},"children":["09"]},"Не стоит переплачивать за органические продукты ради «большего здоровья»"]},{"tag":"a","props":{"href":"/ru/tip/06-10"},"children":[{"tag":"span","props":{},"children":["10"]},"Не стоит тратить большие деньги на БАДы, пастообразные смеси и пищевые добавки для «укрепления здоровья»"]},{"tag":"a","props":{"href":"/ru/tip/06-11"},"children":[{"tag":"span","props":{},"children":["11"]},"Не стоит долго принимать пробиотики при отсутствии проблем с кишечником"]},{"tag":"a","props":{"href":"/ru/tip/06-12"},"children":[{"tag":"span","props":{},"children":["12"]},"Не стоит заставлять себя принимать холодный душ ради «укрепления иммунитета»"]},{"tag":"a","props":{"href":"/ru/tip/06-13"},"children":[{"tag":"span","props":{},"children":["13"]},"Не стоит покупать продукты для детоксикации, очищения кишечника, энзимные добавки или щелочную воду"]},{"tag":"a","props":{"href":"/ru/tip/06-14"},"children":[{"tag":"span","props":{},"children":["14"]},"Не стоит заставлять себя пить воду лишь ради достижения цели «8 стаканов в день»"]},{"tag":"a","props":{"href":"/ru/tip/06-15"},"children":[{"tag":"span","props":{},"children":["15"]},"Не тратьте деньги на гадания, Таро или астрологию, чтобы принимать решения"]},{"tag":"a","props":{"href":"/ru/tip/06-16"},"children":[{"tag":"span","props":{},"children":["16"]},"Не стоит покупать очки с защитой от синего света, чтобы «охранять зрение», и не верьте утверждениям, будто «после нескольких месяцев работы за экраном зрение испортится». Однако сильная боль, отёчность и покраснение глаз — это повод для срочного обращения к врачу"]},{"tag":"a","props":{"href":"/ru/tip/06-17"},"children":[{"tag":"span","props":{},"children":["17"]},"Не стоит рассматривать донорство крови как способ укрепить здоровье: утверждения о «детоксикации, снижении уровня холестерина и профилактике инфаркта» не подтверждены рандомизированными исследованиями, а частое донорство действительно приводит к дефициту железа"]},{"tag":"a","props":{"href":"/ru/tip/06-18"},"children":[{"tag":"span","props":{},"children":["18"]},"Не стоит полагаться на стандартные пакеты медосмотров для профилактики — достаточно проводить те обследования, эффективность которых подтверждена данными, с учётом возраста и пола"]},{"tag":"a","props":{"href":"/ru/tip/06-19"},"children":[{"tag":"span","props":{},"children":["19"]},"Не стоит принимать препараты для снижения уровня мочевой кислоты только потому, что анализы показали её повышение, а боли никогда не было"]},{"tag":"a","props":{"href":"/ru/tip/06-20"},"children":[{"tag":"span","props":{},"children":["20"]},"Не стоит делать профилактическую операцию по удалению желчного пузыря только потому, что при обследовании обнаружили камни, а боли никогда не было"]},{"tag":"a","props":{"href":"/ru/tip/06-21"},"children":[{"tag":"span","props":{},"children":["21"]},"Не стоит отказываться от кальция ради профилактики камней в почках"]},{"tag":"a","props":{"href":"/ru/tip/06-22"},"children":[{"tag":"span","props":{},"children":["22"]},"Не стоит покупать кристаллы, браслеты или фигурки пи-сюй ради «улучшения удачи», «привлечения богатства» или «помощи в саморазвитии»"]},{"tag":"a","props":{"href":"/ru/tip/06-23"},"children":[{"tag":"span","props":{},"children":["23"]},"Не стоит рассчитывать, что покупки улучшат настроение или самооценку"]},{"tag":"a","props":{"href":"/ru/tip/06-24"},"children":[{"tag":"span","props":{},"children":["24"]},"Не тратьте лишние деньги на новую квартиру, машину или круг общения лишь ради того, чтобы «подняться в социальном статусе»"]},{"tag":"a","props":{"href":"/ru/tip/06-25"},"children":[{"tag":"span","props":{},"children":["25"]},"Не верьте утверждению «воля — это как мышца, которая быстро устает»"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/ru/tip/06-26","data-status":"active"},"children":[{"tag":"span","props":{},"children":["26"]},"Не стоит рассчитывать, что завтрак или режим питания 16:8 помогут вам контролировать вес — выбирайте тот график, который сможете соблюдать долгое время"]},{"tag":"a","props":{"href":"/ru/tip/06-27"},"children":[{"tag":"span","props":{},"children":["27"]},"Не верьте в то, что «мастурбация вредит здоровью» или что «нужно воздерживаться, чтобы стать лучше»; на самом деле важно лишь то, не мешает ли это вашему сну, работе и отношениям"]},{"tag":"a","props":{"href":"/ru/tip/06-28"},"children":[{"tag":"span","props":{},"children":["28"]},"Не тратьте деньги на «исправление сексуальной ориентации» или «лечение гомосексуальности», и не отправляйте туда своих близких"]},{"tag":"a","props":{"href":"/ru/tip/06-29"},"children":[{"tag":"span","props":{},"children":["29"]},"Не рассчитывайте предотвратить боль в пояснице «правильной техникой подъема» и курсами: уменьшайте вес и число подъемов, регулярно занимайтесь физической нагрузкой"]},{"tag":"a","props":{"href":"/ru/tip/06-30"},"children":[{"tag":"span","props":{},"children":["30"]},"Не рассчитывайте, что большие дозы кальция и костный бульон ускорят сращение перелома"]},{"tag":"a","props":{"href":"/ru/tip/06-31"},"children":[{"tag":"span","props":{},"children":["31"]},"Не стоит полагаться на ИИ-чат-бот в одиночку, когда нужно оценить болезнь или юридический вопрос: прежде чем идти к врачу, в суд или тратить большие деньги, найдите первоисточник, на который он ссылается, и проверьте по оригиналу"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"Навигация"},"children":[{"tag":"a","props":{"href":"/ru/book"},"children":["Книга"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/ru/book/06"},"children":["Глава 6"," ·"," ","Перечень вредных средств"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"06-26"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["26"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["Доказательства"," ","A"]}]},{"tag":"h1","props":{"lang":"ru"},"children":["Не стоит рассчитывать, что завтрак или режим питания 16:8 помогут вам контролировать вес — выбирайте тот график, который сможете соблюдать долгое время"]},{"tag":"p","props":{"lang":"ru","className":"life-entry-summary"},"children":["Согласно популярным представлениям, отказ от завтрака приводит к перееданию в обед и ужине, в итоге общая калорийность дня возрастает. Однако в исследованиях всё иначе: люди, пропускающие завтрак, в среднем потребляют на 200 ккал меньше в сутки и имеют чуть меньший вес. При этом режим 16:8 не даёт большей потери веса по сравнению с простым ограничением калорий. Однако у тех, кто долгое время не завтракает, риск сердечно-сосудистых заболеваний выше примерно на 17%, а влияния на общую смертность не наблюдается."]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Затраты"]},{"tag":"p","props":{},"children":["Бесплатно. Вы экономите те немногие усилия, которые тратит…"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Польза"]},{"tag":"p","props":{},"children":["Начнём с утверждения, будто отказ от завтрака приводит к перееданию. В одном метаанализе объединили данные 13…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"Отметить: Не стоит рассчитывать, что завтрак или режим питания 16:8 помогут вам контролировать вес — выбирайте тот график, который сможете соблюдать долгое время"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"Сделано"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"В планах"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"В избранное"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Поделиться советом"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Скрыть подробности"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Затраты"]},{"tag":"p","props":{},"children":["Бесплатно. Вы экономите те немногие усилия, которые тратитесь на поддержание определённого времени приёма пищи."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Польза"]},{"tag":"p","props":{},"children":["Начнём с утверждения, будто отказ от завтрака приводит к перееданию. В одном метаанализе объединили данные 13 рандомизированных исследований. Люди, которые ели завтрак, в среднем потребляли на 259,79 ккал больше в день (95% ДИ 78,87–440,71), а их вес был выше примерно на 0,44 кг (ДИ 0,07–0,82). Однако те, кто не завтракал, не компенсировали этот дефицит в обед и ужин. Во всех этих исследованиях наблюдение было недолгим: в среднем 7 недель для веса и 2 недели для калорийности. Теперь рассмотрим режим 16:8, при котором пищу можно употреблять лишь в определённые часы. В одном исследовании 116 людей с избыточным весом в течение 12 недель соблюдали режим питания с 12 до 20 часов; разница в весе по сравнению с группой, принимавшей пищу три раза в день, составила −0,26 кг (ДИ −1,30 до 0,78), что не является статистически значимым. В другом исследовании в Гуанчжоу у 139 пациентов с ожирением в течение года наблюдали, что при ограничении калорий и соблюдении режима 16:8 потеря веса была на 1,8 кг больше (−4,0 до 0,4), однако это тоже не считается значимым различием. Наконец, рассмотрим долгосрочные последствия отказа от завтрака. В обобщённых данных по 2,38 млн человек выяснилось, что у тех, кто не завтракает, риск сердечно-сосудистых заболеваний выше примерно на 17% (ОР 1,17, ДИ 1,09–1,26), а риск смерти от этих болезней — примерно на 49% (ОР 1,49, ДИ 1,20–1,84). Однако эти данные получены из наблюдательных исследований без разделения групп. В одном из исследований с 17–23-летним наблюдением относительный риск смерти от всех причин составил 1,19 (ДИ 0,99–1,42), что не выходит за пределы статистической погрешности."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Первоисточники"]},{"tag":"p","props":{"className":"life-citations"},"children":["Sievert K, Hussain SM, Page MJ, 等 (2019). Effect of breakfast on weight and energy intake: systematic review and meta-analysis of randomised controlled trials. BMJ. ",{"tag":"a","props":{"href":"https://doi.org/10.1136/bmj.l42","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1136/bmj.l42"]},"；Lowe DA, Wu N, Rohdin-Bibby L, 等 (2020). Effects of Time-Restricted Eating on Weight Loss and Other Metabolic Parameters in Women and Men With Overweight and Obesity. JAMA Internal Medicine. ",{"tag":"a","props":{"href":"https://doi.org/10.1001/jamainternmed.2020.4153","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1001/jamainternmed.2020.4153"]},"；Liu D, Huang Y, Huang C, 等 (2022). Calorie Restriction with or without Time-Restricted Eating in Weight Loss. New England Journal of Medicine. ",{"tag":"a","props":{"href":"https://doi.org/10.1056/NEJMoa2114833","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1056/NEJMoa2114833"]},"；Zhang H, Zhang S, Liu Y, 等 (2025). The association between skipping breakfast and cardiovascular disease: a meta analysis. Frontiers in Cardiovascular Medicine. ",{"tag":"a","props":{"href":"https://doi.org/10.3389/fcvm.2025.1565806","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.3389/fcvm.2025.1565806"]},"；Rong S, Snetselaar LG, Xu G, 等 (2019). Association of Skipping Breakfast With Cardiovascular and All-Cause Mortality. Journal of the American College of Cardiology. ",{"tag":"a","props":{"href":"https://doi.org/10.1016/j.jacc.2019.01.065","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1016/j.jacc.2019.01.065"]},"；Fernandes-Alves D, Teixeira GP, Guimarães KC, Crispim CA (2026). Systematic Review and Meta-analysis of Randomized Clinical Trials Comparing Time-Restricted Eating With and Without Caloric Restriction for Weight Loss. Nutrition Reviews. ",{"tag":"a","props":{"href":"https://doi.org/10.1093/nutrit/nuaf053","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1093/nutrit/nuaf053"]},"；Sun T, Zhang L, Lu Y, 等 (2024). Non-linear relationship between the first meal time of the day and gallstone incidence in American adults. Frontiers in Nutrition. ",{"tag":"a","props":{"href":"https://doi.org/10.3389/fnut.2024.1521707","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.3389/fnut.2024.1521707"]},"；Liu T, Wang Y, Wang X, 等 (2023). Habitually Skipping Breakfast Is Associated with the Risk of Gastrointestinal Cancers: Evidence from the Kailuan Cohort Study. Journal of General Internal Medicine. ",{"tag":"a","props":{"href":"https://doi.org/10.1007/s11606-023-08094-7","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1007/s11606-023-08094-7"]}]},{"tag":"a","props":{"href":"https://doi.org/10.1136/bmj.l42","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Открыть источник"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Примечание автора"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["Вопрос остаётся спорным. Указанный риск в 17% для сердечно-сосудистых заболеваний получен из наблюдательных исследований без разделения групп; к тому же люди, не завтракающие, чаще курят, злоупотребляют алкоголем, ведут малоподвижный образ жизни и имеют более низкий доход, что трудно полностью учесть в расчётах. Поэтому неясно, какая часть этого риска связана именно с отказом от завтрака. Что касается общей смертности, то полученный показатель 1,19 находится в пределах погрешности. Режим 16:8 также вызывает споры: в метаанализе 30 исследований с участием 1341 человека выяснилось, что при одинаковом потреблении калорий в группе с ограниченным временем питания потеря веса оказалась на 1,46 кг больше (−2,65 до −0,26), однако при этом терялось на 0,41 кг больше мышечной массы. Однако большинство этих исследований были недолгими; в самом продолжительном и строгом исследовании на 12 месяцев разницы в весе не нашли. Длительный голод также может влиять на состояние желчного пузыря: в одном исследовании с участием 6 547 человек выяснилось, что чем позже принимается первая трапеза, тем выше риск образования камней — при сдвиге с 9 до 14 часов риск возрастает примерно на 49% (ОР 1,49, ДИ 1,24–1,77). Вероятно, это связано с тем, что длительное нахождение желчи в пузыре способствует её кристаллизации. Однако это наблюдательное исследование не доказывает причинно-следственную связь — возможно, проблемы с желчным пузырём заставляют человека позже принимать пищу. В китайской наблюдательной группе «Кайлуань» у 369 пациентов с раком ЖКТ за 5,6 лет выяснилось, что у тех, кто не завтракает, риск колоректального рака выше в 2,32 раза (ДИ 1,34–4,01), а риск рака желчного пузыря и внепечёночных желчных протоков — в 5,43 раза (ДИ 1,34–21,93). Однако широкий диапазон ДИ указывает на малое количество случаев, поэтому это лишь предположение. В целом, с точки зрения контроля веса, время приёма пищи играет незначительную роль, поэтому не стоит тратить на это силы. Что касается долгосрочного отказа от завтрака, то имеющиеся данные лишь показывают корреляцию, но не доказывают причинно-следственную связь; однако тенденция в них неблагоприятная, поэтому для большей безопасности лучше завткать. Не стоит рассчитывать, что это поможет похудеть. Основными причинами гастрита и язвы желудка являются бактерия Helicobacter pylori и длительный приём обезболивающих; подробнее об этом в разделе 1, пункт 23. Если при обследовании обнаружили камни в желчном пузыре, но болей нет, см. пункт 20 этого раздела — в таких случаях хирургическое вмешательство не требуется. Для эффективного контроля веса важнее то, что и сколько вы едите; об этом подробно в разделе 2, пункты 27, 28 и 32. Для людей с диабетом, принимающих сахароснижающие препараты или находящихся в периоде беременности пропуск приёма пищи может привести к гипогликемии, поэтому следуйте рекомендациям врача. Экстремальное голодание и вызывание рвоты — это отдельные проблемы; об этом в разделе 28, пункт 1."]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Моя заметка"]},{"tag":"button","props":{"type":"button"},"children":["Запишите напоминание…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/ru/tip/06-25"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Предыдущий"]},"Не верьте утверждению «воля — это как мышца, которая быстро устает»"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/ru/tip/06-27"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Следующий"]},"Не верьте в то, что «мастурбация вредит здоровью» или что «нужно воздерживаться, чтобы стать лучше»; на самом деле важно лишь то, не мешает ли это вашему сну, работе и отношениям"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["Другие советы по этой теме"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/06-22"},"children":[{"tag":"strong","props":{},"children":["Не стоит покупать кристаллы, браслеты или фигурки пи-сюй ради «улучшения удачи», «привлечения богатства» или «помощи в саморазвитии»"]},{"tag":"span","props":{},"children":["Утверждения вроде «ношение этих предметов меняет судьбу, привлекает б…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/06-23"},"children":[{"tag":"strong","props":{},"children":["Не стоит рассчитывать, что покупки улучшат настроение или самооценку"]},{"tag":"span","props":{},"children":["Чем сильнее человек придаёт значение деньгам и материальным вещам, те…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/06-24"},"children":[{"tag":"strong","props":{},"children":["Не тратьте лишние деньги на новую квартиру, машину или круг общения лишь ради того, чтобы «подняться в социальном статусе»"]},{"tag":"span","props":{},"children":["Если сравнивать людей с одинаковым доходом, то чем выше доход у сосед…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/06-28"},"children":[{"tag":"strong","props":{},"children":["Не тратьте деньги на «исправление сек