cle-user-round","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M18 20a6 6 0 0 0-12 0"},"children":[]},{"tag":"circle","props":{"cx":"12","cy":"10","r":"4"},"children":[]},{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},{"tag":"span","props":{},"children":["Đăng nhập để đồng bộ hóa"]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/vi/book/26"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"Quay lại mục lục"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["Làm một trang web hoặc nền tảng: giấy phép, đăng ký, máy chủ"]},{"tag":"nav","props":{"aria-label":"Các mục trong chương"},"children":[{"tag":"a","props":{"href":"/vi/tip/26-01"},"children":[{"tag":"span","props":{},"children":["01"]},"Để tiền không đi vào tài khoản của nền tảng rồi mới chuyển cho người bán, hãy cho tiền đi thẳng qua tổ chức thanh toán được cấp phép"]},{"tag":"a","props":{"href":"/vi/tip/26-02"},"children":[{"tag":"span","props":{},"children":["02"]},"Trang web thu phí thì cần giấy phép, bên tự bán hàng không cho người khác tham gia thì không cần, bên trung gian kết nối giao dịch là loại giấy phép khác, trang web miễn phí chỉ cần đăng ký khai báo"]},{"tag":"a","props":{"href":"/vi/tip/26-03"},"children":[{"tag":"span","props":{},"children":["03"]},"Phát trực tiếp thì cần giấy phép kinh doanh văn hóa trên mạng, còn giấy phép chương trình nghe nhìn thì công ty tư nhân gần như không xin được"]},{"tag":"a","props":{"href":"/vi/tip/26-04"},"children":[{"tag":"span","props":{},"children":["04"]},"Máy chủ đặt trong nước thì phải đăng ký khai báo, và nhà cung cấp dịch vụ truy cập phải tự có giấy phép viễn thông giá trị gia tăng"]},{"tag":"a","props":{"href":"/vi/tip/26-05"},"children":[{"tag":"span","props":{},"children":["05"]},"Cho người dùng lên bán hàng thì nền tảng phải kiểm tra đăng ký, báo thông tin và lưu giữ ba năm"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/vi/tip/26-06","data-status":"active"},"children":[{"tag":"span","props":{},"children":["06"]},"Nội dung người dùng đăng lên là bạn phải quản: có cơ chế duyệt, có cửa sổ báo việc, thấy nội dung vi phạm thì dừng truyền ngay và báo cáo"]},{"tag":"a","props":{"href":"/vi/tip/26-07"},"children":[{"tag":"span","props":{},"children":["07"]},"Cung cấp dịch vụ đăng thông tin và nhắn tin tức thì phải yêu cầu người dùng cung cấp thông tin danh tính thật"]},{"tag":"a","props":{"href":"/vi/tip/26-08"},"children":[{"tag":"span","props":{},"children":["08"]},"Không mở phát trực tiếp cho người chưa đủ 16 tuổi, tiền thưởng xử lý theo bậc tuổi"]},{"tag":"a","props":{"href":"/vi/tip/26-09"},"children":[{"tag":"span","props":{},"children":["09"]},"Nhận được thông báo vi phạm thì phải xử lý kịp thời, chuyển bản giải trình mà sau 15 ngày không có động tĩnh thì khôi phục lại"]},{"tag":"a","props":{"href":"/vi/tip/26-10"},"children":[{"tag":"span","props":{},"children":["10"]},"Đừng tùy tiện đặt thông tin người dùng ra nước ngoài, việc chuyển dữ liệu ra nước ngoài có điều kiện luật định và có ngưỡng số người"]},{"tag":"a","props":{"href":"/vi/tip/26-11"},"children":[{"tag":"span","props":{},"children":["11"]},"Chọn máy chủ thì xem sập có chịu được không, xem có ai trực vận hành không, cuối cùng mới so giá"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"Breadcrumbs"},"children":[{"tag":"a","props":{"href":"/vi/book"},"children":["Khám phá cuốn sách"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/vi/book/26"},"children":["Chương 26"," ·"," ","Làm một trang web hoặc nền tảng: giấy phép, đăng ký, máy chủ"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"26-06"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["06"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["Bằng chứng"," ","A"]}]},{"tag":"h1","props":{"lang":"vi"},"children":["Nội dung người dùng đăng lên là bạn phải quản: có cơ chế duyệt, có cửa sổ báo việc, thấy nội dung vi phạm thì dừng truyền ngay và báo cáo"]},{"tag":"p","props":{"lang":"vi","className":"life-entry-summary"},"children":["Người dùng đăng cái gì, xảy ra chuyện thì nền tảng chịu trách nhiệm. Bạn phải dựng được bộ quy chế này: đăng ký, duyệt bài đăng, duyệt bình luận, tuần tra hằng ngày, xử lý khi có sự cố. Đặt cửa sổ báo việc ở chỗ dễ thấy trên trang. Thấy thông tin vi phạm thì dừng truyền ngay, lưu bản ghi đầy đủ, báo cơ quan có thẩm quyền. Không làm thì phạt tiền 5 vạn đến 50 vạn tệ, nghiêm trọng hơn thì phạt nặng hơn."]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Chi phí"]},{"tag":"p","props":{},"children":["Phải tốn tiền thuê người duyệt nội dung, đây là khoản chi…"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Lợi ích"]},{"tag":"p","props":{},"children":["Quy chế nói nền tảng「应当履行信息内容管理主体责任」— phải chịu trách nhiệm chính về quản lý nội dung thông tin, nội dung ngườ…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"Đánh dấu: Nội dung người dùng đăng lên là bạn phải quản: có cơ chế duyệt, có cửa sổ báo việc, thấy nội dung vi phạm thì dừng truyền ngay và báo cáo"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"Hoàn tất"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"Kế hoạch thực hiện"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"Lưu"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Chia sẻ mẹo này"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Ẩn chi tiết"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Chi phí"]},{"tag":"p","props":{},"children":["Phải tốn tiền thuê người duyệt nội dung, đây là khoản chi lớn nhất và lâu dài nhất của nền tảng. Cửa sổ báo việc và bản ghi của mỗi lần xử lý đều phải để lại dấu vết. Chỗ khó là ngày nào cũng phải có người trực, ngừng một ngày là có thể xảy ra sự cố."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Lợi ích"]},{"tag":"p","props":{},"children":["Quy chế nói nền tảng「应当履行信息内容管理主体责任」— phải chịu trách nhiệm chính về quản lý nội dung thông tin, nội dung người dùng đăng lên do nền tảng tự chịu trách nhiệm. Cụ thể phải「健全用户注册、账号管理、信息发布审核、跟帖评论审核、版面页面生态管理、实时巡查、应急处置和网络谣言、黑色产业链信息处置等制度」— xây dựng và hoàn thiện các quy chế về đăng ký người dùng, quản lý tài khoản, duyệt thông tin đăng lên, duyệt bình luận và bài trả lời, quản lý môi trường trang, tuần tra theo thời gian thực, xử lý khẩn cấp, và xử lý thông tin tin đồn trên mạng, chuỗi sản xuất đen. Từ đăng ký, đăng bài, bình luận, đến tuần tra hằng ngày và xử lý sự cố, mỗi khâu phải có quy tắc viết ra. Ngoài ra còn phải「应当在显著位置设置便捷的投诉举报入口」— đặt cửa sổ khiếu nại và báo việc thuận tiện ở vị trí dễ thấy, nút báo việc phải để ở chỗ người dùng nhìn thấy và bấm được ngay. Thấy thông tin vi phạm thì「应当依法立即采取处置措施，保存有关记录，并向有关主管部门报告」— phải xử lý ngay theo pháp luật, lưu các bản ghi liên quan và báo cơ quan có thẩm quyền. Luật An ninh mạng nói cụ thể hơn. Nguyên văn là「发现法律、行政法规禁止发布或者传输的信息的，应当立即停止传输该信息，采取消除等处置措施，防止信息扩散，保存有关记录，并向有关主管部门报告」— thấy thông tin mà luật và pháp lệnh hành chính cấm đăng hoặc truyền thì phải dừng truyền ngay, thực hiện biện pháp xử lý như xóa bỏ để ngăn thông tin lan rộng, lưu các bản ghi liên quan và báo cơ quan có thẩm quyền. Không làm thì bị buộc sửa, bị cảnh cáo, bị công bố, có thể còn phạt tiền 5 vạn đến 50 vạn tệ. Không chịu sửa, hoặc tình tiết nghiêm trọng, thì phạt tiền 50 vạn đến 200 vạn tệ, còn có thể bị buộc đình chỉ kinh doanh để chỉnh phục, đóng cửa trang web hoặc ứng dụng, thu hồi giấy phép hoặc giấy chứng nhận đăng ký kinh doanh. Người trực tiếp chịu trách nhiệm bị phạt riêng 5 vạn đến 20 vạn tệ (toàn quốc)"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Nguồn gốc"]},{"tag":"p","props":{"className":"life-citations"},"children":["国家互联网信息办公室 (2019). 网络信息内容生态治理规定（网信办令第 5 号，第八、九、十、十六、三十七条）. ",{"tag":"a","props":{"href":"http://www.cac.gov.cn/2019-12/20/c_1578375159509309.htm","target":"_blank","rel":"noopener noreferrer"},"children":["http://www.cac.gov.cn/2019-12/20/c_1578375159509309.htm"]}," ; 全国人大常委会 (2025). 网络安全法（2025 年修正，2026 年 1 月 1 日施行，第四十九、六十九条）. ",{"tag":"a","props":{"href":"https://www.cac.gov.cn/2025-12/29/c_1768735112911946.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.cac.gov.cn/2025-12/29/c_1768735112911946.htm"]}," ; 国务院 (2000). 互联网信息服务管理办法（第十五、十六、二十三条）. ",{"tag":"a","props":{"href":"https://www.gov.cn/gongbao/content/2011/content_1860864.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/gongbao/content/2011/content_1860864.htm"]}]},{"tag":"a","props":{"href":"http://www.cac.gov.cn/2019-12/20/c_1578375159509309.htm","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Liên kết mở nguồn"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Ghi chú sách"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["Quy tắc duyệt không cần tự nghĩ, cứ chép theo. Chín loại nội dung không được đăng, Điều 15 của Quy định quản lý dịch vụ thông tin Internet liệt kê rõ mồn một. Người phát trực tiếp còn phải làm thêm ba việc: phải「建立直播内容审核平台」— dựng nền tảng duyệt nội dung phát trực tiếp; phải cắt được một buổi đang phát bất cứ lúc nào, điều luật gọi việc đó là「即时阻断」; và phải lưu nội dung phát trực tiếp cùng nhật ký trong 60 ngày. Tư liệu video của biểu diễn trên mạng cũng không được ít hơn 60 ngày"]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Ghi chú của tôi"]},{"tag":"button","props":{"type":"button"},"children":["Viết một lời nhắc cho chính bạn…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/vi/tip/26-05"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Trước"]},"Cho người dùng lên bán hàng thì nền tảng phải kiểm tra đăng ký, báo thông tin và lưu giữ ba năm"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/vi/tip/26-07"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Tiếp theo"]},"Cung cấp dịch vụ đăng thông tin và nhắn tin tức thì phải yêu cầu người dùng cung cấp thông tin danh tính thật"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["Thêm trong chủ đề này"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/26-02"},"children":[{"tag":"strong","props":{},"children":["Trang web thu phí thì cần giấy phép, bên tự bán hàng không cho người khác tham gia thì không cần, bên trung gian kết nối giao dịch là loại giấy phép khác, trang web miễn phí chỉ cần đăng ký khai báo"]},{"tag":"span","props":{},"children":["Trang web thu tiền người dùng thì phải xin giấy phép kinh doanh dịch …"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/26-03"},"children":[{"tag":"strong","props":{},"children":["Phát trực tiếp thì cần giấy phép kinh doanh văn hóa trên mạng, còn giấy phép chương trình nghe nhìn thì công ty tư nhân gần như không xin được"]},{"tag":"span","props":{},"children":["Phát trực tiếp hay thuyết minh trò chơi thì cần giấy phép kinh doanh …"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/26-04"},"children":[{"tag":"strong","props":{},"children":["Máy chủ đặt trong nước thì phải đăng ký khai báo, và nhà cung cấp dịch vụ truy cập phải tự có giấy phép viễn thông giá trị gia tăng"]},{"tag":"span","props":{},"children":["Máy chủ đặt trong nước thì trước khi mở trang web phải đăng ký khai b…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/26-08"},"children":[{"tag":"strong","props":{},"children":["Không mở phát trực tiếp cho người chưa đủ 16 tuổi, tiền thưởng xử lý theo bậc tuổi"]},{"tag":"span","props":{},"children":["Người chưa đủ 16 tuổi không được đăng ký tài khoản phát trực tiếp ở c…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/26-09"},"children":[{"tag":"strong","props":{},"children":["Nhận được thông báo vi phạm thì phải xử lý kịp thời, chuyển bản giải trình mà sau 15 ngày không có động tĩnh thì khôi phục lại"]},{"tag":"span","props":{},"children":["Có người gửi thông báo vi phạm kèm bằng chứng ban đầu thì bạn phải kị…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/26-10"},"children":[{"tag":"strong",