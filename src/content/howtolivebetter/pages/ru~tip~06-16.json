"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"18","height":"18","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-up-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M7 7h10v10"},"children":[]},{"tag":"path","props":{"d":"M7 17 17 7"},"children":[]}]}]}]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/ru/book/06"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"К содержанию"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["Перечень вредных средств"]},{"tag":"div","props":{"data-ad-dock-host":"true"},"children":[]},{"tag":"nav","props":{"aria-label":"Советы главы"},"children":[{"tag":"a","props":{"href":"/ru/tip/06-01"},"children":[{"tag":"span","props":{},"children":["01"]},"Не стоит принимать поливитамины ради долголетия или профилактики сердечно-сосудистых заболеваний"]},{"tag":"a","props":{"href":"/ru/tip/06-02"},"children":[{"tag":"span","props":{},"children":["02"]},"Не стоит принимать обычное рыбье масло ради профилактики сердечно-сосудистых заболеваний"]},{"tag":"a","props":{"href":"/ru/tip/06-03"},"children":[{"tag":"span","props":{},"children":["03"]},"Не стоит давать витамин D людям, у которых его уровень в норме, ради долголетия"]},{"tag":"a","props":{"href":"/ru/tip/06-04"},"children":[{"tag":"span","props":{},"children":["04"]},"Не стоит принимать антиоксидантные добавки ради профилактики рака (бета-каротин, витамин E, витамин A)"]},{"tag":"a","props":{"href":"/ru/tip/06-05"},"children":[{"tag":"span","props":{},"children":["05"]},"Не стоит рассчитывать на глюкозамин и хондроитин при лечении артрита коленного сустава"]},{"tag":"a","props":{"href":"/ru/tip/06-06"},"children":[{"tag":"span","props":{},"children":["06"]},"Не стоит использовать витамин C для профилактики простуды"]},{"tag":"a","props":{"href":"/ru/tip/06-07"},"children":[{"tag":"span","props":{},"children":["07"]},"Не стоит делать себе «полный ПЭТ-КТ» или «панель онкомаркеров», если у вас нет симптомов"]},{"tag":"a","props":{"href":"/ru/tip/06-08"},"children":[{"tag":"span","props":{},"children":["08"]},"Не стоит рассчитывать, что трекеры активности помогут вам похудеть"]},{"tag":"a","props":{"href":"/ru/tip/06-09"},"children":[{"tag":"span","props":{},"children":["09"]},"Не стоит переплачивать за органические продукты ради «большего здоровья»"]},{"tag":"a","props":{"href":"/ru/tip/06-10"},"children":[{"tag":"span","props":{},"children":["10"]},"Не стоит тратить большие деньги на БАДы, пастообразные смеси и пищевые добавки для «укрепления здоровья»"]},{"tag":"a","props":{"href":"/ru/tip/06-11"},"children":[{"tag":"span","props":{},"children":["11"]},"Не стоит долго принимать пробиотики при отсутствии проблем с кишечником"]},{"tag":"a","props":{"href":"/ru/tip/06-12"},"children":[{"tag":"span","props":{},"children":["12"]},"Не стоит заставлять себя принимать холодный душ ради «укрепления иммунитета»"]},{"tag":"a","props":{"href":"/ru/tip/06-13"},"children":[{"tag":"span","props":{},"children":["13"]},"Не стоит покупать продукты для детоксикации, очищения кишечника, энзимные добавки или щелочную воду"]},{"tag":"a","props":{"href":"/ru/tip/06-14"},"children":[{"tag":"span","props":{},"children":["14"]},"Не стоит заставлять себя пить воду лишь ради достижения цели «8 стаканов в день»"]},{"tag":"a","props":{"href":"/ru/tip/06-15"},"children":[{"tag":"span","props":{},"children":["15"]},"Не тратьте деньги на гадания, Таро или астрологию, чтобы принимать решения"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/ru/tip/06-16","data-status":"active"},"children":[{"tag":"span","props":{},"children":["16"]},"Не стоит покупать очки с защитой от синего света, чтобы «охранять зрение», и не верьте утверждениям, будто «после нескольких месяцев работы за экраном зрение испортится». Однако сильная боль, отёчность и покраснение глаз — это повод для срочного обращения к врачу"]},{"tag":"a","props":{"href":"/ru/tip/06-17"},"children":[{"tag":"span","props":{},"children":["17"]},"Не стоит рассматривать донорство крови как способ укрепить здоровье: утверждения о «детоксикации, снижении уровня холестерина и профилактике инфаркта» не подтверждены рандомизированными исследованиями, а частое донорство действительно приводит к дефициту железа"]},{"tag":"a","props":{"href":"/ru/tip/06-18"},"children":[{"tag":"span","props":{},"children":["18"]},"Не стоит полагаться на стандартные пакеты медосмотров для профилактики — достаточно проводить те обследования, эффективность которых подтверждена данными, с учётом возраста и пола"]},{"tag":"a","props":{"href":"/ru/tip/06-19"},"children":[{"tag":"span","props":{},"children":["19"]},"Не стоит принимать препараты для снижения уровня мочевой кислоты только потому, что анализы показали её повышение, а боли никогда не было"]},{"tag":"a","props":{"href":"/ru/tip/06-20"},"children":[{"tag":"span","props":{},"children":["20"]},"Не стоит делать профилактическую операцию по удалению желчного пузыря только потому, что при обследовании обнаружили камни, а боли никогда не было"]},{"tag":"a","props":{"href":"/ru/tip/06-21"},"children":[{"tag":"span","props":{},"children":["21"]},"Не стоит отказываться от кальция ради профилактики камней в почках"]},{"tag":"a","props":{"href":"/ru/tip/06-22"},"children":[{"tag":"span","props":{},"children":["22"]},"Не стоит покупать кристаллы, браслеты или фигурки пи-сюй ради «улучшения удачи», «привлечения богатства» или «помощи в саморазвитии»"]},{"tag":"a","props":{"href":"/ru/tip/06-23"},"children":[{"tag":"span","props":{},"children":["23"]},"Не стоит рассчитывать, что покупки улучшат настроение или самооценку"]},{"tag":"a","props":{"href":"/ru/tip/06-24"},"children":[{"tag":"span","props":{},"children":["24"]},"Не тратьте лишние деньги на новую квартиру, машину или круг общения лишь ради того, чтобы «подняться в социальном статусе»"]},{"tag":"a","props":{"href":"/ru/tip/06-25"},"children":[{"tag":"span","props":{},"children":["25"]},"Не верьте утверждению «воля — это как мышца, которая быстро устает»"]},{"tag":"a","props":{"href":"/ru/tip/06-26"},"children":[{"tag":"span","props":{},"children":["26"]},"Не стоит рассчитывать, что завтрак или режим питания 16:8 помогут вам контролировать вес — выбирайте тот график, который сможете соблюдать долгое время"]},{"tag":"a","props":{"href":"/ru/tip/06-27"},"children":[{"tag":"span","props":{},"children":["27"]},"Не верьте в то, что «мастурбация вредит здоровью» или что «нужно воздерживаться, чтобы стать лучше»; на самом деле важно лишь то, не мешает ли это вашему сну, работе и отношениям"]},{"tag":"a","props":{"href":"/ru/tip/06-28"},"children":[{"tag":"span","props":{},"children":["28"]},"Не тратьте деньги на «исправление сексуальной ориентации» или «лечение гомосексуальности», и не отправляйте туда своих близких"]},{"tag":"a","props":{"href":"/ru/tip/06-29"},"children":[{"tag":"span","props":{},"children":["29"]},"Не рассчитывайте предотвратить боль в пояснице «правильной техникой подъема» и курсами: уменьшайте вес и число подъемов, регулярно занимайтесь физической нагрузкой"]},{"tag":"a","props":{"href":"/ru/tip/06-30"},"children":[{"tag":"span","props":{},"children":["30"]},"Не рассчитывайте, что большие дозы кальция и костный бульон ускорят сращение перелома"]},{"tag":"a","props":{"href":"/ru/tip/06-31"},"children":[{"tag":"span","props":{},"children":["31"]},"Не стоит полагаться на ИИ-чат-бот в одиночку, когда нужно оценить болезнь или юридический вопрос: прежде чем идти к врачу, в суд или тратить большие деньги, найдите первоисточник, на который он ссылается, и проверьте по оригиналу"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"Навигация"},"children":[{"tag":"a","props":{"href":"/ru/book"},"children":["Книга"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/ru/book/06"},"children":["Глава 6"," ·"," ","Перечень вредных средств"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"06-16"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["16"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["Доказательства"," ","A"]}]},{"tag":"h1","props":{"lang":"ru"},"children":["Не стоит покупать очки с защитой от синего света, чтобы «охранять зрение», и не верьте утверждениям, будто «после нескольких месяцев работы за экраном зрение испортится». Однако сильная боль, отёчность и покраснение глаз — это повод для срочного обращения к врачу"]},{"tag":"p","props":{"lang":"ru","className":"life-entry-summary"},"children":["Линзы с защитой от синего света не приносят никакой пользы, и отказ от их покупки позволяет сэкономить значительную сумму. По сравнению с обычными линзами они не снижают усталость глаз и не улучшают остроту зрения; доказательств их защитного эффекта для сетчатки тоже не найдено. Усталость и сухость глаз после длительной работы за экраном проходят сами по себе. Настоящую угрозу для зрения представляют лишь сварочная дуга, ультрафиолет, лазерное излучение и внезапное развитие глаукомы."]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Затраты"]},{"tag":"p","props":{},"children":["Покупать такие очки не нужно — вы сэкономите от нескольких…"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Польза"]},{"tag":"p","props":{},"children":["В 2023 году Cochrane опубликовала систематический обзор, включивший 17 рандомизированных контролируемых исслед…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"Отметить: Не стоит покупать очки с защитой от синего света, чтобы «охранять зрение», и не верьте утверждениям, будто «после нескольких месяцев работы за экраном зрение испортится». Однако сильная боль, отёчность и покраснение глаз — это повод для срочного обращения к врачу"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"Сделано"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"В планах"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"В избранное"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Поделиться советом"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Скрыть подробности"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Затраты"]},{"tag":"p","props":{},"children":["Покупать такие очки не нужно — вы сэкономите от нескольких сотен до тысячи юаней, которые обычно приходится платить за дополнительную наценку на линзы с защитой от синего света."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Польза"]},{"tag":"p","props":{},"children":["В 2023 году Cochrane опубликовала систематический обзор, включивший 17 рандомизированных контролируемых исследований с участием от 5 до 156 человек каждое; период наблюдения в них варьировался от менее суток до пяти недель. Из-за малого объёма данных, различий в составе участников и неодинаковой длительности наблюдений авторы не смогли объединить результаты в единый показатель. Приведённые ниже данные сравниваются с использованием обычных очков без фильтрации синего света. По истечении менее недели самооценка уровня усталости глаз «возможно, не изменилась»; уровень доказательности низкий. В одном из исследований с участием 120 человек разница между группами составила 9,76 единицы; доверительный интервал 95% для этого показателя — от −33,95 до 53,47, что охватывает как положительные, так и отрицательные значения и свидетельствует об отсутствии различий. Частота слияния мерцающих изображений, объективный показатель усталости глаз, «возможно, почти не изменилась» между группами; доказательность низкая. Максимальная острота зрения после коррекции очками «вероятно, не изменилась»; разница между группами составила 0,00 logMAR (95% CI −0,02–0,02). Этот вывод основан лишь на одном исследовании с 156 участниками, поэтому уровень доказательности средний. Влияние на бодрость днём не установлено (два исследования, 42 участника; доказательность крайне низкая). В обзоре также не найдено подтверждений защитного эффекта таких линз для макулы сетчатки."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Первоисточники"]},{"tag":"p","props":{"className":"life-citations"},"children":["Singh S, Downie LE, Anderson AJ, Keller PR, White SJ, Ang M, Wolffsohn JS (2023). Blue-light filtering spectacle lenses for visual performance, sleep, and macular health in adults. Cochrane Database of Systematic Reviews, 8, CD013244. ",{"tag":"a","props":{"href":"https://doi.org/10.1002/14651858.CD013244.pub2","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1002/14651858.CD013244.pub2"]}]},{"tag":"a","props":{"href":"https://doi.org/10.1002/14651858.CD013244.pub2","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Открыть источник"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Примечание автора"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["Усталость и сухость глаз при длительной работе за экраном проявляются в виде дискомфорта, сухости и временного снижения чёткости зрения; эти симптомы проходят после отдыха и частого моргания. Это временное состояние, а не необратимое повреждение зрения. Данное утверждение является общепризнанным мнением офтальмологов, а не выводом из обзора Cochrane, поэтому его уровень доказательности оценивается как C. Настоящую угрозу для зрения представляют лишь сварочная дуга, ультрафиолет, лазерное излучение. Повреждение глаз от сварочной дуги называется «электроофтальмией» и является официально признанным профессиональным заболеванием; защититься от него помогают специальные защитные очки и маски, а не линзы с фильтрацией синего света (см. раздел 19, пункт 10 о защите от пыли, шума и химических веществ). При бессонной работе за экраном опасность представляет не сам экран, а лишь редкие исключения: сильная боль, отёчность и покраснение глаз, появление радужной обводки вокруг источников света, головная боль, тошнота и рвота — это признаки внезапного развития закрытоугольной глаукомы, способной за несколько дней повредить зрительный нерв; в таких случаях требуется немедленное обращение в офтальмологический стационар (см. раздел 13, пункт 6). Риск повышают расширение зрачка в темноте и длительное наклонение головы вперёд, вызывающее смещение хрусталика; особенно подвержены этому люди старше 50 лет с дальнозоркостью и мелкой передней камерой глаза. Хроническая сухость глаз, вызванная работой за экраном, со временем может перерасти в требующее лечения заболевание, поэтому при длительном дискомфорте или снижении зрения необходимо обратиться к врачу, а не просто сменить очки. Меры профилактики близорукости у детей и подростков описаны в разделе 30, пунктах 4, 12 и 9 (ежедневные прогулки на свежем воздухе не менее двух часов, проверка зрения с расширением зрачка, отказ от покупки средств, якобы «излечивающих» близорукость)."]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Моя заметка"]},{"tag":"button","props":{"type":"button"},"children":["Запишите напоминание…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/ru/tip/06-15"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Предыдущий"]},"Не тратьте деньги на гадания, Таро или астрологию, чтобы принимать решения"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/ru/tip/06-17"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Следующий"]},"Не стоит рассматривать донорство крови как способ укрепить здоровье: утверждения о «детоксикации, снижении уровня холестерина и профилактике инфаркта» не подтверждены рандомизированными исследованиями, а частое донорство действительно приводит к дефициту железа"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["Другие советы по этой теме"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/06-12"},"children":[{"tag":"strong","props":{},"children":["Не стоит заставлять себя принимать холодный душ ради «укрепления иммунитета»"]},{"tag":"span","props":{},"children":["В ходе исследования с участием 3018 человек количество случаев взятия…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"h