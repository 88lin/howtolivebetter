:"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Ẩn chi tiết"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Chi phí"]},{"tag":"p","props":{},"children":["Không tốn tiền. Khó ở chỗ phải lấy màn hình ra khỏi tay trẻ, và cũng khó ở chỗ bố mẹ tự bớt xem trước mặt con."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Lợi ích"]},{"tag":"p","props":{},"children":["Điều bốn của《Mười điểm cốt lõi về phòng và kiểm soát cận thị ở trẻ em và thanh thiếu niên》《防控儿童青少年近视核心知识十条》viết nguyên văn:「0～3岁婴幼儿不使用手机、平板、电脑等视屏类电子产品；3～6岁幼儿尽量避免其接触和使用手机、平板、电脑等视屏类电子产品；中小学生非学习目的使用电子屏幕单次时长不宜超过15分钟，每天累计时长不宜超过1小时」, tức trẻ sơ sinh và trẻ nhỏ 0 đến 3 tuổi không dùng điện thoại, máy tính bảng, máy tính; trẻ 3 đến 6 tuổi nên tránh tiếp xúc và dùng các thiết bị đó; học sinh tiểu học và trung học dùng màn hình không phải để học thì mỗi lần không nên quá 15 phút, tổng trong ngày không nên quá 1 giờ. Cùng điều đó nói rõ「长时间近距离使用电子视屏类产品，易消耗儿童远视储备量，是儿童青少年近视早发、高发的重要原因」, tức dùng sản phẩm màn hình ở khoảng cách gần trong thời gian dài dễ làm hao hụt dự trữ thị lực của trẻ, là một nguyên nhân quan trọng khiến cận thị ở trẻ em và thanh thiếu niên tới sớm và xuất hiện nhiều. Bản triển khai năm 2018 của tám bộ, trong đó có Bộ Giáo dục, đưa ra cùng yêu cầu với phía bố mẹ, và bổ sung một câu「年龄越小，连续使用电子产品的时间应越短」, tức tuổi càng nhỏ thì thời gian dùng liên tục thiết bị điện tử càng phải ngắn. Bằng chứng nghiên cứu yếu hơn nhiều: một tổng quan hệ thống thu 33 nghiên cứu, 11 nghiên cứu được đưa vào phép gộp, đối tượng từ 3 tháng tuổi đến 33 tuổi. Chỉ tính điện thoại và máy tính bảng thì tỷ số odds cận thị là 1.26 (95% CI 1.00 đến 1.60, I²=77%). Gộp cả máy tính thì là 1.77 (1.28 đến 2.45, I²=87%). Kết luận của tác giả chỉ viết「可能相关」, và nói rõ trong 33 nghiên cứu không nghiên cứu nào có phép đo thời gian dùng màn hình đáng tin cậy"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Nguồn gốc"]},{"tag":"p","props":{"className":"life-citations"},"children":["国家卫生健康委办公厅 (2023). 防控儿童青少年近视核心知识十条（国卫办妇幼函〔2023〕278 号）. ",{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/202307/content_6894284.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/zhengce/zhengceku/202307/content_6894284.htm"]}," ; 教育部等八部门 (2018). 综合防控儿童青少年近视实施方案（教体艺〔2018〕3 号）. ",{"tag":"a","props":{"href":"http://www.moe.gov.cn/srcsite/A17/moe_943/s3285/201808/t20180830_346672.html","target":"_blank","rel":"noopener noreferrer"},"children":["http://www.moe.gov.cn/srcsite/A17/moe_943/s3285/201808/t20180830_346672.html"]}," ; Foreman J, Salim AT, Praveen A, et al. (2021). Association between digital smart device use and myopia: a systematic review and meta-analysis. The Lancet Digital Health, 3(12), e806-e818. ",{"tag":"a","props":{"href":"https://doi.org/10.1016/S2589-7500(21)00135-7","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1016/S2589-7500(21)00135-7"]}," ; Madigan S, McArthur BA, Anhorn C, Eirich R, Christakis DA (2020). Associations between screen use and child language skills: a systematic review and meta-analysis. JAMA Pediatrics, 174(7), 665-675. ",{"tag":"a","props":{"href":"https://doi.org/10.1001/jamapediatrics.2020.0327","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1001/jamapediatrics.2020.0327"]}]},{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/202307/content_6894284.htm","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Liên kết mở nguồn"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Ghi chú sách"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["Cho mức B là vì cái cơ quan đưa ra là quy định chia theo nhóm tuổi, không phải con số đo từ thử nghiệm. Nghiên cứu cho tỷ số odds có cận dưới vừa đúng ở 1.00, nên tác giả chỉ dám viết「可能相关」. Vì vậy cứ coi đây là một quy tắc gia đình dễ thực hiện, đừng hiểu là「không xem màn hình thì không cận thị」. Cái có thử nghiệm ngẫu nhiên bảo chứng là mục 4 (2 giờ ở ngoài trời). Trẻ mẫu giáo cũng cần khám mắt: cùng tài liệu đó ghi rõ 1～3 tuổi, 4～6 tuổi và sau 7 tuổi đều nên làm khám khúc xạ định kỳ để xem còn lại bao nhiêu dự trữ thị lực, cách khám xem mục 12 của phần này (khám khúc xạ sau khi nhỏ mắt). Quan hệ giữa màn hình và khả năng ngôn ngữ của trẻ cũng đã có phân tích tổng hợp: 42 nghiên cứu, 18905 người, dùng màn hình lâu hơn thì khả năng ngôn ngữ yếu hơn (r=−0.14, 95% CI −0.18 đến −0.10). Nhưng xem chung, xem chương trình có nội dung giáo dục lại ra tương quan thuận (r=0.16 và 0.13). Đây là tương quan chứ không phải nhân quả, chỉ cho thấy dùng màn hình thay cho việc nói chuyện với trẻ là không đáng."]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Ghi chú của tôi"]},{"tag":"button","props":{"type":"button"},"children":["Viết một lời nhắc cho chính bạn…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/vi/tip/30-04"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Trước"]},"Cho trẻ ở ngoài trời đủ 2 giờ mỗi ngày, đây là cách phòng cận thị duy nhất hiện có thử nghiệm ngẫu nhiên đứng sau"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/vi/tip/30-06"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Tiếp theo"]},"Hãy coi cận thị là một tổn thương còn lại: độ càng cao thì sau này càng nhiều bong võng mạc, thoái hoa điểm vàng và glôcôm"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"