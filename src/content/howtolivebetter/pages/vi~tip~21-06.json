n bay hoãn"]},{"tag":"a","props":{"href":"/vi/tip/21-05"},"children":[{"tag":"span","props":{},"children":["05"]},"「 tuyển dụng lương cao ở nước ngoài」 thì coi như lừa đảo, bị lừa đi làm lừa đảo qua điện thoại, về nước còn bị hạn chế xuất cảnh"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/vi/tip/21-06","data-status":"active"},"children":[{"tag":"span","props":{},"children":["06"]},"Rút tiền ở nước ngoài một năm không được quá 100.000 tệ nhân dân tệ, tính gộp tất cả thẻ mang tên bạn"]},{"tag":"a","props":{"href":"/vi/tip/21-07"},"children":[{"tag":"span","props":{},"children":["07"]},"Chụp ảnh hộ chiếu, visa, thẻ căn cước lưu một bản trên đám mây, mất rồi thì báo công an trước rồi làm giấy tờ du lịch"]},{"tag":"a","props":{"href":"/vi/tip/21-08"},"children":[{"tag":"span","props":{},"children":["08"]},"Tự lái xe ở nước ngoài, trước tiên xác nhận nơi đó có công nhận giấy phép lái xe Trung Quốc không, 「giấy phép lái xe quốc tế」bán trên mạng đa phần là giấy vô dụng"]},{"tag":"a","props":{"href":"/vi/tip/21-09"},"children":[{"tag":"span","props":{},"children":["09"]},"Tìm môi giới làm visa, du học, định cư, trước tiên hỏi nó đã đăng ký với cơ quan quản lý nhập cảnh chưa"]},{"tag":"a","props":{"href":"/vi/tip/21-10"},"children":[{"tag":"span","props":{},"children":["10"]},"Đừng làm thay thư mời cho người lạ, cũng đừng để ai làm thủ tục nhập xuất cảnh dưới danh nghĩa của bạn"]},{"tag":"a","props":{"href":"/vi/tip/21-11"},"children":[{"tag":"span","props":{},"children":["11"]},"Trước khi xuất cảnh, gửi lịch trình, nơi ở và người đi cùng cho một người nhà, hẹn trước bao lâu liên lạc một lần"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"Breadcrumbs"},"children":[{"tag":"a","props":{"href":"/vi/book"},"children":["Khám phá cuốn sách"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/vi/book/21"},"children":["Chương 21"," ·"," ","Đi nước ngoài và an toàn ở nước ngoài"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"21-06"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["06"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["Bằng chứng"," ","A"]}]},{"tag":"h1","props":{"lang":"vi"},"children":["Rút tiền ở nước ngoài một năm không được quá 100.000 tệ nhân dân tệ, tính gộp tất cả thẻ mang tên bạn"]},{"tag":"p","props":{"lang":"vi","className":"life-entry-summary"},"children":["Hạn mức rút tiền mặt ở nước ngoài không tính từng thẻ một, mà tính tất cả thẻ ngân hàng trong tên bạn (kể cả thẻ phụ) cộng lại, mỗi năm dương lịch 100.000 tệ nhân dân tệ. Rút hết hạn mức thì phần thời gian còn lại của năm đó và cả năm sau không được rút tiền mặt ở nước ngoài. Chỉ có rút tiền mặt bị dừng, chi tiêu bằng thẻ không bị ảnh hưởng, và cũng không chiếm hạn mức mua ngoại tệ 50.000 đô la Mỹ mỗi năm của bạn."]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Chi phí"]},{"tag":"p","props":{},"children":["Không tốn tiền. Trước khi đi, ước tính chuyến này cần rút…"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Lợi ích"]},{"tag":"p","props":{},"children":["Căn cứ là Thông tư của Cục Quản lý Ngoại hối nhà nước về việc quản lý giao dịch rút tiền mặt số lớn bằng thẻ n…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"Đánh dấu: Rút tiền ở nước ngoài một năm không được quá 100.000 tệ nhân dân tệ, tính gộp tất cả thẻ mang tên bạn"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"Hoàn tất"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"Kế hoạch thực hiện"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"Lưu"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Chia sẻ mẹo này"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Ẩn chi tiết"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Chi phí"]},{"tag":"p","props":{},"children":["Không tốn tiền. Trước khi đi, ước tính chuyến này cần rút bao nhiêu tiền mặt, phần còn lại dùng thẻ. Chỗ khó là đổi thói quen, được dùng thẻ thì đừng rút tiền mặt."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Lợi ích"]},{"tag":"p","props":{},"children":["Căn cứ là Thông tư của Cục Quản lý Ngoại hối nhà nước về việc quản lý giao dịch rút tiền mặt số lớn bằng thẻ ngân hàng ở nước ngoài (关于规范银行卡境外大额提取现金交易的通知, 汇发〔2017〕29 号, có hiệu lực từ ngày 1 tháng 1 năm 2018). Điều một: 「个人持境内银行卡在境外提取现金，本人名下银行卡（含附属卡）合计每个自然年度不得超过等值 10 万元人民币。超过年度额度的，本年及次年将被暂停持境内银行卡在境外提取现金」, tức cá nhân dùng thẻ ngân hàng trong nước rút tiền mặt ở nước ngoài, tổng số tiền của tất cả thẻ ngân hàng trong tên mình (kể cả thẻ phụ) cộng lại không được vượt quá 100.000 tệ nhân dân tệ tương đương trong mỗi năm dương lịch. Vượt quá hạn mức năm thì việc rút tiền mặt ở nước ngoài bằng thẻ ngân hàng trong nước bị đình chỉ trong năm đó và năm kế tiếp. Khoản thứ hai của cùng điều đó: 「个人不得通过借用他人银行卡或出借本人银行卡等方式规避或协助规避境外提取现金管理」, tức cá nhân không được vay thẻ ngân hàng của người khác hoặc cho mượn thẻ của mình để trốn hoặc để giúp người khác trốn việc quản lý rút tiền mặt ở nước ngoài. Điều hai: mỗi ngày cơ quan ngoại hối gửi danh sách đình chỉ tới các ngân hàng phát hành thẻ, ngân hàng phát hành thẻ phải từ 17 giờ theo giờ Bắc Kinh trong ngày, không chậm hơn thế, chặn việc người có trong danh sách đình chỉ rút tiền mặt ở nước ngoài bằng thẻ của ngân hàng mình. Điều ba: người bị đưa vào danh sách đình chỉ có thể mang giấy tờ tùy thân hợp lệ của mình đến chi nhánh cơ quan ngoại hối để tra chi tiết rút tiền mặt ở nước ngoài của bản thân. Điều bốn: hạn mức mỗi thẻ ngoại tệ mỗi ngày, điều chỉnh từ mức tương đương 1000 đô la Mỹ lên mức tương đương 10.000 tệ nhân dân tệ; thẻ nhân dân tệ vẫn giữ mức mỗi thẻ mỗi ngày không quá mức tương đương 10.000 tệ nhân dân tệ. Điều sáu: ngân hàng phát hành thẻ, tổ chức thanh toán thẻ nhân dân tệ trong nước và cá nhân vi phạm các quy định của thông tư này bị xử phạt theo các quy định liên quan của Quy chếnh quản lý ngoại hối của Cộng hòa Nhân dân Trung Quốc. Câu trả lời của cơ quan ngoại hối cho báo chí còn làm rõ vài điểm. Thông tư không ảnh hưởng tới việc cá nhân dùng thẻ chi tiêu ở nước ngoài. Các giao dịch thường ngày do du lịch, công tác, du học ở nước ngoài như ăn ở, đi lại, mua sắm, đều có thể thanh toán bằng thẻ ngân hàng. Các chi tiêu đó cũng không chiếm hạn mức mua ngoại tệ thuận tiện hằng năm 50.000 đô la Mỹ của cá nhân. Hạn mức năm do cơ quan ngoại hối tính bằng cách tổng hợp dữ liệu của các tổ chức tài chính phát hành thẻ, vì kiểm soát tức thời sẽ làm chậm phản hồi giao dịch, 「外汇局采用延时控制手段」, tức không chặn tại chỗ. Theo thống kê, năm 2016 có 81% số lần rút tiền mặt ở nước ngoài bằng thẻ ngân hàng trong nước dưới 30.000 tệ nhân dân tệ (toàn quốc)"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Nguồn gốc"]},{"tag":"p","props":{"className":"life-citations"},"children":["国家外汇管理局 (2017). 关于规范银行卡境外大额提取现金交易的通知（汇发〔2017〕29 号，第一、二、三、四、六、七条，2018 年 1 月 1 日起实施）. ",{"tag":"a","props":{"href":"https://www.safe.gov.cn/safe/2017/1230/21873.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.safe.gov.cn/safe/2017/1230/21873.html"]},"；国家外汇管理局 (2017). 外汇局有关负责人就规范银行卡境外大额提取现金交易有关问题答记者问. ",{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/2017-12/31/content_5251958.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/zhengce/2017-12/31/content_5251958.htm"]},"；中国银联国际. 境外ATM取款. ",{"tag":"a","props":{"href":"https://m.unionpayintl.com/wap/cn/serviceCenter/cardUsingInstructions/805.shtml","target":"_blank","rel":"noopener noreferrer"},"children":["https://m.unionpayintl.com/wap/cn/serviceCenter/cardUsingInstructions/805.shtml"]}]},{"tag":"a","props":{"href":"https://www.safe.gov.cn/safe/2017/1230/21873.html","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Liên kết mở nguồn"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Ghi chú sách"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["Hạn mức tính theo năm dương lịch, ngày 1 tháng 1 bắt đầu lại từ đầu. Chỉ có việc rút tiền mặt ở nước ngoài bị dừng, chi tiêu bằng thẻ không bị ảnh hưởng. Nếu thật sự cần dùng nhiều tiền mặt ở nước ngoài thì theo Biện pháp quản lý ngoại hối của cá nhân (个人外汇管理办法), làm thủ tục mua ngoại tệ trước, rồi mang tiền ngoại tệ mặt ra khỏi nước. Bản thân việc rút tiền còn có hai cái bẫy, trang 「境外ATM取款」của UnionPay Quốc tế nói rõ. Một, thẻ có hai nhãn ở một số ATM tại một số nước không chọn được kênh UnionPay để rút. Hai, một số ATM ở nước ngoài hiện trên màn hình khoản phí thêm (surcharge), khoản tiền đó do tổ chức thanh toán tại chỗ thu, 「与银联无关」, không liên quan gì đến UnionPay. Cùng trang đó còn nhắc 「由于信用卡取款需支付透支利息，建议持卡人境外取款使用银联借记卡」, tức vì rút tiền bằng thẻ tín dụng phải trả lãi vượt hạn mức, nên khuyến nghị chủ thẻ rút tiền ở nước ngoài bằng thẻ ghi nợ UnionPay. Thẻ bị mất, bị nuốt hoặc bị dùng gian lận thì làm gì, xem mục 5 ở phần 14 (thẻ bị dùng gian lận thì báo mất và đóng băng trước, rồi báo công an)"]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Ghi chú của tôi"]},{"tag":"button","props":{"type":"button"},"children":["Viết một lời nhắc cho chính bạn…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/vi/tip/21-05"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Trước"]},"「 tuyển dụng lương cao ở nước ngoài」 thì coi như lừa đảo, bị lừa đi làm lừa đảo qua điện thoại, về nước còn bị hạn chế xuất cảnh"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/vi/tip/21-07"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Tiếp theo"]},"Chụp ảnh hộ chiếu, visa, thẻ căn cước lưu một bản trên đám mây, mất rồi thì báo công an trước rồi làm giấy tờ du lịch"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["Thêm trong chủ đề này"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/21-02"},"children":[{"tag":"strong","props":{},"children":["Lưu 12308 và số điện thoại bảo vệ lãnh sự của đại sứ đoàn địa phương vào điện thoại, rồi chép một bản bỏ vào ví, đừng đợi sự cố rồi mới tìm"]},{"tag":"span","props":{},"children":["Khi có sự cố chỉ có một số gọi đi. Ở trong nước gọi 12308, ở nước ngo…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/21-03"},"children":[{"tag":"strong","props":{},"children":["Biết trước bảo vệ lãnh sự làm được gì và không làm được gì: có thể thăm, không thể cứu ra, chi phí vẫn tự bỏ"]},{"tag":"span","props":{},"children":["Bạn bị bắt ở nước ngoài, đại sứ đoàn làm được: xác minh tình hình với…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/21-04"},"children":[{"tag":"strong","props":{},"children":["Mua một gói bảo hiểm có bảo hiểm y tế nước ngoài và vận chuyển y tế, đừng chỉ mua bảo hiểm chuyến bay hoãn"]},{"tag":"span","props":{},"children":["Tiền khám chữa bệnh ở nước ngoài tự túi. Bảo hiểm y tế trong nước về …"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/21-08"},"children":[{"tag":"strong","props":{},"children":["Tự lái xe ở nước ngoài, trước tiên xác nhận nơi đó có công nhận giấy phép lái xe Trung Quốc không, 「giấy phép lái xe quốc tế」bán trên mạng đa phần là giấy vô dụng"]},{"tag":"span","props":{},"children":["「Giấy phép lái xe quốc tế」do bên ngoài làm hộ trên mạng không có giá …"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/21-09"},"children":[{"tag":"strong","props":{},"children":["Tìm môi giới làm visa, du học, định cư, trước tiên hỏi nó đã đăng ký với cơ quan quản lý nhập cảnh chưa"]},{"tag":"span","props":{},"children":["Từ ngày 15 tháng 9 năm 2026, môi giới làm visa, du học, định cư phải …"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/21-10"},"children":[{"tag":"strong","props":{},"children":["Đừng làm thay thư mời cho người lạ, cũng đừng để ai làm thủ tục nhập xuất cảnh dưới danh nghĩa của bạn"]},{"tag":"span","props":{},"children":["Làm thay thư mời hoặc hồ sơ xin cho người khác mà nội dung không đúng…"]}]}]}]},{"tag":"a","props":{"className":"life-text-link","href":"/vi/book/21"},"children":["Đọc toàn bộ chủ đề: Đi nước ngoài và an toàn ở nước ngoài"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"15","height":"15","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]}]}]},{"tag":"nav","props":{"className":"life-tabbar","aria-label":"Điều hướng chính"},"children":[{"tag":"a","props":{"className":"","href":"