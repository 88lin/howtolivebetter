trokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"已做到"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"加入待做"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"收藏"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"分享这条建议"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"收起详情"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["成本"]},{"tag":"p","props":{"className":"life-citations"},"children":["不花钱。代价是放掉卖破解版、卖注册码、卖破解加密狗这类来钱快的副业。破解补丁也别发到论坛和网盘里。难在破解看着只是技术活，不像偷东西"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["收益"]},{"tag":"p","props":{"className":"life-citations"},"children":["先说民事。著作权法允许权利人给作品加上技术措施。技术措施是防止、限制别人没经许可使用作品的有效技术、装置或者部件。没经权利人许可，任何人不得故意避开或者破坏技术措施。也不得为了避开技术措施，制造、进口或者向公众提供有关装置、部件。还不得故意替别人避开技术措施提供技术服务。计算机软件是作品，这几样做了都是侵权，要停止侵害、赔偿损失。赔多少，按权利人的实际损失或者你挣到的钱算。算不清的，参照正常买授权要付的钱。故意侵权、情节严重的，判 1 到 5 倍。同时损害公共利益的，著作权主管部门还可以没收违法所得。违法经营额 5 万元以上的，可以罚它的 1 到 5 倍。不足 5 万元或者算不清的，可以罚 25 万元以下。再说刑事。刑法修正案（十一）把「故意避开或者破坏技术措施」写进了侵犯著作权罪，前提是以营利为目的。违法所得 3 万元以上，或者非法经营数额 5 万元以上，判 3 年以下，同时罚钱或者只罚钱。到这些数的 10 倍，判 3 到 10 年并罚钱。有人明知别人在搞侵犯著作权犯罪，还给他提供主要用于避开、破坏技术措施的装置、部件或者技术服务。数额到了同样的门槛，也按这个罪追究。官方案例一：2019 年 3 月到 2022 年 7 月，刘某生为了挣钱，自己做能避开软件技术措施的「加密狗」。他还复制盗版软件，和加密狗一起拿去卖。他的非法经营数额 106 万余元。上海市第三中级人民法院认定他情节特别严重，按侵犯著作权罪判了刑。最高检说，这是刑法修正案（十一）施行后全国首例「故意避开或者破坏技术措施型」侵犯著作权案。2023 年 4 月，上海法院判这一串案子的三名被告 3 年 2 个月到 1 年，部分缓刑，罚金 70 万元到 8 万元。官方案例二：医疗设备维修工刘某在 QQ 群里花 8 万元，买了 50 套破解加密狗，再按每个几千元在网上转卖。插上它就能绕过医疗设备的身份验证，进入维修软件。上海普陀法院判他 1 年 2 个月、缓刑，罚金 8 万元。官方案例三：徐州李某某等人从 2021 年 5 月起，找人做游戏机的破解程序，生产破解装置来卖。非法经营数额 3900 余万元。2024 年 11 月，10 人被判 3 年 6 个月到 2 年 6 个月，部分缓刑，罚金 1100 万元到 150 万元（全国）"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["来源"]},{"tag":"p","props":{"className":"life-citations"},"children":["全国人大常委会 (2020). 刑法修正案（十一）（第二十项，即刑法第二百一十七条第六项）. ",{"tag":"a","props":{"href":"https://www.spp.gov.cn/zdgz/202012/t20201227_503682.shtml","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.spp.gov.cn/zdgz/202012/t20201227_503682.shtml"]},"；全国人大常委会 (2020). 著作权法（2020 年修正，第三条，第四十九、五十、五十三、五十四条）. ",{"tag":"a","props":{"href":"http://www.npc.gov.cn/npc/c2/c30834/202011/t20201119_308796.html","target":"_blank","rel":"noopener noreferrer"},"children":["http://www.npc.gov.cn/npc/c2/c30834/202011/t20201119_308796.html"]},"；最高人民法院、最高人民检察院 (2025). 关于办理侵犯知识产权刑事案件适用法律若干问题的解释（法释〔2025〕5 号，第十三条）. ",{"tag":"a","props":{"href":"https://www.spp.gov.cn/xwfbh/wsfbt/202504/t20250424_693977.shtml","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.spp.gov.cn/xwfbh/wsfbt/202504/t20250424_693977.shtml"]},"；最高人民法院、最高人民检察院 (2025). 知识产权刑事保护典型案例（案例六：刘某生、刘某侵犯著作权案）. ",{"tag":"a","props":{"href":"https://www.spp.gov.cn/xwfbh/wsfbt/202504/t20250424_693978.shtml","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.spp.gov.cn/xwfbh/wsfbt/202504/t20250424_693978.shtml"]},"；最高人民检察院 (2024). 最高检：指导办理全国首例「故意避开或者破坏技术措施型」侵犯著作权案. ",{"tag":"a","props":{"href":"https://www.spp.gov.cn/spp/2024zgjtzwlft/202402/t20240228_645416.shtml","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.spp.gov.cn/spp/2024zgjtzwlft/202402/t20240228_645416.shtml"]},"；检察日报 (2023-04-18). 售卖盗版加密狗 解锁医疗设备安全系统（最高检官网转载）. ",{"tag":"a","props":{"href":"https://www.spp.gov.cn/spp/zdgz/202304/t20230418_611586.shtml","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.spp.gov.cn/spp/zdgz/202304/t20230418_611586.shtml"]},"；国家版权局 (2025). 2024 年度全国打击侵权盗版十大案件（案件六：江苏徐州李某某等人破坏技术措施侵犯著作权案）. ",{"tag":"a","props":{"href":"https://www.ncac.gov.cn/xxfb/ywxx/202508/t20250801_925366.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.ncac.gov.cn/xxfb/ywxx/202508/t20250801_925366.html"]},""]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["原书备注"]},{"tag":"p","props":{"className":"life-citations"},"children":["受益人是你自己。著作权法留了几个口子：测试计算机系统和网络的安全性能，做加密研究、软件反向工程研究，可以避开技术措施。但同一条写明，不得把避开用的技术、装置或者部件提供给别人。所以自己研究可以，发出去、卖出去就不行。免费发破解补丁，够不上侵犯著作权罪，因为这个罪要求为了挣钱。但民事侵权照样成立，软件公司可以发律师函、起诉要你赔。打官司一审普通程序 6 个月起，律师费一般自己出。把整个破解版软件放到网上让人下载，算未经许可传播作品，刑事门槛见第 9 节第 24 条（分享网盘资源）。游戏外挂绕过反作弊，见本节第 2 条（游戏外挂和辅助）。"]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["我的备注"]},{"tag":"button","props":{"type":"button"},"children":["写下对自己有用的提醒…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/tip/11-19"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["上一条"]},"不搭「AI 中转站」低价转卖境外大模型接口：上海已有站长被刑事拘留"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/tip/11-21"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["下一条"]},"不帮人发起 DDoS 流量攻击，不卖、不租「压力测试」打流量平台，打游戏输了也别去打对方的服务器"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["本主题的其他建议"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/11-03"},"children":[{"tag":"strong","props":{},"children":["不写、不卖抢票、秒杀、刷单、薅羊毛脚本，哪怕只是「自动化点按钮」"]},{"tag":"span","props":{},"children":["脚本不改内存、不破解，只是发请求比人快，一样可能被定罪，挣到 5000 元或让对方损失 1 万元就够。有人用买来的 12306 账号代抢 200 多张票、挣了…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/11-04"},"children":[{"tag":"strong","props":{},"children":["爬虫只爬无需登录的公开页面，不绕反爬、不碰个人信息，爬到的数据不卖"]},{"tag":"span","props":{},"children":["绕过登录、token、签名这些防护去拿数据，情节严重的判 3 年以下，特别严重的判 3 到 7 年。爬到个人信息更麻烦。行踪、通信内容、征信、财产类 50 条，…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/11-05"},"children":[{"tag":"strong","props":{},"children":["不接赌博、诈骗、色情 App 的开发单，不替「客户」搭支付通道、解封账号"]},{"tag":"span","props":{},"children":["明知是赌博 App 还接开发单，就按开设赌场的共犯办。开设赌场罪判 5 年以下，严重的 5 到 10 年，比单纯帮忙最多判 3 年重。有个电竞竞猜 App 案，…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/11-06"},"children":[{"tag":"strong","props":{},"children":["离职时交清账号权限，不删库、不留后门、不改密码锁系统，哪怕公司欠你钱"]},{"tag":"span","props":{},"children":["账号密码是公司给的，不等于离职后还能用。非法控制系统，情节严重的判 3 年以下。删数据让系统跑不起来、后果严重的，判 5 年以下，特别严重的判 5 年以上。有个…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/11-07"},"children":[{"tag":"strong","props":{},"children":["离职不带走源码、客户名单和技术文档，不上传个人网盘，不在下家复用"]},{"tag":"span","props":{},"children":["上班写的代码著作权一般归公司，客户名单也可能算商业秘密，带走就是拿公司的东西。有离职员工带着安检系统源码去新公司，本人判 5 年、罚 50 万元，新公司罚 40…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/11-08"},"children":[{"tag":"strong","props":{},"children":["不在别人的电脑、服务器、摄像头上跑自己的程序，公司机器不拿来挖矿"]},{"tag":"span","props":{},"children":["没经允许控制别人的电脑、服务器、摄像头，到 20 台就判 3 年以下，特别严重的判 3 到 7 年。够不上犯罪的，也要拘留 5 日以下，还可能罚 5 万到 50…"]}]}]}]},{"tag":"a","props":{"className":"life-text-link","href":"/book/11"},"children":["阅读整个主题：程序员和技术人容易踩的红线 ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"15","height":"15","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]}]}]},{"tag":"nav","props":{"className":"life-tabbar","aria-label":"主导航"},"children":[{"tag":"a","props":{"className":"","href":"/book"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"21","height":"21","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-book-open","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M12 7v14"},"children":[]},{"tag":"path","props":{"d":"M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z"},"children":[]}]},{"tag":"span","props":{},"children":["全书"]}]},{"tag":"a","props":{"className":"","href":"/top-50"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"21","height":"21","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWi