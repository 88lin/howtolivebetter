","props":{},"children":["23"]},"赤身肉の一部を魚や鶏肉に置き換える"]},{"tag":"a","props":{"href":"/ja/tip/02-24"},"children":[{"tag":"span","props":{},"children":["24"]},"精白米や白小麦粉の一部を全粒穀物に置き換える"]},{"tag":"a","props":{"href":"/ja/tip/02-25"},"children":[{"tag":"span","props":{},"children":["25"]},"週に3回以上、お茶を飲む"]},{"tag":"a","props":{"href":"/ja/tip/02-26"},"children":[{"tag":"span","props":{},"children":["26"]},"毎日3〜4杯のコーヒーを、砂糖やミルクなしで飲む"]},{"tag":"a","props":{"href":"/ja/tip/02-27"},"children":[{"tag":"span","props":{},"children":["27"]},"毎日、十分な量の 5 単位（約 400 g）の果物と野菜を食べる"]},{"tag":"a","props":{"href":"/ja/tip/02-28"},"children":[{"tag":"span","props":{},"children":["28"]},"超加工食品（ポテトチップス、インスタントラーメン、菓子類、ファストフード）の摂取を控える"]},{"tag":"a","props":{"href":"/ja/tip/02-29"},"children":[{"tag":"span","props":{},"children":["29"]},"料理や暖房に石炭や薪を使わず、電気やガスに切り替える"]},{"tag":"a","props":{"href":"/ja/tip/02-30"},"children":[{"tag":"span","props":{},"children":["30"]},"熱いものは少し冷ましてから飲む。熱すぎる茶、スープ、コーヒーは避ける"]},{"tag":"a","props":{"href":"/ja/tip/02-31"},"children":[{"tag":"span","props":{},"children":["31"]},"日中は外出して日光を浴びる。一日中光を避けない"]},{"tag":"a","props":{"href":"/ja/tip/02-32"},"children":[{"tag":"span","props":{},"children":["32"]},"BMIを20–25に保つ、過体重なら減量"]},{"tag":"a","props":{"href":"/ja/tip/02-33"},"children":[{"tag":"span","props":{},"children":["33"]},"週に4回以上の唐辛子の摂取"]},{"tag":"a","props":{"href":"/ja/tip/02-34"},"children":[{"tag":"span","props":{},"children":["34"]},"毎日1〜2サービングの乳製品またはヨーグルトを摂取"]},{"tag":"a","props":{"href":"/ja/tip/02-35"},"children":[{"tag":"span","props":{},"children":["35"]},"卵は禁止する必要はないが、毎日3〜4個も食べないこと"]},{"tag":"a","props":{"href":"/ja/tip/02-36"},"children":[{"tag":"span","props":{},"children":["36"]},"条件が許すなら入浴を、シャワーだけで済ませない"]},{"tag":"a","props":{"href":"/ja/tip/02-37"},"children":[{"tag":"span","props":{},"children":["37"]},"昼寝は30分以内に抑えること。1時間を超えないように。1〜2時間寝ないと持ちこたえられない場合は原因を調べること"]},{"tag":"a","props":{"href":"/ja/tip/02-38"},"children":[{"tag":"span","props":{},"children":["38