},{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},{"tag":"span","props":{},"children":["ログイン"]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/ja/book/09"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"目次に戻る"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["一般人が陥りやすい法律のレッドライン"]},{"tag":"nav","props":{"aria-label":"この章のヒント"},"children":[{"tag":"a","props":{"href":"/ja/tip/09-01"},"children":[{"tag":"span","props":{},"children":["01"]},"グループ内で、真偽不明の災害、疫病、事件に関する情報を転送しないこと。画像の加工や、AIによる現場画像の捏造を行わないこと"]},{"tag":"a","props":{"href":"/ja/tip/09-02"},"children":[{"tag":"span","props":{},"children":["02"]},"英烈を侮辱する画像、絵文字、コメントを投稿・転送しないこと。国旗や国歌をネタにしないこと。"]},{"tag":"a","props":{"href":"/ja/tip/09-03"},"children":[{"tag":"span","props":{},"children":["03"]},"海外サイトの内容は見た後に閉じるだけ。スクリーンショットも、転送も、グループへの持ち込みも、コメント欄での追随もせず。"]},{"tag":"a","props":{"href":"/ja/tip/09-04"},"children":[{"tag":"span","props":{},"children":["04"]},"アダルト動画は個人で楽しむ分には自由ですが、グループ内に投稿したり、「素材」を販売したり、グループを作成したりしないでください。"]},{"tag":"a","props":{"href":"/ja/tip/09-05"},"children":[{"tag":"span","props":{},"children":["05"]},"「副業」として自分のカードで入金、出金、送金を行うよう指示される案件、どんなに報酬が高くても断ること"]},{"tag":"a","props":{"href":"/ja/tip/09-06"},"children":[{"tag":"span","props":{},"children":["06"]},"「融資書類の偽造」を勧誘し、融資額に応じたキックバックを提示する者がいても、一切応じないこと"]},{"tag":"a","props":{"href":"/ja/tip/09-07"},"children":[{"tag":"span","props":{},"children":["07"]},"拾得銀行カードをそのままにせず、携帯電話や財布を拾った際は持ち去らず、持ち主に連絡するか警察に届ける"]},{"tag":"a","props":{"href":"/ja/tip/09-08"},"children":[{"tag":"span","props":{},"children":["08"]},"特典は自身の真の身分で受け取る。仮想番号による大量のサブアカウント登録や、脆弱性を利用した繰り返し取得は行わない"]},{"tag":"a","props":{"href":"/ja/tip/09-09"},"children":[{"tag":"span","props":{},"children":["09"]},"バルコニーや窓からいかなる物も投げ出さない。吸い殻、ゴミ袋、酒瓶もすべて対象"]},{"tag":"a","props":{"href":"/ja/tip/09-10"},"children":[{"tag":"span","props":{},"children":["10"]},"模造銃、鋼鉄玉銃、エアガンをネットで購入しない、出所不明の「おもちゃの銃」を買わない"]},{"tag":"a","props":{"href":"/ja/tip/09-11"},"children":[{"tag":"span","props":{},"children":["11"]},"ドローンを購入したらまず実名登録を行う。空港、軍事区域、および都市の規制空域では飛行させない。高度制限の解除（ハッキング）は行わない"]},{"tag":"a","props":{"href":"/ja/tip/09-12"},"children":[{"tag":"span","props":{},"children":["12"]},"他人の盗撮をしない。賃貸物件、民泊、ホテルの客室にカメラを設置しない"]},{"tag":"a","props":{"href":"/ja/tip/09-13"},"children":[{"tag":"span","props":{},"children":["13"]},"麻雀やポーカーは可能ですが、手数料を取らない、胴元にならない、場を設けて集金しない、オンラインギャンブルは行わないこと"]},{"tag":"a","props":{"href":"/ja/tip/09-14"},"children":[{"tag":"span","props":{},"children":["14"]},"野生動物を食べない、売買しない、保護動物をペットとして飼育しない"]},{"tag":"a","props":{"href":"/ja/tip/09-15"},"children":[{"tag":"span","props":{},"children":["15"]},"債権回収において、人を拘束したり、監禁したり、相手の自宅まで押しかけて居座ったりしてはいけない"]},{"tag":"a","props":{"href":"/ja/tip/09-16"},"children":[{"tag":"span","props":{},"children":["16"]},"身分証は貸さない、他人の身分証を使わない、他人の身分証で登録・カード作成・チケット購入を行わない"]},{"tag":"a","props":{"href":"/ja/tip/09-17"},"children":[{"tag":"span","props":{},"children":["17"]},"警察に止められたり連行されたりした際は協力すること。押し返さない、殴らない、执法記録カメラを奪わない。飲酒している時はなおさら自制が必要。"]},{"tag":"a","props":{"href":"/ja/tip/09-18"},"children":[{"tag":"span","props":{},"children":["18"]},"相手が 14 歳未満の場合、性交渉は成立しません。「本人の同意」は理由になりません"]},{"tag":"a","props":{"href":"/ja/tip/09-19"},"children":[{"tag":"span","props":{},"children":["19"]},"手を出して人を殴る前に、この代償を計算しておくこと：拘留、賠償、刑罰"]},{"tag":"a","props":{"href":"/ja/tip/09-20"},"children":[{"tag":"span","props":{},"children":["20"]},"子供を育てられない場合、民政局への登録という唯一の合法的な道があります：金銭を受け取って子供を渡すと人身売買罪に問われる可能性があり、放置すれば遺棄罪になります"]},{"tag":"a","props":{"href":"/ja/tip/09-21"},"children":[{"tag":"span","props":{},"children":["21"]},"事故を捏造せず、損失を誇張して保険金を騙し取らないこと：これは保険詐欺罪です。証言、修理、鑑定を手伝った人も共犯となります"]},{"tag":"a","props":{"href":"/ja/tip/09-22"},"children":[{"tag":"span","props":{},"children":["22"]},"自分の臓器を売らない、他人のドナー探しを手伝わない：腎臓が手元に残るのは 2 万強、同じものが転売されると 20 万、売得金は没収され、さらに取引額の 10 倍から 20 倍の罰金が科される"]},{"tag":"a","props":{"href":"/ja/tip/09-23"},"children":[{"tag":"span","props":{},"children":["23"]},"売春をしない：標準的な罰則は 10 日から 15 日の拘留であり、単なる罰金では済みません"]},{"tag":"a","props":{"href":"/ja/tip/09-24"},"children":[{"tag":"span","props":{},"children":["24"]},"漫画の中国語化、映画・ドラマの無断転載、クラウドストレージ資源の共有、海賊版電子書籍の配布は、無償であっても著作権侵害。広告掲載や会員費の徴収があれば、刑事罰の対象となる可能性あり"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/ja/tip/09-25","data-status":"active"},"children":[{"tag":"span","props":{},"children":["25"]},"二次創作を出版・販売する場合は、まず原作者の許諾を得るか、借りたキャラクター名や関係性を自分のものに書き換える"]},{"tag":"a","props":{"href":"/ja/tip/09-26"},"children":[{"tag":"span","props":{},"children":["26"]},"護身のため伸縮警棒、電撃器、短剣、催涙スプレーを買って携帯しない。車内に置くのも携帯に当たる"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"現在地"},"children":[{"tag":"a","props":{"href":"/ja/book"},"children":["本を読む"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/ja/book/09"},"children":["第9章"," ·"," ","一般人が陥りやすい法律のレッドライン"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"09-25"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["25"]},{"tag":"span","props":{"className":"life-evidence grade-b"},"children":["エビデンス"," ","B"]}]},{"tag":"h1","props":{"lang":"ja"},"children":["二次創作を出版・販売する場合は、まず原作者の許諾を得るか、借りたキャラクター名や関係性を自分のものに書き換える"]},{"tag":"p","props":{"lang":"ja","className":"life-entry-summary"},"children":["二次創作は、たとえキャラクターの名前、性格、関係性を借りただけであっても、出版すれば著作権侵害と判断される可能性があります。江南（ジャン・ナン）の『此間の少年』は、金庸（ジン・ヨン）の作品から60人以上のキャラクターを借用しており、二審では168万元の賠償に加え、20万元の費用支払いが命じられました。裁判は9年続き、最終的には「今後、同じ内容での再版を行わない」という条件で和解に至りました。無料で楽しむための二次創作については、裁判所は「個別のケースごとに分析が必要」としています。"]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["費用・手間"]},{"tag":"p","props":{},"children":["費用はかかりません。ただし、出版や販売を行う前には、必ず原著の権利者とライセンス交渉を行ってください。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["効果"]},{"tag":"p","props":{},"children":["江南の小説『此間の少年』は郭靖、黄蓉、喬峰、令狐冲など金庸作品の人物名を使い、大学生活を描きました。"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"記録する：二次創作を出版・販売する場合は、まず原作者の許諾を得るか、借りたキャラクター名や関係性を自分のものに書き換える"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"できている"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"やることに追加"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"お気に入り"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"このヒントを共有"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"詳細を閉じる"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["費用・手間"]},{"tag":"p","props":{},"children":["費用はかかりません。ただし、出版や販売を行う前には、必ず原著の権利者とライセンス交渉を行ってください。交渉が成立しない場合は、借りてきたキャラクターの名前、性格、人間関係を自分自身のものに書き換えてください。書名、サブタイトル、キャッチコピーにも、原著の名を借りて宣伝することは避けてください。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["効果"]},{"tag":"p","props":{},"children":["江南の小説『此間の少年』は郭靖、黄蓉、喬峰、令狐冲など金庸作品の人物名を使い、大学生活を描きました。2002 年出版時の副題は「射雕英雄の大学生活」でした。提訴時には複数の版で 100 万部以上発行されていました。金庸は 2016 年、江南と出版側に 500 万元を請求しました。一審は、具体的な筋書きから離れた名前・関係・性格だけでは保護される具体的表現にしにくいとして、著作権侵害を否定しました。ただし原作の名声で読者を集めた不正競争は認め、累計印税 560 万元の 30% の 168 万元と弁護士費用 20 万元を命じました。広州知的財産法院の二審は著作権侵害へ変更しました。筋書きは実質的に類似せず盗用ではないが、60 人以上から成る「人物群像」の名前、性格、関係、背景は金庸の選択・配列で、著作権法で保護される表現としました。江南は金庸の 4 作品を侵害し、副題を『射雕英雄伝』と意図的に関連づけたことは不正競争にも当たるとしました。江南に不正競争の停止、新聞への掲載による影響除去、168 万元と合理的費用 20 万元の賠償を命じ、出版・販売会社 2 社はそのうち 33 万元の連帯責任を負いました。二審は侵害停止を命じず、再版時に印税の 30% を原著作権者へ払うよう求めました。双方は広東省高級人民法院に再審を申請し、2025 年 9 月 19 日、同法院の調停で和解しました。各当事者は「剽窃」と位置づけないことに同意しました。江南は著作権の法律知識が足りず、金庸の翻案許諾を事前に得ず、損害を与えたと認めました。そのままの再版をやめ、今後の再版では金庸作品の独創的な人物名や関連内容を使わないと約束しました。副題が不正競争に当たることも確認し、二審の賠償は支払い済みです。調停書受領後、一・二審判決はともに法的効力を失いました。別の事件は『鬼吹灯』作者・張牧野（筆名、天下霸唱）です。2006 年、作品の著作権の財産権を上海玄霆娱乐信息科技有限公司へすべて譲渡しました。その後、新作『摸金校尉』の出版を許諾し、『鬼吹灯』の人物名、関係、墓荒らしの規則を使いました。表紙には『鬼吹灯』原作の映画『尋龍訣』のポスターを使いました。玄霆は 2000 万元を請求しました。上海浦東法院は独立した筋書きがあり著作権侵害ではないが、表紙で『尋龍訣』の原作と関連があると誤認させる虚偽宣伝を認定しました。出版・販売会社 2 社に 90 万元、出版社にはうち 60 万元の連帯責任を命じ、二審も維持しました。法文上、翻案権は作品を変更し独創的な新作を作る権利です。許諾なしに翻案、翻訳、注釈などで使用すれば、侵害停止、損害賠償などの民事責任を負います（全国）。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["出典"]},{"tag":"p","props":{"className":"life-citations"},"children":["广州知识产权法院 (2023). 金庸诉江南「同人作品第一案」有何深意（转载《法制与新闻》2023 年 7 月上期）. ",{"tag":"a","props":{"href":"https://www.gipc.gov.cn/front/content.action?id=7b7cb9a7b2cc45f286199fd427fc6b1f","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gipc.gov.cn/front/content.action?id=7b7cb9a7b2cc45f286199fd427fc6b1f"]},"；广东省高级人民法院 (2025). 「金庸诉江南」著作权及不正当竞争纠纷案在粤达成和解. ",{"tag":"a","props":{"href":"https://www.gdcourts.gov.cn/xwzx/fayuanxinmeiti/content/post_1843458.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gdcourts.gov.cn/xwzx/fayuanxinmeiti/content/post_1843458.html"]},"；国家版权局 (2020). 2019 年度上海十大版权典型案件发布（上海市版权局发布，案例六：「鬼吹灯」著作权侵权及不正当竞争纠纷案）. ",{"tag":"a","props":{"href":"https://www.ncac.gov.cn/xxfb/ywxx/202004/t20200430_47269.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.ncac.gov.cn/xxfb/ywxx/202004/t20200430_47269.html"]},"；全国人大常委会 (2020). 著作权法（2020 年修正，第三条，第十条第一款第十四项，第五十二条第六项，第五十四条）. ",{"tag":"a","props":{"href":"http://www.npc.gov.cn/npc/c2/c30834/202011/t20201119_308796.html","target":"_blank","rel":"noopener noreferrer"},"children":["http://www.npc.gov.cn/npc/c2/c30834/202011/t20201119_308796.html"]}]},{"tag":"a","props":{"href":"https://www.gipc.gov.cn/front/content.action?id=7b7cb9a7b2cc45f286199fd427fc6b1f","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["出典を開く"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["著者の注記"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["受益者はあなた自身です。同人の法律上の境界がまだ確定していないので B としています。両審の結論は異なり、最後は調停で終わり、両判決とも効力を失いました。広東高院の担当裁判官は、和解は当事者だけを拘束し、同人の侵害は具体的な状況ごとに判断し一律には言えないと説明しました。判断は三つです。共通部分が抽象的な発想か具体的表現か、その表現は原作者の独創か、適正使用など非侵害の例外か。題材・設定だけを借りる場合と、人物名、性格、関係を一式借りる場合ではリスクが違います。無料公開の同人について公式の裁判事例は見つかりませんでした。著作権法に「無料なら侵害ではない」という例外もありません。手続きの負担もあります。この件は 2016 年 7 月の提訴から 2025 年 9 月の和解まで 9 年、一審、二審、再審審査を経て、金庸は二審中に亡くなりました。原作者でも権利譲渡後の続編で買い手に訴えられます。天下霸唱がその例です。勝訴側の侵害停止の合理的費用は賠償に含められ、この件の一審の 20 万元は弁護士費用でした。翻訳・転載・共有のリスクは本節第24項（漫画翻訳、映像作品の転載）を参照してください。"]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["自分のメモ"]},{"tag":"button","props":{"type":"button"},"children":["自分へのメモを書く…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/ja/tip/09-24"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["前へ"]},"漫画の中国語化、映画・ドラマの無断転載、クラウドストレージ資源の共有、海賊版電子書籍の配布は、無償であっても著作権侵害。広告掲載や会員費の徴収があれば、刑事罰の対象となる可能性あり"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/ja/tip/09-26"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["次へ"]},"護身のため伸縮警棒、電撃器、短剣、催涙スプレーを買って携帯しない。車内に置くのも携帯に当たる"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none