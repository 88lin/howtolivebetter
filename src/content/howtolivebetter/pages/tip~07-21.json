n":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["成本"]},{"tag":"p","props":{},"children":["机场、火车站的候车区通常不花钱。快餐店、网吧得花点钱消费。睡不踏实，财物有被偷的风险。难在一整夜都不敢真睡。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["收益"]},{"tag":"p","props":{},"children":["在 24 小时营业场所能撑过一夜，有厕所，也能充电。那里安不安全，没有官方数字。救助站这边，民政部要求救助热线全天畅通，实行 24 小时值班。遇困的人上门求助，按政策先给救助。务工没着落、被偷被抢、一下子没了生活来源的，可以拿到应急的过渡性生活保障。有条件的地方会把社区服务中心这类场所开成临时庇护场所。冬天还会引导遇困的人去救助站或者临时避寒场所。不愿进站的，巡查人员会给吃的、衣物和保暖用品，并留下求助方式。夜里、降温和雨雪冰冻时，巡查会加密。车站码头、地下通道、桥梁涵洞、在建工地是重点巡查的地方（全国，民政部门从 2013 年起连年开展冬季专项救助）"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["原始出处"]},{"tag":"p","props":{"className":"life-citations"},"children":["作者经验（24 小时营业场所部分）；民政部办公厅 (2022). 关于扎实做好「寒冬送温暖」专项救助行动的通知（第二、三、四、五部分；第三部分：「保证救助热线全天畅通，及时响应求助线索，对前来求助的遇困人员按政策规定先行实施救助」）. ",{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/2022-12/11/content_5731351.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/zhengce/zhengceku/2022-12/11/content_5731351.htm"]},"；民政部、中央政法委、公安部等 11 部门 (2020). 关于开展生活无着的流浪乞讨人员救助管理服务质量大提升专项行动的通知（民发〔2020〕14 号，第二部分第三项：「要持续做好极端天气下『寒冬送温暖』、『夏季送清凉』等专项救助工作」）. ",{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/2020-03/24/content_5494916.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/zhengce/zhengceku/2020-03/24/content_5494916.htm"]},"；民政部 (2003). 城市生活无着的流浪乞讨人员救助管理办法实施细则（民政部令第 24 号，第二、三、五条）. ",{"tag":"a","props":{"href":"https://www.gov.cn/gongbao/content/2003/content_62510.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/gongbao/content/2003/content_62510.htm"]}]},{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/2022-12/11/content_5731351.htm","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["打开来源链接"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["原书备注"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["安全风险是真的存在。财物贴身放好，不接陌生人递的饮料和食物，避开偏僻角落。夜间不要露宿在桥洞、河边、工地。极端天气里露宿会出人命。救助站管哪些吃住、发不发车票，见第 4 条（走投无路时去救助站）。救助站只收自己解决不了吃住、又没有亲友可投靠的人。进站要如实说清自己的情况，拒不说的不予救助。上面民政部的要求出自 2022 年冬天那份通知，各地每年另发当年的安排，以当地为准。有些场所半夜会清场，不要和安保起冲突。"]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["我的备注"]},{"tag":"button","props":{"type":"button"},"children":["写下对自己有用的提醒…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/tip/07-20"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"