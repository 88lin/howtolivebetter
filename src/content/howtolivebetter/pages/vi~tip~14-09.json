51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Chia sẻ mẹo này"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Ẩn chi tiết"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Chi phí"]},{"tag":"p","props":{},"children":["Không tốn tiền. Khi bị yêu cầu quét mặt, hãy hỏi một câu「có cách xác minh nào khác không」. Bên kia nói không thì yêu cầu họ đưa ra một cách. Khó là phải mở miệng hỏi trực tiếp."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Lợi ích"]},{"tag":"p","props":{},"children":["人脸识别技术应用安全管理办法 ghi rõ:「实现相同目的或者达到同等业务要求，存在其他非人脸识别技术方式的，不得将人脸识别技术作为唯一验证方式。个人不同意通过人脸信息进行身份验证的，应当提供其他合理、便捷的方式。」Quy chế còn ghi:「任何组织和个人不得以办理业务、提升服务质量等为由，误导、欺诈、胁迫个人接受人脸识别技术验证个人身份。」Khi xử lý thông tin khuôn mặt dựa trên sự đồng ý của bạn thì phải có「在充分知情的前提下自愿、明确作出的单独同意」: hỏi riêng về đúng việc này, và bạn gật đầu riêng thì mới tính. Bạn có quyền rút lại sự đồng ý, bên xử lý phải đưa ra cách rút lại thuận tiện. Xử lý thông tin khuôn mặt của người chưa đủ mười bốn tuổi phải có sự đồng ý của cha mẹ hoặc người giám hộ khác. Lắp thiết bị nhận diện khuôn mặt ở nơi công cộng thì phải「应当为维护公共安全所必需」, và phải đặt biển báo hiển thị rõ ràng. Bên trong các không gian riêng tư nằm trong nơi công cộng như phòng khách sạn, phòng tắm công cộng, phòng thay đồ công cộng, nhà vệ sinh công cộng, không tổ chức hay cá nhân nào được lắp. Thông tin khuôn mặt phải được lưu trong thiết bị nhận diện khuôn mặt, không được truyền ra ngoài qua mạng internet. Có hai trường hợp ngoại lệ: luật hoặc quy định hành chính có quy định khác, hoặc đã có sự đồng ý riêng（toàn quốc, có hiệu lực từ ngày 1 tháng 6 năm 2025）"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Nguồn gốc"]},{"tag":"p","props":{"className":"life-citations"},"children":["国家互联网信息办公室、公安部 (2025). 人脸识别技术应用安全管理办法（第 19 号令，第十条、十二条、十三条，2025 年 6 月 1 日起施行）. ",{"tag":"a","props":{"href":"https://www.cac.gov.cn/2025-03/21/c_1744174262156096.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.cac.gov.cn/2025-03/21/c_1744174262156096.htm"]}]},{"tag":"a","props":{"href":"https://www.cac.gov.cn/2025-03/21/c_1744174262156096.htm","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Liên kết mở nguồn"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Ghi chú sách"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["Thường gặp nhất là cổng vào chung cư, nền tảng cho thuê nhà, phòng gym, khách sạn yêu cầu bạn đăng ký khuôn mặt. Khi bên kia nói 「hệ thống chỉ hỗ trợ quét khuôn mặt」 thì hãy đọc nguyên văn quy định cho họ nghe. Nguyên văn là: 「Đạt được cùng một mục đích hoặc đáp ứng yêu cầu kinh doanh tương đương, nếu có phương thức khác ngoài công nghệ nhận diện khuôn mặt, thì không được sử dụng công nghệ nhận diện khuôn mặt làm phương thức xác thực duy nhất」. Sau đó yêu cầu họ cung cấp các phương thức khác như quẹt thẻ, mật khẩu hoặc giấy tờ tùy thân. Nếu vẫn không cung cấp, hãy phản ánh với cơ quan quản lý thông tin mạng địa phương. Nhà nước có quy định riêng về xác thực danh tính bằng khuôn mặt, ví dụ một số tình huống tài chính và hành chính công, thì tuân thủ các quy định đó. Sự khác biệt lớn nhất giữa khuôn mặt và mật khẩu là khi bị rò rỉ thì không thể thay đổi, nên nó đáng được xem xét cẩn trọng hơn mật khẩu. Tổ chức lưu trữ thông tin khuôn mặt của hơn 100.000 người phải báo cáo với cơ quan quản lý thông tin mạng cấp tỉnh trở lên trong vòng 30 ngày làm việc, đây cũng là một cách để hỏi xem bên kia có hợp pháp hay không. Quyền xem, sửa, xóa thông tin cá nhân của chính mình xem mục 8. Việc người khác mượn khuôn mặt của bạn để làm thủ tục vay tiền cho họ là một vấn đề khác, xem mục 8, điều 45."]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Ghi chú của tôi"]},{"tag":"button","props":{"type":"button"},"children":["Viết một lời nhắc cho chính bạn…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/vi/tip/14-08"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Trước"]},"Bạn có quyền xem, sao chép, sửa và xóa thông tin cá nhân của mình, bị từ chối thì có thể kiện"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/vi/tip/14-10"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Tiếp theo"]},"Đừng giao mã nguồn, khóa và dữ liệu riêng tư cho «trạm trung chuyển AI» không rõ nguồn, nhất là khi cho AI tự chạy lệnh"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["Thêm trong chủ đề này"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/14-02"},"children":[{"tag":"strong","props":{},"children":["Đặt mật khẩu riêng cho email, không dùng lại ở bất kỳ trang nào khác"]},{"tag":"span","props":{},"children":["Mật khẩu bị lộ ở trang khác sẽ được dùng để đăng nhập thẳng vào email…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/14-03"},"children":[{"tag":"strong","props":{},"children":["Đặt mật khẩu khóa màn hình điện thoại, đặt mã PIN cho thẻ SIM"]},{"tag":"span","props":{},"children":["Thẻ SIM là cái thẻ nhỏ trong điện thoại, mã xác minh tin nhắn nhận qu…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/14-04"},"children":[{"tag":"strong","props":{},"children":["Điện thoại bị mất thì làm theo đúng thứ tự này: báo mất thẻ SIM, khóa từ xa, đổi mật khẩu, báo công an, phong tỏa thẻ ngân hàng"]},{"tag":"span","props":{},"children":["Thứ tự quan trọng hơn tốc độ. Bước đầu tiên là báo mất thẻ SIM, đường…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/14-05"},"children":[{"tag":"strong","props":{},"children":["Thẻ bị dùng ăn cắp: báo mất và phong tỏa trước, báo công an sau, rồi yêu cầu ngân hàng bồi thường; chứng minh「là chính bạn đã dùng thẻ」là trách nhiệm của ngân hàng"]},{"tag":"span","props":{},"children":["Khi thẻ bị người khác dùng ăn cắp, bạn không cần chứng minh「đây không…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/14-06"},"children":[{"tag":"strong","props":{},"children":["Cứ một thời gian lại xem thiết bị đã đăng nhập và các ứng dụng đã cấp quyền của tài khoản, cái nào không dùng thì dọn đi"]},{"tag":"span","props":{},"children":["«Thiết bị đăng nhập» là điện thoại và máy tính hiện còn dùng được tài…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/14-07"},"children":[{"tag":"strong","props":{},"children":["Đừng bấm「đồng ý tất cả」chỉ để dùng ứng dụng: với thông tin không bắt buộc, bạn không đồng ý thì họ không được phép từ chối dịch vụ"]},{"tag":"span","props":{},"children":["Ứng dụng xin thông tin của bạn, nếu không phải thông tin bắt buộc để …"]}]}]}]},{"tag":"a","props":{"className":"life-text-link","href":"/vi/book/14"},"children":["Đọc toàn bộ chủ đề: Tài khoản và an toàn thông tin"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"15","height":"15","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},