,{"tag":"a","props":{"href":"/tip/27-09","className":""},"children":[{"tag":"span","props":{},"children":["09"]},"想要无痛分娩就直接说，它不增加剖宫产的风险"]},{"tag":"a","props":{"href":"/tip/27-10","className":""},"children":[{"tag":"span","props":{},"children":["10"]},"没有医学指征就别主动要求剖宫产，也别为了挑日子开刀"]},{"tag":"a","props":{"href":"/tip/27-11","className":""},"children":[{"tag":"span","props":{},"children":["11"]},"怀孕前就确认生育保险的参保状态，未就业的配偶也能报生育医疗费用"]},{"tag":"a","props":{"href":"/tip/27-12","className":""},"children":[{"tag":"span","props":{},"children":["12"]},"出院前把《出生医学证明》办掉，名字提前想好、别写错字"]},{"tag":"a","props":{"href":"/tip/27-13","className":""},"children":[{"tag":"span","props":{},"children":["13"]},"新生儿足跟血筛查和听力筛查都别拒绝"]},{"tag":"a","props":{"href":"/tip/27-14","className":""},"children":[{"tag":"span","props":{},"children":["14"]},"拿到出生医学证明就给孩子办居民医保，别等落完户"]},{"tag":"a","props":{"href":"/tip/27-15","className":""},"children":[{"tag":"span","props":{},"children":["15"]},"孩子出生后一个月以内去派出所申报出生登记"]},{"tag":"a","props":{"href":"/tip/27-16","className":""},"children":[{"tag":"span","props":{},"children":["16"]},"产后 42 天那次复查别跳过，它在一些地方同时是产后抑郁的筛查"]},{"tag":"a","props":{"href":"/tip/27-17","className":""},"children":[{"tag":"span","props":{},"children":["17"]},"怀孕了不用把猫送走，猫砂换别人每天铲，肉要做熟、碰土戴手套"]},{"tag":"a","props":{"href":"/tip/27-18","className":""},"children":[{"tag":"span","props":{},"children":["18"]},"怀孕期间赶上流感季就打一针流感灭活疫苗，孕期哪个阶段都能打，别用鼻喷的"]},{"tag":"a","props":{"href":"/tip/27-19","className":""},"children":[{"tag":"span","props":{},"children":["19"]},"怀孕 28 周以后入睡时侧着躺，左侧右侧都行，别仰面躺着睡"]},{"tag":"a","props":{"href":"/tip/27-20","className":"active"},"children":[{"tag":"span","props":{},"children":["20"]},"生完孩子恢复同房就要避孕，喂奶不等于避孕；想要下一胎，至少隔 18 个月再怀"]}]}]},{"tag":"div","props":{"className":"life-tip-page","data-tip-locales":"zh"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"当前位置"},"children":[{"tag":"a","props":{"href":"/book"},"children":["阅读全书"]},{"tag":"span","props":{"ari