"children":[]}]}]}]}]},{"tag":"div","props":{"className":"life-ad-layout life-ad-layout-toc"},"children":[{"tag":"div","props":{"className":"life-ad-rail","data-dock-active":"false","style":{"top":"94px"}},"children":[{"tag":"div","props":{"className":"life-ad-dock","hidden":true},"children":[{"tag":"aside","props":{"className":"life-ad-space life-ad-space-sponsored life-ad-space-compact","data-ad-placement":"ad_dock","data-ad-group":"reading","data-ad-creative":"read_product","data-ad-ready":"false","aria-label":"Реклама · Рекомендация сообщества"},"children":[{"tag":"button","props":{"type":"button","className":"life-ad-dismiss","aria-label":"Закрыть рекламу"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-x","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M18 6 6 18"},"children":[]},{"tag":"path","props":{"d":"m6 6 12 12"},"children":[]}]}]},{"tag":"div","props":{"className":"life-ad-space-brand"},"children":[{"tag":"img","props":{"src":"/sites/howtolivebetter/images/shengcai/logo.png","width":"565","height":"144","alt":"Официальный логотип Shengcai Youshu","decoding":"async"},"children":[]}]},{"tag":"div","props":{"className":"life-ad-space-copy"},"children":[{"tag":"span","props":{"className":"life-ad-space-label"},"children":["Реклама · Рекомендация сообщества"]},{"tag":"strong","props":{},"children":["Могут ли ваши знания стать полезным продуктом?"]},{"tag":"p","props":{},"children":["От электронных книг до инструментов: как участники находят потребности и создают то, чем можно пользоваться."]}]},{"tag":"div","props":{"className":"life-ad-space-actions"},"children":[{"tag":"a","props":{"className":"life-ad-space-link","href":"/ru/shengcaiyoushu?sc_group=reading&sc_creative=read_product&sc_placement=ad_dock"},"children":["О сообществе и примерах",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"18","height":"18","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-up-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M7 7h10v10"},"children":[]},{"tag":"path","props":{"d":"M7 17 17 7"},"children":[]}]}]}]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/ru/book/12"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"К содержанию"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["Открытие бизнеса: как не потерять все сбережения"]},{"tag":"div","props":{"data-ad-dock-host":"true"},"children":[]},{"tag":"nav","props":{"aria-label":"Советы главы"},"children":[{"tag":"a","props":{"href":"/ru/tip/12-01"},"children":[{"tag":"span","props":{},"children":["01"]},"Инвестируйте только те средства, которые можете позволить себе потерять — не трогайте семейные сбережения и не берите кредиты"]},{"tag":"a","props":{"href":"/ru/tip/12-02"},"children":[{"tag":"span","props":{},"children":["02"]},"Не ставьте личную гарантию за компанию, а супругу тем более не вовлекайте"]},{"tag":"a","props":{"href":"/ru/tip/12-03"},"children":[{"tag":"span","props":{},"children":["03"]},"Правильный выбор формы бизнеса до открытия: при индивидуальном предпринимательстве и обычном партнерстве ответственность неограниченна, а в ООО она «ограничена»"]},{"tag":"a","props":{"href":"/ru/tip/12-04"},"children":[{"tag":"span","props":{},"children":["04"]},"Неправомерное включение в число акционеров — риск нести чужие долги"]},{"tag":"a","props":{"href":"/ru/tip/12-05"},"children":[{"tag":"span","props":{},"children":["05"]},"Перед подписанием договора проверьте наличие регистрации в Министерстве коммерции и получите письменную информацию; обязательно включите в договор условие о «периоде раздумий»"]},{"tag":"a","props":{"href":"/ru/tip/12-06"},"children":[{"tag":"span","props":{},"children":["06"]},"Перед регистрацией нужно определить название, место ведения бизнеса, сферу деятельности и размер уставного капитала — при наличии всех документов бизнес-лицензию выдадут сразу"]},{"tag":"a","props":{"href":"/ru/tip/12-07"},"children":[{"tag":"span","props":{},"children":["07"]},"Бизнес, требующий лицензии: начинать работу можно только после её получения"]},{"tag":"a","props":{"href":"/ru/tip/12-08"},"children":[{"tag":"span","props":{},"children":["08"]},"Определите, к какой категории вы относитесь: для производства продуктов питания и ресторанного бизнеса требуется разрешение, для продажи только готовой упакованной продукции достаточно регистрации, а для продажи свежих овощей и мяса разрешение не нужно"]},{"tag":"a","props":{"href":"/ru/tip/12-09"},"children":[{"tag":"span","props":{},"children":["09"]},"Упаковка продукта делает его предварительно упакованной пищевой продукцией: на этикетке обязательно указываются дата производства, срок годности и состав"]},{"tag":"a","props":{"href":"/ru/tip/12-10"},"children":[{"tag":"span","props":{},"children":["10"]},"На обычные продукты питания нельзя указывать, что они лечат болезни: это касается этикеток, инструкций, рекламы и текстов для прямых трансляций"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/ru/tip/12-11","data-status":"active"},"children":[{"tag":"span","props":{},"children":["11"]},"В этой сфере действуют уголовные нормы: продажа мяса от больных животных или продукции с превышенным содержанием вредных веществ уже является преступлением; добавление в пищу токсичных и вредных веществ влечет наказание от 5 лет лишения свободы независимо от суммы оборота"]},{"tag":"a","props":{"href":"/ru/tip/12-12"},"children":[{"tag":"span","props":{},"children":["12"]},"После получения бизнес-лицензии возникает обязанность по подаче налоговой отчетности; даже при отсутствии дохода её нужно подавать с нуля (заполняя все поля нулями)"]},{"tag":"a","props":{"href":"/ru/tip/12-13"},"children":[{"tag":"span","props":{},"children":["13"]},"Счета-фактуры выписываются только по реальным сделкам; малые предприятия могут полностью освободиться от НДС"]},{"tag":"a","props":{"href":"/ru/tip/12-14"},"children":[{"tag":"span","props":{},"children":["14"]},"Мошенники выдают себя за сотрудников налоговой службы и требуют оплаты и подачи деклараций; на самом деле это обман. Официальные каналы для налоговых дел — электронная налоговая система и горячая линия 12366"]},{"tag":"a","props":{"href":"/ru/tip/12-15"},"children":[{"tag":"span","props":{},"children":["15"]},"При написании «задаток» вместо «предоплата» соблюдайте правила двойного возврата, четко пропишите размер неустойки, а предоставление отсрочки платежа рассматривайте как выдачу займа"]},{"tag":"a","props":{"href":"/ru/tip/12-16"},"children":[{"tag":"span","props":{},"children":["16"]},"Заключение письменного трудового договора в первый месяц работы и регистрация в соцстрахе в течение 30 дней"]},{"tag":"a","props":{"href":"/ru/tip/12-17"},"children":[{"tag":"span","props":{},"children":["17"]},"Зарплата выплачивается согласно договору и закону; повышения, займы и премии оформляются письменно"]},{"tag":"a","props":{"href":"/ru/tip/12-18"},"children":[{"tag":"span","props":{},"children":["18"]},"Продавать сначала, а потом производить: проверить спрос через предзаказы и мелкие заказы, прежде чем вкладывать средства в производство"]},{"tag":"a","props":{"href":"/ru/tip/12-19"},"children":[{"tag":"span","props":{},"children":["19"]},"Сначала сверяем образец с перечнем требований для массового производства, а потом приступаем к запуску"]},{"tag":"a","props":{"href":"/ru/tip/12-20"},"children":[{"tag":"span","props":{},"children":["20"]},"Сохраняйте документы и эти поставщика; не закупайте товары по цене, значительно ниже рыночной: если сотрудник привез подделку, ответственность несет руководитель"]},{"tag":"a","props":{"href":"/ru/tip/12-21"},"children":[{"tag":"span","props":{},"children":["21"]},"Для товаров, упаковки, этикеток и рекламных изображений нужно либо создавать графику самостоятельно, либо покупать лицензию; изменение цвета или добавление своего значка не считается «изменением»"]},{"tag":"a","props":{"href":"/ru/tip/12-22"},"children":[{"tag":"span","props":{},"children":["22"]},"Соблюдение установленных правил на рабочем месте и чёткое понимание ответственности при проявлении доброй воли вне этих рамок"]},{"tag":"a","props":{"href":"/ru/tip/12-23"},"children":[{"tag":"span","props":{},"children":["23"]},"Если убытки — действуйте по процедуре: при возможности проводите упрощённую ликвидацию, а если активы не покрывают долги — подавайте на банкротство, не оставляйте дело без внимания"]},{"tag":"a","props":{"href":"/ru/tip/12-24"},"children":[{"tag":"span","props":{},"children":["24"]},"Прежде чем тратить деньги на аутсорсинг управления интернет-магазином, курсы по открытию магазина или схему «без собственного товара», выясните, потребуются ли дополнительные расходы и откуда возьмётся продажная статистика"]},{"tag":"a","props":{"href":"/ru/tip/12-25"},"children":[{"tag":"span","props":{},"children":["25"]},"Компании и индивидуальные предприниматели в Китае ежегодно с 1 января по 30 июня подают онлайн отчёт за прошлый год, даже без деятельности; отчёт бесплатен"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"Навигация"},"children":[{"tag":"a","props":{"href":"/ru/book"},"children":["Книга"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/ru/book/12"},"children":["Глава 12"," ·"," ","Открытие бизнеса: как не потерять все сбережения"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"12-11"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["11"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["Доказательства"," ","A"]}]},{"tag":"h1","props":{"lang":"ru"},"children":["В этой сфере действуют уголовные нормы: продажа мяса от больных животных или продукции с превышенным содержанием вредных веществ уже является преступлением; добавление в пищу токсичных и вредных веществ влечет наказание от 5 лет лишения свободы независимо от суммы оборота"]},{"tag":"p","props":{"lang":"ru","className":"life-entry-summary"},"children":["Предыдущие пункты предусматривали штрафы, а этот пункт карает самих виновных. Продажа мяса от больных животных, не прошедшего проверку, либо продукции с критически высоким содержанием пестицидов, лекарственных препаратов или тяжелых металлов уже является преступлением, даже если никто не пострадал; за такое грозит до 3 лет лишения свободы. Добавление в пищу токсичных и вредных веществ, не предназначенных для употребления в пищу, наказывается лишением свободы от 5 лет независимо от суммы оборота."]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Затраты"]},{"tag":"p","props":{},"children":["Не требует никаких затрат. Следуйте рекомендациям из пункт…"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Польза"]},{"tag":"p","props":{},"children":["Статья 143 Уголовного кодекса регулирует подобные случаи: если производимая или продаваемая пищевая продукция…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"Отметить: В этой сфере действуют уголовные нормы: продажа мяса от больных животных или продукции с превышенным содержанием вредных веществ уже является преступлением; добавление в пищу токсичных и вредных веществ влечет наказание от 5 лет лишения свободы независимо от суммы оборота"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"Сделано"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"В планах"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"В избранное"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Поделиться советом"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Скрыть подробности"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Затраты"]},{"tag":"p","props":{},"children":["Не требует никаких затрат. Следуйте рекомендациям из пункта 8: сначала определите, к какой категории относится ваш бизнес, затем сохраняйте все сертификаты ветеринарного контроля и документы о закупках, а в составе продукции указывайте только те ингредиенты, для которых имеются официальные разрешения."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Польза"]},{"tag":"p","props":{},"children":["Статья 143 Уголовного кодекса регулирует подобные случаи: если производимая или продаваемая пищевая продукция не соответствует нормам безопасности и «достаточно» для вызывания тяжелого пищевого отравления или других серьезных заболеваний, это уже преступление. За такое грозит до 3 лет лишения свободы или арест, а также штраф. Если же нанесен серьезный вред здоровью или есть иные тяжелые обстоятельства, наказание увеличивается до 3–7 лет лишения свободы с штрафом. В случае особо тяжких последствий — от 7 лет лишения свободы до пожизненного заключения с конфискацией имущества. Статья 144 карает добавление в пищу токсичных и вредных веществ, не предназначенных для употребления в пищу, или их продажу с заведомым знанием об этом; наказание — до 5 лет лишения свободы с штрафом. При серьезном вреде здоровью или иных тяжелых обстоятельствах срок увеличивается до 5–10 лет с штрафом. Если в результате употребления продукции наступила смерть или есть иные особо тяжкие обстоятельства, применяется статья 141 (от 10 лет лишения свободы до пожизненного заключения или смертной казни). В соответствующем разъяснении Верховного суда и Верховной прокуратуры перечислены ситуации, когда можно говорить о «достаточности» для вызывания тяжелого пищевого отравления: наличие патогенных микроорганизмов, пестицидов, лекарственных препаратов, токсинов или тяжелых металлов сверх допустимых норм; мясо больных животных, не прошедшее проверку; продукция, запрещенная к производству и продаже по санитарным причинам; детское питание или специальные диетические продукты с критически неправильным составом. Превышение допустимых норм добавления пищевых добавок, если это приводит к этот последствиям, также квалифицируется по статье 143. Перечень вредных веществ определяется законом: это запрещенные к использованию в пищевой промышленности химикаты, а также вещества из официальных списков, утвержденных государственными органами (например, запрещенные пестициды и лекарства для животных). Также к «тяжелым обстоятельствам» относится оборот на сумму от 100 тысяч до 200 тысяч юаней, продажа в школах, детских садах, домах престарелых, а также незаконная частная резка скота вне специализированных предприятий; за такое грозит наказание по статье о незаконной предпринимательской деятельности. Оборот от 100 тысяч юаней или чистая прибыль от 50 тысяч юаней уже считаются «тяжелыми обстоятельствами» по всей стране."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Первоисточники"]},{"tag":"p","props":{"className":"life-citations"},"children":["全国人大常委会 (2020 年修正). 刑法（第一百四十一、一百四十三、一百四十四条）. ",{"tag":"a","props":{"href":"https://flk.npc.gov.cn/detail?id=ff808181796a636a0179822a19640c92","target":"_blank","rel":"noopener noreferrer"},"children":["https://flk.npc.gov.cn/detail?id=ff808181796a636a0179822a19640c92"]},"（国家法律法规数据库）；最高人民法院、最高人民检察院 (2021). 关于办理危害食品安全刑事案件适用法律若干问题的解释（法释〔2021〕24 号，第一、二、五、七、九、十七、十八条，2022 年 1 月 1 日起施行）. ",{"tag":"a","props":{"href":"https://scjg.hebei.gov.cn/info/79117","target":"_blank","rel":"noopener noreferrer"},"children":["https://scjg.hebei.gov.cn/info/79117"]},"（河北省市场监督管理局转载全文）、",{"tag":"a","props":{"href":"https://sft.ln.gov.cn/sft/ywgz/zfflgw/xzys/2525860BD0F843EFA7A3B7FDC330614E/index.shtml","target":"_blank","rel":"noopener noreferrer"},"children":["https://sft.ln.gov.cn/sft/ywgz/zfflgw/xzys/2525860BD0F843EFA7A3B7FDC330614E/index.shtml"]},"（辽宁省司法厅转载全文，两份逐字核对一致）"]},{"tag":"a","props":{"href":"https://flk.npc.gov.cn/detail?id=ff808181796a636a0179822a19640c92","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Открыть источник"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Примечание автора"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["Отличие этого пункта от предыдущих заключается в том, затрагивает ли он вопросы пищевой безопасности напрямую. Нарушения вроде отсутствия лицензии, неверных этикеток или ложных заявлений о пользе продукта наказываются штрафами. А вот продажа мяса от больных животных, продукции с превышенным содержанием вредных веществ, неправильное использование добавок или добавление в пищу запрещенных ингредиентов уже влечет уголовную ответственность. Самый простой способ защиты — соблюдение рекомендаций из пункта 8: закупать мясо только в специализированных мясокомбинатах, сохранять все сертификаты ветеринарного контроля и документы о качестве, а в составе продукции указывать только те ингредиенты, для которых есть разрешения. Чаще всего нарушения по этому пункту возникают при использовании так называемого «дешевого мяса» или «неизвестных остатков сырья». Изначальная ссылка на официальный сайт Верховного суда вернула ошибку 502, поэтому для перевода были использованы два официальных региональных источника, тексты которых были взаимно сверены по словам."]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Моя заметка"]},{"tag":"button","props":{"type":"button"},"children":["Запишите напоминание…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/ru/tip/12-10"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Предыдущий"]},"На обычные продукты питания нельзя указывать, что они лечат болезни: это касается этикеток, инструкций, рекламы и текстов для прямых трансляций"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/ru/tip/12-12"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Следующий"]},"После получения бизнес-лицензии возникает обязанность по подаче налоговой отчетности; даже при отсутствии дохода её нужно подавать с нуля (заполняя все поля нулями)"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["Другие советы по этой теме"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/12-07"},"children":[{"tag":"strong","pro