 12h2"},"children":[]},{"tag":"path","props":{"d":"M20 12h2"},"children":[]},{"tag":"path","props":{"d":"m6.34 17.66-1.41 1.41"},"children":[]},{"tag":"path","props":{"d":"m19.07 4.93-1.41 1.41"},"children":[]}]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"17","height":"17","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-moon life-theme-icon-dark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"},"children":[]}]}]},{"tag":"button","props":{"type":"button","className":"life-language-switch","aria-label":"Español Elegir idioma","aria-haspopup":"menu","aria-expanded":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-globe","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]},{"tag":"path","props":{"d":"M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"},"children":[]},{"tag":"path","props":{"d":"M2 12h20"},"children":[]}]},{"tag":"span","props":{},"children":["Español"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]}]},{"tag":"a","props":{"className":"life-account","href":"/es/sign-in"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"17","height":"17","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle-user-round","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M18 20a6 6 0 0 0-12 0"},"children":[]},{"tag":"circle","props":{"cx":"12","cy":"10","r":"4"},"children":[]},{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},{"tag":"span","props":{},"children":["Iniciar sesión"]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/es/book/33"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"Volver al índice"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["Cómo vivir después de una discapacidad"]},{"tag":"nav","props":{"aria-label":"Consejos del capítulo"},"children":[{"tag":"a","props":{"href":"/es/tip/33-01"},"children":[{"tag":"span","props":{},"children":["01"]},"Después de una lesión medular, si aparece un dolor de cabeza intenso y sudoración repentina, primero hay que ayudar a la persona a sentarse erguida, aflojarle la ropa y llamar al 120"]},{"tag":"a","props":{"href":"/es/tip/33-02"},"children":[{"tag":"span","props":{},"children":["02"]},"Los primeros diez años tras la discapacidad son el periodo de mayor riesgo de suicidio; no lo trate como algo que se resuelve «animándose»"]},{"tag":"a","props":{"href":"/es/tip/33-03"},"children":[{"tag":"span","props":{},"children":["03"]},"La hospitalización por trastorno mental se rige por el principio de voluntariedad; solo hay dos supuestos en los que se puede ingresar sin el consentimiento de la persona"]},{"tag":"a","props":{"href":"/es/tip/33-04"},"children":[{"tag":"span","props":{},"children":["04"]},"Quien cuida a largo plazo de la persona con discapacidad de la casa también necesita que alguien vigile su propio cuerpo"]},{"tag":"a","props":{"href":"/es/tip/33-05"},"children":[{"tag":"span","props":{},"children":["05"]},"Para quien pasa muchas horas en silla de ruedas: cambie el cojín por uno de descarga de presión y revise a diario la zona del isquion y el coxis"]},{"tag":"a","props":{"href":"/es/tip/33-06"},"children":[{"tag":"span","props":{},"children":["06"]},"No compre terapias ni aparatos que prometan «curar la parálisis, la ceguera o la sordera»"]},{"tag":"a","props":{"href":"/es/tip/33-07"},"children":[{"tag":"span","props":{},"children":["07"]},"Una vez obtenido el certificado de discapacidad, pregunte de una sola vez en la federación de personas con discapacidad del condado todo lo que se puede solicitar"]},{"tag":"a","props":{"href":"/es/tip/33-08"},"children":[{"tag":"span","props":{},"children":["08"]},"Si el niño tiene menos de 7 años y además una discapacidad o autismo, solicite en la federación de personas con discapacidad del condado la ayuda a la rehabilitación"]},{"tag":"a","props":{"href":"/es/tip/33-09"},"children":[{"tag":"span","props":{},"children":["09"]},"Las rampas, los pasamanos y la reforma del baño de la casa pueden optar a una subvención del gobierno de nivel de condado o superior"]},{"tag":"a","props":{"href":"/es/tip/33-10"},"children":[{"tag":"span","props":{},"children":["10"]},"Al buscar empleo en China, indique que tiene certificado de discapacidad: contratarle puede reducir un pago obligatorio de la empresa"]},{"tag":"a","props":{"href":"/es/tip/33-11"},"children":[{"tag":"span","props":{},"children":["11"]},"El impuesto sobre la renta de las personas físicas de una persona con discapacidad puede reducirse; cuánto, pregúntelo por teléfono a la administración tributaria provincial"]},{"tag":"a","props":{"href":"/es/tip/33-12"},"children":[{"tag":"span","props":{},"children":["12"]},"Los perros guía pueden entrar en lugares públicos y transporte público; las personas ciegas viajan gratis en el transporte urbano"]},{"tag":"a","props":{"href":"/es/tip/33-13"},"children":[{"tag":"span","props":{},"children":["13"]},"En la prueba nacional de acceso a la universidad, las personas con discapacidad pueden solicitar ajustes razonables; con examen en braille el tiempo se amplía la mitad"]},{"tag":"a","props":{"href":"/es/tip/33-14"},"children":[{"tag":"span","props":{},"children":["14"]},"Si un niño con discapacidad solicita la matrícula, la escuela no puede rechazarlo; si no puede llegar al centro, la oficina de educación organiza la enseñanza a domicilio"]},{"tag":"a","props":{"href":"/es/tip/33-15"},"children":[{"tag":"span","props":{},"children":["15"]},"Sin la pierna derecha o sin ambas piernas también se puede sacar el permiso de conducir: la clase de vehículo se llama C5"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/es/tip/33-16","data-status":"active"},"children":[{"tag":"span","props":{},"children":["16"]},"La rehabilitación hágase en instituciones serias con servicio de medicina de rehabilitación, con la intensidad que indique el terapeuta: no es cuanto más fuerte mejor"]},{"tag":"a","props":{"href":"/es/tip/33-17"},"children":[{"tag":"span","props":{},"children":["17"]},"Ante la pérdida de audición, colóquese audífonos; la razón de ponerlos es oír, no prevenir la demencia"]},{"tag":"a","props":{"href":"/es/tip/33-18"},"children":[{"tag":"span","props":{},"children":["18"]},"Declarar que un adulto «no puede regirse por sí mismo» exige una solicitud al tribunal; la familia no decide sola"]},{"tag":"a","props":{"href":"/es/tip/33-19"},"children":[{"tag":"span","props":{},"children":["19"]},"El tutor de un adulto se designa por el orden legal; si la persona bajo tutela lesiona a alguien, responde el tutor"]},{"tag":"a","props":{"href":"/es/tip/33-20"},"children":[{"tag":"span","props":{},"children":["20"]},"Si le rechazan por discapacidad en la contratación, no le hacen fijo o le pagan menos, puede demandar, pero primero calcule bien el coste del proceso"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"Ruta de navegación"},"children":[{"tag":"a","props":{"href":"/es/book"},"children":["Libro"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/es/book/33"},"children":["Capítulo 33"," ·"," ","Cómo vivir después de una discapacidad"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"33-16"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["16"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["Evidencia"," ","A"]}]},{"tag":"h1","props":{"lang":"es"},"children":["La rehabilitación hágase en instituciones serias con servicio de medicina de rehabilitación, con la intensidad que indique el terapeuta: no es cuanto más fuerte mejor"]},{"tag":"p","props":{"lang":"es","className":"life-entry-summary"},"children":["Llevarse a la persona a casa a que esté tumbada esperando la recuperación natural es el error más frecuente de esta etapa. Los cuidados organizados de un equipo multidisciplinar consiguen que más gente siga viva al año y siga viviendo en su propia casa. Pero tampoco hay que pasarse al revés y subir la dosis por cuenta propia. En un ensayo con más de dos mil personas, la actividad más temprana, más frecuente y de mayor volumen en las primeras 24 horas tras el ictus dio, a los tres meses, resultados peores. Cuánto ejercitar y cuándo lo decide el servicio de rehabilitación y el terapeuta."]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Coste"]},{"tag":"p","props":{},"children":["La rehabilitación hospitalaria cuesta unos cientos de yuan…"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Beneficio"]},{"tag":"p","props":{},"children":["Una revisión sistemática Cochrane incluyó 29 ensayos con 5902 participantes y comparó los cuidados organizados…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"Marcar: La rehabilitación hágase en instituciones serias con servicio de medicina de rehabilitación, con la intensidad que indique el terapeuta: no es cuanto más fuerte mejor"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"Hecho"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"Por hacer"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"Guardar"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Compartir consejo"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Ocultar detalles"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Coste"]},{"tag":"p","props":{},"children":["La rehabilitación hospitalaria cuesta unos cientos de yuanes al día; la parte no cubierta varía según el lugar. El tiempo se mide por meses. Hay que ejercitar todos los días, y es monótono."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Beneficio"]},{"tag":"p","props":{},"children":["Una revisión sistemática Cochrane incluyó 29 ensayos con 5902 participantes y comparó los cuidados organizados en una unidad de ictus hospitalaria con otras formas de cuidado. Al final del seguimiento (mediana de 1 año), la razón de ventajas (odds ratio) del desenlace adverso (muerte, discapacidad o necesidad de cuidados institucionales) fue 0,77 (IC del 95 % 0,69–0,87, intervalo de credibilidad), la de muerte 0,76 (IC del 95 % 0,66–0,88) y la de muerte o dependencia de otros 0,75 (IC del 95 % 0,66–0,85), con calidad de evidencia moderada. Convertido a números absolutos, por cada 100 personas atendidas en una unidad de ictus hay 2 más que sobreviven, 6 más que viven en su casa y 6 más que se valen por sí mismas. En el otro lado, el ensayo AVERT asignó al azar en 56 unidades de ictus agudo de 5 países a 2104 pacientes, comparando «cuidado habitual» y «cuidado habitual más actividad de alta intensidad ultra temprana». A los tres meses, con buen desenlace (escala de Rankin modificada 0—2 puntos) había 480 personas (46 %) en el grupo ultra temprano y 525 (50 %) en el habitual, con razón de ventajas ajustada de 0,73 (IC del 95 % 0,59–0,90, P=0,004). Las muertes fueron 88 frente a 72, sin diferencia demostrada (razón de ventajas 1,34, IC del 95 % 0,93–1,93, P=0,113)"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Fuentes originales"]},{"tag":"p","props":{"className":"life-citations"},"children":["Langhorne P, Ramachandra S; Stroke Unit Trialists' Collaboration (2020). Organised inpatient (stroke unit) care for stroke: network meta-analysis. Cochrane Database of Systematic Reviews, 4:CD000197. ",{"tag":"a","props":{"href":"https://doi.org/10.1002/14651858.CD000197.pub4","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1002/14651858.CD000197.pub4"]},"；AVERT Trial Collaboration group (2015). Efficacy and safety of very early mobilisation within 24 h of stroke onset (AVERT): a randomised controlled trial. Lancet, 386(9988):46-55. ",{"tag":"a","props":{"href":"https://doi.org/10.1016/S0140-6736(15)60690-0","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1016/S0140-6736(15)60690-0"]}]},{"tag":"a","props":{"href":"https://doi.org/10.1002/14651858.CD000197.pub4","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Abrir fuente"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Nota del autor"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["Controversia: ambas pruebas vienen del ictus; extenderlas a lesión medular, amputación, quemaduras y otras causas de discapacidad es una extrapolación. Lo que muestra AVERT es que «cuanto más temprano y más fuerte» no se sostiene, no que «la actividad temprana no sirve». En el ensayo, la gran mayoría de ambos grupos ya estaba de pie fuera de la cama en las primeras 24 horas; lo que difería era la frecuencia y el volumen total. Al elegir institución, mire si tiene servicio de medicina de rehabilitación y terapeutas de rehabilitación y terapia ocupacional en plantilla; no se fíe solo del rótulo que ponga «rehabilitación». Cómo derivan entre la atención primaria y los hospitales de tercer nivel y cómo se cuenta el umbral de pago, véase la sección 24, entrada 1 (derivación escalonada). El lado de la rehabilitación comunitaria y la dotación de productos de apoyo está en la entrada 7 de esta sección (pregunte en la federación del condado hasta agotar todo)."]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Mi nota"]},{"tag":"button","props":{"type":"button"},"children":["Escribe un recordatorio…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/es/tip/33-15"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Anterior"]},"Sin la pierna derecha o sin ambas piernas también se puede sacar el permiso de conducir: la clase de vehículo se llama C5"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/es/tip/33-17"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Siguiente"]},"Ante la pérdida de audición, colóquese audífonos; la razón de ponerlos es oír, no prevenir la demencia"]},{"tag":"svg","pro