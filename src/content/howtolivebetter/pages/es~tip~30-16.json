ag":"path","props":{"d":"M20 12h2"},"children":[]},{"tag":"path","props":{"d":"m6.34 17.66-1.41 1.41"},"children":[]},{"tag":"path","props":{"d":"m19.07 4.93-1.41 1.41"},"children":[]}]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"17","height":"17","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-moon life-theme-icon-dark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"},"children":[]}]}]},{"tag":"button","props":{"type":"button","className":"life-language-switch","aria-label":"Español Elegir idioma","aria-haspopup":"menu","aria-expanded":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-globe","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]},{"tag":"path","props":{"d":"M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"},"children":[]},{"tag":"path","props":{"d":"M2 12h20"},"children":[]}]},{"tag":"span","props":{},"children":["Español"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]}]},{"tag":"a","props":{"className":"life-account","href":"/es/sign-in"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"17","height":"17","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle-user-round","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M18 20a6 6 0 0 0-12 0"},"children":[]},{"tag":"circle","props":{"cx":"12","cy":"10","r":"4"},"children":[]},{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},{"tag":"span","props":{},"children":["Iniciar sesión"]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/es/book/30"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"Volver al índice"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["Los niños en edad escolar"]},{"tag":"nav","props":{"aria-label":"Consejos del capítulo"},"children":[{"tag":"a","props":{"href":"/es/tip/30-01"},"children":[{"tag":"span","props":{},"children":["01"]},"Si el niño dice que le empezó un dolor fuerte y repentino y que va en aumento, al hospital de inmediato; no lo dejes aguantar hasta la salida de clases"]},{"tag":"a","props":{"href":"/es/tip/30-02"},"children":[{"tag":"span","props":{},"children":["02"]},"No retrases «hasta después de los exámenes» un tratamiento que toca hacer: algunas ventanas siguen la edad ósea, no el calendario de exámenes"]},{"tag":"a","props":{"href":"/es/tip/30-03"},"children":[{"tag":"span","props":{},"children":["03"]},"Si el niño sufre acoso escolar, repórtalo a la escuela ese mismo día y exige respuesta por escrito; si hay golpes, extorsión de dinero o difusión de rumores, llama directamente a la policía"]},{"tag":"a","props":{"href":"/es/tip/30-04"},"children":[{"tag":"span","props":{},"children":["04"]},"Que el niño pase al menos 2 horas al día al aire libre: es la única medida contra la miopía que hoy cuenta con un ensayo aleatorizado"]},{"tag":"a","props":{"href":"/es/tip/30-05"},"children":[{"tag":"span","props":{},"children":["05"]},"De 0 a 3 años, ninguna pantalla; de 3 a 6, cuantas menos mejor; escolares, sin fines de estudio, no más de 1 hora al día"]},{"tag":"a","props":{"href":"/es/tip/30-06"},"children":[{"tag":"span","props":{},"children":["06"]},"Toma la miopía como un daño que se queda: a más graduación, más desprendimiento de retina, degeneración macular y glaucoma más adelante"]},{"tag":"a","props":{"href":"/es/tip/30-07"},"children":[{"tag":"span","props":{},"children":["07"]},"El informe del chequeo médico escolar de cada año revísalo tú mismo; los datos anormales, al hospital ese mismo año"]},{"tag":"a","props":{"href":"/es/tip/30-08"},"children":[{"tag":"span","props":{},"children":["08"]},"Haz a los hijos de 12 a 18 años una criba de depresión, y no tomes la evaluación psicológica de la escuela por un diagnóstico"]},{"tag":"a","props":{"href":"/es/tip/30-09"},"children":[{"tag":"span","props":{},"children":["09"]},"No compres productos ni servicios que prometan «curar la miopía» o «reducir las graduaciones»"]},{"tag":"a","props":{"href":"/es/tip/30-10"},"children":[{"tag":"span","props":{},"children":["10"]},"Sueño, deberes, educación física y clasificaciones por notas tienen norma escrita, y a la escuela se le puede reclamar"]},{"tag":"a","props":{"href":"/es/tip/30-11"},"children":[{"tag":"span","props":{},"children":["11"]},"Si el niño no da más, puede suspender los estudios: la escuela está obligada a conservarle la matrícula, hasta 1 año"]},{"tag":"a","props":{"href":"/es/tip/30-12"},"children":[{"tag":"span","props":{},"children":["12"]},"Si el chequeo revela mala visión, ve al hospital para una refracción con dilatación de la pupila y después vuelve a los controles en el intervalo que indique el médico"]},{"tag":"a","props":{"href":"/es/tip/30-13"},"children":[{"tag":"span","props":{},"children":["13"]},"Sellado de fosas y fisuras en los primeros molares permanentes"]},{"tag":"a","props":{"href":"/es/tip/30-14"},"children":[{"tag":"span","props":{},"children":["14"]},"Si su hijo es adicto a los videojuegos, primero observe si se han visto desplazados el sueño, las tareas y las actividades al aire libre; no se limite solo a vigilar cuánto tiempo juega"]},{"tag":"a","props":{"href":"/es/tip/30-15"},"children":[{"tag":"span","props":{},"children":["15"]},"Si tu hijo dice que le gusta el mismo sexo, no lo regañes, no lo eches de casa, no lo envíes a «reeducación»: la actitud de la familia está relacionada con su riesgo de suicidio"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/es/tip/30-16","data-status":"active"},"children":[{"tag":"span","props":{},"children":["16"]},"No golpee a su hijo ni grite llamándolo estúpido: los niños a menudo golpeados o insultados muestran más problemas de conducta y emocionales"]},{"tag":"a","props":{"href":"/es/tip/30-17"},"children":[{"tag":"span","props":{},"children":["17"]},"Si la crianza se le va de las manos y sigue golpeando o gritando, haga un curso que enseñe habilidades parentales concretas"]},{"tag":"a","props":{"href":"/es/tip/30-18"},"children":[{"tag":"span","props":{},"children":["18"]},"No envíes a tu hijo a «escuelas para curar la adicción a internet» ni a «campamentos especiales» cerrados: la ley prohíbe métodos que dañen cuerpo y mente, y ya han muerto niños encerrados"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"Ruta de navegación"},"children":[{"tag":"a","props":{"href":"/es/book"},"children":["Libro"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/es/book/30"},"children":["Capítulo 30"," ·"," ","Los niños en edad escolar"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"30-16"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["16"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["Evidencia"," ","A"]}]},{"tag":"h1","props":{"lang":"es"},"children":["No golpee a su hijo ni grite llamándolo estúpido: los niños a menudo golpeados o insultados muestran más problemas de conducta y emocionales"]},{"tag":"p","props":{"lang":"es","className":"life-entry-summary"},"children":["Los niños castigados físicamente con frecuencia muestran más agresión y problemas psicológicos, más distancia con los padres y golpes más duros. Si un cachete hace obedecer al instante, la evidencia no lo deja claro. Los adolescentes a los que a los 13 años gritan o llaman estúpidos con frecuencia muestran más conductas problemáticas y depresión al año siguiente; la crianza cálida no cancela ese vínculo."]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Coste"]},{"tag":"p","props":{},"children":["Sin dinero. Lo difícil es frenar manos y boca en el calor…"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Beneficio"]},{"tag":"p","props":{},"children":["Para castigo físico, un metaanálisis contó solo nalgadas con la mano abierta en nalgas o extremidades. Agrupó…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"Marcar: No golpee a su hijo ni grite llamándolo estúpido: los niños a menudo golpeados o insultados muestran más problemas de conducta y emocionales"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"Hecho"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"Por hacer"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"Guardar"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Compartir consejo"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Ocultar detalles"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Coste"]},{"tag":"p","props":{},"children":["Sin dinero. Lo difícil es frenar manos y boca en el calor del momento y pasar a una disciplina no violenta. Qué hacer en su lugar: véase el punto 17 de esta sección (escuelas para padres con habilidades concretas)."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Beneficio"]},{"tag":"p","props":{},"children":["Para castigo físico, un metaanálisis contó solo nalgadas con la mano abierta en nalgas o extremidades. Agrupó 75 estudios con 111 tamaños del efecto y 160.927 niños. De 17 resultados, 13 se asociaron significativamente con las nalgadas, todos en dirección dañina. Cohen’s d: 0,2 pequeño, 0,5 mediano. Agresión infantil d = 0,37 (IC del 95% 0,13–0,61). Problemas externalizantes 0,41 (golpes, incumplimiento de normas). Internalizantes 0,24 (ansiedad, depresión). Problemas de salud mental 0,53. Mala relación padre-hijo 0,51. Baja autoestima 0,15. Capacidad cognitiva baja 0,17. Maltrato físico parental 0,64. Conducta antisocial adulta 0,36. Salud mental adulta 0,24. En conjunto sobre 111 efectos d = 0,33 (0,29–0,38). El cumplimiento inmediato no quedó claramente vinculado (d = 0,14, −0,19–0,47), con solo 5 tamaños del efecto. Otra revisión de 69 estudios longitudinales encontró que las nalgadas predecían de forma fiable problemas de conducta posteriores y ningún beneficio a largo plazo; en 7 estudios midieron frecuencia, en 5 más nalgadas se vincularon a peores resultados. Por gritos: un estudio en EE. UU. siguió a 976 familias con dos progenitores. Gritos frecuentes, insultos o llamar al niño estúpido o perezoso a los 13 años predijeron más conductas problemáticas y síntomas depresivos entre los 13 y 14 años. El cariño parental no compensó la asociación; también al revés — más conductas problemáticas a los 13 predijeron más gritos después. Según el artículo 2 de la Ley china contra la violencia doméstica, la violencia doméstica incluye golpes, ataduras, mutilación, restricción de la libertad personal e insultos o intimidación habituales. El artículo 12 exige a los tutores practicar una educación familiar civilizada. Cuando los padres perjudican los derechos del niño, los comités de barrio deben aconsejar, detenerlos y denunciar casos graves a la policía. Seguridad pública, fiscalía y tribunales pueden amonestar a los padres y ordenar orientación en educación familiar (a nivel nacional)."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Fuentes originales"]},{"tag":"p","props":{"className":"life-citations"},"children":["Gershoff ET, Grogan-Kaylor A. (2016). Spanking and child outcomes: Old controversies and new meta-analyses. Journal of Family Psychology, 30(4), 453–469. ",{"tag":"a","props":{"href":"https://doi.org/10.1037/fam0000191","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1037/fam0000191"]},"；Heilmann A, Mehay A, Watt RG, et al. (2021). Physical punishment and child outcomes: a narrative review of prospective studies. Lancet, 398(10297), 355–364. ",{"tag":"a","props":{"href":"https://doi.org/10.1016/S0140-6736(21)00582-1","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1016/S0140-6736(21)00582-1"]},"；Wang MT, Kenny S. (2014). Longitudinal links between fathers' and mothers' harsh verbal discipline and adolescents' conduct problems and depressive symptoms. Child Development, 85(3), 908–923. ",{"tag":"a","props":{"href":"https://doi.org/10.1111/cdev.12143","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1111/cdev.12143"]},"；Ferguson CJ. (2013). Spanking, corporal punishment and negative long-term outcomes: a meta-analytic review of longitudinal studies. Clinical Psychology Review, 33(1), 196–208. ",{"tag":"a","props":{"href":"https://doi.org/10.1016/j.cpr.2012.11.002","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1016/j.cpr.2012.11.002"]},"；Larzelere RE, Kuhn BR. (2005). Comparing child outcomes of physical punishment and alternative disciplinary tactics: a meta-analysis. Clinical Child and Family Psychology Review, 8(1), 1–37. ",{"tag":"a","props":{"href":"https://doi.org/10.1007/s10567-005-2340-z","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1007/s10567-005-2340-z"]},"；全国人大常委会 (2015). 反家庭暴力法（第二、十二条）. ",{"tag":"a","props":{"href":"https://flk.npc.gov.cn/detail?id=2c909fdd678bf17901678bf7f9d60889","target":"_blank","rel":"noopener noreferrer"},"children":["https://flk.npc.gov.cn/detail?id=2c909fdd678bf17901678bf7f9d60889"]},"；全国人大常委会 (2024 年修正). 未成年人保护法（第十一、十七、一百一十八条）. ",{"tag":"a","props":{"href":"https://flk.npc.gov.cn/detail?id=ff8081818f197cf001905e567af635a0","target":"_blank","rel":"noopener noreferrer"},"children":["https://flk.npc.gov.cn/detail?id=ff8081818f197cf001905e567af635a0"]},"；全国人大常委会 (2021). 家庭教育促进法（第二十三、五十三条）. ",{"tag":"a","props":{"href":"https://flk.npc.gov.cn/detail?id=ff8081817cac3b2d017cac5a6c6f0109","target":"_blank","rel":"noopener noreferrer"},"children":["https://flk.npc.gov.cn/detail?id=ff8081817cac3b2d017cac5a6c6f0109"]}]},{"tag":"a","props":{"href":"https://doi.org/10.1037/fam0000191","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Abrir fuente"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Nota del autor"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["Controvertido. Casi todos los estudios son observacionales, no ensayos aleatorizados, así que la causalidad no está clara. En el metaanálisis de nalgadas, el 72% de los estudios fueron transversales o basados en recuerdo. Un metaanálisis de estudios longitudinales encontró que, tras ajustar por conducta previa del niño, los vínculos con problemas externalizantes cayeron a 0,07 e internalizantes a 0,10; esos autores juzgaron los efectos pequeños. Otro metaanálisis encontró que las nalgadas «condicionales» superaron a 10 de 13 métodos alternativos para reducir la desobediencia y la conducta antisocial, pero nalgadas severas o predominantes lo hicieron peor que las alternativas. Críticos y partidarios coinciden en que golpes frecuentes y fuertes e insultos habituales son peores. Un cachete o grito ocasional no se etiqueta explícitamente como violencia doméstica en la ley, que nombra golpes e insultos o intimidación habituales. Principales beneficiarios: los niños. Si otra persona en la familia golpea al niño, véase la sección 8, punto 43 (órdenes de protección personal). Cualquiera puede disuadir o denunciar maltrato crónico a la policía, asuntos civiles o educación; en hogares ajenos, llamar al 110 o avisar al comité de barrio basta — no entre a la fuerza."]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Mi nota"]},{"tag":"button","props":{"type":"button"},"children":["Escribe un recordatorio…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/es/tip/30-15"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Anterior"]},"Si tu hijo dice que le gusta el mismo sexo, no lo regañes, no lo eches de casa, no lo envíes a «reeducación»: la actitud de la familia está relacionada con su riesgo de suicidio"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/es/tip/30-17"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Siguiente"]},"Si la crianza se le va de las manos y sigue golpeando o gritando, haga un curso que