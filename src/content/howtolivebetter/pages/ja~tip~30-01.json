nejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"詳細を閉じる"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["費用・手間"]},{"tag":"p","props":{},"children":["費用はかかりません。半日休みを取り、お子さんを連れて救急外来を受診してください。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["効果"]},{"tag":"p","props":{},"children":["30件の症例報告と2116例の精巣捻転患者を規定通りに集め、まとめて検討した。そのうち1283例は6時間ごとの区分で統計されている。疼痛開始から0〜6時間における精巣の温存率は97.2%である。7〜12時間は79.3%、13〜18時間は61.3%であった。19 ～ 24 時間 42.5%。25 ～ 48 時間 24.4%。48 時間を超えると 7.4%。まとめて見ると、12 時間以内は 90.4%、13 ～ 24 時間は 54.0%、24 時間を超えると 18.1%。著者の結論は、維持できる時間は通常言われている 6 ～ 8 時間よりも長くなり得るということである。ですから、たとえ長い間痛みを感じていたとしても、対処しに行くべきです。「どうせもう遅すぎる」という理由で行かないという選択はしないでください"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["出典"]},{"tag":"p","props":{"className":"life-citations"},"children":["Mellick LB, et al. (2019). A Systematic Review of Testicle Survival Time After a Torsion Event. Pediatric Emergency Care. ",{"tag":"a","props":{"href":"https://doi.org/10.1097/PEC.0000000000001287","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1097/PEC.0000000000001287"]}]},{"tag":"a","props":{"href":"https://doi.org/10.1097/PEC.0000000000001287","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["出典を開く"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["著者の注記"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["事前に男の子に伝えておきましょう：「もし下半身に突然の激痛を感じたら、すぐに言ってね。恥ずかしがる必要はないよ」と。精巣捻転は思春期の男の子に多く見られますが、言い出しにくいために無理に我慢してしまう人が少なくありません。同様に時間との戦いとなるものには、急性虫垂炎（放置すると穿孔の恐れあり）、糖尿病ケトアシドーシス、髄膜炎などがあります。本節では、これらすべてについて「数時間の遅れでどれほど悪化するか」を個別に検証したわけではありません。共通するサインは、「突然の発症」「進行性の悪化」「これまでの痛みとは明らかに違う」という点です。緊急事態の見分け方や、タクシーの呼び方については、第 13 節を参照してください。"]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["自分のメモ"]},{"tag":"button","props":{"type":"button"},"children":["自分へのメモを書く…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"span","props":{},"children":[]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/ja/tip/30-02"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["次へ"]},"すべき治療を「試験が終わるまで」と先延ばしにしないで。治療の適期は骨の成長とともにあり、試験の予定には左右されません"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]