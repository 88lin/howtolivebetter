"tag":"path","props":{"d":"m19.07 4.93-1.41 1.41"},"children":[]}]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"17","height":"17","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-moon life-theme-icon-dark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"},"children":[]}]}]},{"tag":"button","props":{"type":"button","className":"life-language-switch","aria-label":"日本語 言語を選ぶ","aria-haspopup":"menu","aria-expanded":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-globe","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]},{"tag":"path","props":{"d":"M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"},"children":[]},{"tag":"path","props":{"d":"M2 12h20"},"children":[]}]},{"tag":"span","props":{},"children":["日本語"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]}]},{"tag":"a","props":{"className":"life-account","href":"/ja/sign-in"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"17","height":"17","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle-user-round","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M18 20a6 6 0 0 0-12 0"},"children":[]},{"tag":"circle","props":{"cx":"12","cy":"10","r":"4"},"children":[]},{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},{"tag":"span","props":{},"children":["ログイン"]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/ja/book/29"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"目次に戻る"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["重大な打撃を受けた後"]},{"tag":"nav","props":{"aria-label":"この章のヒント"},"children":[{"tag":"a","props":{"href":"/ja/tip/29-01"},"children":[{"tag":"span","props":{},"children":["01"]},"大切な人を亡くした直後の数日間は一人で過ごさないこと。心臓病、高血圧、糖尿病がある人は通常通り服薬を。胸に圧迫感や痛みを感じたら 120 に連絡してください"]},{"tag":"a","props":{"href":"/ja/tip/29-02"},"children":[{"tag":"span","props":{},"children":["02"]},"重大な病の診断を受けたその一週間は、一人で診断結果を受け取りに行かないこと。治療以外の決定は後回しにする"]},{"tag":"a","props":{"href":"/ja/tip/29-03"},"children":[{"tag":"span","props":{},"children":["03"]},"失業後は、まず生活リズム、医療保険、そして求職活動のペースを固定すること。一日中家に閉じこもらないこと"]},{"tag":"a","props":{"href":"/ja/tip/29-04"},"children":[{"tag":"span","props":{},"children":["04"]},"親族が自殺、事故、または事件で亡くなった場合、一人で耐えようとせず、積極的に専門的な助けを求めてください"]},{"tag":"a","props":{"href":"/ja/tip/29-05"},"children":[{"tag":"span","props":{},"children":["05"]},"配偶者を亡くした後の最初の半年間は、三食、睡眠、持病の薬、そして再検査の管理を、特定の誰かに任せて見守ってもらう"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/ja/tip/29-06","data-status":"active"},"children":[{"tag":"span","props":{},"children":["06"]},"親族も友人もいない場合は、「あなたを見守る存在」を3つのものに置き換えてください：自宅に入れる近隣住民、地域の訪問リスト、スマートフォンの緊急連絡先"]},{"tag":"a","props":{"href":"/ja/tip/29-07"},"children":[{"tag":"span","props":{},"children":["07"]},"親が亡くなった後、ありのままを伝え、お別れに立ち会わせ、環境を変えるために他の場所へ送らないこと"]},{"tag":"a","props":{"href":"/ja/tip/29-08"},"children":[{"tag":"span","props":{},"children":["08"]},"悲しみから半年経っても立ち直れず、日常生活が送れない場合は、精神科または臨床心理科を受診してください"]},{"tag":"a","props":{"href":"/ja/tip/29-09"},"children":[{"tag":"span","props":{},"children":["09"]},"いきなり悲嘆カウンセリングにお金を使う前に、自分の悲しみが本当に「停滞」しているかを確認しましょう（第 8 条の症状など）"]},{"tag":"a","props":{"href":"/ja/tip/29-10"},"children":[{"tag":"span","props":{},"children":["10"]},"別居・離婚後は健康保険を途切れさせない、お酒で紛らわさない"]},{"tag":"a","props":{"href":"/ja/tip/29-11"},"children":[{"tag":"span","props":{},"children":["11"]},"話し相手が必要な時は 12356 へ、未成年者・青少年は 12355 へ、医師を求めるなら心理外来へ"]},{"tag":"a","props":{"href":"/ja/tip/29-12"},"children":[{"tag":"span","props":{},"children":["12"]},"大きな変化の直後の3ヶ月間は、いかなる不可逆的な重大決定も、すべて後回しにする"]},{"tag":"a","props":{"href":"/ja/tip/29-13"},"children":[{"tag":"span","props":{},"children":["13"]},"死を借金返済の手段と考えてはいけない：2年以内の生命保険は不払い、労災も不認定、債務は変わらず遺産から差し押さえられる"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"現在地"},"children":[{"tag":"a","props":{"href":"/ja/book"},"children":["本を読む"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/ja/book/29"},"children":["第29章"," ·"," ","重大な打撃を受けた後"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"29-06"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["06"]},{"tag":"span","props":{"className":"life-evidence grade-b"},"children":["エビデンス"," ","B"]}]},{"tag":"h1","props":{"lang":"ja"},"children":["親族も友人もいない場合は、「あなたを見守る存在」を3つのものに置き換えてください：自宅に入れる近隣住民、地域の訪問リスト、スマートフォンの緊急連絡先"]},{"tag":"p","props":{"lang":"ja","className":"life-entry-summary"},"children":["親族も友人もいないときは、2つのことをケアする必要があります。それは、「何かあった時に誰かに気づいてもらうこと」と、「日頃、決まった時間に薬を飲み、食事をすること」です。服薬と食事は自分で行うものとして、記憶に頼らず、リスト化し、アラームを設定してください。誰かに気づいてもらうためには、3つの方法があります。近隣住民に予備の鍵を預けておく、地域の自治会（居委会）に行って訪問ケアのリストに入れられないか尋ねる、スマートフォンの緊急連絡先を設定し、電源を切らないようにする、の3点です。"]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["費用・手間"]},{"tag":"p","props":{},"children":["費用はかかりません。難しいのは、自分から積極的に口を開き、近隣住民や自治会に対して「一人暮らしで、最近、家庭内で不幸…"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["効果"]},{"tag":"p","props":{},"children":["44,573 名の外来患者は、すべて動脈硬化性血栓症のリスクまたは既往歴（血管内にプラークが形成され、血栓によって詰まりやすくなる疾患）を有しています。"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"記録する：親族も友人もいない場合は、「あなたを見守る存在」を3つのものに置き換えてください：自宅に入れる近隣住民、地域の訪問リスト、スマートフォンの緊急連絡先"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"できている"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"やることに追加"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"お気に入り"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"このヒントを共有"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"詳細を閉じる"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["費用・手間"]},{"tag":"p","props":{},"children":["費用はかかりません。難しいのは、自分から積極的に口を開き、近隣住民や自治会に対して「一人暮らしで、最近、家庭内で不幸がありました」と伝えることです。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["効果"]},{"tag":"p","props":{},"children":["44,573 名の外来患者は、すべて動脈硬化性血栓症のリスクまたは既往歴（血管内にプラークが形成され、血栓によって詰まりやすくなる疾患）を有しています。彼らはREACHという国際的なプロジェクトに多国籍の医師によって登録され、2003 年 12 月から 2004 年 12 月にかけて組み入れられ、4 年間にわたり追跡調査されました。そのうち 8,594 人（19%）が独居でした。独居者の 4 年間におけるあらゆる原因による死亡率は 14.1% であり、同居者は 11.1% でした。心血管死は 8.6% 対 6.8% でした。両者の log-rank P値は <0.01 であり、この差が偶然である可能性は低いです。年齢層による差は異なります（交互作用 P=0.03）。45歳から65歳において、独居は同居と比較して死亡リスクが7.7%対5.7%である。他の条件を調整した後のHRは1.24（95% CI 1.01–1.51）であり、約24%高い。66歳から80歳は13.2%対12.3%、HRは1.12（1.01–1.26）で、約10%高い。80歳以上は24.6%対28.4%、HRは0.92（0.79–1.06）であり、逆に上昇は見られなかった。民政部など10部門による2022年の意見書では、訪問ケアサービスの実施が規定されている。対象は、独居、空巣（子供がいない高齢者）、留守（農村部などに残された高齢者）、身体機能不全、重度障害、家族計画における特殊な家庭などの高齢者である。サービス形態は「定期的な戸別訪問、電話・ビデオ通話、遠隔モニタリング」である。町・街道による実態調査および村・居委会の協力を得て、基本情報と「訪問ケアサービスの受診意向」を把握し、基層網格化管理（区域ごとに担当者を割り当てて監視する仕組み）に組み込みます。2025年末までに「特別な困難を抱える高齢者の月間訪問率を100%に到達させることを確実にし」、「機能障害のある特別な困難を抱える高齢者に対しては、毎月1回以上の訪問ケアを行う」としています。また、家庭内へのスマートコールシステム、スマート電気・水道メーター、健康モニタリング製品、介護監視装置の導入を推奨しており、「異常を検知した際、速やかに警告を発し、緊急連絡先へ同時に通知メッセージを送信できる」ようにします。サービス担当者は、緊急事態を発見した際、「直ちに緊急通報電話への連絡を支援しなければならない」としています"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["出典"]},{"tag":"p","props":{"className":"life-citations"},"children":["Udell JA, et al. (2012). Living alone and cardiovascular risk in outpatients at risk of or with atherothrombosis. Archives of Internal Medicine. ",{"tag":"a","props":{"href":"https://doi.org/10.1001/archinternmed.2012.2782","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1001/archinternmed.2012.2782"]},"；民政部等十部门 (2022). 关于开展特殊困难老年人探访关爱服务的指导意见（民发〔2022〕73 号）. ",{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/2022-10/13/content_5718017.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/zhengce/zhengceku/2022-10/13/content_5718017.htm"]}]},{"tag":"a","props":{"href":"https://doi.org/10.1001/archinternmed.2012.2782","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["出典を開く"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["著者の注記"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["3つの具体的な対処法。1、予備の鍵やドアロックの臨時パスワードを近所の人や管理会社に預け、「ここ数日は一人でいます」と一言伝えておく。親しい仲である必要はなく、ただ誰かがあなたが家にいることを知っている状態にすることが重要。2、地域のコミュニティ委員会（居委会）へ行き、一人暮らしであることを伝えて、見守り訪問の対象リストに登録できないか確認する。高齢者の中でも独居、空巣、失独（子供を亡くした）は、公的に明確なサービス対象となっている。併せて、地域で無料設置可能なスマート呼び出し器やスマート水道メーターなどのデバイスがないかも聞いておく。3、スマートフォンの緊急連絡先と医療緊急カードを設定しておく。この数日間は、マナーモードや電源オフにしないこと。Bに伝えた理由は2点ある。一つは、独居と死亡率の関連性は、過去の集団データを振り返った研究によるもので、「もともと健康状態や生活環境が悪い人ほど独居しやすい」という逆の因果関係を排除しきれないこと。原文自体も、この結果にはさらなる確認が必要であると記している。二つ目は、見守り支援に関する文書が高齢者のみを対象としている点です。60歳未満には、それに対応する専用の制度がありません。期待できるのは、文書内の一条で、網格員やソーシャルワーカーに対し、「家庭内の急変、失業、中退などの心理的危機の兆候を適時に発見すること」を求めている点です（本節の第 11 条を参照。誰かがそばにいて、12356 を行うこと）。「家に誰かがいること」がいかに価値があるかは、第 13 節第 1 条（胸骨圧迫）をご覧ください。病院外で発生する心停止のうち、79.2% は自宅で発生しています。そばに圧迫処置を行う人がいる場合、生存して退院できる割合は 16.1% ですが、誰もいない場合はわずか 3.9% です。家に誰もいないということは、最も低い数値の層に属することを意味します。また、併せて行うべき二つの事務手続きがあります。葬儀の手続き自体、葬儀場、地域保健サービス機関、公安、公積金など、複数の窓口を回る必要があります（第 25 節を参照）。これを毎日一度外出する固定のスケジュールに組み込んでください。ここ数日間の外出予定はすでに用意されています。ホットラインは繰り返し電話することができ、一度しかかけられません（本節の第 11 条を参照。誰かに付き添ってもらって 12356 を行うこと）。「一人暮らし」自体が依然として長期的なリスク要因です。独居による死亡比率は 1.32 で、約3割高くなっています。第 22 節第 9 条を参照してください（定期的に人と会うことを健康への支出と考えること）。しかし、ここでは目の前の数日間のみを扱い、長期的な計算は別途行います。"]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["自分のメモ"]},{"tag":"button","props":{"type":"button"},"children":["自分へのメモを書く…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/ja/tip/29-05"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["前へ"]},"配偶者を亡くした後の最初の半年間は、三食、睡眠、持病の薬、そして再検査の管理を、特定の誰かに任せて見守ってもらう"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/ja/tip/29-07"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["次へ"]},"親が亡くなった後、ありのままを伝え、お別れに立ち会わせ、環境を変えるために他の場所へ送らないこと"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["このテーマの他の提案"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/29-02"},"children":[{"tag":"strong","props":{},"children":["重大な病の診断を受けたその一週間は、一人で診断結果を受け取りに行かないこと。治療以外の決定は後回しにする"]},{"tag":"span","props":{},"children":["癌の診断を受けた最初の1週間は、未診断の人に比べて自殺の確率が 12.6 倍、心血管疾患で死亡する確率は 5.6 倍になります。1年後には…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/29-03"},"children":[{"tag":"strong","props":{},"children":["失業後は、まず生活リズム、医療保険、そして求職活動のペースを固定すること。一日中家に閉じこもらないこと"]},{"tag":"span","props":{},"children":["失業後の死亡確率は、在職中の人よりも約6割高くなります。男性や若い世代においてより顕著で、最初の10年間が最も高い数値を示します。喫煙や飲…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/29-04"},"children":[{"tag":"strong","props":{},"children":["親族が自殺、事故、または事件で亡くなった場合、一人で耐えようとせず、積極的に専門的な助けを求めてください"]},{"tag":"span","props":{},"children":["配偶者が自殺で亡くなった人は、5年以内に精神障害と診断される確率が、一般の人より男性で約8割、女性で約7割高いです。他の原因で配偶者を亡く…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/29-08"},"children":[{"tag":"strong","props":{},"children":["悲しみから半年経っても立ち直れず、日常生活が送れない場合は、精神科または臨床心理科を受診してください"]},{"tag":"span","props":{},"children":["大切な人を亡くした成人の約10人に1人が、停滞状態に陥ることがあります。半年以上経っても、食事が喉を通らない、仕事に行けない、育児ができな…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/29-09"},"children":[{"tag":"strong","props":{},"children":["いきなり悲嘆カウンセリングにお金を使う前に、自分の悲しみが本当に「停滞」しているかを確認しましょう（第 8 条の症状など）"]},{"tag":"span","props":{},"children":["大切な人を亡くしたすべての人に心理カウンセリングを勧めることは、メリットが非常に少ないです。なぜなら、ほとんどの人は自然に立ち直っていくた…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/29-10"},"children":[{"tag":"strong","props":{},"children":["別居・離婚後は健康保険を途切れさせない、お酒で紛らわさない"]},{"tag":"span","props":{},"children":["別居や離婚をした人は、婚姻関係が続いている人に比べて早期死亡率が明らかに高く、特に男性や若い世代でその傾向が顕著です。これは必ずしも離婚そ…"]}]}]}]},{"tag":"a","props":{"className":"life-text-link","href":"/ja/book/29"},"children":["テーマ全体を読む：重大な打撃を受けた後"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"15","height":"15","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]}]}]},{"tag":"nav","props":{"className":"life-tabbar","aria-label":"メインナビゲーション"},"children":[{"tag":"a","props":{"className":"","href":"/ja/book"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"21","height":"21","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-book-open","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M12 7v14"},"children":[]},{"tag":"path","props":{"d":"M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z"},"children":[]}]},{"tag":"span","props":{},"children":["本"]}]},{"tag":"a","props":{"className":"","href":"/ja/top-50"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"21","height":"21","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-star","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 2.122 0 0 0-.611-1.879L2