ren":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"目次に戻る"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["アンチ・リスト"]},{"tag":"div","props":{"data-ad-dock-host":"true"},"children":[]},{"tag":"nav","props":{"aria-label":"この章のヒント"},"children":[{"tag":"a","props":{"href":"/ja/tip/06-01"},"children":[{"tag":"span","props":{},"children":["01"]},"長寿や心血管疾患の予防のためにマルチビタミンを摂取しないでください"]},{"tag":"a","props":{"href":"/ja/tip/06-02"},"children":[{"tag":"span","props":{},"children":["02"]},"心血管疾患の予防のために一般的なフィッシュオイルを摂取しないでください"]},{"tag":"a","props":{"href":"/ja/tip/06-03"},"children":[{"tag":"span","props":{},"children":["03"]},"ビタミンDが不足していない人に、長寿目的でビタミンDを補給しないでください"]},{"tag":"a","props":{"href":"/ja/tip/06-04"},"children":[{"tag":"span","props":{},"children":["04"]},"がん予防のために抗酸化サプリメント（β-カロテン、ビタミンE、ビタミンA）を摂取しないでください"]},{"tag":"a","props":{"href":"/ja/tip/06-05"},"children":[{"tag":"span","props":{},"children":["05"]},"グルコサミン/コンドロイチンで膝関節炎を治せると期待しないでください"]},{"tag":"a","props":{"href":"/ja/tip/06-06"},"children":[{"tag":"span","props":{},"children":["06"]},"ビタミンCに風邪の予防を期待しないでください"]},{"tag":"a","props":{"href":"/ja/tip/06-07"},"children":[{"tag":"span","props":{},"children":["07"]},"症状のない自分に対して「全身PET-CT」や「腫瘍マーカーセット」の検査を受けないでください"]},{"tag":"a","props":{"href":"/ja/tip/06-08"},"children":[{"tag":"span","props":{},"children":["08"]},"リストバンドやスマートウォッチによる運動量の数値化で減量できると期待しないでください"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/ja/tip/06-09","data-status":"active"},"children":[{"tag":"span","props":{},"children":["09"]},"「より健康に」なるために、割高なオーガニック食品を買わないでください"]},{"tag":"a","props":{"href":"/ja/tip/06-10"},"children":[{"tag":"span","props":{},"children":["10"]},"「体調を整える」ために、サプリメントや膏方、滋養食品に大金を投じない"]},{"tag":"a","props":{"href":"/ja/tip/06-11"},"children":[{"tag":"span","props":{},"children":["11"]},"腸の問題がない限り、プロバイオティクスを長期的に摂取しない"]},{"tag":"a","props":{"href":"/ja/tip/06-12"},"children":[{"tag":"span","props":{},"children":["12"]},"「免疫力を高める」ために、無理に冷水シャワーを浴びない"]},{"tag":"a","props":{"href":"/ja/tip/06-13"},"children":[{"tag":"span","props":{},"children":["13"]},"デトックス、腸洗浄、酵素、アルカリ水などの製品を買わないでください"]},{"tag":"a","props":{"href":"/ja/tip/06-14"},"children":[{"tag":"span","props":{},"children":["14"]},"「毎日 8 杯の水を飲む」という目標を満たすために、無理に水を飲まないでください"]},{"tag":"a","props":{"href":"/ja/tip/06-15"},"children":[{"tag":"span","props":{},"children":["15"]},"占いやタロット、星座占いで決断を下すために、お金を使わないでください"]},{"tag":"a","props":{"href":"/ja/tip/06-16"},"children":[{"tag":"span","props":{},"children":["16"]},"「視力を守る」ためにブルーライトカット眼鏡を買わないでください。また「数ヶ月画面を見続けると目がダメになる」という言葉も信じないでください。ただし、目の張り、痛み、充血は緊急事態として扱うべきです"]},{"tag":"a","props":{"href":"/ja/tip/06-17"},"children":[{"tag":"span","props":{},"children":["17"]},"献血を健康法と考えないでください：「デトックス、血中脂質低下、心筋梗塞予防」を裏付けるランダム化比較試験はありません。頻繁な献血は、本当に鉄欠乏を引き起こします"]},{"tag":"a","props":{"href":"/ja/tip/06-18"},"children":[{"tag":"span","props":{},"children":["18"]},"一般的な健康診断パッケージに頼って病気を防ごうとせず、年齢と性別に基づいた、エビデンスのある検査項目を受けましょう"]},{"tag":"a","props":{"href":"/ja/tip/06-19"},"children":[{"tag":"span","props":{},"children":["19"]},"尿酸値が高いと診断されても、痛風の発作が一度もない場合は、安易に降尿酸薬の服用を始めないでください"]},{"tag":"a","props":{"href":"/ja/tip/06-20"},"children":[{"tag":"span","props":{},"children":["20"]},"検診で胆石が見つかったからといって、痛みがないのに予防的に胆嚢を切除しないでください"]},{"tag":"a","props":{"href":"/ja/tip/06-21"},"children":[{"tag":"span","props":{},"children":["21"]},"腎結石予防のためにカルシウムを控えないでください"]},{"tag":"a","props":{"href":"/ja/tip/06-22"},"children":[{"tag":"span","props":{},"children":["22"]},"「運気転換」「金運アップ」「開運（養人）」のために、水晶、ブレスレット、貔貅（ピーシュ）などの品物を買わないでください"]},{"tag":"a","props":{"href":"/ja/tip/06-23"},"children":[{"tag":"span","props":{},"children":["23"]},"買い物で気分やステータスを改善しようと期待しないでください"]},{"tag":"a","props":{"href":"/ja/tip/06-24"},"children":[{"tag":"span","props":{},"children":["24"]},"「周囲のレベルに合わせる」ために、家や車、コミュニティを変えるために余計な出費をしないでください"]},{"tag":"a","props":{"href":"/ja/tip/06-25"},"children":[{"tag":"span","props":{},"children":["25"]},"「意志力は筋肉のように、使えばなくなる」という説を信じないでください"]},{"tag":"a","props":{"href":"/ja/tip/06-26"},"children":[{"tag":"span","props":{},"children":["26"]},"朝食を抜くことや 16:8 の間欠的断食で体重をコントロールしようと思わないでください。食事の時間は、長期的に継続できるものを選びましょう"]},{"tag":"a","props":{"href":"/ja/tip/06-27"},"children":[{"tag":"span","props":{},"children":["27"]},"「自慰は体に悪い」「禁欲すれば良くなる」を信じないでください。本当に見るべきは、睡眠、仕事、そして人間関係に支障が出ているかどうかです"]},{"tag":"a","props":{"href":"/ja/tip/06-28"},"children":[{"tag":"span","props":{},"children":["28"]},"「性的指向の矯正」や「同性愛治療」に金を使わないで。家族を送り込むのもやめてください"]},{"tag":"a","props":{"href":"/ja/tip/06-29"},"children":[{"tag":"span","props":{},"children":["29"]},"「正しい持ち上げ方」や運搬研修だけで腰痛を防げると思わず、重さと回数を減らし、普段から運動する"]},{"tag":"a","props":{"href":"/ja/tip/06-30"},"children":[{"tag":"span","props":{},"children":["30"]},"骨折後にカルシウムを大量に補ったり骨スープを飲んだりすれば、骨が早くつながるとは期待しない"]},{"tag":"a","props":{"href":"/ja/tip/06-31"},"children":[{"tag":"span","props":{},"children":["31"]},"AIチャットボットだけで病状や法律問題を判断しない。受診・裁判・大きな支出の前に、根拠の原文を確認する"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"現在地"},"children":[{"tag":"a","props":{"href":"/ja/book"},"children":["本を読む"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/ja/book/06"},"children":["第6章"," ·"," ","アンチ・リスト"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"06-09"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["09"]},{"tag":"span","props":{"className":"life-evidence grade-b"},"children":["エビデンス"," ","B"]}]},{"tag":"h1","props":{"lang":"ja"},"children":["「より健康に」なるために、割高なオーガニック食品を買わないでください"]},{"tag":"p","props":{"lang":"ja","className":"life-entry-summary"},"children":["オーガニック食品の方が栄養価が高いという強力なエビデンスはありません。実際に人が食べた後の健康状態を調査した研究はわずか 3 件しかなく、いずれも差は見られませんでした。オーガニック農産物で残留農薬が検出される割合が 30 パーセント低いのは事実ですが、検出されたことと基準値を超えていることは別です。野菜や果物を多く食べることはそれ自体に意味があり、オーガニックであるかどうかは影響しません。"]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["費用・手間"]},{"tag":"p","props":{},"children":["一般的に、同種の普通食品の 1 から 3 倍の価格です。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["効果"]},{"tag":"p","props":{},"children":["ある系統的レビューでは、ヒトを対象とした 17 件の研究と、食品成分を測定した 223 件の研究を統合して検証しています。"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"記録する：「より健康に」なるために、割高なオーガニック食品を買わないでください"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"できている"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8