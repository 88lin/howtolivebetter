lassName":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Ẩn chi tiết"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Chi phí"]},{"tag":"p","props":{},"children":["Không tốn tiền, còn tiết kiệm tiền mua viên canxi, vitamin D cùng tiền và công hầm xương hằng ngày. Chỉ cần bổ sung khi xét nghiệm phát hiện thiếu; không thiếu thì không bổ sung thêm."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Lợi ích"]},{"tag":"p","props":{},"children":["Trước hết là vitamin D. Một tổng quan hệ thống năm 2023 thu thập 14 nghiên cứu với 2734 bệnh nhân gãy xương. Các tác giả kết luận rằng chỉ bổ sung vitamin D ảnh hưởng rất ít đến quá trình liền xương, việc xương có liền hay không và chức năng sau hồi phục. Vài nghiên cứu thấy lợi ích nhìn chung có chất lượng thấp. Các tác giả ghi rõ: nếu chỉ tính thử nghiệm phân nhóm ngẫu nhiên thì không thử nghiệm nào thấy lợi ích của việc bổ sung. Một thử nghiệm có 100 bệnh nhân gãy xương dài và vitamin D thấp. Trong hai tuần sau chấn thương, một nửa uống một liều duy nhất 100.000 IU, một nửa uống giả dược (không có hoạt chất điều trị). Mỗi nhóm có 2 người không liền xương, tổng cộng là 4%. Một thử nghiệm khác có 102 người từ 18 đến 50 tuổi gãy xương đùi hoặc xương chày, chia thành bốn nhóm dùng liều khác nhau hoặc giả dược. Điểm đánh giá liền xương ở tháng thứ 3 và tháng thứ 12 đều không thấy khác biệt. Một thử nghiệm nữa có 32 phụ nữ sau mãn kinh bị gãy xương cổ tay. So với người không bổ sung, nhóm dùng liều cao tương đương 1800 IU mỗi ngày lại có khả năng chịu lực nén của xương thấp hơn. Tiếp theo là canxi. Một tổng quan hệ thống năm 2014 cho biết nghiên cứu lâm sàng về ảnh hưởng của thiếu vitamin D hoặc bổ sung vitamin D đến liền xương còn rất ít, chưa thể kết luận rõ. Hai nghiên cứu mà tổng quan tìm được bổ sung cả canxi lẫn vitamin D. Chúng thấy mật độ xương ở chỗ gãy hoặc lượng can xương (xương mới hình thành) tăng, nhưng không đánh giá tốc độ liền xương. Cuối cùng là nước hầm xương. Một nghiên cứu đo hàm lượng tại Cao Hùng, Đài Loan, mua ba loại món mì dùng nước hầm xương, mỗi phần có 450 đến 550 gam nước dùng. Lượng canxi trung bình mỗi phần nước dùng là 14 đến 39 miligam, bằng 1,4% đến 3,9% mức khuyến nghị 1000 miligam mỗi ngày. Các tác giả kết luận rằng một phần nước dùng cung cấp dưới 5% lượng khuyến nghị hằng ngày. Ở Trung Quốc, mức khuyến nghị là 800 miligam mỗi ngày cho người 18 đến 49 tuổi, 1000 miligam cho người từ 50 tuổi trở lên; giới hạn trên mỗi ngày là 2000 miligam. Tiêu chuẩn này ghi rõ dùng quá nhiều canxi lâu dài làm tăng nguy cơ sỏi thận. Một thử nghiệm ở Mỹ có 36.282 phụ nữ sau mãn kinh dùng 1000 miligam canxi cộng 400 IU vitamin D mỗi ngày, theo dõi trung bình 7 năm. Nguy cơ sỏi thận tăng khoảng 17% (HR 1,17; khoảng tin cậy 95%: 1,02–1,34). Gãy xương hông giảm khoảng 12%, nhưng không có ý nghĩa thống kê (HR 0,88; 0,72–1,08). Việc này có vẻ đáng tiền vì trực giác «xương làm từ canxi, ăn nhiều canxi thì xương liền nhanh»."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Nguồn gốc"]},{"tag":"p","props":{"className":"life-citations"},"children":["Gatt T, Grech A, Arshad H (2023). The Effect of Vitamin D Supplementation for Bone Healing in Fracture Patients: A Systematic Review. Advances in Orthopedics, 2023, 6236045. ",{"tag":"a","props":{"href":"https://doi.org/10.1155/2023/6236045","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1155/2023/6236045"]},"；Haines N, Kempton LB, Seymour RB, et al. (2017). The effect of a single early high-dose vitamin D supplement on fracture union in patients with hypovitaminosis D: a prospective randomised trial. Bone & Joint Journal, 99-B(11), 1520-1525. ",{"tag":"a","props":{"href":"https://doi.org/10.1302/0301-620X.99B11.BJJ-2017-0271.R1","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1302/0301-620X.99B11.BJJ-2017-0271.R1"]},"；Slobogean GP, Bzovsky S, O'Hara NN, et al. (2023). Effect of Vitamin D3 Supplementation on Acute Fracture Healing: A Phase II Screening Randomized Double-Blind Controlled Trial. JBMR Plus, 7, e10705. ",{"tag":"a","props":{"href":"https://doi.org/10.1002/jbm4.10705","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1002/jbm4.10705"]},"；Heyer FL, de Jong JJ, Willems PC, et al. (2021). The Effect of Bolus Vitamin D3 Supplementation on Distal Radius Fracture Healing: A Randomized Controlled Trial Using HR-pQCT. Journal of Bone and Mineral Research, 36, 1492-1501. ",{"tag":"a","props":{"href":"https://doi.org/10.1002/jbmr.4311","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1002/jbmr.4311"]},"；Gorter EA, Hamdy NA, Appelman-Dijkstra NM, Schipper IB (2014). The role of vitamin D in human fracture healing: a systematic review of the literature. Bone, 64, 288-297. ",{"tag":"a","props":{"href":"https://doi.org/10.1016/j.bone.2014.04.026","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1016/j.bone.2014.04.026"]},"；Hsu DJ, Lee CW, Tsai WC, Chien YC (2017). Essential and toxic metals in animal bone broths. Food & Nutrition Research, 61, 1347478（表 2、表 3）. ",{"tag":"a","props":{"href":"https://doi.org/10.1080/16546628.2017.1347478","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1080/16546628.2017.1347478"]},"；国家卫生和计划生育委员会 (2018). WS/T 578.2—2018 中国居民膳食营养素参考摄入量 第 2 部分：常量元素（表 1；定义 3.7）. ",{"tag":"a","props":{"href":"https://www.nhc.gov.cn/wjw/yingyang/201805/f2c614be95fe41dba8123c23a6e6fb55/files/1739783539207_73894.pdf","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.nhc.gov.cn/wjw/yingyang/201805/f2c614be95fe41dba8123c23a6e6fb55/files/1739783539207_73894.pdf"]},"；Jackson RD, LaCroix AZ, Gass M, et al. (2006). Calcium plus vitamin D supplementation and the risk of fractures. New England Journal of Medicine, 354(7), 669-683. ",{"tag":"a","props":{"href":"https://doi.org/10.1056/NEJMoa055218","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1056/NEJMoa055218"]},"；Doetsch AM, Faber J, Lynnerup N, et al. (2004). The effect of calcium and vitamin D3 supplementation on the healing of the proximal humerus fracture: a randomized placebo-controlled study. Calcified Tissue International, 75, 183-188. ",{"tag":"a","props":{"href":"https://doi.org/10.1007/s00223-004-0167-0","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1007/s00223-004-0167-0"]},"（备注里那项）；Gorter EA, Krijnen P, Schipper IB (2017). Vitamin D status and adult fracture healing. Journal of Clinical Orthopaedics and Trauma, 8(1), 34-37. ",{"tag":"a","props":{"href":"https://doi.org/10.1016/j.jcot.2016.09.003","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1016/j.jcot.2016.09.003"]},"（备注里那项）"]},{"tag":"a","props":{"href":"https://doi.org/10.1155/2023/6236045","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Liên kết mở nguồn"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Ghi chú sách"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["Tranh luận: có hai dấu hiệu nhỏ. Một thử nghiệm ở Đan Mạch có 30 phụ nữ cao tuổi bị gãy đầu trên xương cánh tay gần vai, họ bị loãng xương hoặc khối lượng xương thấp. Người dùng 800 IU vitamin D cộng 1 gam canxi mỗi ngày có mật độ xương ở chỗ gãy cao hơn vào tuần thứ 6 (0,623 so với 0,570 g/cm²). Nhưng nghiên cứu chỉ đo mật độ xương, không đánh giá xương đã liền hay chưa, và số người quá ít. Phân tích sau thử nghiệm 102 người thấy nhóm dùng vitamin D liều cao có điểm chức năng tốt hơn một chút; các tác giả nói cần thử nghiệm thêm để xác nhận. Người vốn thiếu vitamin D là trường hợp khác. Một nghiên cứu theo dõi ở Hà Lan thấy trong những người vẫn thiếu sau khi bổ sung, tỷ lệ chậm liền xương là 9,7%. Người vốn không thiếu là 0,3%, người đã bổ sung về mức bình thường là 1,7%. Đây chỉ là theo dõi ghi nhận, không chứng minh được quan hệ nhân quả. Nếu phát hiện thiếu, bổ sung về mức bình thường theo chỉ dẫn bác sĩ. Người đã được chẩn đoán loãng xương, hoặc chỉ ngã nhẹ đã gãy xương, cần thuốc điều trị loãng xương; xem mục 40 chương 1 (thuốc điều trị loãng xương). Viên canxi không thay thế được thuốc đó. Người không thiếu vitamin D bổ sung lâu dài không có lợi; xem mục 3 chương này (bổ sung vitamin D). Điều bị bác bỏ là «bổ sung thêm thật nhiều», không phải ăn ít canxi: vẫn ăn đủ canxi trong ba bữa; xem mục 21 chương này (kiêng canxi để phòng sỏi thận). Vừa ngã và nghi gãy xương thì làm gì, xem mục 41 chương 13 (nghi gãy xương). Lợi ích được xếp mức vừa theo tiền mua viên canxi và vitamin D trong một năm. Người hưởng lợi là chính bạn."]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Ghi chú của tôi"]},{"tag":"button","props":{"type":"button"},"children":["Viết một lời nhắc cho chính bạn…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/vi/tip/06-29"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Trước"]},"Đừng mong «tư thế nâng đúng» hay lớp huấn luyện bốc vác ngăn được đau lưng; hãy giảm trọng lượng và số lần nâng, tập thể dục đều đặn"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/vi/tip/06-31"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Tiếp theo"]},"Đừng dựa vào chatbot AI để tự chẩn đoán hay phán đoán pháp lý; trước khi chữa bệnh, kiện tụng hoặc chi nhiều tiền, tìm văn bản gốc kiểm tra căn cứ nó nêu"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["Thêm trong chủ đề này"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/06-23"},"children":[{"tag":"stro