n hành nền tảng thương mại điện tử áp dụng các biện pháp cần thiết như xóa, chặn, gỡ liên kết, chấm dứt giao dịch và chấm dứt dịch vụ. Thông báo phải kèm bằng chứng ban đầu chứng minh có vi phạm. Chủ sở hữu quyền là người nắm các quyền như nhãn hiệu, bản quyền tác giả, bằng sáng chế. Chỉ gửi một câu thì không được, phải kèm bằng chứng ban đầu. Nền tảng nhận được thông báo thì「应当及时采取必要措施，并将该通知转送平台内经营者；未及时采取必要措施的，对损害的扩大部分与平台内经营者承担连带责任」— phải kịp thời áp dụng biện pháp cần thiết và chuyển thông báo đó cho người kinh doanh trong nền tảng; không kịp thời áp dụng thì chịu trách nhiệm liên đới với người kinh doanh trong nền tảng về phần thiệt hại bị mở rộng thêm. Kéo dài không xử lý thì phần thiệt hại phát sinh thêm bạn phải cùng người bán chịu. Sau khi người bán giải trình, nền tảng「在转送声明到达知识产权权利人后十五日内，未收到权利人已经投诉或者起诉通知的，应当及时终止所采取的措施」— trong 15 ngày sau khi bản giải trình đã tới được chủ sở hữu quyền sở hữu trí tuệ, nếu không nhận được thông báo rằng chủ sở hữu quyền đã khiếu nại hoặc đã khởi kiện thì phải kịp thời chấm dứt các biện pháp đã áp dụng. Nghĩa là chuyển giải trình của người bán cho chủ sở hữu quyền rồi chờ 15 ngày. Bên kia không khiếu nại cũng không khởi kiện thì khôi phục lại những gì đã xóa hoặc gỡ xuống. Nền tảng biết hoặc phải biết có vi phạm mà không xử lý thì chịu trách nhiệm liên đới với bên vi phạm. Cơ quan quản lý sở hữu trí tuệ còn buộc bạn sửa trong thời hạn, quá hạn không sửa thì phạt tiền 5 vạn đến 50 vạn tệ, nghiêm trọng thì phạt 50 vạn đến 200 vạn tệ. Ngược lại,「恶意发出错误通知，造成平台内经营者损失的，加倍承担赔偿责任」— cố ý gửi thông báo sai làm người kinh doanh trong nền tảng chịu thiệt hại thì chịu trách nhiệm bồi thường gấp đôi (toàn quốc)"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Nguồn gốc"]},{"tag":"p","props":{"className":"life-citations"},"children":["全国人大常委会 (2018). 电子商务法（第四十二、四十三、四十四、四十五、八十四条）. ",{"tag":"a","props":{"href":"https://flk.npc.gov.cn/detail?id=2c909fdd678bf17901678bf8af050b81","target":"_blank","rel":"noopener noreferrer"},"children":["https://flk.npc.gov.cn/detail?id=2c909fdd678bf17901678bf8af050b81"]}," ; 全国人大 (2020). 民法典（第一千一百九十五、一千一百九十六、一千一百九十七条）. ",{"tag":"a","props":{"href":"https://www.court.gov.cn/zixun/xiangqing/233181.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.court.gov.cn/zixun/xiangqing/233181.html"]}]},{"tag":"a","props":{"href":"https://flk.npc.gov.cn/detail?id=2c909fdd678bf17901678bf8af050b81","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Liên kết mở nguồn"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Ghi chú sách"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["Bạn không phải nền tảng thương mại điện tử mà chỉ là một trang web thường thì áp dụng quy tắc thông báo và gỡ bỏ của Bộ luật Dân sự. Khác biệt nằm ở chỗ sau khi bên kia giải trình thì bạn phải chờ bao lâu: Luật Thương mại điện tử ấn định rõ 15 ngày, còn Bộ luật Dân sự chỉ viết「合理期限」— một thời hạn hợp lý. Ngoài ra, việc công bố ra công khai thông báo đã nhận, giải trình của người bán và kết quả xử lý của bạn là yêu cầu rõ ràng tại Điều 44 của Luật Thương mại điện tử. Nền tảng tự tổ chức tải lên bản quyền, hoặc biết rõ vi phạm quyền nhưng vẫn để yên, thì quy tắc「nhận thông báo thì xóa」này không bảo vệ được nền tảng, tham khảo Điều 9, Điều 24 (bản dịch truyện tranh, sao chép phim truyền hình)"]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Ghi chú của tôi"]},{"tag":"button","props":{"type":"button"},"children":["Viết một lời nhắc cho chính bạn…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/vi/tip/26-08"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Trước"]},"Không mở phát trực tiếp cho người chưa đủ 16 tuổi, tiền thưởng xử lý theo bậc tuổi"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/vi/tip/26-10"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Tiếp theo"]},"Đừng tùy tiện đặt thông tin người dùng ra nước ngoài, việc chuyển dữ liệu ra nước ngoài có điều kiện luật định và có ngưỡng số người"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["Thêm trong chủ đề này"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/ti