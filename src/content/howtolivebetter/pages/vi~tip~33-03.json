ren":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Chia sẻ mẹo này"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Ẩn chi tiết"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Chi phí"]},{"tag":"p","props":{},"children":["Không tốn tiền. Ghi nhớ hai trường hợp, đến lúc cần là nói được ngay."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Lợi ích"]},{"tag":"p","props":{},"children":["Luật Sức khỏe Tâm thần (精神卫生法) Điều ba mươi nêu rõ「精神障碍的住院治疗实行自愿原则」— việc điều trị nội trú rối loạn tâm thần theo nguyên tắc tự nguyện. Chỉ khi chẩn đoán và đánh giá tình trạng bệnh xác định người khám là bệnh nhân rối loạn tâm thần nặng, đồng thời thuộc một trong các trường hợp sau, mới được điều trị nội trú. Thứ nhất「已经发生伤害自身的行为，或者有伤害自身的危险的」— đã có hành vi tự gây hại cho bản thân, hoặc có nguy cơ tự hại. Thứ hai「已经发生危害他人安全的行为，或者有危害他人安全的危险的」— đã có hành vi gây nguy hại cho an toàn của người khác, hoặc có nguy cơ đó. Điều ba mươi mốt: thuộc trường hợp thứ nhất thì chỉ khi người giám hộ đồng ý, cơ sở y tế mới được điều trị nội trú; người giám hộ không đồng ý thì không được làm. Điều ba mươi hai: thuộc trường hợp thứ hai mà bản thân hoặc người giám hộ không đồng ý, có thể yêu cầu chẩn đoán lại, phải nộp trong ba ngày kể từ ngày nhận được kết luận chẩn đoán, do hai bác sĩ hành nghề tâm thần ngoài bác sĩ chẩn đoán lần đầu thực hiện; vẫn không đồng ý với kết luận chẩn đoán lại thì có thể tự uỷ quyền cho tổ chức giám định có tư cách hành nghề theo pháp luật để làm giám định y khoa về rối loạn tâm thần. Điều ba mươi lăm: kết luận chẩn đoán lại hoặc báo cáo giám định cho thấy không xác định được là bệnh nhân rối loạn tâm thần nặng, hoặc bệnh nhân không cần điều trị nội trú, thì cơ sở y tế không được tiến hành điều trị nội trú. Điều bảy mươi tám: cố ý đưa người không bị rối loạn tâm thần vào cơ sở y tế với danh nghĩa rối loạn tâm thần để điều trị, thì phải bồi thường theo pháp luật (toàn quốc, có hiệu lực từ ngày 1 tháng 5 năm 2013, sửa đổi năm 2018)"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Nguồn gốc"]},{"tag":"p","props":{"className":"life-citations"},"children":["中华人民共和国精神卫生法（2018 年修正，第三十条、第三十一条、第三十二条、第三十五条、第七十八条）. ",{"tag":"a","props":{"href":"https://flk.npc.gov.cn/detail?id=2c909fdd678bf17901678bf7448a066d","target":"_blank","rel":"noopener noreferrer"},"children":["https://flk.npc.gov.cn/detail?id=2c909fdd678bf17901678bf7448a066d"]}]},{"tag":"a","props":{"href":"https://flk.npc.gov.cn/detail?id=2c909fdd678bf17901678bf7448a066d","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Liên kết mở nguồn"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Ghi chú sách"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["Ngược lại, cũng không phải ai cũng bị cấm đưa đi khám. Điều 28 quy định, người nghi bị rối loạn tâm thần đã có hành vi tự gây hại cho bản thân hoặc gây nguy hại cho an toàn người khác, hoặc có nguy cơ đó, thì người thân thích, cơ quan công tác, công an địa phương phải ngay lập tức áp dụng biện pháp ngăn chặn, và đưa người đó đến cơ sở y tế để chẩn đoán rối loạn tâm thần. Cơ sở y tế khi tiếp nhận người đưa đến thì không được từ chối chẩn đoán. Nên「đưa đi chẩn đoán」và「giữ lại nhập viện」là hai cánh cửa, cánh trước thấp, cánh sau cao. Điều 75 liệt kê trách nhiệm của cơ sở y tế: thực hiện cách ly cưỡng chế trái quy định, chẩn đoán người không bị rối loạn tâm thần thành rối loạn tâm thần, thì bị xử lý cho đến khi bị thu hồi chứng chỉ hành nghề. Người bên cạnh có xung lực gây hại thì làm gì, xem phần 8."]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Ghi chú của tôi"]},{"tag":"button","props":{"type":"button"},"children":["Viết một lời nhắc cho chính bạn…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/vi/tip/33-02"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Trước"]},"Mười năm đầu sau khi bị khuyết tật là giai đoạn nguy cơ tự tử cao, đừng tưởng chỉ cần nghĩ thoáng là xong"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/vi/tip/33-04"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Tiếp theo"]},"Người chăm lâu dài người khuyết tật trong nhà, sức khỏe của chính mình cũng phải có người nhìn"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["Thêm trong chủ đề này"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/33-01"},"children":[{"tag":"strong","props":{},"children":["Sau chấn thương tủy sống mà đột nhiên đau đầu dữ dội và ra mồ hôi: đỡ ngồi ngay lên, nới lỏng quần áo, đồng thời gọi 120"]},{"tag":"span","props":{},"children":["Ở người bị chấn thương tủy sống, đường báo động trong cơ thể đứt mất …"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/33-05"},"children":[{"tag":"strong","props":{},"children":["Người ngồi xe lăn lâu thì đổi đệm ngồi sang loại giảm áp, mỗi ngày xem một lượt xương ngồi và xương cùng"]},{"tag":"span","props":{},"children":["Đệm bọt thường ngồi lâu sẽ làm căng da, vỡ ra thì lành rấ