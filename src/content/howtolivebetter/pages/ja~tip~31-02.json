:"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["費用・手間"]},{"tag":"p","props":{},"children":["費用はかかりません。登録はオンラインで一度入力するだけで、数分で完了します。実際に兵役につく場合の代償は2年間のフルタイム勤務であり、この2年間は他の活動を並行して行うことはできません。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["効果"]},{"tag":"p","props":{},"children":["登録については《兵役登録工作規定》を参照してください。そこには、「県、自治県、直轄市の一部、市轄区の人民政府兵役機関は、毎年 10 月 31 日までに、当該行政区域内の当該年度 12 月 31 日以前に満 18 歳となる男性公民に対し、初回兵役登録を実施しなければならない」と記載されています。また、同規定には「初回兵役登録は主にネットワーク登録方式で行われ、公民は兵役登録ネットワークプラットフォームを通じて自主的に完了させるものとする」とも記載されています。登録を行わなかった場合の影響については、兵役法第五十七条第一項を確認してください。この項は「兵役登録を拒否、または回避した者」を対象としています。罰則は「県級人民政府により期限内の是正を命じられ、期限内に是正されない場合は、県級人民政府により兵役義務の履行を強制され、併せて罰金が科される」となっています。兵役法には「義務兵の現役期間は2年とする」と記されています。「軍の必要性および本人の自発的な意思に基づき、満17歳以上18歳未満の市民を現役として徴集することができる」としています。下士官については「現役期間が12年を満たすか、または国家が定めるその他の条件を満たす場合、配置地の県級以上の地方人民政府が職を割り当てる」とされています。下士官が「現役期間が30年を満たすか、満55歳に達するか、または国家が定めるその他の条件を満たす場合は、退職として配置される」としています。職の割り当てとは政府が職を提供することを指し、退職としての配置とは退職の手続きに従って退役することを指します。『徴兵工作条例』には「普通高等学校の卒業生、および政治的、身体的条件、または専門技能において特別な要件がある兵員の徴集を優先的に保障する」と記されています。この条例には、「志願者が普通高等学校の全日制在校生または卒業予定者である場合、入学前であれば戸籍地または学校所在地にて徴兵に応じることができる」とも記されています（全国）"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["出典"]},{"tag":"p","props":{"className":"life-citations"},"children":["国务院办公厅、中央军委办公厅 (2025). 兵役登记工作规定（国办发〔2025〕41 号）. ",{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/202512/content_7051363.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/zhengce/zhengceku/202512/content_7051363.htm"]},"；全国人大常委会 (2021). 兵役法（2021 年修订，第二十、二十五、二十六、五十四、五十七条）. ",{"tag":"a","props":{"href":"http://www.mod.gov.cn/regulatory/2021-08/20/content_4892491.htm","target":"_blank","rel":"noopener noreferrer"},"children":["http://www.mod.gov.cn/regulatory/2021-08/20/content_4892491.htm"]},"（国防部刊登）；国务院、中央军委 (2023). 征兵工作条例（国务院、中央军委令第 759 号，第五条）. ",{"tag":"a","props":{"href":"http://www.gov.cn/gongbao/content/2023/content_5753313.htm","target":"_blank","rel":"noopener noreferrer"},"children":["http://www.gov.cn/gongbao/content/2023/content_5753313.htm"]}]},{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/202512/content_7051363.htm","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["出典を開く"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["著者の注記"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["登録と徴兵は別個の事柄であり、その代償には大きな差があります。2年間の出国禁止を含む一連の制裁は、徴兵に応じた後に辞退した者にのみ適用されます。第 3 条（兵役拒否）を参照してください。女性には初回兵役登録の義務はなく、軍の必要に応じて徴集されます。兵士の士官学校への入学や、成績優秀な兵士の士官への昇進（提干）に関する条件は、軍内部の規定に記載されており、外部からは確認できません。兵役法には以下の2点のみが記載されています：現役将校は「成績優秀な現役兵」等の中から選抜・採用されること、および軍事学校の学员採用には徴集年齢の制限は適用されないこと。具体的な合格ラインや定員については、本書では提供しません。"]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["自分のメモ"]},{"tag":"button","props":{"type":"button"},"children":["自分へのメモを書く…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/ja/tip/31-01"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["前へ"]},"まずは基準を確認：12のルートの年齢と学歴要件は明文化されています"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/ja/tip/31-03"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["次へ"]},"徴兵に応じた後に兵役を拒否した場合、2年間は出国や進学・復学が禁止され、公務員や国営企業への採用も不可となります"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["このテーマの他の提案"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/31-04"},"children":[{"tag":"strong","props":{},"children":["大学生の兵役で最も実利的な2点：授業料が毎年最大 20000 元補助、学籍は2年間保持、大学院入試の特別枠あり"]},{"tag":"span","props":{},"children":["在校生、卒業予定者、および新入生が兵役に就く場合、国がその在学期間中の授業料を負担します。実際に支払った金額に基づいて補填され、専門・短大…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/31-05"},"children":[{"tag":"strong","props":{},"children":["退役後、政府による就業配置が行われるのは6つのケースのみ；自主就業の場合は 30 日以内に届け出が必要"]},{"tag":"span","props":{},"children":["「兵役に入れば仕事が割り当てられる」というのは、もはや一般的な状況ではありません。現在、政府による就業配置が行われるのは6つのケースのみで…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/31-06"},"children":[{"tag":"strong","props":{},"children":["退役後の3つの勘定：一時金としての退役金、軍歴の勤続年数算入、自主事業の場合は毎年 20000 元の減税"]},{"tag":"span","props":{},"children":["退役後には3つの勘定があります。1つ目は自主就業の一時金としての退役金で、現役の服役年数に応じて支給され、功績がある場合は増額されます。2…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/31-07"},"children":[{"tag":"strong","props":{},"children":["公務員試験以外にも公務員への道はある：基礎サービスプロジェクトで2年間勤務すれば、毎年 10% の定向採用計画に応募可能"]},{"tag":"span","props":{},"children":["公務員を目指す道は、公務員試験だけではありません。「三支一扶」のような基礎サービスプロジェクトで2年間勤務し、評価に合格すれば、それらの対…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/31-08"},"children":[{"tag":"strong","props":{},"children":["特崗教師（特別採用教員）は、3年間の服務期間終了後、評価に合格し、かつ継続を希望する場合は、速やかに正規採用（入編）されるべきである"]},{"tag":"span","props":{},"children":["特崗計画は、数少ない「任期終了後の正規採用」が明記されているルートの一つです。条件は、学士以上の学位（主に師範系専攻）、 30 歳以下、か…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/31-09"},"children":[{"tag":"strong","props":{},"children":["消防士と軍事文職は、公務員試験とは別の公開採用枠であり、門戸は公務員試験よりも低い"]},{"tag":"span","props":{},"children":["これら2つのルートはいずれも「専門学校（大専）以上」というハードルに縛られません。消防士は 18 から 22 歳、高校卒業以上の学歴の人を…"]}]}]}]},{"tag":"a","props":{"className":"life-text-link","href":"/ja/book/31"},"children":["テーマ全体を読む：18歳以降、どのような道があるか"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"15","height":"15","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]}]}]}]},{"tag":"aside","props":{"className":"life-ad-space life-ad-space-sponsored","data-ad-