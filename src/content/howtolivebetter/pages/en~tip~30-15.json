mlns":"http://www.w3.org/2000/svg","width":"18","height":"18","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-up-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M7 7h10v10"},"children":[]},{"tag":"path","props":{"d":"M7 17 17 7"},"children":[]}]}]}]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/en/book/30"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"Back to index"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["Children after starting school"]},{"tag":"div","props":{"data-ad-dock-host":"true"},"children":[]},{"tag":"nav","props":{"aria-label":"Chapter entries"},"children":[{"tag":"a","props":{"href":"/en/tip/30-01"},"children":[{"tag":"span","props":{},"children":["01"]},"Child reports sudden, worsening pain — rush to the hospital right away; don’t let him wait until after school"]},{"tag":"a","props":{"href":"/en/tip/30-02"},"children":[{"tag":"span","props":{},"children":["02"]},"Don’t delay necessary treatment just to “wait until exams are over”; certain treatment windows depend on bone growth, not exam schedules"]},{"tag":"a","props":{"href":"/en/tip/30-03"},"children":[{"tag":"span","props":{},"children":["03"]},"When a child is bullied, report it to school the same day and request a written response; for physical assault, theft, or rumor spreading, call the police immediately"]},{"tag":"a","props":{"href":"/en/tip/30-04"},"children":[{"tag":"span","props":{},"children":["04"]},"Ensuring that children spend at least 2 hours outdoors each day is currently the only myopia‑prevention method backed by randomized trials"]},{"tag":"a","props":{"href":"/en/tip/30-05"},"children":[{"tag":"span","props":{},"children":["05"]},"No screen time for children aged 0–3; limit it as much as possible for ages 3–6; for school‑age kids, non‑educational screen use should not exceed one hour per day"]},{"tag":"a","props":{"href":"/en/tip/30-06"},"children":[{"tag":"span","props":{},"children":["06"]},"Treating myopia as a lasting injury: the higher the prescription, the greater the future risk of retinal detachment, macular degeneration, and glaucoma"]},{"tag":"a","props":{"href":"/en/tip/30-07"},"children":[{"tag":"span","props":{},"children":["07"]},"Take a close look at your child’s annual school health report and follow up on any abnormalities right away"]},{"tag":"a","props":{"href":"/en/tip/30-08"},"children":[{"tag":"span","props":{},"children":["08"]},"Conducting a depression screening for kids aged 12 to 18 — don’t rely on school mental health assessments as a diagnosis"]},{"tag":"a","props":{"href":"/en/tip/30-09"},"children":[{"tag":"span","props":{},"children":["09"]},"Do not buy products or services claiming to “cure myopia” or “reduce refractive error”"]},{"tag":"a","props":{"href":"/en/tip/30-10"},"children":[{"tag":"span","props":{},"children":["10"]},"Clear rules exist for sleep, homework, sports, and rankings; if schools fail to comply, parents can raise the issue"]},{"tag":"a","props":{"href":"/en/tip/30-11"},"children":[{"tag":"span","props":{},"children":["11"]},"Parents can request a temporary leave of absence for their child; the school must retain the child’s enrollment status for up to one year"]},{"tag":"a","props":{"href":"/en/tip/30-12"},"children":[{"tag":"span","props":{},"children":["12"]},"If poor vision is detected, go to the hospital for cycloplegic refraction and follow up at the recommended intervals as advised by the doctor"]},{"tag":"a","props":{"href":"/en/tip/30-13"},"children":[{"tag":"span","props":{},"children":["13"]},"Pit and fissure sealants applied after permanent molars emerge"]},{"tag":"a","props":{"href":"/en/tip/30-14"},"children":[{"tag":"span","props":{},"children":["14"]},"If your child loves playing games, first check if sleep, homework, and outdoor activities have been displaced, rather than just focusing on how long they have played"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/en/tip/30-15","data-status":"active"},"children":[{"tag":"span","props":{},"children":["15"]},"When a child says they are attracted to the same sex: Do not scold, do not kick them out, and do not send them to \"conversion therapy\": The attitude at home is related to whether they will attempt suicide"]},{"tag":"a","props":{"href":"/en/tip/30-16"},"children":[{"tag":"span","props":{},"children":["16"]},"Do not hit your child, and do not yell or call them stupid: children who are often hit or verbally abused show more behavior and emotional problems"]},{"tag":"a","props":{"href":"/en/tip/30-17"},"children":[{"tag":"span","props":{},"children":["17"]},"If parenting feels out of control and you keep hitting or yelling, take a class that teaches concrete parenting skills"]},{"tag":"a","props":{"href":"/en/tip/30-18"},"children":[{"tag":"span","props":{},"children":["18"]},"Do not send children to closed “internet addiction schools” or “special training camps”: harmful methods are prohibited by law, and children have died in confinement"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"Breadcrumb"},"children":[{"tag":"a","props":{"href":"/en/book"},"children":["Explore the book"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/en/book/30"},"children":["Chapter 30"," ·"," ","Children after starting school"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"30-15"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["15"]},{"tag":"span","props":{"className":"life-evidence grade-b"},"children":["Evidence"," ","B"]}]},{"tag":"h1","props":{"lang":"en"},"children":["When a child says they are attracted to the same sex: Do not scold, do not kick them out, and do not send them to \"conversion therapy\": The attitude at home is related to whether they will attempt suicide"]},{"tag":"p","props":{"lang":"en","className":"life-entry-summary"},"children":["Among middle and high school students in China, children who are attracted to the same sex or are bisexual have attempted suicide at approximately 3 to 5.5 times the rate of others. International studies show that adolescents who face strong rejection from their families are much more likely to have attempted suicide later in life. Those sent to \"conversion therapy\" by their parents have the highest suicide attempt rates."]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Cost"]},{"tag":"p","props":{},"children":["No cost. The difficulty lies in parents first processing t…"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Benefit"]},{"tag":"p","props":{},"children":["A domestic survey covered 7 provinces and 506 middle and high schools, involving a total of 150822 students fr…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"Mark: When a child says they are attracted to the same sex: Do not scold, do not kick them out, and do not send them to \"conversion therapy\": The attitude at home is related to whether they will attempt suicide"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"Done"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"Plan to do"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"Save"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Share this tip"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Hide details"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Cost"]},{"tag":"p","props":{},"children":["No cost. The difficulty lies in parents first processing their own emotions and refraining from saying harsh words in the moment."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Benefit"]},{"tag":"p","props":{},"children":["A domestic survey covered 7 provinces and 506 middle and high schools, involving a total of 150822 students from grade 7 to grade 12. Among those who attempted suicide in the past year, 2.2% of males preferred the opposite sex, 6.9% preferred the same sex, and 12.2% were bisexual. For females, the corresponding figures were 3.1%, 8.9%, and 10.9%. This calculates to approximately 3 to 5.5 times the rate of students who only prefer the opposite sex. Researchers controlled for factors such as age, academic pressure, family finances, and bullying. Subsequently, the OR for these two groups of males was 3.13 (95% CI 2.28–4.28) and 3.83 (2.85–5.14), which is about two to three times higher. A meta-analysis summarizing 35 studies calculated that the OR for suicide attempts among sexual minority adolescents was 3.50 (2.98–4.12). A US study surveyed 224 gay and bisexual youths aged 21 to 25 years, asking them to recall their families' reactions during adolescence. Compared to peers whose families were almost non-rejecting, those with high levels of family rejection had an OR for suicide attempts of 8.4. In another study, when parents themselves attempted to change their child's sexual orientation, the OR for the child attempting suicide was 3.08 (1.39–6.83). The OR for parents sending their child to see a therapist or religious figure was 5.07 (2.38–10.79) (China / Multiple countries / USA)"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Original sources"]},{"tag":"p","props":{"className":"life-citations"},"children":["Huang Y, Li P, Guo L, et al. (2018). Sexual minority status and suicidal behaviour among Chinese adolescents: a nationally representative cross-sectional study. BMJ Open, 8(8), e020969. ",{"tag":"a","props":{"href":"https://doi.org/10.1136/bmjopen-2017-020969","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1136/bmjopen-2017-020969"]},"；di Giacomo E, Krausz M, Colmegna F, Aspesi F, Clerici M. (2018). Estimating the Risk of Attempted Suicide Among Sexual Minority Youths: A Systematic Review and Meta-analysis. JAMA Pediatrics, 172(12), 1145–1152. ",{"tag":"a","props":{"href":"https://doi.org/10.1001/jamapediatrics.2018.2731","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1001/jamapediatrics.2018.2731"]},"；Ryan C, Huebner D, Diaz RM, Sanchez J. (2009). Family rejection as a predictor of negative health outcomes in white and Latino lesbian, gay, and bisexual young adults. Pediatrics, 123(1), 346–352. ",{"tag":"a","props":{"href":"https://doi.org/10.1542/peds.2007-3524","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1542/peds.2007-3524"]},"；Ryan C, Toomey RB, Diaz RM, Russell ST. (2020). Parent-Initiated Sexual Orientation Change Efforts With LGBT Adolescents: Implications for Young Adult Mental Health and Adjustment. Journal of Homosexuality, 67(2), 159–173. ",{"tag":"a","props":{"href":"https://doi.org/10.1080/00918369.2018.1538407","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1080/00918369.2018.1538407"]},"；全国人大常委会 (2024 年修正). 未成年人保护法（第十七条）. ",{"tag":"a","props":{"href":"https://flk.npc.gov.cn/detail?id=ff8081818f197cf001905e567af635a0","target":"_blank","rel":"noopener noreferrer"},"children":["https://flk.npc.gov.cn/detail?id=ff8081818f197cf001905e567af635a0"]},"；全国人大常委会 (2015). 反家庭暴力法（第二条）. ",{"tag":"a","props":{"href":"https://flk.npc.gov.cn/detail?id=2c909fdd678bf17901678bf7f9d60889","target":"_blank","rel":"noopener noreferrer"},"children":["https://flk.npc.gov.cn/detail?id=2c909fdd678bf17901678bf7f9d60889"]}]},{"tag":"a","props":{"href":"https://doi.org/10.1136/bmjopen-2017-020969","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Open source link"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"chil