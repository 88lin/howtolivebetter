href":"/ja/tip/01-40"},"children":[{"tag":"strong","props":{},"children":["骨粗鬆症と診断された方、または軽い転倒で骨折した経験がある方は、医師に抗骨粗鬆症薬を処方してもらい、継続して服用してください。カルシウム補給だけで済ませてはいけません。"]},{"tag":"span","props":{},"children":["すでに骨粗鬆症と診断されている方、あるいは軽い転倒で骨折した経験がある方は、医師の治療計画に従って薬を使用することで、大腿骨近位部骨折を約…"]}]}]}]},{"tag":"a","props":{"className":"life-text-link","href":"/ja/book/01"},"children":["テーマ全体を読む：早死を避けるために"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"15","height":"15","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]}]}]},{"tag":"nav","props":{"className":"life-tabbar","aria-label":"メインナビゲーション"},"children":[{"tag":"a","props":{"className":"","href":"/ja/book"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"21","height":"21","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-book-open","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M12 7v14"},"children":[]},{"tag":"path","props":{"d":"M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z"},"children":[]}]},{"tag":"span","props":{},"children":["本"]}]},{"tag":"a","props":{"className":"","href":"/ja/top-50"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"21","height":"21","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-star","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.73