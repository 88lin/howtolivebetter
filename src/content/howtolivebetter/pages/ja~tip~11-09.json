ref":"/ja/tip/11-07"},"children":[{"tag":"span","props":{},"children":["07"]},"退職時にソースコード、顧客リスト、技術文書を持ち出さない、個人のクラウドストレージにアップロードしない、転職先で再利用しない"]},{"tag":"a","props":{"href":"/ja/tip/11-08"},"children":[{"tag":"span","props":{},"children":["08"]},"他人のコンピュータ、サーバ、カメラ上で自作プログラムを動作させない、会社の機器をマイニングに使用しない"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/ja/tip/11-09","data-status":"active"},"children":[{"tag":"span","props":{},"children":["09"]},"書面による許可なく他人のシステムをテストしない、「善意」や「事後報告」は免責理由にならない"]},{"tag":"a","props":{"href":"/ja/tip/11-10"},"children":[{"tag":"span","props":{},"children":["10"]},"脆弱性は規定に従って報告すること。修正前は詳細を公開せず、悪用ツールを配布せず、国外へ渡さないこと"]},{"tag":"a","props":{"href":"/ja/tip/11-11"},"children":[{"tag":"span","props":{},"children":["11"]},"検閲回避ツールやVPNアカウントを販売しない、他人のためにこのようなノードを構築しない"]},{"tag":"a","props":{"href":"/ja/tip/11-12"},"children":[{"tag":"span","props":{},"children":["12"]},"競業避止義務契約を締結した場合、退職後に会社が毎月補償金を支払わないときは書面で催告すること。3 ヶ月支払われなければ解除可能。営業秘密に触れていない職務については、条項の不適用を請求できる"]},{"tag":"a","props":{"href":"/ja/tip/11-13"},"children":[{"tag":"span","props":{},"children":["13"]},"勤務時間中や会社の資産を使用して書いたコードは会社に帰属する。個人のオープンソースプロジェクトは、自身の時間とデバイスを使用し、会社のコードと混在させないこと"]},{"tag":"a","props":{"href":"/ja/tip/11-14"},"children":[{"tag":"span","props":{},"children":["14"]},"GPLなどのオープンソースコードを使用して製品を作る際、ライセンスの要求に従ってオープンソース化するか、ライセンスを変更しなければ、「誰も見ていない」とは言えない"]},{"tag":"a","props":{"href":"/ja/tip/11-15"},"children":[{"tag":"span","props":{},"children":["15"]},"アプリでは業務上必要な個人情報のみを収集すること。14歳未満は保護者の同意が必要。プライバシーポリシーに明記すること"]},{"tag":"a","props":{"href":"/ja/tip/11-16"},"children":[{"tag":"span","props":{},"children":["16"]},"ウェブサイトやAppの公開前にICP備案（登録）を行い、等級保護の要件に従って 6 ヶ月以上のログを保存すること"]},{"tag":"a","props":{"href":"/ja/tip/11-17"},"children":[{"tag":"span","props":{},"children":["17"]},"生成AIサービスを一般に提供する際は、規定に基づき安全評価とアルゴリズムの届出を行い、生成コンテンツに識別標識を付与すること"]},{"tag":"a","props":{"href":"/ja/tip/11-18"},"children":[{"tag":"span","props":{},"children":["18"]},"他社 App の広告を自動でスキップ・遮断するツールを作らず、公開しない。無料で通信しなくても不正競争と認定される可能性がある"]},{"tag":"a","props":{"href":"/ja/tip/11-19"},"children":[{"tag":"span","props":{},"children":["19"]},"海外モデル API を安く転売する「AI 中継サイト」を開かない。上海では運営者が刑事拘留された"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"現在地"},"children":[{"tag":"a","props":{"href":"/ja/book"},"children":["本を読む"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/ja/book/11"},"children":["第11章"," ·"," ","エンジニアや技術者が陥りやすいレッドライン（禁忌事項）"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"11-09"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["09"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["エビデンス"," ","A"]}]},{"tag":"h1","props":{"lang":"ja"},"children":["書面による許可なく他人のシステムをテストしない、「善意」や「事後報告」は免責理由にならない"]},{"tag":"p","props":{"lang":"ja","className":"life-entry-summary"},"children":["罪に問われるかどうかは、権限の有無と、どれだけの情報を取得したかによって決まり、本人の意図は関係ありません。500 組の一般用アカウント・パスワードを取得した場合、あるいは 5000 元の利益を得た、または相手に 1 万元の損失を与えた場合、3 年以下の懲役が科されるのに十分な理由となります。脆弱性を証明するために、ついでにユーザーテーブルを1つダウンロードしただけで、一度に 500 組を超えてしまうことがよくあります。アカウントやパスワードを保持していても、許可された範囲外で使用すれば侵入とみなされます。"]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["費用・手間"]},{"tag":"p","props":{},"children":["費用はかかりません。ベンダーのSRC（セキュリティ・レスポンス・センター）やバグバウンティに参加する前には、必ず許可…"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["効果"]},{"tag":"p","props":{},"children":["一般企業および個人のシステムであり、国家事務、国防建設、先端科学技術の分野以外に属するコンピュータ情報システム。"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"記録する：書面による許可なく他人のシステムをテストしない、「善意」や「事後報告」は免責理由にならない"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","ari