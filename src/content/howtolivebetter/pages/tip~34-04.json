https://www.nmpa.gov.cn/directory/web/nmpa/xxgk/ggtg/ypggtg/ypshmshxdgg/20210423105404141.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.nmpa.gov.cn/directory/web/nmpa/xxgk/ggtg/ypggtg/ypshmshxdgg/20210423105404141.html"]},"；Smith SM, Schroeder K, Fahey T (2014). Over-the-counter (OTC) medications for acute cough in children and adults in community settings. Cochrane Database of Systematic Reviews, (11):CD001831. ",{"tag":"a","props":{"href":"https://doi.org/10.1002/14651858.CD001831.pub5","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1002/14651858.CD001831.pub5"]},""]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["原书备注"]},{"tag":"p","props":{"className":"life-citations"},"children":["这 14 种里很多名字带「氨酚」，也含对乙酰氨基酚，再和退烧药一起吃就重复了，见本节第 1 条（对乙酰氨基酚）。那篇综述里有一项试验发现蜂蜜比安慰剂好，但不满 1 岁不能喂蜂蜜，见第 20 节第 6 条（蜂蜜）。定 B 是因为综述里每类药的试验都少，作者没有合并出数字。收益定「中」是判断：这类药对小孩没有证实的好处，风险主要是过量和成分重复。"]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["我的备注"]},{"tag":"button","props":{"type":"button"},"children":["写下对自己有用的提醒…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/tip/34-03"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["上一条"]},"60 岁以上、胃出过血、在吃抗凝药或激素的人，吃布洛芬这类止痛药之前先问医生"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/tip/34-05"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["下一条"]},"怀孕 20 周以后，别自己吃布洛芬这类止痛药"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["本主题的其他建议"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/34-01"},"children":[{"tag":"strong","props":{},"children":["同时吃两种感冒药或止痛药之前，先看成分表，对乙酰氨基酚只能占一种"]},{"tag":"span","props":{},"children":["很多感冒药里都掺了对乙酰氨基酚，两盒一起吃就是吃了双份，过量会伤肝。在美国，它造成的急性肝衰竭病人里，近三成没等到换肝就死了。国内说明书建议一天最多吃 2 克，…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/34-02"},"children":[{"tag":"strong","props":{},"children":["孩子发烧不用阿司匹林、尼美舒利和安乃近，含安乃近的感冒药也不给未成年人吃"]},{"tag":"span","props":{},"children":["孩子退烧，这三种药都别用。阿司匹林和瑞氏综合征有关，这种病伤脑伤肝，美国统计里约三成病孩死亡，警告发出后病例少了九成多。尼美舒利 12 岁以下禁用，安乃近 18…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/34-06"},"children":[{"tag":"strong","props":{},"children":["反酸烧心自己买奥美拉唑，最多吃 7 天；吞咽困难、呕血、黑便就直接去医院"]},{"tag":"span","props":{},"children":["奥美拉唑肠溶片从 2022 年起不用处方就能买，但说明书写明自己吃不超过 7 天，两个月内别再吃。吞咽困难或疼痛、呕血、便血或黑便时不要自己吃，这些可能是严重情…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/34-07"},"children":[{"tag":"strong","props":{},"children":["普通感冒别找医生要抗生素"]},{"tag":"span","props":{},"children":["感冒吃抗生素，好得不比不吃快。成年人吃了，副作用的风险是不吃的两倍多。流脓鼻涕不到 10 天的，吃抗生素也没有确定的好处。"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/34-08"},"children":[{"tag":"strong","props":{},"children":["拉肚子先喝口服补液盐补水，5 岁以下的孩子不给止泻药"]},{"tag":"span","props":{},"children":["拉肚子最要紧的是补水，不是止泻。按说明书兑水喝口服补液盐，别拿果汁饮料代替，太甜反而让人更缺水。5 岁以下的孩子不给洛哌丁胺这类止泻药，严重的会肠梗阻，可能致命…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/34-09"},"children":[{"tag":"strong","props":{},"children":["止痛药一个月别吃超过 15 天，复方止痛药别超过 10 天，不然头痛可能就是药吃出来的"]},{"tag":"span","props":{},"children":["头痛老犯、就天天吃止痛药，可能越吃越痛。国际头痛分类把这叫药物过度使用性头痛。普通止痛药一个月吃 15 天以上，复方止痛药 10 天以上，连着超过 3 个月，就…"]}]}]}]},{"tag":"a","props":{"className":"life-text-link","href":"/book/34"},"children":["阅读整个主题：家里的常备药别吃出事 ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"15","height":"15","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]}]}]}]},{"tag":"aside","props":{"className":"life-ad-space life-ad-space-sponsored","data-ad-placement":"ad_footer","data-ad-group":"reading","data-ad-creative":"read_product","data-ad-ready":"false","aria-label":"广告 · 社区推荐"},"children":[{"tag":"div","props":{"className":"life-ad-space-brand"},"children":[{"tag":"img","props":{"src":"/sites/howtolivebetter/images/shengcai/logo.png","width":"565","height":"144","alt":"生财有术官方 Logo","decoding":"async"},"children":[]}]},{"tag":"div","props":{"className":"life-ad-space-copy"},"children":[{"tag":"span","props":{"className":"life-ad-space-label"},"children":["广告 · 社区推荐"]},{"tag":"strong","props":{},"children":["读过的知识，能不能做成有用的产品？"]},{"tag":"p","props":{},"children":["从电子书、资料到小工具，看看圈友怎样发现需求，把内容变成实际交付。"]}]},{"tag":"div","props":{"className":"life-ad-space-actions"},"children":[{"tag":"a","props":{"className":"life-ad-space-link","href":"/shengcaiyoushu?sc_group=reading&sc_creative=read_product&sc_placement=ad_footer"},"children":["看看社区与案例",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"18","height":"18","viewBox":"0 0 24 24","fill":"non