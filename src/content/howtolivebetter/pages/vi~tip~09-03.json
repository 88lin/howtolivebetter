ide-circle-user-round","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M18 20a6 6 0 0 0-12 0"},"children":[]},{"tag":"circle","props":{"cx":"12","cy":"10","r":"4"},"children":[]},{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},{"tag":"span","props":{},"children":["Đăng nhập để đồng bộ hóa"]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/vi/book/09"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"Quay lại mục lục"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["Vạch đỏ pháp lý dân dân thường dễ vấp"]},{"tag":"nav","props":{"aria-label":"Các mục trong chương"},"children":[{"tag":"a","props":{"href":"/vi/tip/09-01"},"children":[{"tag":"span","props":{},"children":["01"]},"Không chuyển tiếp tin về thiên tai, dịch bệnh hay sự cố công an không rõ thật giả trong nhóm, không chỉnh sửa ảnh, không dùng AI dựng ảnh hiện trường giả"]},{"tag":"a","props":{"href":"/vi/tip/09-02"},"children":[{"tag":"span","props":{},"children":["02"]},"Không đăng, không chuyển tiếp ảnh, biểu tượng cảm xúc và bình luận xúc phạm liệt sĩ, không đùa cợt với cờ đỏ và quốc ca"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/vi/tip/09-03","data-status":"active"},"children":[{"tag":"span","props":{},"children":["03"]},"Xem xong trên trang nước ngoài thì đóng lại, không chụp màn hình, không chuyển tiếp, không chuyển vào nhóm, cũng không nói theo ở phần bình luận"]},{"tag":"a","props":{"href":"/vi/tip/09-04"},"children":[{"tag":"span","props":{},"children":["04"]},"Video khiêu dâm thì tự xem ở nhà, đừng gửi vào nhóm, đừng bán「tư liệu」, đừng lập nhóm"]},{"tag":"a","props":{"href":"/vi/tip/09-05"},"children":[{"tag":"span","props":{},"children":["05"]},"Việc「làm thêm」bảo bạn dùng thẻ của mình để nhận tiền, rút tiền, chuyển khoản thì không làm, dù được trả bao nhiêu hoa hồng"]},{"tag":"a","props":{"href":"/vi/tip/09-06"},"children":[{"tag":"span","props":{},"children":["06"]},"Có người rủ bạn làm「bọc vật liệu」để vay tiền, chia hoa hồng theo khoản vay, thì không làm việc nào cả"]},{"tag":"a","props":{"href":"/vi/tip/09-07"},"children":[{"tag":"span","props":{},"children":["07"]},"Nhặt được thẻ ngân hàng thì không rút tiền; nhặt được điện thoại, ví thì liên lạc chủ nhân hoặc giao cho công an, không giữ lại"]},{"tag":"a","props":{"href":"/vi/tip/09-08"},"children":[{"tag":"span","props":{},"children":["08"]},"Ưu đãi thì lấy bằng chính danh tính thật của bạn; không mua số ảo để đăng ký hàng loạt tài khoản nhỏ, không dựa lỗ hổng để lấy lặp"]},{"tag":"a","props":{"href":"/vi/tip/09-09"},"children":[{"tag":"span","props":{},"children":["09"]},"Không ném bất cứ thứ gì ra ngoài từ ban công, cửa sổ; đầu thuốc lá, túi rác, chai rượu đều tính"]},{"tag":"a","props":{"href":"/vi/tip/09-10"},"children":[{"tag":"span","props":{},"children":["10"]},"Không mua súng nhựa, súng bi, súng hơi trên mạng; không mua「súng đồ chơi」không rõ nguồn gốc"]},{"tag":"a","props":{"href":"/vi/tip/09-11"},"children":[{"tag":"span","props":{},"children":["11"]},"Mua máy bay không cân thì đăng ký tên thật trước; không bay ở sân bay, khu quân sự và không gian bị kiểm soát của thành phố; không phá giới hạn chiều cao"]},{"tag":"a","props":{"href":"/vi/tip/09-12"},"children":[{"tag":"span","props":{},"children":["12"]},"Không chụp lén người khác, không lắp camera trong phòng thuê, nhà nghỉ, phòng khách sạn"]},{"tag":"a","props":{"href":"/vi/tip/09-13"},"children":[{"tag":"span","props":{},"children":["13"]},"Chơi mậu thẩu, bài poker thì được; không ăn phần trăm, không làm cái, không tổ chức bàn thu tiền, không chơi cờ bạc trên mạng"]},{"tag":"a","props":{"href":"/vi/tip/09-14"},"children":[{"tag":"span","props":{},"children":["14"]},"Không ăn thịt hoang dã, không mua bán, không nuôi động vật được bảo vệ làm thú cưng"]},{"tag":"a","props":{"href":"/vi/tip/09-15"},"children":[{"tag":"span","props":{},"children":["15"]},"Đòi nợ thì không giữ người, không giam người, không đuổi theo tới nhà ở"]},{"tag":"a","props":{"href":"/vi/tip/09-16"},"children":[{"tag":"span","props":{},"children":["16"]},"Không cho mượn thẻ căn cước, không dùng thẻ căn cước của người khác, cũng không lấy giấy tờ của người khác để đăng ký, mở thẻ, mua vé"]},{"tag":"a","props":{"href":"/vi/tip/09-17"},"children":[{"tag":"span","props":{},"children":["17"]},"Khi bị công an chặn hoặc đưa đi thì hợp tác, không đẩy, không đánh, không giật máy quay của người thi hành; đã uống rượu thì càng phải nhịn"]},{"tag":"a","props":{"href":"/vi/tip/09-18"},"children":[{"tag":"span","props":{},"children":["18"]},"Người kia chưa đủ 14 tuổi thì không được quan hệ tình dục; câu「cô ấy đồng ý」không phải là lý do"]},{"tag":"a","props":{"href":"/vi/tip/09-19"},"children":[{"tag":"span","props":{},"children":["19"]},"Trước khi ra tay, tính rõ cái giá: bị giữ, phải bồi, kết án"]},{"tag":"a","props":{"href":"/vi/tip/09-20"},"children":[{"tag":"span","props":{},"children":["20"]},"Sinh con ra không nuôi nổi thì lối thoát hợp pháp chỉ có một: đăng ký nhận nuôi ở cơ quan dân vụ; nhận tiền rồi đưa con cho người khác có thể bị kết án về tội bán trẻ em, bỏ trẻ không chăm thì là tội bỏ bê"]},{"tag":"a","props":{"href":"/vi/tip/09-21"},"children":[{"tag":"span","props":{},"children":["21"]},"Không bịa tai nạn, không phóng đại thiệt hại để lừa bồi thường: đó là tội lừa đảo bảo hiểm, và người làm chứng, sửa xe, giám định giúp bạn cùng bị tính"]},{"tag":"a","props":{"href":"/vi/tip/09-22"},"children":[{"tag":"span","props":{},"children":["22"]},"Không bán cơ quan của mình, cũng đừng đi tìm người hiến cho người khác: thận bán được hơn 2 vạn tệ, cùng một quả bán cho bệnh nhân tới 20 vạn tệ, tiền bị tịch thu lại còn phạt theo giao dịch 10 đến 20 lần"]},{"tag":"a","props":{"href":"/vi/tip/09-23"},"children":[{"tag":"span","props":{},"children":["23"]},"Đừng đi mại dâm: mức mặc định là giam 10 đến 15 ngày, không phải phạt chút tiền là xong"]},{"tag":"a","props":{"href":"/vi/tip/09-24"},"children":[{"tag":"span","props":{},"children":["24"]},"Dịch truyện tranh, đăng lại phim, chia sẻ tệp trên đám mây hoặc ebook lậu vẫn xâm phạm bản quyền dù miễn phí; quảng cáo hay phí thành viên có thể dẫn đến án hình sự"]},{"tag":"a","props":{"href":"/vi/tip/09-25"},"children":[{"tag":"span","props":{},"children":["25"]},"Xuất bản hoặc bán fanfic và tác phẩm phái sinh: hãy xin phép chủ sở hữu tác phẩm gốc, hoặc tự tạo lại tên, tính cách và quan hệ nhân vật"]},{"tag":"a","props":{"href":"/vi/tip/09-26"},"children":[{"tag":"span","props":{},"children":["26"]},"Đừng mua gậy rút, dụng cụ điện giật, dao găm, bình xịt hơi cay để mang theo tự vệ; để trong xe cũng tính mang theo"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"Breadcrumbs"},"children":[{"tag":"a","props":{"href":"/vi/book"},"children":["Khám phá cuốn sách"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/vi/book/09"},"children":["Chương 9"," ·"," ","Vạch đỏ pháp lý dân dân thường dễ vấp"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"09-03"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["03"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["Bằng chứng"," ","A"]}]},{"tag":"h1","props":{"lang":"vi"},"children":["Xem xong trên trang nước ngoài thì đóng lại, không chụp màn hình, không chuyển tiếp, không chuyển vào nhóm, cũng không nói theo ở phần bình luận"]},{"tag":"p","props":{"lang":"vi","className":"life-entry-summary"},"children":["Các điều luật này phạt hành động truyền ra ngoài, không phạt hành động xem. Bạn chuyển tiếp, chuyển vào nhóm, hay nói theo ở phần bình luận thì khi xử lý vụ án đều bị tính là phát tán. Nếu đến mức kêu gọi lật đổ, kêu gọi chia cắt thì phạt tù dưới 5 năm, người cầm đầu thì trên 5 năm. Sách và âm thanh video về chủ nghĩa khủng bố, cực đoan là ngoại lệ: biết là loại đó mà vẫn giữ trong tay, khi nghiêm trọng thì phạt tù dưới 3 năm."]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Chi phí"]},{"tag":"p","props":{},"children":["Không tốn tiền. Đóng trang là xong việc. Không lưu trữ, kh…"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Lợi ích"]},{"tag":"p","props":{},"children":["Dùng bịa đặt tin đồn, vu khống hoặc cách khác để kêu gọi người ta lật đổ chế độ nhà nước, lật đổ chế độ xã hội…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"Đánh dấu: Xem xong trên trang nước ngoài thì đóng lại, không chụp màn hình, không chuyển tiếp, không chuyển vào nhóm, cũng không nói theo ở phần bình luận"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"Hoàn tất"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"Kế hoạch thực hiện"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"Lưu"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Chia sẻ mẹo này"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Ẩn chi tiết"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Chi phí"]},{"tag":"p","props":{},"children":["Không tốn tiền. Đóng trang là xong việc. Không lưu trữ, không chuyển tiếp, không chuyển sang nền tảng trong nước. Không dùng tài khoản trùng với danh tính của bạn để đăng nội dung chính trị lên nền tảng nước ngoài lâu dài. Cũng không nhận tiền bài và trợ cấp do tổ chức, đoàn thể, cá nhân nước ngoài cho. Chỗ khó là nhìn thấy nội dung gây khó chịu mà nhịn không chụp, không chia sẻ."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Lợi ích"]},{"tag":"p","props":{},"children":["Dùng bịa đặt tin đồn, vu khống hoặc cách khác để kêu gọi người ta lật đổ chế độ nhà nước, lật đổ chế độ xã hội chủ nghĩa thì phạt tù dưới 5 năm. Người cầm đầu (điều luật gọi là「首要分子」) hoặc người tội lớn thì phạt tù trên 5 năm, mức tù cao nhất là 15 năm. Kêu gọi chia cắt quốc gia, phá vỡ thống nhất quốc gia thì mức tù y như trên. Cùng tổ chức, đoàn thể, cá nhân nước ngoài làm hai việc đó thì phạt nặng hơn. Tổ chức, đoàn thể hoặc cá nhân trong nước và nước ngoài bỏ tiền trợ cấp cho người khác làm thì người trực tiếp chịu trách nhiệm bị phạt tù dưới 5 năm, nghiêm trọng thì trên 5 năm. Trộm, dò xét, mua, cung cấp trái phép quốc mật hoặc tình báo cho tổ chức, đoàn thể, nhân sự nước ngoài thì phạt tù 5 đến 10 năm. Trong mục này, nghiêm trọng đặc biệt thì trên 10 năm hoặc tù chung thân, nhẹ hơn thì dưới 5 năm. Tội phạm gây nguy hại an ninh quốc gia đều bị tước quyền chính trị 1 đến 5 năm, trong số năm đó bị cắt quyền bầu cử và quyền làm công chức. Có thể phạt kèm tịch thu tài sản, đưa tài sản cá nhân về của nhà nước. Phần xử phạt hành chính cũng có quy định. Không cá nhân, tổ chức nào được dùng mạng để làm hoạt động gây nguy hại an ninh, vinh dự và lợi ích quốc gia. Cũng không được kêu gọi lật đổ chế độ nhà nước, lật đổ chế độ xã hội chủ nghĩa. Không được kêu gọi chia cắt quốc gia, phá vỡ thống nhất quốc gia. Đăng hoặc truyền tải loại thông tin này thì bị xử phạt theo luật và quy chế hành chính liên quan (toàn quốc). Có một loại nữa thì thành tội mà không cần truyền ra. Biết là vật phẩm tuyên truyền chủ nghĩa khủng bố, cực đoan mà vẫn nắm giữ trái phép, đủ mức nghiêm trọng là vào tội. Vật phẩm ở đây gồm sách, tư liệu âm thanh hình ảnh hoặc đồ vật khác. Mức tù là dưới 3 năm, gồm tù giam, giam giữ (nhốt ngắn hạn) hoặc kỉ luật (không giam nhưng bị hạn chế đi lại). Còn phạt kèm hoặc chỉ phạt tiền, tức là vừa kết án vừa phạt tiền, cũng có thể chỉ phạt tiền. Căn cứ là điều một trăm hai mươi, khoản sáu của Bộ luật Hình sự, do Bản sửa đổi (chín) thêm vào."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Nguồn gốc"]},{"tag":"p","props":{"className":"life-citations"},"children":["全国人大 (1997). 刑法（第四十五、五十五、五十六、一百零三、一百零五、一百零六、一百零七、一百一十一、一百一十三条，这几条未经修正案修改）. ",{"tag":"a","props":{"href":"https://www.spp.gov.cn/spp/fl/201802/t20180206_364975.shtml","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.spp.gov.cn/spp/fl/201802/t20180206_364975.shtml"]},"；全国人大常委会 (2025). 网络安全法（2025 年修正，2026 年 1 月 1 日施行，第十三条第二款、第七十一条第一项）. ",{"tag":"a","props":{"href":"https://www.cac.gov.cn/2025-12/29/c_1768735112911946.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.cac.gov.cn/2025-12/29/c_1768735112911946.htm"]},"；全国人大常委会 (2015). 刑法修正案（九）（新增第一百二十条之六）. 国家信访局转载全文 ",{"tag":"a","props":{"href":"https://www.gjxfj.gov.cn/gjxfj/fgwj/flfg/webinfo/2017/03/1601761496614423.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gjxfj.gov.cn/gjxfj/fgwj/flfg/webinfo/2017/03/1601761496614423.htm"]}]},{"tag":"a","props":{"href":"https://www.spp.gov.cn/spp/fl/201802/t20180206_364975.shtml","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Liên kết mở nguồn"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Ghi chú sách"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["Các điều luật dẫn ở mục này phạt hành vi kêu gọi người khác, truyền ra ngoài, cung cấp cho người khác, chỉ xem thì không nằm trong đó. Tài liệu chủ nghĩa khủng bố, cực đoan là ngoại lệ mà điều luật ghi rõ, chỉ riêng việc giữ trong tay đã đủ để định tội (điều một trăm hai mươi, khoản sáu), nên loại này tuyệt đối không được lưu trữ. Nhìn thấy thì dừng lại tại đó: không chụp màn hình lưu, không chuyển tiếp, không bình luận, không rủ người khác cùng chuyển. Chuyển tiếp và nói theo ở phần bình luận, khi xử lý vụ án đều bị tính là phát tán, câu「tôi chỉ chuyển lại thôi」không được miễn trừ. Nội dung lấy từ nền tảng nước ngoài còn có thể bị phạt nặng hơn. Không chắc thật giả thì càng đừng chuyển theo, xem mục 1 của phần này (không chuyển tiếp tin không rõ thật giả). Công cụ vượt tường bị phạt thế nào, xem mục 11 ở phần 11. Chuyển nội dung loại này ra ngoài không mang lại lợi ích thực chất nào, cái giá lại là mức tù, tước quyền chính trị và tịch thu tài sản. Vụ án cùng loại công khai tra cứu được chỉ thấy ở báo chí nước ngoài và văn bản do gia đình công bố, ví dụ một blogger chuyên đăng bình luận chính trị trên nền tảng nước ngoài bị phán năm 2023 là 7 năm. Cuốn sách này không xin được bản án có thể đối chiếu qua kênh chính thức, nên chỉ viết theo điều luật, không kèm vụ án."]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Ghi chú của tôi"]},{"tag":"button","props":{"type":"button"},"children":["Viết một lời nhắc cho chính bạn…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/vi/tip/09-02"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Trước"]},"Không đăng, không chuyển tiếp ảnh, biểu tượng cảm xúc và bình luận xúc phạm liệt sĩ, không đùa cợt với cờ đỏ và quốc ca"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/vi/tip/09-04"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Tiếp theo"]},"Video 