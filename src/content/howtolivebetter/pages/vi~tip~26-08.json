g":"span","props":{},"children":["04"]},"Máy chủ đặt trong nước thì phải đăng ký khai báo, và nhà cung cấp dịch vụ truy cập phải tự có giấy phép viễn thông giá trị gia tăng"]},{"tag":"a","props":{"href":"/vi/tip/26-05"},"children":[{"tag":"span","props":{},"children":["05"]},"Cho người dùng lên bán hàng thì nền tảng phải kiểm tra đăng ký, báo thông tin và lưu giữ ba năm"]},{"tag":"a","props":{"href":"/vi/tip/26-06"},"children":[{"tag":"span","props":{},"children":["06"]},"Nội dung người dùng đăng lên là bạn phải quản: có cơ chế duyệt, có cửa sổ báo việc, thấy nội dung vi phạm thì dừng truyền ngay và báo cáo"]},{"tag":"a","props":{"href":"/vi/tip/26-07"},"children":[{"tag":"span","props":{},"children":["07"]},"Cung cấp dịch vụ đăng thông tin và nhắn tin tức thì phải yêu cầu người dùng cung cấp thông tin danh tính thật"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/vi/tip/26-08","data-status":"active"},"children":[{"tag":"span","props":{},"children":["08"]},"Không mở phát trực tiếp cho người chưa đủ 16 tuổi, tiền thưởng xử lý theo bậc tuổi"]},{"tag":"a","props":{"href":"/vi/tip/26-09"},"children":[{"tag":"span","props":{},"children":["09"]},"Nhận được thông báo vi phạm thì phải xử lý kịp thời, chuyển bản giải trình mà sau 15 ngày không có động tĩnh thì khôi phục lại"]},{"tag":"a","props":{"href":"/vi/tip/26-10"},"children":[{"tag":"span","props":{},"children":["10"]},"Đừng tùy tiện đặt thông tin người dùng ra nước ngoài, việc chuyển dữ liệu ra nước ngoài có điều kiện luật định và có ngưỡng số người"]},{"tag":"a","props":{"href":"/vi/tip/26-11"},"children":[{"tag":"span","props":{},"children":["11"]},"Chọn máy chủ thì xem sập có chịu được không, xem có ai trực vận hành không, cuối cùng mới so giá"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"Breadcrumbs"},"children":[{"tag":"a","props":{"href":"/vi/book"},"children":["Khám phá cuốn sách"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/vi/book/26"},"children":["Chương 26"," ·"," ","Làm một trang web hoặc nền tảng: giấy phép, đăng ký, máy chủ"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"26-08"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["08"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["Bằng chứng"," ","A"]}]},{"tag":"h1","props":{"lang":"vi"},"children":["Không mở phát trực tiếp cho người chưa đủ 16 tuổi, tiền thưởng xử lý theo bậc tuổi"]},{"tag":"p","props":{"lang":"vi","className":"life-entry-summary"},"children":["Người chưa đủ 16 tuổi không được đăng ký tài khoản phát trực tiếp ở chỗ bạn. Đủ 16 tuổi thì phải kiểm tra danh tính, và phải có cha mẹ hoặc người giám hộ khác đồng ý. Tiền thưởng chia ba bậc: dưới 8 tuổi không được thưởng tiền; từ 8 đến 16 tuổi phải có người giám hộ đồng ý; trên 16 tuổi phải có người giám hộ đồng ý hoặc phải kiểm tra giấy tờ chứng minh thu nhập. Trẻ tự thưởng tiền sau lưng người giám hộ thì khi người giám hộ đòi, tòa sẽ xử trả lại."]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Chi phí"]},{"tag":"p","props":{},"children":["Không tốn tiền. Thêm một bước vào mỗi khâu đăng ký và than…"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Lợi ích"]},{"tag":"p","props":{},"children":["Nguyên văn luật là「网络直播服务提供者不得为未满十六周岁的未成年人提供网络直播发布者账号注册服务；"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"Đánh dấu: Không mở phát trực tiếp cho người chưa đủ 16 tuổi, tiền thưởng xử lý theo bậc tuổi"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"Hoàn tất"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"Kế hoạch thực hiện"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"Lưu"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Chia sẻ mẹo này"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Ẩn chi tiết"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Chi phí"]},{"tag":"p","props":{},"children":["Không tốn tiền. Thêm một bước vào mỗi khâu đăng ký và thanh toán: trước hết xác định tuổi, sau đó xác nhận người giám hộ đã đồng ý."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Lợi ích"]},{"tag":"p","props":{},"children":["Nguyên văn luật là「网络直播服务提供者不得为未满十六周岁的未成年人提供网络直播发布者账号注册服务；为年满十六周岁的未成年人提供网络直播发布者账号注册服务时，应当对其身份信息进行认证，并征得其父母或者其他监护人同意」— bên cung cấp dịch vụ phát trực tiếp không được cấp dịch vụ đăng ký tài khoản người phát trực tiếp cho người chưa thành niên chưa đủ mười sáu tuổi; khi cấp cho người chưa thành niên đã đủ mười sáu tuổi thì phải xác thực thông tin danh tính của họ và lấy sự đồng ý của cha mẹ hoặc người giám hộ khác. Nghị định còn yêu cầu「建立网络直播发布者真实身份信息动态核验机制」— lập cơ chế kiểm tra động thông tin danh tính thật của người phát trực tiếp, nghĩa là bạn phải kiểm tra lại được danh tính của người phát bất cứ lúc nào. Ngoài ra phải「合理限制不同年龄阶段未成年人在使用其服务中的单次消费数额和单日累计消费数额」— giới hạn hợp lý số tiền tiêu trong một lần và tổng số tiền tiêu trong một ngày của người chưa thành niên ở từng độ tuổi, tức là đặt trần chi tiêu cho từng giao dịch và từng ngày của người chưa thành niên theo tuổi. Tiền thưởng hiện chia ba bậc:「不得向八周岁以下的未成年人提供打赏服务。向八周岁至十六周岁的未成年人提供打赏服务，应征得其监护人同意。向十六周岁以上的未成年人提供打赏服务，应征得其监护人同意或核验其收入证明材料」— không được cung cấp dịch vụ thưởng tiền cho người chưa thành niên dưới tám tuổi; cung cấp dịch vụ thưởng tiền cho người chưa thành niên từ tám đến mười sáu tuổi thì phải lấy sự đồng ý của người giám hộ; cung cấp dịch vụ thưởng tiền cho người chưa thành niên trên mười sáu tuổi thì phải lấy sự đồng ý của người giám hộ hoặc kiểm tra giấy tờ chứng minh thu nhập của họ. Còn một điều nữa: người chưa thành niên bị hạn chế năng lực dân sự mà tự thưởng tiền khi chưa được người giám hộ đồng ý thì khi người giám hộ đòi tiền, tòa phải có quyết định cho đòi, tiền lấy lại được. Người bị hạn chế năng lực dân sự là người chưa thành niên mà theo pháp luật còn chưa tự quyết hết được cho mình (toàn quốc)"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Nguồn gốc"]},{"tag":"p","props":{"className":"life-citations"},"children":["全国人大常委会 (2020). 未成年人保护法（第七十四、七十六条）. ",{"tag":"a","props":{"href":"https://www.cac.gov.cn/2020-10/22/c_1604928959588622.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.cac.gov.cn/2020-10/22/c_1604928959588622.htm"]}," ; 国务院 (2023). 未成年人网络保护条例（国务院令第 766 号，第三十一、四十四条）. ",{"tag":"a","props":{"href":"https://www.gov.cn/gongbao/2023/issue_10806/202311/content_6913813.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/gongbao/2023/issue_10806/202311/content_6913813.html"]}," ; 中央网信办秘书局 (2026). 关于加强网络直播打赏规范管理的通知（第 7 项）. ",{"tag":"a","props":{"href":"https://www.cac.gov.cn/2026-04/13/c_1777815804150225.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.cac.gov.cn/2026-04/13/c_1777815804150225.htm"]}," ; 最高人民法院 (2020). 关于依法妥善审理涉新冠肺炎疫情民事案件若干问题的指导意见（二）（法发〔2020〕17 号，第九条）. ",{"tag":"a","props":{"href":"https://www.court.gov.cn/fabu/xiangqing/230181.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.court.gov.cn/fabu/xiangqing/230181.html"]}]},{"tag":"a","props":{"href":"https://www.cac.gov.cn/2020-10/22/c_1604928959588622.htm","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Liên kết mở nguồn"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Ghi chú sách"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["Thực sự có tranh chấp hoàn tiền thì xử theo hướng có lợi nhất cho người chưa thành niên. Cách nói về việc này đã thay đổi. Ý kiến của bốn cơ quan năm 2022 và thông báo của Cục Quản lý Phát thanh truyền hình năm 2020 đều nói người chưa thành niên tuyệt đối không được thưởng tiền. Thông báo mới tháng 4 năm 2026 đổi thành chia bậc theo tám tuổi, mười sáu tuổi, nhưng không ghi rõ hai văn bản trước hết hiệu, cơ quan chính thức cũng không nói hai bên liên hệ với nhau thế nào. Nên câu「未成年人一律禁止打赏」bây giờ không còn chính xác"]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Ghi chú của tôi"]},{"tag":"button","props":{"type":"button"},"children":["Viết một lời nhắc cho chính bạn…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/vi/tip/26-07"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Trước"]},"Cung cấp dịch vụ đăng thông tin và nhắn tin tức thì phải yêu cầu người dùng cung cấp thông tin danh tính thật"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/vi/tip/26-09"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Tiếp theo"]},"Nhận được thông báo vi phạm thì phải xử lý kịp thời, chuyển bản giải trình mà sau 15 ngày không có động tĩnh thì khôi phục lại"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["Thêm trong ch