"tag":"path","props":{"d":"M18 20a6 6 0 0 0-12 0"},"children":[]},{"tag":"circle","props":{"cx":"12","cy":"10","r":"4"},"children":[]},{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},{"tag":"span","props":{},"children":["Войти"]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/ru/book/10"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"К содержанию"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["Окупается ли вступление в брак"]},{"tag":"nav","props":{"aria-label":"Советы главы"},"children":[{"tag":"a","props":{"href":"/ru/tip/10-01"},"children":[{"tag":"span","props":{},"children":["01"]},"Знакомьтесь с большим числом людей, а не сосредотачивайтесь на одном: совместимость двух людей невозможно предсказать до встречи"]},{"tag":"a","props":{"href":"/ru/tip/10-02"},"children":[{"tag":"span","props":{},"children":["02"]},"Прекращайте действия после явного отказа — дальнейшее домогательство является нарушением общественного порядка, а не проявлением «доброй воли»"]},{"tag":"a","props":{"href":"/ru/tip/10-03"},"children":[{"tag":"span","props":{},"children":["03"]},"Определяем интерес по поступкам, а не по «сигналам»: кто проявляет инициативу, кто назначает встречу, кто продолжает контакт"]},{"tag":"a","props":{"href":"/ru/tip/10-04"},"children":[{"tag":"span","props":{},"children":["04"]},"Насколько хороши отношения — в основном зависит от ваших собственных ощущений, а не от характеристик партнера"]},{"tag":"a","props":{"href":"/ru/tip/10-05"},"children":[{"tag":"span","props":{},"children":["05"]},"Чтобы сблизиться с человеком, нужно по очереди отвечать на серию вопросов от простых к сложным — и не стоит полагаться на заученные фразы"]},{"tag":"a","props":{"href":"/ru/tip/10-06"},"children":[{"tag":"span","props":{},"children":["06"]},"Отношения на расстоянии не хуже, чем в одном городе, а настоящая проблема — первые три месяца после переезда вместе"]},{"tag":"a","props":{"href":"/ru/tip/10-07"},"children":[{"tag":"span","props":{},"children":["07"]},"Сначала посмотрите статистику регистрации, а потом слушайте советы старших: что такое показатели брачности и разводимости?"]},{"tag":"a","props":{"href":"/ru/tip/10-08"},"children":[{"tag":"span","props":{},"children":["08"]},"Учитываем пользу брака для здоровья, но с поправкой на данные наблюдательных исследований"]},{"tag":"a","props":{"href":"/ru/tip/10-09"},"children":[{"tag":"span","props":{},"children":["09"]},"Разделение неоплачиваемого труда перед регистрацией брака"]},{"tag":"a","props":{"href":"/ru/tip/10-10"},"children":[{"tag":"span","props":{},"children":["10"]},"Сначала ознакомьтесь с законодательными нормами о деньгах и имуществе в браке, а затем решайте, нужно ли заключать письменное соглашение"]},{"tag":"a","props":{"href":"/ru/tip/10-11"},"children":[{"tag":"span","props":{},"children":["11"]},"При внесении родителями средств на покупку жилья необходимо четко указать в документах, является ли это займом или подарком"]},{"tag":"a","props":{"href":"/ru/tip/10-12"},"children":[{"tag":"span","props":{},"children":["12"]},"Долги, взятые супругом без вашего подписания и одобрения, не автоматически становятся вашими долгами"]},{"tag":"a","props":{"href":"/ru/tip/10-13"},"children":[{"tag":"span","props":{},"children":["13"]},"Для получения свидетельства о браке достаточно лишь паспорта и подписанного заявления — домовую книгу (хукоу) предоставлять не нужно, пошлина не взимается, а свидетельство выдаётся сразу на месте"]},{"tag":"a","props":{"href":"/ru/tip/10-14"},"children":[{"tag":"span","props":{},"children":["14"]},"Перед бракосочетанием рекомендуется пройти медицинское обследование; при наличии серьезных заболеваний об этом нужно честно сообщить будущему супругу до регистрации брака"]},{"tag":"a","props":{"href":"/ru/tip/10-15"},"children":[{"tag":"span","props":{},"children":["15"]},"Расчёт затрат на расторжение брака: при добровольном разводе действует 30-дневный период размышлений, а при судебном — требуются определённые условия"]},{"tag":"a","props":{"href":"/ru/tip/10-16"},"children":[{"tag":"span","props":{},"children":["16"]},"Ведите отдельный учёт для брака ради родителей, не смешивая его со своим личным учётом"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/ru/tip/10-17","data-status":"active"},"children":[{"tag":"span","props":{},"children":["17"]},"Отношения в браке как показатель здоровья: спорить следует по существу, не переходя на личности, без оскорблений и насмешек"]},{"tag":"a","props":{"href":"/ru/tip/10-18"},"children":[{"tag":"span","props":{},"children":["18"]},"Пока оба партнера в здравом уме, оформите доверенность, соглашение о добровольном опекунстве и завещание: с юридической точки зрения вы не являетесь близкими родственниками, и без этих документов у вас не будет права подписи и права на наследование"]},{"tag":"a","props":{"href":"/ru/tip/10-19"},"children":[{"tag":"span","props":{},"children":["19"]},"Не стоит скрывать свою сексуальную ориентацию при вступлении в брак, а также не стоит рассматривать фиктивный брак как простой способ решить проблему: с юридической точки зрения это настоящий брак, а для его расторжения остаётся только развод"]},{"tag":"a","props":{"href":"/ru/tip/10-20"},"children":[{"tag":"span","props":{},"children":["20"]},"Отношения зашли в тупик из-за постоянных ссор и «холодной войны»: пара вместе обращается за супружеской терапией. Просто ждать в надежде на улучшение почти не поможет"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"Навигация"},"children":[{"tag":"a","props":{"href":"/ru/book"},"children":["Книга"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/ru/book/10"},"children":["Глава 10"," ·"," ","Окупается ли вступление в брак"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"10-17"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["17"]},{"tag":"span","props":{"className":"life-evidence grade-b"},"children":["Доказательства"," ","B"]}]},{"tag":"h1","props":{"lang":"ru"},"children":["Отношения в браке как показатель здоровья: спорить следует по существу, не переходя на личности, без оскорблений и насмешек"]},{"tag":"p","props":{"lang":"ru","className":"life-entry-summary"},"children":["У супругов с хорошими отношениями здоровье лучше, а риск смертности ниже. Эта связь не очень сильная — она примерно такого же уровня, как влияние рациона на здоровье. В одном эксперименте у пар, которые во время ссоры проявляли постоянную враждебность, заживление небольших ран происходило лишь на 60% быстрее, чем у пар, сохранявших спокойствие."]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Затраты"]},{"tag":"p","props":{},"children":["Никаких затрат не требуется. Во время ссоры следует обсужд…"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Польза"]},{"tag":"p","props":{},"children":["В метаанализе, объединившем 126 исследований с участием более 72 тысяч человек, выявлено: чем выше качество бр…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"Отметить: Отношения в браке как показатель здоровья: спорить следует по существу, не переходя на личности, без оскорблений и насмешек"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"Сделано"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"В планах"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"В избранное"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Поделиться советом"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Скрыть подробности"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Затраты"]},{"tag":"p","props":{},"children":["Никаких затрат не требуется. Во время ссоры следует обсуждать только текущую проблему, не оскорблять партнёра, не насмехаться над ним и не вспоминать прошлые обиды. Сложнее всего — сдерживать себя в момент гнева."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Польза"]},{"tag":"p","props":{},"children":["В метаанализе, объединившем 126 исследований с участием более 72 тысяч человек, выявлено: чем выше качество брака, тем лучше состояние здоровья. Коэффициент корреляции r варьируется от 0,07 до 0,21. Значение 0 означает полное отсутствие связи, а 1 — полное совпадение показателей. Связь с более низким риском смертности имеет коэффициент r = 0,11. При ссорах у таких пар наблюдается меньшая реакция сердечно-сосудистой системы, r = -0,13. Авторы подчёркивают, что все эти эффекты незначительны и сопоставимы по силе с влиянием таких привычек на здоровье, как правильное питание. В другом эксперименте 42 здоровые пары по два раза проходили краткосрочную госпитализацию по 24 часа: в один раз они вели поддерживающий диалог, в другой — обсуждали спорный вопрос. После ссор у пар с высоким уровнем враждебности раны заживали медленнее; их скорость составила лишь 60% от показателей пар с низкой враждебностью. На следующее утро у таких людей в крови наблюдалось более высокое содержание воспалительных маркеров (IL-6, фактор некроза опухоли)."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Первоисточники"]},{"tag":"p","props":{"className":"life-citations"},"children":["Robles TF, Slatcher RB, Trombello JM, McGinn MM (2014). Marital quality and health: a meta-analytic review. Psychological Bulletin. ",{"tag":"a","props":{"href":"https://doi.org/10.1037/a0031859","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1037/a0031859"]},"；Kiecolt-Glaser JK 等 (2005). Hostile marital interactions, proinflammatory cytokine production, and wound healing. Archives of General Psychiatry. ",{"tag":"a","props":{"href":"https://doi.org/10.1001/archpsyc.62.12.1377","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1001/archpsyc.62.12.1377"]}]},{"tag":"a","props":{"href":"https://doi.org/10.1037/a0031859","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Открыть источник"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Примечание автора"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["Причина присвоения категории B: большинство включённых в анализ исследований представляли собой лишь наблюдательные данные без групп сравнения, поэтому невозможно определить, плохие отношения вызывают проблемы со здоровьем или наоборот. Однако после исключения из расчётов факторов возраста и дохода связь между качеством брака и здоровьем сохранялась. В работе Robles также отмечается наличие публикационного смещения в части результатов. Исследования, сравнивавшие мужчин и женщин, в основном не выявили значимых различий между полами. Прямого метаанализа, сопоставляющего уровень смертности у людей в плохих браках и у неженатых/незамужних, не найдено, поэтому утверждение о том, что плохой брак вреднее для здоровья, чем отсутствие брака, остаётся лишь гипотезой. В экспериментах с ранами участвовало всего 42 пары. Рекомендация «обсуждать только суть проблемы, без личных оскорблений» выведена авторами из наблюдений за проявлениями враждебности в ходе экспериментов; прямых исследований, подтверждающих её эффективность, не проводилось. Если ссоры не удаётся предотвратить, парам рекомендуется обратиться за помощью к специалистам по семейной терапии (см. пункт 20 данного раздела). Если во время конфликта возникает физическое насилие, постоянные оскорбления или угрозы, речь идёт уже не о проблемах в общении, а о домашнем насилии (см. пункт 43 раздела 8). Решение об уходе из таких отношений и связанные с этим издержки рассмотрены в пункте 15 данного раздела."]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Моя заметка"]},{"tag":"button","props":{"type":"button"},"children":["Запишите напоминание…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/ru/tip/10-16"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Предыдущий"]},"Ведите отдельный учёт для брака ради родителей, не смешивая его со своим личным учётом"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/ru/tip/10-18"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Следующий"]},"Пока оба партнера в здравом уме, оформите доверенность, соглашение о добровольном опекунстве и завещание: с юридической точки зрения вы не являетесь близкими родственниками, и без этих документов у вас не будет права подписи и права на наследование"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["Другие советы по этой теме"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/10-12"},"children":[{"tag":"strong","props":{},"children":["Долги, взятые супругом без вашего подписания и одобрения, не автоматически становятся вашими долгами"]},{"tag":"span","props":{},"children":["Если супруг взял деньги без вашего ведома, и эта сумма явно превышает…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/10-13"},"children":[{"tag":"strong","props":{},"children":["Для получения свидетельства о браке достаточно лишь паспорта и подписанного заявления — домовую книгу (хукоу) предоставлять не нужно, пошлина не взимается, а свидетельство выдаётся сразу на месте"]},{"tag":"span","props":{},"children":["С мая 2025 года для регистрации брака требуется всего два документа: …"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/10-14"},"children":[{"tag":"strong","props":{},"children":["Перед бракосочетанием рекомендуется пройти медицинское обследование; при наличии серьезных заболеваний об этом нужно честно сообщить будущему супругу до регистрации брака"]},{"tag":"span","props":{},"children":["Если у человека имеются серьезные заболевания, а он не сообщил об это…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/10-15"},"children":[{"tag":"strong","props":{},"children":["Расчёт затрат на расторжение брака: при добровольном разводе действует 30-дневный период размышлений, а при судебном — требуются определённые условия"]},{"tag":"span","props":{},"children":["добровольный развод не завершается сразу после подписания документов.…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/10-19"},"children":[{"tag":"strong","props":{},"children":["Не стоит скрывать свою сексуальную ориентацию при вступлении в брак, а также не стоит рассматривать фиктивный брак как простой способ решить проблему: с юридической точки зрения это настоящий брак, а для его расторжения остаётся только развод"]},{"tag":"span","props":{},"children":["Если скрыть свою сексуальную ориентацию при заключении брака, с юриди…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/10-20"},"children":[{"tag":"strong","props":{},"children":["Отношения зашли в тупик из-за постоянных ссор и «холодной войны»: пара вместе обращается за супружеской терапией. Просто ждать в надежде на улучшение почти не поможет"]},{"tag":"span","props":{},"children":["Пары, у которых отношения зашли в тупик, после прохождения супружеско…"]}]}]}]},{"tag":"a","props":{"className":"life-text-link","href":"/ru/book/10"},"children":["Читать всю тему: Окупается ли вступление в брак"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"15","height":"15","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]}]}]},{"tag":"nav","props":{"className":"life-tabbar","aria-label":"Основная навигация"},"children":[{"tag":"a","props":{"className":"","href":"/ru/book"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"21","height":"21","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-book-open","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M12 7v14"},"children":[]},{"tag":"path","props":{"d":"M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 