:"#四出院前"},"children":["四、出院前"]},{"tag":"a","props":{"href":"#五出生后头一个月"},"children":["五、出生后头一个月"]},{"tag":"a","props":{"href":"#六满月以后到一周岁"},"children":["六、满月以后到一周岁"]}]}]}]},{"tag":"div","props":{"className":"life-longread-main"},"children":[{"tag":"article","props":{"className":"life-article-body","lang":"zh"},"children":[{"tag":"p","props":{},"children":["全书按主题分节，怀孕、生产和带孩子的事散在好几节里。这份清单把它们按时间先后排好，从准备怀孕排到孩子满一周岁。每一项只写要做什么，为什么做、证据有多硬，去后面括号里那一条看。到了哪个阶段，就从哪个小标题往下看。"]},"\n",{"tag":"h2","props":{"id":"一准备怀孕时"},"children":["一、准备怀孕时"]},"\n",{"tag":"ol","props":{},"children":["\n",{"tag":"li","props":{},"children":["每天吃一粒 0.4 毫克的叶酸，提前 3 个月开始吃。见",{"tag":"a","props":{"href":"/book/27#27-01","title":"准备怀孕就开始每天补 0.4 毫克叶酸，一直吃到孕早期满 3 个月"},"children":["第 27 节第 1 条"]},"（叶酸）。"]},"\n",{"tag":"li","props":{},"children":["打一次社保或医保的电话，问清生育保险连续参保的月数够不够。见",{"tag":"a","props":{"href":"/book/27#27-11","title":"怀孕前就确认生育保险的参保状态，未就业的配偶也能报生育医疗费用"},"children":["第 27 节第 11 条"]},"（生育保险）。"]},"\n",{"tag":"li","props":{},"children":["跟同住的家人说好，以后谁也别在屋里抽烟。见",{"tag":"a","props":{"href":"/book/02#02-02","title":"别在家里和车里抽烟，也别让客人在家里抽"},"children":["第 2 节第 2 条"]},"（别在家里和车里抽烟）。"]},"\n",{"tag":"li","props":{},"children":["家里有人靠你的收入过日子，先给挣钱的人买定期寿险。见",{"tag":"a","props":{"href":"/book/05#05-40","title":"家里有人靠你的收入过日子，先给挣钱的人买定期寿险，别先给孩子买"},"children":["第 5 节第 40 条"]},"（定期寿险）。"]},"\n"]},"\n",{"tag":"h2","props":{"id":"二怀孕以后生之前"},"children":["二、怀孕以后、生之前"]},"\n",{"tag":"ol","props":{},"children":["\n",{"tag":"li","props":{},"children":["孕 13 周前去社区卫生服务中心建《母子健康手册》，免费产检从这里领。见",{"tag":"a","props":{"href":"/book/27#27-02","title":"孕 13 周前去社区卫生服务中心建《母子健康手册》，把免费产检额度用掉"},"children":["第 27 节第 2 条"]},"（母子健康手册）。"]},"\n",{"tag":"li","props":{},"children":["第一次产检就查艾滋病、梅毒、乙肝，检测不用自己掏钱。见",{"tag":"a","props":{"href":"/book/27#27-03","title":"第一次产检就把艾滋病、梅毒、乙肝三项查掉，查出来也有免费的阻断"},"children":["第 27 节第 3 条"]},"（艾滋病、梅毒、乙肝三项）。"]},"\n",{"tag":"li","props":{},"children":["整个孕期不抽烟，也一口酒都不喝。见",{"tag":"a","props":{"href":"/book/27#27-04","title":"整个孕期一支烟一口酒都不要，家里人也别在屋里抽"},"children":["第 27 节第 4 条"]},"（一支烟一口酒都不要）。"]},"\n",{"tag":"li","props":{},"children":["产检时把病史说清楚。有子痫前期高危因素的，由医生判断要不要从孕 12 周后吃小剂量阿司匹林。见",{"tag":"a","props":{"href":"/book/27#27-05","title":"有子痫前期高危因素的，孕 12 周后开始每天一片小剂量阿司匹林"},"children":["第 27 节第 5 条"]},"（小剂量阿司匹林）。"]},"\n",{"tag":"li","props":{},"children":["孕 24 周及以后，做一次妊娠期糖尿病筛查。见",{"tag":"a","props":{"href":"/book/27#27-06","title":"孕 24 周及以后做一次妊娠期糖尿病筛查，别嫌喝糖水麻烦"},"children":["第 27 节第 6 条"]},"（妊娠期糖尿病筛查）。"]},"\n",{"tag":"li","props":{},"children":["怀孕 20 周以后，别自己吃布洛芬这类止痛药。见",{"tag":"a","props":{"href":"/book/34#34-05","title":"怀孕 20 周以后，别自己吃布洛芬这类止痛药"},"children":["第 34 节第 5 条"]},"（布洛芬这类止痛药）。"]},"\n",{"tag":"li","props":{},"children":["记住「立刻去医院」的那张清单，也让同住的人记住。见",{"tag":"a","props":{"href":"/book/27#27-07","title":"背下这张「立刻去医院」的清单，孕期和产后一年内都算数"},"children":["第 27 节第 7 条"]},"（立刻去医院的清单）。"]},"\n",{"tag":"li","props":{},"children":["产检时就问医院能不能做无痛分娩。见",{"tag":"a","props":{"href":"/book/27#27-09","title":"想要无痛分娩就直接说，它不增加剖宫产的风险"},"children":["第 27 节第 9 条"]},"（无痛分娩）。"]},"\n",{"tag":"li","props":{},"children":["没有医学指征，不主动要求剖宫产。见",{"tag":"a","props":{"href":"/book/27#27-10","title":"没有医学指征就别主动要求剖宫产，也别为了挑日子开刀"},"children":["第 27 节第 10 条"]},"（剖宫产）。"]},"\n",{"tag":"li","props":{},"children":["不在参保地生的，提前问要不要办异地生育备案。见",{"tag":"a","props":{"href":"/book/27#27-11","title":"怀孕前就确认生育保险的参保状态，未就业的配偶也能报生育医疗费用"},"children":["第 27 节第 11 条"]},"（生育保险）。"]},"\n",{"tag":"li","props":{},"children":["产假至少 98 天，产前可以先休 15 天。见",{"tag":"a","props":{"href":"/book/18#18-02","title":"产假 98 天，生育津贴由生育保险基金按单位上年度职工月平均工资发"},"children":["第 18 节第 2 条"]},"（产假）。"]},"\n",{"tag":"li","props":{},"children":["单位因为怀孕给你降薪、调岗，留好书面通知和聊天记录。见",{"tag":"a","props":{"href":"/book/18#18-03","title":"知道这条：不得因怀孕、生育、哺乳降工资或者辞退"},"children":["第 18 节第 3 条"]},"（不得因怀孕、生育、哺乳降工资）。"]},"\n",{"tag":"li","props":{},"children":["婴儿床、婴儿车先借，借不到买二手。安全座椅和床垫别买二手。见",{"tag":"a","props":{"href":"/book/20#20-11","title":"大件按「借、买二手、买新」的顺序考虑，别一次性配齐"},"children":["第 20 节第 11 条"]},"（借、买二手、买新）。"]},"\n",{"tag":"li","props":{},"children":["尿布先买小包装试一周，合适再囤。见",{"tag":"a","props":{"href":"/book/20#20-10","title":"尿布不看牌子看三件事：合不合身、换得勤不勤、有没有被抽检通报过"},"children":["第 20 节第 10 条"]},"（尿布）。"]},"\n",{"tag":"li","props":{},"children":["提前想好名字，确认户籍系统打得出那几个字。见",{"tag":"a","props":{"href":"/book/27#27-12","title":"出院前把《出生医学证明》办掉，名字提前想好、别写错字"},"children":["第 27 节第 12 条"]},"（出生医学证明）。"]},"\n"]},"\n",{"tag":"h2","props":{"id":"三住院生产时"},"children":["三、住院生产时"]},"\n",{"tag":"ol","props":{},"children":["\n",{"tag":"li","props":{},"children":["破水了就地平躺、垫高臀部、打 120，不要走动。见",{"tag":"a","props":{"href":"/book/27#27-08","title":"破水了就地平躺、垫高臀部、打 120，不要走动也不要洗澡"},"children":["第 27 节第 8 条"]},"（破水）。"]},"\n",{"tag":"li","props":{},"children":["孩子出生后第一个小时里就开始喂奶。见",{"tag":"a","props":{"href":"/book/20#20-04","title":"前 6 个月只喂母乳，连水都不用喂，6 个月起加辅食并继续母乳"},"children":["第 20 节第 4 条"]},"（只喂母乳）。"]},"\n",{"tag":"li","props":{},"children":["出生后 24 小时内打上乙肝疫苗第一针。妈妈乙肝表面抗原阳性的，孩子同时打乙肝免疫球蛋白。见",{"tag":"a","props":{"href":"/book/20#20-02","title":"出生后 24 小时内打上乙肝疫苗第一针"},"children":["第 20 节第 2 条"]},"（乙肝疫苗第一针）。"]},"\n",{"tag":"li","props":{},"children":["维生素 K 针要打。在家生或在不正规机构生的，主动问一句。见",{"tag":"a","props":{"href":"/book/20#20-07","title":"出生时的维生素 K 针一定要打"},"children":["第 20 节第 7 条"]},"（维生素 K 针）。"]},"\n",{"tag":"li","props":{},"children":["足跟血筛查和听力筛查都别拒绝。签知情同意书前，看清哪些是自费加项。见",{"tag":"a","props":{"href":"/book/27#27-13","title":"新生儿足跟血筛查和听力筛查都别拒绝"},"children":["第 27 节第 13 条"]},"（足跟血筛查和听力筛查）。"]},"\n"]},"\n",{"tag":"h2","props":{"id":"四出院前"},"children":["四、出院前"]},"\n",{"tag":"ol","props":{},"children":["\n",{"tag":"li","props":{},"children":["把《出生医学证明》办掉，父母和孩子的姓名、身份证号逐字核对。见",{"tag":"a","props":{"href":"/book/27#27-12","title":"出院前把《出生医学证明》办掉，名字提前想好、别写错字"},"children":["第 27 节第 12 条"]},"（出生医学证明）。"]},"\n",{"tag":"li","props":{},"children":["凭出生医学证明在网上给孩子参居民医保，不用等落户。拿不准就打 12393 问。见",{"tag":"a","props":{"href":"/book/27#27-14","title":"拿到出生医学证明就给孩子办居民医保，别等落完户"},"children":["第 27 节第 14 条"]},"（居民医保）。"]},"\n",{"tag":"li","props":{},"children":["回家的路上就用安全座椅。1 岁以下反向安装，不抱在怀里。见",{"tag":"a","props":{"href":"/book/01#01-10","title":"坐车时给 4 岁以下儿童用安全座椅，不要抱在怀里"},"children":["第 1 节第 10 条"]},"（安全座椅）。"]},"\n"]},"\n",{"tag":"h2","props":{"id":"五出生后头一个月"},"children":["五、出生后头一个月"]},"\n",{"tag":"ol","props":{},"children":["\n",{"tag":"li","props":{},"children":["一个月以内去派出所申报出生登记。见",{"tag":"a","props":{"href":"/book/27#27-15","title":"孩子出生后一个月以内去派出所申报出生登记"},"children":["第 27 节第 15 条"]},"（申报出生登记）。"]},"\n",{"tag":"li","props":{},"children":["落户后去孩子户口所在地申请育儿补贴，每孩每年 3600 元。见",{"tag":"a","props":{"href":"/book/18#18-01","title":"先把能领的算进来：国家育儿补贴每孩每年 3600 元，发到 3 岁"},"children":["第 18 节第 1 条"]},"（育儿补贴）。"]},"\n",{"tag":"li","props":{},"children":["孩子仰着睡，睡硬的平面，同房不同床，床上不放软东西。见",{"tag":"a","props":{"href":"/book/20#20-01","title":"让婴儿期的孩子仰着睡，睡硬的平面，同房不同床，床上不放任何软东西"},"children":["第 20 节第 1 条"]},"（仰着睡）。"]},"\n",{"tag":"li","props":{},"children":["喂配方奶的，用 70 ℃ 以上的水冲，喝剩的倒掉。见",{"tag":"a","props":{"href":"/book/20#20-05","title":"冲奶粉用 70 ℃ 以上的水，冲好放凉再喂，喝剩的倒掉"},"children":["第 20 节第 5 条"]},"（冲奶粉）。"]},"\n",{"tag":"li","props":{},"children":["不满 3 个月的孩子体温到 38 ℃，直接去医院。见",{"tag":"a","props":{"href":"/book/20#20-08","title":"不满 3 个月的婴儿体温到 38 ℃ 就直接去医院，不在家观察"},"children":["第 20 节第 8 条"]},"（体温到 38 ℃）。"]},"\n",{"tag":"li","props":{},"children":["快压不住火时，把孩子放回婴儿床，人走开几分钟。见",{"tag":"a","props":{"href":"/book/20#20-09","title":"无论多累多气都不要摇晃婴儿"},"children":["第 20 节第 9 条"]},"（不要摇晃婴儿）。"]},"\n",{"tag":"li","props":{},"children":["产妇那张「立刻去医院」的清单，产后一年内都算数。见",{"tag":"a","props":{"href":"/book/27#27-07","title":"背下这张「立刻去医院」的清单，孕期和产后一年内都算数"},"children":["第 27 节第 7 条"]},"（立刻去医院的清单）。"]},"\n"]},"\n",{"tag":"h2","props":{"id":"六满月以后到一周岁"},"children":["六、满月以后到一周岁"]},"\n",{"tag":"ol","props":{},"children":["\n",{"tag":"li","props":{},"children":["产后 42 天去做复查，里面有一次产后抑郁筛查。见",{"tag":"a","props":{"href":"/book/27#27-16","title":"产后 42 天那次复查别跳过，它同时是产后抑郁的筛查"},"children":["第 27 节第 16 条"]},"（产后 42 天）。"]},"\n",{"tag":"li","props":{},"children":["按月龄去接种门诊打免疫规划疫苗，百白破从 2 月龄开始。见",{"tag":"a","props":{"href":"/book/20#20-03","title":"按国家免疫规划把该打的疫苗打齐，全程免费，错过了只补没打完的剂次"},"children":["第 20 节第 3 条"]},"（国家免疫规划）。"]},"\n",{"tag":"li","props":{},"children":["前 6 个月只喂母乳。满 6 个月加辅食，每天要有含铁多的动物性食物。见",{"tag":"a","props":{"href":"/book/20#20-04","title":"前 6 个月只喂母乳，连水都不用喂，6 个月起加辅食并继续母乳"},"children":["第 20 节第 4 条"]},"（6 个月起加辅食）。"]},"\n",{"tag":"li","props":{},"children":["不满 1 岁不喂蜂蜜。见",{"tag":"a","props":{"href":"/book/20#20-06","title":"不满 1 岁不喂蜂蜜"},"children":["第 20 节第 6 条"]},"（蜂蜜）。"]},"\n",{"tag":"li","props":{},"children":["有重度湿疹或鸡蛋过敏的，先看医生，再定要不要早点加花生。见",{"tag":"a","props":{"href":"/book/20#20-12","title":"孩子有严重湿疹或鸡蛋过敏，别躲着花生，按医生指导早点加上，但绝不能喂整粒"},"children":["第 20 节第 12 条"]},"（别躲着花生）。"]},"\n",{"tag":"li","props":{},"children":["2 岁以下的孩子感冒，别自己喂复方感冒药。见",{"tag":"a","props":{"href":"/book/34#34-04","title":"2 岁以下的孩子感冒，别自己喂复方感冒药和止咳药"},"children":["第 34 节第 4 条"]},"（复方感冒药）。"]},"\n",{"tag":"li","props":{},"children":["给窗户和阳台装上限位器，纱窗不算防护。见",{"tag":"a","props":{"href":"/book/01#01-11","title":"家里有小孩就给窗户和阳台装限位器，纱窗不算防护"},"children":["第 1 节第 11 条"]},"（窗户和阳台装限位器）。"]},"\n",{"tag":"li","props":{},"children":["0 到 3 岁不给手机、平板这类屏幕。见",{"tag":"a","props":{"href":"/book/30#30-05","title":"0 到 3 岁不给屏幕，3 到 6 岁尽量不给，中小学生非学习用途每天不超过 1 小时"},"children":["第 30 节第 5 条"]},"（不给屏幕）。"]},"\n",{"tag":"li","props":{},"children":["回去上班后，孩子不满一周岁的，每天有 1 小时哺乳时间。见",{"tag":"a","props":{"href":"/book/18#18-03","title":"知道这条：不得因怀孕、生育、哺乳降工资或者辞退"},"children":["第 18 节第 3 条"]},"（哺乳）。"]},"\n",{"tag":"li","props":{},"children":["把职工医保个人账户绑上家庭共济，孩子看病买药能用。见",{"tag":"a","props":{"href":"/book/05#05-13","title":"在医保 App 上办一次家庭共济绑定，职工医保个人账户的钱就能给配偶、父母、子女看病买药"},"children":["第 5 节第 13 条"]},"（家庭共济）。"]},"\n",{"tag":"li","props":{},"children":["每年个税汇算时，填上 3 岁以下婴幼儿照护这项扣除。见",{"tag":"a","props":{"href":"/book/05#05-02","title":"每年三月到六月做一次个税汇算，专项附加扣除该填的填"},"children":["第 5 节第 2 条"]},"（专项附加扣除）。"]},"\n"]},"\n"]},{"tag":"footer","props":{"className":"life-article-attribution"},"children":[{"tag":"p","props":{},"children