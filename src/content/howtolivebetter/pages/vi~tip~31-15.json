:"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Chia sẻ mẹo này"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Ẩn chi tiết"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Chi phí"]},{"tag":"p","props":{},"children":["Không tốn tiền. Mỗi năm quyết toán thuế một lần, thời gian là từ ngày 1 tháng 3 đến ngày 30 tháng 6 năm sau. Khi vượt tổng hạn mức cả năm thì còn phải chuẩn bị hợp đồng lao động và giấy chứng minh thu nhập. Chỗ khó là khoản thuế này bạn phải tự nhớ đi kê khai."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Lợi ích"]},{"tag":"p","props":{},"children":["Việc khoản tiền đó có tính là thu nhập trong nước không thì xem Điều ba của《Quy chế thi hành Luật thuế thu nhập cá nhân》(Hội đồng Nhà nước Lệnh số 707, áp dụng từ ngày 1 tháng 1 năm 2019). Nó viết:「除国务院财政、税务主管部门另有规定外，下列所得，不论支付地点是否在中国境内，均为来源于中国境内的所得：（一）因任职、受雇、履约等在中国境内提供劳务取得的所得」, tức trừ trường hợp cơ quan tài chính, thuế của Hội đồng Nhà nước có quy định khác, thì các khoản thu nhập sau đây, không phân biệt nơi trả có ở trong nước Trung Quốc hay không, đều là thu nhập phát sinh trong nước Trung Quốc; một là thu nhập từ việc cung cấp lao động trong nước Trung Quốc do nhận chức vụ, được thuê mướn, thực hiện hợp đồng. Cùng quy chế đó ở Điều sáu định nghĩa hai khoản thu. Một là tiền lương, tiền công:「工资、薪金所得，是指个人因任职或者受雇取得的工资、薪金、奖金、年终加薪、劳动分红、津贴、补贴以及与任职或者受雇有关的其他所得」, tức thu nhập tiền lương, tiền công là khoản cá nhân nhận được do giữ chức vụ hoặc được thuê mướn, gồm tiền lương, tiền công, thưởng, lương thêm cuối năm, chia lợi nhuận lao động, trợ cấp, bồi thường và các khoản thu nhập khác liên quan đến việc giữ chức vụ hoặc được thuê mướn. Khoản còn lại là thù lao lao động:「劳务报酬所得，是指个人从事劳务取得的所得，包括从事设计、装潢、安装、制图、化验、测试、医疗、法律、会计、咨询、讲学、翻译、审稿、书画、雕刻、影视、录音、录像、演出、表演、广告、展览、技术服务、介绍服务、经纪服务、代办服务以及其他劳务取得的所得」, tức thu nhập từ lao động là thu nhập cá nhân nhận khi làm lao động, gồm thiết kế, trang trí, lắp đặt, vẽ bản đồ, thử nghiệm, kiểm nghiệm, y tế, pháp lý, kế toán, tư vấn, giảng dạy, dịch thuật, phản biên, thư pháp, khắc, điện ảnh, thu âm, quay video, biểu diễn, trình diễn, quảng cáo, triển lãm, dịch vụ kỹ thuật, dịch vụ giới thiệu, dịch vụ môi giới, dịch vụ hộ, và lao động khác. Điều sáu của《Luật thuế thu nhập cá nhân》viết cách tính thu nhập chịu thuế:「居民个人的综合所得，以每一纳税年度的收入额减除费用六万元以及专项扣除、专项附加扣除和依法确定的其他扣除后的余额，为应纳税所得额」, tức thu nhập tổng hợp của cá nhân cư trú là số thu nhập của năm thuế trừ đi khoản chi phí 六万元 và các khoản trừ riêng, trừ riêng bổ sung và khoản trừ khác được xác định theo luật. Cùng điều đó còn viết「劳务报酬所得、稿酬所得、特许权使用费所得以收入减除百分之二十的费用后的余额为收入额」, tức thu nhập từ thù lao lao động, thù lao viết bài và tiền bản quyền sử dụng thì lấy thu nhập trừ 20% chi phí rồi phần còn lại làm thu nhập. Câu trừ 20% chỉ liệt kê ba khoản này, tiền lương không nằm trong đó. Vì vậy tiền lương tính nguyên số vào thu nhập, hai khoản thu cho ra số thuế khác nhau. Điều chín:「个人所得税以所得人为纳税人，以支付所得的单位或者个人为扣缴义务人」, tức thuế thu nhập cá nhân lấy người có thu nhập làm người nộp thuế, lấy đơn vị hoặc cá nhân trả thu nhập làm người khấu trừ. Điều mười:「有下列情形之一的，纳税人应当依法办理纳税申报：……（二）取得应税所得没有扣缴义务人；……（四）取得境外所得」, tức có một trong các trường hợp sau thì người nộp thuế phải kê khai theo luật: hai là có thu nhập chịu thuế mà không có người khấu trừ; bốn là có thu nhập từ nước ngoài. Điều mười một:「居民个人取得综合所得，按年计算个人所得税……需要办理汇算清缴的，应当在取得所得的次年三月一日至六月三十日内办理汇算清缴」, tức thu nhập tổng hợp của cá nhân cư trú thì tính thuế thu nhập cá nhân theo năm; thu nhập nào phải quyết toán thì thực hiện trong khoảng từ ngày 1 tháng 3 đến hết tháng 6 của năm sau. Phần tiền chuyển vào thì xem《Quy chế quản lý ngoại hối cá nhân》(Lệnh của Ngân hàng Nhân dân Trung Quốc〔2006〕số 3, áp dụng từ ngày 1 tháng 2 năm 2007). Điều chín:「对个人结汇和境内个人购汇实行年度总额管理。年度总额内的，凭本人有效身份证件在银行办理；超过年度总额的，经常项目项下凭本人有效身份证件和有交易额的相关证明等材料在银行办理」, tức áp dụng hạn mức tổng cả năm cho việc cá nhân bán ngoại hối và người trong nước mua ngoại hối; trong hạn mức thì ở ngân hàng chỉ cần giấy tùy thân có hiệu lực của chính mình; vượt hạn mức thì ở ngân hàng phải có giấy tùy thân có hiệu lực của chính mình cùng các chứng từ liên quan có số tiền giao dịch và tương tự. Điều bảy:「银行和个人在办理个人外汇业务时，应当遵守本办法的相关规定，不得以分拆等方式逃避限额监管，也不得使用虚假商业单据或者凭证逃避真实性管理」, tức ngân hàng và cá nhân khi làm nghiệp vụ ngoại hối cá nhân phải tuân thủ các quy định của quy chế này, không được chia nhỏ để né kiểm soát hạn mức, cũng không được dùng chứng từ thương mại hoặc giấy tờ giả để né kiểm soát tính xác thực. Điều hai của《Quy chế thi hành chi tiết về quản lý ngoại hối cá nhân》(汇发〔2007〕1 号):「对个人结汇和境内个人购汇实行年度总额管理。年度总额分别为每人每年等值 5 万美元」, tức áp dụng hạn mức tổng cả năm cho việc cá nhân bán ngoại hối và người trong nước mua ngoại hối, hạn mức mỗi người mỗi năm tương đương 5 vạn đô la. Điều mười:「境内个人经常项目项下非经营性结汇超过年度总额的，凭本人有效身份证件及以下证明材料在银行办理：……（七）职工报酬：雇佣合同及收入证明」, tức người trong nước bán ngoại hối phi kinh doanh dưới hạn mức tổng cả năm thì ở ngân hàng cần giấy tùy thân có hiệu lực của chính mình và các chứng từ sau; bảy là thù lao lao động, gồm hợp đồng lao động và giấy chứng minh thu nhập (toàn quốc)"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Nguồn gốc"]},{"tag":"p","props":{"className":"life-citations"},"children":["国务院 (2018). 中华人民共和国个人所得税法实施条例（国务院令第 707 号，第三、六条）. ",{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/2018-12/22/content_5351177.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/zhengce/zhengceku/2018-12/22/content_5351177.htm"]},"；全国人民代表大会常务委员会 (2018). 中华人民共和国个人所得税法（2018 年第七次修正，第六、九、十、十一条）. ",{"tag":"a","props":{"href":"http://www.npc.gov.cn/zgrdw/npc/xinwen/2018-09/05/content_2060671.htm","target":"_blank","rel":"noopener noreferrer"},"children":["http://www.npc.gov.cn/zgrdw/npc/xinwen/2018-09/05/content_2060671.htm"]},"；国家税务总局政策法规库. 中华人民共和国个人所得税法（第六条）. ",{"tag":"a","props":{"href":"https://fgk.chinatax.gov.cn/zcfgk/c100009/c5193028/content.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://fgk.chinatax.gov.cn/zcfgk/c100009/c5193028/content.html"]},"；中国人民银行 (2006). 个人外汇管理办法（中国人民银行令〔2006〕第 3 号，第七、九条）. ",{"tag":"a","props":{"href":"https://www.gov.cn/gongbao/content/2007/content_786257.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/gongbao/content/2007/content_786257.htm"]},"；国家外汇管理局 (2007). 个人外汇管理办法实施细则（汇发〔2007〕1 号，第二、十条）. ",{"tag":"a","props":{"href":"https://www.safe.gov.cn/safe/2007/0105/22509.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.safe.gov.cn/safe/2007/0105/22509.html"]}]},{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/2018-12/22/content_5351177.htm","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Liên kết mở nguồn"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Ghi chú sách"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["Tính theo khoản thu nào thì xét quan hệ giữa bạn và bên kia. Ký hợp đồng lao động, công việc nghe phân công của họ thì tính là tiền lương, tiền công. Tự nhận việc theo dự án, giao kết quả thì tính là thù lao lao động. Hai cách cho ra số thuế khác nhau, trước khi kê khai hãy xác định mình thuộc loại nào. Khi tiền chuyển vào, trong hạn mức tương đương 5 vạn đô la mỗi năm thì chỉ cần giấy tùy thân ở ngân hàng; phần vượt hạn mức thì phải đưa hợp đồng lao động và giấy chứng minh thu nhập cho ngân hàng. Đừng tìm người chia nhỏ để né hạn mức. Những điều viết trên đây nói về trường hợp ở trong nước, không xuất cảnh. Thật sự xuất cảnh đi làm công ăn cho nhà tuyển dụng nước ngoài là bộ khác, xem mục 14 của phần này (muốn đi làm công ăn nước ngoài, trước hết tra công ty này có giấy phép hợp tác lao động ngoài biên giới không). Bốn việc dưới đây sách này tạm chưa viết. Chúng đều có thể có chi phí thực tế, nhưng hiện chưa tra được căn cứ nào đối chiếu từng chữ. Một là khoản thu nhập này có phải nộp thuế giá trị gia tăng không, có phải xuất hoá đơn thay người nộp thuế không. Hai là làm lâu dài như vậy có phải đăng ký giấy phép kinh doanh hay đăng ký làm hộ kinh doanh cá thể không. Ba là có thể theo luật lao động yêu cầu nhà tuyển dụng nước ngoài thực hiện quyền lợi như nghỉ phép năm, tiền làm thêm giờ, bồi thường khi chấm dứt hay không. Bốn là dữ liệu xuất khẩu và bảo mật"]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Ghi chú của tôi"]},{"tag":"button","props":{"type":"button"},"children":["Viết một lời nhắc cho chính bạn…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/vi/tip/31-14"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Trước"]},"Muốn đi làm công ăn nước ngoài, trước hết tra công ty này có giấy phép hợp tác lao động ngoài biên giới không: công ty không được đòi bạn đặt tiền"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/vi/tip/31-16"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Tiếp theo"]},"Không vào cơ quan mà tự làm ăn, tiền khởi đầu hãy xem khoản vay bảo đảm khởi nghiệp: cá nhân tối đa 30 vạn, Nhà nước trợ một nửa lãi suất"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["Thêm trong chủ đề này"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/31-08"