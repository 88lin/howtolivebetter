":"img","props":{"src":"/sites/howtolivebetter/images/book-chapters/23-skills-editorial-thumb.webp","width":"700","height":"525","loading":"lazy","decoding":"async","alt":"Phương pháp học"},"children":[]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"quiz-topic-number"},"children":["0","5"]},{"tag":"h3","props":{},"children":["Phương pháp học"]},{"tag":"p","props":{},"children":["Luyện tập khôi phục, ôn tập theo khoảng cách, hứa hẹn khóa học và chứng chỉ: phân biệt hoạt động với học tập."]},{"tag":"a","props":{"className":"life-text-link","href":"/vi/book/23"},"children":["Đọc chủ đề này",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"15","height":"15","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]}]}]}]},{"tag":"section","props":{"className":"quiz-sample","aria-labelledby":"quiz-sample-title"},"children":[{"tag":"div","props":{},"children":[{"tag":"div","props":{"className":"life-eyebrow"},"children":["Bảo mật tài khoản"]},{"tag":"h2","props":{"id":"quiz-sample-title"},"children":["Thử một câu hỏi trước khi bắt đầu"]},{"tag":"p","props":{},"children":["Ví dụ này đến từ ngân hàng câu hỏi. Chọn một câu trả lời trong đầu, sau đó tiết lộ giải thích. Vòng chơi thực tế của bạn sẽ được chọn riêng biệt."]}]},{"tag":"article","props":{"className":"quiz-sample-question"},"children":[{"tag":"h3","props":{},"children":["Máy của bạn yêu cầu bạn xác nhận một lần đăng nhập mà bạn không thực hiện. Bạn sẽ làm gì?"]},{"tag":"ol","props":{},"children":[{"tag":"li","props":{},"children":["Giả định xác thực hai yếu tố khiến nó an toàn"]},{"tag":"li","props":{},"children":["Từ chối và kiểm tra tài khoản qua trang web chính thức"]},{"tag":"li","props":{},"children":["Gửi ảnh chụp màn hình cho một đại diện không xác định"]},{"tag":"li","props":{},"children":["Xác nhận để dừng cảnh báo"]}]},{"tag":"details","props":{},"children":[{"tag":"summary","props":{},"children":["Tiết lộ câu trả lời và giải thích"]},{"tag":"div","props":{},"children":[{"tag":"strong","props":{},"children":["Từ chối và kiểm tra tài khoản qua trang web chính thức"]},{"tag":"p","props":{},"children":["Chỉ xác nhận các lần đăng nhập mà bạn đã khởi động và nhận biết. Xác thực bổ sung vẫn cần sự chú ý của bạn."]},{"tag":"a","props":{"className":"life-text-link","href":"/vi/book/14#14-01"},"children":["Đọc mục nguồn",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]}]}]}]},{"tag":"section","props":{"aria-labelledby":"quiz-scoring-title"},"children":[{"tag":"h2","props":{"id":"quiz-scoring-title"},"children":["Hiểu những quyết định đằng sau điểm số của bạn"]},{"tag":"p","props":{"className":"quiz-guide-lead"},"children":["Có 20 câu hỏi, mỗi câu 5 điểm, không có hình phạt cho câu trả lời sai. Điểm tối đa là 100. Kết quả của bạn cũng hiển thị câu trả lời đúng trong mỗi trong năm chủ đề để hướng dẫn đọc thêm."]},{"tag":"div","props":{"className":"quiz-level-grid"},"children":[{"tag":"article","props":{},"children":[{"tag":"span","props":{},"children":["90–100 điểm"]},{"tag":"h3","props":{},"children":["Người phát hiện tinh tế"]},{"tag":"p","props":{},"children":["Hầu hết các lựa chọn đều hợp lý. Xem lại các điều kiện liên quan đến bất kỳ câu trả lời nào mà bạn đã bỏ lỡ."]}]},{"tag":"article","props":{},"children":[{"tag":"span","props":{},"children":["70–85 điểm"]},{"tag":"h3","props":{},"children":["Người suy nghĩ cẩn thận"]},{"tag":"p","props":{},"children":["Cơ sở vững chắc. Bắt đầu với chủ đề mà bạn đã bỏ lỡ nhiều câu hỏi nhất."]}]},{"tag":"article","props":{},"children":[{"tag":"span","props":{},"children":["50–65 điểm"]},{"tag":"h3","props":{},"children":["Một vài điểm mù"]},{"tag":"p","props":{},"children":["Một số bẫy quen thuộc vẫn còn tồn tại. So sánh lập luận của bạn với các giải thích."]}]},{"tag":"article","props":{},"children":[{"tag":"span","props":{},"children":["0–45 điểm"]},{"tag":"h3","props":{},"children":["Có những khám phá mới phía trước"]},{"tag":"p","props":{},"children":["Chọn một tình huống mà bạn đã bỏ lỡ và hiểu rõ lời khuyên trước khi áp dụng vào thực tế."]}]}]},{"tag":"p","props":{"className":"quiz-fine"},"children":["Điểm số này mô tả một bộ câu trả lời nhất định. Nó không phải là chứng chỉ hay dự đoán khả năng bạn bị tổn thương hoặc lừa đảo. Các vòng chơi khác chứa các câu hỏi khác nhau, vì vậy điểm số không phải là thứ xếp hạng đáng tin cậy."]}]},{"tag":"section","props":{"aria-labelledby":"quiz-steps-title"},"children":[{"tag":"div","props":{"className":"life-eyebrow"},"children":["Bắt đầu kiểm tra"]},{"tag":"h2","props":{"id":"quiz-steps-title"},"children":["Chuyển đổi bài kiểm tra thành bước hành động thực tế"]},{"tag":"ol","props":{"className":"quiz-step-grid"},"children":[{"tag":"li","props":{},"children":[{"tag":"span","props":{},"children":["0","1"]},{"tag":"h3","props":{},"children":["Chọn điều bạn sẽ thực sự làm"]},{"tag":"p","props":{},"children":["Bắt đầu miễn phí mà không cần tài khoản. Mỗi vòng sẽ rút ngẫu nhiên 20 câu hỏi chọn đơn từ 60 câu hỏi trong ngân hàng và xáo trộn cả câu hỏi và các lựa chọn."]}]},{"tag":"li","props":{},"children":[{"tag":"span","props":{},"children":["0","2"]},{"tag":"h3","props":{},"children":["Tìm ra khoảng trống trong lập luận của bạn"]},{"tag":"p","props":{},"children":["Nộp sau khi trả lời tất cả các câu hỏi. Xem lại tổng số điểm, phân tích theo chủ đề, các lựa chọn và câu trả lời đúng. Tiến trình sẽ được lưu trong trình duyệt này khi có thể lưu trữ."]}]},{"tag":"li","props":{},"children":[{"tag":"span","props":{},"children":["0","3"]},{"tag":"h3","props":{},"children":["Đọc nguồn và chọn một hành động"]},{"tag":"p","props":{},"children":["Theo dõi câu trả lời sai để đến sách, thêm lời khuyên liên quan vào danh sách kiểm tra hoặc chọn một hành động nhỏ từ Nhiệm vụ Hàng ngày."]}]}]}]},{"tag":"section","props":{"className":"quiz-guide-action","aria-labelledby":"quiz-action-title"},"children":[{"tag":"img","props":{"src":"/sites/howtolivebetter/images/book-chapters/04-time-screenprint.webp","alt":"Hình minh họa in màn hình về việc lên kế hoạch thời gian và các hành động nhỏ","width":"700","height":"525","loading":"lazy","decoding":"async"},"children":[]},{"tag":"div","props":{},"children":[{"tag":"div","props":{"className":"life-eyebrow"},"children":["Chia sẻ kết quả của bạn"]},{"tag":"h2","props":{"id":"quiz-action-title"},"children":["Sử dụng kết quả để bắt đầu một cuộc trò chuyện"]},{"tag":"p","props":{},"children":["Xem lại các lỗi trước khi chia sẻ điểm số. Thẻ của bạn bao gồm điểm số, kết quả theo chủ đề và mã QR để bạn bè có thể xem kết quả và thử vòng của họ. Liên kết chỉ chứa tổng số theo chủ đề, không phải các câu trả lời riêng lẻ."]},{"tag":"div","props":{"className":"quiz-actions"},"children":[{"tag":"a","props":{"className":"life-button dark","href":"/vi/daily"},"children":["Chọn một nhiệm vụ hàng ngày",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]},{"tag":"a","props":{"className":"life-text-link","href":"/vi/book"},"children":["Khám phá cuốn sách",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]}]}]},{"tag":"section","props":{"className":"quiz-faq","aria-labelledby":"quiz-faq-title"},"children":[{"tag":"div","props":{"className":"life-eyebrow"},"children":["FAQ"]},{"tag":"h2","props":{"id":"quiz-faq-title"},"children":["Câu hỏi và câu trả lời về các tình huống dễ mắc sai lầm"]},{"tag":"details","props":{},"children":[{"tag":"summary","props":{},"children":["Bài kiểm tra có miễn phí không? Tôi có cần tài khoản không?"]},{"tag":"p","props":{},"children":["Bạn có thể trả lời câu hỏi, đọc giải thích, lưu hình ảnh kết quả và sao chép liên kết chia sẻ miễn phí mà không cần đăng nhập."]}]},{"tag":"details","props":{},"children":[{"tag":"summary","props":{},"children":["Tôi sẽ nhận được cùng những câu hỏi mỗi lần không?"]},{"tag":"p","props":{},"children":["Ngân hàng câu hỏi chứa 60 câu hỏi trên năm chủ đề, với 12 câu hỏi mỗi chủ đề. Mỗi vòng sẽ rút ra 4 câu hỏi mỗi chủ đề cho 20 câu hỏi duy nhất, sau đó xáo trộn cả câu hỏi và các lựa chọn. Các vòng sau có thể lặp lại các câu hỏi từ các vòng trước."]}]},{"tag":"details","props":{},"children":[{"tag":"summary","props":{},"children":["Tôi có thể xem các câu trả lời đúng không?"]},{"tag":"p","props":{},"children":["Sau khi nộp bài, các câu hỏi sai sẽ mở ra với lựa chọn của bạn, câu trả lời đúng, giải thích và liên kết đến cuốn sách. Các câu hỏi trả lời đúng cũng có thể được mở rộng."]}]},{"tag":"details","props":{},"children":[{"tag":"summary","props":{},"children":["Tôi có thể tiếp tục sau khi làm mới trang không?"]},{"tag":"p","props":{},"children":["Vòng hiện tại sẽ được lưu trong trình duyệt này. Xóa dữ liệu trang web, thay đổi thiết bị hoặc chặn lưu trữ có thể xóa tiến trình. Bắt đầu lại sẽ thay thế vòng hiện tại."]}]},{"tag":"details","props":{},"children":[{"tag":"summary","props":{},"children":["Tôi có thể chia sẻ kết quả như thế nào?"]},{"tag":"p","props":{},"children":["Lưu thẻ kết quả QR hoặc sao chép liên kết của nó. Các trang tiếng Anh cung cấp X, Reddit, Facebook, WhatsApp, Instagram và TikTok; các trang tiếng Trung cung cấp các nền tảng địa phương. Một số nền tảng yêu cầu bạn phải dán liên kết hoặc tải lên hình ảnh tự mình."]}]},{"tag":"details","props":{},"children":[{"tag":"summary","props":{},"children":["Các câu trả lời đến từ đâu?"]},{"tag":"p","props":{},"children":["Các câu hỏi được điều chỉnh từ How to Live Better, và các giải thích liên kết đến mục tương ứng. Đây là một bài tập học tập, không phải là đánh giá chuyên nghiệp. Kiểm tra điều kiện nguồn gốc, hoàn cảnh của bạn và các quy tắc địa phương áp dụng."]}]}]},{"tag":"section","props":{"className":"quiz-guide-final"},"children":[{"tag":"h2","props":{},"children":["Những lựa chọn hàng ngày nào sẽ khiến bạn dừng lại?"]},{"tag":"p","props":{},"children":["Bắt đầu miễn phí Pitfall Check và rời với điểm số và bước tiếp theo rõ ràng hơn."]},{"tag":"button","props":{"className":"life-button dark"},"children":["Bắt đầu kiểm tra",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"18","height":"18","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]}]}]},{"tag":"nav","props":{"className":"life-tabbar","aria-label":"Điều hướng chính"},"children":[{"tag":"a","props":{"className":"","href":"/vi/book"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"21","height":"21","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strok