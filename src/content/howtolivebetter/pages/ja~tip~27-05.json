cle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},{"tag":"span","props":{},"children":["ログイン"]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/ja/book/27"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"目次に戻る"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["妊娠と出産：妊娠の判明から退院・手続きまで"]},{"tag":"nav","props":{"aria-label":"この章のヒント"},"children":[{"tag":"a","props":{"href":"/ja/tip/27-01"},"children":[{"tag":"span","props":{},"children":["01"]},"妊娠の準備から毎日 0.4 mgの葉酸を摂取し、妊娠初期の 3 ヶ月まで継続しましょう"]},{"tag":"a","props":{"href":"/ja/tip/27-02"},"children":[{"tag":"span","props":{},"children":["02"]},"妊娠 13 週までに地域保健センターで『母子健康手帳』を作成し、無料妊婦健診の枠を活用しましょう"]},{"tag":"a","props":{"href":"/ja/tip/27-03"},"children":[{"tag":"span","props":{},"children":["03"]},"初回産前検診でHIV、梅毒、B型肝炎の3項目を検査しましょう。陽性であっても無料の予防措置があります"]},{"tag":"a","props":{"href":"/ja/tip/27-04"},"children":[{"tag":"span","props":{},"children":["04"]},"妊娠期間中はタバコもアルコールも一切控え、家族も室内での喫煙は避けてください"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/ja/tip/27-05","data-status":"active"},"children":[{"tag":"span","props":{},"children":["05"]},"子癇前症の高リスク因子がある場合、妊娠 12 週から毎日低用量のアスピリンを服用開始"]},{"tag":"a","props":{"href":"/ja/tip/27-06"},"children":[{"tag":"span","props":{},"children":["06"]},"妊娠 24 週以降に妊娠糖尿病のスクリーニングを一度受けましょう。糖水が面倒だと思わないで"]},{"tag":"a","props":{"href":"/ja/tip/27-07"},"children":[{"tag":"span","props":{},"children":["07"]},"「すぐに病院へ」のチェックリストを保存してください。妊娠中および産後1年間に有効です"]},{"tag":"a","props":{"href":"/ja/tip/27-08"},"children":[{"tag":"span","props":{},"children":["08"]},"破水した場合はその場で仰向けに寝て、臀部を高くし、120 に電話してください。歩き回ったり入浴したりしないでください"]},{"tag":"a","props":{"href":"/ja/tip/27-09"},"children":[{"tag":"span","props":{},"children":["09"]},"無痛分娩を希望する場合ははっきりと伝えましょう。帝王切開のリスクは高まりません"]},{"tag":"a","props":{"href":"/ja/tip/27-10"},"children":[{"tag":"span","props":{},"children":["10"]},"医学的適応がない限り、積極的に帝王切開を求めないでください。また、日取りを選ぶために手術を行うことも避けてください"]},{"tag":"a","props":{"href":"/ja/tip/27-11"},"children":[{"tag":"span","props":{},"children":["11"]},"妊娠前に出産保険の加入状況を確認しておきましょう。未就業の配偶者も出産医療費の請求が可能です"]},{"tag":"a","props":{"href":"/ja/tip/27-12"},"children":[{"tag":"span","props":{},"children":["12"]},"退院前に「出生医学証明書」を済ませましょう。名前は事前に考えておき、誤字がないようにしてください"]},{"tag":"a","props":{"href":"/ja/tip/27-13"},"children":[{"tag":"span","props":{},"children":["13"]},"新生児の踵（かかと）採血スクリーニングと聴覚スクリーニングは、どちらも拒否しないでください"]},{"tag":"a","props":{"href":"/ja/tip/27-14"},"children":[{"tag":"span","props":{},"children":["14"]},"出生医学証明書を受け取ったらすぐに子供の住民医療保険に加入しましょう。戸籍登録（落戸）を待たないでください"]},{"tag":"a","props":{"href":"/ja/tip/27-15"},"children":[{"tag":"span","props":{},"children":["15"]},"子供の出生後、一ヶ月以内に派出所へ出生届を提出してください"]},{"tag":"a","props":{"href":"/ja/tip/27-16"},"children":[{"tag":"span","props":{},"children":["16"]},"産後 42 日のこの検診を飛ばさないで。産後うつのスクリーニングでもあります"]},{"tag":"a","props":{"href":"/ja/tip/27-17"},"children":[{"tag":"span","props":{},"children":["17"]},"妊娠しても猫を手放す必要はない。猫砂は毎日ほかの人が掃除し、肉を十分加熱し、土には手袋を使う"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"現在地"},"children":[{"tag":"a","props":{"href":"/ja/book"},"children":["本を読む"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/ja/book/27"},"children":["第27章"," ·"," ","妊娠と出産：妊娠の判明から退院・手続きまで"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"27-05"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["05"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["エビデンス"," ","A"]}]},{"tag":"h1","props":{"lang":"ja"},"children":["子癇前症の高リスク因子がある場合、妊娠 12 週から毎日低用量のアスピリンを服用開始"]},{"tag":"p","props":{"lang":"ja","className":"life-entry-summary"},"children":["子癇前症は妊娠中に見られる高血圧性疾患です。前回の妊娠での既往、多胎妊娠、慢性高血圧、妊娠前の糖尿病、腎疾患または自己免疫疾患がある場合は高リスクとみなされます。高リスクの方は妊娠 12 週から毎日低用量のアスピリンを1錠服用することで、子癇前症のリスクを約15%低減でき、早産や周産期の乳児死亡率も約20%低減できます。それ以外の方は自己判断で服用しないでください。"]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["費用・手間"]},{"tag":"p","props":{},"children":["数十元。毎日1錠、出産まで継続する必要があります。難しい点は、毎日忘れないことです。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["効果"]},{"tag":"p","props":{},"children":["米国予防サービス作業部会（USPSTF）はBランクの推奨を出しています：子癇前症の高リスク群に対し、妊娠 12 週以降に低用量アスピリン（81 mg/日）の服用を開始することで予防を図ります。"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"記録する：子癇前症の高リスク因子がある場合、妊娠 12 週から毎日低用量のアスピリンを服用開始"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"できている"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"やることに追加"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"お気に入り"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"このヒントを共有"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"詳細を閉じる"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["費用・手間"]},{"tag":"p","props":{},"children":["数十元。毎日1錠、出産まで継続する必要があります。難しい点は、毎日忘れないことです。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["効果"]},{"tag":"p","props":{},"children":["米国予防サービス作業部会（USPSTF）はBランクの推奨を出しています：子癇前症の高リスク群に対し、妊娠 12 週以降に低用量アスピリン（81 mg/日）の服用を開始することで予防を図ります。子癇前症は妊娠中に見られる高血圧性疾患です。複数の研究を統合した結果は以下の通りであり、95% CIは信頼区間を示します。子癇前症のRR 0.85（95% CI 0.75 ～ 0.95、16件の研究）で、約 15% 低減。早産のRR 0.80（95% CI 0.67 ～ 0.95、13件の研究）で、約 20% 低減。周産期死亡のRR 0.79（95% CI 0.66 ～ 0.96、11件の研究）で、約 21% 低減；周産期死亡とは、分娩前後の期間における死亡を指します。SGA（子宮内発育不全）のRRは0.82（95% CI 0.68〜0.99、16件の研究）、約18%の低下。これは、胎児が同じ妊娠週数の児よりも小さく成長していることを意味します。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["出典"]},{"tag":"p","props":{"className":"life-citations"},"children":["US Preventive Services Task Force (2021). Aspirin Use to Prevent Preeclampsia and Related Morbidity and Mortality: Preventive Medication. ",{"tag":"a","props":{"href":"https://www.uspreventiveservicestaskforce.org/uspstf/recommendation/low-dose-aspirin-use-for-the-prevention-of-morbidity-and-mortality-from-preeclampsia-preventive-medication","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.uspreventiveservicestaskforce.org/uspstf/recommendation/low-dose-aspirin-use-for-the-prevention-of-morbidity-and-mortality-from-preeclampsia-preventive-medication"]}]},{"tag":"a","props":{"href":"https://www.uspreventiveservicestaskforce.org/uspstf/recommendation/low-dose-aspirin-use-for-the-prevention-of-morbidity-and-mortality-from-preeclampsia-preventive-medication","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["出典を開く"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["著者の注記"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["高リスクに該当するもの：前回の妊娠で子癇前症を発症した、双胎または多胎妊娠、慢性高学圧がある。また、妊娠前から 1 型または 2 型の糖尿病がある、腎疾患がある、あるいは全身性エリテマトーデスや抗リン脂質抗体症候群などの自己免疫疾患がある場合。これらに該当しない方は自己判断で服用しないでください。この薬は医師の処方箋が必要です。妊婦健診の際に病歴を正確に伝え、医師の判断を仰いでください。国内で主に販売されているのは 100 mgの腸溶錠です。医師の指示に従って服用してください。"]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["自分のメモ"]},{"tag":"button","props":{"type":"button"},"children":["自分へのメモを書く…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/ja/tip/27-04"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","stroke