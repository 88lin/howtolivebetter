okeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["本主题的其他建议"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/17-04"},"children":[{"tag":"strong","props":{},"children":["给老人备好一句随时能说出口的推辞：「我要回去和家里人商量」"]},{"tag":"span","props":{},"children":["推销和诈骗靠的是现场压力，要你来不及想就掏钱。人一激动，就更容易信夸大的广告，老人比年轻人更容易被说动。事先和老人商量好一句「我要回去和家…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/17-05"},"children":[{"tag":"strong","props":{},"children":["凡是让老人先交钱的「投资养老」都别碰：办卡、买床位、买养老公寓、旅居养老、买老年产品是同一套非法集资"]},{"tag":"span","props":{},"children":["让老人先交钱、又许诺回报的养老名目，都是同一套骗局：办卡、买床位、买养老公寓、旅居养老、开会卖老年产品。按规定，这种钱亏了只能自己认。有人…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/17-06"},"children":[{"tag":"strong","props":{},"children":["除了保险公司的住房反向抵押养老保险，其他「以房养老」都别碰，绝不抵押房子去买理财"]},{"tag":"span","props":{},"children":["正规的以房养老只有一种，就是保险公司的住房反向抵押养老保险，还在试点。上门推销的那种和它毫无关系，是骗老人抵押房子，再拿借来的钱买它推荐的…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/17-07"},"children":[{"tag":"strong","props":{},"children":["家里老人长期卧床或重度失能，去参保地医保部门申请长期护理保险；它不是只发给老人"]},{"tag":"span","props":{},"children":["长期护理保险帮你出请人照护的钱。家里有人重度失能、持续半年以上，就去参保地医保部门申请。护理费不用先自己垫，职工参保的报七成左右，城乡居民…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/17-08"},"children":[{"tag":"strong","props":{},"children":["家里有人长期卧床，把压疮当头号敌人：上电动气垫床、定时翻身、每天看一遍骨头突出的地方"]},{"tag":"span","props":{},"children":["髋部骨折开刀前就有压疮的老人，30 天内去世的可能性高约两成。换电动气垫床，新长压疮的少约六成。按时翻身真正做到位，少约七成。别让人长时间…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/17-09"},"children":[{"tag":"strong","props":{},"children":["老人的白内障已经影响看路，就去眼科评估做手术；两只眼都有的，第二只别拖太久"]},{"tag":"span","props":{},"children":["70 岁以上的女性尽快做第一只眼的白内障手术，一年里跌倒的次数少约三成四，骨折的人也少了。但摔过跤的人数没有少。第二只眼做不做，跌倒上没看…"]}]}]}]},{"tag":"a","props":{"className":"life-text-link","href":"/book/17"},"children":["阅读整个主题：家里有老人"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"15","height":"15","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]}]}]}]},{"tag":"aside","props":{"className":"life-ad-space life-ad-space-sponsored","data-ad-placement":"ad_footer","data-ad-group":"reading","data-ad-creative":"read_product","data-ad-ready":"false","aria-label":"广告 · 社区推荐"},"children":[{"tag":"div","props":{"className":"life-ad-space-brand"},"children":[{"tag":"img","props":{"src":"/sites/howtolivebetter/images/shengcai/logo.png","width":"565","height":"144","alt":"生财有术官方 Logo","decoding":"async"},"children":[]}]},{"tag":"div","props":{"className":"life-ad-space-copy"},"children":[{"tag":"span","props":{"className":"life-ad-space-label"},"children":["广告 · 社区推荐"]},{"tag":"strong","props":{},"children":["读过的知识，能不能做成有用的产品？"]},{"tag":"p","props":{},"children":["从电子书、资料到小工具，看看圈友怎样发现需求，把内容变成实际交付。"]}]},{"tag":"div","props":{"className":"life-ad-space-actions"},"children":[{"tag":"a","props":{"className":"life-ad-space-link","href":"/shengcaiyoushu?sc_group=reading&sc_creative=read_product&sc_placement=ad_footer"},"children":["看看社区与案例",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"18","height":"18","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-up-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M7 7h10v10"},"children":[]},{"tag":"path","props":{"d":"M7 17 17 7