chứng chỉ đó có trong Danh mục chứng chỉ nghề nghiệp quốc gia hoặc trong danh sách cơ quan đánh giá đã đăng ký với Bộ Nhân sự và Xã hội không"]},{"tag":"span","props":{},"children":["Có cơ sở nhân danh nghề mới, mức kỹ năng để mở lớp lung tung, thu tiề…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/23-09"},"children":[{"tag":"strong","props":{},"children":["Đào tạo nên đi qua kênh trợ cấp của nhà nước trước, đừng vừa học vừa tự bỏ tiền đăng lớp thương mại"]},{"tag":"span","props":{},"children":["Từ năm 2025 đến cuối năm 2027, nhà nước dự định tổ chức hơn 3000 vạn …"]}]}]}]},{"tag":"a","props":{"className":"life-text-link","href":"/vi/book/23"},"children":["Đọc toàn bộ chủ đề: Học kỹ năng nào thì đáng"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"15","height":"15","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]}]}]},{"tag":"nav","props":{"className":"life-tabbar","aria-label":"Điều hướng chính"},"children":[{"tag":"a","props":{"className":"","href":"/vi/book"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"21","height":"21","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-book-open","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M12 7v14"},"children":[]},{"tag":"path","props":{"d":"M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z"},"children":[]}]},{"tag":"span","props":{},"children":["Sách"]}]},{"tag":"a","props":{"className":"","href":"/vi/top-50"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/20