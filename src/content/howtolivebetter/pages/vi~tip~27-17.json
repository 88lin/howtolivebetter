"fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"Lưu"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Chia sẻ mẹo này"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Ẩn chi tiết"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Chi phí"]},{"tag":"p","props":{},"children":["Không tốn tiền. Giao người nhà dọn cát mỗi ngày. Phải tự dọn thì mua hộp găng dùng một lần. Khó là thịt phải chín hoàn toàn, không ăn bò bít tết hoặc thịt cừu tái."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Lợi ích"]},{"tag":"p","props":{},"children":["CDC Mỹ nói nhiễm Toxoplasma lần đầu ngay trước hoặc trong thai kỳ có thể truyền thai. Đa số trẻ nhiễm chưa có triệu chứng lúc sinh, lớn lên có thể mù hoặc khuyết tật trí tuệ; một số ít đã tổn thương mắt, não nặng khi sinh. NHS Anh nói nhiễm trong thai kỳ có thể sẩy thai. Trung tâm xét nghiệm Toxoplasma Lyon, Pháp thống kê 603 thai phụ chẩn đoán nhiễm khi mang thai, đa số dùng thuốc chống ký sinh trùng. Tỷ lệ truyền thai chung 29% (95% CI 25–33, khoảng tin cậy); nhiễm tuần 13 khoảng 6%, tuần 36 khoảng 72%. Nhiễm càng sớm, trẻ càng dễ có triệu chứng. Nhiễm tuần 24–30 có nguy cơ triệu chứng sớm ở con cao nhất, khoảng 10%. Nghiên cứu sáu thành phố châu Âu so thai phụ mới nhiễm với không nhiễm: nuôi mèo OR 1.0 (95% CI 0.7–1.5), không khác biệt; tự dọn cát OR 1.3 (95% CI 0.8–2.1), khác biệt có thể ngẫu nhiên. Thịt cừu chưa chín OR 3.13 (95% CI 1.4–7.2), nguy cơ khoảng gấp 3; chạm đất OR 1.81 (95% CI 1.2–2.7), cao hơn khoảng 80%. Các thành phố quy 30%–63% ca nhiễm cho thịt chưa chín hoặc thịt ướp, 6%–17% cho chạm đất. CDC Mỹ khuyên thai phụ nhờ người khác thay cát nếu được, không thì đeo găng dùng một lần rồi rửa tay xà phòng và nước. Thay mỗi ngày vì Toxoplasma trong phân mèo cần 1–5 ngày mới lây cho người. Đừng nuôi mèo mới, nhận nuôi hoặc chạm mèo hoang khi mang thai, nhất là mèo con. Giữ mèo trong nhà, chỉ cho thức ăn mèo hoặc thức ăn chín, không thịt sống. CDC Trung Quốc cũng khuyên người bố tương lai dọn cát, phòng hộ tốt thì giữ mèo được. NHS nói vuốt ve hay nuôi mèo không gây nhiễm Toxoplasma."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Nguồn gốc"]},{"tag":"p","props":{"className":"life-citations"},"children":["Centers for Disease Control and Prevention. Toxoplasmosis: Risk Factors. ",{"tag":"a","props":{"href":"https://www.cdc.gov/toxoplasmosis/risk-factors/index.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.cdc.gov/toxoplasmosis/risk-factors/index.html"]},"；Centers for Disease Control and Prevention. Preventing Toxoplasmosis. ",{"tag":"a","props":{"href":"https://www.cdc.gov/toxoplasmosis/prevention/index.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.cdc.gov/toxoplasmosis/prevention/index.html"]},"；NHS. Toxoplasmosis. ",{"tag":"a","props":{"href":"https://www.nhs.uk/conditions/toxoplasmosis/","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.nhs.uk/conditions/toxoplasmosis/"]},"；中国疾病预防控制中心 (2025). 孕期弓形虫感染，都是「吸猫」惹的祸吗？ ",{"tag":"a","props":{"href":"https://www.chinacdc.cn/jkkp/crb/qtcr/202501/t20250103_303681.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.chinacdc.cn/jkkp/crb/qtcr/202501/t20250103_303681.html"]},"；Cook AJ, Gilbert RE, Buffolano W, et al. (2000). Sources of toxoplasma infection in pregnant women: European multicentre case-control study. BMJ, 321(7254), 142-147. ",{"tag":"a","props":{"href":"https://doi.org/10.1136/bmj.321.7254.142","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1136/bmj.321.7254.142"]},"；Dunn D, Wallon M, Peyron F, Petersen E, Peckham C, Gilbert R (1999). Mother-to-child transmission of toxoplasmosis: risk estimates for clinical counselling. Lancet, 353(9167), 1829-1833. ",{"tag":"a","props":{"href":"https://doi.org/10.1016/s0140-6736(98)08220-8","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1016/s0140-6736(98)08220-8"]}]},{"tag":"a","props":{"href":"https://www.cdc.gov/toxoplasmosis/risk-factors/index.html","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Liên kết mở nguồn"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Ghi chú sách"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["Mèo thường chỉ thải Toxoplasma theo phân trong vài tuần sau nhiễm lần đầu. Mèo trưởng thành từng nhiễm ít có khả năng thải lại hơn. Giữ trong nhà, không ăn thịt sống cũng giảm cơ hội nhiễm. Không nuôi mèo vẫn có thể nhiễm từ thịt chưa chín, rau quả chưa rửa, đất nhiễm phân mèo và nước chưa xử lý. Vì vậy nấu chín thịt; rửa dao, thớt, tay sau thịt sống; rửa rau quả dưới nước chảy; đeo găng khi làm vườn, xới đất và rửa tay sau đó. NHS còn khuyên tránh thịt sống ướp như salami, giăm bông Parma, không uống sữa dê chưa tiệt trùng. Nghiên cứu châu Âu không hỏi kỹ rau sống, rau chưa rửa; 14%–49% ca không tìm được nguồn. Có cần xét nghiệm kháng thể Toxoplasma không hãy hỏi bác sĩ khám thai. Xếp B vì số nguy cơ của mèo và thịt chỉ từ một nghiên cứu hồi cứu. Biện pháp từ cơ quan chính thức nhưng chưa nghiên cứu tính làm theo giảm nhiễm bao nhiêu. Lợi ích «trung bình» dựa trên nhận định, lý do trong hồ sơ kiểm chứng. Người hưởng lợi là bạn và con."]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Ghi chú của tôi"]},{"tag":"button","props":{"type":"button"},"children":["Viết một lời nhắc cho chính bạn…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/vi/tip/27-16"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Trước"]},"Đừng bỏ lần tái khám 42 ngày sau khi sinh, lần đó đồng thời là sàng lọc trầm cảm sau sinh"]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["Thêm trong chủ đề này"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/27-10"},"children":[{"tag":"strong","props":{},"children":["Không có chỉ định y tế thì đừng chủ động xin mổ lấy thai, cũng đừng mổ để chọn ngày"]},{"tag":"span","props":{},"children":["Cách nói của Tổ chức Y tế Thế giới là khi tỷ lệ mổ lấy thai ở một địa…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/27-11"},"children":[{"tag":"strong","props":{},"children":["Trước khi mang thai đã xác nhận tình trạng tham gia bảo hiểm sinh sản, người vợ không có việc làm cũng được hoàn phí y tế sinh sản"]},{"tag":"span","props":{},"children":["Đơn vị đã đóng bảo hiểm sinh sản thì phí y tế khi sinh con và khoản t…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/27-12"},"children":[{"tag":"strong","props":{},"children":["Trước khi xuất viện, làm Giấy chứng nhận sinh y tế, nghĩ trước tên con và đừng viết sai chữ"]},{"tag":"spa