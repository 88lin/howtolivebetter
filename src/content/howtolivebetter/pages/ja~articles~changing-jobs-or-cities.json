rity":"high"},"children":[]}]},{"tag":"div","props":{"className":"life-longread-layout"},"children":[{"tag":"aside","props":{"className":"life-longread-toc"},"children":[{"tag":"details","props":{"open":true},"children":[{"tag":"summary","props":{},"children":["この記事の目次"]},{"tag":"nav","props":{"aria-label":"この記事の目次"},"children":[{"tag":"a","props":{"href":"#決める前に健康の勘定"},"children":["決める前に：健康の勘定"]},{"tag":"a","props":{"href":"#決める前に人とのつながり"},"children":["決める前に：人とのつながり"]},{"tag":"a","props":{"href":"#決める前に時間の勘定"},"children":["決める前に：時間の勘定"]},{"tag":"a","props":{"href":"#決める前にお金の勘定"},"children":["決める前に：お金の勘定"]},{"tag":"a","props":{"href":"#退職を申し出る前に"},"children":["退職を申し出る前に"]},{"tag":"a","props":{"href":"#前の会社を離れる数日間"},"children":["前の会社を離れる数日間"]},{"tag":"a","props":{"href":"#新しい会社で契約するとき"},"children":["新しい会社で契約するとき"]},{"tag":"a","props":{"href":"#新しい都市で住まいを探すとき"},"children":["新しい都市で住まいを探すとき"]},{"tag":"a","props":{"href":"#引っ越した後社会保険医療保険受診"},"children":["引っ越した後：社会保険、医療保険、受診"]}]}]}]},{"tag":"div","props":{"className":"life-longread-main"},"children":[{"tag":"article","props":{"className":"life-article-body","lang":"ja"},"children":[{"tag":"p","props":{},"children":["転職や別の都市への引っ越しに関わる事項は、第 2、4、5、7、11、15、19 節などに分かれて掲載されています。以下では、まず健康、人とのつながり、時間、お金という四つの観点から、決める前に確認する項目をまとめます。その後、出発前、入社時、引っ越し後の順に必要な手続きを並べます。各項目には確認することと行うことだけを書いています。数字や根拠は、括弧の前に示した項目を参照してください。移るかどうか、どこへ行くかは、自分で計算して決めてください。ここでは結論を代わりに出しません。会社に解雇された場合は、別の記事「",{"tag":"a","props":{"href":"/ja/articles/after-a-layoff"},"children":["解雇された後にまずすべきこと"]},"」を参照してください。"]},"\n",{"tag":"h2","props":{"id":"決める前に健康の勘定"},"children":["決める前に：健康の勘定"]},"\n",{"tag":"ol","props":{},"children":["\n",{"tag":"li","props":{},"children":["新しい仕事に夜勤があるなら、続ける年数で考えてください。夜勤が 5 年長くなるごとに、心血管疾患のリスクは約 7% 高くなります。仕事を選ぶ時点で、この負担も考慮してください。費用はかかりません。",{"tag":"a","props":{"href":"/ja/book/02#02-39","title":"夜勤の期間が長いほど心血管リスクは高まる。配置転換ができるなら早めに検討を"},"children":["第 2 節第 39 条"]},"（夜勤の年数が長いほど心血管リスクが高い）を参照。"]},"\n",{"tag":"li","props":{},"children":["実際の週の労働時間を確認してください。週 70 時間働いても、週 56 時間の場合と仕事の成果はほぼ変わりません。",{"tag":"a","props":{"href":"/ja/book/03#03-13","title":"週の労働時間をただ増やし続けない：49時間前後を超えると、1時間追加して得られる成果は次第に少なくなる"},"children":["第 3 節第 13 条"]},"（週の労働時間をただ増やし続けない）を参照。"]},"\n",{"tag":"li","props":{},"children":["粉じん、騒音、化学物質に接する仕事なら、面接で三つ聞いてください。職業病の危険があるか、契約に明記されるか、就業前の健康診断の費用は誰が払うか。",{"tag":"a","props":{"href":"/ja/book/19#19-09","title":"粉塵、騒音、化学物質を扱う業務に就く前に、契約書に危害に関する記載があるか確認しましょう。3回の職業健康診断は会社が手配し、費用を負担します"},"children":["第 19 節第 9 条"]},"（粉じん、騒音、化学物質のある仕事に就く前に）を参照。"]},"\n",{"tag":"li","props":{},"children":["新しい会社での就業前、就業中、離職時の三つの職業健康診断は、いずれも会社が手配し、費用を負担します。",{"tag":"a","props":{"href":"/ja/book/19#19-09","title":"粉塵、騒音、化学物質を扱う業務に就く前に、契約書に危害に関する記載があるか確認しましょう。3回の職業健康診断は会社が手配し、費用を負担します"},"children":["第 19 節第 9 条"]},"（三つの職業健康診断は会社が手配して費用を負担する）を参照。"]},"\n"]},"\n",{"tag":"h2","props":{"id":"決める前に人とのつながり"},"children":["決める前に：人とのつながり"]},"\n",{"tag":"ol","props":{},"children":["\n",{"tag":"li","props":{},"children":["職場で長くいじめられていることが転職の理由なら、まず記録して証拠を残してください。いじめられた人は、その後に心臓病や脳卒中になるリスクが約 6 割高くなります。転職は最も大きな代償を伴います。辞めるかどうかは自分で考えてください。",{"tag":"a","props":{"href":"/ja/book/19#19-16","title":"職場で長期にわたりいじめ、罵倒、嫌がらせを受けている場合、一人で耐え込まないこと：まずは証拠を残すために記録し、その性質に応じて、苦情申し立て、通報、または仲裁の手続きを進めること"},"children":["第 19 節第 16 条"]},"（職場で長期にわたりいじめられる）を参照。"]},"\n",{"tag":"li","props":{},"children":["新しい都市に移ると、以前よく会っていた人たちは遠くなります。人付き合いが少ない人は、同じ期間に死亡する確率が約 3 割高くなります。新しい場所でも、定期的に人と会うことを健康のための支出として考えてください。",{"tag":"a","props":{"href":"/ja/book/22#22-09","title":"「定期的に人と会うこと」を健康への投資と考えよう。気分が落ち込んでいる時だけ人に頼るのではなく"},"children":["第 22 節第 9 条"]},"（定期的に人と会うことを健康のための支出と考える）を参照。"]},"\n",{"tag":"li","props":{},"children":["遠距離のパートナーと一緒に住むために都市を移るなら、難所は同居を始めてからの最初の 3 か月です。再び一緒に暮らすようになったカップルの 3 分の 1 は、3 か月以内に別れます。",{"tag":"a","props":{"href":"/ja/book/10#10-06","title":"遠距離恋愛は近距離より悪いわけではない。大きな壁は一緒に暮らし始めてからの3か月"},"children":["第 10 節第 6 条"]},"（同居を始めてからの最初の 3 か月）を参照。"]},"\n",{"tag":"li","props":{},"children":["身近な人の死や失業などの出来事があったばかりで、辞職して他の地域でやり直すよう勧められたら、決定を 3 か月先送りしてください。まず、その件に利害関係のない人に話してください。",{"tag":"a","props":{"href":"/ja/book/29#29-12","title":"大きな変化の直後の3ヶ月間は、いかなる不可逆的な重大決定も、すべて後回しにする"},"children":["第 29 節第 12 条"]},"（取り返しのつかない大きな決断は先送りする）を参照。"]},"\n",{"tag":"li","props":{},"children":["大切な決断は眠って起きてからにし、深夜に決めないでください。",{"tag":"a","props":{"href":"/ja/book/03#03-10","title":"深夜には重大な決断を下さず、重要なメッセージも送らない"},"children":["第 3 節第 10 条"]},"（深夜に重大な決断をしない）を参照。"]},"\n"]},"\n",{"tag":"h2","props":{"id":"決める前に時間の勘定"},"children":["決める前に：時間の勘定"]},"\n",{"tag":"ol","props":{},"children":["\n",{"tag":"li","props":{},"children":["新しい住まいから職場までの片道の所要時間を、まず確認してください。片道が 30 分短くなると、週に 5 時間浮きます。",{"tag":"a","props":{"href":"/ja/book/04#04-18","title":"住居選びでは通勤時間を優先し、片道の通勤時間を短縮する"},"children":["第 4 節第 18 条"]},"（住まい選びでは通勤時間を優先する）を参照。"]},"\n",{"tag":"li","props":{},"children":["通勤の負担の評価には議論があります。長い通勤でも、よりよい仕事や住まいによって埋め合わせられるという研究もあります。",{"tag":"a","props":{"href":"/ja/book/04#04-18","title":"住居選びでは通勤時間を優先し、片道の通勤時間を短縮する"},"children":["第 4 節第 18 条"]},"（片道の通勤時間を短くする）を参照。"]},"\n",{"tag":"li","props":{},"children":["今の会社で何年働いてきたかは、この判断に入れません。今後どれだけ投入し、どれだけ得られるかだけを計算してください。",{"tag":"a","props":{"href":"/ja/book/04#04-03","title":"継続の判断は、過去の投入量ではなく、将来の投入と将来のリターンのみを見る"},"children":["第 4 節第 3 条"]},"（今後の投入と今後の見返りだけを見る）を参照。"]},"\n",{"tag":"li","props":{},"children":["新しい都市でしばらく試すつもりなら、出発前に「何月何日までに、どの指標に達していなければやめる」と一文にして書いてください。",{"tag":"a","props":{"href":"/ja/book/04#04-02","title":"着手前に「撤退条件」を書き留める"},"children":["第 4 節第 2 条"]},"（始める前に撤退条件を書く）を参照。"]},"\n"]},"\n",{"tag":"h2","props":{"id":"決める前にお金の勘定"},"children":["決める前に：お金の勘定"]},"\n",{"tag":"ol","props":{},"children":["\n",{"tag":"li","props":{},"children":["辞める時点で次の仕事が決まっていないなら、生活費 3～6 か月分の緊急予備資金があるか確認してください。",{"tag":"a","props":{"href":"/ja/book/05#05-27","title":"まずは 3 から 6 ヶ月分の生活費を、いつでも引き出せる場所に緊急資金として貯める"},"children":["第 5 節第 27 条"]},"（生活費 3～6 か月分の緊急予備資金）を参照。"]},"\n",{"tag":"li","props":{},"children":["ネットで給料が高いと言われていることを、その職種の人手不足と同じだと考えないでください。移りたい都市の人材不足職種リストと補助金リストを調べてください。",{"tag":"a","props":{"href":"/ja/book/23#23-12","title":"「ネットで給料が高いと言われている」を人手不足の証拠にしないで。現地の不足職種リストと補助金リストを確認しましょう"},"children":["第 23 節第 12 条"]},"（人材不足職種リストと補助金リスト）を参照。"]},"\n",{"tag":"li","props":{},"children":["2025 年の中国全国の 1 人当たり消費支出では、食費が 29.3%、住居費が 21.7% を占めます。仕事を探す際は、食事と住まいが提供されるか確認してください。提供される仕事なら、この二つの大きな支出をなくせます。",{"tag":"a","props":{"href":"/ja/book/07#07-17","title":"住居費と食費を最小限に抑える：シェアハウスの月極利用で日極利用を代替、自炊と食堂利用でデリバリーを代替"},"children":["第 7 節第 17 条"]},"（住居費と食費を最低限に抑える）を参照。"]},"\n",{"tag":"li","props":{},"children":["会社に入らず柔軟な就業形態で働くなら、年金保険と医療保険の保険料は全額自己負担です。現地の算定基準に従うと、毎月 1,000 元以上になります。",{"tag":"a","props":{"href":"/ja/book/31#31-11","title":"組織に属さなければ「フリーランス」：年金と医療保険は就業地での加入が必要、戸籍による制限は緩和済み"},"children":["第 31 節第 11 条"]},"（会社に属さないなら柔軟な就業形態）を参照。"]},"\n",{"tag":"li","props":{},"children":["辞職して学校に戻りたいなら、これを一つの計算問題として考えてください。早く働き始めることで得られる数年分の賃金と、その後の数十年にわたる年収の差を比較します。",{"tag":"a","props":{"href":"/ja/book/23#23-06","title":"「進学か就職か」を一つの計算問題として考える：先に働いて早めに得る3年分の給与と、進学によって得られるその後数十年にわたる年収差の比較"},"children":["第 23 節第 6 条"]},"（進学か就職かを計算問題として考える）を参照。"]},"\n",{"tag":"li","props":{},"children":["賃金未払いや社会保険未加入が理由で辞めるなら、自分から退職を申し出ても経済補償金を受け取れる場合があります。「自己都合による自主退職」には署名しないでください。",{"tag":"a","props":{"href":"/ja/book/19#19-07","title":"「自己都合による自主退職」にはサインしないでください。一度サインしてしまうと、解雇予告手当（N）がもらえなくなります"},"children":["第 19 節第 7 条"]},"（自己都合による自主退職に署名しない）を参照。"]},"\n"]},"\n",{"tag":"h2","props":{"id":"退職を申し出る前に"},"children":["退職を申し出る前に"]},"\n",{"tag":"ol","props":{},"children":["\n",{"tag":"li","props":{},"children":["競業避止契約を結んでいるなら、自分が対象になるか確認してください。対象は経営幹部、高度な技術職、秘密保持義務を負う人に限られ、期間は最長 2 年です。",{"tag":"a","props":{"href":"/ja/book/11#11-12","title":"競業避止義務契約を締結した場合、退職後に会社が毎月補償金を支払わないときは書面で催告すること。3 ヶ月支払われなければ解除可能。営業秘密に触れていない職務については、条項の不適用を請求できる"},"children":["第 11 節第 12 条"]},"（競業避止契約を結んだ場合）を参照。"]},"\n",{"tag":"li","props":{},"children":["競業避止期間中は、会社が毎月補償金を払う必要があります。金額を取り決めていない場合は、離職前 12 か月の平均賃金の 30% です。",{"tag":"a","props":{"href":"/ja/book/11#11-12","title":"競業避止義務契約を締結した場合、退職後に会社が毎月補償金を支払わないときは書面で催告すること。3 ヶ月支払われなければ解除可能。営業秘密に触れていない職務については、条項の不適用を請求できる"},"children":["第 11 節第 12 条"]},"（競業避止契約を結んだ場合）を参照。"]},"\n",{"tag":"li","props":{},"children":["契約が有効で、会社も毎月支払っているのに競合他社で働けば、違約金を払うことになります。",{"tag":"a","props":{"href":"/ja/book/11#11-12","title":"競業避止義務契約を締結した場合、退職後に会社が毎月補償金を支払わないときは書面で催告すること。3 ヶ月支払われなければ解除可能。営業秘密に触れていない職務については、条項の不適用を請求できる"},"children":["第 11 節第 12 条"]},"（競業避止契約を結んだ場合）を参照。"]},"\n",{"tag":"li","props":{},"children":["未消化の年次有給休暇は、離職時に、その年に働いた期間に応じて換算して精算します。「年次有給休暇を自主的に放棄する」という書類には署名しないでください。",{"tag":"a","props":{"href":"/ja/book/19#19-02","title":"年次有給休暇は累計勤続年数に基づき 5、10、15 日付与され、消化できなかった場合は日給の 300% で手当が支払われます"},"children":["第 19 節第 2 条"]},"（年次有給休暇は累計勤続年数で決まる）を参照。"]},"\n",{"tag":"li","props":{},"children":["未払いの残業代も一緒に精算してください。賃金や残業代についての労働仲裁は、離職後 1 年以内に申し立てる必要があります。",{"tag":"a","props":{"href":"/ja/book/19#19-01","title":"残業代は 1.5 倍、2 倍、3 倍の3段階で計算されます。支払われない場合は労働監督署へ通報を。期限内に支払わない場合は 50% から 100% の追加支払い義務が生じます"},"children":["第 19 節第 1 条"]},"（残業代）と",{"tag":"a","props":{"href":"/ja/book/08#08-19","title":"権利保護には期限があります：民事訴訟時効は 3 年、労働仲裁は 1 年、期限を過ぎると相手の「時効超過」の一言で十分です"},"children":["第 8 節第 19 条"]},"（労働仲裁は 1 年以内）を参照。"]},"\n",{"tag":"li","props":{},"children":["パソコンやアカウントを返す前に、給与明細、勤怠記録、労働契約、社会保険の記録、チャット履歴を保存してください。",{"tag":"a","props":{"href":"/ja/book/19#19-08","title":"退職前に、給与明細、勤怠記録、労働契約書、社会保険の記録、およびチャットの履歴を保存しておきましょう"},"children":["第 19 節第 8 条"]},"（離職前に保存する）を参照。"]},"\n",{"tag":"li","props":{},"children":["対立しそうな会話は、その場で録音してください。自分も参加している会話なら、相手の同意を先に得る必要はありません。",{"tag":"a","props":{"href":"/ja/book/08#08-41","title":"トラブルに発展しそうな電話や面談は、直接録音する：自分が参加している会話なら、相手の事前の同意は不要"},"children":["第 8 節第 41 条"]},"（その場で録音する）を参照。"]},"\n"]},"\n",{"tag":"h2","props":{"id":"前の会社を離れる数日間"},"children":["前の会社を離れる数日間"]},"\n",{"tag":"ol","props":{},"children":["\n",{"tag":"li","props":{},"children":["会社に離職証明書を求め、契約期間、離職日、職種、その会社での勤続年数を記載してもらってください。会社は 15 日以内に人事記録と社会保険の移管も行う必要があります。",{"tag":"a","props":{"href":"/ja/book/19#19-17","title":"退職時には会社に離職証明書を請求すること。契約期間、退職日、職種、勤続年数を明記させること"},"children":["第 19 節第 17 条"]},"（離職証明書）を参照。"]},"\n",{"tag":"li","props":{},"children":["離職証明書は、前の会社との契約をすでに解除したことの書面による証拠です。新しい会社が契約未解除の人を雇い、前の会社に損害を与えれば、連帯して賠償責任を負います。",{"tag":"a","props":{"href":"/ja/book/19#19-17","title":"退職時には会社に離職証明書を請求すること。契約期間、退職日、職種、勤続年数を明記させること"},"children":["第 19 節第 17 条"]},"（離職証明書）を参照。"]},"\n",{"tag":"li","props":{},"children":["アカウントの権限はすべて引き継いでください。会社があなたにお金を払っていなくても、データを削除したりパスワードを変えたりしないでください。",{"tag":"a","props":{"href":"/ja/book/11#11-06","title":"退職時にはアカウント権限をすべて返却する。データベースの削除、バックドアの設置、パスワード変更によるシステムのロックは行わない。たとえ会社から未払い賃金があったとしても"},"children":["第 11 節第 6 条"]},"（アカウント権限をすべて引き継ぐ）を参照。"]},"\n",{"tag":"li","props":{},"children":["会社のソースコード、顧客リスト、技術文書は持ち出さず、個人のクラウドストレージにも送らないでください。",{"tag":"a","props":{"href":"/ja/book/11#11-07","title":"退職時にソースコード、顧客リスト、技術文書を持ち出さない、個人のクラウドストレージにアップロードしない、転職先で再利用しない"},"children":["第 11 節第 7 条"]},"（ソースコードを持ち出さない）を参照。"]},"\n",{"tag":"li","props":{},"children":["粉じん、騒音、化学物質に接する仕事なら、離職前に職業健康診断を受け、職業健康管理記録の写しも求めてください。離職時の健康診断をしていなければ、会社は労働契約を解除できません。",{"tag":"a","props":{"href":"/ja/book/19#19-09","title":"粉塵、騒音、化学物質を扱う業務に就く前に、契約書に危害に関する記載があるか確認しましょう。3回の職業健康診断は会社が手配し、費用を負担します"},"children":["第 19 節第 9 条"]},"（職業健康診断）を参照。"]},"\n",{"tag":"li","props":{},"children":["契約解除に伴う一時金を受け取ったら、まず個人所得税を確認してください。現地の前年の従業員平均賃金の 3 倍以内の部分は非課税です。",{"tag":"a","props":{"href":"/ja/book/19#19-18","title":"退職補償金を受け取る際はまず所得税を確認：現地の前年度従業員平均賃金の3倍以内は非課税、超過分は別途計算され、当年の給与とは合算されない"},"children":["第 19 節第 18 条"]},"（離職補償の個人所得税をまず確認する）を参照。"]},"\n",{"tag":"li","props":{},"children":["次の仕事まで間が空き、自己都合退職でもないなら、失業登録をして失業保険金を申請してください。保険料を 1 年以上納めていることが必要です。",{"tag":"a","props":{"href":"/ja/book/07#07-01","title":"失業した際は、まずオンラインで失業保険金の申請を"},"children":["第 7 節第 1 条"]},"（失業保険金）を参照。"]},"\n",{"tag":"li","props":{},"children":["仕事のない期間は生活リズムを固定し、時間どおりに起き、求職活動を決まった予定に組み込んでください。",{"tag":"a","props":{"href":"/ja/book/29#29-03","title":"失業後は、まず生活リズム、医療保険、そして求職活動のペースを固定すること。一日中家に閉じこもらないこと"},"children":["第 29 節第 3 条"]},"（失業後はまず生活リズムを固定する）を参照。"]},"\n"]},"\n",{"tag":"h2","props":{"id":"新しい会社で契約するとき"},"children":["新しい会社で契約するとき"]},"\n",{"tag":"ol","props":{},"children":["\n",{"tag":"li","props":{},"children":["入社書類は最初から最後まで読み、わからないことはその場で聞き、写真を撮って保管してください。",{"tag":"a","props":{"href":"/ja/book/08#08-17","title":"署名前に書類を最後まで読み、代理署名はせず、白紙には署名しない"},"children":["第 8 節第 17 条"]},"（署名前に書類を最後まで読む）を参照。"]},"\n",{"tag":"li","props":{},"children":["試用期間を確認してください。契約期間が 1 年未満なら最長 1 か月、1～3 年なら最長 2 か月、3 年以上なら最長 6 か月です。",{"tag":"a","props":{"href":"/ja/book/19#19-03","title":"試用期間には法定の上限があり、給与は 80% を下回ってはならず、かつ一度しか設定できません"},"children":["第 19 節第 3 条"]},"（試用期間には法定上限がある）を参照。"]},"\n",{"tag":"li","props":{},"children":["試用期間の賃金は、同じ職種の最低等級の賃金または契約で定めた賃金の 80% を下回ってはならず、現地の最低賃金も下回ってはなりません。同じ会社があなたに試用期間を設けられるのは一度だけです。",{"tag":"a","props":{"href":"/ja/book/19#19-03","title":"試用期間には法定の上限があり、給与は 80% を下回ってはならず、かつ一度しか設定できません"},"children":["第 19 節第 3 条"]},"（試用期間には法定上限がある）を参照。"]},"\n",{"tag":"li","props":{},"children":["社会保険は就業初日から納付し、試用期間かどうかには関係しません。",{"tag":"a","props":{"href":"/ja/book/19#19-03","title":"試用期間には法定の上限があり、給与は 80% を下回ってはならず、かつ一度しか設定できません"},"children":["第 19 節第 3 条"]},"（試用期間には法定上限がある）を参照。"]},"\n",{"tag":"li","props":{},"children":["コードを書く仕事やデザインの仕事なら、契約の知的財産条項を確認してください。主に会社の設備、社内ネットワーク、業務データを使って作り、会社が責任を負うソフトウェアの著作権は会社に帰属します。",{"tag":"a","props":{"href":"/ja/book/11#11-13","title":"勤務時間中や会社の資産を使用して書いたコードは会社に帰属する。個人のオープンソースプロジェクトは、自身の時間とデバイスを使用し、会社のコードと混在させないこと"},"children":["第 11 節第 13 条"]},"（会社の資源で書いたコードは会社に帰属する）を参照。"]},"\n",{"tag":"li","props":{},"children":["新しい会社が在職中の競業避止契約を求める場合は、会社が別途お金を払わなくても有効です。",{"tag":"a","props":{"href":"/ja/book/11#11-12","title":"競業避止義務契約を締結した場合、退職後に会社が毎月補償金を支払わないときは書面で催告すること。3 ヶ月支払われなければ解除可能。営業秘密に触れていない職務については、条項の不適用を請求できる"},"children":["第 11 節第 12 条"]},"（競業避止契約を結んだ場合）を参照。"]},"\n"]},"\n",{"tag":"h2","props":{"id":"新しい都市で住まいを探すとき"},"children":["新しい都市で住まいを探すとき"]},"\n",{"tag":"ol","props":{},"children":["\n",{"tag":"li","props":{},"children":["住まいを選ぶ際は、周辺の緑地も考慮してください。費用はかかりません。公園へ行けば寿命が延びる、という意味には取らないでください。",{"tag":"a","props":{"href":"/ja/book/22#22-10","title":"住まいを選ぶときは周辺の緑地を考慮する。ただし「公園に多く行けば」寿命が延びるとは期待しない"},"children":["第 22 節第 10 条"]},"（周辺の緑地を考慮する）を参照。"]},"\n",{"tag":"li","props":{},"children":["敷金の金額、返還時期、差し引ける条件は、署名前に契約に書いてください。",{"tag":"a","props":{"href":"/ja/book/15#15-01","title":"賃貸の保証金は、金額・返還時期・差し引く条件を必ず契約に書く"},"children":["第 15 節第 1 条"]},"（敷金の金額、返還時期、差し引く条件）を参照。"]},"\n",{"tag":"li","props":{},"children":["契約前に不動産登記センターで所有権と抵当権を調べてください。支払いはすべて振り込みにし、備考に「〇〇の住居の〇月分家賃」と記載してください。",{"tag":"a","props":{"href":"/ja/book/15#15-06","title":"中国で賃貸契約する前に権利証と抵当権を確認。支払いは振込にして用途を記録する"},"children":["第 15 節第 6 条"]},"（権利証と抵当権を確認する）を参照。"]},"\n",{"tag":"li","props":{},"children":["家賃と敷金は仲介業者を通さず、大家に直接払ってください。",{"tag":"a","props":{"href":"/ja/book/15#15-03","title":"仲介業者は賃料や敷金の代理受領・代理支払いはできません。お金は直接大家に支払ってください"},"children":["第 15 節第 3 条"]},"（仲介業者は家賃や敷金を代理で受け取ったり支払ったりしてはならない）を参照。"]},"\n",{"tag":"li","props":{},"children":["長期賃貸住宅事業者の物件を借りるなら、まず資金監督口座を公表しているか確認してください。安さにつられて 1 年分を一括で払わないでください。",{"tag":"a","props":{"href":"/ja/book/15#15-04","title":"サービスアパートメントを借りる際は、まず資金管理口座を確認すること。安さに釣られて1年分の一括払いは避ける"},"children":["第 15 節第 4 条"]},"（資金監督口座）を参照。"]},"\n",{"tag":"li","props":{},"children":["間仕切りで細分化した部屋は借りないでください。台所、トイレ、バルコニー、地下の物置には住めません。",{"tag":"a","props":{"href":"/ja/book/15#15-08","title":"仕切り部屋（隔壁部屋）は借りないこと：最小の賃貸単位は元々の設計通りの部屋であり、キッチン、トイレ、バルコニーは居住用として使用できない"},"children":["第 15 節第 8 条"]},"（間仕切り部屋を借りない）を参照。"]},"\n",{"tag":"li","props":{},"children":["賃貸期間中に住居が売られても、賃貸契約は引き続き有効で、引っ越す必要はありません。",{"tag":"a","props":{"href":"/ja/book/15#15-05","title":"賃貸期間中に物件が売却されても、賃貸契約は有効。引っ越す必要なし"},"children":["第 15 節第 5 条"]},"（賃貸契約は引き続き有効）を参照。"]},"\n",{"tag":"li","props":{},"children":["大家が水道や電気を止める、鍵を交換する、押しかけて脅して追い出そうとする場合は、まず警察に通報して対応記録を残してください。",{"tag":"a","props":{"href":"/ja/book/15#15-02","title":"断水・断電、鍵の交換、立ち入りによる退去の脅迫を受けた場合は、まず通報して証拠を残す：法規はこれらの方法で退去を強要することを禁止しています"},"children":["第 15 節第 2 条"]},"（まず警察に通報して証拠を残す）を参照。"]},"\n",{"tag":"li","props":{},"children":["住宅積立金は家賃の支払いにも引き出せます。申請後、住宅積立金センターは 3 日以内に回答する必要があります。",{"tag":"a","props":{"href":"/ja/book/05#05-03","title":"積立金（公積金）は住宅購入のためだけではない：賃貸、リフォーム、管理費の引き出しも可能、2026 年 9 月 20 日より新条例に基づき実施"},"children":["第 5 節第 3 条"]},"（住宅積立金は住宅購入だけに使うものではない）を参照。"]},"\n",{"tag":"li","props":{},"children":["他の地域から働きに来た人は、現地で規定の年数、安定して働いていれば公共賃貸住宅を申請できます。順番待ちに費用はかからず、早く申し込めば早く順番が来ます。",{"tag":"a","props":{"href":"/ja/book/07#07-16","title":"住居に困っているなら、公営賃貸住宅（公租房）の優先枠を"},"children":["第 7 節第 16 条"]},"（住居に困っているならまず公共賃貸住宅の順番待ちに登録する）を参照。"]},"\n",{"tag":"li","props":{},"children":["新しい都市で中古住宅を買い、仲介業者が代わりに購入代金を受け取るなら、銀行に開設した取引資金専用預金口座を使う必要があります。",{"tag":"a","props":{"href":"/ja/book/15#15-07","title":"中古物件の代金支払いを仲介業者に代行させる場合は、必ず業者が銀行に開設した取引資金専用預金口座を使用すること"},"children":["第 15 節第 7 条"]},"（取引資金専用預金口座）を参照。"]},"\n",{"tag":"li","props":{},"children":["都市部の戸籍を持ち、農村へ移って長く住みたいなら、農村住宅は借りるだけにし、1 回の契約は最長 20 年にしてください。宅地使用権やその上の住宅は買わないでください。",{"tag":"a","props":{"href":"/ja/book/15#15-09","title":"都市部の戸籍で田舎への移住を希望する場合、農家住宅を借りるにとどめ、宅基地（宅地使用権）や宅基地上の物件は購入しないこと"},"children":["第 15 節第 9 条"]},"（農村住宅は借りるだけにする）を参照。"]},"\n"]},"\n",{"tag":"h2","props":{"id":"引っ越した後社会保険医療保険受診"},"children":["引っ越した後：社会保険、医療保険、受診"]},"\n",{"tag":"ol","props":{},"children":["\n",{"tag":"li","props":{},"children":["別の地域で働くと、年金保険の加入関係も本人とともに移り、納付年数は引き続き累計されます。中断してもゼロには戻りません。",{"tag":"a","props":{"href":"/ja/book/07#07-18","title":"社会保険の未加入（断缴）に慌てない：年金は累計で計算、医療保険はルールに従って追加入金"},"children":["第 7 節第 18 条"]},"（社会保険の納付が中断しても慌てない）を参照。"]},"\n",{"tag":"li","props":{},"children":["新しい地域で保険に加入して納付した後、新しい会社または自分から新しい加入地に申請し、年金保険と医療保険の加入関係を移してください。",{"tag":"a","props":{"href":"/ja/book/19#19-19","title":"別の都市で働くときは、年金保険と医療保険の加入関係を新しい加入地へ移す。納付年数は累計されるので、脱退しない"},"children":["第 19 節第 19 条"]},"（年金保険の加入関係の移管）を参照。"]},"\n",{"tag":"li","props":{},"children":["年金を受給できる年齢に達する前に、脱退してお金を引き出すことはできません。",{"tag":"a","props":{"href":"/ja/book/19#19-19","title":"別の都市で働くときは、年金保険と医療保険の加入関係を新しい加入地へ移す。納付年数は累計されるので、脱退しない"},"children":["第 19 節第 19 条"]},"（脱退手続きをしない）を参照。"]},"\n",{"tag":"li","props":{},"children":["従業員医療保険の納付が 3 か月を超えて中断すると、新しい地域で医療費の給付を受けるまで最長 6 か月待つことがあります。空白期間を長くしないでください。",{"tag":"a","props":{"href":"/ja/book/19#19-19","title":"別の都市で働くときは、年金保険と医療保険の加入関係を新しい加入地へ移す。納付年数は累計されるので、脱退しない"},"children":["第 19 節第 19 条"]},"（年金保険と医療保険の加入関係を新しい加入地へ移す）を参照。"]},"\n",{"tag":"li","props":{},"children":["戸籍のある省以外の省へ移り、男性は満 50 歳、女性は満 40 歳以上なら、年金保険の加入関係は以前の加入地に残ります。新しい地域では仮口座だけを開設します。",{"tag":"a","props":{"href":"/ja/book/19#19-19","title":"別の都市で働くときは、年金保険と医療保険の加入関係を新しい加入地へ移す。納付年数は累計されるので、脱退しない"},"children":["第 19 節第 19 条"]},"（年金保険と医療保険の加入関係）を参照。"]},"\n",{"tag":"li","props":{},"children":["納付の中断が主に影響するのは、住宅購入、戸籍登録、ポイント制度など、継続した納付を求める現地の資格です。規則は地域ごとに決まるので、新しい都市で調べてください。",{"tag":"a","props":{"href":"/ja/book/07#07-18","title":"社会保険の未加入（断缴）に慌てない：年金は累計で計算、医療保険はルールに従って追加入金"},"children":["第 7 節第 18 条"]},"（社会保険の納付が中断しても慌てない）を参照。"]},"\n",{"tag":"li","props":{},"children":["柔軟な就業形態で働く人は、就業地で年金保険と医療保険に加入できます。戸籍による制限は緩和されています。一部の超大都市ではまだ段階的に緩和しているので、現地で確認してください。",{"tag":"a","props":{"href":"/ja/book/31#31-11","title":"組織に属さなければ「フリーランス」：年金と医療保険は就業地での加入が必要、戸籍による制限は緩和済み"},"children":["第 31 節第 11 条"]},"（戸籍による制限の緩和）を参照。"]},"\n",{"tag":"li","props":{},"children":["途中で自分で住民医療保険を払う必要があるなら、中断しないでください。中断後に納付を再開すると、3 か月間は医療費の給付を受けられません。",{"tag":"a","props":{"href":"/ja/book/07#07-09","title":"住民医療保険の年間 400 元の支払いを中断させないこと。困難世帯は免除・減額が可能"},"children":["第 7 節第 9 条"]},"（年 400 元の住民医療保険を中断しない）を参照。"]},"\n",{"tag":"li","props":{},"children":["高血圧、糖尿病などの慢性疾患があり、医療保険が以前の加入地に残っているなら、二つの手続きが必要です。まず加入地で外来の慢性・特定疾患認定を受け、その後、加入地以外で受診するための登録をしてください。",{"tag":"a","props":{"href":"/ja/book/16#16-02","title":"まずは「外来慢性・特定疾患」の認定を受け、その後に「他地域での受診登録」を行う。これにより、高血圧、糖尿病、放射線・化学療法、透析、抗拒絶反応治療において、他地域での直接精算が可能になる"},"children":["第 16 節第 2 条"]},"（まず外来の慢性・特定疾患認定を受けてから地域外受診の登録をする）を参照。"]},"\n",{"tag":"li","props":{},"children":["「一時的な地域外受診」と「長期の地域外居住」は異なる登録で、給付水準も異なります。",{"tag":"a","props":{"href":"/ja/book/24#24-04","title":"省外での他地域受診の前に、まずは地元の病院に相談を。必要性の判断は原則として副主任医師（副教授級）以上による評価が必要です"},"children":["第 24 節第 4 条"]},"（省をまたいで受診する前に、まず現地で確認する）を参照。"]},"\n",{"tag":"li","props":{},"children":["出発前に診療記録、検査報告、画像を自分で一部保存してください。病院や医師を変えて診てもらうときは、この資料が必要になります。",{"tag":"a","props":{"href":"/ja/book/24#24-05","title":"診察が終わるたびに、診療録、検査報告書、画像資料のコピーを自分で保管しましょう"},"children":["第 24 節第 5 条"]},"（診療記録、検査報告、画像を自分で一部保存する）を参照。"]},"\n",{"tag":"li","props":{},"children":["年の途中で転職したなら、翌年の 3 月から 6 月に個人所得税の年次精算をしてください。通常、還付を受けられます。",{"tag":"a","props":{"href":"/ja/book/05#05-02","title":"毎年3月から6月にかけて確定申告を行い、特別控除の項目は漏れなく記入する"},"children":["第 5 節第 2 条"]},"（個人所得税の年次精算）を参照。"]},"\n"]},"\n"]},{"tag":"footer","props":{"className":"life-article-attribution"},"children":[{"tag":"p","props":{},"children":["このページには当サイトが中国語原文から機械翻訳した文章が含まれ、専門家による校閲は行っていません。医療・法律・金融情報は原文と出典を確認してください。"]},{"tag":"a","props":{"href":"https://github.com/eternity4719/HowToLiveBetter/blob/33362aff50f97f413b22ddfcdb355d2a536a5700/docs/%E6%8D%A2%E5%B7%A5%E4%BD%9C%E3%80%81%E6%8D%A2%E5%9F%8E%E5%B8%82%E4%B9%8B%E5%89%8D.md","target":"_blank","rel":"noopener noreferrer"},"children":["出典の版を見る · 33362af",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"14","height":"14","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]},{"tag":"span","props":{},"children":["取り込み日：2026-10-11"]},{"tag":"p","props":{},"children":["参照リンクは当サイトの版で対応するヒントに移動します。原文の番号とは異なる場合があります。"]}]},{"tag":"div","props":{"className":"life-quick-share"},"children":[{"tag":"button","props":{"type":"button"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","classN