"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Coste"]},{"tag":"p","props":{},"children":["0 yuanes; acude al departamento de asuntos civiles del nivel de distrito o superior a tramitar el registro de adopción, entrega los documentos y espera la revisión y la evaluación de idoneidad"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Beneficio"]},{"tag":"p","props":{},"children":["Artículo 240 del Código Penal: «quien trafique con mujeres o niños será castigado con prisión de 5 a 10 años y multa»; con circunstancias agravantes, prisión de más de 10 años o cadena perpetua, con multa o confiscación de bienes; «cuando las circunstancias sean especialmente graves, pena de muerte con confiscación de bienes». Artículo 17 de la Opinión sobre castigar conforme a la ley los delitos de trata de mujeres y niños: la clave para distinguir la venta del propio hijo de la entrega entre particulares «reside en si el autor tiene el propósito de lucro ilícito»; hay tres situaciones que permiten calificar la conducta como venta del propio hijo y tratarla como trata de mujeres y niños: «hacer de la procreación un medio de lucro ilícito y vender al hijo apenas nacido», «entregar al hijo a otros por dinero a sabiendas de que el receptor no tiene propósito de criarlo, o sin considerar en absoluto si puede criarlo», y «entregar al hijo a otros por cobrar sumas enormes que claramente no son \"gastos de alimentación\" ni \"agradecimiento\"»; la entrega privada sin propósito de lucro, forzada por dificultades de vida, cobrando solo gastos de alimentación o un agradecimiento modesto, es entrega entre particulares y no se trata como trata. Artículo 261 del Código Penal: «quien, teniendo la obligación de mantener a un anciano, un menor, un enfermo u otra persona sin capacidad de vida independiente, se niegue a cumplir esa obligación, en circunstancias atroces, será castigado con prisión de hasta 5 años, detención penal o vigilancia penal». Artículo 1094 del Código Civil: pueden entregar en adopción el tutor de un huérfano, las instituciones de bienestar infantil y los progenitores con dificultades especiales que no pueden mantener a sus hijos; artículo 1105: «la adopción debe registrarse ante el departamento de asuntos civiles del gobierno popular del nivel de distrito o superior. La relación de adopción se constituye desde la fecha del registro»"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Fuentes originales"]},{"tag":"p","props":{"className":"life-citations"},"children":["全国人大 (1997). 刑法（第二百四十、二百六十一条）. ",{"tag":"a","props":{"href":"https://www.spp.gov.cn/spp/fl/201802/t20180206_364975.shtml","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.spp.gov.cn/spp/fl/201802/t20180206_364975.shtml"]},"；最高人民法院、最高人民检察院、公安部、司法部 (2010). 关于依法惩治拐卖妇女儿童犯罪的意见（法发〔2010〕7 号，第 17 条）. 最高人民法院官网 ",{"tag":"a","props":{"href":"https://www.court.gov.cn/fabu/xiangqing/977.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.court.gov.cn/fabu/xiangqing/977.html"]},"；全国人大 (2020). 民法典（第一千零九十四、一千一百零五条）. 盐城市人民政府转载收养编全文 ",{"tag":"a","props":{"href":"https://xxgk.yczf.gov.cn/xzf/ycmzj/fdzdgknr/fgwj_41995/202112/t20211203_1506640.shtml","target":"_blank","rel":"noopener noreferrer"},"children":["https://xxgk.yczf.gov.cn/xzf/ycmzj/fdzdgknr/fgwj_41995/202112/t20211203_1506640.shtml"]}]},{"tag":"a","props":{"href":"https://www.spp.gov.cn/spp/fl/201802/t20180206_364975.shtml","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Abrir fuente"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Nota del autor"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["Esta entrada no discute si tener o no el hijo; resuelve solo la bifurcación que llega después del parto. La secuencia más práctica: parir en el hospital (control prenatal y parto hospitalizado, en la sección 27), porque el certificado médico de nacimiento es el prerrequisito de todos los trámites posteriores; para entregar en adopción, acude primero al departamento de asuntos civiles del nivel de distrito o superior y no pases por intermediarios: en cuanto el dinero cambia de manos, la naturaleza puede cambiar; si en el año posterior al parto aparecen «pensamientos de hacerte daño o de dañar al niño», trátalo como urgencia: la lista de cuándo acudir de inmediato al hospital durante el embarazo y el posparto, en la sección 27, entrada 7; la revisión de los 42 días tras el parto sirve a la vez como cribado de depresión posparto, en la sección 27, entrada 16; y si aparecen pensamientos suicidas, llama al 12356, ver la sección 1, entrada 25. Esta entrada no lleva casos adjuntos: los casos típicos oficiales de trata de hijos propios no se verificaron caso por caso en esta ronda; solo se citan los textos de la ley y de la opinión."]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Mi nota"]},{"tag":"button","props":{"type":"button"},"children":["Escribe un recordatorio…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/es/tip/09-19"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Anterior"]},"Antes de levantar la mano para golpear, haz las cuentas: detención, indemnización, prisión"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/es/tip/09-21"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Siguiente"]},"No falsifiques accidentes ni exageres pérdidas para cobrar el seguro: es el delito de fraude de seguros, y cuentan también los que te ayudan a «probar», reparar el coche o peritar"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["Más en este tema"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/es/tip/09-16"},"children":[{"tag":"strong","props":{},"