ref":"/ja/book/33"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"目次に戻る"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["障害を負った後の生き方"]},{"tag":"div","props":{"data-ad-dock-host":"true"},"children":[]},{"tag":"nav","props":{"aria-label":"この章のヒント"},"children":[{"tag":"a","props":{"href":"/ja/tip/33-01"},"children":[{"tag":"span","props":{},"children":["01"]},"脊髄損傷の後に突然の激しい頭痛や発汗が見られたら、まずは体を起こして座らせ、衣服を緩め、同時に 120 を呼ぶ"]},{"tag":"a","props":{"href":"/ja/tip/33-02"},"children":[{"tag":"span","props":{},"children":["02"]},"障害を負った後の最初の10年間は自殺のハイリスク期です。「前向きに考えれば大丈夫」で済ませないでください"]},{"tag":"a","props":{"href":"/ja/tip/33-03"},"children":[{"tag":"span","props":{},"children":["03"]},"精神障害の入院は自発的な意思を原則とし、本人の同意なしで行えるのは以下の2つのケースのみである"]},{"tag":"a","props":{"href":"/ja/tip/33-04"},"children":[{"tag":"span","props":{},"children":["04"]},"在自宅で障害者を介護している人は、自身の健康管理を怠らないこと"]},{"tag":"a","props":{"href":"/ja/tip/33-05"},"children":[{"tag":"span","props":{},"children":["05"]},"車椅子を長時間使用する場合は、クッションを減圧型に交換し、毎日坐骨と尾骨の状態を確認すること"]},{"tag":"a","props":{"href":"/ja/tip/33-06"},"children":[{"tag":"span","props":{},"children":["06"]},"「麻痺、失明、難聴を治せる」といった療法や器具を買わないこと"]},{"tag":"a","props":{"href":"/ja/tip/33-07"},"children":[{"tag":"span","props":{},"children":["07"]},"障害者手帳の交付後、県級の残聯（障害者連合会）へ行き、申請可能な事項を一度にすべて確認する"]},{"tag":"a","props":{"href":"/ja/tip/33-08"},"children":[{"tag":"span","props":{},"children":["08"]},"7 歳未満で、新たに障害や自閉症（孤独症）が判明した子供については、県級の残聯へリハビリ救済を申請する"]},{"tag":"a","props":{"href":"/ja/tip/33-09"},"children":[{"tag":"span","props":{},"children":["09"]},"自宅のスロープ、手すり、浴室のリフォームについては、県級以上の政府に補助金を申請できる"]},{"tag":"a","props":{"href":"/ja/tip/33-10"},"children":[{"tag":"span","props":{},"children":["10"]},"中国で仕事を探すときは障害者証の所持を伝える。採用で企業の負担金を減らせる"]},{"tag":"a","props":{"href":"/ja/tip/33-11"},"children":[{"tag":"span","props":{},"children":["11"]},"障害者の個人所得税は軽減される可能性があります。軽減額については、各省の税務局へ電話でご確認ください。"]},{"tag":"a","props":{"href":"/ja/tip/33-12"},"children":[{"tag":"span","props":{},"children":["12"]},"盲導犬は公共施設や公共交通機関への同伴が可能で、視覚障害者は市内のバスに無料で乗車できます"]},{"tag":"a","props":{"href":"/ja/tip/33-13"},"children":[{"tag":"span","props":{},"children":["13"]},"障害のある受験生は大学入試（高考）において合理的配慮を申請でき、点字答案を使用する場合、試験時間は1.5倍に延長される"]},{"tag":"a","props":{"href":"/ja/tip/33-14"},"children":[{"tag":"span","props":{},"children":["14"]},"障害のある子供の入学申請に対し、学校は拒否してはならない。登校が困難な場合は、教育局が訪問指導の手配を行う"]},{"tag":"a","props":{"href":"/ja/tip/33-15"},"children":[{"tag":"span","props":{},"children":["15"]},"右下肢または両下肢を欠損していても運転免許の取得は可能。準拠車種は C5 と呼ばれる"]},{"tag":"a","props":{"href":"/ja/tip/33-16"},"children":[{"tag":"span","props":{},"children":["16"]},"リハビリはリハビリテーション科のある正規の機関で行うこと。強度は療法士の指示に従う。激しければ良いというものではない"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/ja/tip/33-17","data-status":"active"},"children":[{"tag":"span","props":{},"children":["17"]},"難聴を感じたら補聴器を検討すること。補聴器を使用する理由は「聞こえるようにするため」であり、「認知症予防のため」ではない"]},{"tag":"a","props":{"href":"/ja/tip/33-18"},"children":[{"tag":"span","props":{},"children":["18"]},"成人が「自身の事柄を管理できない」と判断するには、裁判所に申し立てて認定を受ける必要があり、家族の判断だけでは不十分である"]},{"tag":"a","props":{"href":"/ja/tip/33-19"},"children":[{"tag":"span","props":{},"children":["19"]},"成人の後見人は法定順序に従って定められます。被後見人が他人に損害を与えた場合、後見人が賠償します"]},{"tag":"a","props":{"href":"/ja/tip/33-20"},"children":[{"tag":"span","props":{},"children":["20"]},"障害を理由とした採用拒否、正社員登用拒否、給与の過少支払いは訴えることが可能ですが、まずはプロセスに伴うコストを計算してください"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"現在地"},"children":[{"tag":"a","props":{"href":"/ja/book"},"children":["本を読む"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/ja/book/33"},"children":["第33章"," ·"," ","障害を負った後の生き方"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"33-17"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["17"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["エビデンス"," ","A"]}]},{"tag":"h1","props":{"lang":"ja"},"children":["難聴を感じたら補聴器を検討すること。補聴器を使用する理由は「聞こえるようにするため」であり、「認知症予防のため」ではない"]},{"tag":"p","props":{"lang":"ja","className":"life-entry-summary"},"children":["「補聴器の使用が認知症を予防できる」という説は、現時点では確立されていません。約1,000人を対象とした3年間の試験では、全体として差は見られませんでした。認知機能低下のリスクが元々高いグループにおいてのみ、差が見られました。したがって、補聴器を使用する理由は、今現在聞こえること、人と会話ができること、道を渡る際に車の音が聞こえることのことであり、数十年後の脳のためではありません。"]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["費用・手間"]},{"tag":"p","props":{},"children":["補聴器は数千から数万元で、多くは自費となります。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["効果"]},{"tag":"p","props":{},"children":["ACHIEVE試験は、米国の 4 個のコミュニティにおいて、未治療の難聴があり、明らかな認知障害のない 70 歳から 84 歳までの 977 名を対象に実施されました。"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"記録する：難聴を感じたら補聴器を検討すること。補聴器を使用する理由は「聞こえるようにするため」であり、「認知症予防のため」ではない"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"できている"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"やることに追加"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"お気に入り"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"このヒントを共有"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"詳細を閉じる"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["費用・手間"]},{"tag":"p","props":{},"children":["補聴器は数千から数万元で、多くは自費となります。フィッティング（調整）が必要であり、数回の再調整のために通院する必要があります。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["効果"]},{"tag":"p","props":{},"children":["ACHIEVE試験は、米国の 4 個のコミュニティにおいて、未治療の難聴があり、明らかな認知障害のない 70 歳から 84 歳までの 977 名を対象に実施されました。参加者は、聴覚介入（聴覚カウンセリングおよび補聴器の処方）を受けるグループと、健康教育を受ける対照グループにランダムに分けられ、6 か月ごとにフォローアップが行われました。主要エンドポイントは、3 年間における全般的な認知機能スコアの変化です。2つのソース集団を統合した主要解析では、両群間に有意な差は認められませんでした：介入群 −0.200（95% CI −0.256 から −0.144）、対照群 −0.202（95% CI −0.258 から −0.145）、差 0.002（95% CI −0.077 から 0.081）、P=0.96。あらかじめ設定された感度分析では、介入効果に2つのソース集団間で差があることが示されました（交互作用 P=0.010）。長期心血管健康観察研究の参加者は、より高齢で、認知機能低下のリスク因子が多く、ベースラインの認知スコアが低い傾向にありました。研究者の結論は、聴覚介入が認知機能低下のリスクが高い集団においては 3 年間の認知機能の変化を減少させる可能性がある一方で、リスクが低い集団においては効果がないということである。試験では、本研究に起因する重篤な有害事象は報告されていない"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["出典"]},{"tag":"p","props":{"className":"life-citations"},"children":["Lin FR, Pike JR, Albert MS, et al.; ACHIEVE Collaborative Research Group (2023). Hearing intervention versus health education control to reduce cognitive decline in older adults with hearing loss in the USA (ACHIEVE): a multicentre, randomised controlled trial. Lancet, 402(10404):786-797. ",{"tag":"a","props":{"href":"https://doi.org/10.1016/S0140-6736(23)01406-X","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1016/S0140-6736(23)01406-X"]}]},{"tag":"a","props":{"href":"https://doi.org/10.1016/S0140-6736(23)01406-X","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["出典を開く"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["著者の注記"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["論争：ネット上でよく見られる「補聴器により認知機能の低下が半減した」という情報は、この試験のサブグループの結果であり、主要な結果ではありません。主要な結果は、両グループ間に差がなかったことです。「補聴器の使用」と「認知症予防」は分けて考える必要があります。前者は行うべきことですが、後者を理由にしてはいけません。聴覚障害のある受験者が大学入試で外国語のリスニングを免除されることは、本節第 13 条（合理的配慮）を参照してください。聴覚障害のある人が運転する際は、補聴器などの機器を装着すべきです。本節第 15 条（C5）を参照してください。"]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["自分のメモ"]},{"tag":"button","props":{"type":"button"},"children":["自分へのメモを書く…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/ja/tip/33-16"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["前へ"]},"リハビリはリハビリテーション科のある正規の機関で行うこと。強度は療法士の指示に従う。激しければ良いというものではない"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/ja/tip/33-18"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["次へ"]},"成人が「自身の事柄を管理できない」と判断するには、裁判所に申し立てて認定を受ける必要があり、家族の判断だけでは不十分である"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["このテーマの他の提案"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/33-12"},"children":[{"tag":"strong","props":{},"children":["盲導犬は公共施設や公共交通機関への同伴が可能で、視覚障害者は市内のバスに無料で乗車できます"]},{"tag":"span","props":{},"children":["法律には、公共施設や公共交通機関は、盲導犬、聴導犬、介助犬を伴う障害者に利便性を提供しなければならないと明記されています。視覚障害者は有効…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/33-13"},"children":[{"tag":"strong","props":{},"children":["障害のある受験生は大学入試（高考）において合理的配慮を申請でき、点字答案を使用する場合、試験時間は1.5倍に延長される"]},{"tag":"span","props":{},"children":["障害のある受験生は、大学入試（高考）において、点字答案、拡大文字答案、外国語リスニング免除、別室受験、補聴器や車椅子の持ち込み、および試験…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/33-14"},"children":[{"tag":"strong","props":{},"children":["障害のある子供の入学申請に対し、学校は拒否してはならない。登校が困難な場合は、教育局が訪問指導の手配を行う"]},{"tag":"span","props":{},"children":["幼稚園および各種学校は、条件を満たす障害のある子供の入学申請を拒否してはならず、普通科・職業学校も同様です。介助が必要で登校が困難な子供に…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/33-15"},"children":[{"tag":"strong","props":{},"children":["右下肢または両下肢を欠損していても運転免許の取得は可能。準拠車種は C5 と呼ばれる"]},{"tag":"span","props":{},"children":["右下肢または両下肢を欠損している、あるいは動かせない場合でも、自力で安定して座ることができ、上肢の条件を満たしている人は、障害者専用のオー…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/33-19"},"children":[{"tag":"strong","props":{},"children":["成人の後見人は法定順序に従って定められます。被後見人が他人に損害を与えた場合、後見人が賠償します"]},{"tag":"span","props":{},"children":["成人が行為能力を喪失した後、後見人は以下の順序で決まります：配偶者、父母および子、その他の近親者、最後に後見人となる意思のある個人または組…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/33-20"},"children":[{"tag":"strong","props":{},"children":["障害を理由とした採用拒否、正社員登用拒否、給与の過少支払いは訴えることが可能ですが、まずはプロセスに伴うコストを計算してください"]},{"tag":"span","props":{},"children":["法律は、採用、正社員登用、昇進、职称（職位）の評価、報酬、社会保険において、障害者を差別することを禁止しています。主管部門への投書や、裁判…"]}]}]}]},{"tag":"a","props":{"className":"life-text-link","href":"/ja/book/33"},"children":["テーマ全体を読む：障害を負った後の生き方"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"15","height":"15","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]}]}]}]},{"tag":"aside","props":{"className":"life-ad-space life-ad-space-sponsored","data-ad-placement":"ad_footer","data-ad-group":"reading","data-ad-creative":"read_product","data-ad-ready":"false","aria-label":"広告 · コ