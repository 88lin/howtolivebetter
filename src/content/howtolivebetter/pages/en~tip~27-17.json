 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-up-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M7 7h10v10"},"children":[]},{"tag":"path","props":{"d":"M7 17 17 7"},"children":[]}]}]}]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/en/book/27"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"Back to index"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["Pregnancy and childbirth: From confirming pregnancy to discharge and paperwork"]},{"tag":"div","props":{"data-ad-dock-host":"true"},"children":[]},{"tag":"nav","props":{"aria-label":"Chapter entries"},"children":[{"tag":"a","props":{"href":"/en/tip/27-01"},"children":[{"tag":"span","props":{},"children":["01"]},"Starting daily folic acid supplementation at 0.4 mg before pregnancy and continuing through the first trimester"]},{"tag":"a","props":{"href":"/en/tip/27-02"},"children":[{"tag":"span","props":{},"children":["02"]},"Register for the Maternal and Child Health Handbook at a community health center before 13 weeks of pregnancy to claim free prenatal checkups"]},{"tag":"a","props":{"href":"/en/tip/27-03"},"children":[{"tag":"span","props":{},"children":["03"]},"Getting tested for HIV, syphilis, and hepatitis B during the first prenatal visit — free prevention options available"]},{"tag":"a","props":{"href":"/en/tip/27-04"},"children":[{"tag":"span","props":{},"children":["04"]},"No smoking or drinking at all throughout pregnancy — and no one else in the house should smoke either"]},{"tag":"a","props":{"href":"/en/tip/27-05"},"children":[{"tag":"span","props":{},"children":["05"]},"For women at high risk of preeclampsia, start taking one low-dose aspirin tablet daily after week 12 of pregnancy"]},{"tag":"a","props":{"href":"/en/tip/27-06"},"children":[{"tag":"span","props":{},"children":["06"]},"Get screened for gestational diabetes at 24 weeks of gestation or later — don’t mind drinking the sugary solution"]},{"tag":"a","props":{"href":"/en/tip/27-07"},"children":[{"tag":"span","props":{},"children":["07"]},"Memorize this “go to the hospital immediately” checklist — it applies throughout pregnancy and the first year after childbirth"]},{"tag":"a","props":{"href":"/en/tip/27-08"},"children":[{"tag":"span","props":{},"children":["08"]},"If your water breaks, lie down flat, elevate your hips, and call 120 — don’t walk around or take a shower"]},{"tag":"a","props":{"href":"/en/tip/27-09"},"children":[{"tag":"span","props":{},"children":["09"]},"Ask for labor analgesia — it does not raise the risk of C-section"]},{"tag":"a","props":{"href":"/en/tip/27-10"},"children":[{"tag":"span","props":{},"children":["10"]},"Don’t request a C-section without medical indication, and avoid scheduling one just to pick a “lucky” date"]},{"tag":"a","props":{"href":"/en/tip/27-11"},"children":[{"tag":"span","props":{},"children":["11"]},"Check your yibao enrollment status before getting pregnant — even unemployed spouses can claim maternity medical expenses"]},{"tag":"a","props":{"href":"/en/tip/27-12"},"children":[{"tag":"span","props":{},"children":["12"]},"Get the “Medical Certificate of Birth” sorted out before discharge; decide on the baby’s name early and avoid typos"]},{"tag":"a","props":{"href":"/en/tip/27-13"},"children":[{"tag":"span","props":{},"children":["13"]},"Don’t skip newborn heel‑prick and hearing tests"]},{"tag":"a","props":{"href":"/en/tip/27-14"},"children":[{"tag":"span","props":{},"children":["14"]},"Enroll your newborn in yibao right after getting the birth certificate — don’t wait until household registration is complete"]},{"tag":"a","props":{"href":"/en/tip/27-15"},"children":[{"tag":"span","props":{},"children":["15"]},"Registering a newborn’s birth at a police station within one month"]},{"tag":"a","props":{"href":"/en/tip/27-16"},"children":[{"tag":"span","props":{},"children":["16"]},"Don’t skip that 42-day postpartum checkup — it also screens for postpartum depression"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/en/tip/27-17","data-status":"active"},"children":[{"tag":"span","props":{},"children":["17"]},"Pregnant? Don’t rehome the cat: have someone else scoop the litter daily, cook meat all the way through, and wear gloves around soil"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"Breadcrumb"},"children":[{"tag":"a","props":{"href":"/en/book"},"children":["Explore the book"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/en/book/27"},"children":["Chapter 27"," ·"," ","Pregnancy and childbirth: From confirming pregnancy to discharge and paperwork"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"27-17"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["17"]},{"tag":"span","props":{"className":"life-evidence grade-b"},"children":["Evidence"," ","B"]}]},{"tag":"h1","props":{"lang":"en"},"children":["Pregnant? Don’t rehome the cat: have someone else scoop the litter daily, cook meat all the way through, and wear gloves around soil"]},{"tag":"p","props":{"lang":"en","className":"life-entry-summary"},"children":["Toxoplasma is a parasite. A first infection during pregnancy can cause miscarriage, and the baby’s eyes and brain can be damaged. Living with a cat does not make infection more likely, so the cat does not have to go. What matters more is undercooked meat and handling soil without washing your hands. Having someone else scoop the litter every day is enough."]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Cost"]},{"tag":"p","props":{},"children":["Free. Hand the litter box to someone else in the household…"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Benefit"]},{"tag":"p","props":{},"children":["The US Centers for Disease Control and Prevention (CDC) says that a first toxoplasma infection shortly before…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"Mark: Pregnant? Don’t rehome the cat: have someone else scoop the litter daily, cook meat all the way through, and wear gloves around soil"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"Done"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"Plan to do"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"Save"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Share this tip"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Hide details"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Cost"]},{"tag":"p","props":{},"children":["Free. Hand the litter box to someone else in the household to scoop every day. If you are the only one who can, buy a box of disposable gloves. The hard part is eating meat fully cooked: no rare steak, no pink lamb."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Benefit"]},{"tag":"p","props":{},"children":["The US Centers for Disease Control and Prevention (CDC) says that a first toxoplasma infection shortly before or during pregnancy can pass to the fetus. Most infected babies have no symptoms at birth but may lose their sight or develop intellectual disability later. A few are born with severe eye or brain damage. The UK National Health Service (NHS) says infection during pregnancy can cause miscarriage. A toxoplasmosis testing centre in Lyon, France, counted 603 women with infection confirmed during pregnancy, most of whom took antiparasitic drugs. Overall, 29% of infections were passed to the fetus (95% CI 25 to 33, the plausible range). About 6% of infections at 13 weeks were passed on, versus about 72% at 36 weeks. The earlier the infection, the more likely the child is to show symptoms. Infection at 24 to 30 weeks carried the highest risk of early symptoms in the child, about 10%. A study in six European cities compared pregnant women with a new infection to uninfected women. Living with a cat: OR 1.0 (95% CI 0.7 to 1.5), no difference. Cleaning the litter box yourself: OR 1.3 (95% CI 0.8 to 2.1), a difference that may be chance. Eating undercooked lamb: OR 3.13 (95% CI 1.4 to 7.2), about 3 times the risk of not eating it. Contact with soil: OR 1.81 (95% CI 1.2 to 2.7), about 80% higher. Across the cities, 30% to 63% of infections could be attributed to undercooked or cured meat, and 6% to 17% to soil. The CDC’s advice for pregnant women: let someone else change the litter if possible. If no one can, wear disposable gloves and wash your hands with soap and water afterward. Change the litter daily, because the parasite in cat feces takes 1 to 5 days to become infectious. Don’t get a new cat during pregnancy, and don’t adopt or handle stray cats, especially kittens. Keep the cat indoors and feed it only cat food or cooked food, never raw meat. The Chinese CDC’s explainer also says the father-to-be should take over the litter box as far as possible, and that with precautions during pregnancy the cat can stay. The NHS states that stroking or owning a cat does not give you toxoplasmosis."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Original sources"]},{"tag":"p","props":{"className":"life-citations"},"children":["Centers for Disease Control and Prevention. Toxoplasmosis: Risk Factors. ",{"tag":"a","props":{"href":"https://www.cdc.gov/toxoplasmosis/risk-factors/index.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.cdc.gov/toxoplasmosis/risk-factors/index.html"]},"；Centers for Disease Control and Prevention. Preventing Toxoplasmosis. ",{"tag":"a","props":{"href":"https://www.cdc.gov/toxoplasmosis/prevention/index.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.cdc.gov/toxoplasmosis/prevention/index.html"]},"；NHS. Toxoplasmosis. ",{"tag":"a","props":{"href":"https://www.nhs.uk/conditions/toxoplasmosis/","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.nhs.uk/conditions/toxoplasmosis/"]},"；中国疾病预防控制中心 (2025). 孕期弓形虫感染，都是「吸猫」惹的祸吗？ ",{"tag":"a","props":{"href":"https://www.chinacdc.cn/jkkp/crb/qtcr/202501/t20250103_303681.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.chinacdc.cn/jkkp/crb/qtcr/202501/t20250103_303681.html"]},"；Cook AJ, Gilbert RE, Buffolano W, et al. (2000). Sources of toxoplasma infection in pregnant women: European multicentre case-control study. BMJ, 321(7254), 142-147. ",{"tag":"a","props":{"href":"https://doi.org/10.1136/bmj.321.7254.142","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1136/bmj.321.7254.142"]},"；Dunn D, Wallon M, Peyron F, Petersen E, Peckham C, Gilbert R (1999). Mother-to-child transmission of toxoplasmosis: risk estimates for clinical counselling. Lancet, 353(9167), 1829-1833. ",{"tag":"a","props":{"href":"https://doi.org/10.1016/s0140-6736(98)08220-8","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1016/s0140-6736(98)08220-8"]}]},{"tag":"a","props":{"href":"https://www.cdc.gov/toxoplasmosis/risk-factors/index.html","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Open source link"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Book note"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["A cat usually sheds toxoplasma in its feces only for a few weeks after its first infection. An adult cat that was infected before is even less likely to shed it again. A cat kept indoors and not fed raw meat has little chance of getting infected in the first place. You can catch toxoplasmosis without owning a cat; the sources are undercooked meat, unwashed fruit and vegetables, soil contaminated by cat feces, and untreated water. So do these things: cook meat all the way through, and wash knives, cutting boards and hands after raw meat; rinse fruit and vegetables under running water; wear gloves for gardening or turning soil, and wash your hands afterward. The NHS also advises against cured raw meats such as salami and Parma ham, and against unpasteurised goat’s milk. The European study did not ask in detail about lettuce and unwashed vegetables, and 14% to 49% of infections could not be traced to any source. Ask your prenatal doctor whether to test for toxoplasma antibodies. The grade is B because the cat and meat risks rest on one study’s figures, and those were recalled after the fact. The advice comes from official bodies; no study has calculated how many infections following it would prevent. The “medium” benefit rating is a judgement call, with the reasoning in the verification record. The benefit falls on you and your child."]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["My note"]},{"tag":"button","props":{"type":"button"},"children":["Write a reminder for yourself…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/en/tip/27-16"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"r