"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Chi phí"]},{"tag":"p","props":{},"children":["Không tốn tiền. Chỉ cần nhìn các con số bên dưới."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Lợi ích"]},{"tag":"p","props":{},"children":["Mốc thời gian chuẩn của tổng điều tra dân số lần thứ bảy là ngày 1 tháng 11 năm 2020. Trong dân số cả nước, người có trình độ đại học (cao đẳng trở lên) có 218360767 người. Trung học phổ thông (kể cả trung cấp chuyên nghiệp) 213005258 người. Trung học cơ sở 487163489 người. Tiểu học 349658828 người. So với tổng điều tra dân số lần thứ sáu năm 2010, cứ 100.000 người thì số người có trình độ đại học tăng từ 8930 người lên 15467 người. Trung học phổ thông tăng từ 14032 người lên 15088 người. Trung học cơ sở giảm từ 38788 người xuống 34507 người. Tiểu học giảm từ 26779 người xuống 24767 người. Số năm học trung bình của người từ 15 tuổi trở lên tăng từ 9.08 năm lên 9.91 năm. Tỷ lệ mù chữ giảm từ 4.08% xuống 2.67%. Mốc chuẩn khảo sát mẫu 1% dân số toàn quốc năm 2025 là ngày 1 tháng 11 năm 2025, mẫu 20,52 triệu người. Dựa vào mẫu ước tính dân số cả nước 1405,45 triệu người. Trong đó đại học (cao đẳng trở lên) 272,33 triệu, trung học phổ thông (kể cả trung cấp chuyên nghiệp) 242,72 triệu, trung học cơ sở 452,83 triệu, tiểu học 331,22 triệu. Công báo không đưa số trên mỗi 100000 người. Tự quy đổi theo dân số tổng, trình độ đại học chiếm khoảng 19,4%, trung học cơ sở khoảng 32,2%, vẫn là nhóm đông nhất."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Nguồn gốc"]},{"tag":"p","props":{"className":"life-citations"},"children":["国家统计局、国务院第七次全国人口普查领导小组办公室 (2021). 第七次全国人口普查公报（第六号）——人口受教育情况. ",{"tag":"a","props":{"href":"https://www.stats.gov.cn/sj/tjgb/rkpcgb/qgrkpcgb/202302/t20230206_1902006.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.stats.gov.cn/sj/tjgb/rkpcgb/qgrkpcgb/202302/t20230206_1902006.html"]},"；国家统计局 (2026). 2025 年全国 1% 人口抽样调查主要数据公报. ",{"tag":"a","props":{"href":"https://www.stats.gov.cn/sj/zxfb/202605/t20260522_1963788.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.stats.gov.cn/sj/zxfb/202605/t20260522_1963788.html"]}]},{"tag":"a","props":{"href":"https://www.stats.gov.cn/sj/tjgb/rkpcgb/qgrkpcgb/202302/t20230206_1902006.html","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Liên kết mở nguồn"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Ghi chú sách"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["Các con số này chỉ nói học vấn có hiếm hay dày trong dân chúng. Với một người cụ thể thì đi học đáng không, phải tự tính theo cách làm ở mục 6 của phần này (học hay đi làm thì tính thế nào). Còn phải để ý: tổng điều tra đếm cả toàn bộ dân số, kể cả người già và trẻ em. Tỷ lệ người trẻ học tới đại học cao hơn con số này nhiều, so với người cùng tuổi sẽ thổi phóng lợi thế của mình. Ngược lại, dùng nó để bác câu「đi học vô ích」thì hợp lý, vì mẫu số chính là cả lực lượng lao động đang giành chỗ với bạn. Số năm 2025 là ước tính từ mẫu, còn tổng điều tra đếm toàn bộ từng hộ. Hai cách tính khác nhau nên đặt hai nhóm số cạnh nhau, không lấy số mới thay số cũ. 19,4% và 32,2% được tự tính từ số người và dân số tổng trong công báo. Người hưởng lợi là bạn."]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Ghi chú của tôi"]},{"tag":"button","props":{"type":"button"},"children":["Viết một lời nhắc cho chính bạn…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/vi/tip/23-02"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Trước"]},"Cũng đưa「học có ích không」vào bảng tính tỷ lệ tử vong: mỗi thêm một năm học, nguy cơ tử vong ở người lớn giảm khoảng 1.9%"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/vi/tip/23-04"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Tiếp theo"]},"Trường hợp「không đủ tiền để đi học」thì tính theo chính sách trước đã: học phí trường trung cấp chuyên nghiệp đã miễn phần lớn, học bổng 2300 tệ, học vay tối đa 2 vạn tệ một năm"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"