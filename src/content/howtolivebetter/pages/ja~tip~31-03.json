0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["費用・手間"]},{"tag":"p","props":{},"children":["金銭的な負担はありません。代償となるのは、登録を行う前に、行くか行かないかを明確に決めておかなければならないという点です。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["効果"]},{"tag":"p","props":{},"children":["兵役法第五十七条第一款第二项は、「兵役の徴集を拒否、または回避した市民」に関するものです。罰則も同様に、「県級人民政府により期限内の是正を命じられ、期限内に是正されない場合は、県級人民政府により兵役義務の履行を強制され、罰金が科される」となっています。同条第二項には、「前項第二号の行為があり、是正を拒否した場合は、公務員または《中華人民共和国公務員法》に準じて管理される職員としての採用は認められず、国有企業および事业单位の職員としての採用・雇用も認められない。また、2年間は出国または進学・復学が禁止され、国防義務履行における重大な不誠実主体リストに登録され、共同制裁の対象となる」と記されています。「共同制裁」とは、複数の部門が同一のリストに基づき、上記の制限を共同で執行することを指します。第五十八条では、同様の制裁を既に入隊した者に対しても適用しています。兵役を逃れる目的で、任務の遂行を拒否、または部隊から脱走した軍人については、その処分の結果に応じて責任を問われる。除名、除籍、または法律に基づき刑事責任を追及された場合は、第五十七条第二項に従い処罰される。そのうち、除名された場合は罰金が科される（全国、2021 年 10 月 1 日より施行）"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["出典"]},{"tag":"p","props":{"className":"life-citations"},"children":["全国人大常委会 (2021). 兵役法（2021 年修订，第五十七、五十八条）. ",{"tag":"a","props":{"href":"http://www.mod.gov.cn/regulatory/2021-08/20/content_4892491.htm","target":"_blank","rel":"noopener noreferrer"},"children":["http://www.mod.gov.cn/regulatory/2021-08/20/content_4892491.htm"]},"（国防部刊登）"]},{"tag":"a","props":{"href":"http://www.mod.gov.cn/regulatory/2021-08/20/content_4892491.htm","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["出典を開く"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["著者の注記"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["ここで計算しているのは身体の自由と就業資格に関するものであり、金銭のことではありません。これら一連の制裁は、2種類の対象者に科されます。一つは「徴兵に応じた市民が徴集を拒否または回避した場合」です。もう一つは、入隊後に除名、除籍、または刑事責任を追及された場合です。単に兵役登録を行っていない場合は含まれません。兵役登録については第 2 条を参照してください。罰則の前提は「是正を拒否すること」であり、県級人民政府によって認定および処罰されます。罰金額は各地域が決定するため、本書には記載しません。行くか行かないかは自分自身で決めることですが、登録前には決めておく必要があります。"]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["自分のメモ"]},{"tag":"button","props":{"type":"button"},"children":["自分へのメモを書く…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/ja/tip/31-02"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["前へ"]},"18歳の 10 月 31 日までに兵役登録を行う必要があります。義務兵の現役期間は2年間です"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/ja/tip/31-04"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"c