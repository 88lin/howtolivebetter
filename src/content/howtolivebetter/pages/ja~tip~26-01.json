hildren":[]},{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},{"tag":"span","props":{},"children":["ログイン"]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/ja/book/26"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"目次に戻る"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["ウェブサイトやプラットフォームの構築：資格、届出、サーバー"]},{"tag":"nav","props":{"aria-label":"この章のヒント"},"children":[{"tag":"a","props":{"aria-current":"page","className":"active","href":"/ja/tip/26-01","data-status":"active"},"children":[{"tag":"span","props":{},"children":["01"]},"プラットフォームが自ら代金を受け取ってから販売者に送金するのではなく、ライセンスを持つ決済機関を通じて直接決済される仕組みにすること"]},{"tag":"a","props":{"href":"/ja/tip/26-02"},"children":[{"tag":"span","props":{},"children":["02"]},"有料サイトの多くは許可証が必要。自社販売のみ（他者の出店不可）なら不要。仲介取引は別の許可が必要。無料なら届出のみでOK"]},{"tag":"a","props":{"href":"/ja/tip/26-03"},"children":[{"tag":"span","props":{},"children":["03"]},"ライブ配信にはネットワーク文化経営許可証が必要。視聴覚番組用の許可証は民間企業ではほぼ取得不可能"]},{"tag":"a","props":{"href":"/ja/tip/26-04"},"children":[{"tag":"span","props":{},"children":["04"]},"サーバーを国内に置く場合は备案（届出）が必要であり、接続事業者は自ら付加価値通信許可を保有していなければならない"]},{"tag":"a","props":{"href":"/ja/tip/26-05"},"children":[{"tag":"span","props":{},"children":["05"]},"ユーザーに販売を許可する場合、プラットフォームは登録情報の照合、情報の報告、および3年間の保存を行う義務がある"]},{"tag":"a","props":{"href":"/ja/tip/26-06"},"children":[{"tag":"span","props":{},"children":["06"]},"ユーザーが投稿したコンテンツの管理義務：審査メカニズム、通報窓口、違法発見時の即時停止および報告"]},{"tag":"a","props":{"href":"/ja/tip/26-07"},"children":[{"tag":"span","props":{},"children":["07"]},"情報提供・即時通信サービスを提供する場合、ユーザーに真実の身元情報の提供を義務付けなければならない"]},{"tag":"a","props":{"href":"/ja/tip/26-08"},"children":[{"tag":"span","props":{},"children":["08"]},"16歳未満の者へのライブ配信許可禁止、投げ銭（ギフティング）は年齢に応じて段階的に処理"]},{"tag":"a","props":{"href":"/ja/tip/26-09"},"children":[{"tag":"span","props":{},"children":["09"]},"権利侵害の通知を受けた際は速やかに処理すること。異議申し立ての転送後、15日以内に進展がなければ復旧させる"]},{"tag":"a","props":{"href":"/ja/tip/26-10"},"children":[{"tag":"span","props":{},"children":["10"]},"ユーザー情報は安易に国外へ持ち出さないでください。国外への持ち出しには法的な条件と人数制限があります"]},{"tag":"a","props":{"href":"/ja/tip/26-11"},"children":[{"tag":"span","props":{},"children":["11"]},"サーバー選びは、まずダウンタイムに耐えられるか、次に運用担当者がいるかを確認し、最後に価格を比較すること"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"現在地"},"children":[{"tag":"a","props":{"href":"/ja/book"},"children":["本を読む"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/ja/book/26"},"children":["第26章"," ·"," ","ウェブサイトやプラットフォームの構築：資格、届出、サーバー"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"26-01"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["01"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["エビデンス"," ","A"]}]},{"tag":"h1","props":{"lang":"ja"},"children":["プラットフォームが自ら代金を受け取ってから販売者に送金するのではなく、ライセンスを持つ決済機関を通じて直接決済される仕組みにすること"]},{"tag":"p","props":{"lang":"ja","className":"life-entry-summary"},"children":["購入者の資金が一度あなたの口座に入り、それを販売者に転送する行為は、決済業務を行っていることになります。このビジネスを行うには、中国人民銀行の認可が必要であり、さらに1億元の資本金を用意しなければなりません。認可を得ずに運営した場合、業務停止、収益の没収、罰金の科されるだけでなく、経営者や担当者も別途罰せられます。重大なケースでは刑事罰の対象にもなります。最も安全な方法はたった一つ、資金を自社の口座に入れないことです。"]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["費用・手間"]},{"tag":"p","props":{},"children":["費用はかかりません。ただし、ライセンスを持つ決済機関の製品を導入するために、多少の時間は必要です。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["効果"]},{"tag":"p","props":{},"children":["法規制における決済業務とは、「受取人または支払人が提出した電子決済指示に基づき、通貨資金を移動させること」を指します。"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"記録する：プラットフォームが自ら代金を受け取ってから販売者に送金するのではなく、ライセンスを持つ決済機関を通じて直接決済される仕組みにすること"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"できている"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"やることに追加"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"お気に入り"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"このヒントを共有"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"詳細を閉じる"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["費用・手間"]},{"tag":"p","props":{},"children":["費用はかかりません。ただし、ライセンスを持つ決済機関の製品を導入するために、多少の時間は必要です。ライセンスを持つ決済機関とは、中央銀行から決済ライセンスを取得している企業のことです。その分割決済機能やエスクロー（代金預かり）機能を利用することで、購入者の資金は直接販売者に決済され、プラットフォーム自社の口座を経由しません。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["効果"]},{"tag":"p","props":{},"children":["法規制における決済業務とは、「受取人または支払人が提出した電子決済指示に基づき、通貨資金を移動させること」を指します。平たく言えば、他人の指示に従って他人の代わりに送金を行うことです。この事業を行うには、「中国人民銀行の承認を受け、決済業務の許可を取得しなければなりません」。最低資本金は 1 億元であり、かつ、これは払込済みの通貨資本である必要があるため、この 1 億元は、実際に現金を会社の口座に払い込まなければなりません。「法に基づいた承認を得ずに、非銀行決済機関を独断で設立したり、決済業務を行ったり、あるいは変形的に決済業務に従事したりした場合は、中国人民銀行によって法に基づき取り締まられ、違法所得は没収されます」。許可なくこの業務を行った場合は、直接業務停止となり、稼いだ利益は没収されます。違法所得が 50 万元以上の場合は、さらに違法所得の 1 倍から 5 倍の罰金が科せられます。不法所得がない、または 50 万元に満たない場合は、50 万から 200 万元の罰金に処す。法定代表者および直接責任者は、別途 10 万から 50 万元の罰金に処す。刑法では「資金決済業務の違法な運営」も不法営業とみなされる。情状が重い場合は 5 年以下の懲役、特に重大な場合は 5 年以上の懲役とする。「情状が重い」の定義については、最高人民法院および最高人民検察院の解釈によって境界が定められている。その境界は、不法営業額が 500 万元以上、または不法所得が 10 万元以上（全国、2024 年 5 月より適用）であることとする。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["出典"]},{"tag":"p","props":{"className":"life-citations"},"children":["国务院 (2023). 非银行支付机构监督管理条例（国务院令第 768 号，第二、六、八、二十七、四十七条）. ",{"tag":"a","props":{"href":"https://www.gov.cn/gongbao/2024/issue_11086/202401/content_6924970.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/gongbao/2024/issue_11086/202401/content_6924970.html"]}," ; 中国人民银行 (2024). 非银行支付机构监督管理条例实施细则（中国人民银行令〔2024〕第 4 号，第六十八条）. ",{"tag":"a","props":{"href":"https://www.gov.cn/gongbao/2024/issue_11546/202408/content_6970979.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/gongbao/2024/issue_11546/202408/content_6970979.html"]}," ; 全国人大 (1997). 刑法（第二百二十五条第三项）. ",{"tag":"a","props":{"href":"https://www.spp.gov.cn/spp/fl/201802/t20180206_364975.shtml","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.spp.gov.cn/spp/fl/201802/t20180206_364975.shtml"]}," ; 最高人民法院、最高人民检察院 (2019). 关于办理非法从事资金支付结算业务、非法买卖外汇刑事案件适用法律若干问题的解释（第一、三、四条）. ",{"tag":"a","props":{"href":"https://www.spp.gov.cn/xwfbh/wsfbt/201901/t20190131_407161.shtml","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.spp.gov.cn/xwfbh/wsfbt/201901/t20190131_407161.shtml"]}]},{"tag":"a","props":{"href":"https://www.gov.cn/gongbao/2024/issue_11086/202401/content_6924970.html","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["出典を開く"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["著者の注記"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["資金が自社の口座に入らないように設計すること、これが唯一の安全な方法です。市場ではこのような代行回収・代行支払いを「二清」と呼びますが、公的な文書にこの用語は存在しません。実施細則では「変相的に決済業務に従事する」という表現が使われており、これは認可を得ずにユーザーの指示に従って他人の代わりに送金を行うことを意味します。最高人民法院および最高人民検察院による解釈では、偽装取引による現金化、法人口座による現金化、小切手による現金化の3つのケースのみが列挙されています。プラットフォームによる代行回収・代行支払いが明記されているわけではないため、プラットフォームの代行回収・代行支払いが「必ずしも犯罪を構成する」とは言えません。"]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["自分のメモ"]},{"tag":"button","props":{"type":"button"},"children":["自分へのメモを書く…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"span","props":{},"children":[]},{"tag":"a","props":{"className":"life-