":[{"tag":"span","props":{},"children":["08"]},"3ヶ月未満の乳児は、体温が 38 ℃ に達したら、自宅で様子を見ず、すぐに病院へ行ってください"]},{"tag":"a","props":{"href":"/ja/tip/20-09"},"children":[{"tag":"span","props":{},"children":["09"]},"どんなに疲れ、怒っていても、赤ちゃんを揺らしてはいけません"]},{"tag":"a","props":{"href":"/ja/tip/20-10"},"children":[{"tag":"span","props":{},"children":["10"]},"おむつ選びはブランドではなく3つのポイントを見る：サイズ感、交換頻度、抜き打ち検査の通知歴"]},{"tag":"a","props":{"href":"/ja/tip/20-11"},"children":[{"tag":"span","props":{},"children":["11"]},"大型用品は「借りる、中古を買う、新品を買う」の順で検討し、一度に揃えようとしない"]},{"tag":"a","props":{"href":"/ja/tip/20-12"},"children":[{"tag":"span","props":{},"children":["12"]},"重度の湿疹や卵アレルギーがある場合、ピーナッツを避けるのではなく、医師の指導に従って早めに取り入れる。ただし、粒のまま与えるのは絶対にNG"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/ja/tip/20-13","data-status":"active"},"children":[{"tag":"span","props":{},"children":["13"]},"新生児黄疸を見逃さないためのサイン：生後 24 時間以内の黄疸、悪化する黄疸、呼びかけへの反応低下・授乳困難、白っぽい便が見られたら、当日中に病院へ"]},{"tag":"a","props":{"href":"/ja/tip/20-14"},"children":[{"tag":"span","props":{},"children":["14"]},"妊娠中や授乳中に菜食をしているなら、ビタミンB12を毎日補給する。子供の離乳食には動物性食品を入れ、完全菜食にするなら、まず医師に相談する"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"現在地"},"children":[{"tag":"a","props":{"href":"/ja/book"},"children":["本を読む"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/ja/book/20"},"children":["第20章"," ·"," ","生まれたばかりの赤ちゃんの育て方"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"20-13"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["13"]},{"tag":"span","props":{"className":"life-evidence grade-b"},"children":["エビデンス"," ","B"]}]},{"tag":"h1","props":{"lang":"ja"},"children":["新生児黄疸を見逃さないためのサイン：生後 24 時間以内の黄疸、悪化する黄疸、呼びかけへの反応低下・授乳困難、白っぽい便が見られたら、当日中に病院へ"]},{"tag":"p","props":{"lang":"ja","className":"life-entry-summary"},"children":["新生児の 8 割以上は何らかの黄疸が出ますが、多くは自然に消失します。生後 24 時間未満での黄疸、あるいは黄疸が強まっている場合、普段より眠気が強く呼びかけで起きない、授乳できない、体がぐったりしている、または硬直している場合は、当日中に病院を受診してください。便の色が白い場合は胆道閉鎖症の可能性があるため、早急な検査が必要です。ビリルビン値が高すぎると脳にダメージを与え、一生残る障害につながる恐れがあります。"]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["費用・手間"]},{"tag":"p","props":{},"children":["受診とビリルビン測定を含めて数百元以内です。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["効果"]},{"tag":"p","props":{},"children":["米国小児科学会（AAP）の 2 2022 年のガイドラインでは、「80% を超える新生児に何らかの程度の黄疸が見られる」とされています。"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"記録する：新生児黄疸を見逃さないためのサイン：生後 24 時間以内の黄疸、悪化する黄疸、呼びかけへの反応低下・授乳困難、白っぽい便が見られたら、当日中に病院へ"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"できている"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"やることに追加"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"お気に入り"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"このヒントを共有"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"詳細を閉じる"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["費用・手間"]},{"tag":"p","props":{},"children":["受診とビリルビン測定を含めて数百元以内です。光線療法が必要な場合は、通常、病院で 2 日程度入院します。大変なのは、見た目に問題がなさそうに見える時でも、この通院をしなければならない点です。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["効果"]},{"tag":"p","props":{},"children":["米国小児科学会（AAP）の 2 2022 年のガイドラインでは、「80% を超える新生児に何らかの程度の黄疸が見られる」とされています。ビリルビン値が高すぎると、急性ビリルビン脳症や核黄疸を引き起こす可能性があります。ガイドラインでは、核黄疸は「永続的な障害を伴う神経系疾患」とされています。その症状には、手足が不随意に動く脳性麻痺、眼球が上を向いて動かない、乳歯のエナメル質形成不全、聴覚障害などが含まれます。また、ガイドラインは「生後 24 時間以内に現れる黄疸」を、重症化するリスク因子として挙げています。英国の国民保健サービス（NHS）による保護者への説明は、2 つの段階に分かれています。第 1 段階は、救急車を呼ぶか、直接救急外来へ行くべきケースです。これには、黄疸があり、かつ、普段より眠気が強い、あるいは呼びかけで起きない、授乳できない、体がぐったりしている、または硬直している、痙攣がある場合が含まれます。生後 24 時間未満で黄疸が出た場合も、この段階に該当します。第 2 段階は、早急に医師の予約を取るべきケースです。これには、生後 24 時間経過後、黄疸が改善しない、あるいは悪化している、尿が濃い黄色または茶色である、あるいは便が淡いクリーム色である場合が含まれます。世界的な推計では、2 2010 年に約 48 万人の新生児が Rh 血液型不適合（母児の血液型不一致による）または極めて重度の高ビリルビン血症を発症しました。これらの児のうち 24% が死亡し、13% が核黄疸へと進行しました。核黄疸を生き延びた児の 83% 以上に、一つ以上の障害が残っています。便が白い場合は胆道閉鎖症の可能性があります。この疾患は、60 日以内に葛西手術（Kasai 手術）を行わないと、予後が明らかに良くなりません。台湾では 2 2004 年から、便の比色カードを各新生児の母子健康手帳に印刷しています。60 日以内に手術を受けた割合は、2 2all 2004 年の 60% から、2 2005 年には 74.3% に上昇しました。台湾の別の全住民研究では、比色カードの導入後、胆道閉鎖症児の死亡率は 26.2% から 15.9% に低下しました。これは前後比較であり、対照試験ではありません。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["出典"]},{"tag":"p","props":{"className":"life-citations"},"children":["Kemper AR, Newman TB, Slaughter JL, et al. (2022). Clinical Practice Guideline Revision: Management of Hyperbilirubinemia in the Newborn Infant 35 or More Weeks of Gestation. Pediatrics, 150(3), e2022058859. ",{"tag":"a","props":{"href":"https://doi.org/10.1542/peds.2022-058859","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1542/peds.2022-058859"]},"；NHS. Jaundice in babies（2026-03-24 审阅）. ",{"tag":"a","props":{"href":"https://www.nhs.uk/conditions/jaundice-newborn/","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.nhs.uk/conditions/jaundice-newborn/"]},"；NICE (2010, 2023 修订). Jaundice in newborn babies under 28 days (CG98), 1.2.6、1.7.1. ",{"tag":"a","props":{"href":"https://www.nice.org.uk/guidance/cg98/chapter/Recommendations","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.nice.org.uk/guidance/cg98/chapter/Recommendations"]},"；Bhutani VK, Zipursky A, Blencowe H, et al. (2013). Neonatal hyperbilirubinemia and Rhesus disease of the newborn: incidence and impairment estimates for 2010 at regional and global levels. Pediatric Research, 74(Suppl 1), 86-100. ",{"tag":"a","props":{"href":"https://doi.org/10.1038/pr.2013.208","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1038/pr.2013.208"]},"；Hsiao CH, Chang MH, Chen HL, et al. (2008). Universal screening for biliary atresia using an infant stool color card in Taiwan. Hepatology, 47(4), 1233-1240. ",{"tag":"a","props":{"href":"https://doi.org/10.1002/hep.22182","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1002/hep.22182"]},"；Lee M, Chen SC, Yang HY, et al. (2016). Infant Stool Color Card Screening Helps Reduce the Hospitalization Rate and Mortality of Biliary Atresia: A 14-Year Nationwide Cohort Study in Taiwan. Medicine, 95(12), e3166. ",{"tag":"a","props":{"href":"https://doi.org/10.1097/MD.0000000000003166","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1097/MD.0000000000003166"]},"；国家卫生计生委 (2017). 国家基本公共卫生服务规范（第三版），0～6 岁儿童健康管理服务规范. ",{"tag":"a","props":{"href":"https://www.nhc.gov.cn/ewebeditor/uploadfile/2017/04/20170417104506514.pdf","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.nhc.gov.cn/ewebeditor/uploadfile/2017/04/20170417104506514.pdf"]}]},{"tag":"a","props":{"href":"https://doi.org/10.1542/peds.2022-058859","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["出典を開く"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["著者の注記"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["光線療法（光照療法）は、特殊な光を赤ちゃんの皮膚に当てることで、ビリルビンを排泄しやすい形態に変える治療法です。自宅での日光浴で代用しないでください。米国小児科学会は、日光浴では安全性を保ちつつ日焼けを防ぐことが困難であるため、治療法として推奨しないと述べています。また、黄疸を下げるために水やブドウ糖水を飲ませることも、同ガイドラインで明確に推奨されていません。肉眼による黄疸の色の濃淡では、ビリルビン値がどの程度高いかを正確に推定することはできません。英国の NICE ガイドラインには、肉眼だけに頼らず、判断に迷う場合は必ず測定を行うよう明記されています。妊娠 38 週未満での出生、兄弟姉妹が光線療法を受けた経験がある場合、母乳の摂取が不十分な場合は、重症化しやすくなります。再検査は、国の基本公衆衛生サービス規定に従ってください。退院後 1 週間以内に、医療従事者による訪問指導があります。生後 28 から 30 日には、コミュニティ衛生サービスセンターまたは郷鎮衛生院でのフォローアップがあります。この両方の機会に黄疸を確認してください。退院時に医師からビリルビン再検査の予約を別途指示された場合は、その予約時間に従ってください。正期産児で黄疸が 14 日以上続く場合、早産児では 21 日以上続く場合、NICE ガイドラインは、直接ビリルビン（結合ビリルビン）の測定と、便が白くなっていないかの確認を求めています。黄疸自体はワクチンの接種を妨げません（本節の第 3 条「ワクチン」を参照）。新生児スクリーニングについては、第 27 節 第 13 条（踵血スクリーニング）を参照してください。"]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["自分のメモ"]},{"tag":"button","props":{"type":"button"},"children":["自分へのメモを書く…"]}]}]}]},{"tag":"nav","props":{"classN