th","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"加入待做"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"收藏"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"分享这条建议"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"收起详情"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["成本"]},{"tag":"p","props":{"className":"life-citations"},"children":["不花钱。省下的是买「补肾」偏方和「戒色」课程的钱，还有长期自责的那份焦虑。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["收益"]},{"tag":"p","props":{"className":"life-citations"},"children":["先看身体。美国一项研究跟踪了 31925 名男性，到 2010 年。每个人自己报告每月射精几次，再按次数分组。和每月 4 到 7 次的人比，每月 21 次以上的人前列腺癌 HR 0.81（95% CI 0.72–0.92，低约 19%），这是按 20 到 29 岁时的次数算的。按 40 到 49 岁时的次数算，HR 0.78（0.69–0.89，低约 22%）。少掉的主要是低危的前列腺癌。反方是英国一项病例对照研究，比了 431 名 60 岁前确诊的患者和 409 名对照。二三十岁时手淫频繁的人风险偏高，五十多岁时频繁的人风险偏低。再看色情内容。一篇系统综述加荟萃分析认为，很多人觉得自己「上瘾了」，更多是行为和自己信的道理对不上，不只是看得多。少数人每次射精后确实会不舒服，但这不是「伤身」，而是一种叫射精后疾病综合征（POIS）的罕见病。该去看医生，不是靠戒色。荷兰 45 名患者里，87% 在射精后 30 分钟内起病，80% 疲惫没力气，78% 像得了感冒。法国一家医院 37 名患者平均 4.7 天才好。病因没弄清。荷兰那项研究里，做了皮试的 33 人中 29 人（88%）对自己的精液过敏。中国 24 名患者的研究却查不到针对精液的过敏抗体，患者的焦虑抑郁评分偏高。一篇 2025 年的综述只找到 14 项治疗研究，12 项是个案。全球 211 名性医学专家里，只有 18% 说超过三成病人能好转（美国 / 英国 / 荷兰 / 法国 / 中国）"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["来源"]},{"tag":"p","props":{"className":"life-citations"},"children":["Rider JR, Wilson KM, Sinnott JA, et al. (2016). Ejaculation Frequency and Risk of Prostate Cancer: Updated Results with an Additional Decade of Follow-up. European Urology, 70(6), 974–982. ",{"tag":"a","props":{"href":"https://doi.org/10.1016/j.eururo.2016.03.027","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1016/j.eururo.2016.03.027"]},"；Dimitropoulou P, Lophatananon A, Easton D, et al. (2009). Sexual activity and prostate cancer risk in men diagnosed at a younger age. BJU International, 103(2), 178–185. ",{"tag":"a","props":{"href":"https://doi.org/10.1111/j.1464-410x.2008.08030.x","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1111/j.1464-410x.2008.08030.x"]},"；Grubbs JB, Perry SL, Wilt JA, Reid RC. (2019). Pornography Problems Due to Moral Incongruence: An Integrative Model with a Systematic Review and Meta-Analysis. Archives of Sexual Behavior, 48(2), 397–415. ",{"tag":"a","props":{"href":"https://doi.org/10.1007/s10508-018-1248-x","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1007/s10508-018-1248-x"]},"；Waldinger MD, Meinardi MM, Zwinderman AH, Schweitzer DH. (2011). Postorgasmic Illness Syndrome (POIS) in 45 Dutch caucasian males: clinical characteristics and evidence for an immunogenic pathogenesis (Part 1). The Journal of Sexual Medicine, 8(4), 1164–1170. ",{"tag":"a","props":{"href":"https://doi.org/10.1111/j.1743-6109.2010.02166.x","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1111/j.1743-6109.2010.02166.x"]},"；Chea M, Teng M, Chesnel C, et al. (2023). Postorgasmic illness syndrome: one or several entities? A retrospective cohort study. The Journal of Sexual Medicine, 20(12), 1407–1413. ",{"tag":"a","props":{"href":"https://doi.org/10.1093/jsxmed/qdad139","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1093/jsxmed/qdad139"]},"；Xi GP, Yang RX, Zhang J, et al. (2023). Clinical characteristics, allergic response to autologous semen, and desensitization in patients with postorgasmic illness syndrome. Sexual Medicine, 11(6), qfad068. ",{"tag":"a","props":{"href":"https://doi.org/10.1093/sexmed/qfad068","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1093/sexmed/qfad068"]},"；Ponce S, Chapalamadugu M, Levine S, et al. (2025). Treatments for postorgasmic illness syndrome: a systematic review. The Journal of Sexual Medicine, 22(7), 1236–1243. ",{"tag":"a","props":{"href":"https://doi.org/10.1093/jsxmed/qdaf112","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1093/jsxmed/qdaf112"]},"；Duran MB, Rubin RS, Reisman Y, Serefoglu EC, et al. (2025). Recognition and practice patterns of sexual medicine experts towards postorgasmic illness syndrome. International Journal of Impotence Research, 37(6), 454–457. ",{"tag":"a","props":{"href":"https://doi.org/10.1038/s41443-023-00753-x","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1038/s41443-023-00753-x"]},""]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["原书备注"]},{"tag":"p","props":{"className":"life-citations"},"children":["争议。前列腺癌这两项研究都只是记录、没有分组对照，次数又是本人回忆的，所以结论只能到「没看到伤身的证据」，不能反过来劝人多做。英国那项的作者自己也说，五十多岁那段可能是先病了才次数少。色情那篇的摘要没有给出效应量，所以这里只写方向。收益定成小，是因为降的主要是低危前列腺癌，不是死亡。射精后不适那段的研究都只有几十个病人，文献都说这病罕见，但没有人在普通人群里统计过多少人得。几乎每次射精后都没力气、像感冒、几天才好的，去泌尿科或男科，主动提这个病名。真正该去精神科或心理科的信号是：为这事熬夜、误工、影响伴侣关系，想停也停不下来。熬夜见第 3 节第 9 条（不为游戏、短视频、色情内容熬夜）。担心看色情看出了勃起问题，先按第 1 节第 28 条（勃起功能出了问题先去查心血管）去查。往群里发、卖资源的法律后果见第 9 节第 4 条（黄色视频自己看归自己）。受益人是你自己。"]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["我的备注"]},{"tag":"button","props":{"type":"button"},"children":["写下对自己有用的提醒…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/tip/06-26"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["上一条"]},"不要指望吃早餐或 16:8 轻断食帮你控制体重，吃饭时间挑你能长期坚持的"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/tip/06-28"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["下一条"]},"不要花钱做「性取向矫正」「同性恋治疗」，也不要把家里人送去"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["本主题的其他建议"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/06-23"},"children":[{"tag":"strong","props":{},"children":["不要指望买东西改善心情或身份感"]},{"tag":"span","props":{},"children":["把钱和物质看得越重的人，自己觉得越不幸福，但关联很弱，也分不出谁导致谁。还有研究发现，花钱买一段经历比买东西更让人快乐。所以心情差的时候，把钱花在一次出门、一顿…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/06-24"},"children":[{"tag":"strong","props":{},"children":["不要为了「在周围人里往上挪一档」多花钱换房、换车、换圈子"]},{"tag":"span","props":{},"children":["拿收入一样的人来比，邻居挣得越多，这个人报告的幸福感越低。这只发生在学历和自己相同、又常来往的邻居之间。所以为了搬进一个人人都比你宽裕的地方而多花的钱，买到的是…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/06-25"},"children":[{"tag":"strong","props":{},"children":["不要相信「意志力像肌肉，用一会儿就没了」"]},{"tag":"span","props":{},"children":["流行的说法是：先做一件费自控的事，接下来就更容易破功，所以要省着用意志力。23 个实验室、2141 人按同一套方案重做了这个实验，结果几乎是零。别再用「今天意志…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/06-29"},"children":[{"tag":"strong","props":{},"children":["不要指望学会「正确搬运姿势」、上搬运培训就能防腰痛，要减的是搬的重量和次数，平时多锻炼"]},{"tag":"span","props":{},"children":["上过搬运姿势培训的工人，后来腰痛的并不比没上过的少。搬东西时腰弯得多的人，也没看出更容易腰痛。和腰痛有关的是搬得重、搬得多，每次多搬 10 公斤或每天多搬 10…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/06-30"},"children":[{"tag":"strong","props":{},"children":["不要指望骨折之后猛补钙、喝骨头汤能让骨头长得更快"]},{"tag":"span","props":{},"children":["骨折后补维生素 D 的试验，没有一项看出骨头长得更好。钙和维 D 一起补的研究很少，说不清有没有用。一大碗骨头汤里的钙，只有每天该吃的几十分之一。本来就缺维 D…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/06-31"},"children":[{"tag":"strong","props":{},"children":["不要指望靠 AI 聊天机器人自己判断病情和法律问题，看病、打官司、花大钱之前，把它说的依据找到原文核一遍"]},{"tag":"span","props":{},"children":["把完整病例交给 AI，九成以上它能认出是什么病。但普通人拿它问症状，认出病的反而比自己上网查的人少，该不该去急诊也没判得更准。问法律问题，通用 AI 至少 58…"]}]}]}]},{"tag":"a","props":{"className":"life-text-link","href":"/book/06"},"children":["阅读整个主题：反面清单 ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"15","height":"15","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]}]}]},{"tag":"nav","props":{"className":"life-tabbar","aria-label":"主导航"},"children":[{"tag":"a","props":{"className":"","href":"/book"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"21","height":"21","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-book-open","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M12 7v14"},"children":[]},{"tag":"path","props":{"d":"M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z"},"children":[]}]},{"tag":"span","props":{},"children":["全书"]}]},{"tag":"a","props":{"className":"","href":"/top-50"},"children":[{"tag":"svg","props":{"xmlns":"