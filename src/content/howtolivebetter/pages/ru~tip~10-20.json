24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-up-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M7 7h10v10"},"children":[]},{"tag":"path","props":{"d":"M7 17 17 7"},"children":[]}]}]}]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/ru/book/10"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"К содержанию"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["Окупается ли вступление в брак"]},{"tag":"div","props":{"data-ad-dock-host":"true"},"children":[]},{"tag":"nav","props":{"aria-label":"Советы главы"},"children":[{"tag":"a","props":{"href":"/ru/tip/10-01"},"children":[{"tag":"span","props":{},"children":["01"]},"Знакомьтесь с большим числом людей, а не сосредотачивайтесь на одном: совместимость двух людей невозможно предсказать до встречи"]},{"tag":"a","props":{"href":"/ru/tip/10-02"},"children":[{"tag":"span","props":{},"children":["02"]},"Прекращайте действия после явного отказа — дальнейшее домогательство является нарушением общественного порядка, а не проявлением «доброй воли»"]},{"tag":"a","props":{"href":"/ru/tip/10-03"},"children":[{"tag":"span","props":{},"children":["03"]},"Определяем интерес по поступкам, а не по «сигналам»: кто проявляет инициативу, кто назначает встречу, кто продолжает контакт"]},{"tag":"a","props":{"href":"/ru/tip/10-04"},"children":[{"tag":"span","props":{},"children":["04"]},"Насколько хороши отношения — в основном зависит от ваших собственных ощущений, а не от характеристик партнера"]},{"tag":"a","props":{"href":"/ru/tip/10-05"},"children":[{"tag":"span","props":{},"children":["05"]},"Чтобы сблизиться с человеком, нужно по очереди отвечать на серию вопросов от простых к сложным — и не стоит полагаться на заученные фразы"]},{"tag":"a","props":{"href":"/ru/tip/10-06"},"children":[{"tag":"span","props":{},"children":["06"]},"Отношения на расстоянии не хуже, чем в одном городе, а настоящая проблема — первые три месяца после переезда вместе"]},{"tag":"a","props":{"href":"/ru/tip/10-07"},"children":[{"tag":"span","props":{},"children":["07"]},"Сначала посмотрите статистику регистрации, а потом слушайте советы старших: что такое показатели брачности и разводимости?"]},{"tag":"a","props":{"href":"/ru/tip/10-08"},"children":[{"tag":"span","props":{},"children":["08"]},"Учитываем пользу брака для здоровья, но с поправкой на данные наблюдательных исследований"]},{"tag":"a","props":{"href":"/ru/tip/10-09"},"children":[{"tag":"span","props":{},"children":["09"]},"Разделение неоплачиваемого труда перед регистрацией брака"]},{"tag":"a","props":{"href":"/ru/tip/10-10"},"children":[{"tag":"span","props":{},"children":["10"]},"Сначала ознакомьтесь с законодательными нормами о деньгах и имуществе в браке, а затем решайте, нужно ли заключать письменное соглашение"]},{"tag":"a","props":{"href":"/ru/tip/10-11"},"children":[{"tag":"span","props":{},"children":["11"]},"При внесении родителями средств на покупку жилья необходимо четко указать в документах, является ли это займом или подарком"]},{"tag":"a","props":{"href":"/ru/tip/10-12"},"children":[{"tag":"span","props":{},"children":["12"]},"Долги, взятые супругом без вашего подписания и одобрения, не автоматически становятся вашими долгами"]},{"tag":"a","props":{"href":"/ru/tip/10-13"},"children":[{"tag":"span","props":{},"children":["13"]},"Для получения свидетельства о браке достаточно лишь паспорта и подписанного заявления — домовую книгу (хукоу) предоставлять не нужно, пошлина не взимается, а свидетельство выдаётся сразу на месте"]},{"tag":"a","props":{"href":"/ru/tip/10-14"},"children":[{"tag":"span","props":{},"children":["14"]},"Перед бракосочетанием рекомендуется пройти медицинское обследование; при наличии серьезных заболеваний об этом нужно честно сообщить будущему супругу до регистрации брака"]},{"tag":"a","props":{"href":"/ru/tip/10-15"},"children":[{"tag":"span","props":{},"children":["15"]},"Расчёт затрат на расторжение брака: при добровольном разводе действует 30-дневный период размышлений, а при судебном — требуются определённые условия"]},{"tag":"a","props":{"href":"/ru/tip/10-16"},"children":[{"tag":"span","props":{},"children":["16"]},"Ведите отдельный учёт для брака ради родителей, не смешивая его со своим личным учётом"]},{"tag":"a","props":{"href":"/ru/tip/10-17"},"children":[{"tag":"span","props":{},"children":["17"]},"Отношения в браке как показатель здоровья: спорить следует по существу, не переходя на личности, без оскорблений и насмешек"]},{"tag":"a","props":{"href":"/ru/tip/10-18"},"children":[{"tag":"span","props":{},"children":["18"]},"Пока оба партнера в здравом уме, оформите доверенность, соглашение о добровольном опекунстве и завещание: с юридической точки зрения вы не являетесь близкими родственниками, и без этих документов у вас не будет права подписи и права на наследование"]},{"tag":"a","props":{"href":"/ru/tip/10-19"},"children":[{"tag":"span","props":{},"children":["19"]},"Не стоит скрывать свою сексуальную ориентацию при вступлении в брак, а также не стоит рассматривать фиктивный брак как простой способ решить проблему: с юридической точки зрения это настоящий брак, а для его расторжения остаётся только развод"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/ru/tip/10-20","data-status":"active"},"children":[{"tag":"span","props":{},"children":["20"]},"Отношения зашли в тупик из-за постоянных ссор и «холодной войны»: пара вместе обращается за супружеской терапией. Просто ждать в надежде на улучшение почти не поможет"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"Навигация"},"children":[{"tag":"a","props":{"href":"/ru/book"},"children":["Книга"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/ru/book/10"},"children":["Глава 10"," ·"," ","Окупается ли вступление в брак"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"10-20"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["20"]},{"tag":"span","props":{"className":"life-evidence grade-a（争议）"},"children":["Доказательства"," ","A（争议）"]}]},{"tag":"h1","props":{"lang":"ru"},"children":["Отношения зашли в тупик из-за постоянных ссор и «холодной войны»: пара вместе обращается за супружеской терапией. Просто ждать в надежде на улучшение почти не поможет"]},{"tag":"p","props":{"lang":"ru","className":"life-entry-summary"},"children":["Пары, у которых отношения зашли в тупик, после прохождения супружеской терапии в большинстве случаев становятся гораздо довольнее друг другом — улучшения наблюдаются примерно у 70% пар. В то же время у тех, кто просто ждал, никаких изменений практически не происходило. Однако эффект со временем слабеет: спустя 5 лет лишь половина пар по-прежнему отмечает заметное улучшение, а четверть уже разводится или живёт отдельно."]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Затраты"]},{"tag":"p","props":{},"children":["Требуются финансовые затраты. Оплата производится за кажды…"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Польза"]},{"tag":"p","props":{},"children":["В 2020 году в рамках метаанализа были обобщены данные 58 исследований, охвативших 2092 пары. У тех, кто прошёл…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"Отметить: Отношения зашли в тупик из-за постоянных ссор и «холодной войны»: пара вместе обращается за супружеской терапией. Просто ждать в надежде на улучшение почти не поможет"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"Сделано"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"В планах"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"В избранное"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Поделиться советом"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Скрыть подробности"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Затраты"]},{"tag":"p","props":{},"children":["Требуются финансовые затраты. Оплата производится за каждый сеанс; стоимость зависит от региона и клиники, поэтому конкретную сумму указать невозможно. В исследованиях обычно рекомендуют посещать терапию раз в неделю в течение примерно 8 месяцев. Сложность заключается в том, что оба партнёра должны регулярно посещать сеансы и довести их до конца."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Польза"]},{"tag":"p","props":{},"children":["В 2020 году в рамках метаанализа были обобщены данные 58 исследований, охвативших 2092 пары. У тех, кто прошёл супружескую терапию, показатель удовлетворённости отношениями изменился на g = 1,12 (доверительный интервал 0,92–1,31); авторы исследования считают это значительным эффектом. Здесь g — это величина эффекта, подробнее о ней написано в глоссарии. У пар, которые просто ждали в очереди на терапию, за тот же период показатель g составил 0,12 (−0,04–0,29), то есть улучшений практически не наблюдалось. Чем хуже были отношения в начале, тем больше улучшений они получали впоследствии. В обзоре 2012 года указано, что супружеская терапия помогла улучшить отношения у 70% пар, прошедших лечение. В другом рандомизированном исследовании 134 пары с длительными и серьёзными конфликтами проходили два вида поведенческой супружеской терапии в течение 8 месяцев; по итогам терапии показатели удовлетворённости составили d = 0,90 и 0,71 соответственно. Спустя 5 лет у 50,0% и 45,9% пар из этих групп наблюдались заметные улучшения. Под «заметным улучшением» авторы подразумевают «клинически значимое улучшение». Кроме того, в первой группе 25,7% пар, а во второй — 27,9% разошлись или развелись."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Первоисточники"]},{"tag":"p","props":{"className":"life-citations"},"children":["Roddy MK, Walsh LM, Rothman K, Hatch SG, Doss BD (2020). Meta-analysis of couple therapy: effects across outcomes, designs, timeframes, and other moderators. Journal of Consulting and Clinical Psychology, 88(7), 583-596. ",{"tag":"a","props":{"href":"https://doi.org/10.1037/ccp0000514","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1037/ccp0000514"]},"；Lebow JL, Chambers AL, Christensen A, Johnson SM (2012). Research on the treatment of couple distress. Journal of Marital and Family Therapy, 38(1), 145-168. ",{"tag":"a","props":{"href":"https://doi.org/10.1111/j.1752-0606.2011.00249.x","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1111/j.1752-0606.2011.00249.x"]},"；Christensen A, Atkins DC, Baucom B, Yi J (2010). Marital status and satisfaction five years following a randomized clinical trial comparing traditional versus integrative behavioral couple therapy. Journal of Consulting and Clinical Psychology, 78(2), 225-235. ",{"tag":"a","props":{"href":"https://doi.org/10.1037/a0018132","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1037/a0018132"]},"；Rathgeber M, Bürkner PC, Schiller EM, Holling H (2019). The efficacy of emotionally focused couples therapy and behavioral couples therapy: a meta-analysis. Journal of Marital and Family Therapy, 45(3), 447-463. ",{"tag":"a","props":{"href":"https://doi.org/10.1111/jmft.12336","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1111/jmft.12336"]},"（争议方）；Shadish WR, Baldwin SA (2003). Meta-analysis of MFT interventions. Journal of Marital and Family Therapy, 29(4), 547-570. ",{"tag":"a","props":{"href":"https://doi.org/10.1111/j.1752-0606.2003.tb01694.x","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1111/j.1752-0606.2003.tb01694.x"]},"（争议方）；Karakurt G, Whiting K, van Esch C, Bolen SD, Calabrese JR (2016). Couples therapy for intimate partner violence: a systematic review and meta-analysis. Journal of Marital and Family Therapy, 42(4), 567-583. ",{"tag":"a","props":{"href":"https://doi.org/10.1111/jmft.12178","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1111/jmft.12178"]},"；全国人大常委会 (2018 修正). 精神卫生法（第二十三、五十一条）. ",{"tag":"a","props":{"href":"https://flk.npc.gov.cn/detail?id=2c909fdd678bf17901678bf7448a066d","target":"_blank","rel":"noopener noreferrer"},"children":["https://flk.npc.gov.cn/detail?id=2c909fdd678bf17901678bf7448a066d"]},"（国家法律法规数据库）"]},{"tag":"a","props":{"href":"https://doi.org/10.1037/ccp0000514","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Открыть источник"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Примечание автора"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["Основной спор касается того, как долго сохраняется эффект от терапии. В другом метаанализе, включающем только рандомизированные исследования, показатель g после завершения терапии составил 0,60, а спустя полгода — 0,44. К 12 месяцам данные сохранились лишь по одному виду поведенческой терапии: g = 0,06, то есть эффект практически исчез. В обзоре, обобщающем 20 метаанализов, указано, что клинически значимое улучшение наблюдается у 40–50% людей. Показатели «70% улучшений» и «40–50% заметных улучшений» рассчитаны по разным критериям, поэтому их нельзя напрямую сравнивать. В исследовании, где отслеживались результаты спустя 5 лет, не было контрольной группы, не проходившей терапию, поэтому невозможно точно сказать, увеличилось ли количество разводов. В 2020 году обобщались данные только по гетеросексуальным парам; в России подобных рандомизированных исследований не обнаружено, поэтому результаты следует воспринимать с осторожностью. Где пройти терапию в России: согласно законодательству в сфере психического здоровья, психотерапия проводится только в медицинских учреждениях, а психологи не имеют права заниматься психотерапией. Можно обратиться в психиатрическое или психологическое отделение больницы и узнать, предоставляют ли там супружескую терапию. Если обращаться в частные центры, обязательно уточните квалификацию специалистов и их подготовку. Парам, сталкивающимся с домашним насилием, лучше не начинать терапию вместе. В метаанализе 2016 года указано, что выводы применимы только к парам с лёгкими и средними конфликтами, без физического насилия; случаи, когда один партнёр жестоко контролирует другого или причиняет ему серьёзный вред, в расчёт не берутся. Специалисты также опасаются, что после терапии один из партнёров может подвергнуться репрессиям дома. Если вы стали жертвой насилия, ознакомьтесь с разделом 8, пунктом 43. О том, как вести диалог во время ссоры, написано в разделе 17 («Ссоры: обсуждаем суть, а не личности»); о том, стоит ли прекратить отношения, — в разделе 15 («Издержки разрыва»). Пользу от терапии получат как вы, так и ваш супруг/супруга."]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Моя заметка"]},{"tag":"button","props":{"type":"button"},"children":["Запишите напоминание…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/ru/tip/10-19"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Предыдущий"]},"Не стоит скрывать свою сексуальную ориентацию при вступлении в брак, а также не стоит рассматривать фиктивный брак как простой способ решить проблему: с юридической точки зрения это настоящий брак, а для его расторжения остаётся только развод"]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["Другие советы по этой теме"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/10-13"},"children":[{"tag":"strong","props":{},"children":["Для получения свидетельства о браке достаточно лишь паспорта и подписанного заявления — домовую книгу (хукоу) предоставлять не нужно, пошлина не взимается, а свидетельство выдаётся сразу на месте"]},{"tag":"span","props":{},"children":["С мая 2025 года для регистрации брака требуется всего два документа: …"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/10-14"},"children":[{"tag":"strong","props":{},"children":["Перед бракосочетанием рекомендуется пройти медицинское обследование; при наличии серьезных заболеваний об этом нужно честно сообщить будущему супругу до регистрации брака"]},{"tag":"span","props":{},"children":["Если у человека имеются серьезные заболевания, а он не сообщил об это…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/10-15"},"children":[{"tag":"strong","props":{},"children":["Расчёт затрат на расторжение брака: при добровольном разводе действует 30-дневный период размышлений, а при судебном — требуются определённые условия"]},{"tag":"span","props":{},"children":["добровольный развод не завершается сразу после подписания документов.…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/10-16"},"children":[{"tag":"strong","props":{},"children":["Ведите отдельный учёт для брака ради родителей, не смешивая его со своим личным учётом"]},{"tag":"span","props":{},"children":["Выгоды, которые получают родители — их спокойствие, уважение окружающ…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/10-17"},"children":[{"tag":"strong","props":{},"children":["Отношения в браке как показатель здоровья: спорить следует по существу, не переходя на личности, без оскорблений и насмешек"]},{"tag":"span","props":{},"children":["У супругов с хорошими отношениями здоровье лучше, а риск смертности н…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/10-18"},"children":[{"tag":"strong","props":{},"children":["Пока оба партнера в здравом уме, оформите доверенность, соглашение о добровольном опекунстве и завещание: с юридической точки зрения вы не являетесь близкими родственниками, и без этих документов у вас не будет права подписи и права на наследование"]},{"tag":"span","props":{},"children":["Близкими родственниками по закону являются супруги, родители, дети и …"]}]}]}]},{"tag":"a","props":{"className":"life-text-link","href":"/ru/book/10"},"children":["Читать всю тему: Окупается ли вступление в брак"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"15","height":"15","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]}]}]}]},{"tag":"aside","props":{"className":"life-ad-space life-ad-space-sponsored","data-ad-placement":"ad_footer","data-ad-group":"reading","data-ad-creative":"read_product","data-ad-ready":"false","aria-label":"Реклама · Рекомендация сообщества"