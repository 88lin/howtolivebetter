"className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Chi phí"]},{"tag":"p","props":{},"children":["Không tốn tiền. Kiểm tra một lần, mất mười mấy phút."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Lợi ích"]},{"tag":"p","props":{},"children":["Bộ Nhân sự và Xã hội đã mở đợt xử lý toàn quốc riêng cho việc này. Những sai sót văn bản nêu tên gồm「一些机构和单位以新职业职业资格、职业技能等级等名义随意举办培训、评价、发证活动，乱收费、滥发证；一些机构和单位虚假或夸大宣传，甚至假冒权威机构名义组织培训、评价、颁发证书等」, tức là tổ chức, đơn vị lấy danh nghĩa chứng chỉ nghề mới hay mức kỹ năng nghề để tuỳ tiện mở đào tạo, đánh giá, cấp chứng chỉ, thu tiền lung tung, cấp quá đà, còn có nơi quảng cáo sai hoặc phóng đại, thậm chí giả mạo cơ quan có thẩm quyền để tổ chức đào tạo, đánh giá, cấp chứng chỉ. Biện pháp xử lý gồm phối hợp với các cơ quan quản lý không gian mạng, công an, thị trường để điều tra,「严厉打击假冒鉴定机构、人社部门备案评价机构的评价发证活动」, tức là đánh mạnh vào hoạt động đánh giá cấp chứng chỉ của cơ quan giả mạo cơ quan chuyên môn và của cơ quan đánh giá đã đăng ký. Quảng cáo không hợp lệ trên trang web và nền tảng mới thì đóng theo luật. Văn bản đồng thời yêu cầu「引导公众了解证书查询渠道和方式，判断证书合法合规性和含金量」"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Nguồn gốc"]},{"tag":"p","props":{"className":"life-citations"},"children":["人力资源社会保障部 (2022). 关于开展技术技能类「山寨证书」专项治理工作的通知. ",{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/2022-03/18/content_5679641.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/zhengce/zhengceku/2022-03/18/content_5679641.htm"]}]},{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/2022-03/18/content_5679641.htm","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Liên kết mở nguồn"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Ghi chú sách"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["Kiểm tra theo đúng thứ tự này. Trước hết xem nghề đó có trong《国家职业资格目录》hay không, không có trong danh mục thì không phải chứng chỉ nghề nghiệp quốc gia. Rồi xem cơ quan cấp chứng chỉ có phải cơ quan đánh giá đã đăng ký với cơ quan nhân sự không. Cuối cùng vào nền tảng tra chứng chỉ đánh giá nhân tài kỹ năng chính thức, tra mã số chứng chỉ. Tra không ra thì đừng đăng ký. Loại nào có chữ「quốc tế」,「cao cấp」,「đăng ký」trong tên, hoặc hứa「đảm bảo đỗ」,「treo giấy phép có thu nhập」, thì rủi ro cao nhất."]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Ghi chú của tôi"]},{"tag":"button","props":{"type":"button"},"children":["Viết một lời nhắc cho chính bạn…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/vi/tip/23-07"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Trước"]},"Ghi trước đường cơ sở: một năm học thêm, mức hoàn lại tư nhân trung bình toàn cầu (phần rơi vào thu nhập của chính mình) khoảng 9% mỗi năm"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/vi/tip/23-09"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Tiếp theo"]},"Đào tạo nên đi qua kênh trợ cấp của nhà nước trước, đừng vừa học vừa tự bỏ tiền đăng lớp thương mại"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["Thêm trong chủ đề này"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/23-04"},"children":[{"tag":"strong","props":{},"children":["Trường hợp「không đủ tiền để đi học」thì tính theo chính sách trước đã: học phí trường trung cấp chuyên nghiệp đã miễn phần lớn, học bổng 2300 tệ, học vay tối đa 2 vạn tệ một năm"]},{"tag":"span","props":{},"children":["Trong trường trung cấp chuyên nghiệp công lập, học sinh nông thôn, họ…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/23-05"},"children":[{"tag":"strong","props":{},"children":["Không đỗ được trường phổ thông không phải là hết đường: trường trung cấp chuyên nghiệp có tuyển sinh liên thông và thi riêng, tuyển dụng lao động kỹ thuật còn được hạ yêu cầu học vấn"]},{"tag":"span","props":{},"children":["Luật Giáo dục nghề nghiệp (职业教育法) năm 2022 viết rõ: giáo dục nghề ngh…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/23-06"},"children":[{"tag":"strong","props":{},"children":["Biến câu hỏi「học hay đi làm」thành một bài toán: ba năm lương kiếm sớm nhờ đi làm trước, đổi lấy chênh lệch thu nhập mỗi năm của mấy chục năm sau nhờ học tiếp"]},{"tag":"span","props":{},"children":["Đi làm trước thì kiếm được vài năm lương sớm hơn, nhưng khoản tiền nà…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/23-10"},"children":[{"tag":"strong","props":{},"children":["Khi chọn kỹ năng, xem trước cái「có phải làm bằng tay, có phải phán đoán tại chỗ không」, loại này khó bị tự động hoá thay nhất"]},{"tag":"span","props":{},"children":["Theo ước tính của Mỹ, khoảng 47% vị trí có nguy cơ khá cao bị máy tín…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/23-11"},"children":[{"tag":"strong","props":{},"children":["Trước khi học, xác nhận kỹ năng này có đánh giá theo cấp bậc không, cấp bậc có đổi ra tiền được không"]},{"tag":"span","props":{},"children":["Nhà nước đang đẩy「thợ bậc tám mới」, yêu cầu doanh nghiệp gắn lương th…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/23-12"},"children":[{"tag":"strong","props":{},"children":["Đừng coi「trên mạng nói lương cao」là thiếu người, hãy tra danh mục nghề khan hiếm và danh mục trợ cấp tại địa phương"]},{"tag":"span","props":{},"children":["Mỗi nơi cho nghề nào nhiều trợ cấp đào tạo hơn là tuỳ mức khan hiếm c…"]}]}]}]},{"tag":"a","props":{"className":"life-text-link","href":"/vi/book/23"},"children":["Đọc toàn bộ chủ đề: Học kỹ năng nào thì đáng"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"15","height":"15","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","cl