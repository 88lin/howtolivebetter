ucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["成本"]},{"tag":"p","props":{"className":"life-citations"},"children":["不花钱。每周留意一次孩子几点睡、作业交没交、有没有出门活动。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["收益"]},{"tag":"p","props":{"className":"life-citations"},"children":["一篇荟萃分析汇总了 17 个国家的 53 项研究、226247 人。游戏障碍的患病率是 3.05%（95% CI 2.38–3.91，这是可信范围）。只算抽样更严格的研究，是 1.96%。各研究结果差得远，77% 的差别出在用的是哪份问卷上。样本是青少年、门槛分数低、样本小，都会让比例偏高。另一项研究拿到 7 家游戏公司的数据，把 38935 名玩家六周的真实游戏时长，和他们自己填的幸福感连起来看。几乎找不到玩的时长影响幸福感的证据。国家新闻出版署规定，游戏企业只能在周五、周六、周日和法定节假日每天 20 时到 21 时，给未成年人提供 1 小时服务（全国 / 国际，2021 年起）"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["来源"]},{"tag":"p","props":{"className":"life-citations"},"children":["Stevens MW, Dorstyn D, Delfabbro PH, King DL. (2021). Global prevalence of gaming disorder: A systematic review and meta-analysis. Australian and New Zealand Journal of Psychiatry, 55(6), 553–568. ",{"tag":"a","props":{"href":"https://doi.org/10.1177/0004867420962851","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1177/0004867420962851"]},"；Vuorre M, Johannes N, Magnusson K, Przybylski AK. (2022). Time spent playing video games is unlikely to impact well-being. Royal Society Open Science, 9(7), 220411. ",{"tag":"a","props":{"href":"https://doi.org/10.1098/rsos.220411","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1098/rsos.220411"]},"；国家新闻出版署 (2021). 关于进一步严格管理切实防止未成年人沉迷网络游戏的通知（国新出发〔2021〕14 号）. ",{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/2021-09/01/content_5634661.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/zhengce/zhengceku/2021-09/01/content_5634661.htm"]},""]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["原书备注"]},{"tag":"p","props":{"className":"life-citations"},"children":["给 B 是因为患病率随问卷变化太大，幸福感那项研究也只跟了六周。游戏最常见的代价是挤掉睡觉和户外时间。睡觉的明文要求见本节第 10 条（睡眠、作业、体育），户外见本节第 4 条（每天户外 2 小时），屏幕时长见本节第 5 条（非学习用途每天不超过 1 小时）。充值和退款见第 5 节第 9 条（孩子用手机充值打赏）。成绩、睡觉、和家里人的关系一起垮下来，劝也停不下来，这时带孩子去精神科或儿童心理科。别送去封闭管理的戒网瘾学校，见本节第 18 条（戒网瘾学校）。受益人是孩子。"]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["我的备注"]},{"tag":"button","props":{"type":"button"},"children":["写下对自己有用的提醒…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/tip/30-13"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["上一条"]},"恒磨牙长出来以后做窝沟封闭"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/tip/30-15"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["下一条"]},"孩子说自己喜欢同性，别骂、别赶出家门、别送去「矫正」：家里的态度和他会不会自杀有关"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"secti