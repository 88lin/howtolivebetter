":[{"tag":"path","props":{"d":"M18 20a6 6 0 0 0-12 0"},"children":[]},{"tag":"circle","props":{"cx":"12","cy":"10","r":"4"},"children":[]},{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},{"tag":"span","props":{},"children":["Войти"]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/ru/book/02"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"К содержанию"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["Не умирайте медленно"]},{"tag":"nav","props":{"aria-label":"Советы главы"},"children":[{"tag":"a","props":{"href":"/ru/tip/02-01"},"children":[{"tag":"span","props":{},"children":["01"]},"Бросайте курить — чем раньше, тем лучше"]},{"tag":"a","props":{"href":"/ru/tip/02-02"},"children":[{"tag":"span","props":{},"children":["02"]},"Не курите дома и в машине, а также не позволяйте гостям курить в вашем доме"]},{"tag":"a","props":{"href":"/ru/tip/02-03"},"children":[{"tag":"span","props":{},"children":["03"]},"Отказ от курения: не обходитесь только силой воли, сначала возьмите лекарства — шанс успеха вырастет более чем вдвое"]},{"tag":"a","props":{"href":"/ru/tip/02-04"},"children":[{"tag":"span","props":{},"children":["04"]},"Выберите день для полного отказа от курения — в этот день бросьте сразу, не уменьшайте дозу постепенно"]},{"tag":"a","props":{"href":"/ru/tip/02-05"},"children":[{"tag":"span","props":{},"children":["05"]},"Обратитесь в клинику по отказу от курения или позвоните на горячую линию 12320, чтобы узнать, есть ли такие услуги в вашем регионе"]},{"tag":"a","props":{"href":"/ru/tip/02-06"},"children":[{"tag":"span","props":{},"children":["06"]},"Курящим, уже не способным бросить, можно попробовать электронные сигареты, а некурящим — лучше не прикасаться к ним"]},{"tag":"a","props":{"href":"/ru/tip/02-07"},"children":[{"tag":"span","props":{},"children":["07"]},"Отказ от сладких напитков, даже безсахарных, не решает проблему"]},{"tag":"a","props":{"href":"/ru/tip/02-08"},"children":[{"tag":"span","props":{},"children":["08"]},"Не жевать бетель"]},{"tag":"a","props":{"href":"/ru/tip/02-09"},"children":[{"tag":"span","props":{},"children":["09"]},"Замена обычной соли на низконатриевую (калийную) соль дома"]},{"tag":"a","props":{"href":"/ru/tip/02-10"},"children":[{"tag":"span","props":{},"children":["10"]},"Регулярно чистите зубы и ежедневно удаляйте остатки пищи из межзубных промежутков; при потере зубов своевременно обращайтесь к стоматологу"]},{"tag":"a","props":{"href":"/ru/tip/02-11"},"children":[{"tag":"span","props":{},"children":["11"]},"Ежедневно нужно делать 7000–8000 шагов или набирать 150–300 минут быстрой ходьбы в неделю"]},{"tag":"a","props":{"href":"/ru/tip/02-12"},"children":[{"tag":"span","props":{},"children":["12"]},"При гипертонии и повышенном уровне холестерина следует принимать лекарства строго по назначению врача, не прекращая терапию самостоятельно"]},{"tag":"a","props":{"href":"/ru/tip/02-13"},"children":[{"tag":"span","props":{},"children":["13"]},"Спать примерно 7 часов в сутки и соблюдать режим"]},{"tag":"a","props":{"href":"/ru/tip/02-14"},"children":[{"tag":"span","props":{},"children":["14"]},"Регулярно занимайтесь ракеточными видами спорта: теннисом, бадминтоном, настольным теннисом"]},{"tag":"a","props":{"href":"/ru/tip/02-15"},"children":[{"tag":"span","props":{},"children":["15"]},"Соберите несколько коротких физических нагрузок вроде подъема по лестнице или быстрой ходьбы в суммарный объем в 4–5 минут в день"]},{"tag":"a","props":{"href":"/ru/tip/02-16"},"children":[{"tag":"span","props":{},"children":["16"]},"30–60 минут силовых тренировок в неделю"]},{"tag":"a","props":{"href":"/ru/tip/02-17"},"children":[{"tag":"span","props":{},"children":["17"]},"Не сидите подряд слишком долго — время от времени вставайте и двигайтесь"]},{"tag":"a","props":{"href":"/ru/tip/02-18"},"children":[{"tag":"span","props":{},"children":["18"]},"Меньше употреблять переработанное мясо (ветчину, бекон, колбасу, консервированное мясо)"]},{"tag":"a","props":{"href":"/ru/tip/02-19"},"children":[{"tag":"span","props":{},"children":["19"]},"Пейте как можно меньше или вообще не пейте"]},{"tag":"a","props":{"href":"/ru/tip/02-20"},"children":[{"tag":"span","props":{},"children":["20"]},"Людям, которые ежедневно пьют алкоголь и при прекращении приема испытывают дрожь и тревогу, не стоит самостоятельно бросать пить"]},{"tag":"a","props":{"href":"/ru/tip/02-21"},"children":[{"tag":"span","props":{},"children":["21"]},"Хотите пить меньше? Сначала посчитайте, сколько выпили за неделю, а потом поговорите с врачом несколько минут"]},{"tag":"a","props":{"href":"/ru/tip/02-22"},"children":[{"tag":"span","props":{},"children":["22"]},"Ежедневное употребление небольшой горсти орехов"]},{"tag":"a","props":{"href":"/ru/tip/02-23"},"children":[{"tag":"span","props":{},"children":["23"]},"Замена части красного мяса на рыбу и птицу"]},{"tag":"a","props":{"href":"/ru/tip/02-24"},"children":[{"tag":"span","props":{},"children":["24"]},"Замените часть белого риса и пшеничной муки на цельнозерновые продукты"]},{"tag":"a","props":{"href":"/ru/tip/02-25"},"children":[{"tag":"span","props":{},"children":["25"]},"Пить чай более трёх раз в неделю"]},{"tag":"a","props":{"href":"/ru/tip/02-26"},"children":[{"tag":"span","props":{},"children":["26"]},"Три–четыре чашки кофе в день без сахара и сливок"]},{"tag":"a","props":{"href":"/ru/tip/02-27"},"children":[{"tag":"span","props":{},"children":["27"]},"Съедать по 5 порций (около 400 г) фруктов и овощей в день"]},{"tag":"a","props":{"href":"/ru/tip/02-28"},"children":[{"tag":"span","props":{},"children":["28"]},"Меньше употреблять сверхобработанные продукты (чипсы, быстрые лапша, выпечка, полуфабрикаты)"]},{"tag":"a","props":{"href":"/ru/tip/02-29"},"children":[{"tag":"span","props":{},"children":["29"]},"Переход с угля и дров на электричество или газ для приготовления пищи и отопления"]},{"tag":"a","props":{"href":"/ru/tip/02-30"},"children":[{"tag":"span","props":{},"children":["30"]},"Дайте горячему напитку остыть, прежде чем пить — не пейте слишком горячий чай, суп или кофе"]},{"tag":"a","props":{"href":"/ru/tip/02-31"},"children":[{"tag":"span","props":{},"children":["31"]},"Выходите на солнце днём — не сидите всё время в помещении"]},{"tag":"a","props":{"href":"/ru/tip/02-32"},"children":[{"tag":"span","props":{},"children":["32"]},"Поддерживайте ИМТ в пределах 20–25: при избыточном весе нужно худеть"]},{"tag":"a","props":{"href":"/ru/tip/02-33"},"children":[{"tag":"span","props":{},"children":["33"]},"Употребление перца чили более четырех раз в неделю"]},{"tag":"a","props":{"href":"/ru/tip/02-34"},"children":[{"tag":"span","props":{},"children":["34"]},"Выпивать по одной-две порции молока или йогурта в день"]},{"tag":"a","props":{"href":"/ru/tip/02-35"},"children":[{"tag":"span","props":{},"children":["35"]},"Яйца можно есть, но не стоит употреблять по три-четыре штуки в день"]},{"tag":"a","props":{"href":"/ru/tip/02-36"},"children":[{"tag":"span","props":{},"children":["36"]},"При возможности принимайте ванну, а не ограничивайтесь душем"]},{"tag":"a","props":{"href":"/ru/tip/02-37"},"children":[{"tag":"span","props":{},"children":["37"]},"Ограничьте дневной сон полчаса — не более часа; если вам необходимо спать по часу-два, чтобы чувствовать себя нормально, стоит выяснить причину"]},{"tag":"a","props":{"href":"/ru/tip/02-38"},"children":[{"tag":"span","props":{},"children":["38"]},"После бессонной ночи ложитесь спать пораньше на следующий вечер — не откладывайте это на выходные"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/ru/tip/02-39","data-status":"active"},"children":[{"tag":"span","props":{},"children":["39"]},"Чем дольше человек работает в ночную смену, тем выше риск сердечно-сосудистых заболеваний; при возможности стоит сменить работу"]},{"tag":"a","props":{"href":"/ru/tip/02-40"},"children":[{"tag":"span","props":{},"children":["40"]},"Покупайте готовую упакованную растительную нефть с номером разрешения SC, а не самодельное арахисовое масло из частных мастерских"]},{"tag":"a","props":{"href":"/ru/tip/02-41"},"children":[{"tag":"span","props":{},"children":["41"]},"Замена свиного и сливочного жира на растительное масло в приготовлении пищи — не требует покупки разных видов масел ради здоровья, а льняное масло не защищает сердце"]},{"tag":"a","props":{"href":"/ru/tip/02-42"},"children":[{"tag":"span","props":{},"children":["42"]},"Включайте вытяжку при жарке и тушении — с момента зажигания плиты и до конца готовки"]},{"tag":"a","props":{"href":"/ru/tip/02-43"},"children":[{"tag":"span","props":{},"children":["43"]},"Если приливы и ночная потливость в период менопаузы мешают жить, обратитесь к гинекологу для оценки гормональной терапии: не терпите и не покупайте лекарства самостоятельно, а для профилактики болезней сердца её не используйте"]},{"tag":"a","props":{"href":"/ru/tip/02-44"},"children":[{"tag":"span","props":{},"children":["44"]},"Если собаку и так хотели завести, засчитывайте ежедневные прогулки с ней в норму шагов, но не заводите собаку ради долголетия"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"Навигация"},"children":[{"tag":"a","props":{"href":"/ru/book"},"children":["Книга"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/ru/book/02"},"children":["Глава 2"," ·"," ","Не умирайте медленно"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"02-39"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["39"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["Доказательства"," ","A"]}]},{"tag":"h1","props":{"lang":"ru"},"children":["Чем дольше человек работает в ночную смену, тем выше риск сердечно-сосудистых заболеваний; при возможности стоит сменить работу"]},{"tag":"p","props":{"lang":"ru","className":"life-entry-summary"},"children":["У людей, работающих в ночную смену, сердечно-сосудистых заболеваний примерно на 13% больше, а смертности от них — на 27%. Причем чем дольше человек трудится в ночную смену, тем выше этот риск: каждые дополнительные 5 лет такой работы повышают вероятность сердечно-сосудистых заболеваний примерно на 7%. Поэтому, если есть возможность, стоит сменить работу как можно раньше. Что касается связи ночных смен с раком, то доказательная база здесь значительно слабее, чем утверждают популярные мифы."]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Затраты"]},{"tag":"p","props":{},"children":["Смена работы может привести к снижению дохода, а также к п…"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Польза"]},{"tag":"p","props":{},"children":["Анализ 23 исследований показал, что у людей, работающих в ночную смену, риск развития сердечно-сосудистых забо…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"Отметить: Чем дольше человек работает в ночную смену, тем выше риск сердечно-сосудистых заболеваний; при возможности стоит сменить работу"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"Сделано"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"В планах"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"В избранное"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Поделиться советом"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Скрыть подробности"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Затраты"]},{"tag":"p","props":{},"children":["Смена работы может привести к снижению дохода, а также к потере доплат за ночные смены. Поиск новой работы требует времени и решимости. Если же этот фактор учесть заранее, при выборе места работы, то дополнительные расходы будут равны нулю."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Польза"]},{"tag":"p","props":{},"children":["Анализ 23 исследований показал, что у людей, работающих в ночную смену, риск развития сердечно-сосудистых заболеваний выше примерно на 13% (отношение рисков RR 1,13; 95% доверительный интервал 1,10–1,16). Смертность от таких заболеваний выше примерно на 27% (RR 1,27; 1,18–1,36). В пересчете на годы работы в ночную смену каждые дополнительные 5 лет повышают риск сердечно-сосудистых заболеваний примерно на 7% (RR 1,07; 1,04–1,09) и риск смерти от них — примерно на 5% (RR 1,05; 1,03–1,06). Среди конкретных заболеваний риск ишемической болезни сердца выше примерно на 22% (RR 1,22; 1,16–1,28), смертность от нее — также примерно на 22% (RR 1,22; 1,10–1,36). Риск смерти от ишемической болезни сердца выше примерно на 39% (RR 1,39; 1,06–1,84), а от инсульта — примерно на 49% (RR 1,49; 1,04–2,12). При этом статистически значимого повышения общего риска инсульта не наблюдается (RR 1,06; 0,95–1,18)."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Первоисточники"]},{"tag":"p","props":{"className":"life-citations"},"children":["Xi J, Ma W, Tao Y, 等 (2025). Association between night shift work and cardiovascular disease: a systematic review and dose-response meta-analysis. Frontiers in Public Health. ",{"tag":"a","props":{"href":"https://doi.org/10.3389/fpubh.2025.1668848","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.3389/fpubh.2025.1668848"]},"；Esposito G, Bravi F, Santucci C, 等 (2025). Night shift work and breast cancer risk in healthcare workers: a systematic review and meta-analysis. Occupational Medicine. ",{"tag":"a","props":{"href":"https://doi.org/10.1093/occmed/kqaf040","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1093/occmed/kqaf040"]},"；Shen QM, Li ZY, Tan YT, 等 (2026). Night shift work and risk of total and site-specific cancer: results from a prospective cohort study among Chinese men. Scandinavian Journal of Work, Environment & Health. ",{"tag":"a","props":{"href":"https://doi.org/10.5271/sjweh.4290","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.5271/sjweh.4290"]},"；Czeisler CA, Johnson MP, Duffy JF, 等 (1990). Exposure to bright light and darkness to treat physiologic maladaptation to night work. New England Journal of Medicine, 322(18), 1253-1259. ",{"tag":"a","props":{"href":"https://doi.org/10.1056/NEJM199005033221801","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1056/NEJM199005033221801"]}]},{"tag":"a","props":{"href":"https://doi.org/10.3389/fpubh.2025.1668848","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Открыть источник"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Примечание автора"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["Все эти данные получены в исследованиях, где участники лишь регистрировались, без разделения на группы. Люди, работающие в ночную смену, изначально отличаются от остальных по курению, весу и доходу, поэтому полностью исключить этот фактор из анализа не удалось. Что касается связи ночных смен с раком, то доказательная база здесь значительно слабее, чем утверждают популярные мифы. В анализе 12 исследований с участием 12 132 женщин с диагнозом рак молочной железы риск заболевания у тех, кто работал в ночную смену, оказался выше лишь примерно на 5% (RR 1,05; 0,96–1,14); при этом доверительный интервал пересекает единицу. В группе женщин, проработавших в ночную смену 20 лет, риск повышался примерно на 25% (RR 1,25; 1,01–1,55), однако после учета возможного публикационного смещения этот показатель стал статистически незначимым и близким к единице; авторы называют такую связь «далеко не установленной». В другом исследовании, охватившем 8 202 китайских мужчин в течение 16,1 года, ночные смены не коррелировали с общим риском рака или большинством его видов; лишь у тех, кто проработал в ночную смену от 11 до 20 лет, риск рака поджелудочной железы вырос примерно на 59% (HR 1,59; 1,09–2,31). Поэтому в данном обзоре рассматривается именно сердечно-сосудистый риск, а не рак. Не всем следует уходить с ночной работы — решение нужно принимать, исходя из расчетов, основанных на количестве отработанных лет. Тем, кто уже работает в ночную смену, рекомендуется придерживаться следующих рекомендаций: бросить курить (чем раньше, тем лучше — см. пункт 1 данного раздела); при гипертонии и повышенном уровне липидов принимать назначенные врачом препараты (см. пункт 12); восстанавливать сон после ночной смены (см. пункт 38). Также можно попробовать два дополнительных метода: ограничить прием пищи дневным временем суток и использовать яркий свет днем при почти полном отсутствии света ночью, чтобы сдвинуть биологические ритмы. Последний метод единственный, доказанно способный изменить биологические ритмы: при обычном домашнем освещении после шести ночных смен биологические ритмы не меняются; однако при воздействии света интенсивностью 7 000–12 000 люкс днем и почти полном отсутствии света ночью они меняются уже через четыре дня. Для успеха необходимо соблюдать три условия: свет ночью должен быть достаточно ярким, днем во время сна — полная темнота, а по пути с работы следует надевать солнцезащитные очки, чтобы защититься от утреннего света; пропуск любого из этих условий сводит усилия на нет. Оба метода влияют лишь на метаболические показатели и сон; пока не проводилось исследований, подтверждающих их способность снижать риск сердечно-сосудистых заболеваний. В выходные дни, когда человек возвращается к дневному режиму, биологические ритмы снова смещаются. Исходные цифры, подробности и информацию о том, как организм воспринимает время суток, можно найти в документе ",{"tag":"a","props":{"href":"/ru/articles/circadian-rhythm"},"children":["docs/生物钟和夜班.md"]},"."]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Моя заметка"]},{"tag":"button","props":{"type":"button"},"children":["Запишите напоминание…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/ru/tip/02-38"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Предыдущий"]},"После бессонной ночи ложитесь спать пораньше на следующий вечер — не откладывайте это на выходные"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/ru/tip/02-40"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Следующий"]},"Покупайте готовую упакованную растительную нефть с номером разрешения SC, а не самодельное арахисовое масло из частных мастерских"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["Другие советы по этой теме"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/02-35"},"children":[{"tag":"strong","props":{},"children":["Яйца можно есть, но не стоит употреблять по три-четыре штуки в день"]},{"tag":"span","props":{},"children":["Если в течение дня съедать на половину яйца больше, чем обычно, вероя…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/02-36"},"children":[{"tag":"strong","props":{},"children":["При возможности принимайте ванну, а не ограничивайтесь душем"]},{"tag":"span","props":{},"children":["У людей, которые почти ежедневно принимают ванну, риск развития серде…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/02-37"},"children":[{"tag":"strong","props":{},"children":["Ограничьте дневной сон полчаса — не более часа; если вам необходимо спать по часу-два, чтобы чувствовать себя нормально, стоит выяснить причину"]},{"tag":"span","props":{},"children":["У людей, спящих днём не более часа, не повышается риск смертности и х…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/02-41"},"children":[{"tag":"strong","props":{},"children":["Замена свиного и сливочного жира на растительное масло в приготовлении пищи — не требует покупки разных видов масел ради здоровья, а льняное масло не защищает сердце"]},{"tag":"span","props":{},"children":["Уменьшение потребления насыщенных жиров, содержащихся в свином жире и…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/02-42"},"children":[{"tag":"strong","props":{},"children":["Включайте вытяжку при жарке и тушении — с момента зажигания плиты и до конца готовки"]},{"tag":"span","props":{},"children":["У некурящих китайских женщин, которые не включают или редко пользуютс…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props"