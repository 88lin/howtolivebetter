urrentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-up-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M7 7h10v10"},"children":[]},{"tag":"path","props":{"d":"M7 17 17 7"},"children":[]}]}]}]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/ru/book/06"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"К содержанию"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["Перечень вредных средств"]},{"tag":"div","props":{"data-ad-dock-host":"true"},"children":[]},{"tag":"nav","props":{"aria-label":"Советы главы"},"children":[{"tag":"a","props":{"href":"/ru/tip/06-01"},"children":[{"tag":"span","props":{},"children":["01"]},"Не стоит принимать поливитамины ради долголетия или профилактики сердечно-сосудистых заболеваний"]},{"tag":"a","props":{"href":"/ru/tip/06-02"},"children":[{"tag":"span","props":{},"children":["02"]},"Не стоит принимать обычное рыбье масло ради профилактики сердечно-сосудистых заболеваний"]},{"tag":"a","props":{"href":"/ru/tip/06-03"},"children":[{"tag":"span","props":{},"children":["03"]},"Не стоит давать витамин D людям, у которых его уровень в норме, ради долголетия"]},{"tag":"a","props":{"href":"/ru/tip/06-04"},"children":[{"tag":"span","props":{},"children":["04"]},"Не стоит принимать антиоксидантные добавки ради профилактики рака (бета-каротин, витамин E, витамин A)"]},{"tag":"a","props":{"href":"/ru/tip/06-05"},"children":[{"tag":"span","props":{},"children":["05"]},"Не стоит рассчитывать на глюкозамин и хондроитин при лечении артрита коленного сустава"]},{"tag":"a","props":{"href":"/ru/tip/06-06"},"children":[{"tag":"span","props":{},"children":["06"]},"Не стоит использовать витамин C для профилактики простуды"]},{"tag":"a","props":{"href":"/ru/tip/06-07"},"children":[{"tag":"span","props":{},"children":["07"]},"Не стоит делать себе «полный ПЭТ-КТ» или «панель онкомаркеров», если у вас нет симптомов"]},{"tag":"a","props":{"href":"/ru/tip/06-08"},"children":[{"tag":"span","props":{},"children":["08"]},"Не стоит рассчитывать, что трекеры активности помогут вам похудеть"]},{"tag":"a","props":{"href":"/ru/tip/06-09"},"children":[{"tag":"span","props":{},"children":["09"]},"Не стоит переплачивать за органические продукты ради «большего здоровья»"]},{"tag":"a","props":{"href":"/ru/tip/06-10"},"children":[{"tag":"span","props":{},"children":["10"]},"Не стоит тратить большие деньги на БАДы, пастообразные смеси и пищевые добавки для «укрепления здоровья»"]},{"tag":"a","props":{"href":"/ru/tip/06-11"},"children":[{"tag":"span","props":{},"children":["11"]},"Не стоит долго принимать пробиотики при отсутствии проблем с кишечником"]},{"tag":"a","props":{"href":"/ru/tip/06-12"},"children":[{"tag":"span","props":{},"children":["12"]},"Не стоит заставлять себя принимать холодный душ ради «укрепления иммунитета»"]},{"tag":"a","props":{"href":"/ru/tip/06-13"},"children":[{"tag":"span","props":{},"children":["13"]},"Не стоит покупать продукты для детоксикации, очищения кишечника, энзимные добавки или щелочную воду"]},{"tag":"a","props":{"href":"/ru/tip/06-14"},"children":[{"tag":"span","props":{},"children":["14"]},"Не стоит заставлять себя пить воду лишь ради достижения цели «8 стаканов в день»"]},{"tag":"a","props":{"href":"/ru/tip/06-15"},"children":[{"tag":"span","props":{},"children":["15"]},"Не тратьте деньги на гадания, Таро или астрологию, чтобы принимать решения"]},{"tag":"a","props":{"href":"/ru/tip/06-16"},"children":[{"tag":"span","props":{},"children":["16"]},"Не стоит покупать очки с защитой от синего света, чтобы «охранять зрение», и не верьте утверждениям, будто «после нескольких месяцев работы за экраном зрение испортится». Однако сильная боль, отёчность и покраснение глаз — это повод для срочного обращения к врачу"]},{"tag":"a","props":{"href":"/ru/tip/06-17"},"children":[{"tag":"span","props":{},"children":["17"]},"Не стоит рассматривать донорство крови как способ укрепить здоровье: утверждения о «детоксикации, снижении уровня холестерина и профилактике инфаркта» не подтверждены рандомизированными исследованиями, а частое донорство действительно приводит к дефициту железа"]},{"tag":"a","props":{"href":"/ru/tip/06-18"},"children":[{"tag":"span","props":{},"children":["18"]},"Не стоит полагаться на стандартные пакеты медосмотров для профилактики — достаточно проводить те обследования, эффективность которых подтверждена данными, с учётом возраста и пола"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/ru/tip/06-19","data-status":"active"},"children":[{"tag":"span","props":{},"children":["19"]},"Не стоит принимать препараты для снижения уровня мочевой кислоты только потому, что анализы показали её повышение, а боли никогда не было"]},{"tag":"a","props":{"href":"/ru/tip/06-20"},"children":[{"tag":"span","props":{},"children":["20"]},"Не стоит делать профилактическую операцию по удалению желчного пузыря только потому, что при обследовании обнаружили камни, а боли никогда не было"]},{"tag":"a","props":{"href":"/ru/tip/06-21"},"children":[{"tag":"span","props":{},"children":["21"]},"Не стоит отказываться от кальция ради профилактики камней в почках"]},{"tag":"a","props":{"href":"/ru/tip/06-22"},"children":[{"tag":"span","props":{},"children":["22"]},"Не стоит покупать кристаллы, браслеты или фигурки пи-сюй ради «улучшения удачи», «привлечения богатства» или «помощи в саморазвитии»"]},{"tag":"a","props":{"href":"/ru/tip/06-23"},"children":[{"tag":"span","props":{},"children":["23"]},"Не стоит рассчитывать, что покупки улучшат настроение или самооценку"]},{"tag":"a","props":{"href":"/ru/tip/06-24"},"children":[{"tag":"span","props":{},"children":["24"]},"Не тратьте лишние деньги на новую квартиру, машину или круг общения лишь ради того, чтобы «подняться в социальном статусе»"]},{"tag":"a","props":{"href":"/ru/tip/06-25"},"children":[{"tag":"span","props":{},"children":["25"]},"Не верьте утверждению «воля — это как мышца, которая быстро устает»"]},{"tag":"a","props":{"href":"/ru/tip/06-26"},"children":[{"tag":"span","props":{},"children":["26"]},"Не стоит рассчитывать, что завтрак или режим питания 16:8 помогут вам контролировать вес — выбирайте тот график, который сможете соблюдать долгое время"]},{"tag":"a","props":{"href":"/ru/tip/06-27"},"children":[{"tag":"span","props":{},"children":["27"]},"Не верьте в то, что «мастурбация вредит здоровью» или что «нужно воздерживаться, чтобы стать лучше»; на самом деле важно лишь то, не мешает ли это вашему сну, работе и отношениям"]},{"tag":"a","props":{"href":"/ru/tip/06-28"},"children":[{"tag":"span","props":{},"children":["28"]},"Не тратьте деньги на «исправление сексуальной ориентации» или «лечение гомосексуальности», и не отправляйте туда своих близких"]},{"tag":"a","props":{"href":"/ru/tip/06-29"},"children":[{"tag":"span","props":{},"children":["29"]},"Не рассчитывайте предотвратить боль в пояснице «правильной техникой подъема» и курсами: уменьшайте вес и число подъемов, регулярно занимайтесь физической нагрузкой"]},{"tag":"a","props":{"href":"/ru/tip/06-30"},"children":[{"tag":"span","props":{},"children":["30"]},"Не рассчитывайте, что большие дозы кальция и костный бульон ускорят сращение перелома"]},{"tag":"a","props":{"href":"/ru/tip/06-31"},"children":[{"tag":"span","props":{},"children":["31"]},"Не стоит полагаться на ИИ-чат-бот в одиночку, когда нужно оценить болезнь или юридический вопрос: прежде чем идти к врачу, в суд или тратить большие деньги, найдите первоисточник, на который он ссылается, и проверьте по оригиналу"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"Навигация"},"children":[{"tag":"a","props":{"href":"/ru/book"},"children":["Книга"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/ru/book/06"},"children":["Глава 6"," ·"," ","Перечень вредных средств"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"06-19"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["19"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["Доказательства"," ","A"]}]},{"tag":"h1","props":{"lang":"ru"},"children":["Не стоит принимать препараты для снижения уровня мочевой кислоты только потому, что анализы показали её повышение, а боли никогда не было"]},{"tag":"p","props":{"lang":"ru","className":"life-entry-summary"},"children":["Людям, у которых уровень мочевой кислоты выше нормы, но никогда не было приступов подагры и не образовывались тофусы, приём таких препаратов даёт лишь психологическое облегчение. Согласно расчётам Американского коллегия ревматологов, чтобы предотвратить хотя бы один приступ подагры, 24 человека должны принимать лекарства в течение трёх лет. Кроме того, эти препараты не защищают почки: в рандомизированных исследованиях скорость снижения их функции у пациентов, принимающих лекарства, оказалась такой же, как у тех, кто получал плацебо. Настоящая профилактика — контроль веса, отказ от алкоголя и сладких напитков; лечение начинают только после появления первых симптомов."]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Затраты"]},{"tag":"p","props":{},"children":["Не требуются никакие расходы: вы сэкономите на длительном…"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Польза"]},{"tag":"p","props":{},"children":["В руководстве по подагре Американского коллегия ревматологов за 2020 год рассматривается бессимптомная гиперур…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"Отметить: Не стоит принимать препараты для снижения уровня мочевой кислоты только потому, что анализы показали её повышение, а боли никогда не было"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"Сделано"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"В планах"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"В избранное"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Поделиться советом"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Скрыть подробности"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Затраты"]},{"tag":"p","props":{},"children":["Не требуются никакие расходы: вы сэкономите на длительном лечении, регулярных обследованиях и избежите рисков, связанных с ненужным приёмом лекарств."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Польза"]},{"tag":"p","props":{},"children":["В руководстве по подагре Американского коллегия ревматологов за 2020 год рассматривается бессимптомная гиперурикемия — состояние, при котором уровень мочевой кислоты в крови выше 6,8 мг/дл, но ранее не было ни приступов подагры, ни подкожных отложений кристаллов. В документе с оговорками рекомендуется не назначать никакие препараты для снижения уровня мочевой кислоты таким пациентам. К ним относятся аллопуринол, фебуксостат и пробенецид. Уровень доказательности данных оценивается как «высокий». В примечании к таблице указано: «По расчётам атрибутивного риска, для предотвращения одного приступа подагры необходимо лечить 24 пациента в течение трёх лет». В рандомизированном исследовании CKD-FIX приняли участие 363 человека с хронической почечной недостаточностью 3–4 стадии, у которых не было подагры, но существовал риск её развития. Одна группа ежедневно принимала 100–300 мг аллопуринола, другая — плацебо; наблюдение длилось 104 недели. Показателем функции почек служит eGFR, измеряемый в мл/мин/1,73 м². В первой группе он снижался в среднем на 3,33 единицы в год (95% ДИ: от -4,11 до -2,55), во второй — на 3,23 единицы (95% ДИ: от -3,98 до -2,47). Разница между группами составила всего -0,10 единицы (95% ДИ: от -1,18 до 0,97; p=0,85), то есть скорость ухудшения функции почек была одинаковой. Частота серьёзных побочных эффектов составила 46% и 44% соответственно. В исследовании PERL участвовали 530 пациентов с сахарным диабетом 1 типа и ранней или средней стадией диабетической нефропатии; они принимали аллопуринол три года, после чего делали двухмесячный перерыв для выведения препарата из организма. Аллопуринол действительно снизил уровень мочевой кислоты с 6,1 до 3,9 мг/дл, однако после окончания приёма разница в показателе GFR между группами составила всего 0001 мл/мин/1,73 м² (95% ДИ: от -1,9 до 1,9; p=0,99). Количество белка в моче в группе приёма аллопуринола даже оказалось на 40% выше (диапазон: от 0 до 80%). Всё это выглядит выгодным лишь из-за распространённого заблуждения, будто «превышение нормы — повод немедленно принимать лекарства»."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Первоисточники"]},{"tag":"p","props":{"className":"life-citations"},"children":["FitzGerald JD, Dalbeth N, Mikuls T, et al. (2020). 2020 American College of Rheumatology Guideline for the Management of Gout. Arthritis Care & Research, 72(6), 744-760（表 1 及其脚注）. ",{"tag":"a","props":{"href":"https://doi.org/10.1002/acr.24180","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1002/acr.24180"]},"；Badve SV, Pascoe EM, Tiku A, et al. (2020). Effects of Allopurinol on the Progression of Chronic Kidney Disease. New England Journal of Medicine, 382(26), 2504-2513. ",{"tag":"a","props":{"href":"https://doi.org/10.1056/NEJMoa1915833","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1056/NEJMoa1915833"]},"；Doria A, Galecki AT, Spino C, et al. (2020). Serum Urate Lowering with Allopurinol and Kidney Function in Type 1 Diabetes. New England Journal of Medicine, 382(26), 2493-2503. ",{"tag":"a","props":{"href":"https://doi.org/10.1056/NEJMoa1916624","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1056/NEJMoa1916624"]}]},{"tag":"a","props":{"href":"https://doi.org/10.1002/acr.24180","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Открыть источник"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Примечание автора"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["Данная рекомендация касается только отказа от пожизненного приёма препаратов при отсутствии симптомов; она не означает, что повышенный уровень мочевой кислоты совсем безопасен. В том же руководстве перечислены исключения: лечение стоит начинать при первом приступе подагры у пациентов с почечной недостаточностью 3 стадии и выше, при уровне мочевой кислоты выше 9 мг/дл (примерно 535 мкмоль/л) или при наличии камней в мочевыводящих путях. Людям, у которых уже были приступы, образовались тофусы или на снимках видны разрушения костной ткани, препараты назначаются обязательно; подробности описаны в разделе 16, пункт 9 («При подагре необходим постоянный приём лекарств»). У примерно 7,4% представителей китайской национальности выявлен генетический маркер HLA-B*5801; у белых он встречается лишь у 0,7%. У носителей этого маркера приём аллопуринола повышает риск тяжёлых, угрожающих жизни кожных реакций; вероятность развития синдрома гиперчувствительности у азиатов в 3 раза выше, чем у белых. Поскольку эти препараты и так не требуются без явных показаний, не стоит подвергать себя такому лишнему риску. Перед началом лечения обязательно проверьте наличие этого генетического маркера — инструкции снова приведены в разделе 16, пункт 9. Упомянутые исследования проводились только на пациентах с хронической почечной недостаточностью и сахарным диабетом 1 типа, поэтому их результаты нельзя распространять на всех людей с повышенным уровнем мочевой кислоты; они лишь опровергают утверждение о том, что такие препараты защищают почки. 0.001"]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Моя заметка"]},{"tag":"button","props":{"type":"button"},"children":["Запишите напоминание…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/ru/tip/06-18"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Предыдущий"]},"Не стоит полагаться на стандартные пакеты медосмотров для профилактики — достаточно проводить те обследования, эффективность которых подтверждена данными, с учётом возраста и пола"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/ru/tip/06-20"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Следующий"]},"Не стоит делать профилактическую операцию по удалению желчного пузыря только потому, что при обследовании обнаружили камни, а боли никогда не было"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 