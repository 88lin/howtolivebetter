or","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"加入待做"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"收藏"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"分享这条建议"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"收起详情"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["成本"]},{"tag":"p","props":{"className":"life-citations"},"children":["不花钱。难在习惯仰着睡的人要改姿势"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["收益"]},{"tag":"p","props":{"className":"life-citations"},"children":["死胎在这里指孕 28 周以后孩子死在肚子里。一篇汇总合并了五项研究的原始数据。四项在新西兰、澳大利亚、英国，一项是网上的国际调查。共有 851 名死胎的孕妇，另有 2257 名孩子正常的孕妇作对照。研究的做法是事后问她们最近怎么入睡。和左侧入睡比，仰面入睡的死胎风险 aOR 2.63（95% CI 1.72–4.04，可信范围），约是 2.6 倍。右侧入睡 aOR 1.04（0.83–1.31），和左侧没有差别。孩子偏小、孕妇肥胖、抽烟的，这个关联都差不多。作者估算，如果孕 28 周以后的孕妇都侧着入睡，这个阶段的死胎能少约 5.8%（3.2%–9.2%）。英国国家医疗服务体系（NHS）把「孕 28 周以后别仰面入睡」列为降低死胎风险的做法之一。它同时说，醒来发现自己仰着不用担心，翻回侧面再睡就行"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["来源"]},{"tag":"p","props":{"className":"life-citations"},"children":["Cronin RS, Li M, Thompson JMD, et al. (2019). An Individual Participant Data Meta-analysis of Maternal Going-to-Sleep Position, Interactions with Fetal Vulnerability, and the Risk of Late Stillbirth. EClinicalMedicine, 10, 49-57. ",{"tag":"a","props":{"href":"https://doi.org/10.1016/j.eclinm.2019.03.014","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1016/j.eclinm.2019.03.014"]},"；Silver RM, Hunter S, Reddy UM, et al. (2019). Prospective Evaluation of Maternal Sleep Position Through 30 Weeks of Gestation and Adverse Pregnancy Outcomes. Obstetrics and Gynecology, 134(4), 667-676. ",{"tag":"a","props":{"href":"https://doi.org/10.1097/AOG.0000000000003458","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1097/AOG.0000000000003458"]},"（备注里的反方研究）；NHS. Stillbirth. ",{"tag":"a","props":{"href":"https://www.nhs.uk/conditions/stillbirth/","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.nhs.uk/conditions/stillbirth/"]},""]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["原书备注"]},{"tag":"p","props":{"className":"life-citations"},"children":["争议。上面的数字全来自事后回忆。孩子没了的孕妇可能记得不准，作者自己也承认这一点。也没有随机分组的试验。美国一项研究提前问了 8706 名头胎孕妇的睡姿，再看结果。到孕 30 周为止，仰睡或不是左侧睡和死胎、孩子偏小、孕期高血压都没有关联（aOR 0.99，0.89–1.11）。但它只看到孕 30 周，后面几周的睡姿没有记录。侧着睡不花钱也没有坏处，所以英国照样这么建议。死胎本身少见，高收入国家晚期死胎每 1000 次分娩约 1.3 到 8.8 例。收益定「大」是按 2.6 倍机械套的，理由在核实记录里。好处落在孩子身上"]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["我的备注"]},{"tag":"button","props":{"type":"button"},"children":["写下对自己有用的提醒…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/tip/27-18"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["上一条"]},"怀孕期间赶上流感季就打一针流感灭活疫苗，孕期哪个阶段都能打，别用鼻喷的"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/tip/27-20"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["下一条"]},"生完孩子恢复同房就要避孕，喂奶不等于避孕；想要下一胎，至少隔 18 个月再怀"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["本主题的其他建议"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/27-03"},"children":[{"tag":"strong","props":{},"children":["第一次产检就把艾滋病、梅毒、乙肝三项查掉，查出来艾滋病也有免费的阻断"]},{"tag":"span","props":{},"children":["第一次产检就把艾滋病、梅毒、乙肝这三样查掉。艾滋病的初筛不用自己掏钱。真查出来也不是绝路。查出艾滋病，国家免费给治疗和咨询。查出梅毒，尽早用青霉素治。查出乙肝，…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/27-04"},"children":[{"tag":"strong","props":{},"children":["整个孕期一支烟一口酒都不要，家里人也别在屋里抽"]},{"tag":"span","props":{},"children":["孕期抽烟，孩子早产、生下来太小、唇腭裂的概率都往上走，孕期和生产时异常出血的风险翻一倍。孕妇抽烟，或者孩子出生后吸到烟，婴儿猝死的风险都更高。什么时候戒都还来得…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/27-05"},"children":[{"tag":"strong","props":{},"children":["有子痫前期高危因素的，孕 12 周后开始每天一片小剂量阿司匹林"]},{"tag":"span","props":{},"children":["子痫前期是孕期的一种高血压病。上一胎得过、怀多胎、有慢性高血压、孕前有糖尿病、有肾病或自身免疫病的人算高危。高危的人从孕 12 周起每天一片小剂量阿司匹林，子痫…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/27-06"},"children":[{"tag":"strong","props":{},"children":["孕 24 周及以后做一次妊娠期糖尿病筛查，别嫌喝糖水麻烦"]},{"tag":"span","props":{},"children":["妊娠期糖尿病就是怀孕之后才出现的血糖高。孕 24 周以后花半个上午，喝一次糖水、抽几次血，就能查出来。不查也不管，胎儿长得过大、难产、挨一刀、子痫前期和新生儿低…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/27-07"},"children":[{"tag":"strong","props":{},"children":["背下这张「立刻去医院」的清单，孕期和产后一年内都算数"]},{"tag":"span","props":{},"children":["下面任何一条出现，当天就去医院，别在家等一晚，产后一年内也算。头痛不好或越来越重、看东西变样、发烧到 38 ℃、手或脸肿得厉害。喘不上气、胸痛或心跳快、肚子剧痛…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/27-08"},"children":[{"tag":"strong","props":{},"children":["破水了就地平躺、垫高臀部、打 120，不要走动也不要洗澡"]},{"tag":"span","props":{},"children":["破水了不是慢慢收拾东西再出发。正确做法是就地躺下、把屁股垫高、打 120。站着走动，羊水流得更快，脐带可能跟着被冲下来。那是能要孩子命的急症。"]}]}]}]},{"tag":"a","props":{"className":"life-text-link","href":"/book/27"},"children":["阅读整个主题：怀孕和生产：从发现怀孕到出院办证 ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"15","height":"15","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]}]}]},{"tag":"nav","props":{"className":"life-tabbar","aria-label":"主导航"},"children":[{"tag":"a","props":{"className":"","href":"/book"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"21","height":"21","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-book-open","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M12 7v14"},"children":[]},{"tag":"path","props":{"d":"M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z"},"children":[]}]},{"tag":"span","props":{},"children":["全书"]}]},{"tag":"a","props":{"className":"","href":"/top-50"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"21","height":"21","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-star","aria-hidde