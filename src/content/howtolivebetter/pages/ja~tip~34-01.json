s":{"href":"/ja/tip/34-07"},"children":[{"tag":"span","props":{},"children":["07"]},"風邪のときに抗生物質を医師に求めないでください"]},{"tag":"a","props":{"href":"/ja/tip/34-08"},"children":[{"tag":"span","props":{},"children":["08"]},"下痢の際はまず経口補水液で水分補給を。5 歳未満の子供には止瀉薬を与えないでください"]},{"tag":"a","props":{"href":"/ja/tip/34-09"},"children":[{"tag":"span","props":{},"children":["09"]},"鎮痛薬は月に 15 日を超えて服用しないでください。配合鎮痛薬は 10 日を超えないように。さもないと、頭痛そのものが薬によって引き起こされる可能性があります"]},{"tag":"a","props":{"href":"/ja/tip/34-10"},"children":[{"tag":"span","props":{},"children":["10"]},"期限切れの薬や不要な残薬は定期的に処分しましょう。包装ごと有害ゴミとして捨て、家に残さないでください"]},{"tag":"a","props":{"href":"/ja/tip/34-11"},"children":[{"tag":"span","props":{},"children":["11"]},"セファロスポリン系やメトロニダゾールなどの抗菌薬の使用期間中および服用終了後7日間は、飲酒を控えること。藿香正気水（カッコウセイキスイ）や咳止めシロップなど、アルコールを含む薬も避けること"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"現在地"},"children":[{"tag":"a","props":{"href":"/ja/book"},"children":["本を読む"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/ja/book/34"},"children":["第34章"," ·"," ","家庭常備薬の誤用による事故を防ぐ"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"34-01"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["01"]},{"tag":"span","props":{"className":"life-evidence grade-b"},"children":["エビデンス"," ","B"]}]},{"tag":"h1","props":{"lang":"ja"},"children":["2種類の風邪薬や鎮痛薬を併用する前に、必ず成分表を確認してください。アセトアミノフェンは1種類だけに留める必要があります"]},{"tag":"p","props":{"lang":"ja","className":"life-entry-summary"},"children":["多くの風邪薬にはアセトアミノフェンが含まれており、2箱同時に服用すると2倍量を摂取することになり、過剰摂取は肝機能を損なう恐れがあります。米国では、これにより急性肝不全を引き起こした患者の約3割が、肝移植を待たずに死亡しています。国内の添付文書では、1日最大 2 グラムまでと推奨されており、服用期間中の飲酒も避けるべきです。"]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["費用・手間"]},{"tag":"p","props":{},"children":["無料。各薬の成分表を確認するだけで、1〜2分で済みます。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["効果"]},{"tag":"p","props":{},"children":["米国の 22 箇所の病院において、6 年間にわたり 662 例の急性肝不全が連続して登録されました。"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"記録する：2種類の風邪薬や鎮痛薬を併用する前に、必ず成分表を確認してください。アセトアミノフェンは1種類だけに留める必要があります"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"できている"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"やることに追加"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"お気に入り"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"このヒントを共有"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"詳細を閉じる"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["費用・手間"]},{"tag":"p","props":{},"children":["無料。各薬の成分表を確認するだけで、1〜2分で済みます。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["効果"]},{"tag":"p","props":{},"children":["米国の 22 箇所の病院において、6 年間にわたり 662 例の急性肝不全が連続して登録されました。そのうち 275 例（42%）はアセトアミノフェンによるもので、服用量の値の中央値は 24 gでした。これら 275 人のうち、131 人（48%）は意図的ではなく、誤って過剰に摂取していました。誤って過剰摂取した人のうち、38% はアセトアミノフェンを含む他の薬剤と2種類以上を併用していました。これら 275 人のうち、27% は肝移植を受ける前に死亡し、8% が肝移植を受けました。国家薬品監督管理局は 2020 年、OTC薬（一般用医薬品）の添付文書に、過剰使用は深刻な肝損傷を引き起こす可能性があるため、1日の最大摂取量は 2 gを超えないようにすることを明記するよう求めました。また、添付文書には、アセトアミノフェンまたは他の解熱鎮痛薬を含む薬剤との併用を可能な限り避けるよう記載する必要があります。米国の規制では、この種の市販薬の警告の第1条において、肝損傷を引き起こす3つの状況を明記することを求めています：1日の最大服用量を超えた場合、他のアセトアミノフェン含有薬と併用した場合、および服用期間中に毎日 3 杯以上のアルコールを摂取した場合です。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["出典"]},{"tag":"p","props":{"className":"life-citations"},"children":["Larson AM, Polson J, Fontana RJ, et al.; Acute Liver Failure Study Group (2005). Acetaminophen-induced acute liver failure: results of a United States multicenter, prospective study. Hepatology, 42(6):1364-1372. ",{"tag":"a","props":{"href":"https://doi.org/10.1002/hep.20948","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1002/hep.20948"]},"；国家药监局关于修订对乙酰氨基酚常释及缓释制剂说明书的公告（2020年第15号）及附件2《对乙酰氨基酚常释制剂非处方药说明书修订要求》（湖南省药品监督管理局转载）. ",{"tag":"a","props":{"href":"http://mpa.hunan.gov.cn/mpa/xxgk/tzgg/wjtz/202003/t20200311_11809335.html","target":"_blank","rel":"noopener noreferrer"},"children":["http://mpa.hunan.gov.cn/mpa/xxgk/tzgg/wjtz/202003/t20200311_11809335.html"]},"；21 CFR 201.326(a)(1)(iii)(A) Liver warning. ",{"tag":"a","props":{"href":"https://www.ecfr.gov/current/title-21/chapter-I/subchapter-C/part-201/subpart-G/section-201.326","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.ecfr.gov/current/title-21/chapter-I/subchapter-C/part-201/subpart-G/section-201.326"]}]},{"tag":"a","props":{"href":"https://doi.org/10.1002/hep.20948","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["出典を開く"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["著者の注記"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["アセトアミノフェンはパラセタモールとも呼ばれます。複合風邪薬の一般名に「アミノフェン（氨酚）」という文字が含まれるもの（例：アミノフェン・プソイドエフェドリン、アミノカフェイン等）には、この成分が含まれています。判断に迷う場合は、複数の薬をすべて薬局の薬剤師に見せてください。判定Bとした理由は、米国のデータが症例登録に基づくものであり、対照群がないため、成分表を確認することでどれだけ事象を減らせるか算出できないためです。便益を「大」としたのは、その結果に基づいています。急性肝不全の約3割が直接死亡に至っています。"]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["自分のメモ"]},{"tag":"button","props":{"type":"button"},"children":["自分へのメモを書く…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"span","props":{},"children":[]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/ja/tip/34-02"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["次へ"]},"子供の発熱にアスピリン、ニメスリド、アンチピリンは使用しないでください。アンチピリンを含む風邪薬も未成年者には与えないでください"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"childre