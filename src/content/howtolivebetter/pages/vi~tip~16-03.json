s":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"Kế hoạch thực hiện"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"Lưu"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Chia sẻ mẹo này"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Ẩn chi tiết"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Chi phí"]},{"tag":"p","props":{},"children":["Mỗi lần xét nghiệm vài chục đến vài trăm tệ. Đi bệnh viện một chuyến cộng thời gian chờ kết quả thì mất một ít thời gian. Chỗ khó là cứ sau một khoảng lại phải đi một lần, dễ hoãn lần này sang lần khác."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Lợi ích"]},{"tag":"p","props":{},"children":["Bệnh mạn tính cần xem các chỉ số thay đổi thế nào theo thời gian, không chỉ một lần. Một phân tích gộp tăng huyết áp gộp dữ liệu cá nhân của 7138 người trong 15 thử nghiệm ngẫu nhiên. So với chăm sóc thường lệ, người tự đo tại nhà có thay đổi trung bình huyết áp tâm thu đo tại phòng khám sau 12 tháng là −3.2 mmHg (95% CI −4.9 đến −1.6, khoảng tin cậy). Chỉ tự đo, không biện pháp kèm theo, không thấy hiệu quả: −1.0 mmHg (−3.3 đến 1.2, khác biệt có thể ngẫu nhiên). Hỗ trợ đi kèm nhiều nhất giảm 6.1 mmHg (3.2 đến 9.0). Hỗ trợ gồm bác sĩ, dược sĩ hoặc bệnh nhân chỉnh thuốc theo số đo, thêm giáo dục sức khỏe và hướng dẫn lối sống. Tác giả kết luận chỉ đo không làm huyết áp thấp hơn, phải kèm chỉnh thuốc theo số đo. Đây đều là số huyết áp, không trực tiếp xét tử vong. Khi đổi bệnh viện ở Trung Quốc, biện pháp của Ủy ban Y tế Quốc gia và ba cơ quan khác quy định kết quả kiểm tra, xét nghiệm người bệnh đã cung cấp, nếu đạt điều kiện công nhận và đáp ứng nhu cầu chẩn trị thì bệnh viện, bác sĩ không được lặp lại. Báo cáo đủ điều kiện có dấu «HR», chẳng hạn «全国HR»."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Nguồn gốc"]},{"tag":"p","props":{"className":"life-citations"},"children":["Tucker KL, Sheppard JP, Stevens R, et al. (2017). Self-monitoring of blood pressure in hypertension: A systematic review and individual patient data meta-analysis. PLoS Medicine, 14(9), e1002389. ",{"tag":"a","props":{"href":"https://doi.org/10.1371/journal.pmed.1002389","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1371/journal.pmed.1002389"]},"；国家卫生健康委、国家医保局、国家中医药局、中央军委后勤保障部卫生局 (2022). 关于印发医疗机构检查检验结果互认管理办法的通知（国卫医发〔2022〕6 号），第十三条、第十七条、第十九条. ",{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/2022-02/19/content_5674575.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/zhengce/zhengceku/2022-02/19/content_5674575.htm"]}]},{"tag":"a","props":{"href":"https://doi.org/10.1371/journal.pmed.1002389","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Liên kết mở nguồn"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Ghi chú sách"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["Chỉ xếp B vì bằng chứng trực tiếp mới có tăng huyết áp, tiêu chí chỉ đến huyết áp, chưa đến tử vong. Không tìm thấy nghiên cứu kết quả sức khỏe cho riêng việc «ghi chỉ số vào một sổ». Mỗi lần ghi ít nhất bốn thứ: ngày, số đo, thuốc đang dùng và liều. Chụp phiếu xét nghiệm bằng điện thoại cũng được nhưng giữ cùng chỗ, đừng tản mát. Công nhận có ngoại lệ: bệnh thay đổi, kết quả biến động nhanh, trước phẫu thuật hay truyền máu, cấp cứu thì bệnh viện có thể kiểm tra lại. Sao chép lưu bệnh án, hình ảnh xem phần 24, điều 5 (tự giữ bệnh án, báo cáo và hình ảnh)."]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Ghi chú của tôi"]},{"tag":"button","props":{"type":"button"},"children":["Viết một lời nhắc cho chính bạn…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/vi/tip/16-02"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Trước"]},"Làm giấy công nhận bệnh mạn tính ngoại trú trước, rồi đăng ký khám chữa tại nơi khác, để huyết áp cao, tiểu đường, xạ trị hoá chất, lọc máu và chống thải ghép được quyết toán ngay tại nơi khác"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/vi/tip/16-04"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Tiếp theo"]},"Đừng bỏ điều trị chính thức chỉ để thử phương thuốc dân gian hay thực phẩm bảo vệ sức khoẻ"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hi