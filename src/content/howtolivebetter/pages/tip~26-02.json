/www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"已做到"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"加入待做"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"收藏"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"分享这条建议"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"收起详情"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["成本"]},{"tag":"p","props":{"className":"life-citations"},"children":["备案不花钱。增值电信业务经营许可证要花钱，它管的是「向用户收钱的网站能不能开」。办这张证先得有公司。只在省内经营的，注册资本不低于 100 万元。跨省经营的，不低于 1000 万元。审查期 60 日，证的有效期 5 年"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["收益"]},{"tag":"p","props":{"className":"life-citations"},"children":["法规原话是「国家对经营性互联网信息服务实行许可制度；对非经营性互联网信息服务实行备案制度。未取得许可或者未履行备案手续的，不得从事互联网信息服务」。收钱的要先拿许可证，不收钱的要先备案，两样都没有就不能开站。什么叫经营性？法规说是「通过互联网向上网用户有偿提供信息或者网页制作等服务活动」。简单说就是向用户收钱。撮合交易的那一类叫在线数据处理与交易处理业务，业内简称 EDI。法规给它的定义是「利用各种与公用通信网或互联网相连的数据与交易/事务处理应用平台，通过公用通信网或互联网为用户提供在线数据处理和交易/事务处理的业务」。它还「包括交易处理业务、电子数据交换业务和网络/电子设备数据处理业务」。说的就是网站替用户在线处理数据，或者替买卖双方撮合和处理交易。没办证就经营，或者超范围经营，都要没收违法所得，再罚违法所得的 3 到 5 倍。超范围经营就是办了证，干的事却超出证上写的范围。没有违法所得、或者违法所得不足 5 万元的，罚 10 万到 100 万元。情节严重的，责令关闭网站（全国）。收钱不等于一定要办证。广东省通信管理局 2025 年 10 月发的问答说，按工信部要求，下面三种不用办这张证。第一种，企业在自己的网站、App 上「以自营方式直接销售自身或其它企业的商品或服务」，而且没有别的单位或个人入驻开店。第二种，企业在自己的网站、App 上只发自己的信息，不给别人提供发布信息的平台。第三种，企业只靠微信、支付宝这些平台上的小程序、公众号、视频号、网店做生意，「且无其他独立运营平台」。反过来，只要让别人入驻开店、或者让用户在你这里发信息，就不在这三种里面"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["来源"]},{"tag":"p","props":{"className":"life-citations"},"children":["广东省通信管理局 (2025). 关于办理增值电信业务经营许可证的常见问题解答（2025 年 10 月 17 日，第一项）. ",{"tag":"a","props":{"href":"https://gdca.miit.gov.cn/bsfw/bszn/jyxk/tzgg/art/2025/art_6bcbfa4f041247868c0de08e765b33e9.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://gdca.miit.gov.cn/bsfw/bszn/jyxk/tzgg/art/2025/art_6bcbfa4f041247868c0de08e765b33e9.html"]}," ; 国务院 (2000). 互联网信息服务管理办法（国务院令第 292 号，2024 年 12 月 6 日第二次修订，第三、四、七、十九条）. ",{"tag":"a","props":{"href":"https://www.gov.cn/gongbao/content/2011/content_1860864.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/gongbao/content/2011/content_1860864.htm"]}," ; 国务院 (2024). 关于修改和废止部分行政法规的决定（国务院令第 797 号，第十八项）. ",{"tag":"a","props":{"href":"https://www.gov.cn/gongbao/2025/issue_11786/202501/content_6997034.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/gongbao/2025/issue_11786/202501/content_6997034.html"]}," ; 国务院 (2000). 电信条例（2016 年第二次修订，第七、九、十三、六十九条）. ",{"tag":"a","props":{"href":"https://www.gov.cn/gongbao/content/2016/content_5139478.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/gongbao/content/2016/content_5139478.htm"]}," ; 工业和信息化部 (2017). 电信业务经营许可管理办法（工信部令第 42 号，第六、九、十一、十四条）. ",{"tag":"a","props":{"href":"https://www.gov.cn/gongbao/content/2017/content_5240090.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/gongbao/content/2017/content_5240090.htm"]},""]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["原书备注"]},{"tag":"p","props":{"className":"life-citations"},"children":["你要做的是不是 EDI 那一类，自己拿《电信业务分类目录》里的定义对号入座。官方没有任何一句话明说「带撮合和资金处理的电商平台必须办 EDI 许可」。工信部的办事指南只说「按照业务界定申请相应的电信业务经营许可」。所以要不要办，只能拿定义自己判断。还有一点：这张证个人办不了，申请人必须是依法设立的公司。自营不用办证那三种情形，出自广东省通信管理局的问答，它写明是按工信部要求，但别的省没查到同样的公开文字。拿不准就先打电话问属地的通信管理局。这份问答也提醒，办证不用找中介，只在工信部「电信业务市场综合管理信息系统」上交材料，官方不收费"]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["我的备注"]},{"tag":"button","props":{"type":"button"},"children":["写下对自己有用的提醒…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/tip/26-01"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["上一条"]},"平台不要自己收钱再转给卖家，让钱走持牌支付机构直接结算"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/tip/26-03"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["下一条"]},"做直播要网络文化经营许可证，做视听节目的那张证民营基本拿不到"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["本主题的其他建议"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/26-04"},"children":[{"tag":"strong","props":{},"children":["服务器放境内就要备案，接入商必须自己持有增值电信许可"]},{"tag":"span","props":{},"children":["服务器放在境内，开站前就要备案。备案不花钱，跟着服务器在服务商那里提交，一般几天到几周。没备案会被责令限期改正，再罚 1 万元，不改就关站。主页上不挂备案号，另…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/26-05"},"children":[{"tag":"strong","props":{},"children":["让用户上来卖东西，平台就要核验登记、报送信息、留存三年"]},{"tag":"span","props":{},"children":["让别人上你的平台卖东西，你就要先核卖家的身份、地址、联系方式和许可证，再登记建档。建完档，至少每六个月回头再核一次。卖家是谁要报给市场监管，纳税的情况每季度报给…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/26-06"},"children":[{"tag":"strong","props":{},"children":["用户发的内容你要管：审核机制、举报入口、发现违法立即停传并报告"]},{"tag":"span","props":{},"children":["用户发的东西，出了事由平台负责。你要把这套制度建起来：注册、发帖审核、评论审核、每天巡查、出事怎么处置。页面显眼的地方放举报入口。看到违法信息，马上停止传播、留…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/26-07"},"children":[{"tag":"strong","props":{},"children":["提供信息发布、即时通讯服务，必须要求用户提供真实身份信息"]},{"tag":"span","props":{},"children":["你的网站能发帖，或者能聊天，就要在用户开通服务时要他的真实身份信息。不给的，不能让他用。做法是后台存真名，页面上显示什么昵称由他自己定，核验用手机号就行。不做实…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/26-08"},"children":[{"tag":"strong","props":{},"children":["不给未满 16 周岁的人开直播，打赏按年龄分档处理"]},{"tag":"span","props":{},"children":["不满 16 周岁的人，不能在你这里注册开播账号。满 16 周岁的要核验身份，还要父母或其他监护人同意。打赏分三档：不满 8 岁不能打赏，8 到 16 岁要监护人…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/26-09"},"children":[{"tag":"strong","props":{},"children":["接到侵权通知要及时处理，转送声明后 15 日没有下文就恢复"]},{"tag":"span","props":{},"children":["有人发来侵权通知，还附了初步证据，你要及时把东西删掉、屏蔽或者断开链接，同时把通知转给卖家。拖着不办，多出来的那部分损失你要和卖家一起赔。卖家申辩了，你把申辩转…"]}]}]}]},{"tag":"a","props":{"className":"life-text-link","href":"/book/26"},"children":["阅读整个主题：做一个网站或平台：资质、备案和服