18","height":"18","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-up-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M7 7h10v10"},"children":[]},{"tag":"path","props":{"d":"M7 17 17 7"},"children":[]}]}]}]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/es/book/09"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"Volver al índice"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["Las líneas rojas legales que la gente corriente cruza sin darse cuenta"]},{"tag":"div","props":{"data-ad-dock-host":"true"},"children":[]},{"tag":"nav","props":{"aria-label":"Consejos del capítulo"},"children":[{"tag":"a","props":{"href":"/es/tip/09-01"},"children":[{"tag":"span","props":{},"children":["01"]},"En los grupos: no reenvíes noticias sobre desastres, epidemias o avisos policiales cuya veracidad no conozcas, ni retoques fotos ni uses IA para fabricar imágenes de la escena"]},{"tag":"a","props":{"href":"/es/tip/09-02"},"children":[{"tag":"span","props":{},"children":["02"]},"No publiques ni reenvíes imágenes, memes ni comentarios que insulten a los héroes y mártires, ni te burles del himno o la bandera nacionales"]},{"tag":"a","props":{"href":"/es/tip/09-03"},"children":[{"tag":"span","props":{},"children":["03"]},"Lo que veas en sitios web extranjeros: cierras y ya; sin capturas, sin reenvíos, sin llevarlo a los grupos y sin sumarte en los comentarios"]},{"tag":"a","props":{"href":"/es/tip/09-04"},"children":[{"tag":"span","props":{},"children":["04"]},"Los videos pornográficos: para ti mismo; no los mandes al grupo, no vendas «recursos» ni crees grupos"]},{"tag":"a","props":{"href":"/es/tip/09-05"},"children":[{"tag":"span","props":{},"children":["05"]},"Si un «trabajo» te pide usar tus propias tarjetas para recibir dinero, retirar efectivo o hacer transferencias, no lo hagas por mucha comisión que ofrezcan"]},{"tag":"a","props":{"href":"/es/tip/09-06"},"children":[{"tag":"span","props":{},"children":["06"]},"Si alguien te propone «preparar el expediente» para un préstamo y repartirte una comisión según el monto, no aceptes ni una vez"]},{"tag":"a","props":{"href":"/es/tip/09-07"},"children":[{"tag":"span","props":{},"children":["07"]},"Si encuentras una tarjeta bancaria, no saques dinero; si encuentras un teléfono o una cartera, contacta al dueño o entrégalo a la policía; no te lo quedes"]},{"tag":"a","props":{"href":"/es/tip/09-08"},"children":[{"tag":"span","props":{},"children":["08"]},"Reclama los descuentos con tu identidad real: no compres números virtuales para registrar cuentas a granel ni repitas el reclamo aprovechando fallos"]},{"tag":"a","props":{"href":"/es/tip/09-09"},"children":[{"tag":"span","props":{},"children":["09"]},"Desde el balcón o la ventana no tires nada hacia fuera: colillas, bolsas de basura y botellas cuentan"]},{"tag":"a","props":{"href":"/es/tip/09-10"},"children":[{"tag":"span","props":{},"children":["10"]},"No compres por internet pistolas de imitación, de balines de acero ni de aire, ni «pistolas de juguete» de origen desconocido"]},{"tag":"a","props":{"href":"/es/tip/09-11"},"children":[{"tag":"span","props":{},"children":["11"]},"Al comprar un dron, regístralo con tu nombre real; no vueles en aeropuertos, zonas militares ni espacio aéreo controlado urbano, y no rompas el límite de altura"]},{"tag":"a","props":{"href":"/es/tip/09-12"},"children":[{"tag":"span","props":{},"children":["12"]},"No fotografíes a nadie en secreto ni instales cámaras en pisos de alquiler, casas de huéspedes o habitaciones de hotel"]},{"tag":"a","props":{"href":"/es/tip/09-13"},"children":[{"tag":"span","props":{},"children":["13"]},"Mahjong y cartas se pueden jugar, pero sin cobrar comisión, sin ser la banca, sin organizar partidas por dinero y sin jugar en apuestas en línea"]},{"tag":"a","props":{"href":"/es/tip/09-14"},"children":[{"tag":"span","props":{},"children":["14"]},"No comas carne de animales silvestres, ni compres, vendas o tengas como mascotas animales protegidos"]},{"tag":"a","props":{"href":"/es/tip/09-15"},"children":[{"tag":"span","props":{},"children":["15"]},"Para cobrar una deuda: no detengas a nadie, no encierres a nadie y no te quedes plantado en su casa sin que pueda irse"]},{"tag":"a","props":{"href":"/es/tip/09-16"},"children":[{"tag":"span","props":{},"children":["16"]},"No prestar el DNI a nadie, no usar el DNI de otra persona, ni tampoco documentos ajenos para registrarse, abrir cuentas o comprar billetes"]},{"tag":"a","props":{"href":"/es/tip/09-17"},"children":[{"tag":"span","props":{},"children":["17"]},"Cuando la policía te pare o te lleve, colabora: no empujes, no golpees, no arranques la cámara corporal; si bebiste, con más razón aguántate"]},{"tag":"a","props":{"href":"/es/tip/09-18"},"children":[{"tag":"span","props":{},"children":["18"]},"Si la otra persona tiene menos de 14 años, no puede haber relación; «ella aceptó» no es excusa"]},{"tag":"a","props":{"href":"/es/tip/09-19"},"children":[{"tag":"span","props":{},"children":["19"]},"Antes de levantar la mano para golpear, haz las cuentas: detención, indemnización, prisión"]},{"tag":"a","props":{"href":"/es/tip/09-20"},"children":[{"tag":"span","props":{},"children":["20"]},"Si el hijo que nace no lo puedes criar, la única salida legal es el registro civil: entregar al niño por dinero puede condenarse como trata, y abandonarlo es delito de abandono"]},{"tag":"a","props":{"href":"/es/tip/09-21"},"children":[{"tag":"span","props":{},"children":["21"]},"No falsifiques accidentes ni exageres pérdidas para cobrar el seguro: es el delito de fraude de seguros, y cuentan también los que te ayudan a «probar», reparar el coche o peritar"]},{"tag":"a","props":{"href":"/es/tip/09-22"},"children":[{"tag":"span","props":{},"children":["22"]},"No vendas tus órganos ni ayudes a otros a buscar donantes: por un riñón llegan más de 20 000 yuanes al donante y el mismo riñón se revende a 200 000; el dinero se decomisa y encima multa de 10 a 20 veces el monto de la transacción"]},{"tag":"a","props":{"href":"/es/tip/09-23"},"children":[{"tag":"span","props":{},"children":["23"]},"No compres sexo: la sanción por defecto es detención de 10 a 15 días, no una multa y punto"]},{"tag":"a","props":{"href":"/es/tip/09-24"},"children":[{"tag":"span","props":{},"children":["24"]},"Traducir cómics, subir series y películas, compartir recursos en la nube y libros electrónicos piratas sin cobrar también es una infracción; si se ponen anuncios o se cobran cuotas de suscripción, puede conllevar penas de prisión"]},{"tag":"a","props":{"href":"/es/tip/09-25"},"children":[{"tag":"span","props":{},"children":["25"]},"Para publicar o vender obras de fan fiction o creaciones derivadas, primero hay que obtener permiso del autor original o bien cambiar los nombres y relaciones de los personajes utilizados"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/es/tip/09-26","data-status":"active"},"children":[{"tag":"span","props":{},"children":["26"]},"No compres bastones extensibles, dispositivos eléctricos, puñales ni aerosol de pimienta para llevarlos como defensa; tenerlos en el coche también cuenta como llevarlos"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"Ruta de navegación"},"children":[{"tag":"a","props":{"href":"/es/book"},"children":["Libro"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/es/book/09"},"children":["Capítulo 9"," ·"," ","Las líneas rojas legales que la gente corriente cruza sin darse cuenta"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"09-26"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["26"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["Evidencia"," ","A"]}]},{"tag":"h1","props":{"lang":"es"},"children":["No compres bastones extensibles, dispositivos eléctricos, puñales ni aerosol de pimienta para llevarlos como defensa; tenerlos en el coche también cuenta como llevarlos"]},{"tag":"p","props":{"lang":"es","className":"life-entry-summary"},"children":["Llevar puñales, navajas automáticas, porras o dispositivos eléctricos puede acarrear hasta 5 días de detención. Entrar con ellos en estaciones, centros comerciales o autobuses implica de 5 a 10 días. Usarlos también puede perjudicarte: una persona recibió un puñetazo sin armas, apuñaló al agresor con un cuchillo escondido previamente y fue condenada a 4 años por exceso en la defensa."]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Coste"]},{"tag":"p","props":{},"children":["No cuesta dinero. Si ya los compraste, déjalos en casa, no…"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Beneficio"]},{"tag":"p","props":{},"children":["El artículo 38 de la Ley de Sanciones de Seguridad Pública establece hasta 5 días de detención por llevar ileg…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"Marcar: No compres bastones extensibles, dispositivos eléctricos, puñales ni aerosol de pimienta para llevarlos como defensa; tenerlos e