s":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-x","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M18 6 6 18"},"children":[]},{"tag":"path","props":{"d":"m6 6 12 12"},"children":[]}]}]},{"tag":"div","props":{"className":"life-ad-space-brand"},"children":[{"tag":"img","props":{"src":"/sites/howtolivebetter/images/shengcai/logo.png","width":"565","height":"144","alt":"生财有术官方 Logo","decoding":"async"},"children":[]}]},{"tag":"div","props":{"className":"life-ad-space-copy"},"children":[{"tag":"span","props":{"className":"life-ad-space-label"},"children":["广告 · 社区推荐"]},{"tag":"strong","props":{},"children":["读过的知识，能不能做成有用的产品？"]},{"tag":"p","props":{},"children":["从电子书、资料到小工具，看看圈友怎样发现需求，把内容变成实际交付。"]}]},{"tag":"div","props":{"className":"life-ad-space-actions"},"children":[{"tag":"a","props":{"className":"life-ad-space-link","href":"/shengcaiyoushu?sc_group=reading&sc_creative=read_product&sc_placement=ad_dock"},"children":["看看社区与案例",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"18","height":"18","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-up-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M7 7h10v10"},"children":[]},{"tag":"path","props":{"d":"M7 17 17 7"},"children":[]}]}]}]}]}]}]},{"tag":"main","props":{"className":"life-longread"},"children":[{"tag":"a","props":{"className":"life-back-link active","href":"/articles","data-status":"active","aria-current":"page"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"全部长文"]},{"tag":"header","props":{"className":"life-longread-header"},"children":[{"tag":"div","props":{},"children":[{"tag":"div","props":{"className":"life-eyebrow"},"children":["深度长文"]},{"tag":"h1","props":{"lang":"zh"},"children":["结婚划不划算：把一笔糊涂账拆成五笔清楚账"]},{"tag":"p","props":{"lang":"zh"},"children":["把健康、时间、金钱、退出成本和关系质量分开算，再用填空清单理清自己的选择。"]},{"tag":"a","props":{"className":"life-longread-chapter","href":"/book/10"},"children":["相关章节"," · ","恋爱和结婚划不划算",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"img","props":{"src":"/sites/howtolivebetter/images/book-chapters/10-relationships-editorial.webp","srcSet":"/sites/howtolivebetter/images/book-chapters/10-relationships-editorial-thumb.webp 600w, /sites/howtolivebetter/images/book-chapters/10-relationships-editorial-md.webp 900w, /sites/howtolivebetter/images/book-chapters/10-relationships-editorial.webp 1200w","sizes":"(max-width: 760px) 100vw, 450px","alt":"","width":"1200","height":"800","fetchPriority":"high"},"children":[]}]},{"tag":"div","props":{"className":"life-longread-layout"},"children":[{"tag":"aside","props":{"className":"life-longread-toc"},"children":[{"tag":"details","props":{"open":true},"children":[{"tag":"summary","props":{},"children":["本文目录"]},{"tag":"nav","props":{"aria-label":"本文目录"},"children":[{"tag":"a","props":{"href":"#一先把问题拆开"},"children":["一、先把问题拆开"]},{"tag":"a","props":{"href":"#二每笔账的数据与来源"},"children":["二、每笔账的数据与来源"]},{"tag":"a","props":{"href":"#三怎么给自己算一张填空清单"},"children":["三、怎么给自己算：一张填空清单"]},{"tag":"a","props":{"href":"#四常见误区"},"children":["四、常见误区"]},{"tag":"a","props":{"href":"#来源"},"children":["来源"]}]}]}]},{"tag":"div","props":{"className":"life-longread-main"},"children":[{"tag":"article","props":{"className":"life-article-body","lang":"zh"},"children":[{"tag":"p","props":{},"children":["很多人想问的是一个笼统的问题：结婚到底亏还是赚。这个问题里塞了好几样东西：对方能不能给情绪上的支持，能不能分担家务，能不能挣钱，以及要不要为了应付长辈去结。这几样换算不到一起，放在一起没法回答，所以本文把它拆开算。每一笔账只用官方统计或荟萃分析（把多项研究合起来算）里的数字，算不出来的地方直说算不出来。最后给一张可以自己填的清单，全文不给「该不该结」的结论。"]},"\n",{"tag":"h2","props":{"id":"一先把问题拆开"},"children":["一、先把问题拆开"]},"\n",{"tag":"p","props":{},"children":["「结婚划不划算」里至少装着五笔账。这五笔账的单位不一样，算法也不一样，不能加在一起。"]},"\n",{"tag":"ol","props":{},"children":["\n",{"tag":"li","props":{},"children":["钱：一是实打实要掏出去的彩礼、婚礼、婚房，二是法律规定的财产归谁。前一项没有官方统计，后一项有明文条款。"]},"\n",{"tag":"li","props":{},"children":["时间：家务、照料家人、为对方的工作让步，这些都是干了活没人给钱的劳动，单位是每天多少分钟。"]},"\n",{"tag":"li","props":{},"children":["健康：结了婚的人和没结婚的人，死亡率差多少。这笔账只能说明两件事同时出现，说明不了这个差距是结婚带来的。"]},"\n",{"tag":"li","props":{},"children":["法律风险：财产怎么分，想退出要走多久，哪些付出可以回头要一笔补偿，病重时谁能替你拿主意。这笔账看法律条文怎么写。"]},"\n",{"tag":"li","props":{},"children":["关系质量：对方给不给你情绪上的支持，两个人吵成什么样。这笔账只能用研究里算出来的关联强弱去衡量，换不成钱，也换不成时间。"]},"\n"]},"\n",{"tag":"p","props":{},"children":["第五笔最难变成数字，但最接近多数人想问的东西。"]},"\n",{"tag":"h2","props":{"id":"二每笔账的数据与来源"},"children":["二、每笔账的数据与来源"]},"\n",{"tag":"h3","props":{"id":"登记数据结婚率和离婚率是两种粗率"},"children":["登记数据：结婚率和离婚率是两种粗率"]},"\n",{"tag":"p","props":{},"children":["数字来自民政部《2024 年民政事业发展统计公报》。2024 年全国依法办理结婚登记 610.6 万对，比上一年少了 20.5%，结婚率 4.3‰。依法办理离婚手续 351.3 万对，离婚率 2.5‰。这 351.3 万对里，262.2 万对是在民政部门登记离婚的，89.1 万对是由法院判决或者调解离婚的。公报的注释写明了这两个率怎么算：拿当年结婚（离婚）的对数，除以当年的平均总人口数，再乘 1000‰。"]},"\n",{"tag":"p","props":{},"children":["这两个率的分母都是全体人口，所以叫粗率。「粗」指没做任何细分。它回答的是今年每一千人里有多少对去登记了结婚或者离婚，回答不了一段婚姻最后会不会散。要回答后一个问题，得有跟着同一批人长期记录的数据。本文没能在官方原文里找到这样的数据。"]},"\n",{"tag":"h3","props":{"id":"健康账已婚者死亡率更低但这是相关不是因果"},"children":["健康账：已婚者死亡率更低，但这是相关不是因果"]},"\n",{"tag":"p","props":{},"children":["有三项荟萃分析把多篇研究汇总到了一起，给出的量级是一致的。下面说的「全因死亡」，指的是不分病因、所有死亡加在一起。"]},"\n",{"tag":"ul","props":{},"children":["\n",{"tag":"li","props":{},"children":["Manzoli 等 (2007) 汇总了 53 组比较、25 万余名老年人。这里的「没在婚姻里」包括三种人：丧偶的、离异或者分居的、从未结婚的。已婚的人和这三种人比，全因死亡 RR 为 0.88，低约一成二。RR 是两群人的死亡风险之比，小于 1 说明已婚的一方更低。95% CI 0.85–0.91 是这个数字的可信范围。三种人分开看，丧偶 1.11、离异或分居 1.16、未婚 1.11，分别高约一成、一成六和一成。男女分开算、研究做得好坏分开算、欧洲和美洲分开算，结果都不变。用最保守的算法重算一遍，RR 为 0.94，只低约百分之六。"]},"\n",{"tag":"li","props":{},"children":["Roelfs 等 (2011) 汇总了 95 篇文献、5 亿余人。从未结过婚的人和已婚的人比，全因死亡 HR 为 1.24，高约两成四。HR 和 RR 一样是个倍数，大于 1 说明风险更高。1.19–1.30 是这个数字的可信范围。年纪越大，这个差距越小。研究做得越严谨，算出来的差距也越小。"]},"\n",{"tag":"li","props":{},"children":["Wang 等 (2020) 汇总了 21 项研究、789 万余人。不在婚姻里，和全因死亡、癌症死亡、心血管死亡都有关联，男女都是如此。其中男性在心血管死亡和全因死亡上的关联更强。从未结婚的男性和从未结婚的女性比，死于卒中（脑中风）的风险高 31%，全因死亡高 9%。"]},"\n"]},"\n",{"tag":"p","props":{},"children":["这三项研究都只是跟踪记录人群，没有分组对照。身体好、收入高、社交多的人，本来就更容易结上婚，也本来就更容易活得久。这叫选择效应。Manzoli 那篇还发现有发表偏倚的迹象。发表偏倚的意思是，结果好看的研究更容易被发表出来，汇总的时候就会偏乐观。所以这些数字只能读成已婚的人群里死亡率低一些，不能读成「结了婚你就能少死 12%」。这些研究的样本以欧美人群为主，用在国内只能当个量级参考。"]},"\n",{"tag":"h3","props":{"id":"时间账无酬劳动的性别差距是一个上限参考"},"children":["时间账：无酬劳动的性别差距是一个上限参考"]},"\n",{"tag":"p","props":{},"children":["数字来自国家统计局第三次全国时间利用调查，调查时间是 2024 年 5 月。先说清三个词。无酬劳动就是干了活没人给钱的那部分。「参与者」指当天真做了这件事的人。「参与率」指有多少比例的人当天做了这件事。结果是这样：无酬劳动的参与者每天平均花 2 小时 45 分，其中男性 1 小时 52 分、女性 3 小时 29 分。参与率 75.6%，其中男性 67.5%、女性 83.9%。家务劳动单独拿出来看，按全体居民摊平是每天 1 小时 17 分。只算当天真干了的人，是 1 小时 59 分，比 2018 年少 28 分，参与率 64.9%。陪伴照料家人单独拿出来看，按全体居民摊平是 30 分。只算当天真干了的人，是 1 小时 46 分，参与率 28.4%。"]},"\n",{"tag":"p","props":{},"children":["2018 年的第二次调查是这样：家务劳动按全体居民摊平是 1 小时 26 分，其中男性 45 分、女性 2 小时 6 分。参与率男性 40.4%、女性 75.6%。陪伴照料孩子生活按全体居民摊平是 36 分，其中男性 17 分、女性 53 分。参与率男性 12.3%、女性 25.1%。"]},"\n",{"tag":"p","props":{},"children":["这两次调查都只按性别、城乡、年龄分组，没有按结没结婚分组。所以「结婚之后每天要多干多少家务」这个问题，没有官方数字。能拿来用的是男女之间的差距。2024 年无酬劳动的男女差距是 1 小时 37 分。如果家务分工没谈清楚，两个人可能拉开的差距最多就是这么大。"]},"\n",{"tag":"h3","props":{"id":"钱账默认规则书面约定和家务补偿"},"children":["钱账：默认规则、书面约定和家务补偿"]},"\n",{"tag":"p","props":{},"children":["彩礼、婚礼、婚房这几项没有官方统计，本文不写数字。能写清楚的是民法典婚姻家庭编定下的规则。民法典从 2021 年 1 月 1 日起施行。"]},"\n",{"tag":"ul","props":{},"children":["\n",{"tag":"li","props":{},"children":["第一千零六十二条：从结婚那天到离婚那天，这段时间里得到的四样东西，都算两个人的共同财产。一是工资、奖金、劳务报酬。二是做生意和投资的收益。三是知识产权的收益。四是继承来的或者别人赠与的财产。第四样有个例外：遗嘱或者赠与合同里写明只给一个人的，不算共同财产。共同财产两个人有同等的处理权。"]},"\n",{"tag":"li","props":{},"children":["第一千零六十三条：有四样算个人财产，离婚的时候不进共同财产。一是结婚前就有的财产。二是身体受伤害拿到的赔偿或者补偿。三是遗嘱或者赠与合同里写明只给一方的财产。四是一方专用的生活用品。"]},"\n",{"tag":"li","props":{},"children":["第一千零六十五条：婚前和婚后的财产归谁，两个人可以自己约定。可以约定各归各的，可以约定全部共有，也可以约定一部分各归各、一部分共有。这个约定必须写成书面的，写了就对两个人都有法律约束力。没有约定，或者约定得不清不楚，就按上面两条办。"]},"\n",{"tag":"li","props":{},"children":["第一千零八十八条：有一方因为带孩子、照顾老人、帮着另一方工作，比对方多付出了，离婚的时候可以向对方要一笔补偿。补多少，先由两个人自己商量，商量不拢由法院判。"]},"\n"]},"\n",{"tag":"p","props":{},"children":["这套规则对两边都有用。挣钱多的那一方，重点看第一千零六十二条和第一千零六十五条。家里干活多的那一方，重点看第一千零八十八条。财产约定只要求写成书面的，法律上不要求去公证处公证。"]},"\n",{"tag":"h3","props":{"id":"退出成本冷静期和诉讼条件"},"children":["退出成本：冷静期和诉讼条件"]},"\n",{"tag":"ul","props":{},"children":["\n",{"tag":"li","props":{},"children":["第一千零七十六条：两个人都愿意离婚的，先签一份书面离婚协议，再本人到婚姻登记机关去申请。协议里要写明孩子归谁带，财产和债务怎么处理。这些内容都得是两个人谈拢了的意见。"]},"\n",{"tag":"li","props":{},"children":["第一千零七十七条：从登记机关收到申请那天算起的三十天里，任何一方反悔了，都可以把申请撤回来。这三十天就是常说的冷静期。冷静期过完之后的三十天里，两个人要本人去申请领离婚证，没去的就当作撤回申请。"]},"\n",{"tag":"li","props":{},"children":["第一千零七十九条：一方想离、另一方不同意的，可以先调解，也可以直接到法院起诉。到了法院，法院也要先调解。法院确认感情确实已经破裂、调解也没用的，应当判离。下面这几种情形，调解无效的应当判离：重婚或者与他人同居，家庭暴力或者虐待遗弃，赌博吸毒等恶习屡教不改，因为感情不和分居满二年。还有一种情形：第一次判了不准离，之后两个人又分居满一年，再起诉的应当判离。"]},"\n"]},"\n",{"tag":"p","props":{},"children":["2024 年离婚的 351.3 万对里，有 89.1 万对是走法院判决或者调解离的。冷静期只管登记离婚，走法院打官司的不适用冷静期。"]},"\n",{"tag":"h3","props":{"id":"法律身份配偶是近亲属病重时能替你拿主意"},"children":["法律身份：配偶是近亲属，病重时能替你拿主意"]},"\n",{"tag":"p","props":{},"children":["结了婚，对方在法律上就是你的近亲属。民法典第一千零四十五条列的近亲属，排在第一个的就是配偶。这个身份在下面几种时候用得上。"]},"\n",{"tag":"ul","props":{},"children":["\n",{"tag":"li","props":{},"children":["做手术：第一千二百一十九条规定，手术、特殊检查、特殊治疗要先跟病人本人讲清风险，取得本人的明确同意。本人昏迷没法说明，或者不宜跟本人说的，医生要向近亲属说明，由近亲属同意。病人清醒的时候，签字的是病人自己，配偶替不了。"]},"\n",{"tag":"li","props":{},"children":["抢救：第一千二百二十条规定，病人生命垂危，又没法取得本人或者近亲属的意见，经医院负责人批准，可以立即抢救。家属不在场，法律允许医院先救。"]},"\n",{"tag":"li","props":{},"children":["长期没法自己做主：成年人丧失民事行为能力后，第二十八条排的监护人顺序是配偶第一，父母、子女第二。事先书面指定过监护人的，按第三十三条由指定的人来当。"]},"\n",{"tag":"li","props":{},"children":["继承：第一千一百二十七条的第一顺序继承人是配偶、子女、父母。没立遗嘱的，配偶和你的子女、父母一起分遗产。"]},"\n"]},"\n",{"tag":"p","props":{},"children":["这个好处要打两个折扣。第一，第一千二百一十九条只写了「近亲属」，没给近亲属排先后。父母、成年子女也是近亲属，几个人意见不一致时听谁的，法律没写。第二，没结婚的伴侣也能补上大部分。办法是趁两个人都清醒，办好书面授权委托、意定监护协议和遗嘱，见",{"tag":"a","props":{"href":"/book/10#10-18","title":"同性伴侣趁两个人都清醒，办好授权委托、意定监护和遗嘱：法律上你们不是近亲属，不办就没有签字权和继承权"},"children":["第 10 节第 18 条"]},"（授权委托、意定监护和遗嘱）。那条写的是同性伴侣，这三样文件对没领证的异性伴侣一样能办。但意定监护人能不能直接签手术同意书，各医院做法不一。结了婚，这几样身份领证时一次全有，不用一样样去办，也少了被医院或家属挑文件的麻烦。"]},"\n",{"tag":"h3","props":{"id":"关系质量比有没有结婚更值得算的一笔"},"children":["关系质量：比「有没有结婚」更值得算的一笔"]},"\n",{"tag":"p","props":{},"children":["Robles 等 (2014) 汇总了 126 篇研究、7.2 万余人。结论是：婚姻质量越高，健康越好。这里衡量两件事跟得紧不紧，用的是一个叫效应量 r 的数。r 越接近 0，说明两件事几乎不相干。r 的绝对值越大，说明跟得越紧。r 前面带个负号，表示一个高、另一个就低。这些关联的 r 在 0.07 到 0.21 之间。其中和死亡风险的 r = 0.11。和两人起冲突时的心血管反应，r = −0.13。这些数值都不大。不过吃得好不好这类健康行为和健康之间的关联，也是同一个量级。有一部分结果存在发表偏倚（好看的结果更易发表）。有些研究专门检验过男女差别，基本没发现男女不一样。这些研究多数只是跟踪记录，没有分组对照，所以推不出因果。Dhindsa 等 (2020) 这篇心血管方面的综述也指出，对婚姻满不满意、婚姻质量好不好，对心血管风险有明显影响。"]},"\n",{"tag":"p","props":{},"children":["本文没有找到这样的荟萃分析：直接拿「质量差的婚姻」和「没结婚」比死亡率。所以「坏婚姻还不如不结」目前只是推出来的说法，没有数字撑着。站得住的是：「结没结婚」这个差别里混着选择效应，「婚姻质量好不好」是另外一件独立的事。只看有没有结婚、不看过得怎么样，就会把婚姻质量这笔账整个漏掉。"]},"\n",{"tag":"h2","props":{"id":"三怎么给自己算一张填空清单"},"children":["三、怎么给自己算：一张填空清单"]},"\n",{"tag":"p","props":{},"children":["一笔账归一笔账地填。不同笔的数不要加在一起。填不出来的格子就写「不知道」。「不知道」本身也是有用的信息。"]},"\n",{"tag":"p","props":{},"children":["对方能提供什么（一笔一笔填）"]},"\n",{"tag":"ul","props":{},"children":["\n",{"tag":"li","props":{},"children":["钱：对方的收入有多少，欠了多少债，婚前有什么财产。婚后的财产，是按法律的默认规则走，还是要写一份书面约定。要写约定的话，约定里写什么。"]},"\n",{"tag":"li","props":{},"children":["时间：对方现在每天做多少没人付钱的家务和照料。全国平均数可以拿来对照：当天真干了的人里，男性 1 小时 52 分、女性 3 小时 29 分。结婚以后这些活怎么分。有了孩子、家里老人要人照顾的时候，又怎么分。两个人里谁的工作可以往后放。"]},"\n",{"tag":"li","props":{},"children":["关系质量：过去半年两个人起过几次冲突，每次最后是怎么收场的。你生病、失业、情绪低落的时候，对方做了什么。反过来，对方碰上这些事的时候，你做了什么。"]},"\n",{"tag":"li","props":{},"children":["情绪价值：和对方待在一起，你是觉得精力变多了，还是被耗掉了。这个要相处几个月才看得出来，光看条件清单看不出来。"]},"\n"]},"\n",{"tag":"p","props":{},"children":["自己要付出什么（一笔一笔填）"]},"\n",{"tag":"ul","props":{},"children":["\n",{"tag":"li","props":{},"children":["钱：为结婚这件事本身要掏多少，包括彩礼、婚礼、婚房。这笔钱如果不结婚，会用到哪儿去。"]},"\n",{"tag":"li","props":{},"children":["时间：估一下每天要多干多少家务和照料。再估一下每周要多花多少时间在人情往来上。"]},"\n",{"tag":"li","props":{},"children":["健康：自己的作息、吃饭、运动，会因为结婚变好还是变坏。这比荟萃分析算出来的那些数字更贴近你自己。"]},"\n",{"tag":"li","props":{},"children":["退出成本：走登记离婚，要先等 30 天冷静期，再在接下来的 30 天内去领证。走法院，要满足第一千零七十九条写的那些情形。这段时间自己扛不扛得住。"]},"\n"]},"\n",{"tag":"p","props":{},"children":["法律上怎么保护自己（两边都适用）"]},"\n",{"tag":"ul","props":{},"children":["\n",{"tag":"li","props":{},"children":["婚前的财产有没有凭证，比如购房合同、银行流水、赠与合同、遗嘱。这些凭证能不能证明它是「婚前就有的」，或者「写明了只归一方」。"]},"\n",{"tag":"li","props":{},"children":["要不要签一份书面的财产约定。这份约定是只管婚前财产，只管婚后挣的，还是两头都管。"]},"\n",{"tag":"li","props":{},"children":["婚后是谁家务和照料干得更多。干得多的这一方，知不知道按第一千零八十八条可以要一笔补偿。两个人愿不愿意提前把补偿办法约定好。"]},"\n",{"tag":"li","props":{},"children":["债务：婚后以个人名义借的钱，哪些会算成两个人的共同债务。另一方对这笔钱知不知情。"]},"\n",{"tag":"li","props":{},"children":["病重、昏迷的时候，你希望谁替你签字、拿主意。结了婚，配偶是近亲属，但父母也是，意见可能不一样。想指定一个人，可以事先书面办意定监护。不结婚的，这几样要自己去办。"]},"\n"]},"\n",{"tag":"p","props":{},"children":["为长辈结婚这一栏单独填"]},"\n",{"tag":"ul","props":{},"children":["\n",{"tag":"li","props":{},"children":["长辈能得到什么：心里踏实，面子上过得去，不用再催婚，将来有人养老。"]},"\n",{"tag":"li","props":{},"children":["这几样里哪些真是长辈的好处，哪些其实是自己的好处。"]},"\n",{"tag":"li","props":{},"children":["上面三栏的成本，全都由自己承担。长辈得到的那些好处，不会自动变成自己的健康，也不会自动变成自己的关系质量。"]},"\n",{"tag":"li","props":{},"children":["这么分开写完，这笔账是重是轻，由填表的人自己判断。"]},"\n"]},"\n",{"tag":"h2","props":{"id":"四常见误区"},"children":["四、常见误区"]},"\n",{"tag":"p","props":{},"children":["把两种离婚率搞混。一种是粗离婚率，算的是每一千人里有多少对离婚，2024 年是 2.5‰。另一种是「离结比」，算的是当年离婚的对数除以当年结婚的对数，351.3 / 610.6 ≈ 57.5%。离结比的分子和分母不是同一批人，今年离婚的这些人，多数是好多年前结的婚。结婚的人一少，这个比值就会自己往上跳，所以它说明不了「一半的婚姻会离」。民政部的公报里也没有这个指标。"]},"\n",{"tag":"p","props":{},"children":["把「同时出现」当成「因为所以」。已婚的人死亡率低 12% 左右，这是把多篇研究合起来算出来的结果。但身体好、收入高、社交多这些条件，本来就同时影响两件事：一个人能不能结上婚，和一个人能不能活得久。这笔账可以算，但要打折看，也不能拿它代替对眼前这段具体关系的判断。"]},"\n",{"tag":"p","props":{},"children":["把结婚当成一项要完成的任务。当成任务，就只盯着「结没结」这个状态，不看「过得怎么样」。可是关系质量对健康的影响独立于结没结婚，任务式的决定通常把这笔账整个漏掉。"]},"\n",{"tag":"p","props":{},"children":["把全国平均数当成自己的数。时间利用调查里的男女差距，是全国平均。财产规则是法律给的默认设置，可以用一份书面约定改掉。全国数字只能给你一个量级、一个谈判的起点，给不了结论。"]},"\n",{"tag":"p","props":{},"children":["没有官方数字的地方，别拿民间数字去填。彩礼、婚礼、养孩子的成本都没有官方统计，所以本文空着。自己填自己那份真实的数，比引用任何机构的估算都准。"]},"\n",{"tag":"h2","props":{"id":"来源"},"children":["来源"]},"\n",{"tag":"ul","props":{},"children":["\n",{"tag":"li","props":{},"children":["民政部 (2025). 2024 年民政事业发展统计公报（五（二）1 婚姻登记服务、注释 5）. ",{"tag":"a","props":{"href":"https://www.mca.gov.cn/n1288/n1294/n1554/c1662004999980006190/content.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.mca.gov.cn/n1288/n1294/n1554/c1662004999980006190/content.html"]},"（PDF：",{"tag":"a","props":{"href":"https://www.mca.gov.cn/gdnps/n2445/n2451/n2458/n2681/c1662004999980006189/attr/400985.pdf","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.mca.gov.cn/gdnps/n2445/n2451/n2458/n2681/c1662004999980006189/attr/400985.pdf"]},"）"]},"\n",{"tag":"li","props":{},"children":["国家统计局 (2024). 第三次全国时间利用调查公报（第一号、第二号、第三号）. ",{"tag":"a","props":{"href":"https://www.stats.gov.cn/sj/zxfb/202410/t20241031_1957217.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.stats.gov.cn/sj/zxfb/202410/t20241031_1957217.html"]},"、",{"tag":"a","props":{"href":"https://www.stats.gov.cn/sj/zxfb/202410/t20241031_1957216.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.stats.gov.cn/sj/zxfb/202410/t20241031_1957216.html"]},"、",{"tag":"a","props":{"href":"https://www.stats.gov.cn/sj/zxfb/202410/t20241031_1957215.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.stats.gov.cn/sj/zxfb/202410/t20241031_1957215.html"]},"；国家统计局社科文司负责人答记者问. ",{"tag":"a","props":{"href":"https://www.stats.gov.cn/sj/sjjd/202410/t20241031_1957218.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.stats.gov.cn/sj/sjjd/202410/t20241031_1957218.html"]}]},"\n",{"tag":"li","props":{},"children":["国家统计局 (2019). 2018 年全国时间利用调查公报. ",{"tag":"a","props":{"href":"https://www.stats.gov.cn/sj/zxfb/202302/t20230203_1900224.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.stats.gov.cn/sj/zxfb/202302/t20230203_1900224.html"]}]},"\n",{"tag":"li","props":{},"children":["全国人民代表大会 (2020). 中华人民共和国民法典（第二十八、三十三、一千零四十五、一千零六十二、一千零六十三、一千零六十五、一千零七十六、一千零七十七、一千零七十九、一千零八十八、一千一百二十七、一千二百一十九、一千二百二十条）. 国家法律法规数据库 ",{"tag":"a","props":{"href":"https://flk.npc.gov.cn/detail?title=%E4%B8%AD%E5%8D%8E%E4%BA%BA%E6%B0%91%E5%85%B1%E5%92%8C%E5%9B%BD%E6%B0%91%E6%B3%95%E5%85%B8&id=ff808081729d1efe01729d50b5c500bf","target":"_blank","rel":"noopener noreferrer"},"children":["https://flk.npc.gov.cn/detail?title=中华人民共和国民法典&id=ff808081729d1efe01729d50b5c500bf"]},"；条文全文见最高人民法院公报转载 ",{"tag":"a","props":{"href":"http://gongbao.court.gov.cn/Details/7f184078694d811fb3314f6af9accf.html","target":"_blank","rel":"noopener noreferrer"},"children":["http://gongbao.court.gov.cn/Details/7f184078694d811fb3314f6af9accf.html"]}]},"\n",{"tag":"li","props":{},"children":["民政部 (2020). 关于贯彻落实《中华人民共和国民法典》中有关婚姻登记规定的通知（民发〔2020〕116 号）. ",{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/2020-12/04/content_5567010.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/zhengce/zhengceku/2020-12/04/content_5567010.htm"]}]},"\n",{"tag":"li","props":{},"children":["Manzoli L, Villari P, Pirone GM, Boccia A (2007). Marital status and mortality in the elderly: a systematic review and meta-analysis. Soc Sci Med 64:77–94. ",{"tag":"a","props":{"href":"https://doi.org/10.1016/j.socscimed.2006.08.031","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1016/j.socscimed.2006.08.031"]}]},"\n",{"tag":"li","props":{},"children"