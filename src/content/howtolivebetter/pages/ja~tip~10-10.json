rue"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"詳細を閉じる"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["費用・手間"]},{"tag":"p","props":{},"children":["費用はかかりません。民法（婚姻・家族編）の財産に関する条文を読んでおきましょう。必要であれば、夫婦で書面による財産分与の合意書を作成してください。法律上、書面であることが求められており、公証を受ける必要はありません。難しいのは、お金に関する話を事前にオープンにすることです。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["効果"]},{"tag":"p","props":{},"children":["特段の合意がない場合のデフォルトルールは以下の通りです：婚姻後に得た給与、ボーナス、労務の報酬、生産・経営・投資による収益、知的財産権による収益、相続または贈与された財産は、夫婦の共有財産となります（第1062条）。婚姻前の財産、人身損害賠償、遺言または贈与契約において一方のみに帰属することが明示された財産、および一方の専用生活用品は、個人の財産となります（第1063条）。夫婦双方は、婚姻前および婚姻後の財産を各自の所有とするか、共有とするか、あるいは一部を各自、一部を共有とするかを書面で合意することができ、この合意は双方に対して法的拘束力を持ちます（第1065条）。子の養育、高齢者の介護、相手方の仕事の補助などのために、より多くの義務を負担した側は、離婚時に補償を請求する権利を有します（第1088条）"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["出典"]},{"tag":"p","props":{"className":"life-citations"},"children":["全国人民代表大会 (2020). 中华人民共和国民法典（2021 年 1 月 1 日起施行，第一千零六十二、一千零六十三、一千零六十五、一千零八十八条）. 国家法律法规数据库 ",{"tag":"a","props":{"href":"https://flk.npc.gov.cn/detail?title=%E4%B8%AD%E5%8D%8E%E4%BA%BA%E6%B0%91%E5%85%B1%E5%92%8C%E5%9B%BD%E6%B0%91%E6%B3%95%E5%85%B8&id=ff808081729d1efe01729d50b5c500bf","target":"_blank","rel":"noopener noreferrer"},"children":["https://flk.npc.gov.cn/detail?title=%E4%B8%AD%E5%8D%8E%E4%BA%BA%E6%B0%91%E5%85%B1%E5%92%8C%E5%9B%BD%E6%B0%91%E6%B3%95%E5%85%B8&id=ff808081729d1efe01729d50b5c500bf"]},"；条文全文见最高人民法院公报转载 ",{"tag":"a","props":{"href":"http://gongbao.court.gov.cn/Details/7f184078694d811fb3314f6af9accf.html","target":"_blank","rel":"noopener noreferrer"},"children":["http://gongbao.court.gov.cn/Details/7f184078694d811fb3314f6af9accf.html"]}]},{"tag":"a","props":{"href":"https://flk.npc.gov.cn/detail?title=%E4%B8%AD%E5%8D%8E%E4%BA%BA%E6%B0%91%E5%85%B1%E5%92%8C%E5%9B%BD%E6%B0%91%E6%B3%95%E5%85%B8&id=ff808081729d1efe01729d50b5c500bf","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["出典を開く"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["著者の注記"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["結納金、結婚式、新居については公式な統計がないため、本項目では数値を記載していません。第1088条の補償額については、まずは夫婦間で話し合い、合意に至らない場合は裁判所が決定します。固定された計算式はありません。書面による財産合意は双方にメリットがあります。収入の高い側にとっても、家事や介護などの無報酬の役割を多く担う側にとっても、有効な手段となります。"]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["自分のメモ"]},{"tag":"button","prop