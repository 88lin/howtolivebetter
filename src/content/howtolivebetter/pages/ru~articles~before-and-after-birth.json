ops":{"src":"/sites/howtolivebetter/images/book-chapters/27-pregnancy-editorial.webp","srcSet":"/sites/howtolivebetter/images/book-chapters/27-pregnancy-editorial-thumb.webp 600w, /sites/howtolivebetter/images/book-chapters/27-pregnancy-editorial-md.webp 900w, /sites/howtolivebetter/images/book-chapters/27-pregnancy-editorial.webp 1200w","sizes":"(max-width: 760px) 100vw, 450px","alt":"","width":"1200","height":"800","fetchPriority":"high"},"children":[]}]},{"tag":"div","props":{"className":"life-longread-layout"},"children":[{"tag":"aside","props":{"className":"life-longread-toc"},"children":[{"tag":"details","props":{"open":true},"children":[{"tag":"summary","props":{},"children":["В этой статье"]},{"tag":"nav","props":{"aria-label":"В этой статье"},"children":[{"tag":"a","props":{"href":"#i-при-планировании-беременности"},"children":["I. При планировании беременности"]},{"tag":"a","props":{"href":"#ii-после-наступления-беременности-до-родов"},"children":["II. После наступления беременности, до родов"]},{"tag":"a","props":{"href":"#iii-в-роддоме"},"children":["III. В роддоме"]},{"tag":"a","props":{"href":"#iv-до-выписки"},"children":["IV. До выписки"]},{"tag":"a","props":{"href":"#v-первый-месяц-после-рождения"},"children":["V. Первый месяц после рождения"]},{"tag":"a","props":{"href":"#vi-от-месяца-до-первого-дня-рождения"},"children":["VI. От месяца до первого дня рождения"]}]}]}]},{"tag":"div","props":{"className":"life-longread-main"},"children":[{"tag":"article","props":{"className":"life-article-body","lang":"ru"},"children":[{"tag":"blockquote","props":{},"children":["\n",{"tag":"p","props":{},"children":["Неофициальный перевод файла ",{"tag":"a","props":{"href":"/articles/before-and-after-birth"},"children":["docs/孩子出生前后要办的事.md"]},". При расхождениях приоритет у китайского оригинала."]},"\n"]},"\n",{"tag":"p","props":{},"children":[{"tag":"a","props":{"href":"https://github.com/dlgrv/HowToLiveBetter/blob/5a8aac6e715851066661ab6524c3a4e650f7e9d7/README.ru.md","target":"_blank","rel":"noopener noreferrer"},"children":["← К оглавлению"]}]},"\n",{"tag":"p","props":{},"children":["Книга разбита по темам; беременность, роды и уход за младенцем разнесены по разным разделам. Этот список выстроен по времени — от планирования беременности до первого дня рождения. В каждой строке — только действие; обоснование и сила доказательств — в пункте в скобках. Начните с заголовка вашего этапа."]},"\n",{"tag":"h2","props":{"id":"i-при-планировании-беременности"},"children":["I. При планировании беременности"]},"\n",{"tag":"ol","props":{},"children":["\n",{"tag":"li","props":{},"children":["Принимайте 0,4 мг фолиевой кислоты ежедневно, начиная за три месяца до зачатия. См. ",{"tag":"a","props":{"href":"/ru/book/27"},"children":["пункт 1 раздела 27"]}," (фолиевая кислота)."]},"\n",{"tag":"li","props":{},"children":["Один раз позвоните в соцстрах или медстрахование и спросите, хватает ли месяцев взносов по страхованию материнства. См. ",{"tag":"a","props":{"href":"/ru/book/27"},"children":["пункт 11 раздела 27"]}," (страхование материнства)."]},"\n",{"tag":"li","props":{},"children":["Договоритесь с домашними: с этого момента никто не курит в помещении. См. ",{"tag":"a","props":{"href":"/ru/book/02"},"children":["пункт 2 раздела 2"]}," (не курить дома и в машине)."]},"\n",{"tag":"li","props":{},"children":["Если от вашего дохода зависит кто-то дома — сначала оформите сроковое страхование жизни на кормильца. См. ",{"tag":"a","props":{"href":"/ru/book/05"},"children":["пункт 40 раздела 5"]}," (сроковое страхование жизни)."]},"\n"]},"\n",{"tag":"h2","props":{"id":"ii-после-наступления-беременности-до-родов"},"children":["II. После наступления беременности, до родов"]},"\n",{"tag":"ol","props":{},"children":["\n",{"tag":"li","props":{},"children":["До 13-й недели зарегистрируйтесь в центре общественного здоровья на «Справочник матери и ребёнка»; оттуда начинаются бесплатные визиты. См. ",{"tag":"a","props":{"href":"/ru/book/27"},"children":["пункт 2 раздела 27"]}," (справочник матери и ребёнка)."]},"\n",{"tag":"li","props":{},"children":["На первом пренатальном визите сдайте ВИЧ, сифилис и гепатит B; за анализы не платите. См. ",{"tag":"a","props":{"href":"/ru/book/27"},"children":["пункт 3 раздела 27"]}," (ВИЧ, сифилис, гепатит B)."]},"\n",{"tag":"li","props":{},"children":["Во время беременности — ни сигарет, ни алкоголя. См. ",{"tag":"a","props":{"href":"/ru/book/27"},"children":["пункт 4 раздела 27"]}," (без сигарет и алкоголя)."]},"\n",{"tag":"li","props":{},"children":["На приёмах сообщите полный анамнез. При факторах риска преэклампсии пусть врач решит, нужен ли с 12-й недели аспирин в малой дозе. См. ",{"tag":"a","props":{"href":"/ru/book/27"},"children":["пункт 5 раздела 27"]}," (аспирин в малой дозе)."]},"\n",{"tag":"li","props":{},"children":["С 24-й недели — скрининг гестационного диабета. См. ",{"tag":"a","props":{"href":"/ru/book/27"},"children":["пункт 6 раздела 27"]}," (скрининг гестационного диабета)."]},"\n",{"tag":"li","props":{},"children":["После 20-й недели не принимайте обезболивающие типа ибупрофена сами. См. ",{"tag":"a","props":{"href":"/ru/book/34"},"children":["пункт 5 раздела 34"]}," (обезболивающие типа ибупрофена)."]},"\n",{"tag":"li","props":{},"children":["Выучите список «срочно в больницу» и передайте его домашним. См. ",{"tag":"a","props":{"href":"/ru/book/27"},"children":["пункт 7 раздела 27"]}," (срочно в больницу)."]},"\n",{"tag":"li","props":{},"children":["На приёмах спросите, есть ли в роддоме обезболивание родов. См. ",{"tag":"a","props":{"href":"/ru/book/27"},"children":["пункт 9 раздела 27"]}," (обезболивание родов)."]},"\n",{"tag":"li","props":{},"children":["Без медицинских показаний не просите кесарево сечение. См. ",{"tag":"a","props":{"href":"/ru/book/27"},"children":["пункт 10 раздела 27"]}," (кесарево сечение)."]},"\n",{"tag":"li","props":{},"children":["Если рожать будете вне региона страхования — заранее уточните, нужна ли межрегиональная регистрация по материнству. См. ",{"tag":"a","props":{"href":"/ru/book/27"},"children":["пункт 11 раздела 27"]}," (страхование материнства)."]},"\n",{"tag":"li","props":{},"children":["Декретный отпуск — не меньше 98 дней; до 15 дней можно взять до родов. См. ",{"tag":"a","props":{"href":"/ru/book/18"},"children":["пункт 2 раздела 18"]}," (декретный отпуск)."]},"\n",{"tag":"li","props":{},"children":["Если работодатель снижает оплату или переводит из‑за беременности — сохраняйте письма и переписку. См. ",{"tag":"a","props":{"href":"/ru/book/18"},"children":["пункт 3 раздела 18"]}," (без снижения оплаты из‑за беременности, родов и кормления)."]},"\n",{"tag":"li","props":{},"children":["Сначала одолжите кроватку и коляску; если не одолжат — покупайте б/у. Б/у автокресло и матрас не берите. См. ",{"tag":"a","props":{"href":"/ru/book/20"},"children":["пункт 11 раздела 20"]}," (одолжить, б/у, новое)."]},"\n",{"tag":"li","props":{},"children":["Подгузники попробуйте маленькой упаковкой неделю, потом закупайте. См. ",{"tag":"a","props":{"href":"/ru/book/20"},"children":["пункт 10 раздела 20"]}," (подгузники)."]},"\n",{"tag":"li","props":{},"children":["Имя выберите заранее и проверьте, что система регистрации домохозяйства печатает нужные иероглифы. См. ",{"tag":"a","props":{"href":"/ru/book/27"},"children":["пункт 12 раздела 27"]}," (медицинское свидетельство о рождении)."]},"\n"]},"\n",{"tag":"h2","props":{"id":"iii-в-роддоме"},"children":["III. В роддоме"]},"\n",{"tag":"ol","props":{},"children":["\n",{"tag":"li","props":{},"children":["Если излились воды — лежите на месте, поднимите таз, звоните 120; не ходите. См. ",{"tag":"a","props":{"href":"/ru/book/27"},"children":["пункт 8 раздела 27"]}," (излитие вод)."]},"\n",{"tag":"li","props":{},"children":["Начните грудное вскармливание в первый час после рождения. См. ",{"tag":"a","props":{"href":"/ru/book/20"},"children":["пункт 4 раздела 20"]}," (только грудное вскармливание)."]},"\n",{"tag":"li","props":{},"children":["Первую дозу вакцины против гепатита B — в течение 24 часов. Если у матери положительный HBsAg — одновременно иммуноглобулин против гепатита B. См. ",{"tag":"a","props":{"href":"/ru/book/20"},"children":["пункт 2 раздела 20"]}," (первая доза против гепатита B)."]},"\n",{"tag":"li","props":{},"children":["Сделайте инъекцию витамина K. При домашних или неформальных родах спросите явно. См. ",{"tag":"a","props":{"href":"/ru/book/20"},"children":["пункт 7 раздела 20"]}," (инъекция витамина K)."]},"\n",{"tag":"li","props":{},"children":["Не отказывайтесь от прокола пятки и аудиоскрининга. Перед подписью смотрите, что платное по желанию. См. ",{"tag":"a","props":{"href":"/ru/book/27"},"children":["пункт 13 раздела 27"]}," (прокол пятки и слух)."]},"\n"]},"\n",{"tag":"h2","props":{"id":"iv-до-выписки"},"children":["IV. До выписки"]},"\n",{"tag":"ol","props":{},"children":["\n",{"tag":"li","props":{},"children":["Оформите медицинское свидетельство о рождении; сверьте имена и номера документов родителей и ребёнка по символам. См. ",{"tag":"a","props":{"href":"/ru/book/27"},"children":["пункт 12 раздела 27"]}," (медицинское свидетельство о рождении)."]},"\n",{"tag":"li","props":{},"children":["Оформите ребёнку жительское медстрахование онлайн по свидетельству о рождении; регистрация домохозяйства не нужна. Если неясно — 12393. См. ",{"tag":"a","props":{"href":"/ru/book/27"},"children":["пункт 14 раздела 27"]}," (жительское медстрахование)."]},"\n",{"tag":"li","props":{},"children":["Домой — в автокресле: до года лицом назад; не держите на руках. См. ",{"tag":"a","props":{"href":"/ru/book/01"},"children":["пункт 10 раздела 1"]}," (автокресло)."]},"\n"]},"\n",{"tag":"h2","props":{"id":"v-первый-месяц-после-рождения"},"children":["V. Первый месяц после рождения"]},"\n",{"tag":"ol","props":{},"children":["\n",{"tag":"li","props":{},"children":["Зарегистрируйте рождение в полиции в течение месяца. См. ",{"tag":"a","props":{"href":"/ru/book/27"},"children":["пункт 15 раздела 27"]}," (регистрация рождения)."]},"\n",{"tag":"li","props":{},"children":["После регистрации домохозяйства подайте на субсидию на содержание ребёнка по месту регистрации: 3600 юаней в год на ребёнка. См. ",{"tag":"a","props":{"href":"/ru/book/18"},"children":["пункт 1 раздела 18"]}," (субсидия на содержание ребёнка)."]},"\n",{"tag":"li","props":{},"children":["Укладывайте спать на спину, на твёрдой поверхности, в одной комнате, но не в одной кровати; мягкого постельного белья в кроватке нет. См. ",{"tag":"a","props":{"href":"/ru/book/20"},"children":["пункт 1 раздела 20"]}," (сон на спине)."]},"\n",{"tag":"li","props":{},"children":["Смесь — вода не ниже 70 °C; остатки выливайте. См. ",{"tag":"a","props":{"href":"/ru/book/20"},"children":["пункт 5 раздела 20"]}," (приготовление смеси)."]},"\n",{"tag":"li","props":{},"children":["Ребёнку до трёх месяцев при 38 °C — в больницу. См. ",{"tag":"a","props":{"href":"/ru/book/20"},"children":["пункт 8 раздела 20"]}," (температура 38 °C)."]},"\n",{"tag":"li","props":{},"children":["Если срываетесь — положите малыша в кроватку и отойдите на несколько минут. См. ",{"tag":"a","props":{"href":"/ru/book/20"},"children":["пункт 9 раздела 20"]}," (не трясти ребёнка)."]},"\n",{"tag":"li","props":{},"children":["Список «срочно в больницу» для матери действует ещё год после родов. См. ",{"tag":"a","props":{"href":"/ru/book/27"},"children":["пункт 7 раздела 27"]}," (срочно в больницу)."]},"\n"]},"\n",{"tag":"h2","props":{"id":"vi-от-месяца-до-первого-дня-рождения"},"children":["VI. От месяца до первого дня рождения"]},"\n",{"tag":"ol","props":{},"children":["\n",{"tag":"li","props":{},"children":["На 42-й день после родов — осмотр, в том числе скрининг послеродовой депрессии. См. ",{"tag":"a","props":{"href":"/ru/book/27"},"children":["пункт 16 раздела 27"]}," (визит на 42-й день)."]},"\n",{"tag":"li","props":{},"children":["Следуйте календарю прививок в поликлинике; АКДС — с двух месяцев. См. ",{"tag":"a","props":{"href":"/ru/book/20"},"children":["пункт 3 раздела 20"]}," (национальный календарь прививок)."]},"\n",{"tag":"li","props":{},"children":["Первые шесть месяцев — только грудное молоко; с шести месяцев — прикорм, каждый день продукты животного происхождения с железом. См. ",{"tag":"a","props":{"href":"/ru/book/20"},"children":["пункт 4 раздела 20"]}," (прикорм с шести месяцев)."]},"\n",{"tag":"li","props":{},"children":["Мёд до года не давайте. См. ",{"tag":"a","props":{"href":"/ru/book/20"},"children":["пункт 6 раздела 20"]}," (мёд)."]},"\n",{"tag":"li","props":{},"children":["При тяжёлой экземе или аллергии на яйцо — к врачу, прежде чем решать, вводить ли арахис рано. См. ",{"tag":"a","props":{"href":"/ru/book/20"},"children":["пункт 12 раздела 20"]}," (не избегать арахис полностью)."]},"\n",{"tag":"li","props":{},"children":["Детям до двух лет при простуде не давайте комбинированные противопростудные сами. См. ",{"tag":"a","props":{"href":"/ru/book/34"},"children":["пункт 4 раздела 34"]}," (комбинированные противопростудные)."]},"\n",{"tag":"li","props":{},"children":["Поставьте ограничители на окна и балкон; сетка — не защита от падения. См. ",{"tag":"a","props":{"href":"/ru/book/01"},"children":["пункт 11 раздела 1"]}," (ограничители на окна и балкон)."]},"\n",{"tag":"li","props":{},"children":["Детям 0–3 — без телефонов и планшетов. См. ",{"tag":"a","props":{"href":"/ru/book/30"},"children":["пункт 5 раздела 30"]}," (без экранов)."]},"\n",{"tag":"li","props":{},"children":["После выхода на работу, если ребёнку меньше года — час в день на кормление. См. ",{"tag":"a","props":{"href":"/ru/book/18"},"children":["пункт 3 раздела 18"]}," (час на кормление)."]},"\n",{"tag":"li","props":{},"children":["Подключите семейное использование лицевого счёта медстрахования работника, чтобы ребёнок мог платить за лечение и лекарства. См. ",{"tag":"a","props":{"href":"/ru/book/05"},"children":["пункт 13 раздела 5"]}," (семейное использование счёта)."]},"\n",{"tag":"li","props":{},"children":["При годовом расчёте НДФЛ заявите вычет на уход за детьми до трёх лет. См. ",{"tag":"a","props":{"href":"/ru/book/05"},"children":["пункт 2 раздела 5"]}," (специальные дополнительные вычеты)."]},"\n"]},"\n"]},{"tag":"footer","props":{"className":"life-article-attribution"},"children":[{"tag":"p","props":{},"children":["Статья воспроизведена из открытого проекта HowToLiveBetter с сохранением формулировок и примечаний. Обновления смотрите в исходном репозитории."]},{"tag":"a","props":{"href":"https://github.com/dlgrv/HowToLiveBetter/blob/5a8aac6e715851066661ab6524c3a4e650f7e9d7/docs/research/ru/%D0%A7%D1%82%D0%BE-%D0%BE%D1%84%D0%BE%D1%80%D0%BC%D0%B8%D1%82%D1%8C-%D0%BF%D1%80%D0%B8-%D1%80%D0%BE%D0%B6%D0%B4%D0%B5%D0%BD%D0%B8%D0%B8-%D1%80%D0%B5%D0%B1%D1%91%D0%BD%D0%BA%D0%B0.md","target":"_blank","rel":"noopener noreferrer"},"children":["Открыть исходную версию · 5a8aac6",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"14","height":"14","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]},{"tag":"span","props":{},"children":["Импортировано: 2026-10-11"]},{"tag":"p","props":{},"children":["Ссылки ведут к соответствующим советам в нашей версии; номера в источнике могут отличаться."]}]},{"tag":"div","props":{"className":"life-quick-share"},"children":[{"tag":"button","props":{"type":"button"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-copy","aria-hidden":"true"},"children":[{"tag":"rect","props":{"width":"14","heigh