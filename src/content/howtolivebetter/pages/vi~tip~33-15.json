12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Chia sẻ mẹo này"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Ẩn chi tiết"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Chi phí"]},{"tag":"p","props":{},"children":["Học phí tương tự giấy phép lái xe thường, ở hầu hết các nơi vài nghìn tệ. Xe phải đội lại thành điều khiển bằng tay. Cứ ba năm kiểm tra sức khoẻ một lần."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Lợi ích"]},{"tag":"p","props":{},"children":["Phụ lục 1 của Quy định về việc cấp và sử dụng giấy phép lái xe cơ giới (机动车驾驶证申领和使用规定) viết khá chi tiết về điều kiện thể chất. Mục số 8:「右下肢、双下肢缺失或者丧失运动功能但能够自主坐立，且上肢符合本项第5目规定的，可以申请残疾人专用小型自动挡载客汽车准驾车型的机动车驾驶证。一只手掌缺失，另一只手拇指健全，其他手指有两指健全，上肢和手指运动功能正常，且下肢符合本项第6目规定的，可以申请残疾人专用小型自动挡载客汽车准驾车型的机动车驾驶证」— mất hoặc mất khả năng vận động hai chi dưới bên phải hoặc cả hai, nhưng tự ngồi đứng được, và hai chi trên đáp ứng quy định tại mục năm của cùng mục này, thì có thể xin giấy phép lái xe cơ giới với loại xe được phép lái là ô tô con nhỏ số tự động dành riêng cho người khuyết tật; mất một bàn tay, tay còn lại có ngón cái lành, trong các ngón tay còn lại có hai ngón lành, chức năng vận động của hai chi trên và ngón tay bình thường, và hai chi dưới đáp ứng quy định tại mục sáu của cùng mục này, thì cũng có thể xin loại giấy phép lái xe cơ giới như trên. Mục sáu: chỉ mất hoặc mất khả năng vận động chi dưới bên trái, nhưng chi dưới bên phải bình thường thì có thể xin loại xe ô tô nhỏ số tự động. Về thị lực:「单眼视力障碍，优眼裸视力或者矫正视力达到对数视力表5.0以上，且水平视野达到150度的」— khiếm thị một mắt, thị lực tốt hơn không kính hoặc sau nhiễu đạt từ 5.0 trở lên trên bảng thị lực loga, và tầm nhìn ngang đạt 150 độ, thì có thể xin các loại ô tô nhỏ, ô tô nhỏ số tự động, xe tải chạy chậm, xe ba bánh và ô tô con nhỏ số tự động dành riêng cho người khuyết tật. Về thính giác: người khiếm thính nhưng mang thiết bị trợ thính vẫn xác định được hướng của nguồn âm thanh thì có thể xin loại ô tô nhỏ và ô tô nhỏ số tự động, khi lái phải mang thiết bị trợ thính. Điều tám mươi lăm quy định, giấy chứng minh điều kiện thể chất nộp khi làm thủ tục giấy phép lái ô tô con nhỏ số tự động dành riêng cho người khuyết tật phải do cơ sở y tế chuyên khoa được cơ quan quản lý sức khoẻ cấp tỉnh công nhận cấp. Người có loại xe được phép lái này phải kiểm tra sức khoẻ mỗi ba năm một lần, nộp giấy chứng minh điều kiện thể chất trong vòng ba mươi ngày sau khi hết chu kỳ điểm. Điều bảy mươi tám quy định, khi lái phải đặt đúng quy định biển hiệu dành riêng cho xe cơ giới của người khuyết tật trên thân xe (toàn quốc, Lệnh số 172 của Bộ Công an sửa đổi, có hiệu lực từ ngày 1 tháng 1 năm 2025)"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Nguồn gốc"]},{"tag":"p","props":{"className":"life-citations"},"children":["公安部令第 172 号. 机动车驾驶证申领和使用规定（第七十八条、第八十五条、附件 1）. ",{"tag":"a","props":{"href":"https://www.gov.cn/gongbao/2025/issue_11866/202502/content_7004031.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/gongbao/2025/issue_11866/202502/content_7004031.html"]}]},{"tag":"a","props":{"href":"https://www.gov.cn/gongbao/2025/issue_11866/202502/content_7004031.html","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Liên kết mở nguồn"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Ghi chú sách"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["Loại xe dễ hơn nhiều là xe lăn có động cơ dành cho người khuyết tật. Điều 119 của Luật An toàn giao thông đường bộ xếp loại xe này vào nhóm phương tiện không có động cơ, nên không cần giấy phép lái xe; Điều 58 quy định, xe lăn có động cơ dành cho người khuyết tật khi chạy trong làn xe tự động không được vượt quá tốc độ tối đa mười lăm ki lô mét một giờ. Xe mã C5 phải lắp bước ga và phanh cơ, việc đội xe phải tìm nhà sản xuất có giấy phép, đội xong đi đăng ký đổi thông tin tại cơ quan quản lý phương tiện. Không nộp giấy chứng minh điều kiện thể chất trong vòng một năm sau khi hết ba chu kỳ điểm thì giấy phép lái xe sẽ bị thu hồi."]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Ghi chú của tôi"]},{"tag":"button","props":{"type":"button"},"children":["Viết một lời nhắc cho chính bạn…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/vi/tip/33-14"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Trước"]},"Trẻ khuyết tật xin nhập học, nhà trường không được từ chối; trẻ không đến được trường thì phòng giáo dục sắp xếp giảng viên đến tận nhà"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/vi/tip/33-16"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Tiếp theo"]},"Phục hồi chức năng làm ở cơ sở chính quy có khoa phục hồi chức năng, cường độ nghe người trị liệu, tập càng nặng càng không tốt"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["Thêm trong chủ đề này"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/33-11"},"children":[{"tag":"strong","props":{},"chil