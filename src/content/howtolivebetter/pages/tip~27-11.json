dren":["成本"]},{"tag":"p","props":{"className":"life-citations"},"children":["不花钱。打一次社保或者医保的咨询电话"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["收益"]},{"tag":"p","props":{"className":"life-citations"},"children":["《社会保险法》第五十四条：用人单位已经缴纳生育保险费的，其职工享受生育保险待遇。职工没有工作的配偶，按照国家规定享受生育医疗费用待遇，所需资金从生育保险基金中支付。说白了，单位交了生育保险，职工本人能享受待遇，职工那位没工作的配偶生孩子的医疗费，也能从这笔基金里出。生育保险待遇分两块：一块是生育医疗费用，就是生孩子这件事本身的医疗费；另一块是生育津贴，就是产假期间发给你的那笔钱。第五十六条列明了能领生育津贴的三种情形：女职工生育享受产假、享受计划生育手术休假、法律法规规定的其他情形。生育津贴「按照职工所在用人单位上年度职工月平均工资计发」，算的是你所在单位去年的职工月平均工资，不是你自己的工资"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["来源"]},{"tag":"p","props":{"className":"life-citations"},"children":["全国人大常委会 (2010). 中华人民共和国社会保险法（第五十四、五十六条）. ",{"tag":"a","props":{"href":"https://guangdong.chinatax.gov.cn/gdsw/qysw_gkwj/2020-02/12/content_8e8c485d0db34b989531f3ba57cec5a9.shtml","target":"_blank","rel":"noopener noreferrer"},"children":["https://guangdong.chinatax.gov.cn/gdsw/qysw_gkwj/2020-02/12/content_8e8c485d0db34b989531f3ba57cec5a9.shtml"]},"（国家税务总局广东省税务局转载）"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["原书备注"]},{"tag":"p","props":{"className":"life-citations"},"children":["两件事要提前问清楚，因为事后补不了。一是连续参保的月数够不够：各地都定了最低月数，不够就享受不了。二是不在参保地生的，要不要先办异地生育备案：没备案的可能只能自己先垫钱，回来再手工报销，甚至报不了。产假天数和生育津贴怎么算见第 18 节第 2 条"]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["我的备注"]},{"tag":"button","props":{"type":"button"},"children":["写下对自己有用的提醒…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/tip/27-10"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["上一条"]},"没有医学指征就别主动要求剖宫产，也别为了挑日子开刀"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/tip/27-12"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["下一条"]},"出院前把《出生医学证明》办掉，名字提前想好、别写错字"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["本主题的其他建议"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/27-07"},"children":[{"tag":"strong","props":{},"children":["背下这张「立刻去医院」的清单，孕期和产后一年内都算数"]},{"tag":"span","props":{},"children":["任何一条出现，当天就去医院，别在家等一晚。头痛不好或越来越重、看东西变样、发烧到 38 ℃。手或脸肿得厉害、喘不上气、胸痛或心跳快。肚子剧痛不缓解、胎动停了或明…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/27-08"},"children":[{"tag":"strong","props":{},"children":["破水了就地平躺、垫高臀部、打 120，不要走动也不要洗澡"]},{"tag":"span","props":{},"children":["破水了不是慢慢收拾东西再出发。正确做法是就地躺下、把屁股垫高、打 120。站着走动，羊水流得更快，脐带可能跟着被冲下来。那是能要孩子命的急症。"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/27-09"},"children":[{"tag":"strong","props":{},"children":["想要无痛分娩就直接说，它不增加剖宫产的风险"]},{"tag":"span","props":{},"children":["无痛分娩就是在腰上打一针麻药，把生孩子的疼压下去。它比别的止疼办法更管用，也不会让你更可能挨一刀。「打了无痛腰疼一辈子」同样没有依据。现在它有了单独的收费项目，…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/27-13"},"children":[{"tag":"strong","props":{},"children":["新生儿足跟血筛查和听力筛查都别拒绝"]},{"tag":"span","props":{},"children":["扎一次足跟血、做一次听力测试，能在孩子看起来完全正常的时候，查出甲减、苯丙酮尿症和听力障碍。等症状显出来，智力上的损害已经补不回来了。"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/27-14"},"children":[{"tag":"strong","props":{},"children":["拿到出生医学证明就给孩子办居民医保，别等落完户"]},{"tag":"span","props":{},"children":["拿到出生证就能在网上给孩子参保，不用等落户。参上了，出院时的住院费当场就能报。新生儿的住院费不低，参保和没参保差别很大。"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/27-15"},"children":[{"tag":"strong","props":{},"children":["孩子出生后一个月以内去派出所申报出生登记"]},{"tag":"span","props":{},"children":["法律给的是一个月，不是「有空再说」。落户卡着后面的打疫苗、入园、入学和办身份证。越往后拖，要补的材料越多。"]}]}]}]},{"tag":"a","props":{"className":"life-text-link","href":"/book/27"},"children":["阅读整个主题：怀孕和生产：从发现怀孕到出院办证 ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"15","height":"15","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]}]}]}]},{"tag":"aside","props":{"className":"life-ad-space life-ad-space-sponsored","data-ad-placement":"ad_footer","data-ad-group":"reading","data-ad-creative":"read_product","data-ad-ready":"false","aria-label":"广告 · 社区推荐"},"children":[{"tag":"div","props":{"className":"life-ad-space-brand"},"children":[{"tag":"img","props":{"src":"/sites/howtolivebetter/images/shengcai/logo.png","width":"565","height":"144","alt":"生财有术官方 Logo","decoding":"async"},"children":[]}]},{"tag":"div","props":{"className":"life-ad-space-copy"},"children":[{"tag":"span","props":{"className":"life-ad-space-label"},"children":["广告 · 社区推荐"]},{"tag":"strong","props":{},"children":["读过的知识，能不能做成有用的产品？"]},{"tag":"p","props":{},"children":["从电子书、资料到小工具，看看圈友怎样发现需求，把内容变成实际交付。"]}]},{"tag":"div","props":{"clas