 life-ad-layout-toc"},"children":[{"tag":"div","props":{"className":"life-ad-rail","data-dock-active":"false","style":{"top":"94px"}},"children":[{"tag":"div","props":{"className":"life-ad-dock","hidden":true},"children":[{"tag":"aside","props":{"className":"life-ad-space life-ad-space-sponsored life-ad-space-compact","data-ad-placement":"ad_dock","data-ad-group":"reading","data-ad-creative":"read_product","data-ad-ready":"false","aria-label":"Advertisement · Community recommendation"},"children":[{"tag":"button","props":{"type":"button","className":"life-ad-dismiss","aria-label":"Close ad"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-x","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M18 6 6 18"},"children":[]},{"tag":"path","props":{"d":"m6 6 12 12"},"children":[]}]}]},{"tag":"div","props":{"className":"life-ad-space-brand"},"children":[{"tag":"img","props":{"src":"/sites/howtolivebetter/images/shengcai/logo.png","width":"565","height":"144","alt":"Official Shengcai Youshu logo","decoding":"async"},"children":[]}]},{"tag":"div","props":{"className":"life-ad-space-copy"},"children":[{"tag":"span","props":{"className":"life-ad-space-label"},"children":["Advertisement · Community recommendation"]},{"tag":"strong","props":{},"children":["Could what you know become a useful product?"]},{"tag":"p","props":{},"children":["From ebooks to small tools, explore how members spot needs and turn knowledge into something people can use."]}]},{"tag":"div","props":{"className":"life-ad-space-actions"},"children":[{"tag":"a","props":{"className":"life-ad-space-link","href":"/en/shengcaiyoushu?sc_group=reading&sc_creative=read_product&sc_placement=ad_dock"},"children":["Explore the community and examples",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"18","height":"18","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-up-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M7 7h10v10"},"children":[]},{"tag":"path","props":{"d":"M7 17 17 7"},"children":[]}]}]}]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/en/book/05"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"Back to index"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["Don’t waste money"]},{"tag":"div","props":{"data-ad-dock-host":"true"},"children":[]},{"tag":"nav","props":{"aria-label":"Chapter entries"},"children":[{"tag":"a","props":{"href":"/en/tip/05-01"},"children":[{"tag":"span","props":{},"children":["01"]},"Turn off all automatic renewals and switch to manual renewal upon expiry"]},{"tag":"a","props":{"href":"/en/tip/05-02"},"children":[{"tag":"span","props":{},"children":["02"]},"Conduct the annual tax reconciliation from March to June; be sure to include all eligible special deductions"]},{"tag":"a","props":{"href":"/en/tip/05-03"},"children":[{"tag":"span","props":{},"children":["03"]},"Housing provident fund isn’t just for buying a home: it can be used for renting, home renovations, and paying property taxes, effective from September 20, 2026 under new regulations"]},{"tag":"a","props":{"href":"/en/tip/05-04"},"children":[{"tag":"span","props":{},"children":["04"]},"Recalculate your mobile and broadband plans annually: downgrade unused services, and file a complaint if the carrier refuses to comply"]},{"tag":"a","props":{"href":"/en/tip/05-05"},"children":[{"tag":"span","props":{},"children":["05"]},"Not buying lottery tickets"]},{"tag":"a","props":{"href":"/en/tip/05-06"},"children":[{"tag":"span","props":{},"children":["06"]},"Walk away the moment you see “high returns,” “guaranteed returns,” or “sure profits”"]},{"tag":"a","props":{"href":"/en/tip/05-07"},"children":[{"tag":"span","props":{},"children":["07"]},"Avoid making minimum payments on credit cards, and never sign up for installment plans or consumer loans for purchases; if borrowing is unavoidable, first convert the interest rate to an annual percentage rate before comparing options"]},{"tag":"a","props":{"href":"/en/tip/05-08"},"children":[{"tag":"span","props":{},"children":["08"]},"Don’t give streamers tips, don’t make in‑game purchases, and don’t make impulsive buys"]},{"tag":"a","props":{"href":"/en/tip/05-09"},"children":[{"tag":"span","props":{},"children":["09"]},"When kids make in-app purchases or send gifts, parents can demand refunds for large sums spent by kids over eight if they never gave consent"]},{"tag":"a","props":{"href":"/en/tip/05-10"},"children":[{"tag":"span","props":{},"children":["10"]},"Teaching kids one key phrase: anyone who asks them to use a parent’s phone to enter verification codes is a scammer"]},{"tag":"a","props":{"href":"/en/tip/05-11"},"children":[{"tag":"span","props":{},"children":["11"]},"Skipping extended warranties for electronics"]},{"tag":"a","props":{"href":"/en/tip/05-12"},"children":[{"tag":"span","props":{},"children":["12"]},"Prefer generic drugs that have passed consistency evaluation and those selected in centralized procurement"]},{"tag":"a","props":{"href":"/en/tip/05-13"},"children":[{"tag":"span","props":{},"children":["13"]},"Once you set up family medical expense sharing in the yibao app, funds from your individual medical insurance account can be used to pay for your spouse, parents, and children’s medical care and medication"]},{"tag":"a","props":{"href":"/en/tip/05-14"},"children":[{"tag":"span","props":{},"children":["14"]},"Drink boiled tap water instead of routinely ordering large water-dispenser bottles or buying small bottled water"]},{"tag":"a","props":{"href":"/en/tip/05-15"},"children":[{"tag":"span","props":{},"children":["15"]},"Infrequent stock trading"]},{"tag":"a","props":{"href":"/en/tip/05-16"},"children":[{"tag":"span","props":{},"children":["16"]},"Don’t borrow money to invest, avoid leverage, and never buy assets you don’t understand"]},{"tag":"a","props":{"href":"/en/tip/05-17"},"children":[{"tag":"span","props":{},"children":["17"]},"Using broad-market index funds instead of actively managed funds as a long-term core holding (the portion of money you keep invested for years)"]},{"tag":"a","props":{"href":"/en/tip/05-18"},"children":[{"tag":"span","props":{},"children":["18"]},"When picking similar funds, go for those with lower fees"]},{"tag":"a","props":{"href":"/en/tip/05-19"},"children":[{"tag":"span","props":{},"children":["19"]},"Don’t put all your money into one stock, one platform, or one property"]},{"tag":"a","props":{"href":"/en/tip/05-20"},"children":[{"tag":"span","props":{},"children":["20"]},"Individuals paying income tax at a rate of 10% or higher can open a private pension account; up to 12,000 yuan per year can be deducted from taxable income. For those paying no tax or only a 3% rate, opening such an account is not worthwhile"]},{"tag":"a","props":{"href":"/en/tip/05-21"},"children":[{"tag":"span","props":{},"children":["21"]},"Paying for gym visits individually or on short-term plans is only worthwhile if you have a consistent attendance record spanning over a year"]},{"tag":"a","props":{"href":"/en/tip/05-22"},"children":[{"tag":"span","props":{},"children":["22"]},"Sign a written contract before paying a deposit; if a business faces risks, it must stop taking payments, and you have the right to get back any unused balance if it shuts down"]},{"tag":"a","props":{"href":"/en/tip/05-23"},"children":[{"tag":"span","props":{},"children":["23"]},"Implementing a 24-hour cooling-off period for non-essential big-ticket purchases; making full use of the seven-day no-questions-asked return policy for online shopping"]},{"tag":"a","props":{"href":"/en/tip/05-24"},"children":[{"tag":"span","props":{},"children":["24"]},"Don’t fall for “strikethrough prices” or impulse buying during sales"]},{"tag":"a","props":{"href":"/en/tip/05-25"},"children":[{"tag":"span","props":{},"children":["25"]},"It’s better to choose a non‑return insurance plan and treat any “refunds” or dividends as non‑guaranteed benefits"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/en/tip/05-26","data-status":"active"},"children":[{"tag":"span","props":{},"children":["26"]},"Get sufficient third‑party liability coverage: the mandatory insurance limits are uniform nationwide and relatively low, so any excess must be paid out of your own pocket"]},{"tag":"a","props":{"href":"/en/tip/05-27"},"children":[{"tag":"span","props":{},"children":["27"]},"Set aside an emergency fund equal to 3–6 months of living expenses in a readily accessible account"]},{"tag":"a","props":{"href":"/en/tip/05-28"},"children":[{"tag":"span","props":{},"children":["28"]},"Run a quick comparison before paying off your mortgage — don’t rely on gut feeling"]},{"tag":"a","props":{"href":"/en/tip/05-29"},"children":[{"tag":"span","props":{},"children":["29"]},"When shopping online, follow platform rules and laws — not influencers or “positive reviews”"]},{"tag":"a","props":{"href":"/en/tip/05-30"},"children":[{"tag":"span","props":{},"children":["30"]},"If something goes wrong after buying from a livestream, first ask the platform for the seller’s and influencer’s details — they’re required to provide them"]},{"tag":"a","props":{"href":"/en/tip/05-31"},"children":[{"tag":"span","props":{},"children":["31"]},"If you buy unsafe food, you can demand ten times the purchase price as compensation; if the amount is under 1,000 yuan, you’re still entitled to 1,000 yuan"]},{"tag":"a","props":{"href":"/en/tip/05-32"},"children":[{"tag":"span","props":{},"children":["32"]},"Check national inspection reports, 3C certification, and energy labels before buying big-ticket items"]},{"tag":"a","props":{"href":"/en/tip/05-33"},"children":[{"tag":"span","props":{},"children":["33"]},"Bracelets, jade, luxury watches, and collectibles should be judged by “how much you spend” rather than “how much you save”"]},{"tag":"a","props":{"href":"/en/tip/05-34"},"children":[{"tag":"span","props":{},"children":["34"]},"For jewelry and gemstones, only test reports bearing the CMA mark are acceptable; you must also verify the issuing agency on the regulator’s official website"]},{"tag":"a","props":{"href":"/en/tip/05-35"},"children":[{"tag":"span","props":{},"children":["35"]},"Random sales such as blind boxes and gacha games are treated as “money that won’t come back”"]},{"tag":"a","props":{"href":"/en/tip/05-36"},"children":[{"tag":"span","props":{},"children":["36"]},"If you care about what’s in your food, buy pre-packaged products: loose goods at retail counters aren’t legally required to list ingredients"]},{"tag":"a","props":{"href":"/en/tip/05-37"},"children":[{"tag":"span","props":{},"children":["37"]},"Stocks that have lost value should also be sold according to pre‑set rules — don’t try to even out costs by buying more"]},{"tag":"a","props":{"href":"/en/tip/05-38"},"children":[{"tag":"span","props":{},"children":["38"]},"Planning to invest in overseas assets such as U.S. stocks? Use QDII funds or the Hong Kong Stock Connect program — don’t open accounts with foreign brokers, and don’t use your annual foreign exchange quota for buying foreign stocks"]},{"tag":"a","props":{"href":"/en/tip/05-39"},"children":[{"tag":"span","props":{},"children":["39"]},"Only buy insurance for losses your savings can’t cover; use an emergency fund for losses you can afford"]},{"tag":"a","props":{"href":"/en/tip/05-40"},"children":[{"tag":"span","props":{},"children":["40"]},"If someone at home depends on your income, buy term life insurance for the breadwinner first — not for your kids"]},{"tag":"a","props":{"href":"/en/tip/05-41"},"children":[{"tag":"span","props":{},"children":["41"]},"Regretting a personal insurance policy signed for over a year? You can cancel it during the cooling-off period and get most of your premium back"]},{"tag":"a","props":{"href":"/en/tip/05-42"},"children":[{"tag":"span","props":{},"children":["42"]},"Before signing at the bank counter, check whether it’s a deposit or insurance"]},{"tag":"a","props":{"href":"/en/tip/05-43"},"children":[{"tag":"span","props":{},"children":["43"]},"To cancel your insurance policy, contact the insurer directly — don’t use “policy cancellation agents.” If you feel misled, call 12378 for free assistance"]},{"tag":"a","props":{"href":"/en/tip/05-44"},"children":[{"tag":"span","props":{},"children":["44"]},"Writing a specific beneficiary on the policy lets family claim the payout: 5 years for life insurance, 2 years for other policies"]},{"tag":"a","props":{"href":"/en/tip/05-45"},"children":[{"tag":"span","props":{},"children":["45"]},"Do not buy cryptocurrencies such as Bitcoin or Tether, or join others’ investment schemes: trades lack legal protection, and suing will not recover investment losses"]},{"tag":"a","props":{"href":"/en/tip/05-46"},"children":[{"tag":"span","props":{},"children":["46"]},"If you have no employer, pay into China’s employee pension scheme yourself at the lowest contribution tier and first meet the minimum contribution period; even at the lowest tier, it takes about 10 years of pension payments to recover the cost"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"Breadcrumb"},"children":[{"tag":"a","props":{"href":"/en/book"},"children":["Explore the book"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/en/book/05"},"children":["Chapter 5"," ·"," ","Don’t waste money"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"05-26"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["26"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["Evidence"," ","A"]}]},{"tag":"h1","props":{"lang":"en"},"children":["Get sufficient third‑party liability coverage: the mandatory insurance limits are uniform nationwide and relatively low, so any excess must be paid out of your own pocket"]},{"tag":"p","props":{"lang":"en","className":"life-entry-summary"},"children":["When you’re at fault, the mandatory insurance pays out only up to three specific limits: 180,000 yuan for death or disability, 18,000 yuan for medical expenses, and 2,000 yuan for property damage. These amounts cannot be combined or transferred between categories. Compensation for injuries often exceeds these caps, and any shortfall must be paid by you personally; therefore, it’s essential to purchase enough commercial third‑party coverage."]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Cost"]},{"tag":"p","props":{},"children":["Commercial third‑party liability insurance costs a few hun…"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Benefit"]},{"tag":"p","props":{},"children":["Nationwide, mandatory insurance enforces uniform liability limits. These limits are calculated separately for…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"Mark: Get sufficient third‑party liability coverage: the mandatory insurance limits are uniform nationwide and relatively low, so any excess must be paid out of your own pocket"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"Done"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"Plan to do"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"Save"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Share this tip"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Hide details"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Cost"]},{"tag":"p","props":{},"children":["Commercial third‑party liability insurance costs a few hundred to a few thousand yuan per year. The higher the coverage amount you choose, the cheaper the premium becomes per unit of coverage."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Benefit"]},{"tag":"p","props":{},"children":["Nationwide, mandatory insurance enforces uniform liability limits. These limits are calculated separately for four categories: death or disability, medical costs, property damage, and compensation payable when you’re not at fault. Following the 2020 overhaul of auto insurance, the total maximum payout is now 200,000 yuan, broken down as 180,000 yuan for death/disability, 18,000 yuan for medical costs, and 2,000 yuan for property damage. When you’re not liable, the limits drop to 18,000 yuan for death/disability, 1,800 yuan for medical costs, and 100 yuan for property damage. Any amount above these caps must be borne by the responsible party; drivers lacking mandatory coverage face vehicle impoundment and a fine equal to twice the unpaid premium."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Original sources"]},{"tag":"p","props":{"className":"life-citations"},"children":["国务院 (2006, 2012 修订). 机动车交通事故责任强制保险条例（国务院令第 462 号，第 618 号令修改）第二十三条：「机动车交通事故责任强制保险在全国范围内实行统一的责任限额。责任限额分为死亡伤残赔偿限额、医疗费用赔偿限额、财产损失赔偿限额以及被保险人在道路交通事故中无责任的赔偿限额。」「责任限额由保监会会同国务院公安部门、国务院卫生主管部门、国务院农业主管部门规定。」第二十一条限额内赔偿；第三十九条未投保的「由公安机关交通管理部门扣留机动车……处依照规定投保最低责任限额应缴纳的保险费的2倍罚款」. ",{"tag":"a","props":{"href":"http://www.gov.cn/gongbao/content/2012/content_2131962.htm","target":"_blank","rel":"noopener noreferrer"},"children":["http://www.gov.cn/gongbao/content/2012/content_2131962.htm"]},"；中国银行保险监督管理委员会 (2020). 关于实施车险综合改革的指导意见（银保监发〔2020〕41 号，四（四）：「将交强险总责任限额从12.2万元提高到20万元，其中死亡伤残赔偿限额从11万元提高到18万元，医疗费用赔偿限额从1万元提高到1.8万元，财产损失赔偿限额维持0.2万元不变」）. ",{"tag":"a","props":{"href":"https://www.gov.cn/gongbao/content/2020/content_5567758.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/gongbao/content/2020/content_5567758.htm"]},"（国务院公报）"]},{"tag":"a","props":{"href":"http://www.gov.cn/gongbao/content/2012/content_2131962.htm","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Open source link"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Book note"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["These limits are set by financial regulators and may be adjusted over time. The figures cited reflect current values after the September 2020 reforms; it’s advisable to verify them before purchasing a policy. Crucially, mandatory insurance pays out per category separately — unused portions cannot be applied toward other categories. Compensation claims often surpass these caps, leaving drivers personally liable for the remainder. While this guide does not prescribe an exact coverage amount, it highlights how a modest additional outlay can safeguard you against a scenario with low probability yet potentially devastating financial impact."]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["My note"]},{"tag":"button","props":{"type":"button"},"children":["Write a reminder for yourself…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/en/tip/05-25"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24",