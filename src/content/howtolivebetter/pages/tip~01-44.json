hildren":[{"tag":"span","props":{},"children":["09"]},"开车不超速、不酒驾，不看手机，困了就停车歇"]},{"tag":"a","props":{"href":"/tip/01-10","className":""},"children":[{"tag":"span","props":{},"children":["10"]},"坐车时给 4 岁以下儿童用安全座椅，不要抱在怀里"]},{"tag":"a","props":{"href":"/tip/01-11","className":""},"children":[{"tag":"span","props":{},"children":["11"]},"家里有小孩就给窗户和阳台装限位器，纱窗不算防护"]},{"tag":"a","props":{"href":"/tip/01-12","className":""},"children":[{"tag":"span","props":{},"children":["12"]},"儿童近水不离视线，划船、野泳穿救生衣"]},{"tag":"a","props":{"href":"/tip/01-13","className":""},"children":[{"tag":"span","props":{},"children":["13"]},"60 岁以上练平衡和腿部力量，改造家里的浴室和楼梯"]},{"tag":"a","props":{"href":"/tip/01-14","className":""},"children":[{"tag":"span","props":{},"children":["14"]},"查乙肝两对半，没有抗体就打疫苗"]},{"tag":"a","props":{"href":"/tip/01-15","className":""},"children":[{"tag":"span","props":{},"children":["15"]},"被铁钉、木刺扎到或者伤口沾了泥土，当天去处理，顺便问破伤风要不要打"]},{"tag":"a","props":{"href":"/tip/01-16","className":""},"children":[{"tag":"span","props":{},"children":["16"]},"女性接种 HPV 疫苗，越早越好"]},{"tag":"a","props":{"href":"/tip/01-17","className":""},"children":[{"tag":"span","props":{},"children":["17"]},"女性 40 岁起做乳腺癌筛查，每两年一次钼靶"]},{"tag":"a","props":{"href":"/tip/01-18","className":""},"children":[{"tag":"span","props":{},"children":["18"]},"30 岁以上女性做宫颈癌筛查，优先 HPV 检测"]},{"tag":"a","props":{"href":"/tip/01-19","className":""},"children":[{"tag":"span","props":{},"children":["19"]},"45 到 50 岁起做结直肠癌筛查，做查大便隐血的粪便免疫化学检测或者肠镜"]},{"tag":"a","props":{"href":"/tip/01-20","className":""},"children":[{"tag":"span","props":{},"children":["20"]},"有心血管病的人和老年人每年打流感疫苗"]},{"tag":"a","props":{"href":"/tip/01-21","className":""},"children":[{"tag":"span","props":{},"children":["21"]},"50 岁以后打带状疱疹疫苗"]},{"tag":"a","props":{"href":"/tip/01-22","className":""},"children":[{"tag":"span","props":{},"children":["22"]},"65 岁以上打肺炎球菌疫苗"]},{"tag":"a","props":{"href":"/tip/01-23","className":""},"children":[{"tag":"span","props":{},"children":["23"]},"查幽门螺杆菌，阳性就根除"]},{"tag":"a","props":{"href":"/tip/01-24","className":""},"children":[{"tag":"span","props":{},"children":["24"]},"重度吸烟者每年做一次低剂量胸部 CT"]},{"tag":"a","props":{"href":"/tip/01-25","className":""},"children":[{"tag":"span","props":{},"children":["25"]},"抑郁或有自杀念头时打 12356，家里不囤安眠药和农药"]},{"tag":"a","props":{"href":"/tip/01-26","className":""},"children":[{"tag":"span","props":{},"children":["26"]},"备齐灭火器、灭火毯、逃生呼吸面罩和急救包，每年检查一次"]},{"tag":"a","props":{"href":"/tip/01-27","className":""},"children":[{"tag":"span","props":{},"children":["27"]},"尿里出现肉眼看得见的血，哪怕不疼、哪怕第二天就干净了，也要去查一次"]},{"tag":"a","props":{"href":"/tip/01-28","className":""},"children":[{"tag":"span","props":{},"children":["28"]},"勃起功能出了问题，先去查心血管，别当成单纯的「那方面的事」"]},{"tag":"a","props":{"href":"/tip/01-29","className":""},"children":[{"tag":"span","props":{},"children":["29"]},"减重、戒烟、把血压血糖控住，勃起功能能跟着好转"]},{"tag":"a","props":{"href":"/tip/01-30","className":""},"children":[{"tag":"span","props":{},"children":["30"]},"性行为全程用安全套，不和别人共用针具"]},{"tag":"a","props":{"href":"/tip/01-31","className":""},"children":[{"tag":"span","props":{},"children":["31"]},"有过高危行为就去查一次艾滋病，疾控中心免费、结果保密"]},{"tag":"a","props":{"href":"/tip/01-32","className":""},"children":[{"tag":"span","props":{},"children":["32"]},"自杀念头一冒出来先告诉身边的一个人，把这几十分钟交出去"]},{"tag":"a","props":{"href":"/tip/01-33","className":""},"children":[{"tag":"span","props":{},"children":["33"]},"别把「救回来」当成兜底：喝农药、吸煤气之后急诊能保住的是命，可能保不住肺和脑子"]},{"tag":"a","props":{"href":"/tip/01-34","className":""},"children":[{"tag":"span","props":{},"children":["34"]},"别拿「躺几天就好」赌高处坠落：进了创伤 ICU 的人多数活下来，代价按年算"]},{"tag":"a","props":{"href":"/tip/01-35","className":""},"children":[{"tag":"span","props":{},"children":["35"]},"别拿「少一个肾没什么」换钱：剩下那个要替两个干活，卖过肾的人事后 86% 说身体变差"]},{"tag":"a","props":{"href":"/tip/01-36","className":""},"children":[{"tag":"span","props":{},"children":["36"]},"不捡、不拆、不卖来路不明的金属件，带三叶草警示标志的离远点"]},{"tag":"a","props":{"href":"/tip/01-37","className":""},"children":[{"tag":"span","props":{},"children":["37"]},"赌到借钱还赌、心情一直低落时，先打 12356，再把银行卡和支付密码交给家人管"]},{"tag":"a","props":{"href":"/tip/01-38","className":""},"children":[{"tag":"span","props":{},"children":["38"]},"有高危性行为的男男性行为者，去艾滋病定点医院问暴露前预防药，按时吃能少感染约七成"]},{"tag":"a","props":{"href":"/tip/01-39","className":""},"children":[{"tag":"span","props":{},"children":["39"]},"65 岁以上的女性去做一次双能 X 线骨密度检查，绝经后有骨质疏松危险因素的不用等到 65 岁"]},{"tag":"a","props":{"href":"/tip/01-40","className":""},"children":[{"tag":"span","props":{},"children":["40"]},"查出骨质疏松，或者轻轻一摔就骨折过，就请医生开抗骨质疏松药并坚持用，别拿补钙代替"]},{"tag":"a","props":{"href":"/tip/01-41","className":""},"children":[{"tag":"span","props":{},"children":["41"]},"上野外冰面前先打孔量厚度，不到 15 厘米别上，河上的冰和冰钓洞边别去"]},{"tag":"a","props":{"href":"/tip/01-42","className":""},"children":[{"tag":"span","props":{},"children":["42"]},"装好护罩、戴上护目镜加面屏再用角磨机，双手握稳，别装木工锯片切木头"]},{"tag":"a","props":{"href":"/tip/01-43","className":""},"children":[{"tag":"span","props":{},"children":["43"]},"直接问身边情绪不对的人「你有没有想过自杀」，问了不会让他更想"]},{"tag":"a","props":{"href":"/tip/01-44","className":"active"},"children":[{"tag":"span","props":{},"children":["44"]},"心慌、心跳乱就去做心电图，查出房颤请医生评估吃抗凝药防中风，别拿阿司匹林代替"]},{"tag":"a","props":{"href":"/tip/01-45","className":""},"children":[{"tag":"span","props":{},"children":["45"]},"成年人查一次丙肝抗体，阳性就再查核酸，确诊了吃 8 到 12 周口服药，绝大多数能治好"]},{"tag":"a","props":{"href":"/tip/01-46","className":""},"children":[{"tag":"span","props":{},"children":["46"]},"下化粪池、窨井、污水池、菜窖地窖、发酵罐之前先打开通风，有人倒在里面别跟着下去，打 119 和 120"]},{"tag":"a","props":{"href":"/tip/01-47","className":""},"children":[{"tag":"span","props":{},"children":["47"]},"45 岁以上，住在胃癌食管癌高发地区、有家族史或幽门螺杆菌阳性的，去做胃镜筛查"]},{"tag":"a","props":{"href":"/tip/01-48","className":""},"children":[{"tag":"span","props":{},"children":["48"]},"泡发的木耳、银耳当顿吃完别过夜，河粉、肠粉这类湿米粉买来当天吃，家里不自制酵米面"]}]}]},{"tag":"div","props":{"className":"life-tip-page","data-tip-locales":"zh"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"当前位置"},"children":[{"tag":"a","props":{"href":"/book"},"children":["阅读全书"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/book/01"},"children":["第 1 章 · 不要早死"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"01-44"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["44"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["证据 A"]}]},{"tag":"h1","props":{"lang":"zh"},"children":["心慌、心跳乱就去做心电图，查出房颤请医生评估吃抗凝药防中风，别拿阿司匹林代替"]},{"tag":"p","props":{"lang":"zh","className":"life-entry-summary"},"children":["房颤是心跳乱成一团，血在心里淤住容易结成血块，冲进脑子就是中风。按医生评估吃抗凝药，中风少约六成，死亡少约三成。阿司匹林这类药只少约两成，代替不了。2014 到 2016 年的调查里，中国高危房颤的人只有 6% 在吃抗凝药。"]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["成本"]},{"tag":"p","props":{},"children":["做一次心电图几十元。华法林很便宜，但要定期抽血调剂量。新型抗凝药不用常抽血，贵一些。难在没有症状也要天天吃，拔牙、做手术前要先告诉医生在吃抗凝药。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["收益"]},{"tag":"p","props":{},"children":["房颤时心房乱颤，血在心房里淤住，容易结成血块。血块冲进脑血管就是中风。最常见的症状是心慌、一活动就累、胸口不舒服，也有约 25% 的人自己说没有症状。做 30 秒以上的单导联心电图，或者 10 秒以上的普通 12 导联心电图，就能确诊。2007 年一篇荟萃分析合并了 29 项随机试验、28044 人…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"标记：心慌、心跳乱就去做心电图，查出房颤请医生评估吃抗凝药防中风，别拿阿司匹林代替"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"已做到"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"加入待做"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"收藏"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"分享这条建议"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"收起详情"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["成本"]},{"tag":"p","props":{"className":"life-citations"},"children":["做一次心电图几十元。华法林很便宜，但要定期抽血调剂量。新型抗凝药不用常抽血，贵一些。难在没有症状也要天天吃，拔牙、做手术前要先告诉医生在吃抗凝药。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["收益"]},{"tag":"p","props":{"className":"life-citations"},"children":["房颤时心房乱颤，血在心房里淤住，容易结成血块。血块冲进脑血管就是中风。最常见的症状是心慌、一活动就累、胸口不舒服，也有约 25% 的人自己说没有症状。做 30 秒以上的单导联心电图，或者 10 秒以上的普通 12 导联心电图，就能确诊。2007 年一篇荟萃分析合并了 29 项随机试验、28044 人。和不吃药比，按剂量调好的华法林让中风少约六成（少 64%，可信范围 49% 到 74%）。阿司匹林这类抗血小板药只少约两成（少 22%，可信范围 6% 到 35%）。两类药直接比，华法林比抗血小板药再少 39%。脑子以外的大出血，每年的绝对增加不超过 0.3%。一篇 Cochrane 综述只看没中过风的 2313 人。华法林让死亡低约三成（OR 0.69，95% CI 0.50 到 0.94）。4 项大试验共 71683 人，比较新型口服抗凝药和华法林。新药让中风和栓塞再少 19%（RR 0.81），死亡少 10%（RR 0.90）。颅内出血少 52%（RR 0.48），但胃肠道出血多 25%（RR 1.25）。阿司匹林代替不了抗凝药。不适合用华法林的 5599 人里，阿哌沙班比阿司匹林让中风和栓塞少 55%（HR 0.45）。大出血每年 1.4% 对 1.2%，看不出差别（HR 1.13，可信范围 0.74 到 1.75）。另一项试验只收 75 岁以上的 973 人。致死致残的中风、颅内出血和动脉栓塞合起来，华法林比阿司匹林少 52%（RR 0.48）。脑子以外的出血每年 1.4% 对 1.6%。中国 2023 年房颤指南用 CHA2DS2-VASc-60 打分。心衰、高血压、糖尿病、血管病、60 到 64 岁、女性各 1 分，65 岁以上、中过风各 2 分。男性 2 分以上、女性 3 分以上，推荐吃口服抗凝药。男性 1 分、女性 2 分的，权衡出血风险和本人意愿后考虑。指南不推荐用抗血小板药预防房颤引起的中风。美国 2023 年指南写明，要不要吃看中风风险，不看房颤是一阵一阵发作还是一直持续。它还写明，出血风险评分不能单独拿来决定不吃，要用来找出能改的出血因素。中国 2014 到 2016 年调查 45 岁以上的人，房颤占 1.8%，约 790 万人。知道自己有房颤的，城市 78.3%，农村只有 35.3%。高危房颤的人里只有 6.0% 在用抗凝药。2020 到 2021 年的全国调查里，查出的房颤有 43.8% 是这次才发现的。以前就确诊的人里，32.1% 在用抗凝药，农村只有 19.8%"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["来源"]},{"tag":"p","props":{"className":"life-citations"},"children":["Hart RG, Pearce LA, Aguilar MI. (2007). Meta-analysis: antithrombotic therapy to prevent stroke in patients who have nonvalvular atrial fibrillation. Annals of Internal Medicine, 146(12), 857-867. ",{"tag":"a","props":{"href":"https://doi.org/10.7326/0003-4819-146-12-200706190-00007","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.7326/0003-4819-146-12-200706190-00007"]},"；Aguilar MI, Hart R. (2005). Oral anticoagulants for preventing stroke in patients with non-valvular atrial fibrillation and no previous history of stroke or transient ischemic attacks. Cochrane Database of Systematic Reviews, (3), CD001927. ",{"tag":"a","props":{"href":"https://doi.org/10.1002/14651858.CD001927.pub2","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1002/14651858.CD001927.pub2"]},"；Ruff CT, Giugliano RP, Braunwald E, et al. (2014). Comparison of the efficacy and safety of new oral anticoagulants with warfarin in patients with atrial fibrillation: a meta-analysis of randomised trials. Lancet, 383(9921), 955-962. ",{"tag":"a","props":{"href":"https://doi.org/10.1016/S0140-6736(13)62343-0","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1016/S0140-6736(13)62343-0"]},"；Connolly SJ, Eikelboom J, Joyner C, et al. (2011). Apixaban in patients with atrial fibrillation. New England Journal of Medicine, 364(9), 806-817. ",{"tag":"a","props":{"href":"https://doi.org/10.1056/NEJMoa1007432","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1056/NEJMoa1007432"]},"；Mant J, Hobbs FD, Fletcher K, et al. (2007). Warfarin versus aspirin for stroke prevention in an elderly community population with atrial fibrillation (the Birmingham Atrial Fibrillation Treatment of the Aged Study, BAFTA): a randomised controlled trial. Lancet, 370(9586), 493-503. ",{"tag":"a","props":{"href":"https://doi.org/10.1016/S0140-6736(07)61233-1","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1016/S0140-6736(07)61233-1"]},"；Ma CS, Wu SL, Liu SW, Han YL, Chinese Society of Cardiology, et al. (2024). Chinese Guidelines for the Diagnosis and Management of Atrial Fibrillation. Journal of Geriatric Cardiology, 21(3), 251-314（中华医学会心血管病学分会等 2023 年《心房颤动诊断和治疗中国指南》的英文版）. ",{"tag":"a","props":{"href":"https://doi.org/10.26599/1671-5411.2024.03.009","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.26599/1671-5411.2024.03.009"]},"；Joglar JA, Chung MK, Armbruster AL, et al. (2024). 2023 ACC/AHA/ACCP/HRS Guideline for the Diagnosis and Management of Atrial Fibrillation. Circulation, 149(1), e1-e156. ",{"tag":"a","props":{"href":"https://doi.org/10.1161/CIR.0000000000001193","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1161/CIR.0000000000001193"]},"；Du X, Guo L, Xia S, et al. (2021). Atrial fibrillation prevalence, awareness and management in a nationwide survey of adults in China. Heart. ",{"tag":"a","props":{"href":"https://doi.org/10.1136/heartjnl-2020-317915","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1136/heartjnl-2020-317915"]},"；Shi S, Tang Y, Zhao Q, et al. (2022). Prevalence and risk of atrial fibrillation in China: A national cross-sectional epidemiological study. Lancet Regional Health – Western Pacific, 23, 100439. ",{"tag":"a","props":{"href":"https://doi.org/10.1016/j.lanwpc.2022.100439","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1016/j.lanwpc.2022.100439"]},"；US Preventive Services Task Force (2022). Screening for Atrial Fibrillation: US Preventive Services Task Force Recommendation Statement. JAMA, 327(4), 360-367. ",{"tag":"a","props":{"href":"https://doi.org/10.1001/jama.2021.23732","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1001/jama.2021.23732"]},"；Svennberg E, Friberg L, Frykman V, et al. (2021). Clinical outcomes in systematic screening for atrial fibrillation (STROKESTOP): a multicentre, parallel group, unmasked, randomised controlled trial. Lancet, 398(10310), 1498-1506. ",{"tag":"a","props":{"href":"https://doi.org/10.1016/S0140-6736(21)01637-8","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1016/S0140-6736(21)01637-8"]},"；Svendsen JH, Diederichsen SZ, Højberg S, et al. (2021). Implantable loop recorder detection of atrial fibrillation to prevent stroke (The LOOP Study): a randomised controlled trial. Lancet, 398(10310), 1507-1516. ",{"tag":"a","props":{"href":"https://doi.org/10.1016/S0140-6736(21)01698-6","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1016/S0140-6736(21)01698-6"]},""]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["原书备注"]},{"tag":"p","props":{"className":"life-citations"},"children":["争议在筛查上，查出房颤后吃抗凝药这点没有争议。没有症状的人要不要专门去查房颤，证据不够。美国预防服务工作组 2022 年的结论是证据不足，判断不了利弊。瑞典请 75 到 76 岁的人做两周心电图，约 7 年后死亡、中风、出血合起来只少 4%，刚够上统计差别。丹麦给 70 到 90 岁的人埋了长期记录心电的小仪器。查出房颤的是 31.8% 对 12.2%，中风却没有少到看得出差别。中国 2023 年指南说，65 岁以上的人看病时，可以考虑顺手摸脉或做心电图。所以有症状的人要去查，65 岁以上的看病时请医生顺便摸一下脉，不必专门买仪器去筛。吃上抗凝药以后，别自己加布洛芬这类止痛药，见第 34 节第 3 条（在吃抗凝药的人吃布洛芬之前先问医生）。药要长期吃，别觉得没事就停，见第 16 节第 1 条（药按医嘱吃满）。高血压也是打分项，见本节第 7 条（量血压）。有房颤的人不必一律戒咖啡，见第 2 节第 26 条（每天喝三到四杯咖啡）。突然嘴歪、一侧没劲，吃没吃药都马上打 120，见第 13 节第 3 条（突然嘴歪、一侧胳膊没劲）。受益人主要是你自己和家里的老人。"]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["我的备注"]},{"tag":"button","props":{"type":"button"},"children":["写下对自己有用的提醒…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/tip/01-43"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["上一条"]},"直接问身边情绪不对的人「你有没有想过自杀」，问了不会让他更想"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/tip/01-45"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["下一条"]},"成年人查一次丙肝抗体，阳性就再查核酸，确诊了吃 8 到 12 周口服药，绝大多数能治好"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["本主题的其他建议"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/01-03"},"children":[{"tag":"strong","props":{},"children":["装烟雾报警器；冬天在室内烧煤、用燃气取暖的再装一氧化碳报警器"]},{"tag":"span","props":{},"children":["一个能正常工作的烟雾报警器，能把住宅火灾里死亡的概率降约六成。美国死了人的住宅火灾，四成起火时人在睡觉。冬天在屋里烧煤或用燃气的，再加一个一氧化碳报警器。中国…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/01-04"},"children":[{"tag":"strong","props":{},"children":["燃气软管和灶具到期就换，不自己改管道，燃气公司上门推销可以直接拒绝"]},{"tag":"span","props":{},"children":["软管和灶具到期就换，这是《城镇燃气管理条例》写明的用户义务。自己改管道、拆燃气表是条例明令禁止的。同一部条例还写了，燃气公司不能要求你买它指定的产品和服务。上门…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/01-05"},"children":[{"tag":"strong","props":{},"children":["不采、不买、不吃野生蘑菇，任何「土办法鉴别」都不成立"]},{"tag":"span","props":{},"children":["光 2025 年一年，中国疾控中心就调查了 828 起蘑菇中毒，2165 人中招，13 人死。那一年还新认出 34 种以前没记录过会毒人的蘑菇。银针试毒、虫子吃…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/01-06"},"children":[{"tag":"strong","props":{},"children":["电动自行车不推进楼道、不进电梯、不在家里充电"]},{"tag":"span","props":{},"children":["在高层住宅的门厅、走道、楼梯间停电动车或者充电，是应急管理部的规章明令禁止的。不改正的，个人罚 500 到 1000 元，做生意的罚 2000 到 10000…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/01-07"},"children":[{"tag":"strong","props":{},"children":["量血压，高了就吃药降到达标"]},{"tag":"span","props":{},"children":["高压每降 10 mmHg，出大的心血管毛病的概率降两成，中风降 27%。心衰降 28%，死亡概率降 13%。中国 35 到 75 岁的人里，44.7% 有高血压…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/01-08"},"children":[{"tag":"strong","props":{},"children":["35 岁以后只要超重，就去查一次空腹血糖，正常也每三年再查"]},{"tag":"span","props":{},"children":["花几十块抽一管血，就能在一点症状都没有的时候查出糖尿病前期。美国官方的筛查建议是：35 到 70 岁、超重或肥胖的人去查。查出来正常的，每三年再查一次。美国按体…"]}]}]}]},{"tag":"a","props":{"className":"life-text-link","href":"/book/01"},"children":["阅读整个主题：不要早死 ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"15","height":"15","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]}]}]},{"tag":"nav","props":{"className":"life-tabbar","aria-label":"主导航"},"children":[{"tag":"a","props":{"className":"","href":"/book"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"21","he