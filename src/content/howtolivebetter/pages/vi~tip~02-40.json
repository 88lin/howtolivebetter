iện"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"Lưu"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Chia sẻ mẹo này"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Ẩn chi tiết"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Chi phí"]},{"tag":"p","props":{},"children":["Đổi chỗ mua thôi, tiền tương đương. Chỉ cần nhìn trên bao bì có số giấy phép sản xuất thực phẩm bắt đầu bằng SC hay không. Chỗ khó là thuyết phục người lớn tuổi quen mua dầu tự ép."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Lợi ích"]},{"tag":"p","props":{},"children":["Aflatoxin là chất gây ung thư nhóm 1 do Cơ quan Quốc tế Nghiên cứu Ung thư xếp, nghĩa là chắc chắn gây ra ung thư, và chủ yếu là ung thư gan. Một nghiên cứu ở Quảng Châu đo aflatoxin B1 trong dầu điều tự ép của các xưởng nhỏ trong giai đoạn 2010 đến 2022. Trung vị là 1.29 μg/kg, nửa mẫu nằm trong khoảng 0.12 đến 6.58. Sau khi địa phương ban hành quy chế quản lý xưởng nhỏ, độc tố trong dầu giảm ngay 2.865 μg/kg, rồi mỗi năm giảm thêm 2.593. Tỷ lệ dân ở khu vực thường ăn dầu tự ép có chức năng gan bất thường giảm theo (PR 0.650, 95% CI 0.469–0.902, khoảng tin cậy), khoảng 35%. Một nghiên cứu ở Quảng Tây theo dõi 1611 phụ nữ có thai, trong đó 81.7% ăn dầu điều tự ép. Người ăn dầu điều tự ép có nguy cơ con cân nặng thấp khi sinh cao hơn khoảng chín phần mười (aOR 1.9, 1.1–3.2), sinh non cao hơn khoảng tám phần mười (aOR 1.8, 1.1–3.0)."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Nguồn gốc"]},{"tag":"p","props":{"className":"life-citations"},"children":["Lei J, Li Y, Wang Y, 等 (2024). The impact of small food workshops management regulations on aflatoxin B1 in home-made peanut oil and the liver function of high-consumption area residents: an interrupted time series study in Guangzhou, China. Frontiers in Public Health, 12. ",{"tag":"a","props":{"href":"https://doi.org/10.3389/fpubh.2024.1484414","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.3389/fpubh.2024.1484414"]},"；Zhong Y, Lu H, Jiang Y, 等 (2024). Effect of homemade peanut oil consumption during pregnancy on low birth weight and preterm birth outcomes: a cohort study in Southwestern China. Global Health Action, 17. ",{"tag":"a","props":{"href":"https://doi.org/10.1080/16549716.2024.2336312","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1080/16549716.2024.2336312"]},"；IARC (2012). Chemical Agents and Related Occupations. IARC Monographs on the Evaluation of Carcinogenic Risks to Humans, Vol 100F. ",{"tag":"a","props":{"href":"https://publications.iarc.fr/123","target":"_blank","rel":"noopener noreferrer"},"children":["https://publications.iarc.fr/123"]},"；国家卫生计生委、国家食品药品监督管理总局 (2017). 食品安全国家标准 食品中真菌毒素限量（GB 2761-2017）"]},{"tag":"a","props":{"href":"https://doi.org/10.3389/fpubh.2024.1484414","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Liên kết mở nguồn"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Ghi chú sách"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["Cả hai nghiên cứu chỉ ghi nhận và theo dõi, không có nhóm đối chứng. Kết quả cuối của nghiên cứu ở Quảng Châu là xét nghiệm chức năng gan, không phải ung thư gan và không phải tử vong. Trung vị độc tố trong dầu tự ép thực ra thấp hơn giới hạn 20 μg/kg mà tiêu chuẩn quốc gia đặt cho dầu điều, rủi ro đến từ việc ăn nhiều năm và từ những lô đơn lẻ cao bất thường. Giới hạn của tiêu chuẩn quốc gia áp dụng cho mọi loại dầu điều, nhưng dầu đóng gói phải qua giấy phép sản xuất và kiểm nghiệm trước khi xuất xưởng, còn xưởng nhỏ thì theo biện pháp quản lý của từng tỉnh và được lấy mẫu kiểm tra ít hơn nhiều. Người hưởng lợi từ mục này chủ yếu là bạn và người ăn cùng bạn."]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Ghi chú của tôi"]},{"tag":"button","props":{"type":"button"},"children":["Viết một lời nhắc cho chính bạn…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/vi/tip/02-39"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Trước"]},"Làm ca đêm càng lâu thì rủi ro tim mạch càng cao, đổi được chỗ thì nên đổi sớm"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/vi/tip/02-41"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Tiếp theo"]},"Nấu ăn bằng dầu thực vật thay cho mỡ lợn và bơ, không cần đổi dầu qua lại vì lý do sức khoẻ, cũng đừng trông chờ dầu hạt lanh bảo vệ tim"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16"