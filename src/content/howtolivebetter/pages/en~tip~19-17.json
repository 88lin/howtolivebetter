{"path":"/en/tip/19-17","title":"When you leave a job, ask the employer for a termination certificate stating contract term, separation date, position, and years of service | HowToLiveBetter","description":"Whether you were dismissed, the contract expired, or you resigned, the employer must give you a termination certificate when you leave and transfer y…","lang":"en","styles":["/sites/howtolivebetter/styles/bca54bebe9c1bd3b.css"],"bodyClass":"font-sans antialiased","nodes":[{"tag":"div","props":{"className":"life-site"},"children":[{"tag":"div","props":{"className":"life-header-slot","aria-hidden":"true"},"children":[]},{"tag":"header","props":{"className":"life-header"},"children":[{"tag":"div","props":{"className":"life-header-inner"},"children":[{"tag":"a","props":{"className":"life-brand","aria-label":"H ✳ HowToLiveBetter home","href":"/en"},"children":[{"tag":"span","props":{"className":"life-brand-mark","aria-hidden":"true"},"children":["H",{"tag":"span","props":{},"children":["✳"]}]},{"tag":"span","props":{},"children":["HowToLive",{"tag":"span","props":{},"children":["Better"]}]}]},{"tag":"nav","props":{"className":"life-nav","aria-label":"Main navigation"},"children":[{"tag":"a","props":{"className":"life-nav-link","href":"/en/book"},"children":[{"tag":"span","props":{},"children":["Explore the book"]}]},{"tag":"a","props":{"className":"life-nav-link","href":"/en/top-50"},"children":[{"tag":"span","props":{},"children":["Top 50"]}]},{"tag":"a","props":{"className":"life-nav-link","href":"/en/daily"},"children":[{"tag":"span","props":{},"children":["Daily task"]}]},{"tag":"a","props":{"className":"life-nav-link","href":"/en/dashboard"},"children":[{"tag":"span","props":{},"children":["My checklist"]}]},{"tag":"button","props":{"type":"button","className":"life-nav-link life-nav-more","aria-haspopup":"menu","aria-expanded":"false"},"children":[{"tag":"span","props":{},"children":["More"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"15