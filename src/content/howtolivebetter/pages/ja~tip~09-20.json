:"life-back-link","href":"/ja/book/09"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"目次に戻る"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["一般人が陥りやすい法律のレッドライン"]},{"tag":"div","props":{"data-ad-dock-host":"true"},"children":[]},{"tag":"nav","props":{"aria-label":"この章のヒント"},"children":[{"tag":"a","props":{"href":"/ja/tip/09-01"},"children":[{"tag":"span","props":{},"children":["01"]},"グループ内で、真偽不明の災害、疫病、事件に関する情報を転送しないこと。画像の加工や、AIによる現場画像の捏造を行わないこと"]},{"tag":"a","props":{"href":"/ja/tip/09-02"},"children":[{"tag":"span","props":{},"children":["02"]},"英烈を侮辱する画像、絵文字、コメントを投稿・転送しないこと。国旗や国歌をネタにしないこと。"]},{"tag":"a","props":{"href":"/ja/tip/09-03"},"children":[{"tag":"span","props":{},"children":["03"]},"海外サイトの内容は見た後に閉じるだけ。スクリーンショットも、転送も、グループへの持ち込みも、コメント欄での追随もせず。"]},{"tag":"a","props":{"href":"/ja/tip/09-04"},"children":[{"tag":"span","props":{},"children":["04"]},"アダルト動画は個人で楽しむ分には自由ですが、グループ内に投稿したり、「素材」を販売したり、グループを作成したりしないでください。"]},{"tag":"a","props":{"href":"/ja/tip/09-05"},"children":[{"tag":"span","props":{},"children":["05"]},"「副業」として自分のカードで入金、出金、送金を行うよう指示される案件、どんなに報酬が高くても断ること"]},{"tag":"a","props":{"href":"/ja/tip/09-06"},"children":[{"tag":"span","props":{},"children":["06"]},"「融資書類の偽造」を勧誘し、融資額に応じたキックバックを提示する者がいても、一切応じないこと"]},{"tag":"a","props":{"href":"/ja/tip/09-07"},"children":[{"tag":"span","props":{},"children":["07"]},"拾得銀行カードをそのままにせず、携帯電話や財布を拾った際は持ち去らず、持ち主に連絡するか警察に届ける"]},{"tag":"a","props":{"href":"/ja/tip/09-08"},"children":[{"tag":"span","props":{},"children":["08"]},"特典は自身の真の身分で受け取る。仮想番号による大量のサブアカウント登録や、脆弱性を利用した繰り返し取得は行わない"]},{"tag":"a","props":{"href":"/ja/tip/09-09"},"children":[{"tag":"span","props":{},"children":["09"]},"バルコニーや窓からいかなる物も投げ出さない。吸い殻、ゴミ袋、酒瓶もすべて対象"]},{"tag":"a","props":{"href":"/ja/tip/09-10"},"children":[{"tag":"span","props":{},"children":["10"]},"模造銃、鋼鉄玉銃、エアガンをネットで購入しない、出所不明の「おもちゃの銃」を買わない"]},{"tag":"a","props":{"href":"/ja/tip/09-11"},"children":[{"tag":"span","props":{},"children":["11"]},"ドローンを購入したらまず実名登録を行う。空港、軍事区域、および都市の規制空域では飛行させない。高度制限の解除（ハッキング）は行わない"]},{"tag":"a","props":{"href":"/ja/tip/09-12"},"children":[{"tag":"span","props":{},"children":["12"]},"他人の盗撮をしない。賃貸物件、民泊、ホテルの客室にカメラを設置しない"]},{"tag":"a","props":{"href":"/ja/tip/09-13"},"children":[{"tag":"span","props":{},"children":["13"]},"麻雀やポーカーは可能ですが、手数料を取らない、胴元にならない、場を設けて集金しない、オンラインギャンブルは行わないこと"]},{"tag":"a","props":{"href":"/ja/tip/09-14"},"children":[{"tag":"span","props":{},"children":["14"]},"野生動物を食べない、売買しない、保護動物をペットとして飼育しない"]},{"tag":"a","props":{"href":"/ja/tip/09-15"},"children":[{"tag":"span","props":{},"children":["15"]},"債権回収において、人を拘束したり、監禁したり、相手の自宅まで押しかけて居座ったりしてはいけない"]},{"tag":"a","props":{"href":"/ja/tip/09-16"},"children":[{"tag":"span","props":{},"children":["16"]},"身分証は貸さない、他人の身分証を使わない、他人の身分証で登録・カード作成・チケット購入を行わない"]},{"tag":"a","props":{"href":"/ja/tip/09-17"},"children":[{"tag":"span","props":{},"children":["17"]},"警察に止められたり連行されたりした際は協力すること。押し返さない、殴らない、执法記録カメラを奪わない。飲酒している時はなおさら自制が必要。"]},{"tag":"a","props":{"href":"/ja/tip/09-18"},"children":[{"tag":"span","props":{},"children":["18"]},"相手が 14 歳未満の場合、性交渉は成立しません。「本人の同意」は理由になりません"]},{"tag":"a","props":{"href":"/ja/tip/09-19"},"children":[{"tag":"span","props":{},"children":["19"]},"手を出して人を殴る前に、この代償を計算しておくこと：拘留、賠償、刑罰"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/ja/tip/09-20","data-status":"active"},"children":[{"tag":"span","props":{},"children":["20"]},"子供を育てられない場合、民政局への登録という唯一の合法的な道があります：金銭を受け取って子供を渡すと人身売買罪に問われる可能性があり、放置すれば遺棄罪になります"]},{"tag":"a","props":{"href":"/ja/tip/09-21"},"children":[{"tag":"span","props":{},"children":["21"]},"事故を捏造せず、損失を誇張して保険金を騙し取らないこと：これは保険詐欺罪です。証言、修理、鑑定を手伝った人も共犯となります"]},{"tag":"a","props":{"href":"/ja/tip/09-22"},"children":[{"tag":"span","props":{},"children":["22"]},"自分の臓器を売らない、他人のドナー探しを手伝わない：腎臓が手元に残るのは 2 万強、同じものが転売されると 20 万、売得金は没収され、さらに取引額の 10 倍から 20 倍の罰金が科される"]},{"tag":"a","props":{"href":"/ja/tip/09-23"},"children":[{"tag":"span","props":{},"children":["23"]},"売春をしない：標準的な罰則は 10 日から 15 日の拘留であり、単なる罰金では済みません"]},{"tag":"a","props":{"href":"/ja/tip/09-24"},"children":[{"tag":"span","props":{},"children":["24"]},"漫画の中国語化、映画・ドラマの無断転載、クラウドストレージ資源の共有、海賊版電子書籍の配布は、無償であっても著作権侵害。広告掲載や会員費の徴収があれば、刑事罰の対象となる可能性あり"]},{"tag":"a","props":{"href":"/ja/tip/09-25"},"children":[{"tag":"span","props":{},"children":["25"]},"二次創作を出版・販売する場合は、まず原作者の許諾を得るか、借りたキャラクター名や関係性を自分のものに書き換える"]},{"tag":"a","props":{"href":"/ja/tip/09-26"},"children":[{"tag":"span","props":{},"children":["26"]},"護身のため伸縮警棒、電撃器、短剣、催涙スプレーを買って携帯しない。車内に置くのも携帯に当たる"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"現在地"},"children":[{"tag":"a","props":{"href":"/ja/book"},"children":["本を読む"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/ja/book/09"},"children":["第9章"," ·"," ","一般人が陥りやすい法律のレッドライン"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"09-20"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["20"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["エビデンス"," ","A"]}]},{"tag":"h1","props":{"lang":"ja"},"children":["子供を育てられない場合、民政局への登録という唯一の合法的な道があります：金銭を受け取って子供を渡すと人身売買罪に問われる可能性があり、放置すれば遺棄罪になります"]},{"tag":"p","props":{"lang":"ja","className":"life-entry-summary"},"children":["育てられない場合の道はありますが、合法的なのは一つだけです。民政部門で養子縁組登録を行うことで、養子縁組関係は登録した日から成立します。私的に子供を他人に渡すこと、特に金銭を受け取った場合は、「譲渡」が児童人身売渡罪へと性質が変わる可能性があり、その法定刑は 5 年以上です。子供を放置し、養育を拒否する行為が、悪質な場合は遺棄罪となり、5 年以下の判決となります。"]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["費用・手間"]},{"tag":"p","props":{},"children":["費用はかかりません。県級以上の民政部門で養子縁組登録を行う必要があり、書類の提出、審査、および養子縁組評価を待つ必要…"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["効果"]},{"tag":"p","props":{},"children":["刑法第240条：「婦人または児童を拐売した者は、5年以上の10年以下の有期懲役に処し、あわせて罰金を科す」。"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"記録する：子供を育てられない場合、民政局への登録という唯一の合法的な道があります：金銭を受け取って子供を渡すと人身売買罪に問われる可能性があり、放置すれば遺棄罪になります"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"できている"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"やることに追加"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"お気に入り"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"このヒントを共有"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"詳細を閉じる"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["費用・手間"]},{"tag":"p","props":{},"children":["費用はかかりません。県級以上の民政部門で養子縁組登録を行う必要があり、書類の提出、審査、および養子縁組評価を待つ必要があるため、多少の時間はかかります。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["効果"]},{"tag":"p","props":{},"children":["刑法第240条：「婦人または児童を拐売した者は、5年以上の10年以下の有期懲役に処し、あわせて罰金を科す」。加重事由がある場合は、10年以上の有期懲役または無期懲役に処し、あわせて罰金を科すか、または財産を没収する。「情状が特に重い場合は、死刑に処し、あわせて財産を没収する」。『婦人および児童の拐売犯罪を依法懲らしめることに関する意見』第 17 条では、実子を売ることと民間での養子縁組をどのように区別するかについて述べている。判断基準は「行為者に不法な利益を得る目的があるかどうかが鍵である」という点である。つまり、この件を通じて金銭を得ようとする意図があるかどうかを見る。実子を売ったと認定され、婦人・児童拐売罪として処罰される可能性があるのは、以下の3つのケースである。第一のケースは、「出産を不法な利益を得るための手段とし、出産後すぐに児童を売却する場合」である。二つ目は、「相手に養育の意思がないことを知りながら、あるいは相手に養育の意思があるかどうかを全く考慮せず、金銭を受け取るために子供を他人に『譲渡』する場合」です。三つ目は、「明らかに『養育費』や『謝礼』の範囲を超えた多額の金銭を受け取るために、子供を他人に『譲渡』する場合」です。逆に、金銭目的ではなく、真に生活の困窮からやむを得ず私的に養子に出した場合や、少額の養育費や謝礼を受け取るのみである場合は、民間の養子縁組に該当し、人身売買罪（拐売罪）として処罰されることはありません。次に、刑法第261条を見てみましょう。「高齢者、幼年者、病者、またはその他の自立した生活能力のない者に対し、扶養義務があるにもかなく扶養を拒否し、その情状が極めて悪質な場合は、5年以下の有期懲役、拘役、または禁錮に処する」。民法典第1094条は、養親になれるのは以下の3種類に限られると規定しています：孤児の後見人、児童福祉機関、および特別な困難があり子供を養育する能力のない実父母です。第1105条：「養子縁組は、県級以上の人民政府民政部門に登記しなければならない。養子縁組関係は、登記の日から成立する」"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["出典"]},{"tag":"p","props":{"className":"life-citations"},"children":["全国人大 (1997). 刑法（第二百四十、二百六十一条）. ",{"tag":"a","props":{"href":"https://www.spp.gov.cn/spp/fl/201802/t20180206_364975.shtml","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.spp.gov.cn/spp/fl/201802/t20180206_364975.shtml"]},"；最高人民法院、最高人民检察院、公安部、司法部 (2010). 关于依法惩治拐卖妇女儿童犯罪的意见（法发〔2010〕7 号，第 17 条）. 最高人民法院官网 ",{"tag":"a","props":{"href":"https://www.court.gov.cn/fabu/xiangqing/977.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.court.gov.cn/fabu/xiangqing/977.html"]},"；全国人大 (2020). 民法典（第一千零九十四、一千一百零五条）. 盐城市人民政府转载收养编全文 ",{"tag":"a","props":{"href":"https://xxgk.yczf.gov.cn/xzf/ycmzj/fdzdgknr/fgwj_41995/202112/t20211203_1506640.shtml","target":"_blank","rel":"noopener noreferrer"},"children":["https://xxgk.yczf.gov.cn/xzf/ycmzj/fdzdgknr/fgwj_41995/202112/t20211203_1506640.shtml"]}]},{"tag":"a","props":{"href":"https://www.spp.gov.cn/spp/fl/201802/t20180206_364975.shtml","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["出典を開く"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["著者の注記"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["産むか否かについてはここでは触れません。子供が生まれた後は、この手順に従うのが最も手間がかかりません。第一歩は、病院で出産することです。妊婦健診と入院分娩については第 27 節を参照してください。出生医学証明書は、その後のすべての手続きの前提となります。第二歩、譲渡したい場合は、仲介人を介さず、直接、県級以上の民政部門に相談してください。一度でも金銭が介在すると、性質が変わる可能性があります。産後一年以内に「自分自身や子供を傷つけたいという考え」が生じた場合は、救急として対応してください。妊娠中および産後に直ちに病院へ行くべきリストについては、第 27 節第 7 条を参照してください。産後 42 日の再診は、産後うつ病のスクリーニングも兼ねています。詳細は第 27 節第 16 条を参照してください。自殺の念慮がある場合は 12356 に電話してください。詳細は第 1 節第 25 条を参照してください。本条には事例は付随していません：実子の人身売買に関する公式な典型事例について、本ラウンドでは個別の照合を行っていないため、条文と意見の原文のみを引用しています。"]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["自分のメモ"]},{"tag":"button","props":{"type":"button"},"children":["自分へのメモを書く…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/ja/tip/09-19"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["前へ"]},"手を出して人を殴る前に、この代償を計算しておくこと：拘留、賠償、刑罰"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/ja/tip/09-21"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["次へ"]},"事故を捏造せず、損失を誇張して保険金を騙し取らないこと：これは保険詐欺罪です。証言、修理、鑑定を手伝った人も共犯となります"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["このテーマの他の提案"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/09-16"},"children":[{"tag":"strong","props":{},"children":["身分証は貸さない、他人の身分証を使わない、他人の身分証で登録・カード作成・チケット購入を行わない"]},{"tag":"span","props":{},"children":["身分証を他人に貸したり、レンタルしたり、譲渡したりした場合、警告および 200 元以下の罰金に処されます。他人の身分証を冒用した場合、また…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/09-17"},"children":[{"tag":"strong","props":{},"children":["警察に止められたり連行されたりした際は協力すること。押し返さない、殴らない、执法記録カメラを奪わない。飲酒している時はなおさら自制が必要。"]},{"tag":"span","props":{},"children":["現場での執行妨害は、警告または 50