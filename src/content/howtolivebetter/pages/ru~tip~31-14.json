troke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-up-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M7 7h10v10"},"children":[]},{"tag":"path","props":{"d":"M7 17 17 7"},"children":[]}]}]}]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/ru/book/31"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"К содержанию"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["Какие пути открываются после 18 лет"]},{"tag":"div","props":{"data-ad-dock-host":"true"},"children":[]},{"tag":"nav","props":{"aria-label":"Советы главы"},"children":[{"tag":"a","props":{"href":"/ru/tip/31-01"},"children":[{"tag":"span","props":{},"children":["01"]},"Сначала сверьте требования: возрастные и образовательные критерии для двенадцати вариантов карьерного пути чётко прописаны в документах"]},{"tag":"a","props":{"href":"/ru/tip/31-02"},"children":[{"tag":"span","props":{},"children":["02"]},"Мужчины, которым исполнилось 18 лет, должны до 31 октября пройти регистрацию на военную службу; срочная служба длится два года"]},{"tag":"a","props":{"href":"/ru/tip/31-03"},"children":[{"tag":"span","props":{},"children":["03"]},"Отказ от военной службы после подачи заявления влечет серьезные ограничения на два года"]},{"tag":"a","props":{"href":"/ru/tip/31-04"},"children":[{"tag":"span","props":{},"children":["04"]},"Два главных преимущества для студентов, решивших пойти в армию: государство компенсирует до 20 000 юаней в год за обучение, сохраняет за ними право на учёбу на протяжении двух лет и предусматривает отдельную программу поступления в магистратуру"]},{"tag":"a","props":{"href":"/ru/tip/31-05"},"children":[{"tag":"span","props":{},"children":["05"]},"После увольнения с военной службы работу по распределению предоставляют лишь в шести случаях; при самостоятельном трудоустройстве необходимо явиться в органы гражданской администрации в течение 30 дней"]},{"tag":"a","props":{"href":"/ru/tip/31-06"},"children":[{"tag":"span","props":{},"children":["06"]},"Три важных показателя после увольнения: единовременная выплата, зачёт военного стажа и налоговая льгота в 20 000 юаней в год"]},{"tag":"a","props":{"href":"/ru/tip/31-07"},"children":[{"tag":"span","props":{},"children":["07"]},"Не только экзамен на госслужбу — есть и другие пути попасть в систему: после двух лет работы по программе «Три поддержки, один помощник» можно претендовать на 10% вакансий, выделенных специально для участников этой программы"]},{"tag":"a","props":{"href":"/ru/tip/31-08"},"children":[{"tag":"span","props":{},"children":["08"]},"По истечении трёхлетнего срока службы, при успешной аттестации и желании остаться работать, учителя из программы «Специальные рабочие места» должны быть незамедлительно зачислены в штат"]},{"tag":"a","props":{"href":"/ru/tip/31-09"},"children":[{"tag":"span","props":{},"children":["09"]},"Поступление на службу в пожарную охрану и в штат гражданских специалистов Вооружённых сил — ещё два пути открытого набора, причём порог входа здесь ниже, чем при сдаче государственного экзамена"]},{"tag":"a","props":{"href":"/ru/tip/31-10"},"children":[{"tag":"span","props":{},"children":["10"]},"Образование — это не разовое решение: для экзаменов по самообразованию нет ограничений по возрасту и уровню образования; поступить можно также через экзамены для взрослых или в Открытый университет"]},{"tag":"a","props":{"href":"/ru/tip/31-11"},"children":[{"tag":"span","props":{},"children":["11"]},"Отсутствие трудоустройства не означает отсутствие соцстраха: пенсионное и медицинское страхование придётся оформлять самостоятельно в месте работы, ограничения по прописке уже сняты"]},{"tag":"a","props":{"href":"/ru/tip/31-12"},"children":[{"tag":"span","props":{},"children":["12"]},"Для курьеров, водителей такси и грузоперевозчиков платформа сама оплачивает страховку от профессиональных травм за каждый выполненный заказ — вам платить не придётся"]},{"tag":"a","props":{"href":"/ru/tip/31-13"},"children":[{"tag":"span","props":{},"children":["13"]},"Два пути получения государственной должности в день подачи заявлений на поступление в вуз: бесплатное обучение для будущих учителей и для медиков, но за это придётся отработать 6 лет"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/ru/tip/31-14","data-status":"active"},"children":[{"tag":"span","props":{},"children":["14"]},"Прежде чем ехать работать за границу, проверьте, имеет ли компания лицензию на международное трудоустройство: она не вправе требовать от вас залог"]},{"tag":"a","props":{"href":"/ru/tip/31-15"},"children":[{"tag":"span","props":{},"children":["15"]},"Работа на иностранную компанию из дома: такие доходы считаются внутренними по налоговому законодательству. Налог нужно декларировать самостоятельно, а перевод средств следует оформлять как «оплату труда сотрудника»"]},{"tag":"a","props":{"href":"/ru/tip/31-16"},"children":[{"tag":"span","props":{},"children":["16"]},"Работа на себя без трудоустройства: для старта нужно сначала изучить кредиты под гарантию государства — личный лимит до 300 тысяч юаней, причём половину процентов оплачивает казна"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"Навигация"},"children":[{"tag":"a","props":{"href":"/ru/book"},"children":["Книга"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/ru/book/31"},"children":["Глава 31"," ·"," ","Какие пути открываются после 18 лет"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"31-14"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["14"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["Доказательства"," ","A"]}]},{"tag":"h1","props":{"lang":"ru"},"children":["Прежде чем ехать работать за границу, проверьте, имеет ли компания лицензию на международное трудоустройство: она не вправе требовать от вас залог"]},{"tag":"p","props":{"lang":"ru","className":"life-entry-summary"},"children":["Закон регулирует не вас, а именно ту компанию, которая организует ваш выезд за границу. Только предприятия, получившие лицензию на международное трудоустройство и зарегистрировавшиеся в установленном порядке, имеют право этим заниматься. Фраза «сначала оформите туристическую визу, а потом поменяйте её на рабочую» сама по себе указывает на нарушение закона. Компания также не вправе требовать от вас залог или какое-либо имущество в качестве гарантии."]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Затраты"]},{"tag":"p","props":{},"children":["Ничего не стоит. Потратьте всего несколько минут перед отъ…"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Польза"]},{"tag":"p","props":{},"children":["Согласно статье 5 «Положения об управлении международным трудоустройством», для занятия этой деятельностью тре…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"Отметить: Прежде чем ехать работать за границу, проверьте, имеет ли компания лицензию на международное трудоустройство: она не вправе требовать от вас залог"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"Сделано"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"В планах"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"В избранное"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Поделиться советом"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Скрыть подробности"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Затраты"]},{"tag":"p","props":{},"children":["Ничего не стоит. Потратьте всего несколько минут перед отъездом, чтобы проверить квалификацию компании и внимательно изучить два договора."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Польза"]},{"tag":"p","props":{},"children":["Согласно статье 5 «Положения об управлении международным трудоустройством», для занятия этой деятельностью требуется разрешение от регионального или городского департамента коммерции — именно эта лицензия и является доказательством квалификации. Статья 7 гласит, что список лицензированных компаний публикуется на сайте Министерства коммерции и сообщается в консульства КНР за рубежом. В статье 8 прямо указано: «Никто не имеет права организовывать трудоустройство за границу под предлогом коммерции, туризма или учебы». Статья 9 обязывает компании в течение 5 рабочих дней после регистрации внести на специальный счёт не менее 3 млн юаней в качестве гарантийного фонда, предназначенного для выплаты компенсаций в случае отказа фирмы платить или невозможности её выплатить. Эти средства также используются для экстренной эвакуации работников при чрезвычайных ситуациях. Статья 11 запрещает отправлять людей на работу в сферы, связанные с азартными играми или проституцией. Статья 12 требует проведения предварительного обучения. Статья 13 обязывает страховать работников от несчастных случаев за границей. Статьи 21 и 23 предписывают заключение отдельных письменных договоров с иностранным работодателем и с самими работниками; без них выезд невозможен. Статья 25 прямо запрещает любые залоги и требования о предоставлении имущества в качестве гарантии. В течение 10 дней после подписания договоров компания обязана зарегистрировать их в департаменте коммерции. Статья 29 гарантирует право работников требовать компенсации в случае нарушения условий договора; статья 31 запрещает отправку людей в страны с нестабильной обстановкой. В статье 37 создаётся система учёта недобросовестных компаний. Статья 39 предусматривает отзыв лицензии и уголовную ответственность за нелегальную деятельность. Статья 40 аннулирует лицензии за использование фиктивных целей выезда, передачу прав другим лицам или привлечение к азартным играм и проституции. Штраф за отсутствие договоров или предоставление ложной информации составляет от 100 до 200 тысяч юаней, а для руководителей — от 20 до 50 тысяч юаней."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Первоисточники"]},{"tag":"p","props":{"className":"life-citations"},"children":["国务院 (2012). 对外劳务合作管理条例（国务院令第 620 号，第五、七、八、九、十、十一、十二、十三、二十一、二十三、二十五、二十六、二十九、三十一、三十七、三十九、四十、四十三条）. ",{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/2012-06/11/content_1091.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/zhengce/zhengceku/2012-06/11/content_1091.htm"]}]},{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/2012-06/11/content_1091.htm","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Открыть источник"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Примечание автора"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["В этом разделе описывается законный порядок трудоустройства за границей. Сначала компания заключает договор с иностранным работодателем, затем — с вами, где прописываются условия труда, зарплата, график, отпуска, соцстрах и риски. В течение 10 дней после этого договоры регистрируются в ведомстве. Компания обязана провести обучение по технике безопасности, языку и местным законам, а также оформить страховку. Если вам отказывают в ознакомлении с договором, требуют залог или настаивают на подписании документов задним числом — это признаки нелегальной фирмы. Информация о мошеннических предложениях высокооплачиваемой работы и телефонный центр помощи 12308 приведены в других разделах. Закон не устанавливает возрастных или образовательных ограничений для работников, но требует, чтобы компания имела соответствующую лицензию, а страна назначения разрешала такой труд. Компания может заключать контракты только с официальными организациями, а не с частными лицами. Гарантийный фонд не предназначен для личного пользования, он выплачивается в случае отказа фирмы выполнять обязательства. В случае проблем следует обращаться в департамент коммерции — именно это предусмотрено статьёй 20. Если в одну страну отправляется более 100 человек, компания обязана назначить сопровождающего менеджера и уведомить консульство; при меньшем числе сотрудников вам самим важно сохранить копии договоров и подтверждения оплаты."]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Моя заметка"]},{"tag":"button","props":{"type":"button"},"children":["Запишите напоминание…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/ru/tip/31-13"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Предыдущий"]},"Два пути получения государственной должности в день подачи заявлений на поступление в вуз: бесплатное обучение для будущих учителей и для медиков, но за это придётся отработать 6 лет"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/ru/tip/31-15"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Следующий"]},"Работа на иностранную компанию из дома: такие доходы считаются внутренними по налоговому законодательству. Налог нужно декларировать самостоятельно, а перевод средств следует оформлять как «оплату труда сотрудника»"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["Другие советы по этой теме"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/31-08"},"children":[{"tag":"strong","props":{},"children":["По истечении трёхлетнего срока службы, при успешной аттестации и желании остаться работать, учителя из программы «Специальные рабочие места» должны быть незамедлительно зачислены в штат"]},{"tag":"span","props":{},"children":["Программа «Специальные рабочие места» — один из немногих путей, где ч…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/31-09"},"children":[{"tag":"strong","props":{},"children":["Поступление на службу в пожарную охрану и в штат гражданских специалистов Вооружённых сил — ещё два пути открытого набора, причём порог входа здесь ниже, чем при сдаче государственного экзамена"]},{"tag":"span","props":{},"children":["Для обоих направлений не требуется образование уровня не ниже среднег…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/31-10"},"children":[{"tag":"strong","props":{},"children":["Образование — это не разовое решение: для экзаменов по самообразованию нет ограничений по возрасту и уровню образования; поступить можно также через экзамены для взрослых или в Открытый университет"]},{"tag":"span","props":{},"children":["Если в восемнадцать лет вы не смогли поступить в вуз, позже остаются …"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/31-11"},"children":[{"tag":"strong","props":{},"children":["Отсутствие трудоустройства не означает отсутствие соцстраха: пенсионное и медицинское страхование придётся оформлять самостоятельно в месте работы, ограничения по прописке уже сняты"]},{"tag":"span","props":{},"children":["Отсутствие трудоустройства не означает, что соцстрахование вам не пол…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/31-12"},"children":[{"tag":"strong","props":{},"children":["Для курьеров, водителей такси и грузоперевозчиков платформа сама оплачивает страховку от профессиональных травм за каждый выполненный заказ — вам платить не придётся"]},{"tag":"span","props":{},"children":["Платформа обязана оплачивать страховку от профессиональных травм за к…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/31-16"},"children":[{"tag":"strong","props":{},"children":["Работа на себя без трудоустройства: для старта нужно сначала изучить кредиты под гарантию государства — личный лимит до 300 тысяч юаней, причём половину процентов оплачивает казна"]},{"tag":"span","props":{},"children":["Если старт бизнеса неизбежно требует займа, стоит рассмотреть именно …"]}]}]}]},{"tag":"a","props":{"className":"life-text-link","href":"/ru/book/31"},"children":["Читать всю тему: Какие пути открываются после 18 лет"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"15","height":"15","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","pr