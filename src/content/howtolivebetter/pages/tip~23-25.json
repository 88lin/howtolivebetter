":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"分享这条建议"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"收起详情"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["成本"]},{"tag":"p","props":{"className":"life-citations"},"children":["不花钱。去目标单位的招聘公告里查一遍学历要求，再找两三个在读博士聊一次。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["收益"]},{"tag":"p","props":{"className":"life-citations"},"children":["本节第 24 条（读硕士）引的英国教育部 2020 年研究，也算了博士。原文是「8% (women) and -9% (men) for PhDs」：扣掉家庭背景和本科成绩的差别后，35 岁时博士比只读本科的女性多挣约 8%，男性少挣约 9%。研究还发现，博士降低了失业和年收入低于 3 万英镑的可能，也降低了年收入超过 4 万英镑的可能。不同学科差别大，数学博士的回报特别低，心理学博士是回报最高的之一。读博期间的心理负担看 2021 年的一篇汇总分析。16 项研究、23469 名博士生里，有明显抑郁症状的合计约 24%（95% CI 18%–31%，可信范围）。9 项研究、15626 名博士生里，有明显焦虑症状的约 17%（12%–23%）。各研究之间差别很大（I² 约 98%）。国内的花费照 2013 年意见：全日制学术学位博士学费原则上每年不超过 1 万元，研究生国家助学金每年不低于 1 万元"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["来源"]},{"tag":"p","props":{"className":"life-citations"},"children":["Britton J, Buscha F, Dickson M, van der Erve L, Vignoles A, Walker I, Waltmann B, Zhu Y (2020). The earnings returns to postgraduate degrees in the UK. Department for Education. ",{"tag":"a","props":{"href":"https://assets.publishing.service.gov.uk/media/5f609e478fa8f5106d1563cc/PG_LEO_report_FINAL.pdf","target":"_blank","rel":"noopener noreferrer"},"children":["https://assets.publishing.service.gov.uk/media/5f609e478fa8f5106d1563cc/PG_LEO_report_FINAL.pdf"]},"；Satinsky EN, Kimura T, Kiang MV, et al. (2021). Systematic review and meta-analysis of depression, anxiety, and suicidal ideation among Ph.D. students. Scientific Reports, 11, 14370. ",{"tag":"a","props":{"href":"https://doi.org/10.1038/s41598-021-93687-7","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1038/s41598-021-93687-7"]},"；Liu H, Gao Y, Tuerxun N, Cabirou L (2026). More than Depression: Doctoral Students' Mental Health in China: A Systematic Review and Meta-Analysis. Behavioral Sciences, 16, 1355. ",{"tag":"a","props":{"href":"https://doi.org/10.3390/bs16081355","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.3390/bs16081355"]},"；财政部、国家发展改革委、教育部 (2013). 关于完善研究生教育投入机制的意见（财教〔2013〕19号）. ",{"tag":"a","props":{"href":"https://www.gov.cn/gongbao/content/2013/content_2404719.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/gongbao/content/2013/content_2404719.htm"]},""]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["原书备注"]},{"tag":"p","props":{"className":"life-citations"},"children":["争议。抑郁焦虑那组数字只是把各国调查的比例合起来，没有和同龄人对比，用的量表也不一样。所以它说明博士生里这类症状常见，说明不了是读博造成的。国内中文研究的汇总发现，博士生和硕士生的心理症状差别不大，但都比全国常模和青年常模高。收入数字的局限和本节第 24 条（读硕士）一样，只能当方向参考。高校教职、科研院所和部分研发岗的招聘公告常写明要博士，想走这条路的，先把目标单位近几年的公告翻一遍。读的过程中情绪低落持续两周以上，先做第 3 节第 18 条（情绪低落时先做的几件事）那几件事，有自杀念头打 12356，见第 1 节第 25 条（抑郁或有自杀念头时打 12356）。"]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["我的备注"]},{"tag":"button","props":{"type":"button"},"children":["写下对自己有用的提醒…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/tip/23-24"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["上一条"]},"本科毕业要不要接着读硕士：先算学费和少挣的两三年工资，再看自己读的专业多挣不多挣"]}]},{"tag":"span","props":{},"children":[]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["本主题的其他建议"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/23-03"},"children":[{"tag":"strong","props":{},"children":["判断「学历是不是贬值了」之前，先看全国的学历结构：每 10 万人里只有 15467 人有大学文化程度（2020 年普查，2025 年抽样推算约 19%）"]},{"tag":"span","props":{},"children":["2020 年人口普查时，全国念到大专及以上的约占 15%。2025 年的抽样调查推算约 19%，五年里多了几个百分点。两次都是初中学历的人最多。15 岁以上的人…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/23-04"},"children":[{"tag":"strong","props":{},"children":["「读不起」先按政策算一遍：中职学费大多已免，助学金 2300 元，助学贷款每年最高 2 万"]},{"tag":"span","props":{},"children":["公办中职里，农村学生、城市涉农专业学生和家庭困难学生已经免学费。中职和普通高中的助学金，2025 年春季起每年 2300 元。上了大学，助学金每年 3700 元…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/23-05"},"children":[{"tag":"strong","props":{},"children":["没考上普高不等于路断了：中职有贯通招生和单独考试，技能岗位招聘还可以降学历要求"]},{"tag":"span","props":{},"children":["2022 年的职业教育法写明：职业教育和普通教育地位同等重要。中职可以和高职贯通招生，高职还必须留出招生计划或者单独考试，专门招中职毕业生。用人单位也不得因为你…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/23-06"},"children":[{"tag":"strong","props":{},"children":["把「读书还是打工」算成一道题：先去打工早挣的三年工资，对上接着读书换来的、往后几十年的年收入差"]},{"tag":"span","props":{},"children":["先去打工，能早挣几年工资，但这笔钱只拿一次。接着读书，往后每年都比不读的多挣一些，要连着拿三四十年。所以要把这两笔钱放在一起比。中国城镇多读一年书，一年收入大约…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/23-07"},"children":[{"tag":"strong","props":{},"children":["先记住基准线：多受一年教育，全球平均的私人回报（落到自己收入上的那部分）约为每年 9%"]},{"tag":"span","props":{},"children":["按全世界平均算，多读一年书，个人收入每年高约 9%，女性的回报一直高于男性。这个数说的是正规上学，报一个班不能直接套。拿它当尺子：一个课程要你花 3 万元和半年…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/23-08"},"children":[{"tag":"strong","props":{},"children":["花钱考证之前，先查这张证在不在国家职业资格目录或人社部备案的评价机构名单里"]},{"tag":"span","props":{},"children":["有些机构打着新职业、技能等级的名义乱办班、乱收费、滥发证，还有假冒权威机构的，人社部专门治理过。报名前按三步查：这个职业在不在国家职业资格目录、发证机构是不是人…"]}]}]}]},{"tag":"a","props":{"className":"life-text-link","href":"/book/23"},"children":["阅读整个主题：学什么技能划算 ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"15","height":"15","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]}]}]},{"tag":"nav","props":{"className":"life-tabba