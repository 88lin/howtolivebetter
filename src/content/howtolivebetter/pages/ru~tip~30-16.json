:[]},{"tag":"path","props":{"d":"M20 12h2"},"children":[]},{"tag":"path","props":{"d":"m6.34 17.66-1.41 1.41"},"children":[]},{"tag":"path","props":{"d":"m19.07 4.93-1.41 1.41"},"children":[]}]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"17","height":"17","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-moon life-theme-icon-dark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"},"children":[]}]}]},{"tag":"button","props":{"type":"button","className":"life-language-switch","aria-label":"Русский Выбрать язык","aria-haspopup":"menu","aria-expanded":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-globe","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]},{"tag":"path","props":{"d":"M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"},"children":[]},{"tag":"path","props":{"d":"M2 12h20"},"children":[]}]},{"tag":"span","props":{},"children":["Русский"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]}]},{"tag":"a","props":{"className":"life-account","href":"/ru/sign-in"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"17","height":"17","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle-user-round","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M18 20a6 6 0 0 0-12 0"},"children":[]},{"tag":"circle","props":{"cx":"12","cy":"10","r":"4"},"children":[]},{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},{"tag":"span","props":{},"children":["Войти"]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/ru/book/30"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"К содержанию"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["Дети после поступления в школу"]},{"tag":"nav","props":{"aria-label":"Советы главы"},"children":[{"tag":"a","props":{"href":"/ru/tip/30-01"},"children":[{"tag":"span","props":{},"children":["01"]},"Внезапная сильная боль в мошонке у мальчика — повод немедленно ехать в больницу, не дожидаясь конца уроков"]},{"tag":"a","props":{"href":"/ru/tip/30-02"},"children":[{"tag":"span","props":{},"children":["02"]},"Не откладывайте необходимое лечение «до окончания экзаменов» — для некоторых состояний существует временное окно, зависящее от сроков роста костей, а не от расписания экзаменов"]},{"tag":"a","props":{"href":"/ru/tip/30-03"},"children":[{"tag":"span","props":{},"children":["03"]},"Ребёнок подвергся издевательствам: в тот же день следует сообщить об этом в школу и потребовать письменного рассмотрения дела; в случаях избиения, отъёма денег или распространения слухов необходимо сразу вызывать полицию"]},{"tag":"a","props":{"href":"/ru/tip/30-04"},"children":[{"tag":"span","props":{},"children":["04"]},"Чтобы предотвратить близорукость, детям необходимо проводить на улице не менее 2 часов в день — это единственный метод, подтвержденный рандомизированными исследованиями"]},{"tag":"a","props":{"href":"/ru/tip/30-05"},"children":[{"tag":"span","props":{},"children":["05"]},"Детям до 3 лет экраны не давать, детям от 3 до 6 лет — по возможности тоже не давать; школьникам использовать экраны в неучебных целях не более 1 часа в день"]},{"tag":"a","props":{"href":"/ru/tip/30-06"},"children":[{"tag":"span","props":{},"children":["06"]},"Восприятие близорукости как необратимого повреждения: чем выше степень близорукости, тем выше риск развития отслойки сетчатки, макулярной дегенерации и глаукомы в будущем"]},{"tag":"a","props":{"href":"/ru/tip/30-07"},"children":[{"tag":"span","props":{},"children":["07"]},"Каждый год нужно внимательно изучать выданный школьникам медицинский осмотр — при выявлении отклонений в тот же год следует обратиться к врачу"]},{"tag":"a","props":{"href":"/ru/tip/30-08"},"children":[{"tag":"span","props":{},"children":["08"]},"Проведение скрининга на депрессию для подростков 12–18 лет: не следует считать школьные психологические тесты диагнозом"]},{"tag":"a","props":{"href":"/ru/tip/30-09"},"children":[{"tag":"span","props":{},"children":["09"]},"Не покупайте товары и услуги, которые якобы «излечивают близорукость» или «снижают степень близорукости»"]},{"tag":"a","props":{"href":"/ru/tip/30-10"},"children":[{"tag":"span","props":{},"children":["10"]},"Для сна, учебного расписания, физических занятий и ранжирования учеников существуют чёткие правила; если школа их не соблюдает, можно об этом заявить"]},{"tag":"a","props":{"href":"/ru/tip/30-11"},"children":[{"tag":"span","props":{},"children":["11"]},"Ребенку можно взять академический отпуск, если он не справляется с учебой; при этом школа обязана сохранить его ученический статус на срок до 1 года"]},{"tag":"a","props":{"href":"/ru/tip/30-12"},"children":[{"tag":"span","props":{},"children":["12"]},"Обнаружена плохая острота зрения: в больнице проводят проверку с применением мидриатика, а затем по рекомендации врача делают повторные осмотры"]},{"tag":"a","props":{"href":"/ru/tip/30-13"},"children":[{"tag":"span","props":{},"children":["13"]},"Герметизация фиссур на постоянных коренных зубах после их прорезывания"]},{"tag":"a","props":{"href":"/ru/tip/30-14"},"children":[{"tag":"span","props":{},"children":["14"]},"Ребенок любит играть в игры: сначала проверьте, не пострадали ли сон, уроки и прогулки, а не только время, проведенное за игрой"]},{"tag":"a","props":{"href":"/ru/tip/30-15"},"children":[{"tag":"span","props":{},"children":["15"]},"Ребенок говорит, что ему нравятся люди своего пола: не ругайте, не выгоняйте из дома и не отправляйте на «исправление»: отношение в семье напрямую связано с риском самоубийства"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/ru/tip/30-16","data-status":"active"},"children":[{"tag":"span","props":{},"children":["16"]},"Не бейте ребёнка и не кричите, не называя его глупым или ленивым: у часто наказываемых телом или словами детей чаще проблемы с поведением и настроением"]},{"tag":"a","props":{"href":"/ru/tip/30-17"},"children":[{"tag":"span","props":{},"children":["17"]},"Если с ребёнком не справляетесь и снова бьёте или кричите, пройдите курс с конкретными родительскими навыками"]},{"tag":"a","props":{"href":"/ru/tip/30-18"},"children":[{"tag":"span","props":{},"children":["18"]},"Не отправляйте детей в закрытые «школы лечения интернет-зависимости» и «спецлагеря»: закон запрещает вредные методы, а дети уже погибали в заключении"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"Навигация"},"children":[{"tag":"a","props":{"href":"/ru/book"},"children":["Книга"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/ru/book/30"},"children":["Глава 30"," ·"," ","Дети после поступления в школу"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"30-16"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["16"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["Доказательства"," ","A"]}]},{"tag":"h1","props":{"lang":"ru"},"children":["Не бейте ребёнка и не кричите, не называя его глупым или ленивым: у часто наказываемых телом или словами детей чаще проблемы с поведением и настроением"]},{"tag":"p","props":{"lang":"ru","className":"life-entry-summary"},"children":["У детей, которых часто бьют, чаще агрессия и психологические проблемы, больше отчуждение от родителей и более жёсткие избиения. Доказывает ли шлепок мгновенное послушание — в данных неясно. Подростков, которых в 13 лет часто ругают или называют глупым, в следующем году чаще ждут проступки и депрессия; тёплые отношения с родителями эту связь не снимают."]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Затраты"]},{"tag":"p","props":{},"children":["Без денег. Трудно в запале удержать руки и рот и перейти к…"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Польза"]},{"tag":"p","props":{},"children":["По физическому наказанию один метаанализ учитывал только шлепки открытой ладонью по ягодицам или конечностям.…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"Отметить: Не бейте ребёнка и не кричите, не называя его глупым или ленивым: у часто наказываемых телом или словами детей чаще проблемы с поведением и настроением"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"Сделано"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"В планах"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"В избранное"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Поделиться советом"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Скрыть подробности"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Затраты"]},{"tag":"p","props":{},"children":["Без денег. Трудно в запале удержать руки и рот и перейти к ненасильственным мерам. Чем заменить — в пункте 17 этого раздела (курсы для родителей с конкретными навыками)."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Польза"]},{"tag":"p","props":{},"children":["По физическому наказанию один метаанализ учитывал только шлепки открытой ладонью по ягодицам или конечностям. Объединены 75 исследований, 111 размеров эффекта и 160 927 детей. Из 17 исходов 13 были значимо связаны с шлепками, все в сторону вреда. Cohen’s d: 0,2 — малый, 0,5 — средний. Агрессия в детстве d = 0,37 (95% CI 0,13–0,61). Внешние проблемы 0,41 (драки, нарушение правил). Внутренние 0,24 (тревога, депрессия). Проблемы психического здоровья 0,53. Плохие отношения с родителями 0,51. Низкая самооценка 0,15. Слабые когнитивные способности 0,17. Физическое насилие со стороны родителей 0,64. Антисоциальное поведение во взрослом возрасте 0,36. Психическое здоровье во взрослом возрасте 0,24. По всем 111 эффектам d = 0,33 (0,29–0,38). Мгновенное послушание связи не показала (d = 0,14, −0,19–0,47), всего 5 размеров эффекта. Другой обзор 69 продольных исследований: шлепки надёжно предсказывали последующие проблемы поведения и не давали долгосрочной пользы; в 7 исследованиях считали частоту, в 5 чаще шлепки — хуже исходы. По крикам: в США проследили 976 семей с двумя родителями. Частые крики, ругательства или обзывания «глупым» или «ленивым» в 13 лет предсказывали больше проступков и депрессивных симптомов между 13 и 14 годами. Теплота родителей связь не ослабляла; обратное тоже — больше проступков в 13 лет предсказывало больше криков позже. По статье 2 Закона КНР о предотвращении домашнего насилия домашнее насилие включает избиение, связывание, калечение, ограничение свободы и привычные оскорбления или запугивание словами. Статья 12 обязывает опекунов воспитывать цивилизованно. Если родители нарушают права ребёнка, уличные комитеты должны убеждать, пресекать и при тяжёлых случаях сообщать в полицию. Органы общественной безопасности, прокуратура и суды могут вынести предостережение и обязать пройти семейное обучение (по всей стране)."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Первоисточники"]},{"tag":"p","props":{"className":"life-citations"},"children":["Gershoff ET, Grogan-Kaylor A. (2016). Spanking and child outcomes: Old controversies and new meta-analyses. Journal of Family Psychology, 30(4), 453–469. ",{"tag":"a","props":{"href":"https://doi.org/10.1037/fam0000191","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1037/fam0000191"]},"；Heilmann A, Mehay A, Watt RG, et al. (2021). Physical punishment and child outcomes: a narrative review of prospective studies. Lancet, 398(10297), 355–364. ",{"tag":"a","props":{"href":"https://doi.org/10.1016/S0140-6736(21)00582-1","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1016/S0140-6736(21)00582-1"]},"；Wang MT, Kenny S. (2014). Longitudinal links between fathers' and mothers' harsh verbal discipline and adolescents' conduct problems and depressive symptoms. Child Development, 85(3), 908–923. ",{"tag":"a","props":{"href":"https://doi.org/10.1111/cdev.12143","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1111/cdev.12143"]},"；Ferguson CJ. (2013). Spanking, corporal punishment and negative long-term outcomes: a meta-analytic review of longitudinal studies. Clinical Psychology Review, 33(1), 196–208. ",{"tag":"a","props":{"href":"https://doi.org/10.1016/j.cpr.2012.11.002","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1016/j.cpr.2012.11.002"]},"；Larzelere RE, Kuhn BR. (2005). Comparing child outcomes of physical punishment and alternative disciplinary tactics: a meta-analysis. Clinical Child and Family Psychology Review, 8(1), 1–37. ",{"tag":"a","props":{"href":"https://doi.org/10.1007/s10567-005-2340-z","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1007/s10567-005-2340-z"]},"；全国人大常委会 (2015). 反家庭暴力法（第二、十二条）. ",{"tag":"a","props":{"href":"https://flk.npc.gov.cn/detail?id=2c909fdd678bf17901678bf7f9d60889","target":"_blank","rel":"noopener noreferrer"},"children":["https://flk.npc.gov.cn/detail?id=2c909fdd678bf17901678bf7f9d60889"]},"；全国人大常委会 (2024 年修正). 未成年人保护法（第十一、十七、一百一十八条）. ",{"tag":"a","props":{"href":"https://flk.npc.gov.cn/detail?id=ff8081818f197cf001905e567af635a0","target":"_blank","rel":"noopener noreferrer"},"children":["https://flk.npc.gov.cn/detail?id=ff8081818f197cf001905e567af635a0"]},"；全国人大常委会 (2021). 家庭教育促进法（第二十三、五十三条）. ",{"tag":"a","props":{"href":"https://flk.npc.gov.cn/detail?id=ff8081817cac3b2d017cac5a6c6f0109","target":"_blank","rel":"noopener noreferrer"},"children":["https://flk.npc.gov.cn/detail?id=ff8081817cac3b2d017cac5a6c6f0109"]}]},{"tag":"a","props":{"href":"https://doi.org/10.1037/fam0000191","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Открыть источник"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Примечание автора"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["Спорно. Почти все исследования наблюдательные, не рандомизированные — причинность неясна. В метаанализе шлепков 72% исследований поперечные или с опорой на воспоминания. Метаанализ продольных данных: после учёта прежнего поведения ребёнка связь с внешними проблемами упала до 0,07, с внутренними до 0,10; авторы оценили эффект как малый. Другой метаанализ: «условные» шлепки превосходили 10 из 13 альтернатив при снижении непослушания и антисоциального поведения, но тяжёлые или доминирующие шлепки проигрывали альтернативам. Критики и сторонники сходятся: частые жёсткие удары и привычные оскорбления хуже. Разовый шлепок или крик закон прямо не называет домашним насилием — там избиение и привычные оскорбления или запугивание словами. Главные получатели — дети. Если бьёт кто-то другой в семье — см. раздел 8, пункт 43 (обеспечительные меры личной безопасности). Любой может отговорить или сообщить о систематическом насилии над ребёнком в полицию, гражданские органы или образование; в чужой семье достаточно 110 или уличного комитета — не вламывайтесь сами."]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Моя заметка"]},{"tag":"button","props":{"type":"button"},"children":["Запишите напоминание…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/ru/tip/30-15"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Предыдущий"]},"Ребенок говорит, что ему нравятся люди своего пола: не ругайте, не выгоняйте из дома и не отправляйте на «исправление»: отношение в семье напрямую связано с риском самоубийства"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/ru/tip/30-17"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Следующий"]},"Если с ребёнком не справляетесь и снова бьёте или кричите, пройдите курс с конкретными родительскими навыками"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["Другие советы по этой теме"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/30-10"},"children":[{"tag":"strong","props":{},"children":["Для сна, учебного расписания, физических занятий и ранжирования учеников существуют чёткие правила; если школа их не соблюдает, можно об этом заявить"]},{"tag":"span","props":{},"children":["Все эти требования прописаны чёрным по белому: младшеклассники должны…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/30-11"},"children":[{"tag":"strong","props":{},"children":["Ребенку можно взять академический отпуск, если он не справляется с учебой; при этом школа обязана сохранить его ученический статус на срок до 1 года"]},{"tag":"span","props":{},"children":["Академический отпуск предусмотрен официальной системой. После подачи …"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/30-12"},"children":[{"tag":"strong","props":{},"children":["Обнаружена плохая острота зрения: в больнице проводят проверку с применением мидриатика, а затем по рекомендации врача делают повторные осмотры"]},{"tag":"span","props":{},"children":["Проверка с применением мидриатика подразумевает закапывание специальн…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/30-13"},"children":[{"tag":"strong","props":{},"children":["Герметизация фиссур на постоянных коренных зубах после их прорезывания"]},{"tag":"span","props":{},"children":["Герметизация фиссур заключается в заполнении специальным составом угл…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/30-14"},"children":[{"tag":"strong","props":{},"children":["Ребенок любит играть в игры: сначала проверьте, не пострадали ли сон, уроки и прогулки, а не только время, проведенное за игрой"]},{"tag":"span","props":{},"children":["Настоящее «игровое расстройство» встречается примерно у двух-трех чел…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/30-18"},"children":[{"tag":"strong","props":{},"children":["Не отправляйте детей в закрытые «школы лечения интернет-зависимости» и «спецлагеря»: закон запрещает вредные методы, а дети уже погибали в заключении"]},{"tag":"span","props":{},"children":["Закон прямо запрещает лечить интернет-зависимость методами, вредящими…"]}]}]}]},{"tag":"a","props":{"className":"life-text-link","href":"/ru/book/30"},"children":["Читать всю тему: Дети после поступления в школу"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"15","height":"15","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]}]}]},{"tag":"nav","props":{"className":"life-tabbar","aria-label":"Основная навигация"},"children":[{"tag":"a","props":{"className":"","href":"/ru/book"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"21","height":"21","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-book-open","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M12 7v14"},"children":[]},{"tag":"path","props":{"d":"M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z"},"children":[]}]},{"tag":"span","props":{},"children":["Книга"]}]},{"tag":"a","props":{"className":"","href":"/ru/top-50"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"21","height":"21","viewB