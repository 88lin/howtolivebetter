tag":"p","props":{},"children":["Топ-50 по общему числу дней, текущей серии или дням за этот месяц. При равенстве — одинаковое место. Сложность и скорость не учитываются."]}]}]},{"tag":"div","props":{"className":"daily-rank-grid"},"children":[{"tag":"div","props":{},"children":[{"tag":"p","props":{"role":"status"},"children":["Загружаем записи…"]}]},{"tag":"div","props":{"className":"daily-join"},"children":[{"tag":"a","props":{"className":"life-button dark","href":"/ru/sign-in?callbackUrl=%2Fdaily"},"children":["Войдите, чтобы по желанию участвовать",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]},{"tag":"p","props":{"className":"daily-small"},"children":["Участие добровольное. Публичны только псевдоним и число дней (всего, серия и за месяц). Можно выйти в любой момент, сохранив записи."]}]}]}]},{"tag":"div","props":{"className":"page-guide"},"children":[{"tag":"section","props":{"aria-labelledby":"daily-about-title"},"children":[{"tag":"div","props":{"className":"life-eyebrow"},"children":["О заданиях дня"]},{"tag":"h2","props":{"id":"daily-about-title"},"children":["Что такое задания дня?"]},{"tag":"p","props":{},"children":["Задания дня — небольшие бесплатные действия на 1–5 минут: пройтись три минуты, отключить одно ненужное уведомление, оставить себе начало на завтра. Всего их 30; каждый день выбирайте одно случайное и отмечайте, когда сделаете."]},{"tag":"p","props":{},"children":["Они подойдут, если вы ещё не решили, с какого совета начать, или хотите сначала выработать одну маленькую привычку. Задания придуманы сайтом по темам книги и не являются цитатами из неё; с карточки можно перейти к связанной теме и прочитать обоснование."]}]},{"tag":"section","props":{"className":"page-guide-faq","aria-labelledby":"daily-faq-title"},"children":[{"tag":"h2","props":{"id":"daily-faq-title"},"children":["Частые вопросы о заданиях дня"]},{"tag":"details","props":{},"children":[{"tag":"summary","props":{},"children":["Нужно ли входить в аккаунт?"]},{"tag":"p","props":{},"children":["Нет. Отметки по умолчанию хранятся в этом браузере. После входа новые отметки синхронизируются с аккаунтом и видны на других устройствах."]}]},{"tag":"details","props":{},"children":[{"tag":"summary","props":{},"children":["Пропуск дня всё обнуляет?"]},{"tag":"p","props":{},"children":["Нет. Общее число дней сохраняется, заново начинается только текущая серия. Пустые дни — это нормально, начать можно сегодня."]}]},{"tag":"details","props":{},"children":[{"tag":"summary","props":{},"children":["Что видно в рейтинге?"]},{"tag":"p","props":{},"children":["Участие добровольное и требует входа. Видны только выбранный вами ник и общее число дней, без самих заданий. Выйти можно в любой момент, личные записи сохранятся."]}]},{"tag":"details","props":{},"children":[{"tag":"summary","props":{},"children":["Сколько раз в день можно отмечаться?"]},{"tag":"p","props":{},"children":["День засчитывается один раз. Смена задания на записи не влияет, а после отмены сегодняшней отметки можно выбрать заново."]}]}]}]},{"tag":"p","props":{"className":"daily-original"},"children":["Это самостоятельные повторяемые задания на повседневные темы, а не цитаты из книги."]}]},{"tag":"aside","props":{"className":"life-ad-space life-ad-space-sponsored","data-ad-placement":"ad_footer","data-ad-group":"practice","data-ad-creative":"practice_time","data-ad-ready":"false","aria-label":"Реклама · Рекомендация сообщества"},"children":[{"tag":"div","props":{"className":"life-ad-space-brand"},"children":[{"tag":"img","props":{"src":"/sites/howtolivebetter/images/shengcai/logo.png","width":"565","height":"144","alt":"Официальный логотип Shengca