th","props":{"d":"M18 20a6 6 0 0 0-12 0"},"children":[]},{"tag":"circle","props":{"cx":"12","cy":"10","r":"4"},"children":[]},{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},{"tag":"span","props":{},"children":["Sign in to sync"]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/en/book/01"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"Back to index"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["Do not die early"]},{"tag":"nav","props":{"aria-label":"Chapter entries"},"children":[{"tag":"a","props":{"href":"/en/tip/01-01"},"children":[{"tag":"span","props":{},"children":["01"]},"Always wear seat belts, both front and back"]},{"tag":"a","props":{"href":"/en/tip/01-02"},"children":[{"tag":"span","props":{},"children":["02"]},"Wearing a helmet and fastening the strap while riding motorcycles or e-bikes"]},{"tag":"a","props":{"href":"/en/tip/01-03"},"children":[{"tag":"span","props":{},"children":["03"]},"Install smoke alarms; those heating with coal or gas in winter should also add a carbon monoxide alarm"]},{"tag":"a","props":{"href":"/en/tip/01-04"},"children":[{"tag":"span","props":{},"children":["04"]},"Replace gas hoses and stoves when they reach their expiration date; never modify the piping yourself, and you may decline any unsolicited sales pitches from gas companies"]},{"tag":"a","props":{"href":"/en/tip/01-05"},"children":[{"tag":"span","props":{},"children":["05"]},"Do not pick, buy, or eat wild mushrooms; any “folk tricks” for identification are useless"]},{"tag":"a","props":{"href":"/en/tip/01-06"},"children":[{"tag":"span","props":{},"children":["06"]},"Electric bicycles must not be pushed into stairwells, elevators, or charged indoors"]},{"tag":"a","props":{"href":"/en/tip/01-07"},"children":[{"tag":"span","props":{},"children":["07"]},"Measuring blood pressure and taking meds to reach target levels"]},{"tag":"a","props":{"href":"/en/tip/01-08"},"children":[{"tag":"span","props":{},"children":["08"]},"After age 35, anyone who is overweight should get a fasting blood glucose test; if the result is normal, repeat it every three years"]},{"tag":"a","props":{"href":"/en/tip/01-09"},"children":[{"tag":"span","props":{},"children":["09"]},"Don’t speed or drive after drinking"]},{"tag":"a","props":{"href":"/en/tip/01-10"},"children":[{"tag":"span","props":{},"children":["10"]},"When riding in a car, use a car seat for children under 4, don’t hold them in your arms"]},{"tag":"a","props":{"href":"/en/tip/01-11"},"children":[{"tag":"span","props":{},"children":["11"]},"Install window guards and balcony barriers if you have kids at home; screen windows do not count as protection"]},{"tag":"a","props":{"href":"/en/tip/01-12"},"children":[{"tag":"span","props":{},"children":["12"]},"Keep young children in sight near water; wear life jackets when boating or swimming"]},{"tag":"a","props":{"href":"/en/tip/01-13"},"children":[{"tag":"span","props":{},"children":["13"]},"Exercising balance and leg strength for people over 60, plus home modifications"]},{"tag":"a","props":{"href":"/en/tip/01-14"},"children":[{"tag":"span","props":{},"children":["14"]},"Get tested for hepatitis B markers; if no antibodies, get vaccinated"]},{"tag":"a","props":{"href":"/en/tip/01-15"},"children":[{"tag":"span","props":{},"children":["15"]},"If you get pricked by a nail or splinter, or if a wound gets dirty with soil, seek treatment the same day and ask whether a tetanus shot is needed"]},{"tag":"a","props":{"href":"/en/tip/01-16"},"children":[{"tag":"span","props":{},"children":["16"]},"The earlier women get the HPV vaccine, the better"]},{"tag":"a","props":{"href":"/en/tip/01-17"},"children":[{"tag":"span","props":{},"children":["17"]},"Breast cancer screening for women: mammograms every two years starting at age 40"]},{"tag":"a","props":{"href":"/en/tip/01-18"},"children":[{"tag":"span","props":{},"children":["18"]},"For women over 30, HPV testing should be the first choice for cervical cancer screening"]},{"tag":"a","props":{"href":"/en/tip/01-19"},"children":[{"tag":"span","props":{},"children":["19"]},"Starting colorectal cancer screening at ages 45–50: use fecal immunochemical tests or colonoscopies"]},{"tag":"a","props":{"href":"/en/tip/01-20"},"children":[{"tag":"span","props":{},"children":["20"]},"People with cardiovascular disease and older adults should get a flu shot each year"]},{"tag":"a","props":{"href":"/en/tip/01-21"},"children":[{"tag":"span","props":{},"children":["21"]},"Getting the shingles vaccine after age 50"]},{"tag":"a","props":{"href":"/en/tip/01-22"},"children":[{"tag":"span","props":{},"children":["22"]},"Pneumococcal vaccine for people over 65"]},{"tag":"a","props":{"href":"/en/tip/01-23"},"children":[{"tag":"span","props":{},"children":["23"]},"Testing for Helicobacter pylori and eradicating it if positive"]},{"tag":"a","props":{"href":"/en/tip/01-24"},"children":[{"tag":"span","props":{},"children":["24"]},"Heavy smokers should get a low-dose chest CT once a year"]},{"tag":"a","props":{"href":"/en/tip/01-25"},"children":[{"tag":"span","props":{},"children":["25"]},"Call 12356 if you’re depressed or having suicidal thoughts; don’t keep sleeping pills or pesticides at home"]},{"tag":"a","props":{"href":"/en/tip/01-26"},"children":[{"tag":"span","props":{},"children":["26"]},"Purchase fire extinguishers, fire blankets, escape respirators, and first-aid kits, then inspect them once a year"]},{"tag":"a","props":{"href":"/en/tip/01-27"},"children":[{"tag":"span","props":{},"children":["27"]},"Visible blood in urine — even if painless and gone by the next day — still warrants a check-up"]},{"tag":"a","props":{"href":"/en/tip/01-28"},"children":[{"tag":"span","props":{},"children":["28"]},"If erectile dysfunction appears, check cardiovascular health first — don’t treat it as a purely sexual issue"]},{"tag":"a","props":{"href":"/en/tip/01-29"},"children":[{"tag":"span","props":{},"children":["29"]},"Weight loss, quitting smoking, and controlling blood pressure and blood sugar can improve erectile function"]},{"tag":"a","props":{"href":"/en/tip/01-30"},"children":[{"tag":"span","props":{},"children":["30"]},"Always use condoms during sex and never share needles"]},{"tag":"a","props":{"href":"/en/tip/01-31"},"children":[{"tag":"span","props":{},"children":["31"]},"If you’ve engaged in high‑risk behavior, get tested for HIV — the Chinese CDC offers free testing with full confidentiality"]},{"tag":"a","props":{"href":"/en/tip/01-32"},"children":[{"tag":"span","props":{},"children":["32"]},"As soon as suicidal thoughts arise, tell someone nearby and hand over those first few minutes"]},{"tag":"a","props":{"href":"/en/tip/01-33"},"children":[{"tag":"span","props":{},"children":["33"]},"Don’t treat “survival” as a safety net: after ingesting paraquat or inhaling carbon monoxide, emergency care can save lives, but it rarely preserves lung or brain function"]},{"tag":"a","props":{"href":"/en/tip/01-34"},"children":[{"tag":"span","props":{},"children":["34"]},"Don’t bet on “a few days of rest” after a fall from height: most patients admitted to a trauma ICU survive, though at a cost measured in years"]},{"tag":"a","props":{"href":"/en/tip/01-35"},"children":[{"tag":"span","props":{},"children":["35"]},"Don’t trade “losing one kidney is no big deal” for cash: the remaining kidney has to do the work of two, and 86% of kidney sellers later say their health got worse"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/en/tip/01-36","data-status":"active"},"children":[{"tag":"span","props":{},"children":["36"]},"Don’t pick up, disassemble, or sell unidentified metal parts; stay clear of areas marked with the clover symbol"]},{"tag":"a","props":{"href":"/en/tip/01-37"},"children":[{"tag":"span","props":{},"children":["37"]},"When gambling leads to borrowing money to gamble and your mood is constantly low, first call 12356, then hand your bank cards and payment passwords over to your family to manage"]},{"tag":"a","props":{"href":"/en/tip/01-38"},"children":[{"tag":"span","props":{},"children":["38"]},"For men who have sex with men (MSM) engaging in high-risk sexual behavior, asking for Pre-Exposure Prophylaxis (PrEP) at designated HIV hospitals and taking it on schedule can reduce infection risk by over 70%"]},{"tag":"a","props":{"href":"/en/tip/01-39"},"children":[{"tag":"span","props":{},"children":["39"]},"Women aged 65 and older should have a dual-energy X-ray absorptiometry (DXA) bone density test; postmenopausal women with osteoporosis risk factors need not wait until 65"]},{"tag":"a","props":{"href":"/en/tip/01-40"},"children":[{"tag":"span","props":{},"children":["40"]},"If you are diagnosed with osteoporosis, or have fractured from a minor fall, ask a doctor for osteoporosis medication and keep taking it—do not treat calcium supplements as a substitute"]},{"tag":"a","props":{"href":"/en/tip/01-41"},"children":[{"tag":"span","props":{},"children":["41"]},"Drill holes to measure ice thickness before stepping onto it; don’t go out if it’s under 15 cm thick. Avoid ice over rivers and near ice-fishing holes"]},{"tag":"a","props":{"href":"/en/tip/01-42"},"children":[{"tag":"span","props":{},"children":["42"]},"Fit the guard and wear goggles plus a face shield before using an angle grinder; hold it with both hands, and never fit a woodworking saw blade to cut wood"]},{"tag":"a","props":{"href":"/en/tip/01-43"},"children":[{"tag":"span","props":{},"children":["43"]},"Ask someone whose mood seems wrong directly, “Have you thought about suicide?” Asking does not make them want it more"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"Breadcrumb"},"children":[{"tag":"a","props":{"href":"/en/book"},"children":["Explore the book"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/en/book/01"},"children":["Chapter 1"," ·"," ","Do not die early"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"01-36"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["36"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["Evidence"," ","A"]}]},{"tag":"h1","props":{"lang":"en"},"children":["Don’t pick up, disassemble, or sell unidentified metal parts; stay clear of areas marked with the clover symbol"]},{"tag":"p","props":{"lang":"en","className":"life-entry-summary"},"children":["Radiation has no smell, color, or temperature. Most radioactive sources look like ordinary pieces of metal, so “it looks harmless” is not a reliable indicator. The chance of an ordinary person encountering one is extremely low — fewer than one incident occurs per 10,000 sources each year. Yet when such an encounter does happen, the consequences are irreversible. In 1987, four people died in Brazil after dismantling a radiotherapy machine from an abandoned clinic."]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Cost"]},{"tag":"p","props":{},"children":["No cost involved. If you see unfamiliar metal cylinders, l…"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Benefit"]},{"tag":"p","props":{},"children":["