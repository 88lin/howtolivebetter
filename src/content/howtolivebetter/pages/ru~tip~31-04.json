necap":"round","strokeLinejoin":"round","className":"lucide lucide-circle-user-round","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M18 20a6 6 0 0 0-12 0"},"children":[]},{"tag":"circle","props":{"cx":"12","cy":"10","r":"4"},"children":[]},{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},{"tag":"span","props":{},"children":["Войти"]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/ru/book/31"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"К содержанию"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["Какие пути открываются после 18 лет"]},{"tag":"nav","props":{"aria-label":"Советы главы"},"children":[{"tag":"a","props":{"href":"/ru/tip/31-01"},"children":[{"tag":"span","props":{},"children":["01"]},"Сначала сверьте требования: возрастные и образовательные критерии для двенадцати вариантов карьерного пути чётко прописаны в документах"]},{"tag":"a","props":{"href":"/ru/tip/31-02"},"children":[{"tag":"span","props":{},"children":["02"]},"Мужчины, которым исполнилось 18 лет, должны до 31 октября пройти регистрацию на военную службу; срочная служба длится два года"]},{"tag":"a","props":{"href":"/ru/tip/31-03"},"children":[{"tag":"span","props":{},"children":["03"]},"Отказ от военной службы после подачи заявления влечет серьезные ограничения на два года"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/ru/tip/31-04","data-status":"active"},"children":[{"tag":"span","props":{},"children":["04"]},"Два главных преимущества для студентов, решивших пойти в армию: государство компенсирует до 20 000 юаней в год за обучение, сохраняет за ними право на учёбу на протяжении двух лет и предусматривает отдельную программу поступления в магистратуру"]},{"tag":"a","props":{"href":"/ru/tip/31-05"},"children":[{"tag":"span","props":{},"children":["05"]},"После увольнения с военной службы работу по распределению предоставляют лишь в шести случаях; при самостоятельном трудоустройстве необходимо явиться в органы гражданской администрации в течение 30 дней"]},{"tag":"a","props":{"href":"/ru/tip/31-06"},"children":[{"tag":"span","props":{},"children":["06"]},"Три важных показателя после увольнения: единовременная выплата, зачёт военного стажа и налоговая льгота в 20 000 юаней в год"]},{"tag":"a","props":{"href":"/ru/tip/31-07"},"children":[{"tag":"span","props":{},"children":["07"]},"Не только экзамен на госслужбу — есть и другие пути попасть в систему: после двух лет работы по программе «Три поддержки, один помощник» можно претендовать на 10% вакансий, выделенных специально для участников этой программы"]},{"tag":"a","props":{"href":"/ru/tip/31-08"},"children":[{"tag":"span","props":{},"children":["08"]},"По истечении трёхлетнего срока службы, при успешной аттестации и желании остаться работать, учителя из программы «Специальные рабочие места» должны быть незамедлительно зачислены в штат"]},{"tag":"a","props":{"href":"/ru/tip/31-09"},"children":[{"tag":"span","props":{},"children":["09"]},"Поступление на службу в пожарную охрану и в штат гражданских специалистов Вооружённых сил — ещё два пути открытого набора, причём порог входа здесь ниже, чем при сдаче государственного экзамена"]},{"tag":"a","props":{"href":"/ru/tip/31-10"},"children":[{"tag":"span","props":{},"children":["10"]},"Образование — это не разовое решение: для экзаменов по самообразованию нет ограничений по возрасту и уровню образования; поступить можно также через экзамены для взрослых или в Открытый университет"]},{"tag":"a","props":{"href":"/ru/tip/31-11"},"children":[{"tag":"span","props":{},"children":["11"]},"Отсутствие трудоустройства не означает отсутствие соцстраха: пенсионное и медицинское страхование придётся оформлять самостоятельно в месте работы, ограничения по прописке уже сняты"]},{"tag":"a","props":{"href":"/ru/tip/31-12"},"children":[{"tag":"span","props":{},"children":["12"]},"Для курьеров, водителей такси и грузоперевозчиков платформа сама оплачивает страховку от профессиональных травм за каждый выполненный заказ — вам платить не придётся"]},{"tag":"a","props":{"href":"/ru/tip/31-13"},"children":[{"tag":"span","props":{},"children":["13"]},"Два пути получения государственной должности в день подачи заявлений на поступление в вуз: бесплатное обучение для будущих учителей и для медиков, но за это придётся отработать 6 лет"]},{"tag":"a","props":{"href":"/ru/tip/31-14"},"children":[{"tag":"span","props":{},"children":["14"]},"Прежде чем ехать работать за границу, проверьте, имеет ли компания лицензию на международное трудоустройство: она не вправе требовать от вас залог"]},{"tag":"a","props":{"href":"/ru/tip/31-15"},"children":[{"tag":"span","props":{},"children":["15"]},"Работа на иностранную компанию из дома: такие доходы считаются внутренними по налоговому законодательству. Налог нужно декларировать самостоятельно, а перевод средств следует оформлять как «оплату труда сотрудника»"]},{"tag":"a","props":{"href":"/ru/tip/31-16"},"children":[{"tag":"span","props":{},"children":["16"]},"Работа на себя без трудоустройства: для старта нужно сначала изучить кредиты под гарантию государства — личный лимит до 300 тысяч юаней, причём половину процентов оплачивает казна"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"Навигация"},"children":[{"tag":"a","props":{"href":"/ru/book"},"children":["Книга"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/ru/book/31"},"children":["Глава 31"," ·"," ","Какие пути открываются после 18 лет"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"31-04"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["04"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["Доказательства"," ","A"]}]},{"tag":"h1","props":{"lang":"ru"},"children":["Два главных преимущества для студентов, решивших пойти в армию: государство компенсирует до 20 000 юаней в год за обучение, сохраняет за ними право на учёбу на протяжении двух лет и предусматривает отдельную программу поступления в магистратуру"]},{"tag":"p","props":{"lang":"ru","className":"life-entry-summary"},"children":["Студенты, выпускники и абитуриенты, поступающие в вузы, получают от государства компенсацию за обучение на весь период учёбы. Для бакалавров и специалистов максимальная сумма составляет 20 000 юаней в год, для магистров — 25 000 юаней в год. Компенсируется только фактически уплаченная сумма; если обучение стоит дешевле, выплачивается именно она. Право на учёбу сохраняется на два года. Для демобилизованных студентов действует отдельная программа поступления в магистратуру."]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Затраты"]},{"tag":"p","props":{},"children":["Бесплатно. После демобилизации нужно подать документы в ву…"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Польза"]},{"tag":"p","props":{},"children":["Согласно уведомлению Минфина и ещё трёх ведомств от 2024 года, студенты, прошедшие военную службу, получают тр…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"Отметить: Два главных преимущества для студентов, решивших пойти в армию: государство компенсирует до 20 000 юаней в год за обучение, сохраняет за ними право на учёбу на протяжении двух лет и предусматривает отдельную программу поступления в магистратуру"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"Сделано"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"В планах"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"В избранное"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Поделиться советом"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Скрыть подробности"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Затраты"]},{"tag":"p","props":{},"children":["Бесплатно. После демобилизации нужно подать документы в вуз согласно требованиям — обычно потребуется один‑два визита."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Польза"]},{"tag":"p","props":{},"children":["Согласно уведомлению Минфина и ещё трёх ведомств от 2024 года, студенты, прошедшие военную службу, получают три вида поддержки: компенсацию за обучение, погашение государственных образовательных кредитов и скидку на оплату учёбы. Компенсируется большая из двух сумм — фактически уплаченная за обучение или размер кредита (включая все проценты до полного погашения). Сверх установленного лимита выплаты не производятся. Для студентов с годовой оплатой 5 000 юаней компенсируется именно эта сумма. Период компенсации равен сроку обучения, а не сроку службы. Согласно «Закону о защите прав ветеранов», право на учёбу сохраняется на два года после демобилизации, а вузы могут создавать отдельные квоты для поступления ветеранов. Для магистратуры действует специальная программа «План для демобилизованных студентов», в рамках которой выделяются отдельные места, а критерии зачисления обычно ниже, чем для обычных абитуриентов."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Первоисточники"]},{"tag":"p","props":{"className":"life-citations"},"children":["财政部、教育部、中国人民银行、金融监管总局 (2024). 关于调整完善国家助学贷款有关政策的通知（财教〔2024〕188 号）. ",{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/202411/content_6984812.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/zhengce/zhengceku/202411/content_6984812.htm"]},"；财政部等五部门 (2019). 学生资助资金管理办法（财科教〔2019〕19 号，第五条；入伍资助年限：「入伍前已完成规定的修业年限，即为学费补偿或国家助学贷款代偿的年限；退役复学后接续完成规定的剩余修业年限，即为学费减免的年限」，毕业生「学费补偿或国家助学贷款代偿的年限，分别按照国家规定的相应学制计算」）. ",{"tag":"a","props":{"href":"http://www.gov.cn/gongbao/content/2019/content_5421553.htm","target":"_blank","rel":"noopener noreferrer"},"children":["http://www.gov.cn/gongbao/content/2019/content_5421553.htm"]},"；全国人大常委会 (2020). 退役军人保障法（第三十四、三十五条）. ",{"tag":"a","props":{"href":"http://www.mod.gov.cn/gfbw/fgwx/flfg/16048597.html","target":"_blank","rel":"noopener noreferrer"},"children":["http://www.mod.gov.cn/gfbw/fgwx/flfg/16048597.html"]},"（国防部刊登）；教育部办公厅 (2025). 关于做好 2026 年退役大学生士兵专项硕士研究生招生计划招生工作的通知（教学厅〔2025〕8 号）. ",{"tag":"a","props":{"href":"http://www.moe.gov.cn/srcsite/A15/moe_778/s3261/202512/t20251211_1423174.html","target":"_blank","rel":"noopener noreferrer"},"children":["http://www.moe.gov.cn/srcsite/A15/moe_778/s3261/202512/t20251211_1423174.html"]},"；退役军人事务部 (2022). 退役士兵教育培训政策 23 条：「从2022年招生起，高职（专科）毕业生及在校生（含高校新生）应征入伍，退役后完成高职（专科）学业的，申请专升本，免于参加文化课考试」（依据教学厅〔2021〕8 号）. ",{"tag":"a","props":{"href":"https://www.mva.gov.cn/sy/xx/bnxx/202201/t20220107_55052.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.mva.gov.cn/sy/xx/bnxx/202201/t20220107_55052.html"]},"；教育部 (2026). 2027 年全国硕士研究生招生工作管理规定（教学〔2026〕2 号，第二十二、二十四、二十五条），研招网刊登. ",{"tag":"a","props":{"href":"https://yz.chsi.com.cn/kyzx/jybzc/202609/20260924/2293971511.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://yz.chsi.com.cn/kyzx/jybzc/202609/20260924/2293971511.html"]},"；教育部 (2024). 2025 年全国硕士研究生招生工作管理规定（教学〔2024〕4 号，第二十二条）. ",{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/202410/content_6978684.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/zhengce/zhengceku/202410/content_6978684.htm"]}]},{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/202411/content_6984812.htm","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Открыть источник"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Примечание автора"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["Существуют ещё два дополнительных варианта поддержки. Первый — освобождение от вступительных экзаменов при поступлении в бакалавриат: выпускники колледжей, прошедшие службу, могут без экзаменов поступить в вуз, пройдя лишь профессиональный отбор. Это правило действует с 2022 года и регулируется региональными нормативами. Второй вариант — добавление 10 баллов к итоговому баллу ЕГЭ при поступлении в магистратуру в течение трёх лет после демобилизации; однако при выборе специальной программы баллы не суммируются. Лица, награждённые орденом второй степени и выше, могут быть освобождены от вступительных испытаний. Список вузов, участвующих в программе, ежегодно обновляется: в 2026 г. в ней задействовано 532 учебных заведения. Размер компенсации менялся дважды: в 2019 г. он составлял 8 000/12 000 юаней, в осеннем семестре 2023 г. был повышен до 16 000/20 000 юаней, а с осени 2024 г. — до 20 000/25 000 юаней в год. При использовании официальных документов следует опираться на актуальные цифры, а не на устаревшие данные из сводок Минобороны 2022 года. 〔523〕"]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Моя заметка"]},{"tag":"button","props":{"type":"button"},"children":["Запишите напоминание…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/ru/tip/31-03"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left"