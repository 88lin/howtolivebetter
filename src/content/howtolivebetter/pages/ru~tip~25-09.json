ide lucide-circle-user-round","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M18 20a6 6 0 0 0-12 0"},"children":[]},{"tag":"circle","props":{"cx":"12","cy":"10","r":"4"},"children":[]},{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},{"tag":"span","props":{},"children":["Войти"]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/ru/book/25"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"К содержанию"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["Что нужно сделать после смерти человека"]},{"tag":"nav","props":{"aria-label":"Советы главы"},"children":[{"tag":"a","props":{"href":"/ru/tip/25-01"},"children":[{"tag":"span","props":{},"children":["01"]},"Хукоу: как отличить обычную смерть от неестественной и где получить свидетельство о смерти"]},{"tag":"a","props":{"href":"/ru/tip/25-02"},"children":[{"tag":"span","props":{},"children":["02"]},"Свидетельство о смерти — ключ ко всем последующим процедурам: его выдают те, кто проводил лечение; при естественной смерти дома — местные учреждения общественного здравоохранения, выдача происходит в течение одного дня"]},{"tag":"a","props":{"href":"/ru/tip/25-03"},"children":[{"tag":"span","props":{},"children":["03"]},"Перевозка, хранение и кремация тел могут осуществляться только в похоронных бюро; морги больниц такими услугами не занимаются, а хранение обычно не превышает 3 дней"]},{"tag":"a","props":{"href":"/ru/tip/25-04"},"children":[{"tag":"span","props":{},"children":["04"]},"При наличии сомнений в причине смерти необходимо назначить вскрытие в течение 48 часов и одновременно опечатать медицинскую документацию"]},{"tag":"a","props":{"href":"/ru/tip/25-05"},"children":[{"tag":"span","props":{},"children":["05"]},"Установлены законные сроки для снятия с учёта хукоу умершего: в городах — до момента захоронения, в сельской местности — в течение месяца"]},{"tag":"a","props":{"href":"/ru/tip/25-06"},"children":[{"tag":"span","props":{},"children":["06"]},"Похоронные услуги делятся на базовые и небазовые. Для базовых услуг существует утвержденный перечень, а их стоимость устанавливается согласно закону"]},{"tag":"a","props":{"href":"/ru/tip/25-07"},"children":[{"tag":"span","props":{},"children":["07"]},"Запишите нарушения: принудительная продажа дополнительных услуг, доплаты сверх указанной цены, разбивка одной услуги на несколько позиций для взимания платы"]},{"tag":"a","props":{"href":"/ru/tip/25-08"},"children":[{"tag":"span","props":{},"children":["08"]},"Посредники, предоставляющие услуги по организации похорон, покупке предметов для похорон и проведению церемоний, должны быть зарегистрированы в органах гражданской администрации на уровне уезда"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/ru/tip/25-09","data-status":"active"},"children":[{"tag":"span","props":{},"children":["09"]},"Необходимо поочередно получать деньги, находящиеся в разных местах: остаток по жилищному накопительному фонду (гунцзицзинь), выплаты по соцстраху и пособия в случае производственной травмы"]},{"tag":"a","props":{"href":"/ru/tip/25-10"},"children":[{"tag":"span","props":{},"children":["10"]},"Родственники умершего могут запрашивать доступ к аккаунту и личным данным, их копирование, исправление и удаление"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"Навигация"},"children":[{"tag":"a","props":{"href":"/ru/book"},"children":["Книга"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/ru/book/25"},"children":["Глава 25"," ·"," ","Что нужно сделать после смерти человека"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"25-09"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["09"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["Доказательства"," ","A"]}]},{"tag":"h1","props":{"lang":"ru"},"children":["Необходимо поочередно получать деньги, находящиеся в разных местах: остаток по жилищному накопительному фонду (гунцзицзинь), выплаты по соцстраху и пособия в случае производственной травмы"]},{"tag":"p","props":{"lang":"ru","className":"life-entry-summary"},"children":["Наследники могут снять остаток средств на накопительном сберегательном счете (Housing Provident Fund); эти средства не находятся на банковском счете, поэтому их легче всего упустить. Остаток средств на личном счету пенсионного страхования также подлежит наследованию. В случае смерти от болезни родственники дополнительно получают пособие на погребение и выплату пособия на случай потери кормильца в размере от 3 до 24 месяцев. В случае смерти на производстве предусмотрены три дополнительные выплаты по производственной травме."]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Затраты"]},{"tag":"p","props":{},"children":["Никаких расходов нет, но придётся посетить несколько ведом…"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Польза"]},{"tag":"p","props":{},"children":["Остаток на счете накоплений на жилье (деньги, оставшиеся на его счете накоплений на жилье), который могут полу…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"Отметить: Необходимо поочередно получать деньги, находящиеся в разных местах: остаток по жилищному накопительному фонду (гунцзицзинь), выплаты по соцстраху и пособия в случае производственной травмы"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"Сделано"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"В планах"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"В избранное"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Поделиться советом"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Скрыть подробности"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Затраты"]},{"tag":"p","props":{},"children":["Никаких расходов нет, но придётся посетить несколько ведомств. Перед поездкой подготовьте свидетельство о смерти и документы, подтверждающие родственные связи."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Польза"]},{"tag":"p","props":{},"children":["Остаток на счете накоплений на жилье (деньги, оставшиеся на его счете накоплений на жилье), который могут получить наследники или лица, имеющие право на наследование по завещанию. Лицо, имеющее право на наследование по завещанию, — это человек, указанный в завещании как получатель имущества. В случае смерти на производстве предусмотрены еще три выплаты: пособие на погребение, пособие по случаю потери кормильца и единовременная выплата в связи со смертью работника. Согласно Закону о социальном страховании, средства, оставшиеся на личном счете пенсионного страхования, подлежат наследованию. В случае смерти работника, участвующего в системе пенсионного страхования, по причине болезни или не связанной с производством, члены семьи также могут получить пособие на погребение и пособие по случаю потери кормильца, что в совокупности называется выплатами по случаю потери кормильца. Стандарты для работников предприятий едины по всей стране. Пособие на погребение составляет 2 кратный среднемесячный располагаемый доход на душу населения городских жителей данной провинции за предыдущий год. Пособие по случаю потери кормильца рассчитывается на основе дохода за текущий месяц и выплачивается в размере от 3 до 24 месяцев страхового стажа: менее 5 лет и 3 месяцев, от 5 до 10 лет и 6 месяцев, от 10 до 15 лет и 9 месяцев, а за каждый дополнительный период свыше 15 лет добавляется 1 месяцев за каждые 1 лет, но не более 24 месяцев. Для лиц, уже вышедших на пенсию: за каждый 1 год получения пенсии размер выплаты уменьшается на 1 месяцев, но не менее чем на 9 месяцев."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Первоисточники"]},{"tag":"p","props":{"className":"life-citations"},"children":["国务院 (2026). 住房公积金管理条例（国务院令第 844 号修改，2026 年 9 月 20 日起施行）第二十四条末款. ",{"tag":"a","props":{"href":"https://www.gov.cn/gongbao/2026/issue_12946/202608/content_7079363.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/gongbao/2026/issue_12946/202608/content_7079363.html"]},"：「职工死亡或者被宣告死亡的，职工的继承人、受遗赠人可以提取职工住房公积金账户内的存储余额；无继承人也无受遗赠人的，职工住房公积金账户内的存储余额纳入住房公积金的增值收益。」；工伤保险条例第三十九条的三笔待遇见第 19 节. ",{"tag":"a","props":{"href":"https://www.gov.cn/gongbao/content/2011/content_1778064.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/gongbao/content/2011/content_1778064.htm"]},"；全国人大常委会 (2018 修正). 社会保险法（第十四、十七条）：「个人死亡的，个人账户余额可以继承」「参加基本养老保险的个人，因病或者非因工死亡的，其遗属可以领取丧葬补助金和抚恤金」. ",{"tag":"a","props":{"href":"https://flk.npc.gov.cn/detail?id=ff8080816f135f46016f210989b9179a","target":"_blank","rel":"noopener noreferrer"},"children":["https://flk.npc.gov.cn/detail?id=ff8080816f135f46016f210989b9179a"]},"（国家法律法规数据库）；人力资源社会保障部、财政部 (2021). 企业职工基本养老保险遗属待遇暂行办法（人社部发〔2021〕18 号，2021 年 9 月 1 日起施行，第四、五条），原件未公开挂网，条文按广州市花都区人民政府行政复议决定书（花都府行复〔2022〕226 号）的逐字引用核对：「丧葬补助金的标准，按照参保人员死亡时本省……上一年度城镇居民月人均可支配收入的2倍计算」「缴费年限不满5年的，发放月数为3个月……缴费年限30年以上的，按照30年计算，发放月数最高为24个月」. ",{"tag":"a","props":{"href":"https://www.huadu.gov.cn/xxgk/xzfy/content/post_8672730.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.huadu.gov.cn/xxgk/xzfy/content/post_8672730.html"]},"；福建省人力资源和社会保障厅. 常见问题：「每领取1年基本养老金减少1个月，发放月数最低为9个月」「累计缴费年限不足5年的，其遗属待遇（含丧葬补助金和抚恤金）标准不得超过其个人缴费之和」. ",{"tag":"a","props":{"href":"http://rst.fujian.gov.cn/wz/cjwt/czzgly/202311/t20231113_6294929.htm","target":"_blank","rel":"noopener noreferrer"},"children":["http://rst.fujian.gov.cn/wz/cjwt/czzgly/202311/t20231113_6294929.htm"]}]},{"tag":"a","props":{"href":"https://www.gov.cn/gongbao/2026/issue_12946/202608/content_7079363.html","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Открыть источник"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Примечание автора"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["О средствах на накопительном сберегательном счете забывают чаще всего, так как они не находятся на банковском счете и не включаются в распределение наследства автоматически. Остаток средств на личном счету пенсионного страхования и выплаты иждивенцам рассчитываются и выплачиваются отдельно; необходимо обращаться в окно обслуживания социального страхования по месту регистрации. Перечень необходимых документов различается в зависимости от региона. Если срок уплаты взносов составляет менее 5 лет, совокупный размер выплат иждивенцам не превышает сумму самостоятельно уплаченных им взносов. Данная формула взята из правил пенсионного страхования работников предприятий; по вопросам выплат иждивенцам в государственных учреждениях и системах пенсионного страхования городских и сельских жителей следует обращаться непосредственно в соответствующие ведомства. Требования к форме завещания и процедуре наследования см. в разделе 17."]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Моя заметка"]},{"tag":"button","props":{"type":"button"},"children":["Запишите напоминание…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/ru/tip/25-08"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Предыдущий"]},"Посредники, предоставляющие услуги по организации похорон, покупке предметов для похорон и проведению церемоний, должны быть зарегистрированы в органах гражданской администрации на уровне уезда"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/ru/tip/25-10"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Следующий"]},"Родственники умершего могут запрашивать доступ к аккаунту и личным данным, их копирование, исправление и удаление"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["Другие советы по этой теме"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/25-02"},"children":[{"tag":"strong","props":{},"children":["Свидетельство о смерти — ключ ко всем последующим процедурам: его выдают те, кто проводил лечение; при естественной смерти дома — местные учреждения общественного здравоохранения, выдача происходит в течение одного дня"]},{"tag":"span","props":{},"children":["Если человек умер в больнице, свидетельство выдаёт учреждение, которо…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/25-03"},"children":[{"tag":"strong","props":{},"children":["Перевозка, хранение и кремация тел могут осуществляться только в похоронных бюро; морги больниц такими услугами не занимаются, а хранение обычно не превышает 3 дней"]},{"tag":"span","props":{},"children":["Перевозку, хранение, бальзамирование, косметическую обработку и крема…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/25-04"},"children":[{"tag":"strong","props":{},"children":["При наличии сомнений в причине смерти необходимо назначить вскрытие в течение 48 часов и одновременно опечатать медицинскую документацию"]},{"tag":"span","props":{},"children":["Если у вас есть сомнения в причине смерти человека, нужно назначить в…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/25-05"},"children":[{"tag":"strong","props":{},"children":["Установлены законные сроки для снятия с учёта хукоу умершего: в городах — до момента захоронения, в сельской местности — в течение месяца"]},{"tag":"span","props":{},"children":["В городах снятие с учёта хукоу нужно провести до захоронения умершего…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/25-06"},"children":[{"tag":"strong","props":{},"children":["Похоронные услуги делятся на базовые и небазовые. Для базовых услуг существует утвержденный перечень, а их стоимость устанавливается согласно закону"]},{"tag":"span","props":{},"children":["Транспортировка тела, его временное хранение, прощание с умершим, кре…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/25-07"},"children":[{"tag":"strong","props":{},"children":["Запишите нарушения: принудительная продажа дополнительных услуг, доплаты сверх указанной цены, разбивка одной услуги на несколько позиций для взимания платы"]},{"tag":"span","props":{},"children":["Все эти действия относятся к нарушениям ценового законодательства: от…"]}]}]}]},{"tag":"a","props":{"className":"life-text-link","href":"/ru/book/25"},"children":["Читать всю тему: Что нужно сделать после смерти человека"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"15","height":"15","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]}]}]},{"tag":"nav","props":{"className":"life-tabbar","aria-label":"Основная навигация"},"children":[{"tag":"a","props":{"className":"","href":"/ru/book"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"21","height":"21","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-book-open","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M12 7v14"},"children":[]},{"tag":"path","props":{"d":"M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z"},"children":[]}]},{"tag":"span","props":{},"children":["Книга"]}]},{"tag":"a","props":{"className":"","href":"/ru/top-50"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"21","height":"21","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-star","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 2.122 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.122 2.122 0 0 0 1.5