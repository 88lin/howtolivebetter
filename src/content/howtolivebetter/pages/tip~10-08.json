n","props":{},"children":["11"]},"父母出资买房，在转账的时候就把是借是送写清楚"]},{"tag":"a","props":{"href":"/tip/10-12","className":""},"children":[{"tag":"span","props":{},"children":["12"]},"配偶一方大额借的钱，你没签字也没追认，不自动变成你的债"]},{"tag":"a","props":{"href":"/tip/10-13","className":""},"children":[{"tag":"span","props":{},"children":["13"]},"领证只要身份证加一份签字声明，不用户口簿，不收钱，当场发证"]},{"tag":"a","props":{"href":"/tip/10-14","className":""},"children":[{"tag":"span","props":{},"children":["14"]},"婚前做一次婚检，有重大疾病必须在登记前如实告诉对方"]},{"tag":"a","props":{"href":"/tip/10-15","className":""},"children":[{"tag":"span","props":{},"children":["15"]},"算退出成本：协议离婚有 30 天冷静期，诉讼离婚有法定条件"]},{"tag":"a","props":{"href":"/tip/10-16","className":""},"children":[{"tag":"span","props":{},"children":["16"]},"给「为长辈结婚」单独记一笔账，别和自己的账混在一起"]},{"tag":"a","props":{"href":"/tip/10-17","className":""},"children":[{"tag":"span","props":{},"children":["17"]},"把关系好坏当成一笔健康账：吵架对事不对人，别骂人、别挖苦"]},{"tag":"a","props":{"href":"/tip/10-18","className":""},"children":[{"tag":"span","props":{},"children":["18"]},"同性伴侣趁两个人都清醒，办好授权委托、意定监护和遗嘱：法律上你们不是近亲属，不办就没有签字权和继承权"]},{"tag":"a","props":{"href":"/tip/10-19","className":""},"children":[{"tag":"span","props":{},"children":["19"]},"别靠隐瞒性取向结婚，也别把形婚当成省事的办法：法律上它就是一段真婚姻，想退出只能走离婚"]},{"tag":"a","props":{"href":"/tip/10-20","className":""},"children":[{"tag":"span","props":{},"children":["20"]},"关系卡在反复吵架和冷战里，两个人一起去做伴侣治疗：干等着基本不会自己好"]},{"tag":"a","props":{"href":"/tip/10-21","className":""},"children":[{"tag":"span","props":{},"children":["21"]},"办了婚礼、摆了酒席，也要去领结婚证：没登记的在法律上不算夫妻，对方去世你没有配偶的继承权"]}]}]},{"tag":"div","props":{"className":"life-tip-page","data-tip-locales":"zh,en,ru,es,ja,vi"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"当前位置"},"children":[{"tag":"a","props":{"href":"/book"},"children":["阅读全书"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/book/10"},"children":["第 10 章 · 恋爱和结婚划不划算"]}]},{"tag":"article","props":{"className":"life-