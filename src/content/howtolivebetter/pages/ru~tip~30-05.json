ь полицию"]},{"tag":"span","props":{},"children":["Вероятность появления у ребёнка суицидальных мыслей примерно в 2,2 ра…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/30-07"},"children":[{"tag":"strong","props":{},"children":["Каждый год нужно внимательно изучать выданный школьникам медицинский осмотр — при выявлении отклонений в тот же год следует обратиться к врачу"]},{"tag":"span","props":{},"children":["В средних и младших школах ежегодно проводится один медицинский осмот…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/30-08"},"children":[{"tag":"strong","props":{},"children":["Проведение скрининга на депрессию для подростков 12–18 лет: не следует считать школьные психологические тесты диагнозом"]},{"tag":"span","props":{},"children":["Рабочая группа по профилактическим услугам США рекомендует проводить …"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/30-09"},"children":[{"tag":"strong","props":{},"children":["Не покупайте товары и услуги, которые якобы «излечивают близорукость» или «снижают степень близорукости»"]},{"tag":"span","props":{},"children":["В официальном заявлении Государственного управления по надзору за рын…"]}]}]}]},{"tag":"a","props":{"className":"life-text-link","href":"/ru/book/30"},"children":["Читать всю тему: Дети после поступления в школу"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"15","height":"15","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]}]}]}]},{"tag":"aside","props":{"className":"life-ad-space life-ad-space-sponsored","data-ad-placement":"ad_footer","data-ad-group":"reading","data-ad-creative":"read_product","data-ad-ready":"false","aria-labe