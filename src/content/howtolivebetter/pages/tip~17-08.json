:"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"已做到"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"加入待做"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"收藏"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"分享这条建议"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"收起详情"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["成本"]},{"tag":"p","props":{"className":"life-citations"},"children":["家用电动交替压力气垫床，几百元起。翻一次身只要几分钟。难的是每隔两三小时就得翻一次，夜里也不停，一个人扛不下来"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["收益"]},{"tag":"p","props":{"className":"life-citations"},"children":["19520 例髋部骨折手术患者（美国 NSQIP 2016 至 2019 年）。开刀前就有压疮的人，30 天内死亡的比例更高。把其他因素算进去之后，这个关联仍然成立（OR 1.2，几率增加 21%，P=0.004）。这些人还更容易出别的问题：深静脉血栓（OR 1.59）、肺炎（OR 1.39）、非计划再住院（OR 1.43），平均住院日也多 0.4 天。324 名住院老人（平均 86 岁）随访中位 18 个月。压疮能单独预测长期死亡（HR 1.500，95% CI 1.059 至 2.126，P=0.020）。单独预测的意思是，把别的因素排掉之后，它自己就能预测。65 项随机试验放在一起算（网络荟萃分析）。比的是电动主动气流支撑面和标准病床垫（标准病床支撑面）。电动主动气流支撑面就是电动气垫床这一类。用它的人压疮发生率更低（RR 0.42，95% CI 0.29 至 0.63，中等确定性）。电动混合气流支撑面是 RR 0.22（0.07 至 0.66）。11 项试验 4462 人的 Cochrane 综述（2026 年更新）。2 小时翻一次和 4 小时翻一次比，差别说不清（RR 1.05，95% CI 0.79 至 1.39，确定性极低）。其他翻身间隔之间的比较，同样极不确定。1226 名 ICU 患者的试验里，用可穿戴传感器实时提醒并给出视觉警示，把 2 小时翻一次真正落实下来。压疮发生率低于常规护理（RR 0.28，95% CI 0.10 至 0.75，中等确定性）。116 人的试验中，俯卧位（趴着）那组的压疮发生率高于仰卧位（平躺）那组（RR 4.55，95% CI 2.31 至 8.98）"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["来源"]},{"tag":"p","props":{"className":"life-citations"},"children":["Porter SB, Pla R, Chow JH, et al. (2022). Preoperative Pressure Ulcers, Mortality, and Complications in Older Hip Fracture Surgery Patients. JAAOS Global Research & Reviews, 6(11). ",{"tag":"a","props":{"href":"https://doi.org/10.5435/JAAOSGlobal-D-22-00117","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.5435/JAAOSGlobal-D-22-00117"]},"；Ottaviani S, Rondanina E, Longo E, 等 (2026). Impact of pressure ulcers and frailty on long-term mortality: a prospective cohort study of hospitalized older adults. European Geriatric Medicine, 17(2), 665-672. ",{"tag":"a","props":{"href":"https://doi.org/10.1007/s41999-025-01331-8","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1007/s41999-025-01331-8"]},"；Shi C, Dumville JC, Cullum N (2018). Support surfaces for pressure ulcer prevention: A network meta-analysis. PLoS ONE, 13(2), e0192707. ",{"tag":"a","props":{"href":"https://doi.org/10.1371/journal.pone.0192707","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1371/journal.pone.0192707"]},"；Latimer SL, Chaboyer WP, Probst S, 等 (2026). Repositioning for pressure injury prevention in adults. Cochrane Database of Systematic Reviews, 6, CD009958. ",{"tag":"a","props":{"href":"https://doi.org/10.1002/14651858.CD009958.pub4","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1002/14651858.CD009958.pub4"]},""]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["原书备注"]},{"tag":"p","props":{"className":"life-citations"},"children":["给 B 的原因有三条。一是死亡率那两项研究只看到「有压疮的人后来处境更差」，这不等于「防住压疮就能把死亡率降下来」。二是翻身间隔那几项随机试验的结论很不牢靠。三是气垫床那条证据要硬一些，但研究里比的是医院病床的垫子，套到家用床垫上属于往外推。每天查骶尾、足跟、髋部、肩背，看有没有「压下去不褪色的红」，这是护理的常规做法，没有单独的文献。长期护理保险能报的照护服务，见本节第 7 条。突然一条腿肿起来，按深静脉血栓处理，见第 13 节第 11 条。因坠落或重伤长期卧床的那一段，见第 1 节第 34 条"]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["我的备注"]},{"tag":"button","props":{"type":"button"},"children":["写下对自己有用的提醒…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/tip/17-07"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["上一条"]},"家里老人长期卧床或重度失能，去参保地医保部门申请长期护理保险；它不是只发给老人"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/tip/17-09"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["下一条"]},"老人的白内障已经影响看路，就去眼科评估做手术；两只眼都有的，第二只别拖太久"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["本主题的其他建议"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/17-02"},"children":[{"tag":"strong","props":{},"children":["把遗嘱立了，记住后立的推翻先立的，公证遗嘱不再优先"]},{"tag":"span","props":{},"children":["法律认六种遗嘱，但形式写错了整份作废，这是最常见的翻车点。自己手写的那种，要本人从头到尾手写，签上名，写清年月日。立了好几份、内容互相打架的，按最后立的那份算。…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/17-03"},"children":[{"tag":"strong","props":{},"children":["老人的钱单独放一个账户，大额支出定一个双人确认的规矩"]},{"tag":"span","props":{},"children":["骗老人的人常先送小礼物、嘘寒问暖，把信任攒足，再一次骗走大钱。骗子还常叮嘱「不要告诉任何人」。事先约好一条规矩：超过多少钱的支出，要先跟某个人说一声。这样家里人…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/17-04"},"children":[{"tag":"strong","props":{},"children":["给老人备好一句随时能说出口的推辞：「我要回去和家里人商量」"]},{"tag":"span","props":{},"children":["推销和诈骗靠的是现场压力，要你来不及想就掏钱。人一激动，就更容易信夸大的广告，老人比年轻人更容易被说动。事先和老人商量好一句「我要回去和家里人商量」。他随时能说…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/17-05"},"children":[{"tag":"strong","props":{},"children":["凡是让老人先交钱的「投资养老」都别碰：办卡、买床位、买养老公寓、旅居养老、买老年产品是同一套非法集资"]},{"tag":"span","props":{},"children":["让老人先交钱、又许诺回报的养老名目，都是同一套骗局：办卡、买床位、买养老公寓、旅居养老、开会卖老年产品。按规定，这种钱亏了只能自己认。有人借预定养老公寓床位收走…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/17-06"},"children":[{"tag":"strong","props":{},"children":["除了保险公司的住房反向抵押养老保险，其他「以房养老」都别碰，绝不抵押房子去买理财"]},{"tag":"span","props":{},"children":["正规的以房养老只有一种，就是保险公司的住房反向抵押养老保险，还在试点。上门推销的那种和它毫无关系，是骗老人抵押房子，再拿借来的钱买它推荐的理财。有人连房子被抵押…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/17-10"},"children":[{"tag":"strong","props":{},"children":["家里老人遛狗，把牵绳握在手心、别缠在手上，绳子收短，狗先训练到牵着不往前猛冲"]},{"tag":"span","props":{},"children":["美国 65 岁以上的人牵狗散步摔骨折的，一年从约 1700 人涨到约 4400 人，八成是女性。髋部是最常见的骨折部位，近三成要住院。被狗绳伤到手的，约四分之三…"]}]}]}]},{"tag":"a","props":{"className":"life-text-link","href":"/book/17"},"children":["阅读整个主题：家里有老人 ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"15","height":"15","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]}]}]},{"tag":"nav","props":{"className":"life-tabbar","aria-label":"主导航"},"children":[{"tag":"a","props":{"className":"","href":"/book"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"21","height":"21","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-book-open","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M12 7v14"},"children":[]},{"tag":"path","props":{"d":"M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z"},"children":[]}]},{"tag":"span","props":{},"children":["全书"]}]},{"tag":"a","props":{"className":"","href":"/top-50"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"21","height":"21","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-star","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 2.122 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.122 2.122 0 0 0 1.597-1.16z"},"children":[]}]},{"tag":"span","prop