do","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"加入待做"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"收藏"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"分享这条建议"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"收起详情"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["成本"]},{"tag":"p","props":{"className":"life-citations"},"children":["不花钱。申请人身安全保护令不交诉讼费，也不用交担保。要花的是报警、验伤、写申请的时间。最难的是对家里人开这个口。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["收益"]},{"tag":"p","props":{"className":"life-citations"},"children":["先说风险。66 个国家的数据合起来看（系统综述）。女性被杀的案子里，38.6% 是亲密伴侣干的，男性是 6.3%。作者说，这类命案往往是长期虐待的最后一步。另一项研究比较了 506 起命案和杀人未遂，还有 427 名挨过打但没出这种事的女性。以前被伴侣掐过脖子的，遭杀人未遂的几率是没被掐过的 6.70 倍（OR 6.70，95% CI 3.91–11.49）。被杀的几率是 7.48 倍（OR 7.48，95% CI 4.53–12.35）。再说法律。受害人和近亲属可以报警。公安机关要及时出警，制止家暴，调查取证，协助就医和验伤。情节较轻的，公安机关可以给对方出告诫书。遭受家暴或者面临家暴的现实危险，可以向法院申请人身安全保护令。法院受理后 72 小时内要作出裁定，情况紧急的 24 小时内。保护令可以禁止对方施暴，禁止对方骚扰、跟踪、接触你和你的近亲属，还可以让对方搬出你的住处。保护令最长管 6 个月，到期前可以申请延长。申请不以离婚为前提。法院认为家暴「存在较大可能性」就可以发。对方违反保护令，法院可以罚款 1000 元以下、拘留 15 日以下。构成犯罪的，按拒不执行判决、裁定罪处理。经常性的侮辱、威胁、跟踪、骚扰，还有挨冻挨饿，也算家暴。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["来源"]},{"tag":"p","props":{"className":"life-citations"},"children":["全国人大常委会 (2015). 反家庭暴力法（第二、十三、十五、十六、十九、二十三、二十八、二十九、三十、三十四条）. ",{"tag":"a","props":{"href":"https://flk.npc.gov.cn/detail?id=2c909fdd678bf17901678bf7f9d60889","target":"_blank","rel":"noopener noreferrer"},"children":["https://flk.npc.gov.cn/detail?id=2c909fdd678bf17901678bf7f9d60889"]},"；最高人民法院 (2022). 关于办理人身安全保护令案件适用法律若干问题的规定（法释〔2022〕17 号，第一、三、六、十、十二条）. ",{"tag":"a","props":{"href":"https://www.court.gov.cn/zixun/xiangqing/366021.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.court.gov.cn/zixun/xiangqing/366021.html"]},"；最高人民法院 (2016). 关于人身安全保护令案件相关程序问题的批复（法释〔2016〕15 号，第一、二项）. 平原县人民法院转载全文 ",{"tag":"a","props":{"href":"http://qdzy.sdcourt.gov.cn/dzpyfy/393141/393283/1461545/index.html","target":"_blank","rel":"noopener noreferrer"},"children":["http://qdzy.sdcourt.gov.cn/dzpyfy/393141/393283/1461545/index.html"]},"；Stöckl H 等 (2013). The global prevalence of intimate partner homicide: a systematic review. Lancet. ",{"tag":"a","props":{"href":"https://doi.org/10.1016/S0140-6736(13)61030-2","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1016/S0140-6736(13)61030-2"]},"；Glass N 等 (2008). Non-fatal strangulation is an important risk factor for homicide of women. Journal of Emergency Medicine. ",{"tag":"a","props":{"href":"https://doi.org/10.1016/j.jemermed.2007.02.065","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1016/j.jemermed.2007.02.065"]},""]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["原书备注"]},{"tag":"p","props":{"className":"life-citations"},"children":["受益人主要是你自己和家人。命案比例是国外数据，我国没有公开的同口径统计。证据要攒：出警记录、告诫书、验伤结果、看病记录、对方写的保证书、聊天记录和录音都能用。录音见本节第 41 条（录音）。保护令不用请律师，一般几天内就有结果。要离婚或者要赔偿，是另一场官司，一审普通程序 6 个月起，律师费自己出。家暴受害人可以找法律援助，法院也可以缓收、减收或者免收诉讼费。保护令不等于人身安全有了保证，眼前有危险先打 110。受害人被强迫、被吓住，没法自己申请的，近亲属、公安机关、妇联、居委会、村委会可以代为申请。受害的是朋友或同事，你可以陪对方去报警、去医院。看见陌生人家里有人正在挨打，打 110 就够了。别自己上手拉架，理由见本节第 10 条（冲突先报警）。"]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["我的备注"]},{"tag":"button","props":{"type":"button"},"children":["写下对自己有用的提醒…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/tip/08-42"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["上一条"]},"现场出了事，先拍全景，再拍位置关系，最后拍损坏和伤情，原图原视频别删"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/tip/08-44"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["下一条"]},"家里人赌博欠了债，别急着替他还：赌债法律不保护，为赌借的钱也不算夫妻共同债务"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["本主题的其他建议"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/08-38"},"children":[{"tag":"strong","props":{},"children":["「先给人买保险再动手」这条路法律上从头堵死：钱一分拿不到，罪按故意杀人加保险诈骗数罪并罚"]},{"tag":"span","props":{},"children":["四道门都是关着的。背着家人给他买以死亡为条件的保险，合同无效。投保人故意造成被保险人死亡的，保险公司不赔。故意杀害被继承人的，丧失继承权。刑法还把这种骗保单列一…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/08-39"},"children":[{"tag":"strong","props":{},"children":["报警当场要受案回执，不立案要书面通知：7 日内可申请复议，再 7 日可申请复核，检察院能通知公安立案"]},{"tag":"span","props":{},"children":["报了警要当场拿到受案回执，这是你报过案的唯一凭据。公安决定不立案，应当给你书面的不予立案通知书。不服可以 7 日内申请复议，还不服再 7 日内申请复核。你也可以…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/08-40"},"children":[{"tag":"strong","props":{},"children":["别给办案、执法的人送钱送卡：行贿自己也判，对监察、执法、司法人员行贿还要从重"]},{"tag":"span","props":{},"children":["「花点钱把事摆平」在刑法里是独立的罪，被抓的不只是收钱那个人。行贿判 3 年以下。情节严重的判 3 到 10 年，特别严重的判 10 年以上或者无期。对监察、行…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/08-41"},"children":[{"tag":"strong","props":{},"children":["可能翻脸的电话和面谈，直接开录音：自己参加的谈话，不用先征得对方同意"]},{"tag":"span","props":{},"children":["借钱、欠款、赔偿、退款、劳动纠纷，电话里说清楚了却没留下东西，几个月后双方就可能各说一套。你自己参加的谈话可以录下来，没提前告诉对方，不会单凭这一点就不能当证据…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/08-45"},"children":[{"tag":"strong","props":{},"children":["熟人让你「帮忙刷个脸、做个见证」去办贷款，或者要你念验证码，别答应：这叫 AB 贷，借款人是你，不是担保人"]},{"tag":"span","props":{},"children":["所谓「帮忙刷个脸、做个见证」，其实是用你的名字向银行借钱。借款人是你，不是担保人，钱转给熟人以后，银行照样找你还。中介骗了你，但只要银行不知情，这份借款合同你就…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/08-46"},"children":[{"tag":"strong","props":{},"children":["给门窗装好锁、门外装一盏感应灯，出门真的锁上：防入室盗窃靠这几样，单装一个报警器看不出用"]},{"tag":"span","props":{},"children":["英国的数据显示，门锁加窗锁的人家，被人进屋偷东西的几率只有什么都没装的十二分之一。再加一盏门外感应灯，降到三十多分之一。只装一个报警器、别的都不装，看不出能防盗…"]}]}]}]},{"tag":"a","props":{"className":"life-text-link","href":"/book/08"},"children":["阅读整个主题：别把自己搭进去：法律与财产安全 ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"15","height":"15","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]}]}]},{"tag":"nav","prop