"M7 17 17 7"},"children":[]}]}]}]}]},{"tag":"div","props":{"className":"life-ad-layout life-ad-layout-toc"},"children":[{"tag":"div","props":{"className":"life-ad-rail","data-dock-active":"false","style":{"top":"94px"}},"children":[{"tag":"div","props":{"className":"life-ad-dock","hidden":true},"children":[{"tag":"aside","props":{"className":"life-ad-space life-ad-space-sponsored life-ad-space-compact","data-ad-placement":"ad_dock","data-ad-group":"reading","data-ad-creative":"read_product","data-ad-ready":"false","aria-label":"Quảng cáo · Giới thiệu cộng đồng"},"children":[{"tag":"button","props":{"type":"button","className":"life-ad-dismiss","aria-label":"Đóng quảng cáo"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-x","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M18 6 6 18"},"children":[]},{"tag":"path","props":{"d":"m6 6 12 12"},"children":[]}]}]},{"tag":"div","props":{"className":"life-ad-space-brand"},"children":[{"tag":"img","props":{"src":"/sites/howtolivebetter/images/shengcai/logo.png","width":"565","height":"144","alt":"Logo chính thức của Shengcai Youshu","decoding":"async"},"children":[]}]},{"tag":"div","props":{"className":"life-ad-space-copy"},"children":[{"tag":"span","props":{"className":"life-ad-space-label"},"children":["Quảng cáo · Giới thiệu cộng đồng"]},{"tag":"strong","props":{},"children":["Kiến thức bạn có thể thành sản phẩm hữu ích không?"]},{"tag":"p","props":{},"children":["Từ sách điện tử đến công cụ nhỏ: xem cách thành viên tìm nhu cầu và biến kiến thức thành thứ dùng được."]}]},{"tag":"div","props":{"className":"life-ad-space-actions"},"children":[{"tag":"a","props":{"className":"life-ad-space-link","href":"/vi/shengcaiyoushu?sc_group=reading&sc_creative=read_product&sc_placement=ad_dock"},"children":["Xem cộng đồng và các ví dụ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"18","height":"18","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-up-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M7 7h10v10"},"children":[]},{"tag":"path","props":{"d":"M7 17 17 7"},"children":[]}]}]}]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/vi/book/12"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"Quay lại mục lục"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["Khởi nghiệp: đừng làm mất khoản tiết kiệm của gia đình"]},{"tag":"div","props":{"data-ad-dock-host":"true"},"children":[]},{"tag":"nav","props":{"aria-label":"Các mục trong chương"},"children":[{"tag":"a","props":{"href":"/vi/tip/12-01"},"children":[{"tag":"span","props":{},"children":["01"]},"Chỉ dùng số tiền mà lỡ mất trắng vẫn chịu được để khởi nghiệp, không đụng vốn của cả nhà, không vay tiền để mở hàng"]},{"tag":"a","props":{"href":"/vi/tip/12-02"},"children":[{"tag":"span","props":{},"children":["02"]},"Đừng ký bảo đảm cá nhân cho khoản vay của công ty, người phối ngẫu càng đừng ký theo"]},{"tag":"a","props":{"href":"/vi/tip/12-03"},"children":[{"tag":"span","props":{},"children":["03"]},"Chọn đúng loại hình kinh doanh trước khi mở hàng: hộ cá thể và cổ phần công chung phải trả đến cùng, chỉ công ty hữu hạn mới「hữu hạn」"]},{"tag":"a","props":{"href":"/vi/tip/12-04"},"children":[{"tag":"span","props":{},"children":["04"]},"Đừng làm cổ phân danh nghĩa, đừng giữ cổ phần thay người khác"]},{"tag":"a","props":{"href":"/vi/tip/12-05"},"children":[{"tag":"span","props":{},"children":["05"]},"Trước khi nhượng quyền, kiểm tra hồ sơ đăng ký ở Bộ Thương mại, lấy bản công bố bằng văn bản, ghi「thời gian cân nhắc」vào hợp đồng"]},{"tag":"a","props":{"href":"/vi/tip/12-06"},"children":[{"tag":"span","props":{},"children":["06"]},"Trước khi đăng ký, chốt tên, địa điểm kinh doanh, phạm vi kinh doanh và vốn đăng ký, đủ hồ sơ thì lấy được giấy phép ngay tại chỗ"]},{"tag":"a","props":{"href":"/vi/tip/12-07"},"children":[{"tag":"span","props":{},"children":["07"]},"Ngành cần giấy phép thì chưa có giấy thì không khai trương"]},{"tag":"a","props":{"href":"/vi/tip/12-08"},"children":[{"tag":"span","props":{},"children":["08"]},"Làm thực phẩm thì xem trước mình ở bậc nào: sản xuất và ăn uống phải có giấy phép, chỉ bán đóng gói sẵn thì kê khai, bán thịt rau tươi không cần giấy"]},{"tag":"a","props":{"href":"/vi/tip/12-09"},"children":[{"tag":"span","props":{},"children":["09"]},"Đóng túi để bán thì là thực phẩm đóng gói sẵn: trên nhãn, ngày sản xuất, hạn sử dụng, bảng thành phần thiếu mục nào cũng không được"]},{"tag":"a","props":{"href":"/vi/tip/12-10"},"children":[{"tag":"span","props":{},"children":["10"]},"Thực phẩm thường không được nói là chữa bệnh: nhãn, hướng dẫn, quảng cáo và lời livestream đều tính"]},{"tag":"a","props":{"href":"/vi/tip/12-11"},"children":[{"tag":"span","props":{},"children":["11"]},"Ngành thực phẩm có đường ranh giới hình sự: bán thịt chết bệnh, hàng vượt tiêu chuẩn là đủ thành tội, trộn thêm nguyên liệu độc hại thì không tính tiền, khởi tội năm năm"]},{"tag":"a","props":{"href":"/vi/tip/12-12"},"children":[{"tag":"span","props":{},"children":["12"]},"Có giấy phép là bắt đầu có nghĩa vụ kê khai, không có doanh thu vẫn phải kê khai đúng hạn (nộp một tờ toàn số không)"]},{"tag":"a","props":{"href":"/vi/tip/12-13"},"children":[{"tag":"span","props":{},"children":["13"]},"Hoá đơn chỉ xuất theo giao dịch thật, người nộp thuế quy mô nhỏ hãy dùng hết ngưỡng miễn thuế"]},{"tag":"a","props":{"href":"/vi/tip/12-14"},"children":[{"tag":"span","props":{},"children":["14"]},"Ai tự xưng cơ quan thuế đòi bạn nộp tiền khai thuế đều là lừa đảo, làm thủ tục thuế chỉ đi qua cổng thuế điện tử và 12366"]},{"tag":"a","props":{"href":"/vi/tip/12-15"},"children":[{"tag":"span","props":{},"children":["15"]},"Nhận tiền thì viết「定金」chứ đừng viết「订金」, tiền phạt vi phạm phải ghi rõ con số, hạn thanh toán thì soi như cho vay"]},{"tag":"a","props":{"href":"/vi/tip/12-16"},"children":[{"tag":"span","props":{},"children":["16"]},"Người lao động tháng đầu phải ký hợp đồng bằng văn bản, 30 ngày đăng ký bảo hiểm xã hội"]},{"tag":"a","props":{"href":"/vi/tip/12-17"},"children":[{"tag":"span","props":{},"children":["17"]},"Lương trả theo hợp đồng và theo pháp luật, tăng lương, cho vay, thưởng đều phải qua văn bản"]},{"tag":"a","props":{"href":"/vi/tip/12-18"},"children":[{"tag":"span","props":{},"children":["18"]},"Bán trước rồi mới sản xuất: dùng bán trước và đơn nhỏ để kiểm chứng có người mua, rồi mới bỏ tiền vào sản xuất"]},{"tag":"a","props":{"href":"/vi/tip/12-19"},"children":[{"tag":"span","props":{},"children":["19"]},"Làm xong mẫu thì so qua danh sách sản xuất hàng loạt, rồi hãy nói chuyện khoảng sản xuất"]},{"tag":"a","props":{"href":"/vi/tip/12-20"},"children":[{"tag":"span","props":{},"children":["20"]},"Mỗi lô hàng nhập về để lại một bộ hoá đơn và thông tin nhà cung cấp, giá nhập thấp hơn hẳn giá thị trường thì không nhập: hàng giả do nhân viên mua, người bị kết án là chủ"]},{"tag":"a","props":{"href":"/vi/tip/12-21"},"children":[{"tag":"span","props":{},"children":["21"]},"Hình ảnh trên hàng, bao bì, treo thẻ và ảnh quảng cáo thì tự làm hoặc mua giấy uỷ quyền, đổi màu, thêm biểu tượng không tính là「đã sửa」"]},{"tag":"a","props":{"href":"/vi/tip/12-22"},"children":[{"tag":"span","props":{},"children":["22"]},"Ở đúng vị trí thì làm theo quy trình, còn cái thiện ý ngoài quy trình thì nghĩ kỹ trách nhiệm thuộc về ai"]},{"tag":"a","props":{"href":"/vi/tip/12-23"},"children":[{"tag":"span","props":{},"children":["23"]},"Lỗ thì rút lui theo thủ tục: huỷ được kiểu rút gọn thì huỷ, vỡ nợ thì đi phá sản, đừng để yên"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/vi/tip/12-24","data-status":"active"},"children":[{"tag":"span","props":{},"children":["24"]},"Trước khi chi tiền thuê người khác quản lý cửa hàng trực tuyến, tham gia khóa đào tạo mở cửa hàng, hoặc thực hiện mô hình 'không nguồn hàng', hãy hỏi rõ liệu sau này có phải trả thêm tiền hay không, và nguồn doanh số sẽ đến từ đâu"]},{"tag":"a","props":{"href":"/vi/tip/12-25"},"children":[{"tag":"span","props":{},"children":["25"]},"Mở công ty hoặc hộ cá thể ở Trung Quốc: từ 1 tháng 1 đến 30 tháng 6 nộp báo cáo năm trước qua mạng, không kinh doanh cũng phải nộp, không mất phí"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"Breadcrumbs"},"children":[{"tag":"a","props":{"href":"/vi/book"},"children":["Khám phá cuốn sách"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/vi/book/12"},"children":["Chương 12"," ·"," ","Khởi nghiệp: đừng làm mất khoản tiết kiệm của gia đình"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"12-24"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["24"]},{"tag":"span","props":{"className":"life-evidence grade-b"},"children":["Bằng chứng"," ","B"]}]},{"tag":"h1","props":{"lang":"vi"},"children":["Trước khi chi tiền thuê người khác quản lý cửa hàng trực tuyến, tham gia khóa đào tạo mở cửa hàng, hoặc thực hiện mô hình 'không nguồn hàng', hãy hỏi rõ liệu sau này có phải trả thêm tiền hay không, và nguồn doanh số sẽ đến từ đâu"]},{"tag":"p","props":{"lang":"vi","className":"life-entry-summary"},"children":["Loại lừa đảo này thường thu một khoản nhỏ trước, rồi lấy cớ “nâng cấp gói”, ứng tiền hàng hoặc nộp phí mở khóa để yêu cầu bạn trả thêm nhiều lần. Đơn hàng và doanh thu trong hệ thống có thể là giả; đến lúc muốn rút tiền thì không rút được. Tạo giao dịch giả để đẩy doanh số cũng là hành vi trái pháp luật; bên vận hành hộ có thể bị xử phạt."]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Chi phí"]},{"tag":"p","props":{},"children":["Không cần chi phí. Trước khi chuyển tiền, cần yêu cầu ba đ…"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Lợi ích"]},{"tag":"p","props":{},"children":["Tòa án Nhân dân Cấp cao tỉnh Quảng Đông từng xử lý một vụ lừa đảo về dịch vụ đại lý vận hành. một nhóm 55 ngườ…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"Đánh dấu: Trước khi chi tiền thuê người khác quản lý cửa hàng trực tuyến, tham gia khóa đào tạo mở cửa hàng, hoặc thực hiện mô hình 'không nguồn hàng', hãy hỏi rõ liệu sau này có phải trả thêm tiền hay không, và nguồn doanh số sẽ đến từ đâu"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"Hoàn tất"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"Kế hoạch thực hiện"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"Lưu"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Chia sẻ mẹo này"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Ẩn chi tiết"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Chi phí"]},{"tag":"p","props":{},"children":["Không cần chi phí. Trước khi chuyển tiền, cần yêu cầu ba điều: hợp đồng bằng văn bản, tên đầy đủ của công ty đối phương và điều kiện hoàn tiền. Tiền chỉ nên chuyển cho công ty được ghi trong hợp đồng, không chuyển cho tài khoản cá nhân. Khó khăn là khi đối phương đưa ra hình ảnh chụp màn hình \"học viên thu nhập hàng vạn nhân dân tệ mỗi tháng\", cần kiềm chế không chuyển tiền ngay lập tức."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Lợi ích"]},{"tag":"p","props":{},"children":["Tòa án Nhân dân Cấp cao tỉnh Quảng Đông từng xử lý một vụ lừa đảo về dịch vụ đại lý vận hành. một nhóm 55 người đã mở nhiều công ty tại Quảng Châu, Nam Ninh và Hàng Châu. Tòa án xác định họ «biết rõ hoàn toàn không có năng lực và điều kiện kỹ thuật để đại lý vận hành thương mại điện tử». Dù vậy, họ vẫn dùng danh nghĩa cung cấp dịch vụ đại lý vận hành cho cửa hàng Taobao để lừa 7.711 nạn nhân mua và nâng cấp «gói dịch vụ». Tổng số tiền lừa đảo là hơn 52.994.000 nhân dân tệ. Hai thủ phạm chính bị tuyên án 14 năm và 13 năm 6 tháng vì tội lừa đảo. Tòa án nói rằng «bẫy lừa được thiết kế rất tinh vi», «nhiều nạn nhân bị lừa nhiều lần». Vào năm 2025, Cục Cảnh sát Công an tỉnh Giang Tô đã phân tích vụ lừa đảo thương mại điện tử «không cần tồn kho» thành bốn bước. Bước một: Gửi thông tin «không cần kinh nghiệm» và «không cần tích trữ hàng hóa» trên nền tảng giao tiếp xã hội. Bước hai: Với danh nghĩa «hướng dẫn vận hành», thêm bạn vào danh sách và yêu cầu bạn tải nền tảng chỉ định. Bước ba: Sau khi bạn mở cửa hàng, bạn sẽ nhanh chóng có được đơn hàng đầu tiên. Đối phương yêu cầu bạn trả tiền mặt hàng theo giá gốc, nói rằng tiền của khách hàng bị đóng băng trên nền tảng, và giải phóng sau khi nhận hàng. Sau đó, họ tạo ra nhiều đơn hàng giả, khiến bạn phải liên tục đưa tiền. Bước bốn: Khi bạn muốn rút tiền, họ nói «tài khoản có vấn đề» hoặc «hệ thống bảo trì», yêu cầu bạn trả thêm tiền giải phóng và phí dịch vụ. Trong ví dụ này, bà Trương đã liên tục đưa vào hơn 900.000 nhân dân tệ, nhưng chỉ sau 3 ngày, trang web đã không thể truy cập được. Về phía gian lận đánh giá: Một công ty đại lý vận hành tổ chức các cuộc mua sắm giả để tăng thứ hạng. Cơ quan quản lý thị trường đã phạt 100.000 nhân dân tệ, nền tảng đã giữ lại 50.000 nhân dân tệ tiền đặt cọc, và tòa án ủng hộ việc nền tảng giữ lại tiền. Vào năm 2026, Tòa án Tối cao đã đưa vụ này vào các ví dụ điển hình, nói rõ «giao dịch giả tạo, gian lận đánh giá là hành vi bị pháp luật cấm rõ ràng». Vào năm 2025, Cục Quản lý Thị trường cũng từng công bố một vụ án. Một công ty bán phần mềm «chuyển cửa hàng một nút» và «đại lý phát hàng một nút», lấy thông tin sản phẩm từ nền tảng khác để đăng lên, bị phạt 530.000 nhân dân tệ. Cục Quản lý Thị trường cảnh báo các doanh nghiệp «không được thực hiện các hành vi vi phạm pháp luật như «chuyển cửa hàng trộm» và «kinh doanh không cần tồn kho»». Giải pháp nằm trong Bộ luật Dân sự: Hợp đồng mà bạn ký dưới sự lừa đảo của bên kia có thể được yêu cầu hủy bỏ bởi tòa án hoặc cơ quan trọng tài. Bạn phải yêu cầu hủy bỏ trong vòng 1 năm kể từ ngày biết mình bị lừa. Sau khi hủy bỏ, tiền mà bên kia đã nhận được phải được hoàn trả (toàn quốc)."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Nguồn gốc"]},{"tag":"p","props":{"className":"life-citations"},"children":["广东省高级人民法院 (2023). 广东法院打击治理电信网络诈骗犯罪典型案例（案例三：蒋某、徐某等 55 人犯罪集团诈骗案）. ",{"tag":"a","props":{"href":"https://www.gdcourts.gov.cn/gsxx/quanweifabu/anlihuicui/content/post_1388464.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gdcourts.gov.cn/gsxx/quanweifabu/anlihuicui/content/post_1388464.html"]},"；江苏省公安厅 (2025). 防范提示：无货源跨境电商，当心有诈！. ",{"tag":"a","props":{"href":"https://gat.jiangsu.gov.cn/art/2025/2/13/art_89956_11491354.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://gat.jiangsu.gov.cn/art/2025/2/13/art_89956_11491354.html"]},"；最高人民法院 (2026). 最高人民法院发布依法规范平台经营、保护消费者合法权益典型案例（案例三：某代运营商诉某平台服务合同纠纷案）. ",{"tag":"a","props":{"href":"https://www.court.gov.cn/zixun/xiangqing/507691.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.court.gov.cn/zixun/xiangqing/507691.html"]},"；市场监管总局 (2025). 市场监管总局公布五起网络不正当竞争典型案例（案例一）. ",{"tag":"a","props":{"href":"https://www.samr.gov.cn/xw/zj/art/2025/art_0d043840ec9445a689496bcf30c94820.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.samr.gov.cn/xw/zj/art/2025/art_0d043840ec9445a689496bcf30c94820.html"]},"；全国人大 (2020). 民法典（第一百四十八、一百五十二、一百五十七条）. ",{"tag":"a","props":{"href":"https://www.spp.gov.cn/spp/fl/202006/t20200602_463888.shtml","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.spp.gov.cn/spp/fl/202006/t20200602_463888.shtml"]}]},{"tag":"a","props":{"href":"https://www.gdcourts.gov.cn/gsxx/quanweifabu/anlihuicui/content/post_1388464.html","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Liên kết mở nguồn"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Ghi chú sách"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["Nhìn thấy các từ như 「không cần kinh nghiệm」「không cần tích hàng」「đầu tư thấp, lợi nhuận cao」「đảm bảo lợi nhuận」, trước tiên hãy dừng lại. Những người yêu cầu bạn đưa tiền vào nền tảng được họ chỉ định cũng nên dừng lại. Trước khi chuyển tiền, hãy tra cứu giấy phép kinh doanh và lịch sử xử phạt của bên kia qua hệ thống công khai thông tin doanh nghiệp quốc gia. Ghi rõ trong hợp đồng nội dung dịch vụ và cách hoàn tiền nếu không đạt được kết quả. Lưu lại các tin nhắn, hợp đồng và hình ảnh chuyển tiền. Nếu đã chuyển tiền, hãy gọi ngay 110 hoặc 96110 để yêu cầu tạm dừng thanh toán, tham khảo mục 8.2 (phòng tránh bị lừa đảo và yêu cầu tạm dừng thanh toán). Nếu bên kia thực sự đã làm việc nhưng kết quả không như mong đợi, phần lớn sẽ là tranh chấp hợp đồng, cần thương lượng, khiếu nại hoặc khởi kiện. Để hủy hợp đồng, bạn sẽ phải kiện ra tòa, thủ tục sơ thẩm thường mất ít nhất 6 tháng, phí luật sư do bạn tự chi trả, và có thể bên kia đã bỏ trốn khi phán quyết ra đời. Những trường hợp thu tiền dưới danh nghĩa liên doanh, trước hết hãy kiểm tra thông tin đăng ký tại Bộ Thương mại theo mục 5 (trước khi ký hợp đồng liên doanh, hãy kiểm tra đăng ký tại Bộ Thương mại). Người hưởng lợi chính là bạn."]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Ghi chú của tôi"]},{"tag":"button","props":{"type":"button"},"children":["Viết một lời nhắc cho chính bạn…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/vi/tip/12-23"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Trước"]},"Lỗ thì rút lui theo thủ tục: huỷ được kiểu rút gọn thì huỷ, vỡ nợ thì đi phá sản, đừng để yên"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/vi/tip/12-25"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Tiếp theo"]},"Mở công ty hoặc hộ cá thể ở Trung Quốc: từ 1 tháng 1 đến 30 tháng 6 nộp báo cáo năm trước qua mạng, không kinh doanh cũng phải nộp, không mất phí"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["Thêm trong chủ đề này"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/12-17"},"children":[{"tag":"strong","props":{},"children":["Lương trả theo hợp đồng và theo pháp luật, tăng lương, cho vay, thưởng đều phải qua văn bản"]},{"tag":"span","props":{},"children":["Lương phải trả đúng hạn, đủ số, theo hợp đồng và theo pháp luật. Nợ l…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/12-18"},"children":[{"tag":"strong","props":{},"children":["Bán trước rồi mới sản xuất: dùng bán trước và đơn nhỏ để kiểm chứng có người mua, rồi mới bỏ tiền vào sản xuất"]},{"tag":"span","props":{},"children":["Có người theo dõi 116 công ty mới ở Italia khoảng một năm: người khởi…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/12-19"},"children":[{"tag":"strong","props":{},"children":["Làm xong mẫu thì so qua danh sách sản xuất hàng loạt, rồi hãy nói chuyện khoảng sản xuất"]},{"tag":"span","props":{},"children":["Khác biệt giữa một mẫu và một nghìn cái nằm ở chỗ tiền bị kẹp ở đâu. …"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/12-20"},"children":[{"tag":"strong","props":{},"children":["Mỗi lô hàng nhập về để lại một bộ hoá đơn và thông tin nhà cung cấp, giá nhập thấp hơn hẳn giá thị trường thì không nhập: hàng giả do nhân viên mua, người bị kết án là chủ"]},{"tag":"span","props":{},"children":["Bán hàng giả, thu được 3 vạn, hoặc bán đến mức 5 vạn, là đủ bị kết án…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/12-21"},"children":[{"tag":"strong","props":{},"children":["Hình ảnh trên hàng, bao bì, treo thẻ và ảnh quảng cáo thì tự làm hoặc mua giấy uỷ quyền, đổi màu, thêm biểu tượng không tính là「đã sửa」"]},{"tag":"span","props":{},"children":["Sửa màu trên ảnh của người khác, đổi nền, thêm biểu tượng của mình, v…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/12-22"},"children":[{"tag":"strong","props":{},"children":["Ở đúng vị trí thì làm theo quy trình, còn cái thiện ý ngoài quy trình thì nghĩ kỹ trách nhiệm thuộc về ai"]},{"tag":"span","props":{},"children":["Lấy y tá làm ví dụ: quy định ghi rõ, phát hiện bệnh nhân lâm ng