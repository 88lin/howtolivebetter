{"path":"/tip/27-01","title":"准备怀孕就开始每天补 0.4 毫克叶酸，一直吃到孕早期满 3 个月 | HowToLiveBetter","description":"怀孕前后每天吃一粒叶酸，孩子出现神经管缺陷的概率大约能降七成。神经管缺陷就是无脑儿、脊柱裂这一类的出生缺陷。已经生过一个这样的孩子的人，再生一个还出问题的概率，大约降到原来的三分之一。","lang":"zh","styles":["/sites/howtolivebetter/styles/bca54bebe9c1bd3b.css"],"bodyClass":"font-sans antialiased","nodes":[{"tag":"div","props":{"className":"life-site"},"children":[{"tag":"div","props":{"className":"life-header-slot","aria-hidden":"true"},"children":[]},{"tag":"header","props":{"className":"life-header"},"children":[{"tag":"div","props":{"className":"life-header-inner"},"children":[{"tag":"a","props":{"className":"life-brand","aria-label":"H ✳ HowToLiveBetter 首页","href":"/"},"children":[{"tag":"span","props":{"className":"life-brand-mark","aria-hidden":"true"},"children":["H",{"tag":"span","props":{},"children":["✳"]}]},{"tag":"span","props":{},"children":["HowToLive",{"tag":"span","props":{},"children":["Better"]}]}]},{"tag":"nav","props":{"className":"life-nav","aria-label":"主导航"},"children":[{"tag":"a","props":{"className":"life-nav-link","href":"/book"},"children":[{"tag":"span","props":{},"children":["阅读全书"]}]},{"tag":"a","props":{"className":"life-nav-link","href":"/top-50"},"children":[{"tag":"span","props":{},"children":["精选 50 条"]}]},{"tag":"a","props":{"className":"life-nav-link","href":"/daily"},"children":[{"tag":"span","props":{},"children":["每日任务"]}]},{"tag":"a","props":{"className":"life-nav-link","href":"/dashboard"},"children":[{"tag":"span","props":{},"children":["我的清单"]}]},{"tag":"button","props":{"type":"button","className":"life-nav-link life-nav-more","aria-haspopup":"menu","aria-expanded":"false"},"children":[{"tag":"span","props":{},"children":["更多"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"15","height":"15","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down","aria-hidden":"true"},"children":[{"ta