de lucide-circle-user-round","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M18 20a6 6 0 0 0-12 0"},"children":[]},{"tag":"circle","props":{"cx":"12","cy":"10","r":"4"},"children":[]},{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},{"tag":"span","props":{},"children":["Đăng nhập để đồng bộ hóa"]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/vi/book/19"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"Quay lại mục lục"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["Đi làm, nghỉ việc và tai nạn lao động"]},{"tag":"nav","props":{"aria-label":"Các mục trong chương"},"children":[{"tag":"a","props":{"href":"/vi/tip/19-01"},"children":[{"tag":"span","props":{},"children":["01"]},"Tiền làm thêm giờ tính theo ba mức 1.5 lần, 2 lần, 3 lần; không trả thì báo thanh tra lao động, quá hạn không trả còn phải cộng thêm 50% đến 100%"]},{"tag":"a","props":{"href":"/vi/tip/19-02"},"children":[{"tag":"span","props":{},"children":["02"]},"Nghỉ phép năm tính theo thâm niên cộng dồn: 5, 10, 15 ngày; nghỉ không được thì đổi thành tiền bằng 300% lương ngày"]},{"tag":"a","props":{"href":"/vi/tip/19-03"},"children":[{"tag":"span","props":{},"children":["03"]},"Thời gian thử việc có trần theo luật, lương không được dưới 80%, và chỉ được thỏa thuận một lần"]},{"tag":"a","props":{"href":"/vi/tip/19-04"},"children":[{"tag":"span","props":{},"children":["04"]},"Bị sa thải thì tính rõ N trước: cứ mỗi năm làm đủ một năm thì một tháng lương, chưa đủ sáu tháng thì tính nửa tháng"]},{"tag":"a","props":{"href":"/vi/tip/19-05"},"children":[{"tag":"span","props":{},"children":["05"]},"Công ty sa thải bạn mà không báo trước 30 ngày thì còn phải trả thêm một tháng lương"]},{"tag":"a","props":{"href":"/vi/tip/19-06"},"children":[{"tag":"span","props":{},"children":["06"]},"Công ty chấm dứt hợp đồng sai luật thì tiền bồi thường bằng hai lần mức bồi thường kinh tế"]},{"tag":"a","props":{"href":"/vi/tip/19-07"},"children":[{"tag":"span","props":{},"children":["07"]},"Đừng ký「tự nguyện nghỉ việc vì lý do cá nhân」, ký là mất trắng cả khoản N"]},{"tag":"a","props":{"href":"/vi/tip/19-08"},"children":[{"tag":"span","props":{},"children":["08"]},"Trước khi nghỉ việc thì lưu trước phiếu lương, bản chấm công, hợp đồng lao động, hồ sơ bảo hiểm xã hội và lịch sử trò chuyện"]},{"tag":"a","props":{"href":"/vi/tip/19-09"},"children":[{"tag":"span","props":{},"children":["09"]},"Trước khi vào chỗ có bụi, tiếng ồn, hoá chất thì xem trong hợp đồng đã ghi nguy cơ chưa; ba kỳ khám sức khoẻ nghề nghiệp do đơn vị sắp xếp và bỏ tiền"]},{"tag":"a","props":{"href":"/vi/tip/19-10"},"children":[{"tag":"span","props":{},"children":["10"]},"Tổn thương do bụi, tiếng ồn, chất độc hoá học thì không hồi phục được: đơn vị phải cấp đồ dùng bảo vệ, công việc không có biện pháp bảo vệ thì được từ chối"]},{"tag":"a","props":{"href":"/vi/tip/19-11"},"children":[{"tag":"span","props":{},"children":["11"]},"Bị thương lúc làm việc, hay bị xe đâm trên đường đi làm về: việc đầu tiên là xin xác nhận tai nạn lao động, đơn vị không báo thì bạn tự báo"]},{"tag":"a","props":{"href":"/vi/tip/19-12"},"children":[{"tag":"span","props":{},"children":["12"]},"Đừng tin「leo tới bàn giấy là được coi là tai nạn lao động」: thấy khó chịu đột ngột thì gọi 120 trước, đừng chạy tới chấm công"]},{"tag":"a","props":{"href":"/vi/tip/19-13"},"children":[{"tag":"span","props":{},"children":["13"]},"Đơn vị không đóng bảo hiểm tai nạn lao động cho bạn thì ưu đãi tai nạn lao động vẫn có, và do đơn vị trả đủ theo đúng tiêu chuẩn"]},{"tag":"a","props":{"href":"/vi/tip/19-14"},"children":[{"tag":"span","props":{},"children":["14"]},"Khi tình trạng thương tích đã ổn định thì đi đánh giá năng lực lao động, hạng khuyết tật quy đổi thẳng thành tiền"]},{"tag":"a","props":{"href":"/vi/tip/19-15"},"children":[{"tag":"span","props":{},"children":["15"]},"Phải phân biệt ba khoản tiền khi chết vì tai nạn lao động: tiền trợ cấp mai táng, tiền trợ cấp hưu trí người được nuôi dưỡng, tiền trợ cấp một lần khi chết vì tai nạn lao động"]},{"tag":"a","props":{"href":"/vi/tip/19-16"},"children":[{"tag":"span","props":{},"children":["16"]},"Ở công ty lâu ngày bị bắt nạt, mắng, gây khó, đừng gồng chịu: ghi lại để có chứng cứ, rồi tuỳ tính chất mà khiếu nại, báo công an hoặc đi hoà giải"]},{"tag":"a","props":{"href":"/vi/tip/19-17"},"children":[{"tag":"span","props":{},"children":["17"]},"Lúc nghỉ việc thì xin đơn vị một giấy xác nhận nghỉ việc, ghi rõ thời hạn hợp đồng, ngày nghỉ việc, vị trí và số năm đã làm"]},{"tag":"a","props":{"href":"/vi/tip/19-18"},"children":[{"tag":"span","props":{},"children":["18"]},"Nhận tiền bồi thường khi nghỉ việc thì xem thuế thu nhập cá nhân trước: phần trong 3 mức lương bình quân người lao động của năm trước ở địa phương thì miễn thuế, phần vượt ra tính riêng, không gộp vào thu nhập của năm đó"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/vi/tip/19-19","data-status":"active"},"children":[{"tag":"span","props":{},"children":["19"]},"Đổi thành phố làm việc thì chuyển quan hệ bảo hiểm hưu trí và y tế sang nơi tham gia mới, số năm đóng tiếp tục cộng dồn, đừng hủy bảo hiểm để rút tiền"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"Breadcrumbs"},"children":[{"tag":"a","props":{"href":"/vi/book"},"children":["Khám phá cuốn sách"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/vi/book/19"},"children":["Chương 19"," ·"," ","Đi làm, nghỉ việc và tai nạn lao động"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"19-19"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["19"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["Bằng chứng"," ","A"]}]},{"tag":"h1","props":{"lang":"vi"},"children":["Đổi thành phố làm việc thì chuyển quan hệ bảo hiểm hưu trí và y tế sang nơi tham gia mới, số năm đóng tiếp tục cộng dồn, đừng hủy bảo hiểm để rút tiền"]},{"tag":"p","props":{"lang":"vi","className":"life-entry-summary"},"children":["Đổi thành phố làm việc, quan hệ bảo hiểm hưu trí và y tế đều có thể đi theo bạn, số năm đã đóng tiếp tục cộng thêm. Chưa đến tuổi nhận lương hưu thì không được hủy bảo hiểm để rút tiền. Gián đoạn đóng bảo hiểm y tế quá 3 tháng, ở nơi mới có thể phải chờ tối đa 6 tháng mới được thanh toán chi phí, nên đừng để trống quá lâu."]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Chi phí"]},{"tag":"p","props":{},"children":["Không tốn tiền. Sau khi tham gia và đóng bảo hiểm ở nơi mớ…"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Lợi ích"]},{"tag":"p","props":{},"children":["Luật Bảo hiểm xã hội quy định rằng khi đổi nơi làm việc —tên chính thức là chuyển giữa các khu vực quản lý quỹ…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"Đánh dấu: Đổi thành phố làm việc thì chuyển quan hệ bảo hiểm hưu trí và y tế sang nơi tham gia mới, số năm đóng tiếp tục cộng dồn, đừng hủy bảo hiểm để rút tiền"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"Hoàn tất"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"Kế hoạch thực hiện"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"Lưu"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Chia sẻ mẹo này"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Ẩn chi tiết"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Chi phí"]},{"tag":"p","props":{},"children":["Không tốn tiền. Sau khi tham gia và đóng bảo hiểm ở nơi mới, đơn vị mới hoặc bạn nộp yêu cầu chuyển, đến quầy một lần hoặc làm trực tuyến. Bảo hiểm hưu trí có thể mất tổng cộng vài chục ngày làm việc, bảo hiểm y tế khoảng 15 ngày làm việc."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Lợi ích"]},{"tag":"p","props":{},"children":["Luật Bảo hiểm xã hội quy định rằng khi đổi nơi làm việc —tên chính thức là chuyển giữa các khu vực quản lý quỹ chung— quan hệ bảo hiểm hưu trí chuyển theo người, số năm đóng được cộng dồn. Bảo hiểm y tế người lao động cũng vậy: quan hệ đi theo người, số năm cộng dồn. Khi nghỉ hưu, lương hưu được tính theo từng giai đoạn và chi trả thống nhất. Chuyển quan hệ bảo hiểm hưu trí giữa các tỉnh theo biện pháp chuyển tiếp do Văn phòng Quốc vụ viện chuyển ban hành. Chưa đến tuổi nhận quyền lợi thì không được chấm dứt quan hệ bảo hiểm hưu trí, hủy bảo hiểm để rút tiền. Luật Bảo hiểm xã hội cũng ghi rõ không được rút trước tiền trong tài khoản cá nhân. Toàn bộ tiền gốc và lãi trong tài khoản cá nhân đều được chuyển. Phần đơn vị đóng gọi là quỹ chung, chuyển theo mức 12% tiền lương thực tế dùng để đóng bảo hiểm của từng năm từ 1998 trở đi. Khi nhận lương hưu, mức hưởng tính theo tiền lương đóng bảo hiểm từng năm, số năm đóng và tiền lương bình quân từng năm tại nơi nhận. Sau khi tham gia và đóng ở nơi mới, đơn vị hoặc bạn gửi yêu cầu bằng văn bản tới nơi tham gia mới. Nơi mới xét duyệt trong 15 ngày làm việc; nơi cũ làm xong chuyển đi trong 15 ngày làm việc sau khi nhận thư đồng ý tiếp nhận. Sau khi nhận quan hệ và tiền, nơi mới hoàn tất trong 15 ngày làm việc nữa. Theo danh sách thủ tục liên tỉnh năm 2020, việc này phải được thực hiện liên tỉnh trước cuối năm đó. Chỉ cần yêu cầu tại nơi chuyển đến, không phải quay lại nơi chuyển đi. Với bảo hiểm y tế người lao động, phải dừng tham gia ở nơi cũ và đã tham gia ở nơi mới thì mới được xin chuyển. Có thể xin trực tuyến trên Nền tảng Dịch vụ bảo hiểm y tế quốc gia hoặc tới quầy. Nơi cũ chuyển đi trong 10 ngày làm việc, nơi mới chuyển đến trong 5 ngày làm việc, cả số dư tài khoản cá nhân cũng chuyển theo. Nếu trước khi chuyển, gián đoạn đóng không quá 3 tháng, sau khi đóng bù theo quy định nơi mới thì không có thời gian chờ; được thanh toán chi phí ngay trong tháng đóng và truy thanh toán cho khoảng trống ở giữa. Nếu gián đoạn quá 3 tháng, thời gian chờ theo quy định địa phương, về nguyên tắc không quá 6 tháng (toàn quốc)."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Nguồn gốc"]},{"tag":"p","props":{"className":"life-citations"},"children":["全国人大常委会 (2010, 2018 修正). 社会保险法（第十四、十九、三十二条）. ",{"tag":"a","props":{"href":"https://www.gov.cn/guoqing/2021-10/29/content_5647616.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/guoqing/2021-10/29/content_5647616.htm"]},"；人力资源社会保障部、财政部 (2009). 城镇企业职工基本养老保险关系转移接续暂行办法（国办发〔2009〕66 号转发，第二、三、四、五、六、七、八、十一条）. ",{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/2009-12/29/content_8104.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/zhengce/zhengceku/2009-12/29/content_8104.htm"]},"；国务院办公厅 (2020). 关于加快推进政务服务「跨省通办」的指导意见（国办发〔2020〕35 号，附件第 7 项）. ",{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/2020-09/29/content_5548125.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/zhengce/zhengceku/2020-09/29/content_5548125.htm"]},"；国家医保局办公室、财政部办公厅 (2021). 基本医疗保险关系转移接续暂行办法（医保办发〔2021〕43 号，第五、六、八、九、十一、十二、十三条）. ",{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/2021-11/28/content_5653856.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/zhengce/zhengceku/2021-11/28/content_5653856.htm"]},"；国家医保局 (2021). 《基本医疗保险关系转移接续暂行办法》政策解读（国家医保服务平台网址 fuwu.nhsa.gov.cn）. ",{"tag":"a","props":{"href":"http://www.gov.cn/zhengce/2021-11/28/content_5653855.htm","target":"_blank","rel":"noopener noreferrer"},"children":["http://www.gov.cn/zhengce/2021-11/28/content_5653855.htm"]}]},{"tag":"a","props":{"href":"https://www.gov.cn/guoqing/2021-10/29/content_5647616.htm","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Liên kết mở nguồn"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Ghi chú sách"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["Nếu chuyển sang tỉnh khác tỉnh đăng ký hộ khẩu, nam đã đủ 50 tuổi hoặc nữ đã đủ 40 tuổi, quan hệ bảo hiểm hưu trí sẽ ở lại nơi tham gia cũ. Nơi mới chỉ mở tài khoản tạm thời, ghi toàn bộ khoản đóng của đơn vị và cá nhân. Nơi nhận lương hưu khi nghỉ hưu theo các quy tắc sau. Quan hệ bảo hiểm ở tỉnh hộ khẩu thì nhận tại nơi hộ khẩu. Không ở nơi hộ khẩu nhưng đã đóng cộng dồn đủ 10 năm tại nơi có quan hệ bảo hiểm thì nhận ở đó. Chưa đủ 10 năm thì chuyển về nơi gần nhất trước đó đã đóng đủ 10 năm để nhận. Không nơi nào đủ 10 năm thì gom về nơi hộ khẩu để nhận. Nơi nhận khác nhau thì tiền lương bình quân dùng để tính lương hưu cũng khác nhau. Cách chuyển giữa các thành phố trong cùng tỉnh do từng tỉnh quy định, hỏi cơ quan thực hiện bảo hiểm xã hội địa phương. Người đã nhận lương hưu không chuyển quan hệ bảo hiểm nữa. Cách tính số năm sau gián đoạn và những điều kiện yêu cầu đóng liên tục, xem phần 7, mục 18 (gián đoạn đóng bảo hiểm xã hội). Người không vào đơn vị, tự đóng bảo hiểm xã hội, xem phần 31, mục 11 (việc làm linh hoạt)."]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Ghi chú của tôi"]},{"tag":"button","props":{"type":"button"},"children":["Viết một lời nhắc cho chính bạn…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/vi/tip/19-18"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Trước"]},"Nhận tiền bồi thường khi nghỉ việc thì xem thuế thu nhập cá nhân trước: phần trong 3 mức lương bình quân người lao động của năm trước ở địa phương thì miễn thuế, phần vượt ra tính riêng, không gộp vào thu nhập của năm đó"]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["Thêm trong chủ đề này"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/19-12"},"children":[{"tag":"strong","props":{},"children":["Đừng tin「leo tới bàn giấy là được coi là tai nạn lao động」: thấy khó chịu đột ngột thì gọi 120 trước, đừng chạy tới chấm công"]},{"tag":"span","props":{},"children":["Khó chịu đột ngột mà chạy tới công ty không giúp bạn nhận thêm đồng n…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/19-13"},"children":[{"tag":"strong","props":{},"children":["Đơn vị không đóng bảo hiểm tai nạn lao động cho bạn thì ưu đãi tai nạn lao động vẫn có, và do đơn vị trả đủ theo đúng tiêu chuẩn"]},{"tag":"span","props":{},"children":["Đơn vị không đóng bảo hiểm tai nạn lao động cho bạn thì ưu đãi tai nạ…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/19-14"},"children":[{"tag":"strong","props":{},"children":["Khi tình trạng thương tích đã ổn định thì đi đánh giá năng lực lao động, hạng khuyết tật quy đổi thẳng thành tiền"]},{"tag":"span","props":{},"children":["Sau khi tình trạng thương tích ổn định thì đi đánh giá năng lực lao đ…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/19-15"},"children":[{"tag":"strong","props":{},"children":["Phải phân biệt ba khoản tiền khi chết vì tai nạn lao động: tiền trợ cấp mai táng, tiền trợ cấp hưu trí người được nuôi dưỡng, tiền trợ cấp một lần khi chết vì tai nạn lao động"]},{"tag":"span","props":{},"children":["Chết vì tai nạn lao động là ba khoản tiền, đừng chỉ thương lượng một …"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/19-16"},"children":[{"tag":"strong","props":{},"children":["Ở công ty lâu ngày bị bắt nạt, mắng, gây khó, đừng gồng chịu: ghi lại để có chứng cứ, rồi tuỳ tính chất mà khiếu nại, báo công an hoặc đi hoà giải"]},{"tag":"span","props":{},"children":["Người bị bắt nạt ở công ty thì về sau nguy cơ mắc bệnh tim, đột quỵ c…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/19-17"},"children":[{"tag":"strong","props":{},"children":["Lúc nghỉ việc thì xin đơn vị một giấy xác nhận nghỉ việc, ghi rõ thời hạn hợp đồng, ngày nghỉ việc, vị trí và số năm đã làm"]},{"tag":"span","props":{},"children":["Dù là bị sa thải, hết hạn hợp đồng hay tự nghỉ việc, đơn vị cũng phải…"]}]}]}]},{"tag":"a","props":{"className":"life-text-link","href":"/vi/book/19"},"children":["Đọc toàn bộ chủ đề: Đi làm, nghỉ việc và tai nạn lao động"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"15","height":"15","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]}]}]},{"tag":"nav","props":{"className":"life-tabbar","aria-label":"Điều hướng chính"},"children":[{"tag":"a","props":{"className":"","href":"/vi/book"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"21","height":"21","viewBox":"0 0 24 24","fill":