sName":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"このヒントを共有"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"詳細を閉じる"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["費用・手間"]},{"tag":"p","props":{},"children":["イブプロフェンは1箱十数元で、痛みのある数日間だけ服用します。婦人科の受診が必要な場合は、受付や超音波検査にいくらかの費用と半日ほどの時間がかかります。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["効果"]},{"tag":"p","props":{},"children":["Cochraneの系統的レビューは、原発性月経困難症の女性5820人を対象とした80件のランダム化比較試験をまとめました。原発性月経困難症とは、他の病気が見つからない月経痛のことです。プラセボに比べ、非ステロイド性抗炎症薬の方が鎮痛に有効でした（OR 4.37、95% CI 3.76–5.09、信頼区間）。換算すると、中等度以上の改善が得られる人は、プラセボでは18%、この種類の薬では45～53%でした。一方で、副作用は少し増えます（OR 1.29、1.11–1.51）。副作用が出る人は、プラセボでは10%、この種類の薬では11～14%でした。増えたのは主に胃腸の不調（OR 1.58）と神経系の反応（OR 2.74）でした。アセトアミノフェンと比べても、この種類の薬の方が鎮痛に有効でした（OR 1.89、1.05–3.43）が、試験は3件だけでした。この種類の薬の中でどれが最もよいかについては、差が認められませんでした。英国NICEのガイドライン（2024年更新）は、子宮内膜症を疑うべき状況を挙げています。慢性的な骨盤痛、日常の活動や生活の質に影響する月経痛、性交中または性交後の奥の痛みです。月経時の排便痛、月経時の血尿や排尿痛、これらの症状を伴う不妊も含まれます。17歳以下の少女も対象です。ガイドラインは、まずアセトアミノフェンやこの種類の薬を、例えば3か月間試すことを勧めています。鎮痛が十分でなければ、さらに検査を受けるために紹介します。婦人科診察と超音波検査が両方とも正常でも、この病気は否定できません。ある研究は、10か国の16病院で腹腔鏡検査を受ける女性1418人を調査しました。症状が出てから手術で子宮内膜症が確定診断されるまで、平均6.7年かかり、主にかかりつけ医などの一次医療を受診していた期間に遅れが生じていました。確定診断された女性は、平均で週10.8時間分の仕事を失っており、その大部分は出勤していても効率が落ちることによるものでした。オランダのオンライン調査では、15～45歳の女性32748人に尋ねました。13.8%が月経のために休暇を取ったことがあり、平均は年間1.3日でした。80.7%は月経中に出勤していても効率が落ち、年間8.9日分の仕事の減少に相当しました。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["出典"]},{"tag":"p","props":{"className":"life-citations"},"children":["Marjoribanks J, Ayeleke RO, Farquhar C, Proctor M (2015). Nonsteroidal anti-inflammatory drugs for dysmenorrhoea. Cochrane Database of Systematic Reviews, (7):CD001751. ",{"tag":"a","props":{"href":"https://doi.org/10.1002/14651858.CD001751.pub3","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1002/14651858.CD001751.pub3"]},"；National Institute for Health and Care Excellence (2017, updated 2024). Endometriosis: diagnosis and management (NG73), recommendations 1.3.1, 1.4.2, 1.4.3, 1.5.4. ",{"tag":"a","props":{"href":"https://www.nice.org.uk/guidance/ng73/chapter/Recommendations","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.nice.org.uk/guidance/ng73/chapter/Recommendations"]},"；Nnoaham KE, Hummelshoj L, Webster P, et al.; World Endometriosis Research Foundation Global Study of Women's Health consortium (2011). Impact of endometriosis on quality of life and work productivity: a multicenter study across ten countries. Fertility and Sterility, 96(2):366-373.e8. ",{"tag":"a","props":{"href":"https://doi.org/10.1016/j.fertnstert.2011.05.090","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1016/j.fertnstert.2011.05.090"]},"；Schoep ME, Adang EMM, Maas JWM, De Bie B, Aarts JWM, Nieboer TE (2019). Productivity loss due to menstruation-related symptoms: a nationwide cross-sectional survey among 32 748 women. BMJ Open, 9(6):e026186. ",{"tag":"a","props":{"href":"https://doi.org/10.1136/bmjopen-2018-026186","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1136/bmjopen-2018-026186"]},"；Haleon (2026). Advil (ibuprofen capsule, liquid filled), OTC drug label: Warnings. DailyMed. ",{"tag":"a","props":{"href":"https://dailymed.nlm.nih.gov/dailymed/drugInfo.cfm?setid=1f01c10a-9434-91a4-2ee4-352315a6b610","target":"_blank","rel":"noopener noreferrer"},"children":["https://dailymed.nlm.nih.gov/dailymed/drugInfo.cfm?setid=1f01c10a-9434-91a4-2ee4-352315a6b610"]}]},{"tag":"a","props":{"href":"https://doi.org/10.1002/14651858.CD001751.pub3","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["出典を開く"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["著者の注記"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["60歳以上の人、胃から出血したことがある人、抗凝固薬やステロイドを使用している人は、この種類の薬を使う前に医師に相談してください。詳細は第34節第3条（イブプロフェンなどの鎮痛薬）を参照してください。米国のイブプロフェンの説明書には、重いアレルギーを起こす可能性があり、アスピリンにアレルギーのある人では起こりやすく、その症状には喘息発作も含まれると明記されています。喘息のある人も、使用前に医師に相談してください。妊娠している可能性があるときは先に医師に相談し、妊娠20週以降は自己判断で服用しないでください。第34節第5条（妊娠20週以降）を参照してください。この種類の薬を使えない人は、アセトアミノフェンに変更できます。1日の上限は第34節第1条（アセトアミノフェン）を参照してください。月経痛には、月経のある数日間だけ薬を使います。第34節第9条（鎮痛薬を月15日を超えて使わない）の基準は頭痛についてのもので、月経痛で薬を使う日数はそこまで多くなりません。Aとしたのは、鎮痛効果が多数のランダム化試験に基づくためです。著者らは大半の比較のエビデンスの質を低いと評価しています。主な理由は試験方法の記載が不明確であることで、試験の59%は製薬会社から資金提供を受けていました。利益を「中」とするのは判断です。レビューは痛みの有無だけを測り、休暇が何日減るかは測っていません。オランダの調査では、月経による損失は年間約10日分に相当し、週あたりにすると時間単位です。子宮内膜症の研究対象はすでに腹腔鏡検査を受ける人であり、月経痛のある人の大半がこの病気であるという意味ではありません。主に利益を受けるのはあなた自身です。"]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["自分のメモ"]},{"tag":"button","props":{"type":"button"},"children":["自分へのメモを書く…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/ja/tip/03-24"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["前へ"]},"心に悩みがあるとき、数日間にわたって考えや感情を書き留めることはできますが、それが治療になるとは期待しないでください"]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["このテーマの他の提案"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/03-18"},"children":[{"tag":"strong","props":{},"children":["気分が落ち込んだ時にまず行うべき、最もコストパフォーマンスの高い数事：体を動かす、日光を浴びる、規則正しく眠る、誰かに話す、12356に電話する"]},{"tag":"span","props":{},"children":["うつ状態に対しては、早歩きやジョギングが最も効果的であり、強度が大きいほど効果が高まります。詳細は第 22 節第 6 条（気分が悪いときは…"]}]}]},{"tag"