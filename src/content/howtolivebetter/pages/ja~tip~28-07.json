tag":"span","props":{},"children":["07"]},"性ホルモン剤は医師の処方と定期的な再検査を前提に使用すること。ネット通販での購入や自己判断による増量は避けること"]},{"tag":"a","props":{"href":"/ja/tip/28-08"},"children":[{"tag":"span","props":{},"children":["08"]},"もし「自分が醜い」と感じる程度が、何度も鏡を見たり、何度も修正したいと考えたりするレベルに達しているなら、手術を検討する前に、まずボディイメージの評価を受けること"]},{"tag":"a","props":{"href":"/ja/tip/28-09"},"children":[{"tag":"span","props":{},"children":["09"]},"歯列矯正は矯正の資格がある医師の対面診察を受け、定期受診する。ネットでマウスピースを買って自宅で使わない"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"現在地"},"children":[{"tag":"a","props":{"href":"/ja/book"},"children":["本を読む"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/ja/book/28"},"children":["第28章"," ·"," ","見た目のために体を壊さないで"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"28-07"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["07"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["エビデンス"," ","A"]}]},{"tag":"h1","props":{"lang":"ja"},"children":["性ホルモン剤は医師の処方と定期的な再検査を前提に使用すること。ネット通販での購入や自己判断による増量は避けること"]},{"tag":"p","props":{"lang":"ja","className":"life-entry-summary"},"children":["ここでは使用の是非ではなく、使用方法についてのみ論じる。エストロゲンを使用しているトランスジェンダー女性は、同年代と比較して血管内に血栓ができる割合が明らかに高く、1,000人あたり2年間で約 4 人、8年間で約 17 人増加する。この種のリスクは定期的な再検査で監視する必要がある。ネット通販での薬の購入や自己調節では、誰も代わりにチェックしてくれない。"]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["費用・手間"]},{"tag":"p","props":{},"children":["定期的な受診と血液検査による再検査。年間で数百元、数回の半日を要する。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["効果"]},{"tag":"p","props":{},"children":["研究者らは、Kaiser Permanente医療グループの電子カルテを用いて、2,842名のトランスジェンダー女性と2,118名のトランスジェンダー男性の集団を追跡調査した。"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"記録する：性ホルモン剤は医師の処方と定期的な再検査を前提に使用すること。ネット通販での購入や自己判断による増量は避けること"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"できている"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"やることに追加"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"お気に入り"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"このヒントを共有"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"詳細を閉じる"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["費用・手間"]},{"tag":"p","props":{},"children":["定期的な受診と血液検査による再検査。年間で数百元、数回の半日を要する。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["効果"]},{"tag":"p","props":{},"children":["研究者らは、Kaiser Permanente医療グループの電子カルテを用いて、2,842名のトランスジェンダー女性と2,118名のトランスジェンダー男性の集団を追跡調査した。追跡期間は平均4.0年および3.6年である。各対象者に対し、出生年、人種、受診地点、および登録時期に基づいて、約10倍のシスジェンダー対照群（計48,686名のシスジェンダー男性および48,775名のシスジェンダー女性）を割り当てた。トランスジェンダー女性における静脈血栓塞栓症（血管内に血栓が生じて詰まる状態）の発症率は、対照群よりも高かった。シスジェンダー男性と比較すると、2年における発症率は1000人あたり4.1例（95% CI 1.6–6.7）であった。8年においては16.7例（6.4–27.5）であった。計算すると、1000 人あたり2年間で 4.1 例、8年間で 16.7 例発生しています。シスジェンダー女性と比較すると、これらの数値は 3.4（1.1–5.6）および 13.7（4.1–22.7）です。虚血性脳卒中（血管が詰まるタイプの脳卒中）と心筋梗塞は、全体として各グループで同程度でした。しかし、追跡期間中にホルモン療法を開始したトランスジェンダー女性においては、静脈血栓症と虚血性脳卒中の差がより顕著でした。トランスジェンダー男性については、エビデンスが不十分であり、結論を出すには至っていません。著者の結論は「これらの結果は、トランスジェンダーのホルモン療法におけるエストロゲンの血管系への副作用に対して、長期的な警戒が必要であることを示唆している可能性がある」というものです"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["出典"]},{"tag":"p","props":{"className":"life-citations"},"children":["Getahun D et al. (2018). Cross-sex Hormones and Acute Cardiovascular Events in Transgender Persons: A Cohort Study. Ann Intern Med. ",{"tag":"a","props":{"href":"https://doi.org/10.7326/M17-2785","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.7326/M17-2785"]},"；国家市场监督管理总局 (2022). 药品网络销售监督管理办法（总局令第 58 号，第九条）. ",{"tag":"a","props":{"href":"https://www.gov.cn/gongbao/content/2022/content_5717002.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/gongbao/content/2022/content_5717002.htm"]}]},{"tag":"a","props":{"href":"https://doi.org/10.7326/M17-2785","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["出典を開く"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["著者の注記"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["研究者自身がこの研究の限界について明記している。病院のシステム外で自ら薬を購入した人がどれほどいるか、彼らには把握できないため、「投薬の有無」という境界線は本来不鮮明である。したがって、投薬はより一層、正規のフォローアップ体制に組み込まれるべきである。この研究が対象としているのは血管に異常が生じたかどうかのみであり、ホルモン療法の是非や、使用によるメリットについては回答していない。それは別のエビデンスの領域である。避妊薬、更年期ホルモン療法、テストステロン補充など、性ホルモンを使用するあらゆる場面において同様である。ネット通販を利用し、ネット上の投稿を参考に量を調節し、血栓や肝・腎機能の指標を一度も検査しない場合、リスクは「監視者がいない」という点にあり、なぜ投薬するかという理由とは無関係である。国内の正規の手順は、正規の医療機関の内分泌科または適切な専門科を受診し、評価、処方、再検査を受けることである。"]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["自分のメモ"]},{"tag":"button","props":{"type":"button"},"children":["自分へのメモを書く…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/ja/tip/28-06"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["前へ"]},"ダイエット薬を服用する場合は病院で処方箋を受け取ってください。処方箋なしで発送するネットショップで購入しないでください"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/ja/tip/28-08"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["次へ"]},"もし「自分が醜い」と感じる程度が、何度も鏡を見たり、何度も修正したいと考えたりするレベルに達しているなら、手術を検討する前に、まずボディイメージの評価を受けること"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":