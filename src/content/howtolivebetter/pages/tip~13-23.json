,"fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"返回目录"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["紧急情况：先做什么"]},{"tag":"div","props":{"data-ad-dock-host":"true"},"children":[]},{"tag":"nav","props":{"aria-label":"章节条目"},"children":[{"tag":"a","props":{"href":"/tip/13-01","className":""},"children":[{"tag":"span","props":{},"children":["01"]},"有人倒地没呼吸，立刻用力按压胸口，让旁人打 120 并找 AED"]},{"tag":"a","props":{"href":"/tip/13-02","className":""},"children":[{"tag":"span","props":{},"children":["02"]},"老人摔倒、有人倒地，先蹲下喊他、打 120，别急着把人扶起来；陌生人这档走开在国内也合法，停下来就别上手搬"]},{"tag":"a","props":{"href":"/tip/13-03","className":""},"children":[{"tag":"span","props":{},"children":["03"]},"突然嘴歪、一侧胳膊没劲、说话说不清，立刻打 120，不要等、不要自己开车去"]},{"tag":"a","props":{"href":"/tip/13-04","className":""},"children":[{"tag":"span","props":{},"children":["04"]},"突然天旋地转站不稳、看东西成双、一只眼发黑，或者手指点不到自己鼻尖，也按卒中打 120"]},{"tag":"a","props":{"href":"/tip/13-05","className":""},"children":[{"tag":"span","props":{},"children":["05"]},"一只眼睛突然像拉下窗帘一样黑掉，哪怕几分钟就自己好了，也当天按卒中去急诊"]},{"tag":"a","props":{"href":"/tip/13-06","className":""},"children":[{"tag":"span","props":{},"children":["06"]},"一只眼又胀又痛、发红，看灯有一圈彩虹，还头痛恶心想吐，当天去眼科急诊"]},{"tag":"a","props":{"href":"/tip/13-07","className":""},"children":[{"tag":"span","props":{},"children":["07"]},"胸口压着疼、闷、发紧超过 15 分钟不缓解，打 120，不要自己扛也不要自己开车"]},{"tag":"a","props":{"href":"/tip/13-08","className":""},"children":[{"tag":"span","props":{},"children":["08"]},"突然像被撕开一样的剧痛，从胸口往后背、往腰一路挪，打 120 并说清「疼在移动」"]},{"tag":"a","props":{"href":"/tip/13-09","className":""},"children":[{"tag":"span","props":{},"children":["09"]},"突然一记「这辈子最疼的头痛」，一小时内就到最疼，立刻去急诊做头颅 CT"]},{"tag":"a","props":{"href":"/tip/13-10","className":""},"children":[{"tag":"span","props":{},"children":["10"]},"老人磕过头之后两三周到几个月变得走路不稳、迟钝、嗜睡或者一侧没劲，去做头颅 CT"]},{"tag":"a","props":{"href":"/tip/13-11","className":""},"children":[{"tag":"span","props":{},"children":["11"]},"一条腿突然肿起来、发紧、按着疼，尽快就医；再加上突然喘不上气或者胸痛，立刻打 120"]},{"tag":"a","props":{"href":"/tip/13-12","className":""},"children":[{"tag":"span","props":{},"children":["12"]},"大出血先用手死死压住伤口，四肢压不住就上止血带，同时打 120"]},{"tag":"a","props":{"href":"/tip/13-13","className":""},"children":[{"tag":"span","props":{},"children":["13"]},"被狗、猫咬伤或抓破皮，先用肥皂水和流水交替冲 15 分钟，当天去打疫苗"]},{"tag":"a","props":{"href":"/tip/13-14","className":""},"children":[{"tag":"span","props":{},"children":["14"]},"烫伤后立刻用凉的流动水冲 20 分钟，别抹牙膏酱油"]},{"tag":"a","props":{"href":"/tip/13-15","className":""},"children":[{"tag":"span","props":{},"children":["15"]},"突然全身起疹、喘不上气或者发晕，按过敏性休克处理，立刻叫 120 并说清楚"]},{"tag":"a","props":{"href":"/tip/13-16","className":""},"children":[{"tag":"span","props":{},"children":["16"]},"有人抽搐倒地，清开周围、让他侧躺、看表计时，什么都别往嘴里塞"]},{"tag":"a","props":{"href":"/tip/13-17","className":""},"children":[{"tag":"span","props":{},"children":["17"]},"糖尿病人突然发抖、出冷汗、说话不清，先给 15 克糖，15 分钟后复测"]},{"tag":"a","props":{"href":"/tip/13-18","className":""},"children":[{"tag":"span","props":{},"children":["18"]},"有人触电，先断电，再用干燥的木棍之类挑开电源，不要直接上手拉"]},{"tag":"a","props":{"href":"/tip/13-19","className":""},"children":[{"tag":"span","props":{},"children":["19"]},"一氧化碳报警器响了，或者一屋子人同时头痛恶心，先出门再打电话"]},{"tag":"a","props":{"href":"/tip/13-20","className":""},"children":[{"tag":"span","props":{},"children":["20"]},"误服清洁剂、农药、药物先别催吐，带上瓶子立刻就医；溅到眼睛或皮肤用大量清水至少冲 15 分钟"]},{"tag":"a","props":{"href":"/tip/13-21","className":""},"children":[{"tag":"span","props":{},"children":["21"]},"酸碱等化学品溅到身上，立刻脱掉污染的衣服、用大量流动清水冲，眼睛要掰开眼皮冲，冲够时间再走"]},{"tag":"a","props":{"href":"/tip/13-22","className":""},"children":[{"tag":"span","props":{},"children":["22"]},"高温下头晕、恶心、不出汗或意识不清，立刻挪到阴凉处脱衣泼水降温，意识不清的不喂水、打 120"]},{"tag":"a","props":{"href":"/tip/13-23","className":"active"},"children":[{"tag":"span","props":{},"children":["23"]},"中暑的人只要清醒，就少量多次喝凉的淡盐水或运动饮料，别猛灌、别喝酒和高糖饮料"]},{"tag":"a","props":{"href":"/tip/13-24","className":""},"children":[{"tag":"span","props":{},"children":["24"]},"火灾时贴地爬、摸门再开门、门烫就别开，走楼梯不坐电梯，出去了别回头"]},{"tag":"a","props":{"href":"/tip/13-25","className":""},"children":[{"tag":"span","props":{},"children":["25"]},"看到有人溺水，先叫人和打 110/120，伸竿、抛漂浮物，自己不下水"]},{"tag":"a","props":{"href":"/tip/13-26","className":""},"children":[{"tag":"span","props":{},"children":["26"]},"有人噎住说不出话，1 岁以上的站到背后做 5 次拍背加 5 次腹部冲击，倒下就做心肺复苏"]},{"tag":"a","props":{"href":"/tip/13-27","className":""},"children":[{"tag":"span","props":{},"children":["27"]},"在戈壁、沙漠、无人区迷路或车坏了，留在原地或车旁，先报位置，再遮阳保温，省水，不乱走"]},{"tag":"a","props":{"href":"/tip/13-28","className":""},"children":[{"tag":"span","props":{},"children":["28"]},"发抖、说话含糊、走路打晃是失温，换掉湿衣、包起来，先暖躯干，喝热甜饮不喝酒"]},{"tag":"a","props":{"href":"/tip/13-29","className":""},"children":[{"tag":"span","props":{},"children":["29"]},"被蛇咬，坐下别动、摘掉戒指手表、尽快送医院打抗蛇毒血清，不切、不吸、不绑死"]},{"tag":"a","props":{"href":"/tip/13-30","className":""},"children":[{"tag":"span","props":{},"children":["30"]},"地震时先看自己在什么房子里：符合抗震设防的楼里就地躲，会垮的老房子门在几步外就出去"]},{"tag":"a","props":{"href":"/tip/13-31","className":""},"children":[{"tag":"span","props":{},"children":["31"]},"遇到熊、野猪、成群野狗，别跑，侧身慢慢退开"]},{"tag":"a","props":{"href":"/tip/13-32","className":""},"children":[{"tag":"span","props":{},"children":["32"]},"野外遇上雷雨，钻进有硬顶的车或建筑，避开山脊、孤树、水面和金属"]},{"tag":"a","props":{"href":"/tip/13-33","className":""},"children":[{"tag":"span","props":{},"children":["33"]},"上高原按睡眠海拔（当晚睡在多高）慢慢升，症状加重就下撤，不要硬扛"]},{"tag":"a","props":{"href":"/tip/13-34","className":""},"children":[{"tag":"span","props":{},"children":["34"]},"被蜱虫叮住，用尖头镊子贴着皮肤稳稳拉出来，别涂油别用火烧"]},{"tag":"a","props":{"href":"/tip/13-35","className":""},"children":[{"tag":"span","props":{},"children":["35"]},"野外的水一律烧开再喝，滚开一分钟就够，不用因为海拔高多煮"]},{"tag":"a","props":{"href":"/tip/13-36","className":""},"children":[{"tag":"span","props":{},"children":["36"]},"荒郊野外被陌生人索财，钱给他，不动手，记特征，脱身后报警"]},{"tag":"a","props":{"href":"/tip/13-37","className":""},"children":[{"tag":"span","props":{},"children":["37"]},"撞见一群人打架，退开走人，别上去拉架、别围观、别捡地上的家伙；要报警就退到安全距离打 110"]},{"tag":"a","props":{"href":"/tip/13-38","className":""},"children":[{"tag":"span","props":{},"children":["38"]},"可能被 HIV 暴露了，72 小时内去拿阻断药，越早越好"]},{"tag":"a","props":{"href":"/tip/13-39","className":""},"children":[{"tag":"span","props":{},"children":["39"]},"救人受了伤、搭进了钱，先找加害人和医保，再去申报见义勇为确认"]},{"tag":"a","props":{"href":"/tip/13-40","className":""},"children":[{"tag":"span","props":{},"children":["40"]},"刀、钢筋、玻璃扎进身体，压住异物周围止血，不要把它拔出来"]},{"tag":"a","props":{"href":"/tip/13-41","className":""},"children":[{"tag":"span","props":{},"children":["41"]},"怀疑骨折就别再动那个部位，托着不动、冷敷 20 分钟以内，别自己掰正"]},{"tag":"a","props":{"href":"/tip/13-42","className":""},"children":[{"tag":"span","props":{},"children":["42"]},"被性侵之后，先到安全的地方打 110；验伤之前别洗澡、别洗衣服、别收拾房间，72 小时内去医院"]},{"tag":"a","props":{"href":"/tip/13-43","className":""},"children":[{"tag":"span","props":{},"children":["43"]},"不满 1 岁的婴儿噎住哭不出声，趴着拍背 5 下、翻过来按胸口 5 下，轮着做，别按肚子"]},{"tag":"a","props":{"href":"/tip/13-44","className":""},"children":[{"tag":"span","props":{},"children":["44"]},"不满 1 岁的婴儿没反应、没正常呼吸，开免提打 120，做婴儿心肺复苏：按 30 下吹 2 口气"]}]}]},{"tag":"div","props":{"className":"life-tip-page","data-tip-locales":"zh,en,ru,es,ja,vi"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"当前位置"},"children":[{"tag":"a","props":{"href":"/book"},"children":["阅读全书"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/book/13"},"children":["第 13 章 · 紧急情况：先做什么"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"13-23"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["23"]},{"tag":"span","props":{"className":"life-evidence grade-b"},"children":["证据 B"]}]},{"tag":"h1","props":{"lang":"zh"},"children":["中暑的人只要清醒，就少量多次喝凉的淡盐水或运动饮料，别猛灌、别喝酒和高糖饮料"]},{"tag":"p","props":{"lang":"zh","className":"life-entry-summary"},"children":["只有清醒的人才喝。凉的淡盐水或运动饮料少量多次喝，一小时 500 到 1000 毫升。别猛灌，吐出来呛进气管更要命。不喝酒和高糖饮料，它们会让人丢更多水。先用凉水擦身、冰袋敷脖子腋下大腿根降温，再补水。意识不清、说话含糊的，一口都不喂。"]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["成本"]},{"tag":"p","props":{},"children":["不花钱。一瓶运动饮料几元。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["收益"]},{"tag":"p","props":{},"children":["中国疾控中心发布过《公众高温中暑预防与紧急处理指南（2014 版）》。里面写着「至少每小时喝 2~4 杯凉水（500~1000ml），水温不宜过高，饮水应少量多次」。还写着「不要饮用含酒精或大量糖分的饮料。这些饮料会导致失去更多的体液。同时，还应避免饮用过凉的冰冻饮料」。对热射病则明确写「不要给病人…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"标记：中暑的人只要清醒，就少量多次喝凉的淡盐水或运动饮料，别猛灌、别喝酒和高糖饮料"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"已做到"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"加入待做"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"收藏"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"分享这条建议"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"收起详情"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["成本"]},{"tag":"p","props":{"className":"life-citations"},"children":["不花钱。一瓶运动饮料几元。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["收益"]},{"tag":"p","props":{"className":"life-citations"},"children":["中国疾控中心发布过《公众高温中暑预防与紧急处理指南（2014 版）》。里面写着「至少每小时喝 2~4 杯凉水（500~1000ml），水温不宜过高，饮水应少量多次」。还写着「不要饮用含酒精或大量糖分的饮料。这些饮料会导致失去更多的体液。同时，还应避免饮用过凉的冰冻饮料」。对热射病则明确写「不要给病人喝水」。美国 NIOSH：热衰竭要「鼓励小口频繁地喝凉水」；热痉挛每 15 到 20 分钟补一次含糖和电解质的运动饮料，「不要用盐片」"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["来源"]},{"tag":"p","props":{"className":"life-citations"},"children":["中国疾病预防控制中心职业卫生与中毒控制所 (2014). 公众高温中暑预防与紧急处理指南（2014 版）. ",{"tag":"a","props":{"href":"https://niohp.chinacdc.cn/sndt/201405/t20140530_97623.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://niohp.chinacdc.cn/sndt/201405/t20140530_97623.htm"]}," ; US CDC/NIOSH. Heat-Related Illnesses. ",{"tag":"a","props":{"href":"https://www.cdc.gov/niosh/heat-stress/about/illnesses.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.cdc.gov/niosh/heat-stress/about/illnesses.html"]},""]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["原书备注"]},{"tag":"p","props":{"className":"life-citations"},"children":["出大汗后只灌白开水，会把血里的盐冲淡（血钠低），所以水里要含一点盐。一次猛灌容易吐，吐的东西呛进气管比中暑本身更快要命。「别喝冰镇的」是中国疾控 2014 年那版指南里的建议，理由是怕胃痉挛，没有量化证据。别把它误读成「不能用冷的」。第 22 条（高温下头晕恶心时脱衣泼水降温）里讲了几样降温法。分别是凉水擦洗、冷水浸泡、冰袋敷脖子、腋下、大腿根（腹股沟）。这几样正是官方推荐的头一档降温法，是往身上用的，不往嘴里灌。降温永远排在补水前面。意识不清、说话含糊的，一口都不要喂"]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["我的备注"]},{"tag":"button","props":{"type":"button"},"children":["写下对自己有用的提醒…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/tip/13-22"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["上一条"]},"高温下头晕、恶心、不出汗或意识不清，立刻挪到阴凉处脱衣泼水降温，意识不清的不喂水、打 120"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/tip/13-24"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["下一条"]},"火灾时贴地爬、摸门再开门、门烫就别开，走楼梯不坐电梯，出去了别回头"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["本主题的其他建议"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/13-19"},"children":[{"tag":"strong","props":{},"children":["一氧化碳报警器响了，或者一屋子人同时头痛恶心，先出门再打电话"]},{"tag":"span","props":{},"children":["报警器响了，或者一屋子人同时头痛、恶心、发晕，先把人都带到室外，再打电话。别留在屋里找原因，也别回去关阀门。症状像感冒，「出门就好转」是最强的提示。中国 201…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/13-20"},"children":[{"tag":"strong","props":{},"children":["误服清洁剂、农药、药物先别催吐，带上瓶子立刻就医；溅到眼睛或皮肤用大量清水至少冲 15 分钟"]},{"tag":"span","props":{},"children":["误服清洁剂、农药、药物不要催吐，腐蚀性液体吐出来会把食管再烧一遍。先喝适量牛奶或者蛋清，带上瓶子和说明书立刻去医院。溅到皮肤或者眼睛，用大量清水至少冲 15 分…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/13-21"},"children":[{"tag":"strong","props":{},"children":["酸碱等化学品溅到身上，立刻脱掉污染的衣服、用大量流动清水冲，眼睛要掰开眼皮冲，冲够时间再走"]},{"tag":"span","props":{},"children":["三步。第一步，立刻脱掉沾上的衣服鞋袜，衣服兜住的地方伤得最重。第二步，用大量流动清水冲，皮肤和眼睛都至少 15 分钟，湖南省应急管理厅给到 20 到 30 分钟…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/13-25"},"children":[{"tag":"strong","props":{},"children":["看到有人溺水，先叫人和打 110/120，伸竿、抛漂浮物，自己不下水"]},{"tag":"span","props":{},"children":["溺水的人会本能地把施救者往水下按，下水的人自己也可能淹死。顺序是：大喊叫人 → 打 110/120 → 递长杆、绳子 → 抛救生圈、空桶、矿泉水瓶 → 人上岸没…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/13-26"},"children":[{"tag":"strong","props":{},"children":["有人噎住说不出话，1 岁以上的站到背后做 5 次拍背加 5 次腹部冲击，倒下就做心肺复苏"]},{"tag":"span","props":{},"children":["先问「你噎住了吗，能说话吗」。还能咳、能出声的让他自己咳。1 岁以上的说不出话，就站到背后，5 次拍背接 5 次腹部冲击，反复做到东西出来或者人倒下。倒下就做心…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/13-27"},"children":[{"tag":"strong","props":{},"children":["在戈壁、沙漠、无人区迷路或车坏了，留在原地或车旁，先报位置，再遮阳保温，省水，不乱走"]},{"tag":"span","props":{},"children":["留在原地或者车旁，车是最大的遮阳物。顺序是：有信号先发位置再打电话 → 遮阳保暖 → 省水，白天不动、夜里凉了再动 → 不乱走 → 用反光镜、烟、三堆火发信号。…"]}]}]}]},{"tag":"a","props":{"className":"life-text-link","href":"/book/13"},"children":["阅读整个主题：紧急情况：先做什么 ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"15","height":"15","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]}]}]}]},{"tag":"aside",