sName":"life-ad-rail","data-dock-active":"false","style":{"top":"94px"}},"children":[{"tag":"div","props":{"className":"life-ad-dock","hidden":true},"children":[{"tag":"aside","props":{"className":"life-ad-space life-ad-space-sponsored life-ad-space-compact","data-ad-placement":"ad_dock","data-ad-group":"reading","data-ad-creative":"read_product","data-ad-ready":"false","aria-label":"Advertisement · Community recommendation"},"children":[{"tag":"button","props":{"type":"button","className":"life-ad-dismiss","aria-label":"Close ad"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-x","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M18 6 6 18"},"children":[]},{"tag":"path","props":{"d":"m6 6 12 12"},"children":[]}]}]},{"tag":"div","props":{"className":"life-ad-space-brand"},"children":[{"tag":"img","props":{"src":"/sites/howtolivebetter/images/shengcai/logo.png","width":"565","height":"144","alt":"Official Shengcai Youshu logo","decoding":"async"},"children":[]}]},{"tag":"div","props":{"className":"life-ad-space-copy"},"children":[{"tag":"span","props":{"className":"life-ad-space-label"},"children":["Advertisement · Community recommendation"]},{"tag":"strong","props":{},"children":["Could what you know become a useful product?"]},{"tag":"p","props":{},"children":["From ebooks to small tools, explore how members spot needs and turn knowledge into something people can use."]}]},{"tag":"div","props":{"className":"life-ad-space-actions"},"children":[{"tag":"a","props":{"className":"life-ad-space-link","href":"/en/shengcaiyoushu?sc_group=reading&sc_creative=read_product&sc_placement=ad_dock"},"children":["Explore the community and examples",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"18","height":"18","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-up-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M7 7h10v10"},"children":[]},{"tag":"path","props":{"d":"M7 17 17 7"},"children":[]}]}]}]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/en/book/03"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"Back to index"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["Don’t waste your energy"]},{"tag":"div","props":{"data-ad-dock-host":"true"},"children":[]},{"tag":"nav","props":{"aria-label":"Chapter entries"},"children":[{"tag":"a","props":{"href":"/en/tip/03-01"},"children":[{"tag":"span","props":{},"children":["01"]},"Turn off non‑essential notifications and keep your phone out of sight while working"]},{"tag":"a","props":{"href":"/en/tip/03-02"},"children":[{"tag":"span","props":{},"children":["02"]},"Keep a fixed wake-up time, even on weekends"]},{"tag":"a","props":{"href":"/en/tip/03-03"},"children":[{"tag":"span","props":{},"children":["03"]},"Getting 7 to 8 hours of sleep each night — don’t settle for just 6 hours"]},{"tag":"a","props":{"href":"/en/tip/03-04"},"children":[{"tag":"span","props":{},"children":["04"]},"Avoid caffeine after 2 p.m"]},{"tag":"a","props":{"href":"/en/tip/03-05"},"children":[{"tag":"span","props":{},"children":["05"]},"Batch-process emails and messages a few times per day"]},{"tag":"a","props":{"href":"/en/tip/03-06"},"children":[{"tag":"span","props":{},"children":["06"]},"When doing tasks that require continuous thinking, keep out even brief interruptions"]},{"tag":"a","props":{"href":"/en/tip/03-07"},"children":[{"tag":"span","props":{},"children":["07"]},"Do one thing at a time — don’t reply to messages while in a meeting"]},{"tag":"a","props":{"href":"/en/tip/03-08"},"children":[{"tag":"span","props":{},"children":["08"]},"Avoid glowing screens one hour before bed; if you must, read paper books or e-ink devices instead"]},{"tag":"a","props":{"href":"/en/tip/03-09"},"children":[{"tag":"span","props":{},"children":["09"]},"Go to bed at a set time — avoid staying up late for games, short videos, or porn"]},{"tag":"a","props":{"href":"/en/tip/03-10"},"children":[{"tag":"span","props":{},"children":["10"]},"Don’t make major decisions or send important messages late at night"]},{"tag":"a","props":{"href":"/en/tip/03-11"},"children":[{"tag":"span","props":{},"children":["11"]},"Take a 10‑minute nap in the afternoon — don’t sleep half an hour"]},{"tag":"a","props":{"href":"/en/tip/03-12"},"children":[{"tag":"span","props":{},"children":["12"]},"Using earplugs or finding a quiet room for memory-heavy tasks in open offices"]},{"tag":"a","props":{"href":"/en/tip/03-13"},"children":[{"tag":"span","props":{},"children":["13"]},"Do not keep adding weekly work hours: beyond roughly 49 hours, each extra hour produces less additional output"]},{"tag":"a","props":{"href":"/en/tip/03-14"},"children":[{"tag":"span","props":{},"children":["14"]},"When you notice yourself endlessly replaying a distressing memory, do something hands‑on instead"]},{"tag":"a","props":{"href":"/en/tip/03-15"},"children":[{"tag":"span","props":{},"children":["15"]},"Treat thoughts like “things will definitely get worse” as symptoms, not as facts"]},{"tag":"a","props":{"href":"/en/tip/03-16"},"children":[{"tag":"span","props":{},"children":["16"]},"Cut back on draining relationships and learn to say no to unwanted requests"]},{"tag":"a","props":{"href":"/en/tip/03-17"},"children":[{"tag":"span","props":{},"children":["17"]},"Walk away when angry; treat the other person as weather, not an enemy"]},{"tag":"a","props":{"href":"/en/tip/03-18"},"children":[{"tag":"span","props":{},"children":["18"]},"Best low-cost actions when you’re feeling down: move, get sunlight, stick to a schedule, talk to someone, call 12356"]},{"tag":"a","props":{"href":"/en/tip/03-19"},"children":[{"tag":"span","props":{},"children":["19"]},"Treat police officers, doctors, and bank tellers as rule‑following workers, not as archetypes: paperwork and deadlines — not emotions — drive results"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/en/tip/03-20","data-status":"active"},"children":[{"tag":"span","props":{},"children":["20"]},"Don’t make “how others are doing” a daily habit: set limits on apps that show peers’ updates or turn them off"]},{"tag":"a","props":{"href":"/en/tip/03-21"},"children":[{"tag":"span","props":{},"children":["21"]},"When you feel like “everyone saw me make a fool of myself,” cut that estimate in half"]},{"tag":"a","props":{"href":"/en/tip/03-22"},"children":[{"tag":"span","props":{},"children":["22"]},"Treat “others expect me to be perfect” as a symptom, not a fact"]},{"tag":"a","props":{"href":"/en/tip/03-23"},"children":[{"tag":"span","props":{},"children":["23"]},"When angry, don’t try to vent by smashing things, punching a bag, or going for a run — first calm your body down"]},{"tag":"a","props":{"href":"/en/tip/03-24"},"children":[{"tag":"span","props":{},"children":["24"]},"Writing down thoughts and feelings about a troubling issue over several days can be helpful, but don’t expect it to cure anything"]},{"tag":"a","props":{"href":"/en/tip/03-25"},"children":[{"tag":"span","props":{},"children":["25"]},"Use painkillers such as ibuprofen for period pain instead of just enduring it; if pain disrupts work or school or remains uncontrolled after three months of medication, see a gynecologist"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"Breadcrumb"},"children":[{"tag":"a","props":{"href":"/en/book"},"children":["Explore the book"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/en/book/03"},"children":["Chapter 3"," ·"," ","Don’t waste your energy"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"03-20"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["20"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["Evidence"," ","A"]}]},{"tag":"h1","props":{"lang":"en"},"children":["Don’t make “how others are doing” a daily habit: set limits on apps that show peers’ updates or turn them off"]},{"tag":"p","props":{"lang":"en","className":"life-entry-summary"},"children":["People who habitually compare themselves to others online tend to feel worse emotionally and have lower self‑esteem. Meta‑analysis of over 36,000 participants shows a moderate correlation between upward social comparison and poorer psychological outcomes. Correlation does not equal causation, but randomized trials back this link: after four weeks without Facebook, participants reported a slight rise in happiness. Another study limited three major platforms to 10 minutes per day; after three weeks, loneliness and depression both declined. The trade‑off? Knowledge of current events also dropped during those four weeks of abstinence."]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Cost"]},{"tag":"p","props":{},"children":["This costs nothing. Setting time limits or deactivating an…"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Benefit"]},{"tag":"p","props":{},"children":["The combined results of 54 independent studies — 94 effect sizes and a total N of 36,583 — analyzed via a thre…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"Mark: Don’t make “how others are doing” a daily habit: set limits on apps that show peers’ updates or turn them off"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"Done"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"Plan to do"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"Save"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Share this tip"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Hide details"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Cost"]},{"tag":"p","props":{},"children":["This costs nothing. Setting time limits or deactivating an account takes just a few minutes. The real challenge is resisting the urge to open these apps again later on."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Benefit"]},{"tag":"p","props":{},"children":["The combined results of 54 independent studies — 94 effect sizes and a total N of 36,583 — analyzed via a three‑level random‑effects model reveal that upward social comparison correlates with poorer mental health (average r = 0.330, 95% CI 0.289–0.370). Specific effects include higher fear of negative evaluation (r = 0.438), anxiety (0.382), depression (0.306), lower happiness (0.268) and lower self‑esteem (0.263). Life satisfaction increased by 0.12 standard deviations, while happiness rose by 0.08 standard deviations. Age, cultural background and data collection year do not alter this link. In a randomized trial of 2,743 U.S. Facebook users, 61% would accept a four‑week suspension at a cost of under $102; those in the suspension group gained 0.09 standard deviations in overall life satisfaction. Compared with typical psychological interventions (which raise happiness by ~0.34 SD and cut depression by ~0.23 SD), this effect is roughly 25–40% of that magnitude. After the trial ended, former suspension users still spent 0.31 fewer standard deviations per day on Facebook. Even after the trial ended, former suspension users still spent 12 fewer minutes per day on Facebook. A smaller trial of 143 college students showed similar benefits after limiting three platforms to 10 minutes daily. Additionally, knowledge of current affairs declined by 0.19 standard deviations, and political polarization fell by 0.16 standard deviations as a result of reduced app usage."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Original sources"]},{"tag":"p","props":{"className":"life-citations"},"children":["Lei Y, Hu S, Sun Y, Zheng L (2026). \"Looking up\" linked to feeling down: a meta-analysis of online upward social comparison and psychological maladjustment. Frontiers in Psychology. ",{"tag":"a","props":{"href":"https://doi.org/10.3389/fpsyg.2026.1825169","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.3389/fpsyg.2026.1825169"]},"；Allcott H, Braghieri L, Eichmeyer S, Gentzkow M (2020). The Welfare Effects of Social Media. American Economic Review, 110(3), 629–676. ",{"tag":"a","props":{"href":"https://doi.org/10.1257/aer.20190658","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1257/aer.20190658"]},"；Allcott H, Braghieri L, Eichmeyer S, Gentzkow M (2019). The Welfare Effects of Social Media. NBER Working Paper No. 25514（本条引用的具体数字按这一版逐字核对，刊出版的摘要不含数字）. ",{"tag":"a","props":{"href":"https://www.nber.org/papers/w25514","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.nber.org/papers/w25514"]},"；Hunt MG, Marx R, Lipson C, Young J (2018). No More FOMO: Limiting Social Media Decreases Loneliness and Depression. Journal of Social and Clinical Psychology, 37(10), 751–768. ",{"tag":"a","props":{"href":"https://doi.org/10.1521/jscp.2018.37.10.751","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1521/jscp.2018.37.10.751"]}]},{"tag":"a","props":{"href":"https://doi.org/10.3389/fpsyg.2026.1825169","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Open source link"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Book note"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["The correlation findings merely indicate that these patterns tend to appear together; they do not prove causation. The randomized trials do suggest causal links, but they involve U.S. participants prior to the 2018 midterm elections, so applying the results directly to Chinese users is a stretch. The undergraduate trial involved only 143 subjects, limiting its statistical power. Overall effect sizes remain modest, so cutting off these apps alone will not resolve all emotional issues. This advice targets usage aimed at monitoring how others are faring; it does not apply to staying in touch with family, seeking information or job hunting. If strict limits prove hard to maintain, start by disabling push notifications, “people you may know” suggestions and homepage recommendations. For broader screen‑time management, see sections 4.15 and 4.16 (hard caps on short‑video apps and scrolling news). When feeling down, consider the actions outlined in section 19 (exercise, sunlight and regular sleep). For those seeking identity through purchases, see section 6.23; those striving to “move up a social rung” should review section 6.24."]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["My note"]},{"tag":"button","props":{"type":"button"},"children":["Write a reminder for yourself…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/en/tip/03-19"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round