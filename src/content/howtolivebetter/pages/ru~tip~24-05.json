ria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M18 20a6 6 0 0 0-12 0"},"children":[]},{"tag":"circle","props":{"cx":"12","cy":"10","r":"4"},"children":[]},{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},{"tag":"span","props":{},"children":["Войти"]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/ru/book/24"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"К содержанию"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["Как сэкономить деньги и избежать лишних хлопот при обращении за медпомощью"]},{"tag":"nav","props":{"aria-label":"Советы главы"},"children":[{"tag":"a","props":{"href":"/ru/tip/24-01"},"children":[{"tag":"span","props":{},"children":["01"]},"Обычные заболевания сначала лечат в поликлинике, после чего пациента направляют в более крупные больницы; при этом порог оплаты за госпитализацию учитывается лишь один раз"]},{"tag":"a","props":{"href":"/ru/tip/24-02"},"children":[{"tag":"span","props":{},"children":["02"]},"В пределах одной территории медстрахования (места участия в программе ибао) чем ниже уровень больницы, тем выше процент возмещения — разница составляет примерно 10 процентных пунктов"]},{"tag":"a","props":{"href":"/ru/tip/24-03"},"children":[{"tag":"span","props":{},"children":["03"]},"Чтобы попасть в крупную больницу, нужно воспользоваться направлением от местного медучреждения или обратиться в центр направлений при больнице — не стоит обращаться к спекулянтам билетов"]},{"tag":"a","props":{"href":"/ru/tip/24-04"},"children":[{"tag":"span","props":{},"children":["04"]},"Перед тем как лечиться в другом регионе, сначала уточните ситуацию у местного врача — оценку необходимости в принципе должен дать врач не ниже уровня доцента"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/ru/tip/24-05","data-status":"active"},"children":[{"tag":"span","props":{},"children":["05"]},"Не стоит больше использовать больницы третьего уровня лишь как аптеки — при стабильном течении хронических заболеваний лечение перейдет на первичный уровень"]},{"tag":"a","props":{"href":"/ru/tip/24-06"},"children":[{"tag":"span","props":{},"children":["06"]},"При возникновении сомнений в лечении сразу требуйте опечатывания медицинской карты — при этом должны присутствовать обе стороны, составляется опись, и каждая сторона получает свой экземпляр"]},{"tag":"a","props":{"href":"/ru/tip/24-07"},"children":[{"tag":"span","props":{},"children":["07"]},"После каждого визита к врачу делайте копии своей медицинской карты, результатов анализов и снимков"]},{"tag":"a","props":{"href":"/ru/tip/24-08"},"children":[{"tag":"span","props":{},"children":["08"]},"Даже если у вас нет денег, документов или вы не можете назвать свое имя, в отделении неотложной помощи вас обязаны сначала вылечить"]},{"tag":"a","props":{"href":"/ru/tip/24-09"},"children":[{"tag":"span","props":{},"children":["09"]},"Оценку степени инвалидности проводят только после завершения лечения; ранняя оценка даёт более низкий уровень"]},{"tag":"a","props":{"href":"/ru/tip/24-10"},"children":[{"tag":"span","props":{},"children":["10"]},"После лечения действительно остаются функциональные нарушения; для получения удостоверения инвалида нужно обратиться в районное отделение Союза инвалидов по месту регистрации хукоу"]},{"tag":"a","props":{"href":"/ru/tip/24-11"},"children":[{"tag":"span","props":{},"children":["11"]},"Поблагодарите врача, спасшего вас: пишите благодарственные письма, вручайте благодарственные знаки и оставляйте оценки удовлетворённости, но не давайте «красные конверты»: правила запрещают именно материальные блага, а не саму благодарность"]},{"tag":"a","props":{"href":"/ru/tip/24-12"},"children":[{"tag":"span","props":{},"children":["12"]},"До имплантации зуба выясните, что входит в пакетную цену; выбирайте учреждения, участвующие в регулировании цен, и не доверяйте дешевой рекламе"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"Навигация"},"children":[{"tag":"a","props":{"href":"/ru/book"},"children":["Книга"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/ru/book/24"},"children":["Глава 24"," ·"," ","Как сэкономить деньги и избежать лишних хлопот при обращении за медпомощью"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"24-05"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["05"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["Доказательства"," ","A"]}]},{"tag":"h1","props":{"lang":"ru"},"children":["Не стоит больше использовать больницы третьего уровня лишь как аптеки — при стабильном течении хронических заболеваний лечение перейдет на первичный уровень"]},{"tag":"p","props":{"lang":"ru","className":"life-entry-summary"},"children":["Впредь больницы третьего уровня будут заниматься в основном экстренными и тяжелыми случаями, а также сложными диагнозами. Повторные приемы при обычных заболеваниях и приемы у врачей при стабильном течении хронических болезней постепенно будут сокращаться. Приемы у тех же специалистов перенесут в поликлиники на первичном уровне. Если и дальше обращаться в крупные больницы лишь за лекарствами, в будущем будет всё сложнее получить туда запись."]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Затраты"]},{"tag":"p","props":{},"children":["Не требует затрат. Главная сложность — избавиться от привы…"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Польза"]},{"tag":"p","props":{},"children":["Больницы третьего уровня смогут сосредоточиться на экстренных и сложных случаях, постепенно сокращая приемы пр…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"Отметить: Не стоит больше использовать больницы третьего уровня лишь как аптеки — при стабильном течении хронических заболеваний лечение перейдет на первичный уровень"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"Сделано"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"В планах"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"В избранное"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Поделиться советом"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Скрыть подробности"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Затраты"]},{"tag":"p","props":{},"children":["Не требует затрат. Главная сложность — избавиться от привычки «доверять только крупным больницам»."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Польза"]},{"tag":"p","props":{},"children":["Больницы третьего уровня смогут сосредоточиться на экстренных и сложных случаях, постепенно сокращая приемы при обычных заболеваниях, а также приемы у пациентов с хроническими болезнями, у которых диагноз уже поставлен и течение заболевания стабильно. То есть количество записей на такие обычные приемы будет постепенно уменьшаться в зависимости от обстоятельств. Кроме того, специалисты из крупных больниц будут вести приемы на первичном уровне, то есть те же врачи будут принимать пациентов в местных поликлиниках."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Первоисточники"]},{"tag":"p","props":{"className":"life-citations"},"children":["国务院 (2018). 医疗纠纷预防和处理条例（国务院令第 701 号）第十六条：「患者有权查阅、复制其门诊病历、住院志、体温单、医嘱单、化验单（检验报告）、医学影像检查资料、特殊检查同意书、手术同意书、手术及麻醉记录、病理资料、护理记录、医疗费用以及国务院卫生主管部门规定的其他属于病历的全部资料。」「患者要求复制病历资料的，医疗机构应当提供复制服务，并在复制的病历资料上加盖证明印记……可以收取工本费，收费标准应当公开。」「患者死亡的，其近亲属可以依照本条例的规定，查阅、复制病历资料。」第十五条「任何单位和个人不得篡改、伪造、隐匿、毁灭或者抢夺病历资料。」",{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/2018-08/31/content_5318057.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/zhengce/zhengceku/2018-08/31/content_5318057.htm"]},"；国家卫生计生委、国家中医药管理局 (2013). 医疗机构病历管理规定（2013 年版）：医疗机构「应当指定部门或者专（兼）职人员负责受理复制病历资料的申请」，复制在申请人在场的情况下进行并加盖证明印记. ",{"tag":"a","props":{"href":"http://www.gov.cn/gongbao/content/2014/content_2600084.htm","target":"_blank","rel":"noopener noreferrer"},"children":["http://www.gov.cn/gongbao/content/2014/content_2600084.htm"]}]},{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/2018-08/31/content_5318057.htm","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Открыть источник"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Примечание автора"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["Это направление государственной политики, а не рекомендация. В будущем запись на обычные приемы в крупные больницы будет всё сложнее. При стабильном течении хронических заболеваний на первичном уровне можно получить лекарства сразу на 12 недель — об этом говорится в разделе 16."]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Моя заметка"]},{"tag":"button","props":{"type":"button"},"children":["Запишите напоминание…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/ru/tip/24-04"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Предыдущий"]},"Перед тем как лечиться в другом регионе, сначала уточните ситуацию у местного врача — оценку необходимости в принципе должен дать врач не ниже уровня доцента"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/ru/tip/24-06"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Следующий"]},"При возникновении сомнений в лечении сразу требуйте опечатывания медицинской карты — при этом должны присутствовать обе стороны, составляется опись, и каждая сторона получает свой экземпляр"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["Другие советы по этой теме"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/24-01"},"children":[{"tag":"strong","props":{},"children":["Обычные заболевания сначала лечат в поликлинике, после чего пациента направляют в более крупные больницы; при этом порог оплаты за госпитализацию учитывается лишь один раз"]},{"tag":"span","props":{},"children":["Сначала обращаетесь в поликлинику, а затем она направляет вас в крупн…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/24-02"},"children":[{"tag":"strong","props":{},"children":["В пределах одной территории медстрахования (места участия в программе ибао) 