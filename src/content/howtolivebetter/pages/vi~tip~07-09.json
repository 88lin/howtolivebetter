children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Chia sẻ mẹo này"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Ẩn chi tiết"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Chi phí"]},{"tag":"p","props":{},"children":["Phần bạn tự đóng, mỗi người mỗi năm không dưới 400 tệ. Đây là tiêu chuẩn quốc gia năm 2024、2025, mỗi nơi có thể cao hơn mức này. Phải đóng trong đúng khoảng thời gian thu phí tập trung cố định mỗi năm. Người đặc biệt khó khăn được hỗ trợ toàn bộ, khoản này do nhà nước trả hết. Đối tượng trợ cấp người có thu nhập thấp được hỗ trợ định mức, nhà nước trả một phần cố định."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Lợi ích"]},{"tag":"p","props":{},"children":["Ngoài phần tự đóng, ngân sách còn hỗ trợ thêm theo đầu người. Năm 2024 không dưới 670 tệ, năm 2025 cao hơn năm trước 30 tệ, không dưới 700 tệ, phần cá nhân vẫn không dưới 400 tệ (医保发〔2025〕22 号, theo văn bản của tỉnh chuyển tiếp). Trong báo cáo chính phủ năm 2026 nói sẽ tăng thêm 24 tệ. Đối tượng trợ cấp người có thu nhập thấp và người đặc biệt khó khăn, chi phí y tế đúng quy định, sau khi bảo hiểm y tế thanh toán phần còn lại, vẫn có thể đi trợ cấp y tế chi trả lần nữa với tỷ lệ không dưới 70%. Cái giá của việc đứt đóng là thời gian chờ. Không tham gia trong kỳ thu phí tập trung hoặc không đóng liên tục, sau khi đóng xong có 3 tháng thời gian chờ cố định, khoảng thời gian này khám bệnh không được chi trả. Mỗi năm đứt thêm, về nguyên tắc cộng thêm 1 tháng (áp dụng từ 2025, toàn quốc)"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Nguồn gốc"]},{"tag":"p","props":{"className":"life-citations"},"children":["国家医保局 (2024). 《关于做好 2024 年城乡居民基本医疗保障有关工作的通知》政策解读（医保发〔2024〕19 号）. ",{"tag":"a","props":{"href":"https://www.nhsa.gov.cn/art/2024/8/26/art_105_13634.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.nhsa.gov.cn/art/2024/8/26/art_105_13634.html"]},"；河北省医疗保障局等 (2025). 关于做好 2025 年城乡居民基本医疗保障有关工作的通知（冀医保发〔2025〕6 号，地方文件）. ",{"tag":"a","props":{"href":"https://www.renqiu.gov.cn/renqiu/ybjbmwj/202510/6d90754638a248cba655e94ea518a3bb.shtml","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.renqiu.gov.cn/renqiu/ybjbmwj/202510/6d90754638a248cba655e94ea518a3bb.shtml"]},"；安徽省医疗保障局等 (2025). 关于做好 2025 年城乡居民基本医疗保障有关工作的通知（淮北市医保局转载）：「按照国家医保局、财政部、国家税务总局《关于做好2025年城乡居民基本医疗保障有关工作的通知》（医保发〔2025〕22号）要求」「居民医保人均财政补助标准较上年提高30元，达到每人每年不低于700元」. ",{"tag":"a","props":{"href":"https://ybj.huaibei.gov.cn/zcwj/zcwj/58004084.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://ybj.huaibei.gov.cn/zcwj/zcwj/58004084.html"]},"；国务院办公厅 (2021). 关于健全重特大疾病医疗保险和救助制度的意见（国办发〔2021〕42 号）. ",{"tag":"a","props":{"href":"https://www.gov.cn/gongbao/content/2021/content_5659514.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/gongbao/content/2021/content_5659514.htm"]},"；国务院办公厅 (2024). 关于健全基本医疗保险参保长效机制的指导意见（国办发〔2024〕38 号）. ",{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/content/202408/content_6965741.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/zhengce/content/202408/content_6965741.htm"]},"；国家医保局 (2026). 2026 年政府工作报告提到这些医保工作. ",{"tag":"a","props":{"href":"https://www.nhsa.gov.cn/art/2026/3/5/art_14_19809.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.nhsa.gov.cn/art/2026/3/5/art_14_19809.html"]}]},{"tag":"a","props":{"href":"https://www.nhsa.gov.cn/art/2024/8/26/art_105_13634.html","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Liên kết mở nguồn"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Ghi chú sách"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["Thông báo năm 2025 của Cục Quản lý bảo hiểm y tế quốc gia（医保发〔2025〕22 号）không được đăng công khai trên trang của Cục và trang Chính phủ Trung Quốc. Hai con số 700 tệ và 400 tệ trùng nhau trong văn bản của Hà Bắc và An Hui, bản An Hui ghi rõ là theo thông báo này mà đặt. Trong thời gian lĩnh bảo hiểm thất nghiệp, bảo hiểm y tế do quỹ bảo hiểm thất nghiệp đóng thay, không cần tham gia trùng."]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Ghi chú của tôi"]},{"tag":"button","props":{"type":"button"},"children":["Viết một lời nhắc cho chính bạn…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/vi/tip/07-08"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Trước"]},"Người có giấy chứng nhận người khuyết tật thì đi xin hai khoản trợ cấp cho người khuyết tật"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/vi/tip/07-10"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Tiếp theo"]},"Mắc bệnh nặng thì đi theo bảo hiểm y tế, bảo hiểm bệnh nan y, trợ cấp y tế và đăng ký khám ngoài tỉnh trước, đừng đụng vào vay tiền trên mạng"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["Thêm trong chủ đề này"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/07-05"},"children":