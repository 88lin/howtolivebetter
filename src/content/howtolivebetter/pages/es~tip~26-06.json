w.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"Guardar"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Compartir consejo"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Ocultar detalles"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Coste"]},{"tag":"p","props":{},"children":["El personal y los mecanismos de moderación son el mayor gasto permanente de una plataforma; el canal de denuncias y los registros de las actuaciones deben quedar documentados"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Beneficio"]},{"tag":"p","props":{},"children":["La plataforma «debe asumir la responsabilidad principal de la gestión del contenido informativo», «perfeccionar los sistemas de registro de usuarios, gestión de cuentas, revisión de la publicación de información, revisión de comentarios y respuestas, gestión de la ecología de las páginas, patrullaje en tiempo real, respuesta ante emergencias y tratamiento de rumores en red e información de industrias ilícitas en cadena», y «debe establecer en un lugar destacado un canal cómodo de quejas y denuncias»; quien descubra información ilegal «debe adoptar de inmediato las medidas de tratamiento conforme a la ley, conservar los registros pertinentes y reportar a las autoridades competentes»; la Ley de Seguridad Cibernética exige que «al descubrir información cuya publicación o transmisión está prohibida por las leyes y normas administrativas, se detenga de inmediato su transmisión y se adopten medidas de eliminación y otras medidas de tratamiento para impedir su difusión, se conserven los registros pertinentes y se reporte a las autoridades competentes»; quien no lo haga recibe la orden de corregir, una advertencia y una notificación pública, con multa posible de 50 000 a 500 000 yuanes; quien se niegue a corregir o incurra en casos graves recibe multa de 500 000 a 2 000 000 de yuanes, y puede además ordenársele la suspensión del negocio, el cierre del sitio web o de la aplicación, o la revocación de la licencia o de la licencia comercial; los responsables directos reciben multas de 50 000 a 200 000 yuanes (todo el país)"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Fuentes originales"]},{"tag":"p","props":{"className":"life-citations"},"children":["国家互联网信息办公室 (2019). 网络信息内容生态治理规定（网信办令第 5 号，第八、九、十、十六、三十七条）. ",{"tag":"a","props":{"href":"http://www.cac.gov.cn/2019-12/20/c_1578375159509309.htm","target":"_blank","rel":"noopener noreferrer"},"children":["http://www.cac.gov.cn/2019-12/20/c_1578375159509309.htm"]}," ; 全国人大常委会 (2025). 网络安全法（2025 年修正，2026 年 1 月 1 日施行，第四十九、六十九条）. ",{"tag":"a","props":{"href":"https://www.cac.gov.cn/2025-12/29/c_1768735112911946.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.cac.gov.cn/2025-12/29/c_1768735112911946.htm"]}," ; 国务院 (2000). 互联网信息服务管理办法（第十五、十六、二十三条）. ",{"tag":"a","props":{"href":"https://www.gov.cn/gongbao/content/2011/content_1860864.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/gongbao/content/2011/content_1860864.htm"]}]},{"tag":"a","props":{"href":"http://www.cac.gov.cn/2019-12/20/c_1578375159509309.htm","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Abrir fuente"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Nota del autor"]},{"tag":"p","props":{"className":"life-citations"},"ch