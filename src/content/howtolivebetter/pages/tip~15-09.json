ps":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["成本"]},{"tag":"p","props":{"className":"life-citations"},"children":["不花钱。代价是房子不归你，租期一次最长 20 年，到期要重新和房东谈"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["收益"]},{"tag":"p","props":{"className":"life-citations"},"children":["国务院办公厅的文件写得很明白：「城镇居民不得到农村购买宅基地、农民住宅或『小产权房』。」同一份文件还规定，农民卖掉或者租出住房以后，再申请宅基地不予批准。2019 年中央农办和农业农村部的文件又说了一遍：「严禁城镇居民到农村购买宅基地。」同一份文件给出了合法的路：城镇居民可以租农房居住或者经营，租赁合同的期限不得超过二十年，到期双方可以另行约定"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["来源"]},{"tag":"p","props":{"className":"life-citations"},"children":["国务院办公厅 (2007). 关于严格执行有关农村集体建设用地法律和政策的通知（国办发〔2007〕71 号）. ",{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/2008-03/28/content_2395.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/zhengce/zhengceku/2008-03/28/content_2395.htm"]},"；中央农村工作领导小组办公室、农业农村部 (2019). 关于进一步加强农村宅基地管理的通知（中农发〔2019〕11 号）第五、六部分. ",{"tag":"a","props":{"href":"https://www.moa.gov.cn/govpublic/NCJJTZ/201909/t20190920_6328397.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.moa.gov.cn/govpublic/NCJJTZ/201909/t20190920_6328397.htm"]},""]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["原书备注"]},{"tag":"p","props":{"className":"life-citations"},"children":["宅基地就是村里分给本村村民盖房的地，只能分给本村人。租农房时和出租的农户签书面合同，写清租期、租金、能不能装修改建，以及装修的钱到期怎么算。文件规定租期不超过 20 年，别签「租 50 年」「租 70 年」这类合同，更别一次付清多年租金。文件还禁止下乡用宅基地盖别墅大院和私人会馆，别出钱给村民「合建」。"]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["我的备注"]},{"tag":"button","props":{"type":"button"},"children":["写下对自己有用的提醒…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/tip/15-08"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["上一条"]},"别租隔断房：最小出租单位是原设计的房间，厨房、卫生间、阳台不得住人"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/tip/15-10"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["下一条"]},"买期房时先看预售许可证，定金、首付和贷款只打进合同写明的预售资金监管账户"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["本主题的其他建议"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/15-02"},"children":[{"tag":"strong","props":{},"children":["被断水断电、换锁、上门威胁赶人，先报警留证：法规禁止用这些方式逼你腾房"]},{"tag":"span","props":{},"children":["房东不能靠断水断电、换锁、上门威胁逼你解约或者搬走，法规明令禁止。遇上了先报警。出警记录是你以后要求赔损失的证据。不要自己动手和对方对抗。"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/15-03"},"children":[{"tag":"strong","props":{},"children":["中介不得代收代付租金和押金，钱直接给房东"]},{"tag":"span","props":{},"children":["按规定，房租和押金不能由中介代收代付，钱直接付给房东。钱在中介手里过一道，就多一次它卷款跑路的机会。真跑了，你租金白交，还会被房东赶走。付款前核对收款人是不是产…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/15-04"},"children":[{"tag":"strong","props":{},"children":["租长租公寓先查它的资金监管账户，别图便宜一次性付一年"]},{"tag":"span","props":{},"children":["一次性付一年，拿到的折扣就那么点。公司一旦倒了，你的押金和剩下十几个月的房租一起没。绑了租金贷更糟：公寓跑了，贷款还是你按月还完。签约前先查它有没有公示资金监管…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/15-05"},"children":[{"tag":"strong","props":{},"children":["房子租期内被卖掉，租约继续有效，不用搬"]},{"tag":"span","props":{},"children":["租期内房子被卖掉，你的租约照样有效。新房东要按原来的合同让你住到期满。不用搬，也不用重新谈价钱。前提是你已经合法住在里面，合同、转账记录、入住时间的证据都留好。"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/15-06"},"children":[{"tag":"strong","props":{},"children":["租房签约前核对产权证和抵押情况，所有款项走转账并备注用途"]},{"tag":"span","props":{},"children":["签约前让房东拿出身份证和产权证。再带身份证去不动产登记机构，查房子有没有抵押、有没有被查封，没签合同也能查。出租前就抵押或者查封的房子，被拍卖换了主人，你没法要…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/15-07"},"children":[{"tag":"strong","props":{},"children":["二手房让中介代收房款的，必须走中介在银行开的交易资金专用存款账户"]},{"tag":"span","props":{},"children":["房款是几十万到几百万，是这本书里单笔金额最大的一件事。中介代收房款的，按规定必须走它在银行开的专用账户，不能微信转给经纪人个人。另外，两家中介合做一单只能收一份…"]}]}]}]},{"tag":"a","props":{"className":"life-text-link","href":"/book/15"},"children":["阅读整个主题：租房与买房 ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"15","height":"15","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]}]}]},{"tag":"nav","props":{"className":"life-tabbar","aria-label":"主导航"},"children":[{"tag":"a","props":{"className":"","href":"/book"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"21","height":"21","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-book-open","aria-hidd