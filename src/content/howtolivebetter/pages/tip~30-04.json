"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"分享这条建议"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"收起详情"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["成本"]},{"tag":"p","props":{"className":"life-citations"},"children":["不花钱。但每天要腾出时间，多半得从写作业和上网课的时间里挤。难在天天都要做到，不是做几次就完。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["收益"]},{"tag":"p","props":{"className":"life-citations"},"children":["广州 12 所小学的一年级学生，以学校为单位抽签分组（干预校 952 人，对照校 951 人，平均年龄 6.6 岁）。干预的做法是每个上学日增加 1 节 40 分钟户外活动课，并鼓励家长在课外多带孩子出去。3 年里新近视的比例，干预组 30.4%，是 853 名合格者中的 259 例；对照组 39.5%，是 726 名中的 287 例。两组差值 -9.1 个百分点（95% CI -14.1 至 -4.1，P<0.001），真实差距大致在少 4 到少 14 个百分点之间。3 年里度数的加深量（等效球镜变化）是 -1.42 D 对 -1.59 D，差 0.17 D（P=0.04）。干预组加深得略少一点。D 是量度数的单位。眼轴（眼球前后的长度）的增长，两组看不出差别（P=0.07）。《防控儿童青少年近视核心知识十条》要求儿童青少年每天日间户外活动不少于 2 小时，或每周累计 14 小时。它注明即使阴天，户外活动也有防护效果，并要求避开午后高温强晒的时段。用药防近视也有抽签试验。香港 474 名 4 到 9 岁、还没近视的孩子分三组，每晚点一次眼药水，连点两年。点 0.05% 阿托品的，两年里近视的比例是 28.4%，点安慰剂的是 53.0%。点 0.01% 阿托品的是 45.9%，和安慰剂比看不出差别"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["来源"]},{"tag":"p","props":{"className":"life-citations"},"children":["He M, et al. (2015). Effect of Time Spent Outdoors at School on the Development of Myopia Among Children in China: A Randomized Clinical Trial. JAMA. ",{"tag":"a","props":{"href":"https://doi.org/10.1001/jama.2015.10803","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1001/jama.2015.10803"]},"；Yam JC, Zhang XJ, Zhang Y, et al. (2023). Effect of Low-Concentration Atropine Eyedrops vs Placebo on Myopia Incidence in Children: The LAMP2 Randomized Clinical Trial. JAMA, 329(6), 472-481. ",{"tag":"a","props":{"href":"https://doi.org/10.1001/jama.2022.24162","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1001/jama.2022.24162"]},"；国家卫生健康委办公厅 (2023). 防控儿童青少年近视核心知识十条（国卫办妇幼函〔2023〕278 号）. ",{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/202307/content_6894284.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/zhengce/zhengceku/202307/content_6894284.htm"]},""]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["原书备注"]},{"tag":"p","props":{"className":"life-citations"},"children":["这项试验只做了 3 年，参加的孩子也都是从 6 岁开始的。两组近视的比例差 9.1 个百分点，只能让一部分人不近视，保证不了不近视。同一份核心知识十条还给了几条做法。读写要「一尺一拳一寸」。近距离用眼 20 分钟后，要远眺 20 秒以上。中小学生不为学习而用电子屏幕的，一次不超过 15 分钟，一天加起来不超过 1 小时。「待在户外」和「上体育课」不是一回事，课间到室外站着也算数。阿托品眼药水那项试验的作者说，还要再做试验确认，也要再看长期是否安全。点不点、点哪种浓度，问眼科医生。作者没查到别的不花钱、不用药的办法有抽签试验。"]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["我的备注"]},{"tag":"button","props":{"type":"button"},"children":["写下对自己有用的提醒…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/tip/30-03"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["上一条"]},"孩子被欺凌，当天就报到学校并要求书面处理，涉及打人、抢钱、传谣的直接报警"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/tip/30-05"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["下一条"]},"0 到 3 岁不给屏幕，3 到 6 岁尽量不给，中小学生非学习用途每天不超过 1 小时"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["本主题的其他建议"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/30-01"},"children":[{"tag":"strong","props":{},"children":["孩子说突然剧痛、而且越来越重，立刻去医院，不要让他忍到放学"]},{"tag":"span","props":{},"children":["有些病是按小时算的。男孩突然一侧阴囊剧痛，可能是睾丸扭转，也就是睾丸连着的那根血管拧住了，血供断了。6 小时内处理，睾丸保住的比例 97.2%。拖到 19 至…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/30-02"},"children":[{"tag":"strong","props":{},"children":["该做的治疗别为了「等考完」往后拖，有些窗口跟着骨龄走，不跟着考试安排走"]},{"tag":"span","props":{},"children":["脊柱侧弯是脊柱往侧面弯。支具是一件硬壳背心，穿在身上把脊柱撑住。骨头还在长的时候戴，75% 的孩子到骨头长完都没弯到 50 度，只观察不戴的只有 42%。能戴的…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/30-06"},"children":[{"tag":"strong","props":{},"children":["把近视当成会留下的损伤：度数越深，将来视网膜脱离、黄斑病变、青光眼越多"]},{"tag":"span","props":{},"children":["近视不会自己好，度数也降不回去。它也不只是「戴个眼镜」的事。和不近视的人比，得近视性黄斑病变的可能，轻度近视高十几倍，600 度以上高几百倍。视网膜脱离，轻度高…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/30-07"},"children":[{"tag":"strong","props":{},"children":["每年那次学生体检的报告单要自己看一遍，异常项当年带去医院查"]},{"tag":"span","props":{},"children":["中小学校每年组织一次学生体检。报告单上要重点看的是超重、肥胖、营养不良、脊柱弯曲异常、视力不良、龋齿。别只看一眼身高体重就收起单子。这几项有异常，当年就带孩子去…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/30-08"},"children":[{"tag":"strong","props":{},"children":["12 到 18 岁的孩子做一次抑郁筛查，别拿学校的心理测评当诊断"]},{"tag":"span","props":{},"children":["美国的预防指南建议给 12 到 18 岁的孩子筛查重度抑郁，11 岁及以下证据不够。在美国，自杀是 10 到 19 岁孩子的第二位死因。学校每年的心理测评只是普…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/30-09"},"children":[{"tag":"strong","props":{},"children":["不买号称能「治愈近视」「降低度数」的产品和服务"]},{"tag":"span","props":{},"children":["市场监管总局明说「在目前医疗技术条件下，近视不能治愈」。宣传「恢复」「降低度数」「近视治愈」「度数修复」这类说法的，要从严查处。看到这类词直接排除，不用再比价。…"]}]}]}]},{"tag":"a","props":{"className":"life-text-link","href":"/book/30"},"children":["阅读整个主题：上学以后的孩子 ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"15","height":"15","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]}]}]},{"tag":"nav","props":{"className":"life-tabbar","aria-label":"主导航"},"children":[{"tag":"a","props":{"className":"","href":"/book"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"21","height":"21","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-book-open","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M12 7v