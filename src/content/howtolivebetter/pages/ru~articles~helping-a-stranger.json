ath","props":{"d":"M18 20a6 6 0 0 0-12 0"},"children":[]},{"tag":"circle","props":{"cx":"12","cy":"10","r":"4"},"children":[]},{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},{"tag":"span","props":{},"children":["Войти"]}]}]}]},{"tag":"main","props":{"className":"life-longread"},"children":[{"tag":"a","props":{"className":"life-back-link active","href":"/ru/articles","data-status":"active","aria-current":"page"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"Все статьи"]},{"tag":"header","props":{"className":"life-longread-header"},"children":[{"tag":"div","props":{},"children":[{"tag":"div","props":{"className":"life-eyebrow"},"children":["Статьи"]},{"tag":"h1","props":{"lang":"ru"},"children":["Стоит ли останавливаться, если с незнакомцем случилась беда"]},{"tag":"p","props":{"lang":"ru"},"children":["Это развёрнутая версия пункта 2 главы 13. По принятой в книге шкале «для кого выгода» незнакомец — самая нижняя из четырёх ступеней: рассчитывать на ответную пользу почти не приход…"]},{"tag":"a","props":{"className":"life-longread-chapter","href":"/ru/book/13"},"children":["Глава по теме"," · ","Что делать в экстренной ситуации",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"img","props":{"src":"/sites/howtolivebetter/images/book-chapters/13-emergency-editorial.webp","srcSet":"/sites/howtolivebetter/images/book-chapters/13-emergency-editorial-thumb.webp 600w, /sites/howtolivebetter/images/book-chapters/13-emergency-editorial-md.webp 900w, /sites/howtolivebetter/images/book-chapters/13-emergency-editorial.webp 1200w","sizes":"(max-width: 760px) 100vw, 450px","alt":"","width":"1200","height":"800","fetchPriority":"high"},"children":[]}]},{"tag":"div","props":{"className":"life-longread-layout"},"children":[{"tag":"aside","props":{"className":"life-longread-toc"},"children":[{"tag":"details","props":{"open":true},"children":[{"tag":"summary","props":{},"children":["В этой статье"]},{"tag":"nav","props":{"aria-label":"В этой статье"},"children":[{"tag":"a","props":{"href":"#три-пути"},"children":["Три пути"]},{"tag":"a","props":{"href":"#издержки-которые-могут-проявиться-после-того-как-вы-остановились--от-лёгких-к-тяжёлым"},"children":["Издержки, которые могут проявиться после того, как вы остановились, — от лёгких к тяжёлым"]},{"tag":"a","props":{"href":"#три-случая-когда-уйти-перестаёт-быть-бесплатным"},"children":["Три случая, когда «уйти» перестаёт быть бесплатным"]},{"tag":"a","props":{"href":"#когда-вы-всё-же-решили-остановиться-наименее-затратный-порядок-действий"},"children":["Когда вы всё же решили остановиться: наименее затратный порядок действий"]},{"tag":"a","props":{"href":"#источники"},"children":["Источники"]}]}]}]},{"tag":"div","props":{"className":"life-longread-main"},"children":[{"tag":"article","props":{"className":"life-article-body","lang":"ru"},"children":[{"tag":"blockquote","props":{},"children":["\n",{"tag":"p","props":{},"children":["Неофициальный перевод файла ",{"tag":"a","props":{"href":"/articles/helping-a-stranger"},"children":["docs/遇到陌生人出事该不该停.md"]},". При расхождениях приоритет у китайского оригинала."]},"\n"]},"\n",{"tag":"p","props":{},"children":[{"tag":"a","props":{"href":"https://github.com/eternity4719/HowToLiveBetter/README.ru.md","target":"_blank","rel":"noopener noreferrer"},"children":["← К общему оглавлению"]}]},"\n",{"tag":"blockquote","props":{},"children":["\n",{"tag":"p","props":{},"children":["Примечание переводчика: все телефоны в статье — китайские: 120 — скорая помощь, 110 — полиция. В России скорая — 103, полиция — 102, единый номер экстренных служб — 112. Линия психологической помощи 12356: в России аналог — 8-800-2000-122. Все упомянутые законы и статьи — законодательство КНР; для читателя за пределами Китая это справочный материал, а не действующее право."]},"\n"]},"\n",{"tag":"p","props":{},"children":["Это развёрнутая версия ",{"tag":"a","props":{"href":"/ru/book/13#13-02","title":"Если пожилой упал или человек лежит на земле, присядьте, позовите его и звоните 120, не спешите поднимать; уйти от незнакомца в Китае тоже законно, но остановившись, не перемещайте его"},"children":["пункта 2 главы 13"]},". По принятой в книге шкале «для кого выгода» незнакомец — самая нижняя из четырёх ступеней: рассчитывать на ответную пользу почти не приходится, а характер его вам неизвестен. Поэтому здесь вас ни к чему не призывают: только полный список счетов, которые надо заплатить на каждом из трёх путей, а выбирать вам."]},"\n",{"tag":"p","props":{},"children":[{"tag":"strong","props":{},"children":["В этой статье нет ни одной вероятности."]}," Каждый уровень издержек ниже — реальный, его можно проверить по конкретным статьям закона, но статистики о том, какая доля спасателей реально с этим сталкивалась, в открытых источниках нет, а правило книги — сомнительную цифру лучше не писать вовсе. Не читайте «перечислено семь уровней» как «все семь до вас дойдут»."]},"\n",{"tag":"h2","props":{"id":"три-пути"},"children":["Три пути"]},"\n",{"tag":"div","props":{"className":"article-table-scroll","tabIndex":"0"},"children":[{"tag":"table","props":{},"children":[{"tag":"thead","props":{},"children":["\n",{"tag":"tr","props":{},"children":["\n",{"tag":"th","props":{},"children":[]},"\n",{"tag":"th","props":{},"children":["Уйти"]},"\n",{"tag":"th","props":{},"children":["Остановиться, но не трогать"]},"\n",{"tag":"th","props":{},"children":["Остановиться и помочь до конца"]},"\n"]},"\n"]},"\n",{"tag":"tbody","props":{},"children":["\n",{"tag":"tr","props":{},"children":["\n",{"tag":"td","props":{},"children":["Законность"]},"\n",{"tag":"td","props":{},"children":["Законно. У обычного человека нет обязанности спасать незнакомца, и в уголовном кодексе нет статьи за «знал о беде и не спас». Это о Китае; в таких странах, как Германия, иначе — см. ниже"]},"\n",{"tag":"td","props":{},"children":["Законно"]},"\n",{"tag":"td","props":{},"children":["Законно"]},"\n"]},"\n",{"tag":"tr","props":{},"children":["\n",{"tag":"td","props":{},"children":["Время"]},"\n",{"tag":"td","props":{},"children":["0"]},"\n",{"tag":"td","props":{},"children":["Несколько минут; звонок на 120 оставляет ваш номер"]},"\n",{"tag":"td","props":{},"children":["Полдня как минимум; возможно, придётся доехать до больницы"]},"\n"]},"\n",{"tag":"tr","props":{},"children":["\n",{"tag":"td","props":{},"children":["Возможность, что вас будут искать потом"]},"\n",{"tag":"td","props":{},"children":["Минимальная"]},"\n",{"tag":"td","props":{},"children":["Вы — тот, кто оставил номер"]},"\n",{"tag":"td","props":{},"children":["Максимальная"]},"\n"]},"\n",{"tag":"tr","props":{},"children":["\n",{"tag":"td","props":{},"children":["Польза для пострадавшего"]},"\n",{"tag":"td","props":{},"children":["0"]},"\n",{"tag":"td","props":{},"children":["Скорая приедет раньше"]},"\n",{"tag":"td","props":{},"children":["Наибольшая"]},"\n"]},"\n"]},"\n"]}]},{"tag":"h2","props":{"id":"издержки-которые-могут-проявиться-после-того-как-вы-остановились--от-лёгких-к-тяжёлым"},"children":["Издержки, которые могут проявиться после того, как вы остановились, — от лёгких к тяжёлым"]},"\n",{"tag":"p","props":{},"children":[{"tag":"strong","props":{},"children":["1. Обратный звонок и опрос."]}," Звонок на 120 или 110 оставляет номер: вам могут перезвонить, чтобы уточнить место, а позже — задать несколько вопросов. Заявителю по уголовному делу, который не хочет раскрывать своё имя, орган, ведущий дело, обязан сохранять тайну (статья 111 Уголовно-процессуального кодекса КНР); для 120 аналогичной нормы нет."]},"\n",{"tag":"p","props":{},"children":[{"tag":"strong","props":{},"children":["2. Вас найдут родственники пострадавшего."]}," Если по камерам не удаётся опознать машину-виновника, легче всего семье найти того, кто оставил номер и был на месте. Возможны и настойчивые звонки, и визиты домой."]},"\n",{"tag":"p","props":{},"children":[{"tag":"strong","props":{},"children":["3. Вас могут записать в ответчики."]}," Тот, кто утверждает, что сбил вас, обязан сам собирать доказательства; не собрал — неблагоприятные последствия ложатся на него (статья 90 разъяснений Верховного народного суда о применении Гражданского процессуального кодекса) — ",{"tag":"strong","props":{},"children":["но эта норма гарантирует лишь исход дела, а не то, что вас в него не втянут"]},". Срок разбирательства по первой инстанции в общем порядке — 6 месяцев, при особых обстоятельствах его продлевают ещё на 6, в упрощённом порядке — 3 месяца (статьи 152 и 164 Гражданского процессуального кодекса КНР). Даже выиграв полностью, переложить на другую сторону можно только три вида расходов: сбор за принятие дела к производству, сборы по заявлениям и расходы на проезд и недополученный заработок свидетелей, экспертов и других вызванных в суд лиц (статьи 6 и 29 Мер по уплате судебных расходов) — ",{"tag":"strong","props":{},"children":["гонорар адвоката в этот список не входит"]},"."]},"\n",{"tag":"p","props":{},"children":[{"tag":"strong","props":{},"children":["4. История дойдёт до вашей работы."]}," Кто нарушает порядок работы предприятий и организаций так, что нормальная работа невозможна, получает предупреждение или штраф до 500 юаней; при более тяжких обстоятельствах — задержание от 5 до 10 суток и штраф до 1000 юаней; кто делает это в толпе: зачинщикам — задержание от 10 до 15 суток (пункт 1 статьи 26 Закона об административных наказаниях за нарушение общественного порядка). За приставания, назойливое преследование и слежку, мешающие нормальной жизни, наказывают по пункту 5 статьи 50 того же закона; кроме того, с одобрения руководителя органа общественной безопасности нарушителю можно запретить контактировать с вами в течение определённого срока. Если работодатель уволит вас из-за этого, такое увольнение, как правило, незаконно, а компенсация считается по формуле 2N (",{"tag":"a","props":{"href":"/ru/book/19#19-06","title":"Незаконное расторжение трудового договора работодателем: компенсация равна двукратному размеру экономической выплаты"},"children":["пункт 6 главы 19"]},") — но и в полицию, и в трудовой арбитраж идти придётся самому, а потерянные месяцы без работы задним числом тот 2N не возместит."]},"\n",{"tag":"p","props":{},"children":[{"tag":"strong","props":{},"children":["5. Вас снимут на видео и выложат в сеть."]}," Главное, что нужно знать на этом уровне: ",{"tag":"strong","props":{},"children":["остановить съёмку вы можете и не суметь"]},". Создавать, использовать и обнародовать изображение человека без его согласия нельзя (статья 1019 Гражданского кодекса КНР), но «создание, использование и обнародование изображения человека, неизбежное при подготовке новостного репортажа», считается добросовестным использованием (пункт 2 статьи 1020 того же кодекса). В ваших силах — не давать интервью, не попадать в кадр, не говорить перед камерой; соглашаться или нет — решаете вы сами, и никто не может дать согласие за вас."]},"\n",{"tag":"p","props":{},"children":[{"tag":"strong","props":{},"children":["6. Повторное распространение и сетевая травля."]}," Как только видео разошлось, комментарии вам неподконтрольны. Что можно сделать самому, описано в Положении об урегулировании информации о травле в интернете (вступило в силу 1 августа 2024 года): платформа обязана предоставлять настройки защиты — блокировку незнакомых или конкретных пользователей, ограничение видимости своей информации, запрет репостов и комментариев, приём личных сообщений только от друзей либо полный отказ от личных сообщений (статья 23); обязана дать функцию быстрого сохранения доказательств травли (статья 25); обязана разместить на видном месте отдельный быстрый вход для жалоб (статья 26); обнаружив признаки правонарушения или преступления, платформа должна без промедления сообщить в органы общественной безопасности (полицию КНР) и передать им имеющиеся сведения (статья 15). Как зафиксировать доказательства и подать заявление — ",{"tag":"a","props":{"href":"/ru/book/08#08-16","title":"В интернете не оскорбляйте, не распространяйте слухи и не пересылайте непроверенную информацию; при кибертравле сначала соберите доказательства, а потом обращайтесь в полицию"},"children":["пункт 14 главы 8"]},"."]},"\n",{"tag":"p","props":{},"children":[{"tag":"strong","props":{},"children":["7. Когда сил уже нет."]}," Первые шесть уровней закрыть через статьи закона можно, седьмой — нет. Надёжных китайских данных о том, как затяжные сетевые атаки отражаются на душевном состоянии, привести нельзя, и книга не даёт цифр, а даёт выход: линия психологической помощи 12356, см. ",{"tag":"a","props":{"href":"/ru/book/01#01-25","title":"При возникновении депрессии или суицидальных мыслей звоните по номеру 12356; дома не храните снотворные и пестициды"},"children":["пункт 25 главы 1"]},"."]},"\n",{"tag":"h2","props":{"id":"три-случая-когда-уйти-перестаёт-быть-бесплатным"},"children":["Три случая, когда «уйти» перестаёт быть бесплатным"]},"\n",{"tag":"ul","props":{},"children":["\n",{"tag":"li","props":{},"children":["\n",{"tag":"p","props":{},"children":[{"tag":"strong","props":{},"children":["Вы за границей."]}," Слова выше о законности ухода относятся к китайскому праву. В некоторых странах неоказание помощи человеку в опасности — преступление. Параграф 323c Уголовного кодекса Германии предусматривает: при несчастном случае, общей опасности или бедствии, когда помощь необходима и разумно ожидаема в данных обстоятельствах, особенно без существенной опасности для себя и нарушения иных важных обязанностей, неоказание помощи карается лишением свободы до 1 года или штрафом. Законы стран различаются; действует право страны, где вы находитесь."]},"\n"]},"\n",{"tag":"li","props":{},"children":["\n",{"tag":"p","props":{},"children":[{"tag":"strong","props":{},"children":["Вы владелец или администрация этого места либо организатор массового мероприятия"]}," (гостиница, торговый центр, банк, вокзал, аэропорт, стадион, развлекательное заведение и т. п.): на вас лежит обязанность обеспечить безопасность; не исполнили её — отвечаете за причинённый вред; если вред нанёс третье лицо, а вы свою обязанность не исполнили, вы несёте соответствующую дополнительную ответственность (статья 1198 Гражданского кодекса КНР). Уйти для дежурного сотрудника или владельца места — не то же самое, что для прохожего."]},"\n"]},"\n",{"tag":"li","props":{},"children":["\n",{"tag":"p","props":{},"children":[{"tag":"strong","props":{},"children":["Происшествие связано с вами"]},": сбили вы, ваша машина, опасность создали ваши прежние действия. Тогда вопрос не «вмешиваться ли в чужое», а порядок действий при ДТП и ответственность за оставление места аварии (",{"tag":"a","props":{"href":"/ru/book/08#08-01","title":"В случае ДТП сначала остановитесь, окажите помощь пострадавшим и вызовите полицию — не уезжайте с места происшествия"},"children":["пункт 1 главы 8"]},")."]},"\n"]},"\n"]},"\n",{"tag":"h2","props":{"id":"когда-вы-всё-же-решили-остановиться-наименее-затратный-порядок-действий"},"children":["Когда вы всё же решили остановиться: наименее затратный порядок действий"]},"\n",{"tag":"ol","props":{},"children":["\n",{"tag":"li","props":{},"children":[{"tag":"strong","props":{},"children":["Не трогайте пострадавшего и не тащите его."]}," Единственный шаг без второго ответа; причина у него медицинская, а не юридическая — грубая попытка поднять человека может усугубить кровоизлияние в мозг или повреждение позвоночника. С юридической стороны вред, причинённый при оказании помощи, прощает статья 184 Гражданского кодекса КНР."]},"\n",{"tag":"li","props":{},"children":["С безопасного расстояния окликните его и определите, дышит ли он; дыхания нет — начинайте компрессии грудной клетки (",{"tag":"a","props":{"href":"/ru/book/13#13-01","title":"Если человек лежит без дыхания, немедленно начните сильно нажимать на грудину, попросив кого-то вызвать скорую (120) и принести дефибриллятор AED"},"children":["пункт 1 главы 13"]},"), дыхание есть — оставайтесь на месте и звоните 120, сообщив, где вы находитесь."]},"\n",{"tag":"li","props":{},"children":["Подзовите ещё одного прохожего и включите видеозапись на телефоне: живые свидетели и записи полезнее, чем потом спорить, что было."]},"\n",{"tag":"li","props":{},"children":["Не грузите его в машину в одиночку и не платите за лечение из своих денег. Это самый затратный и наименее окупаемый отрезок всей истории."]},"\n",{"tag":"li","props":{},"children":["Если, спасая его, пострадали сами или потратили свои деньги — как вернуть деньги, написано в ",{"tag":"a","props":{"href":"/ru/book/13#13-39","title":"Если при спасении человека вы получили травмы и понесли расходы, сначала обратитесь к виновнику и в медстраховку, а затем подайте заявление на признание вас героем-спасателем"},"children":["пункте 40 главы 13"]},"."]},"\n"]},"\n",{"tag":"h2","props":{"id":"источники"},"children":["Источники"]},"\n",{"tag":"ul","props":{},"children":["\n",{"tag":"li","props":{},"children":["全国人大 (2020). 民法典 [рус. «Гражданский кодекс КНР»]（第一百八十四、一千零一十九、一千零二十、一千一百九十八条）. 最高人民检察院转载全文. ",{"tag":"a","props":{"href":"https://www.spp.gov.cn/spp/fl/202006/t20200602_463888.shtml","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.spp.gov.cn/spp/fl/202006/t20200602_463888.shtml"]}]},"\n",{"tag":"li","props":{},"children":["最高人民法院 (2022 年第二次修正，2022 年 4 月 10 日施行). 关于适用《中华人民共和国民事诉讼法》的解释 [рус. «Разъяснения о применении Гражданского процессуального кодекса КНР»]（第九十条）. ",{"tag":"a","props":{"href":"https://www.court.gov.cn/zixun/xiangqing/353651.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.court.gov.cn/zixun/xiangqing/353651.html"]}]},"\n",{"tag":"li","props":{},"children":["全国人大常委会 (2023 年修正，2024 年 1 月 1 日施行). 民事诉讼法 [рус. «Гражданский процессуальный кодекс КНР»]（第一百五十二、一百六十四条）. 上海市发展和改革委员会转载全文. ",{"tag":"a","props":{"href":"https://fgw.sh.gov.cn/ys-syjf-zc-2.4.1-h5/20240408/073febdb2b04464390546232d4089f51.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://fgw.sh.gov.cn/ys-syjf-zc-2.4.1-h5/20240408/073febdb2b04464390546232d4089f51.html"]}]},"\n",{"tag":"li","props":{},"children":["国务院 (2006). 诉讼费用交纳办法 [рус. «Меры по уплате судебных расходов»]（国务院令第 481 号，第六、二十九条）. ",{"tag":"a","props":{"href":"https://www.gov.cn/ziliao/flfg/2006-12/29/content_483682.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/ziliao/flfg/2006-12/29/content_483682.htm"]}]},"\n",{"tag":"li","props":{},"children":["全国人大常委会 (2025). 治安管理处罚法 [рус. «Закон об административных наказаниях за нарушение общественного порядка»]（2025 年修订，2026 年 1 月 1 日起施行，第二十六条第一项、第五十条第五项）. ",{"tag":"a","props":{"href":"https://www.spp.gov.cn/spp/fl/202506/t20250627_699863.shtml","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.spp.gov.cn/spp/fl/202506/t20250627_699863.shtml"]}]},"\n",{"tag":"li","props":{},"children":["全国人大常委会 (2018 年修正). 刑事诉讼法 [рус. «Уголовно-процессуальный кодекс КНР»]（第一百一十一条）. 宁夏回族自治区人民检察院转载全文. ",{"tag":"a","props":{"href":"https://www.nx.jcy.gov.cn/zwsy/qwfb/202011/t20201119_608817.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.nx.jcy.gov.cn/zwsy/qwfb/202011/t20201119_608817.html"]}]},"\n",{"tag":"li","props":{},"children":["国家互联网信息办公室、公安部、文化和旅游部、国家广播电视总局 (2024). 网络暴力信息治理规定 [рус. «Положение об урегулировании инфор