ef":"/ja/tip/34-09"},"children":[{"tag":"span","props":{},"children":["09"]},"鎮痛薬は月に 15 日を超えて服用しないでください。配合鎮痛薬は 10 日を超えないように。さもないと、頭痛そのものが薬によって引き起こされる可能性があります"]},{"tag":"a","props":{"href":"/ja/tip/34-10"},"children":[{"tag":"span","props":{},"children":["10"]},"期限切れの薬や不要な残薬は定期的に処分しましょう。包装ごと有害ゴミとして捨て、家に残さないでください"]},{"tag":"a","props":{"href":"/ja/tip/34-11"},"children":[{"tag":"span","props":{},"children":["11"]},"セファロスポリン系やメトロニダゾールなどの抗菌薬の使用期間中および服用終了後7日間は、飲酒を控えること。藿香正気水（カッコウセイキスイ）や咳止めシロップなど、アルコールを含む薬も避けること"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"現在地"},"children":[{"tag":"a","props":{"href":"/ja/book"},"children":["本を読む"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/ja/book/34"},"children":["第34章"," ·"," ","家庭常備薬の誤用による事故を防ぐ"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"34-02"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["02"]},{"tag":"span","props":{"className":"life-evidence grade-b"},"children":["エビデンス"," ","B"]}]},{"tag":"h1","props":{"lang":"ja"},"children":["子供の発熱にアスピリン、ニメスリド、アンチピリンは使用しないでください。アンチピリンを含む風邪薬も未成年者には与えないでください"]},{"tag":"p","props":{"lang":"ja","className":"life-entry-summary"},"children":["子供の解熱には、これら3種類の薬は使用しないでください。アスピリンはライ症候群に関連しており、この病気は脳や肝臓に損傷を与えます。米国の統計では、患児の約3割が死亡しており、警告が出された後は症例が9割以上減少しました。ニメスリドは 12 歳未満は禁忌、アンチピリンは 18 歳未満は禁忌です。"]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["費用・手間"]},{"tag":"p","props":{},"children":["費用はかかりません。解熱剤を購入する際は、一般名と成分表を確認してください。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["効果"]},{"tag":"p","props":{},"children":["ライ症候群は脳症や肝脂肪変性を引き起こし、通常はインフルエンザや水痘の後に発生します。"]}]}]},{"tag":"div","props":{"classNam