7 2.17 0 0 0 0 3.08c.82.82 2.13.85 3 .07l2.07-1.9a2.82 2.82 0 0 1 3.79 0l2.96 2.66"},"children":[]},{"tag":"path","props":{"d":"m18 15-2-2"},"children":[]},{"tag":"path","props":{"d":"m15 18-2-2"},"children":[]}]},{"tag":"div","props":{},"children":[{"tag":"p","props":{},"children":["Trả lời 5 câu hỏi thay bố mẹ để tìm ra những việc đáng làm trước nhất cho họ: lừa đảo nhắm vào người cao tuổi, dùng thuốc trong nhà an toàn, tầm soát, giám hộ theo thỏa thuận và bảo hiểm chăm sóc dài hạn."]},{"tag":"div","props":{"className":"checkup-intro-actions"},"children":[{"tag":"button","props":{"type":"button","className":"life-button ghost"},"children":["Làm một bản cho bố mẹ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]},{"tag":"a","props":{"className":"checkup-retake","href":"/vi/checkup/plans"},"children":["Kế hoạch của tôi"]}]}]}]},{"tag":"p","props":{"className":"checkup-fine"},"children":["Câu trả lời ban đầu lưu trên thiết bị này. Đăng nhập để lưu kế hoạch cho bố mẹ vào tài khoản và tiếp tục trên thiết bị khác. Nếu cho phép thống kê, lựa chọn được tính vào tổng ẩn danh."]}]},{"tag":"div","props":{"className":"page-guide"},"children":[{"tag":"section","props":{"aria-labelledby":"checkup-about-title"},"children":[{"tag":"div","props":{"className":"life-eyebrow"},"children":["Về kiểm tra sức khỏe"]},{"tag":"h2","props":{"id":"checkup-about-title"},"children":["Điều gì là kiểm tra sức khỏe cuộc sống?"]},{"tag":"p","props":{},"children":["Kiểm tra sức khỏe cuộc sống là một bài kiểm tra tự đánh giá miễn phí gồm 5 câu hỏi. Từ độ tuổi của bạn, cách bạn di chuyển, tình hình nhà cửa, công việc và điều bạn muốn cải thiện nhất, nó sẽ chọn ra 10 lời khuyên từ 677 trong cuốn sách Hướng dẫn Sống Tốt hơn có giá trị cao nhất mà phù hợp nhất với bạn."]},{"tag":"p","props":{},"children":["Các lời khuyên được chọn dựa trên chi phí và lợi ích mà sách ghi nhận cho từng lời khuyên: ít tiền, ít thời gian, ít sức lực và lợi ích lớn sẽ được ưu tiên trước. Mỗi chủ đề chỉ chọn tối đa hai lời khuyên và bỏ qua những điều bạn đã làm rồi."]}]},{"tag":"section","props":{"aria-labelledby":"checkup-steps-title"},"children":[{"tag":"h2","props":{"id":"checkup-steps-title"},"children":["Ba phút từ 677 lời khuyên đến 10 lời khuyên của bạn"]},{"tag":"ol","props":{"className":"page-guide-steps"},"children":[{"tag":"li","props":{},"children":[{"tag":"span","props":{},"children":["0","1"]},{"tag":"h3","props":{},"children":["Trả lời 5 câu hỏi"]},{"tag":"p","props":{},"children":["Tất cả là lựa chọn nhiều đáp án, hầu hết cho phép chọn nhiều đáp án, và không hỏi gì cá nhân."]}]},{"tag":"li","props":{},"children":[{"tag":"span","props":{},"children":["0","2"]},{"tag":"h3","props":{},"children":["Xem top 10 của bạn"]},{"tag":"p","props":{},"children":["Mỗi lời khuyên có một dòng tóm tắt và một liên kết đến nội dung đầy đủ. Đánh dấu là đã làm hoặc thêm vào danh sách việc cần làm ngay tại đây."]}]},{"tag":"li","props":{},"children":[{"tag":"span","props":{},"children":["0","3"]},{"tag":"h3","props":{},"children":["Thêm tất cả chỉ với một lần chạm"]},{"tag":"p","props":{},"children":["Chúng sẽ được đưa vào danh sách của tôi, nơi bạn có thể theo dõi tiến độ hoặc xuất chúng ra lịch, một lần mỗi tuần."]}]}]}]},{"tag":"section","props":{"className":"page-guide-faq","aria-labelledby":"checkup-faq-title"},"children":[{"tag":"h2","props":{"id":"checkup-faq-title"},"children":["Câu hỏi thường gặp về kiểm tra sức khỏe"]},{"tag":"details","props":{},"children":[{"tag":"summary","props":{},"children":["Tôi có cần tài khoản hay phải trả phí không?"]},{"tag":"p","props":{},"children":["Không. Kiểm tra, kết quả và thêm việc cần làm đều hoạt động mà không cần đăng nhập, và danh sách của bạn sẽ được lưu trữ trong trình duyệt này. Đăng nhập để đồng bộ hóa nó trên nhiều thiết bị."]}]},{"tag":"details","props":{},"children":[{"tag":"summary","props":{},"children":["Các câu trả lời của tôi có được tải lên không?"]},{"tag":"p","props":{},"children":["Không. Chúng sẽ được lưu trong trình duyệt này để bạn có thể xem kết quả lần sau. Các liên kết chia sẻ cũng không bao gồm các câu trả lời của bạn."]}]},{"tag":"details","props":{},"children":[{"tag":"summary","props":{},"children":["Kết quả được tính như thế nào?"]},{"tag":"p","props":{},"children":["Mỗi câu trả lời sẽ làm tăng trọng số của các chủ đề liên quan. Các lời khuyên sau đó được xếp hạng dựa trên lợi ích, tiền bạc, thời gian và sức lực mà sách ghi nhận, cùng với thứ tự riêng của sách trong từng chủ đề. Đây là một quy tắc minh bạch, không phải lời khuyên y tế, pháp lý hoặc tài chính cá nhân."]}]},{"tag":"details","props":{},"children":[{"tag":"summary","props":{},"children":["Tại sao một số lời khuyên không phù hợp với tôi?"]},{"tag":"p","props":{},"children":["Năm câu hỏi không thể bao quát mọi tình huống. Bỏ qua những điều không phù hợp, hoặc tiếp tục xem sách theo chủ đề và cấp độ bằng chứng."]}]},{"tag":"details","props":{},"children":[{"tag":"summary","props":{},"children":["Tôi nên làm kiểm tra bao nhiêu lần?"]},{"tag":"p","props":{},"children":["Làm lại khi cuộc sống của bạn thay đổi: một công việc mới, một lần di chuyển, một đứa con mới. Những lời khuyên bạn đã làm sẽ bị bỏ qua, vì vậy bạn sẽ nhận được nhóm tiếp theo đáng làm."]}]}]}]}]},{"tag":"nav","props":{"className":"life-tabbar","aria-label":"Điều hướng chính"},"children":[{"tag":"a","props":{"className":"","href":"/vi/book"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"21","height":"21","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-book-open","aria-h