book/09"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"目次に戻る"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["一般人が陥りやすい法律のレッドライン"]},{"tag":"div","props":{"data-ad-dock-host":"true"},"children":[]},{"tag":"nav","props":{"aria-label":"この章のヒント"},"children":[{"tag":"a","props":{"href":"/ja/tip/09-01"},"children":[{"tag":"span","props":{},"children":["01"]},"グループ内で、真偽不明の災害、疫病、事件に関する情報を転送しないこと。画像の加工や、AIによる現場画像の捏造を行わないこと"]},{"tag":"a","props":{"href":"/ja/tip/09-02"},"children":[{"tag":"span","props":{},"children":["02"]},"英烈を侮辱する画像、絵文字、コメントを投稿・転送しないこと。国旗や国歌をネタにしないこと。"]},{"tag":"a","props":{"href":"/ja/tip/09-03"},"children":[{"tag":"span","props":{},"children":["03"]},"海外サイトの内容は見た後に閉じるだけ。スクリーンショットも、転送も、グループへの持ち込みも、コメント欄での追随もせず。"]},{"tag":"a","props":{"href":"/ja/tip/09-04"},"children":[{"tag":"span","props":{},"children":["04"]},"アダルト動画は個人で楽しむ分には自由ですが、グループ内に投稿したり、「素材」を販売したり、グループを作成したりしないでください。"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/ja/tip/09-05","data-status":"active"},"children":[{"tag":"span","props":{},"children":["05"]},"「副業」として自分のカードで入金、出金、送金を行うよう指示される案件、どんなに報酬が高くても断ること"]},{"tag":"a","props":{"href":"/ja/tip/09-06"},"children":[{"tag":"span","props":{},"children":["06"]},"「融資書類の偽造」を勧誘し、融資額に応じたキックバックを提示する者がいても、一切応じないこと"]},{"tag":"a","props":{"href":"/ja/tip/09-07"},"children":[{"tag":"span","props":{},"children":["07"]},"拾得銀行カードをそのままにせず、携帯電話や財布を拾った際は持ち去らず、持ち主に連絡するか警察に届ける"]},{"tag":"a","props":{"href":"/ja/tip/09-08"},"children":[{"tag":"span","props":{},"children":["08"]},"特典は自身の真の身分で受け取る。仮想番号による大量のサブアカウント登録や、脆弱性を利用した繰り返し取得は行わない"]},{"tag":"a","props":{"href":"/ja/tip/09-09"},"children":[{"tag":"span","props":{},"children":["09"]},"バルコニーや窓からいかなる物も投げ出さない。吸い殻、ゴミ袋、酒瓶もすべて対象"]},{"tag":"a","props":{"href":"/ja/tip/09-10"},"children":[{"tag":"span","props":{},"children":["10"]},"模造銃、鋼鉄玉銃、エアガンをネットで購入しない、出所不明の「おもちゃの銃」を買わない"]},{"tag":"a","props":{"href":"/ja/tip/09-11"},"children":[{"tag":"span","props":{},"children":["11"]},"ドローンを購入したらまず実名登録を行う。空港、軍事区域、および都市の規制空域では飛行させない。高度制限の解除（ハッキング）は行わない"]},{"tag":"a","props":{"href":"/ja/tip/09-12"},"children":[{"tag":"span","props":{},"children":["12"]},"他人の盗撮をしない。賃貸物件、民泊、ホテルの客室にカメラを設置しない"]},{"tag":"a","props":{"href":"/ja/tip/09-13"},"children":[{"tag":"span","props":{},"children":["13"]},"麻雀やポーカーは可能ですが、手数料を取らない、胴元にならない、場を設けて集金しない、オンラインギャンブルは行わないこと"]},{"tag":"a","props":{"href":"/ja/tip/09-14"},"children":[{"tag":"span","props":{},"children":["14"]},"野生動物を食べない、売買しない、保護動物をペットとして飼育しない"]},{"tag":"a","props":{"href":"/ja/tip/09-15"},"children":[{"tag":"span","props":{},"children":["15"]},"債権回収において、人を拘束したり、監禁したり、相手の自宅まで押しかけて居座ったりしてはいけない"]},{"tag":"a","props":{"href":"/ja/tip/09-16"},"children":[{"tag":"span","props":{},"children":["16"]},"身分証は貸さない、他人の身分証を使わない、他人の身分証で登録・カード作成・チケット購入を行わない"]},{"tag":"a","props":{"href":"/ja/tip/09-17"},"children":[{"tag":"span","props":{},"children":["17"]},"警察に止められたり連行されたりした際は協力すること。押し返さない、殴らない、执法記録カメラを奪わない。飲酒している時はなおさら自制が必要。"]},{"tag":"a","props":{"href":"/ja/tip/09-18"},"children":[{"tag":"span","props":{},"children":["18"]},"相手が 14 歳未満の場合、性交渉は成立しません。「本人の同意」は理由になりません"]},{"tag":"a","props":{"href":"/ja/tip/09-19"},"children":[{"tag":"span","props":{},"children":["19"]},"手を出して人を殴る前に、この代償を計算しておくこと：拘留、賠償、刑罰"]},{"tag":"a","props":{"href":"/ja/tip/09-20"},"children":[{"tag":"span","props":{},"children":["20"]},"子供を育てられない場合、民政局への登録という唯一の合法的な道があります：金銭を受け取って子供を渡すと人身売買罪に問われる可能性があり、放置すれば遺棄罪になります"]},{"tag":"a","props":{"href":"/ja/tip/09-21"},"children":[{"tag":"span","props":{},"children":["21"]},"事故を捏造せず、損失を誇張して保険金を騙し取らないこと：これは保険詐欺罪です。証言、修理、鑑定を手伝った人も共犯となります"]},{"tag":"a","props":{"href":"/ja/tip/09-22"},"children":[{"tag":"span","props":{},"children":["22"]},"自分の臓器を売らない、他人のドナー探しを手伝わない：腎臓が手元に残るのは 2 万強、同じものが転売されると 20 万、売得金は没収され、さらに取引額の 10 倍から 20 倍の罰金が科される"]},{"tag":"a","props":{"href":"/ja/tip/09-23"},"children":[{"tag":"span","props":{},"children":["23"]},"売春をしない：標準的な罰則は 10 日から 15 日の拘留であり、単なる罰金では済みません"]},{"tag":"a","props":{"href":"/ja/tip/09-24"},"children":[{"tag":"span","props":{},"children":["24"]},"漫画の中国語化、映画・ドラマの無断転載、クラウドストレージ資源の共有、海賊版電子書籍の配布は、無償であっても著作権侵害。広告掲載や会員費の徴収があれば、刑事罰の対象となる可能性あり"]},{"tag":"a","props":{"href":"/ja/tip/09-25"},"children":[{"tag":"span","props":{},"children":["25"]},"二次創作を出版・販売する場合は、まず原作者の許諾を得るか、借りたキャラクター名や関係性を自分のものに書き換える"]},{"tag":"a","props":{"href":"/ja/tip/09-26"},"children":[{"tag":"span","props":{},"children":["26"]},"護身のため伸縮警棒、電撃器、短剣、催涙スプレーを買って携帯しない。車内に置くのも携帯に当たる"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"現在地"},"children":[{"tag":"a","props":{"href":"/ja/book"},"children":["本を読む"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/ja/book/09"},"children":["第9章"," ·"," ","一般人が陥りやすい法律のレッドライン"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"09-05"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["05"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["エビデンス"," ","A"]}]},{"tag":"h1","props":{"lang":"ja"},"children":["「副業」として自分のカードで入金、出金、送金を行うよう指示される案件、どんなに報酬が高くても断ること"]},{"tag":"p","props":{"lang":"ja","className":"life-entry-summary"},"children":["この種の副業で稼げるのは数百元程度ですが、その代償は前科がつくことです。ある人物は、身分証と 1 枚の銀行カードを持って指定の場所へ行き、送金や出金に協力した結果、500 元以上の利益を得ました。検察は起訴しませんでしたが、公安は 10 日間の拘留と 1000 元の罰金を科しました。別の人物は、自分や他人の銀行カードやSIMカードを犯罪グループに渡し、入金や出金を行わせたため、2 年 3 ヶ月の懲役と、2.2 万元の罰金が科されました。"]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["費用・手間"]},{"tag":"p","props":{},"children":["費用はかかりません。「日払い数百元、カードを持って銀行へ行く」といった仕事は諦めることです。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["効果"]},{"tag":"p","props":{},"children":["犯罪による金銭・物品と知りながら移転、買い取り、売却、その他の隠蔽に協力すると、3 年以下の刑と罰金の併科、または罰金だけとなります。"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"記録する：「副業」として自分のカードで入金、出金、送金を行うよう指示される案件、どんなに報酬が高くても断ること"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"できている"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"やることに追加"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","s