6 0 0 0-12 0"},"children":[]},{"tag":"circle","props":{"cx":"12","cy":"10","r":"4"},"children":[]},{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},{"tag":"span","props":{},"children":["Sign in to sync"]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/en/book/29"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"Back to index"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["After experiencing a major setback"]},{"tag":"nav","props":{"aria-label":"Chapter entries"},"children":[{"tag":"a","props":{"href":"/en/tip/29-01"},"children":[{"tag":"span","props":{},"children":["01"]},"After a loved one passes, don’t stay alone for the first few days. Those with heart disease, high blood pressure, or diabetes should keep taking their medication. If you feel pressure or pain in the chest, call 120 right away"]},{"tag":"a","props":{"href":"/en/tip/29-02"},"children":[{"tag":"span","props":{},"children":["02"]},"On the week you receive a cancer diagnosis, don’t go alone to pick up the results — postpone non‑treatment decisions"]},{"tag":"a","props":{"href":"/en/tip/29-03"},"children":[{"tag":"span","props":{},"children":["03"]},"After losing a job, it’s important to set a regular sleep schedule, keep yibao (basic medical insurance) active, and plan job searches methodically — don’t just stay at home all day"]},{"tag":"a","props":{"href":"/en/tip/29-04"},"children":[{"tag":"span","props":{},"children":["04"]},"People who lose a loved one to suicide, accident, or homicide should seek professional help rather than trying to cope alone"]},{"tag":"a","props":{"href":"/en/tip/29-05"},"children":[{"tag":"span","props":{},"children":["05"]},"In the first six months after losing a spouse, assign one trusted person to oversee meals, sleep, medication for chronic conditions, and follow‑up appointments"]},{"tag":"a","props":{"href":"/en/tip/29-06"},"children":[{"tag":"span","props":{},"children":["06"]},"For those without family or friends, replace “the person watching over you” with three simple things: a neighbor who can enter your home, a spot on the community outreach list, and emergency contacts saved on your phone"]},{"tag":"a","props":{"href":"/en/tip/29-07"},"children":[{"tag":"span","props":{},"children":["07"]},"After a parent dies, tell the child the truth, let him attend the funeral, and don’t send him to another environment"]},{"tag":"a","props":{"href":"/en/tip/29-08"},"children":[{"tag":"span","props":{},"children":["08"]},"Still stuck in grief after half a year, unable to move on — when to see a psychiatrist or clinical psychologist"]},{"tag":"a","props":{"href":"/en/tip/29-09"},"children":[{"tag":"span","props":{},"children":["09"]},"Don’t spend money on grief counseling right away — first check whether your grief is truly stuck (see the symptoms listed in item 8)"]},{"tag":"a","props":{"href":"/en/tip/29-10"},"children":[{"tag":"span","props":{},"children":["10"]},"Don’t drop yibao or turn to alcohol after separating or divorcing"]},{"tag":"a","props":{"href":"/en/tip/29-11"},"children":[{"tag":"span","props":{},"children":["11"]},"Call 12356 for general support, 12355 for minors and teens; for medical care, book a psychology clinic appointment"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/en/tip/29-12","data-status":"active"},"children":[{"tag":"span","props":{},"children":["12"]},"In the first three months after a tragedy, postpone any irreversible major decisions"]},{"tag":"a","props":{"href":"/en/tip/29-13"},"children":[{"tag":"span","props":{},"children":["13"]},"Don’t treat death as a way to settle debts: life insurance won’t pay out for suicides within two years, workplace injuries won’t be recognized, and debts are still deducted from your estate first"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"Breadcrumb"},"children":[{"tag":"a","props":{"href":"/en/book"},"children":["Explore the book"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/en/book/29"},"children":["Chapter 29"," ·"," ","After experiencing a major setback"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"29-12"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["12"]},{"tag":"span","props":{"className":"life-evidence grade-b"},"children":["Evidence"," ","B"]}]},{"tag":"h1","props":{"lang":"en"},"children":["In the first three months after a tragedy, postpone any irreversible major decisions"]},{"tag":"p","props":{"lang":"en","className":"life-entry-summary"},"children":["During this period, your ability to judge what truly counts as an “opportunity” is at its weakest. People will approach you with offers — some claiming to let you contact the deceased, others promising to multiply your money, some urging you to quit your job and start anew elsewhere, and still others seeking a business partnership. Set a strict rule for yourself: any decision involving an amount greater than one month’s income, or any choice that would be costly to reverse, must be postponed for three months. First, discuss it with someone who has no personal stake in the matter; you simply need someone to listen so you won’t have to decide on the spot."]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Cost"]},{"tag":"p","props":{},"children":["There is no monetary cost — you simply delay decisions, wh…"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Benefit"]},{"tag":"p","props":{},"children":["This rule helps you avoid making irreversible financial moves when you’re still reeling from a loss and your j…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"Mark: In the first three months after a tragedy, postpone any irreversible major decisions"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"Done"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"Plan to do"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"Save"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Share this tip"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Hide details"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Cost"]},{"tag":"p","props":{},"children":["There is no monetary cost — you simply delay decisions, which may cause you to miss certain opportunities. It can be hard to accept at the time, since opportunities often seem to vanish quickly."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Benefit"]},{"tag":"p","props":{},"children":["This rule helps you avoid making irreversible financial moves when you’re still reeling from a loss and your judgment is impaired. Such moves include selling your home, quitting your job, investing a lump sum of bereavement or compensation payouts, rushing into a new marriage, or acting as a guarantor for someone else. These decisions often involve sums ranging from tens of thousands of yuan up to the value of a house, which is why the benefit level is rated as moderate. Official documents also list “family tragedy, job loss, or dropping out of school” as risk factors for psychological distress that communities should monitor — meaning this period is already recognized as one where outside support is needed. The US National Institute on Aging (NIA) grief guide lists difficulty making decisions as common in grief. It recommends postponing major life decisions until you feel better, if you have a choice, and avoiding changes such as selling a home or quitting work while grieving and possibly unable to think clearly. A study with three experiments randomly induced sadness in some participants, then asked them to choose money now or in 3 months. Compared with emotionally neutral participants, sad participants were willing to accept 13% to 34% less to avoid waiting 3 months. This was experimentally induced sadness, not actual bereavement. In 2023, the US Federal Trade Commission (FTC) warned about scammers impersonating funeral homes and telling families the funeral would be canceled unless they paid immediately. Its first recommendation is to resist pressure to act immediately: legitimate businesses give you time to decide."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Original sources"]},{"tag":"p","props":{"className":"life-citations"},"children":["国家卫生健康委等 25 部门 (2026). 健全社会心理服务体系和危机干预机制实施方案（国卫医政发〔2026〕8 号）. ",{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/202604/content_7065035.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/zhengce/zhengceku/202604/content_7065035.htm"]},"；National Institute on Aging. Coping With Grief and Loss（「Postpone major decisions if possible」一段，页面 2026-01-26 更新）. ",{"tag":"a","props":{"href":"https://www.nia.nih.gov/health/grief-and-mourning/coping-grief-and-loss","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.nia.nih.gov/health/grief-and-mourning/coping-grief-and-loss"]},"；Lerner JS, Li Y, Weber EU (2013). The financial costs of sadness. Psychological Science, 24(1), 72-79. ",{"tag":"a","props":{"href":"https://doi.org/10.1177/0956797612450302","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1177/0956797612450302"]},"；Puig A, Federal Trade Commission (2023-06-15). Imposters prey on families preparing for the funeral of a loved one. ",{"tag":"a","props":{"href":"https://consumer.ftc.gov/consumer-alerts/2023/06/imposters-prey-families-preparing-funeral-loved-one","target":"_blank","rel":"noopener noreferrer"},"children":["https://consumer.ftc.gov/consumer-alerts/2023/06/imposters-prey-families-preparing-funeral-loved-one"]}]},{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/202604/content_7065035.htm","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Open source link"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Book note"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["If no disinterested person is available, call China's 12356 and talk it through (see item 11, call 12356 for someone to talk to), or write it down and reread it three days later. Rated B because an official grief guide and a randomized experiment support postponement in principle. However, no study directly compared financial outcomes among bereaved people who postponed decisions and those who did not. NIA only says ‘until you feel better’, without a timeframe. ‘Three months’ and ‘more than one month's income’ are the author's own thresholds. For scams targeting bereaved people and older adults, see Section 17 (investment retirement and housing-based retirement) and Section 6 (fortune telling). Guarantees and IOUs are in Section 8. Some funds must be actively claimed and are not covered by ‘postpone’: housing provident fund balances, social-insurance benefits and three work-related-death payments; see Sections 25 and 19."]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["My note"]},{"tag":"button","props":{"type":"button"},"children":["Write a reminder for yourself…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"