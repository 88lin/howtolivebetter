n","props":{},"children":["04"]},"Check a long-term rental’s escrow account before paying a full year’s rent upfront"]},{"tag":"a","props":{"href":"/en/tip/15-05"},"children":[{"tag":"span","props":{},"children":["05"]},"House sold during lease term – lease remains valid, no need to move"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/en/tip/15-06","data-status":"active"},"children":[{"tag":"span","props":{},"children":["06"]},"Before signing a rental in China, check ownership documents and mortgages; transfer all payments with a note stating their purpose"]},{"tag":"a","props":{"href":"/en/tip/15-07"},"children":[{"tag":"span","props":{},"children":["07"]},"For second-hand home sales where the agent collects the payment, the funds must be deposited into a dedicated transaction account opened by the agency at a bank"]},{"tag":"a","props":{"href":"/en/tip/15-08"},"children":[{"tag":"span","props":{},"children":["08"]},"Don’t rent a subdivided apartment: the smallest legal rental unit is the original room as designed; kitchens, bathrooms, balconies must not be used for living"]},{"tag":"a","props":{"href":"/en/tip/15-09"},"children":[{"tag":"span","props":{},"children":["09"]},"For urban residents looking to move to the countryside: only rent farmhouses, do not buy homestead land or houses built on homestead land"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"Breadcrumb"},"children":[{"tag":"a","props":{"href":"/en/book"},"children":["Explore the book"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/en/book/15"},"children":["Chapter 15"," ·"," ","Renting vs. buying a home"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"15-06"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["06"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["Evidence"," ","A"]}]},{"tag":"h1","props":{"lang":"en"},"children":["Before signing a rental in China, check ownership documents and mortgages; transfer all payments with a note stating their purpose"]},{"tag":"p","props":{"lang":"en","className":"life-entry-summary"},"children":["Before signing, ask the landlord for ID and the property ownership certificate. Take your own ID to the property registry to check mortgages and seizures; you can do this before signing. If a property was mortgaged or seized before the lease and is auctioned to a new owner, you cannot demand to stay. Transfer every payment with its purpose noted as evidence."]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Cost"]},{"tag":"p","props":{},"children":["Free. Take your ID to the property registry;"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Benefit"]},{"tag":"p","props":{},"children":["Before signing a lease in China, the landlord must show ID and the property ownership certificate. Without a c…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"Mark: Before signing a rental in China, check ownership documents and mortgages; transfer all payments with a note stating their purpose"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"Done"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"Plan to do"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"Save"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Share this tip"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Hide details"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Cost"]},{"tag":"p","props":{},"children":["Free. Take your ID to the property registry; a check takes about half an hour. The difficult part is asking the landlord face to face for the ownership certificate."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Benefit"]},{"tag":"p","props":{},"children":["Before signing a lease in China, the landlord must show ID and the property ownership certificate. Without a certificate, they must produce other evidence of the right to let the property. They must also cooperate with your checks of property information; administrative regulations impose this duty. Even before signing, you can take your ID to the city or county property registry where the home is located to check basic property details, co-ownership, registered mortgages or rights of residence, and seizures. After signing, the lease allows you to check registration results. This matters because the rule that a sale does not end a lease has two exceptions. If the property was mortgaged to a bank before being let and is later auctioned to repay debt, you cannot demand that the new owner honor the original lease. The same applies if a court seized it before it was let. When a lease obstructs an earlier mortgage, the court removes the lease before auctioning the home. Conversely, if it was let to you and you moved in before a later mortgage, that mortgage does not affect the lease. If seizure or an ownership dispute prevents you from using the home, you may terminate the lease. If another party claims rights that prevent your use, you may ask to reduce or suspend rent. Paying everything by transfer with a note such as ‘[month] rent for [address]’ is the author's experience: in a dispute it proves payment and its purpose."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Original sources"]},{"tag":"p","props":{"className":"life-citations"},"children":["国务院 (2025). 住房租赁条例（国令第 812 号，2025 年 9 月 15 日施行）（第九条第一项：「向承租人出示身份证明材料、拟出租住房的不动产权属证书或者其他证明其具有合法出租权利的材料，并配合承租人依法查询、核实拟出租住房有关信息」）. ",{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/202507/content_7032956.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/zhengce/zhengceku/202507/content_7032956.htm"]},"；自然资源部 (2024 修正). 不动产登记资料查询暂行办法（第八、十九、二十、二十一条）. ",{"tag":"a","props":{"href":"https://www.gov.cn/gongbao/2024/issue_11506/202408/content_6966482.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/gongbao/2024/issue_11506/202408/content_6966482.html"]},"；自然资源部 (2025). 关于修改《不动产登记资料查询暂行办法》的决定（自然资源部令第 18 号，第二十一条第三项改为「不动产是否存在抵押权登记、预告登记、异议登记或者居住权登记等情形」）. ",{"tag":"a","props":{"href":"https://www.gov.cn/gongbao/2026/issue_12546/202602/content_7057456.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/gongbao/2026/issue_12546/202602/content_7057456.html"]},"；全国人大 (2020). 民法典（第四百零五、七百二十三、七百二十四、七百二十五条）. ",{"tag":"a","props":{"href":"https://www.spp.gov.cn/spp/fl/202006/t20200602_463888.shtml","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.spp.gov.cn/spp/fl/202006/t20200602_463888.shtml"]},"；最高人民法院 (2020). 关于修改《最高人民法院关于在民事审判工作中适用〈中华人民共和国工会法〉若干问题的解释》等二十七件民事类司法解释的决定（法释〔2020〕17 号，第二十一项第 6 点修改城镇房屋租赁合同解释原第二十条，条文顺序调整后为第十四条：「（一）房屋在出租前已设立抵押权，因抵押权人实现抵押权发生所有权变动的；（二）房屋在出租前已被人民法院依法查封的」）. ",{"tag":"a","props":{"href":"https://www.court.gov.cn/fabu/xiangqing/282621.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.court.gov.cn/fabu/xiangqing/282621.html"]},"；最高人民法院 (2004). 关于人民法院民事执行中拍卖、变卖财产的规定（法释〔2004〕16 号，第三十一条第二款；法释〔2020〕21 号删去第五至七条后为第二十八条第二款）. ",{"tag":"a","props":{"href":"https://www.court.gov.cn/shenpan/xiangqing/713.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.court.gov.cn/shenpan/xiangqing/713.html"]},"；最高人民法院 (2020). 关于修改《最高人民法院关于人民法院扣押铁路运输货物若干问题的规定》等十八件执行类司法解释的决定（法释〔2020〕21 号）. ",{"tag":"a","props":{"href":"https://www.court.gov.cn/fabu/xiangqing/282661.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.court.gov.cn/fabu/xiangqing/282661.html"]},"；证据留存与转账备注同理见第 8 节关于彩礼和借条的两条"]},{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/202507/content_7032956.htm","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Open source link"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"c