会または連絡を取り、関連するニーズを把握し、駐在国の関係当局に対して当該中国公民への人道的かつ公正な待遇を求める」とあります。平たく言えば、現地の法律や両国間の条約に従って、あなたへの面会や連絡を行い、必要なものを確認した上で、現地に対して人道的かつ公正な基準であなたを扱うよう要求するということです。公判時には、大使館や領事館は傍聴することができ、あなたの訴訟権利の保障を求めることができます。また、あなたが負傷したり災害に遭ったりした場合には、現地の緊急救助を促したり、家族の事後処理を支援したりすることが可能です。しかし、費用に関しては条例にも同様に明確に記されています。「中国の市民、法人、および非法人組織は、領事保護および援助の過程において、第三者から提供された宿泊、交通、医療などの物資やサービスを受けた場合、自らが負担すべき費用を支払わなければならない」。他者が立て替えた宿泊、交通、医療費のうち、本来あなたが負担すべきものは、やはりあなたが支払う必要があります。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["出典"]},{"tag":"p","props":{"className":"life-citations"},"children":["国务院 (2023). 领事保护与协助条例（国令第 763 号）. ",{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/202307/content_6891761.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/zhengce/zhengceku/202307/content_6891761.htm"]},"（第九、十、十四、二十六条）"]},{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/202307/content_6891761.htm","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["出典を開く"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["著者の注記"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["使領館は、罰金の支払いや医療費の支払い、航空券の手配を代行することはできませんし、所在国の裁判所の結論を変えることもできません。提供できるのは、現地の弁護士、通訳、医療、葬儀機関の情報、および親族への連絡や救済手段の案内です。したがって、出国前に自ら資金と保険を準備しておき、「トラブルが起きても国が責任を持ってくれる」という考えを計画の柱にしないようにしてください。"]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["自分のメモ"]},{"tag":"button","props":{"type":"button"},"children":["自分へのメモを書く…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/ja/tip/21-02"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["前へ"]},"12308と現地の使領館の領事保護電話をスマホに保存し、さらにコピーを財布にも入れておきましょう。トラブルが起きてから探すのでは遅すぎます"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/ja/tip/21-04"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["次へ"]},"海外医療と医療搬送をカバーする保険に入りましょう。単なる航空便遅延保険だけでは不十分です"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["このテーマの他の提案"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/21-01"},"children":[{"tag":"strong","props":{},"children":["出発前に外交部の安全提醒を確認しましょう。「渡航中止」と表示されている場所には行かないこと"]},{"tag":"span","props":{},"children":["2026年9月15日より、国外の安全リス