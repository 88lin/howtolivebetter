":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"收起详情"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["成本"]},{"tag":"p","props":{"className":"life-citations"},"children":["不花钱。开慢一点，一趟多花几分钟。难的地方是饭局上少喝，消息来了忍住不看。开长途每 4 小时至少停下来歇 20 分钟。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["收益"]},{"tag":"p","props":{"className":"life-citations"},"children":["世界卫生组织（WHO）的说法：平均车速每升高 1%，出人命的事故风险升高 4%。酒驾的风险，从很低的血液酒精浓度起就开始上升。WHO 还说，开车用手机的司机出事故的概率约是不用的 4 倍，用免提也安全不了多少。美国一项研究在 3500 多名司机的车里装了摄像头，拍下了 905 起伤人或撞坏车的事故。对照的是清醒、专心、没喝酒时的开车片段。手里摆弄手机的各种动作合起来，出事概率是 3.6 倍（OR 3.6）。拨号 12.2 倍，打字发消息 6.1 倍，伸手去拿手机 4.8 倍。刷手机 2.7 倍，手持通话 2.2 倍。录像里能看出明显犯困的，是 3.4 倍（OR 3.4）"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["来源"]},{"tag":"p","props":{"className":"life-citations"},"children":["WHO (2025). Road traffic injuries fact sheet：「Drivers using mobile phones are approximately 4 times more likely to be involved in a crash than drivers not using a mobile phone.」「Hands-free phones are not much safer than hand-held phone sets.」",{"tag":"a","props":{"href":"https://www.who.int/news-room/fact-sheets/detail/road-traffic-injuries","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.who.int/news-room/fact-sheets/detail/road-traffic-injuries"]}," ; Dingus TA 等 (2016). Driver crash risk factors and prevalence evaluation using naturalistic driving data. PNAS 113(10):2636-2641. ",{"tag":"a","props":{"href":"https://doi.org/10.1073/pnas.1513271113","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1073/pnas.1513271113"]}," ; 中华人民共和国道路交通安全法（2021 年修正）第二十二条第二款：「过度疲劳影响安全驾驶的，不得驾驶机动车」；第九十条：「处警告或者二十元以上二百元以下罚款」. ",{"tag":"a","props":{"href":"https://flk.npc.gov.cn/detail?id=ff8081817ab231eb017abd617ef70519","target":"_blank","rel":"noopener noreferrer"},"children":["https://flk.npc.gov.cn/detail?id=ff8081817ab231eb017abd617ef70519"]}," ; 中华人民共和国道路交通安全法实施条例（2017 年修订）第六十二条：驾驶机动车不得有「（三）拨打接听手持电话、观看电视等妨碍安全驾驶的行为」「（七）连续驾驶机动车超过4小时未停车休息或者停车休息时间少于20分钟」. ",{"tag":"a","props":{"href":"https://flk.npc.gov.cn/detail?id=ff8080816f3cbb3c016f40f566c10e23","target":"_blank","rel":"noopener noreferrer"},"children":["https://flk.npc.gov.cn/detail?id=ff8080816f3cbb3c016f40f566c10e23"]}," ; 公安部 (2021). 道路交通安全违法行为记分管理办法（公安部令第 163 号）第十一条：一次记 3 分的有「（六）驾驶机动车有拨打、接听手持电话等妨碍安全驾驶的行为的」「（十四）连续驾驶载货汽车超过4小时未停车休息或者停车休息时间少于20分钟的」；第九条：一次记 9 分的有「（七）连续驾驶中型以上载客汽车、危险物品运输车辆超过4小时未停车休息或者停车休息时间少于20分钟的」. ",{"tag":"a","props":{"href":"http://www.gov.cn/gongbao/content/2022/content_5679697.htm","target":"_blank","rel":"noopener noreferrer"},"children":["http://www.gov.cn/gongbao/content/2022/content_5679697.htm"]},""]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["原书备注"]},{"tag":"p","props":{"className":"life-citations"},"children":["速度和死亡的那组 1%、4%，是按事故模型推算出来的，不是随机分组的试验。酒驾这边 WHO 只给了方向，没给数字。「喝多少、风险涨多少」这个问题，本节没有核实过原始文献。手机和犯困那几个倍数，算的是伤人或撞坏车的事故，不是死亡。对照组是挑过的「最理想的开车状态」，所以倍数比和平常开车相比要偏高一些。法规管的是拿在手里打电话，罚 20 到 200 元、记 3 分。用免提不违法，但 WHO 说它也安全不了多少。连续开车超过 4 小时没歇满 20 分钟，同样违法；开货车记 3 分，开中型以上客车和危险品车记 9 分。犯困了，开窗、喝咖啡都顶不了多久，进服务区停车睡一会儿。"]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["我的备注"]},{"tag":"button","props":{"type":"button"},"children":["写下对自己有用的提醒…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/tip/01-08"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["上一条"]},"35 岁以后只要超重，就去查一次空腹血糖，正常也每三年再查"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/tip/01-10"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["下一条"]},"坐车时给 4 岁以下儿童用安全座椅，不要抱在怀里"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["本主题的其他建议"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/01-05"},"children":[{"tag":"strong","props":{},"children":["不采、不买、不吃野生蘑菇，任何「土办法鉴别」都不成立"]},{"tag":"span","props":{},"children":["光 2025 年一年，全国就有 828 起蘑菇中毒，2165 人中招，13 人死。那一年还新认出 34 种以前没记录过会毒人的蘑菇。银针试毒、虫子吃过就没毒、颜…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/01-06"},"children":[{"ta