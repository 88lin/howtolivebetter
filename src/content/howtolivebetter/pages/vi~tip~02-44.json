hí đốt"]},{"tag":"a","props":{"href":"/vi/tip/02-30"},"children":[{"tag":"span","props":{},"children":["30"]},"Đồ nóng để nguội rồi hãy uống, không uống trà, canh hay cà phê sôi"]},{"tag":"a","props":{"href":"/vi/tip/02-31"},"children":[{"tag":"span","props":{},"children":["31"]},"Ban ngày ra ngoài hẵn nắng, đừng cả ngày không thấy ánh sáng"]},{"tag":"a","props":{"href":"/vi/tip/02-32"},"children":[{"tag":"span","props":{},"children":["32"]},"Giữ BMI trong khoảng 20–25, thừa cân thì giảm"]},{"tag":"a","props":{"href":"/vi/tip/02-33"},"children":[{"tag":"span","props":{},"children":["33"]},"Mỗi tuần ăn ớt từ bốn lần trở lên"]},{"tag":"a","props":{"href":"/vi/tip/02-34"},"children":[{"tag":"span","props":{},"children":["34"]},"Mỗi ngày uống một hai phần sữa hoặc sữa chua"]},{"tag":"a","props":{"href":"/vi/tip/02-35"},"children":[{"tag":"span","props":{},"children":["35"]},"Không cần kiêng trứng, nhưng đừng ăn ba bốn quả mỗi ngày"]},{"tag":"a","props":{"href":"/vi/tip/02-36"},"children":[{"tag":"span","props":{},"children":["36"]},"Có điều kiện thì ngâm mình, đừng chỉ tắm vòi sen"]},{"tag":"a","props":{"href":"/vi/tip/02-37"},"children":[{"tag":"span","props":{},"children":["37"]},"Giữ giấc ngủ trưa trong nửa tiếng, đừng quá một tiếng; nếu cứ phải ngủ một hai tiếng mới chịu thì đi tìm nguyên nhân"]},{"tag":"a","props":{"href":"/vi/tip/02-38"},"children":[{"tag":"span","props":{},"children":["38"]},"Thức khuya xong thì đêm hôm sau bù ngay, đừng dồn dập cuối tuần"]},{"tag":"a","props":{"href":"/vi/tip/02-39"},"children":[{"tag":"span","props":{},"children":["39"]},"Làm ca đêm càng lâu thì rủi ro tim mạch càng cao, đổi được chỗ thì nên đổi sớm"]},{"tag":"a","props":{"href":"/vi/tip/02-40"},"children":[{"tag":"span","props":{},"children":["40"]},"Mua dầu ăn đóng gói có số SC, đừng mua dầu điều tự ép tẩy từ xưởng nhỏ bán rời"]},{"tag":"a","props":{"href":"/vi/tip/02-41"},"children":[{"tag":"span","props":{},"children":["41"]},"Nấu ăn bằng dầu thực vật thay cho mỡ lợn và bơ, không cần đổi dầu qua lại vì lý do sức khoẻ, cũng đừng trông chờ dầu hạt lanh bảo vệ tim"]},{"tag":"a","props":{"href":"/vi/tip/02-42"},"children":[{"tag":"span","props":{},"children":["42"]},"Khi xào và khi chiên rán thì bật máy hút mùi, từ lúc bật bếp cho tới khi nấu xong"]},{"tag":"a","props":{"href":"/vi/tip/02-43"},"children":[{"tag":"span","props":{},"children":["43"]},"Bốc hỏa, đổ mồ hôi đêm quanh thời kỳ mãn kinh ảnh hưởng đến cuộc sống thì đi khám phụ khoa để đánh giá liệu pháp hormone; đừng cố chịu hay tự mua thuốc, và đừng dùng để phòng bệnh tim"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/vi/tip/02-44","data-status":"active"},"children":[{"tag":"span","props":{},"children":["44"]},"Nếu vốn muốn nuôi chó, tính việc dắt chó mỗi ngày vào lượng đi bộ; đừng nuôi riêng để sống lâu hơn"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"Breadcrumbs"},"children":[{"tag":"a","props":{"href":"/vi/book"},"children":["Khám phá cuốn sách"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/vi/book/02"},"children":["Chương 2"," ·"," ","Đừng chết dần"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"02-44"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["44"]},{"tag":"span","props":{"className":"life-evidence grade-b"},"children":["Bằng chứng"," ","B"]}]},{"tag":"h1","props":{"lang":"vi"},"children":["Nếu vốn muốn nuôi chó, tính việc dắt chó mỗi ngày vào lượng đi bộ; đừng nuôi riêng để sống lâu hơn"]},{"tag":"p","props":{"lang":"vi","className":"life-entry-summary"},"children":["Người nuôi chó có xác suất tử vong trong cùng thời gian thấp hơn trung bình khoảng một phần tư; sau nhồi máu cơ tim hoặc đột quỵ còn thấp hơn nữa. Nhưng sau khi điều chỉnh các khác biệt khác, nghiên cứu lớn ở Anh và Na Uy đều không thấy khác biệt; nuôi mèo cũng không có liên hệ. Vì vậy đừng nuôi chó riêng để sống lâu; nếu vốn muốn nuôi, hãy tính dắt chó hằng ngày là đi bộ."]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Chi phí"]},{"tag":"p","props":{},"children":["Nuôi chó phải chi tiền liên tục cho thức ăn, vắc-xin, tẩy…"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Lợi ích"]},{"tag":"p","props":{},"children":["Gộp 10 nghiên cứu theo dõi khoảng 3,84 triệu người, theo dõi trung bình 10.1 năm. Người nuôi chó có nguy cơ tử…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"Đánh dấu: Nếu vốn muốn nuôi chó, tính việc dắt chó mỗi ngày vào lượng đi bộ; đừng nuôi riêng để sống lâu hơn"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"Hoàn tất"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"Kế hoạch thực hiện"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"Lưu"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Chia sẻ mẹo này"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Ẩn chi tiết"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Chi phí"]},{"tag":"p","props":{},"children":["Nuôi chó phải chi tiền liên tục cho thức ăn, vắc-xin, tẩy ký sinh trùng, khám bệnh và đăng ký, chăm đến khi chó già chết. Mỗi ngày cần thời gian dắt đi, khi công tác hay du lịch phải tìm người trông. Khó ở chỗ phải làm hằng ngày, đã nuôi không thể muốn dừng là dừng. Trung Quốc không có thống kê chính thức về chi phí nuôi một con chó nên ở đây không ghi số."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Lợi ích"]},{"tag":"p","props":{},"children":["Gộp 10 nghiên cứu theo dõi khoảng 3,84 triệu người, theo dõi trung bình 10.1 năm. Người nuôi chó có nguy cơ tử vong thấp hơn khoảng 24% (RR 0.76, 95% CI 0.67–0.86, tức khoảng tin cậy). Tử vong tim mạch thấp hơn khoảng 31% (RR 0.69, 0.67–0.71). Trong nhóm từng mắc bệnh mạch vành, người có chó tại nhà thấp hơn khoảng 65% (RR 0.35, 0.17–0.69). Tác giả nói rõ phép gộp này chưa điều chỉnh yếu tố khác. Nghiên cứu đăng ký toàn Thụy Điển khoảng 3,43 triệu người đã điều chỉnh thu nhập, hôn nhân và các yếu tố khác. Người sống một mình có chó có nguy cơ tử vong thấp hơn khoảng 33% (HR 0.67, 0.65–0.69); người sống cùng người khác thấp hơn khoảng 11% (HR 0.89, 0.87–0.91). Trong bệnh nhân Thụy Điển sau nhồi máu cơ tim, người sống một mình nuôi chó thấp hơn khoảng 33% (HR 0.67, 0.61–0.75), người sống với bạn đời hoặc con thấp hơn khoảng 15% (HR 0.85, 0.80–0.90). Sau đột quỵ thiếu máu cục bộ, tương ứng thấp hơn khoảng 27% (HR 0.73, 0.66–0.80) và 12% (HR 0.88, 0.83–0.93). Bằng chứng ngược lại: 6 đợt khảo sát sức khỏe ở Anh với 59352 người, theo dõi trung bình 11.5 năm. Sau điều chỉnh đầy đủ, nuôi chó không liên hệ với tử vong (HR 1.03, 0.98–1.09) hay tử vong tim mạch (HR 1.07, 0.96–1.18). Một nghiên cứu Na Uy theo dõi trung vị 18.5 năm thấy nguy cơ tử vong gần như bằng nhau (HR 1.00, 0.91–1.09). Người nuôi chó ở đó cũng không hoạt động nhiều hơn. Trong đăng ký cặp song sinh Thụy Điển, 34202 người được hỏi về lối sống; ở họ không lặp lại được liên hệ giữa nuôi chó và nguy cơ bệnh tim mạch, tử vong thấp hơn. Nghiên cứu Úc theo dõi 15735 người trong 4 năm thấy người nuôi chó có nguy cơ tử vong thấp hơn khoảng 23% (OR 0.77, 0.59–0.99), một phần giải thích được bằng hoạt động nhiều hơn. Nuôi mèo, chim, cá đều không thấy liên hệ với tử vong. Tuyên bố năm 2013 của Hiệp hội Tim mạch Hoa Kỳ nói nuôi thú cưng, nhất là chó, để giảm nguy cơ tim mạch «có thể hợp lý», mức khuyến nghị yếu nhất. Cùng tuyên bố ấy phản đối rõ việc nhận nuôi, cứu hộ hoặc mua thú cưng chủ yếu để giảm nguy cơ tim mạch."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Nguồn gốc"]},{"tag":"p","props":{"className":"life-citations"},"children":["Kramer CK, Mehmood S, Suen RS (2019). Dog ownership and survival: a systematic review and meta-analysis. Circulation: Cardiovascular Quality and Outcomes, 12(10), e005554. ",{"tag":"a","props":{"href":"https://doi.org/10.1161/CIRCOUTCOMES.119.005554","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1161/CIRCOUTCOMES.119.005554"]},"；Mubanga M, Byberg L, Nowak C, 等 (2017). Dog ownership and the risk of cardiovascular disease and death – a nationwide cohort study. Scientific Reports, 7, 15821. ",{"tag":"a","props":{"href":"https://doi.org/10.1038/s41598-017-16118-6","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1038/s41598-017-16118-6"]},"；Mubanga M, Byberg L, Egenvall A, Ingelsson E, Fall T (2019). Dog ownership and survival after a major cardiovascular event: a register-based prospective study. Circulation: Cardiovascular Quality and Outcomes, 12(10), e005342. ",{"tag":"a","props":{"href":"https://doi.org/10.1161/CIRCOUTCOMES.118.005342","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1161/CIRCOUTCOMES.118.005342"]},"；Ding D, Bauman AE, Sherrington C, 等 (2018). Dog ownership and mortality in England: a pooled analysis of six population-based cohorts. American Journal of Preventive Medicine, 54(2), 289-293. ",{"tag":"a","props":{"href":"https://doi.org/10.1016/j.amepre.2017.09.012","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1016/j.amepre.2017.09.012"]},"；Torske MO, Krokstad S, Stamatakis E, Bauman A (2017). Dog ownership and all-cause mortality in a population cohort in Norway: the HUNT study. PLoS ONE, 12(6), e0179832. ",{"tag":"a","props":{"href":"https://doi.org/10.1371/journal.pone.0179832","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1371/journal.pone.0179832"]},"；Taniguchi Y, Ikeuchi T, Yong J (2024). Dog, cat, bird, fish, and other pet ownership and mortality: evidence from the HILDA cohort. PLoS ONE, 19(8), e0305546. ",{"tag":"a","props":{"href":"https://doi.org/10.1371/journal.pone.0305546","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1371/journal.pone.0305546"]},"；Mubanga M, Byberg L, Egenvall A, 等 (2019). Dog ownership and cardiovascular risk factors: a nationwide prospective register-based cohort study. BMJ Open, 9(3), e023447. ",{"tag":"a","props":{"href":"https://doi.org/10.1136/bmjopen-2018-023447","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1136/bmjopen-2018-023447"]},"；Levine GN, Allen K, Braun LT, 等 (2013). Pet ownership and cardiovascular risk: a scientific statement from the American Heart Association. Circulation, 127(23), 2353-2363. ",{"tag":"a","props":{"href":"https://doi.org/10.1161/CIR.0b013e31829201e1","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1161/CIR.0b013e31829201e1"]}]},{"tag":"a","props":{"href":"https://doi.org/10.1161/CIRCOUTCOMES.119.005554","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Liên kết mở nguồn"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Ghi chú sách"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["Còn tranh luận. Toàn bộ trên là theo dõi quan sát, không phân nhóm đối chứng, nên không suy ra «hãy nuôi chó để sống lâu». Người nuôi chó có thể vốn khỏe và thích vận động hơn; người bệnh hoặc khuyết tật có thể vốn ít nuôi chó hơn; không loại hết được các khác biệt này. Con số 24% trong phân tích gộp không điều chỉnh gì, còn vài nghiên cứu hỏi được lối sống thì khác biệt biến mất. Một nghiên cứu Thụy Điển khác thấy người nuôi chó bắt đầu dùng thuốc hạ áp, hạ lipid hơi nhiều hơn; dù nguy cơ tử vong có thật sự thấp hơn cũng không phải nhờ huyết áp và lipid giảm. Điều áp dụng được chỉ là: đã nuôi hoặc vốn muốn nuôi thì tính dắt chó mỗi ngày vào lượng đi bộ; đủ chưa xem điều 11 phần này (7000–8000 bước mỗi ngày). Dây dắt, vắc-xin và trách nhiệm bồi thường khi chó gây thương tích xem phần 8, điều 30 (nuôi chó phải dùng dây dắt). Người cao tuổi cầm dây thế nào để phòng ngã xem phần 17, điều 10 (người cao tuổi dắt chó). Lợi ích được xếp lớn một cách máy móc theo mức 24% của phân tích gộp, nhưng con số ấy chưa điều chỉnh nhiễu. Người hưởng lợi chủ yếu là bạn."]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Ghi chú của tôi"]},{"tag":"button","props":{"type":"button"},"children":["Viết một lời nhắc cho chính bạn…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/vi/tip/02-43"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Trước"]},"Bốc hỏa, đổ mồ hôi đêm quanh thời kỳ mãn kinh ảnh hưởng đến cuộc sống thì đi khám phụ khoa để đánh giá liệu pháp hormone; đừng cố chịu hay tự mua thuốc, và đừng dùng để phòng bệnh tim"]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["Thêm trong chủ đề này"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/02-37"},"children":[{"tag":"strong","props":{},"children":["Giữ giấc ngủ trưa trong nửa tiếng, đừng quá một tiếng; nếu cứ phải ngủ một hai tiếng mới chịu thì đi tìm nguyên nhân"]},{"tag":"span","props":{},"children":["Người ngủ trưa không quá một tiếng thì rủi ro tử vong và bệnh mạn tín…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/02-38"},"children":[{"tag":"strong","props":{},"children":["Thức khuya xong thì đêm hôm sau bù ngay, đừng dồn dập cuối tuần"]},{"tag":"span","props":{},"children":["Người ngủ thiếu mà đêm hôm sau không bù thì rủi ro tử vong cao hơn ng…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/02-39"},"children":[{"tag":"strong","props":{},"children":["Làm ca đêm càng lâu thì rủi ro tim mạch càng cao, đổi được chỗ thì nên đổi sớm"]},{"tag":"span","props":{},"children":["Người làm ca đêm mắc bệnh tim mạch nhiều hơn người không làm ca đêm k…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/02-40"},"children":[{"tag":"strong","props":{},"children":["Mua dầu ăn đóng gói có số SC, đừng mua dầu điều tự ép tẩy từ xưởng nhỏ bán rời"]},{"tag":"span","props":{},"children":["Đậu phộng bị ẩm mốc sinh aflatoxin, đây là chất gây ung thư đã rõ, và…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/02-41"},"children":[{"tag":"strong","props":{},"children":["Nấu ăn bằng dầu thực vật thay cho mỡ lợn và bơ, không cần đổi dầu qua lại vì lý do sức khoẻ, cũng đừng trông chờ dầu hạt lanh bảo vệ tim"]},{"tag":"span","props":{},"children":["Ăn ít mỡ lợn, bơ và các loại mỡ bão hòa tương tự, đổi sang dầu thực v…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/02-42"},"children":[{"tag":"strong","props":{},"children":["Khi xào và khi chiên rán thì bật máy hút mùi, từ lúc bật bếp cho tới khi nấu xong"]},{"tag":"span","props":{},"children":["Phụ nữ Trung Quốc không hút thuốc, khi xào mà không bật hoặc rất ít b…"]}]}]}]},{"tag":"a","props":{"className":"life-text-link","href":"/vi/book/02"},"children":["Đọc toàn bộ chủ đề: Đừng chết dần"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"15","height":"15","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]}]}]}]},{"tag":"aside","props":{"className":"life-