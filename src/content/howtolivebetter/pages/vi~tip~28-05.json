dren":[]},{"tag":"path","props":{"d":"m6.34 17.66-1.41 1.41"},"children":[]},{"tag":"path","props":{"d":"m19.07 4.93-1.41 1.41"},"children":[]}]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"17","height":"17","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-moon life-theme-icon-dark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"},"children":[]}]}]},{"tag":"button","props":{"type":"button","className":"life-language-switch","aria-label":"Tiếng Việt Chọn ngôn ngữ","aria-haspopup":"menu","aria-expanded":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-globe","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]},{"tag":"path","props":{"d":"M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"},"children":[]},{"tag":"path","props":{"d":"M2 12h20"},"children":[]}]},{"tag":"span","props":{},"children":["Tiếng Việt"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]}]},{"tag":"a","props":{"className":"life-account","href":"/vi/sign-in"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"17","height":"17","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle-user-round","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M18 20a6 6 0 0 0-12 0"},"children":[]},{"tag":"circle","props":{"cx":"12","cy":"10","r":"4"},"children":[]},{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},{"tag":"span","props":{},"children":["Đăng nhập để đồng bộ hóa"]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/vi/book/28"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"Quay lại mục lục"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["Đừng phá hỏng cơ thể vì ngoại hình"]},{"tag":"nav","props":{"aria-label":"Các mục trong chương"},"children":[{"tag":"a","props":{"href":"/vi/tip/28-01"},"children":[{"tag":"span","props":{},"children":["01"]},"Đừng dùng ăn kiêng cực đoan, nhịn ăn hay nôn ra sau khi ăn để kiểm soát cân nặng; muốn giảm thì giảm từ phía vận động"]},{"tag":"a","props":{"href":"/vi/tip/28-02"},"children":[{"tag":"span","props":{},"children":["02"]},"Trước khi tiêm, cấy chỉ hay phẫu thuật, kiểm tra hai thứ: giấy phép cơ sở có ghi「y học thẩm mỹ」không, và người thao tác có phải bác sĩ chủ trị không"]},{"tag":"a","props":{"href":"/vi/tip/28-03"},"children":[{"tag":"span","props":{},"children":["03"]},"Khi tiêm filler vào mặt, tránh lưng mũi, khoảng giữa hai lông mày và trán; đừng tiêm ở chỗ không chính quy chỉ để tiết kiệm tiền"]},{"tag":"a","props":{"href":"/vi/tip/28-04"},"children":[{"tag":"span","props":{},"children":["04"]},"Đừng mua thuốc, cà phê, kẹo giảm cân hay mận enzyme (mận được quảng cáo là ngâm enzyme) hứa hẹn «gầy nhanh»"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/vi/tip/28-05","data-status":"active"},"children":[{"tag":"span","props":{},"children":["05"]},"Đừng dùng steroid đồng hóa (「thuốc tiêm tăng cơ」「thuốc uống」) để tăng cơ"]},{"tag":"a","props":{"href":"/vi/tip/28-06"},"children":[{"tag":"span","props":{},"children":["06"]},"Đã định dùng thuốc giảm cân thì đến bệnh viện lấy đơn thuốc, đừng mua ở cửa hàng trực tuyến mà không cần đơn"]},{"tag":"a","props":{"href":"/vi/tip/28-07"},"children":[{"tag":"span","props":{},"children":["07"]},"Chỉ dùng thuốc hormone giới tính khi bác sĩ kê đơn và có tái khám định kỳ; đừng mua trên mạng, đừng tự tăng liều"]},{"tag":"a","props":{"href":"/vi/tip/28-08"},"children":[{"tag":"span","props":{},"children":["08"]},"Nếu「cảm thấy mình xấu」đã đến mức soi gương lặp đi lặp lại, muốn sửa đi sửa lại, thì làm một đánh giá về hình thể trước khi nói đến phẫu thuật"]},{"tag":"a","props":{"href":"/vi/tip/28-09"},"children":[{"tag":"span","props":{},"children":["09"]},"Chỉnh nha cần bác sĩ có chuyên môn chỉnh nha khám trực tiếp, tái khám đúng hẹn; đừng mua khay trên mạng rồi tự đeo ở nhà"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"Breadcrumbs"},"children":[{"tag":"a","props":{"href":"/vi/book"},"children":["Khám phá cuốn sách"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/vi/book/28"},"children":["Chương 28"," ·"," ","Đừng phá hỏng cơ thể vì ngoại hình"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"28-05"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["05"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["Bằng chứng"," ","A"]}]},{"tag":"h1","props":{"lang":"vi"},"children":["Đừng dùng steroid đồng hóa (「thuốc tiêm tăng cơ」「thuốc uống」) để tăng cơ"]},{"tag":"p","props":{"lang":"vi","className":"life-entry-summary"},"children":["Nam giới có kết quả steroid dương tính trong kiểm tra doping ở phòng gym thì nguy cơ chết gấp 3 lần người cùng tuổi, và số lần đến bệnh viện mỗi năm nhiều hơn gấp đôi. Viêm da, vú to ở nam và rối loạn cương, cứ mười người dùng thuốc thì ít nhất một người mắc. Loại thuốc này ở Trung Quốc là thuốc kê đơn, nên kênh nào bán được cho bạn thì bản thân nó đã vi phạm pháp."]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Chi phí"]},{"tag":"p","props":{},"children":["Không tốn tiền, lại còn tiết kiệm tiền thuốc. Khó ở chỗ ph…"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Lợi ích"]},{"tag":"p","props":{},"children":["Đan Mạch quay lại tra hồ sơ, cho mỗi người dùng thuốc một đối chứng cùng tuổi. Người dùng là 545 nam giới có k…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"Đánh dấu: Đừng dùng steroid đồng hóa (「thuốc tiêm tăng cơ」「thuốc uống」) để tăng cơ"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"Hoàn tất"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"Kế hoạch thực hiện"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"Lưu"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Chia sẻ mẹo này"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Ẩn chi tiết"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Chi phí"]},{"tag":"p","props":{},"children":["Không tốn tiền, lại còn tiết kiệm tiền thuốc. Khó ở chỗ phải chấp nhận cơ bắp mọc chậm."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Lợi ích"]},{"tag":"p","props":{},"children":["Đan Mạch quay lại tra hồ sơ, cho mỗi người dùng thuốc một đối chứng cùng tuổi. Người dùng là 545 nam giới có kết quả steroid androgenic dương tính trong kiểm tra doping phòng gym từ 2006-01-03 đến 2018-03-01, ghép với 5.450 đối chứng. Lại dùng thêm 644 người từ chối kiểm tra và 6.440 đối chứng để soát lại một lần nữa. Kết quả: tỷ lệ tử vong của người dùng gấp 3 lần đối chứng, HR 3.0 (95% CI 1.3–7.0), mức gấp thật nằm trong khoảng từ 1.3 đến 7. Số lần nhập viện hoặc khám mỗi năm trung vị là 0.81 vs 0.36 (P<0.0001). Trung vị nghĩa là một nửa người nhiều hơn con số này, một nửa ít hơn. Giá trị P này cho thấy chênh lệch gần như không thể là ngẫu nhiên. Viêm da (mụn), vú to ở nam và rối loạn cương đều ảnh hưởng hơn 10% người dùng, tức cứ mười người dùng thì ít nhất một người mắc, tất cả đều cao rõ rệt so với đối chứng (P<0.0001). Lần soát hồ sơ thứ hai cho kết quả nhất quán.《Biện pháp chống doping》Điều bảy: Nhà nước quản lý chặt các chất cấm có trong danh mục doping, bất kỳ tổ chức, cá nhân nào cũng không được sản xuất, kinh doanh, nhập khẩu, xuất khẩu bất hợp pháp. Cùng biện pháp đó quy định chế phẩm đồng hóa protein và hormone peptide phải quản lý như thuốc kê đơn, tức chỉ mua được bằng đơn thuốc của bác sĩ;「蛋白同化制剂」là cách luật pháp gọi nhóm thuốc này"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Nguồn gốc"]},{"tag":"p","props":{"className":"life-citations"},"children":["Horwitz H et al. (2019). Health consequences of androgenic anabolic steroid use. J Intern Med. ",{"tag":"a","props":{"href":"https://doi.org/10.1111/joim.12850","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1111/joim.12850"]},"；国务院 (2004). 反兴奋剂条例（国务院令第 398 号，第七条、第九条）. ",{"tag":"a","props":{"href":"http://www.gov.cn/gongbao/content/2004/content_63129.htm","target":"_blank","rel":"noopener noreferrer"},"children":["http://www.gov.cn/gongbao/content/2004/content_63129.htm"]}]},{"tag":"a","props":{"href":"https://doi.org/10.1111/joim.12850","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Liên kết mở nguồn"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Ghi chú sách"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["Tranh cãi. Đây là nghiên cứu theo dõi một nhóm người rồi xem kết quả, không phải thử nghiệm chia nhóm ngẫu nhiên. Người dùng thuốc vốn có thể cũng mạo hiểm hơn ở mặt khác, con số 3 lần không thể đổ hết cho thuốc. Mức gấp thật có thể thấp tới 1.3, cũng có thể cao tới 7.0, biên độ rất rộng. Nhưng「viêm da, vú to ở nam và rối loạn cương mỗi thứ đều có trên một phần mười người dùng mắc」là tác dụng phụ nhìn thấy được bằng mắt, ít bị ảnh hưởng bởi kiểu thiên lệch này. Trong luật, nhóm thuốc này được viết là「蛋白同化制剂」, thấy bốn chữ đó là nói đến nó. Bột protein thường và creatine không nằm trong mục này. Rắc rối là sản phẩm「tuyên bố tăng cơ rất nhanh」có thể lén thêm thành phần. Cách phân biệt giống hệt mục 4 (đừng mua thuốc giảm cân hứa giảm nhanh): thuốc đàng hoàng là thuốc kê đơn, số phép tra được. Bán dưới danh「bột tăng cơ」「thực phẩm bổ sung」mà hứa mấy tuần có kết quả, nếu thật sự hữu hiệu thì là đã trộn thêm gì đó."]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Ghi chú của tôi"]},{"tag":"button","props":{"type":"button"},"children":["Viết một lời nhắc cho chính bạn…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/vi/tip/28-04"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Trước"]},"Đừng mua thuốc, cà phê, kẹo giảm cân hay mận enzyme (mận được quảng cáo là ngâm enzyme) hứa hẹn «gầy nhanh»"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/vi/tip/28-06"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Tiếp theo"]},"Đã định dùng thuốc giảm cân thì đến bệnh viện lấy đơn thuốc, đừng mua ở cửa hàng trực tuyến mà không cần đơn"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["Thêm trong chủ đề này"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/28-01"},"children":[{"tag":"strong","props":{},"children":["Đừng dùng ăn kiêng cực đoan, nhịn ăn hay nôn ra sau khi ăn để kiểm soát cân nặng; muốn giảm thì giảm từ phía vận động"]},{"tag":"span","props":{},"children":["Người bị chứng ăn uống từ chối tâm thần có xác suất tử vong cao gấp k…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/28-02"},"children":[{"tag":"strong","props":{},"children":["Trước khi tiêm, cấy chỉ hay phẫu thuật, kiểm tra hai thứ: giấy phép cơ sở có ghi「y học thẩm mỹ」không, và người thao tác có phải bác sĩ chủ trị không"]},{"tag":"span","props":{},"children":["Đâm kim, mổ hay dùng thiết bị y tế làm rách da hay đi vào trong cơ th…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/28-03"},"children":[{"tag":"strong","props":{},"children":["Khi tiêm filler vào mặt, tránh lưng mũi, khoảng giữa hai lông mày và trán; đừng tiêm ở chỗ không chính quy chỉ để tiết kiệm tiền"]},{"tag":"span","props":{},"children":["Trong số người bị mù sau khi tiêm filler, hơn một nửa tiêm ở mũi, kế …"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/28-07"},"children":[{"tag":"strong","props":{},"chi