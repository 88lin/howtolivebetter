ll":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-up-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M7 7h10v10"},"children":[]},{"tag":"path","props":{"d":"M7 17 17 7"},"children":[]}]}]}]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/es/book/30"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"Volver al índice"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["Los niños en edad escolar"]},{"tag":"div","props":{"data-ad-dock-host":"true"},"children":[]},{"tag":"nav","props":{"aria-label":"Consejos del capítulo"},"children":[{"tag":"a","props":{"href":"/es/tip/30-01"},"children":[{"tag":"span","props":{},"children":["01"]},"Si el niño dice que le empezó un dolor fuerte y repentino y que va en aumento, al hospital de inmediato; no lo dejes aguantar hasta la salida de clases"]},{"tag":"a","props":{"href":"/es/tip/30-02"},"children":[{"tag":"span","props":{},"children":["02"]},"No retrases «hasta después de los exámenes» un tratamiento que toca hacer: algunas ventanas siguen la edad ósea, no el calendario de exámenes"]},{"tag":"a","props":{"href":"/es/tip/30-03"},"children":[{"tag":"span","props":{},"children":["03"]},"Si el niño sufre acoso escolar, repórtalo a la escuela ese mismo día y exige respuesta por escrito; si hay golpes, extorsión de dinero o difusión de rumores, llama directamente a la policía"]},{"tag":"a","props":{"href":"/es/tip/30-04"},"children":[{"tag":"span","props":{},"children":["04"]},"Que el niño pase al menos 2 horas al día al aire libre: es la única medida contra la miopía que hoy cuenta con un ensayo aleatorizado"]},{"tag":"a","props":{"href":"/es/tip/30-05"},"children":[{"tag":"span","props":{},"children":["05"]},"De 0 a 3 años, ninguna pantalla; de 3 a 6, cuantas menos mejor; escolares, sin fines de estudio, no más de 1 hora al día"]},{"tag":"a","props":{"href":"/es/tip/30-06"},"children":[{"tag":"span","props":{},"children":["06"]},"Toma la miopía como un daño que se queda: a más graduación, más desprendimiento de retina, degeneración macular y glaucoma más adelante"]},{"tag":"a","props":{"href":"/es/tip/30-07"},"children":[{"tag":"span","props":{},"children":["07"]},"El informe del chequeo médico escolar de cada año revísalo tú mismo; los datos anormales, al hospital ese mismo año"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/es/tip/30-08","data-status":"active"},"children":[{"tag":"span","props":{},"children":["08"]},"Haz a los hijos de 12 a 18 años una criba de depresión, y no tomes la evaluación psicológica de la escuela por un diagnóstico"]},{"tag":"a","props":{"href":"/es/tip/30-09"},"children":[{"tag":"span","props":{},"children":["09"]},"No compres productos ni servicios que prometan «curar la miopía» o «reducir las graduaciones»"]},{"tag":"a","props":{"href":"/es/tip/30-10"},"children":[{"tag":"span","props":{},"children":["10"]},"Sueño, deberes, educación física y clasificaciones por notas tienen norma escrita, y a la escuela se le puede reclamar"]},{"tag":"a","props":{"href":"/es/tip/30-11"},"children":[{"tag":"span","props":{},"children":["11"]},"Si el niño no da más, puede suspender los estudios: la escuela está obligada a conservarle la matrícula, hasta 1 año"]},{"tag":"a","props":{"href":"/es/tip/30-12"},"children":[{"tag":"span","props":{},"children":["12"]},"Si el chequeo revela mala visión, ve al hospital para una refracción con dilatación de la pupila y después vuelve a los controles en el intervalo que indique el médico"]},{"tag":"a","props":{"href":"/es/tip/30-13"},"children":[{"tag":"span","props":{},"children":["13"]},"Sellado de fosas y fisuras en los primeros molares permanentes"]},{"tag":"a","props":{"href":"/es/tip/30-14"},"children":[{"tag":"span","props":{},"children":["14"]},"Si su hijo es adicto a los videojuegos, primero observe si se han visto desplazados el sueño, las tareas y las actividades al aire libre; no se limite solo a vigilar cuánto tiempo juega"]},{"tag":"a","props":{"href":"/es/tip/30-15"},"children":[{"tag":"span","props":{},"children":["15"]},"Si tu hijo dice que le gusta el mismo sexo, no lo regañes, no lo eches de casa, no lo envíes a «reeducación»: la actitud de la familia está relacionada con su riesgo de suicidio"]},{"tag":"a","props":{"href":"/es/tip/30-16"},"children":[{"tag":"span","props":{},"children":["16"]},"No golpee a su hijo ni grite llamándolo estúpido: los niños a menudo golpeados o insultados muestran más problemas de conducta y emocionales"]},{"tag":"a","props":{"href":"/es/tip/30-17"},"children":[{"tag":"span","props":{},"children":["17"]},"Si la crianza se le va de las manos y sigue golpeando o gritando, haga un curso que enseñe habilidades parentales concretas"]},{"tag":"a","props":{"href":"/es/tip/30-18"},"children":[{"tag":"span","props":{},"children":["18"]},"No envíes a tu hijo a «escuelas para curar la adicción a internet» ni a «campamentos especiales» cerrados: la ley prohíbe métodos que dañen cuerpo y mente, y ya han muerto niños encerrados"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"Ruta de navegación"},"children":[{"tag":"a","props":{"href":"/es/book"},"children":["Libro"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/es/book/30"},"children":["Capítulo 30"," ·"," ","Los niños en edad escolar"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"30-08"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["08"]},{"tag":"span","props":{"className":"life-evidence grade-b"},"children":["Evidencia"," ","B"]}]},{"tag":"h1","props":{"lang":"es"},"children":["Haz a los hijos de 12 a 18 años una criba de depresión, y no tomes la evaluación psicológica de la escuela por un diagnóstico"]},{"tag":"p","props":{"lang":"es","className":"life-entry-summary"},"children":["El Grupo de Trabajo de Servicios Preventivos de EE. UU. recomienda cribar la depresión mayor en adolescentes de 12 a 18 años, porque el cálculo da un beneficio moderado y vale la pena. Para 11 años o menos, la evidencia no alcanza. El suicidio es la segunda causa de muerte en las personas de 10 a 19 años. La evaluación psicológica que la escuela aplica cada año escolar es una criba general, no un diagnóstico. Si el propio niño dice que está mal, o si come, duerme, se interesa o rinde de manera claramente distinta en poco tiempo, pide cita directamente en psiquiatría o en psicología clínica."]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Coste"]},{"tag":"p","props":{},"children":["De 0 a unas decenas de yuanes: un cuestionario de criba qu…"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Beneficio"]},{"tag":"p","props":{},"children":["El Grupo de Trabajo de Servicios Preventivos de EE. UU. publicó en 2022 una declaración de recomendación. Reco…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"Marcar: Haz a los hijos de 12 a 18 años una criba de depresión, y no tomes la evaluación psicológica de la escuela por un diagnóstico"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"Hecho"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"Por hacer"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"Guardar"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Compartir consejo"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Ocultar detalles"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Coste"]},{"tag":"p","props":{},"children":["De 0 a unas decenas de yuanes: un cuestionario de criba que se rellena en la consulta de la comunidad o del hospital. Las dos líneas 12355 y 12356 son gratuitas."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Beneficio"]},{"tag":"p","props":{},"children":["El Grupo de Trabajo de Servicios Preventivos de EE. UU. publicó en 2022 una declaración de recomendación. Recomienda cribar el trastorno depresivo mayor en adolescentes de 12 a 18 años (recomendación de grado B). El grado B significa seguridad moderada y beneficio moderado en el cálculo: vale la pena hacerlo. Cribar la depresión mayor en niños de 11 años o menos: evidencia insuficiente (declaración I; es decir, no alcanza para dar recomendación). Cribar de manera específica el riesgo de suicidio en niños y adolescentes: los beneficios y los daños tampoco alcanzan (declaración I). El documento señala que el suicidio es la segunda causa de muerte en las personas de 10 a 19 años. También señala que la depresión mayor de niños y adolescentes va muy unida a muchos problemas posteriores: depresión que reaparece en la adultez, otros trastornos mentales, y también un riesgo más alto de idea suicida, intento de suicidio y muerte por suicidio. Las Diez medidas para fortalecer aún más el trabajo de salud mental de los escolares exigen construir un sistema de servicios de tres niveles: tutor de clase, maestros de salud mental a tiempo completo o parcial, y médicos psiquiatras. Cada alumno recibe una evaluación psicológica por año escolar, en general no más de 1. El documento pide además impulsar los mecanismos de derivación para el tratamiento de las enfermedades mentales y de vuelta al estudio tras la recuperación, y aprovechar el servicio juvenil 12355 y la línea de ayuda psicológica 12356 (nacional, emitido en octubre de 2025)."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Fuentes originales"]},{"tag":"p","props":{"className":"life-citations"},"children":["US Preventive Services Task Force (2022). Screening for Depression and Suicide Risk in Children and Adolescents: US Preventive Services Task Force Recommendation Statement. JAMA. ",{"tag":"a","props":{"href":"https://doi.org/10.1001/jama.2022.16946","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1001/jama.2022.16946"]},"；教育部办公厅 (2025). 进一步加强中小学生心理健康工作十条措施（教基厅〔2025〕2 号）. ",{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/202510/content_7045528.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/zhengce/zhengceku/202510/content_7045528.htm"]}]},{"tag":"a","props":{"href":"https://doi.org/10.1001/jama.2022.16946","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Abrir fuente"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Nota del autor"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["La B es porque lo que da el original es la fuerza de la recomendación, no un efecto convertible en cifras. Y es una recomendación de EE. UU.; en China no hay una recomendación oficial equivalente de cribado. Un resultado positivo de la criba solo dice que toca hacer otra evaluación; no es un diagnóstico. Qué hacer cuando aparece la idea suicida: véase la sección 1, punto 25. Cómo afrontarlo en casa: véase la sección 29."]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Mi nota"]},{"tag":"button","props":{"type":"button"},"children":["Escribe un recordatorio…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/es/tip/30-07"},"ch