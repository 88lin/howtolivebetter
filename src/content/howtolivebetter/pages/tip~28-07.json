ldren":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"收起详情"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["成本"]},{"tag":"p","props":{"className":"life-citations"},"children":["定期挂号，加上抽血复查。一年几百元，占掉几个半天。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["收益"]},{"tag":"p","props":{"className":"life-citations"},"children":["研究者从 Kaiser Permanente 这家医疗集团的电子病历里跟踪了一批人。其中 2,842 名跨性别女性、2,118 名跨性别男性。平均跟踪 4.0 年与 3.6 年。每个人都按出生年、种族、就诊点和入组时间配了约 10 倍的顺性别对照，一共 48,686 名顺性别男性与 48,775 名顺性别女性。跨性别女性的静脉血栓栓塞（血管里长血块堵住）比对照多。和顺性别男性比，2 年是每 1000 人 4.1 例（95% CI 1.6–6.7）。8 年是 16.7 例（6.4–27.5）。算下来，1000 个人里两年多出 4.1 例，八年多出 16.7 例。和顺性别女性比，这两个数是 3.4（1.1–5.6）与 13.7（4.1–22.7）。缺血性卒中（血管堵住那一类中风）与心肌梗死总体各组接近。但在跟踪期内才开始激素治疗的跨性别女性中，静脉血栓与缺血性卒中的差异更明显。跨性别男性的证据不够，下不了结论。作者结论为「这些结果可能提示需要长期警惕跨性别激素中雌激素的血管副作用」"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["来源"]},{"tag":"p","props":{"className":"life-citations"},"children":["Getahun D et al. (2018). Cross-sex Hormones and Acute Cardiovascular Events in Transgender Persons: A Cohort Study. Ann Intern Med. ",{"tag":"a","props":{"href":"https://doi.org/10.7326/M17-2785","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.7326/M17-2785"]},"；国家市场监督管理总局 (2022). 药品网络销售监督管理办法（总局令第 58 号，第九条）. ",{"tag":"a","props":{"href":"https://www.gov.cn/gongbao/content/2022/content_5717002.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/gongbao/content/2022/content_5717002.htm"]},""]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["原书备注"]},{"tag":"p","props":{"className":"life-citations"},"children":["研究者自己写明了这项研究的短处：有多少人是在医院系统外自己买的药，他们查不到，所以「有没有用药」这条线本来就划不干净。所以用药更该放进正规随访里。这项研究看的只是血管出没出事，不回答激素治疗该不该用、用了有什么好处，那是另一套证据。所有用到性激素的场合都一样，包括避孕药、更年期激素治疗、睾酮补充。凡是自己网购、照着网帖调量、从不查血栓和肝肾指标的，风险都出在「没人盯着」这一段，和为什么用药无关。国内的正规路子是去正规医疗机构的内分泌科或者相应专科，做评估、开方、复查。"]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["我的备注"]},{"tag":"button","props":{"type":"button"},"children":["写下对自己有用的提醒…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/tip/28-06"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["上一条"]},"要吃减肥药就去医院拿处方，别在不用处方就发货的网店买"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/tip/28-08"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["下一条"]},"如果「觉得自己丑」已经到反复照镜子、反复想改的程度，先做一次体像评估再谈手术"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["本主题的其他建议"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/28-01"},"children":[{"tag":"strong","props":{},"children":["不要用极端节食、断食或催吐来控制体重，要减就从运动那一侧减"]},{"tag":"span","props":{},"children":["神经性厌食的人，死亡概率大约是同龄人的 5.9 倍。每 1000 个人跟一年，死 5.1 个。死的人里每五个有一个是自杀。而它的入口就是节食：跟踪 44 所中学…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/28-02"},"children":[{"tag":"strong","props":{},"children":["打针、埋线、开刀之前查两样：机构许可证上有没有「医疗美容」，动手的人是不是主诊医师"]},{"tag":"span","props":{},"children":["动针、动刀、用医疗器械，会破皮或进到身体里的，就算看病。只能在许可证上写了「医疗美容」的机构做，动手的必须是注册过的执业医师。在美容院、工作室、酒店房间里做属于…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/28-03"},"children":[{"tag":"strong","props":{},"children":["面部填充避开鼻背、眉间、额头这几个部位，更别为省钱找非正规注射"]},{"tag":"span","props":{},"children":["打填充针后失明的人里，一半多打的是鼻部，其次是眉间、额头和法令纹，八成多用的是玻尿酸。失明的人只有两成视力完全恢复，一成多部分恢复，将近两成还伤到了脑。目前没有…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/28-04"},"children":[{"tag":"strong","props":{},"children":["不要买承诺「快速瘦」的减肥药、减肥咖啡、瘦身糖果和酵素梅（号称泡过酵素的梅子）"]},{"tag":"span","props":{},"children":["这类产品里最常查出偷加的是西布曲明，它原来是减肥药，2010 年在中国被停掉了。有心脏病或糖尿病的超重的人吃了三年多，没致命的心梗高约三成，中风高约三成六。体重…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/28-05"},"children":[{"tag":"strong","props":{},"children":["不要用合成代谢类固醇（「增肌针」「口服药」）来长肌肉"]},{"tag":"span","props":{},"children":["健身房兴奋剂检测阳性的男性，死亡风险是同龄人的 3 倍，每年跑医院的次数多一倍多。痤疮、男性乳房发育、勃起功能障碍，每十个用药的人里至少一个中招。这类药在中国是…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/28-09"},"children":[{"tag":"strong","props":{},"children":["矫正牙齿要找有正畸资质的医生当面检查、按时复诊，别网购牙套自己在家戴"]},{"tag":"span","props":{},"children":["透明牙套在国内是二类医疗器械，说明书要求在有正畸资质的医生指导下戴、定期复诊。美国药监部门说没批准过不经牙医开方就直接卖给个人的牙套。没人当面检查，可能咬合变歪…"]}]}]}]},{"tag":"a","props":{"className":"life-text-link","href":"/book/28"},"children":["阅读整个主题：别为了外形把身体搞坏 ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"15","height":"15","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]}]}]}]},{"tag":"aside","props":{"className":"life-ad-space life-ad-space-sponsored","data-ad-placement":"ad_footer","data-ad-group":"reading","data-ad-creative":"read_product","data-ad-ready":"false","aria-label":"广告 · 社区推荐"},"children":[{"tag":"div","props":{"className":"life-ad-space-brand"},"children":[{"tag":"img","props":{"src":"/sites/howtolivebetter/images/shengcai/logo.png","width":"565","height":"144","alt":"生财有术官方 Logo","decoding":"async"},"children":[]}]},{"tag":"div","props":{"className":"life-ad-space-copy"},"children":[{"tag":"span","props":{"className":"life-ad-space-label"},"children":["广告 · 社区推荐"]},{"tag":"strong","props":{},"children":["读过的知识，能不能做成有用的产品？"]},{"tag":"p","props":{},"children":["从电子书、资料到小工具，看看圈友怎样发现需求，把内容变成实际交付。"]}]},{"tag":"div","props":{"className":"life-ad-space-actions"},"children":[{"tag":"a","props":{"className":"life-ad-space-link","href":"/shengcaiyoushu?sc_group=reading&sc_creative=read_product&sc_placement=ad_footer"},"children":["看看社区与案例",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"18","height":"18","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-up-r