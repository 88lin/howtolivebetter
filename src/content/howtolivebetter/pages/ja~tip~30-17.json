g":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},{"tag":"span","props":{},"children":["ログイン"]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/ja/book/30"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"目次に戻る"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["就学後の子ども"]},{"tag":"nav","props":{"aria-label":"この章のヒント"},"children":[{"tag":"a","props":{"href":"/ja/tip/30-01"},"children":[{"tag":"span","props":{},"children":["01"]},"子供が突然激痛を感じ、さらに痛みが強まっている場合は、すぐに病院へ行ってください。放課後まで我慢させてはいけません"]},{"tag":"a","props":{"href":"/ja/tip/30-02"},"children":[{"tag":"span","props":{},"children":["02"]},"すべき治療を「試験が終わるまで」と先延ばしにしないで。治療の適期は骨の成長とともにあり、試験の予定には左右されません"]},{"tag":"a","props":{"href":"/ja/tip/30-03"},"children":[{"tag":"span","props":{},"children":["03"]},"子供がいじめを受けた際、当日中に学校へ報告し、書面での対応を求める。殴打、金銭の強奪、デマの流布が関わる場合は直接警察へ通報"]},{"tag":"a","props":{"href":"/ja/tip/30-04"},"children":[{"tag":"span","props":{},"children":["04"]},"子供を毎日 2 時間屋外で過ごさせることは、現在、ランダム化比較試験によって支持されている唯一の近視予防策です"]},{"tag":"a","props":{"href":"/ja/tip/30-05"},"children":[{"tag":"span","props":{},"children":["05"]},"0 歳から 3 歳まではスクリーンを与えない、3 歳から 6 歳までは極力与えない、小中学生の学習目的以外での使用は1日 1 時間を超えないこと"]},{"tag":"a","props":{"href":"/ja/tip/30-06"},"children":[{"tag":"span","props":{},"children":["06"]},"近視を「残る損傷」として捉える：度数が深いほど、将来の網膜剥離、黄斑変性、緑内障のリスクが高まる"]},{"tag":"a","props":{"href":"/ja/tip/30-07"},"children":[{"tag":"span","props":{},"children":["07"]},"年に一度の学生健康診断の結果は自分で必ず確認し、異常があればその年のうちに病院で検査を受けること"]},{"tag":"a","props":{"href":"/ja/tip/30-08"},"children":[{"tag":"span","props":{},"children":["08"]},"12歳から18歳の子どもへのうつ病スクリーニング：学校の心理テストを診断と混同しないこと"]},{"tag":"a","props":{"href":"/ja/tip/30-09"},"children":[{"tag":"span","props":{},"children":["09"]},"「近視を治す」「度数を下げる」と謳う製品やサービスは買わない"]},{"tag":"a","props":{"href":"/ja/tip/30-10"},"children":[{"tag":"span","props":{},"children":["10"]},"睡眠、授業、体育、順位に関する明文規定があり、学校が守れていない場合は指摘可能です"]},{"tag":"a","props":{"href":"/ja/tip/30-11"},"children":[{"tag":"span","props":{},"children":["11"]},"子供が限界な場合は休学が可能です。学籍は学校が必ず保持しなければならず、最長 1 年間可能です。"]},{"tag":"a","props":{"href":"/ja/tip/30-12"},"children":[{"tag":"span","props":{},"children":["12"]},"視力不良と判明した際、眼科で散瞳検査を受け、その後医師の指示に従って経過観察を行う"]},{"tag":"a","props":{"href":"/ja/tip/30-13"},"children":[{"tag":"span","props":{},"children":["13"]},"永久臼歯が生えた後のシーラント（窩溝裂溝閉鎖）"]},{"tag":"a","props":{"href":"/ja/tip/30-14"},"children":[{"tag":"span","props":{},"children":["14"]},"子供がゲームに夢中な時、単にプレイ時間だけを見るのではなく、睡眠、宿題、外出活動が削られていないかを確認しましょう"]},{"tag":"a","props":{"href":"/ja/tip/30-15"},"children":[{"tag":"span","props":{},"children":["15"]},"子供が同性が好きだと言っても、責めたり、家から追い出したり、「矯正」しようとしたりしないで：家庭の態度は子供の自殺リスクに関係しています"]},{"tag":"a","props":{"href":"/ja/tip/30-16"},"children":[{"tag":"span","props":{},"children":["16"]},"子供を叩かない、怒鳴ったり「バカ」と罵ったりもしないで：体罰や罵倒を日常的に受けている子供は、行動面・情緒面の問題がより多く見られる"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/ja/tip/30-17","data-status":"active"},"children":[{"tag":"span","props":{},"children":["17"]},"子供のしつけが難しく、つい叩いたり怒鳴ったりしてしまう方へ：具体的な手法を教える前回の親向け講座へ"]},{"tag":"a","props":{"href":"/ja/tip/30-18"},"children":[{"tag":"span","props":{},"children":["18"]},"子どもを閉鎖管理の「ネット依存矯正学校」「特訓キャンプ」に送らない。心身を傷つける矯正は法律で禁止され、監禁で死亡した子どももいる"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"現在地"},"children":[{"tag":"a","props":{"href":"/ja/book"},"children":["本を読む"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/ja/book/30"},"children":["第30章"," ·"," ","就学後の子ども"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"30-17"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["17"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["エビデンス"," ","A"]}]},{"tag":"h1","props":{"lang":"ja"},"children":["子供のしつけが難しく、つい叩いたり怒鳴ったりしてしまう方へ：具体的な手法を教える前回の親向け講座へ"]},{"tag":"p","props":{"lang":"ja","className":"life-entry-summary"},"children":["親に具体的なしつけ方を教える講座について。ランダム化比較試験の結果、子供の他害行為やルールを守らない問題が減少し、親の感情も安定しました。親による子供への叩打や怒鳴る行為も減少しました。この効果は講座終了直後が最も顕著で、1〜2年後も継続していますが、減少幅は小さくなっています。上海でも同様の講座が試行され、有効性が確認されています。"]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["費用・手間"]},{"tag":"p","props":{},"children":["学校、幼稚園、およびコミュニティが運営する親学校は公益目的であり、費用はかかりません。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["効果"]},{"tag":"p","props":{},"children":["Cochrane（コクラン）は13件の試験を統合しており、そのうち10件はランダム化割り付け試験で、合計1件の対象は1078名の親です。"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"記録する：子供のしつけが難しく、つい叩いたり怒鳴ったりしてしまう方へ：具体的な手法を教える前回の親向け講座へ"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"できている"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"やることに追加"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"お気に入り"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"このヒントを共有"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"詳細を閉じる"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["費用・手間"]},{"tag":"p","props":{},"children":["学校、幼稚園、およびコミュニティが運営する親学校は公益目的であり、費用はかかりません。エビデンス（証拠）がある種類の講座は、週に1回または隔週で行われ、1回あたり1〜2時間、期間は4週間から24週間まで様々です。帰宅後も学んだことを実践する必要があります。困難な点は、最後までやり遂げ、毎日継続することです。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["効果"]},{"tag":"p","props":{},"children":["Cochrane（コクラン）は13件の試験を統合しており、そのうち10件はランダム化割り付け試験で、合計1件の対象は1078名の親です。子供の年齢は3歳から12歳で、いずれも行動上の問題がありました。講座を受講した親の子供は、行動上の問題が減少しました。親による自己評価ではSMD −0.53（95% CI −0.72から−0.34、信頼区間）、第三者による独立した評価では−0.44（−0.77から−0.11）でした。SMDとdは同じ尺度であり、0.5は中程度の効果とみなされます。親のメンタルヘルスも改善し、−0.36（−0.52から−0.20）となりました。否定的または厳格なしつけは減少しました。親による自己評価では−0.77（−0.96から−0.59）、第三者による評価では−0.42（−0.67から−0.16）でした。著者はこれらを短期的な効果であると述べています。別のメタ分析では、346件のランダム化比較試験が抽出され、そのうち60件が子供への叩打や怒鳴るなどの行為を測定しており、22カ国にわたっています。叩打や怒鳴る行為は、講座終了直後に減少しました（d = −0.46、−0.59から−0.33）。1〜6ヶ月後は−0.24（−0.37から−0.11）でした。7〜24ヶ月後は−0.18（−0.34から−0.02）となり、時間が経過するほど効果は小さくなっています。これらのデータの多くは親による自己報告です。中国国内でも試験が行われています。上海の81名の親をランダム化割り付けし、一部にTriple Pグループ講座を実施しました。講座終了後、子供の適応問題、親のしつけ、および感情のすべてにおいて、受講を待機していた親よりも良好な結果が得られ、6ヶ月後も継続していました。ある農村部の幼稚園では、子供を連れた大人191名が参加し、一部はオンライン講座を自習し、さらに2回のグループディスカッションを行いました。2週間の終了後、彼らが報告した子供への虐待行為は、資料配布のみのグループと比較して約33%減少しました（IRR 0.67）。3ヶ月後には、子供の行動上の問題も減少しました（d = −0.40）。『家庭教育促進法』は、親が自発的に家庭教育の知識を学ぶことを求めています。小中学校や幼稚園は親学校を運営し、定期的に公益的な家庭教育指導を組織することができます。居委会（居住者委員会）や村委会（村委員会）はコミュニティ親学校を運営できます。省級以上の政府は、公益的なオンライン親学校やサービスホットラインを開設する必要があります。家庭教育指導機関は営利目的のトレーニングを組織してはなりません（中国全土、2022年1月1日より施行）。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["出典"]},{"tag":"p","props":{"className":"life-citations"},"children":["Furlong M, McGilloway S, Bywater T, Hutchings J, Smith SM, Donnelly M. (2012). Behavioural and cognitive-behavioural group-based parenting programmes for early-onset conduct problems in children aged 3 to 12 years. Cochrane Database of Systematic Reviews, (2), CD008225. ",{"tag":"a","props":{"href":"https://doi.org/10.1002/14651858.CD008225.pub2","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1002/14651858.CD008225.pub2"]},"；Backhaus S, Leijten P, Jochim J, Melendez-Torres GJ, Gardner F. (2023). Effects over time of parenting interventions to reduce physical and emotional violence against children: a systematic review and meta-analysis. eClinicalMedicine, 60, 102003. ",{"tag":"a","props":{"href":"https://doi.org/10.1016/j.eclinm.2023.102003","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1016/j.eclinm.2023.102003"]},"；Guo M, Morawska A, Sanders MR. (2016). A Randomized Controlled Trial of Group Triple P With Chinese Parents in Mainland China. Behavior Modification, 40(6), 825–851. ",{"tag":"a","props":{"href":"https://doi.org/10.1177/0145445516644221","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1177/0145445516644221"]},"；Wang W, Zhang H. (2026). A self-directed parenting program to reduce the risk of child maltreatment in rural China: A cluster randomized controlled trial. Child Abuse & Neglect, 173, 107937. ",{"tag":"a","props":{"href":"https://doi.org/10.1016/j.chiabu.2026.107937","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1016/j.chiabu.2026.107937"]},"；全国人大常委会 (2021). 家庭教育促进法（第十八、二十五、三十一、三十八、四十条）. ",{"tag":"a","props":{"href":"https://flk.npc.gov.cn/detail?id=ff8081817cac3b2d017cac5a6c6f0109","target":"_blank","rel":"noopener noreferrer"},"children":["https://flk.npc.gov.cn/detail?id=ff8081817cac3b2d017cac5a6c6f0109"]}]},{"tag":"a","props":{"href":"https://doi.org/10.1002/14651858.CD008225.pub2","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["出典を開く"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["著者の注記"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["A（エビデンスの強さ）を付与している理由は、Cochraneおよび複数のランダム化比較試験を統合した数値に基づいているためです。試験における講座にはいくつかの共通点があります。講師は、子供と一緒に遊ぶ、褒める、報酬を与える、しつけるといった具体的な手法を教えます。親は講座内で練習やロールプレイを行い、帰宅後には宿題もあります。資料配布のみ、あるいは議論のみの講座は除外されているため、単発の講義を聞いただけのケースにはこのエビデンスは適用されません。国内の公益的な親学校の内容や教え方は地域によって異なり、必ずしもこの種類とは限りません。講座を選ぶ際は、数週間にわたって継続し、具体的な実践を促すものであるかを確認してください。講座名によく見られるものには、Triple P、Incredible Years、親子の相互作用療法（PCIT）などがあります。本書では特定の機関や有料の製品を推奨することはありません。叩打や怒鳴る行為の減少効果は1〜2年後に小さくなるため、講座終了後も練習を続ける必要があります。恩恵を受けるのは子供であり、あなた自身でもあります。子供にすでに深刻な情緒の問題がある場合は、精神科または小児科を受診してください（本節の第8条「うつ病スクリーニング」を参照）。"]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["自分のメモ"]},{"tag":"button","props":{"type":"button"},"children":["自分へのメモを書く…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/ja/tip/30-16"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["前へ"]},"子供を叩かない、怒鳴ったり「バカ」と罵ったりもしないで：体罰や罵倒を日常的に受けている子供は、行動面・情緒面の問題がより多く見られる"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/ja/tip/30-18"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["次へ"]},"子どもを閉鎖管理の「ネット依存矯正学校」「特訓キャンプ」に送らない。心身を傷つける矯正は法律で禁止され、監禁で死亡した子どももいる"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["このテーマの他の提案"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/30-10"},"children":[{"tag":"strong","props":{},"children":["睡眠、授業、体育、順位に関する明文規定があり、学校が守れていない場合は指摘可能です"]},{"tag":"span","props":{},"children":["文書には、小学生は毎日 10 時間、中学生は 9 時間、高校生は 8 時間の睡眠をとるべきであると明記され