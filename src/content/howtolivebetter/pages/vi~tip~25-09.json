"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Chia sẻ mẹo này"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Ẩn chi tiết"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Chi phí"]},{"tag":"p","props":{},"children":["Không tốn tiền, nhưng phải đi mấy cửa sổ. Trước khi đi chuẩn bị giấy chứng minh tử vong và giấy chứng minh quan hệ thân nhân."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Lợi ích"]},{"tag":"p","props":{},"children":["Số dư tài khoản quỹ tích góp nhà ở, tức số tiền còn lại trong tài khoản quỹ của người đó, người thừa kế và người được tặng theo di chúc được rút. Người được tặng theo di chúc là người được ghi trong di chúc, người mà người đó để lại tài sản cho. Chết vì tai nạn lao động thì có thêm ba khoản: trợ cấp mai táng, trợ cấp cho thân nhân được trợ cấp và trợ cấp tử vong do tai nạn lao động một lần. Số tiền còn lại trong tài khoản bảo hiểm hưu trí cá nhân, Luật bảo hiểm xã hội ghi rõ có thể thừa kế. Người tham gia bảo hiểm hưu trí người lao động chết vì bệnh hoặc không phải vì tai nạn lao động thì người nhà còn được nhận trợ cấp mai táng và trợ cấp tử vong, gọi chung là quyền lợi cho thân nhân. Công thức cho người lao động doanh nghiệp thống nhất trên cả nước. Trợ cấp mai táng bằng 2 lần mức thu nhập chi tiêu bình quân mỗi người mỗi tháng của dân cư đô thị năm trước của tỉnh. Trợ cấp tử vong lấy mức thu nhập hằng tháng đó làm căn cứ, trả theo thời gian đóng bảo hiểm, từ 3 đến 24 tháng: dưới 5 năm là 3 tháng, từ 5 đến 10 năm là 6 tháng, từ 10 đến 15 năm là 9 tháng, trên 15 năm thì cứ thêm 1 năm thì cộng 1 tháng, nhiều nhất 24 tháng. Người đã nghỉ hưu thì cứ nhận 1 năm lương hưu trí thì bớt 1 tháng, ít nhất 9 tháng"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Nguồn gốc"]},{"tag":"p","props":{"className":"life-citations"},"children":["国务院 (2026). 住房公积金管理条例（国务院令第 844 号修改，2026 年 9 月 20 日起施行）第二十四条末款. ",{"tag":"a","props":{"href":"https://www.gov.cn/gongbao/2026/issue_12946/202608/content_7079363.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/gongbao/2026/issue_12946/202608/content_7079363.html"]},"：「职工死亡或者被宣告死亡的，职工的继承人、受遗赠人可以提取职工住房公积金账户内的存储余额；无继承人也无受遗赠人的，职工住房公积金账户内的存储余额纳入住房公积金的增值收益。」；工伤保险条例第三十九条的三笔待遇见第 19 节. ",{"tag":"a","props":{"href":"https://www.gov.cn/gongbao/content/2011/content_1778064.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/gongbao/content/2011/content_1778064.htm"]},"；全国人大常委会 (2018 修正). 社会保险法（第十四、十七条）：「个人死亡的，个人账户余额可以继承」「参加基本养老保险的个人，因病或者非因工死亡的，其遗属可以领取丧葬补助金和抚恤金」. ",{"tag":"a","props":{"href":"https://flk.npc.gov.cn/detail?id=ff8080816f135f46016f210989b9179a","target":"_blank","rel":"noopener noreferrer"},"children":["https://flk.npc.gov.cn/detail?id=ff8080816f135f46016f210989b9179a"]},"（国家法律法规数据库）；人力资源社会保障部、财政部 (2021). 企业职工基本养老保险遗属待遇暂行办法（人社部发〔2021〕18 号，2021 年 9 月 1 日起施行，第四、五条），原件未公开挂网，条文按广州市花都区人民政府行政复议决定书（花都府行复〔2022〕226 号）的逐字引用核对：「丧葬补助金的标准，按照参保人员死亡时本省……上一年度城镇居民月人均可支配收入的2倍计算」「缴费年限不满5年的，发放月数为3个月……缴费年限30年以上的，按照30年计算，发放月数最高为24个月」. ",{"tag":"a","props":{"href":"https://www.huadu.gov.cn/xxgk/xzfy/content/post_8672730.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.huadu.gov.cn/xxgk/xzfy/content/post_8672730.html"]},"；福建省人力资源和社会保障厅. 常见问题：「每领取1年基本养老金减少1个月，发放月数最低为9个月」「累计缴费年限不足5年的，其遗属待遇（含丧葬补助金和抚恤金）标准不得超过其个人缴费之和」. ",{"tag":"a","props":{"href":"http://rst.fujian.gov.cn/wz/cjwt/czzgly/202311/t20231113_6294929.htm","target":"_blank","rel":"noopener noreferrer"},"children":["http://rst.fujian.gov.cn/wz/cjwt/czzgly/202311/t20231113_6294929.htm"]}]},{"tag":"a","props":{"href":"https://www.gov.cn/gongbao/2026/issue_12946/202608/content_7079363.html","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Liên kết mở nguồn"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Ghi chú sách"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["Khoản quỹ tích góp nhà ở hay bị bỏ sót nhất, vì nó không nằm trong tài khoản ngân hàng và cũng không tự động vào phần chia tài sản. Số tiền còn lại trong tài khoản bảo hiểm hưu trí cá nhân và quyền lợi cho thân nhân là hai khoản tính riêng và phát riêng, phải ra cửa sổ bảo hiểm xã hội nơi tham gia bảo hiểm làm cùng một lúc. Mỗi nơi đòi giấy tờ khác nhau. Thời gian đóng dưới 5 năm thì tổng quyền lợi cho thân nhân không vượt quá số tiền bản thân người đó đã đóng. Công thức này lấy từ biện pháp về bảo hiểm hưu trí người lao động doanh nghiệp, còn quyền lợi cho thân nhân trong bảo hiểm hưu trí của cơ quan, tổ chức, đơn vị công lập và bảo hiểm hưu trí dân cư thì hỏi tại cửa sổ. Yêu cầu về hình thức của di chúc và thừa kế xem phần 17."]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Ghi chú của tôi"]},{"tag":"button","props":{"type":"button"},"children":["Viết một lời nhắc cho chính bạn…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/vi/tip/25-08"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Trước"]},"Môi giới tang chế, môi giới mua tang phẩm, tổ chức và dẫn dắt tang sự phải đăng ký với cơ quan dân vụ cấp huyện"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/vi/tip/25-10"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Tiếp theo"]},"Tài khoản và thông tin cá nhân của người đã mất, người thân gần có quyền yêu cầu tra cứu, sao chép, sửa, xoá"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["Thêm trong chủ đề này"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/25-02"},"children":[{"tag":"strong","props":{},"children":["Giấy chứng minh tử vong là chìa khoá cho mọi việc phía sau: ai cứu chữa thì người đó cấp, tử vong bình thường tại nhà thì tìm cơ sở y tế cộng đồng, ký trong một ngày"]},{"tag":"span","props":{},"children":["Mất ở bệnh viện thì tìm cơ sở đã cứu chữa xin giấy chứng minh tử vong…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/25-03"},"children":[{"tag":"strong","props":{},"children":["Vận chuyển, lưu giữ và thiêu thi thể chỉ làm được ở nhà tang lễ, kho lưu thi thể của bệnh viện không làm tang nghiệp, lưu giữ thường không quá 3 ngày"]},{"tag":"span","props":{},"children":["Vận chuyển, lưu giữ, bảo quản, hoàn thiện thi thể và thiêu chỉ nhà ta…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/25-04"},"children":[{"tag":"strong","props":{},"children":["Bất đồng về nguyên nhân tử vong thì trong 48 giờ phải yêu cầu mổ xác, đồng thời niêm phong hồ sơ bệnh án"]},{"tag":"span","props":{},"children":["Có nghi ngờ về nguyên nhân tử vong thì phải yêu cầu mổ xác trong 48 g…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/25-05"},"children":[{"tag":"strong","props":{},"children":["Ở Trung Quốc, xóa hộ khẩu cho người đã mất có thời hạn luật định: thành thị trước khi an táng, nông thôn trong một tháng"]},{"tag":"span","props":{},"children":["Ở thành phố phải huỷ hộ khẩu trước khi an táng, ở nông thôn thì trong…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/25-06"},"children":[{"tag":"strong","props":{},"children":["Dịch vụ tang chế chia thành mục cơ sở và mục ngoài cơ sở, mục cơ sở có bảng giá, mức thu do pháp luật quy định"]},{"tag":"span","props":{},"children":["Vận chuyển thi thể, lưu giữ, lễ khí chung, thiêu, gửi tro cốt, an tán…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/25-07"},"children":[{"tag":"strong","props":{},"children":["Gặp ép mua kèm, thêm tiền ngoài giá niêm yết, tách một dịch vụ thành mấy dịch vụ để thu tiền thì ghi lại và khiếu nại"]},{"tag":"span","props":{},"children":["Mấy việc sau đều là hành vi vi phạm giá mà quy chế nêu đích danh: khô…"]}]}]}]},{"tag":"a","props":{"className":"life-text-link","href":"/vi/book/25"},"children":["Đọc toàn bộ chủ đề: Sau khi có người qua đời"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"15","height":"15","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]}]}]}]},{"tag":"aside","props":{"className":"life-ad-space life-ad-space-sponsored","data-ad-placement":"ad_footer","data-ad-group":"reading","data-ad-creative":"read_product","data-ad-ready":"false","aria-label":"Quảng cáo · Giới thiệu cộng đồng"},"children":[{"tag":"div","props":{"className":"life-ad-space-brand"},"children":[{"tag":"img","props":{"src":"/sites/howtolivebetter/images/shengcai/logo.png","width":"565","height":"144","alt":"Logo chính thức của Shengcai Youshu","decoding":"async"},"children":[]}]},{"tag":"div","props":{"className":"life-ad-space-copy"},"children":[{"tag":"span","props":{"className":"life-ad-space-label"},"children":["Quảng cáo · Giới thiệu cộng đồng"]},{"tag":"strong","props":{},"children":["Kiến thức bạn có t