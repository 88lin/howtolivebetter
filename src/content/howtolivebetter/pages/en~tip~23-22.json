strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle-user-round","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M18 20a6 6 0 0 0-12 0"},"children":[]},{"tag":"circle","props":{"cx":"12","cy":"10","r":"4"},"children":[]},{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},{"tag":"span","props":{},"children":["Sign in to sync"]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/en/book/23"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"Back to index"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["Which skills are worth learning?"]},{"tag":"nav","props":{"aria-label":"Chapter entries"},"children":[{"tag":"a","props":{"href":"/en/tip/23-01"},"children":[{"tag":"span","props":{},"children":["01"]},"There’s no option for anyone under 16 to “get a job”: any employer who hires them faces a fine of $5000 per month, and those willing to do so are breaking the law"]},{"tag":"a","props":{"href":"/en/tip/23-02"},"children":[{"tag":"span","props":{},"children":["02"]},"Adding “education’s value” to mortality statistics: each extra year of schooling reduces adult mortality by roughly 1.9%"]},{"tag":"a","props":{"href":"/en/tip/23-03"},"children":[{"tag":"span","props":{},"children":["03"]},"Before deciding whether educational qualifications have lost value, check China’s education profile: only 15467 per 100000 have college-level education (2020 census; about 19% estimated in the 2025 sample survey)"]},{"tag":"a","props":{"href":"/en/tip/23-04"},"children":[{"tag":"span","props":{},"children":["04"]},"Run the policy math first: most vocational school tuition is waived, with a 2300‑yuan grant and up to 20000 yuan in student loans per year"]},{"tag":"a","props":{"href":"/en/tip/23-05"},"children":[{"tag":"span","props":{},"children":["05"]},"Failing to get into regular high school doesn’t mean your path ends: secondary vocational schools offer linked admission programs and separate exams, and employers can lower educational requirements for skilled roles"]},{"tag":"a","props":{"href":"/en/tip/23-06"},"children":[{"tag":"span","props":{},"children":["06"]},"Treat “work now or keep studying” as one calculation: three years of wages from going to work first, against the yearly income gap over the following decades that further study buys"]},{"tag":"a","props":{"href":"/en/tip/23-07"},"children":[{"tag":"span","props":{},"children":["07"]},"Keep this baseline in mind: on average worldwide, each additional year of schooling yields a personal return of roughly 9% per year"]},{"tag":"a","props":{"href":"/en/tip/23-08"},"children":[{"tag":"span","props":{},"children":["08"]},"Before spending money on a certification, first verify whether it appears in the National Vocational Qualification Catalogue or in the list of evaluation agencies registered with the Ministry of Human Resources and Social Security"]},{"tag":"a","props":{"href":"/en/tip/23-09"},"children":[{"tag":"span","props":{},"children":["09"]},"It’s best to use government subsidies for training — don’t jump straight to paying for commercial courses out of pocket"]},{"tag":"a","props":{"href":"/en/tip/23-10"},"children":[{"tag":"span","props":{},"children":["10"]},"When picking a skill to learn, prioritize those that require hands-on work and on-the-spot judgment — these are the hardest for automation to replace"]},{"tag":"a","props":{"href":"/en/tip/23-11"},"children":[{"tag":"span","props":{},"children":["11"]},"Check first whether a skill has an official grading system and if those grades can translate into pay raises"]},{"tag":"a","props":{"href":"/en/tip/23-12"},"children":[{"tag":"span","props":{},"children":["12"]},"Don’t take “high wages advertised online” as proof of labor shortages — check local lists of in‑demand occupations and subsidy programs instead"]},{"tag":"a","props":{"href":"/en/tip/23-13"},"children":[{"tag":"span","props":{},"children":["13"]},"For the same cost and time, prioritize short-duration programs that lead directly to employment"]},{"tag":"a","props":{"href":"/en/tip/23-14"},"children":[{"tag":"span","props":{},"children":["14"]},"After studying, close the book and test yourself — don’t just reread it"]},{"tag":"a","props":{"href":"/en/tip/23-15"},"children":[{"tag":"span","props":{},"children":["15"]},"Spread the same study time over several days instead of cramming it all at once"]},{"tag":"a","props":{"href":"/en/tip/23-16"},"children":[{"tag":"span","props":{},"children":["16"]},"Don’t treat highlighting, rereading, and summarizing as primary study methods"]},{"tag":"a","props":{"href":"/en/tip/23-17"},"children":[{"tag":"span","props":{},"children":["17"]},"Mixing different types of exercises rather than doing twenty of the same kind"]},{"tag":"a","props":{"href":"/en/tip/23-18"},"children":[{"tag":"span","props":{},"children":["18"]},"Don’t pick learning methods based on “I’m a visual learner, he’s an auditory learner”"]},{"tag":"a","props":{"href":"/en/tip/23-19"},"children":[{"tag":"span","props":{},"children":["19"]},"Test yourself using questions based on how you’ll use the material later; don’t just recite it verbatim"]},{"tag":"a","props":{"href":"/en/tip/23-20"},"children":[{"tag":"span","props":{},"children":["20"]},"First, figure out which professional series and level you belong to, then find the right application channels based on your employer type"]},{"tag":"a","props":{"href":"/en/tip/23-21"},"children":[{"tag":"span","props":{},"children":["21"]},"Entry- and intermediate-level accounting titles are earned via a national unified exam; first check your education level and work experience to see if you qualify"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/en/tip/23-22","data-status":"active"},"children":[{"tag":"span","props":{},"children":["22"]},"Don’t hire agents to handle evaluations, don’t pay for ghostwritten papers, and don’t falsify any application materials: any proven violations will result in immediate revocation of your professional title and a 3-year entry in your integrity record"]},{"tag":"a","props":{"href":"/en/tip/23-23"},"children":[{"tag":"span","props":{},"children":["23"]},"Having a professional title doesn’t automatically mean a pay raise: first find out whether your employer uses a post‑based quota for evaluation and hiring, or if getting the title doesn’t guarantee a post or raise"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"Breadcrumb"},"children":[{"tag":"a","props":{"href":"/en/book"},"children":["Explore the book"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/en/book/23"},"children":["Chapter 23"," ·"," ","Which skills are worth learning?"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"23-22"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["22"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["Evidence"," ","A"]}]},{"tag":"h1","props":{"lang":"en"},"children":["Don’t hire agents to handle evaluations, don’t pay for ghostwritten papers, and don’t falsify any application materials: any proven violations will result in immediate revocation of your professional title and a 3-year entry in your integrity record"]},{"tag":"p","props":{"lang":"en","className":"life-entry-summary"},"children":["Any professional title obtained through fake materials, ghostwritten papers, or plagiarized work will be revoked upon verification. A record of this misconduct stays on file for 3 years and is shared with the national credit database. If you sign a commitment statement during application and later prove it to be false, you will be barred from applying for any title for 3 years. Labor and social security authorities also actively crack down on agents that make false claims, pose as official evaluators, or sell counterfeit certificates."]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Cost"]},{"tag":"p","props":{},"children":["No direct monetary cost. The real challenge is resisting t…"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Benefit"]},{"tag":"p","props":{},"children":["As stipulated in Order No. 40 issued by the Ministry of Human Resources and Social Security, anyone found to h…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"Mark: Don’t hire agents to handle evaluations, don’t pay for ghostwritten papers, and don’t falsify any application materials: any proven violations will result in immediate revocation of your professional title and a 3-year entry in your integrity record"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"Done"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"Plan to do"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"Save"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Share this tip"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Hide details"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Cost"]},{"tag":"p","props":{},"children":["No direct monetary cost. The real challenge is resisting tempting ads promising “guaranteed approval for a fee.”"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Benefit"]},{"tag":"p","props":{},"children":["As stipulated in Order No. 40 issued by the Ministry of Human Resources and Social Security, anyone found to have submitted false materials, plagiarized others’ work or academic achievements, or obtained a professional title through any other improper means will have their title revoked. This violation is also logged into the professional title evaluation integrity database and shared with the national credit information platform for a 3-year period. The 2024 regulatory guidelines specifically list several prohibited acts by applicants: making false commitments, fabricating personal information, commissioning ghostwritten papers, falsifying work achievements, and seeking special treatment via personal connections. Applicants must sign a personal commitment statement; failure to honor this agreement results in a 3-year ban on all future applications. Labor and social security authorities collaborate with public security, internet regulatory, and market supervision agencies to investigate and penalize agents that run fake websites, make misleading claims, use contract traps, pose as official evaluators, or sell counterfeit certificates. In cases where violations are severe enough to constitute a crime, relevant parties will be handed over to judicial authorities for prosecution (nationwide)."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Original sources"]},{"tag":"p","props":{"className":"life-citations"},"children":["人力资源和社会保障部令第 40 号 (2019). 职称评审管理暂行规定. ",{"tag":"a","props":{"href":"https://www.gov.cn/gongbao/content/2019/content_5437137.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/gongbao/content/2019/content_5437137.htm"]},"：第三十九条；人力资源社会保障部 (2024). 职称评审监管暂行办法. ",{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/202408/content_6969436.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/zhengce/zhengceku/202408/content_6969436.htm"]},"：第五条、第十五条、第十七条、第二十七条；人力资源社会保障部办公厅 (2022). 关于进一步做好职称评审工作的通知. ",{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/2022-12/24/content_5733407.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/zhengce/zhengceku/2022-12/24/content_5733407.htm"]},"：「未经备案的职称评审委员会，评审结果不纳入全国职称评审信息查询验证系统」；新华社 (2024). 职称评审进入高峰，信息如何查？有何新变化？ ",{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/202410/content_6978917.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/zhengce/202410/content_6978917.htm"]},"：「大家可通过www.12333.gov.cn网页、手机12333客户端、人力资源社会保障部门户网站、“人力资源和社会保障部”微信公众号等多种渠道进行登录」"]},{"tag":"a","props":{"href":"https://www.gov.cn/gongbao/content/2019/content_5437137.htm","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Open source link"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Book note"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["A simple way to tell legitimate evaluations from fraudulent ones: any officially awarded professional title can be verified via the National Professional Title Evaluation Information Query Platform, accessible through the 12333 website, its mobile app, or the official Ministry of Human Resources and Social Security site. Titles issued by unregistered evaluation committees cannot be found in this system at all. Therefore, any agent or service that guarantees “100% approval”, claims you don’t need to attend any evaluation process, or promises you can use a title even if it does not appear in official records is almost certainly untrustworthy. The main beneficiaries of these rules are applicants themselves, as they protect them from the serious consequences of title revocation and a 3-year negative credit record."]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["My note"]},{"tag":"button","props":{"type":"button"},"children":["W