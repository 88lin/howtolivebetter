","className":"lucide lucide-circle-user-round","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M18 20a6 6 0 0 0-12 0"},"children":[]},{"tag":"circle","props":{"cx":"12","cy":"10","r":"4"},"children":[]},{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},{"tag":"span","props":{},"children":["Đăng nhập để đồng bộ hóa"]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/vi/book/12"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"Quay lại mục lục"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["Khởi nghiệp: đừng làm mất khoản tiết kiệm của gia đình"]},{"tag":"nav","props":{"aria-label":"Các mục trong chương"},"children":[{"tag":"a","props":{"href":"/vi/tip/12-01"},"children":[{"tag":"span","props":{},"children":["01"]},"Chỉ dùng số tiền mà lỡ mất trắng vẫn chịu được để khởi nghiệp, không đụng vốn của cả nhà, không vay tiền để mở hàng"]},{"tag":"a","props":{"href":"/vi/tip/12-02"},"children":[{"tag":"span","props":{},"children":["02"]},"Đừng ký bảo đảm cá nhân cho khoản vay của công ty, người phối ngẫu càng đừng ký theo"]},{"tag":"a","props":{"href":"/vi/tip/12-03"},"children":[{"tag":"span","props":{},"children":["03"]},"Chọn đúng loại hình kinh doanh trước khi mở hàng: hộ cá thể và cổ phần công chung phải trả đến cùng, chỉ công ty hữu hạn mới「hữu hạn」"]},{"tag":"a","props":{"href":"/vi/tip/12-04"},"children":[{"tag":"span","props":{},"children":["04"]},"Đừng làm cổ phân danh nghĩa, đừng giữ cổ phần thay người khác"]},{"tag":"a","props":{"href":"/vi/tip/12-05"},"children":[{"tag":"span","props":{},"children":["05"]},"Trước khi nhượng quyền, kiểm tra hồ sơ đăng ký ở Bộ Thương mại, lấy bản công bố bằng văn bản, ghi「thời gian cân nhắc」vào hợp đồng"]},{"tag":"a","props":{"href":"/vi/tip/12-06"},"children":[{"tag":"span","props":{},"children":["06"]},"Trước khi đăng ký, chốt tên, địa điểm kinh doanh, phạm vi kinh doanh và vốn đăng ký, đủ hồ sơ thì lấy được giấy phép ngay tại chỗ"]},{"tag":"a","props":{"href":"/vi/tip/12-07"},"children":[{"tag":"span","props":{},"children":["07"]},"Ngành cần giấy phép thì chưa có giấy thì không khai trương"]},{"tag":"a","props":{"href":"/vi/tip/12-08"},"children":[{"tag":"span","props":{},"children":["08"]},"Làm thực phẩm thì xem trước mình ở bậc nào: sản xuất và ăn uống phải có giấy phép, chỉ bán đóng gói sẵn thì kê khai, bán thịt rau tươi không cần giấy"]},{"tag":"a","props":{"href":"/vi/tip/12-09"},"children":[{"tag":"span","props":{},"children":["09"]},"Đóng túi để bán thì là thực phẩm đóng gói sẵn: trên nhãn, ngày sản xuất, hạn sử dụng, bảng thành phần thiếu mục nào cũng không được"]},{"tag":"a","props":{"href":"/vi/tip/12-10"},"children":[{"tag":"span","props":{},"children":["10"]},"Thực phẩm thường không được nói là chữa bệnh: nhãn, hướng dẫn, quảng cáo và lời livestream đều tính"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/vi/tip/12-11","data-status":"active"},"children":[{"tag":"span","props":{},"children":["11"]},"Ngành thực phẩm có đường ranh giới hình sự: bán thịt chết bệnh, hàng vượt tiêu chuẩn là đủ thành tội, trộn thêm nguyên liệu độc hại thì không tính tiền, khởi tội năm năm"]},{"tag":"a","props":{"href":"/vi/tip/12-12"},"children":[{"tag":"span","props":{},"children":["12"]},"Có giấy phép là bắt đầu có nghĩa vụ kê khai, không có doanh thu vẫn phải kê khai đúng hạn (nộp một tờ toàn số không)"]},{"tag":"a","props":{"href":"/vi/tip/12-13"},"children":[{"tag":"span","props":{},"children":["13"]},"Hoá đơn chỉ xuất theo giao dịch thật, người nộp thuế quy mô nhỏ hãy dùng hết ngưỡng miễn thuế"]},{"tag":"a","props":{"href":"/vi/tip/12-14"},"children":[{"tag":"span","props":{},"children":["14"]},"Ai tự xưng cơ quan thuế đòi bạn nộp tiền khai thuế đều là lừa đảo, làm thủ tục thuế chỉ đi qua cổng thuế điện tử và 12366"]},{"tag":"a","props":{"href":"/vi/tip/12-15"},"children":[{"tag":"span","props":{},"children":["15"]},"Nhận tiền thì viết「定金」chứ đừng viết「订金」, tiền phạt vi phạm phải ghi rõ con số, hạn thanh toán thì soi như cho vay"]},{"tag":"a","props":{"href":"/vi/tip/12-16"},"children":[{"tag":"span","props":{},"children":["16"]},"Người lao động tháng đầu phải ký hợp đồng bằng văn bản, 30 ngày đăng ký bảo hiểm xã hội"]},{"tag":"a","props":{"href":"/vi/tip/12-17"},"children":[{"tag":"span","props":{},"children":["17"]},"Lương trả theo hợp đồng và theo pháp luật, tăng lương, cho vay, thưởng đều phải qua văn bản"]},{"tag":"a","props":{"href":"/vi/tip/12-18"},"children":[{"tag":"span","props":{},"children":["18"]},"Bán trước rồi mới sản xuất: dùng bán trước và đơn nhỏ để kiểm chứng có người mua, rồi mới bỏ tiền vào sản xuất"]},{"tag":"a","props":{"href":"/vi/tip/12-19"},"children":[{"tag":"span","props":{},"children":["19"]},"Làm xong mẫu thì so qua danh sách sản xuất hàng loạt, rồi hãy nói chuyện khoảng sản xuất"]},{"tag":"a","props":{"href":"/vi/tip/12-20"},"children":[{"tag":"span","props":{},"children":["20"]},"Mỗi lô hàng nhập về để lại một bộ hoá đơn và thông tin nhà cung cấp, giá nhập thấp hơn hẳn giá thị trường thì không nhập: hàng giả do nhân viên mua, người bị kết án là chủ"]},{"tag":"a","props":{"href":"/vi/tip/12-21"},"children":[{"tag":"span","props":{},"children":["21"]},"Hình ảnh trên hàng, bao bì, treo thẻ và ảnh quảng cáo thì tự làm hoặc mua giấy uỷ quyền, đổi màu, thêm biểu tượng không tính là「đã sửa」"]},{"tag":"a","props":{"href":"/vi/tip/12-22"},"children":[{"tag":"span","props":{},"children":["22"]},"Ở đúng vị trí thì làm theo quy trình, còn cái thiện ý ngoài quy trình thì nghĩ kỹ trách nhiệm thuộc về ai"]},{"tag":"a","props":{"href":"/vi/tip/12-23"},"children":[{"tag":"span","props":{},"children":["23"]},"Lỗ thì rút lui theo thủ tục: huỷ được kiểu rút gọn thì huỷ, vỡ nợ thì đi phá sản, đừng để yên"]},{"tag":"a","props":{"href":"/vi/tip/12-24"},"children":[{"tag":"span","props":{},"children":["24"]},"Trước khi chi tiền thuê người khác quản lý cửa hàng trực tuyến, tham gia khóa đào tạo mở cửa hàng, hoặc thực hiện mô hình 'không nguồn hàng', hãy hỏi rõ liệu sau này có phải trả thêm tiền hay không, và nguồn doanh số sẽ đến từ đâu"]},{"tag":"a","props":{"href":"/vi/tip/12-25"},"children":[{"tag":"span","props":{},"children":["25"]},"Mở công ty hoặc hộ cá thể ở Trung Quốc: từ 1 tháng 1 đến 30 tháng 6 nộp báo cáo năm trước qua mạng, không kinh doanh cũng phải nộp, không mất phí"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"Breadcrumbs"},"children":[{"tag":"a","props":{"href":"/vi/book"},"children":["Khám phá cuốn sách"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/vi/book/12"},"children":["Chương 12"," ·"," ","Khởi nghiệp: đừng làm mất khoản tiết kiệm của gia đình"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"12-11"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["11"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["Bằng chứng"," ","A"]}]},{"tag":"h1","props":{"lang":"vi"},"children":["Ngành thực phẩm có đường ranh giới hình sự: bán thịt chết bệnh, hàng vượt tiêu chuẩn là đủ thành tội, trộn thêm nguyên liệu độc hại thì không tính tiền, khởi tội năm năm"]},{"tag":"p","props":{"lang":"vi","className":"life-entry-summary"},"children":["Mấy mục trước phạt tiền, mục này bắt người. Bán thịt chết bệnh, thịt kiểm nghiệm không đạt, hoặc hàng nông dư lưu, dư lượng độc tố nặng, chỉ cần「đủ sức」khiến người ta ăn vào bị ngộ độc nặng là đủ thành tội, không cần thật sự có người ăn hỏng, phạt tù từ 3 năm trở xuống. Trộn nguyên liệu không phải thực phẩm có độc, gây hại vào thực phẩm thì khởi tội 5 năm trở xuống, không xét bạn đã bán được bao nhiêu tiền."]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Chi phí"]},{"tag":"p","props":{},"children":["Không tốn tiền. Làm theo bộ mục 8 của phần này (làm thực p…"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Lợi ích"]},{"tag":"p","props":{},"children":["Điều một trăm bốn mươi ba của Bộ luật Hình sự quy định mức này. Thực phẩm bạn làm, bán không đúng tiêu chuẩn a…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"Đánh dấu: Ngành thực phẩm có đường ranh giới hình sự: bán thịt chết bệnh, hàng vượt tiêu chuẩn là đủ thành tội, trộn thêm nguyên liệu độc hại thì không tính tiền, khởi tội năm năm"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"Hoàn tất"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"Kế hoạch thực hiện"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"Lưu"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Chia sẻ mẹo này"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Ẩn chi tiết"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Chi phí"]},{"tag":"p","props":{},"children":["Không tốn tiền. Làm theo bộ mục 8 của phần này (làm thực phẩm thì xem trước mình ở bậc nào): giữ giấy kiểm dịch và chứng từ nhập hàng, bảng thành phần chỉ đưa loại có tra được số hiệu phê duyệt."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Lợi ích"]},{"tag":"p","props":{},"children":["Điều một trăm bốn mươi ba của Bộ luật Hình sự quy định mức này. Thực phẩm bạn làm, bán không đúng tiêu chuẩn an toàn thực phẩm. Chỉ cần「đủ sức gây ra tai nạn ngộ độc thực phẩm nghiêm trọng hoặc bệnh do thực phẩm nghiêm trọng khác」là đủ thành tội. Phạt tù từ 3 năm trở xuống hoặc phạt tù ngắn hạn (giam giữ ngắn), kèm phạt tiền. Gây tổn hại nghiêm trọng cho sức khoẻ con người, hoặc có tình tiết nghiêm trọng khác, thì phạt tù từ 3 năm đến 7 năm và phạt tiền. Hậu quả đặc biệt nghiêm trọng thì phạt tù từ 7 năm trở lên cho tới tù chung thân, phạt tiền hoặc tịch thu toàn bộ tài sản. Điều một trăm bốn mươi tư: trộn nguyên liệu không phải thực phẩm có độc, gây hại vào thực phẩm bạn đang làm, bán, hoặc biết đã trộn mà vẫn bán, thì phạt tù từ 5 năm trở xuống và phạt tiền. Gây tổn hại nghiêm trọng cho sức khoẻ con người, hoặc có tình tiết nghiêm trọng khác, thì phạt tù từ 5 năm đến 10 năm và phạt tiền. Gây chết người, hoặc có tình tiết đặc biệt nghiêm trọng khác, thì xử theo Điều một trăm bốn mươi mốt (từ 10 năm trở lên, tù chung thân hoặc tử hình). Tòa án nhân dân tối cao và Viện kiểm sát nhân dân tối cao đã ban hành một bản giải thích (giải thích của hai tòa). Bản nêu rõ những tình huống nào được coi là「đủ sức gây ra tai nạn ngộ độc thực phẩm nghiêm trọng hoặc bệnh do thực phẩm nghiêm trọng khác」. Một là「chứa chất gây ô nhiễm như vi sinh vật gây bệnh vượt quá giới hạn tiêu chuẩn nghiêm trọng, dư lượng thuốc trừ sâu, dư lượng thuốc thú y, độc tố sinh học, kim loại nặng」. Hai là「là thịt và sản phẩm từ gia cầm, thú, thuỷ sản chết bệnh, chết không rõ nguyên nhân hoặc không đạt kiểm dịch, kiểm nghiệm」. Ba là「thuộc loại nhà nước cấm sản xuất, bán để phòng chống bệnh dịch và các nhu cầu đặc biệt khác」. Bốn là「thực phẩm công thức dinh dưỡng cho mục đích y tế đặc biệt, thực phẩm chính, phụ dành cho trẻ nhỏ có thành phần dinh dưỡng không đúng tiêu chuẩn an toàn thực phẩm nghiêm trọng」. Dùng phụ gia liều quá, dùng sai chỗ, đến mức gây ra hậu quả nêu trên, thì cũng bị quy cho tội theo Điều một trăm bốn mươi ba. Cái gì là「nguyên liệu không phải thực phẩm có độc, gây hại」không phải do bạn quyết định. Một loại là chất mà pháp luật cấm cho thêm vào thực phẩm. Loại khác là chất trong danh sách công bố của các bộ ngành của Quốc vụ viện, như thuốc trừ sâu bị cấm, thuốc không được dùng trên gia súc nuôi ăn. Còn một tình huống nữa cũng tính là「tình tiết nghiêm trọng khác」ở Điều một trăm bốn mươi tư. Làm, bán trên 10 vạn tệ mà chưa đến 20 vạn tệ. Địa điểm là khuôn viên trường tiểu học, trung xác thu học, cơ sở chăm sóc người cao tuổi và xung quanh. Đối tượng bán là người chưa thành niên, người cao tuổi. Giết lợn tự lập ở nơi không phải nhà máy giết được chỉ định để buôn bán, tình tiết nặng thì xử theo tội kinh doanh phi pháp. Khi mức tiền trên 10 vạn tệ, hoặc thu được trên 5 vạn tệ, thì coi là「tình tiết nghiêm trọng」（toàn quốc）"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Nguồn gốc"]},{"tag":"p","props":{"className":"life-citations"},"children":["全国人大常委会 (2020 年修正). 刑法（第一百四十一、一百四十三、一百四十四条）. ",{"tag":"a","props":{"href":"https://flk.npc.gov.cn/detail?id=ff808181796a636a0179822a19640c92","target":"_blank","rel":"noopener noreferrer"},"children":["https://flk.npc.gov.cn/detail?id=ff808181796a636a0179822a19640c92"]},"（国家法律法规数据库）；最高人民法院、最高人民检察院 (2021). 关于办理危害食品安全刑事案件适用法律若干问题的解释（法释〔2021〕24 号，第一、二、五、七、九、十七、十八条，2022 年 1 月 1 日起施行）. ",{"tag":"a","props":{"href":"https://scjg.hebei.gov.cn/info/79117","target":"_blank","rel":"noopener noreferrer"},"children":["https://scjg.hebei.gov.cn/info/79117"]},"（河北省市场监督管理局转载全文）、",{"tag":"a","props":{"href":"https://sft.ln.gov.cn/sft/ywgz/zfflgw/xzys/2525860BD0F843EFA7A3B7FDC330614E/index.shtml","target":"_blank","rel":"noopener noreferrer"},"children":["https://sft.ln.gov.cn/sft/ywgz/zfflgw/xzys/2525860BD0F843EFA7A3B7FDC330614E/index.shtml"]},"（辽宁省司法厅转载全文，两份逐字核对一致）"]},{"tag":"a","props":{"href":"https://flk.npc.gov.cn/detail?id=ff808181796a636a0179822a19640c92","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Liên kết mở nguồn"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Ghi chú sách"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["Ranh giới với ba mục trước là có đụng tới an toàn thực phẩm hay không. Không xin giấy, nhãn thiếu mục, thổi tác dụng chữa bệnh thì bị phạt tiền. Bán thịt chết bệnh, hàng vượt tiêu chuẩn, thêm phụ gia bừa bãi, trộn nguyên liệu không phải thực phẩm thì đi vào thủ tục hình sự. Phòng thủ tiện nhất vẫn là bộ động tác ở mục 8 của phần này (làm thực phẩm thì xem trước mình ở bậc nào). Thịt chỉ nhập từ nhà máy giết cố định. Mỗi lô giữ giấy kiểm dịch và giấy xác nhận chất lượng thịt. Thành phần chỉ dùng loại tra được số hiệu phê duyệt. Thứ được gọi là「thịt xử lý giá rẻ」「phế tấm không biết từ đâu」thì hay xảy ra sự cố nhất. Lần này trang Công báo Tòa án nhân dân tối cao trả về lỗi 502, nên đã dẫn hai bản trích lại chính thức của tỉnh và đối chiếu từng chữ với nhau."]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Ghi chú của tôi"]},{"tag":"button","props":{"type":"button"},"children":["Viết một lời nhắc cho chính bạn…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/vi/tip/12-10"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Trước"]},"Thực phẩm thường không được nói là chữa bệnh: nhãn, hướng dẫn, quảng cáo và lời livestream đều tính"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/vi/tip/12-12"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Tiếp theo"]},"Có giấy phép là bắt đầu có nghĩa vụ kê khai, không có doanh thu vẫn phải kê khai đúng hạn (n