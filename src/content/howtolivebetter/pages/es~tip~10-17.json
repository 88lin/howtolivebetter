ath","props":{"d":"M20 12h2"},"children":[]},{"tag":"path","props":{"d":"m6.34 17.66-1.41 1.41"},"children":[]},{"tag":"path","props":{"d":"m19.07 4.93-1.41 1.41"},"children":[]}]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"17","height":"17","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-moon life-theme-icon-dark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"},"children":[]}]}]},{"tag":"button","props":{"type":"button","className":"life-language-switch","aria-label":"Español Elegir idioma","aria-haspopup":"menu","aria-expanded":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-globe","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]},{"tag":"path","props":{"d":"M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"},"children":[]},{"tag":"path","props":{"d":"M2 12h20"},"children":[]}]},{"tag":"span","props":{},"children":["Español"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]}]},{"tag":"a","props":{"className":"life-account","href":"/es/sign-in"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"17","height":"17","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle-user-round","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M18 20a6 6 0 0 0-12 0"},"children":[]},{"tag":"circle","props":{"cx":"12","cy":"10","r":"4"},"children":[]},{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},{"tag":"span","props":{},"children":["Iniciar sesión"]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/es/book/10"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"Volver al índice"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["¿Vale la pena enamorarse y casarse?"]},{"tag":"nav","props":{"aria-label":"Consejos del capítulo"},"children":[{"tag":"a","props":{"href":"/es/tip/10-01"},"children":[{"tag":"span","props":{},"children":["01"]},"Conocer a más gente en vez de obsesionarse con una sola persona: la compatibilidad entre dos personas no se puede predecir antes de conocerse"]},{"tag":"a","props":{"href":"/es/tip/10-02"},"children":[{"tag":"span","props":{},"children":["02"]},"Detente después de un rechazo explícito: insistir es una infracción administrativa, no una prueba de «sinceridad»"]},{"tag":"a","props":{"href":"/es/tip/10-03"},"children":[{"tag":"span","props":{},"children":["03"]},"Para saber si le interesas, mira los actos y no las «señales»: quién toma la iniciativa, quién organiza, quién da seguimiento"]},{"tag":"a","props":{"href":"/es/tip/10-04"},"children":[{"tag":"span","props":{},"children":["04"]},"La calidad de la relación depende sobre todo de cómo te sientes tú en ella, no de las condiciones del otro"]},{"tag":"a","props":{"href":"/es/tip/10-05"},"children":[{"tag":"span","props":{},"children":["05"]},"Para acercaros, turnaos respondiendo un grupo de preguntas de lo superficial a lo profundo; nada de trucos verbales"]},{"tag":"a","props":{"href":"/es/tip/10-06"},"children":[{"tag":"span","props":{},"children":["06"]},"La relación a distancia no es peor que la de la misma ciudad; el verdadero escollo son los tres primeros meses tras mudarse juntos"]},{"tag":"a","props":{"href":"/es/tip/10-07"},"children":[{"tag":"span","props":{},"children":["07"]},"Mira primero los datos del registro civil antes que los consejos de los mayores: qué mide la tasa de nupcialidad y la de divorcio"]},{"tag":"a","props":{"href":"/es/tip/10-08"},"children":[{"tag":"span","props":{},"children":["08"]},"Incluye los beneficios del matrimonio para la salud, pero aplícales el descuento de los datos observacionales"]},{"tag":"a","props":{"href":"/es/tip/10-09"},"children":[{"tag":"span","props":{},"children":["09"]},"Calcula la cuenta del tiempo como «trabajo no remunerado» y aclaren la división de tareas antes de registrar el matrimonio"]},{"tag":"a","props":{"href":"/es/tip/10-10"},"children":[{"tag":"span","props":{},"children":["10"]},"Para la cuenta del dinero del matrimonio, primero mira las reglas legales por defecto y luego decide si conviene un acuerdo por escrito"]},{"tag":"a","props":{"href":"/es/tip/10-11"},"children":[{"tag":"span","props":{},"children":["11"]},"Si los padres aportan dinero para comprar la vivienda, deja claro en el mismo momento de la transferencia si es un préstamo o una donación"]},{"tag":"a","props":{"href":"/es/tip/10-12"},"children":[{"tag":"span","props":{},"children":["12"]},"El dinero que pide prestado en grande tu cónyuge no se convierte automáticamente en deuda tuya si no firmaste ni lo ratificaste después"]},{"tag":"a","props":{"href":"/es/tip/10-13"},"children":[{"tag":"span","props":{},"children":["13"]},"Para registrar el matrimonio bastan el documento de identidad y una declaración firmada: sin padrón, sin pago, con entrega del certificado en el acto"]},{"tag":"a","props":{"href":"/es/tip/10-14"},"children":[{"tag":"span","props":{},"children":["14"]},"Hacerse un examen médico prenupcial; si se padece alguna enfermedad grave, hay que informarlo al otro cónyuge antes de registrar el matrimonio"]},{"tag":"a","props":{"href":"/es/tip/10-15"},"children":[{"tag":"span","props":{},"children":["15"]},"Cálculo del coste de retirada: el divorcio por mutuo acuerdo tiene un periodo de reflexión de 30 días, mientras que el divorcio judicial exige requisitos legales específicos"]},{"tag":"a","props":{"href":"/es/tip/10-16"},"children":[{"tag":"span","props":{},"children":["16"]},"Anote por separado los beneficios de “casarse para complacer a los mayores”, sin mezclarlos con sus propios beneficios"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/es/tip/10-17","data-status":"active"},"children":[{"tag":"span","props":{},"children":["17"]},"Consider the calidad de la relación conyugal como un factor de salud: discutan sobre el tema en cuestión sin atacarse ni usar sarcasmo"]},{"tag":"a","props":{"href":"/es/tip/10-18"},"children":[{"tag":"span","props":{},"children":["18"]},"Las parejas del mismo sexo deben tramitar un poder notarial, la tutela designada y un testamento mientras ambos estén lúcidos: legalmente no son parientes cercanos, y si no lo hacen, no tendrán derecho a firmar ni a heredar."]},{"tag":"a","props":{"href":"/es/tip/10-19"},"children":[{"tag":"span","props":{},"children":["19"]},"No se case ocultando su orientación sexual, ni considere el matrimonio de conveniencia como una solución fácil: legalmente es un matrimonio de verdad y, para terminarlo, solo queda el divorcio"]},{"tag":"a","props":{"href":"/es/tip/10-20"},"children":[{"tag":"span","props":{},"children":["20"]},"Cuando la relación se estanca en peleas constantes y distanciamiento, ambos miembros de la pareja pueden acudir a terapia de pareja: esperar sin hacer nada casi nunca mejora la situación"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"Ruta de navegación"},"children":[{"tag":"a","props":{"href":"/es/book"},"children":["Libro"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/es/book/10"},"children":["Capítulo 10"," ·"," ","¿Vale la pena enamorarse y casarse?"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"10-17"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["17"]},{"tag":"span","props":{"className":"life-evidence grade-b"},"children":["Evidencia"," ","B"]}]},{"tag":"h1","props":{"lang":"es"},"children":["Consider the calidad de la relación conyugal como un factor de salud: discutan sobre el tema en cuestión sin atacarse ni usar sarcasmo"]},{"tag":"p","props":{"lang":"es","className":"life-entry-summary"},"children":["Las parejas con una buena relación conyugal suelen gozar de mejor salud y presentan un riesgo de mortalidad menor. Esta asociación es moderada, similar a la que existe entre la alimentación y la salud. En un experimento, las heridas pequeñas en parejas que mantenían actitudes hostiles durante la discusión sanaron a solo el 60 % de la velocidad que lo hicieron en parejas relajadas."]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Coste"]},{"tag":"p","props":{},"children":["No implica gasto alguno. Al discutir, háganlo solo sobre e…"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Beneficio"]},{"tag":"p","props":{},"children":["Un meta-análisis que agrupó 126 estudios con más de 72 000 participantes reveló que, cuanto mayor es la calida…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"Marcar: Consider the calidad de la relación conyugal como un factor de salud: discutan sobre el tema en cuestión sin atacarse ni usar sarcasmo"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"Hecho"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"Por hacer"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"Guardar"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Compartir consejo"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Ocultar detalles"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Coste"]},{"tag":"p","props":{},"children":["No implica gasto alguno. Al discutir, háganlo solo sobre el asunto presente; eviten insultos, sarcasmo y sacar a relucir viejos conflictos. Lo difícil es controlar la lengua cuando están enfadados."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Beneficio"]},{"tag":"p","props":{},"children":["Un meta-análisis que agrupó 126 estudios con más de 72 000 participantes reveló que, cuanto mayor es la calidad de la relación conyugal, mejor es la salud general; el coeficiente de correlación r oscila entre 0,07 y 0,21. Un valor de 0 indica ausencia de relación, mientras que 1 significa una correlación total. La asociación más fuerte con menor riesgo de mortalidad es r = 0,11. Además, durante las discusiones, la respuesta cardiovascular de estas parejas es menor, con r = –0,13. Los autores señalan que estos efectos son modestos y comparables a los que generan hábitos saludables como la alimentación. En otro estudio, 42 parejas sanas fueron hospitalizadas dos veces durante 24 horas cada una: en una ocasión mantuvieron una conversación de apoyo mutuo y en la otra debatieron un tema controvertido. Tras la discusión, las ampollas producidas experimentalmente sanaron más lentamente; en las parejas con mayor hostilidad, la cicatrización fue solo el 60 % de la velocidad observada en las parejas menos hostiles. A la mañana siguiente, sus niveles sanguíneos de marcadores inflamatorios como IL‑6 y el factor de necrosis tumoral también resultaron más elevados."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Fuentes originales"]},{"tag":"p","props":{"className":"life-citations"},"children":["Robles TF, Slatcher RB, Trombello JM, McGinn MM (2014). Marital quality and health: a meta-analytic review. Psychological Bulletin. ",{"tag":"a","props":{"href":"https://doi.org/10.1037/a0031859","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1037/a0031859"]},"；Kiecolt-Glaser JK 等 (2005). Hostile marital interactions, proinflammatory cytokine production, and wound healing. Archives of General Psychiatry. ",{"tag":"a","props":{"href":"https://doi.org/10.1001/archpsyc.62.12.1377","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1001/archpsyc.62.12.1377"]}]},{"tag":"a","props":{"href":"https://doi.org/10.1037/a0031859","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Abrir fuente"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Nota del autor"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["Se asignó la categoría B porque la mayoría de los estudios analizados son estudios de seguimiento sin grupos de control comparativos; por eso no se puede determinar si una relación deficiente causa enfermedades o si la mala salud empeora la relación. No obstante, tras excluir variables como la edad y los ingresos, la asociación persiste. El propio Robles señala que algunos resultados pueden verse afectados por sesgo de publicación. Los estudios que compararon a hombres y mujeres no hallaron diferencias significativas entre ambos sexos. No se encontró ningún meta‑análisis que comparara directamente la mortalidad de personas en matrimonios desdichos frente a quienes no están casados; por ello la afirmación de que “un matrimonio malo es peor para la salud que no casarse” debe considerarse una inferencia. El experimento de cicatrización involucró solo 42 parejas. La recomendación de “discutir sobre el tema sin atacar al otro” se deriva de los comportamientos hostiles observados en los experimentos; no existen estudios que la hayan probado directamente. Si la discusión se vuelve muy intensa y no mejora, ambos cónyuges pueden acudir a terapia de pareja, tal como se describe en el apartado 20. Cuando la discusión incluye violencia física, insultos prolongados o amenazas, ya no se trata de un problema de comunicación, sino de violencia doméstica; véase el apartado 8, punto 43. Para evaluar si vale la pena mantener la relación, consúltese el apartado 15 sobre los costos de separación."]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Mi nota"]},{"tag":"button","props":{"type":"button"},"children":["Escribe un recordatorio…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/es/tip/10-16"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Anterior"]},"Anote por separado los beneficios de “casarse para complacer a los mayores”, sin mezclarlos con sus propios beneficios"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/es/tip/10-18"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Siguiente"]},"Las parejas del mismo sexo deben tramitar un poder notarial, la tutela designada y un testamento mientras ambos estén lúcidos: legalmente no son parientes cercanos, y si no lo h