me":"lucide lucide-circle-user-round","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M18 20a6 6 0 0 0-12 0"},"children":[]},{"tag":"circle","props":{"cx":"12","cy":"10","r":"4"},"children":[]},{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},{"tag":"span","props":{},"children":["Войти"]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/ru/book/07"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"К содержанию"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["Как выжить, когда денег нет"]},{"tag":"nav","props":{"aria-label":"Советы главы"},"children":[{"tag":"a","props":{"href":"/ru/tip/07-01"},"children":[{"tag":"span","props":{},"children":["01"]},"Как онлайн оформить выплаты по безработице после потери работы"]},{"tag":"a","props":{"href":"/ru/tip/07-02"},"children":[{"tag":"span","props":{},"children":["02"]},"Сначала подайте жалобу в управление по труду и соцстраху, затем обратитесь в арбитраж в одну инстанцию — оба пути бесплатны, и в большинстве случаев решение принимается в течение нескольких месяцев"]},{"tag":"a","props":{"href":"/ru/tip/07-03"},"children":[{"tag":"span","props":{},"children":["03"]},"Если не можете позволить себе оплатить услуги адвоката, обратитесь за бесплатной юридической помощью — дела о невыплате зарплаты, взыскании алиментов, компенсации за травмы на производстве как раз попадают под эту категорию"]},{"tag":"a","props":{"href":"/ru/tip/07-04"},"children":[{"tag":"span","props":{},"children":["04"]},"Когда совсем некуда идти — обращайтесь в центр помощи: там обеспечат питание, жильё и билет домой"]},{"tag":"a","props":{"href":"/ru/tip/07-05"},"children":[{"tag":"span","props":{},"children":["05"]},"Для поиска работы сначала пользуйтесь бесплатными государственными службами занятости и платформами для краткосрочных подработок, не обращаясь к платным посредникам"]},{"tag":"a","props":{"href":"/ru/tip/07-06"},"children":[{"tag":"span","props":{},"children":["06"]},"В случае внезапных бедствий сначала подайте заявление на временную помощь"]},{"tag":"a","props":{"href":"/ru/tip/07-07"},"children":[{"tag":"span","props":{},"children":["07"]},"Подача заявления на дибао при доходе ниже местного порога"]},{"tag":"a","props":{"href":"/ru/tip/07-08"},"children":[{"tag":"span","props":{},"children":["08"]},"Как подать заявление на получение двух видов пособий для инвалидов по наличию удостоверения инвалида"]},{"tag":"a","props":{"href":"/ru/tip/07-09"},"children":[{"tag":"span","props":{},"children":["09"]},"Не прерывайте уплату взносов в медстраховку (ибао) — ежегодно требуется минимум 400 юаней; для малоимущих предусмотрены скидки"]},{"tag":"a","props":{"href":"/ru/tip/07-10"},"children":[{"tag":"span","props":{},"children":["10"]},"При тяжелых заболеваниях сначала пользуйтесь медстраховкой (ибао), программой «Тяжелые заболевания», помощью в медицинских расходах и регистрацией в другом регионе, а от кредитов лучше воздержаться"]},{"tag":"a","props":{"href":"/ru/tip/07-11"},"children":[{"tag":"span","props":{},"children":["11"]},"Если потеряли удостоверение личности, сразу оформляйте дубликат; при срочной необходимости получите временное удостоверение"]},{"tag":"a","props":{"href":"/ru/tip/07-12"},"children":[{"tag":"span","props":{},"children":["12"]},"Получение статуса лица, испытывающего трудности в трудоустройстве после регистрации в качестве безработного, а также получение субсидий на соцстрах или доступ к общественным рабочим местам"]},{"tag":"a","props":{"href":"/ru/tip/07-13"},"children":[{"tag":"span","props":{},"children":["13"]},"Получайте субсидии на профессиональное обучение, стажировки и соцстрахование во время безработицы — не тратьте деньги на платные курсы"]},{"tag":"a","props":{"href":"/ru/tip/07-14"},"children":[{"tag":"span","props":{},"children":["14"]},"Поиск работы: не ограничивайтесь отправкой резюме, используйте системный подход — изучайте навыки, ставьте цели и просите помощи у других"]},{"tag":"a","props":{"href":"/ru/tip/07-15"},"children":[{"tag":"span","props":{},"children":["15"]},"Без залога, без удержания документов, без «обучающих кредитов», без схем пирамид, без высокопроцентных займов"]},{"tag":"a","props":{"href":"/ru/tip/07-16"},"children":[{"tag":"span","props":{},"children":["16"]},"Очередь на социальное жилье для нуждающихся"]},{"tag":"a","props":{"href":"/ru/tip/07-17"},"children":[{"tag":"span","props":{},"children":["17"]},"Сведите расходы на еду и жильё к минимуму: снимайте квартиру на месяц вместо дневной аренды, готовьте сами и пользуйтесь столовыми вместо доставки еды"]},{"tag":"a","props":{"href":"/ru/tip/07-18"},"children":[{"tag":"span","props":{},"children":["18"]},"Не паникуйте из-за перерывов в соцстрахе: пенсия считается по накопленному стажу, а медстраховка — по правилам"]},{"tag":"a","props":{"href":"/ru/tip/07-19"},"children":[{"tag":"span","props":{},"children":["19"]},"Люди, отбывшие тюремное заключение, объявившие банкротство или попавшие в список недобросовестных должников, имеют законные возможности для начала новой жизни — для этого лишь нужно выполнить все необходимые процедуры"]},{"tag":"a","props":{"href":"/ru/tip/07-20"},"children":[{"tag":"span","props":{},"children":["20"]},"Перед серьезным заболеванием стоит оформить на годовой срок медицинскую страховку или страховку от тяжелых болезней помимо базовой медстраховки, но обязательно обратите внимание на фразу «гарантированное продление»"]},{"tag":"a","props":{"href":"/ru/tip/07-21"},"children":[{"tag":"span","props":{},"children":["21"]},"Если совсем негде ночевать, круглосуточные заведения подойдут лишь на одну ночь; лучше сразу идти в приют"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/ru/tip/07-22","data-status":"active"},"children":[{"tag":"span","props":{},"children":["22"]},"Если вам не выплатили зарплату, сначала выясните, кто вас нанимал: нелицензированные мастерские и бригадиры — всё равно в трудовую инспекцию; в суд идут только при работе у семьи или частного лица"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"Навигация"},"children":[{"tag":"a","props":{"href":"/ru/book"},"children":["Книга"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/ru/book/07"},"children":["Глава 7"," ·"," ","Как выжить, когда денег нет"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"07-22"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["22"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["Доказательства"," ","A"]}]},{"tag":"h1","props":{"lang":"ru"},"children":["Если вам не выплатили зарплату, сначала выясните, кто вас нанимал: нелицензированные мастерские и бригадиры — всё равно в трудовую инспекцию; в суд идут только при работе у семьи или частного лица"]},{"tag":"p","props":{"lang":"ru","className":"life-entry-summary"},"children":["Мастерская или лавка без лицензии — жалоба в трудовую инспекцию и трудовой арбитраж возможны, с владельца можно взыскивать лично. Если на стройке должен субподрядчик — платят генеральный подрядчик или заказчик. Только работа у семьи или частного лица, например няня, — это не трудовой спор; нужно искать в суд."]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Затраты"]},{"tag":"p","props":{},"children":["Бесплатно. Сначала проясните три вещи: ведёт ли другая сто…"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Польза"]},{"tag":"p","props":{},"children":["Статья 2 Трудового договора относит «работодателей» к предприятиям, индивидуальным хозяйствам, некоммерческим…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"Отметить: Если вам не выплатили зарплату, сначала выясните, кто вас нанимал: нелицензированные мастерские и бригадиры — всё равно в трудовую инспекцию; в суд идут только при работе у семьи или частного лица"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"Сделано"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"В планах"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"В избранное"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Поделиться советом"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Скрыть подробности"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Затраты"]},{"tag":"p","props":{},"children":["Бесплатно. Сначала проясните три вещи: ведёт ли другая сторона магазин, цех или другое дело; пришла ли работа от компании или со стройки через субподряд; работали ли вы в чьём-то доме. Есть ли у них лицензия, можно проверить в Национальной системе публичного раскрытия информации о кредите предприятий."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Польза"]},{"tag":"p","props":{},"children":["Статья 2 Трудового договора относит «работодателей» к предприятиям, индивидуальным хозяйствам, некоммерческим организациям и т. п.; физические лица не входят. Разъяснение ВС по трудовым спорам перечисляет споры, которые не являются трудовыми: (1) между семьёй или физлицом и работником по домашнему обслуживанию; (2) между ремесленником и подмастерьем или учеником; (3) между сельским подрядчиком и наёмным работником. Такие иски — в суд как гражданские, срок исковой давности 3 года. Работодатель без лицензии в это исключение не попадает. Статья 93 Трудового договора: если у работодателя нет законных оснований для деятельности, а работник уже отработал, организация или её учредители обязаны выплатить зарплату, компенсацию и ущерб. Статья 29 того же разъяснения: при споре с работодателем без лицензии, с отозванной лицензией или работающим после истечения срока — ответчиком указывают организацию или учредителей. Статья 33 Положения о надзоре за соблюдением трудового законодательства: при найме без лицензии или с отозванной лицензией надзор ведёт орган трудового надзора. Индивидуальный подрядчик незаконно нанял работников и причинил вред — заказчик и подрядчик несут солидарную ответственность (ст. 94 Трудового договора). Застройщик или генподрядчик передал работу физлицу или организации без законных оснований, из-за чего задержали зарплату мигрантам — платит застройщик или генподрядчик (ст. 36 Положения о выплате зарплаты мигрантам) (по всей стране)."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Первоисточники"]},{"tag":"p","props":{"className":"life-citations"},"children":["全国人大常委会 (2012 修正). 劳动合同法（第二、九十三、九十四条）. ",{"tag":"a","props":{"href":"https://fgk.chinatax.gov.cn/zcfgk/c100009/c5193025/content.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://fgk.chinatax.gov.cn/zcfgk/c100009/c5193025/content.html"]},"（国家税务总局政策法规库转载）；最高人民法院 (2020). 关于审理劳动争议案件适用法律问题的解释（一）（法释〔2020〕26 号，第二、二十九条）. ",{"tag":"a","props":{"href":"https://www.court.gov.cn/fabu/xiangqing/282121.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.court.gov.cn/fabu/xiangqing/282121.html"]},"；国务院 (2004). 劳动保障监察条例（国务院令第 423 号，第三十三条）. ",{"tag":"a","props":{"href":"https://www.gov.cn/gongbao/content/2004/content_63042.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/gongbao/content/2004/content_63042.htm"]},"；国务院 (2019). 保障农民工工资支付条例（国务院令第 724 号，第三十六条）. ",{"tag":"a","props":{"href":"https://www.gov.cn/gongbao/content/2020/content_5469641.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/gongbao/content/2020/content_5469641.htm"]},"；全国人大 (2020). 民法典（第一百八十八条）. ",{"tag":"a","props":{"href":"https://www.spp.gov.cn/spp/fl/202006/t20200602_463888.shtml","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.spp.gov.cn/spp/fl/202006/t20200602_463888.shtml"]},"；国务院 (2006). 诉讼费用交纳办法（国务院令第 481 号，第六、二十九条）. ",{"tag":"a","props":{"href":"https://www.gov.cn/ziliao/flfg/2006-12/29/content_483682.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/ziliao/flfg/2006-12/29/content_483682.htm"]},