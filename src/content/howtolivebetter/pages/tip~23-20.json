den":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"收起详情"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["成本"]},{"tag":"p","props":{},"children":["不花钱。查一次本省当年的申报通知，半小时左右。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["收益"]},{"tag":"p","props":{},"children":["全国共设 27 个职称系列，比如经济、工程、卫生、出版。职称分高级、中级、初级三层。人社部令第 40 号适用于企业、事业单位、社会团体、个体经济组织，也适用于自由职业者。申报人一般要逐级申报。你所在单位要审核材料，并在单位内公示，公示期不少于 5 个工作日。民营企业和自由职业者，可以由人事代理机构等替你审核、公示、推荐。各地要在科技园区、高新区等地设职称申报受理服务点，也可以通过人才中介服务机构、行业协会商会、学会受理申报。符合条件的自由职业者，按属地参加当地人社部门组织的评审。能在网上核验的材料，不得要求你另外开证明。材料不齐的，评审方要一次性告诉你缺哪些。民营企业的人一般在劳动关系所在地申报。被派到外地连续干满一年的，可以在派驻地申报。离退休人员不能申报。事业单位工作人员受记过以上处分的，处分期间不能申报（全国）"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["原始出处"]},{"tag":"p","props":{"className":"life-citations"},"children":["人力资源和社会保障部令第 40 号 (2019). 职称评审管理暂行规定. ",{"tag":"a","props":{"href":"https://www.gov.cn/gongbao/content/2019/content_5437137.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/gongbao/content/2019/content_5437137.htm"]},"：第二条、第十三条、第十四条、第十五条、第十六条、第十七条、第十八条；人力资源社会保障部办公厅 (2020). 关于进一步做好民营企业职称工作的通知. ",{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/2020-03/03/content_5486340.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/zhengce/zhengceku/2020-03/03/content_5486340.htm"]},"：「在专业技术人才密集的创业孵化基地、高新技术开发区、科技园区等地设立职称申报受理服务点，或通过人才中介服务机构、工商联、行业协会商会、学会等社会组织受理民营企业专业技术人才职称申报」「民营企业专业技术人才被派驻外地连续工作一年以上的，可按有关规定在派驻地申报职称评审」；新华社 (2024). 职称评审进入高峰，信息如何查？有何新变化？ ",{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/202410/content_6978917.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/zhengce/202410/content_6978917.htm"]},"：「我国共设有经济、工程、卫生、出版等27个职称系列」「符合条件的自由职业者，可根据属地原则申报参加当地人社部门组织的职称评审」；中共中央办公厅、国务院办公厅 (2016). 关于深化职称制度改革的意见. ",{"tag":"a","props":{"href":"https://www.gov.cn/gongbao/content/2017/content_5163445.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/gongbao/content/2017/content_5163445.htm"]},"：「不将论文作为评价应用型人才的限制性条件」「对职称外语和计算机应用能力考试不作统一要求」「符合条件的高技能人才，可参加工程系列专业技术人才职称评审」「公务员不得参加专业技术人才职称评审」"]},{"tag":"a","props":{"href":"https://www.gov.cn/gongbao/content/2019/content_5437137.htm","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["打开来源链接"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["原书备注"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["要准备哪些材料，全国没有统一清单。各系列、各省每年发申报通知，材料清单、申报时间和业绩条件都写在里面。所以第一步是在本省人社厅官网找当年的通知。论文不再是一律要有：2016 年的改革意见要求，不把论文当应用型人才的硬门槛，职称外语和计算机考试也不作统一要求。技术工人也有路：符合条件的高技能人才，可以参加工程系列的职称评审。公务员不能参加职称评审。"]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["我的备注"]},{"tag":"button","props":{"type":"button"},"children":["写下对自己有用的提醒…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/tip/23-19"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["上一条"]},"要背的内容按将来的用法出题考自己，别原样背一遍就算完"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/tip/23-21"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["下一条"]},"会计这类初级、中级职称靠全国统考拿，先对照学历和工作年限去报名"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["本主题的其他建议"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/23-15"},"children":[{"tag":"strong","props":{},"children":["把同样的时间摊到几天，别一次学完"]},{"tag":"span","props":{},"children":["同样的时间，分几天学比一次学完记得牢。317 个实验都在测这件事，结论一致。还有一条实用规律：你要记到多久以后，复习间隔就该拉多长。明天考…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/23-16"},"children":[{"tag":"strong","props":{},"children":["别把划重点、反复读、写摘要当成主要学法"]},{"tag":"span","props":{},"children":["学生最常用的是划重点和反复读，可在十种常用学法的排名里，这两样都在最低一档。写摘要、关键词记忆法、给课文配图想象也在最低一档。它们不是完全…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/23-17"},"children":[{"tag":"strong","props":{},"children":["几种题型混着练，别一种连做二十道"]},{"tag":"span","props":{},"children":["同一类题连做一大串，当场做得很顺，过后不一定分得清该用哪个方法。把几类题打乱着练，长期效果更好，属于中等幅度。但这招挑材料：练图像、练分类…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/23-18"},"children":[{"tag":"strong","props":{},"children":["别按「我是视觉型、他是听觉型」挑学法"]},{"tag":"span","props":{},"children":["很多人相信每个人有自己的学习风格，比如视觉型、听觉型，按风格教才学得好。认真检验这件事的研究很少，几乎没有一项支持它，有几项的结果还正好相…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/23-22"},"children":[{"tag":"strong","props":{},"children":["别找中介代评、别买论文代写、别在材料上造假：查实就撤销职称，记诚信档案 3 年"]},{"tag":"span","props":{},"children":["用假材料、代写论文、剽窃成果拿到的职称，查实就撤销。失信记录要记 3 年，还进全国信用平台。申报时签的承诺书不实，3 年内不能再申报。人社…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/23-23"},"children":[{"tag":"strong","props":{},"children":["拿到职称不等于涨工资：先问清单位是按岗位比例评聘，还是评了不一定聘"]},{"tag":"span","props":{},"children":["职称是聘用、考核、晋升的依据，但评上和聘上是两回事。事业单位一般在岗位比例内评，评上多半能聘。不实行岗位管理的单位可以评聘分开，评上了单位…"]}]}]}]},{"tag":"a","props":{"className":"life-text-link","href":"/book/23"},"children":["阅读整个主题：学什么技能划算"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"15","height":"15","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]}]}]}]},{"tag":"aside","props":{"className":"life-ad-space life-ad-space-sponsored","data-ad-placement":"ad_footer","data-ad-group":"reading","data-ad-creative":"read_product","data-ad-ready":"false","aria-label":"广告 · 社区推荐"},"children":[{"tag":"div","props":{"className":"life-ad-space-brand"},"children":[{"tag":"img","prop