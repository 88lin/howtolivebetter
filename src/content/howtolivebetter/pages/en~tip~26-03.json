,"width":"18","height":"18","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-up-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M7 7h10v10"},"children":[]},{"tag":"path","props":{"d":"M7 17 17 7"},"children":[]}]}]}]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/en/book/26"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"Back to index"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["Building a website or platform: licensing, registration, and servers"]},{"tag":"div","props":{"data-ad-dock-host":"true"},"children":[]},{"tag":"nav","props":{"aria-label":"Chapter entries"},"children":[{"tag":"a","props":{"href":"/en/tip/26-01"},"children":[{"tag":"span","props":{},"children":["01"]},"Platforms must never collect payments themselves and then transfer them to sellers; funds must be settled directly via a licensed payment institution"]},{"tag":"a","props":{"href":"/en/tip/26-02"},"children":[{"tag":"span","props":{},"children":["02"]},"Most paid websites need a license; self-operated sales without outside sellers do not; transaction platforms need a different permit; free sites only need filing"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/en/tip/26-03","data-status":"active"},"children":[{"tag":"span","props":{},"children":["03"]},"Obtaining a license for online cultural activities is required to run live streams; private companies rarely qualify for the permit needed to distribute audiovisual content"]},{"tag":"a","props":{"href":"/en/tip/26-04"},"children":[{"tag":"span","props":{},"children":["04"]},"Servers placed in China must be registered; ISPs must hold a value-added telecom license"]},{"tag":"a","props":{"href":"/en/tip/26-05"},"children":[{"tag":"span","props":{},"children":["05"]},"Requiring sellers to join the platform means the platform must verify identities, register data, report information, and retain records for three years"]},{"tag":"a","props":{"href":"/en/tip/26-06"},"children":[{"tag":"span","props":{},"children":["06"]},"You must regulate user-generated content: moderation mechanisms, reporting portals, and immediate takedown plus reporting of illegal material"]},{"tag":"a","props":{"href":"/en/tip/26-07"},"children":[{"tag":"span","props":{},"children":["07"]},"Providing information publishing and instant messaging services requires users to provide authentic identity information"]},{"tag":"a","props":{"href":"/en/tip/26-08"},"children":[{"tag":"span","props":{},"children":["08"]},"No live streaming accounts may be created for anyone under 16; tipping limits are set by age group"]},{"tag":"a","props":{"href":"/en/tip/26-09"},"children":[{"tag":"span","props":{},"children":["09"]},"Respond promptly to infringement notices; restore content after 15 days if no response"]},{"tag":"a","props":{"href":"/en/tip/26-10"},"children":[{"tag":"span","props":{},"children":["10"]},"Personal information must not be casually transferred overseas; legal conditions and thresholds apply"]},{"tag":"a","props":{"href":"/en/tip/26-11"},"children":[{"tag":"span","props":{},"children":["11"]},"When picking a server, first consider how much downtime you can tolerate, then check whether there’s any support available, and only then compare prices"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"Breadcrumb"},"children":[{"tag":"a","props":{"href":"/en/book"},"children":["Explore the book"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/en/book/26"},"children":["Chapter 26"," ·"," ","Building a website or platform: licensing, registration, and servers"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"26-03"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["03"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["Evidence"," ","A"]}]},{"tag":"h1","props":{"lang":"en"},"children":["Obtaining a license for online cultural activities is required to run live streams; private companies rarely qualify for the permit needed to distribute audiovisual content"]},{"tag":"p","props":{"lang":"en","className":"life-entry-summary"},"children":["To host live streams or game commentary sessions, you must secure a provincial-level Online Cultural Activities License that explicitly lists “online performances” among its permitted activities. Approval is granted within 20 days, and the license stays valid for three years. All recorded streams must be retained for a minimum of 60 days. Operating without this license results in immediate suspension, warnings, and fines up to 30,000 RMB; repeat offenders face inclusion on a cultural industry blacklist. A separate permit is required to distribute audiovisual content online, and only state-owned or state-controlled organizations may qualify for it."]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Cost"]},{"tag":"p","props":{},"children":["The so-called “Online Cultural Activities License” governs…"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Benefit"]},{"tag":"p","props":{},"children":["Securing the proper licensing framework ensures legal operation within China’s digital media sector while avoi…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"Mark: Obtaining a license for online cultural activities is required to run live streams; private companies rarely qualify for the permit needed to distribute audiovisual content"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"Done"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"Plan to do"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"Save"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Share this tip"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Hide details"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Cost"]},{"tag":"p","props":{},"children":["The so-called “Online Cultural Activities License” governs whether one may earn money via live streams or game commentary. It is issued by provincial-level cultural authorities within 20 days of application and remains valid for three years, after which renewal must be requested at least 30 days prior to expiration. The separate Audiovisual Content Distribution License determines eligibility to publish programs online; it mandates that applicants be wholly state-owned or state-controlled entities — private firms essentially cannot obtain it."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Benefit"]},{"tag":"p","props":{},"children":["Securing the proper licensing framework ensures legal operation within China’s digital media sector while avoiding punitive measures. Compliance safeguards both business continuity and reputation by adhering to stringent regulatory standards governing online cultural activities and audiovisual distribution."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Original sources"]},{"tag":"p","props":{"className":"life-citations"},"children":["文化部 (2016). 网络表演经营活动管理办法（文市发〔2016〕33 号，第二、四、六、十三、二十条）. ",{"tag":"a","props":{"href":"https://zwgk.mct.gov.cn/zfxxgkml/scgl/202012/t20201206_918194.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://zwgk.mct.gov.cn/zfxxgkml/scgl/202012/t20201206_918194.html"]}," ; 文化部 (2011). 互联网文化管理暂行规定（文化部令第 51 号，2017 年经文化部令第 57 号修订，第七、八、九、十六、二十一、二十八条）. ",{"tag":"a","props":{"href":"https://zwgk.mct.gov.cn/zfxxgkml/zcfg/bmgz/202012/t20201204_905340.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://zwgk.mct.gov.cn/zfxxgkml/zcfg/bmgz/202012/t20201204_905340.html"]}," ; 广电总局、信息产业部 (2007). 互联网视听节目服务管理规定（第 56 号令，2015 年修订，第二、七、八、二十四条）. ",{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/2022-08/23/content_5722664.htm","target":"_