 mở nguồn"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Ghi chú sách"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["Ai đủ điều kiện thì do bác sĩ quyết, thường là người đã chẩn đoán rõ và phương thuốc đã ổn định. Thuốc vẫn là thuốc cũ, cái tiết kiệm là nửa ngày mỗi tháng chạy đi lấy và tiền lệ khám. Ở tuyến cơ sở không có loại thuốc bạn cần thì hỏi xem có đăng ký thiếu thuốc và cấp phát không. Cùng văn bản đó còn yêu cầu bệnh viện hạng ba dần bỏ khám ngoại trú thường cho loại bệnh mạn tính này, khám ngoại trú thường của cùng nhóm chuyên gia chuyển xuống mở ở cộng đồng. Còn coi bệnh viện lớn là chỗ lấy thuốc thì sau này sẽ càng khó lấy số khám."]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Ghi chú của tôi"]},{"tag":"button","props":{"type":"button"},"children":["Viết một lời nhắc cho chính bạn…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/vi/tip/16-04"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"tr