ta-dock-active":"false","style":{"top":"94px"}},"children":[{"tag":"div","props":{"className":"life-ad-dock","hidden":true},"children":[{"tag":"aside","props":{"className":"life-ad-space life-ad-space-sponsored life-ad-space-compact","data-ad-placement":"ad_dock","data-ad-group":"reading","data-ad-creative":"read_product","data-ad-ready":"false","aria-label":"Advertisement · Community recommendation"},"children":[{"tag":"button","props":{"type":"button","className":"life-ad-dismiss","aria-label":"Close ad"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-x","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M18 6 6 18"},"children":[]},{"tag":"path","props":{"d":"m6 6 12 12"},"children":[]}]}]},{"tag":"div","props":{"className":"life-ad-space-brand"},"children":[{"tag":"img","props":{"src":"/sites/howtolivebetter/images/shengcai/logo.png","width":"565","height":"144","alt":"Official Shengcai Youshu logo","decoding":"async"},"children":[]}]},{"tag":"div","props":{"className":"life-ad-space-copy"},"children":[{"tag":"span","props":{"className":"life-ad-space-label"},"children":["Advertisement · Community recommendation"]},{"tag":"strong","props":{},"children":["Could what you know become a useful product?"]},{"tag":"p","props":{},"children":["From ebooks to small tools, explore how members spot needs and turn knowledge into something people can use."]}]},{"tag":"div","props":{"className":"life-ad-space-actions"},"children":[{"tag":"a","props":{"className":"life-ad-space-link","href":"/en/shengcaiyoushu?sc_group=reading&sc_creative=read_product&sc_placement=ad_dock"},"children":["Explore the community and examples",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"18","height":"18","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-up-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M7 7h10v10"},"children":[]},{"tag":"path","props":{"d":"M7 17 17 7"},"children":[]}]}]}]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/en/book/08"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"Back to index"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["Protect yourself: legal rights and property safety"]},{"tag":"div","props":{"data-ad-dock-host":"true"},"children":[]},{"tag":"nav","props":{"aria-label":"Chapter entries"},"children":[{"tag":"a","props":{"href":"/en/tip/08-01"},"children":[{"tag":"span","props":{},"children":["01"]},"After a traffic accident, stop, help the injured, and call the police — don’t flee"]},{"tag":"a","props":{"href":"/en/tip/08-02"},"children":[{"tag":"span","props":{},"children":["02"]},"If you realize you’ve been scammed, call 110 or 96110 right away to request a stop‑payment — don’t try to investigate on your own first"]},{"tag":"a","props":{"href":"/en/tip/08-03"},"children":[{"tag":"span","props":{},"children":["03"]},"Remember the core anti-fraud rules: don’t trust unsolicited calls, don’t share personal information, don’t click on suspicious links, and always verify any transfer requests. All seven of the most common scam types follow this same pattern"]},{"tag":"a","props":{"href":"/en/tip/08-04"},"children":[{"tag":"span","props":{},"children":["04"]},"Seeing a face on video or hearing a voice on the phone does not count as verification; if a transfer is involved, hang up first and call back using an old number saved in your contacts"]},{"tag":"a","props":{"href":"/en/tip/08-05"},"children":[{"tag":"span","props":{},"children":["05"]},"If accused or summoned, hire a lawyer first — don’t settle privately or delete records"]},{"tag":"a","props":{"href":"/en/tip/08-06"},"children":[{"tag":"span","props":{},"children":["06"]},"If something happens, come forward and explain: voluntary surrender can cut a sentence by up to 40%, and minor offenses may qualify for more or exemption; “waiting out the prosecution limit” is a dead end"]},{"tag":"a","props":{"href":"/en/tip/08-07"},"children":[{"tag":"span","props":{},"children":["07"]},"Don’t touch the steering wheel after drinking — even for e‑bikes or “just moving the car a bit”"]},{"tag":"a","props":{"href":"/en/tip/08-08"},"children":[{"tag":"span","props":{},"children":["08"]},"Never lend your bank cards, SIM cards, or payment accounts to anyone — “money laundering” is not a side hustle"]},{"tag":"a","props":{"href":"/en/tip/08-09"},"children":[{"tag":"span","props":{},"children":["09"]},"Checking your credit report twice a year for free helps spot any loans or cards you didn’t apply for"]},{"tag":"a","props":{"href":"/en/tip/08-10"},"children":[{"tag":"span","props":{},"children":["10"]},"If a fight breaks out, call the police first — the one who strikes first almost always loses"]},{"tag":"a","props":{"href":"/en/tip/08-11"},"children":[{"tag":"span","props":{},"children":["11"]},"You may defend yourself against an unavoidable attack, but only strike the person who is actually attacking — stop when he stops"]},{"tag":"a","props":{"href":"/en/tip/08-12"},"children":[{"tag":"span","props":{},"children":["12"]},"Who to hold accountable — unpaid wages, wrongful dismissal, financial losses — filing complaints, arbitration, or lawsuits instead of taking revenge"]},{"tag":"a","props":{"href":"/en/tip/08-13"},"children":[{"tag":"span","props":{},"children":["13"]},"However angry you are, do not attack uninvolved people: driving into a crowd or attacking people in public can constitute endangering public safety by dangerous means, with sentences starting at three years; if someone dies, ten years minimum, up to the death penalty"]},{"tag":"a","props":{"href":"/en/tip/08-14"},"children":[{"tag":"span","props":{},"children":["14"]},"Thoughts such as “find a scapegoat” or “die together” must be treated as a medical emergency: leave the scene, hand over car keys and knives to someone else, and call 12356"]},{"tag":"a","props":{"href":"/en/tip/08-15"},"children":[{"tag":"span","props":{},"children":["15"]},"Family members say “no one will be safe” or “I’ll take the kids and leave” — don’t dismiss this as anger: close relatives can take such a person to the hospital, and police must respond to any emergency call"]},{"tag":"a","props":{"href":"/en/tip/08-16"},"children":[{"tag":"span","props":{},"children":["16"]},"Don’t curse, spread rumors, or share unverified content online; if you’re a victim of online abuse, document evidence first then report it to police"]},{"tag":"a","props":{"href":"/en/tip/08-17"},"children":[{"tag":"span","props":{},"children":["17"]},"Read the document thoroughly before signing; never sign on behalf of others or on blank paper"]},{"tag":"a","props":{"href":"/en/tip/08-18"},"children":[{"tag":"span","props":{},"children":["18"]},"Write a clear loan agreement when lending money; think carefully before agreeing to be a guarantor"]},{"tag":"a","props":{"href":"/en/tip/08-19"},"children":[{"tag":"span","props":{},"children":["19"]},"Time limits for legal action: 3 years for civil lawsuits, 1 year for labor arbitration; once the deadline passes, a simple “statute of limitations exceeded” claim can block your case"]},{"tag":"a","props":{"href":"/en/tip/08-20"},"children":[{"tag":"span","props":{},"children":["20"]},"If you’re being sued or have a court order against you, report all your assets truthfully and repay as much as you can — don’t transfer your house or money to relatives, friends, or companies"]},{"tag":"a","props":{"href":"/en/tip/08-21"},"children":[{"tag":"span","props":{},"children":["21"]},"If you’re subject to spending restrictions or listed on the dishonesty registry, first find out which rule applies and request removal if possible"]},{"tag":"a","props":{"href":"/en/tip/08-22"},"children":[{"tag":"span","props":{},"children":["22"]},"If scammed while shopping online or via second-hand markets, first file a complaint with the platform, then report it to police, and finally decide whether to sue"]},{"tag":"a","props":{"href":"/en/tip/08-23"},"children":[{"tag":"span","props":{},"children":["23"]},"Think carefully before and after making large gifts in romantic relationships or marriage"]},{"tag":"a","props":{"href":"/en/tip/08-24"},"children":[{"tag":"span","props":{},"children":["24"]},"Transfer betrothal gifts via payment with clear notes; keep chat records; money demanded under marriage can be reclaimed"]},{"tag":"a","props":{"href":"/en/tip/08-25"},"children":[{"tag":"span","props":{},"children":["25"]},"No need to worry about premarital assets — clearly define property additions and parental contributions"]},{"tag":"a","props":{"href":"/en/tip/08-26"},"children":[{"tag":"span","props":{},"children":["26"]},"Check a person’s marital status before getting married; those who use marriage as a pretext to defraud money can be prosecuted for fraud"]},{"tag":"a","props":{"href":"/en/tip/08-27"},"children":[{"tag":"span","props":{},"children":["27"]},"For home appliance repairs, vehicle inspections, and renovations: always ask for a quote first and stay on site throughout the process"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/en/tip/08-28","data-status":"active"},"children":[{"tag":"span","props":{},"children":["28"]},"Don’t be a “nominal legal representative” — don’t lend your ID to register a company"]},{"tag":"a","props":{"href":"/en/tip/08-29"},"children":[{"tag":"span","props":{},"children":["29"]},"Don’t carry items for strangers when traveling, and don’t accept packages of unknown origin"]},{"tag":"a","props":{"href":"/en/tip/08-30"},"children":[{"tag":"span","props":{},"children":["30"]},"Leashing dogs is mandatory: failure to do so means strict liability for any harm caused (you must pay compensation regardless of fault), and the obligation extends fully. The dog also needs its rabies vaccinations on schedule and a dog registration"]},{"tag":"a","props":{"href":"/en/tip/08-31"},"children":[{"tag":"span","props":{},"children":["31"]},"If the other person is intoxicated, unconscious, or under 14, do not have sex with them"]},{"tag":"a","props":{"href":"/en/tip/08-32"},"children":[{"tag":"span","props":{},"children":["32"]},"If someone threatens to call the police, post intimate photos, or inform your workplace unless you pay up — don’t give them a single cent and don’t delete any records; call the police right away"]},{"tag":"a","props":{"href":"/en/tip/08-33"},"children":[{"tag":"span","props":{},"children":["33"]},"If someone falsely accuses you, you can seek legal consequences: up to 5 days of detention for minor violations, up to 3 years in prison for criminal acts"]},{"tag":"a","props":{"href":"/en/tip/08-34"},"children":[{"tag":"span","props":{},"children":["34"]},"Insufficient evidence alone warrants acquittal; coerced confessions must be excluded; appeals and retrials remain possible after conviction"]},{"tag":"a","props":{"href":"/en/tip/08-35"},"children":[{"tag":"span","props":{},"children":["35"]},"For individuals released from detention after a case is dropped, charges are withdrawn, or they are acquitted, applying for state compensation is possible — compensation is calculated on a daily basis"]},{"tag":"a","props":{"href":"/en/tip/08-36"},"children":[{"tag":"span","props":{},"children":["36"]},"If you’re a victim seeking compensation, use channels like 12315, file a lawsuit, or hire a lawyer. Never meet the offending party alone, and don’t phrase “paying money” and “I won’t expose you” as a single condition"]},{"tag":"a","props":{"href":"/en/tip/08-37"},"children":[{"tag":"span","props":{},"children":["37"]},"Cyberbullying: First enable protections, gather evidence, then choose between court injunctions, private prosecution, or police reports"]},{"tag":"a","props":{"href":"/en/tip/08-38"},"children":[{"tag":"span","props":{},"children":["38"]},"The legal route of “buying insurance for a family member first, then harming them” is completely blocked: you get zero money, and the perpetrator faces multiple charges including intentional homicide and insurance fraud"]},{"tag":"a","props":{"href":"/en/tip/08-39"},"children":[{"tag":"span","props":{},"children":["39"]},"You must obtain a case receipt when reporting a crime; if no case is opened, you must receive a written notice. You can request a reconsideration within 7 days and a review within another 7 days. The procuratorate can also order the police to open a case"]},{"tag":"a","props":{"href":"/en/tip/08-40"},"children":[{"tag":"span","props":{},"children":["40"]},"Don’t give money or cards to investigators, law enforcers: offering bribes is a crime, and bribing oversight, law enforcement, and judicial staff is punished even more severely"]},{"tag":"a","props":{"href":"/en/tip/08-41"},"children":[{"tag":"span","props":{},"children":["41"]},"For calls and in-person talks where things might turn sour, start recording right away: you can record conversations you personally take part in without needing prior consent from the other party"]},{"tag":"a","props":{"href":"/en/tip/08-42"},"children":[{"tag":"span","props":{},"children":["42"]},"In an emergency at the scene, first film a wide shot, then capture the spatial relationships, and finally record the damage and injuries — keep the original photos and videos"]},{"tag":"a","props":{"href":"/en/tip/08-43"},"children":[{"tag":"span","props":{},"children":["43"]},"Domestic violence: Call the police to get an incident report, then apply to court for a protection order — no divorce required and it’s free"]},{"tag":"a","props":{"href":"/en/tip/08-44"},"children":[{"tag":"span","props":{},"children":["44"]},"Family members have gambling debts; don't rush to pay them for them: Gambling debts are not protected by law, and money borrowed for gambling does not count as common marital debt"]},{"tag":"a","props":{"href":"/en/tip/08-45"},"children":[{"tag":"span","props":{},"children":["45"]},"Don’t agree when an acquaintance asks you to “help by doing a facial scan or acting as a witness” to secure a loan, or to read out a verification code — this is known as “AB loan” fraud. In this scheme, you are the borrower, not a guarantor"]},{"tag":"a","props":{"href":"/en/tip/08-46"},"children":[{"tag":"span","props":{},"children":["46"]},"Fit locks on doors and windows, install a motion-sensor light outside, and actually lock up when leaving: these help prevent burglary; an alarm alone shows no clear benefit"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"Breadcrumb"},"children":[{"tag":"a","props":{"href":"/en/book"},"children":["Explore the book"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/en/book/08"},"children":["Chapter 8"," ·"," ","Protect yourself: legal rights and property safety"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"08-28"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["28"]},{"tag":"span","props":{"className":"life-evidence grade-b"},"children":["Evidence"," ","B"]}]},{"tag":"h1","props":{"lang":"en"},"children":["Don’t be a “nominal legal representative” — don’t lend your ID to register a company"]},{"tag":"p","props":{"lang":"en","className":"life-entry-summary"},"children":["The law assumes the legal representative is the person actually managing the company; claiming “I’m just a figurehead and know nothing” does not serve as a valid excuse to avoid liability. If a legal representative causes harm to others while performing duties, the company must compensate first, then may seek reimbursement from the negligent representative. For those already serving in this role, company law allows them to resign, provided the company appoints a new legal representative within 30 days."]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Cost"]},{"tag":"p","props":{},"children":["There’s no cost involved. If someone asks you to “just be…"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Benefit"]},{"tag":"p","props":{},"children":["The legal representative is intended to be the director or manager who actually runs the company’s affairs, me…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"Mark: Don’t be a “nominal legal representative” — don’t lend your ID to register a company"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"Done"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"ht