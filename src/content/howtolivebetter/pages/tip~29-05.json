"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"收藏"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"分享这条建议"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"收起详情"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["成本"]},{"tag":"p","props":{"className":"life-citations"},"children":["不花钱。找一个具体的人，子女、兄弟姐妹或者朋友都行，让他定期上门或者打电话。难在要开口把这件事托付出去。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["收益"]},{"tag":"p","props":{"className":"life-citations"},"children":["15 项先登记再往后跟踪的研究、2,263,888 人合起来算。丧偶不足 6 个月时死亡 RR 1.41（95% CI 1.26–1.57），即同期死亡概率比没丧偶的人高约四成。6 个月以后是 1.14（1.10–1.18），降到高约一成半。男性 RR 1.23（1.18–1.28），高约两成三。女性 1.04（1.00–1.08，无统计学意义，即这点差可能只是巧合）。小于 65 岁与 65 岁以上没看出明显差别。另一项分析合并了 123 篇文献、1377 个风险估计、逾 5 亿人。把条件差异扣平后 HR 1.23（1.19–1.28），即整体高约两成三。男性还高于女性。男性 1.27（1.19–1.35），高两成七。女性 1.15（1.08–1.22），高一成五"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["来源"]},{"tag":"p","props":{"className":"life-citations"},"children":["Moon JR, et al. (2011). Widowhood and mortality: a meta-analysis. PLoS ONE. ",{"tag":"a","props":{"href":"https://doi.org/10.1371/journal.pone.0023465","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1371/journal.pone.0023465"]},"；Shor E, et al. (2012). Widowhood and mortality: a meta-analysis and meta-regression. Demography. ",{"tag":"a","props":{"href":"https://doi.org/10.1007/s13524-012-0096-x","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1007/s13524-012-0096-x"]},""]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["原书备注"]},{"tag":"p","props":{"className":"life-citations"},"children":["这是回头翻人群数据的研究，别的因素掺进来去不掉。夫妻的生活方式和疾病本来就相似。但「头半年比之后高得多」这个规律，在两份各自独立的汇总分析里都一样，值得当成一段照看窗口。男性风险更高，也更少开口求助。家里有丧偶老人的，按第 17 节把账户、监护和遗嘱一并理清。找不到这样一个人的（独居、失独、子女也不在了），把这件事交给社区和手机，见本节第 6 条。"]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["我的备注"]},{"tag":"button","props":{"type":"button"},"children":["写下对自己有用的提醒…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/tip/29-04"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["上一条"]},"亲人死于自杀、意外或凶案的，别指望硬扛，主动去找专业帮助"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/tip/29-06"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["下一条"]},"没有亲人也没有朋友的，把「盯着你的那个人」换成三样东西：能进你家门的邻居、社区的探访名单、手机里的紧急联络"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["本主题的其他建议"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/29-01"},"children":[{"tag":"strong","props":{},"children":["亲人刚走的那几天别一个人待着，有心脏病、高血压、糖尿病的照常吃药，胸口压着疼就叫 120"]},{"tag":"span","props":{},"children":["亲人去世后头一天，心梗发作的概率是平时的 21.1 倍，之后一天比一天低。60 到 89 岁的人在伴侣去世后 30 天内，心梗或中风的比例大约翻倍，一个月后回落…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/29-02"},"children":[{"tag":"strong","props":{},"children":["被告知重病诊断的那一周，别一个人去拿报告，治疗以外的决定往后放"]},{"tag":"span","props":{},"children":["拿到癌症诊断的第一周，自杀的概率是没确诊的人的 12.6 倍，死于心血管病的概率是 5.6 倍。到第一年，自杀风险降到 3.1 倍，越难治的癌越明显。所以拿报告…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/29-03"},"children":[{"tag":"strong","props":{},"children":["失业之后先把作息、医保和找工作的节奏固定下来，别整天待在家里"]},{"tag":"span","props":{},"children":["失业的人之后死亡的概率比在职的人高约六成，男性和年纪不大的人更明显，头十年最高。把抽烟喝酒的影响扣掉，升幅少了约四分之一，这部分自己能管住。先去办失业登记、领失…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/29-07"},"children":[{"tag":"strong","props":{},"children":["家长去世后，如实告诉孩子、让他参加告别、别送去别处「换个环境」"]},{"tag":"span","props":{},"children":["18 岁前失去父亲或母亲的孩子，到成年早期死亡的概率比没经历过的孩子高约五成。父母死于意外、自杀的高约八成，死于疾病的高约三成。家里能做的是如实告诉他，让他参加…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/29-08"},"children":[{"tag":"strong","props":{},"children":["哀伤过了半年还在原地、日子过不下去，去精神科或临床心理科挂号"]},{"tag":"span","props":{},"children":["大约每十个丧亲的成年人里有一个会卡住：半年以上还在持续想念到吃不下饭、上不了班、带不了孩子，人麻木，觉得生活没有意义。这不是不够坚强，它有诊断标准，也有专门的治…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/29-09"},"children":[{"tag":"strong","props":{},"children":["别一上来就花钱做哀伤咨询，先看自己的哀伤是不是真的卡住了（第 8 条那几条症状）"]},{"tag":"span","props":{},"children":["给所有丧亲的人都安排心理咨询，好处很小，过一阵就看不出来了，因为多数人本来会自己缓过来。但对已经明显适应不了的人，治疗和治别的心理问题一样有效。所以先对照第 8…"]}]}]}]},{"tag":"a","props":{"className":"life-text-link","href":"/book/29"},"children":["阅读整个主题：遭遇重大打击之后 ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"15","height":"15","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]}]}]},{"tag":"nav","props":{"className":"life-tabbar","aria-label":"主导航"},"children":[{"tag":"a","props":{"className":"","href":"/book"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"21","height":"21","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-book-open","aria-hidden