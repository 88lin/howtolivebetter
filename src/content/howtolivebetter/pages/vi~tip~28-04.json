tp://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"Kế hoạch thực hiện"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"Lưu"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Chia sẻ mẹo này"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Ẩn chi tiết"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Chi phí"]},{"tag":"p","props":{},"children":["Không tốn tiền. Ngược lại còn tiết kiệm tiền mua các sản phẩm này. Khó ở chỗ phải chấp nhận rằng không có chuyện「tuần nào cũng giảm được vài cân」."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Lợi ích"]},{"tag":"p","props":{},"children":["Thử nghiệm SCOUT tuyển 9.804 người. Tất cả đều trên 55 tuổi, thừa cân hoặc béo phì, và mắc bệnh tim mạch hoặc tiểu đường typ 2. Họ được bốc thăm chia thành nhóm dùng thuốc và nhóm không dùng, trung bình điều trị 3.4 năm. Điểm cuối chính là mấy sự cố xấu đã định sẵn từ trước: nhồi máu cơ tim không tử vong, đột quỵ không tử vong, ngừng tim rồi được cứu lại, và tử vong tim mạch. Tần suất các sự cố này là 11.4% vs 10.0%. HR 1.16 (95% CI 1.03–1.31, P=0.02), tức người dùng thuốc có xác suất xảy ra cao hơn khoảng một phần sáu. Giá trị thật nằm trong khoảng cao hơn 3% đến cao hơn 31%. Nhồi máu cơ tim không tử vong 4.1% vs 3.2%, HR 1.28 (1.04–1.57), cao hơn khoảng ba phần mười. Đột quỵ không tử vong 2.6% vs 1.9%, HR 1.36 (1.04–1.77), cao hơn khoảng ba phần sáu. Tử vong tim mạch và tử vong mọi nguyên nhân không tăng; mọi nguyên nhân nghĩa là cộng tất cả các nguyên nhân lại. Sau khi bốc thăm, nhóm sibutramine trung bình giảm thêm 1.7 kg. Cục Quản lý Thực phẩm và Dược phẩm Trung Quốc cũ căn cứ đánh giá an toàn cho rằng「rủi ro của điều trị giảm cân lớn hơn lợi ích」, tháng 10 năm 2010 đã thông báo ngừng sản xuất, kinh doanh và sử dụng chế phẩm sibutramine cùng nguyên liệu. Sibutramine và phenolphthalein đều bị cấm thêm vào thực phẩm, kể cả thực phẩm chức năng"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Nguồn gốc"]},{"tag":"p","props":{"className":"life-citations"},"children":["James WPT et al. (2010). Effect of sibutramine on cardiovascular outcomes in overweight and obese subjects. NEJM. ",{"tag":"a","props":{"href":"https://doi.org/10.1056/NEJMoa1003114","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1056/NEJMoa1003114"]},"；天津市市场监督管理委员会. 警惕部分食品中违法添加「盐酸西布曲明」和「酚酞」. ",{"tag":"a","props":{"href":"https://scjg.tj.gov.cn/tjsscjdglwyh_52651/hdpt/cjwtyxfts/202007/t20200720_2972549.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://scjg.tj.gov.cn/tjsscjdglwyh_52651/hdpt/cjwtyxfts/202007/t20200720_2972549.html"]}]},{"tag":"a","props":{"href":"https://doi.org/10.1056/NEJMoa1003114","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Liên kết mở nguồn"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Ghi chú sách"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["SCOUT tuyển người vốn đã mắc bệnh tim hoặc tiểu đường, tức nhóm nguy cơ cao. Thử nghiệm này không chứng minh người trẻ khoẻ mạnh ăn vào cũng xảy ra đúng như thế. Nhưng chính vì không phân biệt được ai là người nguy cơ cao, cơ quan quản lý mới cho nó rút khỏi thị trường luôn. Thành phần hay bị lén thêm nữa là phenolphthalein, vốn là thuốc nhuận tràng, ăn lâu dài nhiều sẽ làm rối loạn điện chất trong cơ thể và gây rối loạn nhịp tim. Cách phân biệt: thuốc giảm cân đàng hoàng là thuốc kê đơn, số phép tra được ở nhà thuốc và bệnh viện. Sản phẩm bán dưới danh「cà phê」「kẹo」「mận」「thay bữa」mà hứa tuần giảm vài cân thì theo định nghĩa không được có tác dụng dược, mà có tác dụng tức là đã trộn thêm thứ gì đó. Nguyên văn 国食药监办〔2010〕432 号 nằm trên trang của Cục Quản lý dược phẩm quốc gia, máy này mở luôn báo lỗi 412 nên phải trích lại trang của cơ quan quản lý cấp tỉnh. Hai câu「rủi ro lớn hơn lợi ích」và「tháng 10 năm 2010 ngừng sản xuất, kinh doanh, sử dụng」có thể đối chiếu từng chữ ở đó."]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Ghi chú của tôi"]},{"tag":"button","props":{"type":"button"},"children":["Viết một lời nhắc cho chính bạn…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/vi/tip/28-03"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"