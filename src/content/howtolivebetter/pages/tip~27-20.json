ht":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"加入待做"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"收藏"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"分享这条建议"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"收起详情"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["成本"]},{"tag":"p","props":{"className":"life-citations"},"children":["避孕套一盒几十元。上环、皮下埋植要去医院，价格各地不一样。难在产后忙乱，顾不上这件事"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["收益"]},{"tag":"p","props":{"className":"life-citations"},"children":["英国国家医疗服务体系（NHS）说，生完孩子 3 周就可能再怀孕，在喂奶、月经没来的也一样。除非想马上再要，每次同房都要避孕。靠喂奶避孕叫哺乳期闭经避孕法，要同时满足三样：只喂母乳、月经没来、孩子不满 6 个月。照规矩做，能挡住 99% 以上。做不到那么严格的，6 个月内每 100 人约有 2 人怀上。出现下面任何一样，就要换别的办法：孩子过了 6 个月，开始加奶粉辅食或用安抚奶嘴，来了月经（少量出血也算），夜里不喂了，喂的次数变少。一篇汇总合并了 67 项研究，扣掉了母亲年龄和家境。以上一胎生下到下次怀上隔 18 到 23 个月为准。不到 6 个月的，早产 OR 1.40（95% CI 1.24–1.58，可信范围），高约四成。孩子出生体重低 1.61（1.39–1.86），孩子比同孕周偏小 1.26（1.18–1.33）。隔 6 到 17 个月、超过 59 个月的，这三样也都偏高。加拿大一项研究看了 14.8 万多次怀孕，拿隔 6 个月的和隔 18 个月的比。35 岁以上的母亲死亡或重病 0.62% 对 0.26%，aRR 2.39（2.03–2.80），约是 2.4 倍。20 到 34 岁的母亲没有差别（0.92，0.83–1.02）。20 到 34 岁的孩子死胎、夭折、极小或极早产合计 2.0% 对 1.4%，aRR 1.42（1.36–1.47）。世界卫生组织 2005 年的专家会议建议，生下孩子以后至少隔 24 个月再试着怀下一胎。与会专家一致同意的是，不到 18 个月就怀上要避开。流产或人工流产之后至少隔 6 个月"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["来源"]},{"tag":"p","props":{"className":"life-citations"},"children":["NHS. Sex and contraception after birth. ",{"tag":"a","props":{"href":"https://www.nhs.uk/baby/support-and-services/sex-and-contraception-after-birth/","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.nhs.uk/baby/support-and-services/sex-and-contraception-after-birth/"]},"；NHS. Natural family planning. ",{"tag":"a","props":{"href":"https://www.nhs.uk/contraception/methods-of-contraception/natural-family-planning/","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.nhs.uk/contraception/methods-of-contraception/natural-family-planning/"]},"；Conde-Agudelo A, Rosas-Bermúdez A, Kafury-Goeta AC (2006). Birth spacing and risk of adverse perinatal outcomes: a meta-analysis. JAMA, 295(15), 1809. ",{"tag":"a","props":{"href":"https://doi.org/10.1001/jama.295.15.1809","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1001/jama.295.15.1809"]},"；Schummers L, Hutcheon JA, Hernandez-Diaz S, et al. (2018). Association of Short Interpregnancy Interval With Pregnancy Outcomes According to Maternal Age. JAMA Internal Medicine, 178(12), 1661. ",{"tag":"a","props":{"href":"https://doi.org/10.1001/jamainternmed.2018.4696","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1001/jamainternmed.2018.4696"]},"；World Health Organization (2007). Report of a WHO Technical Consultation on Birth Spacing, Geneva, 13–15 June 2005（WHO/RHR/07.1）. ",{"tag":"a","props":{"href":"https://www.who.int/publications/i/item/WHO-RHR-07.1","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.who.int/publications/i/item/WHO-RHR-07.1"]},"；Ball SJ, Pereira G, Jacoby P, de Klerk N, Stanley FJ (2014). Re-evaluation of link between interpregnancy interval and adverse birth outcomes: retrospective cohort study matching two intervals per mother. BMJ, 349, g4333. ",{"tag":"a","props":{"href":"https://doi.org/10.1136/bmj.g4333","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1136/bmj.g4333"]},"（备注里的反方研究）"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["原书备注"]},{"tag":"p","props":{"className":"life-citations"},"children":["争议。隔多久才够，说法不一样。世界卫生组织的专家一派主张 18 个月，一派主张 27 个月，24 个月是两边妥协定的。NHS 说的是至少隔 12 个月。澳大利亚一项研究拿 40441 名母亲自己的两次间隔互相比，结论不一样。隔 0 到 5 个月的早产 OR 1.07（0.86–1.34），出生体重低 1.03（0.79–1.34），都看不出差别。换成不同母亲之间比，早产是 1.41。所以间隔短的风险，可能有一部分来自母亲本身的情况。避孕本身没有争议，争的只是隔多久。按 NHS 的说法，避孕套、皮下埋植生完马上就能用，喂奶的也一样。喂奶的人用复方避孕药，一般要等到产后至少 6 周。用哪种，在产后 42 天复查时和医生谈，见第 16 条（产后 42 天那次复查）。收益定「中」凭判断，理由在核实记录里。好处落在你自己和下一个孩子身上"]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["我的备注"]},{"tag":"button","props":{"type":"button"},"children":["写下对自己有用的提醒…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/tip/27-19"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["上一条"]},"怀孕 28 周以后入睡时侧着躺，左侧右侧都行，别仰面躺着睡"]}]},{"tag":"span","props":{},"children":[]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["本主题的其他建议"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/27-03"},"children":[{"tag":"strong","props":{},"children":["第一次产检就把艾滋病、梅毒、乙肝三项查掉，查出来艾滋病也有免费的阻断"]},{"tag":"span","props":{},"children":["第一次产检就把艾滋病、梅毒、乙肝这三样查掉。艾滋病的初筛不用自己掏钱。真查出来也不是绝路。查出艾滋病，国家免费给治疗和咨询。查出梅毒，尽早用青霉素治。查出乙肝，…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/27-04"},"children":[{"tag":"strong","props":{},"children":["整个孕期一支烟一口酒都不要，家里人也别在屋里抽"]},{"tag":"span","props":{},"children":["孕期抽烟，孩子早产、生下来太小、唇腭裂的概率都往上走，孕期和生产时异常出血的风险翻一倍。孕妇抽烟，或者孩子出生后吸到烟，婴儿猝死的风险都更高。什么时候戒都还来得…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/27-05"},"children":[{"tag":"strong","props":{},"children":["有子痫前期高危因素的，孕 12 周后开始每天一片小剂量阿司匹林"]},{"tag":"span","props":{},"children":["子痫前期是孕期的一种高血压病。上一胎得过、怀多胎、有慢性高血压、孕前有糖尿病、有肾病或自身免疫病的人算高危。高危的人从孕 12 周起每天一片小剂量阿司匹林，子痫…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/27-06"},"children":[{"tag":"strong","props":{},"children":["孕 24 周及以后做一次妊娠期糖尿病筛查，别嫌喝糖水麻烦"]},{"tag":"span","props":{},"children":["妊娠期糖尿病就是怀孕之后才出现的血糖高。孕 24 周以后花半个上午，喝一次糖水、抽几次血，就能查出来。不查也不管，胎儿长得过大、难产、挨一刀、子痫前期和新生儿低…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/27-07"},"children":[{"tag":"strong","props":{},"children":["背下这张「立刻去医院」的清单，孕期和产后一年内都算数"]},{"tag":"span","props":{},"children":["下面任何一条出现，当天就去医院，别在家等一晚，产后一年内也算。头痛不好或越来越重、看东西变样、发烧到 38 ℃、手或脸肿得厉害。喘不上气、胸痛或心跳快、肚子剧痛…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/27-08"},"children":[{"tag":"strong","props":{},"children":["破水了就地平躺、垫高臀部、打 120，不要走动也不要洗澡"]},{"tag":"span","props":{},"children":["破水了不是慢慢收拾东西再出发。正确做法是就地躺下、把屁股垫高、打 120。站着走动，羊水流得更快，脐带可能跟着被冲下来。那是能要孩子命的急症。"]}]}]}]},{"tag":"a","props":{"className":"life-text-link","href":"/book/27"},"children":["阅读整个主题：怀孕和生产：从发现怀孕到出院办证 ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"15","height":"15","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]}]}]},{"tag":"nav","props":{"className":"life-tabbar","aria-label":"主导航"},"children":[