svg","width":"18","height":"18","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-up-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M7 7h10v10"},"children":[]},{"tag":"path","props":{"d":"M7 17 17 7"},"children":[]}]}]}]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/es/book/33"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"Volver al índice"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["Cómo vivir después de una discapacidad"]},{"tag":"div","props":{"data-ad-dock-host":"true"},"children":[]},{"tag":"nav","props":{"aria-label":"Consejos del capítulo"},"children":[{"tag":"a","props":{"aria-current":"page","className":"active","href":"/es/tip/33-01","data-status":"active"},"children":[{"tag":"span","props":{},"children":["01"]},"Después de una lesión medular, si aparece un dolor de cabeza intenso y sudoración repentina, primero hay que ayudar a la persona a sentarse erguida, aflojarle la ropa y llamar al 120"]},{"tag":"a","props":{"href":"/es/tip/33-02"},"children":[{"tag":"span","props":{},"children":["02"]},"Los primeros diez años tras la discapacidad son el periodo de mayor riesgo de suicidio; no lo trate como algo que se resuelve «animándose»"]},{"tag":"a","props":{"href":"/es/tip/33-03"},"children":[{"tag":"span","props":{},"children":["03"]},"La hospitalización por trastorno mental se rige por el principio de voluntariedad; solo hay dos supuestos en los que se puede ingresar sin el consentimiento de la persona"]},{"tag":"a","props":{"href":"/es/tip/33-04"},"children":[{"tag":"span","props":{},"children":["04"]},"Quien cuida a largo plazo de la persona con discapacidad de la casa también necesita que alguien vigile su propio cuerpo"]},{"tag":"a","props":{"href":"/es/tip/33-05"},"children":[{"tag":"span","props":{},"children":["05"]},"Para quien pasa muchas horas en silla de ruedas: cambie el cojín por uno de descarga de presión y revise a diario la zona del isquion y el coxis"]},{"tag":"a","props":{"href":"/es/tip/33-06"},"children":[{"tag":"span","props":{},"children":["06"]},"No compre terapias ni aparatos que prometan «curar la parálisis, la ceguera o la sordera»"]},{"tag":"a","props":{"href":"/es/tip/33-07"},"children":[{"tag":"span","props":{},"children":["07"]},"Una vez obtenido el certificado de discapacidad, pregunte de una sola vez en la federación de personas con discapacidad del condado todo lo que se puede solicitar"]},{"tag":"a","props":{"href":"/es/tip/33-08"},"children":[{"tag":"span","props":{},"children":["08"]},"Si el niño tiene menos de 7 años y además una discapacidad o autismo, solicite en la federación de personas con discapacidad del condado la ayuda a la rehabilitación"]},{"tag":"a","props":{"href":"/es/tip/33-09"},"children":[{"tag":"span","props":{},"children":["09"]},"Las rampas, los pasamanos y la reforma del baño de la casa pueden optar a una subvención del gobierno de nivel de condado o superior"]},{"tag":"a","props":{"href":"/es/tip/33-10"},"children":[{"tag":"span","props":{},"children":["10"]},"Al buscar empleo en China, indique que tiene certificado de discapacidad: contratarle puede reducir un pago obligatorio de la empresa"]},{"tag":"a","props":{"href":"/es/tip/33-11"},"children":[{"tag":"span","props":{},"children":["11"]},"El impuesto sobre la renta de las personas físicas de una persona con discapacidad puede reducirse; cuánto, pregúntelo por teléfono a la administración tributaria provincial"]},{"tag":"a","props":{"href":"/es/tip/33-12"},"children":[{"tag":"span","props":{},"children":["12"]},"Los perros guía pueden entrar en lugares públicos y transporte público; las personas ciegas viajan gratis en el transporte urbano"]},{"tag":"a","props":{"href":"/es/tip/33-13"},"children":[{"tag":"span","props":{},"children":["13"]},"En la prueba nacional de acceso a la universidad, las personas con discapacidad pueden solicitar ajustes razonables; con examen en braille el tiempo se amplía la mitad"]},{"tag":"a","props":{"href":"/es/tip/33-14"},"children":[{"tag":"span","props":{},"children":["14"]},"Si un niño con discapacidad solicita la matrícula, la escuela no puede rechazarlo; si no puede llegar al centro, la oficina de educación organiza la enseñanza a domicilio"]},{"tag":"a","props":{"href":"/es/tip/33-15"},"children":[{"tag":"span","props":{},"children":["15"]},"Sin la pierna derecha o sin ambas piernas también se puede sacar el permiso de conducir: la clase de vehículo se llama C5"]},{"tag":"a","props":{"href":"/es/tip/33-16"},"children":[{"tag":"span","props":{},"children":["16"]},"La rehabilitación hágase en instituciones serias con servicio de medicina de rehabilitación, con la intensidad que indique el terapeuta: no es cuanto más fuerte mejor"]},{"tag":"a","props":{"href":"/es/tip/33-17"},"children":[{"tag":"span","props":{},"children":["17"]},"Ante la pérdida de audición, colóquese audífonos; la razón de ponerlos es oír, no prevenir la demencia"]},{"tag":"a","props":{"href":"/es/tip/33-18"},"children":[{"tag":"span","props":{},"children":["18"]},"Declarar que un adulto «no puede regirse por sí mismo» exige una solicitud al tribunal; la familia no decide sola"]},{"tag":"a","props":{"href":"/es/tip/33-19"},"children":[{"tag":"span","props":{},"children":["19"]},"El tutor de un adulto se designa por el orden legal; si la persona bajo tutela lesiona a alguien, responde el tutor"]},{"tag":"a","props":{"href":"/es/tip/33-20"},"children":[{"tag":"span","props":{},"children":["20"]},"Si le rechazan por discapacidad en la contratación, no le hacen fijo o le pagan menos, puede demandar, pero primero calcule bien el coste del proceso"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"Ruta de navegación"},"children":[{"tag":"a","props":{"href":"/es/book"},"children":["Libro"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/es/book/33"},"children":["Capítulo 33"," ·"," ","Cómo vivir después de una discapacidad"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"33-01"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["01"]},{"tag":"span","props":{"className":"life-evidence grade-b"},"children":["Evidencia"," ","B"]}]},{"tag":"h1","props":{"lang":"es"},"children":["Después de una lesión medular, si aparece un dolor de cabeza intenso y sudoración repentina, primero hay que ayudar a la persona a sentarse erguida, aflojarle la ropa y llamar al 120"]},{"tag":"p","props":{"lang":"es","className":"life-entry-summary"},"children":["En las personas con lesión medular, parte de la red de señales corporales queda dañada. Aunque la vejiga esté llena o la ropa apriete sin que la persona lo note, la presión arterial puede subir bruscamente. Los síntomas típicos son dolor de cabeza intenso y sudoración. En esos casos, lo más importante es sentar a la persona, aflojarle la ropa, comprobar si tiene la vejiga llena y llamar al 120."]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Coste"]},{"tag":"p","props":{},"children":["No cuesta nada. Solo se necesitan tres acciones que se pue…"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Beneficio"]},{"tag":"p","props":{},"children":["Este episodio se conoce como reflejo autonómico anormal. Una revisión sistemática analizó cuatro bases de dato…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"Marcar: Después de una lesión medular, si aparece un dolor de cabeza intenso y sudoración repentina, primero hay que ayudar a la persona a sentarse erguida, aflojarle la ropa y llamar al 120"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"Hecho"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"Por hacer"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"Guardar"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Compartir consejo"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Ocultar detalles"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Coste"]},{"tag":"p","props":{},"children":["No cuesta nada. Solo se necesitan tres acciones que se pueden realizar en unos pocos segundos."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Beneficio"]},{"tag":"p","props":{},"children":["Este episodio se conoce como reflejo autonómico anormal. Una revisión sistemática analizó cuatro bases de datos (Medline, CINAHL, EMBASE y PsycINFO) e incluyó 31 estudios, de los cuales 6 eran ensayos controlados aleatorizados. Según dicha revisión, el tratamiento no farmacológico inmediato consiste en tres pasos: colocar a la persona en posición vertical, aflojar la ropa ajustada y eliminar cualquier estímulo desencadenante. Estas medidas se basan en consenso clínico y datos fisiológicos, por lo que se clasifican como evidencia de nivel 5. Solo cuando la presión arterial sigue elevada se emplean fármacos antihipertensivos; entre ellos, la prazosina cuenta con evidencia de nivel 1, mientras que el nifedipino y la prostaglandina E2 tienen evidencia de nivel 2. Para prevenir estos episodios, las estrategias deben centrarse en los factores desencadenantes más habituales, como problemas urinarios o intervenciones quirúrgicas; sin embargo, la mayoría de estas medidas solo disponen de evidencia de nivel 4 o 5."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Fuentes originales"]},{"tag":"p","props":{"className":"life-citations"},"children":["Krassioukov A, Warburton DE, Teasell R, Eng JJ; Spinal Cord Injury Rehabilitation Evidence Research Team (2009). A systematic review of the management of autonomic dysreflexia after spinal cord injury. Archives of Physical Medicine and Rehabilitation, 90(4):682-695. ",{"tag":"a","props":{"href":"https://doi.org/10.1016/j.apmr.2008.10.017","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1016/j.apmr.2008.10.017"]}]},{"tag":"a","props":{"href":"https://doi.org/10.1016/j.apmr.2008.10.017","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Abrir fuente"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Nota del autor"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["Se asigna el nivel B porque, aunque existen consenso clínico y fundamentos fisiológicos, no se cuenta con ensayos controlados aleatorizados que respalden directamente esas tres acciones iniciales; la mayor parte de la evidencia disponible proviene de estudios no controlados. En cuanto al uso de fármacos, esa decisión corresponde exclusivamente a los médicos; en casa no se debe administrar ningún antihipertensivo. Colocar a la persona en posición horizontal podría elevar aún más su presión arterial, por lo que es imprescindible mantenerla sentada. Familiares y cuidadores deben conocer estos pasos. No se debe confundir este episodio con un simple dolor de cabeza."]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Mi nota"]},{"tag":"button","props":{"type":"button"},"children":["Escribe un recordatorio…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"span","props":{},"children"