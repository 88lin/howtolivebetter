href":"/tip/06-12","className":""},"children":[{"tag":"span","props":{},"children":["12"]},"不要为了「增强免疫力」逼自己洗冷水澡"]},{"tag":"a","props":{"href":"/tip/06-13","className":""},"children":[{"tag":"span","props":{},"children":["13"]},"不要买排毒、清肠、酵素、碱性水这类产品"]},{"tag":"a","props":{"href":"/tip/06-14","className":""},"children":[{"tag":"span","props":{},"children":["14"]},"不要为了凑够「每天 8 杯水」强迫自己喝水"]},{"tag":"a","props":{"href":"/tip/06-15","className":""},"children":[{"tag":"span","props":{},"children":["15"]},"不要花钱算命、看塔罗、看星座来做决定"]},{"tag":"a","props":{"href":"/tip/06-16","className":""},"children":[{"tag":"span","props":{},"children":["16"]},"不要买防蓝光眼镜来「保护视力」，也不要相信「对着屏幕干几个月眼睛就废了」，但眼睛胀痛发红要当急症"]},{"tag":"a","props":{"href":"/tip/06-17","className":""},"children":[{"tag":"span","props":{},"children":["17"]},"不要把献血当保健：「排毒、降血脂、防心梗」没有随机试验支持，频繁献倒是真会缺铁"]},{"tag":"a","props":{"href":"/tip/06-18","className":"active"},"children":[{"tag":"span","props":{},"children":["18"]},"不要靠通用体检套餐防病，按年龄性别做那几项有证据的筛查"]},{"tag":"a","props":{"href":"/tip/06-19","className":""},"children":[{"tag":"span","props":{},"children":["19"]},"不要因为体检查出尿酸高、但从没痛过，就开始吃降尿酸药"]},{"tag":"a","props":{"href":"/tip/06-20","className":""},"children":[{"tag":"span","props":{},"children":["20"]},"不要因为体检查出胆囊结石、但从没疼过，就去预防性切胆囊"]},{"tag":"a","props":{"href":"/tip/06-21","className":""},"children":[{"tag":"span","props":{},"children":["21"]},"不要为了防肾结石把钙戒掉"]},{"tag":"a","props":{"href":"/tip/06-22","className":""},"children":[{"tag":"span","props":{},"children":["22"]},"不要为了「转运」「招财」「养人」买水晶、手串、貔貅这类物件"]},{"tag":"a","props":{"href":"/tip/06-23","className":""},"children":[{"tag":"span","props":{},"children":["23"]},"不要指望买东西改善心情或身份感"]},{"tag":"a","props":{"href":"/tip/06-24","className":""},"children":[{"tag":"span","props":{},"children":["24"]},"不要为了「在周围人里往上挪一档」多花钱换房、换车、换圈子"]},{"tag":"a","props":{"href":"/tip/06-25","className":""},"children":[{"tag":"span","props":{},"children":["25"]},"不要相信「意志力像肌肉，用一会儿就没了」"]},{"tag":"a","props":{"href":"/tip/06-26","className":""},"children":[{"tag":"span","props":{},"children":["26"]},"不要指望吃早餐或 16:8 轻断食帮你控制体重，吃饭时间挑你能长期坚持的"]},{"tag":"a","props":{"href":"/tip/06-27","className":""},"children":[{"tag":"span","props":{},"children":["27"]},"不要相信「手淫伤身」「戒色才能变好」，真正要看的是有没有耽误睡觉、工作和关系"]},{"tag":"a","props":{"href":"/tip/06-28","className":""},"children":[{"tag":"span","props":{},"children":["28"]},"不要花钱做「性取向矫正」「同性恋治疗」，也不要把家里人送去"]},{"tag":"a","props":{"href":"/tip/06-29","className":""},"children":[{"tag":"span","props":{},"children":["29"]},"不要指望学会「正确搬运姿势」、上搬运培训就能防腰痛，要减的是搬的重量和次数，平时多锻炼"]},{"tag":"a","props":{"href":"/tip/06-30","className":""},"children":[{"tag":"span","props":{},"children":["30"]},"不要指望骨折之后猛补钙、喝骨头汤能让骨头长得更快"]},{"tag":"a","props":{"href":"/tip/06-31","className":""},"children":[{"tag":"span","props":{},"children":["31"]},"不要指望靠 AI 聊天机器人自己判断病情和法律问题，看病、打官司、花大钱之前，把它说的依据找到原文核一遍"]},{"tag":"a","props":{"href":"/tip/06-32","className":""},"children":[{"tag":"span","props":{},"children":["32"]},"不要因为「人随时会死，早点把钱花完才快乐」就不存钱，三十岁的人约九成能活到六十岁"]}]}]},{"tag":"div","props":{"className":"life-tip-page","data-tip-locales":"zh,en,ru,es,ja,vi"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"当前位置"},"children":[{"tag":"a","props":{"href":"/book"},"children":["阅读全书"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/book/06"},"children":["第 6 章 · 反面清单"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"06-18"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["18"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["证据 A"]}]},{"tag":"h1","props":{"lang":"zh"},"children":["不要靠通用体检套餐防病，按年龄性别做那几项有证据的筛查"]},{"tag":"p","props":{"lang":"zh","className":"life-entry-summary"},"children":["定期做通用健康检查的人，和不做的人死亡率一样，死于心血管病、癌症的也一样多。按年龄性别做那几项有证据的筛查就够了。35 岁以上每年能免费量一次血压