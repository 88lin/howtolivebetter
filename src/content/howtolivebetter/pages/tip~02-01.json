":""},"children":[{"tag":"span","props":{},"children":["12"]},"成年后定期查血脂，40 岁前每 2 到 5 年一次、40 岁起每年一次；有高血压、高血脂就按医嘱规律吃药，别自行停"]},{"tag":"a","props":{"href":"/tip/02-13","className":""},"children":[{"tag":"span","props":{},"children":["13"]},"每晚睡 7 小时左右，作息固定"]},{"tag":"a","props":{"href":"/tip/02-14","className":""},"children":[{"tag":"span","props":{},"children":["14"]},"常打网球、羽毛球、乒乓球这类球拍类运动"]},{"tag":"a","props":{"href":"/tip/02-15","className":""},"children":[{"tag":"span","props":{},"children":["15"]},"把爬楼梯、快走赶路这类零碎的用力活动攒到每天四五分钟"]},{"tag":"a","props":{"href":"/tip/02-16","className":""},"children":[{"tag":"span","props":{},"children":["16"]},"每周做 30–60 分钟力量训练"]},{"tag":"a","props":{"href":"/tip/02-17","className":""},"children":[{"tag":"span","props":{},"children":["17"]},"别连着坐太久，隔一阵起身动一动"]},{"tag":"a","props":{"href":"/tip/02-18","className":""},"children":[{"tag":"span","props":{},"children":["18"]},"少吃加工肉（火腿、培根、香肠、午餐肉）"]},{"tag":"a","props":{"href":"/tip/02-19","className":""},"children":[{"tag":"span","props":{},"children":["19"]},"少喝或不喝酒"]},{"tag":"a","props":{"href":"/tip/02-20","className":""},"children":[{"tag":"span","props":{},"children":["20"]},"每天都喝酒、一停就手抖心慌的人，别自己硬戒"]},{"tag":"a","props":{"href":"/tip/02-21","className":""},"children":[{"tag":"span","props":{},"children":["21"]},"想少喝酒，先把一周喝了多少数出来，再找医生聊几分钟"]},{"tag":"a","props":{"href":"/tip/02-22","className":""},"children":[{"tag":"span","props":{},"children":["22"]},"每天吃一小把坚果"]},{"tag":"a","props":{"href":"/tip/02-23","className":""},"children":[{"tag":"span","props":{},"children":["23"]},"把一部分红肉换成鱼和禽肉"]},{"tag":"a","props":{"href":"/tip/02-24","className":""},"children":[{"tag":"span","props":{},"children":["24"]},"把一部分精米白面换成全谷物"]},{"tag":"a","props":{"href":"/tip/02-25","className":""},"children":[{"tag":"span","props":{},"children":["25"]},"每周喝三次以上茶"]},{"tag":"a","props":{"href":"/tip/02-26","className":""},"children":[{"tag":"span","props":{},"children":["26"]},"每天喝三到四杯咖啡，咖啡因总量不超过 400 mg，不加糖不加奶盖"]},{"tag":"a","props":{"href":"/tip/02-27","className":""},"children":[{"tag":"span","props":{},"children":["27"]},"每天吃够 5 份（约 400 g）水果蔬菜"]},{"tag":"a","props":{"href":"/tip/02-28","className":""},"children":[{"tag":"span","props":{},"children":["28"]},"少吃超加工食品（薯片、方便面、糕点、速食）"]},{"tag":"a","props":{"href":"/tip/02-29","className":""},"children":[{"tag":"span","props":{},"children":["29"]},"做饭、取暖不烧煤和柴，换成电或燃气"]},{"tag":"a","props":{"href":"/tip/02-30","className":""},"children":[{"tag":"span","props":{},"children":["30"]},"热的东西放一放再喝，不喝滚烫的茶、汤和咖啡"]},{"tag":"a","props":{"href":"/tip/02-31","className":""},"children":[{"tag":"span","props":{},"children":["31"]},"白天出门晒晒太阳，别整天不见光"]},{"tag":"a","props":{"href":"/tip/02-32","className":""},"children":[{"tag":"span","props":{},"children":["32"]},"把 BMI 控制在 20–25，超重就减"]},{"tag":"a","props":{"href":"/tip/02-33","className":""},"children":[{"tag":"span","props":{},"children":["33"]},"每周吃四次以上辣椒"]},{"tag":"a","props":{"href":"/tip/02-34","className":""},"children":[{"tag":"span","props":{},"children":["34"]},"每天喝一两份奶或酸奶"]},{"tag":"a","props":{"href":"/tip/02-35","className":""},"children":[{"tag":"span","props":{},"children":["35"]},"鸡蛋不用戒，但别每天三四个"]},{"tag":"a","props":{"href":"/tip/02-36","className":""},"children":[{"tag":"span","props":{},"children":["36"]},"有条件就泡澡，别只冲淋浴"]},{"tag":"a","props":{"href":"/tip/02-37","className":""},"children":[{"tag":"span","props":{},"children":["37"]},"把午睡控制在半小时内，别超过一小时，非得睡一两小时才撑得住就去查原因"]},{"tag":"a","props":{"href":"/tip/02-38","className":""},"children":[{"tag":"span","props":{},"children":["38"]},"熬夜之后第二天晚上就补觉，别攒到周末"]},{"tag":"a","props":{"href":"/tip/02-39","className":""},"children":[{"tag":"span","props":{},"children":["39"]},"上夜班干得越久心血管风险越高，能转岗就趁早转"]},{"tag":"a","props":{"href":"/tip/02-40","className":""},"children":[{"tag":"span","props":{},"children":["40"]},"买预包装、有 SC 编号的食用油，不买小作坊散装自榨花生油"]},{"tag":"a","props":{"href":"/tip/02-41","className":""},"children":[{"tag":"span","props":{},"children":["41"]},"做饭用植物油代替猪油和黄油，不必为了健康换着买油，也别指望亚麻籽油护心"]},{"tag":"a","props":{"href":"/tip/02-42","className":""},"children":[{"tag":"span","props":{},"children":["42"]},"炒菜、煎炸时打开抽油烟机，从开火一直开到做完"]},{"tag":"a","props":{"href":"/tip/02-43","className":""},"children":[{"tag":"span","props":{},"children":["43"]},"绝经前后潮热盗汗影响到生活，就去妇科评估激素治疗，别硬扛也别自己买药，更别拿它防心脏病"]},{"tag":"a","props":{"href":"/tip/02-44","className":""},"children":[{"tag":"span","props":{},"children":["44"]},"本来就想养狗的，把每天遛狗算进走路量，别为了长寿专门去养狗"]},{"tag":"a","props":{"href":"/tip/02-45","className":""},"children":[{"tag":"span","props":{},"children":["45"]},"查出糖尿病前期（血糖偏高、还没到糖尿病），就靠少吃、减重、多动把糖尿病往后推，每半年复查一次血糖"]},{"tag":"a","props":{"href":"/tip/02-46","className":""},"children":[{"tag":"span","props":{},"children":["46"]},"家里的花生、玉米、坚果和米面发了霉，整包扔掉，别挑掉霉的吃剩下的；嚼到发苦的坚果马上吐掉"]},{"tag":"a","props":{"href":"/tip/02-47","className":""},"children":[{"tag":"span","props":{},"children":["47"]},"别吃淡水鱼虾做的鱼生、生鱼片、鱼生粥和醉虾，常吃过的去医院查一次肝吸虫，查出来按医嘱吃吡喹酮"]}]}]},{"tag":"div","props":{"className":"life-tip-page","data-tip-locales":"zh,en,ru,es,ja,vi"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"当前位置"},"children":[{"tag":"a","props":{"href":"/book"},"children":["阅读全书"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/book/02"},"children":["第 2 章 · 不要慢慢死"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"02-01"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["01"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["证据 A"]}]},{"tag":"h1","props":{"lang":"zh"},"children":["戒烟，越早越好"]},{"tag":"p","props":{"lang":"zh","className":"life-entry-summary"},"children":["吸烟的人平均比不吸烟的人少活十年以上。40 岁前戒掉，能把接着吸烟带来的死亡风险抹掉九成左右。戒得越早，捡回来的越多。骨折以后接着抽，骨头长不上的几率约是不抽的 2.3 倍，所以骨头没长好之前别抽。"]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["成本"]},{"tag":"p","props":{},"children":["不花钱，反过来还省钱。一天一包烟约 20–30 元，戒了这笔钱就留下了。难在戒断期要熬，一般是几周到几个月。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["收益"]},{"tag":"p","props":{},"children":["美国一项跟踪一群人的研究（只记录、不分组）发现：现在还吸烟的人，比从不吸烟的人预期寿命短 10 年以上。40 岁前戒掉，可以消除继续吸烟所带来死亡风险的约 90%。25–34 岁戒烟约多活 10 年，35–44 岁约多活 9 年，45–54 岁约多活 6 年（原文以寿命年报告）。中国的同类研究：20…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"标记：戒烟，越早越好"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"已做到"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"加入待做"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"收藏"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"分享这条建议"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"收起详情"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["成本"]},{"tag":"p","props":{"className":"life-citations"},"children":["不花钱，反过来还省钱。一天一包烟约 20–30 元，戒了这笔钱就留下了。难在戒断期要熬，一般是几周到几个月。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["收益"]},{"tag":"p","props":{"className":"life-citations"},"children":["美国一项跟踪一群人的研究（只记录、不分组）发现：现在还吸烟的人，比从不吸烟的人预期寿命短 10 年以上。40 岁前戒掉，可以消除继续吸烟所带来死亡风险的约 90%。25–34 岁戒烟约多活 10 年，35–44 岁约多活 9 年，45–54 岁约多活 6 年（原文以寿命年报告）。中国的同类研究：2010 年代，城市男性吸烟者的死亡风险是不吸烟者的 1.65 倍（RR 1.65），农村男性是 1.22 倍。主动戒烟满 10 年后，吸烟带来的这部分风险接近消失。骨折之后也一样。19 项只记录、不分组的研究合起来算，吸烟的人骨折不愈合（骨头长不上）的几率约是不吸烟者的 2.3 倍（OR 2.32，95% CI 1.76–3.06，已扣除其他因素）。小腿胫骨骨折和开放性骨折里同样偏高。瑞典一项随机试验里，骨折急诊手术后参加 6 周戒烟项目的 50 人，20% 出现至少一种术后并发症。没参加的 55 人是 38%。提前约好的手术，可以在术前 4 到 8 周开始戒烟，每周有人辅导，配尼古丁替代品。这样做术后并发症低约 58%（RR 0.42，95% CI 0.27–0.65，2 项试验、210 人）。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["来源"]},{"tag":"p","props":{"className":"life-citations"},"children":["Jha P 等 (2013). 21st-century hazards of smoking and benefits of cessation in the United States. NEJM. ",{"tag":"a","props":{"href":"https://doi.org/10.1056/NEJMsa1211128","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1056/NEJMsa1211128"]},"；Chen Z 等 (2015). Contrasting male and female trends in tobacco-attributed mortality in China: evidence from successive nationwide prospective cohort studies. Lancet. ",{"tag":"a","props":{"href":"https://doi.org/10.1016/S0140-6736(15)00340-2","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1016/S0140-6736(15)00340-2"]},"；Oberg M 等 (2011). Worldwide burden of disease from exposure to second-hand smoke: a retrospective analysis of data from 192 countries. Lancet. ",{"tag":"a","props":{"href":"https://doi.org/10.1016/S0140-6736(10)61388-8","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1016/S0140-6736(10)61388-8"]},"（二手烟那两个数字）；Scolaro JA 等 (2014). Cigarette smoking increases complications following fracture: a systematic review. J Bone Joint Surg Am. ",{"tag":"a","props":{"href":"https://doi.org/10.2106/JBJS.M.00081","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.2106/JBJS.M.00081"]},"；Nåsell H 等 (2010). Effect of smoking cessation intervention on results of acute fracture surgery: a randomized controlled trial. J Bone Joint Surg Am. ",{"tag":"a","props":{"href":"https://doi.org/10.2106/JBJS.I.00627","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.2106/JBJS.I.00627"]},"；Thomsen T 等 (2014). Interventions for preoperative smoking cessation. Cochrane Database Syst Rev. ",{"tag":"a","props":{"href":"https://doi.org/10.1002/14651858.CD002294.pub4","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1002/14651858.CD002294.pub4"]},"（骨折和手术那几个数字）"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["原书备注"]},{"tag":"p","props":{"className":"life-citations"},"children":["吸别人的烟同样会死人：2004 年全球约有 60.3 万人死于二手烟，占当年全球总死亡的约 1%。自己不吸，也要躲开别人的烟，尤其别让孩子吸到。怎么戒，具体办法在后面四条：第 3 条（戒烟药）、第 4 条（定一个戒烟日）、第 5 条（去戒烟门诊）、第 6 条（电子烟）。骨不愈合那个数字来自只记录、不分组的研究，吸烟的人在别的方面也可能和不吸烟的人不同，没法全部扣干净。骨折后那项戒烟试验只有 105 人，换一种算法差别就不显著。"]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["我的备注"]},{"tag":"button","props":{"type":"button"},"children":["写下对自己有用的提醒…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"span","props":{},"children":[]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/tip/02-02"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["下一条"]},"别在家里和车里抽烟，也别让客人在家里抽"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["本主题的其他建议"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/02-03"},"children":[{"tag":"strong","props":{},"children":["戒烟别光靠忍，先去拿药：成功率能翻一倍多"]},{"tag":"span","props":{},"children":["光靠忍，多数人戒不掉。吃伐尼克兰的人戒成的比例，是吃安慰剂的两倍多。用尼古丁贴片、咀嚼胶这类替代品的，比不用药的高五成左右。贴片和咀嚼胶一起用，还能再高两成多。"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/02-04"},"children":[{"tag":"strong","props":{},"children":["定一个戒烟日，到那天一次停掉，别先慢慢减"]},{"tag":"span","props":{},"children":["很多人打算先每天少抽几根，慢慢减到零。可到了第六个月，定好日子一次停掉的人里 22% 没再抽，慢慢减的只有 15.5%。所以定一个日子，到那天一次停掉。"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/02-05"},"children":[{"tag":"strong","props":{},"children":["去戒烟门诊，或者打 12320 问当地有没有戒烟服务"]},{"tag":"span","props":{},"children":["药和「有人定期问你」是两件事，合起来最管用。一边吃药一边有专人跟进的人，戒成的比例接近只听一句简短建议的人的两倍。电话也算：主动打回来的戒烟热线，能把成功率再提…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/02-06"},"children":[{"tag":"strong","props":{},"children":["已经戒不掉再考虑电子烟，本来不吸烟的人别碰"]},{"tag":"span","props":{},"children":["把烟换成含尼古丁的电子烟，戒成的人比用尼古丁贴片多约六成，这个结论很可靠。但它不是无害的，长期吸的安全数据还没有。本来不吸烟的人吸它没有任何好处。"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/02-07"},"children":[{"tag":"strong","props":{},"children":["不喝含糖饮料，换成无糖的也不算解决"]},{"tag":"span","props":{},"children":["每天喝两瓶以上甜饮料的人，同期死亡的概率比几乎不喝的人高约两成。每天一到两瓶的，也高一成多。换成无糖的也没见着好处：每天喝两杯以上代糖饮料的人，反而高约四分之一…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/02-08"},"children":[{"tag":"strong","props":{},"children":["不嚼槟榔"]},{"tag":"span","props":{},"children":["嚼槟榔的人，同期死亡的概率比不嚼的人高约两成。糖尿病和代谢综合征的风险高近五成。口腔癌和食管癌的风险还要另算。"]}]}]}]},{"tag":"a","props":{"className":"life-text-link","href":"/book/02"},"children":["阅读整个主题：不要慢慢死 ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"15","height":"15","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]}]}]}]},{"tag":"aside","props":{"className":"life-ad-space life-ad-space-sponsored","data-ad-placement":"ad_footer","data-ad-group":"reading","data-ad-creative":"read_product","data-ad-ready":"false","aria-label":"广告 · 社区推荐"},"children":[{"tag":"div","props":{"className":"life-ad-space-brand"},"children":[{"tag":"img","props":{"src":"/sites/howtolivebetter/images/shengcai/logo.png","width":"565","height":"144","alt":"生财有术官方 Logo","decoding":"async"},"children":[]}]},{"tag":"div","props":{"className":"life-ad-space-copy"},"children":[{"tag":"span","props":{"className":"life-ad-space-label"},"children":["广告 · 社区推荐"]},{"tag":"strong","props":{},"children":["读过的知识，能不能做成有用的产品？"]},{"tag":"p","props":{},"children":["从电子书、资料到小工具，看看圈友怎样发现需求，把内容变成实际交付。"]}]},{"tag":"div","props":{"className":"life-ad-space-actions"},"children":[{"tag":"a","props":{"className":"life-ad-space-link","href":"/shengcaiyoushu?sc_group=reading&sc_creative=read_product&sc_placement=ad_footer"},"children":["看看社区与案例",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"18","height":"18","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-up-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M7 7h10v10"},"children":[]},{"tag":"path","props":{"d":"M7 17 17 7"},"children":[]}]}]},{"tag":"a","props":{"className":"life-ad-space-rent"