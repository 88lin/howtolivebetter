:"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"已做到"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"加入待做"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"收藏"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"分享这条建议"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"收起详情"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["成本"]},{"tag":"p","props":{"className":"life-citations"},"children":["不花钱。顺序是固定的，一步一步来。第一步，跨省住院之前，用「国家医保局」微信公众号里的「国家异地就医备案」小程序备案。第二步，出院时直接结算。第三步，报销之后自己要掏的还是太重，就向乡镇政府或者街道办申请医疗救助。第四步，还在上班的按医疗期请病假，医疗期就是生病停工又不能被辞退的那段时间；属于工伤的走工伤保险。第五步，信用卡还不上，主动找银行协商分期。第六步，实在不够，再上民政部指定的个人求助平台筹款。材料主要是诊断证明、费用清单、结算单，跑 2 到 4 趟。难在人在病中，还要一趟趟跑手续。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["收益"]},{"tag":"p","props":{"className":"life-citations"},"children":["国家把基本医保、大病保险、医疗救助合起来叫「三重制度」，一层一层往下兜。低保对象和特困人员，符合规定的医疗费用按不低于 70% 救助。本来不穷、看病看穷了的重病患者，可以自己提出申请再救助。跨省住院前备了案，就能出院直接结算，不必先垫全款再回参保地报。生病停工有 3 到 24 个月的医疗期，具体多久按工龄长短定。这段时间里，公司不得解除劳动合同，病假工资不得低于当地最低工资的 80%。工伤职工有停工留薪期，就是养伤不上班的那段时间，原来的工资福利照发，由单位按月发，一般不超过 12 个月。信用卡欠款超出还款能力、本人又愿意还的，可以和银行协商个性化分期，把欠款重新排一个还款计划，最长 5 年。签了协议，银行就必须停止催收。网上替本人筹钱的个人求助平台，必须经国务院民政部门指定。平台要核验求助信息是不是真的。捐来的钱只能打给求助人本人，或者他提供的账户（全国）"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["来源"]},{"tag":"p","props":{"className":"life-citations"},"children":["国务院办公厅 (2021). 关于健全重特大疾病医疗保险和救助制度的意见（国办发〔2021〕42 号）. ",{"tag":"a","props":{"href":"https://www.gov.cn/gongbao/content/2021/content_5659514.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/gongbao/content/2021/content_5659514.htm"]},"；国家医保局 (2025). 跨省异地就医如何直接报销？. ",{"tag":"a","props":{"href":"https://www.nhsa.gov.cn/art/2025/3/16/art_14_16010.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.nhsa.gov.cn/art/2025/3/16/art_14_16010.html"]},"；劳动部 (1994). 企业职工患病或非因工负伤医疗期规定（劳部发〔1994〕479 号，第二、三条）. ",{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/2022-08/31/content_5711269.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/zhengce/2022-08/31/content_5711269.htm"]},"；劳动部 (1995). 关于贯彻执行《劳动法》若干问题的意见（劳部发〔1995〕309 号，第 59 条）. ",{"tag":"a","props":{"href":"http://hrss.jl.gov.cn/ldgx/ldyggl/201608/t20160824_2401358.html","target":"_blank","rel":"noopener noreferrer"},"children":["http://hrss.jl.gov.cn/ldgx/ldyggl/201608/t20160824_2401358.html"]},"（吉林省人社厅转载）；国务院 (2010 修订). 工伤保险条例（国务院令第 586 号，第三十、三十三条）. ",{"tag":"a","props":{"href":"https://www.gov.cn/gongbao/content/2011/content_1778064.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/gongbao/content/2011/content_1778064.htm"]},"；银监会 (2011). 商业银行信用卡业务监督管理办法（银监会令 2011 年第 2 号，第七十条）. ",{"tag":"a","props":{"href":"https://www.gov.cn/gongbao/content/2011/content_1893974.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/gongbao/content/2011/content_1893974.htm"]},"；全国人大常委会 (2023). 关于修改慈善法的决定（第一百二十四条）. ",{"tag":"a","props":{"href":"https://www.gov.cn/yaowen/liebiao/202312/content_6923390.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/yaowen/liebiao/202312/content_6923390.htm"]},"；民政部等五部门 (2024). 个人求助网络服务平台管理办法（令第 75 号，第三、十一、十三、十七条）. ",{"tag":"a","props":{"href":"https://www.gov.cn/gongbao/2024/issue_11646/202410/content_6980857.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/gongbao/2024/issue_11646/202410/content_6980857.html"]},""]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["原书备注"]},{"tag":"p","props":{"className":"life-citations"},"children":["医疗救助报多大比例、一年最多报多少，由你参保的那个地方自己定。医疗期分六档，看你一共工作了几年、在这家单位干了几年。医疗期一过，公司就可能合法跟你解约，提前看清自己在哪一档。急诊抢救的人也在需要备案的名单里。医保局的页面没说急诊算不算自动备案、事后能不能补办，打电话问参保地。网贷和民间高息借款不要碰。法院只保护到一年期 LPR 的 4 倍这条线（不借高利贷见第 15 条）。超出那条线的部分不受保护，本金还是照还。躺在病床上也没精力去打这种官司。急重伤病是另一回事：没钱也要打 120，医院不得拒绝、推诿或者拖延救治。那一段的急救费由疾病应急救助基金付，见第 24 节第 8 条（急诊也必须先救）。劳部发〔1995〕309 号的原文页在人社部官网打不开，内容取自省人社厅的转载。信用卡还不上怎么和银行谈分期，见第 23 条（信用卡、网贷已经还不上）。"]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["我的备注"]},{"tag":"button","props":{"type":"button"},"children":["写下对自己有用的提醒…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/tip/07-09"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["上一条"]},"居民医保每年 400 元不要断，困难户可减免"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/tip/07-11"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["下一条"]},"身份证丢了立刻补办，急用先领临时身份证"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["本主题的其他建议"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/07-06"},"children":[{"tag":"strong","props":{},"children":["突发变故先申请临时救助"]},{"tag":"span","props":{},"children":["家里突然出事，比如火灾、车祸、家人突发重病，把基本生活一时压垮了，可以向出事地的乡镇政府或者街道办申请临时救助，不要求你是低保户。这类急难一般 3 天内办完，最…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/07-07"},"children":[{"tag":"strong","props":{},"children":["收入低于当地低保线就申请低保，比低保线略高或者看病上学花得多的申请医疗、教育、住房、就业救助"]},{"tag":"span","props":{},"children":["全家人均收入低于当地低保线、财产也符合规定的，就可以申请。2024 年末，全国城市低保线平均每人每月 798.1 元，农村 593.9 元。钱按差额补，也可分档…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/07-08"},"children":[{"tag":"strong","props":{},"children":["持残疾人证的去申请残疾人两项补贴"]},{"tag":"span","props":{},"children":["低保家庭里的残疾人，可以领生活补贴。残疾等级是一级、二级，又需要长期照护的，可以领护理补贴，两项能同时领。标准各省自己定，差别很大，具体问街道。带上第二代残疾人…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/07-12"},"children":[{"tag":"strong","props":{},"children":["办失业登记后争取就业困难人员认定，拿社保补贴或公益性岗位"]},{"tag":"span","props":{},"children":["认定下来之后，自己交社保能拿补贴，原则上不超过你实际交的三分之二，最长 3 年。被单位招用、或者安排到公益性岗位的，单位那部分社保也有补贴。公益性岗位的补贴参照…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/07-13"},"children":[{"tag":"strong","props":{},"children":["失业期间去领职业培训补贴、就业见习补贴和社保补贴，别自费上培训班"]},{"tag":"span","props":{},"children":["参加培训并拿到规定的证书，就有职业培训补贴，同一个人最多领 3 次。毕业两年内没找到工作的高校毕业生、16 到 24 岁的失业青年，可以参加就业见习，见习期间领…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/07-14"},"children":[{"tag":"strong","props":{},"children":["求职别只投简历，用系统方法：学技巧、定目标、找人帮"]},{"tag":"span","props":{},"children":["参加过求职辅导的人，找到工作的几率是没参加的人的 2.67 倍。管用的是这几样：学具体的求职技巧，把自己讲清楚，定明确目标，主动出击，开口找人帮忙。"]}]}]}]},{"tag":"a","props":{"className":"life-text-link","href":"/book/07"},"children":["阅读整个主题：没钱的时候怎么活 ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"15","height":"15","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]}]}]},{"tag":"nav","props":{"className":"life-tabbar","aria-label":"主导航"},"children":[{"tag":"a","props":{"className":"","href":"/book"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"21","height":"21","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-book-open","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M12 7v14"},"children":[]},{"tag":"path","props":{"d":"M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z"},"children":[]}]},{"tag":"span","props":{},"children":["全书"]}]},{"tag":"a","props":{"className":"","href":"/top-50"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"21","height":"21","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"ro