ide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Chia sẻ mẹo này"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Ẩn chi tiết"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Chi phí"]},{"tag":"p","props":{},"children":["Không tốn tiền. Chỉ là tự hỏi thêm một câu lúc căng thẳng: họ thật sự nhìn thấy sao."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Lợi ích"]},{"tag":"p","props":{},"children":["Thí nghiệm một: cho người tham dự mặc T-shirt in hình Barry Manilow, bước vào phòng có người tham dự khác. Người mặc ước trung bình 46% người chứng kiến chỉ đúng người in trên áo. Người chứng kiến đúng thực tế là 23%, ước lượng gấp đôi thực tế. Tính từng lượt, ước lượng trừ thực tế, trung bình cao hơn 23 điểm phần trăm (95% CI 9–38, khoảng tin cậy). Loại hai lượt chỉ có hai và ba người chứng kiến ra thì là 27 điểm phần trăm (11–43). Thí nghiệm hai: đổi sang mặc T-shirt do người tham dự tự chọn, tự thấy tích cực. Ước trung bình 48%, người chứng kiến đúng thực tế 8%, gấp sáu lần. Một loạt nghiên cứu khác có ba bối cảnh: người lạ ghép cặp trò chuyện, bạn cùng phòng năm nhất, hội trưởng thành cho người lớn. Kết quả là người ta đánh giá thấp mức đối phương thích mình, và cũng đánh giá thấp mức đối phương enjoyed cuộc trò chuyện. Tác giả gọi đó là「khoảng cách thích」. Nó có trong các cuộc trò chuyện dài ngắn khác nhau, và tồn tại hàng tháng giữa bạn cùng phòng năm nhất."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Nguồn gốc"]},{"tag":"p","props":{"className":"life-citations"},"children":["Gilovich T, Medvec VH, Savitsky K (2000). The spotlight effect in social judgment: An egocentric bias in estimates of the salience of one's own actions and appearance. Journal of Personality and Social Psychology, 78(2), 211–222. ",{"tag":"a","props":{"href":"https://doi.org/10.1037/0022-3514.78.2.211","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1037/0022-3514.78.2.211"]},"；Boothby EJ, Cooney G, Sandstrom GM, Clark MS (2018). The Liking Gap in Conversations: Do People Like Us More Than We Think? Psychological Science, 29(11), 1742–1756. ",{"tag":"a","props":{"href":"https://doi.org/10.1177/0956797618783714","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1177/0956797618783714"]}]},{"tag":"a","props":{"href":"https://doi.org/10.1037/0022-3514.78.2.211","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Liên kết mở nguồn"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Ghi chú sách"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["Lý do chấm B: đều là nghiên cứu thí nghiệm trong phòng lab và nghiên cứu ở trường, bối cảnh là mặc quần áo và nói chuyện với người lạ. Chuyển sang「bị đồng nghiệp bàn tán」「nói sai trên họp」thì không có bằng chứng trực tiếp. Những con số này chỉ cho hướng ước cao và độ lớn đại khái, không dùng làm hệ số được. Ý kiến người khác cũng không phải thứ gì cũng quan trọng. Chỗ thật sự đang đánh giá bạn, như phỏng vấn, bảo vệ luận văn, đánh giá, báo cáo khám sức khỏe, thì đánh giá là thật, đã thế thì chuẩn bị. Cái cần giảm chỉ là cảm giác「mọi người đều đang nhìn mình」trong đời thường, chỗ đó thứ phải đối phó là chính thiên lệch ước lượng của bạn."]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Ghi chú của tôi"]},{"tag":"button","props":{"type":"button"},"children":["Viết một lời nhắc cho chính bạn…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/vi/tip/03-20"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Trước"]},"Đừng coi việc「xem người khác sống thế nào」là phần bắt buộc phải đọc mỗi ngày: giới hạn hoặc tắt luôn các app lướt bảng tin của người cùng tuổi"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/vi/tip/03-22"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Tiếp theo"]},"Xem câu「người khác đòi tôi hoàn hảo」là triệu chứng, không phải sự thật"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["Thêm trong chủ đề này"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/03-17"},"children":[{"tag":"strong","props":{},"children":["Khi giận thì đi khỏi chỗ đó trước, coi đối phương như thời tiết chứ không như kẻ thù"]},{"tag":"span","props":{},"children":["Nhìn chuyện vừa xảy ra theo góc khác, hoặc đứng từ góc đối phương mà …"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/03-18"},"children":[{"tag":"strong","props":{},"children":["Khi tâm trạng tụt, làm trước mấy việc hiệu quả chi phí nhất: vận động, phơi nắng, ngủ đúng giờ, nói với ai đó, gọi 12356"]},{"tag":"span","props":{},"children":["Với bệnh trầm cảm, đi bộ nhanh và chạy bộ hiệu quả nhất, càng mạnh cà…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/03-19"},"children":[{"tag":"strong","props":{},"children":["Xem cảnh sát, bác sĩ và nhân viên giao dịch là người đi làm theo quy định, đừng xem là một vai diễn: thứ đẩy việc tới đích là giấy tờ và thời hạn, không phải cảm xúc"]},{"tag":"span","props":{},"children":["Cảnh sát, bác sĩ và nhân viên giao dịch đều là người đi làm theo quy …"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/03-23"},"children":[{"tag":"strong","props":{},"children":["Khi giận đừng trút bằng cách đập đồ, đấm bao cát, chạy một vòng; hãy làm cơ thể chậm lại trước"]},{"tag":"span","props":{},"children":["Đấm bao cát, ném đồ, đi chạy một vòng, những cách trút giận làm cơ th…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/03-24"},"children":[{"tag":"strong","props":{},"children":["Có một chuyện đè nặng trong lòng, có thể viết suốt mấy ngày liền tư tưởng và cảm xúc của mình ra, nhưng đừng trông chờ nó chữa bệnh"]},{"tag":"span","props":{},"children":["Viết những chuyện đè nặng lòng ra thì trung bình có ít lợi ích, nhưng…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/03-25"},"children":[{"tag":"strong","props":{},"children":["Đau bụng kinh thì dùng thuốc giảm đau như ibuprofen, đừng cố chịu; đau đến mức ảnh hưởng đi làm, đi học hoặc dùng thuốc ba tháng vẫn không kiểm soát được thì đi khám phụ khoa"]},{"tag":"span","props":{},"children":["Dùng thuốc như ibuprofen khi đau bụng kinh làm tỷ lệ người giảm đau r…"]}]}]}]},{"tag":"a","props":{"className":"life-text-link","href":"/vi/book/03"},"children":["Đọc toàn bộ chủ đề: Đừng phí sức"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"15","height":"15","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"childr