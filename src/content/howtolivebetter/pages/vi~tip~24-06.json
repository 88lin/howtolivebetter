e-circle-user-round","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M18 20a6 6 0 0 0-12 0"},"children":[]},{"tag":"circle","props":{"cx":"12","cy":"10","r":"4"},"children":[]},{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},{"tag":"span","props":{},"children":["Đăng nhập để đồng bộ hóa"]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/vi/book/24"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"Quay lại mục lục"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["Khám bệnh: tốn ít tiền hơn và đi lại ít hơn"]},{"tag":"nav","props":{"aria-label":"Các mục trong chương"},"children":[{"tag":"a","props":{"href":"/vi/tip/24-01"},"children":[{"tag":"span","props":{},"children":["01"]},"Bệnh thông thường thì khám ở cộng đồng trước, đi theo chuyển tuyến từ tuyến cơ sở lên trên, mức đồng chi trả nằm viện tính nối tiếp"]},{"tag":"a","props":{"href":"/vi/tip/24-02"},"children":[{"tag":"span","props":{},"children":["02"]},"Trong cùng một vùng gộp quỹ (nơi tham gia bảo hiểm y tế), cấp bệnh viện càng thấp thì tỷ lệ hoàn càng cao, chênh nhau khoảng 10 điểm phần trăm"]},{"tag":"a","props":{"href":"/vi/tip/24-03"},"children":[{"tag":"span","props":{},"children":["03"]},"Muốn đi bệnh viện lớn, đi theo chuyển tuyến từ tuyến cơ sở hoặc trung tâm chuyển tuyến của bệnh viện, đừng tìm kẻ bán số khám"]},{"tag":"a","props":{"href":"/vi/tip/24-04"},"children":[{"tag":"span","props":{},"children":["04"]},"Trước khi đi khám chữa bệnh ở tỉnh khác, hỏi một câu ở nơi bạn đang sống, tính cần thiết về nguyên tắc phải có bác sĩ phó trưởng khoa đánh giá"]},{"tag":"a","props":{"href":"/vi/tip/24-05"},"children":[{"tag":"span","props":{},"children":["05"]},"Mỗi lần khám xong, tự giữ lại một bộ hồ sơ bệnh án, kết quả xét nghiệm và ảnh"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/vi/tip/24-06","data-status":"active"},"children":[{"tag":"span","props":{},"children":["06"]},"Có nghi ngờ về chẩn đoán và điều trị thì yêu cầu niêm phong hồ sơ bệnh án ngay tại chỗ, hai bên cùng có mặt, lập danh mục, mỗi bên giữ một bản"]},{"tag":"a","props":{"href":"/vi/tip/24-07"},"children":[{"tag":"span","props":{},"children":["07"]},"Chấn thương nặng thì đi thẳng bàn tiền phân loại của khoa cấp cứu, đừng xếp hàng ở cửa sổ lấy số khám"]},{"tag":"a","props":{"href":"/vi/tip/24-08"},"children":[{"tag":"span","props":{},"children":["08"]},"Không có tiền, không có giấy tờ, không nói rõ mình là ai, cấp cứu vẫn phải cứu trước"]},{"tag":"a","props":{"href":"/vi/tip/24-09"},"children":[{"tag":"span","props":{},"children":["09"]},"Giám định thương tật phải đợi điều trị kết thúc rồi hãy làm, làm sớm thì cấp độ bị chấp thấp"]},{"tag":"a","props":{"href":"/vi/tip/24-10"},"children":[{"tag":"span","props":{},"children":["10"]},"Sau khi chữa xong mà thật sự còn tổn thương chức năng, đi tới hội liên hiệp người khuyết tật cấp huyện nơi có hộ khẩu để xin giấy chứng nhận người khuyết tật"]},{"tag":"a","props":{"href":"/vi/tip/24-11"},"children":[{"tag":"span","props":{},"children":["11"]},"Cảm ơn bác sĩ đã cứu bạn: dùng thư cảm ơn, băng đỏ tặng ơn và đánh giá mức độ hài lòng, đừng dùng phong bao; quy tắc cấm là tài sản, không phải lòng biết ơn"]},{"tag":"a","props":{"href":"/vi/tip/24-12"},"children":[{"tag":"span","props":{},"children":["12"]},"Trước khi cấy răng hỏi rõ giá trọn gói gồm gì, ưu tiên cơ sở cam kết tham gia quản lý giá, đừng tin quảng cáo giá rẻ"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"Breadcrumbs"},"children":[{"tag":"a","props":{"href":"/vi/book"},"children":["Khám phá cuốn sách"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/vi/book/24"},"children":["Chương 24"," ·"," ","Khám bệnh: tốn ít tiền hơn và đi lại ít hơn"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"24-06"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["06"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["Bằng chứng"," ","A"]}]},{"tag":"h1","props":{"lang":"vi"},"children":["Có nghi ngờ về chẩn đoán và điều trị thì yêu cầu niêm phong hồ sơ bệnh án ngay tại chỗ, hai bên cùng có mặt, lập danh mục, mỗi bên giữ một bản"]},{"tag":"p","props":{"lang":"vi","className":"life-entry-summary"},"children":["Có nghi ngờ về cách điều trị thì có thể yêu cầu niêm phong hồ sơ bệnh án. Khi niêm phong, bệnh nhân và cơ sở y tế phải cùng có mặt, lập danh mục, ký và đóng dấu, mỗi bên giữ một bản. Hồ sơ chưa viết xong thì niêm phong trước phần đã viết xong. Nghi ngờ do truyền dịch, truyền máu, tiêm, dùng thuốc thì túi dịch, ống thuốc và bộ truyền dịch cũng phải niêm phong cùng."]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Chi phí"]},{"tag":"p","props":{},"children":["Không tốn tiền. Nêu yêu cầu niêm phong với bệnh viện, rồi…"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Lợi ích"]},{"tag":"p","props":{},"children":["Quy chế quy định「发生医疗纠纷需要封存、启封病历资料的，应当在医患双方在场的情况下进行」— xảy ra tranh chấp y tế mà cần niêm phong, mở niêm phong…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"Đánh dấu: Có nghi ngờ về chẩn đoán và điều trị thì yêu cầu niêm phong hồ sơ bệnh án ngay tại chỗ, hai bên cùng có mặt, lập danh mục, mỗi bên giữ một bản"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"Hoàn tất"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"Kế hoạch thực hiện"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"Lưu"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Chia sẻ mẹo này"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Ẩn chi tiết"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Chi phí"]},{"tag":"p","props":{},"children":["Không tốn tiền. Nêu yêu cầu niêm phong với bệnh viện, rồi chờ cả hai bên đến làm thủ tục. Chỗ khó là nói được câu đó trước mặt bác sĩ."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Lợi ích"]},{"tag":"p","props":{},"children":["Quy chế quy định「发生医疗纠纷需要封存、启封病历资料的，应当在医患双方在场的情况下进行」— xảy ra tranh chấp y tế mà cần niêm phong, mở niêm phong hồ sơ bệnh án thì phải tiến hành khi cả bệnh nhân và cơ sở y tế đều có mặt. Phần được niêm phong có thể là bản gốc, cũng có thể là bản sao, do cơ sở y tế giữ. Hồ sơ chưa hoàn thành mà cần niêm phong thì niêm phong trước phần đã hoàn thành, phần làm sau thì niêm phong tiếp. Cơ sở y tế phải lập danh mục hồ sơ đã niêm phong, bệnh nhân và cơ sở y tế ký hoặc đóng dấu, mỗi bên giữ một bản. Nghi ngờ truyền dịch, truyền máu, tiêm, dùng thuốc gây hậu quả xấu thì hai bên phải cùng niêm phong, mở niêm phong vật thể tại hiện trường. Cần xét nghiệm thì hai bên phải cùng giao cho một cơ sở có đủ điều kiện xét nghiệm. Không giao được thì cơ quan quản lý y tế của chính quyền cấp huyện nơi cơ sở y tế đặt trụ sở chỉ định. Nghi ngờ truyền máu gây hậu quả xấu mà cần niêm phong máu thì cơ sở y tế phải báo trạm máu cử người đến. Còn một ràng buộc cứng:「任何单位和个人不得篡改、伪造、隐匿、毁灭或者抢夺病历资料。」— không đơn vị cá nhân nào được sửa, làm giả, giấu, huỷ diệt hay cướp hồ sơ bệnh án. Sau khi niêm phong mà tranh chấp đã giải quyết, hoặc đã đủ 3 năm mà không ai yêu cầu giải quyết nữa, cơ sở y tế có thể tự mở niêm phong (toàn quốc, áp dụng từ ngày 1 tháng 10 năm 2018)"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Nguồn gốc"]},{"tag":"p","props":{"className":"life-citations"},"children":["国务院 (2018). 医疗纠纷预防和处理条例（国务院令第 701 号，第十五、二十四、二十五条）. ",{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/2018-08/31/content_5318057.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/zhengce/zhengceku/2018-08/31/content_5318057.htm"]}]},{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/2018-08/31/content_5318057.htm","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Liên kết mở nguồn"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Ghi chú sách"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["Niêm phong và sao chép là hai việc khác nhau. Sao chép là việc nên làm khi bình thường, xem mục 5 ở phần này (tự giữ hồ sơ bệnh án và ảnh). Niêm phong là khi xảy ra tranh chấp thì ghim bằng chứng lại, chống việc sau đó bổ sung viết hoặc sửa. Nghi ngờ do truyền dịch, truyền máu, dùng thuốc thì ngoài hồ sơ bệnh án còn phải niêm phong cả túi dịch, ống thuốc và bộ truyền dịch, đừng để người ta dọn đi mà vứt bỏ. Cơ sở y tế phải công bố ở vị trí dễ thấy các đường giải quyết tranh chấp y tế, thủ tục và cách liên hệ, và lập một bộ phận tiếp nhận khiếu nại thống nhất. Có khiếu nại thì tìm bộ phận đó, đừng đi lý lẽ với bác sĩ trực."]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Ghi chú của tôi"]},{"tag":"button","props":{"type":"button"},"children":["Viết một lời nhắc cho chính bạn…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/vi/tip/24-05"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arro