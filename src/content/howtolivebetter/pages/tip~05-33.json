keLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"分享这条建议"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"收起详情"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["成本"]},{"tag":"p","props":{},"children":["不花钱。只是别把「以后能升值」算进你买它的理由里。难的是忍住不为「保值」加预算。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["收益"]},{"tag":"p","props":{},"children":["先看买入这一头。《消费税税目税率表》定的税率是这样的。「高档手表」20%。「贵重首饰及珠宝玉石」里，金银首饰、铂金首饰、钻石及钻石饰品 5%。其他贵重首饰和珠宝玉石 10%。「高档手表」的口径是「销售价格（不含增值税）每只在 10000 元（含）以上的各类手表」。再看变现这一头，依据是《典当管理办法》。第三十六条：典当期限最长不得超过 6 个月。第三十七条讲的是当金利率，指典当行借给你那笔钱的利息。这个利息按中国人民银行公布的 6 个月期法定贷款利率和典当期限折算。利息不得预扣，不能从给你的钱里先扣走。第三十八条：动产质押典当（押手表玉石这类东西）的月综合费率，不得超过当金的 42‰，每月另收的综合费用不超过借款额的 4.2%。房地产抵押是 27‰，财产权利质押是 24‰。第四十条：期限到了以后 5 日内既不赎当也不续当，就算绝当，东西不再等你来赎。第四十三条：估价金额 3 万元以上的绝当物，可以委托拍卖。拍卖收入要先扣掉拍卖费用和当金本息。剩下的退还给当户，不够的部分还要向当户追索（全国）"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["原始出处"]},{"tag":"p","props":{"className":"life-citations"},"children":["国务院 (2008). 中华人民共和国消费税暂行条例（国务院令第 539 号，附《消费税税目税率表》）. ",{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/2008-11/14/content_1795.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/zhengce/zhengceku/2008-11/14/content_1795.htm"]},"；财政部、国家税务总局 (2006). 关于调整和完善消费税政策的通知（财税〔2006〕33 号）. ",{"tag":"a","props":{"href":"http://www.mof.gov.cn/zhengwuxinxi/zhengcefabu/2006zcfb/200805/t20080524_34758.htm","target":"_blank","rel":"noopener noreferrer"},"children":["http://www.mof.gov.cn/zhengwuxinxi/zhengcefabu/2006zcfb/200805/t20080524_34758.htm"]},"；商务部、公安部 (2005). 典当管理办法（2005 年第 8 号令，第三十六、三十七、三十八、四十、四十三条）. ",{"tag":"a","props":{"href":"https://www.gov.cn/gongbao/content/2005/content_93074.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/gongbao/content/2005/content_93074.htm"]}]},{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/2008-11/14/content_1795.htm","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["打开来源链接"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["原书备注"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["押给典当行要算清楚：每月的综合费用上限是借款额的 42‰，一年就是借款额的五成左右，借款的利息还要另算。这个「一年五成」是拿月费率直接乘 12 算的粗账，用来看个量级，不是精确的一年利率。税率和费率都是明文写着的数字。但「这类东西长期能不能升值」没有可以引用的官方统计，本书不做预测，也不点评任何品类。要拦的只是把消费当投资的那部分理由：喜欢、戴着高兴，按消费买没问题；以「保值」「以后能卖更高」为理由把预算加上去，才是亏钱的地方。黄金也分两头：按克重买卖的投资性金条，和按件卖的首饰不是一回事。首饰的价钱里含设计费和工费，回收的时候通常不算这部分。二手平台上的挂牌价不是成交价，别当行情看。"]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["我的备注"]},{"tag":"button","props":{"type":"button"},"children":["写下对自己有用的提醒…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/tip/05-32"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["上一条"]},"买大件前先查国家抽检通报、3C 认证和能效标识"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/tip/05-34"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["下一条"]},"珠宝玉石只认带 CMA 标志的检测报告，并到发证部门官网核一下这家机构"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"childre