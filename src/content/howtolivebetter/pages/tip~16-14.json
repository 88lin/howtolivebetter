{"path":"/tip/16-14","title":"结肠癌做完手术和化疗的，参加有人指导的运动方案，坚持练满三年 | HowToLiveBetter","description":"结肠癌做完手术和化疗以后，参加三年有人指导的运动方案的人，复发、长新癌或死亡的可能低约 28%，死亡低约 37%。8 年后还活着的，练的人约九成，只拿宣传材料的约八成三。练的人肌肉、关节受伤的多一些。","lang":"zh","styles":["/sites/howtolivebetter/styles/bca54bebe9c1bd3b.css"],"bodyClass":"font-sans antialiased","nodes":[{"tag":"div","props":{"className":"life-site"},"children":[{"tag":"div","props":{"className":"life-header-slot","aria-hidden":"true"},"children":[]},{"tag":"header","props":{"className":"life-header"},"children":[{"tag":"div","props":{"className":"life-header-inner"},"children":[{"tag":"a","props":{"className":"life-brand","aria-label":"H ✳ HowToLiveBetter 首页","href":"/"},"children":[{"tag":"span","props":{"className":"life-brand-mark","aria-hidden":"true"},"children":["H",{"tag":"span","props":{},"children":["✳"]}]},{"tag":"span","props":{},"children":["HowToLive",{"tag":"span","props":{},"children":["Better"]}]}]},{"tag":"nav","props":{"className":"life-nav","aria-label":"主导航"},"children":[{"tag":"a","props":{"className":"life-nav-link","href":"/book"},"children":[{"tag":"span","props":{},"children":["阅读全书"]}]},{"tag":"a","props":{"className":"life-nav-link","href":"/top-50"},"children":[{"tag":"span","props":{},"children":["精选 50 条"]}]},{"tag":"a","props":{"className":"life-nav-link","href":"/daily"},"children":[{"tag":"span","props":{},"children":["每日任务"]}]},{"tag":"a","props":{"className":"life-nav-link","href":"/dashboard"},"children":[{"tag":"span","props":{},"children":["我的清单"]}]},{"tag":"button","props":{"type":"button","className":"life-nav-link life-nav-more","aria-haspopup":"menu","aria-expanded":"false"},"children":[{"tag":"span","props":{},"children":["更多"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"15","height":"15","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down","aria-hidden":"true"},"children":