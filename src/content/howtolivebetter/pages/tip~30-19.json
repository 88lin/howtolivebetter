:"span","props":{},"children":["登录同步"]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/book/30"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"返回目录"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["上学以后的孩子"]},{"tag":"nav","props":{"aria-label":"章节条目"},"children":[{"tag":"a","props":{"href":"/tip/30-01","className":""},"children":[{"tag":"span","props":{},"children":["01"]},"孩子说突然剧痛、而且越来越重，立刻去医院，不要让他忍到放学"]},{"tag":"a","props":{"href":"/tip/30-02","className":""},"children":[{"tag":"span","props":{},"children":["02"]},"该做的治疗别为了「等考完」往后拖，有些窗口跟着骨龄走，不跟着考试安排走"]},{"tag":"a","props":{"href":"/tip/30-03","className":""},"children":[{"tag":"span","props":{},"children":["03"]},"孩子被欺凌，当天就报到学校并要求书面处理，涉及打人、抢钱、传谣的直接报警"]},{"tag":"a","props":{"href":"/tip/30-04","className":""},"children":[{"tag":"span","props":{},"children":["04"]},"让孩子每天在户外待够 2 小时，这是目前不花钱、不用药的办法里，唯一有随机试验支持的防近视办法"]},{"tag":"a","props":{"href":"/tip/30-05","className":""},"children":[{"tag":"span","props":{},"children":["05"]},"0 到 3 岁不给屏幕，3 到 6 岁尽量不给，中小学生非学习用途每天不超过 1 小时"]},{"tag":"a","props":{"href":"/tip/30-06","className":""},"children":[{"tag":"span","props":{},"children":["06"]},"把近视当成会留下的损伤：度数越深，将来视网膜脱离、黄斑病变、青光眼越多"]},{"tag":"a","props":{"href":"/tip/30-07","className":""},"children":[{"tag":"span","props":{},"children":["07"]},"每年那次学生体检的报告单要自己看一遍，异常项当年带去医院查"]},{"tag":"a","props":{"href":"/tip/30-08","className":""},"children":[{"tag":"span","props":{},"children":["08"]},"12 到 18 岁的孩子做一次抑郁筛查，别拿学校的心理测评当诊断"]},{"tag":"a","props":{"href":"/tip/30-09","className":""},"children":[{"tag":"span","props":{},"children":["09"]},"不买号称能「治愈近视」「降低度数」的产品和服务"]},{"tag":"a","props":{"href":"/tip/30-10","className":""},"children":[{"tag":"span","props":{},"children":["10"]},"睡眠、作业、体育和排名都有明文规定，学校做不到可以提"]},{"tag":"a","props":{"href":"/tip/30-11","className":""},"children":[{"tag":"span","props":{},"children":["11"]},"孩子撑不住了可以休学，学籍学校必须给他留着，最长 1 年"]},{"tag":"a","props":{"href":"/tip/30-12","className":""},"children":[{"tag":"span","props":{},"children":["12"]},"查出视力不良，去医院做散瞳验光，之后按医生给的间隔复查"]},{"tag":"a","props":{"href":"/tip/30-13","className":""},"children":[{"tag":"span","props":{},"children":["13"]},"恒磨牙长出来以后做窝沟封闭"]},{"tag":"a","props":{"href":"/tip/30-14","className":""},"children":[{"tag":"span","props":{},"children":["14"]},"孩子爱打游戏，先看睡觉、作业和出门活动有没有被挤掉，别光盯着玩了多久"]},{"tag":"a","props":{"href":"/tip/30-15","className":""},"children":[{"tag":"span","props":{},"children":["15"]},"孩子说自己喜欢同性，别骂、别赶出家门、别送去「矫正」：家里的态度和他会不会自杀有关"]},{"tag":"a","props":{"href":"/tip/30-16","className":""},"children":[{"tag":"span","props":{},"children":["16"]},"管孩子别动手打，也别吼骂、骂他笨：常挨打挨骂的孩子，行为和情绪问题都更多"]},{"tag":"a","props":{"href":"/tip/30-17","className":""},"children":[{"tag":"span","props":{},"children":["17"]},"孩子难管、自己总忍不住打骂，去上一期教具体做法的家长课"]},{"tag":"a","props":{"href":"/tip/30-18","className":""},"children":[{"tag":"span","props":{},"children":["18"]},"别把孩子送进封闭管理的「戒网瘾学校」「特训营」：法律禁止用伤害身心的办法戒网瘾，已经有孩子被关死"]},{"tag":"a","props":{"href":"/tip/30-19","className":"active"},"children":[{"tag":"span","props":{},"children":["19"]},"教孩子认识身体的隐私部位，被人碰了、被要求保密都要回家说；孩子说了先信、别骂，带去报警和就医"]},{"tag":"a","props":{"href":"/tip/30-20","className":""},"children":[{"tag":"span","props":{},"children":["20"]},"别让不满 12 周岁的孩子骑自行车上路、不满 16 周岁的骑电动自行车上路：撞了人父母赔，自己被撞也可能要担一部分"]},{"tag":"a","props":{"href":"/tip/30-21","className":""},"children":[{"tag":"span","props":{},"children":["21"]},"孩子运动时撞了头、之后头痛头晕或者发懵，当天别再上场；吐了又吐、越来越困、头痛越来越重，立刻去急诊"]}]}]},{"tag":"div","props":{"className":"life-tip-page","data-tip-locales":"zh"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"当前位置"},"children":[{"tag":"a","props":{"href":"/book"},"children":["阅读全书"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/book/30"},"children":["第 30 章 · 上学以后的孩子"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"30-19"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["19"]},{"tag":"span","props":{"className":"life-evidence grade-b"},"children":["证据 B"]}]},{"tag":"h1","props":{"lang":"zh"},"children":["教孩子认识身体的隐私部位，被人碰了、被要求保密都要回家说；孩子说了先信、别骂，带去报警和就医"]},{"tag":"p","props":{"lang":"zh","className":"life-entry-summary"},"children":["上过防性侵课的孩子，在假扮陌生人引诱的演练里，做出保护自己动作的明显多了。学到的东西半年后还在，孩子也没变得更害怕。能不能真的少受侵害，还没测出来。性侵孩子的人里熟人占比较高，所以要教他哪里别人不能碰，碰了、被要求保密，都回家说。"]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["成本"]},{"tag":"p","props":{},"children":["不花钱。平时洗澡、换衣服时顺口教几句，隔一阵再问问。难在家长自己说身体部位不好意思开口，也难在孩子真说出来时，压住火不骂他。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["收益"]},{"tag":"p","props":{},"children":["Cochrane 2015 年汇总了 24 项学校防性侵课的试验，共 5802 名 5 到 18 岁的学生。这些课大多教几样东西：安全规则，身体归自己，哪些是隐私部位。还教孩子分清哪种触碰不行、哪种秘密不能守，以及该告诉谁。很多课还强调，出了事不是孩子的错。先看孩子会不会保护自己。研究者找人假扮陌生…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"标记：教孩子认识身体的隐私部位，被人碰了、被要求保密都要回家说；孩子说了先信、别骂，带去报警和就医"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"已做到"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"加入待做"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"收藏"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"分享这条建议"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"收起详情"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["成本"]},{"tag":"p","props":{"className":"life-citations"},"children":["不花钱。平时洗澡、换衣服时顺口教几句，隔一阵再问问。难在家长自己说身体部位不好意思开口，也难在孩子真说出来时，压住火不骂他。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["收益"]},{"tag":"p","props":{"className":"life-citations"},"children":["Cochrane 2015 年汇总了 24 项学校防性侵课的试验，共 5802 名 5 到 18 岁的学生。这些课大多教几样东西：安全规则，身体归自己，哪些是隐私部位。还教孩子分清哪种触碰不行、哪种秘密不能守，以及该告诉谁。很多课还强调，出了事不是孩子的错。先看孩子会不会保护自己。研究者找人假扮陌生人去引诱孩子，2 项试验 102 人。上过课的做出保护动作的 OR 5.71（95% CI 1.98–16.51，可信范围），机会约为没上课的 5.7 倍。按原文换算，没上课的每 1000 人约 390 人做到，上过课的约 795 人。再看知识。18 项试验 4657 人，问卷得分 SMD 0.61（0.45–0.78），0.5 算中等。半年后仍是 0.69（0.51–0.87）。3 项研究 795 人看了害处，孩子的焦虑、害怕没有增减（SMD −0.08，−0.22 到 0.07）。3 项研究 1788 人看了孩子会不会说出来。说出自己被性侵过的 OR 3.56（1.13–11.24），每 1000 人从约 4 人变成约 14 人。但同班同校的孩子彼此相像，校正这一点之后，差别就看不出来了（OR 3.04，0.75–12.33）。所有结果的证据质量都是中等。作者写明，这些课能不能真的减少性侵，还要长期跟踪才知道。联合国教科文组织等六个联合国机构 2018 年出了性教育指南。它建议 5 到 8 岁就教孩子身体各部位的名称，包括生殖器官。还要教孩子知道身体哪些部位是隐私的。有人碰他、让他不舒服时，要说「不」、走开，再告诉信任的大人。指南写明，性侵永远不是受害孩子的错。熟人、信任的人甚至家里人做的，也一样。人民日报的防性侵手册给了一个好记的说法：背心、短裤遮住的地方，不许别人看、不许别人摸。《未成年人保护法》第十六条要求父母对孩子做安全教育，提高他自我保护的意识和能力。第四十条要求学校、幼儿园开展适合孩子年龄的性教育。学校、幼儿园发现性侵害、性骚扰，不得隐瞒，要及时报告公安和教育部门。最高检等九部门 2020 年建立了强制报告制度。要报的人包括学校、幼儿园、医院、托育机构、居委会、村委会、宾馆等单位的人。他们在工作中发现孩子受到或疑似受到侵害，要立即向公安报案。要报的情形包括：生殖器官或隐私部位疑似有不正常的伤，不满 14 岁的女孩疑似被性侵、怀孕、流产。报案人的信息要保密。因为报告引起纠纷的，报告人不承担法律责任。2025 年，检察机关起诉强奸、猥亵儿童等性侵害未成年人犯罪 42873 人，比上年少 5.5%。这占起诉的侵害未成年人犯罪的 58.9%。这一年起诉的侵害未成年人案件里，3852 件的线索来自强制报告，占 7.1%。最高法等 16 部门 2025 年的意见说，这类案子熟人作案占比较高。有的年幼孩子缺少防范意识，监护人又疏于关注，孩子被性侵了自己都不知道（全国 / 多国）"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["来源"]},{"tag":"p","props":{"className":"life-citations"},"children":["Walsh K, Zwi K, Woolfenden S, Shlonsky A. (2015). School-based education programmes for the prevention of child sexual abuse. Cochrane Database of Systematic Reviews, (4), CD004380. ",{"tag":"a","props":{"href":"https://doi.org/10.1002/14651858.CD004380.pub3","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1002/14651858.CD004380.pub3"]},"；UNESCO, UNAIDS, UNFPA, UNICEF, UN Women, WHO (2018). International technical guidance on sexuality education: an evidence-informed approach (revised edition). ",{"tag":"a","props":{"href":"https://www.unfpa.org/sites/default/files/pub-pdf/ITGSE.pdf","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.unfpa.org/sites/default/files/pub-pdf/ITGSE.pdf"]},"；贵州省民政厅 (2024). 未成年人防性侵手册，请家长孩子查收！（转载人民日报）. ",{"tag":"a","props":{"href":"https://mzt.guizhou.gov.cn/xwzx/mzyw/202407/t20240723_85145012.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://mzt.guizhou.gov.cn/xwzx/mzyw/202407/t20240723_85145012.html"]},"；全国人大常委会 (2024 年修正). 未成年人保护法（第十一、十六、四十条）. ",{"tag":"a","props":{"href":"https://flk.npc.gov.cn/detail?id=ff8081818f197cf001905e567af635a0","target":"_blank","rel":"noopener noreferrer"},"children":["https://flk.npc.gov.cn/detail?id=ff8081818f197cf001905e567af635a0"]},"；最高人民检察院等九部门 (2020). 关于建立侵害未成年人案件强制报告制度的意见（试行）（第二、三、四、十三、十五条）. ",{"tag":"a","props":{"href":"https://www.spp.gov.cn/xwfbh/wsfbt/202005/t20200529_463482.shtml","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.spp.gov.cn/xwfbh/wsfbt/202005/t20200529_463482.shtml"]},"；最高人民检察院 (2026). 未成年人检察工作白皮书（2025）. ",{"tag":"a","props":{"href":"https://www.spp.gov.cn/xwfbh/wsfbt/202606/t20260601_728630.shtml","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.spp.gov.cn/xwfbh/wsfbt/202606/t20260601_728630.shtml"]},"；贵州省民政厅 (2025). 最高法、最高检、民政部等16部门联合印发《关于依法从严惩处和防范性侵害未成年人违法犯罪的意见》（转载人民法院报）. ",{"tag":"a","props":{"href":"https://mzt.guizhou.gov.cn/xwzx/mzyw/202508/t20250807_88423354.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://mzt.guizhou.gov.cn/xwzx/mzyw/202508/t20250807_88423354.html"]},""]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["原书备注"]},{"tag":"p","props":{"className":"life-citations"},"children":["给 B 是因为数字都来自学校里上的课，量的是知识和演练里的动作，不是真的少受了多少侵害。家长在家教，没有单独的试验。收益定小，是因为只有这些替代指标，没有侵害真的少了几成的数字。教法照上面那几样来：用身体部位本来的名字，告诉他哪里是隐私部位。再告诉他，谁让他保密、不许告诉爸妈的，都要回家说，说了不会挨骂。孩子说了，先当真，别追问是不是编的，也别骂他。法律要求老师、医生「疑似」就报警，家长更不用等到确定。告诉他不是他的错，然后打 110。验伤前别给他洗澡、换洗衣服，见第 13 节第 42 条（被性侵之后）。对方是谁都一样，亲戚、老师也报警。对方不满 14 岁的法律后果，见第 9 节第 18 条（对方不满 14 岁）。朋友家的孩子跟你说了，告诉他父母，一起报警。陌生孩子的事，打 110 交给警察，别自己去找对方算账。法律写明任何人都有权向公安检举。受益人是孩子。"]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["我的备注"]},{"tag":"button","props":{"type":"button"},"children":["写下对自己有用的提醒…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/tip/30-18"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["上一条"]},"别把孩子送进封闭管理的「戒网瘾学校」「特训营」：法律禁止用伤害身心的办法戒网瘾，已经有孩子被关死"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/tip/30-20"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["下一条"]},"别让不满 12 周岁的孩子骑自行车上路、不满 16 周岁的骑电动自行车上路：撞了人父母赔，自己被撞也可能要担一部分"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["本主题的其他建议"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/30-03"},"children":[{"tag":"strong","props":{},"children":["孩子被欺凌，当天就报到学校并要求书面处理，涉及打人、抢钱、传谣的直接报警"]},{"tag":"span","props":{},"children":["被同伴欺凌的孩子，冒出自杀念头的可能约是没被欺凌的 2.2 倍，有过自杀行为的约 2.6 倍。学校接到报告要立即调查，认定是欺凌就要惩戒或处分，严重的不许瞒，必…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/30-04"},"children":[{"tag":"strong","props":{},"children":["让孩子每天在户外待够 2 小时，这是目前不花钱、不用药的办法里，唯一有随机试验支持的防近视办法"]},{"tag":"span","props":{},"children":["小学一年级每天多上 40 分钟户外课，三年后新近视的孩子从约四成降到约三成。卫健委给的量是每天白天在户外不少于 2 小时，或者一周加起来 14 小时。阴天也算数…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/30-05"},"children":[{"tag":"strong","props":{},"children":["0 到 3 岁不给屏幕，3 到 6 岁尽量不给，中小学生非学习用途每天不超过 1 小时"]},{"tag":"span","props":{},"children":["国家卫健委要求 0 到 3 岁不给屏幕，3 到 6 岁尽量别碰。中小学生不为学习用的，一次不超过 15 分钟、一天不超过 1 小时。理由是长时间近距离用眼会让近…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/30-06"},"children":[{"tag":"strong","props":{},"children":["把近视当成会留下的损伤：度数越深，将来视网膜脱离、黄斑病变、青光眼越多"]},{"tag":"span","props":{},"children":["近视不会自己好，度数也降不回去。它也不只是「戴个眼镜」的事。和不近视的人比，得近视性黄斑病变的可能，轻度近视高十几倍，600 度以上高几百倍。视网膜脱离，轻度高…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/30-07"},"children":[{"tag":"strong","props":{},"children":["每年那次学生体检的报告单要自己看一遍，异常项当年带去医院查"]},{"tag":"span","props":{},"children":["中小学校每年组织一次学生体检。报告单上要重点看的是超重、肥胖、营养不良、脊柱弯曲异常、视力不良、龋齿。别只看一眼身高体重就收起单子。这几项有异常，当年就带孩子去…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/30-08"},"children":[{"tag":"strong","props":{},"children":["12 到 18 岁的孩子做一次抑郁筛查，别拿学校的心理测评当诊断"]},{"tag":"span","props":{},"children":["美国的预防指南建议给 12 到 18 岁的孩子筛查重度抑郁，11 岁及以下证据不够。在美国，自杀是 10 到 19 岁孩子的第二位死因。学校每年的心理测评只是普…"]}]}]}]},{"tag":"a","props":{"className":"life-text-link","href":"/book/30"},"children":["阅读整个主题：上学以后的孩子 ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"15","height":"15","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]}]}]},{"tag":"nav","props":{"className":"life-tabbar","aria-label":"主导航"},"children":[{"tag":"a","props":{"className":"","href":"/book"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"21","height":"21","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucid