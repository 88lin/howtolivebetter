"},"children":[]},{"tag":"path","props":{"d":"m6.34 17.66-1.41 1.41"},"children":[]},{"tag":"path","props":{"d":"m19.07 4.93-1.41 1.41"},"children":[]}]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"17","height":"17","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-moon life-theme-icon-dark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"},"children":[]}]}]},{"tag":"button","props":{"type":"button","className":"life-language-switch","aria-label":"Русский Выбрать язык","aria-haspopup":"menu","aria-expanded":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-globe","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]},{"tag":"path","props":{"d":"M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"},"children":[]},{"tag":"path","props":{"d":"M2 12h20"},"children":[]}]},{"tag":"span","props":{},"children":["Русский"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]}]},{"tag":"a","props":{"className":"life-account","href":"/ru/sign-in"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"17","height":"17","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle-user-round","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M18 20a6 6 0 0 0-12 0"},"children":[]},{"tag":"circle","props":{"cx":"12","cy":"10","r":"4"},"children":[]},{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},{"tag":"span","props":{},"children":["Войти"]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/ru/book/19"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"К содержанию"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["Заработная плата, увольнение и производственные травмы"]},{"tag":"nav","props":{"aria-label":"Советы главы"},"children":[{"tag":"a","props":{"href":"/ru/tip/19-01"},"children":[{"tag":"span","props":{},"children":["01"]},"Оплата сверхурочной работы рассчитывается по трём ставкам: 1,5-кратной, 2-кратной и 3-кратной. Если компания отказывается платить, можно подать жалобу в трудовую инспекцию; при невыплате в установленный срок ей придётся доплатить ещё от 50% до 100% от суммы долга"]},{"tag":"a","props":{"href":"/ru/tip/19-02"},"children":[{"tag":"span","props":{},"children":["02"]},"Ежегодный оплачиваемый отпуск рассчитывается по суммарному стажу: 5, 10 или 15 дней; за неиспользованные дни выплачивается компенсация в размере 300% от дневной зарплаты"]},{"tag":"a","props":{"href":"/ru/tip/19-03"},"children":[{"tag":"span","props":{},"children":["03"]},"Законодательно установлены предельные сроки испытательного периода, его оплата не может быть ниже 80% от обычной зарплаты, а назначать его можно лишь один раз"]},{"tag":"a","props":{"href":"/ru/tip/19-04"},"children":[{"tag":"span","props":{},"children":["04"]},"Как рассчитать N: за каждый отработанный год — один месячный оклад, за период менее полугода — полмесяца"]},{"tag":"a","props":{"href":"/ru/tip/19-05"},"children":[{"tag":"span","props":{},"children":["05"]},"Компания увольняет вас без предварительного уведомления за 30 дней и обязана выплатить дополнительную зарплату за месяц"]},{"tag":"a","props":{"href":"/ru/tip/19-06"},"children":[{"tag":"span","props":{},"children":["06"]},"Незаконное расторжение трудового договора работодателем: компенсация равна двукратному размеру экономической выплаты"]},{"tag":"a","props":{"href":"/ru/tip/19-07"},"children":[{"tag":"span","props":{},"children":["07"]},"Не стоит подписывать заявление об увольнении по собственному желанию — после этого вы теряете все полагающиеся выплаты"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/ru/tip/19-08","data-status":"active"},"children":[{"tag":"span","props":{},"children":["08"]},"Сохраните справки о зарплате, учёт рабочего времени, трудовой договор, эти соцстраха и переписку до увольнения"]},{"tag":"a","props":{"href":"/ru/tip/19-09"},"children":[{"tag":"span","props":{},"children":["09"]},"Прежде чем приступать к работе в условиях пыли, шума и химических веществ, проверьте, указаны ли в договоре сведения об опасностях; три медосмотра по охране труда должна организовать и оплатить компания"]},{"tag":"a","props":{"href":"/ru/tip/19-10"},"children":[{"tag":"span","props":{},"children":["10"]},"Повреждения, вызванные пылью, шумом и химическими токсинами, необратимы: работодатель обязан предоставлять средства защиты, а от работы без них можно отказаться"]},{"tag":"a","props":{"href":"/ru/tip/19-11"},"children":[{"tag":"span","props":{},"children":["11"]},"При получении травмы на работе или в ДТП по пути на работу/с работы первым делом нужно оформить признание случая производственной травмой; если работодатель этого не делает, это должны сделать вы сами"]},{"tag":"a","props":{"href":"/ru/tip/19-12"},"children":[{"tag":"span","props":{},"children":["12"]},"Не верьте утверждению, будто «если дойти до рабочего места — это считается производственной травмой»: при внезапном недомогании сначала звоните 120, а не спешите на работу"]},{"tag":"a","props":{"href":"/ru/tip/19-13"},"children":[{"tag":"span","props":{},"children":["13"]},"Если работодатель не оформил страховку от несчастных случаев, вы всё равно имеете право на положенные выплаты — он обязан оплатить их в полном объёме по тем же стандартам"]},{"tag":"a","props":{"href":"/ru/tip/19-14"},"children":[{"tag":"span","props":{},"children":["14"]},"После стабилизации состояния пострадавшего проводится экспертиза трудоспособности, по результатам которой определяется размер компенсации"]},{"tag":"a","props":{"href":"/ru/tip/19-15"},"children":[{"tag":"span","props":{},"children":["15"]},"Три вида выплат при смерти на работе: пособие на погребение, пенсия иждивенцам и единовременная компенсация"]},{"tag":"a","props":{"href":"/ru/tip/19-16"},"children":[{"tag":"span","props":{},"children":["16"]},"Если на работе вас долгое время унижают, оскорбляют и притесняют, не пытайтесь терпеть: сначала зафиксируйте всё как доказательства, а затем действуйте в зависимости от ситуации — подавайте жалобы, вызывайте полицию или обращайтесь в суд"]},{"tag":"a","props":{"href":"/ru/tip/19-17"},"children":[{"tag":"span","props":{},"children":["17"]},"При увольнении попросите у работодателя справку об увольнении с указанием срока договора, даты увольнения, должности и стажа"]},{"tag":"a","props":{"href":"/ru/tip/19-18"},"children":[{"tag":"span","props":{},"children":["18"]},"Получив компенсацию при увольнении, сначала проверьте НДФЛ: в пределах трёхкратной средней зарплаты работников региона за прошлый год — без налога; сверх — отдельный расчёт, не вместе с годовой зарплатой"]},{"tag":"a","props":{"href":"/ru/tip/19-19"},"children":[{"tag":"span","props":{},"children":["19"]},"Переезжая в другой город для работы, переведите пенсионное и медицинское страхование по новому месту участия: годы взносов суммируются, выходить из пенсионного страхования не нужно"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"Навигация"},"children":[{"tag":"a","props":{"href":"/ru/book"},"children":["Книга"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/ru/book/19"},"children":["Глава 19"," ·"," ","Заработная плата, увольнение и производственные травмы"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"19-08"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["08"]},{"tag":"span","props":{"className":"life-evidence grade-b"},"children":["Доказательства"," ","B"]}]},{"tag":"h1","props":{"lang":"ru"},"children":["Сохраните справки о зарплате, учёт рабочего времени, трудовой договор, эти соцстраха и переписку до увольнения"]},{"tag":"p","props":{"lang":"ru","className":"life-entry-summary"},"children":["В Китае увольнение и сокращение зарплаты должен обосновывать работодатель, но сверхурочные сначала доказываете вы, а зарплатные записи обязаны хранить лишь два года. Вернув компьютер и аккаунт, доступа лишитесь. Расчётные листки, табели, соцстрах и оригиналы переписки дадут доказательства при отказе работодателя."]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Затраты"]},{"tag":"p","props":{},"children":["Бесплатно. Потребуется лишь полчаса, чтобы всё сохранить.…"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Польза"]},{"tag":"p","props":{},"children":["После сдачи компьютера и аккаунта эти документы недоступны. В трудовых спорах Китая заявляющий требование дока…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"Отметить: Сохраните справки о зарплате, учёт рабочего времени, трудовой договор, эти соцстраха и переписку до увольнения"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"Сделано"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"В планах"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"В избранное"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Поделиться советом"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Скрыть подробности"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Затраты"]},{"tag":"p","props":{},"children":["Бесплатно. Потребуется лишь полчаса, чтобы всё сохранить. Главная сложность — не забыть сделать это до ухода с работы."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Польза"]},{"tag":"p","props":{},"children":["После сдачи компьютера и аккаунта эти документы недоступны. В трудовых спорах Китая заявляющий требование доказывает его. Доказательства у работодателя он обязан представить, иначе несёт неблагоприятные последствия. Арбитраж может потребовать их в установленный срок. Увольнение, прекращение договора, уменьшение зарплаты и расчёт стажа доказывает работодатель. Сверхурочные — иначе: сначала докажите работу сверх нормы. Только доказав наличие записей у работодателя и его отказ, можно возложить последствия на него. Зарплатные записи он обязан хранить более двух лет, при выплате выдавать личный расчётный листок. Без письменного договора отношения подтверждают зарплатные записи, взносы соцстраха, пропуск, анкета найма, табели и показания коллег. Переписка — электронное доказательство. Представляют оригинал; распечатка непосредственно из исходных записей тоже оригинал. В шанхайском деле работник требовал недоплату до минимальной зарплаты за десять лет. Две инстанции признали только последние два года: хранить надо два года, первые восемь доказывает работник. У него были десять лет листков и банковских выписок, но работодатель отрицал подлинность листков. В августе 2024 года работник попросил прокурорского надзора. После протеста прокуратуры по примирению доплатили 19000 юаней. Иск был подан при увольнениях в компании в 2021 году, примерно за три года до надзора (по всему Китаю)."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Первоисточники"]},{"tag":"p","props":{"className":"life-citations"},"children":["全国人大常委会 (2007). 劳动争议调解仲裁法（第六、三十九条）. ",{"tag":"a","props":{"href":"https://rsj.ankang.gov.cn/Content-2150407.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://rsj.ankang.gov.cn/Content-2150407.html"]},"（安康市人力资源和社会保障局转载）；最高人民法院 (2020). 关于审理劳动争议案件适用法律问题的解释（一）（法释〔2020〕26 号，第四十二、