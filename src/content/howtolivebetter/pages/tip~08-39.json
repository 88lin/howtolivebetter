0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"收藏"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"分享这条建议"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"收起详情"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["成本"]},{"tag":"p","props":{},"children":["不花钱。当场多问一句，把受案回执要到手。之后按上面的日期去追问进度。难在一次次开口去问。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["收益"]},{"tag":"p","props":{},"children":["《公安机关办理刑事案件程序规定》（公安部令第 159 号修正后）第一百七十一条管的是受案回执。原文是：「公安机关接受案件时，应当制作受案登记表和受案回执，并将受案回执交扭送人、报案人、控告人、举报人」。第一百七十四条：「对接受的案件，或者发现的犯罪线索，公安机关应当迅速进行审查」。第一百七十八条管的是立不立案。接受案件后经审查，认为有犯罪事实需要追究刑事责任，又属于自己管辖的，经县级以上公安机关负责人批准予以立案。不立案也要给你一张纸：「对有控告人的案件，决定不予立案的，公安机关应当制作不予立案通知书，并在三日以内送达控告人」。第一百七十九条管的是不服怎么办。原文是：「控告人对不予立案决定不服的，可以在收到不予立案通知书后七日以内向作出决定的公安机关申请复议；公安机关应当在收到复议申请后三十日以内作出决定」。接着写：「控告人对不予立案的复议决定不服的，可以在收到复议决定书后七日以内向上一级公安机关申请复核；上一级公安机关应当在收到复核申请后三十日以内作出决定。对上级公安机关撤销不予立案决定的，下级公安机关应当执行」。案情重大、复杂的可以延长复议复核的时限，但「不得超过三十日，并书面告知申请人」。刑事诉讼法第一百一十二条：认为有犯罪事实需要追究刑事责任的应当立案；不予立案的，「将不立案的原因通知控告人。控告人如果不服，可以申请复议」。第一百一十三条：「被害人认为公安机关对应当立案侦查的案件而不立案侦查，向人民检察院提出的，人民检察院应当要求公安机关说明不立案的理由。人民检察院认为公安机关不立案理由不能成立的，应当通知公安机关立案，公安机关接到通知后应当立案」。《公安机关办理行政案件程序规定》第六十一条也有同样的要求。属于本单位管辖的案件，「应当立即调查处理，制作受案登记表和受案回执，并将受案回执交报案人、控告人、举报人、扭送人」。办理治安案件的期限「自受理之日起不得超过 30 日；案情重大、复杂的，经上一级公安机关批准，可以延长 30 日」，鉴定期间不计入办案期限。《公安机关督察条例》第九条管的是投诉警察。原文是：「督察机构对群众投诉的正在发生的公安机关及其人民警察违法违纪行为，应当及时出警，按照规定给予现场处置，并将处理结果及时反馈投诉人」（全国）"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["原始出处"]},{"tag":"p","props":{"className":"life-citations"},"children":["全国人大 (2018). 刑事诉讼法（2018 年修正，第一百一十二、一百一十三条）. ",{"tag":"a","props":{"href":"https://flk.npc.gov.cn/detail?id=ff8080816f135f46016f1d1b81b01351","target":"_blank","rel":"noopener noreferrer"},"children":["https://flk.npc.gov.cn/detail?id=ff8080816f135f46016f1d1b81b01351"]},"；公安部 (2020). 关于修改《公安机关办理刑事案件程序规定》的决定（公安部令第 159 号）及修正后全文. ",{"tag":"a","props":{"href":"http://www.gov.cn/gongbao/content/2020/content_5549884.htm","target":"_blank","rel":"noopener noreferrer"},"children":["http://www.gov.cn/gongbao/content/2020/content_5549884.htm"]},"；公安部 (2013/2019 修正). 公安机关办理行政案件程序规定（公安部令第 125 号，第 149 号修改决定）. ",{"tag":"a","props":{"href":"http://www.gov.cn/gongbao/content/2013/content_2321117.htm","target":"_blank","rel":"noopener noreferrer"},"children":["http://www.gov.cn/gongbao/content/2013/content_2321117.htm"]},"、",{"tag":"a","props":{"href":"http://www.gov.cn/zhengce/zhengceku/2018-12/31/content_5428593.htm","target":"_blank","rel":"noopener noreferrer"},"children":["http://www.gov.cn/zhengce/zhengceku/2018-12/31/content_5428593.htm"]},"；国务院 (2011). 公安机关督察条例（国务院令第 603 号，第九条）. ",{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/2011-09/08/content_6138.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/zhengce/zhengceku/2011-09/08/content_6138.htm"]}]},{"tag":"a","props":{"href":"https://flk.npc.gov.cn/detail?id=ff8080816f135f46016f1d1b81b01351","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["打开来源链接"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["原书备注"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["受益人是你自己。报了警不一定就会处理，但办不办、多久办，都有明文的标准和期限。三个动作按顺序记。① 当场拿受案回执，把案件编号和受理单位记下来。② 到期没结果，就按上面的期限去问进度，问「案子在哪个环节」，别问「为什么不管我」。③ 收到不予立案通知书，先看理由，7 日内复议，再 7 日复核，同时可以向人民检察院提出立案监督，三条路不冲突。治安案件，就是打架、小偷小摸这类。办案期限从受理那天算起，不超过 30 日。案情重大复杂的，经上一级公安机关批准可以再延 30 日。做鉴定的时间不算在内。接待态度差就走督察投诉，案子本身照样按立案流程追。捡到失物、邻里纠纷这类本来就不是刑事案件，公安机关按行政案件或者调解处理，甚至只是登记备案，别按「报案没人管」来理解。被诈骗之后的止付流程，见本节第 2 条（立刻打 110 要求止付）。被网暴见本节第 37 条（被网暴了先固证再挑路）"]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["我的备注"]},{"tag":"button","props":{"type":"button"},"children":["写下对自己有用的提醒…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/tip/08-38"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["上一条"]},"「先给人买保险再动手」这条路法律上从头堵死：钱一分拿不到，罪按故意杀人加保险诈骗数罪并罚"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/tip/08-40"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["下一条"]},"别给办案、执法的人送钱送卡：行贿自己也判，对监察、执法、司法人员行贿还要从重"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["本主题的其他建议"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/08-35"},"children":[{"tag":"strong","props":{},"children":["被羁押后撤案、不起诉或者判无罪的，去申请国家赔偿，按天算钱"]},{"tag":"span","props":{},"children":["被拘留、逮捕后又撤案、不起诉或判无罪的，能申请国家赔偿。被关的日子按天赔，2026 年 5 月 18 日起每天 495.94 元，一年约 …"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/08-36"},"children":[{"tag":"strong","props":{},"children":["自己是受害人去索赔，走 12315、起诉或者律师，别单独赴对方的约，别把「给钱」和「我不曝光」绑成一句话"]},{"tag":"span","props":{},"children":["自己是受害人，向侵权方索赔，本身有法律依据，不会因为「要价高」就自动变成敲诈勒索。但代价可能很大：郭利先被以敲诈勒索罪判了五年，后来才再审…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/08-37"},"children":[{"tag":"strong","props":{},"children":["被网暴了：先开防护、先固证，再在平台、禁令、报警三条路里挑"]},{"tag":"span","props":{},"children":["当场先做三件事：打开平台的防护设置，用快捷取证把内容存下来，再从快捷入口举报。之后可以向法院申请禁令，让他先停手。也可以自己去法院告，取证…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/08-41"},"children":[{"tag":"strong","props":{},"children":["可能翻脸的电话和面谈，直接开录音：自己参加的谈话，不用先征得对方同意"]},{"tag":"span","props":{},"children":["借钱、欠款、赔偿、退款、劳动纠纷，电话里说清楚了却没留下东西，几个月后双方就可能各说一套。你自己参加的谈话可以录下来，没提前告诉对方，不会…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/08-42"},"children":[{"tag":"strong","props":{},"children":["现场出了事，先拍全景，再拍位置关系，最后拍损坏和伤情，原图原视频别删"]},{"tag":"span","props":{},"children":["只对着车上一道划痕或者地上一件东西拍特写，过几天没人知道它原来在哪。先拍一段全景，把路口、门牌、车、人和周围都收进去，再拍相互位置，最后拍…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/08-43"},"children":[{"tag":"strong","props":{},"children":["被家暴了：先报警留下出警记录，再去法院申请人身安全保护令，不用先离婚，也不收费"]},{"tag":"span","props":{},"children":["在全世界被杀害的女性里，三分之一以上是伴侣下的手，往往是长期家暴的结局。同样挨打的女性里，被掐过脖子的，后来被杀的几率是没被掐过的 7 倍…"]}]}]}]},{"tag":"a","props":{"className":"life-text-link","href":"/book/08"},"children":["阅读整个主题：别把自己搭进去：法律与财产安全"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"15","height":"15","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]}]}]}]},{"tag":"aside","props":{"className":"life-ad-space life-ad-space-sponsored","data-ad-placement":"ad_footer","data-ad-group":"reading","data-ad-creative":"read_product","d