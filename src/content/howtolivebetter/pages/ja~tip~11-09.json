ag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"このヒントを共有"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"詳細を閉じる"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["費用・手間"]},{"tag":"p","props":{},"children":["費用はかかりません。ベンダーのSRC（セキュリティ・レスポンス・センター）やバグバウンティに参加する前には、必ず許可範囲、対象リスト、テスト可能期間が明記された文書を入手してください。SRCはベンダー自身が運営するセキュリティ・レスポンス・センターであり、外部から報告された脆弱性を専門に受け付けています。脆弱性が存在することを確認したら、そこで作業を止めてください。難しい点は、「ついでに試してみよう」という衝動を抑えることです。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["効果"]},{"tag":"p","props":{},"children":["一般企業および個人のシステムであり、国家事務、国防建設、先端科学技術の分野以外に属するコンピュータ情報システム。これらのシステムに侵入したり、その他の技術的手法を用いて、内部に保存、処理、伝送されているデータを取得した場合、事態が重大なときは3年以下の有期懲役または拘役、および罰金に処される。特に重大な場合は3年から7年の懲役および罰金に処される。「事態が重大」とされる基準には以下のものがある：決済、証券取引、先物取引などのネットワーク金融サービスの認証情報（アカウント名やパスワードなど）を10組以上取得した場合、その他の認証情報を500組以上取得した場合、コンピュータ情報システムを20台以上不正に制御した場合、不法所得が5000元以上、または経済的損失が1万元以上発生した場合。上記の数値の 5 倍以上が「情状が特に重大」とみなされます。公式の事例：検例第 36 号では、「権限の範囲を超えてアカウントやパスワードを使用してコンピュータ情報システムにログインすることは、コンピュータ情報システムへの侵入行為に該当する」という一文が確立されています。これは、もともとアカウントやパスワードを保持していたとしても、権限外の範囲で使用した場合は、その行為自体が侵入とみなされることを意味します。当該の事件では、3名が業務上把握していたアカウント、パスワード、およびトークンを使用し、遠隔地から社内システムにログインして業務範囲外のデータをダウンロードし、ネット上で販売して 37000 元の不当利益を得ました。3名はそれぞれ 4 年、3 年 9 ヶ月、4 年の懲役、およびそれぞれ 4 万元の罰金に処されました（全国）"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["出典"]},{"tag":"p","props":{"className":"life-citations"},"children":["全国人大 (2020). 刑法（根据刑法修正案（十一）修正，第二百八十五条第一款、第二款）. ",{"tag":"a","props":{"href":"https://jtgl.beijing.gov.cn/jgj/jgxx/flfg/fl/11033925/index.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://jtgl.beijing.gov.cn/jgj/jgxx/flfg/fl/11033925/index.html"]},"；最高人民法院、最高人民检察院 (2011). 关于办理危害计算机信息系统安全刑事案件应用法律若干问题的解释（第一条）. ",{"tag":"a","props":{"href":"https://ga.sz.gov.cn/ZWGK/ZCFG/ZCJD/content/post_1304363.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://ga.sz.gov.cn/ZWGK/ZCFG/ZCJD/content/post_1304363.html"]},"（深圳市公安局转载）；最高人民检察院 (2017). 第九批指导性案例（检例第 36 号，卫梦龙、龚旭、薛东东非法获取计算机信息系统数据案）. ",{"tag":"a","props":{"href":"https://www.spp.gov.cn/spp/jczdal/201710/t20171017_202593.shtml","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.spp.gov.cn/spp/jczdal/201710/t20171017_202593.shtml"]},"；央广网 (2016-06-29). 白帽子发布漏洞后被抓 世纪佳缘否认“钓鱼”使其上套（记者赵珂，实习记者刘香玺）. ",{"tag":"a","props":{"href":"https://m.cnr.cn/news/yctt/20160629/t20160629_522531823.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://m.cnr.cn/news/yctt/20160629/t20160629_522531823.html"]},"（网页存档 ",{"tag":"a","props":{"href":"https://web.archive.org/web/20261005043859/https://m.cnr.cn/news/yctt/20160629/t20160629_522531823.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://web.archive.org/web/20261005043859/https://m.cnr.cn/news/yctt/20160629/t20160629_522531823.html"]},"）"]},{"tag":"a","props":{"href":"https://jtgl.beijing.gov.cn/jgj/jgxx/flfg/fl/11033925/index.html","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["出典を開く"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["著者の注記"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["検例第36号の指導事例自体は、データを売って利益を得た事件です。「権限の範囲を超えたログインも侵入」という点だけを引用しており、善意のテストも同じ重さの刑になるという意味ではありません。目的や事後報告の有無は罪を消さず、量刑や起訴の判断に影響する可能性があるだけです。企業が最初に礼を言い、後で通報しても矛盾しません。感謝は許可ではありません。2016 年、ホワイトハットが世紀佳縁の脆弱性を第三者の報告プラットフォームに提出し、その後同社が通報して逮捕されました。同社は記者に、データが持ち出されたため通報し、当時は持ち出した人が報告者だとは知らなかったと説明しました。報道のみで判決・公式通知はなく、最終処分の公式説明もありません。最高人民法院・最高人民検察院の公式サイトでも、原文を逐語的に確認できる善意のテストの事例は見つからず、本項は法文と処罰基準だけで評価しています。行うなら企業の公開 SRC、または書面で委託された評価を利用し、範囲、対象、期間を明記してください。脆弱性の証明は最小限にし、大量のデータを取得しないでください。犯罪に達しなくても治安処罰と就業禁止があり、罰金額と期間は第8項（他人の機械で自分のプログラムを動かさない）と同じです。発見後の処理は第10項（規定に従い脆弱性を報告）を参照してください。"]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["自分のメモ"]},{"tag":"button","props":{"type":"button"},"children":["自分へのメモを書く…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/ja/tip/11-08"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["前へ"]},"他人のコンピュータ、サーバ、カメラ上で自作プログラムを動作させない、会社の機器をマイニングに使用しない"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/ja/tip/11-10"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["次へ"]},"脆弱性は規定に従って報告すること。修正前は詳細を公開せず、悪用ツールを配布せず、国外へ渡さないこと"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["このテーマの他の提案"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/11-05"},"children":[{"tag":"strong","props":{},"children":["ギャンブル、詐欺、アダルトAppの開発案件は受けない。「クライアント」のために決済チャネルの構築やアカウントの凍結解除を行わない"]},{"tag":"span","props":{},"children":["このような高額な報酬を提示し、かつ要求内容が曖昧な案件を引き受けることは、賭博グループの共犯になるも同然です。賭博開設罪に問われた場合、5…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/11-06"},"children":[{"tag":"strong","props":{},"children":["退職時にはアカウント権限をすべて返却する。データベースの削除、バックドアの設置、パスワード変更によるシステムのロックは行わない。たとえ会社から未払い賃金があったとしても"]},{"tag":"span","props":{},"children":["ア