dren":[{"tag":"div","props":{"className":"life-ad-rail","data-dock-active":"false","style":{"top":"94px"}},"children":[{"tag":"div","props":{"className":"life-ad-dock","hidden":true},"children":[{"tag":"aside","props":{"className":"life-ad-space life-ad-space-sponsored life-ad-space-compact","data-ad-placement":"ad_dock","data-ad-group":"reading","data-ad-creative":"read_product","data-ad-ready":"false","aria-label":"Advertisement · Community recommendation"},"children":[{"tag":"button","props":{"type":"button","className":"life-ad-dismiss","aria-label":"Close ad"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-x","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M18 6 6 18"},"children":[]},{"tag":"path","props":{"d":"m6 6 12 12"},"children":[]}]}]},{"tag":"div","props":{"className":"life-ad-space-brand"},"children":[{"tag":"img","props":{"src":"/sites/howtolivebetter/images/shengcai/logo.png","width":"565","height":"144","alt":"Official Shengcai Youshu logo","decoding":"async"},"children":[]}]},{"tag":"div","props":{"className":"life-ad-space-copy"},"children":[{"tag":"span","props":{"className":"life-ad-space-label"},"children":["Advertisement · Community recommendation"]},{"tag":"strong","props":{},"children":["Could what you know become a useful product?"]},{"tag":"p","props":{},"children":["From ebooks to small tools, explore how members spot needs and turn knowledge into something people can use."]}]},{"tag":"div","props":{"className":"life-ad-space-actions"},"children":[{"tag":"a","props":{"className":"life-ad-space-link","href":"/en/shengcaiyoushu?sc_group=reading&sc_creative=read_product&sc_placement=ad_dock"},"children":["Explore the community and examples",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"18","height":"18","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-up-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M7 7h10v10"},"children":[]},{"tag":"path","props":{"d":"M7 17 17 7"},"children":[]}]}]}]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/en/book/20"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"Back to index"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["How to care for a newborn baby"]},{"tag":"div","props":{"data-ad-dock-host":"true"},"children":[]},{"tag":"nav","props":{"aria-label":"Chapter entries"},"children":[{"tag":"a","props":{"href":"/en/tip/20-01"},"children":[{"tag":"span","props":{},"children":["01"]},"During infancy, put the baby to sleep on their back on a firm surface; share a room but not a bed; and do not place any soft items in the crib or bed"]},{"tag":"a","props":{"href":"/en/tip/20-02"},"children":[{"tag":"span","props":{},"children":["02"]},"Administer the first dose of hepatitis B vaccine within 24 hours after birth"]},{"tag":"a","props":{"href":"/en/tip/20-03"},"children":[{"tag":"span","props":{},"children":["03"]},"Ensure your child receives all vaccines in the national immunization schedule at no cost; missed doses can be added later"]},{"tag":"a","props":{"href":"/en/tip/20-04"},"children":[{"tag":"span","props":{},"children":["04"]},"Breastfeed exclusively for the first 6 months — no water needed; introduce solids at 6 months while continuing breastfeeding"]},{"tag":"a","props":{"href":"/en/tip/20-05"},"children":[{"tag":"span","props":{},"children":["05"]},"Use water hotter than 70 °C to prepare formula, then let it cool before feeding; discard any leftovers"]},{"tag":"a","props":{"href":"/en/tip/20-06"},"children":[{"tag":"span","props":{},"children":["06"]},"Do not feed honey to children under 1 year old"]},{"tag":"a","props":{"href":"/en/tip/20-07"},"children":[{"tag":"span","props":{},"children":["07"]},"Vitamin K injection at birth is essential"]},{"tag":"a","props":{"href":"/en/tip/20-08"},"children":[{"tag":"span","props":{},"children":["08"]},"Infants under 3 months with a body temperature of 38°C should be taken straight to the hospital — no home observation needed"]},{"tag":"a","props":{"href":"/en/tip/20-09"},"children":[{"tag":"span","props":{},"children":["09"]},"No matter how tired or angry you are, never shake a baby"]},{"tag":"a","props":{"href":"/en/tip/20-10"},"children":[{"tag":"span","props":{},"children":["10"]},"When choosing diapers, focus on three things: fit, how often you change them, and whether they’ve been flagged in any quality inspections"]},{"tag":"a","props":{"href":"/en/tip/20-11"},"children":[{"tag":"span","props":{},"children":["11"]},"Consider buying big-ticket items in the order “borrow, buy used, buy new” — don’t buy them all at once"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/en/tip/20-12","data-status":"active"},"children":[{"tag":"span","props":{},"children":["12"]},"For children with severe eczema or egg allergy, don’t avoid peanuts — introduce them early under medical guidance, but never feed whole peanuts"]},{"tag":"a","props":{"href":"/en/tip/20-13"},"children":[{"tag":"span","props":{},"children":["13"]},"Watch newborn jaundice for these signals: yellow within 24 hours of birth, getting yellower, hard to wake or refusing feeds, pale stools — go to hospital the same day"]},{"tag":"a","props":{"href":"/en/tip/20-14"},"children":[{"tag":"span","props":{},"children":["14"]},"If you eat a vegetarian diet during pregnancy or breastfeeding, take vitamin B12 daily; include animal foods in the baby’s complementary diet, and consult a doctor before making it vegan"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"Breadcrumb"},"children":[{"tag":"a","props":{"href":"/en/book"},"children":["Explore the book"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/en/book/20"},"children":["Chapter 20"," ·"," ","How to care for a newborn baby"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"20-12"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["12"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["Evidence"," ","A"]}]},{"tag":"h1","props":{"lang":"en"},"children":["For children with severe eczema or egg allergy, don’t avoid peanuts — introduce them early under medical guidance, but never feed whole peanuts"]},{"tag":"p","props":{"lang":"en","className":"life-entry-summary"},"children":["In a randomized trial of 640 high‑risk infants, those who ate peanuts regularly from 4 to 11 months of age had a peanut allergy rate of only 1.9% by age 5, compared with 13.7% in the group that completely avoided peanuts. Among children already showing a weak positive skin test at enrollment, the rates were 10.6% versus 35.3%. Avoiding peanuts actually raises the risk of allergy. However, whole peanuts must never be given, as they can block the airway. A total of 530 infants had negative skin tests at entry, while 98 had weakly positive results."]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Cost"]},{"tag":"p","props":{},"children":["A jar of peanut butter costs just a few dozen yuan. Feedin…"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Benefit"]},{"tag":"p","props":{},"children":["The LEAP trial involved 640 infants aged 4–11 months with severe eczema, egg allergy, or both. One group ate p…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"Mark: For children with severe eczema or egg allergy, don’t avoid peanuts — introduce them early under medical guidance, but never feed whole peanuts"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"Done"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"Plan to do"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"Save"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Share this tip"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Hide details"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Cost"]},{"tag":"p","props":{},"children":["A jar of peanut butter costs just a few dozen yuan. Feeding it a few times a week is easy to fit into a routine. Before starting, though, a doctor’s evaluation is required."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Benefit"]},{"tag":"p","props":{},"children":["The LEAP trial involved 640 infants aged 4–11 months with severe eczema, egg allergy, or both. One group ate peanut products regularly while the other avoided them entirely; at 60 months, only 1.9% of the eaters had a peanut allergy versus 13.7% of avoiders (P<0.001). Among 98 children with a weak positive skin test at entry, 10.6% of eaters were allergic versus 35.3% of avoiders (P=0.004). No serious adverse events differed between groups."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Original sources"]},{"tag":"p","props":{"className":"life-citations"},"children":["Du Toit G, Roberts G, Sayre PH, 等 (2015). Randomized trial of peanut consumption in infants at risk for peanut allergy. New England Journal of Medicine, 372(9), 803-813. ",{"tag":"a","props":{"href":"https://doi.org/10.1056/NEJMoa1414850","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1056/NEJMoa1414850"]},"；国家卫生健康委办公厅 (2020). 婴幼儿喂养健康教育核心信息. ",{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/2020-08/01/content_5531915.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/zhengce/zhengceku/2020-08/01/content_5531915.htm"]},"；Perkin MR 等 (2016). Randomized Trial of Introduction of Allergenic Foods in Breast-Fed Infants. New England Journal of Medicine, 374(18), 1733-1743. ",{"tag":"a","props":{"href":"https://doi.org/10.1056/NEJMoa1514210","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1056/NEJMoa1514210"]},"（备注里那项一般婴儿试验 EAT）"]},{"tag":"a","props":{"href":"https://doi.org/10.1056/NEJMoa1414850","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Open source link"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Book note"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["Peanuts must be given only as thinned peanut butter or powdered form mixed into food — never as whole nuts. The Health Commission clearly states: “Whole peanuts, nuts, jelly, and similar foods can be inhaled into the airway and cause choking; infants should avoid them.” For choking first aid, see Section 13, Item 26. This guidance applies only to high‑risk children with severe eczema or egg allergy. A medical assessment is mandatory before introduction; in the LEAP trial, children with a skin‑test reaction greater than 4 mm were excluded. Another study of 1,162 breastfed infants found no significant difference in overall food allergy rates between early‑introduction and standard groups, though a subset showed a clear benefit: 5.6% versus 7.1% (P=0.32) and 2.4% versus 7.3% respectively. Evidence for typical infants is far weaker. Early introduction appears safe, but Chinese official guidelines currently give no recommendation on this point; therefore this advice follows international trial evidence. Keep in mind that LEAP started at 4 months while Chinese practice recommends waiting until 6 months for solids — consult a doctor on timing and method for high‑risk children."]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["My note"]},{"tag":"button","props":{"type":"button"},"children":["Write a reminder for yourself…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/en/tip/20-11"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Previous"]},"Consider buying big-ticket items in the order “borrow, buy used, buy new” — don’t buy them all at once"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/en/tip/20-13"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Next"]},"Watch newborn jaundice for these signals: yellow within 24 hours of birth, getting yellower, hard to wake or refusing feeds, pale stools — go to hospital the same day"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12