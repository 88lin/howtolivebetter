ildren":[{"tag":"div","props":{"className":"life-ad-rail","data-dock-active":"false","style":{"top":"94px"}},"children":[{"tag":"div","props":{"className":"life-ad-dock","hidden":true},"children":[{"tag":"aside","props":{"className":"life-ad-space life-ad-space-sponsored life-ad-space-compact","data-ad-placement":"ad_dock","data-ad-group":"reading","data-ad-creative":"read_product","data-ad-ready":"false","aria-label":"Реклама · Рекомендация сообщества"},"children":[{"tag":"button","props":{"type":"button","className":"life-ad-dismiss","aria-label":"Закрыть рекламу"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-x","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M18 6 6 18"},"children":[]},{"tag":"path","props":{"d":"m6 6 12 12"},"children":[]}]}]},{"tag":"div","props":{"className":"life-ad-space-brand"},"children":[{"tag":"img","props":{"src":"/sites/howtolivebetter/images/shengcai/logo.png","width":"565","height":"144","alt":"Официальный логотип Shengcai Youshu","decoding":"async"},"children":[]}]},{"tag":"div","props":{"className":"life-ad-space-copy"},"children":[{"tag":"span","props":{"className":"life-ad-space-label"},"children":["Реклама · Рекомендация сообщества"]},{"tag":"strong","props":{},"children":["Могут ли ваши знания стать полезным продуктом?"]},{"tag":"p","props":{},"children":["От электронных книг до инструментов: как участники находят потребности и создают то, чем можно пользоваться."]}]},{"tag":"div","props":{"className":"life-ad-space-actions"},"children":[{"tag":"a","props":{"className":"life-ad-space-link","href":"/ru/shengcaiyoushu?sc_group=reading&sc_creative=read_product&sc_placement=ad_dock"},"children":["О сообществе и примерах",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"18","height":"18","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-up-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M7 7h10v10"},"children":[]},{"tag":"path","props":{"d":"M7 17 17 7"},"children":[]}]}]}]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/ru/book/12"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"К содержанию"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["Открытие бизнеса: как не потерять все сбережения"]},{"tag":"div","props":{"data-ad-dock-host":"true"},"children":[]},{"tag":"nav","props":{"aria-label":"Советы главы"},"children":[{"tag":"a","props":{"href":"/ru/tip/12-01"},"children":[{"tag":"span","props":{},"children":["01"]},"Инвестируйте только те средства, которые можете позволить себе потерять — не трогайте семейные сбережения и не берите кредиты"]},{"tag":"a","props":{"href":"/ru/tip/12-02"},"children":[{"tag":"span","props":{},"children":["02"]},"Не ставьте личную гарантию за компанию, а супругу тем более не вовлекайте"]},{"tag":"a","props":{"href":"/ru/tip/12-03"},"children":[{"tag":"span","props":{},"children":["03"]},"Правильный выбор формы бизнеса до открытия: при индивидуальном предпринимательстве и обычном партнерстве ответственность неограниченна, а в ООО она «ограничена»"]},{"tag":"a","props":{"href":"/ru/tip/12-04"},"children":[{"tag":"span","props":{},"children":["04"]},"Неправомерное включение в число акционеров — риск нести чужие долги"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/ru/tip/12-05","data-status":"active"},"children":[{"tag":"span","props":{},"children":["05"]},"Перед подписанием договора проверьте наличие регистрации в Министерстве коммерции и получите письменную информацию; обязательно включите в договор условие о «периоде раздумий»"]},{"tag":"a","props":{"href":"/ru/tip/12-06"},"children":[{"tag":"span","props":{},"children":["06"]},"Перед регистрацией нужно определить название, место ведения бизнеса, сферу деятельности и размер уставного капитала — при наличии всех документов бизнес-лицензию выдадут сразу"]},{"tag":"a","props":{"href":"/ru/tip/12-07"},"children":[{"tag":"span","props":{},"children":["07"]},"Бизнес, требующий лицензии: начинать работу можно только после её получения"]},{"tag":"a","props":{"href":"/ru/tip/12-08"},"children":[{"tag":"span","props":{},"children":["08"]},"Определите, к какой категории вы относитесь: для производства продуктов питания и ресторанного бизнеса требуется разрешение, для продажи только готовой упакованной продукции достаточно регистрации, а для продажи свежих овощей и мяса разрешение не нужно"]},{"tag":"a","props":{"href":"/ru/tip/12-09"},"children":[{"tag":"span","props":{},"children":["09"]},"Упаковка продукта делает его предварительно упакованной пищевой продукцией: на этикетке обязательно указываются дата производства, срок годности и состав"]},{"tag":"a","props":{"href":"/ru/tip/12-10"},"children":[{"tag":"span","props":{},"children":["10"]},"На обычные продукты питания нельзя указывать, что они лечат болезни: это касается этикеток, инструкций, рекламы и текстов для прямых трансляций"]},{"tag":"a","props":{"href":"/ru/tip/12-11"},"children":[{"tag":"span","props":{},"children":["11"]},"В этой сфере действуют уголовные нормы: продажа мяса от больных животных или продукции с превышенным содержанием вредных веществ уже является преступлением; добавление в пищу токсичных и вредных веществ влечет наказание от 5 лет лишения свободы независимо от суммы оборота"]},{"tag":"a","props":{"href":"/ru/tip/12-12"},"children":[{"tag":"span","props":{},"children":["12"]},"После получения бизнес-лицензии возникает обязанность по подаче налоговой отчетности; даже при отсутствии дохода её нужно подавать с нуля (заполняя все поля нулями)"]},{"tag":"a","props":{"href":"/ru/tip/12-13"},"children":[{"tag":"span","props":{},"children":["13"]},"Счета-фактуры выписываются только по реальным сделкам; малые предприятия могут полностью освободиться от НДС"]},{"tag":"a","props":{"href":"/ru/tip/12-14"},"children":[{"tag":"span","props":{},"children":["14"]},"Мошенники выдают себя за сотрудников налоговой службы и требуют оплаты и подачи деклараций; на самом деле это обман. Официальные каналы для налоговых дел — электронная налоговая система и горячая линия 12366"]},{"tag":"a","props":{"href":"/ru/tip/12-15"},"children":[{"tag":"span","props":{},"children":["15"]},"При написании «задаток» вместо «предоплата» соблюдайте правила двойного возврата, четко пропишите размер неустойки, а предоставление отсрочки платежа рассматривайте как выдачу займа"]},{"tag":"a","props":{"href":"/ru/tip/12-16"},"children":[{"tag":"span","props":{},"children":["16"]},"Заключение письменного трудового договора в первый месяц работы и регистрация в соцстрахе в течение 30 дней"]},{"tag":"a","props":{"href":"/ru/tip/12-17"},"children":[{"tag":"span","props":{},"children":["17"]},"Зарплата выплачивается согласно договору и закону; повышения, займы и премии оформляются письменно"]},{"tag":"a","props":{"href":"/ru/tip/12-18"},"children":[{"tag":"span","props":{},"children":["18"]},"Продавать сначала, а потом производить: проверить спрос через предзаказы и мелкие заказы, прежде чем вкладывать средства в производство"]},{"tag":"a","props":{"href":"/ru/tip/12-19"},"children":[{"tag":"span","props":{},"children":["19"]},"Сначала сверяем образец с перечнем требований для массового производства, а потом приступаем к запуску"]},{"tag":"a","props":{"href":"/ru/tip/12-20"},"children":[{"tag":"span","props":{},"children":["20"]},"Сохраняйте документы и эти поставщика; не закупайте товары по цене, значительно ниже рыночной: если сотрудник привез подделку, ответственность несет руководитель"]},{"tag":"a","props":{"href":"/ru/tip/12-21"},"children":[{"tag":"span","props":{},"children":["21"]},"Для товаров, упаковки, этикеток и рекламных изображений нужно либо создавать графику самостоятельно, либо покупать лицензию; изменение цвета или добавление своего значка не считается «изменением»"]},{"tag":"a","props":{"href":"/ru/tip/12-22"},"children":[{"tag":"span","props":{},"children":["22"]},"Соблюдение установленных правил на рабочем месте и чёткое понимание ответственности при проявлении доброй воли вне этих рамок"]},{"tag":"a","props":{"href":"/ru/tip/12-23"},"children":[{"tag":"span","props":{},"children":["23"]},"Если убытки — действуйте по процедуре: при возможности проводите упрощённую ликвидацию, а если активы не покрывают долги — подавайте на банкротство, не оставляйте дело без внимания"]},{"tag":"a","props":{"href":"/ru/tip/12-24"},"children":[{"tag":"span","props":{},"children":["24"]},"Прежде чем тратить деньги на аутсорсинг управления интернет-магазином, курсы по открытию магазина или схему «без собственного товара», выясните, потребуются ли дополнительные расходы и откуда возьмётся продажная статистика"]},{"tag":"a","props":{"href":"/ru/tip/12-25"},"children":[{"tag":"span","props":{},"children":["25"]},"Компании и индивидуальные предприниматели в Китае ежегодно с 1 января по 30 июня подают онлайн отчёт за прошлый год, даже без деятельности; отчёт бесплатен"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"Навигация"},"children":[{"tag":"a","props":{"href":"/ru/book"},"children":["Книга"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/ru/book/12"},"children":["Глава 12"," ·"," ","Открытие бизнеса: как не потерять все сбережения"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"12-05"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["05"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["Доказательства"," ","A"]}]},{"tag":"h1","props":{"lang":"ru"},"children":["Перед подписанием договора проверьте наличие регистрации в Министерстве коммерции и получите письменную информацию; обязательно включите в договор условие о «периоде раздумий»"]},{"tag":"p","props":{"lang":"ru","className":"life-entry-summary"},"children":["Согласно закону, бренд-франчайзер обязан сначала открыть как минимум два собственных магазина и проработать с ними не менее года. В течение 15 дней после подписания договора он также должен зарегистрировать свою деятельность в органах коммерции. До подписания соглашения он обязан предоставить вам письменный документ, содержащий 12 ключевых пунктов: размеры франшизного сбора и залога, условия их возврата, сведения о прибыльности действующих магазинов и т.д. Если регистрация не найдена, представитель бренда отказывается предоставить документы или требует оплаты до ознакомления с договором — лучше сразу откажитесь от сотрудничества."]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Затраты"]},{"tag":"p","props":{},"children":["Бесплатно. Просто зайдите на сайт «Системы информации о ко…"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Польза"]},{"tag":"p","props":{},"children":["Законодательство требует, чтобы у франчайзера было минимум два собственных магазина, проработавших не меньше г…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"Отметить: Перед подписанием договора проверьте наличие регистрации в Министерстве коммерции и получите письменную информацию; обязательно включите в договор условие о «периоде раздумий»"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"Сделано"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"В планах"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"В избранное"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Поделиться советом"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Скрыть подробности"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Затраты"]},{"tag":"p","props":{},"children":["Бесплатно. Просто зайдите на сайт «Системы информации о коммерческой франшизе» Министерства коммерции и проверьте, зарегистрирован ли этот бренд. Затем потребуйте от представителя бренда предоставить вам письменный перечень всех необходимых сведений до подписания договора — вместе с самим текстом соглашения. Эту процедуру можно завершить всего за несколько часов."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Польза"]},{"tag":"p","props":{},"children":["Законодательство требует, чтобы у франчайзера было минимум два собственных магазина, проработавших не меньше года. В течение 15 дней после первого подписания договора он обязан зарегистрировать свою деятельность в соответствующих органах. В противном случае ему грозит штраф от 10 до 50 тысяч юаней; при просрочке штраф возрастает до 50–100 тысяч юаней, а информация о нарушении публикуется открыто. До подписания договора он должен предоставить вам письменный перечень из 12 пунктов, включая размеры франшизного сбора и залога, условия их возврата, количество действующих франчайзи и их финансовые показатели, выдержки из аудиторских отчетов за последние два года, сведения о судебных и арбитражных разбирательствах за последние пять лет. В договоре также обязательно указывается, что в течение определенного срока после подписания франчайзи имеет право расторгнуть соглашение в одностороннем порядке. Если бренд скрывает такие сведения или предоставляет ложную информацию, франчайзи вправе расторгнуть договор (действует по всей стране с мая 2007 года)."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Первоисточники"]},{"tag":"p","props":{"className":"life-citations"},"children":["国务院 (2007). 商业特许经营管理条例（国务院令第 485 号，第七、八、十二、二十二、二十三、二十五条）. ",{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/2008-03/28/content_4179.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/zhengce/zhengceku/2008-03/28/content_4179.htm"]},"；商务部 (2012). 商业特许经营信息披露管理办法（商务部令 2012 年第 2 号，第五、九条）. ",{"tag":"a","props":{"href":"http://www.gov.cn/gongbao/content/2012/content_2177025.htm","target":"_blank","rel":"noopener noreferrer"},"children":["http://www.gov.cn/gongbao/content/2012/content_2177025.htm"]},"；商务部. 商业特许经营信息管理系统. ",{"tag":"a","props":{"href":"https://txjy.syggs.mofcom.gov.cn/","target":"_blank","rel":"noopener noreferrer"},"children":["https://txjy.syggs.mofcom.gov.cn/"]}]},{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/2008-03/28/content_4179.htm","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Открыть источник"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Примечание автора"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["Если регистрация бренда не найдена, представитель отказывается предоставить необходимые документы или требует оплаты до ознакомления с договором — немедленно прекращайте переговоры. «Период раздумий» — это именно тот срок после подписания договора, когда франчайзи может расторгнуть его в одностороннем порядке. Конкретное количество дней определяется в договоре, поскольку закон лишь указывает на «определенный срок»; поэтому при подписании обязательно уточните и зафиксируйте это число. Касательно указанных брендом средних показателей продаж, валовой и чистой прибыли действующих франчайзи обязательно потребуйте подтверждения источника этих данных — закон предписывает бренду раскрывать такую информацию. Схемы без «франшизы», только с оплатой «ведения магазина» или «обучения открытию», см. пункт 24 (ведение магазина и обучение открытию)."]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Моя заметка"]},{"tag":"button","props":{"type":"button"},"children":["Запишите напоминание…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/ru/tip/12-04"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Предыдущий"]},"Неправомерное включение в число акционеров — риск нести чужие долги"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/ru/tip/12-06"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Следующий"]},"Перед регистрацией нужно определить название, место ведения бизнеса, сферу деятельности и размер уставного капитала — при наличии всех документов бизнес-лицензию выдадут сразу"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["Другие советы по этой теме"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/12-01"},"children":[{"tag":"strong","props":{},"children":["Инвестируйте только те средства, которые можете позволить себе потерять — не трогайте семейные сбережения и не берите кредиты"]},{"tag":"span","props":{},"children":["Долги индивидуального предпринимателя погашаются за счёт личных средс…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/12-02"},"children":[{"tag":"strong","props":{},"children":["Не ставьте личную гарантию за компанию, а супругу тем более не вовлекайте"]},{"tag":"span","props":{},"children":["Подписывая «солидарную гарантию», вы даёте согласие на то, что если к…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/12-03"},"children":[{"tag":"strong","props":{},"children":["Правильный выбор формы бизнеса до открытия: при индивидуальном предпринимательстве и обычном партнерстве ответственность неограниченна, а в ООО она «ограничена»"]},{"tag":"span","props":{},"children":["При индивидуальном предпринимательстве и обычном партнерстве ответств…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/12-07"},"children":[{"tag":"strong","props":{},"children":["Бизнес, требующий лицензии: начинать работу можно только после её получения"]},{"tag":"span","props":{},"children":["Если начать работу без лицензии, в лучшем случае вас заставят прекрат…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/12-08"},"children":[{"tag":"strong","props":{},"children":["Определите, к какой категории вы относитесь: для производства продуктов питания и ресторанного бизнеса требуется разрешение, для продажи только готовой упакованной продукции достаточно регистрации, а для продажи свежих овощей и мяса разрешение не нужно"]},{"tag":"span","props":{},"children":["Если вы хотите самостоятельно готовить и продавать еду — например, от…"]}]}]},{"tag":"li","props