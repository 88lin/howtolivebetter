hildren":[]},{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},{"tag":"span","props":{},"children":["ログイン"]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/ja/book/30"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"目次に戻る"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["就学後の子ども"]},{"tag":"nav","props":{"aria-label":"この章のヒント"},"children":[{"tag":"a","props":{"href":"/ja/tip/30-01"},"children":[{"tag":"span","props":{},"children":["01"]},"子供が突然激痛を感じ、さらに痛みが強まっている場合は、すぐに病院へ行ってください。放課後まで我慢させてはいけません"]},{"tag":"a","props":{"href":"/ja/tip/30-02"},"children":[{"tag":"span","props":{},"children":["02"]},"すべき治療を「試験が終わるまで」と先延ばしにしないで。治療の適期は骨の成長とともにあり、試験の予定には左右されません"]},{"tag":"a","props":{"href":"/ja/tip/30-03"},"children":[{"tag":"span","props":{},"children":["03"]},"子供がいじめを受けた際、当日中に学校へ報告し、書面での対応を求める。殴打、金銭の強奪、デマの流布が関わる場合は直接警察へ通報"]},{"tag":"a","props":{"href":"/ja/tip/30-04"},"children":[{"tag":"span","props":{},"children":["04"]},"子供を毎日 2 時間屋外で過ごさせることは、現在、ランダム化比較試験によって支持されている唯一の近視予防策です"]},{"tag":"a","props":{"href":"/ja/tip/30-05"},"children":[{"tag":"span","props":{},"children":["05"]},"0 歳から 3 歳まではスクリーンを与えない、3 歳から 6 歳までは極力与えない、小中学生の学習目的以外での使用は1日 1 時間を超えないこと"]},{"tag":"a","props":{"href":"/ja/tip/30-06"},"children":[{"tag":"span","props":{},"children":["06"]},"近視を「残る損傷」として捉える：度数が深いほど、将来の網膜剥離、黄斑変性、緑内障のリスクが高まる"]},{"tag":"a","props":{"href":"/ja/tip/30-07"},"children":[{"tag":"span","props":{},"children":["07"]},"年に一度の学生健康診断の結果は自分で必ず確認し、異常があればその年のうちに病院で検査を受けること"]},{"tag":"a","props":{"href":"/ja/tip/30-08"},"children":[{"tag":"span","props":{},"children":["08"]},"12歳から18歳の子どもへのうつ病スクリーニング：学校の心理テストを診断と混同しないこと"]},{"tag":"a","props":{"href":"/ja/tip/30-09"},"children":[{"tag":"span","props":{},"children":["09"]},"「近視を治す」「度数を下げる」と謳う製品やサービスは買わない"]},{"tag":"a","props":{"href":"/ja/tip/30-10"},"children":[{"tag":"span","props":{},"children":["10"]},"睡眠、授業、体育、順位に関する明文規定があり、学校が守れていない場合は指摘可能です"]},{"tag":"a","props":{"href":"/ja/tip/30-11"},"children":[{"tag":"span","props":{},"children":["11"]},"子供が限界な場合は休学が可能です。学籍は学校が必ず保持しなければならず、最長 1 年間可能です。"]},{"tag":"a","props":{"href":"/ja/tip/30-12"},"children":[{"tag":"span","props":{},"children":["12"]},"視力不良と判明した際、眼科で散瞳検査を受け、その後医師の指示に従って経過観察を行う"]},{"tag":"a","props":{"href":"/ja/tip/30-13"},"children":[{"tag":"span","props":{},"children":["13"]},"永久臼歯が生えた後のシーラント（窩溝裂溝閉鎖）"]},{"tag":"a","props":{"href":"/ja/tip/30-14"},"children":[{"tag":"span","props":{},"children":["14"]},"子供がゲームに夢中な時、単にプレイ時間だけを見るのではなく、睡眠、宿題、外出活動が削られていないかを確認しましょう"]},{"tag":"a","props":{"href":"/ja/tip/30-15"},"children":[{"tag":"span","props":{},"children":["15"]},"子供が同性が好きだと言っても、責めたり、家から追い出したり、「矯正」しようとしたりしないで：家庭の態度は子供の自殺リスクに関係しています"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/ja/tip/30-16","data-status":"active"},"children":[{"tag":"span","props":{},"children":["16"]},"子供を叩かない、怒鳴ったり「バカ」と罵ったりもしないで：体罰や罵倒を日常的に受けている子供は、行動面・情緒面の問題がより多く見られる"]},{"tag":"a","props":{"href":"/ja/tip/30-17"},"children":[{"tag":"span","props":{},"children":["17"]},"子供のしつけが難しく、つい叩いたり怒鳴ったりしてしまう方へ：具体的な手法を教える前回の親向け講座へ"]},{"tag":"a","props":{"href":"/ja/tip/30-18"},"children":[{"tag":"span","props":{},"children":["18"]},"子どもを閉鎖管理の「ネット依存矯正学校」「特訓キャンプ」に送らない。心身を傷つける矯正は法律で禁止され、監禁で死亡した子どももいる"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"現在地"},"children":[{"tag":"a","props":{"href":"/ja/book"},"children":["本を読む"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/ja/book/30"},"children":["第30章"," ·"," ","就学後の子ども"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"30-16"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["16"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["エビデンス"," ","A"]}]},{"tag":"h1","props":{"lang":"ja"},"children":["子供を叩かない、怒鳴ったり「バカ」と罵ったりもしないで：体罰や罵倒を日常的に受けている子供は、行動面・情緒面の問題がより多く見られる"]},{"tag":"p","props":{"lang":"ja","className":"life-entry-summary"},"children":["日常的に叩かれている子供は、攻撃性や心理的問題が多く、親とも疎遠になりやすく、より激しい体罰を受ける頻度も高くなります。叩くことでその場での従順さが得られるかどうかについては、証拠が不十分です。13 歳時に頻繁に怒鳴られたり、バカだと罵られたりした子供は、その後の問題行動や抑圧症状の増加が見られ、親が普段どれほど愛情深く接していても、その悪影響を打ち消すことはできません。"]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["費用・手間"]},{"tag":"p","props":{},"children":["費用はかかりません。難しいのは、怒りが頂点に達した瞬間に手と口を止めることであり、さらに叩いたり怒鳴ったりしない別の…"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["効果"]},{"tag":"p","props":{},"children":["まずは「叩くこと」について見ていきましょう。あるメタ分析では、「手を広げてお尻を叩く、あるいは手足に叩く」という一種類のみを対象としています。"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"記録する：子供を叩かない、怒鳴ったり「バカ」と罵ったりもしないで：体罰や罵倒を日常的に受けている子供は、行動面・情緒面の問題がより多く見られる"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"できている"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"やることに追加"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"お気に入り"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"このヒントを共有"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"詳細を閉じる"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["費用・手間"]},{"tag":"p","props":{},"children":["費用はかかりません。難しいのは、怒りが頂点に達した瞬間に手と口を止めることであり、さらに叩いたり怒鳴ったりしない別の指導法に切り替えなければならない点です。どのような指導法に切り替えるべきかは、本節の第 17 条（具体的な実践方法を教える親向け講座）を参照してください。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["効果"]},{"tag":"p","props":{},"children":["まずは「叩くこと」について見ていきましょう。あるメタ分析では、「手を広げてお尻を叩く、あるいは手足に叩く」という一種類のみを対象としています。これは 75 件の研究、111 個の効果量、計 160,927 人の子供をまとめたものです。17 件の結果のうち 13 件が体罰と明確に関連しており、その方向性はすべて悪影響でした。d は効果量で、0.2 は小、0.5 は中程度とみなされます。幼少期の攻撃性は d = 0.37（95% CI 0.13–0.61、信頼区間）でした。外顕化問題（他害やルール違反など）は 0.41。内在化問題（不安や抑圧など）は 0.24。心理的健康問題は 0.53、親との関係の悪さは 0.51、自尊心の低さは 0.15、認知能力の低さは 0.17。親による身体的虐待は 0.64。成人後の反社会的な行動は 0.36、心理的健康問題は 0.24。111 個の効果量を合わせると d = 0.33（0.29–0.38）です。子供がその場で従うかどうかと、体罰の有無には明確な関連は見られませんでした（d = 0.14、−0.19–0.47）、この項目については 5 個の効果量のみです。別のレビューでは、前後比較研究のみを対象としており、計 69 件でした。体罰は、その後の子供の問題行動の増加を安定して予測しており、長期的な好結果との関連は見られませんでした。そのうち 7 件の研究では叩く回数を調査しており、5 件において「叩く回数が多いほど、問題が深刻である」ことが判明しました。次に「怒鳴り・罵倒」についてです。アメリカのある研究では、976 の両親が揃っている家庭を追跡しました。子供が 13 歳の時に、親が頻繁に怒鳴る、汚い言葉を使う、子供を「バカ」や「怠け者」と罵る場合、13 歳から 14 歳の間で問題行動と抑圧症状の両方が増加しました。親が普段どれほど親密であっても、この関連を相殺することはできません。逆もまた然りです。13 歳時に問題行動が多い子供は、その後の罵倒を受ける頻度も高くなります。法律上、親は子供に対して家庭内暴力（DV）を行ってはなりません。『反家庭暴力法』第2条には、家庭暴力の形態として、殴打、拘束、身体的損傷、身体の自由の制限、および頻繁な罵倒や脅迫が列挙されています。同法第12条は、保護者が文明的な方法で家庭教育を行うことを求めています。親が子供の権利を侵害した場合、居委会や村委会は諭し、阻止しなければならず、事態が深刻な場合は公安に報告しなければなりません。公安、検察庁、裁判所が発見した場合は、親に訓戒を与え、家庭教育指導の受講を命じることができるものとします（全国共通）。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["出典"]},{"tag":"p","props":{"className":"life-citations"},"children":["Gershoff ET, Grogan-Kaylor A. (2016). Spanking and child outcomes: Old controversies and new meta-analyses. Journal of Family Psychology, 30(4), 453–469. ",{"tag":"a","props":{"href":"https://doi.org/10.1037/fam0000191","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1037/fam0000191"]},"；Heilmann A, Mehay A, Watt RG, et al. (2021). Physical punishment and child outcomes: a narrative review of prospective studies. Lancet, 398(10297), 355–364. ",{"tag":"a","props":{"href":"https://doi.org/10.1016/S0140-6736(21)00582-1","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1016/S0140-6736(21)00582-1"]},"；Wang MT, Kenny S. (2014). Longitudinal links between fathers' and mothers' harsh verbal discipline and adolescents' conduct problems and depressive symptoms. Child Development, 85(3), 908–923. ",{"tag":"a","props":{"href":"https://doi.org/10.1111/cdev.12143","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1111/cdev.12143"]},"；Ferguson CJ. (2013). Spanking, corporal punishment and negative long-term outcomes: a meta-analytic review of longitudinal studies. Clinical Psychology Review, 33(1), 196–208. ",{"tag":"a","props":{"href":"https://doi.org/10.1016/j.cpr.2012.11.002","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1016/j.cpr.2012.11.002"]},"；Larzelere RE, Kuhn BR. (2005). Comparing child outcomes of physical punishment and alternative disciplinary tactics: a meta-analysis. Clinical Child and Family Psychology Review, 8(1), 1–37. ",{"tag":"a","props":{"href":"https://doi.org/10.1007/s10567-005-2340-z","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1007/s10567-005-2340-z"]},"；全国人大常委会 (2015). 反家庭暴力法（第二、十二条）. ",{"tag":"a","props":{"href":"https://flk.npc.gov.cn/detail?id=2c909fdd678bf17901678bf7f9d60889","target":"_blank","rel":"noopener noreferrer"},"children":["https://flk.npc.gov.cn/detail?id=2c909fdd678bf17901678bf7f9d60889"]},"；全国人大常委会 (2024 年修正). 未成年人保护法（第十一、十七、一百一十八条）. ",{"tag":"a","props":{"href":"https://flk.npc.gov.cn/detail?id=ff8081818f197cf001905e567af635a0","target":"_blank","rel":"noopener noreferrer"},"children":["https://flk.npc.gov.cn/detail?id=ff8081818f197cf001905e567af635a0"]},"；全国人大常委会 (2021). 家庭教育促进法（第二十三、五十三条）. ",{"tag":"a","props":{"href":"https://flk.npc.gov.cn/detail?id=ff8081817cac3b2d017cac5a6c6f0109","target":"_blank","rel":"noopener noreferrer"},"children":["https://flk.npc.gov.cn/detail?id=ff8081817cac3b2d017cac5a6c6f0109"]}]},{"tag":"a","props":{"href":"https://doi.org/10.1037/fam0000191","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["出典を開く"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["著者の注記"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["論争点。これらの研究のほとんどは追跡記録のみであり、対照群を用いた比較ではないため、どちらが原因であるかを断定することはできません。お尻を叩く件のメタ分析では、72% の研究が「2つの事象が同時に起こるか」あるいは「事後の回想」のみを見ています。もう一つのメタ分析では、前後比較研究のみを対象としており、子供の元々の行動を除外したところ、お尻を叩くことと外顕化問題の関連は 0.07 に、内在化問題との関連は 0.10 にまで減少しました。その著者は、影響は極めて小さいと考えています。また、別のメタ分析では、「条件付きの体罰」は、不従順や反社会的な行動を減らす上で、他の 13 種類の指導法のうち 10 種類よりも効果が高いことが判明しています。ただし、体罰が過度である、あるいは体罰を主とする場合は、他の指導法よりも劣ることも判明しています。したがって、反対派が説明できるのは、「少量かつ条件付きの体罰は、必ずしも他の指導法より劣るわけではない」ということです。一方で、激しい体罰や、頻繁な叩き・罵倒は、双方の立場から見てより悪いとされています。たまに叩いたり、一度怒鳴ったりすることが、法条文において直ちに家庭暴力と明記されているわけではありません。法が指しているのは、殴打および頻繁な罵倒や脅迫です。受益者は主に子供です。家族の他の人が子供を叩いている場合は、通報および保護命令の申請については第 8 節第 43 条（人身安全保護命令）を参照してください。他人の家庭で長期的な体罰を目撃した場合、誰でも制止したり、公安、民政、教育部門に通報したりする権利があります。見知らぬ家庭の事案については、110番に電話するか、居委会に伝えるだけで十分であり、自分自身で乗り込んで仲裁しようとはしないでください。"]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["自分のメモ"]},{"tag":"button","props":{"type":"button"},"children":["自分へのメモを書く…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/ja/tip/30-15"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["前へ"]},"子供が同性が好きだと言っても、責めたり、家から追い出したり、「矯正」しようとしたりしないで：家庭の態度は子供の自殺リスクに関係しています"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/ja/tip/30-17"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["次へ"]},"子供のしつけが難しく、つい叩いたり怒鳴ったりしてしまう方へ：具体的な手法を教える前回の親向け講座へ"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["このテーマの他の提案"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/30-10"},"children":[{"tag":"strong","props":{},"children":["睡眠、授業、体育、順位に関する明文規定があり、学校が守れていない場合は指摘可能です"]},{"tag":"span","props":{},"children":["文書には、小学生は毎日 10 時間、中学生は 9 時間、高校生は 8 時間の睡眠をとるべきであると明記されています。小学校の授業開始は通常…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/30-11"},"children":[{"tag":"strong","props":{},"children":["子供が限界な場合は休学が可能です。学籍は学校が必ず保持しなければならず、最長 1 年間可能です。"]},{"tag":"span","props":{},"children":["休学には正式な制度があります。保護者またはその他の法定代理人が申請を行い、学校が確認した後に上級機関の承認を得ます。一度の期間は最長 1 …"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/30-12"},"children":[{"tag":"strong","props":{},"children":["視力不良と判明した際、眼科で散瞳検査を受け、その後医師の指示に従って経過観察を行う"]},{"tag":"span","props":{},"children":["散瞳検査とは、まず点眼薬を使用して目のピント調節を司る筋肉を弛緩させ、その後に屈折度を測定する方法です。これは病院で行うもので、近視の診断…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/30-13"},"children":[{"tag":"strong","props":{},"children":["永久臼歯が生えた後のシーラント（窩溝裂溝閉鎖）"]},{"tag":"span","props":{},"children":["シーラントとは、奥歯の噛み合わせ面に溝がある部分をレジンで封鎖し、食べかすが詰まらないようにする処置です。処置後2年間は、虫歯になる確率が…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/30-14"},"children":[{"tag":"strong","props":{},"children":["子供がゲームに夢中な時、単にプレイ時間だけを見るのではなく、睡眠、宿題、外出活動が削られていないかを確認しましょう"]},{"tag":"span","props":{},"children":["真に「ゲーム障害」と呼べるレベルの人は、100人中2〜3人程度です。アンケートの基準が低かったり、青少年を対象に絞って調査したりすると、割…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/30-18"},"children":[{"tag":"strong","props":{},"children":["子どもを閉鎖管理の「ネット依存矯正学校」「特訓キャンプ」に送らない。心身を傷つける矯正は法律で禁止され、監禁で死亡した子どももいる"]},{"tag":"span","props":{},"children":["子どもの心身を傷つけてネット依存を矯正することは、法律で明確に禁止されています。合肥の特訓学校では、入ったばかりの男子を隔離室で手錠につな…"]}]}]}]},{"tag":"a","props":{"className":"life-text-link","href":"/ja/book/30"},"children":["テーマ全体を読む：就学後の子ども"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"15","height":"15","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]}]}]},{"tag":"nav","props":{"className":"life-tabbar","aria-label":"メインナビゲーション"},"children":[{"tag":"a","props":{"className":"","href":"/ja/book"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"21","height":"21","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-book-open","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M12 7v14"},"children":[]},{"tag":"path","props":{"d":"M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z"},"children":[]}]},{"tag":"span","props":{},"children":["本"]}]},{"tag":"a","props":{"className":"","href":"/ja/top-50"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"21","height":"21","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-star","aria-hidden":"true"},"children":