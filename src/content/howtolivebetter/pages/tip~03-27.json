,"props":{},"children":["23"]},"生气时别靠打沙袋、跑一圈来发泄，先让身体慢下来"]},{"tag":"a","props":{"href":"/tip/03-24","className":""},"children":[{"tag":"span","props":{},"children":["24"]},"心里压着一件事，可以连着几天把想法和感受写下来，但别指望它治病"]},{"tag":"a","props":{"href":"/tip/03-25","className":""},"children":[{"tag":"span","props":{},"children":["25"]},"痛经就吃布洛芬这类止痛药，别硬扛；痛到耽误上班上学、吃三个月药也压不住，就去妇科查"]},{"tag":"a","props":{"href":"/tip/03-26","className":""},"children":[{"tag":"span","props":{},"children":["26"]},"长期失眠（一周三晚以上、拖了三个月以上）先做失眠的认知行为治疗，别一上来就长期吃安眠药"]},{"tag":"a","props":{"href":"/tip/03-27","className":"active"},"children":[{"tag":"span","props":{},"children":["27"]},"打鼾很响、有人看见你睡着时憋气、白天困到开车都想睡的，去医院做睡眠监测查睡眠呼吸暂停，中重度的夜里戴呼吸机"]}]}]},{"tag":"div","props":{"className":"life-tip-page","data-tip-locales":"zh"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"当前位置"},"children":[{"tag":"a","props":{"href":"/book"},"children":["阅读全书"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/book/03"},"children":["第 3 章 · 不要浪费精力"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"03-27"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["27"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["证据 A"]}]},{"tag":"h1","props":{"lang":"zh"},"children":["打鼾很响、有人看见你睡着时憋气、白天困到开车都想睡的，去医院做睡眠监测查睡眠呼吸暂停，中重度的夜里戴呼吸机"]},{"tag":"p","props":{"lang":"zh","className":"life-entry-summary"},"children":["睡眠呼吸暂停是睡着后呼吸一阵阵停住或变浅，人会憋醒，白天就犯困。戴呼吸机后，白天的困劲明显减轻，开车出事少约七成。但试验没看出它能防心脏病、能让人少死，戴它是为了白天清醒。"]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["成本"]},{"tag":"p","props":{},"children":["先去医院的睡眠门诊、呼吸科或耳鼻喉科。确诊要做一晚睡眠监测，在医院睡，或者把仪器借回家戴着睡。要戴呼吸机的，机器一般得自己买，是一笔不小的钱。难在坚持：每晚都要戴着面罩睡，头几周不习惯，不少人戴几个小时就摘了。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["收益"]},{"tag":"p","props":{},"children":["美国睡眠医学会 2017 年的诊断指南写了谁更可能是中重度。大多数日子白天特别困，再加上下面三条里的至少两条。一是经常大声打鼾，二是有人看见你睡着时停止呼吸、喘气或呛醒，三是已经查出高血压。指南要求用睡眠监测确诊，不能只靠问卷。每小时呼吸停顿或变浅 5 次以上并有症状，就算这个病。不管有没有症状，1…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"标记：打鼾很响、有人看见你睡着时憋气、白天困到开车都想睡的，去医院做睡眠监测查睡眠呼吸暂停，中重度的夜里戴呼吸机"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"已做到"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"加入待做"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"收藏"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"分享这条建议"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"收起详情"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["成本"]},{"tag":"p","props":{"className":"life-citations"},"children":["先去医院的睡眠门诊、呼吸科或耳鼻喉科。确诊要做一晚睡眠监测，在医院睡，或者把仪器借回家戴着睡。要戴呼吸机的，机器一般得自己买，是一笔不小的钱。难在坚持：每晚都要戴着面罩睡，头几周不习惯，不少人戴几个小时就摘了。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["收益"]},{"tag":"p","props":{"className":"life-citations"},"children":["美国睡眠医学会 2017 年的诊断指南写了谁更可能是中重度。大多数日子白天特别困，再加上下面三条里的至少两条。一是经常大声打鼾，二是有人看见你睡着时停止呼吸、喘气或呛醒，三是已经查出高血压。指南要求用睡眠监测确诊，不能只靠问卷。每小时呼吸停顿或变浅 5 次以上并有症状，就算这个病。不管有没有症状，15 次以上也算。美国睡眠医学会 2019 年的系统综述合了 38 项随机对照试验。和不治疗比，戴呼吸机的人自评困倦分数降了 2.4 分（95% CI 1.9–2.8，可信范围）。这个分数叫 Epworth 嗜睡量表，满分 24 分，越高越困。只算本来不困的人，5 项试验降了 1.0 分，作者认为没有临床意义。同一综述合了 10 项治疗前后对比的研究。戴呼吸机后车祸率是治疗前的 0.3 倍（RR 0.3，0.2–0.4），少约七成。2010 年另一篇分析合了 9 项同类研究，结果是 RR 0.278（0.22–0.35）。它还说，戴一晚白天困倦就明显减轻，模拟开车的表现 2 到 7 天内变好。2009 年同一组作者的分析说，没治疗的病人出车祸的风险大致是别人的 1.21 到 4.89 倍。再看心脏和寿命。SAVE 试验找了 2717 名 45 到 75 岁的中重度病人，都有冠心病或中风过。随机分组后平均跟了 3.7 年。出心脑血管事件的，戴呼吸机的是 17.0%，不戴的是 15.4%。两组没有差别（HR 1.10，0.91–1.32）。戴的人平均每晚只戴 3.3 小时。他们的打鼾、白天困倦、生活质量和情绪都改善了。2017 年一项分析合了 10 项随机试验、7266 人。总死亡率也没有差别（RR 1.13，0.99–1.29）。2019 年一项估算说，中国 30 到 69 岁的人里约 1.76 亿有这个病，占 23.6%。其中中重度约 6552 万，占 8.8%，人数全世界最多。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["来源"]},{"tag":"p","props":{"className":"life-citations"},"children":["Kapur VK, Auckley DH, Chowdhuri S, 等 (2017). Clinical Practice Guideline for Diagnostic Testing for Adult Obstructive Sleep Apnea: An American Academy of Sleep Medicine Clinical Practice Guideline. Journal of Clinical Sleep Medicine, 13(3):479-504. ",{"tag":"a","props":{"href":"https://doi.org/10.5664/jcsm.6506","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.5664/jcsm.6506"]},"；Patil SP, Ayappa IA, Caples SM, Kimoff RJ, Patel SR, Harrod CG (2019). Treatment of Adult Obstructive Sleep Apnea With Positive Airway Pressure: An American Academy of Sleep Medicine Systematic Review, Meta-Analysis, and GRADE Assessment. Journal of Clinical Sleep Medicine, 15(2):301-334. ",{"tag":"a","props":{"href":"https://doi.org/10.5664/jcsm.7638","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.5664/jcsm.7638"]},"；Tregear S, Reston J, Schoelles K, Phillips B (2010). Continuous positive airway pressure reduces risk of motor vehicle crash among drivers with obstructive sleep apnea: systematic review and meta-analysis. Sleep, 33(10):1373-1380. ",{"tag":"a","props":{"href":"https://doi.org/10.1093/sleep/33.10.1373","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1093/sleep/33.10.1373"]},"；Tregear S, Reston J, Schoelles K, Phillips B (2009). Obstructive sleep apnea and risk of motor vehicle crash: systematic review and meta-analysis. Journal of Clinical Sleep Medicine, 5(6):573-581. ",{"tag":"a","props":{"href":"https://pubmed.ncbi.nlm.nih.gov/20465027/","target":"_blank","rel":"noopener noreferrer"},"children":["https://pubmed.ncbi.nlm.nih.gov/20465027/"]},"；McEvoy RD, Antic NA, Heeley E, 等 (2016). CPAP for Prevention of Cardiovascular Events in Obstructive Sleep Apnea. New England Journal of Medicine, 375(10):919-931. ",{"tag":"a","props":{"href":"https://doi.org/10.1056/NEJMoa1606599","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1056/NEJMoa1606599"]},"；Yu J, Zhou Z, McEvoy RD, 等 (2017). Association of Positive Airway Pressure With Cardiovascular Events and Death in Adults With Sleep Apnea: A Systematic Review and Meta-analysis. JAMA, 318(2):156-166. ",{"tag":"a","props":{"href":"https://doi.org/10.1001/jama.2017.7967","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1001/jama.2017.7967"]},"；Benjafield AV, Ayas NT, Eastwood PR, 等 (2019). Estimation of the global prevalence and burden of obstructive sleep apnoea: a literature-based analysis. The Lancet Respiratory Medicine, 7(8):687-698. ",{"tag":"a","props":{"href":"https://doi.org/10.1016/S2213-2600(19)30198-5","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1016/S2213-2600(19)30198-5"]},"；US Preventive Services Task Force (2022). Screening for Obstructive Sleep Apnea in Adults: US Preventive Services Task Force Recommendation Statement. JAMA, 328(19):1945-1950. ",{"tag":"a","props":{"href":"https://doi.org/10.1001/jama.2022.20304","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1001/jama.2022.20304"]},""]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["原书备注"]},{"tag":"p","props":{"className":"life-citations"},"children":["争议。呼吸机能不能防心脏病、让人多活，随机试验没看出来。SAVE 里的人大多不怎么困，戴得也少。但 2017 年那项分析按戴的时长分开算，也没看出差别。车祸那组数字来自治疗前后对比，不是随机分组，研究里的人治疗后可能本来就更小心。中国的人数只按 2005 年一项 3648 人的研究推算，这项估算由呼吸机厂商出资。美国预防服务工作组 2022 年说，给没症状的人普查，好处坏处都说不清。所以不打鼾、白天也不困的人，不必专门去查。收益定中是判断：困倦分数降 2.4 分，没量出每天多清醒几小时。挂哪个科是作者经验（C 级），各医院不一样。开车犯困先停车，见第 1 节第 9 条（困了就停车歇）。白天要长睡的，见第 2 节第 37 条（午睡超过一小时就去查原因）。长期失眠见本节第 26 条（长期失眠）。受益人主要是你自己，同车的人和路上的人也跟着受益。"]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["我的备注"]},{"tag":"button","props":{"type":"button"},"children":["写下对自己有用的提醒…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/tip/03-26"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["上一条"]},"长期失眠（一周三晚以上、拖了三个月以上）先做失眠的认知行为治疗，别一上来就长期吃安眠药"]}]},{"tag":"span","props":{},"children":[]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["本主题的其他建议"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/03-03"},"children":[{"tag":"strong","props":{},"children":["每晚睡够 7 到 8 小时，别把 6 小时当作够用"]},{"tag":"span","props":{},"children":["连着两周每晚只睡 6 小时，脑子的表现会掉到相当于两天两夜没合眼的水平。麻烦的是自己感觉不到。自己打分的困倦头几天涨完就不再涨，睡 6 小时的人和睡 4 小时的…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/03-04"},"children":[{"tag":"strong","props":{},"children":["下午两点以后不碰咖啡因"]},{"tag":"span","props":{},"children":["睡前 6 小时吃下 400 mg 咖啡因，差不多是三四杯咖啡，当晚用仪器测出来少睡 1 小时以上。可自己写的睡眠日记根本看不出差别。一杯 250 mL 的咖啡（…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/03-05"},"children":[{"tag":"strong","props":{},"children":["把邮件和消息改成每天固定几次批量处理"]},{"tag":"span","props":{},"children":["同一批人对比了两周。把邮件限制成每天只查 3 次的那一周，日常压力明显更低，而收发的邮件数量一样多。不加限制的时候，人平均每天要查 15.5 次。"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/03-06"},"children":[{"tag":"strong","props":{},"children":["做需要连续思考的工作时，把哪怕几秒钟的打断也挡在外面"]},{"tag":"span","props":{},"children":["一次平均 2.8 秒的打断，就让接下来的操作出错概率翻倍。4.4 秒的打断翻三倍。现场跟踪还发现，被打断的那件事平均要 25 分钟才回得来，中间还插进两件别的事…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/03-07"},"children":[{"tag":"strong","props":{},"children":["一次只做一件事，不要边开会边回消息"]},{"tag":"span","props":{},"children":["任务一切换，反应就更慢，也更容易出错。经常同时用好几种媒体的人，并没有练出同时做几件事的本事，反而在任务切换测试上表现更差。"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/03-08"},"children":[{"tag":"strong","props":{},"children":["睡前一小时不看发光屏幕，要看就看纸书或不开屏幕灯的墨水屏"]},{"tag":"span","props":{},"children":["睡前读发光屏幕，比读纸书晚约 10 分钟才睡着。褪黑素被压低 55%。第二天生物钟往后推 1.5 小时以上，早上更困，要更久才清醒。"]}]}]}]},{"tag":"a","props":{"className":"life-text-link","href":"/book/03"},"children":["阅读整个主题：不要浪费精力 ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"15","height":"15","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]}]}]},{"tag":"nav","props":{"className":"life-tabbar","aria-label":"主导航"},"children":[{"tag":"a","props":{"className":"","href":"/book"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"21","height":"21","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-book-open","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M12 7v14"},"children":[]},{"tag":"path","props":{"d":"M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z"},"children":[]}]},{"tag":"span","props":{},"children":["全书"]}]},{"tag":"a","props":{"className":"","href":"/top-50"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"21","height":"21","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-star","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 2.122 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.122 2.122 0 0 0 1.597-1.16z"},"children":[]}]},{"tag":"span","props":{},"children":["精选"]}]},{"tag":"a","props":{"className":"","href":"/daily"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"21","height":"21","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-calendar-check","aria-hidden":"true"},"ch