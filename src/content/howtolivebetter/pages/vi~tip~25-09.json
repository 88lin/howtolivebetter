,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-up-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M7 7h10v10"},"children":[]},{"tag":"path","props":{"d":"M7 17 17 7"},"children":[]}]}]}]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/vi/book/25"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"Quay lại mục lục"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["Sau khi có người qua đời"]},{"tag":"div","props":{"data-ad-dock-host":"true"},"children":[]},{"tag":"nav","props":{"aria-label":"Các mục trong chương"},"children":[{"tag":"a","props":{"href":"/vi/tip/25-01"},"children":[{"tag":"span","props":{},"children":["01"]},"Người mất ở nhà hay ngoài đời, trước hết phân biệt tử vong bình thường với tử vong bất thường: tai nạn, chết không rõ nguyên nhân, người sống một mình lâu ngày mới bị phát hiện thì báo công an ngay, thi thể và hiện trường đừng đụng vào"]},{"tag":"a","props":{"href":"/vi/tip/25-02"},"children":[{"tag":"span","props":{},"children":["02"]},"Giấy chứng minh tử vong là chìa khoá cho mọi việc phía sau: ai cứu chữa thì người đó cấp, tử vong bình thường tại nhà thì tìm cơ sở y tế cộng đồng, ký trong một ngày"]},{"tag":"a","props":{"href":"/vi/tip/25-03"},"children":[{"tag":"span","props":{},"children":["03"]},"Vận chuyển, lưu giữ và thiêu thi thể chỉ làm được ở nhà tang lễ, kho lưu thi thể của bệnh viện không làm tang nghiệp, lưu giữ thường không quá 3 ngày"]},{"tag":"a","props":{"href":"/vi/tip/25-04"},"children":[{"tag":"span","props":{},"children":["04"]},"Bất đồng về nguyên nhân tử vong thì trong 48 giờ phải yêu cầu mổ xác, đồng thời niêm phong hồ sơ bệnh án"]},{"tag":"a","props":{"href":"/vi/tip/25-05"},"children":[{"tag":"span","props":{},"children":["05"]},"Ở Trung Quốc, xóa hộ khẩu cho người đã mất có thời hạn luật định: thành thị trước khi an táng, nông thôn trong một tháng"]},{"tag":"a","props":{"href":"/vi/tip/25-06"},"children":[{"tag":"span","props":{},"children":["06"]},"Dịch vụ tang chế chia thành mục cơ sở và mục ngoài cơ sở, mục cơ sở có bảng giá, mức thu do pháp luật quy định"]},{"tag":"a","props":{"href":"/vi/tip/25-07"},"children":[{"tag":"span","props":{},"children":["07"]},"Gặp ép mua kèm, thêm tiền ngoài giá niêm yết, tách một dịch vụ thành mấy dịch vụ để thu tiền thì ghi lại và khiếu nại"]},{"tag":"a","props":{"href":"/vi/tip/25-08"},"children":[{"tag":"span","props":{},"children":["08"]},"Môi giới tang chế, môi giới mua tang phẩm, tổ chức và dẫn dắt tang sự phải đăng ký với cơ quan dân vụ cấp huyện"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/vi/tip/25-09","data-status":"active"},"children":[{"tag":"span","props":{},"children":["09"]},"Tiền nằm rải rác các nơi thì phải đi lấy từng chỗ: số dư quỹ tích góp nhà ở, quyền lợi bảo hiểm xã hội, quyền lợi tai nạn lao động"]},{"tag":"a","props":{"href":"/vi/tip/25-10"},"children":[{"tag":"span","props":{},"children":["10"]},"Tài khoản và thông tin cá nhân của người đã mất, người thân gần có quyền yêu cầu tra cứu, sao chép, sửa, xoá"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"Breadcrumbs"},"children":[{"tag":"a","props":{"href":"/vi/book"},"children":["Khám phá cuốn sách"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]}