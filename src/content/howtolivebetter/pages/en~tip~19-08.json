"props":{"className":"life-ad-rail","data-dock-active":"false","style":{"top":"94px"}},"children":[{"tag":"div","props":{"className":"life-ad-dock","hidden":true},"children":[{"tag":"aside","props":{"className":"life-ad-space life-ad-space-sponsored life-ad-space-compact","data-ad-placement":"ad_dock","data-ad-group":"reading","data-ad-creative":"read_product","data-ad-ready":"false","aria-label":"Advertisement · Community recommendation"},"children":[{"tag":"button","props":{"type":"button","className":"life-ad-dismiss","aria-label":"Close ad"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-x","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M18 6 6 18"},"children":[]},{"tag":"path","props":{"d":"m6 6 12 12"},"children":[]}]}]},{"tag":"div","props":{"className":"life-ad-space-brand"},"children":[{"tag":"img","props":{"src":"/sites/howtolivebetter/images/shengcai/logo.png","width":"565","height":"144","alt":"Official Shengcai Youshu logo","decoding":"async"},"children":[]}]},{"tag":"div","props":{"className":"life-ad-space-copy"},"children":[{"tag":"span","props":{"className":"life-ad-space-label"},"children":["Advertisement · Community recommendation"]},{"tag":"strong","props":{},"children":["Could what you know become a useful product?"]},{"tag":"p","props":{},"children":["From ebooks to small tools, explore how members spot needs and turn knowledge into something people can use."]}]},{"tag":"div","props":{"className":"life-ad-space-actions"},"children":[{"tag":"a","props":{"className":"life-ad-space-link","href":"/en/shengcaiyoushu?sc_group=reading&sc_creative=read_product&sc_placement=ad_dock"},"children":["Explore the community and examples",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"18","height":"18","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-up-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M7 7h10v10"},"children":[]},{"tag":"path","props":{"d":"M7 17 17 7"},"children":[]}]}]}]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/en/book/19"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"Back to index"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["While employed, upon leaving the job, and for work‑related injuries"]},{"tag":"div","props":{"data-ad-dock-host":"true"},"children":[]},{"tag":"nav","props":{"aria-label":"Chapter entries"},"children":[{"tag":"a","props":{"href":"/en/tip/19-01"},"children":[{"tag":"span","props":{},"children":["01"]},"Overtime pay is calculated at three rates: 1.5×, 2×, and 3× the regular wage; failure to pay warrants a complaint to labor authorities, and non‑payment after the deadline incurs an additional penalty of 50%–100% of the owed amount"]},{"tag":"a","props":{"href":"/en/tip/19-02"},"children":[{"tag":"span","props":{},"children":["02"]},"Annual leave is calculated based on total years of service: 5, 10, or 15 days. If unused, employees receive 300% of their daily wage as compensation"]},{"tag":"a","props":{"href":"/en/tip/19-03"},"children":[{"tag":"span","props":{},"children":["03"]},"There is a legal limit on probation periods, wages must be at least 80% of the regular rate, and only one probation period may be set per employee"]},{"tag":"a","props":{"href":"/en/tip/19-04"},"children":[{"tag":"span","props":{},"children":["04"]},"Calculating N: One month’s salary per full year of service; half a month for periods under six months"]},{"tag":"a","props":{"href":"/en/tip/19-05"},"children":[{"tag":"span","props":{},"children":["05"]},"If a company fires you without 30 days’ notice, it must pay an extra month’s salary"]},{"tag":"a","props":{"href":"/en/tip/19-06"},"children":[{"tag":"span","props":{},"children":["06"]},"When a company unlawfully terminates employment, the compensation equals twice the standard severance amount"]},{"tag":"a","props":{"href":"/en/tip/19-07"},"children":[{"tag":"span","props":{},"children":["07"]},"Never sign “voluntary resignation for personal reasons”; doing so forfeits your entitlements"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/en/tip/19-08","data-status":"active"},"children":[{"tag":"span","props":{},"children":["08"]},"Save pay stubs, attendance records, employment contracts, social insurance documents, and chat logs before leaving your job"]},{"tag":"a","props":{"href":"/en/tip/19-09"},"children":[{"tag":"span","props":{},"children":["09"]},"Before taking up a post where there is dust, noise, or chemicals, check whether the contract mentions any occupational hazards; the employer must arrange and pay for three occupational health examinations"]},{"tag":"a","props":{"href":"/en/tip/19-10"},"children":[{"tag":"span","props":{},"children":["10"]},"Damage caused by dust, noise, and chemical toxins is irreversible: employers must provide protective gear, and workers can refuse unsafe tasks"]},{"tag":"a","props":{"href":"/en/tip/19-11"},"children":[{"tag":"span","props":{},"children":["11"]},"If you’re injured at work or hit while commuting, the first step is to get a work‑injury determination; if your employer won’t file it, you must do it yourself"]},{"tag":"a","props":{"href":"/en/tip/19-12"},"children":[{"tag":"span","props":{},"children":["12"]},"Don’t believe the myth that “staying at work counts as a workplace injury”: if you suddenly feel unwell, call 120 first — don’t rush to clock in"]},{"tag":"a","props":{"href":"/en/tip/19-13"},"children":[{"tag":"span","props":{},"children":["13"]},"Even if the employer fails to enroll you in workers’ compensation insurance, you still qualify for full benefits paid entirely by the employer at the same rates"]},{"tag":"a","props":{"href":"/en/tip/19-14"},"children":[{"tag":"span","props":{},"children":["14"]},"After injuries stabilize, undergo a work capacity assessment; disability grades translate directly into compensation"]},{"tag":"a","props":{"href":"/en/tip/19-15"},"children":[{"tag":"span","props":{},"children":["15"]},"Three types of compensation for work-related deaths: funeral allowance, survivor’s pension, and one-time death benefit"]},{"tag":"a","props":{"href":"/en/tip/19-16"},"children":[{"tag":"span","props":{},"children":["16"]},"If you’ve been bullied, insulted, or mistreated at work for a long time, don’t just endure it: document everything as evidence, then take action based on the nature of the abuse"]},{"tag":"a","props":{"href":"/en/tip/19-17"},"children":[{"tag":"span","props":{},"children":["17"]},"When you leave a job, ask the employer for a termination certificate stating contract term, separation date, position, and years of service"]},{"tag":"a","props":{"href":"/en/tip/19-18"},"children":[{"tag":"span","props":{},"children":["18"]},"Before spending severance pay, check individual income tax: amounts within three times the local prior-year average employee wage are tax-free; the excess is taxed separately, not merged into that year’s salary"]},{"tag":"a","props":{"href":"/en/tip/19-19"},"children":[{"tag":"span","props":{},"children":["19"]},"When moving to another city for work, transfer your pension and medical insurance to the new place of enrollment; contribution years keep adding up, so do not withdraw from pension insurance"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"Breadcrumb"},"children":[{"tag":"a","props":{"href":"/en/book"},"children":["Explore the book"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/en/book/19"},"children":["Chapter 19"," ·"," ","While employed, upon leaving the job, and for work‑related injuries"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"19-08"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["08"]},{"tag":"span","props":{"className":"life-evidence grade-b"},"children":["Evidence"," ","B"]}]},{"tag":"h1","props":{"lang":"en"},"children":["Save pay stubs, attendance records, employment contracts, social insurance documents, and chat logs before leaving your job"]},{"tag":"p","props":{"lang":"en","className":"life-entry-summary"},"children":["In China, employers bear the burden of proof for disputes such as dismissal and pay cuts, but you must first prove overtime, and employers only have to retain wage records for two years. Once the computer and account are returned, you lose access. Pay slips, attendance, social-insurance records and original chats give you evidence when the employer denies your claim."]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Cost"]},{"tag":"p","props":{},"children":["No expense required. It takes about half an hour to save a…"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Benefit"]},{"tag":"p","props":{},"children":["After returning the computer and account, these records become inaccessible. In Chinese labor disputes, whoeve…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"Mark: Save pay stubs, attendance records, employment contracts, social insurance documents, and chat logs before leaving your job"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"Done"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"Plan to do"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"Save"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Share this tip"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Hide details"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Cost"]},{"tag":"p","props":{},"children":["No expense required. It takes about half an hour to save all these documents. The tricky part is remembering to do it before you leave."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Benefit"]},{"tag":"p","props":{},"children":["After returning the computer and account, these records become inaccessible. In Chinese labor disputes, whoever makes a claim must prove it. Evidence held by the employer must be produced, with adverse consequences for failure. If you cannot obtain employer-held material during arbitration, the tribunal can require its production by a deadline. Employers bear the burden for dismissal, termination, pay reductions and calculation of service years. Overtime is different: you must first prove that you worked it. Only if you show the employer holds overtime records and refuses to produce them does it bear adverse consequences. Employers must retain payroll records for more than two years and provide an individual pay statement when paying wages. Without a written contract, employment can be proved using payroll records, social-insurance contribution records, work IDs, recruitment forms, attendance records and colleagues' testimony. Chats count as electronic evidence. Submit originals; printouts directly from original records also count as originals. In a Shanghai prosecution-supervision case, a worker sought ten years of minimum-wage shortfalls. The first and second courts recognized only the last two years before departure because employers only need two years of records, leaving the worker to prove the earlier eight. He held ten years of pay slips and bank statements, but the employer disputed the slips' authenticity. In August 2024 he sought procuratorial supervision. After a procuratorial protest, mediation secured an additional 19000 yuan. He had sued when the company dismissed workers in 2021, about three years before seeking supervision (China nationwide)."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Original sources"]},{"tag":"p","props":{"className":"life-citations"},"children":["全国人大常委会 (2007). 劳动争议调解仲裁法（第六、三十九条）. ",{"tag":"a","props":{"href":"https://rsj.ankang.gov.cn/Content-2150407.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://rsj.ankang.gov.cn/Content-2150407.html"]},"（安康市人力资源和社会保障局转载）；最高人民法院 (2020). 关于审理劳动争议案件适用法律问题的解释（一）（法释〔2020〕26 号，第四十二、四十四条）. ",{"tag":"a","props":{"href":"https://www.court.gov.cn/fabu/xiangqing/282121.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.court.gov.cn/fabu/xiangqing/282121.html"]},"；最高人民法院 (2019). 关于民事诉讼证据的若干规定（法释〔2019〕19 号，第十四、十五条）. ",{"tag":"a","props":{"href":"https://www.court.gov.cn/zixun/xiangqing/212721.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.court.gov.cn/zixun/xiangqing/212721.html"]},"；劳动部 (1994). 工资支付暂行规定（第六条），黑龙江省人民政府「政策帮你问」引述. ",{"tag":"a","props":{"href":"https://www.hlj.gov.cn/hlj/c116413/202402/c00_31712524.shtml","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.hlj.gov.cn/hlj/c116413/202402/c00_31712524.shtml"]},"；劳动和社会保障部 (2005). 关于确立劳动关系有关事项的通知（劳社部发〔2005〕12 号），黑龙江省人民政府「政策帮你问」引述. ",{"tag":"a","props":{"href":"https://hlj.gov.cn/hlj/c116413/202408/c00_31757488.shtml","target":"_blank","rel":"noopener noreferrer"},"children":["https://hlj.gov.cn/hlj/c116413/202408/c00_31757488.shtml"]},"；郭勇辉, 边琬茹 (2025). 两年之外的工资支付情况举证责任应由谁承担？检察日报. ",{"tag":"a","props":{"href":"https://www.spp.gov.cn/spp/llyj/202508/t20250806_703164.shtml","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.spp.gov.cn/spp/llyj/202508/t20250806_703164.shtml"]},"（最高人民检察院网站刊载）；维权路径见第 7 节"]},{"tag":"a","props":{"href":"https://rsj.ankang.gov.cn/Content-2150407.html","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Open source link"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Book note"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["Save only your own employment records. Do not take company source code, customer lists or technical documents; see Section 11 for the risks. Do not rely on chat screenshots: keep original records on the phone. Save pay slips and bank statements monthly; years after departure, the employer no longer has to hold records older than two years. The Shanghai case was reversed through a procuratorial protest, a stage most people do not reach. Ask for a departure certificate before leaving; see item 17 (departure certificate)."]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["My note"]},{"tag":"button","props":{"type":"button"},"children":["Write a reminder for yourself…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/en/tip/19-07"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Previous"]},"Never sign “voluntary resignation for personal reasons”; doing 