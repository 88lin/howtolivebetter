,"height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"收藏"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"分享这条建议"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"收起详情"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["成本"]},{"tag":"p","props":{"className":"life-citations"},"children":["看吸入剂用法不另花钱，复诊时把药带上，当面用一遍，几分钟。肺康复是有人带着做的运动训练，加上用药和自我管理的讲解，要按方案去好几次，费用各地不同。难在出院后身体虚，还得坚持去练。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["收益"]},{"tag":"p","props":{"className":"life-citations"},"children":["中国一项全国抽样调查，50991 名 20 岁以上的成年人都做了肺功能检查。慢阻肺的比例是 8.6%（95% CI 7.5–9.9，可信范围），约合 9990 万人。40 岁以上是 13.7%。慢阻肺病人里，以前做过肺功能检查的只有 12.0%。一项分析汇总了 144 篇研究，54354 名病人由受过训练的人当面看着用吸入剂。手法完全正确的占 31%，勉强可以的 41%，差的 31%。前 20 年和后 20 年比，没有改善。用按压式喷雾的，按压和吸气配合不上的占 45%。吸得不够快、不够深的占 44%，吸完不屏气的占 46%。法国一项调查只记录、不分组，医生看了 2935 名慢阻肺病人用吸入剂。超过一半的操作有错。会让药吸不进去的关键错误，各种吸入装置在 15.4% 到 46.9% 之间。过去 3 个月因加重住院或看急诊的，没出错的病人里是 3.3%，出了关键错误的是 6.9%（OR 1.86，1.14–3.04）。GOLD 2023 年报告的摘要写明，要教会医生和病人正确使用吸入装置，复诊时要定期检查。它还建议慢阻肺病人按当地规定打流感、肺炎球菌等疫苗。Cochrane 2016 年的综述汇总了 20 项随机分组试验、1477 人。比较的是慢阻肺急性加重之后做肺康复，和照常护理不做康复。8 项研究、810 人看了再住院。做康复的再住院可能低约 56%（OR 0.44，95% CI 0.21–0.91），证据质量中等。但各研究的结果差别很大。6 项研究、670 人看了死亡，OR 0.68（0.28–1.67），差别可能是碰巧，证据质量低。生活质量的改善超过了病人能感觉到的幅度，证据质量高。6 分钟走路的距离平均多了 62 米（38–86 米），证据质量高"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["来源"]},{"tag":"p","props":{"className":"life-citations"},"children":["Wang C, Xu J, Yang L, et al.; China Pulmonary Health Study Group (2018). Prevalence and risk factors of chronic obstructive pulmonary disease in China (the China Pulmonary Health [CPH] study): a national cross-sectional study. Lancet, 391(10131), 1706-1717. ",{"tag":"a","props":{"href":"https://doi.org/10.1016/S0140-6736(18)30841-9","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1016/S0140-6736(18)30841-9"]},"；Sanchis J, Gich I, Pedersen S; ADMIT (2016). Systematic Review of Errors in Inhaler Use: Has Patient Technique Improved Over Time? Chest, 150(2), 394-406. ",{"tag":"a","props":{"href":"https://doi.org/10.1016/j.chest.2016.03.041","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1016/j.chest.2016.03.041"]},"；Molimard M, Raherison C, Lignot S, et al. (2017). Chronic obstructive pulmonary disease exacerbation and inhaler device handling: real-life assessment of 2935 patients. European Respiratory Journal, 49(2), 1601794. ",{"tag":"a","props":{"href":"https://doi.org/10.1183/13993003.01794-2016","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1183/13993003.01794-2016"]},"；Agustí A, Celli BR, Criner GJ, et al. (2023). Global Initiative for Chronic Obstructive Lung Disease 2023 Report: GOLD Executive Summary. European Respiratory Journal, 61(4), 2300239. ",{"tag":"a","props":{"href":"https://doi.org/10.1183/13993003.00239-2023","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1183/13993003.00239-2023"]},"；Puhan MA, Gimeno-Santos E, Cates CJ, Troosters T (2016). Pulmonary rehabilitation following exacerbations of chronic obstructive pulmonary disease. Cochrane Database of Systematic Reviews, 12, CD005305. ",{"tag":"a","props":{"href":"https://doi.org/10.1002/14651858.CD005305.pub4","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1002/14651858.CD005305.pub4"]},"；Greening NJ, Williams JE, Hussain SF, et al. (2014). An early rehabilitation intervention to enhance recovery during hospital admission for an exacerbation of chronic respiratory disease: randomised controlled trial. BMJ, 349, g4315. ",{"tag":"a","props":{"href":"https://doi.org/10.1136/bmj.g4315","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1136/bmj.g4315"]},"（反方）"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["原书备注"]},{"tag":"p","props":{"className":"life-citations"},"children":["争议：肺康复什么时候开始，说法不一。英国一项随机分组试验在入院 48 小时内就开始练，一年后再住院没有少（HR 1.1）。死亡反而更多（OR 1.74，95% CI 1.05–2.88）。GOLD 2023 年报告的摘要说，出院后头 4 周内开始，效果还不清楚。所以要做的是出院后病情稳下来，按医生的安排去做，住院的急性期别自己加练。Cochrane 那篇综述也写明，新纳入的研究效果比早年的小。吸入剂那两项都是只记录、不分组的调查，没有试验直接证明「复诊时看一遍」能少住院。具体手法每种装置不一样，以说明书和医生的示范为准。流感疫苗见第 1 节第 20 条（流感疫苗），肺炎球菌疫苗见第 1 节第 22 条（肺炎球菌疫苗）。还在抽烟的先戒烟，见第 2 节第 3 条（戒烟别光靠忍，先去拿药）。受益人主要是你自己。"]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["我的备注"]},{"tag":"button","props":{"type":"button"},"children":["写下对自己有用的提醒…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/tip/16-11"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["上一条"]},"查出乙肝表面抗原阳性的，每半年做一次肝脏 B 超加甲胎蛋白，按医生评估决定吃不吃抗病毒药，吃上了别自己停"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/tip/16-13"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["下一条"]},"有糖尿病的每年查一次尿白蛋白肌酐比和血肌酐，有高血压的也要查，早点发现慢性肾病"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["本主题的其他建议"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/16-03"},"children":[{"tag":"strong","props":{},"children":["复查按医生给的间隔做，把每次的指标记在同一个本子上"]},{"tag":"span","props":{},"children":["慢性病看的是一段时间里的变化，不是某一次的数值。光自己在家量血压，看不出血压因此降下来。把读数带给医生、让医生照着调药，血压才降得多一些。换医院时，标着互认标志…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/16-04"},"children":[{"tag":"strong","props":{},"children":["别为了试偏方、保健品停掉正规治疗"]},{"tag":"span","props":{},"children":["本来能治的癌症，只用替代疗法、不做正规治疗的人，死亡风险是正规治疗的 2.5 倍。边治边用补充疗法的人更常拒绝手术、化疗和放疗，多出来的死亡就出在这里。有的草药…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/16-05"},"children":[{"tag":"strong","props":{},"children":["病情稳定的慢性病，在社区医院一次可以开到 12 周的药"]},{"tag":"span","props":{},"children":["病情稳定、吃的药也没换的人，在社区卫生服务中心一次最多能开 12 周的药。省掉每月往返大医院排队挂号的半天。在同一个参保地里，住基层医院的报销比例原则上要比上一…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/16-06"},"children":[{"tag":"strong","props":{},"children":["在社区签家庭医生之前，问清楚哪些进医保、哪些自费"]},{"tag":"span","props":{},"children":["签约的基本服务包按规定走医保。个性化服务包的钱要全部自己出。有人推销「升级包」的时候，先问清楚这是基本包还是个性化包、备没备案、一年多少钱。"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/16-07"},"children":[{"tag":"strong","props":{},"children":["确诊糖尿病就去查一次眼底，之后按医生给的间隔查；每年查一次脚"]},{"tag":"span","props":{},"children":["糖尿病伤到眼底、伤到脚，在坏到看不见、烂起来之前几乎没有感觉。早查出来还有得治。2 型糖尿病确诊当时就查一次散瞳眼底，1 型在发病 5 年后开始查。查过一两次没…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/16-08"},"children":[{"tag":"strong","props":{},"children":["得过肾结石就把水喝到每天 2.5–3 升，盐降到 6 克以内"]},{"tag":"span","props":{},"children":["第一次长了钙结石、又查不出原因的人，什么都不做的话，五年里约四分之一会再长。每天把水喝够的人，五年里复发的只有一成多，少了一半多。英国指南给的量是每天喝 2.5…"]}]}]}]},{"tag":"a","props":{"className":"life-text-link","href":"/book/16"},"children":["阅读整个主题：得了慢性病之后怎么活 ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"15","height":"15","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin