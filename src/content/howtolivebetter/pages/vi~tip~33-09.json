none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-up-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M7 7h10v10"},"children":[]},{"tag":"path","props":{"d":"M7 17 17 7"},"children":[]}]}]}]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/vi/book/33"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"Quay lại mục lục"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["Sống sau khi bị khuyết tật"]},{"tag":"div","props":{"data-ad-dock-host":"true"},"children":[]},{"tag":"nav","props":{"aria-label":"Các mục trong chương"},"children":[{"tag":"a","props":{"href":"/vi/tip/33-01"},"children":[{"tag":"span","props":{},"children":["01"]},"Sau chấn thương tủy sống mà đột nhiên đau đầu dữ dội và ra mồ hôi: đỡ ngồi ngay lên, nới lỏng quần áo, đồng thời gọi 120"]},{"tag":"a","props":{"href":"/vi/tip/33-02"},"children":[{"tag":"span","props":{},"children":["02"]},"Mười năm đầu sau khi bị khuyết tật là giai đoạn nguy cơ tự tử cao, đừng tưởng chỉ cần nghĩ thoáng là xong"]},{"tag":"a","props":{"href":"/vi/tip/33-03"},"children":[{"tag":"span","props":{},"children":["03"]},"Nhập viện điều trị rối loạn tâm thần theo nguyên tắc tự nguyện, chỉ có hai trường hợp được làm mà không cần sự đồng ý của bản thân"]},{"tag":"a","props":{"href":"/vi/tip/33-04"},"children":[{"tag":"span","props":{},"children":["04"]},"Người chăm lâu dài người khuyết tật trong nhà, sức khỏe của chính mình cũng phải có người nhìn"]},{"tag":"a","props":{"href":"/vi/tip/33-05"},"children":[{"tag":"span","props":{},"children":["05"]},"Người ngồi xe lăn lâu thì đổi đệm ngồi sang loại giảm áp, mỗi ngày xem một lượt xương ngồi và xương cùng"]},{"tag":"a","props":{"href":"/vi/tip/33-06"},"children":[{"tag":"span","props":{},"children":["06"]},"Đừng mua các liệu pháp và thiết bị「chữa khỏi bại liệt, mù lòa, điếc」"]},{"tag":"a","props":{"href":"/vi/tip/33-07"},"children":[{"tag":"span","props":{},"children":["07"]},"Có giấy chứng nhận người khuyết tật rồi thì đến hội người khuyết tật cấp huyện hỏi trọn một lần các khoản trợ cấp"]},{"tag":"a","props":{"href":"/vi/tip/33-08"},"children":[{"tag":"span","props":{},"children":["08"]},"Trẻ dưới 7 tuổi có khuyết tật hoặc tự kỷ, đến hội người khuyết tật cấp huyện xin trợ giúp phục hồi chức năng"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/vi/tip/33-09","data-status":"active"},"children":[{"tag":"span","props":{},"children":["09"]},"Lối đi, lan can và cải tạo phòng tắm trong nhà, có thể xin trợ cấp từ chính quyền cấp huyện trở lên"]},{"tag":"a","props":{"href":"/vi/tip/33-10"},"children":[{"tag":"span","props":{},"children":["10"]},"Khi tìm việc ở Trung Quốc, chủ động nói rõ mình có giấy chứng nhận khuyết tật; tuyển bạn có thể giúp doanh nghiệp bớt một khoản phải nộp"]},{"tag":"a","props":{"href":"/vi/tip/33-11"},"children":[{"tag":"span","props":{},"children":["11"]},"Thuế thu nhập cá nhân của người khuyết tật có thể được giảm, giảm bao nhiêu thì gọi điện hỏi cơ quan thuế tỉnh"]},{"tag":"a","props":{"href":"/vi/tip/33-12"},"children":[{"tag":"span","props":{},"children":["12"]},"Chó dẫn đường cho người mù được vào nơi công cộng và phương tiện giao thông công cộng, người mù đi xe buýt trong thành phố miễn phí"]},{"tag":"a","props":{"href":"/vi/tip/33-13"},"children":[{"tag":"span","props":{},"children":["13"]},"Thí sinh khuyết tật dự kỳ thi tuyển sinh đại học có thể xin biện pháp hỗ trợ hợp lý, dùng đề braille thì kéo dài thời gian thi thêm một nửa"]},{"tag":"a","props":{"href":"/vi/tip/33-14"},"children":[{"tag":"span","props":{},"children":["14"]},"Trẻ khuyết tật xin nhập học, nhà trường không được từ chối; trẻ không đến được trường thì phòng giáo dục sắp xếp giảng viên đến tận nhà"]},{"tag":"a","props":{"href":"/vi/tip/33-15"},"children":[{"tag":"span","props":{},"children":["15"]},"Mất hoặc không cử động được hai chi dưới bên phải vẫn thi được giấy phép lái xe, loại xe được phép lái gọi là C5"]},{"tag":"a","props":{"href":"/vi/tip/33-16"},"children":[{"tag":"span","props":{},"children":["16"]},"Phục hồi chức năng làm ở cơ sở chính quy có khoa phục hồi chức năng, cường độ nghe người trị liệu, tập càng nặng càng không tốt"]},{"tag":"a","props":{"href":"/vi/tip/33-17"},"children":[{"tag":"span","props":{},"children":["17"]},"Nghe kém thì đi lắp máy trợ thính, lý do lắp là để nghe rõ, không phải để phòng chứng mất trí nhớ"]},{"tag":"a","props":{"href":"/vi/tip/33-18"},"children":[{"tag":"span","props":{},"children":["18"]},"Nói một người thành niên「không quản lý được việc của mình」thì phải xin tòa án công nhận, người nhà nói không tính"]},{"tag":"a","props":{"href":"/vi/tip/33-19"},"children":[{"tag":"span","props":{},"children":["19"]},"Người giám hộ của người thành niên được xác định theo thứ tự luật định; người được giám hộ gây hại cho người khác thì người giám hộ bồi thường"]},{"tag":"a","props":{"href":"/vi/tip/33-20"},"children":[{"tag":"span","props":{},"children":["20"]},"Bị từ chối tuyển, không được chuyển biên chế, bị trả lương thiếu vì khuyết tật thì có thể kiện, nhưng hãy tính chi phí trong quá trình trước"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"Breadcrumbs"},"children":[{"tag":"a","props":{"href":"/vi/book"},"children":["Khám phá cuốn sách"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/vi/book/33"},"children":["Chương 33"," ·"," ","Sống sau khi bị khuyết tật"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"33-09"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["09"]},{"tag":"span","props":{"className":"life-evidence grade-b"},"children":["Bằng chứng"," ","B"]}]},{"tag":"h1","props":{"lang":"vi"},"children":["Lối đi, lan can và cải tạo phòng tắm trong nhà, có thể xin trợ cấp từ chính quyền cấp huyện trở lên"]},{"tag":"p","props":{"lang":"vi","className":"life-entry-summary"},"children":["Luật Xây dựng môi trường không vật cản (《无障碍环境建设法》) có một điều: chính quyền cấp huyện trở lên phải hỗ trợ, hướng dẫn cải tạo tiện nghi không vật cản trong gia đình, và phải trợ cấp mức độ thích hợp cho gia đình có người khuyết tật, người già thỏa điều kiện. Loại dự án này thường do hội người khuyết tật phụ trách, làm theo hạn ngạch từng năm, nên phải đi đăng ký sớm. Trợ cấp bao nhiêu, sửa mấy hạng mục thì địa phương quy định."]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Chi phí"]},{"tag":"p","props":{},"children":["Nộp đơn không tốn tiền. Phần cải tạo phần lớn có trợ cấp,…"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Lợi ích"]},{"tag":"p","props":{},"children":["Điều mười chín của Luật Xây dựng môi trường không vật cản:「县级以上人民政府应当支持、指导家庭无障碍设施改造。"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"Đánh dấu: Lối đi, lan can và cải tạo phòng tắm trong nhà, có thể xin trợ cấp từ chính quyền cấp huyện trở lên"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"Hoàn tất"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"Kế hoạch thực hiện"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"Lưu"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Chia sẻ mẹo này"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Ẩn chi tiết"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Chi phí"]},{"tag":"p","props":{},"children":["Nộp đơn không tốn tiền. Phần cải tạo phần lớn có trợ cấp, bạn có thể phải bỏ thêm một phần. Phải đi hội người khuyết tật và ủy ban phường."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Lợi ích"]},{"tag":"p","props":{},"children":["Điều mười chín của Luật Xây dựng môi trường không vật cản:「县级以上人民政府应当支持、指导家庭无障碍设施改造。对符合条件的残疾人、老年人家庭应当给予适当补贴。」— tức chính quyền nhân dân cấp huyện trở lên phải hỗ trợ, hướng dẫn cải tạo tiện nghi không vật cản trong gia đình, và phải trợ cấp mức độ thích hợp cho gia đình có người khuyết tật, người già thỏa điều kiện. Điều mười tám quy định, đối với công trình ở, khu ở, công trình công cộng, nơi công cộng, phương tiện vận tải, đường giao thông đô thị và nông thôn đã có sẵn mà không đạt tiêu chuẩn kỹ thuật xây dựng công trình tiện nghi không vật cản, chính quyền nhân dân cấp huyện trở lên phải căn cứ tình hình thực tế để lập kế hoạch cải tạo tiện nghi có trọng điểm và tổ chức thực hiện. Điều sáu mươi hai quy định, mọi tổ chức và cá nhân có quyền đưa ý kiến, kiến nghị với các cơ quan chủ trì liên quan của chính quyền về việc tăng cường và cải thiện xây dựng môi trường không vật cản, và khiếu nại, báo việc về hành vi vi phạm luật này; cơ quan chủ trì nhận được khiếu nại, báo việc「应当及时处理并予以答复」— phải xử lý kịp thời và trả lời. Điều sáu mươi ba quy định, đối với hành vi vi phạm luật này gây thiệt hại cho lợi ích công cộng, Viện kiểm sát nhân dân có thể đưa ra kiến nghị của Viện kiểm sát hoặc khởi kiện vì lợi ích công cộng (toàn quốc, có hiệu lực từ ngày 1 tháng 9 năm 2023)"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Nguồn gốc"]},{"tag":"p","props":{"className":"life-citations"},"children":["中华人民共和国无障碍环境建设法（第十八条、第十九条、第六十二条、第六十三条）. ",{"tag":"a","props":{"href":"https://flk.npc.gov.cn/detail?id=ff80818188d7430b0189018493370940","target":"_blank","rel":"noopener noreferrer"},"children":["https://flk.npc.gov.cn/detail?id=ff80818188d7430b0189018493370940"]}]},{"tag":"a","props":{"href":"https://flk.npc.gov.cn/detail?id=ff80818188d7430b0189018493370940","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Liên kết mở nguồn"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Ghi chú sách"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["Để ở mức B là vì luật chỉ viết「应当给予适当补贴」, trợ cấp bao nhiêu, ai thỏa điều kiện thì giao hết cho địa phương, không có con số thống nhất cả nước. Trước hết tra trên trang chính thức của hội người khuyết tật địa phương「困难重度残疾人家庭无障碍改造」. Hạn ngạch phần lớn chia theo năm, phải xếp hàng sớm. Lắp thang máy trong khu chung cư, cải tạo hành lang là một quy trình khác, đi theo cơ quan nhà ở và đô thị. Tiện nghi không vật cản ở nơi công cộng không đạt thì khiếu nại với cơ quan chủ trì theo Điều sáu mươi hai, cơ quan đó phải trả lời bạn."]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Ghi chú của tôi"]},{"tag":"button","props":{"type":"button"},"children":["Viết một lời nhắc cho chính bạn…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/vi/tip/33-08"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Trước"]},"Trẻ dưới 7 tuổi có khuyết tật hoặc tự kỷ, đến hội người khuyết tật cấp huyện xin trợ giúp phục hồi chức năng"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/vi/tip/33-10"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Tiếp theo"]},"Khi tìm việc ở Trung Quốc, chủ động nói rõ mình có giấy chứng nhận khuyết tật; tuyển bạn có thể giúp doanh nghiệp bớt một khoản phải nộp"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["Thêm trong chủ đề này"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/33-05"},"children":[{"tag":"strong","props":{},"children":["Người ngồi xe lăn lâu thì đổi đệm ngồi sang loại giảm áp, mỗi ngày xem một lượt xương ngồi và xương cùng"]},{"tag":"span","props":{},"children":["Đệm bọt thường ngồi lâu sẽ làm căng da, vỡ ra thì lành rất lâu, dễ nh…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/33-06"},"children":[{"tag":"strong","props":{},"children":["Đừng mua các liệu pháp và thiết bị「chữa khỏi bại liệt, mù lòa, điếc」"]},{"tag":"span","props":{},"children":["Luật Quảng cáo đã nói chết. Quảng cáo y tế, thuốc, thiết bị y tế khôn…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/33-07"},"children":[{"tag":"strong","props":{},"children":["Có giấy chứng nhận người khuyết tật rồi thì đến hội người khuyết tật cấp huyện hỏi trọn một lần các khoản trợ cấp"]},{"tag":"span","props":{},"children":["Bản thân giấy chứng nhận người khuyết tật không phát tiền, nó là một …"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/33-11"},"children":[{"tag":"strong","props":{},"children":["Thuế thu nhập cá nhân của người khuyết tật có thể được giảm, giảm bao nhiêu thì gọi điện hỏi cơ quan thuế tỉnh"]},{"tag":"span","props":{},"children":["Luật Thuế thu nhập cá nhân viết rằng thu nhập của người khuyết tật có…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/33-12"},"children":[{"tag":"strong","props":{},"children":["Chó dẫn đường cho người mù được vào nơi công cộng và phương tiện giao thông công cộng, người mù đi xe buýt trong thành phố miễn phí"]},{"tag":"span","props":{},"children":["Pháp luật quy định nơi công cộng và giao thông công cộng phải tạo điề…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/33-13"},"children":[{"tag":"strong","props":{},"children":["Thí sinh khuyết tật dự kỳ thi tuyển sinh đại học có thể xin biện pháp hỗ trợ hợp lý, dùng đề braille thì kéo dài thời gian thi thêm một nửa"]},{"tag":"span","props":{},"children":["Thí sinh khuyết tật dự kỳ thi tuyển sinh đại học có thể xin đề braill…"]}]}]}]},{"tag":"a","props":{"className":"life-text-link","href":"/vi/book/33"},"children":["Đọc toàn bộ chủ đề: Sống sau khi bị khuyết tật"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"15","height":"15","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]}]}]}]},{"tag":"aside","props":{"className":"life-ad-space life-ad-space-sponsored","data-ad-placement":"ad_footer","data-ad-group":"reading","data-ad-creative":"read_product","data-ad-ready":"false","aria-label":"Quảng cáo · Giới thiệu cộng đồng"},"children":[{"tag":"div","props":{"className":"life-ad-space-brand"},"children":[{"tag":"img","props":{"src":"/sites/howtolivebetter/images/shengcai/logo.png","width":"565","height":"144","alt":"Logo chính thức của She