k"},"children":["阅读全书"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/book/01"},"children":["第 1 章 · 不要早死"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"01-47"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["47"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["证据 A"]}]},{"tag":"h1","props":{"lang":"zh"},"children":["45 岁以上，住在胃癌食管癌高发地区、有家族史或幽门螺杆菌阳性的，去做胃镜筛查"]},{"tag":"p","props":{"lang":"zh","className":"life-entry-summary"},"children":["45 岁以上、属于胃癌食管癌高风险的人，做过胃镜的，死于这两种癌的概率低约一半。但主动去查的人本来就更注意身体，这个数会偏大。按最严格的办法比，食管癌死亡只低约两成，还在误差范围内。不在高风险里的人，指南不建议查。"]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["成本"]},{"tag":"p","props":{},"children":["普通胃镜几百元，做无痛胃镜要另加几百元，各地价格不同。要空腹去，前后占半天。选无痛胃镜的，要有人陪着去。难受的地方是管子过喉咙那几分钟。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["收益"]},{"tag":"p","props":{},"children":["国家卫健委 2024 年的方案这样定高风险人群。先要年满 45 岁，再满足下面任意一条。一是住在胃癌或食管癌高发的县。胃癌按年龄标化发病率超过每 10 万人 20 例算，食管癌按超过 15 例算。二是父母、子女、兄弟姐妹得过这种癌。三是幽门螺杆菌检测阳性，这一条只算胃癌。四是抽烟、重度饮酒、吃得咸、…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"标记：45 岁以上，住在胃癌食管癌高发地区、有家族史或幽门螺杆菌阳性的，去做胃镜筛查"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"已做到"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"加入待做"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"收藏"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"分享这条建议"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"收起详情"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["成本"]},{"tag":"p","props":{"className":"life-citations"},"children":["普通胃镜几百元，做无痛胃镜要另加几百元，各地价格不同。要空腹去，前后占半天。选无痛胃镜的，要有人陪着去。难受的地方是管子过喉咙那几分钟。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["收益"]},{"tag":"p","props":{"className":"life-citations"},"children":["国家卫健委 2024 年的方案这样定高风险人群。先要年满 45 岁，再满足下面任意一条。一是住在胃癌或食管癌高发的县。胃癌按年龄标化发病率超过每 10 万人 20 例算，食管癌按超过 15 例算。二是父母、子女、兄弟姐妹得过这种癌。三是幽门螺杆菌检测阳性，这一条只算胃癌。四是抽烟、重度饮酒、吃得咸、爱吃腌制食品，食管癌还加上爱吃烫的。五是得过萎缩性胃炎、胃溃疡、胃息肉、巴雷特食管、反流性食管炎这类病。筛查年龄一般在 45 到 74 岁，首选胃镜，原则上每 5 年做一次。2022 年的国家指南明确不建议高风险以外的人做胃癌筛查。中国 6 个高发地区有一项研究，跟踪了 40 到 69 岁的约 63.75 万人。做过一次胃镜的人和没被邀请的人比，死于上消化道癌的风险低约 57%。原值 RR 0.43，可信范围 95% CI 0.40 到 0.47。上消化道癌的发病低约 23%（RR 0.77）。被邀请的人里只有 33.53% 真去做了。把被邀请的人全算上，死亡低约 31%（RR 0.69，95% CI 0.66 到 0.72）。另一项研究在食管癌高发的村子里做，没有随机分组，跟了 10 年。筛查组的食管鳞癌累计死亡是 3.35%，对照组是 5.05%。韩国国家筛查项目里，做过胃镜的人死于胃癌的可能低约 47%。原值 OR 0.53，95% CI 0.51 到 0.56。做钡餐的看不出差别（OR 0.98）。做胃镜的次数越多，风险越低。把亚洲 10 项研究合起来算，做过胃镜的人胃癌死亡低约 40%。原值 RR 0.60，95% CI 0.49 到 0.73。得胃癌的人数没看出变化。中国北方有一项按村随机分组的试验，收了 45 到 69 岁的 3.38 万人，跟了 9 年。分到筛查组的人，食管癌死亡低约 18%（HR 0.82，95% CI 0.53 到 1.26），还在误差范围内。发病低约 19%（HR 0.81，95% CI 0.60 到 1.09），同样不显著。2023 年一篇荟萃分析校正了「主动去查的人本来就更健康」这层偏差。真去做胃镜的人，胃癌死亡低约 48%（RR 0.52，可信范围 0.39 到 0.79）。按整个筛查项目算，只剩 RR 0.94（可信范围 0.71 到 1.28），看不出效果（中国 / 韩国 / 亚洲）"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["来源"]},{"tag":"p","props":{"className":"life-citations"},"children":["国家卫生健康委办公厅 (2024). 关于印发食管癌筛查与早诊早治方案（2024年版）和胃癌筛查与早诊早治方案（2024年版）的通知（国卫办医急函〔2024〕200号）. ",{"tag":"a","props":{"href":"https://www.nhc.gov.cn/wjw/c100378/202406/7008ffe1c77d4457ac73361be75760c7.shtml","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.nhc.gov.cn/wjw/c100378/202406/7008ffe1c77d4457ac73361be75760c7.shtml"]},"（附件全文转载：广东省疾病预防控制中心 ",{"tag":"a","props":{"href":"https://cdcp.gd.gov.cn/jkjy/jkzt/mxfcrxjbfz/content/mpost_4444507.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://cdcp.gd.gov.cn/jkjy/jkzt/mxfcrxjbfz/content/mpost_4444507.html"]},"）；赫捷, 陈万青, 李兆申, 等 (2022). 中国胃癌筛查与早诊早治指南（2022，北京）. 中国肿瘤, 31(7), 488-527（临床问题 7、13）. ",{"tag":"a","props":{"href":"https://doi.org/10.11735/j.issn.1004-0242.2022.07.A002","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.11735/j.issn.1004-0242.2022.07.A002"]},"（同文刊于中华肿瘤杂志, 44(7), 634-666. ",{"tag":"a","props":{"href":"https://doi.org/10.3760/cma.j.cn112152-20220617-00430","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.3760/cma.j.cn112152-20220617-00430"]},"）；Chen R, Liu Y, Song G, et al. (2021). Effectiveness of one-time endoscopic screening programme in prevention of upper gastrointestinal cancer in China: a multicentre population-based cohort study. Gut, 70(2), 251-260. ",{"tag":"a","props":{"href":"https://doi.org/10.1136/gutjnl-2019-320200","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1136/gutjnl-2019-320200"]},"；Wei WQ, Chen ZF, He YT, et al. (2015). Long-Term Follow-Up of a Community Assignment, One-Time Endoscopic Screening Study of Esophageal Cancer in China. Journal of Clinical Oncology, 33(17), 1951-1957. ",{"tag":"a","props":{"href":"https://doi.org/10.1200/JCO.2014.58.0423","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1200/JCO.2014.58.0423"]},"；Jun JK, Choi KS, Lee HY, et al. (2017). Effectiveness of the Korean National Cancer Screening Program in Reducing Gastric Cancer Mortality. Gastroenterology, 152(6), 1319-1328.e7. ",{"tag":"a","props":{"href":"https://doi.org/10.1053/j.gastro.2017.01.029","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1053/j.gastro.2017.01.029"]},"；Zhang X, Li M, Chen S, et al. (2018). Endoscopic Screening in Asian Countries Is Associated With Reduced Gastric Cancer Mortality: A Meta-analysis and Systematic Review. Gastroenterology, 155(2), 347-354.e9. ",{"tag":"a","props":{"href":"https://doi.org/10.1053/j.gastro.2018.04.026","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1053/j.gastro.2018.04.026"]},"；Liu M, Yang W, Guo C, et al. (2024). Effectiveness of Endoscopic Screening on Esophageal Cancer Incidence and Mortality: A 9-Year Report of the Endoscopic Screening for Esophageal Cancer in China (ESECC) Randomized Trial. Journal of Clinical Oncology, 42(14), 1655-1664. ",{"tag":"a","props":{"href":"https://doi.org/10.1200/JCO.23.01284","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1200/JCO.23.01284"]},"；Hibino M, Hamashima C, Iwata M, Terasawa T. (2023). Radiographic and endoscopic screening to reduce gastric cancer mortality: a systematic review and meta-analysis. The Lancet Regional Health – Western Pacific, 35, 100741. ",{"tag":"a","props":{"href":"https://doi.org/10.1016/j.lanwpc.2023.100741","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1016/j.lanwpc.2023.100741"]},""]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["原书备注"]},{"tag":"p","props":{"className":"life-citations"},"children":["争议。胃镜降死亡的证据，大多是拿自愿去查的人和不查的人比。去查的人本来就更注意身体，好处会被算大。2023 年那篇荟萃分析评定，这些研究的偏倚风险是中等到严重。食管癌那项按村分组的试验，9 年的死亡差别还在误差范围内。2022 年指南列出的害处有过度诊断、假阳性和漏诊，还有出血、穿孔、心肺意外、吸入性肺炎和感染。过度诊断指查出一辈子都不会发作的癌。受不了普通胃镜的，方案写明可以在麻醉或镇静下做。45 岁以上幽门螺杆菌阳性的，本身就算胃癌高风险。根除见第 23 条（查幽门螺杆菌，阳性就根除），但根除代替不了胃镜，两样都要做。钡餐、单查胃蛋白酶原、肿瘤标志物和 PET 检查，方案都不推荐用来筛查。肿瘤标志物套餐见第 6 节第 7 条（全身 PET-CT 和肿瘤标志物套餐）。查出萎缩性胃炎、肠上皮化生、上皮内瘤变的，复查要更勤，按医生说的来。自己住的县算不算高发区，可以问当地疾控中心或县医院。已经吞咽困难、呕血、黑便的，是去看病，不是筛查，见第 34 节第 6 条（吞咽困难、呕血、黑便就直接去医院）。爱喝烫茶的，见第 2 节第 30 条（热的东西放一放再喝）。受益人主要是你自己，也包括你的父母。"]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["我的备注"]},{"tag":"button","props":{"type":"button"},"children":["写下对自己有用的提醒…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/tip/01-46"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["上一条"]},"下化粪池、窨井、污水池、菜窖地窖、发酵罐之前先打开通风，有人倒在里面别跟着下去，打 119 和 120"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/tip/01-48"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["下一条"]},"泡发的木耳、银耳当顿吃完别过夜，河粉、肠粉这类湿米粉买来当天吃，家里不自制酵米面"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["本主题的其他建议"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/01-03"},"children":[{"tag":"strong","props":{},"children":["装烟雾报警器；冬天在室内烧煤、用燃气取暖的再装一氧化碳报警器"]},{"tag":"span","props":{},"children":["一个能正常工作的烟雾报警器，能把住宅火灾里死亡的概率降约六成。美国死了人的住宅火灾，四成起火时人在睡觉。冬天在屋里烧煤或用燃气的，再加一个一氧化碳报警器。中国…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/01-04"},"children":[{"tag":"strong","props":{},"children":["燃气软管和灶具到期就换，不自己改管道，燃气公司上门推销可以直接拒绝"]},{"tag":"span","props":{},"children":["软管和灶具到期就换，这是《城镇燃气管理条例》写明的用户义务。自己改管道、拆燃气表是条例明令禁止的。同一部条例还写了，燃气公司不能要求你买它指定的产品和服务。上门…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/01-05"},"children":[{"tag":"strong","props":{},"children":["不采、不买、不吃野生蘑菇，任何「土办法鉴别」都不成立"]},{"tag":"span","props":{},"children":["光 2025 年一年，中国疾控中心就调查了 828 起蘑菇中毒，2165 人中招，13 人死。那一年还新认出 34 种以前没记录过会毒人的蘑菇。银针试毒、虫子吃…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/01-06"},"children":[{"tag":"strong","props":{},"children":["电动自行车不推进楼道、不进电梯、不在家里充电"]},{"tag":"span","props":{},"children":["在高层住宅的门厅、走道、楼梯间停电动车或者充电，是应急管理部的规章明令禁止的。不改正的，个人罚 500 到 1000 元，做生意的罚 2000 到 10000…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/01-07"},"children":[{"tag":"strong","props":{},"children":["量血压，高了就吃药降到达标"]},{"tag":"span","props":{},"children":["高压每降 10 mmHg，出大的心血管毛病的概率降两成，中风降 27%。心衰降 28%，死亡概率降 13%。中国 35 到 75 岁的人里，44.7% 有高血压…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/01-08"},"children":[{"tag":"strong","props":{},"children":["35 岁以后只要超重，就去查一次空腹血糖，正常也每三年再查"]},{"tag":"span","props":{},"children":["花几十块抽一管血，就能在一点症状都没有的时候查出糖尿病前期。美国官方的筛查建议是：35 到 70 岁、超重或肥胖的人去查。查出来正常的，每三年再