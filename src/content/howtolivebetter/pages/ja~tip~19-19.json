,{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},{"tag":"span","props":{},"children":["ログイン"]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/ja/book/19"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"目次に戻る"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["在職、離職、および労災"]},{"tag":"nav","props":{"aria-label":"この章のヒント"},"children":[{"tag":"a","props":{"href":"/ja/tip/19-01"},"children":[{"tag":"span","props":{},"children":["01"]},"残業代は 1.5 倍、2 倍、3 倍の3段階で計算されます。支払われない場合は労働監督署へ通報を。期限内に支払わない場合は 50% から 100% の追加支払い義務が生じます"]},{"tag":"a","props":{"href":"/ja/tip/19-02"},"children":[{"tag":"span","props":{},"children":["02"]},"年次有給休暇は累計勤続年数に基づき 5、10、15 日付与され、消化できなかった場合は日給の 300% で手当が支払われます"]},{"tag":"a","props":{"href":"/ja/tip/19-03"},"children":[{"tag":"span","props":{},"children":["03"]},"試用期間には法定の上限があり、給与は 80% を下回ってはならず、かつ一度しか設定できません"]},{"tag":"a","props":{"href":"/ja/tip/19-04"},"children":[{"tag":"span","props":{},"children":["04"]},"解雇時のN（経済補償金）の計算方法：勤続1年につき1ヶ月分の給与、6ヶ月未満は半月分"]},{"tag":"a","props":{"href":"/ja/tip/19-05"},"children":[{"tag":"span","props":{},"children":["05"]},"会社が 30 日前に通知せず解雇する場合、さらに1ヶ月分の給与を支払う必要がある"]},{"tag":"a","props":{"href":"/ja/tip/19-06"},"children":[{"tag":"span","props":{},"children":["06"]},"不当解雇（違法解雇）の場合、賠償金は経済補償金基準の2倍となる"]},{"tag":"a","props":{"href":"/ja/tip/19-07"},"children":[{"tag":"span","props":{},"children":["07"]},"「自己都合による自主退職」にはサインしないでください。一度サインしてしまうと、解雇予告手当（N）がもらえなくなります"]},{"tag":"a","props":{"href":"/ja/tip/19-08"},"children":[{"tag":"span","props":{},"children":["08"]},"退職前に、給与明細、勤怠記録、労働契約書、社会保険の記録、およびチャットの履歴を保存しておきましょう"]},{"tag":"a","props":{"href":"/ja/tip/19-09"},"children":[{"tag":"span","props":{},"children":["09"]},"粉塵、騒音、化学物質を扱う業務に就く前に、契約書に危害に関する記載があるか確認しましょう。3回の職業健康診断は会社が手配し、費用を負担します"]},{"tag":"a","props":{"href":"/ja/tip/19-10"},"children":[{"tag":"span","props":{},"children":["10"]},"粉塵、騒音、化学毒物による損傷は不可逆：防護具は会社が提供しなければならず、防護措置のない作業は拒否できる"]},{"tag":"a","props":{"href":"/ja/tip/19-11"},"children":[{"tag":"span","props":{},"children":["11"]},"仕事中の負傷や通勤中の交通事故、まず最初に行うべきは労災認定。会社が申請しない場合は自分で申請できる"]},{"tag":"a","props":{"href":"/ja/tip/19-12"},"children":[{"tag":"span","props":{},"children":["12"]},"「出勤した時点で労災」を信じないで：急な体調不良時は、まず 120 へ。打刻のために急いで向かうのではなく。"]},{"tag":"a","props":{"href":"/ja/tip/19-13"},"children":[{"tag":"span","props":{},"children":["13"]},"会社が労災保険に加入していなくても、労災補償は受けられます。会社が同等の基準で全額負担します"]},{"tag":"a","props":{"href":"/ja/tip/19-14"},"children":[{"tag":"span","props":{},"children":["14"]},"症状が安定した後に労働能力鑑定を行い、障害等級を直接金額に換算する"]},{"tag":"a","props":{"href":"/ja/tip/19-15"},"children":[{"tag":"span","props":{},"children":["15"]},"労災死亡における3つの給付を明確に区別すること：葬儀補助金、扶養家族年金、一回限り労災死亡補助金"]},{"tag":"a","props":{"href":"/ja/tip/19-16"},"children":[{"tag":"span","props":{},"children":["16"]},"職場で長期にわたりいじめ、罵倒、嫌がらせを受けている場合、一人で耐え込まないこと：まずは証拠を残すために記録し、その性質に応じて、苦情申し立て、通報、または仲裁の手続きを進めること"]},{"tag":"a","props":{"href":"/ja/tip/19-17"},"children":[{"tag":"span","props":{},"children":["17"]},"退職時には会社に離職証明書を請求すること。契約期間、退職日、職種、勤続年数を明記させること"]},{"tag":"a","props":{"href":"/ja/tip/19-18"},"children":[{"tag":"span","props":{},"children":["18"]},"退職補償金を受け取る際はまず所得税を確認：現地の前年度従業員平均賃金の3倍以内は非課税、超過分は別途計算され、当年の給与とは合算されない"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/ja/tip/19-19","data-status":"active"},"children":[{"tag":"span","props":{},"children":["19"]},"別の都市で働くときは、年金保険と医療保険の加入関係を新しい加入地へ移す。納付年数は累計されるので、脱退しない"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"現在地"},"children":[{"tag":"a","props":{"href":"/ja/book"},"children":["本を読む"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/ja/book/19"},"children":["第19章"," ·"," ","在職、離職、および労災"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"19-19"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["19"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["エビデンス"," ","A"]}]},{"tag":"h1","props":{"lang":"ja"},"children":["別の都市で働くときは、年金保険と医療保険の加入関係を新しい加入地へ移す。納付年数は累計されるので、脱退しない"]},{"tag":"p","props":{"lang":"ja","className":"life-entry-summary"},"children":["別の都市で働くときは、年金保険と医療保険の加入関係も本人とともに移り、それまでの納付年数は引き続き累計されます。年金受給年齢に達する前に、脱退してお金を引き出すことはできません。医療保険の納付が 3 か月を超えて中断すると、新しい地域で医療費の給付を受けるまで最長 6 か月待つことがあります。空白期間を長くしないでください。"]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["費用・手間"]},{"tag":"p","props":{},"children":["費用はかかりません。新しい地域で保険に加入して納付した後、新しい会社または自分で移管を申請します。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["効果"]},{"tag":"p","props":{},"children":["社会保険法によると、別の地域で働く場合（正式には保険の統括管理区域をまたぐ場合）、年金保険の加入関係は本人とともに移り、納付年数は累計されます。"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"記録する：別の都市で働くときは、年金保険と医療保険の加入関係を新しい加入地へ移す。納付年数は累計されるので、脱退しない"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"できている"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"やることに追加"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"お気に入り"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"このヒントを共有"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"詳細を閉じる"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["費用・手間"]},{"tag":"p","props":{},"children":["費用はかかりません。新しい地域で保険に加入して納付した後、新しい会社または自分で移管を申請します。窓口へ行くか、オンラインで手続きできます。年金保険は全体で数十営業日、医療保険は約 15 営業日かかります。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["効果"]},{"tag":"p","props":{},"children":["社会保険法によると、別の地域で働く場合（正式には保険の統括管理区域をまたぐ場合）、年金保険の加入関係は本人とともに移り、納付年数は累計されます。従業員医療保険も同じで、加入関係は本人とともに移り、年数は累計されます。退職時の年金は地域別に分けて計算し、まとめて支払われます。省をまたぐ年金保険の移管は、国務院弁公庁が転送した移管・継続加入の規則に従います。給付を受けられる年齢に達する前は、年金保険の加入関係を終了したり脱退したりしてはなりません。社会保険法でも、個人口座からの早期引き出しは禁止されています。個人口座のお金は元本と利息をすべて移します。会社の納付分は統括基金と呼ばれ、1998 年以降の各年の実際の保険料算定賃金の 12% を移します。年金受給時には、各年の保険料算定賃金、納付年数、受給地の各年の平均賃金に基づいて計算します。手続きは、新しい地域で加入・納付した後、会社または本人が新しい加入地へ書面で申請します。新しい加入地は 15 営業日以内に審査し、以前の加入地は受入同意書を受領してから 15 営業日以内に移管を行います。新しい加入地は加入関係と資金を受領した後、さらに 15 営業日以内に手続きを完了します。2020 年の省をまたぐ手続きの共通対応リストでは、この手続きは同年末までに省をまたいで処理できるようにするとされています。移管先に申請すればよく、移管元へ戻る必要はありません。従業員医療保険は、以前の加入地で加入を停止し、新しい地域ですでに加入してから、移管を申請できます。国家医療保険サービスプラットフォームでオンライン申請するか、窓口で手続きできます。以前の加入地は 10 営業日以内に移管し、新しい加入地は 5 営業日以内に受け入れます。個人口座の残高も一緒に移します。移管前の納付中断が 3 か月以内なら、新しい地域の規則に従って追加納付した後は待機期間がなく、納付した月から医療費の給付を受けられ、中断期間についても遡って給付を受けられます。中断が 3 か月を超える場合の待機期間は各地の規則に従い、原則として 6 か月を超えません（中国全国）。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["出典"]},{"tag":"p","props":{"className":"life-citations"},"children":["全国人大常委会 (2010, 2018 修正). 社会保险法（第十四、十九、三十二条）. ",{"tag":"a","props":{"href":"https://www.gov.cn/guoqing/2021-10/29/content_5647616.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/guoqing/2021-10/29/content_5647616.htm"]},"；人力资源社会保障部、财政部 (2009). 城镇企业职工基本养老保险关系转移接续暂行办法（国办发〔2009〕66 号转发，第二、三、四、五、六、七、八、十一条）. ",{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/2009-12/29/content_8104.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/zhengce/zhengceku/2009-12/29/content_8104.htm"]},"；国务院办公厅 (2020). 关于加快推进政务服务「跨省通办」的指导意见（国办发〔2020〕35 号，附件第 7 项）. ",{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/2020-09/29/content_5548125.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/zhengce/zhengceku/2020-09/29/content_5548125.htm"]},"；国家医保局办公室、财政部办公厅 (2021). 基本医疗保险关系转移接续暂行办法（医保办发〔2021〕43 号，第五、六、八、九、十一、十二、十三条）. ",{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/2021-11/28/content_5653856.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/zhengce/zhengceku/2021-11/28/content_5653856.htm"]},"；国家医保局 (2021). 《基本医疗保险关系转移接续暂行办法》政策解读（国家医保服务平台网址 fuwu.nhsa.gov.cn）. ",{"tag":"a","props":{"href":"http://www.gov.cn/zhengce/2021-11/28/content_5653855.htm","target":"_blank","rel":"noopener noreferrer"},"children":["http://www.gov.cn/zhengce/2021-11/28/content_5653855.htm"]}]},{"tag":"a","props":{"href":"https://www.gov.cn/guoqing/2021-10/29/content_5647616.htm","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["出典を開く"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["著者の注記"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["戸籍のある省以外の省へ移り、男性は満 50 歳、女性は満 40 歳以上なら、年金保険の加入関係は以前の加入地に残ります。新しい地域では仮口座だけを開設し、会社と本人の納付額をすべて記録します。退職時の年金受給地は、次の規則で決まります。加入関係が戸籍のある省にあれば、戸籍地で受給します。戸籍地になくても、加入関係の所在地で累計 10 年以上納付していれば、その地域で受給します。そこで 10 年に達していなければ、以前に 10 年以上納付した地域へ戻して受給します。どの地域でも 10 年に達していなければ、戸籍地にまとめて受給します。受給地が違えば、年金の計算に使う平均賃金も異なります。同じ省内の都市間の移管方法は各省が定めるため、現地の社会保険取扱機関に確認してください。すでに年金を受給している人は、加入関係を移管しません。納付が中断した後の年数の計算や、継続納付を要する資格については、第 7 節第 18 条（社会保険の納付中断）を参照してください。会社に属さず自分で社会保険を払う場合は、第 31 節第 11 条（柔軟な就業形態）を参照してください。"]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["自分のメモ"]},{"tag":"button","props":{"type":"button"},"children":["自分へのメモを書く…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/ja/tip/19-18"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["前へ"]},"退職補償金を受け取る際はまず所得税を確認：現地の前年度従業員平均賃金の3倍以内は非課税、超過分は別途計算され、当年の給与とは合算されない"]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["このテーマの他の提案"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/19-12"},"children":[{"tag":"strong","props":{},"children":["「出勤した時点で労災」を信じないで：急な体調不良時は、まず 120 へ。打刻のために急いで向かうのではなく。"]},{"tag":"span","props":{},"children":["急な体調不良のまま会社へ急いでも、手当が増えるわけではありません。労災とみなされるには、勤務時間内かつ勤務場所内での発症が条件であり、移動…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/19-13"},"children":[{"tag":"strong","props":{},"children":["会社が労災保険に加入していなくても、労災補償は受けられます。会社が同等の基準で全額負担します"]},{"tag":"span","props":{},"children":["会社が労災保険に加入していなくても、労災補償は同様に受けられます。単に、会社が同じ項目と基準に従って全額を支払う形に変わるだけで、一分も欠…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/19-14"},"children":[{"tag":"strong","props":{},"children":["症状が安定した後に労働能力鑑定を行い、障害等級を直接金額に換算する"]},{"tag":"span","props":{},"children":["症状が安定した後に労働能力鑑定を行い、等級を直接金額に換算します。一括障害補助金は本人の給与に基づいて計算されます：5級は 18 ヶ月、6…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/19-15"},"children":[{"tag":"strong","props":{},"children":["労災死亡における3つの給付を明確に区別すること：葬儀補助金、扶養家族年金、一回限り労災死亡補助金"]},{"tag":"span","props":{},"children":["労災による死亡時には3つの給付が発生します。そのうちの1つだけを見てはいけません。葬儀補助金は、現地の前年度従業員月平均賃金の 6 ヶ月分…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/19-16"},"children":[{"tag":"strong","props":{},"children":["職場で長期にわたりいじめ、罵倒、嫌がらせを受けている場合、一人で耐え込まないこと：まずは証拠を残すために記録し、その性質に応じて、苦情申し立て、通報、または仲裁の手続きを進めること"]},{"tag":"span","props":{},"children":["職場でいじめを受けている人は、後に心臓病や脳卒中を発症するリスクが約6割高く、いじめが深刻なほどそのリスクは高まります。いじめを受けている…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/19-17"},"children":[{"tag":"strong","props":{},"children":["退職時には会社に離職証明書を請求すること。契約期間、退職日、職種、勤続年数を明記させること"]},{"tag":"span","props":{},"children":["解雇、契約満了、自己都合退職のいずれであっても、会社は退職時に離職証明書を交付しなければならず、15日以内に档案（個人記録）と社会保険の移…"]}]}]}]},{"tag":"a","props":{"className":"life-text-link","href":"/ja/book/19"},"children":["テーマ全体を読む：在職、離職、および労災"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"15","height":"15","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]}]}]},{"tag":"nav","props":{"className":"life-tabbar","aria-label":"メインナビゲーション"},"children":[{"tag":"a","props":{"className":"","href":"/ja/book"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"21","height":"21","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-book-open","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M12 7v14"},"children":[]},{"tag":"path","props":{"d":"M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z"},"children":[]}]},{"tag":"span","props":{},"children":["本"]}]},{"tag":"a","props":{"className":"","href":"/ja/top-50"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"21","height":"21","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-star","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M11.525 2.295a.53.53 0 0 1 .95 0l2