1.41 1.41"},"children":[]},{"tag":"path","props":{"d":"M2 12h2"},"children":[]},{"tag":"path","props":{"d":"M20 12h2"},"children":[]},{"tag":"path","props":{"d":"m6.34 17.66-1.41 1.41"},"children":[]},{"tag":"path","props":{"d":"m19.07 4.93-1.41 1.41"},"children":[]}]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"17","height":"17","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-moon life-theme-icon-dark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"},"children":[]}]}]},{"tag":"button","props":{"type":"button","className":"life-language-switch","aria-label":"Español Elegir idioma","aria-haspopup":"menu","aria-expanded":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-globe","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]},{"tag":"path","props":{"d":"M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"},"children":[]},{"tag":"path","props":{"d":"M2 12h20"},"children":[]}]},{"tag":"span","props":{},"children":["Español"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]}]},{"tag":"a","props":{"className":"life-account","href":"/es/sign-in"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"17","height":"17","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle-user-round","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M18 20a6 6 0 0 0-12 0"},"children":[]},{"tag":"circle","props":{"cx":"12","cy":"10","r":"4"},"children":[]},{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},{"tag":"span","props":{},"children":["Iniciar sesión"]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/es/book/23"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"Volver al índice"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["¿Qué habilidades merece la pena aprender?"]},{"tag":"nav","props":{"aria-label":"Consejos del capítulo"},"children":[{"tag":"a","props":{"href":"/es/tip/23-01"},"children":[{"tag":"span","props":{},"children":["01"]},"Menores de 16 años no tienen opción de «trabajar»: la empresa que los contrate pagará 5000 yuanes de multa al mes; solo las empresas que emplean mano de obra ilegal lo harán"]},{"tag":"a","props":{"href":"/es/tip/23-02"},"children":[{"tag":"span","props":{},"children":["02"]},"Incluir el «valor de estudiar» en la cuenta de la mortalidad: cada año adicional de educación reduce el riesgo de muerte en adultos en aproximadamente un 1,9 %"]},{"tag":"a","props":{"href":"/es/tip/23-03"},"children":[{"tag":"span","props":{},"children":["03"]},"Antes de decidir si «los títulos han perdido valor», mira la estructura educativa nacional: solo 15467 de cada 100000 personas tienen estudios superiores (censo de 2020; estimación muestral de 2025: alrededor del 19%)"]},{"tag":"a","props":{"href":"/es/tip/23-04"},"children":[{"tag":"span","props":{},"children":["04"]},"«No puedo pagar la matrícula»: primero, calculemos según las políticas: la mayoría de los estudios en escuelas técnicas públicas ya son gratuitos, hay una beca de 2300 yuanes y el préstamo estudiantil alcanza un máximo de 20 000 yuanes al año"]},{"tag":"a","props":{"href":"/es/tip/23-05"},"children":[{"tag":"span","props":{},"children":["05"]},"No aprobar el examen de ingreso a la secundaria no significa que se haya cerrado el camino: los centros de formación profesional ofrecen vías de acceso continuado a la educación superior y exámenes de admisión específicos; además, muchas empresas que buscan personal cualificado pueden bajar el requisito de nivel académico"]},{"tag":"a","props":{"href":"/es/tip/23-06"},"children":[{"tag":"span","props":{},"children":["06"]},"Tratar «estudiar o trabajar» como un solo cálculo: los tres años de salario que se ganan al ponerse a trabajar primero, frente a la diferencia de ingresos anuales durante las décadas siguientes que se obtiene al seguir estudiando"]},{"tag":"a","props":{"href":"/es/tip/23-07"},"children":[{"tag":"span","props":{},"children":["07"]},"Primero, memorice la línea de referencia: en promedio mundial, cada año adicional de escolaridad genera un retorno privado de aproximadamente el 9 % en los ingresos personales"]},{"tag":"a","props":{"href":"/es/tip/23-08"},"children":[{"tag":"span","props":{},"children":["08"]},"Antes de gastar dinero en obtener una certificación, verifique si esta figura en el Catálogo Nacional de Certificaciones Profesionales o en la lista de organismos evaluadores registrados ante el Ministerio de Recursos Humanos y Seguridad Social"]},{"tag":"a","props":{"href":"/es/tip/23-09"},"children":[{"tag":"span","props":{},"children":["09"]},"Es preferible optar por los programas subvencionados por el gobierno para la capacitación; no se debe pagar de forma privada por cursos comerciales desde el principio"]},{"tag":"a","props":{"href":"/es/tip/23-10"},"children":[{"tag":"span","props":{},"children":["10"]},"Al elegir una habilidad, priorice aquellas que requieran trabajo manual y capacidad de juicio en el momento, ya que son las más difíciles de automatizar"]},{"tag":"a","props":{"href":"/es/tip/23-11"},"children":[{"tag":"span","props":{},"children":["11"]},"Antes de aprender una habilidad, compruebe si existe una evaluación de nivel y si ese nivel puede traducirse en dinero"]},{"tag":"a","props":{"href":"/es/tip/23-12"},"children":[{"tag":"span","props":{},"children":["12"]},"No tomes como indicador de escasez laboral lo que se dice en internet sobre «altos salarios»; consulta los catálogos locales de oficios necesitados y de subvenciones correspondientes"]},{"tag":"a","props":{"href":"/es/tip/23-13"},"children":[{"tag":"span","props":{},"children":["13"]},"Con el mismo dinero y tiempo, se deben priorizar los programas de corta duración que permiten empezar a trabajar de inmediato"]},{"tag":"a","props":{"href":"/es/tip/23-14"},"children":[{"tag":"span","props":{},"children":["14"]},"Después de estudiar, cierra el libro y haz un examen por tu cuenta; no vuelvas a leerlo"]},{"tag":"a","props":{"href":"/es/tip/23-15"},"children":[{"tag":"span","props":{},"children":["15"]},"Distribuya el mismo tiempo en varios días en lugar de estudiarlo todo de una vez"]},{"tag":"a","props":{"href":"/es/tip/23-16"},"children":[{"tag":"span","props":{},"children":["16"]},"No considere el subrayado, la lectura repetida ni el resumen como métodos de estudio principales"]},{"tag":"a","props":{"href":"/es/tip/23-17"},"children":[{"tag":"span","props":{},"children":["17"]},"Practicar varios tipos de ejercicios mezclados, no hacer veinte del mismo tipo seguidos"]},{"tag":"a","props":{"href":"/es/tip/23-18"},"children":[{"tag":"span","props":{},"children":["18"]},"No elijan métodos de aprendizaje basándose en que «yo soy visual y él es auditivo»"]},{"tag":"a","props":{"href":"/es/tip/23-19"},"children":[{"tag":"span","props":{},"children":["19"]},"Para repasar, plantee usted mismo preguntas según el uso futuro; no se limite a memorizar tal cual"]},{"tag":"a","props":{"href":"/es/tip/23-20"},"children":[{"tag":"span","props":{},"children":["20"]},"Para solicitar un título profesional, primero debe determinar en qué serie y nivel se encuentra, y luego buscar el canal de solicitud según la naturaleza de su entidad laboral"]},{"tag":"a","props":{"href":"/es/tip/23-21"},"children":[{"tag":"span","props":{},"children":["21"]},"Los títulos profesionales de nivel básico e intermedio, como el de contador, se obtienen mediante exámenes nacionales unificados; primero hay que comprobar los requisitos de formación académica y antigüedad laboral para inscribirse"]},{"tag":"a","props":{"href":"/es/tip/23-22"},"children":[{"tag":"span","props":{},"children":["22"]},"No recurran a intermediarios para la evaluación, no contraten redacción de artículos académicos ni falsifiquen documentos: si se detecta, se revocará su título profesional y se registrará en su historial de integridad durante 3 años"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/es/tip/23-23","data-status":"active"},"children":[{"tag":"span","props":{},"children":["23"]},"Tener un título profesional no implica un aumento salarial: primero averigüe si su institución evalúa y asigna puestos según la proporción de plazas disponibles, o si obtener el título no garantiza el puesto correspondiente"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"Ruta de navegación"},"children":[{"tag":"a","props":{"href":"/es/book"},"children":["Libro"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/es/book/23"},"children":["Capítulo 23"," ·"," ","¿Qué habilidades merece la pena aprender?"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"23-23"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["23"]},{"tag":"span","props":{"className":"life-evidence grade-b"},"children":["Evidencia"," ","B"]}]},{"tag":"h1","props":{"lang":"es"},"children":["Tener un título profesional no implica un aumento salarial: primero averigüe si su institución evalúa y asigna puestos según la proporción de plazas disponibles, o si obtener el título no garantiza el puesto correspondiente"]},{"tag":"p","props":{"lang":"es","className":"life-entry-summary"},"children":["Los títulos profesionales sirven como base para la contratación, la evaluación y los ascensos, pero obtener el título y conseguir el puesto son dos procesos distintos. En las instituciones públicas, por lo general se evalúan los títulos dentro de los límites de plazas disponibles, y la mayoría de quienes los obtienen consiguen el puesto. En organizaciones que no aplican este sistema de gestión de puestos, se puede separar la evaluación del título de la asignación del puesto, por lo que obtener el título no implica automáticamente el puesto ni el aumento salarial correspondiente. Al cambiar de institución o de región, es posible que sea necesario volver a evaluar o confirmar el título."]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Coste"]},{"tag":"p","props":{},"children":["No cuesta nada. Solo es necesario consultar una vez al dep…"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Beneficio"]},{"tag":"p","props":{},"children":["Según el artículo 2 de la Orden N.º 40 del Ministerio de Recursos Humanos y Seguridad Social, los resultados d…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"Marcar: Tener un título profesional no implica un aumento salarial: primero averigüe si su institución evalúa y asigna puestos según la proporción de plazas disponibles, o si obtener el título no garantiza el puesto correspondiente"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"Hecho"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"Por hacer"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"Guardar"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Compartir consejo"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Ocultar detalles"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Coste"]},{"tag":"p","props":{},"children":["No cuesta nada. Solo es necesario consultar una vez al departamento de recursos humanos de su institución."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Beneficio"]},{"tag":"p","props":{},"children":["Según el artículo 2 de la Orden N.º 40 del Ministerio de Recursos Humanos y Seguridad Social, los resultados de la evaluación de títulos profesionales son una base importante para la contratación, la evaluación y los ascensos de los profesionales. Las directrices de reforma de 2016 establecen que en las instituciones públicas que aplican el sistema de gestión de puestos, la evaluación de títulos se realiza dentro de los límites de la estructura de plazas. En organizaciones sin este sistema, así como en áreas con gran demanda general o en profesiones emergentes, se permite separar la evaluación del título de su asignación. Cuando los profesionales se trasladan a otras regiones o instituciones, sus títulos se vuelven a evaluar o confirmar según las competencias administrativas, salvo que existan normativas nacionales distintas (a nivel nacional)."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Fuentes originales"]},{"tag":"p","props":{"className":"life-citations"},"children":["人力资源和社会保障部令第 40 号 (2019). 职称评审管理暂行规定. ",{"tag":"a","props":{"href":"https://www.gov.cn/gongbao/content/2019/content_5437137.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/gongbao/content/2019/content_5437137.htm"]},"：第二条、第二十九条；中共中央办公厅、国务院办公厅 (2016). 关于深化职称制度改革的意见. ",{"tag":"a","props":{"href":"https://www.gov.cn/gongbao/content/2017/content_5163445.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/gongbao/content/2017/content_5163445.htm"]},"：「对于全面实行岗位管理、专业技术人才学术技术水平与岗位职责密切相关的事业单位，一般应在岗位结构比例内开展职称评审。对于不实行岗位管理的单位，以及通用性强、广泛分布在各社会组织的职称系列和新兴职业，可采用评聘分开方式。」"]},{"tag":"a","props":{"href":"https://www.gov.cn/gongbao/content/2019/content_5437137.htm","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Abrir fuente"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Nota del autor"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["El nivel de evidencia se clasifica como B porque los documentos oficiales solo describen cómo se relacionan la evaluación y la asignación de puestos, pero no ofrecen cifras nacionales unificadas sobre el aumento salarial que conlleva obtener el título. Lo que sí se puede hacer es: en instituciones públicas y empresas estatales, consultar primero al departamento de recursos humanos sobre las plazas disponibles y las normas de asignación de puestos; en empresas privadas, preguntar al jefe si reconoce el título y si supone un aumento salarial."]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Mi nota"]},{"tag":"button","props":{"type":"button"},"children":["Escribe un recordatorio…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/es/tip/23-22"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12