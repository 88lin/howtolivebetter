ook/12"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"目次に戻る"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["起業とビジネス：全財産を失わないために"]},{"tag":"div","props":{"data-ad-dock-host":"true"},"children":[]},{"tag":"nav","props":{"aria-label":"この章のヒント"},"children":[{"tag":"a","props":{"href":"/ja/tip/12-01"},"children":[{"tag":"span","props":{},"children":["01"]},"失ってもよい金額のみで起業する：家財を投じず、借金をして開業しない"]},{"tag":"a","props":{"href":"/ja/tip/12-02"},"children":[{"tag":"span","props":{},"children":["02"]},"会社への融資に対して個人保証に署名しない、配偶者も絶対に署名しない"]},{"tag":"a","props":{"href":"/ja/tip/12-03"},"children":[{"tag":"span","props":{},"children":["03"]},"開業前に正しい主体を選ぶ：個人事業主と組合員は最後まで責任を負い、有限会社のみが「有限」となる"]},{"tag":"a","props":{"href":"/ja/tip/12-04"},"children":[{"tag":"span","props":{},"children":["04"]},"名義上の株主にならない、他人のために株式を保有（名義貸し）しない"]},{"tag":"a","props":{"href":"/ja/tip/12-05"},"children":[{"tag":"span","props":{},"children":["05"]},"加盟前に商務部の備案を確認し、書面による開示を受け、契約書に「クーリングオフ期間」を明記する"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/ja/tip/12-06","data-status":"active"},"children":[{"tag":"span","props":{},"children":["06"]},"登録前に名称、営業所、経営範囲、登録資本金を確定させる。書類が揃っていればその場で免許を取得できる"]},{"tag":"a","props":{"href":"/ja/tip/12-07"},"children":[{"tag":"span","props":{},"children":["07"]},"許可証が必要な業種：許可が下りるまで営業禁止"]},{"tag":"a","props":{"href":"/ja/tip/12-08"},"children":[{"tag":"span","props":{},"children":["08"]},"食品販売はまず自分の区分を確認：製造・飲食は許可が必要、既包装の販売は届出のみ、生鮮肉・野菜は許可不要"]},{"tag":"a","props":{"href":"/ja/tip/12-09"},"children":[{"tag":"span","props":{},"children":["09"]},"袋詰め販売は「既包装食品」：ラベルの製造日、賞味期限、原材料名はすべて必須"]},{"tag":"a","props":{"href":"/ja/tip/12-10"},"children":[{"tag":"span","props":{},"children":["10"]},"一般食品で病気が治せると言うのは禁止：ラベル、説明書、広告、ライブ配信の台本すべてが対象"]},{"tag":"a","props":{"href":"/ja/tip/12-11"},"children":[{"tag":"span","props":{},"children":["11"]},"食品業界には刑事罰のラインがある：病死した肉や基準超過品を売れば罪に問われ、有害物質の混入は金額に関わらず、刑期は5年起算"]},{"tag":"a","props":{"href":"/ja/tip/12-12"},"children":[{"tag":"span","props":{},"children":["12"]},"営業許可取得後から申告義務が発生。収入がなくても期限内に「ゼロ申告」を行うこと（すべてゼロの書類を提出する）"]},{"tag":"a","props":{"href":"/ja/tip/12-13"},"children":[{"tag":"span","props":{},"children":["13"]},"請求書は実際の取引に基づいてのみ発行し、小規模納税者は免税枠を最大限活用する"]},{"tag":"a","props":{"href":"/ja/tip/12-14"},"children":[{"tag":"span","props":{},"children":["14"]},"税務局を名乗り納税を催促してくるのはすべて詐欺です。納税手続きは電子税務局と 12366 を通じてのみ行ってください"]},{"tag":"a","props":{"href":"/ja/tip/12-15"},"children":[{"tag":"span","props":{},"children":["15"]},"「手付金（定金）」と記載し「予約金（订金）」とは書かないこと。違約金は金額を明記し、支払猶予期間（売掛）は貸付として審査すること"]},{"tag":"a","props":{"href":"/ja/tip/12-16"},"children":[{"tag":"span","props":{},"children":["16"]},"雇用後の最初の1ヶ月以内に書面契約を締結し、30 日以内に社会保険登録を行う"]},{"tag":"a","props":{"href":"/ja/tip/12-17"},"children":[{"tag":"span","props":{},"children":["17"]},"賃金は契約と法律に従って支払い、昇給、貸付、ボーナスはすべて書面で行う"]},{"tag":"a","props":{"href":"/ja/tip/12-18"},"children":[{"tag":"span","props":{},"children":["18"]},"販売してから製造：予約販売と小規模注文で需要を検証してから、製造に投資する"]},{"tag":"a","props":{"href":"/ja/tip/12-19"},"children":[{"tag":"span","props":{},"children":["19"]},"サンプル完成後は、まず量産チェックリストを確認してから着手すること"]},{"tag":"a","props":{"href":"/ja/tip/12-20"},"children":[{"tag":"span","props":{},"children":["20"]},"仕入れのたびに伝票と仕入れ元情報を保管すること。市場価格より明らかに低い仕入れ値のものは仕入れない：従業員が仕入れた偽物で、社長が判決を受けた事例"]},{"tag":"a","props":{"href":"/ja/tip/12-21"},"children":[{"tag":"span","props":{},"children":["21"]},"商品、パッケージ、タグ、宣伝画像に使用する図案は、自作するかライセンスを購入すること。色の変更やアイコンの追加は「改変」とはみなされない"]},{"tag":"a","props":{"href":"/ja/tip/12-22"},"children":[{"tag":"span","props":{},"children":["22"]},"職務においては規定に従って行動し、規定外の善意はまず責任の所在を明確にすること"]},{"tag":"a","props":{"href":"/ja/tip/12-23"},"children":[{"tag":"span","props":{},"children":["23"]},"損失が出たら手続きに従って退場を：簡便な注銷ができるなら注銷し、債務超過なら破産を。放置してはいけない"]},{"tag":"a","props":{"href":"/ja/tip/12-24"},"children":[{"tag":"span","props":{},"children":["24"]},"ネットショップの運営代行、開店セミナー、 「無在庫販売」に手を出して費用を支払う前に、追加料金の有無と売上の出所を必ず確認すること"]},{"tag":"a","props":{"href":"/ja/tip/12-25"},"children":[{"tag":"span","props":{},"children":["25"]},"中国で会社や個人事業を営むなら、毎年1月1日〜6月30日に前年の年次報告をオンライン提出。営業がなくても必要で、無料"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"現在地"},"children":[{"tag":"a","props":{"href":"/ja/book"},"children":["本を読む"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/ja/book/12"},"children":["第12章"," ·"," ","起業とビジネス：全財産を失わないために"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"12-06"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["06"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["エビデンス"," ","A"]}]},{"tag":"h1","props":{"lang":"ja"},"children":["登録前に名称、営業所、経営範囲、登録資本金を確定させる。書類が揃っていればその場で免許を取得できる"]},{"tag":"p","props":{"lang":"ja","className":"life-entry-summary"},"children":["登記自体に費用はかかりません。登録手数料は 2015 年から徴収が停止されています。提出が必要な書類は、申請書、身分証明書または資格証明書、営業所に関する書類、定款または合意書（個人事業主は不要）、および法令で別途指定された書類の5点のみです。書類が揃っていればその場で免許が交付され、即時交付できない場合でも 3 営業日以内に完了します。徴収された費用は、その多くが代行業者への手数料です。"]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["費用・手間"]},{"tag":"p","props":{},"children":["登記のステップに費用はかかりません。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["効果"]},{"tag":"p","props":{},"children":["条例では、提出が必要な書類は以下の5項目と明確に定められています。「（一）申請書」。"]}]}]},{"tag":"div","props":{"