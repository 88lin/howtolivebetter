lassName":"lucide lucide-circle-user-round","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M18 20a6 6 0 0 0-12 0"},"children":[]},{"tag":"circle","props":{"cx":"12","cy":"10","r":"4"},"children":[]},{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},{"tag":"span","props":{},"children":["Войти"]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/ru/book/28"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"К содержанию"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["Не ломайте здоровье ради внешности"]},{"tag":"nav","props":{"aria-label":"Советы главы"},"children":[{"tag":"a","props":{"href":"/ru/tip/28-01"},"children":[{"tag":"span","props":{},"children":["01"]},"Не стоит прибегать к экстремальным диетам, голоданию или вызыванию рвоты для контроля веса — если хотите похудеть, делайте это с помощью физических упражнений"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/ru/tip/28-02","data-status":"active"},"children":[{"tag":"span","props":{},"children":["02"]},"Прежде чем колоть, вживлять нити или ложиться под нож, проверьте две вещи: есть ли в лицензии учреждения пункт «косметологическая медицина» и является ли оперирующий лечащим врачом-специалистом (主诊医师资格)"]},{"tag":"a","props":{"href":"/ru/tip/28-03"},"children":[{"tag":"span","props":{},"children":["03"]},"При наполнении лица избегайте переносицы, межбровья и лба; тем более не ищите неофициальные инъекции ради экономии"]},{"tag":"a","props":{"href":"/ru/tip/28-04"},"children":[{"tag":"span","props":{},"children":["04"]},"Таблетки для похудения, «жиросжигающий» кофе, конфеты для стройности и «энзимные» сливы (сливы, якобы вымоченные в энзимах) с обещанием «быстро похудеть» — не покупать"]},{"tag":"a","props":{"href":"/ru/tip/28-05"},"children":[{"tag":"span","props":{},"children":["05"]},"Анаболические стероиды («уколы для массы», «таблетки») — не средство нарастить мышцы"]},{"tag":"a","props":{"href":"/ru/tip/28-06"},"children":[{"tag":"span","props":{},"children":["06"]},"Если хотите препарат для похудения — идите в больницу за рецептом, а не покупайте в интернет-магазине, который отправляет без рецепта"]},{"tag":"a","props":{"href":"/ru/tip/28-07"},"children":[{"tag":"span","props":{},"children":["07"]},"Половые гормоны применяйте только по назначению врача и с регулярными повторными обследованиями; не покупайте через интернет и не увеличивайте дозу сами"]},{"tag":"a","props":{"href":"/ru/tip/28-08"},"children":[{"tag":"span","props":{},"children":["08"]},"Если «кажется, что я уродлив» уже дошло до постоянных разглядываний в зеркале и навязчивых мыслей об исправлении, сначала пройдите оценку образа тела и только потом говорите об операции"]},{"tag":"a","props":{"href":"/ru/tip/28-09"},"children":[{"tag":"span","props":{},"children":["09"]},"Для исправления прикуса обратитесь очно к врачу с ортодонтической квалификацией и регулярно приходите на контроль; не покупайте элайнеры онлайн для самостоятельного ношения дома"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"Навигация"},"children":[{"tag":"a","props":{"href":"/ru/book"},"children":["Книга"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/ru/book/28"},"children":["Глава 28"," ·"," ","Не ломайте здоровье ради внешности"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"28-02"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["02"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["Доказательства"," ","A"]}]},{"tag":"h1","props":{"lang":"ru"},"children":["Прежде чем колоть, вживлять нити или ложиться под нож, проверьте две вещи: есть ли в лицензии учреждения пункт «косметологическая медицина» и является ли оперирующий лечащим врачом-специалистом (主诊医师资格)"]},{"tag":"p","props":{"lang":"ru","className":"life-entry-summary"},"children":["Всё, что связано с операцией, уколом, применением медицинских изделий — то есть нарушает кожу или проникает внутрь тела, — считается медицинской деятельностью и может выполняться только в учреждении, получившем «Лицензию на медицинскую деятельность», где в лицензии утверждена специальность «косметологическая медицина». Врач, который проводит процедуру, должен иметь квалификацию практикующего врача и быть зарегистрирован; тому, кто делает косметическую хирургию, требуется ещё не менее 6 лет клинической работы в пластической или косметической хирургии. Делать это в салоне красоты, студии или гостиничном номере — незаконное врачевание: в тяжёлых случаях — до 3 лет лишения свободы, при причинении вреда здоровью — от 3 до 10 лет, при гибели человека — свыше 10 лет. Перед процедурой врач обязан письменно сообщить показания, противопоказания и риски и взять подпись; если этот шаг пропущен, значит, сам порядок нарушен."]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Затраты"]},{"tag":"p","props":{},"children":["0 юаней; проверка двух документов занимает несколько минут…"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Польза"]},{"tag":"p","props":{},"children":["«Правила управления услугами косметологической медицины» (医疗美容服务管理办法), статья 2, определяют косметологическую…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"Отметить: Прежде чем колоть, вживлять нити или ложиться под нож, проверьте две вещи: есть ли в лицензии учреждения пункт «косметологическая медицина» и является ли оперирующий лечащим врачом-специалистом (主诊医师资格)"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"Сделано"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"В планах"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"В избранное"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Поделиться советом"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Скрыть подробности"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Затраты"]},{"tag":"p","props":{},"children":["0 юаней; проверка двух документов занимает несколько минут; учреждение обязано вывесить «Лицензию на медицинскую деятельность» (医疗机构执业许可证) в холле, а квалификацию врача можно проверить в реестре практикующих врачей ведомства здравоохранения"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Польза"]},{"tag":"p","props":{},"children":["«Правила управления услугами косметологической медицины» (医疗美容服务管理办法), статья 2, определяют косметологическую медицину как «восстановление и переформирование внешности человека и формы отдельных частей его тела с помощью операций, лекарств, медицинских изделий и иных медицинских методов, обладающих травматичностью или инвазивностью»; статьи 8 и 24 требуют сначала получить «Лицензию на медицинскую деятельность» и получить утверждение регистрирующего органа на вид медицинской помощи «косметологическая медицина»; статья 11 требует, чтобы лечащий врач-специалист (主诊医师资格) имел квалификацию практикующего врача и был зарегистрирован, причём для косметической хирургии требуется не менее 6 лет профильной клинической работы, для косметической стоматологии — 5 лет, для косметической китайской медицины и косметической дерматологии — по 3 года; статья 20 требует перед проведением письменно сообщить показания, противопоказания, медицинские риски и меры предосторожности и получить подписанное согласие. Уголовный кодекс КНР, статья 336: тот, кто занимается незаконным врачеванием без квалификации практикующего врача, в тяжёлых случаях наказывается лишением свободы на срок до 3 лет, арестом или исправительными работами, со штрафом или без него; при серьёзном вреде здоровью пациента — лишением свободы на срок от 3 до 10 лет со штрафом; при гибели пациента — лишением свободы на срок свыше 10 лет со штрафом"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Первоисточники"]},{"tag":"p","props":{"className":"life-citations"},"children":["卫生部 (2002). 医疗美容服务管理办法（卫生部令第 19 号，第二条、第八条、第十一条、第十六条、第二十条、第二十四条）. ",{"tag":"a","props":{"href":"http://www.gov.cn/gongbao/content/2003/content_62198.htm","target":"_blank","rel":"noopener noreferrer"},"children":["http://www.gov.cn/gongbao/content/2003/content_62198.htm"]},"；全国人大 (1997). 刑法（第三百三十六条）. ",{"tag":"a","props":{"href":"https://www.spp.gov.cn/spp/fl/201802/t20180206_364975.shtml","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.spp.gov.cn/spp/fl/201802/t20180206_364975.shtml"]}]},{"tag":"a","props":{"href":"http://www.gov.cn/gongbao/content/2003/content_62198.htm","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Открыть источник"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Примечание автора"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["Та же статья 16 этих Правил требует, чтобы проекты косметологической медицины проводились в косметологическом медицинском учреждении или в медицинском учреждении, где открыт кабинет косметологической медицины, поэтому «выезд на дом» и «приватная студия» уже сами по себе не соответствуют правилам. Статья 20 прямо гласит: «без согласия законного представителя не проводить проекты косметологической медицины для лиц без дееспособности или с ограниченной дееспособностью», — косметологическая медицина для несовершеннолетних требует подписи законного представителя. Бытовая косметология (уход за лицом, массаж, маникюр) в этот круг не входит, но как только речь заходит об игле и скальпеле — это уже косметологическая медицина."]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Моя заметка"]},{"tag":"button","props":{"type":"button"},"children":["Запишите напоминание…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/ru/tip/28-01"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Предыдущий"]},"Не стоит прибегать к экстремальным диетам, голоданию или вызыванию рвоты для контроля веса — если хотите похудеть, делайте это с помощью физических упражнений"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/ru/tip/28-03"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Следующий"]},"При наполнении лица избегайте переносицы, межбровья и лба; тем более не ищите неофициальные инъекции ради экономии"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"chil