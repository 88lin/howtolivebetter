dth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"このヒントを共有"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"詳細を閉じる"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["費用・手間"]},{"tag":"p","props":{},"children":["費用はかかりません。自分が今何歳か、1分間計算してみてください。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["効果"]},{"tag":"p","props":{},"children":["《義務教育法》第11条：「6歳に達したすべての児童は、その父母またはその他の法定後見人が、義務教育を受けるために学校へ入学させ、これを完了させなければならない」。第14条：「雇用主が、義務教育を受けるべき適齢期の児童および少年を雇用することを禁止する」。第58条：正当な理由なく、本法の規定に従って適齢期の児童および少年を学校に入学させない場合は、現地の郷鎮人民政府または県級人民政府の教育行政部門により「批判的な教育を与え、期限内に是正するよう命じるものとする」。《児童労働の使用禁止規定》第2条：国家機関、社会団体、企業、事業単位、民間の非営利団体、または個人事業主は、「いずれも16歳に満たない未成年者を雇用してはならない」。第六条：「児童労働者1名につき、月額5000元の罰金を科す基準に従って処罰を行う」。期限内に是正されない場合は、1人につき月額1万元の罰金を科す。第七条：児童労働者の就業を仲介した場合は、「1人の紹介につき5000元の罰金を科す」。第十条：児童労働者が病気や怪我をした場合、雇用主は「医療機関への搬送および治療の責任を負い、治療期間中のすべての医療費および生活費を負担しなければならない」。障害が残った場合や死亡した場合には、一括賠償も行うものとする。第十三条には唯一の例外が残されている：文芸・体育団体は、父母またはその他の法定代理人の同意を得た上で、満16歳に満たない専門的な文芸従事者およびアスリートを雇用することができる（全国）"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["出典"]},{"tag":"p","props":{"className":"life-citations"},"children":["全国人大常委会 (2018). 义务教育法（2018 年第二次修正，第十一、十四、五十八条）. ",{"tag":"a","props":{"href":"http://www.moe.gov.cn/jyb_sjzl/sjzl_zcfg/zcfg_jyfl/202110/t20211029_575949.html","target":"_blank","rel":"noopener noreferrer"},"children":["http://www.moe.gov.cn/jyb_sjzl/sjzl_zcfg/zcfg_jyfl/202110/t20211029_575949.html"]},"（教育部刊登）；国务院 (2002). 禁止使用童工规定（国务院令第 364 号，第二、六、七、十、十三条）. ",{"tag":"a","props":{"href":"http://www.gov.cn/gongbao/content/2002/content_61798.htm","target":"_blank","rel":"noopener noreferrer"},"children":["http://www.gov.cn/gongbao/content/2002/content_61798.htm"]}]},{"tag":"a","props":{"href":"http://www.moe.gov.cn/jyb_sjzl/sjzl_zcfg/zcfg_jyfl/202110/t20211029_575949.html","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["出典を開く"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["著者の注記"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["利益を得るのは自分自身です.16歳を過ぎれば、働くことは合法です。しかし、16歳で学歴のない人を雇うような職種は、まさに本節の第10条（自動化に抗うスキル）で述べた類のもの、すなわち、プロセスが固定されており、最も機械に取って代わられやすいものです。第19節で扱う残業代、年次有給休暇、労災補償などは、すべて労働関係があり、証拠があることが前提となります。闇労働にはそのどちらも欠けているため、それらの金銭を受け取ることもできません。"]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["自分のメモ"]},{"tag":"button","props":{"type":"button"},"children":["自分へのメモを書く…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"span","props":{},"children":[]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/ja/tip/23-02"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["次へ"]},"「読書に意味があるか」も死亡率の計算に含める：教育年数が1年増えるごとに、成人の死亡リスクは約 1.9% 低下する"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["このテーマの他の提案"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/23-03"},"children":[{"tag":"strong","props":{},"children":["「学歴の価値が下がったのか」を判断する前に、まず全国の学歴構成を見る：10万人につき短大・大学以上の学歴を持つ人は15467人（2020年国勢調査。2025年の標本調査による推計では約19%）"]},{"tag":"span","props":{},"children":["2020年の国勢調査では、全国の短大・大学以上の学歴を持つ人は約15%だった。2025年の標本調査による推計では約19%で、5年間で数パー…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/23-04"},"children":[{"tag":"strong","props":{},"children":["「学費が払えない」はまず政策に照らして計算してみる：中等職業学校の学費は多くが免除済み、助学金は 2300 元、奨学金は年間最大 2 万"]},{"tag":"span","props":{},"children":["公立の中等職業学校では、農村部の学生、都市部の農業関連専攻の学生、および経済的困難を抱える学生の学費はすでに免除されています。中等職業学校…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/23-05"},"children":[{"tag":"strong","props":{},"children":["普通高校に入学できなかったからといって道が断たれたわけではない：中等職業教育には接続型入試や単独試験があり、技能職の採用では学歴要件が緩和されることもある"]},{"tag":"span","props":{},"children":["2022 年の職業教育法には、「職業教育と普通教育の地位は等しく重要である」と明記されています。中等職業教育（中職）は高等職業教育（高職）…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/23-06"},"children":[{"tag":"strong","props":{},"children":["「進学か就職か」を一つの計算問題として考える：先に働いて早めに得る3年分の給与と、進学によって得られるその後数十年にわたる年収差の比較"]},{"tag":"span","props":{},"children":["先に働けば、数年分の給与を早く得られますが、このお金は一度きりです。進学すれば、その後は毎年、進学しなかった場合より少し多く稼げ、それが3…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/23-07"},"children":[{"tag":"strong","props":{},"children":["まずは基準となる数値（ベースライン）を覚えておきましょう：教育期間が1年増えることによる、世界平均の私的収益（個人の所得に反映される部分）は、年間約 9% です"]},{"tag":"span","props":{},"children":["世界平均で見ると、教育期間が1年増えるごとに個人の所得は年間約 9% 高くなり、女性の収益率は一貫して男性よりも高い傾向にあります。この数…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/23-08"},"children":[{"tag":"strong","props":{},"children":["資格取得にお金を使う前に、その資格が国家職業資格目録または人社部（人材資源社会保障部）の備案済み評価機関リストに含まれているか確認しましょう"]},{"tag":"span","props":{},"children":["一部の機関が「新しい職業」や「技能等級」の名を借りて、無秩序な講座開設、不当な費用徴収、証明書の乱発を行っており、権威ある機関を装うケース…"]}]}]}]},{"tag":"a","props":{"className":"life-text-link","href":"/ja/book/23"},"children":["テーマ全体を読む：何のスキルを学ぶのが最も効率的か"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"15","height":"15","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children