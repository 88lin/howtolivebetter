,"children":["登录同步"]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/book/30"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"返回目录"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["上学以后的孩子"]},{"tag":"nav","props":{"aria-label":"章节条目"},"children":[{"tag":"a","props":{"href":"/tip/30-01","className":""},"children":[{"tag":"span","props":{},"children":["01"]},"孩子说突然剧痛、而且越来越重，立刻去医院，不要让他忍到放学"]},{"tag":"a","props":{"href":"/tip/30-02","className":""},"children":[{"tag":"span","props":{},"children":["02"]},"该做的治疗别为了「等考完」往后拖，有些窗口跟着骨龄走，不跟着考试安排走"]},{"tag":"a","props":{"href":"/tip/30-03","className":"active"},"children":[{"tag":"span","props":{},"children":["03"]},"孩子被欺凌，当天就报到学校并要求书面处理，涉及打人、抢钱、传谣的直接报警"]},{"tag":"a","props":{"href":"/tip/30-04","className":""},"children":[{"tag":"span","props":{},"children":["04"]},"让孩子每天在户外待够 2 小时，这是目前不花钱、不用药的办法里，唯一有随机试验支持的防近视办法"]},{"tag":"a","props":{"href":"/tip/30-05","className":""},"children":[{"tag":"span","props":{},"children":["05"]},"0 到 3 岁不给屏幕，3 到 6 岁尽量不给，中小学生非学习用途每天不超过 1 小时"]},{"tag":"a","props":{"href":"/tip/30-06","className":""},"children":[{"tag":"span","props":{},"children":["06"]},"把近视当成会留下的损伤：度数越深，将来视网膜脱离、黄斑病变、青光眼越多"]},{"tag":"a","props":{"href":"/tip/30-07","className":""},"children":[{"tag":"span","props":{},"children":["07"]},"每年那次学生体检的报告单要自己看一遍，异常项当年带去医院查"]},{"tag":"a","props":{"href":"/tip/30-08","className":""},"children":[{"tag":"span","props":{},"children":["08"]},"12 到 18 岁的孩子做一次抑郁筛查，别拿学校的心理测评当诊断"]},{"tag":"a","props":{"href":"/tip/30-09","className":""},"children":[{"tag":"span","props":{},"children":["09"]},"不买号称能「治愈近视」「降低度数」的产品和服务"]},{"tag":"a","props":{"href":"/tip/30-10","className":""},"children":[{"tag":"span","props":{},"children":["10"]},"睡眠、作业、体育和排名都有明文规定，学校做不到可以提"]},{"tag":"a","props":{"href":"/tip/30-11","className":""},"children":[{"tag":"span","props":{},"children":["11"]},"孩子撑不住了可以休学，学籍学校必须给他留着，最长 1 年"]},{"tag":"a","props":{"href":"/tip/30-12","className":""},"children":[{"tag":"span","props":{},"children":["12"]},"查出视力不良，去医院做散瞳验光，之后按医生给的间隔复查"]},{"tag":"a","props":{"href":"/tip/30-13","className":""},"children":[{"tag":"span","props":{},"children":["13"]},"恒磨牙长出来以后做窝沟封闭"]},{"tag":"a","props":{"href":"/tip/30-14","className":""},"children":[{"tag":"span","props":{},"children":["14"]},"孩子爱打游戏，先看睡觉、作业和出门活动有没有被挤掉，别光盯着玩了多久"]},{"tag":"a","props":{"href":"/tip/30-15","className":""},"children":[{"tag":"span","props":{},"children":["15"]},"孩子说自己喜欢同性，别骂、别赶出家门、别送去「矫正」：家里的态度和他会不会自杀有关"]},{"tag":"a","props":{"href":"/tip/30-16","className":""},"children":[{"tag":"span","props":{},"children":["16"]},"管孩子别动手打，也别吼骂、骂他笨：常挨打挨骂的孩子，行为和情绪问题都更多"]},{"tag":"a","props":{"href":"/tip/30-17","className":""},"children":[{"tag":"span","props":{},"children":["17"]},"孩子难管、自己总忍不住打骂，去上一期教具体做法的家长课"]},{"tag":"a","props":{"href":"/tip/30-18","className":""},"children":[{"tag":"span","props":{},"children":["18"]},"别把孩子送进封闭管理的「戒网瘾学校」「特训营」：法律禁止用伤害身心的办法戒网瘾，已经有孩子被关死"]},{"tag":"a","props":{"href":"/tip/30-19","className":""},"children":[{"tag":"span","props":{},"children":["19"]},"教孩子认识身体的隐私部位，被人碰了、被要求保密都要回家说；孩子说了先信、别骂，带去报警和就医"]},{"tag":"a","props":{"href":"/tip/30-20","className":""},"children":[{"tag":"span","props":{},"children":["20"]},"别让不满 12 周岁的孩子骑自行车上路、不满 16 周岁的骑电动自行车上路：撞了人父母赔，自己被撞也可能要担一部分"]},{"tag":"a","props":{"href":"/tip/30-21","className":""},"children":[{"tag":"span","props":{},"children":["21"]},"孩子运动时撞了头、之后头痛头晕或者发懵，当天别再上场；吐了又吐、越来越困、头痛越来越重，立刻去急诊"]}]}]},{"tag":"div","props":{"className":"life-tip-page","data-tip-locales":"zh,en,ru,es,ja,vi"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"当前位置"},"children":[{"tag":"a","props":{"href":"/book"},"children":["阅读全书"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/book/30"},"children":["第 30 章 · 上学以后的孩子"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"30-03"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["03"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["证据 A"]}]},{"tag":"h1","props":{"lang":"zh"},"children":["孩子被欺凌，当天就报到学校并要求书面处理，涉及打人、抢钱、传谣的直接报警"]},{"tag":"p","props":{"lang":"zh","className":"life-entry-summary"},"children":["被同伴欺凌的孩子，冒出自杀念头的可能约是没被欺凌的 2.2 倍，有过自杀行为的约 2.6 倍。学校接到报告要立即调查，认定是欺凌就要惩戒或处分，严重的不许瞒，必须报公安。所以当天就报，要求走认定程序，留下书面记录。"]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["成本"]},{"tag":"p","props":{},"children":["不花钱。找班主任，也找学校的学生欺凌治理组织。要报警就打 110。难在要顶住「别把事闹大」这类劝法。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["收益"]},{"tag":"p","props":{},"children":["34 项研究、284,375 名儿童青少年合起来算。被同伴欺凌和冒出自杀念头相关，OR 2.23（95% CI 2.10–2.37），出现念头的机会约为没被欺凌的 2.2 倍。另有 9 项研究、70,102 人，被欺凌和自杀未遂相关，OR 2.55（1.95–3.34），约 2.6 倍。男女、年龄和…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"标记：孩子被欺凌，当天就报到学校并要求书面处理，涉及打人、抢钱、传谣的直接报警"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"已做到"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"加入待做"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"收藏"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"分享这条建议"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"收起详情"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["成本"]},{"tag":"p","props":{"className":"life-citations"},"children":["不花钱。找班主任，也找学校的学生欺凌治理组织。要报警就打 110。难在要顶住「别把事闹大」这类劝法。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["收益"]},{"tag":"p","props":{"className":"life-citations"},"children":["34 项研究、284,375 名儿童青少年合起来算。被同伴欺凌和冒出自杀念头相关，OR 2.23（95% CI 2.10–2.37），出现念头的机会约为没被欺凌的 2.2 倍。另有 9 项研究、70,102 人，被欺凌和自杀未遂相关，OR 2.55（1.95–3.34），约 2.6 倍。男女、年龄和研究本身质量不同，结果都一样。网络欺凌和自杀念头的关联比线下欺凌更强。《未成年人学校保护规定》第二十一条列出五类行为：殴打、脚踢、掌掴、抓咬、推撞、拉扯；辱骂、讥讽、起侮辱性绰号；抢夺、强拿硬要或故意毁坏财物；恶意排斥孤立；通过网络捏造事实诽谤或散布谣言。该条还规定，在年龄、身体或人数上占优势的一方蓄意或恶意做这些事，造成人身伤害、财产损失或精神损害的，可以认定为欺凌。第二十二条要求教职工发现学生情绪反常、身体损伤，应及时了解并报告。第二十三条要求学校接到报告立即调查，提交欺凌治理组织认定处置，并通知家长参与。认定构成欺凌的，要作出教育惩戒或纪律处分。对违反治安管理或涉嫌犯罪的严重欺凌行为不得隐瞒，应当及时向公安机关、教育行政部门报告（全国，2021 年 9 月 1 日起施行）"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["来源"]},{"tag":"p","props":{"className":"life-citations"},"children":["van Geel M, et al. (2014). Relationship between peer victimization, cyberbullying, and suicide in children and adolescents: a meta-analysis. JAMA Pediatrics. ",{"tag":"a","props":{"href":"https://doi.org/10.1001/jamapediatrics.2013.4143","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1001/jamapediatrics.2013.4143"]},"；教育部 (2021). 未成年人学校保护规定（教育部令第 50 号，第二十一、二十二、二十三条）. ",{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/2021-06/02/content_5614946.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/zhengce/zhengceku/2021-06/02/content_5614946.htm"]},"；教育部等十一部门 (2017). 加强中小学生欺凌综合治理方案（教督〔2017〕10 号，三（一））. ",{"tag":"a","props":{"href":"https://www.gov.cn/gongbao/content/2018/content_5294435.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/gongbao/content/2018/content_5294435.htm"]},""]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["原书备注"]},{"tag":"p","props":{"className":"life-citations"},"children":["第二十二条点名的信号是明显的情绪反常和身体损伤。孩子身上出现说不清来由的伤，或者情绪突然不对，先去问。这份把多项研究合起来算的分析只是跟踪记录、没有分组对照，所以不能证明单是欺凌就导致自杀。但风险的方向和大小是清楚的。《加强中小学生欺凌综合治理方案》另外要求严格区分欺凌与学生之间的打闹嬉戏。所以学校有义务作出认定，不能一句「小孩子闹着玩」了事。"]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["我的备注"]},{"tag":"button","props":{"type":"button"},"children":["写下对自己有用的提醒…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/tip/30-02"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["上一条"]},"该做的治疗别为了「等考完」往后拖，有些窗口跟着骨龄走，不跟着考试安排走"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/tip/30-04"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["下一条"]},"让孩子每天在户外待够 2 小时，这是目前不花钱、不用药的办法里，唯一有随机试验支持的防近视办法"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["本主题的其他建议"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/30-01"},"children":[{"tag":"strong","props":{},"children":["孩子说突然剧痛、而且越来越重，立刻去医院，不要让他忍到放学"]},{"tag":"span","props":{},"children":["有些病是按小时算的。男孩突然一侧阴囊剧痛，可能是睾丸扭转，也就是睾丸连着的那根血管拧住了，血供断了。6 小时内处理，睾丸保住的比例 97.2%。拖到 19 至…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/30-05"},"children":[{"tag":"strong","props":{},"children":["0 到 3 岁不给屏幕，3 到 6 岁尽量不给，中小学生非学习用途每天不超过 1 小时"]},{"tag":"span","props":{},"children":["国家卫健委要求 0 到 3 岁不给屏幕，3 到 6 岁尽量别碰。中小学生不为学习用的，一次不超过 15 分钟、一天不超过 1 小时。理由是长时间近距离用眼会让近…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/30-06"},"children":[{"tag":"strong","props":{},"children":["把近视当成会留下的损伤：度数越深，将来视网膜脱离、黄斑病变、青光眼越多"]},{"tag":"span","props":{},"children":["近视不会自己好，度数也降不回去。它也不只是「戴个眼镜」的事。和不近视的人比，得近视性黄斑病变的可能，轻度近视高十几倍，600 度以上高几百倍。视网膜脱离，轻度高…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/30-07"},"children":[{"tag":"strong","props":{},"children":["每年那次学生体检的报告单要自己看一遍，异常项当年带去医院查"]},{"tag":"span","props":{},"children":["中小学校每年组织一次学生体检。报告单上要重点看的是超重、肥胖、营养不良、脊柱弯曲异常、视力不良、龋齿。别只看一眼身高体重就收起单子。这几项有异常，当年就带孩子去…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/30-08"},"children":[{"tag":"strong","props":{},"children":["12 到 18 岁的孩子做一次抑郁筛查，别拿学校的心理测评当诊断"]},{"tag":"span","props":{},"children":["美国的预防指南建议给 12 到 18 岁的孩子筛查重度抑郁，11 岁及以下证据不够。在美国，自杀是 10 到 19 岁孩子的第二位死因。学校每年的心理测评只是普…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/30-09"},"children":[{"tag":"strong","props":{},"children":["不买号称能「治愈近视」「降低度数」的产品和服务"]},{"tag":"span","props":{},"children":["市场监管总局明说「在目前医疗技术条件下，近视不能治愈」。宣传「恢复」「降低度数」「近视治愈」「度数修复」这类说法的，要从严查处。看到这类词直接排除，不用再比价。…"]}]}]}]},{"tag":"a","props":{"className":"life-text-link","href":"/book/30"},"children":["阅读整个主题：上学以后的孩子 ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"15","height":"15","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]}]}]},{"tag":"nav","props":{"className":"life-tabbar","aria-label":"主导航"},"children":[{"tag":"a","props":{"className":"","href":"/book"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"21","height":"21","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-book-open","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M12 7v14"},"children":[]},{"tag":"path","props":{"d":"M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z"},"children"