on","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"收起详情"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["成本"]},{"tag":"p","props":{"className":"life-citations"},"children":["每次检查几十到几百元。去一趟医院加上等结果，要占一点时间。难在隔一段就得去一次，容易一拖再拖。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["收益"]},{"tag":"p","props":{"className":"life-citations"},"children":["慢性病要看的是数值一段时间里怎么变，只看某一次不够。高血压有一项汇总分析，把 15 项随机试验里 7138 人的原始数据合起来算。和照常看病的人比，在家自己量血压的人，12 个月后诊室收缩压平均变化 −3.2 mmHg（95% CI −4.9 到 −1.6，可信范围）。只自己量、不配别的措施的，看不出效果：−1.0 mmHg（−3.3 到 1.2，差别可能是碰巧）。配套支持最多的，降了 6.1 mmHg（3.2 到 9.0）。配套支持指医生、药师或病人自己按读数调药，加上健康教育、生活方式指导。作者的结论是，光自己测不能让血压更低，要配上按读数调药才有用。这些数字都是血压，没有直接看死亡。换医院时，国家卫健委等四部门的办法规定：患者提供的已有检查检验结果，符合互认条件、满足诊疗需要的，医院和医生不得重复检查检验。能互认的报告单上标着「HR」标志，比如「全国HR」"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["来源"]},{"tag":"p","props":{"className":"life-citations"},"children":["Tucker KL, Sheppard JP, Stevens R, et al. (2017). Self-monitoring of blood pressure in hypertension: A systematic review and individual patient data meta-analysis. PLoS Medicine, 14(9), e1002389. ",{"tag":"a","props":{"href":"https://doi.org/10.1371/journal.pmed.1002389","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1371/journal.pmed.1002389"]},"；国家卫生健康委、国家医保局、国家中医药局、中央军委后勤保障部卫生局 (2022). 关于印发医疗机构检查检验结果互认管理办法的通知（国卫医发〔2022〕6 号），第十三条、第十七条、第十九条. ",{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/2022-02/19/content_5674575.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/zhengce/zhengceku/2022-02/19/content_5674575.htm"]},""]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["原书备注"]},{"tag":"p","props":{"className":"life-citations"},"children":["只给 B 级，因为直接证据只有高血压一种病，终点也只到血压，没到死亡。「把指标记在一个本子上」本身有没有好处，没找到看健康结果的研究。每次至少记四样：日期、指标值、当时在吃的药、药的剂量。用手机拍化验单也行，但都要放在同一处，别东一张西一张。互认有例外：病情变了、结果变化快、手术输血之前、急诊抢救时，医院可以重查。病历和影像怎么复印留存，见第 24 节第 5 条（病历、检查报告和影像自己存一份）"]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["我的备注"]},{"tag":"button","props":{"type":"button"},"children":["写下对自己有用的提醒…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/tip/16-02"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["上一条"]},"先办门诊慢特病认定再办异地备案，高血压、糖尿病、放化疗、透析、抗排异就能异地直接结算"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/tip/16-04"},"children":[{"tag"