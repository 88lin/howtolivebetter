d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["成本"]},{"tag":"p","props":{"className":"life-citations"},"children":["不花钱。打银行客服电话或者在手机银行里申请，一次几十分钟。银行不一定同意"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["收益"]},{"tag":"p","props":{"className":"life-citations"},"children":["人民银行 2024 年的公告允许借贷双方协商变更房贷利率在 LPR 基础上的加点幅度。LPR 是贷款市场报价利率，房贷利率按它加点或减点。人民银行负责人答记者问说，原来合同里的加点幅度在整个贷款期限内固定不变，这次改了。2026 年 8 月，人民银行和金融监管总局又写进文件：已发放的浮动利率房贷，利率和全国新发放的房贷利率偏离到一定幅度时，「借款人可以与银行业金融机构协商变更合同约定的利率水平，或申请新发放浮动利率个人住房贷款置换存量贷款，方式应由借款人自主选择」。新贷款的金额不得高于原贷款剩下的本金。能省多少，按等额本息公式自己算的例子：贷 100 万元、30 年，年利率 4.0% 时月供约 4774 元，3.5% 时约 4490 元。每月少约 284 元，30 年少付利息约 10 万元"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["来源"]},{"tag":"p","props":{"className":"life-citations"},"children":["中国人民银行、金融监管总局 (2026). 关于改革完善房地产信贷管理推动加快构建房地产发展新模式的意见（银发〔2026〕171 号，第二十四条）. ",{"tag":"a","props":{"href":"https://www.gov.cn/gongbao/2026/issue_13026/202610/content_7082770.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/gongbao/2026/issue_13026/202610/content_7082770.html"]},"；中国人民银行 (2024). 中国人民银行有关负责人就完善商业性个人住房贷款利率定价机制有关问题答记者问（介绍中国人民银行公告〔2024〕第 11 号）. ",{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/202409/content_6977671.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/zhengce/202409/content_6977671.htm"]},""]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["原书备注"]},{"tag":"p","props":{"className":"life-citations"},"children":["偏离到多大幅度才能谈，文件没写具体数，以你贷款银行的公告为准。这条管的是银行发放的浮动利率房贷。银行不同意降、你手里又有闲钱的，可以按第 5 节第 28 条（提前还房贷）的算法比一比。置换不能多借，新贷款不能超过旧贷款剩下的本金。"]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["我的备注"]},{"tag":"button","props":{"type":"button"},"children":["写下对自己有用的提醒…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/tip/15-14"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["上一条"]},"买房签约前查清有没有查封和抵押，签约后去不动产登记机构办预告登记"]}]},{"tag":"span","props":{},"children":[]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["本主题的其他建议"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/15-03"},"children":[{"tag":"strong","props":{},"children":["中介不得代收代付租金和押金，钱直接给房东"]},{"tag":"span","props":{},"children":["按规定，房租和押金不能由中介代收代付，钱直接付给房东。钱在中介手里过一道，就多一次它卷款跑路的机会。真跑了，你租金白交，还会被房东赶走。付款前核对收款人是不是产…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/15-04"},"children":[{"tag":"strong","props":{},"children":["租长租公寓先查它的资金监管账户，别图便宜一次性付一年"]},{"tag":"span","props":{},"children":["一次性付一年，拿到的折扣就那么点。公司一旦倒了，你的押金和剩下十几个月的房租一起没。绑了租金贷更糟：公寓跑了，贷款还是你按月还完。签约前先查它有没有公示资金监管…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/15-05"},"children":[{"tag":"strong","props":{},"children":["房子租期内被卖掉，租约继续有效，不用搬"]},{"tag":"span","props":{},"children":["租期内房子被卖掉，你的租约照样有效。新房东要按原来的合同让你住到期满。不用搬，也不用重新谈价钱。前提是你已经合法住在里面，合同、转账记录、入住时间的证据都留好。"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/15-06"},"children":[{"tag":"strong","props":{},"children":["租房签约前核对产权证和抵押情况，所有款项走转账并备注用途"]},{"tag":"span","props":{},"children":["签约前让房东拿出身份证和产权证。再带身份证去不动产登记机构，查房子有没有抵押、有没有被查封，没签合同也能查。出租前就抵押或者查封的房子，被拍卖换了主人，你没法要…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/15-07"},"children":[{"tag":"strong","props":{},"children":["二手房让中介代收房款的，必须走中介在银行开的交易资金专用存款账户"]},{"tag":"span","props":{},"children":["房款是几十万到几百万，是这本书里单笔金额最大的一件事。中介代收房款的，按规定必须走它在银行开的专用账户，不能微信转给经纪人个人。另外，两家中介合做一单只能收一份…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/15-08"},"children":[{"tag":"strong","props":{},"children":["别租隔断房：最小出租单位是原设计的房间，厨房、卫生间、阳台不得住人"]},{"tag":"span","props":{},"children":["按规定，最小的出租单位是原来设计好的那间房。厨房、卫生间、阳台和地下储藏室不能住人。这种房被查处之后，你可能要搬走。另外，租期内房东也不能自己说涨租就涨租。"]}]}]}]},{"tag":"a","props":{"className":"life-text-link","href":"/book/15"},"children":["阅读整个主题：租房与买房 ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"15","height":"15","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]}]}]},{"tag":"nav","props":{"className":"life-tabbar","aria-label":"主导航"},"children":[{"tag":"a","props":{"className":"","href":"/book"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"21","height":"21","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-book-open","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M12 7v14"},"children":[]},{"tag":"path","props":{"d":"M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z"},"children":[]}]},{"tag":"span","props":{},"children":["全书"]}]},{"tag":"a","props":{"className":"","href":"/top-50"},"children"