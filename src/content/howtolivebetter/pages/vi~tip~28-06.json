","props":{},"children":["04"]},"Đừng mua thuốc, cà phê, kẹo giảm cân hay mận enzyme (mận được quảng cáo là ngâm enzyme) hứa hẹn «gầy nhanh»"]},{"tag":"a","props":{"href":"/vi/tip/28-05"},"children":[{"tag":"span","props":{},"children":["05"]},"Đừng dùng steroid đồng hóa (「thuốc tiêm tăng cơ」「thuốc uống」) để tăng cơ"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/vi/tip/28-06","data-status":"active"},"children":[{"tag":"span","props":{},"children":["06"]},"Đã định dùng thuốc giảm cân thì đến bệnh viện lấy đơn thuốc, đừng mua ở cửa hàng trực tuyến mà không cần đơn"]},{"tag":"a","props":{"href":"/vi/tip/28-07"},"children":[{"tag":"span","props":{},"children":["07"]},"Chỉ dùng thuốc hormone giới tính khi bác sĩ kê đơn và có tái khám định kỳ; đừng mua trên mạng, đừng tự tăng liều"]},{"tag":"a","props":{"href":"/vi/tip/28-08"},"children":[{"tag":"span","props":{},"children":["08"]},"Nếu「cảm thấy mình xấu」đã đến mức soi gương lặp đi lặp lại, muốn sửa đi sửa lại, thì làm một đánh giá về hình thể trước khi nói đến phẫu thuật"]},{"tag":"a","props":{"href":"/vi/tip/28-09"},"children":[{"tag":"span","props":{},"children":["09"]},"Chỉnh nha cần bác sĩ có chuyên môn chỉnh nha khám trực tiếp, tái khám đúng hẹn; đừng mua khay trên mạng rồi tự đeo ở nhà"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"Breadcrumbs"},"children":[{"tag":"a","props":{"href":"/vi/book"},"children":["Khám phá cuốn sách"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/vi/book/28"},"children":["Chương 28"," ·"," ","Đừng phá hỏng cơ thể vì ngoại hình"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"28-06"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["06"]},{"tag":"span","props":{"className":"life-evidence grade-b"},"children":["Bằng chứng"," ","B"]}]},{"tag":"h1","props":{"lang":"vi"},"children":["Đã định dùng thuốc giảm cân thì đến bệnh viện lấy đơn thuốc, đừng mua ở cửa hàng trực tuyến mà không cần đơn"]},{"tag":"p","props":{"lang":"vi","className":"life-entry-summary"},"children":["Thuốc kê đơn bắt buộc phải bán bằng đơn thuốc, bán trên mạng cũng vậy: phải có đơn thật và định danh thật. Cửa hàng không hỏi khám, không cần đơn, đặt hàng là gửi ngay thì hoặc là bán không phải thứ nó nói, hoặc là cửa hàng đó vi phạm quy định. Khi xảy ra sự cố, không ai chịu trách nhiệm về liều lượng và chống chỉ định của bạn. Một lần khám mất mấy chục tệ, là có bác sĩ帮你 giữ cửa ải này."]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Chi phí"]},{"tag":"p","props":{},"children":["Một lần khám, cộng đi lại hai chiều. Mấy chục tệ, nửa ngày…"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Lợi ích"]},{"tag":"p","props":{},"children":["《Biện pháp quản lý giám sát chất lượng kinh doanh và sử dụng thuốc》（药品经营和使用质量监督管理办法）yêu cầu doanh nghiệp bán l…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"Đánh dấu: Đã định dùng thuốc giảm cân thì đến bệnh viện lấy đơn thuốc, đừng mua ở cửa hàng trực tuyến mà không cần đơn"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"Hoàn tất"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"Kế hoạch thực hiện"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"Lưu"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Chia sẻ mẹo này"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Ẩn chi tiết"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Chi phí"]},{"tag":"p","props":{},"children":["Một lần khám, cộng đi lại hai chiều. Mấy chục tệ, nửa ngày."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Lợi ích"]},{"tag":"p","props":{},"children":["《Biện pháp quản lý giám sát chất lượng kinh doanh và sử dụng thuốc》（药品经营和使用质量监督管理办法）yêu cầu doanh nghiệp bán lẻ thuốc phải tuân thủ chế độ quản lý phân loại thuốc kê đơn và thuốc không kê đơn. Chế độ đó chia thuốc thành hai loại: một loại bắt buộc mua bằng đơn của bác sĩ, loại kia mua được tự mình. Nhà thuốc phải bán thuốc kê đơn theo đơn thuốc theo quy định, giữ đơn không dưới năm năm. Khi dược sĩ hoặc nhân viên kỹ thuật dược khác không có mặt thì phải treo bảng thông báo, chưa qua họ kiểm tra thì không được bán thuốc kê đơn. Thuốc kê đơn không được bày bán mở, tức là đặt trên kệ để khách tự lấy. Điều chín của《Biện pháp giám sát quản lý kinh doanh thuốc trên mạng》（药品网络销售监督管理办法）quy định bán thuốc kê đơn cho cá nhân qua mạng thì phải bảo đảm nguồn đơn thật, đáng tin cậy và thực hiện định danh thật. Điều mười yêu cầu hiển thị nổi bật thông tin cảnh báo rủi ro dưới mỗi trang hiển thị thuốc. Đơn chưa qua kiểm tra thì không được hiển thị hướng dẫn sử dụng, cũng không được cung cấp dịch vụ mua, tức là trang không nên có cả nút mua. Điều tám quy định thuốc Nhà nước quản lý đặc biệt không được kinh doanh qua mạng. Nhóm thuốc này bao gồm vaccine, chế phẩm máu, thuốc gây nghiện, thuốc tâm thần, thuốc độc dùng trong y tế, thuốc phóng xạ và hóa chất tiền chất thuộc nhóm thuốc"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Nguồn gốc"]},{"tag":"p","props":{"className":"life-citations"},"children":["国家市场监督管理总局 (2023). 药品经营和使用质量监督管理办法（总局令第 84 号）. ",{"tag":"a","props":{"href":"https://www.gov.cn/gongbao/2023/issue_10846/202311/content_6917322.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/gongbao/2023/issue_10846/202311/content_6917322.html"]},"；国家市场监督管理总局 (2022). 药品网络销售监督管理办法（总局令第 58 号，第八条至第十条）. ",{"tag":"a","props":{"href":"https://www.gov.cn/gongbao/content/2022/content_5717002.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/gongbao/content/2022/content_5717002.htm"]}]},{"tag":"a","props":{"href":"https://www.gov.cn/gongbao/2023/issue_10846/202311/content_6917322.html","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Liên kết mở nguồn"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Ghi chú sách"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["Pháp lệnh có thể đối chiếu từng chữ, nhưng「uống theo đơn thì so với tự mua tự uống sẽ bớt được bao nhiêu sự cố」chưa ai nghiên cứu định lượng, nên ghi mức B vì「khó định lượng」. Steroid và hormone giới tính nói ở mục 5 và 7 của phần này cũng đi theo cùng bộ quy tắc đó. Đến lúc thật sự phải nhờ thuốc để giảm cân, bác sĩ sẽ xem chỉ số khối cơ thể, người có bệnh gì khác không, có tình trạng nào không dùng được thuốc không, rồi mới quyết định uống hay không, uống loại nào. Cái phán đoán đó không mua được."]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Ghi chú của tôi"]},{"tag":"button","props":{"type":"button"},"children":["Viết một lời nhắc cho chính bạn…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/vi/tip/28-05"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Trước"]},"Đừng dùng steroid đồng hóa (「thuốc tiêm tăng cơ」「thuốc uống」) để tăng cơ"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/vi/tip/28-07"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Tiếp theo"]},"Chỉ dùng thuốc hormone giới tính khi bác sĩ kê đơn và có tái khám định kỳ; đừng mua trên mạng, đừng tự tăng liều"]},{"tag":"svg","props