-08"},"children":[{"tag":"span","props":{},"children":["08"]},"35 歳以降、過体重であれば空腹時血糖を一度検査し、正常であっても3年ごとに再検査する"]},{"tag":"a","props":{"href":"/ja/tip/01-09"},"children":[{"tag":"span","props":{},"children":["09"]},"スピード超過や飲酒運転をしない"]},{"tag":"a","props":{"href":"/ja/tip/01-10"},"children":[{"tag":"span","props":{},"children":["10"]},"車に乗るときは4歳以下の子どもをチャイルドシートに座らせ、抱っこしない"]},{"tag":"a","props":{"href":"/ja/tip/01-11"},"children":[{"tag":"span","props":{},"children":["11"]},"お子さんがいる家庭は窓やベランダにストッパーを。網戸は防護策になりません"]},{"tag":"a","props":{"href":"/ja/tip/01-12"},"children":[{"tag":"span","props":{},"children":["12"]},"子供を水辺から目を離さない。ボートや水泳の際はライフジャケットを着用"]},{"tag":"a","props":{"href":"/ja/tip/01-13"},"children":[{"tag":"span","props":{},"children":["13"]},"60歳以上はバランス運動と脚力トレーニングを。自宅の浴室や階段を改修する"]},{"tag":"a","props":{"href":"/ja/tip/01-14"},"children":[{"tag":"span","props":{},"children":["14"]},"B型肝炎ウイルス抗体検査を受け、抗体がなければワクチンを接種する"]},{"tag":"a","props":{"href":"/ja/tip/01-15"},"children":[{"tag":"span","props":{},"children":["15"]},"釘や木刺による怪我、または傷口に土が付着した場合は、当日中に処置を行い、あわせて破傷風ワクチンの必要性を医師に確認する"]},{"tag":"a","props":{"href":"/ja/tip/01-16"},"children":[{"tag":"span","props":{},"children":["16"]},"女性のHPVワクチン接種は、早ければ早いほど良い"]},{"tag":"a","props":{"href":"/ja/tip/01-17"},"children":[{"tag":"span","props":{},"children":["17"]},"女性は40歳から乳がん検診を、2年に1度のマンモグラフィを"]},{"tag":"a","props":{"href":"/ja/tip/01-18"},"children":[{"tag":"span","props":{},"children":["18"]},"30歳以上の女性は子宮頸がん検診において、HPV検査を優先"]},{"tag":"a","props":{"href":"/ja/tip/01-19"},"children":[{"tag":"span","props":{},"children":["19"]},"45歳から50歳から大腸がん検診を開始、便潜血検査（FIT）または大腸内視鏡検査を行う"]},{"tag":"a","props":{"href":"/ja/tip/01-20"},"children":[{"tag":"span","props":{},"children":["20"]},"心血管疾患患者および高齢者は毎年インフルエンザワクチンを接種"]},{"tag":"a","props":{"href":"/ja/tip/01-21"},"children":[{"tag":"span","props":{},"children":["21"]},"50 歳以降の帯状疱疹ワクチン接種"]},{"tag":"a","props":{"href":"/ja/tip/01-22"},"children":[{"tag":"span","props":{},"children":["22"]},"65 歳以上への肺炎球菌ワクチン接種"]},{"tag":"a","props":{"href":"/ja/tip/01-23"},"children":[{"tag":"span","props":{},"children":["23"]},"ピロリ菌を検査し、陽性なら除菌する"]},{"tag":"a","props":{"href":"/ja/tip/01-24"},"children":[{"tag":"span","props":{},"children":["24"]},"重度の喫煙者は年に一度、低線量胸部CT検査を"]},{"tag":"a","props":{"href":"/ja/tip/01-25"},"children":[{"tag":"span","props":{},"children":["25"]},"抑うつ状態や自殺念慮がある時は 12356 に電話を。自宅に睡眠薬や農薬を常備しないこと"]},{"tag":"a","props":{"href":"/ja/tip/01-26"},"children":[{"tag":"span","props":{},"children":["26"]},"消火器、消火毯、避難用マスク、救急セットを揃え、年に一度点検する"]},{"tag":"a","props":{"href":"/ja/tip/01-27"},"children":[{"tag":"span","props":{},"children":["27"]},"尿に肉眼で確認できる血が混じった場合、たとえ痛みを感じず、翌日には止まったとしても、必ず一度検査を受けるべきです"]},{"tag":"a","props":{"href":"/ja/tip/01-28"},"children":[{"tag":"span","props":{},"children":["28"]},"勃起機能に問題を感じたら、まずは心血管系をチェック。単なる「性的な問題」と片付けないで"]},{"tag":"a","props":{"href":"/ja/tip/01-29"},"children":[{"tag":"span","props":{},"children":["29"]},"減量、禁煙、血圧・血糖のコントロールにより、勃起機能の改善が期待できる"]},{"tag":"a","props":{"href":"/ja/tip/01-30"},"children":[{"tag":"span","props":{},"children":["30"]},"性行為の際は常にコンドームを使用し、注射器を他人と共有しない"]},{"tag":"a","props":{"href":"/ja/tip/01-31"},"children":[{"tag":"span","props":{},"children":["31"]},"ハイリスクな行為があったらHIV検査を。CDC（疾病予防管理センター）は無料、結果は秘密厳守"]},{"tag":"a","props":{"href":"/ja/tip/01-32"},"children":[{"tag":"span","props":{},"children":["32"]},"自殺の衝動が浮かんだら、まずは身近な誰かに伝える。この数十分間をやり過ごすために。"]},{"tag":"a","props":{"href":"/ja/tip/01-33"},"children":[{"tag":"span","props":{},"children":["33"]},"「助かった」を「完治」と誤解しないこと：農薬の飲用やガス吸引後の救急医療で守れるのは命だけで、肺や脳は守れない"]},{"tag":"a","props":{"href":"/ja/tip/01-34"},"children":[{"tag":"span","props":{},"children":["34"]},"「数日寝れば治る」と高所からの転落を賭けないこと：外傷ICUに入院した人の多くは生き残るが、その代償は年単位で計算される"]},{"tag":"a","props":{"href":"/ja/tip/01-35"},"children":[{"tag":"span","props":{},"children":["35"]},"「腎が一つ減っても大丈夫」を金に変えないで：残った一つが二つ分の働きをしなければならず、腎を売った人の 86% が、後に健康状態が悪化したと回答している"]},{"tag":"a","props":{"href":"/ja/tip/01-36"},"children":[{"tag":"span","props":{},"children":["36"]},"出所不明の金属部品は拾わない、分解しない、売らない。クローバーの警告マークがあるものは遠ざかること"]},{"tag":"a","props":{"href":"/ja/tip/01-37"},"children":[{"tag":"span","props":{},"children":["37"]},"ギャンブル依存で借金をしてまで続けてしまい、気分が落ち込み続けている時は、まず 12356 に電話し、銀行カードと決済パスワードを家族に管理してもらう"]},{"tag":"a","props":{"href":"/ja/tip/01-38"},"children":[{"tag":"span","props":{},"children":["38"]},"ハイリスクな性的行動のあるMSM（男性間性交渉者）へ：HIV予防薬（PrEP）の相談を。正しく服用すれば感染リスクを7割以上低減可能"]},{"tag":"a","props":{"href":"/ja/tip/01-39"},"children":[{"tag":"span","props":{},"children":["39"]},"65歳以上の女性は二重エネルギーX線吸収法による骨密度検査を。閉経後に骨粗鬆症のリスク因子がある場合は65歳を待つ必要はない"]},{"tag":"a","props":{"href":"/ja/tip/01-40"},"children":[{"tag":"span","props":{},"children":["40"]},"骨粗鬆症と診断された方、または軽い転倒で骨折した経験がある方は、医師に抗骨粗鬆症薬を処方してもらい、継続して服用してください。カルシウム補給だけで済ませてはいけません。"]},{"tag":"a","props":{"href":"/ja/tip/01-41"},"children":[{"tag":"span","props":{},"children":["41"]},"野外の氷の上へ行く前は穴を開けて厚さを確認。15cm未満は避けること。川の氷や氷の穴の周辺には近づかない"]},{"tag":"a","props":{"href":"/ja/tip/01-42"},"children":[{"tag":"span","props":{},"children":["42"]},"ディスクグラインダーは保護カバーを付け、保護眼鏡とフェイスシールドを着用し、両手で持つ。木工用のこ刃を付けて木を切らない"]},{"tag":"a","props":{"href":"/ja/tip/01-43"},"children":[{"tag":"span","props":{},"children":["43"]},"様子がおかしい身近な人に「自殺を考えたことはある？」と直接聞く。聞いたことで、その考えが強まるわけではない"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"現在地"},"children":[{"tag":"a","props":{"href":"/ja/book"},"children":["本を読む"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/ja/book/01"},"children":["第1章"," ·"," ","早死を避けるために"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"01-03"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["03"]},{"tag":"span","props":{"className":"life-evidence grade-b"},"children":["エビデンス"," ","B"]}]},{"tag":"h1","p