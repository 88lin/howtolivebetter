x":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-up-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M7 7h10v10"},"children":[]},{"tag":"path","props":{"d":"M7 17 17 7"},"children":[]}]}]}]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/ru/book/28"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"К содержанию"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["Не ломайте здоровье ради внешности"]},{"tag":"div","props":{"data-ad-dock-host":"true"},"children":[]},{"tag":"nav","props":{"aria-label":"Советы главы"},"children":[{"tag":"a","props":{"href":"/ru/tip/28-01"},"children":[{"tag":"span","props":{},"children":["01"]},"Не стоит прибегать к экстремальным диетам, голоданию или вызыванию рвоты для контроля веса — если хотите похудеть, делайте это с помощью физических упражнений"]},{"tag":"a","props":{"href":"/ru/tip/28-02"},"children":[{"tag":"span","props":{},"children":["02"]},"Прежде чем колоть, вживлять нити или ложиться под нож, проверьте две вещи: есть ли в лицензии учреждения пункт «косметологическая медицина» и является ли оперирующий лечащим врачом-специалистом (主诊医师资格)"]},{"tag":"a","props":{"href":"/ru/tip/28-03"},"children":[{"tag":"span","props":{},"children":["03"]},"При наполнении лица избегайте переносицы, межбровья и лба; тем более не ищите неофициальные инъекции ради экономии"]},{"tag":"a","props":{"href":"/ru/tip/28-04"},"children":[{"tag":"span","props":{},"children":["04"]},"Таблетки для похудения, «жиросжигающий» кофе, конфеты для стройности и «энзимные» сливы (сливы, якобы вымоченные в энзимах) с обещанием «быстро похудеть» — не покупать"]},{"tag":"a","props":{"href":"/ru/tip/28-05"},"children":[{"tag":"span","props":{},"children":["05"]},"Анаболические стероиды («уколы для массы», «таблетки») — не средство нарастить мышцы"]},{"tag":"a","props":{"href":"/ru/tip/28-06"},"children":[{"tag":"span","props":{},"children":["06"]},"Если хотите препарат для похудения — идите в больницу за рецептом, а не покупайте в интернет-магазине, который отправляет без рецепта"]},{"tag":"a","props":{"href":"/ru/tip/28-07"},"children":[{"tag":"span","props":{},"children":["07"]},"Половые гормоны применяйте только по назначению врача и с регулярными повторными обследованиями; не покупайте через интернет и не увеличивайте дозу сами"]},{"tag":"a","props":{"href":"/ru/tip/28-08"},"children":[{"tag":"span","props":{},"children":["08"]},"Если «кажется, что я уродлив» уже дошло до постоянных разглядываний в зеркале и навязчивых мыслей об исправлении, сначала пройдите оценку образа тела и только потом говорите об операции"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/ru/tip/28-09","data-status":"active"},"children":[{"tag":"span","props":{},"children":["09"]},"Для исправления прикуса обратитесь очно к врачу с ортодонтической квалификацией и регулярно приходите на контроль; не покупайте элайнеры онлайн для самостоятельного ношения дома"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"Навигация"},"children":[{"tag":"a","props":{"href":"/ru/book"},"children":["Книга"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/ru/book/28"},"children":["Глава 28"," ·"," ","Не ломайте здоровье ради внешности"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"28-09"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["09"]},{"tag":"span","props":{"className":"life-evidence grade-c"},"children":["Доказательства"," ","C"]}]},{"tag":"h1","props":{"lang":"ru"},"children":["Для исправления прикуса обратитесь очно к врачу с ортодонтической квалификацией и регулярно приходите на контроль; не покупайте элайнеры онлайн для самостоятельного ношения дома"]},{"tag":"p","props":{"lang":"ru","className":"life-entry-summary"},"children":["Прозрачные элайнеры в Китае относятся к медицинским изделиям II класса; инструкция требует наблюдения квалифицированного ортодонта и регулярных повторных приемов. Американский регулятор сообщает, что не разрешал элайнеры, продаваемые напрямую человеку без назначения стоматолога. Без очного осмотра возможны неравномерный прикус, неправильное смещение зубов, боль и даже потеря зубов."]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Затраты"]},{"tag":"p","props":{},"children":["По сравнению с онлайн-покупкой добавляются расходы на перв…"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Польза"]},{"tag":"p","props":{},"children":["Руководство по регистрационной экспертизе безбрекетных ортодонтических аппаратов, выпущенное в 2022 году Центр…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"Отметить: Для исправления прикуса обратитесь очно к врачу с ортодонтической квалификацией и регулярно приходите на контроль; не покупайте элайнеры онлайн для самостоятельного ношения дома"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"Сделано"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"В планах"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"В избранное"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Поделиться советом"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Скрыть подробности"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Затраты"]},{"tag":"p","props":{},"children":["По сравнению с онлайн-покупкой добавляются расходы на первичный и повторные приемы; периодически нужно приезжать в клинику. Трудность — соблюдать график весь курс, часто один-два года."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Польза"]},{"tag":"p","props":{},"children":["Руководство по регистрационной экспертизе безбрекетных ортодонтических аппаратов, выпущенное в 2022 году Центром оценки медицинских изделий Государственного управления по контролю лекарств Китая, относит их ко II классу. Оно требует указывать в инструкции необходимость ношения в процессе лечения под руководством врача с профессиональной ортодонтической квалификацией, а также требования к приему пищи, чистке зубов и регулярным контрольным визитам. В названии изделия не рекомендуется использовать неопределенные или условные понятия вроде «невидимый». Управление по контролю пищевых продуктов и лекарств США (FDA) сообщает, что не разрешало прозрачные элайнеры, продаваемые напрямую потребителю без назначения и наблюдения стоматолога или ортодонта. FDA также говорит, что очный осмотр помогает снизить риски неравномерного прикуса, непреднамеренного смещения зубов, боли и потери зубов. После начала ношения регулярные очные визиты нужны, чтобы подтверждать безопасное перемещение зубов по плану. Оба источника — регуляторные документы, не приводящие частоту осложнений."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Первоисточники"]},{"tag":"p","props":{"className":"life-citations"},"children":["国家药品监督管理局医疗器械技术审评中心 (2022). 无托槽矫治器注册审查指导原则（2022 年第 41 号）. ",{"tag":"a","props":{"href":"https://www.cmde.org.cn/flfg/zdyz/zdyzwbk/20230103095116100.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.cmde.org.cn/flfg/zdyz/zdyzwbk/20230103095116100.html"]},"；国家卫生健康委办公厅等 (2023). 关于进一步推进口腔医疗服务和保障管理工作的通知（国卫办医政发〔2023〕11 号，第五条）. ",{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/202309/content_6903786.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/zhengce/zhengceku/202309/content_6903786.htm"]},"；U.S. Food and Drug Administration (2026). Clear Dental Aligners（页面 2026 年 9 月 9 日更新）. ",{"tag":"a","props":{"href":"https://www.fda.gov/medical-devices/dental-devices/clear-dental-aligners","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.fda.gov/medical-devices/dental-devices/clear-dental-aligners"]}]},{"tag":"a","props":{"href":"https://www.cmde.org.cn/flfg/zdyz/zdyzwbk/20230103095116100.html","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Открыть источник"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Примечание автора"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["Масштаб пользы оценен как малый: частоту осложнений найти не удалось, оценка основана только на последствиях. Китайских предупреждений лекарственных и медицинских ведомств именно о самостоятельном ношении купленных онлайн элайнеров не найдено, поэтому пункт опирается прежде всего на регистрационные требования и сведения FDA. Ортодонтия — медицинская деятельность. Для коррекции зубов в целях медицинской косметологии лицензия учреждения должна включать соответствующий профиль, а врач должен иметь квалификацию; способ проверки см. в пункте 2 этого раздела (лицензия учреждения и ведущий врач). Совместное уведомление четырех ведомств о стоматологической помощи 2023 года также требует строго наказывать нелицензированные учреждения и привлечение немедицинских работников к лечению зубов. Ортодонтия не возмещается медицинским страхованием; см. раздел 24, пункт 12 (до имплантации выясните состав пакетной цены)."]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Моя заметка"]},{"tag":"button","props":{"type":"button"},"children":["Запишите напоминание…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/ru/tip/28-08"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Предыдущий"]},"Если «кажется, что я уродлив» уже дошло до постоянных разглядываний в зеркале и навязчивых мыслей об исправлении, сначала пройдите оценку образа тела и только потом говорите об операции"]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["Другие советы по этой теме"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/28-02"},"children":[{"tag":"strong","props":{},"children":["Прежде чем колоть, вживлять нити или ложиться под нож, проверьте две вещи: есть ли в лицензии учреждения пункт «косметологическая медицина» и является ли оперирующий лечащим врачом-специалистом (主诊医师资格)"]},{"tag":"span","props":{},"children":["Всё, что связано с операцией, уколом, применением медицинских изделий…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/28-03"},"children":[{"tag":"strong","props":{},"children":["При наполнении лица избегайте переносицы, межбровья и лба; тем более не ищите неофициальные инъекции ради экономии"]},{"tag":"span","props":{},"children":["Филлер попадает в сосуд лица, ток крови несёт его обратно, он закупор…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/28-04"},"children":[{"tag":"strong","props":{},"children":["Таблетки для похудения, «жиросжигающий» кофе, конфеты для стройности и «энзимные» сливы (сливы, якобы вымоченные в энзимах) с обещанием «быстро похудеть» — не покупать"]},{"tag":"span","props":{},"children":["Самый часто обнаруживаемый незаконно добавляемый компонент в таких пр…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/28-05"},"children":[{"tag":"strong","props":{},"children":["Анаболические стероиды («уколы для массы», «таблетки») — не средство нарастить мышцы"]},{"tag":"span","props":{},"children":["В Дании отследили 545 человек, у которых тест на допинг в фитнес-клуб…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/28-06"},"children":[{"tag":"strong","props":{},"children":["Если хотите препарат для похудения — идите в больницу за рецептом, а не покупайте в интернет-магазине, который отправляет без рецепта"]},{"tag":"span","props":{},"children":["Рецептурные препараты по правилам отпускаются только по рецепту, прич…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/28-07"},"children":[{"tag":"strong","props":{},"children":["Половые гормоны применяйте только по назначению врача и с регулярными повторными обследованиями; не покупайте через интернет и не увеличивайте дозу сами"]},{"tag":"span","props":{},"children":["Этот пункт не обсуждает, стоит ли применять, — он о том, как применят…"]}]}]}]},{"tag":"a","props":{"className":"life-text-link","href":"/ru/book/28"},"children":["Читать всю тему: Не ломайте здоровье ради внешности"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"15","height":"15","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]}]}]}]},{"tag":"as