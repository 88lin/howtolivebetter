ps":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["治安管理处罚法的这一条，是 2025 年修订时才加进去的。在那之前，这种事只能走刑法，或者由检察院提民事公益诉讼。几百人的微信群，在法院眼里就算公开场合。"]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["我的备注"]},{"tag":"button","props":{"type":"button"},"children":["写下对自己有用的提醒…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/tip/09-01"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["上一条"]},"群里不转发不知真假的灾情、疫情、警情消息，不 P 图、不用 AI 造现场图"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/tip/09-03"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["下一条"]},"境外网站上的东西看完就关，不截图、不转发、不搬进群里，也不在评论区跟着说"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["本主题的其他建议"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/09-04"},"children":[{"tag":"strong","props":{},"children":["黄色视频自己看归自己，别往群里发、别卖「资源」、别建群"]},{"tag":"span","props":{},"children":["自己看不在处罚条款里。往群里发一次就算向全群传播，拘留 10 到 15 日，再罚 5000 元以下，情节严重的判 2 年以下。卖「资源」挣…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/09-05"},"children":[{"tag":"strong","props":{},"children":["「兼职」要你用自己的卡收钱、取现、转账，不管给多少好处费都不做"]},{"tag":"span","props":{},"children":["这类兼职挣的是几百块，代价是留一份案底。有人带着身份证和 1 张银行卡去指定地点，配合转账取款，挣了 500 多元。检察院没起诉他，公安还…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/09-06"},"children":[{"tag":"strong","props":{},"children":["有人拉你去「包装材料」贷款、按贷款额分你好处费，一个都不做"]},{"tag":"span","props":{},"children":["帮人「包装材料」去贷款、拿分成，按诈骗办。有个 126 人的团伙，把没工作的人包装成「优质客户」，在 80 多家银行骗贷 3000 多万元…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/09-07"},"children":[{"tag":"strong","props":{},"children":["捡到银行卡不取钱，捡到手机、钱包联系失主或交给警察，不揣走"]},{"tag":"span","props":{},"children":["捡到东西留着自己用，金额到了「数额较大」又不肯交出来，判 2 年以下，数额巨大的判 2 到 5 年。拿捡来的银行卡去 ATM 取钱更重，算…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/09-08"},"children":[{"tag":"strong","props":{},"children":["优惠用自己的真实身份领，不买虚拟号批量注册小号，不靠漏洞重复领"]},{"tag":"span","props":{},"children":["用自己的真实身份、一个号领一次券，不在处罚范围里。批量注册假用户、自己下单自己接单去多领，按诈骗办，骗到 3000 元就能判 3 年以下，…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/09-09"},"children":[{"tag":"strong","props":{},"children":["阳台、窗户不往外扔任何东西，烟头、垃圾袋、酒瓶都算"]},{"tag":"span","props":{},"children":["往楼下扔东西，没砸到人也能拘留 5 日、罚 1000 元，情节严重的拘留 10 到 15 日。砸到人就换罪名了：有人在 21 楼酒后把空酒…"]}]}]}]},{"tag":"a","props":{"className":"life-text-link","href":"/book/09"},"children":["阅读整个主题：普通人容易踩的法律红线"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"15","height":"15","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"pa