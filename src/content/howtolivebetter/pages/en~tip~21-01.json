inejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Share this tip"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Hide details"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Cost"]},{"tag":"p","props":{},"children":["It’s free. Simply browse the Chinese Consular Service website — it takes just a few minutes."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Benefit"]},{"tag":"p","props":{},"children":["The Ministry publishes safety advisories ranked from low to high risk: “Exercise Caution,” “Increase Safety Precautions,” “Travel with Care,” and “Do Not Travel.” The new regulation effective September 15, 2026, also spells out citizens’ obligations: “Chinese nationals should pay attention to overseas safety advisories and destination‑specific risk warnings, and avoid traveling to or staying in high‑risk countries or regions.” It further mandates that immigration authorities — responsible for issuing travel documents and border checks — warn and, if necessary, dissuade anyone planning to visit such areas. The original wording reads: “For Chinese citizens intending to travel to countries or regions with the highest risk level or where incidents threatening personal safety occur frequently, authorities must, when appropriate, dissuade them from going.”"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Original sources"]},{"tag":"p","props":{"className":"life-citations"},"children":["国务院 (2026). 关于出境入境管理的规定（国令第 841 号）. ",{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/202607/content_7077173.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/zhengce/zhengceku/202607/content_7077173.htm"]},"（第二条）；国务院 (2023). 领事保护与协助条例（国令第 763 号）. ",{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/202307/content_6891761.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/zhengce/zhengceku/202307/content_6891761.htm"]},"（第十九、二十一条）；外交部领事司. 安全提醒. ",{"tag":"a","props":{"href":"https://cs.mfa.gov.cn/zggmzhw/lsbh/aqtx/","target":"_blank","rel":"noopener noreferrer"},"children":["https://cs.mfa.gov.cn/zggmzhw/lsbh/aqtx/"]}]},{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/202607/content_7077173.htm","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Open source link"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Book note"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["Advisories are updated as situations evolve; this guide does not list them, so be sure to check the page yourself before you travel. As of September 7, 2026, the “Do Not Travel” warnings covered Eswatini (August 25, 2026), Palestine (October 10, 2023), Sudan (April 17, 2023), Afghanistan (February 17, 2023), Syria (January 4, 2023), Peru (December 29, 2022), Somalia (November 24, 2022), as well as specific warnings for northern Myanmar and certain provinces of the Democratic Republic of the Congo. Travel agencies also have a duty to inform clients; before joining a tour, you can request a written summary of destination risks."]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["My note"]},{"tag":"button","props":{"type":"button"},"children":["Write a reminder for yourself…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"span","props":{},"children":[]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/en/tip/21-02"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Next"]},"Save the 12308 hotline number and your local embassy/consulate’s consular protection number in your phone, then write them down and keep a copy in your wallet — don’t wait until an emergency to look them up"]},{"tag":"svg","p