children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"このヒントを共有"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"詳細を閉じる"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["費用・手間"]},{"tag":"p","props":{},"children":["費用はかかりません。紛争が生じた場合は、居委会、村委会、民政部門、または裁判所にて解決を図る必要があります。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["効果"]},{"tag":"p","props":{},"children":["《民法典》第28条：民事行為能力を有しない、または民事行為能力が制限されている成人は、次に掲げる監護能力を有する者が、その順序に従って監護人となる。「（一）配偶；（二）父母、子；（三）その他の近親者；（四）その他、監護人となることを希望する個人または組織。ただし、被監護者の住所地の住民委員会、村委員会、または民政部門の同意を得なければならない。」第31条：監護人の決定について争いがある場合は、被監護者の住所地の住民委員会、村委員会、または民政部門が指定するものとし、その指定に不服がある場合は、人民法院に対して指定を申請すること、または直接人民法院に対して申請することができる。指定にあたっては、「被監護者の真の意思を尊重し、被監護者に最も利益となる原則に従わなければならない」。指定前、権利が保護されていない状態にある場合は、住民委員会、村委員会、法律で定められた関連組織、または民政部門が臨時後見人を務めるものとする。第三十三条：「完全な民事行為能力を有する成人は、その近親者、その他後見人を務める意思のある個人または組織と事前に協議し、書面によって自身の後見人を確定することができる」。第千百八十八条：「無民事行為能力人または制限民事行為能力人が他人に損害を与えた場合、後見人がその不法行為責任を負うものとする。後見人が後見の義務を果たしている場合は、その不法行為責任を軽減することができる。」財産がある場合は、本人の財産から賠償費用を支払うものとし、不足分については後見人が賠償するものとする。第1189条：保護者がその保護義務を他人に委託した場合であっても、保護者は引き続き不法行為責任を負うものとし、受任者に過失がある場合は、受任者が相応の責任を負うものとする（全国、2021 年 1 月 1 日より施行）"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["出典"]},{"tag":"p","props":{"className":"life-citations"},"children":["中华人民共和国民法典（第二十八条、第三十一条、第三十三条、第一千一百八十八条、第一千一百八十九条）. ",{"tag":"a","props":{"href":"https://flk.npc.gov.cn/detail?id=ff808081729d1efe01729d50b5c500bf","target":"_blank","rel":"noopener noreferrer"},"children":["https://flk.npc.gov.cn/detail?id=ff808081729d1efe01729d50b5c500bf"]}]},{"tag":"a","props":{"href":"https://flk.npc.gov.cn/detail?id=ff808081729d1efe01729d50b5c500bf","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["出典を開く"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["著者の注記"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["第三十三条の内容は「意定後見（任意後見）」にあたります。本人が意識がはっきりしているうちに書面で後見人を指定しておけば、後の紛争の大部分を回避できます。具体的な書き方は第 17 節第 1 条（意定後見）を参照してください。賠償に関する部分は注意が必要です。養育機関や親族に世話を委ねたとしても、責任は依然として後見人にあります。受託者は、自身に過失がある場合にのみ相応の責任を負います。したがって、被後見人のために後見人責任保険に加入しておくことは有意義です。《精神衛生法》第七十八条では、後見人が患者を遺棄したり、後見義務を履行せず損害を与えたりした場合、法律に基づき賠償責任を負うと規定されています。"]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["自分のメモ"]},{"tag":"button","props":{"type":"button"},"children":["自分へのメモを書く…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/ja/tip/33-18"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["前へ"]},"成人が「自身の事柄を管理できない」と判断するには、裁判所に申し立てて認定を受ける必要があり、家族の判断だけでは不十分である"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/ja/tip/33-20"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["次へ"]},"障害を理由とした採用拒否、正社員登用拒否、給与の過少支払いは訴えることが可能ですが、まずはプロセスに伴うコストを計算してください"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["このテーマの他の提案"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/33-12"},"children":[{"tag":"strong","props":{},"children":["盲導犬は公共施設や公共交通機関への同伴が可能で、視覚障害者は市内のバスに無料で乗車できます"]},{"tag":"span","props":{},"children":["法律には、公共施設や公共交通機関は、盲導犬、聴導犬、介助犬を伴う障害者に利便性を提供しなければならないと明記されています。視覚障害者は有効…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/33-13"},"children":[{"tag":"strong","props":{},"children":["障害のある受験生は大学入試（高考）において合理的配慮を申請でき、点字答案を使用する場合、試験時間は1.5倍に延長される"]},{"tag":"span","props":{},"children":["障害のある受験生は、大学入試（高考）において、点字答案、拡大文字答案、外国語リスニング免除、別室受験、補聴器や車椅子の持ち込み、および試験…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/33-14"},"children":[{"tag":"strong","props":{},"children":["障害のある子供の入学申請に対し、学校は拒否してはならない。登校が困難な場合は、教育局が訪問指導の手配を行う"]},{"tag":"span","props":{},"children":["幼稚園および各種学校は、条件を満たす障害のある子供の入学申請を拒否してはならず、普通科・職業学校も同様です。介助が必要で登校が困難な子供に…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/33-15"},"children":[{"tag":"strong","props":{},"children":["右下肢または両下肢を欠損していても運転免許の取得は可能。準拠車種は C5 と呼ばれる"]},{"tag":"span","props":{},"children":["右下肢または両下肢を欠損している、あるいは動かせない場合でも、自力で安定して座ることができ、上肢の条件を満たしている人は、障害者専用のオー…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/33-16"},"children":[{"tag":"strong","props":{},"children":["リハビリはリハビリテーション科のある正規の機関で行うこと。強度は療法士の指示に従う。激しければ良いというものではない"]},{"tag":"span","props":{},"children":["自宅に連れて帰り、自然回復を待つのが最もよくある間違いです。脳卒中後、多職種チームによる組織的なケアを受けた場合、1年後も生存し、自宅での…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/33-17"},"children":[{"tag":"strong","props":{},"children":["難聴を感じたら補聴器を検討すること。補聴器を使用する理由は「聞こえるようにするため」であり、「認知症予防のため」ではない"]},{"tag":"span","props":{},"children":["「補聴器の使用が認知症を予防できる」という説は、現時点では確立されていません。約1,000人を対象とした3年間の試験では、全体として差は見…"]}]}]}]},{"tag":"a","props":{"className":"life-text-link","href":"/ja/book/33"},"children":["テーマ全体を読む：障害を負った後の生き方"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"15","height":"15","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"childre