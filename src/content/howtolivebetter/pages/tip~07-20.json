r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"分享这条建议"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"收起详情"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["成本"]},{"tag":"p","props":{"className":"life-citations"},"children":["年轻人买一年期的费用补偿型医疗险，每年几百元。费用补偿型就是按你实际花掉的钱报销那种。重疾险每年几千元起（作者粗估，无官方数字）。投保前要如实告知自己的健康状况，一次性花半小时。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["收益"]},{"tag":"p","props":{"className":"life-citations"},"children":["官方把这类产品分成两种。医疗保险按你实际花掉的医疗费报销。疾病保险是一确诊合同里约定的那些病，就按约定的数额直接赔一笔钱。两者补的都是医保报完之后自己要掏的那部分，以及停工的损失。保险期间在一年及以下、条款里又没写保证续保的，属于短期健康险。超过一年的，或者写了保证续保的，才是长期健康险。「保证续保」的意思是：到期续保时，公司必须按原来的条款和约定的费率接着保。保险公司不得诱导同一个人重复买保障功能相同或者类似的费用补偿型医疗险。买两份，同一笔钱也只能报一次。重疾险的疾病定义有行业统一规范，包括 28 种重度疾病和 3 种轻度疾病。恶性肿瘤、急性心肌梗死、脑中风后遗症是核心病种（全国，2019、2020 年起）"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["来源"]},{"tag":"p","props":{"className":"life-citations"},"children":["银保监会 (2019). 健康保险管理办法（银保监会令 2019 年第 3 号，第二、四、四十一条）. ",{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/2019-12/04/content_5458542.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/zhengce/zhengceku/2019-12/04/content_5458542.htm"]},"；中国保险行业协会、中国医师协会 (2020). 重大疾病保险的疾病定义使用规范（2020 年修订版）答记者问. ",{"tag":"a","props":{"href":"https://www.iachina.cn/art/2020/11/5/art_8616_104705.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.iachina.cn/art/2020/11/5/art_8616_104705.html"]},"；银保监会 (2020). 关于使用《中国人身保险业重大疾病经验发生率表（2020）》有关事项的通知（银保监发〔2020〕51 号）. ",{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/2020-11/06/content_5557791.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/zhengce/zhengceku/2020-11/06/content_5557791.htm"]},"；全国人大常委会 (2015 修正). 中华人民共和国保险法第十六条（如实告知与合同成立二年后不得解除）. ",{"tag":"a","props":{"href":"https://flk.npc.gov.cn/detail?id=2c909fdd678bf17901678bf7c4060811","target":"_blank","rel":"noopener noreferrer"},"children":["https://flk.npc.gov.cn/detail?id=2c909fdd678bf17901678bf7c4060811"]},""]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["原书备注"]},{"tag":"p","props":{"className":"life-citations"},"children":["定 B 级，是因为官方只给了定义和规则，没有「买了能省多少」的数字。「百万医疗险」是卖的时候的叫法，法规上它算短期健康险。条款里不写「保证续保」的，明年可能停售或者涨价，买之前先在条款里找这四个字。两份按实际花费报销的医疗险，同一笔钱不能报两次，别叠着买。已经有病还投保、又不如实告知的，出事会被拒赔。如实告知有个两年的期限：合同成立满两年，保险公司就不能再以你没如实告知为由解除合同，出了事要赔。两年内被查出故意没告知的，合同解除前出的事不赔，保费也不退。哪些损失值得用保险兜，见第 5 节第 39 条（扛不住的损失）。先把居民医保（第 9 条）交上，再考虑这条。疾病定义规范是行业协会发布、银保监会指导的，不是政府文件。"]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["我的备注"]},{"tag":"button","props":{"type":"button"},"children":["写下对自己有用的提醒…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/tip/07-19"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["上一条"]},"坐过牢、破过产、上过失信名单，法律上都有重来的路，先把手续走完"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/tip/07-21"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["下一条"]},"实在没地方睡，24 小时营业场所只能应急一晚，优先去救助站"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["本主题的其他建议"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/07-14"},"children":[{"tag":"strong","props":{},"children":["求职别只投简历，用系统方法：学技巧、定目标、找人帮"]},{"tag":"span","props":{},"children":["参加过求职辅导的人，找到工作的几率是没参加的人的 2.67 倍。管用的是这几样：学具体的求职技巧，把自己讲清楚，定明确目标，主动出击，开口找人帮忙。"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/07-15"},"children":[{"tag":"strong","props":{},"children":["不交押金、不押证件、不签「培训贷」、不进传销、不借高利贷"]},{"tag":"span","props":{},"children":["用人单位不能扣你的身份证，不能收押金，也不能换个名目收钱。中介没给你介绍成工作，必须退中介费。先交培训费再上岗的培训贷、靠拉人头算钱的传销，都是官方点名的骗局。…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/07-16"},"children":[{"tag":"strong","props":{},"children":["住房困难先排公租房"]},{"tag":"span","props":{},"children":["要同时占上三条：在本地没房，或者住房面积低于标准；收入和财产低于标准；外来务工的还要在本地稳定就业满规定年限。轮候期由当地公布。这是远水，解不了近渴，但排队不花…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/07-17"},"children":[{"tag":"strong","props":{},"children":["把住和吃压到最低：合租月租代替日租，自炊和助餐食堂代替外卖"]},{"tag":"span","props":{},"children":["2025 年全国人均消费里，吃占 29.3%，住占 21.7%，两项加起来过半，所以压这两项最有效。按作者的经验，日租房、钟点房折算到一个月，比合租贵；自己做饭…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/07-18"},"children":[{"tag":"strong","props":{},"children":["社保断缴不要慌：养老按累计算，医保按规则补"]},{"tag":"span","props":{},"children":["养老金按累计年限算，不按连续年限算，断了不清零，到退休年龄累计满 15 年就能按月领。职工医保交够年限的，退休后不用再交，各地的年限不一样。断缴影响的是两样：居…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/07-22"},"children":[{"tag":"strong","props":{},"children":["被欠了工钱，先分清雇你的是谁：没执照的作坊和包工头照样找劳动监察，给家庭或个人干私活才去法院"]},{"tag":"span","props":{},"children":["没办执照的作坊、店铺，欠了工资照样能投诉劳动监察、申请劳动仲裁，老板本人也能被追。包工头转包工地上的活欠了钱，由总包或建设单位来付。只有给家庭或个人干私活，比如…"]}]}]}]},{"tag":"a","props":{"className":"life-text-link","href":"/book/07"},"children":["阅读整个主题：没钱的时候怎么活 ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"15","height":"15","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]}]}]},{"tag":"nav","props":{"className":"life-tabbar","aria-label":"主导航"},"children":[{"tag":"a","props":{"className":"","href":"/book"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"21","height":"21","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"roun