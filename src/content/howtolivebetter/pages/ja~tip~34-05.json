2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"お気に入り"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"このヒントを共有"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"詳細を閉じる"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["費用・手間"]},{"tag":"p","props":{},"children":["費用はかかりません。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["効果"]},{"tag":"p","props":{},"children":["米国食品医薬品局（FDA）は、2020年10月に安全警告を発表しました。妊娠約20週以降の非ステロイド性抗炎症薬（NSAIDs）の使用は、胎児の腎臓に問題を引き起こし、羊水過少症を招く可能性があります。この警告は、アスピリン、イブプロフェン、ナプロキセン、ジクロフェナク、セレコキシブを含む、処方薬および市販薬の両方を対象としています。FDAは2017年7月までの有害事象報告を調査し、35例の羊水過少症または新生児の腎機能不全を確認しましたが、これらはすべて深刻な結果を伴うものでした。そのうち5例は新生児死亡であり、すべて新生児の腎不全を伴っていました。文献によれば、羊水過少の多くは、投薬中止後72時間から6日以内に回復しています。FDAは、医師から明確な指示がない限り、妊婦が20週以降にこれらの薬剤を使用しないことを推奨しています。81 mgの低用量アスピリンを、妊娠中の特定の症状の治療のために医師から処方されている場合は、この制限の対象外です。痛みや熱を抑える必要がある場合、FDAはアセトアミノフェンなどの他の薬を使用できると言及していますが、事前に薬剤師または医師に相談してください。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["出典"]},{"tag":"p","props":{"className":"life-citations"},"children":["U.S. Food and Drug Administration (2020-10-15). FDA recommends avoiding use of NSAIDs in pregnancy at 20 weeks or later because they can result in low amniotic fluid. Drug Safety Communication. ",{"tag":"a","props":{"href":"https://www.fda.gov/drugs/drug-safety-and-availability/fda-recommends-avoiding-use-nsaids-pregnancy-20-weeks-or-later-because-they-can-result-low-amniotic","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.fda.gov/drugs/drug-safety-and-availability/fda-recommends-avoiding-use-nsaids-pregnancy-20-weeks-or-later-because-they-can-result-low-amniotic"]}]},{"tag":"a","props":{"href":"https://www.fda.gov/drugs/drug-safety-and-availability/fda-recommends-avoiding-use-nsaids-pregnancy-20-weeks-or-later-because-they-can-result-low-amniotic","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["出典を開く"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["著者の注記"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["FDAは、多くの風邪、インフルエンエザ、不眠症の治療に使われる市販薬にもこれらの成分が含まれているため、成分表を確認するよう注意喚起しています。米国の市販薬ラベルは、以前は妊娠後期の 3 ヶ月間のみを警告対象としていましたが、今回はその境界を 20 週頃まで前倒ししました。妊娠高血圧腎症（子癇前症）予防のための低用量アスピリンについては、第 27 節第 5 条（低用量アスピリン）を参照してください。評価をBとした理由は、数値が有害事象報告に基づいたものであり、服用しても問題が起きなかった人の数は不明であるためです。ベネフィットを「中」とした判断基準：結果は深刻ですが、発生頻度は低いためです。"]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["自分のメモ"]},{"tag":"button","props":{"type":"button"},"children":["自分へのメモを書く…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/ja/tip/34-04"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["前へ"]},"2 歳以下の子供が風邪を引いたとき、市販の総合感冒薬や咳止め薬を自己判断で飲ませないでください"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/ja/tip/34-06"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["次へ"]},"逆流性食道炎や胸焼けのためにオメプラゾールを自己購入する場合、最大で 7 日間まで。嚥下困難、吐血、黒色便がある場合は、すぐに病院へ"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["このテーマの他の提案"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/34-01"},"children":[{"tag":"strong","props":{},"children":["2種類の風邪薬や鎮痛薬を併用する前に、必ず成分表を確認してください。アセトアミノフェンは1種類だけに留める必要があります"]},{"tag":"span","props":{},"children":["多くの風邪薬にはアセトアミノフェンが含まれており、2箱同時に服用すると2倍量を摂取することになり、過剰摂取は肝機能を損なう恐れがあります。…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/34-02"},"children":[{"tag":"strong","props":{},"children":["子供の発熱にアスピリン、ニメスリド、アンチピリンは使用しないでください。アンチピリンを含む風邪薬も未成年者には与えないでください"]},{"tag":"span","props":{},"children":["子供の解熱には、これら3種類の薬は使用しないでください。アスピリンはライ症候群に関連しており、この病気は脳や肝臓に損傷を与えます。米国の統…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/34-03"},"children":[{"tag":"strong","props":{},"children":["60歳以上、胃出血の既往歴がある方、抗凝固薬またはステロイドを服用中の方は、イブプロフェンのような鎮痛剤を服用する前に医師に相談してください"]},{"tag":"span","props":{},"children":["イブプロフェン、ナプロキセン、アスピリンなどの鎮痛剤は胃を傷める可能性があります。高用量の試験では、イブプロフェンを服用した人の胃出血や穿…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/34-07"},"children":[{"tag":"strong","props":{},"children":["風邪のときに抗生物質を医師に求めないでください"]},{"tag":"span","props":{},"children":["風邪に対して抗生物質を服用しても、服用しない場合より早く治るわけではありません。成人が服用した場合、副作用のリスクは服用しない場合の2倍以…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/34-08"},"children":[{"tag":"strong","props":{},"children":["下痢の際はまず経口補水液で水分補給を。5 歳未満の子供には止瀉薬を与えないでください"]},{"tag":"span","props":{},"children":["下痢において最も重要なのは水分補給であり、下痢を止めることではありません。説明書に従って経口補水液を水で割り、果汁飲料や清涼飲料では代用し…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/34-09"},"children":[{"tag":"strong","props":{},"children":["鎮痛薬は月に 15 日を超えて服用しないでください。配合鎮痛薬は 10 日を超えないように。さもないと、頭痛そのものが薬によって引き起こされる可能性があります"]},{"tag":"span","props":{},"children":["頭痛が頻発し、毎日鎮痛薬を服用していると、かえって痛みが増すことがあります。国際頭痛分類では、これを「薬剤の使用過多による頭痛」と呼んでい…"]}]}]}]},{"tag":"a","props":{"className":"life-text-link","href":"/ja/book/34"},"children":["テーマ全体を読む：家庭常備薬の誤用による事故を防ぐ"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"15","height":"15","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]}]}]},{"tag":"nav","props":{"className":"life-tabbar","aria-label":"メインナビゲーション"},"children":[{"tag":"a","props":{"className":"","href":"/ja/book"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"21","height":"21","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-book-open","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M12 7v14"},"children":[]},{"tag":"path","props":{"d":"M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z"},"children":[]}]},{"tag":"span","props":{},"children":["本"]}]},{"tag":"a","props":{"className":"","href":"/ja/top-50"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"21","height":"21","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-star","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a