,{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},{"tag":"span","props":{},"children":["ログイン"]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/ja/book/31"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"目次に戻る"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["18歳以降、どのような道があるか"]},{"tag":"nav","props":{"aria-label":"この章のヒント"},"children":[{"tag":"a","props":{"href":"/ja/tip/31-01"},"children":[{"tag":"span","props":{},"children":["01"]},"まずは基準を確認：12のルートの年齢と学歴要件は明文化されています"]},{"tag":"a","props":{"href":"/ja/tip/31-02"},"children":[{"tag":"span","props":{},"children":["02"]},"18歳の 10 月 31 日までに兵役登録を行う必要があります。義務兵の現役期間は2年間です"]},{"tag":"a","props":{"href":"/ja/tip/31-03"},"children":[{"tag":"span","props":{},"children":["03"]},"徴兵に応じた後に兵役を拒否した場合、2年間は出国や進学・復学が禁止され、公務員や国営企業への採用も不可となります"]},{"tag":"a","props":{"href":"/ja/tip/31-04"},"children":[{"tag":"span","props":{},"children":["04"]},"大学生の兵役で最も実利的な2点：授業料が毎年最大 20000 元補助、学籍は2年間保持、大学院入試の特別枠あり"]},{"tag":"a","props":{"href":"/ja/tip/31-05"},"children":[{"tag":"span","props":{},"children":["05"]},"退役後、政府による就業配置が行われるのは6つのケースのみ；自主就業の場合は 30 日以内に届け出が必要"]},{"tag":"a","props":{"href":"/ja/tip/31-06"},"children":[{"tag":"span","props":{},"children":["06"]},"退役後の3つの勘定：一時金としての退役金、軍歴の勤続年数算入、自主事業の場合は毎年 20000 元の減税"]},{"tag":"a","props":{"href":"/ja/tip/31-07"},"children":[{"tag":"span","props":{},"children":["07"]},"公務員試験以外にも公務員への道はある：基礎サービスプロジェクトで2年間勤務すれば、毎年 10% の定向採用計画に応募可能"]},{"tag":"a","props":{"href":"/ja/tip/31-08"},"children":[{"tag":"span","props":{},"children":["08"]},"特崗教師（特別採用教員）は、3年間の服務期間終了後、評価に合格し、かつ継続を希望する場合は、速やかに正規採用（入編）されるべきである"]},{"tag":"a","props":{"href":"/ja/tip/31-09"},"children":[{"tag":"span","props":{},"children":["09"]},"消防士と軍事文職は、公務員試験とは別の公開採用枠であり、門戸は公務員試験よりも低い"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/ja/tip/31-10","data-status":"active"},"children":[{"tag":"span","props":{},"children":["10"]},"学歴は一度きりの取引ではない：自考（社会自学試験）は年齢や既修学歴を問わず、成人高考や開放大学でも補完が可能"]},{"tag":"a","props":{"href":"/ja/tip/31-11"},"children":[{"tag":"span","props":{},"children":["11"]},"組織に属さなければ「フリーランス」：年金と医療保険は就業地での加入が必要、戸籍による制限は緩和済み"]},{"tag":"a","props":{"href":"/ja/tip/31-12"},"children":[{"tag":"span","props":{},"children":["12"]},"出前置配送、配网約車、市内貨物輸送などの業務において、プラットフォームが注文ごとに職業傷害保障費を負担し、自身での支払いは不要"]},{"tag":"a","props":{"href":"/ja/tip/31-13"},"children":[{"tag":"span","props":{},"children":["13"]},"大学入試の志望校記入日に公務員枠を確定できる2つの道：公費師範生と定向医学生、代償は 6 年間の義務履行"]},{"tag":"a","props":{"href":"/ja/tip/31-14"},"children":[{"tag":"span","props":{},"children":["14"]},"海外での就労を希望するなら、まずこの会社に「対外労務合作経営資格」があるか確認すること：預かり金を請求することは禁止されています"]},{"tag":"a","props":{"href":"/ja/tip/31-15"},"children":[{"tag":"span","props":{},"children":["15"]},"海外企業のリモートワーク、この収入は税法上「国内所得」とみなされます：個人所得税は自身で申告し、送金は「給与所得」として処理すること"]},{"tag":"a","props":{"href":"/ja/tip/31-16"},"children":[{"tag":"span","props":{},"children":["16"]},"会社に属さず自力で起業するなら、まずは創業保証ローンをチェック：個人向け最高 30 万円、利息の半分を財政が補助"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"現在地"},"children":[{"tag":"a","props":{"href":"/ja/book"},"children":["本を読む"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/ja/book/31"},"children":["第31章"," ·"," ","18歳以降、どのような道があるか"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"31-10"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["10"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["エビデンス"," ","A"]}]},{"tag":"h1","props":{"lang":"ja"},"children":["学歴は一度きりの取引ではない：自考（社会自学試験）は年齢や既修学歴を問わず、成人高考や開放大学でも補完が可能"]},{"tag":"p","props":{"lang":"ja","className":"life-entry-summary"},"children":["18歳の時に学業を断念したとしても、その後には自考、成人高考、開放大学という3つの正規のルートがあります。自考は年齢やこれまでの学歴を問いませんが、全日制の在校生は受験できません。成人高考には、まず高校または専門学校の卒業証書が必要です。3つのルートはいずれも時間はかかりますが、18歳の時の試験結果に左右されることはありません。"]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["費用・手間"]},{"tag":"p","props":{},"children":["受験料と教材費は年間数百元程度です。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["効果"]},{"tag":"p","props":{},"children":["自考（高等教育自学試験）については、『高等教育自学試験暫定条例』を参照してください。"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"記録する：学歴は一度きりの取引ではない：自考（社会自学試験）は年齢や既修学歴を問わず、成人高考や開放大学でも補完が可能"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"できている"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"やることに追加"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"お気に入り"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"このヒントを共有"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"詳細を閉じる"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["費用・手間"]},{"tag":"p","props":{},"children":["受験料と教材費は年間数百元程度です。代償となるのは、長期にわたる独学、あるいは仕事の合間の通学です。働きながら学ぶ非脱産（非全日制）の編入学の場合、最短でも2年半の期間を要し、長期的な継続力が課題となります。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["効果"]},{"tag":"p","props":{},"children":["自考（高等教育自学試験）については、『高等教育自学試験暫定条例』を参照してください。第三条：「中華人民共和国の公民は、性別、年齢、民族、人種、および既修得の教育程度に制限されることなく、本条例の規定に従って高等教育自学試験に参加することができる」。第二十条：「各級各類の全日制学校の在校生は受験できない」。第二十五条には、卒業証書取得のための3つの条件が記載されています：すべての科目の試験に合格すること、卒業論文または実習任務を完了すること、思想品徳の鑑定に合格すること。これらすべてを満たせば、卒業証書を取得できます。また、同条には「専門科（基礎科）または本科の卒業証書を取得した者は、その学歴が国家によって認められる」とも記されています。第三十二条には、卒業証書取得者の給与待遇について、「非在職者の採用後は、普通高等学校の同類卒業生と同様とする」と記載されています。《高等教育法》第21条「国家は高等教育の自学試験制度を実施し、試験に合格した者には、相応の学位記またはその他の学業証明書を授与する」。成人大学入試については《2025 年全国成人大学入試方法》を参照。「受験対象は、国家が認める学歴を持つ各種高等・中等学校の在学生以外の従事者およびその他の社会人」である。「高専から本科（学士）または専門学校への進学を希望する受験者は、高等中等教育学校を卒業しているか、同等の学力を有していなければならない。専門学校から本科への進学を希望する受験者は、既に……専門学校卒業証書、本科修了証書、またはそれ以上の証書を取得している者でなければならない」。「全日制の最短学習期間は、高専から本科が4年、高専から専門学校および専門学校から本科への進学が2年、通学制の最短学習期間は、高専から本科が5年、高専から専門学校および専門学校から本科への進学が2年半である」。「脱産」とは、仕事を離れて終日学校に通う形態を指し、「非脱産」とは仕事を続けながら学ぶ形態を指します。オープン大学については、『教育部によるオープン大学の運営に関する意見』をご参照ください。そこには、「オープン大学は登録制入学を採用し、学生は課程を修了して所定の単位を取得することで課程修了証を取得できる。また、規定の単位を修得し関連する要件を満たした場合には、相応の学位および非学位の証明書を取得でき、学位授与の条件を満たす者には相応の学位を授与するものとする」と記載されています（全国）"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["出典"]},{"tag":"p","props":{"className":"life-citations"},"children":["国务院 (1988, 2014 修订). 高等教育自学考试暂行条例（第三、二十、二十五、三十二条）. ",{"tag":"a","props":{"href":"https://flk.npc.gov.cn/detail?id=ff8080816f3cbb3c016f415d64e5236d","target":"_blank","rel":"noopener noreferrer"},"children":["https://flk.npc.gov.cn/detail?id=ff8080816f3cbb3c016f415d64e5236d"]},"（国家法律法规数据库）；全国人大常委会 (2018). 高等教育法（第二十一条）. ",{"tag":"a","props":{"href":"https://flk.npc.gov.cn/detail?id=ff8080816f135f46016f20df64ec16c5","target":"_blank","rel":"noopener noreferrer"},"children":["https://flk.npc.gov.cn/detail?id=ff8080816f135f46016f20df64ec16c5"]},"（国家法律法规数据库）；教育部办公厅 (2025). 关于做好 2025 年全国成人高校招生工作的通知（教学厅〔2025〕6 号）及附件《2025 年全国成人高校招生办法》. ",{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/202509/content_7040877.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/zhengce/zhengceku/202509/content_7040877.htm"]},"；教育部 (2016). 关于办好开放大学的意见（教职成〔2016〕2 号）. ",{"tag":"a","props":{"href":"http://www.gov.cn/gongbao/content/2016/content_5067956.htm","target":"_blank","rel":"noopener noreferrer"},"children":["http://www.gov.cn/gongbao/content/2016/content_5067956.htm"]},"；教育部 (2007). 关于进一步做好高等学校各类招生管理工作的通知（教发〔2007〕13 号）：「普通专升本招生计划按不超过当年应届普通高职（专科）毕业生5%的比例安排」. ",{"tag":"a","props":{"href":"http://www.moe.gov.cn/s78/A03/s7050/201006/t20100607_88782.html","target":"_blank","rel":"noopener noreferrer"},"children":["http://www.moe.gov.cn/s78/A03/s7050/201006/t20100607_88782.html"]},"；中国政府网 (2020). 今年扩招硕士18.9万，专升本32.2万——毕业生就业帮扶发力，教育部副部长翁铁慧：「扩大普通高校专升本的规模，同比争取增加32.2万人」. ",{"tag":"a","props":{"href":"http://www.gov.cn/zhengce/2020-02/29/content_5484774.htm","target":"_blank","rel":"noopener noreferrer"},"children":["http://www.gov.cn/zhengce/2020-02/29/content_5484774.htm"]},"；福建省教育考试院 (2026). 转发时引「教育部高校学生司《关于做好2026年普通高等学校专升本考试招生工作的通知》（教学司函〔2025〕53号）」. ",{"tag":"a","props":{"href":"https://www.eeafj.cn/gkzsb/20260310/14437.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.eeafj.cn/gkzsb/20260310/14437.html"]}]},{"tag":"a","props":{"href":"https://flk.npc.gov.cn/detail?id=ff8080816f3cbb3c016f415d64e5236d","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["出典を開く"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["著者の注記"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["また、新卒の全日制短大・専門学校卒業生を対象とした、通常の「専升本（短大から本科への編入学）」という制度もあります。全国レベルで公開されている文書は、教育部による 2007 年の通知で、そこには専升本計画は当年度の短大卒業生数の 5% を超えないと記載されています。2020 年から教育部は専升本の規模を拡大し、前年比で 32.2 万人増加しましたが、5% という基準は、実際にはもはや適用されていません。毎年の具体的な計画は、教育部高校学生司が発行する公文書に基づいています。例えば、2026 年は教学司函〔2025〕53 号です。この文書は外部には公開されておらず、各省が転送する文書から文書番号を確認することしかできません。募集対象は各省が独自に決定しており、基本的には自省の当年度全日制短大卒業生のみを対象としているため、本文にはその条件は記載されていません。2025 年の秋季より、高等学历継続教育は「函授」「業余」とは呼ばれなくなり、統一して「非脱産」と呼ばれます。高等学历継続教育とは、成人が後から学歴を補完する類のものであり、旧名称を使用している宣伝には注意が必要です。学歴の補完と「どのスキルを学ぶのがお得か」は別問題であり、後者については第 23 節を参照してください。費用を払って手に入れる「迅速な資格取得」や偽造証明書については、第 23 節第 8 条を参照してください。"]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["自分のメモ"]},{"tag":"button","props":{"type":"button"},"children":["自分へのメモを書く…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/ja/tip/31-09"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["前へ"]},"消防士と軍事文職は、公務員試験とは別の公開採用枠であり、門戸は公務員試験よりも低い"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/ja/tip/31-11"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["次へ"]},"組織に属さなければ「フリーランス」：年金と医療保険は就業地での加入が必要、戸籍による制限は緩和済み"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["このテーマの他の提案"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/31-06"},"children":[{"tag":"strong","props":{},"children":["退役後の3つの勘定：一時金としての退役金、軍歴の勤続年数算入、自主事業の場合は毎年 20000 元の減税"]},{"tag":"span","props":{},"children":["退役後には3つの勘定があります。1つ目は自主就業の一時金としての退役金で、現役の服役年数に応じて支給され、功績がある場合は増額されます。2…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/31-07"},"children":[{"tag":"strong","props":{},"children":["公務員試験以外にも公務員への道はある：基礎サービスプロジェクトで2年間勤務すれば、毎年 10% の定向採用計画に応募可能"]},{"tag":"span","props":{},"children":["公務員を目指す道は、公務員試験だけではありません。「三支一扶」のような基礎サービスプロジェクトで2年間勤務し、評