u chứng tái diễn thì đi khám ngay. Không dùng khi khó nuốt hoặc đau khi nuốt, nôn ra máu, đi ngoài ra máu hoặc phân đen, vì đây có thể là dấu hiệu của tình trạng nặng. Khi có triệu chứng cảnh báo như sút cân rõ, nôn lặp, khó nuốt, nôn ra máu hoặc phân đen thì phải loại trừ ung thư trước, vì việc điều trị có thể che mất triệu chứng và làm chậm chẩn đoán. Người trên 55 tuổi mà có triệu chứng mới hoặc triệu chứng thay đổi thì hỏi bác sĩ. Người đang uống clopidogrel thì tránh uống omeprazole cùng lúc."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Nguồn gốc"]},{"tag":"p","props":{"className":"life-citations"},"children":["国家药监局关于奥美拉唑肠溶片处方药转换为非处方药的公告（2022年第68号）及附件2《非处方药说明书范本》. ",{"tag":"a","props":{"href":"https://www.nmpa.gov.cn/yaopin/ypggtg/20220826171517123.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.nmpa.gov.cn/yaopin/ypggtg/20220826171517123.html"]}]},{"tag":"a","props":{"href":"https://www.nmpa.gov.cn/yaopin/ypggtg/20220826171517123.html","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Liên kết mở nguồn"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Ghi chú sách"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["Clopidogrel là thuốc chống huyết khối mà người đã đặt stent, đã từng bị nhồi máu cơ tim hay dùng. Omeprazole làm nó yếu đi, người đang uống thì hỏi bác sĩ trước. Để ở mức B là vì đây chỉ là quy định trong hướng dẫn, không có nghiên cứu nào tính được làm theo thì bớt được bao nhiêu sự cố. Cỡ lợi ích đặt là「vừa」là đánh giá: nó ngăn việc kéo dài xuất huyết dạ dày và ung thư dạ dày, nhưng phần lớn triệu chứng trào ngược và ợ nóng không nặng."]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Ghi chú của tôi"]},{"tag":"button","props":{"type":"button"},"children":["Viết một lời nhắc cho chính bạn…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/vi/tip/34-05"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Trước"]},"Sau tuần thứ 20 của thai kỳ, đừng tự uống thuốc giảm đau như ibuprofen"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/vi/tip/34-07"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Tiếp theo"]},"Cảm cúm thường đừng xin bác sĩ kê kháng sinh"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"s