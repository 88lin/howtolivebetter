ai, cho con bú thì bổ sung vitamin B12 hằng ngày; thức ăn dặm của con phải có thực phẩm động vật, nhất quyết thuần chay thì hỏi bác sĩ trước"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"Breadcrumbs"},"children":[{"tag":"a","props":{"href":"/vi/book"},"children":["Khám phá cuốn sách"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/vi/book/20"},"children":["Chương 20"," ·"," ","Chăm trẻ mới sinh"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"20-12"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["12"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["Bằng chứng"," ","A"]}]},{"tag":"h1","props":{"lang":"vi"},"children":["Con bị eczema nặng hoặc dị ứng trứng, đừng né đậu phộng, sớm thêm theo hướng dẫn của bác sĩ, nhưng tuyệt đối không cho ăn hạt cả nguyên"]},{"tag":"p","props":{"lang":"vi","className":"life-entry-summary"},"children":["Trẻ sơ sinh bị eczema nặng hoặc dị ứng trứng, cho ăn đậu phộng đều đặn từ 4 đến 11 tháng tuổi, đến 5 tuổi tỷ lệ dị ứng đậu phộng chỉ 1.9%, trẻ né hoàn toàn là 13.7%. Với nhóm trẻ mà xét nghiệp da đã có phản ứng nhẹ, nhóm ăn là 10.6%, nhóm né là 35.3%. Trước khi thêm, hãy đưa con đi khám bác sĩ. Tuyệt đối không cho ăn hạt đậu phộng nguyên, sẽ nghẹn vào khí quản."]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Chi phí"]},{"tag":"p","props":{},"children":["Một hộp sốt đậu phộng vài chục tệ. Cho ăn vài lần một tuần…"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Lợi ích"]},{"tag":"p","props":{},"children":["Thử nghiệm chia nhóm ngẫu nhiên LEAP của Anh. 640 trẻ sơ sinh được đưa vào nghiên cứu, điều kiện là bị eczema…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"Đánh dấu: Con bị eczema nặng hoặc dị ứng trứng, đừng né đậu phộng, sớm thêm theo hướng dẫn của bác sĩ, nhưng tuyệt đối không cho ăn hạt cả nguyên"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"Hoàn tất"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"Kế hoạch thực hiện"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"Lưu"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Chia sẻ mẹo này"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Ẩn chi tiết"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Chi phí"]},{"tag":"p","props":{},"children":["Một hộp sốt đậu phộng vài chục tệ. Cho ăn vài lần một tuần, làm luôn thôi. Trước khi thêm phải đưa con đi khám bác sĩ một lần để đánh giá."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Lợi ích"]},{"tag":"p","props":{},"children":["Thử nghiệm chia nhóm ngẫu nhiên LEAP của Anh. 640 trẻ sơ sinh được đưa vào nghiên cứu, điều kiện là bị eczema nặng, dị ứng trứng, hoặc cả hai. Khi nhập mẫu trẻ từ 4 đến 11 tháng tuổi. Chia ngẫu nhiên thành hai nhóm, một nhóm ăn đậu phộng đều đặn, một nhóm né hoàn toàn, đến 60 tháng tuổi thì xem tỷ lệ dị ứng đậu phộng. Trong 530 trẻ có xét nghiệm da âm tính với đậu phộng lúc nhập mẫu, nhóm né 13.7% dị ứng, nhóm ăn 1.9%（P<0.001）. Trong 98 trẻ đã dương tính yếu lúc nhập mẫu, nhóm né 35.3%, nhóm ăn 10.6%（P=0.004）. Biến cố bất lợi nghiêm trọng không khác nhau giữa hai nhóm."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Nguồn gốc"]},{"tag":"p","props":{"className":"life-citations"},"children":["Du Toit G, Roberts G, Sayre PH, 等 (2015). Randomized trial of peanut consumption in infants at risk for peanut allergy. New England Journal of Medicine, 372(9), 803-813. ",{"tag":"a","props":{"href":"https://doi.org/10.1056/NEJMoa1414850","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1056/NEJMoa1414850"]},"；国家卫生健康委办公厅 (2020). 婴幼儿喂养健康教育核心信息. ",{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/2020-08/01/content_5531915.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/zhengce/zhengceku/2020-08/01/content_5531915.htm"]},"；Perkin MR 等 (2016). Randomized Trial of Introduction of Allergenic Foods in Breast-Fed Infants. New England Journal of Medicine, 374(18), 1733-1743. ",{"tag":"a","props":{"href":"https://doi.org/10.1056/NEJMoa1514210","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1056/NEJMoa1514210"]},"（备注里那项一般婴儿试验 EAT）"]},{"tag":"a","props":{"href":"https://doi.org/10.1056/NEJMoa1414850","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Liên kết mở nguồn"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Ghi chú sách"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":[{"tag":"strong","props":{},"children":["Dạng thức chỉ có thể là sốt đậu phộng pha loãng, hoặc bột đậu phộng trộn vào thức ăn dặm, tuyệt đối không cho hạt đậu phộng nguyên."]}," Thông tin cốt lõi về nuôi dưỡng của Ủy ban Quốc gia Y tế và Sức khoẻ nói rõ: 「整粒花生、坚果、果冻等食物易吸入气管，引起窒息，婴幼儿应当避免食用」, tức hạt đậu phộng nguyên, hạt cây, thạch và các thức ăn tương tự rất dễ bị hút vào khí quản, gây ngạt thở, trẻ sơ sinh và trẻ nhỏ nên tránh ăn. Bị nghẹn thì làm gì, xem mục 26 ở phần 13 (có người bị nghẹn không nói nổi). Chỉ nhóm trẻ nguy cơ cao mới áp dụng: trẻ bị eczema nặng, hoặc đã dị ứng trứng. ",{"tag":"strong","props":{},"children":["Trước khi thêm phải đi khám bác sĩ để đánh giá, đừng tự thử ở nhà"]},": trước khi nhập mẫu, thử nghiệm LEAP làm xét nghiệm da cho từng trẻ, trẻ có phản ứng da lớn hơn 4 milimét bị loại khỏi thử nghiệm, không cho ăn. Với trẻ thường, bằng chứng yếu hơn nhiều. Trong một thử nghiệm khác gồm 1162 trẻ sơ sinh bú mẹ bình thường, tính theo nhóm thì nhóm cho sớm tỷ lệ dị ứng thức ăn là 5.6%, nhóm thường là 7.1%, chênh lệch không có ý nghĩa (P=0.32); chỉ trong nhóm trẻ thực sự làm theo mới thấy khác biệt (2.4% so với 7.3%). Cách tính này dễ nói quá hiệu quả, chính tác giả nói tính theo nhóm không chứng minh được hiệu lực, nhưng cũng cho thấy cho sớm là an toàn. Văn bản nuôi dưỡng chính thức của Trung Quốc hiện chưa có lập trường về 「nên cho sớm hay nên tránh thức ăn dễ dị ứng」, nên mục này viết theo bằng chứng thử nghiệm quốc tế. Về thời điểm cũng phải để ý: LEAP bắt đầu từ 4 tháng tuổi, còn Trung Quốc bắt đầu thêm thức ăn dặm khi đủ 6 tháng tuổi, xem mục 4 của phần này (sáu tháng đầu chỉ cho bú mẹ). Trẻ nguy cơ cao bắt đầu từ mấy tháng tuổi và bắt đầu thế nào, nghe bác sĩ."]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Ghi chú của tôi"]},{"tag":"button","props":{"type":"button"},"children":["Viết một lời nhắc cho chính bạn…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/vi/tip/20-11"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Trước"]},"Với đồ lớn thì cứ theo thứ tự 「mượn, mua đồ cũ, mua mới」, đừng mua đủ một lần"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/vi/tip/20-13"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Tiếp theo"]},"Canh mấy dấu hiệu vàng da ở trẻ sơ sinh: vàng trong 24 giờ đầu sau khi sinh, vàng đậm dần, gọi không dậy không bú, phân màu trắng thì trong ngày đó đi bệnh viện"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["Thêm trong chủ đề này"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/20-06"},"children":[{"tag":"strong","props":{},"children":["Không cho con dưới 1 tuổi ăn mật ong"]},{"tag":"span","props":{},"children":["Con dưới 1 tuổi, đừng cho ăn mật ong. Nước mật ong, mật ong trộn vào …"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/20-07"},"children":[{"tag":"strong","props":{},"children":["Mũi tiêm vitamin K lúc sinh nhất định phải tiêm"]},{"tag":"span","props":{},"children":["Trẻ sơ sinh dự trữ rất ít vitamin K trong cơ thể, không bù thì có thể…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/20-08"},"children":[{"tag":"strong","props":{},"children":["Trẻ dưới 3 tháng tuổi, nhiệt độ chạm 38 ℃ thì đi bệnh viện luôn, không quan sát ở nhà"]},{"tag":"span","props":{},"children":["Con dưới 3 tháng tuổi, nhiệt độ chạm 38 ℃ thì đi bệnh viện luôn. Đừng…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/20-09"},"children":[{"tag":"strong","props":{},"children":["Dù mệt mỏi, giận dữ đến đâu cũng đừng lắc đứa trẻ"]},{"tag":"span","props":{},"children":["Đầu trẻ sơ sinh to, cổ yếu. Lắc mạnh khiến trẻ xuất huyết trong não v…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/20-10"},"children":[{"tag":"strong","props":{},"children":["Bỉ thì không xem nhãn hiệu, xem ba điều: vừa thân không, có thay đủ tần suất không, có bị thông báo kiểm tra mẫu rồi không"]},{"tag":"span","props":{},"children":["Không cơ quan chính thức nào xếp hạng 「thương hiệu nào là tốt nhất」. …"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/20-14"},"children":[{"tag":"strong","props":{},"children":["Ăn chay khi mang thai, cho con bú thì bổ sung vitamin B12 hằng ngày; thức ăn dặm của con phải có thực phẩm động vật, nhất quyết thuần chay thì hỏi bác sĩ trước"]},{"tag":"span","props":{},"children":["Vitamin B12 hầu như chỉ có trong thịt, trứng, sữa. Mẹ ăn thuần chay m…"]}]}]}]},{"tag":"a","props":{"className":"life-text-link","href":"/vi/book/20"},"children":["Đọc toàn bộ chủ đề: Chăm trẻ mới sinh"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"15","height":"15","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]}]}]}]},{"tag":"aside","props":{"className":"life-ad-space life-ad-space-sponsored","data-ad-placement":"ad_footer","data-ad-group":"reading","data-ad-creative":"read_product","data-ad-ready":"false","aria-label":"Quảng cáo · Giới thiệu cộng đồng"},"children":[{"tag":"div","props":{"className":"life-ad-space-brand"},"children":[{"tag":"img","props":{"src":"/sites/howtolivebetter/images/shengcai/logo.png","width":"565","height":"144","alt":"Logo chính thức của Shengcai Youshu","decoding":"async"},"children":[]}]},{"tag":"div","props":{"className":"life-ad-space-copy"},"children":[{"tag":"span","props":{"className":"life-ad-space-label"},"children":["Quảng cáo · Giới thiệu cộng đồng"]},{"tag":"strong","props":{},"children":["Kiến thức bạn có thể thành sản phẩm hữu ích không?"]},{"tag":"p","props":{},"children":["Từ sách điện tử đến công cụ nhỏ: xem cách thành viên tìm nhu cầu và biến kiến thức thành thứ dùng được."]}]},{"tag":"div","props":{"className":"life-ad-space-actions"},"children":[{"tag":"a","props":{"className":"life-ad-space-link