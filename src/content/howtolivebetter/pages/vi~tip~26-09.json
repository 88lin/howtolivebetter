ewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-up-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M7 7h10v10"},"children":[]},{"tag":"path","props":{"d":"M7 17 17 7"},"children":[]}]}]}]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/vi/book/26"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"Quay lại mục lục"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["Làm một trang web hoặc nền tảng: giấy phép, đăng ký, máy chủ"]},{"tag":"div","props":{"data-ad-dock-host":"true"},"children":[]},{"tag":"nav","props":{"aria-label":"Các mục trong chương"},"children":[{"tag":"a","props":{"href":"/vi/tip/26-01"},"children":[{"tag":"span","props":{},"children":["01"]},"Để tiền không đi vào tài khoản của nền tảng rồi mới chuyển cho người bán, hãy cho tiền đi thẳng qua tổ chức thanh toán được cấp phép"]},{"tag":"a","props":{"href":"/vi/tip/26-02"},"children":[{"tag":"span","props":{},"children":["02"]},"Trang web thu phí thì cần giấy phép, bên tự bán hàng không cho người khác tham gia thì không cần, bên trung gian kết nối giao dịch là loại giấy phép khác, trang web miễn phí chỉ cần đăng ký khai báo"]},{"tag":"a","props":{"href":"/vi/tip/26-03"},"children":[{"tag":"span","props":{},"children":["03"]},"Phát trực tiếp thì cần giấy phép kinh doanh văn hóa trên mạng, còn giấy phép chương trình nghe nhìn thì công ty tư nhân gần như không xin được"]},{"tag":"a","props":{"href":"/vi/tip/26-04"},"children":[{"tag":"span","props":{},"children":["04"]},"Máy chủ đặt trong nước thì phải đăng ký khai báo, và nhà cung cấp dịch vụ truy cập phải tự có giấy phép viễn thông giá trị gia tăng"]},{"tag":"a","props":{"href":"/vi/tip/26-05"},"children":[{"tag":"span","props":{},"children":["05"]},"Cho người dùng lên bán hàng thì nền tảng phải kiểm tra đăng ký, báo thông tin và lưu giữ ba năm"]},{"tag":"a","props":{"href":"/vi/tip/26-06"},"children":[{"tag":"span","props":{},"children":["06"]},"Nội dung người dùng đăng lên là bạn phải quản: có cơ chế duyệt, có cửa sổ báo việc, thấy nội dung vi phạm thì dừng truyền ngay và báo cáo"]},{"tag":"a","props":{"href":"/vi/tip/26-07"},"children":[{"tag":"span","props":{},"children":["07"]},"Cung cấp dịch vụ đăng thông tin và nhắn tin tức thì phải yêu cầu người dùng cung cấp thông tin danh tính thật"]},{"tag":"a","props":{"href":"/vi/tip/26-08"},"children":[{"tag":"span","props":{},"children":["08"]},"Không mở phát trực tiếp cho người chưa đủ 16 tuổi, tiền thưởng xử lý theo bậc tuổi"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/vi/tip/26-09","data-status":"active"},"children":[{"tag":"span","props":{},"children":["09"]},"Nhận được thông báo vi phạm thì phải xử lý kịp thời, chuyển bản giải trình mà sau 15 ngày không có động tĩnh thì khôi phục lại"]},{"tag":"a","props":{"href":"/vi/tip/26-10"},"children":[{"tag":"span","props":{},"children":["10"]},"Đừng tùy tiện đặt thông tin người dùng ra nước ngoài, việc chuyển dữ liệu ra nước ngoài có điều kiện luật định và có ngưỡng số người"]},{"tag":"a","props":{"href":"/vi/tip/26-11"},"children":[{"tag":"span","props":{},"children":["11"]},"Chọn máy chủ thì xem sập có chịu được không, xem có ai trực vận hành không, cuối cùng mới so giá"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-la