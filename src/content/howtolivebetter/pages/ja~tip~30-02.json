necap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"詳細を閉じる"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["費用・手間"]},{"tag":"p","props":{},"children":["費用はかかりません。重要なのは、早期に対処するか遅らせるかです。欠席や再診には時間がかかりますが、治療自体の費用は別途計算されます。困難な点は、装具を毎日少なくとも 18 時間装着する必要があり、子供がそれに耐え続けなければならないことです。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["効果"]},{"tag":"p","props":{},"children":["複数の病院による共同試験において、装具の使用条件を満たす青少年特発性側弯症患者 242 例を対象とした。そのうち 116 例は抽選によりグループ分けを行い、126 例は装具を使用するかどうかを自身で選択した。成功と失敗の判定基準は事前に決定されており、弯曲度が 50 度以上に達した場合は治療失敗、骨の成長が完了した時点でこの度に達していなければ治療成功とみなした。判定は、後に実際に十分な期間使用したかに関わらず、最初に割り当てられたグループに基づいて行われた。抽選で装具使用群に割り当てられた場合の成功率は 75%、観察のみの群は 42%（OR 4.11、95% CI 1.85–9.16）であり、成功する確率は観察のみの群の約 4 倍であった。抽選で選ばれたグループと自身で選んだグループを合わせて計算すると、72% 対 48% となります（両グループ間の元々の差を補正した後では OR 1.93、1.08–3.46、依然として約 1.9 倍）。1日の装着時間が長いほど、成功率は高くなります（P<0.001、この関係が偶然である可能性は低いです）。装置に確かな有効性が認められたため、試験は予定より前倒しで終了しました"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["出典"]},{"tag":"p","props":{"className":"life-citations"},"children":["Weinstein SL, et al. (2013). Effects of bracing in adolescents with idiopathic scoliosis. New England Journal of Medicine. ",{"tag":"a","props":{"href":"https://doi.org/10.1056/NEJMoa1307337","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1056/NEJMoa1307337"]}]},{"tag":"a","props":{"href":"https://doi.org/10.1056/NEJMoa1307337","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["出典を開く"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["著者の注記"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["ここでは側弯症を例に挙げています。これは、ランダム化比較試験が存在し、明確な治療の適期（ウィンドウ）があり、かつ学生の健康診断の重点項目の一つだからです（第 7 条を参照）。同様の例には、斜視、弱視、う蝕（虫歯）、および時期を選んで行うことができる先天性心疾患の手術などがあります。これらに共通しているのは、遅ければ遅いほど効果が低下するか、あるいは代償が大きくなるという点です。具体的な適期については専門医に相談してください。授業への影響を心配される場合は、義務教育段階であれば休学が可能です。最長 1 年間、学籍は維持されます（第 11 条を参照）。"]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["自分のメモ"]},{"tag":"button","props":{"type":"button"},"children":["自分へのメモを書く…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/ja/tip/30-01"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["前へ"]},"子供が突然激痛を感じ、さらに痛みが強まっている場合は、すぐに病院へ行ってください。放課後まで我慢させてはいけません"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/ja/tip/30-03"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["次へ"]},"子供がいじめを受けた際、当日中に学校へ報告し、書面での対応を求める。殴打、金銭の強奪、デマの流布が関わる場合は直接警察へ通報"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["このテーマの他の提案"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/30-04"},"children":[{"tag":"strong","props":{},"children":["子供を毎日 2 時間屋外で過ごさせることは、現在、ランダム化比較試験によって支持されている唯一の近視予防策です"]},{"tag":"span","props":{},"children":["小学1年生が毎日 40 分間多く屋外授業を行うと、3年後の新規近視児の割合が約4割から約3割に減少しました。国家衛生健康委員会が推奨する量…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/30-05"},"children":[{"tag":"strong","props":{},"children":["0 歳から 3 歳まではスクリーンを与えない、3 歳から 6 歳までは極力与えない、小中学生の学習目的以外での使用は1日 1 時間を超えないこと"]},{"tag":"span","props":{},"children":["国家衛生健康委員会は、0 歳から 3 歳まではスクリーンを与えず、3 歳から 6 歳までは極力触れさせないことを求めています。小中学生の学…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/30-06"},"children":[{"tag":"strong","props":{},"children":["近視を「残る損傷」として捉える：度数が深いほど、将来の網膜剥離、黄斑変性、緑内障のリスクが高まる"]},{"tag":"span","props":{},"children":["近視は自然に治ることはなく、度数が下がることもありません。単に「眼鏡をかける」だけの問題でもありません。非近視の人と比較して、近視性黄斑変…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/30-07"},"children":[{"tag":"strong","props":{},"children":["年に一度の学生健康診断の結果は自分で必ず確認し、異常があればその年のうちに病院で検査を受けること"]},{"tag":"span","props":{},"children":["小中学校では毎年、学生健康診断が実施されます。報告書で重点的に見るべきは、肥満、過体重、栄養不良、脊柱の弯曲異常、視力低下、虫歯です。これ…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/30-08"},"children":[{"tag":"strong","props":{},"children":["12歳から18歳の子どもへのうつ病スクリーニング：学校の心理テストを診断と混同しないこと"]},{"tag":"span","props":{},"children":["米国の予防ガイドラインでは、12歳から18歳の子どもに対して重度うつ病のスクリーニングを推奨しており、11歳以下についてはエビデンスが不十…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/30-09"},"children":[{"tag":"strong","props":{},"children":["「近視を治す」「度数を下げる」と謳う製品やサービスは買わない"]},{"tag":"span","props":{},"children":["国家市場監督管理総局は「現在の医療技術では、近視は完治できない」と明言しています。「回復」「度数を下げる」「近視の完治」「度数の修復」とい…"]}]}]}]},{"tag":"a","props":{"className":"life-text-link","href":"/ja/book/30"},"children":["テーマ全体を読む：就学後の子ども"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"15","height":"15","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]}]}]}]},{"tag":"aside","props":{"className":"life-ad-space life-ad-space-sponsored","data-ad-placement":"ad_footer","data-ad-group":"reading","data-ad-creative":"read_product","data-ad-ready":"false","aria-label":"広告 · コミュニティ紹介"},"children":[{"tag":"div","props":{"className":"life-ad-space-brand"},"children":[{"tag":"img","props":{"src":"/sites/howtolivebetter/images/shengcai/logo.png","width":"565","height":"144","alt":"生財有術の公式ロゴ","decoding":"async"},"children":[]}]},{"tag":"div","props":{"className":"life-ad-space-copy"},"children":[{"tag":"span","props":{"className":"life-ad-space-label"},"children":["広告 · コミュニティ紹介"]},{"tag":"strong","props":{},"children":["学んだ知識は、役立つ製品になる？"]},{"tag":"p","props":{},"chil