,"height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"div","props":{"className":"life-longread-layout"},"children":[{"tag":"aside","props":{"className":"life-longread-toc"},"children":[{"tag":"details","props":{"open":true},"children":[{"tag":"summary","props":{},"children":["本文目录"]},{"tag":"nav","props":{"aria-label":"本文目录"},"children":[{"tag":"a","props":{"href":"#完整题单与原文介绍"},"children":["完整题单与原文介绍"]},{"tag":"a","props":{"href":"#让陌生人迅速相爱的36个问题"},"children":["让陌生人迅速相爱的36个问题"]},{"tag":"a","props":{"href":"#研究说明了什么"},"children":["研究说明了什么"]},{"tag":"a","props":{"href":"#开始前用一句话说清楚"},"children":["开始前，用一句话说清楚"]},{"tag":"a","props":{"href":"#轮流回答别变成采访"},"children":["轮流回答，别变成采访"]},{"tag":"a","props":{"href":"#感觉太深就退一步"},"children":["感觉太深，就退一步"]},{"tag":"a","props":{"href":"#聊完之后不急着下结论"},"children":["聊完之后，不急着下结论"]},{"tag":"a","props":{"href":"#回到书里的对应建议"},"children":["回到书里的对应建议"]}]}]}]},{"tag":"div","props":{"className":"life-longread-main"},"children":[{"tag":"article","props":{"className":"life-article-body","lang":"zh"},"children":[{"tag":"p","props":{},"children":["两个人都愿意认真聊一会儿时，可以用一份有顺序的题单作开场。它的价值在于让双方都有机会表达，而不是给谁一套让别人喜欢自己的话术。"]},"\n",{"tag":"h2","props":{"id":"完整题单与原文介绍"},"children":["完整题单与原文介绍"]},"\n",{"tag":"p","props":{},"children":["下面收录 Daniel Jones 的《让陌生人迅速相爱的36个问题》全文，来源为",{"tag":"a","props":{"href":"https://cn.nytimes.com/culture/20150123/t23questions/","target":"_blank","rel":"noopener noreferrer"},"children":["纽约时报中文网"]},"。也可查看",{"tag":"a","props":{"href":"https://ggia.berkeley.edu/practice/36_questions_for_increasing_closeness/","target":"_blank","rel":"noopener noreferrer"},"children":["英文题单与练习说明"]},"。两个人可以直接在本页轮流读题、回答，经典练习通常留出约 45 分钟。原文之后附有本站整理的使用建议。"]},"\n",{"tag":"h2","props":{"id":"让陌生人迅速相爱的36个问题"},"children":["让陌生人迅速相爱的36个问题"]},"\n",{"tag":"p","props":{},"children":["Daniel Jones"]},"\n",{"tag":"p","props":{},"children":[{"tag":"img","props":{"src":"/sites/howtolivebetter/external/static01.nyt.com/images/2014/02/11/science/11WELL/11WELL-master1050.jpg","alt":"Stuart Bradford 绘制的插画"},"children":[]}]},"\n",{"tag":"p","props":{},"children":["插画：Stuart Bradford"]},"\n",{"tag":"p","props":{},"children":["曼迪·莱恩·卡特隆(Mandy Len Catron)为“现代爱情”专栏写了一篇文章《如何快速与陌生人相爱》，她在文中提到心理学家阿瑟·亚伦(Arthur Aron)等人的研究成果：两个陌生人之间的亲密关系或许可以通过彼此询问一些特别的个人化问题而快速升温。这36个问题分为三组，一组比一组来得寻根究底。"]},"\n",{"tag":"p","props":{},"children":["这个理论的核心是，共同的脆弱能促进亲近感。这项研究的作者们称：“同伴之间发展亲密关系的关键模式在于持续、逐步升级、相互且个人化的袒露自我。”允许自己和另一个人共享脆弱可能非常困难，下面这个练习能迫使你做到这一点。"]},"\n",{"tag":"p","props":{},"children":["卡特隆和她的朋友在文中尝试的最后一件事是彼此对视四分钟，这个过程没有被详细记录（其实可以从两分钟到四分钟不等）。但是卡特隆毫不迟疑地推荐这件事。“两分钟的效果已经很惊人了，”她告诉我，“四分钟真的非常有效。”"]},"\n",{"tag":"h3","props":{"id":"第一组"},"children":["第一组"]},"\n",{"tag":"ol","props":{},"children":["\n",{"tag":"li","props":{},"children":["\n",{"tag":"p","props":{},"children":["如果可以在世界上所有人中任意选择，你想邀请谁共进晚餐？"]},"\n"]},"\n",{"tag":"li","props":{},"children":["\n",{"tag":"p","props":{},"children":["你想成名吗？想以什么方式成名？"]},"\n"]},"\n",{"tag":"li","props":{},"children":["\n",{"tag":"p","props":{},"children":["打电话之前你会先排练一下要说什么吗，为什么？"]},"\n"]},"\n",{"tag":"li","props":{},"children":["\n",{"tag":"p","props":{},"children":["对你来说，“完美”的一天是什么样的？"]},"\n"]},"\n",{"tag":"li","props":{},"children":["\n",{"tag":"p","props":{},"children":["你上次自己唱起歌来是在什么时候，给别人唱呢？"]},"\n"]},"\n",{"tag":"li","props":{},"children":["\n",{"tag":"p","props":{},"children":["如果你能活到90岁，同时可以一直保持30岁时的心智或身体，你会选择保持哪一种呢，心智还是身体？"]},"\n"]},"\n",{"tag":"li","props":{},"children":["\n",{"tag":"p","props":{},"children":["你是否曾经秘密地预感到自己会以怎样的方式死去？"]},"\n"]},"\n",{"tag":"li","props":{},"children":["\n",{"tag":"p","props":{},"children":["说出三件你和你的伴侣看上去相同的特征。"]},"\n"]},"\n",{"tag":"li","props":{},"children":["\n",{"tag":"p","props":{},"children":["人生中的什么东西最令你感激？"]},"\n"]},"\n",{"tag":"li","props":{},"children":["\n",{"tag":"p","props":{},"children":["如果你能改变被抚养成人过程中的一件事，会是哪一件。"]},"\n"]},"\n",{"tag":"li","props":{},"children":["\n",{"tag":"p","props":{},"children":["花四分钟时间，尽可能详细告诉伴侣你的人生经历。"]},"\n"]},"\n",{"tag":"li","props":{},"children":["\n",{"tag":"p","props":{},"children":["如果你明天一觉醒来就能拥有某种才能或能力，你希望那会是什么能力呢？"]},"\n"]},"\n"]},"\n",{"tag":"h3","props":{"id":"第二组"},"children":["第二组"]},"\n",{"tag":"ol","props":{"start":"13"},"children":["\n",{"tag":"li","props":{},"children":["\n",{"tag":"p","props":{},"children":["如果有一个水晶球可以告诉你关于自己、人生，未来乃至任何事情的真相，你会想知道吗？"]},"\n"]},"\n",{"tag":"li","props":{},"children":["\n",{"tag":"p","props":{},"children":["有没有什么事是你一直梦想去做而没有去做的，为什么没有做？"]},"\n"]},"\n",{"tag":"li","props":{},"children":["\n",{"tag":"p","props":{},"children":["你人生中最大的成就是什么？"]},"\n"]},"\n",{"tag":"li","props":{},"children":["\n",{"tag":"p","props":{},"children":["在一段友谊之中你最珍视的是什么？"]},"\n"]},"\n",{"tag":"li","props":{},"children":["\n",{"tag":"p","props":{},"children":["你最宝贵的记忆是什么？"]},"\n"]},"\n",{"tag":"li","props":{},"children":["\n",{"tag":"p","props":{},"children":["你最糟糕的记忆是什么？"]},"\n"]},"\n",{"tag":"li","props":{},"children":["\n",{"tag":"p","props":{},"children":["假如你知道自己在一年内就会突然死去，你会改变现在的生活方式吗？为什么？"]},"\n"]},"\n",{"tag":"li","props":{},"children":["\n",{"tag":"p","props":{},"children":["友谊对于你来说意味着什么？"]},"\n"]},"\n",{"tag":"li","props":{},"children":["\n",{"tag":"p","props":{},"children":["爱与情感在你生活中扮演着什么样的角色？"]},"\n"]},"\n",{"tag":"li","props":{},"children":["\n",{"tag":"p","props":{},"children":["和你的伴侣轮流说出心目中对方的一个好品质，每人说五条。"]},"\n"]},"\n",{"tag":"li","props":{},"children":["\n",{"tag":"p","props":{},"children":["你的家人之间关系是否亲密而温暖，你觉得自己的童年比其他人更快乐吗？"]},"\n"]},"\n",{"tag":"li","props":{},"children":["\n",{"tag":"p","props":{},"children":["你和母亲之间的关系是怎样的？"]},"\n"]},"\n"]},"\n",{"tag":"h3","props":{"id":"第三组"},"children":["第三组"]},"\n",{"tag":"ol","props":{"start":"25"},"children":["\n",{"tag":"li","props":{},"children":["\n",{"tag":"p","props":{},"children":["每人用“我们”造三个句子，并含有实际情况，比如“我们俩在屋子里，感觉……”"]},"\n"]},"\n",{"tag":"li","props":{},"children":["\n",{"tag":"p","props":{},"children":["补完这个句子：“我希望和某人在一起，分享……”"]},"\n"]},"\n",{"tag":"li","props":{},"children":["\n",{"tag":"p","props":{},"children":["如果你想和对方成为亲近的朋友，请告诉对方有什么重要的事情是他或她需要知道的。"]},"\n"]},"\n",{"tag":"li","props":{},"children":["\n",{"tag":"p","props":{},"children":["告诉对方你喜欢他或她身上的什么东西，要非常诚实，说些你不会对萍水之交说的东西。"]},"\n"]},"\n",{"tag":"li","props":{},"children":["\n",{"tag":"p","props":{},"children":["和对方分享生命中那些尴尬的时刻。"]},"\n"]},"\n",{"tag":"li","props":{},"children":["\n",{"tag":"p","props":{},"children":["你上次在别人面前哭是什么时候？自己哭呢？"]},"\n"]},"\n",{"tag":"li","props":{},"children":["\n",{"tag":"p","props":{},"children":["告诉对方，你已经喜欢上了他或她身上的什么品质。"]},"\n"]},"\n",{"tag":"li","props":{},"children":["\n",{"tag":"p","props":{},"children":["你觉得什么东西是严肃到不能开玩笑的，假如有的话。"]},"\n"]},"\n",{"tag":"li","props":{},"children":["\n",{"tag":"p","props":{},"children":["如果你今晚就将死去，而且没有机会同任何人联络，你会因为之前没有对别人说什么话而感到遗憾，你为什么到现在都没有对他们说这些话呢？"]},"\n"]},"\n",{"tag":"li","props":{},"children":["\n",{"tag":"p","props":{},"children":["假设你拥有的全部东西都在你的房子里，现在房子着了火，救出家人和宠物之后，你还有机会安全地冲进去最后一次，取出最后一件东西，你会拿什么，为什么？"]},"\n"]},"\n",{"tag":"li","props":{},"children":["\n",{"tag":"p","props":{},"children":["你的家人中，谁去世了会令你最难过，为什么？"]},"\n"]},"\n",{"tag":"li","props":{},"children":["\n",{"tag":"p","props":{},"children":["说出一件你的个人问题，问对方如果遇到此事要如何解决。另外，也要让对方如实告诉你，在他或她眼中，你对于这个问题的感受是怎样的。"]},"\n"]},"\n"]},"\n",{"tag":"h2","props":{"id":"研究说明了什么"},"children":["研究说明了什么"]},"\n",{"tag":"p","props":{},"children":[{"tag":"a","props":{"href":"https://doi.org/10.1177/0146167297234003","target":"_blank","rel":"noopener noreferrer"},"children":["Aron 等人 1997 年的原始研究"]},"比较了逐步深入的交谈任务和闲聊任务，前者带来的即时亲近感更高。这个结果不能证明两个人一定会相爱，也不能预测一段关系能维持多久。"]},"\n",{"tag":"p","props":{},"children":["把它当成一次认识对方的机会就够了。聊完觉得更亲近，可以继续交往；觉得不合适，也得到了一些有用的信息。不要把完成题单当成对方应该喜欢你、继续约会或回答更多问题的理由。"]},"\n",{"tag":"h2","props":{"id":"开始前用一句话说清楚"},"children":["开始前，用一句话说清楚"]},"\n",{"tag":"p","props":{},"children":["可以这样邀请：“想不想找个安静的地方，轮流聊几个问题？有不想答的题直接跳过，随时可以停。”"]},"\n",{"tag":"p","props":{},"children":["一起选个不容易被打断的时间。手机只用来查看题单，别一边回答一边看消息。第一次尝试，不必安排昂贵的餐厅或一整天的活动；找个双方都觉得自在的地方即可。"]},"\n",{"tag":"p","props":{},"children":["先约定不录音、不截图转发对方的回答。涉及第三个人时，少说姓名和能识别身份的细节。对方不愿意展开的话题，就停在那一句。"]},"\n",{"tag":"h2","props":{"id":"轮流回答别变成采访"},"children":["轮流回答，别变成采访"]},"\n",{"tag":"p","props":{},"children":["读一题，两个人分别回答，再换下一题。不要让一个人连续讲完、另一个人只负责提问。听到回答后，可以问：“你希望我只是听，还是也说说我的想法？”"]},"\n",{"tag":"p","props":{},"children":["想不出漂亮的答案时，讲一件具体的小事，比寻找标准答案更容易。比如，可以用这些本站原创问题试着开场："]},"\n",{"tag":"ul","props":{},"children":["\n",{"tag":"li","props":{},"children":["最近哪件普通的小事，让你觉得有人在认真听你说话？"]},"\n",{"tag":"li","props":{},"children":["如果一起安排一个不用花钱的周末，你希望我们把时间留给什么？"]},"\n",{"tag":"li","props":{},"children":["遇到意见不同时，你希望我先问你什么，而不是急着解释？"]},"\n"]},"\n",{"tag":"p","props":{},"children":["这些例子不是经典题单的节选，也不需要拿来评分。回答不同很正常，可以继续问“为什么这件事对你重要”，不用急着判断谁的想法更好。"]},"\n",{"tag":"h2","props":{"id":"感觉太深就退一步"},"children":["感觉太深，就退一步"]},"\n",{"tag":"p","props":{},"children":["题单越往后，越可能触及难过、家庭或关系中的经历。可以说“这题先跳过”“我只想说到这里”，也可以换回轻松的话题。跳过并不意味着不真诚，更不意味着关系出了问题。"]},"\n",{"tag":"p","props":{},"children":["如果一方明显不舒服，就先停止练习，问问对方现在需要什么。不要用计时、完成率或“都做到这里了”催促继续。一次舒服的谈话，比把所有题做完更重要。"]},"\n",{"tag":"h2","props":{"id":"聊完之后不急着下结论"},"children":["聊完之后，不急着下结论"]},"\n",{"tag":"p","props":{},"children":["各自说一句今天听到的新发现，再问“以后愿不愿意找个时间继续聊”。可以约一次普通的散步，也可以到此为止。当天的投入感，和长期相处中的尊重、可靠、是否合适，是不同的事。"]},"\n",{"tag":"p","props":{},"children":["如果改成先在网页里填写、再互相看答案，把它当作下一次谈话的准备。文字容易缺少语气和背景，看到不明白的回答，先询问，不要根据一句话给对方贴标签。异步填写的效果不能直接套用面对面研究的结果。"]},"\n",{"tag":"h2","props":{"id":"回到书里的对应建议"},"children":["回到书里的对应建议"]},"\n",{"tag":"p","props":{},"children":[{"tag":"a","props":{"href":"/book/10#10-05"},"children":["阅读条目 10-05：轮流回答由浅入深的问题"]},"。想进一步考虑关系中的成本和选择，可以继续读",{"tag":"a","props":{"href":"/articles/marriage"},"children":["结婚划不划算"]},"。"]},"\n"]},{"tag":"footer","props":{"className":"life-article-attribution"},"children":[{"tag"