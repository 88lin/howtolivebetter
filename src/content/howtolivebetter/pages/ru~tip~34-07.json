]},{"tag":"circle","props":{"cx":"12","cy":"10","r":"4"},"children":[]},{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},{"tag":"span","props":{},"children":["Войти"]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/ru/book/34"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"К содержанию"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["Домашние лекарства: как не навредить себе"]},{"tag":"nav","props":{"aria-label":"Советы главы"},"children":[{"tag":"a","props":{"href":"/ru/tip/34-01"},"children":[{"tag":"span","props":{},"children":["01"]},"Перед тем, как принимать два противопростудных или обезболивающих препарата одновременно, обязательно проверьте их состав: парацетамол должен входить только в один из них"]},{"tag":"a","props":{"href":"/ru/tip/34-02"},"children":[{"tag":"span","props":{},"children":["02"]},"Для детей при лихорадке не следует использовать аспирин, нимесулид и анальгин; противопростудные препараты, содержащие анальгин, также запрещены для несовершеннолетних"]},{"tag":"a","props":{"href":"/ru/tip/34-03"},"children":[{"tag":"span","props":{},"children":["03"]},"Людям старше 60 лет, у кого ранее были кровотечения в желудке и которые принимают антикоагулянты или гормоны, перед приёмом обезболивающих вроде ибупрофена следует проконсультироваться с врачом"]},{"tag":"a","props":{"href":"/ru/tip/34-04"},"children":[{"tag":"span","props":{},"children":["04"]},"Не давайте детям младше 2 лет комплексные противопростудные и отхаркивающие препараты без назначения врача"]},{"tag":"a","props":{"href":"/ru/tip/34-05"},"children":[{"tag":"span","props":{},"children":["05"]},"Беременность после 20-й недели: не принимайте ибупрофен и подобные обезболивающие самостоятельно"]},{"tag":"a","props":{"href":"/ru/tip/34-06"},"children":[{"tag":"span","props":{},"children":["06"]},"Самостоятельный прием омепразола при изжоге и отрыжке — не более 7 дней; при затрудненном глотании, рвоте с кровью или черном стуле — сразу к врачу"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/ru/tip/34-07","data-status":"active"},"children":[{"tag":"span","props":{},"children":["07"]},"При обычной простуде не стоит требовать от врача антибиотики"]},{"tag":"a","props":{"href":"/ru/tip/34-08"},"children":[{"tag":"span","props":{},"children":["08"]},"При диарее в первую очередь пейте раствор для пероральной регидратации; детям до 5 лет не давайте противодиарейные препараты"]},{"tag":"a","props":{"href":"/ru/tip/34-09"},"children":[{"tag":"span","props":{},"children":["09"]},"Не стоит принимать обезболивающие более 15 дней в месяц, а комбинированные препараты — более 10 дней; иначе головная боль может возникнуть именно из-за чрезмерного употребления лекарств"]},{"tag":"a","props":{"href":"/ru/tip/34-10"},"children":[{"tag":"span","props":{},"children":["10"]},"Регулярно убирайте просроченные и неиспользуемые лекарства; выбрасывайте их с упаковкой в контейнер для опасных отходов, а не дома «как попало»"]},{"tag":"a","props":{"href":"/ru/tip/34-11"},"children":[{"tag":"span","props":{},"children":["11"]},"На время приёма цефалоспоринов, метronidazola и похожих антибактериальных препаратов и ещё 7 дней после отмены не употребляйте алкоголь — в том числе этанол в пероральном растворе Huoxiang Zhengqi (藿香正气口服液) и в сиропах от кашля"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"Навигация"},"children":[{"tag":"a","props":{"href":"/ru/book"},"children":["Книга"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/ru/book/34"},"children":["Глава 34"," ·"," ","Домашние лекарства: как не навредить себе"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"34-07"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["07"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["Доказательства"," ","A"]}]},{"tag":"h1","props":{"lang":"ru"},"children":["При обычной простуде не стоит требовать от врача антибиотики"]},{"tag":"p","props":{"lang":"ru","className":"life-entry-summary"},"children":["При простуде антибиотики не помогают выздороветь быстрее, чем без них. У взрослых риск побочных эффектов при их приёме в два раза выше, чем без приёма. При гнойных выделениях из носа, длящихся менее 10 дней, антибиотики также не дают явной пользы."]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Затраты"]},{"tag":"p","props":{},"children":["Бесплатно, и даже позволяет сэкономить на лекарствах."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Польза"]},{"tag":"p","props":{},"children":["В систематическом обзоре Cochrane собраны данные по 6 рандомизированным исследованиям с участием 1147 человек.…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"Отметить: При обычной простуде не стоит требовать от врача антибиотики"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"Сделано"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"В планах"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"В избранное"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Поделиться советом"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Скрыть подробности"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Затраты"]},{"tag":"p","props":{},"children":["Бесплатно, и даже позволяет сэкономить на лекарствах."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Польза"]},{"tag":"p","props":{},"children":["В систематическом обзоре Cochrane собраны данные по 6 рандомизированным исследованиям с участием 1147 человек. При сравнении приёма антибиотиков и плацебо при простуде разница в доле невыздоровевших или с сохраняющимися симптомами оказалась незначительной (RR 0,83, 95% CI 0,60–1,14). Риск нежелательных реакций увеличивается в 1,8 раза по сравнению с плацебо (95% CI 1,01–3,21). Для взрослых этот показатель достигает 2,62 раза (1,32–5,18), а у детей он не повышается (0,91, 0,51–1,63). При остром гнойном рините с гнойными выделениями из носа менее 10 дней приём антибиотиков также не приносит явной пользы (RR 0,73, 0,47–1,13), однако риск побочных эффектов возрастает на 46% (RR 1,46, 1,10–1,94). Авторы обзора пришли к выводу, что в обоих случаях регулярный приём антибиотиков не рекомендуется."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Первоисточники"]},{"tag":"p","props":{"className":"life-citations"},"children":["Kenealy T, Arroll B (2025). Antibiotics for the common cold and acute purulent rhinitis. Cochrane Database of Systematic Reviews, 11:CD000247. ",{"tag":"a","props":{"href":"https://doi.org/10.1002/14651858.CD000247.pub4","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1002/14651858.CD000247.pub4"]}]},{"tag":"a","props":{"href":"https://doi.org/10.1002/14651858.CD000247.pub4","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Открыть источник"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Примечание автора"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["Данная версия обзора вышла в 2025 году; в аннотации указано, что поиск литературы проводился до 2013 года. В России антибиотики относятся к рецептурным препаратам, их продажа в аптеках возможна только по рецепту. Не стоит принимать оставшиеся дома антибиотики без назначения врача. Оценка эффекта как «средней» обусловлена тем, что он направлен на предотвращение побочных эффектов, а не на снижение смертности."]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Моя заметка"]},{"tag":"button","props":{"type":"button"},"children":["Запишите напоминание…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/ru/tip/34-06"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Предыдущий"]},"Самостоятельный прием омепразола при изжоге и отрыжке — не более 7 дней; при затрудненном глотании, рвоте с кровью или черном стуле — сразу к врачу"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/ru/tip/34-08"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Следующий"]},"При диарее в первую очередь пейте раствор для пероральной регидратации; детям до 5 лет не давайте противодиарейные препараты"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["Другие советы по этой теме"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/34-03"},"children":[{"tag":"strong","props":{},"children":["Людям старше 60 лет, у кого ранее были кровотечения в желудке и которые принимают антикоагулянты или гормоны, перед приёмом обезболивающих вроде ибупрофена следует проконсультироваться с врачом"]},{"tag":"span","props":{},"children":["Обезболивающие вроде ибупрофена, напроксена и аспирина могут негативн…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/34-04"},"children":[{"tag":"strong","props":{},"children":["Не давайте детям младше 2 лет комплексные противопростудные и отхаркивающие препараты без назначения врача"]},{"tag":"span","props":{},"children":["Государственное управление по контролю за лекарствами требует добавит…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/34-05"},"children":[{"tag":"strong","props":{},"children":["Беременность после 20-й недели: не принимайте ибупрофен и подобные обезболивающие самостоятельно"]},{"tag":"span","props":{},"children":["После 20-й недели беременности большая часть околоплодных вод образуе…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/34-09"},"children":[{"tag":"strong","props":{},"children":["Не стоит принимать обезболивающие более 15 дней в месяц, а комбинированные препараты — более 10 дней; иначе головная боль может возникнуть именно из-за чрезмерного употребления лекарств"]},{"tag":"span","props":{},"children":["Если регулярно принимать обезболивающие при частых головных болях, бо…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/34-10"},"children":[{"tag":"strong","props":{},"children":["Регулярно убирайте просроченные и неиспользуемые лекарства; выбрасывайте их с упаковкой в контейнер для опасных отходов, а 