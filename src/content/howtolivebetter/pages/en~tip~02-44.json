ildren":[]},{"tag":"path","props":{"d":"m6.34 17.66-1.41 1.41"},"children":[]},{"tag":"path","props":{"d":"m19.07 4.93-1.41 1.41"},"children":[]}]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"17","height":"17","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-moon life-theme-icon-dark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"},"children":[]}]}]},{"tag":"button","props":{"type":"button","className":"life-language-switch","aria-label":"English Choose language","aria-haspopup":"menu","aria-expanded":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-globe","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]},{"tag":"path","props":{"d":"M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"},"children":[]},{"tag":"path","props":{"d":"M2 12h20"},"children":[]}]},{"tag":"span","props":{},"children":["English"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]}]},{"tag":"a","props":{"className":"life-account","href":"/en/sign-in"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"17","height":"17","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle-user-round","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M18 20a6 6 0 0 0-12 0"},"children":[]},{"tag":"circle","props":{"cx":"12","cy":"10","r":"4"},"children":[]},{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},{"tag":"span","props":{},"children":["Sign in to sync"]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/en/book/02"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"Back to index"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["Don’t die slowly"]},{"tag":"nav","props":{"aria-label":"Chapter entries"},"children":[{"tag":"a","props":{"href":"/en/tip/02-01"},"children":[{"tag":"span","props":{},"children":["01"]},"Quit smoking—the earlier, the better"]},{"tag":"a","props":{"href":"/en/tip/02-02"},"children":[{"tag":"span","props":{},"children":["02"]},"Don’t smoke at home or in the car, and don’t let guests smoke indoors"]},{"tag":"a","props":{"href":"/en/tip/02-03"},"children":[{"tag":"span","props":{},"children":["03"]},"Don’t rely solely on willpower to quit smoking — get medication first: success rates more than double"]},{"tag":"a","props":{"href":"/en/tip/02-04"},"children":[{"tag":"span","props":{},"children":["04"]},"Pick a quit date and stop smoking on that day — don’t taper gradually"]},{"tag":"a","props":{"href":"/en/tip/02-05"},"children":[{"tag":"span","props":{},"children":["05"]},"Visit a smoking cessation clinic or call 12320 to find local services"]},{"tag":"a","props":{"href":"/en/tip/02-06"},"children":[{"tag":"span","props":{},"children":["06"]},"Only consider e‑cigarettes if you’ve already tried quitting; non‑smokers should avoid them"]},{"tag":"a","props":{"href":"/en/tip/02-07"},"children":[{"tag":"span","props":{},"children":["07"]},"Not drinking sugary drinks — even switching to sugar-free ones doesn’t help"]},{"tag":"a","props":{"href":"/en/tip/02-08"},"children":[{"tag":"span","props":{},"children":["08"]},"Not chewing betel nut"]},{"tag":"a","props":{"href":"/en/tip/02-09"},"children":[{"tag":"span","props":{},"children":["09"]},"Switch household salt to low‑sodium (potassium‑rich) salt"]},{"tag":"a","props":{"href":"/en/tip/02-10"},"children":[{"tag":"span","props":{},"children":["10"]},"Brush teeth thoroughly and floss daily; replace missing teeth promptly"]},{"tag":"a","props":{"href":"/en/tip/02-11"},"children":[{"tag":"span","props":{},"children":["11"]},"Walking 7,000–8,000 steps per day, or accumulating 150–300 minutes of brisk walking each week"]},{"tag":"a","props":{"href":"/en/tip/02-12"},"children":[{"tag":"span","props":{},"children":["12"]},"People with hypertension and high cholesterol should take their medication regularly as prescribed; never stop on their own"]},{"tag":"a","props":{"href":"/en/tip/02-13"},"children":[{"tag":"span","props":{},"children":["13"]},"Getting about 7 hours of sleep each night with a consistent schedule"]},{"tag":"a","props":{"href":"/en/tip/02-14"},"children":[{"tag":"span","props":{},"children":["14"]},"Regularly play racket sports such as tennis, badminton or table tennis"]},{"tag":"a","props":{"href":"/en/tip/02-15"},"children":[{"tag":"span","props":{},"children":["15"]},"Accumulating brief bouts of strenuous activity like stair climbing or brisk walking to total 4–5 minutes per day"]},{"tag":"a","props":{"href":"/en/tip/02-16"},"children":[{"tag":"span","props":{},"children":["16"]},"30–60 minutes of strength training per week"]},{"tag":"a","props":{"href":"/en/tip/02-17"},"children":[{"tag":"span","props":{},"children":["17"]},"Don’t sit for too long at a time — get up and move every now and then"]},{"tag":"a","props":{"href":"/en/tip/02-18"},"children":[{"tag":"span","props":{},"children":["18"]},"Eat less processed meat (ham, bacon, sausages, luncheon meat)"]},{"tag":"a","props":{"href":"/en/tip/02-19"},"children":[{"tag":"span","props":{},"children":["19"]},"Drink less or no alcohol"]},{"tag":"a","props":{"href":"/en/tip/02-20"},"children":[{"tag":"span","props":{},"children":["20"]},"People who drink daily and experience tremors and palpitations when they stop should not try to quit on their own"]},{"tag":"a","props":{"href":"/en/tip/02-21"},"children":[{"tag":"span","props":{},"children":["21"]},"To drink less, first tally how much you drink each week, then chat briefly with a doctor"]},{"tag":"a","props":{"href":"/en/tip/02-22"},"children":[{"tag":"span","props":{},"children":["22"]},"Eating a small handful of nuts daily"]},{"tag":"a","props":{"href":"/en/tip/02-23"},"children":[{"tag":"span","props":{},"children":["23"]},"Swapping some red meat for fish or poultry"]},{"tag":"a","props":{"href":"/en/tip/02-24"},"children":[{"tag":"span","props":{},"children":["24"]},"Swap some refined rice and flour for whole grains"]},{"tag":"a","props":{"href":"/en/tip/02-25"},"children":[{"tag":"span","props":{},"children":["25"]},"Drinking tea more than three times a week"]},{"tag":"a","props":{"href":"/en/tip/02-26"},"children":[{"tag":"span","props":{},"children":["26"]},"Drinking three to four cups of coffee daily, without sugar or cream"]},{"tag":"a","props":{"href":"/en/tip/02-27"},"children":[{"tag":"span","props":{},"children":["27"]},"Eating 5 servings (about 400 g) of fruits and vegetables daily"]},{"tag":"a","props":{"href":"/en/tip/02-28"},"children":[{"tag":"span","props":{},"children":["28"]},"Eat fewer ultra-processed foods (chips, instant noodles, pastries, ready meals)"]},{"tag":"a","props":{"href":"/en/tip/02-29"},"children":[{"tag":"span","props":{},"children":["29"]},"Switching from coal and wood to electricity or gas for cooking and heating"]},{"tag":"a","props":{"href":"/en/tip/02-30"},"children":[{"tag":"span","props":{},"children":["30"]},"Let hot drinks cool down before drinking; avoid tea, soup, and coffee that are piping hot"]},{"tag":"a","props":{"href":"/en/tip/02-31"},"children":[{"tag":"span","props":{},"children":["31"]},"Getting some sun during the day — don’t stay out of the light all the time"]},{"tag":"a","props":{"href":"/en/tip/02-32"},"children":[{"tag":"span","props":{},"children":["32"]},"Keeping BMI between 20–25; losing weight if overweight"]},{"tag":"a","props":{"href":"/en/tip/02-33"},"children":[{"tag":"span","props":{},"children":["33"]},"Eating chili peppers four or more times per week"]},{"tag":"a","props":{"href":"/en/tip/02-34"},"children":[{"tag":"span","props":{},"children":["34"]},"Drinking one or two servings of milk or yogurt daily"]},{"tag":"a","props":{"href":"/en/tip/02-35"},"children":[{"tag":"span","props":{},"children":["35"]},"Eggs need not be avoided, but don’t eat three or four daily"]},{"tag":"a","props":{"href":"/en/tip/02-36"},"children":[{"tag":"span","props":{},"children":["36"]},"Take baths whenever you can — don’t limit yourself to showers"]},{"tag":"a","props":{"href":"/en/tip/02-37"},"children":[{"tag":"span","props":{},"children":["37"]},"Keep naps under 30 minutes—no longer than an hour. If you regularly need a one- or two-hour nap to get through the day, it’s time to see a doctor"]},{"tag":"a","props":{"href":"/en/tip/02-38"},"children":[{"tag":"span","props":{},"children":["38"]},"Catch up on sleep the night after a sleepless night — don’t wait until the weekend"]},{"tag":"a","props":{"href":"/en/tip/02-39"},"children":[{"tag":"span","props":{},"children":["39"]},"The longer you work night shifts, the higher your cardiovascular risk — switch if you can"]},{"tag":"a","props":{"href":"/en/tip/02-40"},"children":[{"tag":"span","props":{},"children":["40"]},"Buy pre-packaged cooking oil with an SC code; avoid bulk, unregulated homemade peanut oil"]},{"tag":"a","props":{"href":"/en/tip/02-41"},"children":[{"tag":"span","props":{},"children":["41"]},"Replacing lard and butter with vegetable oils for cooking: you don’t need to switch oils for health reasons, nor should you expect flaxseed oil to protect your heart"]},{"tag":"a","props":{"href":"/en/tip/02-42"},"children":[{"tag":"span","props":{},"children":["42"]},"Turn on the range hood while stir-frying and deep-frying, from the moment you light the stove until the cooking is done"]},{"tag":"a","props":{"href":"/en/tip/02-43"},"children":[{"tag":"span","props":{},"children":["43"]},"If hot flashes and night sweats around menopause disrupt your life, see a gynecologist to assess hormone therapy; do not just endure them or buy medication yourself, and do not use it to prevent heart disease"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/en/tip/02-44","data-status":"active"},"children":[{"tag":"span","props":{},"children":["44"]},"If you already wanted a dog, count the daily walk toward your steps — don’t get a dog just for longevity"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"Breadcrumb"},"children":[{"tag":"a","props":{"href":"/en/book"},"children":["Explore the book"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/en/book/02"},"children":["Chapter 2"," ·"," ","Don’t die slowly"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"02-44"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["44"]},{"tag":"span","props":{"className":"life-evidence grade-b"},"children":["Evidence"," ","B"]}]},{"tag":"h1","props":{"lang":"en"},"children":["If you already wanted a dog, count the daily walk toward your steps — don’t get a dog just for longevity"]},{"tag":"p","props":{"lang":"en","className":"life-entry-summary"},"children":["Dog owners are on average about a quarter less likely to die over the same period, and those who keep a dog after a heart attack or stroke do even better. But once other differences are accounted for, large studies in the UK and Norway see no difference, and owning a cat shows no link either. So don’t get a dog just for longevity; if you already wanted one, count the daily walk as walking."]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Cost"]},{"tag":"p","props":{},"children":["Keeping a dog is an ongoing expense: food, vaccines, dewor…"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Benefit"]},{"tag":"p","props":{},"children":["Pooling 10 observational follow-up studies covering about 3,840,000 people, followed for an average of 10.1 ye…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"Mark: If you already wanted a dog, count the daily walk toward your steps — don’t get a dog just for longevity"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"Done"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"Plan to do"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"Save"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Share this tip"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Hide details"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Cost"]},{"tag":"p","props":{},"children":["Keeping a dog is an ongoing expense: food, vaccines, deworming, vet bills and registration all have to be paid, for as long as the dog lives. You also have to find time to walk it every day and arrange care when you travel. The hard part is doing it every single day; once you have a dog you can’t just stop. China has no official statistic on what a dog costs, so no figure is given here."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Benefit"]},{"tag":"p","props":{},"children":["Pooling 10 observational follow-up studies covering about 3,840,000 people, followed for an average of 10.1 years, dog owners had about 24% lower death risk (RR 0.76, 95% CI 0.67–0.86). Cardiovascular death was about 31% lower (RR 0.69, 0.67–0.71). Among people who had had coronary heart disease, those with a dog at home were about 65% lower (RR 0.35, 0.17–0.69). The authors state that this pooled estimate was not adjusted for other factors. A Swedish nationwide register study of about 3,430,000 people adjusted for income, marital status and the like. Among people living alone, dog owners had about 33% lower death risk (HR 0.67, 0.65–0.69); among those living with others, about 11% lower (HR 0.89, 0.87–0.91). Among Swedish heart-attack patients, those living alone with a dog had about 33% lower death risk (HR 0.67, 0.61–0.75), and those living with a partner or children about 15% lower (HR 0.85, 0.80–0.90). After ischemic stroke the figures were about 27% lower (HR 0.73, 0.66–0.80) and about 12% lower (HR 0.88, 0.83–0.93) respectively. Counter-evidence: in a UK pooled analysis of 6 health surveys with 59,352 people, followed for an average of 11.5 years, dog ownership showed no link with death after full adjustment (HR 1.03, 0.98–1.09), nor with cardiovascular death (HR 1.07, 0.96–1.18). A Norwegian study with a median follow-up of 18.5 years found virtually the same death risk for dog owners (HR 1.00, 0.91–1.09), and dog owners there were no more active than others. In the Swedish twin register, among 34,202 people who could be asked about lifestyle, the link between dog ownership and lower cardiovascular disease and death risk could not be reproduced. An Australian study of 15,735 people followed for 4 years found dog owners’ death risk about 23% lower (OR 0.77, 0.59–0.99), part of which could be explained by more physical activity. Owning a cat, bird or fish showed no link with death. The American Heart Association’s 2013 statement says that pet ownership, especially dog ownership, “may be reasonable” for lowering cardiovascular risk, the weakest tier of recommendation. The same statement explicitly advises against adopting, rescuing or buying a pet mainly to lower cardiovascular risk."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Original sources"]},{"tag":"p","props":{"className":"life-citations"},"children":["Kramer CK, Mehmood S, Suen RS (2019). Dog ownership and survival: a systematic review and meta-analysis. Circulation: Cardiovascular Quality and Outcomes, 12(10), e005554. ",{"tag":"a","props":{"href":"https://doi.org/10.1161/CIRCOUTCOMES.119.005554","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1161/CIRCOUTCOMES.119.005554"]},"；Mubanga M, Byberg L, Nowak C, 等 (2017). Dog ownership and the risk of cardiovascular disease and death – a nationwide cohort study. Scientific Reports, 7, 15821. ",{"tag":"a","props":{"href":"https://doi.org/10.1038/s41598-017-16118-6","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1038/s41598-017-16118-6"]},"；Mubanga M, Byberg L, Egenvall A, Ingelsson E, Fall T (2019). Dog ownership and survival after a major cardiovascular event: a register-based prospective study. Circulation: Cardiovascular Quality and Outcomes, 12(10), e005342. ",{"tag":"a","props":{"href":"https://doi.org/10.1161/CIRCOUTCOMES.118.005342","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1161/CIRCOUTCOMES.118.005342"]},"；Ding D, Bauman AE, Sherrington C, 等 (2018). Dog ownership and mortality in England: a pooled analysis of six population-based cohorts. American Journal of Preventive Medicine, 54(2), 289-293. ",{"tag":"a","props":{"href":"https://doi.org/10.1016/j.amepre.2017.09.012","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1016/j.amepre.2017.09.012"]},"；Torske MO, Krokstad S, Stamatakis E, Bauman A (2017). Dog ownership and all-cause mortality in a population cohort in Norway: the HUNT study. PLoS ONE, 12(6), e0179832. ",{"tag":"a","props":{"href":"https://doi.org/10.1371/journal.pone.0179832","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1371/journal.pone.0179832"]},"；Taniguchi Y, Ikeuchi T, Yong J (2024). Dog, cat, bird, fish, and other pet ownership and mortality: evidence from the HILDA cohort. PLoS ONE, 19(8), e0305546. ",{"tag":"a","props":{"href":"https://doi.org/10.1371/journal.pone.0305546","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1371/journal.pone.0305546"]},"；Mubanga M, Byberg L, Egenvall A, 等 (2019). Dog ownership and cardiovascular risk factors: a nationwide prospective register-based cohort study. BMJ Open, 9(3), e023447. ",{"tag":"a","props":{"href":"https://doi.org/10.1136/bmjopen-2018-023447","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1136/bmjopen-2018-023447"]},"；Levine GN, Allen K, Braun LT, 等 (2013). Pet ownership and cardiovascular risk: a scientific statement from the American Heart Association. Circulation, 127(23), 2353-2363. ",{"tag":"a","props":{"href":"https://doi.org/10.1161/CIR.0b013e31829201e1","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1161/CIR.0b013e31829201e1"]}]},{"tag":"a","props":{"href":"https://doi.org/10.1161/CIRCOUTCOMES.119.005554","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Open source link"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Book note"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["Contested. Everything above is observational follow-up with no randomized groups, so it cannot support “get a dog for longevity.” People who keep dogs may already be healthier and more active, and people who are ill or disabled may be less likely to keep one; these differences cannot be fully removed. The pooled 24% was not adjusted for anything, and in the studies that could ask about lifestyle the difference disappeared. In another Swedish study, dog owners were slightly more likely to start blood pressure or lipid drugs, so even if the death risk really is lower, it is not because blood pressure or lipids came down. The one actionable point: if you already have a dog or were going to get one, count the daily walk toward your steps; for how much is enough, see Section 2, item 11 (7,000–8,000 steps a day). Leashes, vaccination and liability when a dog bites are covered in Section 8, item 30 (dogs must be leashed). For how older relatives should hold the leash to avoid falls, see Section 17, item 10 (older people walking dogs). The benefit size is set to large mechanically from the pooled 24%, but that figure is unadjusted. The main beneficiary of this item is you."]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["My note"]},{"tag":"button","props":{"type":"button"},"children":["Write a reminder for yourself…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/en/tip/02-43"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Previous"]},"If hot flashes and night sweats around menopause disrupt your life, see a gynecologist to assess hormone therapy; do not just endure them or buy medication yourself, and do not use it to prevent heart disease"]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"c