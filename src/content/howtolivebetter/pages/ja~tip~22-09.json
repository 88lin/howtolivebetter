atus":"active"},"children":[{"tag":"span","props":{},"children":["09"]},"「定期的に人と会うこと」を健康への投資と考えよう。気分が落ち込んでいる時だけ人に頼るのではなく"]},{"tag":"a","props":{"href":"/ja/tip/22-10"},"children":[{"tag":"span","props":{},"children":["10"]},"住まいを選ぶときは周辺の緑地を考慮する。ただし「公園に多く行けば」寿命が延びるとは期待しない"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"現在地"},"children":[{"tag":"a","props":{"href":"/ja/book"},"children":["本を読む"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/ja/book/22"},"children":["第22章"," ·"," ","リラックスする方法：娯楽施設とストレス解消"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"22-09"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["09"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["エビデンス"," ","A"]}]},{"tag":"h1","props":{"lang":"ja"},"children":["「定期的に人と会うこと」を健康への投資と考えよう。気分が落ち込んでいる時だけ人に頼るのではなく"]},{"tag":"p","props":{"lang":"ja","className":"life-entry-summary"},"children":["普段あまり人と交流がない人は、同時期における死亡率が約3割高い。孤独を感じる人は約4分の1、独居の人は約3割高く、65 歳以下ではその傾向がより顕著である。これらは追跡調査によって明らかになったもので、もともと健康状態が悪い人が独居になりやすいという可能性もある。"]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["費用・手間"]},{"tag":"p","props":{},"children":["多少の費用と、会うための時間が必要になる。難しいのは、気分が良い時でも自ら積極的に誘わなければならない点だ。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["効果"]},{"tag":"p","props":{},"children":["これは 70 項の研究（メタ分析）を統合して算出した結果であり、合計 340 万人の参加者を対象に、平均 7 年間追跡したものである。"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"記録する：「定期的に人と会うこと」を健康への投資と考えよう。気分が落ち込んでいる時だけ人に頼るのではなく"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"できている"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"やることに追加"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"お気に入り"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"このヒントを共有"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"詳細を閉じる"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["費用・手間"]},{"tag":"p","props":{},"children":["多少の費用と、会うための時間が必要になる。難しいのは、気分が良い時でも自ら積極的に誘わなければならない点だ。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["効果"]},{"tag":"p","props":{},"children":["これは 70 項の研究（メタ分析）を統合して算出した結果であり、合計 340 万人の参加者を対象に、平均 7 年間追跡したものである。社会的孤立、孤独感、独居はいずれも死亡率の上昇と関連している。年齢や身体状況などの交絡因子を除去した後の、加重平均ハザード比はそれぞれ、社会的孤立が 1.29、孤独が 1.26、独居が 1.32 である。これに換算すると、同時期の死亡確率はそれぞれ約3割、約4分の1、約3割高くなる。3つの効果の大きさはほぼ同等であり、さらに 65 歳以下の層では、高齢者層よりもその傾向が大きかった。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["出典"]},{"tag":"p","props":{"className":"life-citations"},"children":["Holt-Lunstad J, Smith TB, Baker M, Harris T, Stephenson D (2015). Loneliness and social isolation as risk factors for mortality: a meta-analytic review. Perspectives on Psychological Science, 10(2), 227-237. ",{"tag":"a","props":{"href":"https://doi.org/10.1177/1745691614568352","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1177/1745691614568352"]}]},{"tag":"a","props":{"href":"https://doi.org/10.1177/1745691614568352","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["出典を開く"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["著者の注記"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["議論の余地あり。これらは集団を追跡して得られた相関関係であり、ランダム化比較試験ではないため、因果関係の特定はできていない。もともと健康状態が悪い人ほど、独居になりやすく、社交も少ない可能性がある。著者は社会的なつながりを、喫煙や肥満と同じレベルの健康要因として捉えているが、「社交を増やすことが死亡率を低下させる」ことを証明したランダム化試験は存在しない。この内容は、第 3 節の「自分を消耗させる人間関係を減らす」という内容と矛盾しない。あちらは自分を消耗させる関係を断ち切ることであり、こちらは自分に活力を与えてくれる関係を維持することである。"]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["自分のメモ"]},{"tag":"button","props":{"type":"button"},"children":["自分へのメモを書く…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"c