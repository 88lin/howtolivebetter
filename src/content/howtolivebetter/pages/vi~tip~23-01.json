ound","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M18 20a6 6 0 0 0-12 0"},"children":[]},{"tag":"circle","props":{"cx":"12","cy":"10","r":"4"},"children":[]},{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},{"tag":"span","props":{},"children":["Đăng nhập để đồng bộ hóa"]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/vi/book/23"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"Quay lại mục lục"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["Học kỹ năng nào thì đáng"]},{"tag":"nav","props":{"aria-label":"Các mục trong chương"},"children":[{"tag":"a","props":{"aria-current":"page","className":"active","href":"/vi/tip/23-01","data-status":"active"},"children":[{"tag":"span","props":{},"children":["01"]},"Dưới 16 tuổi không có lựa chọn「đi làm công ăn」: đơn vị thuê bạn bị phạt 5000 tệ mỗi tháng, đơn vị nào vẫn thuê thì là việc chui"]},{"tag":"a","props":{"href":"/vi/tip/23-02"},"children":[{"tag":"span","props":{},"children":["02"]},"Cũng đưa「học có ích không」vào bảng tính tỷ lệ tử vong: mỗi thêm một năm học, nguy cơ tử vong ở người lớn giảm khoảng 1.9%"]},{"tag":"a","props":{"href":"/vi/tip/23-03"},"children":[{"tag":"span","props":{},"children":["03"]},"Trước khi kết luận «học vấn có mất giá không», xem cơ cấu học vấn cả nước: mỗi 100000 người chỉ có 15467 người có trình độ đại học (tổng điều tra 2020, ước tính từ mẫu 2025 khoảng 19%)"]},{"tag":"a","props":{"href":"/vi/tip/23-04"},"children":[{"tag":"span","props":{},"children":["04"]},"Trường hợp「không đủ tiền để đi học」thì tính theo chính sách trước đã: học phí trường trung cấp chuyên nghiệp đã miễn phần lớn, học bổng 2300 tệ, học vay tối đa 2 vạn tệ một năm"]},{"tag":"a","props":{"href":"/vi/tip/23-05"},"children":[{"tag":"span","props":{},"children":["05"]},"Không đỗ được trường phổ thông không phải là hết đường: trường trung cấp chuyên nghiệp có tuyển sinh liên thông và thi riêng, tuyển dụng lao động kỹ thuật còn được hạ yêu cầu học vấn"]},{"tag":"a","props":{"href":"/vi/tip/23-06"},"children":[{"tag":"span","props":{},"children":["06"]},"Biến câu hỏi「học hay đi làm」thành một bài toán: ba năm lương kiếm sớm nhờ đi làm trước, đổi lấy chênh lệch thu nhập mỗi năm của mấy chục năm sau nhờ học tiếp"]},{"tag":"a","props":{"href":"/vi/tip/23-07"},"children":[{"tag":"span","props":{},"children":["07"]},"Ghi trước đường cơ sở: một năm học thêm, mức hoàn lại tư nhân trung bình toàn cầu (phần rơi vào thu nhập của chính mình) khoảng 9% mỗi năm"]},{"tag":"a","props":{"href":"/vi/tip/23-08"},"children":[{"tag":"span","props":{},"children":["08"]},"Trước khi trả tiền thi chứng chỉ, kiểm tra chứng chỉ đó có trong Danh mục chứng chỉ nghề nghiệp quốc gia hoặc trong danh sách cơ quan đánh giá đã đăng ký với Bộ Nhân sự và Xã hội không"]},{"tag":"a","props":{"href":"/vi/tip/23-09"},"children":[{"tag":"span","props":{},"children":["09"]},"Đào tạo nên đi qua kênh trợ cấp của nhà nước trước, đừng vừa học vừa tự bỏ tiền đăng lớp thương mại"]},{"tag":"a","props":{"href":"/vi/tip/23-10"},"children":[{"tag":"span","props":{},"children":["10"]},"Khi chọn kỹ năng, xem trước cái「có phải làm bằng tay, có phải phán đoán tại chỗ không」, loại này khó bị tự động hoá thay nhất"]},{"tag":"a","props":{"href":"/vi/tip/23-11"},"children":[{"tag":"span","props":{},"children":["11"]},"Trước khi học, xác nhận kỹ năng này có đánh giá theo cấp bậc không, cấp bậc có đổi ra tiền được không"]},{"tag":"a","props":{"href":"/vi/tip/23-12"},"children":[{"tag":"span","props":{},"children":["12"]},"Đừng coi「trên mạng nói lương cao」là thiếu người, hãy tra danh mục nghề khan hiếm và danh mục trợ cấp tại địa phương"]},{"tag":"a","props":{"href":"/vi/tip/23-13"},"children":[{"tag":"span","props":{},"children":["13"]},"Với cùng số tiền và thời gian, ưu tiên chương trình ngắn hạn học xong là vào việc được ngay"]},{"tag":"a","props":{"href":"/vi/tip/23-14"},"children":[{"tag":"span","props":{},"children":["14"]},"Học xong thì đóng sách lại tự kiểm một lượt, đừng đọc lại từ đầu"]},{"tag":"a","props":{"href":"/vi/tip/23-15"},"children":[{"tag":"span","props":{},"children":["15"]},"Chia cùng thời gian đó ra mấy ngày, đừng học một lạch xong"]},{"tag":"a","props":{"href":"/vi/tip/23-16"},"children":[{"tag":"span","props":{},"children":["16"]},"Đừng coi gạch chân, đọc lại, viết tóm tắt là cách học chính"]},{"tag":"a","props":{"href":"/vi/tip/23-17"},"children":[{"tag":"span","props":{},"children":["17"]},"Luyện xen kẽ nhiều dạng bài, đừng làm liên hai mươi bài cùng một dạng"]},{"tag":"a","props":{"href":"/vi/tip/23-18"},"children":[{"tag":"span","props":{},"children":["18"]},"Đừng chọn cách học theo kiểu「tôi là người học bằng mắt, người kia là người học bằng tai」"]},{"tag":"a","props":{"href":"/vi/tip/23-19"},"children":[{"tag":"span","props":{},"children":["19"]},"Muốn học thuộc, hãy ra đề theo cách dùng về sau rồi tự kiểm tra, đừng chỉ đọc thuộc một lượt là xong"]},{"tag":"a","props":{"href":"/vi/tip/23-20"},"children":[{"tag":"span","props":{},"children":["20"]},"Xét chức danh nghề nghiệp: trước hết xem mình thuộc chuyên môn nào, bậc nào, rồi tìm cửa đăng ký theo tính chất đơn vị"]},{"tag":"a","props":{"href":"/vi/tip/23-21"},"children":[{"tag":"span","props":{},"children":["21"]},"Chức danh sơ cấp, trung cấp ở kế toán thì lấy bằng kỳ thi thống nhất toàn quốc, đăng ký theo trình độ học vấn và số năm làm việc"]},{"tag":"a","props":{"href":"/vi/tip/23-22"},"children":[{"tag":"span","props":{},"children":["22"]},"Đừng nhờ trung gian xét thay, đừng mua dịch vụ viết thay luận án, đừng làm giả hồ sơ: bị phát hiện thì huỷ chức danh và lưu hồ sơ lưu tín 3 năm"]},{"tag":"a","props":{"href":"/vi/tip/23-23"},"children":[{"tag":"span","props":{},"children":["23"]},"Có chức danh nghề nghiệp không có nghĩa lương tăng: trước hết hỏi rõ đơn vị xét theo tỷ lệ vị trí, hay xét rồi chưa chắc dùng"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"Breadcrumbs"},"children":[{"tag":"a","props":{"href":"/vi/book"},"children":["Khám phá cuốn sách"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/vi/book/23"},"children":["Chương 23"," ·"," ","Học kỹ năng nào thì đáng"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"23-01"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["01"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["Bằng chứng"," ","A"]}]},{"tag":"h1","props":{"lang":"vi"},"children":["Dưới 16 tuổi không có lựa chọn「đi làm công ăn」: đơn vị thuê bạn bị phạt 5000 tệ mỗi tháng, đơn vị nào vẫn thuê thì là việc chui"]},{"tag":"p","props":{"lang":"vi","className":"life-entry-summary"},"children":["Học xong phổ thông cơ sở thường là 15 đến 16 tuổi, vừa nằm ngay trên ranh giới này. Dưới 16 tuổi mà đơn vị thuê bạn là vi phạm pháp, mỗi lao động trẻ em dùng một người bị phạt 5000 tệ mỗi tháng. Nên đơn vị nào vẫn lấy bạn là đơn vị biết rõ vi phạm mà vẫn dùng. Lỡ có chuyện thì tiền khám chữa và tiền bồi thường chỉ có thể đòi chính đơn vị đó, nó cố không trả hoặc bỏ chạy thì không ai đứng ra đỡ thay."]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Chi phí"]},{"tag":"p","props":{},"children":["K