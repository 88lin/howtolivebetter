"},"children":[]},{"tag":"path","props":{"d":"M20 12h2"},"children":[]},{"tag":"path","props":{"d":"m6.34 17.66-1.41 1.41"},"children":[]},{"tag":"path","props":{"d":"m19.07 4.93-1.41 1.41"},"children":[]}]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"17","height":"17","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-moon life-theme-icon-dark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"},"children":[]}]}]},{"tag":"button","props":{"type":"button","className":"life-language-switch","aria-label":"Tiếng Việt Chọn ngôn ngữ","aria-haspopup":"menu","aria-expanded":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-globe","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]},{"tag":"path","props":{"d":"M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"},"children":[]},{"tag":"path","props":{"d":"M2 12h20"},"children":[]}]},{"tag":"span","props":{},"children":["Tiếng Việt"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]}]},{"tag":"a","props":{"className":"life-account","href":"/vi/sign-in"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"17","height":"17","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle-user-round","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M18 20a6 6 0 0 0-12 0"},"children":[]},{"tag":"circle","props":{"cx":"12","cy":"10","r":"4"},"children":[]},{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},{"tag":"span","props":{},"children":["Đăng nhập để đồng bộ hóa"]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/vi/book/05"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"Quay lại mục lục"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["Đừng phí tiền"]},{"tag":"nav","props":{"aria-label":"Các mục trong chương"},"children":[{"tag":"a","props":{"href":"/vi/tip/05-01"},"children":[{"tag":"span","props":{},"children":["01"]},"Tắt hết tự động gia hạn, đến hạn thì tự gia hạn"]},{"tag":"a","props":{"href":"/vi/tip/05-02"},"children":[{"tag":"span","props":{},"children":["02"]},"Mỗi năm từ tháng Ba đến tháng Sáu làm một lần tổng kết thuế thu nhập cá nhân, khai đủ các khoản trừ bổ sung chuyên ngành"]},{"tag":"a","props":{"href":"/vi/tip/05-03"},"children":[{"tag":"span","props":{},"children":["03"]},"Quỹ tích góp nhà ở không chỉ dùng để mua nhà: thuê nhà, sửa sang, phí quản lý nhà ở đều rút được, từ ngày 20 tháng 9 năm 2026 áp dụng quy định mới"]},{"tag":"a","props":{"href":"/vi/tip/05-04"},"children":[{"tag":"span","props":{},"children":["04"]},"Mỗi năm tính lại gói điện thoại và băng thông một lần, không dùng tới thì hạ bậc, nhà mạng không chuyển được thì khiếu nại"]},{"tag":"a","props":{"href":"/vi/tip/05-05"},"children":[{"tag":"span","props":{},"children":["05"]},"Không mua xổ số"]},{"tag":"a","props":{"href":"/vi/tip/05-06"},"children":[{"tag":"span","props":{},"children":["06"]},"Thấy「高收益」「保本」「稳赚」thì đi luôn"]},{"tag":"a","props":{"href":"/vi/tip/05-07"},"children":[{"tag":"span","props":{},"children":["07"]},"Không dùng khoản trả tối thiểu trên thẻ tín dụng, không mở trả góp hay vay tiêu dùng để mua; nếu thật sự cần vay, hãy đổi lãi suất thành lãi suất năm rồi so sánh"]},{"tag":"a","props":{"href":"/vi/tip/05-08"},"children":[{"tag":"span","props":{},"children":["08"]},"Không tặng thưởng người livestream, không nạp tiền vào game, không đặt hàng bốc đầu"]},{"tag":"a","props":{"href":"/vi/tip/05-09"},"children":[{"tag":"span","props":{},"children":["09"]},"Con nạp tiền, tặng thưởng trên điện thoại: khoản chi lớn của trẻ từ tám tuổi trở lên, cha mẹ không chấp thuận thì có thể đòi lại"]},{"tag":"a","props":{"href":"/vi/tip/05-10"},"children":[{"tag":"span","props":{},"children":["10"]},"Dạy trẻ nhớ một câu: bất cứ ai bảo trẻ cầm điện thoại của cha mẹ ra thao tác, hoặc đọc mã xác minh, đều là kẻ lừa"]},{"tag":"a","props":{"href":"/vi/tip/05-11"},"children":[{"tag":"span","props":{},"children":["11"]},"Từ chối gói bảo hành mở rộng (延保) cho thiết bị điện tử"]},{"tag":"a","props":{"href":"/vi/tip/05-12"},"children":[{"tag":"span","props":{},"children":["12"]},"Ưu tiên thuốc generic đã đạt đánh giá tính nhất quán và thuốc trong gói đấu thầu tập trung"]},{"tag":"a","props":{"href":"/vi/tip/05-13"},"children":[{"tag":"span","props":{},"children":["13"]},"Làm một lần liên kết dùng chung tài khoản trên app bảo hiểm y tế, tiền trong tài khoản cá nhân của bảo hiểm y tế người lao động dùng được cho vợ chồng, cha mẹ, con cái"]},{"tag":"a","props":{"href":"/vi/tip/05-14"},"children":[{"tag":"span","props":{},"children":["14"]},"Uống nước máy đun sôi, không đặt nước bình cho máy nước hay mua nước chai quanh năm"]},{"tag":"a","props":{"href":"/vi/tip/05-15"},"children":[{"tag":"span","props":{},"children":["15"]},"Đừng giao dịch cổ phiếu liên tục, thị trường lên rầm rộ rồi đổ sập thì càng phải ít ra tay hơn"]},{"tag":"a","props":{"href":"/vi/tip/05-16"},"children":[{"tag":"span","props":{},"children":["16"]},"Không vay tiền để đầu tư, không dùng đòn bẩy, không mua thứ mình không hiểu"]},{"tag":"a","props":{"href":"/vi/tip/05-17"},"children":[{"tag":"span","props":{},"children":["17"]},"Thay quỹ quản lý chủ động bằng quỹ chỉ số phạm vi rộng cho phần giữ dài hạn"]},{"tag":"a","props":{"href":"/vi/tip/05-18"},"children":[{"tag":"span","props":{},"children":["18"]},"Cùng một loại quỹ thì chọn quỹ có mức phí thấp"]},{"tag":"a","props":{"href":"/vi/tip/05-19"},"children":[{"tag":"span","props":{},"children":["19"]},"Đừng đặt hết tiền vào một cổ phiếu, một nền tảng, một căn nhà"]},{"tag":"a","props":{"href":"/vi/tip/05-20"},"children":[{"tag":"span","props":{},"children":["20"]},"Người nộp thuế thu nhập cá nhân và thuế suất đạt 10% trở lên mở tài khoản lương hưu cá nhân, mỗi năm tối đa 12.000 nhân dân tệ được khấu trừ trước thuế; người không nộp thuế hoặc thuế suất chỉ có 3% mở là không đáng"]},{"tag":"a","props":{"href":"/vi/tip/05-21"},"children":[{"tag":"span","props":{},"children":["21"]},"Phòng tập thì trả theo lượt hoặc theo chu kỳ ngắn, trừ khi bạn đã có hơn một năm đi đều đặn"]},{"tag":"a","props":{"href":"/vi/tip/05-22"},"children":[{"tag":"span","props":{},"children":["22"]},"Trả tiền trước phải ký hợp đồng bằng văn bản; người bán có rủi ro phải ngừng nhận tiền, trước khi bỏ chạy bạn có quyền đòi lại số dư chưa tiêu"]},{"tag":"a","props":{"href":"/vi/tip/05-23"},"children":[{"tag":"span","props":{},"children":["23"]},"Món mua lớn không thiết yếu thì đặt thời gian chờ, mua hàng trên mạng thì dùng luôn quyền trả hàng trong bảy ngày không cần lý do"]},{"tag":"a","props":{"href":"/vi/tip/05-24"},"children":[{"tag":"span","props":{},"children":["24"]},"Đừng tích trữ hàng vì giá gạch chéo và đợt khuyến mãi lớn"]},{"tag":"a","props":{"href":"/vi/tip/05-25"},"children":[{"tag":"span","props":{},"children":["25"]},"Bảo hiểm thì mua loại chỉ bảo vệ trước, coi「hoàn tiền」「chia lợi nhuận」là phần không được bảo đảm"]},{"tag":"a","props":{"href":"/vi/tip/05-26"},"children":[{"tag":"span","props":{},"children":["26"]},"Mua đủ bảo hiểm trách nhiệm dân sự bên thứ ba: hạn mức bảo hiểm bắt buộc thống nhất toàn quốc và không cao, phần vượt ra do túi bạn trả"]},{"tag":"a","props":{"href":"/vi/tip/05-27"},"children":[{"tag":"span","props":{},"children":["27"]},"Để dành trước khoản dự phòng bằng 3 đến 6 tháng chi phí, đặt ở chỗ rút ra được bất cứ lúc nào"]},{"tag":"a","props":{"href":"/vi/tip/05-28"},"children":[{"tag":"span","props":{},"children":["28"]},"Trước khi trả nợ vay mua nhà sớm, làm một bài so sánh, đừng theo cảm tính"]},{"tag":"a","props":{"href":"/vi/tip/05-29"},"children":[{"tag":"span","props":{},"children":["29"]},"Mua hàng trên mạng thì nhìn quy tắc của nền tảng và luật, không nghe người livestream, không tin「đánh giá tốt」"]},{"tag":"a","props":{"href":"/vi/tip/05-30"},"children":[{"tag":"span","props":{},"children":["30"]},"Hàng mua trong livestream có vấn đề, trước hết yêu cầu nền tảng cung cấp thông tin người bán và người livestream, nền tảng phải cung cấp"]},{"tag":"a","props":{"href":"/vi/tip/05-31"},"children":[{"tag":"span","props":{},"children":["31"]},"Mua phải thực phẩm không an toàn: ngoài hoàn tiền còn đòi được mười lần giá, khoản bồi thường thêm dưới một nghìn tệ thì tính bằng một nghìn tệ"]},{"tag":"a","props":{"href":"/vi/tip/05-32"},"children":[{"tag":"span","props":{},"children":["32"]},"Mua món đồ lớn thì tra thông báo kiểm tra mẫu quốc gia, chứng nhận 3C và nhãn tiết kiệm năng lượng trước"]},{"tag":"a","props":{"href":"/vi/tip/05-33"},"children":[{"tag":"span","props":{},"children":["33"]},"Vòng tay đá, ngọc, đồng hồ, đồ chơi thời trang: tính theo「số tiền đã tiêu」, không tính theo「số tiền để dành」"]},{"tag":"a","props":{"href":"/vi/tip/05-34"},"children":[{"tag":"span","props":{},"children":["34"]},"Ngọc và đá quý chỉ nhận báo cáo kiểm nghiệm có nhãn CMA, và tra cơ quan cấp giấy trên trang chính thức của cơ quan đó"]},{"tag":"a","props":{"href":"/vi/tip/05-35"},"children":[{"tag":"span","props":{},"children":["35"]},"Hộp mù, bài bốc ngẫu nhiên: tính theo「số tiền này sẽ không quay lại」"]},{"tag":"a","props":{"href":"/vi/tip/05-36"},"children":[{"tag":"span","props":{},"children":["36"]},"Quan tâm thực phẩm có thêm gì thì mua loại đóng gói sẵn: quầy hàng bán lẻ không bắt buộc ghi bảng thành phần"]},{"tag":"a","props":{"href":"/vi/tip/05-37"},"children":[{"tag":"span","props":{},"children":["37"]},"Cổ phiếu lỗ cũng phải bán theo quy tắc định trước, đừng trông chờ mua thêm để hạ giá vốn mà lật lời"]},{"tag":"a","props":{"href":"/vi/tip/05-38"},"children":[{"tag":"span","props":{},"children":["38"]},"Muốn mua tài sản nước ngoài như cổ phiếu Mỹ thì đi qua quỹ QDII hoặc kênh Hồng Kông, đừng mở tài khoản ở công ty chứng khoán nước ngoài, cũng đừng dùng hạn mức đổi tiền hằng năm để mua"]},{"tag":"a","props":{"href":"/vi/tip/05-39"},"children":[{"tag":"span","props":{},"children":["39"]},"Chỉ mua bảo hiểm cho loại tổn thất mà bạn không gánh nổi, tổn thất gánh nổi thì để khoản dự phòng đỡ"]},{"tag":"a","props":{"href":"/vi/tip/05-40"},"children":[{"tag":"span","props":{},"children":["40"]},"Nhà có người sống dựa vào thu nhập của bạn thì mua bảo hiểm nhân thọ có thời hạn cho người kiếm tiền trước, đừng mua cho con trước"]},{"tag":"a","props":{"href":"/vi/tip/05-41"},"children":[{"tag":"span","props":{},"children":["41"]},"Ký bảo hiểm nhân thọ trên một năm rồi hối hận, hủy trong thời hạn cân nhắc, tiền phí trả lại gần hết"]},{"tag":"a","props":{"href":"/vi/tip/05-42"},"children":[{"tag":"span","props":{},"children":["42"]},"Trước khi ký ở quầy ngân hàng, nhìn rõ trong tay là tiền gửi hay bảo hiểm"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/vi/tip/05-43","data-status":"active"},"children":[{"tag":"span","props":{},"children":["43"]},"Muốn hủy bảo hiểm thì tự tìm công ty bảo hiểm làm, đừng tìm「đại lý hủy bảo hiểm」, nghĩ là mình bị hiểu sai rồi thì gọi 12378 khiếu nại"]},{"tag":"a","props":{"href":"/vi/tip/05-44"},"children":[{"tag":"span","props":{},"children":["44"]},"Ghi người thụ hưởng là một người cụ thể trên hợp đồng bảo hiểm, có chuyện thì nhớ đi nhận tiền: bảo hiểm nhân thọ trong 5 năm, bảo hiểm khác trong 2 năm phải thực hiện yêu cầu"]},{"tag":"a","props":{"href":"/vi/tip/05-45"},"children":[{"tag":"span","props":{},"children":["45"]},"Đừng bỏ tiền mua Bitcoin, Tether hay tiền mã hóa khác, người rủ đầu tư cũng đừng theo: giao dịch không được luật bảo vệ, lỗ rồi kiện cũng không đòi lại được"]},{"tag":"a","props":{"href":"/vi/tip/05-46"},"children":[{"tag":"span","props":{},"children":["46"]},"Không có đơn vị sử dụng lao động mà tự đóng bảo hiểm hưu trí người lao động: đóng mức thấp nhất và đủ số năm trước là có lợi nhất; không phải cứ đóng là có lời, ngay mức thấp nhất cũng phải nhận lương hưu khoảng 10 năm mới hoàn vốn"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"Breadcrumbs"},"children":[{"tag":"a","props":{"href":"/vi/book"},"children":["Khám phá cuốn sách"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/vi/book/05"},"children":["Chương 5"," ·"," ","Đừng phí tiền"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"05-43"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["43"]},{"tag":"span","props":{"className":"life-evidence grade-b"},"children":["Bằng chứng"," ","B"]}]},{"tag":"h1","props":{"lang":"vi"},"children":["Muốn hủy bảo hiểm thì tự tìm công ty bảo hiểm làm, đừng tìm「đại lý hủy bảo hiểm」, nghĩ là mình bị hiểu sai rồi thì gọi 12378 khiếu nại"]},{"tag":"p","props":{"lang":"vi","className":"life-entry-summary"},"children":["Mấy quảng cáo trên mạng rao「hủy bảo hiểm trọn vẹn, không thành công không thu phí」đa phần là đại lý hủy bảo hiểm trái phép. Họ lấy ba đến năm phần mười số tiền hủy bảo hiểm trả lại, còn đòi cả giấy tờ tùy thân, thẻ ngân hàng và mã xác minh của bạn. Hủy bảo hiểm xong thì sự bảo đảm cũng mất. Nghĩ là mình bị hiểu sai, trước hết gọi khách hàng của công ty bảo hiểm, không nói chuyện được thì gọi 12378, toàn bộ miễn phí."]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Chi phí"]},{"tag":"p","props":{},"children":["Không tốn tiền. Tự gọi đường dây khách hàng của công ty bả…"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Lợi ích"]},{"tag":"p","props":{},"children":["Tháng 2 năm 2026, Cục Tài chính và Ngân hàng, Văn phòng Xây dựng mạng thông tin Trung Quốc, Bộ Công an, Ngân h…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"Đánh dấu: Muốn hủy bảo hiểm thì tự tìm công ty bảo hiểm làm, đừng tìm「đại lý hủy bảo hiểm」, nghĩ là mình bị hiểu sai rồi thì gọi 12378 khiếu nại"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"Hoàn tất"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"Kế hoạch thực hiện"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"Lưu"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Chia sẻ mẹo này"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Ẩn chi tiết"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Chi phí"]},{"tag":"p","props":{},"children":["Không tốn tiền. Tự gọi đường dây khách hàng của công ty bảo hiểm hoặc ra quầy, chỉ phải đi thêm một hai chuyến so với giao cho môi giới."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Lợi ích"]},{"tag":"p","props":{},"children":["Tháng 2 năm 2026, Cục Tài chính và Ngân hàng, Văn phòng Xây dựng mạng thông tin Trung Quốc, Bộ Công an, Ngân hàng Nhân dân Trung Quốc và Ủy ban Chứng khoán Trung Quốc cùng ban hành cảnh báo rủi ro. Cảnh báo nói các câu như「hủy bảo hiểm trọn vẹn」là thông tin sai, không khớp với Luật Bảo hiểm và các quy phạm khác. Người làm「đòi quyền qua đại lý」thu phí dịch vụ cao, bạn muốn dừng giữa chừng còn có thể phải ra tòa vì「vi phạm hợp đồng」. Họ còn thu thập thẻ SIM, thẻ ngân hàng, hợp đồng bảo hiểm, nơi ở, trường học của con bạn. Những thông tin đó bán lại, bạn có thể dính lừa đảo qua điện thoại và mất tiền do gian lận. Cảnh báo tháng 6 năm 2026 của Cục Giám sát Tài chính Ninh Hạ viết chi tiết hơn. Loại môi giới này thỏa thuận thu phí đại lý từ 30% đến 50% số tiền hủy bảo hiểm, làm nửa chừng thì phải nộp phạt vi phạm cao. Họ còn dạy người ta bịa lý do như bị tư vấn sai, bị ký hộ để khiếu nại. Người làm theo có thể vi phạm Luật xử phạt quản lý trật tự công cộng, trường hợp nặng còn có thể bị tình nghi cùng tham gia vu khống, ép bức tống tiền. Hủy bảo hiểm xong thì trách nhiệm bảo hiểm chấm dứt ngay. Sau này mua lại loại bảo hiểm tương tự có thể bị tăng giá hoặc từ chối bán vì lớn tuổi hơn hoặc khám ra vấn đề sức khoẻ. Bị hiểu sai thật thì trước hết khiếu nại trao đổi với khách hàng chính thức của công ty bảo hiểm, không nói chuyện được thì gọi 12378, đường dây khiếu nại và bảo vệ quyền lợi cho người tiêu dùng ngân hàng và bảo hiểm, toàn bộ miễn phí. Chỉ là tạm thời không đủ tiền đóng thì hỏi công ty bảo hiểm có làm được dịch vụ giảm mức bảo hiểm còn phí, vay bằng hợp đồng bảo hiểm hay không. Giảm mức bảo hiểm còn phí nghĩa là sau này không phải đóng tiền nữa, mức bảo hiểm giảm theo tỷ lệ (toàn quốc, năm 2026)"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Nguồn gốc"]},{"tag":"p","props":{"className":"life-citations"},"children":["金融监管总局、中央网信办、公安部、中国人民银行、中国证监会 (2026-02-06). 关于警惕不法「代理维权」短视频及直播陷阱的风险提示（中央网信办官网转载）. ",{"tag":"a","props":{"href":"https://www.cac.gov.cn/2026-02/06/c_1772110875635198.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.cac.gov.cn/2026-02/06/c_1772110875635198.htm"]},"；宁夏金融监管局 (2026-06-16). 关于防范非法代理退保的风险提示. ",{"tag":"a","props":{"href":"https://www.nfra.gov.cn/branch/ningxia/view/pages/common/ItemDetail.html?docId=1261442&itemId=2188","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.nfra.gov.cn/branch/ningxia/view/pages/common/ItemDetail.html?docId=1261442&itemId=2188"]},"；湖南金融监管局 (2025-07-23). 关于防范非法「代理退保」黑灰产的风险提示. ",{"tag":"a","props":{"href":"https://www.nfra.gov.cn/branch/hunan/view/pages/common/ItemDetail.html?docId=1218753&itemId=1480","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.nfra.gov.cn/branch/hunan/view/pages/common/ItemDetail.html?docId=1218753&itemId=1480"]}]},{"tag":"a","props":{"h