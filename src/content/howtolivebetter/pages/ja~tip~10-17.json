,"props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},{"tag":"span","props":{},"children":["ログイン"]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/ja/book/10"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"目次に戻る"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["恋愛と結婚は損か得か"]},{"tag":"nav","props":{"aria-label":"この章のヒント"},"children":[{"tag":"a","props":{"href":"/ja/tip/10-01"},"children":[{"tag":"span","props":{},"children":["01"]},"一人に執着せず、より多くの人と出会う：二人の相性は会う前には予測できない"]},{"tag":"a","props":{"href":"/ja/tip/10-02"},"children":[{"tag":"span","props":{},"children":["02"]},"相手から明確に拒絶されたら止めること。つきまといは「誠意」ではなく、治安違反である"]},{"tag":"a","props":{"href":"/ja/tip/10-03"},"children":[{"tag":"span","props":{},"children":["03"]},"相手の興味を判断するには、「サイン」ではなく「行動」を見る：誰が主導し、誰が段取りし、誰がフォローするか"]},{"tag":"a","props":{"href":"/ja/tip/10-04"},"children":[{"tag":"span","props":{},"children":["04"]},"関係が良いかどうかは、相手の条件ではなく、あなた自身がその関係の中でどう感じているか次第である"]},{"tag":"a","props":{"href":"/ja/tip/10-05"},"children":[{"tag":"span","props":{},"children":["05"]},"距離を縮めたいなら、テクニックではなく、段階的に深まる質問に交互に答えること"]},{"tag":"a","props":{"href":"/ja/tip/10-06"},"children":[{"tag":"span","props":{},"children":["06"]},"遠距離恋愛は近距離より悪いわけではない。大きな壁は一緒に暮らし始めてからの3か月"]},{"tag":"a","props":{"href":"/ja/tip/10-07"},"children":[{"tag":"span","props":{},"children":["07"]},"まずは登録データを確認してから年長者の話を聞く：婚姻率と離婚率の算出基準の違い"]},{"tag":"a","props":{"href":"/ja/tip/10-08"},"children":[{"tag":"span","props":{},"children":["08"]},"結婚の健康上の利益も計算に入れる。ただし観察データとして割り引いて考える"]},{"tag":"a","props":{"href":"/ja/tip/10-09"},"children":[{"tag":"span","props":{},"children":["09"]},"時間の計算は「無償労働」として算出し、役割分担を明確にしてから婚姻届を出す"]},{"tag":"a","props":{"href":"/ja/tip/10-10"},"children":[{"tag":"span","props":{},"children":["10"]},"結婚のお金の問題は、まず法律の標準ルールを確認し、書面での合意が必要かを決める"]},{"tag":"a","props":{"href":"/ja/tip/10-11"},"children":[{"tag":"span","props":{},"children":["11"]},"親が住宅購入資金を出す場合、送金時に「借入」か「贈与」かを明確に記載しておく"]},{"tag":"a","props":{"href":"/ja/tip/10-12"},"children":[{"tag":"span","props":{},"children":["12"]},"配偶者が一方的に多額の借金をした場合、あなたが署名せず、かつ追認もしていなければ、自動的にあなたの債務にはなりません"]},{"tag":"a","props":{"href":"/ja/tip/10-13"},"children":[{"tag":"span","props":{},"children":["13"]},"婚姻届出は身分証と署名済みの申告書だけで可能。戸籍簿不要、費用無料、その場で交付"]},{"tag":"a","props":{"href":"/ja/tip/10-14"},"children":[{"tag":"span","props":{},"children":["14"]},"結婚前に一度結婚前検査を受け、重大な疾患がある場合は必ず登録前に相手に真実を伝えなければならない"]},{"tag":"a","props":{"href":"/ja/tip/10-15"},"children":[{"tag":"span","props":{},"children":["15"]},"離脱コストを計算する：協議離婚には 30 日の冷静期があり、裁判離婚には法定条件がある"]},{"tag":"a","props":{"href":"/ja/tip/10-16"},"children":[{"tag":"span","props":{},"children":["16"]},"「親世代のための結婚」には別途勘定を立て、自分の勘定と混ぜないこと"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/ja/tip/10-17","data-status":"active"},"children":[{"tag":"span","props":{},"children":["17"]},"人間関係の良し悪しを健康の計算に入れておく：喧嘩は事柄に対して行い、人格を否定しない。罵倒や皮肉は避けること"]},{"tag":"a","props":{"href":"/ja/tip/10-18"},"children":[{"tag":"span","props":{},"children":["18"]},"同性パートナーは、二人が意識がはっきりしているうちに、委任状、任意後見、および遺言を作成しておくべき：法律上、あなたたちは近親者ではないため、作成しなければ署名権も相続権もありません"]},{"tag":"a","props":{"href":"/ja/tip/10-19"},"children":[{"tag":"span","props":{},"children":["19"]},"性的指向を隠して結婚しないで、偽装結婚を「手間の省ける方法」とも思わないこと：法律上、それは真の婚姻であり、解消したい場合は離婚の手続きを踏むしかない"]},{"tag":"a","props":{"href":"/ja/tip/10-20"},"children":[{"tag":"span","props":{},"children":["20"]},"関係が繰り返される喧嘩や冷戦で停滞しているなら、二人でカップルセラピーを受けるべきです：ただ待っているだけでは、自然に良くなることは基本的にはありません"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"現在地"},"children":[{"tag":"a","props":{"href":"/ja/book"},"children":["本を読む"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/ja/book/10"},"children":["第10章"," ·"," ","恋愛と結婚は損か得か"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"10-17"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["17"]},{"tag":"span","props":{"className":"life-evidence grade-b"},"children":["エビデンス"," ","B"]}]},{"tag":"h1","props":{"lang":"ja"},"children":["人間関係の良し悪しを健康の計算に入れておく：喧嘩は事柄に対して行い、人格を否定しない。罵倒や皮肉は避けること"]},{"tag":"p","props":{"lang":"ja","className":"life-entry-summary"},"children":["夫婦関係が良いと、健康状態がより良く、死亡リスクも低くなります。この関連性は、食事と健康の関連性と同程度に、それほど大きくはありません。ある実験では、喧嘩の際に常に敵意を抱いている夫婦は、穏やかな夫婦と比較して、実験で作られた小さな傷の治癒速度が6割にとどまりました。"]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["費用・手間"]},{"tag":"p","props":{},"children":["費用はかかりません。喧嘩をする際は、目の前の事柄についてのみ話し、人を罵らず、皮肉を言わず、過去の蒸し返しをしないこ…"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["効果"]},{"tag":"p","props":{},"children":["126件の研究、7.2万人以上のデータを統合して算出した結果（メタ分析）によれば、婚姻の質が高いほど健康状態も良く、相関係数 r は .07 から .21 の間にあります。"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"記録する：人間関係の良し悪しを健康の計算に入れておく：喧嘩は事柄に対して行い、人格を否定しない。罵倒や皮肉は避けること"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"できている"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"やることに追加"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"お気に入り"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"このヒントを共有"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"詳細を閉じる"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["費用・手間"]},{"tag":"p","props":{},"children":["費用はかかりません。喧嘩をする際は、目の前の事柄についてのみ話し、人を罵らず、皮肉を言わず、過去の蒸し返しをしないこと。難しいのは、感情が高ぶっている時に口を慎むことです。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["効果"]},{"tag":"p","props":{},"children":["126件の研究、7.2万人以上のデータを統合して算出した結果（メタ分析）によれば、婚姻の質が高いほど健康状態も良く、相関係数 r は .07 から .21 の間にあります。相関係数 0 は無関係、1 は完全な同期を意味します。そのうち、死亡リスクの低さとより関連しているものは r = .11 です。喧嘩の際の心血管反応はより小さく、r = -.13 です。著者は、これらの効果は小さく、食事などの健康習慣と健康の関連性と同程度であると述べています。別のクロスオーバー実験では、健康な夫婦42組がそれぞれ2回、各24時間の入院を行いました。1回は互いに支え合う会話を行い、もう1回は意見の分かれる事柄について議論しました。議論の後、実験で作られた水疱状の傷の治癒はより遅くなりました。両方の場面でより強い敵意を示した夫婦は、敵意の低い夫婦の60%の傷の治癒速度でした。喧嘩の翌朝、彼らの血液中の炎症指標（IL-6、腫瘍壊死因子）もより高く上昇しました。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["出典"]},{"tag":"p","props":{"className":"life-citations"},"children":["Robles TF, Slatcher RB, Trombello JM, McGinn MM (2014). Marital quality and health: a meta-analytic review. Psychological Bulletin. ",{"tag":"a","props":{"href":"https://doi.org/10.1037/a0031859","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1037/a0031859"]},"；Kiecolt-Glaser JK 等 (2005). Hostile marital interactions, proinflammatory cytokine production, and wound healing. Archives of General Psychiatry. ",{"tag":"a","props":{"href":"https://doi.org/10.1001/archpsyc.62.12.1377","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1001/archpsyc.62.12.1377"]}]},{"tag":"a","props":{"href":"https://doi.org/10.1037/a0031859","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["出典を開く"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["著者の注記"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["B（低確信度）とした理由：集計された研究の多くは追跡記録のみであり、対照群を用いた比較が行われていません。そのため、関係の悪さが病気を引き起こしたのか、健康状態の悪化が関係を悪化させたのかを区別できません。年齢や収入を調整した後でも、関連性が残る研究もあります。Roblesの原文には、一部の結果に出版バイアスがあることも明記されています。男女を明確に比較した研究では、基本的に男女差は見られませんでした。本節では「関係の悪い婚姻」と「未婚」の死亡率を直接比較した集計分析は見つからなかったため、「悪い婚姻は未婚よりも体に悪い」とは推論の域を出ません。傷の実験は42組の夫婦のみを対象としています。「事柄に対して行い、人を罵らず皮肉を言わない」という手法は、著者が実験内の「敵意ある行動」から導き出した方法であり、直接比較した研究はありません。激しく喧嘩しても改善されない場合は、二人でカップルセラピーを受けてください（本節第 20 条：カップルセラピーを参照）。喧嘩が暴力に発展したり、長期的な罵倒や脅迫があったりする場合は、コミュニケーションの問題ではなく家庭内暴力（DV）です（第 8 節 第 43 条：DVを受けた場合を参照）。離れるべきかどうかを考える際は、離脱コストについては本節第 15 条（離脱コスト）を参照してください。"]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["自分のメモ"]},{"tag":"button","props":{"type":"button"},"children":["自分へのメモを書く…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/ja/tip/10-16"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["前へ"]},"「親世代のための結婚」には別途勘定を立て、自分の勘定と混ぜないこと"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/ja/tip/10-18"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["次へ"]},"同性パートナーは、二人が意識がはっきりしているうちに、委任状、任意後見、および遺言を作成しておくべき：法律上、あなたたちは近親者ではないため、作成しなければ署名権も相続権もありません"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["このテーマの他の提案"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"hr