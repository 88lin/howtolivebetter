tag":"a","props":{"href":"/ja/tip/26-09"},"children":[{"tag":"span","props":{},"children":["09"]},"権利侵害の通知を受けた際は速やかに処理すること。異議申し立ての転送後、15日以内に進展がなければ復旧させる"]},{"tag":"a","props":{"href":"/ja/tip/26-10"},"children":[{"tag":"span","props":{},"children":["10"]},"ユーザー情報は安易に国外へ持ち出さないでください。国外への持ち出しには法的な条件と人数制限があります"]},{"tag":"a","props":{"href":"/ja/tip/26-11"},"children":[{"tag":"span","props":{},"children":["11"]},"サーバー選びは、まずダウンタイムに耐えられるか、次に運用担当者がいるかを確認し、最後に価格を比較すること"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"現在地"},"children":[{"tag":"a","props":{"href":"/ja/book"},"children":["本を読む"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/ja/book/26"},"children":["第26章"," ·"," ","ウェブサイトやプラットフォームの構築：資格、届出、サーバー"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"26-04"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["04"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["エビデンス"," ","A"]}]},{"tag":"h1","props":{"lang":"ja"},"children":["サーバーを国内に置く場合は备案（届出）が必要であり、接続事業者は自ら付加価値通信許可を保有していなければならない"]},{"tag":"p","props":{"lang":"ja","className":"life-entry-summary"},"children":["サーバーを国内に置く場合、サイト開設前に备案（届出）を行う必要があります。备案に費用はかからず、サーバーと一緒にサービスプロバイダーを通じて申請し、通常は数日から数週間かかります。备案を行っていない場合は、期限内の是正を命じられ、さらに 1 万元の罰金が科せられ、是正されない場合はサイトの閉鎖に至ります。ホームページに备案番号を掲示していない場合、別途 5000 元から 5 万元の罰金が科せられます。"]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["費用・手間"]},{"tag":"p","props":{},"children":["备案に費用はかかりません。サーバーと一緒にサービスプロキダーを通じて申請し、通常は数日から数週間待ちます。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["効果"]},{"tag":"p","props":{},"children":["法規の原文は「未登録の場合、中華人民共和国の領域内において非営利目的のインターネット情報サービスに従事しては