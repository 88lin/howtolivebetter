de-faq","aria-labelledby":"checkup-faq-title"},"children":[{"tag":"h2","props":{"id":"checkup-faq-title"},"children":["关于人生体检的常见问题"]},{"tag":"details","props":{},"children":[{"tag":"summary","props":{},"children":["需要注册或付费吗？"]},{"tag":"p","props":{},"children":["不需要。体检、查看结果和加入待做都可以直接使用，记录保存在当前浏览器；登录后可以在多台设备之间同步清单。"]}]},{"tag":"details","props":{},"children":[{"tag":"summary","props":{},"children":["我的回答会上传吗？"]},{"tag":"p","props":{},"children":["不会。回答只保存在本机浏览器，用于下次打开时显示上次的结果。分享出去的链接也不包含你的回答。"]}]},{"tag":"details","props":{},"children":[{"tag":"summary","props":{},"children":["结果是怎么算出来的？"]},{"tag":"p","props":{},"children":["每个回答会提高相关主题的权重，再结合原书标注的收益大小、花费、时间和毅力，以及原书在每个主题里的排序来打分。这是一套透明的挑选规则，不是个性化的医疗、法律或理财建议。"]}]},{"tag":"details","props":{},"children":[{"tag":"summary","props":{},"children":["为什么有的建议和我关系不大？"]},{"tag":"p","props":{},"children":["体检只问了 5 个问题，覆盖不了所有情况。不适合的条目直接跳过即可，也可以在全书里按主题和证据等级继续挑选。"]}]},{"tag":"details","props":{},"children":[{"tag":"summary","props":{},"children":["多久做一次比较好？"]},{"tag":"p","props":{},"children":["生活阶段变化时重做一次就好，比如换工作、搬家、有了孩子。已经做到的建议会被跳过，结果会换上下一批值得做的事。"]}]}]}]}]},{"tag":"nav","props":{"className":"life-tabbar","aria-label":"主导航"},"children":[{"tag":"a","props":{"className":"","href":"/book"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"21","height":"21","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-book-open","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M12 7v14"},"children":[]},{"tag":"path","props":{"d":"M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z"},"children":[]}]},{"tag":"span","props":{},"children":["全书"]}]},{"tag":"a","props":{"className":"","href":"/top-50"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"21","height":"21","viewBox":"0 0 24 24","fill":"non