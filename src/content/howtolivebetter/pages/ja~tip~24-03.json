fe-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["費用・手間"]},{"tag":"p","props":{},"children":["費用はかかりなせん。紹介受診の手続きという、もう一つの工程が必要になります。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["効果"]},{"tag":"p","props":{},"children":["緊密型医療連合体（医聯体）の主導病院は、基層からの紹介患者のために一定割合の予約枠と病床を確保し、基層から紹介された患者をタイムリーに診療しなければなりません。緊密型医療連合体とは、いくつかの病院とコミュニティ衛生機関が連携して構成される組織群のことです。したがって、コミュニティから紹介される場合は、ロビーで予約を争う人たちとは別に、専用の枠と病床が用意されています。医療機関は紹介センターを設置するか、固定の部門を指定し、2027 年までに全カバーを実現する必要があります。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["出典"]},{"tag":"p","props":{"className":"life-citations"},"children":["国务院办公厅 (2026). 关于加快建设分级诊疗体系的若干措施. ",{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/202604/content_7065031.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/zhengce/zhengceku/202604/content_7065031.htm"]},"：「牵头医院要为基层医疗卫生机构预留一定比例的号源和床位，并及时接诊经基层转诊患者。」「医疗机构要强化转诊服务统一管理，设立转诊中心或指定固定部门承担患者转诊服务工作，到2027年实现全覆盖。」"]},{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/202604/content_7065031.htm","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["出典を開く"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["著者の注記"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["確保された予約枠は、紹介患者のために特別に用意されたものです。予約が取れない場合は、紹介受診の手続きを利用できます。予約転売業者を探すことは、高価であるだけでなく、不適切な診療科に割り当てられるリスクもあります。紹介センターが見つからない場合は、病院のサービス窓口へ電話して問い合わせてください。"]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["自分のメモ"]},{"tag":"button","props":{"type":"button"},"children":["自分へのメモを書く…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/ja/tip/24-02"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["前へ"]},"同一の統籌地区（医療保険加入地）内では、医療機関のレベルが低いほど払い戻し率が高くなり、その差は約 10 パーセントポイントです"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/ja/tip/24-04"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["次へ"]},"省外での他地域受診の前に、まずは地元の病院に相談を。必要性の判断は原則として副主任医師（副教授級）以上による評価が必要です"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["このテーマの他の提案"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/24-01"},"children":[{"tag":"strong","props":{},"children":["一般的な疾患はまずコミュニティ（地域医療機関）で受診し、基層医療から段階的に紹介受診することで、入院自己負担額（免責額）の継続計算が可能になります"]},{"tag":"span","props":{},"children":["まずコミュニティを受診し、そこから大病院へ紹介されて入院する場合、最初に自己負担した金額は一度として計算されます。自分自身で直接三級病院へ…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/24-05"},"children":[{"tag":"strong","props":{},"children":["診察が終わるたびに、診療録、検査報告書、画像資料のコピーを自分で保管しましょう"]},{"tag":"span","props":{},"children":["自身の診療録を閲覧・複製することは、法律で認められたあなたの権利です。外来診療録、入院記録、検査結果、画像、手術および麻酔の記録、病理資料…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/24-06"},"children":[{"tag":"strong","props":{},"children":["診療内容に疑問がある場合は、その場で診療録の封印（封存）を要求しましょう。双方立ち会いのもと、リストを作成し、各自が1部ずつ保管します"]},{"tag":"span","props":{},"children":["治療に疑問がある場合は、診療録を封印（封存）するよう要求することができます。封印には医師と患者の双方が立ち会い、リストを作成し、署名・捺印…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/24-07"},"children":[{"tag":"strong","props":{},"children":["緊急・重症の負傷者は、受付窓口で並ばず、直接救急のトリアージデスクへ向かうこと"]},{"tag":"span","props":{},"children":["救急外来は先着順ではなく、病状の重症度に応じて4段階に分類されます。判定が行われるのは、救急入口のトリアージデスクであり、受付窓口ではあり…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/24-08"},"children":[{"tag":"strong","props":{},"children":["お金がない、身分証がない、自分が誰か説明できない場合でも、救急は必ず優先して救命しなければならない"]},{"tag":"span","props":{},"children":["国には疾病応急救助基金があり、以下の2種類の人の救急費用を専門に支払います：身元が特定できない人と、支払う能力がない人です。病院は救命を拒…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/24-09"},"children":[{"tag":"strong","props":{},"children":["後遺障害の等級判定は治療終了後に行うこと。早すぎると等級が低くなる可能性がある"]},{"tag":"span","props":{},"children":["賠償額は主にどの等級に判定されるかで決まり、等級は治療終了後にどれだけの機能障害が残っているかで決まります。基準には、治療の終了後、または…"]}]}]}]},{"tag":"a","props":{"className":"life-text-link","href":"/ja/book/24"},"children":["テーマ全体を読む：通院ガイド：費用と手間を最小限に抑える方法"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"15","he