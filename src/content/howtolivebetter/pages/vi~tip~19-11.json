 12h2"},"children":[]},{"tag":"path","props":{"d":"M20 12h2"},"children":[]},{"tag":"path","props":{"d":"m6.34 17.66-1.41 1.41"},"children":[]},{"tag":"path","props":{"d":"m19.07 4.93-1.41 1.41"},"children":[]}]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"17","height":"17","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-moon life-theme-icon-dark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"},"children":[]}]}]},{"tag":"button","props":{"type":"button","className":"life-language-switch","aria-label":"Tiếng Việt Chọn ngôn ngữ","aria-haspopup":"menu","aria-expanded":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-globe","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]},{"tag":"path","props":{"d":"M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"},"children":[]},{"tag":"path","props":{"d":"M2 12h20"},"children":[]}]},{"tag":"span","props":{},"children":["Tiếng Việt"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]}]},{"tag":"a","props":{"className":"life-account","href":"/vi/sign-in"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"17","height":"17","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle-user-round","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M18 20a6 6 0 0 0-12 0"},"children":[]},{"tag":"circle","props":{"cx":"12","cy":"10","r":"4"},"children":[]},{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},{"tag":"span","props":{},"children":["Đăng nhập để đồng bộ hóa"]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/vi/book/19"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"Quay lại mục lục"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["Đi làm, nghỉ việc và tai nạn lao động"]},{"tag":"nav","props":{"aria-label":"Các mục trong chương"},"children":[{"tag":"a","props":{"href":"/vi/tip/19-01"},"children":[{"tag":"span","props":{},"children":["01"]},"Tiền làm thêm giờ tính theo ba mức 1.5 lần, 2 lần, 3 lần; không trả thì báo thanh tra lao động, quá hạn không trả còn phải cộng thêm 50% đến 100%"]},{"tag":"a","props":{"href":"/vi/tip/19-02"},"children":[{"tag":"span","props":{},"children":["02"]},"Nghỉ phép năm tính theo thâm niên cộng dồn: 5, 10, 15 ngày; nghỉ không được thì đổi thành tiền bằng 300% lương ngày"]},{"tag":"a","props":{"href":"/vi/tip/19-03"},"children":[{"tag":"span","props":{},"children":["03"]},"Thời gian thử việc có trần theo luật, lương không được dưới 80%, và chỉ được thỏa thuận một lần"]},{"tag":"a","props":{"href":"/vi/tip/19-04"},"children":[{"tag":"span","props":{},"children":["04"]},"Bị sa thải thì tính rõ N trước: cứ mỗi năm làm đủ một năm thì một tháng lương, chưa đủ sáu tháng thì tính nửa tháng"]},{"tag":"a","props":{"href":"/vi/tip/19-05"},"children":[{"tag":"span","props":{},"children":["05"]},"Công ty sa thải bạn mà không báo trước 30 ngày thì còn phải trả thêm một tháng lương"]},{"tag":"a","props":{"href":"/vi/tip/19-06"},"children":[{"tag":"span","props":{},"children":["06"]},"Công ty chấm dứt hợp đồng sai luật thì tiền bồi thường bằng hai lần mức bồi thường kinh tế"]},{"tag":"a","props":{"href":"/vi/tip/19-07"},"children":[{"tag":"span","props":{},"children":["07"]},"Đừng ký「tự nguyện nghỉ việc vì lý do cá nhân」, ký là mất trắng cả khoản N"]},{"tag":"a","props":{"href":"/vi/tip/19-08"},"children":[{"tag":"span","props":{},"children":["08"]},"Trước khi nghỉ việc thì lưu trước phiếu lương, bản chấm công, hợp đồng lao động, hồ sơ bảo hiểm xã hội và lịch sử trò chuyện"]},{"tag":"a","props":{"href":"/vi/tip/19-09"},"children":[{"tag":"span","props":{},"children":["09"]},"Trước khi vào chỗ có bụi, tiếng ồn, hoá chất thì xem trong hợp đồng đã ghi nguy cơ chưa; ba kỳ khám sức khoẻ nghề nghiệp do đơn vị sắp xếp và bỏ tiền"]},{"tag":"a","props":{"href":"/vi/tip/19-10"},"children":[{"tag":"span","props":{},"children":["10"]},"Tổn thương do bụi, tiếng ồn, chất độc hoá học thì không hồi phục được: đơn vị phải cấp đồ dùng bảo vệ, công việc không có biện pháp bảo vệ thì được từ chối"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/vi/tip/19-11","data-status":"active"},"children":[{"tag":"span","props":{},"children":["11"]},"Bị thương lúc làm việc, hay bị xe đâm trên đường đi làm về: việc đầu tiên là xin xác nhận tai nạn lao động, đơn vị không báo thì bạn tự báo"]},{"tag":"a","props":{"href":"/vi/tip/19-12"},"children":[{"tag":"span","props":{},"children":["12"]},"Đừng tin「leo tới bàn giấy là được coi là tai nạn lao động」: thấy khó chịu đột ngột thì gọi 120 trước, đừng chạy tới chấm công"]},{"tag":"a","props":{"href":"/vi/tip/19-13"},"children":[{"tag":"span","props":{},"children":["13"]},"Đơn vị không đóng bảo hiểm tai nạn lao động cho bạn thì ưu đãi tai nạn lao động vẫn có, và do đơn vị trả đủ theo đúng tiêu chuẩn"]},{"tag":"a","props":{"href":"/vi/tip/19-14"},"children":[{"tag":"span","props":{},"children":["14"]},"Khi tình trạng thương tích đã ổn định thì đi đánh giá năng lực lao động, hạng khuyết tật quy đổi thẳng thành tiền"]},{"tag":"a","props":{"href":"/vi/tip/19-15"},"children":[{"tag":"span","props":{},"children":["15"]},"Phải phân biệt ba khoản tiền khi chết vì tai nạn lao động: tiền trợ cấp mai táng, tiền trợ cấp hưu trí người được nuôi dưỡng, tiền trợ cấp một lần khi chết vì tai nạn lao động"]},{"tag":"a","props":{"href":"/vi/tip/19-16"},"children":[{"tag":"span","props":{},"children":["16"]},"Ở công ty lâu ngày bị bắt nạt, mắng, gây khó, đừng gồng chịu: ghi lại để có chứng cứ, rồi tuỳ tính chất mà khiếu nại, báo công an hoặc đi hoà giải"]},{"tag":"a","props":{"href":"/vi/tip/19-17"},"children":[{"tag":"span","props":{},"children":["17"]},"Lúc nghỉ việc thì xin đơn vị một giấy xác nhận nghỉ việc, ghi rõ thời hạn hợp đồng, ngày nghỉ việc, vị trí và số năm đã làm"]},{"tag":"a","props":{"href":"/vi/tip/19-18"},"children":[{"tag":"span","props":{},"children":["18"]},"Nhận tiền bồi thường khi nghỉ việc thì xem thuế thu nhập cá nhân trước: phần trong 3 mức lương bình quân người lao động của năm trước ở địa phương thì miễn thuế, phần vượt ra tính riêng, không gộp vào thu nhập của năm đó"]},{"tag":"a","props":{"href":"/vi/tip/19-19"},"children":[{"tag":"span","props":{},"children":["19"]},"Đổi thành phố làm việc thì chuyển quan hệ bảo hiểm hưu trí và y tế sang nơi tham gia mới, số năm đóng tiếp tục cộng dồn, đừng hủy bảo hiểm để rút tiền"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"Breadcrumbs"},"children":[{"tag":"a","props":{"href":"/vi/book"},"children":["Khám phá cuốn sách"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/vi/book/19"},"children":["Chương 19"," ·"," ","Đi làm, nghỉ việc và tai nạn lao động"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"19-11"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["11"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["Bằng chứng"," ","A"]}]},{"tag":"h1","props":{"lang":"vi"},"children":["Bị thương lúc làm việc, hay bị xe đâm trên đường đi làm về: việc đầu tiên là xin xác nhận tai nạn lao động, đơn vị không báo thì bạn tự báo"]},{"tag":"p","props":{"lang":"vi","className":"life-entry-summary"},"children":["Bị thương lúc đi làm thì tính là tai nạn lao động. Bị xe đâm trên đường đi làm về mà lỗi chính không thuộc về bạn thì cũng tính là tai nạn lao động. Nhưng không xin xác nhận tai nạn lao động thì tiền khám chữa, lương vẫn được trả trong thời gian nghỉ dưỡng, tiền trợ cấp tàn tật đều mất trắng. Đơn vị phải báo trong vòng 30 ngày. Đơn vị không báo thì bạn, người nhà hoặc công đoàn có thể tự báo tới cơ quan quản lý bảo hiểm xã hội trong vòng một năm."]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Chi phí"]},{"tag":"p","props":{},"children":["Không tốn tiền, chạy một lượt tới cơ quan quản lý bảo hiểm…"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Lợi ích"]},{"tag":"p","props":{},"children":["Không xin xác nhận tai nạn lao động thì tiền khám chữa, lương vẫn được trả trong thời gian nghỉ dưỡng (lương t…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"Đánh dấu: Bị thương lúc làm việc, hay bị xe đâm trên đường đi làm về: việc đầu tiên là xin xác nhận tai nạn lao động, đơn vị không báo thì bạn tự báo"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","a