霜"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"已做到"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"加入待做"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"收藏"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"分享这条建议"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"收起详情"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["成本"]},{"tag":"p","props":{"className":"life-citations"},"children":["不花钱，查一次编号几分钟。难的是不买熟人、微商推得最起劲的那几款。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["收益"]},{"tag":"p","props":{"className":"life-citations"},"children":["《化妆品监督管理条例》第十六条把祛斑美白化妆品列为特殊化妆品。第十七条规定，特殊化妆品经国务院药品监督管理部门注册后方可生产、进口。第三十六条要求标签上标注特殊化妆品注册证编号。第二十条要求注册信息向社会公布，所以编号能在国家药监局网站上查到。《化妆品注册备案管理办法》第六十二条规定，国产的编号是「国妆特字」加年份和顺序号，进口的是「国妆特进字」。国家药监局 2026 年第 14 号通告公布了两批祛斑霜，分别检出汞 4938 mg/kg 和 9281 mg/kg。通告附件列的限量是不超过 1 mg/kg，这两批超出几千倍。它们是在四川和安徽两家小化妆品店买到的，包装上印着国妆特字编号。标示的厂家提出异议，广东省药监局审查后认定，这家企业没生产过这批货。一篇综述汇总了期刊报道的 30 例病例，都是用含汞美白霜后得了肾病综合征，就是尿里漏出大量蛋白。30 人全是亚洲女性，多在 18 到 52 岁。从开始用到发病 1 到 60 个月，一半人在 5 个月以内。肾穿刺多是微小病变（67%）或膜性肾病（23%），这是两种肾小球的病。停用后一个半月内自己好转的很少。有记录的几例里，用了排汞药的尿蛋白转阴要 1 到 9 个月，中位数 2 个月。没用排汞药的 3 例都要 12 个月以上。北京一家医院 2014 到 2019 年收治汞中毒 288 人，84 人（29.27%）和化妆品有关。女性中毒的主要来源就是化妆品。随访到的 18 名肾病综合征病人里，15 人在平均 22.67 个月后尿蛋白和白蛋白恢复正常。这 18 人的汞不全来自化妆品"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["来源"]},{"tag":"p","props":{"className":"life-citations"},"children":["国务院 (2020). 化妆品监督管理条例（国务院令第 727 号，第十六条、第十七条、第二十条、第三十六条、第四十二条、第六十条）. ",{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/2020-06/29/content_5522593.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/zhengce/zhengceku/2020-06/29/content_5522593.htm"]},"；国家市场监督管理总局 (2021). 化妆品注册备案管理办法（总局令第 35 号，第六十二条）. ",{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/2021-01/12/content_5579239.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/zhengce/zhengceku/2021-01/12/content_5579239.htm"]},"；国家药品监督管理局 (2026). 国家药监局关于25批次化妆品检出禁用原料的通告（2026年第14号）及附件. ",{"tag":"a","props":{"href":"https://www.nmpa.gov.cn/xxgk/ggtg/hzhpggtg/hzhpchjgg/hzhpcjgjj/20260424173212101.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.nmpa.gov.cn/xxgk/ggtg/hzhpggtg/hzhpchjgg/hzhpcjgjj/20260424173212101.html"]},"；Chan TYK, Chan APL, Tang HL (2020). Nephrotic syndrome caused by exposures to skin-lightening cosmetic products containing inorganic mercury. Clin Toxicol. ",{"tag":"a","props":{"href":"https://doi.org/10.1080/15563650.2019.1639724","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1080/15563650.2019.1639724"]},"；Yawei S et al. (2021). Epidemiology, clinical presentation, treatment, and follow-up of chronic mercury poisoning in China: a retrospective analysis. BMC Pharmacol Toxicol. ",{"tag":"a","props":{"href":"https://doi.org/10.1186/s40360-021-00493-y","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1186/s40360-021-00493-y"]},""]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["原书备注"]},{"tag":"p","props":{"className":"life-citations"},"children":["上面那两批说明编号也能被冒用。所以查编号时要看查出来的品名、厂家和包装对不对得上，最好从品牌官方店或正规商场买。条例第四十二条规定，美容院给顾客用化妆品，要守化妆品经营者的规矩。第六十条第五项禁止经营者擅自配制化妆品，美容院自己调的「院线祛斑霜」本身就违法。已经长期用过来路不明的祛斑霜，就停用，带上产品去医院查尿汞和尿蛋白。那篇综述里有 6 人血汞正常，查了尿汞的 24 人都高出正常上限。病例是一例一例报出来的，算不出用含汞霜的人有多大比例会伤肾，所以记 B 级。收益量级凭后果定为中：肾病综合征多数能治好，但要治几个月到两年。"]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["我的备注"]},{"tag":"button","props":{"type":"button"},"children":["写下对自己有用的提醒…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/tip/28-09"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["上一条"]},"矫正牙齿要找有正畸资质的医生当面检查、按时复诊，别网购牙套自己在家戴"]}]},{"tag":"span","props":{},"children":[]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["本主题的其他建议"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/28-03"},"children":[{"tag":"strong","props":{},"children":["面部填充避开鼻背、眉间、额头这几个部位，更别为省钱找非正规注射"]},{"tag":"span","props":{},"children":["打填充针后失明的人里，一半多打的是鼻部，其次是眉间、额头和法令纹，八成多用的是玻尿酸。失明的人只有两成视力完全恢复，一成多部分恢复，将近两成还伤到了脑。目前没有…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/28-04"},"children":[{"tag":"strong","props":{},"children":["不要买承诺「快速瘦」的减肥药、减肥咖啡、瘦身糖果和酵素梅（号称泡过酵素的梅子）"]},{"tag":"span","props":{},"children":["这类产品里常查出偷加西布曲明，它原来是减肥药，2010 年在中国被停掉了。55 岁以上、有心脏病或糖尿病的超重的人吃了三年多，没致命的心梗高约三成，中风高约三成…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/28-05"},"children":[{"tag":"strong","props":{},"children":["不要用合成代谢类固醇（「增肌针」「口服药」）来长肌肉"]},{"tag":"span","props":{},"children":["健身房兴奋剂检测阳性的男性，死亡风险是同龄人的 3 倍，每年跑医院的次数多一倍多。痤疮、男性乳房发育、勃起功能障碍，每十个用药的人里至少一个中招。这类药在中国是…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/28-06"},"children":[{"tag":"strong","props":{},"children":["要吃减肥药、打司美格鲁肽这类减重针，就去医院拿处方、按医生安排加量和复查，别在不用处方就发货的网店买，也别去美容院打"]},{"tag":"span","props":{},"children":["处方药必须凭处方卖，网上卖也要有真实处方并且实名。不问诊就发货的网店、上门打针的美容院，药多半来路不明，剂量和禁忌没人负责。减重针停了一年，减掉的体重大约回来三…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/28-07"},"children":[{"tag":"strong","props":{},"children":["性激素类药只在医生开方并定期复查的前提下用，不要网购、不要自己加量"]},{"tag":"span","props":{},"children":["不讨论该不该用，只讨论怎么用。用雌激素的跨性别女性，血管里长血块的比同龄人明显多，每一千人两年多出约 4 个，八年多出约 17 个。这类风险得靠定期复查盯着，网…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/28-08"},"children":[{"tag":"strong","props":{},"children":["如果「觉得自己丑」已经到反复照镜子、反复想改的程度，先做一次体像评估再谈手术"]},{"tag":"span","props":{},"children":["去整形外科看的人里约 15% 有躯体变形障碍，就是把别人基本看不出的缺陷放大到影响生活。去皮肤科看的人里约 13%，两边都是七成多为女性。先挂一次号看看自己是不…"]}]}]}]},{"tag":"a","props":{"className":"life-text-link","href":"/book/28"},"children":["阅读整个主题：别为了外形把身体搞坏 ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"15","height":"15","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","pro