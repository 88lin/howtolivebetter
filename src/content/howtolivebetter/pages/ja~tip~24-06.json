ink","href":"/ja/book/24"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"目次に戻る"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["通院ガイド：費用と手間を最小限に抑える方法"]},{"tag":"div","props":{"data-ad-dock-host":"true"},"children":[]},{"tag":"nav","props":{"aria-label":"この章のヒント"},"children":[{"tag":"a","props":{"href":"/ja/tip/24-01"},"children":[{"tag":"span","props":{},"children":["01"]},"一般的な疾患はまずコミュニティ（地域医療機関）で受診し、基層医療から段階的に紹介受診することで、入院自己負担額（免責額）の継続計算が可能になります"]},{"tag":"a","props":{"href":"/ja/tip/24-02"},"children":[{"tag":"span","props":{},"children":["02"]},"同一の統籌地区（医療保険加入地）内では、医療機関のレベルが低いほど払い戻し率が高くなり、その差は約 10 パーセントポイントです"]},{"tag":"a","props":{"href":"/ja/tip/24-03"},"children":[{"tag":"span","props":{},"children":["03"]},"大病院へ行く際は、基層からの紹介または病院の紹介センターを利用してください。予約転売業者（号販子）に頼ってはいけません"]},{"tag":"a","props":{"href":"/ja/tip/24-04"},"children":[{"tag":"span","props":{},"children":["04"]},"省外での他地域受診の前に、まずは地元の病院に相談を。必要性の判断は原則として副主任医師（副教授級）以上による評価が必要です"]},{"tag":"a","props":{"href":"/ja/tip/24-05"},"children":[{"tag":"span","props":{},"children":["05"]},"診察が終わるたびに、診療録、検査報告書、画像資料のコピーを自分で保管しましょう"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/ja/tip/24-06","data-status":"active"},"children":[{"tag":"span","props":{},"children":["06"]},"診療内容に疑問がある場合は、その場で診療録の封印（封存）を要求しましょう。双方立ち会いのもと、リストを作成し、各自が1部ずつ保管します"]},{"tag":"a","props":{"href":"/ja/tip/24-07"},"children":[{"tag":"span","props":{},"children":["07"]},"緊急・重症の負傷者は、受付窓口で並ばず、直接救急のトリアージデスクへ向かうこと"]},{"tag":"a","props":{"href":"/ja/tip/24-08"},"children":[{"tag":"span","props":{},"children":["08"]},"お金がない、身分証がない、自分が誰か説明できない場合でも、救急は必ず優先して救命しなければならない"]},{"tag":"a","props":{"href":"/ja/tip/24-09"},"children":[{"tag":"span","props":{},"children":["09"]},"後遺障害の等級判定は治療終了後に行うこと。早すぎると等級が低くなる可能性がある"]},{"tag":"a","props":{"href":"/ja/tip/24-10"},"children":[{"tag":"span","props":{},"children":["10"]},"治療終了後に実際に機能障害が残った場合は、戸籍地の県級残疾人連合会へ障害者手帳の申請を行う"]},{"tag":"a","props":{"href":"/ja/tip/24-11"},"children":[{"tag":"span","props":{},"children":["11"]},"命を救ってくれた医師には、感謝の手紙、錦旗（きんき）、満足度評価を。お礼の「红包（赤包）」は避けるべき：禁じられているのは金品であり、感謝の気持ちではない"]},{"tag":"a","props":{"href":"/ja/tip/24-12"},"children":[{"tag":"span","props":{},"children":["12"]},"インプラント前に定額料金に何が含まれるか確認する。価格適正化への参加を約束した施設を優先し、安い広告を信じない"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"現在地"},"children":[{"tag":"a","props":{"href":"/ja/book"},"children":["本を読む"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/ja/book/24"},"children":["第24章"," ·"," ","通院ガイド：費用と手間を最小限に抑える方法"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"24-06"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["06"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["エビデンス"," ","A"]}]},{"tag":"h1","props":{"lang":"ja"},"children":["診療内容に疑問がある場合は、その場で診療録の封印（封存）を要求しましょう。双方立ち会いのもと、リストを作成し、各自が1部ずつ保管します"]},{"tag":"p","props":{"lang":"ja","className":"life-entry-summary"},"children":["治療に疑問がある場合は、診療録を封印（封存）するよう要求することができます。封印には医師と患者の双方が立ち会い、リストを作成し、署名・捺印の上、各自が1部ずつ保管する必要があります。診療録がまだ作成途中の場合は、先に作成済みの部分を封印します。輸液、輸血、注射、投薬が原因と思われる問題については、その輸液バッグ、薬剤、および輸液セットも併せて封印の対象とします。"]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["費用・手間"]},{"tag":"p","props":{},"children":["費用はかかりません。病院に封印の要求を出し、医師と患者の双方が立ち会った後、手続きを完了させます。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["効果"]},{"tag":"p","props":{},"children":["条例では「医療紛争が発生し、診療録資料の封印および開封が必要な場合は、医師と患者の双方が立ち会う状況で行わなければならない」と規定されています。"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"記録する：診療内容に疑問がある場合は、その場で診療録の封印（封存）を要求しましょう。双方立ち会いのもと、リストを作成し、各自が1部ずつ保管します"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"できている"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"やることに追加"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 