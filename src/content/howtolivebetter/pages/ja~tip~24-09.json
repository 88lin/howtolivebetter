_product","data-ad-ready":"false","aria-label":"広告 · コミュニティ紹介"},"children":[{"tag":"button","props":{"type":"button","className":"life-ad-dismiss","aria-label":"広告を閉じる"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-x","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M18 6 6 18"},"children":[]},{"tag":"path","props":{"d":"m6 6 12 12"},"children":[]}]}]},{"tag":"div","props":{"className":"life-ad-space-brand"},"children":[{"tag":"img","props":{"src":"/sites/howtolivebetter/images/shengcai/logo.png","width":"565","height":"144","alt":"生財有術の公式ロゴ","decoding":"async"},"children":[]}]},{"tag":"div","props":{"className":"life-ad-space-copy"},"children":[{"tag":"span","props":{"className":"life-ad-space-label"},"children":["広告 · コミュニティ紹介"]},{"tag":"strong","props":{},"children":["学んだ知識は、役立つ製品になる？"]},{"tag":"p","props":{},"children":["電子書籍や小さなツール。需要を見つけ、知識を使える形にする参加者の実践を紹介します。"]}]},{"tag":"div","props":{"className":"life-ad-space-actions"},"children":[{"tag":"a","props":{"className":"life-ad-space-link","href":"/ja/shengcaiyoushu?sc_group=reading&sc_creative=read_product&sc_placement=ad_dock"},"children":["コミュニティと事例を見る",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"18","height":"18","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-up-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M7 7h10v10"},"children":[]},{"tag":"path","props":{"d":"M7 17 17 7"},"children":[]}]}]}]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/ja/book/24"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"目次に戻る"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["通院ガイド：費用と手間を最小限に抑える方法"]},{"tag":"div","props":{"data-ad-dock-host":"true"},"children":[]},{"tag":"nav","props":{"aria-label":"この章のヒント"},"children":[{"tag":"a","props":{"href":"/ja/tip/24-01"},"children":[{"tag":"span","props":{},"children":["01"]},"一般的な疾患はまずコミュニティ（地域医療機関）で受診し、基層医療から段階的に紹介受診することで、入院自己負担額（免責額）の継続計算が可能になります"]},{"tag":"a","props":{"href":"/ja/tip/24-02"},"children":[{"tag":"span","props":{},"children":["02"]},"同一の統籌地区（医療保険加入地）内では、医療機関のレベルが低いほど払い戻し率が高くなり、その差は約 10 パーセントポイントです"]},{"tag":"a","props":{"href":"/ja/tip/24-03"},"children":[{"tag":"span","props":{},"children":["03"]},"大病院へ行く際は、基層からの紹介または病院の紹介センターを利用してください。予約転売業者（号販子）に頼ってはいけません"]},{"tag":"a","props":{"href":"/ja/tip/24-04"},"children":[{"tag":"span","props":{},"children":["04"]},"省外での他地域受診の前に、まずは地元の病院に相談を。必要性の判断は原則として副主任医師（副教授級）以上による評価が必要です"]},{"tag":"a","props":{"href":"/ja/tip/24-05"},"children":[{"tag":"span","props":{},"children":["05"]},"診察が終わるたびに、診療録、検査報告書、画像資料のコピーを自分で保管しましょう"]},{"tag":"a","props":{"href":"/ja/tip/24-06"},"children":[{"tag":"span","props":{},"children":["06"]},"診療内容に疑問がある場合は、その場で診療録の封印（封存）を要求しましょう。双方立ち会いのもと、リストを作成し、各自が1部ずつ保管します"]},{"tag":"a","props":{"href":"/ja/tip/24-07"},"children":[{"tag":"span","props":{},"children":["07"]},"緊急・重症の負傷者は、受付窓口で並ばず、直接救急のトリアージデスクへ向かうこと"]},{"tag":"a","props":{"href":"/ja/tip/24-08"},"children":[{"tag":"span","props":{},"children":["08"]},"お金がない、身分証がない、自分が誰か説明できない場合でも、救急は必ず優先して救命しなければならない"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/ja/tip/24-09","data-status":"active"},"children":[{"tag":"span","props":{},"children":["09"]},"後遺障害の等級判定は治療終了後に行うこと。早すぎると等級が低くなる可能性がある"]},{"tag":"a","props":{"href":"/ja/tip/24-10"},"children":[{"tag":"span","props":{},"children":["10"]},"治療終了後に実際に機能障害が残った場合は、戸籍地の県級残疾人連合会へ障害者手帳の申請を行う"]},{"tag":"a","props":{"href":"/ja/tip/24-11"},"children":[{"tag":"span","props":{},"children":["11"]},"命を救ってくれた医師には、感謝の手紙、錦旗（きんき）、満足度評価を。お礼の「红包（赤包）」は避けるべき：禁じられているのは金品であり、感謝の気持ちではない"]},{"tag":"a","props":{"href":"/ja/tip/24-12"},"children":[{"tag":"span","props":{},"children":["12"]},"インプラント前に定額料金に何が含まれるか確認する。価格適正化への参加を約束した施設を優先し、安い広告を信じない"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"現在地"},"children":[{"tag":"a","props":{"href":"/ja/book"},"children":["本を読む"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/ja/book/24"},"children":["第24章"," ·"," ","通院ガイド：費用と手間を最小限に抑える方法"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"24-09"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["09"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["エビデンス"," ","A"]}]},{"tag":"h1","props":{"lang":"ja"},"children":["後遺障害の等級判定は治療終了後に行うこと。早すぎると等級が低くなる可能性がある"]},{"tag":"p","props":{"lang":"ja","className":"life-entry-summary"},"children":["賠償額は主にどの等級に判定されるかで決まり、等級は治療終了後にどれだけの機能障害が残っているかで決まります。基準には、治療の終了後、または臨床的な治療効果が安定した後に判定を行うべきであると明記されています。骨がまだ癒合していない、あるいはプレートがまだ抜去されていない状態で判定を受けると、その時点の状態での判定となるため、自ら等級を下げてしまうことになります。機能に影響のない、治癒した通常の骨折では判定を受けられません。"]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["費用・手間"]},{"tag":"p","props":{},"children":["鑑定費用は数百元から2,000元程度と幅があり、一般的には申請を行った側がまず立て替えます。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["効果"]},{"tag":"p","props":{},"children":["『人体損傷致残程度分級』では、判定の時期について「原発性の損傷およびそれに関連する合併症の治療終了後、または臨床的な治療効果が安定した後に、鑑定を行うものとする」と規定されています。"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"記録する：後遺障害の等級判定は治療終了後に行うこと。早すぎると等級が低くなる可能性がある"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"できている"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"やることに追加"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"お気に入り"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"このヒントを共有"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"詳細を閉じる"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["費用・手間"]},{"tag":"p","props":{},"children":["鑑定費用は数百元から2,000元程度と幅があり、一般的には申請を行った側がまず立て替えます。治療の終了、または臨床的な効果が安定するまで待つ必要があり、通常は受傷後3か月から6か月、時にはそれ以上かかることもあります。困難なのは、傷が完全に治る前に早く確定させてしまいたいという気持ちですが、そこは堪えなければなりません。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["効果"]},{"tag":"p","props":{},"children":["『人体損傷致残程度分級』では、判定の時期について「原発性の損傷およびそれに関連する合併症の治療終了後、または臨床的な治療効果が安定した後に、鑑定を行うものとする」と規定されています。基準では「人体損傷の致残程度を、第1級（人体致残率100%）から第10級（人体致残率10%）までの10段階に区分し、各級の致残率は10%ずつ差がある」としています。判断の根拠は「人体組織・器官の構造破壊、機能障害、および医療・介護への依存度とし、障害に起因する社会的交流や心理的要因の影響を適宜考慮する」ことです。第10級のうち、骨折に関連する条項には以下のものがあります。一つ目は「椎体の一箇所における圧迫骨折（圧迫程度が1/3に達するもの）または粉砕骨折」。二つ目は「骨盤の2箇所以上の骨折または粉砕骨折、および変形治癒」。三つ目は「四肢のいずれか大きな関節（足関節を除く）の機能喪失が25%以上」。同一部位かつ同一性質の障害を重複して計算することはできません。2箇所以上の障害がある場合は、それぞれの等級を明記しなければなりません（全国、2017年1月1日より施行）。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["出典"]},{"tag":"p","props":{"className":"life-citations"},"children":["最高人民法院、最高人民检察院、公安部、国家安全部、司法部 (2016). 关于发布《人体损伤致残程度分级》的公告（2016 年 4 月 18 日发布，2017 年 1 月 1 日施行），标准第 4.2、4.4、4.5、5.10.6、6.2 条. ",{"tag":"a","props":{"href":"https://www.moj.gov.cn/pub/sfbgw/zwxxgk/fdzdgknr/fdzdgknrtzwj/201908/P020210316701681025917.pdf","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.moj.gov.cn/pub/sfbgw/zwxxgk/fdzdgknr/fdzdgknrtzwj/201908/P020210316701681025917.pdf"]}]},{"tag":"a","props":{"href":"https://www.moj.gov.cn/pub/sfbgw/zwxxgk/fdzdgknr/fdzdgknrtzwj/201908/P020210316701681025917.pdf","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["出典を開く"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["著者の注記"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["3種類の障害判定制度は互換性がないため、混同しないように注意してください。暴行による負傷、交通事故、その他の対人損害については、司法鑑定としての『人体損傷致残程度分級』を用い、これによって障害賠償金を算出します（第9節を参照）。労働災害（労災）の場合は、労働能力鑑定を行い、別の10段階の障害等級が適用され、労災補償を管理します（第19節を参照）。障害者向けの政策的待遇を受けるには、別途、障害者手帳の申請が必要です（第10条、障害者手帳を参照）。鑑定の前には、病歴、手術記録、再検査後の画像データをすべて揃えておいてください（第5条、病歴と画像データは各自で1部保管しておくこと）。画像データの不足は、等級が低く判定される最も一般的な原因です。今回の負傷と元々あった持病が混在している場合、鑑定意見書には今回の負傷が障害の結果にどの程度の割合で寄与しているかを明記しなければなりません。この項目が賠償額に直接影響します。"]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["自分のメモ"]},{"tag":"button","props":{"type":"button"},"children":["自分へのメモを書く…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/ja/tip/24-08"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["前へ"]},"お金がない、身分証がない、自分が誰か説明できない場合でも、救急は必ず優先して救命しなければならない"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/ja/tip/24-10"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["次へ"]},"治療終了後に実際に機能障害が残った場合は、戸籍地の県級残疾人連合会へ障害者手帳の申請を行う"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["このテーマの他の提案"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/24-04"},"children":[{"tag":"strong","props":{},"children":["省外での他地域受診の前に、まずは地元の病院に相談を。必要性の判断は原則として副主任医師（副教授級）以上による評価が必要です"]},{"tag":"span","props":{},"children":["他地域へ診察に行く必要があるかどうかは、原則として二次・三次病院の副主任医師以上の医師による評価に基づきます。一時的な外出受診における払い…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/24-05"},"children":[{"tag":"strong","props":{},"children":["診察が終わるたびに、診療録、検査報告書、画像資料のコピーを自分で保管しましょう"]},{"tag":"span","props":{},"children":["自身の診療録を閲覧・複製することは、法律で認められたあなたの権利です。外来診療録、入院記録、検査結果、画像、手術および麻酔の記録、病理資料…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/24-06"},"children":[{"tag":"strong","props":{},"children":["診療内容に疑問がある場合は、その場で診療録の封印（封存）を要求しましょう。双方立ち会いのもと、リストを作成し、各自が1部ずつ保管します"]},{"tag":"span","props":{},"children":["治療に疑問がある場合は、診療録を封印（封存）するよう要求することができます。封印には医師と患者の双方が立ち会い、リストを作成し、署名・捺印…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/24-07"},"children":[{"tag":"strong","props":{},"children":["緊急・重症の負傷者は、受付窓口で並ばず、直接救急のトリアージデスクへ向かうこと"]},{"tag":"span","props":{},"children":["救急外来は先着順ではなく、病状の重症度に応じて4段階に分類されます。判定が行われるのは、救急入口のトリアージデスクであり、受付窓口ではあり…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/24-11"},"children":[{"tag":"strong","props":{},"children":["命を救ってくれた医師には、感謝の手紙、錦旗（きんき）、満足度評価を。お礼の「红包（赤包）」は避けるべき：禁じられているのは金品であり、感謝の気持ちではない"]},{"tag":"span","props":{},"children":["事前に現金を渡しても優先権は買えません。予約枠、病床、不足している医薬品、手術のスケジュールなどを、見返りと引き換えに操作することは禁止さ…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/24-12"},"children":[{"tag":"strong","props":{},"children":["インプラント前に定額料金に何が含まれるか確認する。価格適正化への参加を約束した施設を優先し、安い広告を信じない"]},{"tag":"span","props":{},"children":["2023 年の一斉値下げ後、通常のインプラント 1 本の総費用は平均 1.5 万元から 6000～7000 元になりました。三級公立病院の…"]}]}]}]},{"tag":"a","props":{"className":"life-text-link","href":"/ja/book/24"},"children":["テーマ全体を読む：通院ガイド：費用と手間を最小限に抑える方法"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"15","height":"15","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]}]}]}]},{"tag":"aside","props":{"className":"life-ad-space life-ad-space-sponsored","data-ad-placement":"ad_footer","data-ad-group":"reading","data-ad-creative":"read_product","data-ad-ready":"false","aria-label":"広告 · コミュニティ紹介"},"children":[{"tag":"div","props":{"className":"life-ad-space-brand"},"children":[{"tag":"img","props":{"src":"/sites/howtolivebetter/images/shengcai/logo.png","width":"565","height":"144","alt":"生財有術の公式ロゴ","decoding":"async"},"children":[]}]},{"tag":"div","props":{"className":"life-ad-space-copy"},"children":[{"tag":"span","props":{"className":"life-ad-space-label"},"children":["広告 · コミュニティ紹介"]},{"tag":"strong","props":{},"children":["学んだ知識は、役立つ製品になる？"]},{"tag":"p","props":{},"children":["電子書籍や小さなツール。需要を見つけ、知識を使える形にする参加者の実践を紹介します。"]}]},{"tag":"div","props":{"className":"life-ad-space-actions"},"children":[{"tag":"a","props":{"className":"life-ad-space-link","href":"/ja/shengcaiyoushu?sc_group=reading&sc_creative=read_product&sc_placement=ad_footer"},"children":["コミュニティと事例を見る",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"18","height":"18","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lu