2"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"目次に戻る"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["起業とビジネス：全財産を失わないために"]},{"tag":"div","props":{"data-ad-dock-host":"true"},"children":[]},{"tag":"nav","props":{"aria-label":"この章のヒント"},"children":[{"tag":"a","props":{"href":"/ja/tip/12-01"},"children":[{"tag":"span","props":{},"children":["01"]},"失ってもよい金額のみで起業する：家財を投じず、借金をして開業しない"]},{"tag":"a","props":{"href":"/ja/tip/12-02"},"children":[{"tag":"span","props":{},"children":["02"]},"会社への融資に対して個人保証に署名しない、配偶者も絶対に署名しない"]},{"tag":"a","props":{"href":"/ja/tip/12-03"},"children":[{"tag":"span","props":{},"children":["03"]},"開業前に正しい主体を選ぶ：個人事業主と組合員は最後まで責任を負い、有限会社のみが「有限」となる"]},{"tag":"a","props":{"href":"/ja/tip/12-04"},"children":[{"tag":"span","props":{},"children":["04"]},"名義上の株主にならない、他人のために株式を保有（名義貸し）しない"]},{"tag":"a","props":{"href":"/ja/tip/12-05"},"children":[{"tag":"span","props":{},"children":["05"]},"加盟前に商務部の備案を確認し、書面による開示を受け、契約書に「クーリングオフ期間」を明記する"]},{"tag":"a","props":{"href":"/ja/tip/12-06"},"children":[{"tag":"span","props":{},"children":["06"]},"登録前に名称、営業所、経営範囲、登録資本金を確定させる。書類が揃っていればその場で免許を取得できる"]},{"tag":"a","props":{"href":"/ja/tip/12-07"},"children":[{"tag":"span","props":{},"children":["07"]},"許可証が必要な業種：許可が下りるまで営業禁止"]},{"tag":"a","props":{"href":"/ja/tip/12-08"},"children":[{"tag":"span","props":{},"children":["08"]},"食品販売はまず自分の区分を確認：製造・飲食は許可が必要、既包装の販売は届出のみ、生鮮肉・野菜は許可不要"]},{"tag":"a","props":{"href":"/ja/tip/12-09"},"children":[{"tag":"span","props":{},"children":["09"]},"袋詰め販売は「既包装食品」：ラベルの製造日、賞味期限、原材料名はすべて必須"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/ja/tip/12-10","data-status":"active"},"children":[{"tag":"span","props":{},"children":["10"]},"一般食品で病気が治せると言うのは禁止：ラベル、説明書、広告、ライブ配信の台本すべてが対象"]},{"tag":"a","props":{"href":"/ja/tip/12-11"},"children":[{"tag":"span","props":{},"children":["11"]},"食品業界には刑事罰のラインがある：病死した肉や基準超過品を売れば罪に問われ、有害物質の混入は金額に関わらず、刑期は5年起算"]},{"tag":"a","props":{"href":"/ja/tip/12-12"},"children":[{"tag":"span","props":{},"children":["12"]},"営業許可取得後から申告義務が発生。収入がなくても期限内に「ゼロ申告」を行うこと（すべてゼロの書類を提出する）"]},{"tag":"a","props":{"href":"/ja/tip/12-13"},"children":[{"tag":"span","props":{},"children":["13"]},"請求書は実際の取引に基づいてのみ発行し、小規模納税者は免税枠を最大限活用する"]},{"tag":"a","props":{"href":"/ja/tip/12-14"},"children":[{"tag":"span","props":{},"children":["14"]},"税務局を名乗り納税を催促してくるのはすべて詐欺です。納税手続きは電子税務局と 12366 を通じてのみ行ってください"]},{"tag":"a","props":{"href":"/ja/tip/12-15"},"children":[{"tag":"span","props":{},"children":["15"]},"「手付金（定金）」と記載し「予約金（订金）」とは書かないこと。違約金は金額を明記し、支払猶予期間（売掛）は貸付として審査すること"]},{"tag":"a","props":{"href":"/ja/tip/12-16"},"children":[{"tag":"span","props":{},"children":["16"]},"雇用後の最初の1ヶ月以内に書面契約を締結し、30 日以内に社会保険登録を行う"]},{"tag":"a","props":{"href":"/ja/tip/12-17"},"children":[{"tag":"span","props":{},"children":["17"]},"賃金は契約と法律に従って支払い、昇給、貸付、ボーナスはすべて書面で行う"]},{"tag":"a","props":{"href":"/ja/tip/12-18"},"children":[{"tag":"span","props":{},"children":["18"]},"販売してから製造：予約販売と小規模注文で需要を検証してから、製造に投資する"]},{"tag":"a","props":{"href":"/ja/tip/12-19"},"children":[{"tag":"span","props":{},"children":["19"]},"サンプル完成後は、まず量産チェックリストを確認してから着手すること"]},{"tag":"a","props":{"href":"/ja/tip/12-20"},"children":[{"tag":"span","props":{},"children":["20"]},"仕入れのたびに伝票と仕入れ元情報を保管すること。市場価格より明らかに低い仕入れ値のものは仕入れない：従業員が仕入れた偽物で、社長が判決を受けた事例"]},{"tag":"a","props":{"href":"/ja/tip/12-21"},"children":[{"tag":"span","props":{},"children":["21"]},"商品、パッケージ、タグ、宣伝画像に使用する図案は、自作するかライセンスを購入すること。色の変更やアイコンの追加は「改変」とはみなされない"]},{"tag":"a","props":{"href":"/ja/tip/12-22"},"children":[{"tag":"span","props":{},"children":["22"]},"職務においては規定に従って行動し、規定外の善意はまず責任の所在を明確にすること"]},{"tag":"a","props":{"href":"/ja/tip/12-23"},"children":[{"tag":"span","props":{},"children":["23"]},"損失が出たら手続きに従って退場を：簡便な注銷ができるなら注銷し、債務超過なら破産を。放置してはいけない"]},{"tag":"a","props":{"href":"/ja/tip/12-24"},"children":[{"tag":"span","props":{},"children":["24"]},"ネットショップの運営代行、開店セミナー、 「無在庫販売」に手を出して費用を支払う前に、追加料金の有無と売上の出所を必ず確認すること"]},{"tag":"a","props":{"href":"/ja/tip/12-25"},"children":[{"tag":"span","props":{},"children":["25"]},"中国で会社や個人事業を営むなら、毎年1月1日〜6月30日に前年の年次報告をオンライン提出。営業がなくても必要で、無料"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"現在地"},"children":[{"tag":"a","props":{"href":"/ja/book"},"children":["本を読む"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/ja/book/12"},"children":["第12章"," ·"," ","起業とビジネス：全財産を失わないために"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"12-10"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["10"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["エビデンス"," ","A"]}]},{"tag":"h1","props":{"lang":"ja"},"children":["一般食品で病気が治せると言うのは禁止：ラベル、説明書、広告、ライブ配信の台本すべてが対象"]},{"tag":"p","props":{"lang":"ja","className":"life-entry-summary"},"children":["一般食品のラベル、説明書、広告において、病気の予防や治療ができると述べることはできません。医療、医薬品、医療機器の3つの広告を除き、他の広告では病気が治せると言うことも、薬のように聞こえる言葉を使うことも禁止されています。罰則は広告費の 1 から 3 倍です。広告費が算出できない場合は、10 万から 20 万の罰金となります。悪質な場合は営業許可の取り消しもあり得ます。"]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["費用・手間"]},{"tag":"p","props":{},"children":["費用はかかりません。宣伝文句、商品詳細ページ、ライブ配信の台本を一度見直すだけです。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["効果"]},{"tag":"p","props":{},"children":["食品安全法：「食品および食品添加物のラベル、説明書には、虚偽の内容を含んではならず、疾病の予防または治療機能に関わる内容を含んではならない。"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"記録する：一般食品で病気が治せると言うのは禁止：ラベル、説明書、広告、ライブ配信の台本すべてが対象"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"できている"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"やることに追加"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"お気に入り"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"このヒントを共有"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"詳細を閉じる"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["費用・手間"]},{"tag":"p","props":{},"children":["費用はかかりません。宣伝文句、商品詳細ページ、ライブ配信の台本を一度見直すだけです。難しいのは「高血圧・高血糖・高脂血症の低下」や「便秘解消」といった言葉を言いたい気持ちを抑えることです。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["効果"]},{"tag":"p","props":{},"children":["食品安全法：「食品および食品添加物のラベル、説明書には、虚偽の内容を含んではならず、疾病の予防または治療機能に関わる内容を含んではならない。製造業者および販売業者は、提供するラベルおよび説明書の内容に対して責任を負う」。 「食品広告の内容は真実かつ適法でなければならず、虚偽の内容を含んではならず、疾病の予防または治療機能に関わる内容を含んではならない。食品の製造業者および販売業者は、食品広告の内容の真実性および適法性に対して責任を負う」。つまり、パッケージ、説明書、広告のいずれにおいても、病気の予防や治療ができると謳うことはできず、記載された内容については販売者が責任を負うという意味である。広告において食品について誇張したり、消費者を欺いたりした場合は、広告法に基づき罰せられる。広告法には、もう一つの禁止規定もある。「医療、医薬品、医療機器の広告を除き、他のいかなる広告も疾病の治療機能に言及することを禁止し、医療用語、または販売される商品と医薬品や医療機器と混同させる恐れのある用語を使用してはならない」。医療、医薬品、医療機器のこれら3種類の広告を除き、他の広告は一切、病気が治ると述べることはできず、薬や医療機器のように聞こえる言葉を使用することもできない。これに違反した場合、広告の中止を命じる。また、広告を出した側（広告主）に対し、過去に掲載された範囲において公開のうえ、釈明し、影響を排除させなければならない。さらに、広告費用の 1 倍以上 3 倍以下の罰金を科す。広告費用が算出できない場合、または明らかに低く報告されている場合は、10 万元以上 20 万元以下の罰金を科す。情节が重大な場合は、広告費用の 3 倍以上 5 倍以下、または 20 万元以上 100 万元以下の罰金に処されるほか、営業許可の取り消しにより、事業の継続が不可能になることがあります（全国共通）"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["出典"]},{"tag":"p","props":{"className":"life-citations"},"children":["全国人大常委会 (2025 年第三次修正). 食品安全法（第七十一、七十三、一百二十五、一百四十条）. ",{"tag":"a","props":{"href":"https://flk.npc.gov.cn/detail?id=7b5a76d0461745a08d3f964916b87ef3","target":"_blank","rel":"noopener noreferrer"},"children":["https://flk.npc.gov.cn/detail?id=7b5a76d0461745a08d3f964916b87ef3"]},"；全国人大常委会 (2021 年修正). 广告法（第十七、五十八条）. ",{"tag":"a","props":{"href":"https://flk.npc.gov.cn/detail?id=ff8081817ab231eb017abd6bd860052d","target":"_blank","rel":"noopener noreferrer"},"children":["https://flk.npc.gov.cn/detail?id=ff8081817ab231eb017abd6bd860052d"]}]},{"tag":"a","props":{"href":"https://flk.npc.gov.cn/detail?id=7b5a76d0461745a08d3f964916b87ef3","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["出典を開く"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["著者の注記"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["「保健機能」についても、一般食品が謳うことはできません。健康食品が主張できる保健機能は、国が定めた目録にあるものに限られ、製品は登録または備案（届出）を経る必要がありますが、一般食品にはその手続きはありません。購入者がこのような言い回しをどのように見分けるかは、第 6 節第 10 条（健康食品を大金で買って体を整えようとしないこと）を参照してください。パッケージや広告だけでなく、詳細ページ、ライブ配信の台本、SNS（朋友圈）の投稿も同様に広告内容とみなされ、一度発信すると痕跡が残ります。"]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["自分のメモ"]},{"tag":"button","props":{"type":"button"},"children":["自分へのメモを書く…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/ja/tip/12-09"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["前へ"]},"袋詰め販売は「既包装食品」：ラベルの製造日、賞味期限、原材料名はすべて必須"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/ja/tip/12-11"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["次へ"]},"食品業界には刑事罰のラインがある：病死した肉や基準超過品を売れば罪に問われ、有害物質の混入は金額に関わらず、刑期は5年起算"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["このテーマの他の提案"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/12-06"},"children":[{"tag":"strong","props":{},"children":["登録前に名称、営業所、経営範囲、登録資本金を確定させる。書類が揃っていればその場で免許を取得できる"]},{"tag":"span","props":{},"children":["登記自体に費用はかかりません。登録手数料は 2015 年から徴収が停止されています。提出が必要な書類は、申請書、身分証明書または資格証明書…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/12-07"},"children":[{"tag":"strong","props":{},"children":["許可証が必要な業種：許可が下りるまで営業禁止"]},{"tag":"span","props":{},"children":["許可なしでの営業は、軽ければ営業停止命令、得た利益の没収、さらに 1 万元以下の罰金が科されます。独占販売品や、証券、先物、保険、資金決済…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/12-08"},"children":[{"tag":"strong","props":{},"children":["食品販売はまず自分の区分を確認：製造・飲食は許可が必要、既包装の販売は届出のみ、生鮮肉・野菜は許可不要"]},{"tag":"span","props":{},"children":["自作のものを販売する場合、軽食店、滷味（ルーウェイ）、ベーカリー、自家製漬物などは、すべて許可が必要です。他社が製造した既包装の食品を販売…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/12-12"},"children":[{"tag":"strong","props":{},"children":["営業許可取得後から申告義務が発生。収入がなくても期限内に「ゼロ申告」を行うこと（すべてゼロの書類を提出する）"]},{"tag":"span","props":{},"children":["営業許可を取得したら、期限内に納税申告を行う必要があります。1円も稼いでいなくても申告は必要ですが、その場合は書類の数字をすべてゼロと記入…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/12-13"},"children":[{"tag":"strong","props":{},"children":["請求書は実際の取引に基づいてのみ発行し、小規模納税者は免税枠を最大限活用する"]},{"tag":"span","props":{},"children":["簡易課税制度を適用する小規模納税者で、月間の売上高が 10 万未満、かつ四半期の売上高が 30 万未満であれば、増値税（付加価値税）は免除…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/12-14"},"children":[{"tag":"strong","props":{},"children":["税務局を名乗