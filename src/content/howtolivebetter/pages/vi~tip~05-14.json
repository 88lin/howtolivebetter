currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-up-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M7 7h10v10"},"children":[]},{"tag":"path","props":{"d":"M7 17 17 7"},"children":[]}]}]}]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/vi/book/05"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"Quay lại mục lục"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["Đừng phí tiền"]},{"tag":"div","props":{"data-ad-dock-host":"true"},"children":[]},{"tag":"nav","props":{"aria-label":"Các mục trong chương"},"children":[{"tag":"a","props":{"href":"/vi/tip/05-01"},"children":[{"tag":"span","props":{},"children":["01"]},"Tắt hết tự động gia hạn, đến hạn thì tự gia hạn"]},{"tag":"a","props":{"href":"/vi/tip/05-02"},"children":[{"tag":"span","props":{},"children":["02"]},"Mỗi năm từ tháng Ba đến tháng Sáu làm một lần tổng kết thuế thu nhập cá nhân, khai đủ các khoản trừ bổ sung chuyên ngành"]},{"tag":"a","props":{"href":"/vi/tip/05-03"},"children":[{"tag":"span","props":{},"children":["03"]},"Quỹ tích góp nhà ở không chỉ dùng để mua nhà: thuê nhà, sửa sang, phí quản lý nhà ở đều rút được, từ ngày 20 tháng 9 năm 2026 áp dụng quy định mới"]},{"tag":"a","props":{"href":"/vi/tip/05-04"},"children":[{"tag":"span","props":{},"children":["04"]},"Mỗi năm tính lại gói điện thoại và băng thông một lần, không dùng tới thì hạ bậc, nhà mạng không chuyển được thì khiếu nại"]},{"tag":"a","props":{"href":"/vi/tip/05-05"},"children":[{"tag":"span","props":{},"children":["05"]},"Không mua xổ số"]},{"tag":"a","props":{"href":"/vi/tip/05-06"},"children":[{"tag":"span","props":{},"children":["06"]},"Thấy「高收益」「保本」「稳赚」thì đi luôn"]},{"tag":"a","props":{"href":"/vi/tip/05-07"},"children":[{"tag":"span","props":{},"children":["07"]},"Không dùng khoản trả tối thiểu trên thẻ tín dụng, không mở trả góp hay vay tiêu dùng để mua; nếu thật sự cần vay, hãy đổi lãi suất thành lãi suất năm rồi so sánh"]},{"tag":"a","props":{"href":"/vi/tip/05-08"},"children":[{"tag":"span","props":{},"children":["08"]},"Không tặng thưởng người livestream, không nạp tiền vào game, không đặt hàng bốc đầu"]},{"tag":"a","props":{"href":"/vi/tip/05-09"},"children":[{"tag":"span","props":{},"children":["09"]},"Con nạp tiền, tặng thưởng trên điện thoại: khoản chi lớn của trẻ từ tám tuổi trở lên, cha mẹ không chấp thuận thì có thể đòi lại"]},{"tag":"a","props":{"href":"/vi/tip/05-10"},"children":[{"tag":"span","props":{},"children":["10"]},"Dạy trẻ nhớ một câu: bất cứ ai bảo trẻ cầm điện thoại của cha mẹ ra thao tác, hoặc đọc mã xác minh, đều là kẻ lừa"]},{"tag":"a","props":{"href":"/vi/tip/05-11"},"children":[{"tag":"span","props":{},"children":["11"]},"Từ chối gói bảo hành mở rộng (延保) cho thiết bị điện tử"]},{"tag":"a","props":{"href":"/vi/tip/05-12"},"children":[{"tag":"span","props":{},"children":["12"]},"Ưu tiên thuốc generic đã đạt đánh giá tính nhất quán và thuốc trong gói đấu thầu tập trung"]},{"tag":"a","props":{"href":"/vi/tip/05-13"},"children":[{"tag":"span","props":{},"children":["13"]},"Làm một lần liên kết dùng chung tài khoản trên app bảo hiểm y tế, tiền trong tài khoản cá nhân của bảo hiểm y tế người lao động dùng được cho vợ chồng, cha mẹ, con cái"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/vi/tip/05-14","data-status":"active"},"children":[{"tag":"span","props":{},"children":["14"]},"Uống nước máy đun sôi, không đặt nước bình cho máy nước hay mua nước chai quanh năm"]},{"tag":"a","props":{"href":"/vi/tip/05-15"},"children":[{"tag":"span","props":{},"children":["15"]},"Đừng giao dịch cổ phiếu liên tục, thị trường lên rầm rộ rồi đổ sập thì càng phải ít ra tay hơn"]},{"tag":"a","props":{"href":"/vi/tip/05-16"},"children":[{"tag":"span","props":{},"children":["16"]},"Không vay tiền để đầu tư, không dùng đòn bẩy, không mua thứ mình không hiểu"]},{"tag":"a","props":{"href":"/vi/tip/05-17"},"children":[{"tag":"span","props":{},"children":["17"]},"Thay quỹ quản lý chủ động bằng quỹ chỉ số phạm vi rộng cho phần giữ dài hạn"]},{"tag":"a","props":{"href":"/vi/tip/05-18"},"children":[{"tag":"span","props":{},"children":["18"]},"Cùng một loại quỹ thì chọn quỹ có mức phí thấp"]},{"tag":"a","props":{"href":"/vi/tip/05-19"},"children":[{"tag":"span","props":{},"children":["19"]},"Đừng đặt hết tiền vào một cổ phiếu, một nền tảng, một căn nhà"]},{"tag":"a","props":{"href":"/vi/tip/05-20"},"children":[{"tag":"span","props":{},"children":["20"]},"Người nộp thuế thu nhập cá nhân và thuế suất đạt 10% trở lên mở tài khoản lương hưu cá nhân, mỗi năm tối đa 12.000 nhân dân tệ được khấu trừ trước thuế; người không nộp thuế hoặc thuế suất chỉ có 3% mở là không đáng"]},{"tag":"a","props":{"href":"/vi/tip/05-21"},"children":[{"tag":"span","props":{},"children":["21"]},"Phòng tập thì trả theo lượt hoặc theo chu kỳ ngắn, trừ khi bạn đã có hơn một năm đi đều đặn"]},{"tag":"a","props":{"href":"/vi/tip/05-22"},"children":[{"tag":"span","props":{},"children":["22"]},"Trả tiền trước phải ký hợp đồng bằng văn bản; người bán có rủi ro phải ngừng nhận tiền, trước khi bỏ chạy bạn có quyền đòi lại số dư chưa tiêu"]},{"tag":"a","props":{"href":"/vi/tip/05-23"},"children":[{"tag":"span","props":{},"children":["23"]},"Món mua lớn không thiết yếu thì đặt thời gian chờ, mua hàng trên mạng thì dùng luôn quyền trả hàng trong bảy ngày không cần lý do"]},{"tag":"a","props":{"href":"/vi/tip/05-24"},"children":[{"tag":"span","props":{},"children":["24"]},"Đừng tích trữ hàng vì giá gạch chéo và đợt khuyến mãi lớn"]},{"tag":"a","props":{"href":"/vi/tip/05-25"},"children":[{"tag":"span","props":{},"children":["25"]},"Bảo hiểm thì mua loại chỉ bảo vệ trước, coi「hoàn tiền」「chia lợi nhuận」là phần không được bảo đảm"]},{"tag":"a","props":{"href":"/vi/tip/05-26"},"children":[{"tag":"span","props":{},"children":["26"]},"Mua đủ bảo hiểm trách nhiệm dân sự bên thứ ba: hạn mức bảo hiểm bắt buộc thống nhất toàn quốc và không cao, phần vượt ra do túi bạn trả"]},{"tag":"a","props":{"href":"/vi/tip/05-27"},"children":[{"tag":"span","props":{},"children":["27"]},"Để dành trước khoản dự phòng bằng 3 đến 6 tháng chi phí, đặt ở chỗ rút ra được bất cứ lúc nào"]},{"tag":"a","props":{"href":"/vi/tip/05-28"},"children":[{"tag":"span","props":{},"children":["28"]},"Trước khi trả nợ vay mua nhà sớm, làm một bài so sánh, đừng theo cảm tính"]},{"tag":"a","props":{"href":"/vi/tip/05-29"},"children":[{"tag":"span","props":{},"children":["29"]},"Mua hàng trên mạng thì nhìn quy tắc của nền tảng và luật, không nghe người livestream, không tin「đánh giá tốt」"]},{"tag":"a","props":{"href":"/vi/tip/05-30"},"children":[{"tag":"span","props":{},"children":["30"]},"Hàng mua trong livestream có vấn đề, trước hết yêu cầu nền tảng cung cấp thông tin người bán và người livestream, nền tảng phải cung cấp"]},{"tag":"a","props":{"href":"/vi/tip/05-31"},"children":[{"tag":"span","props":{},"children":["31"]},"Mua phải thực phẩm không an toàn: ngoài hoàn tiền còn đòi được mười lần giá, khoản bồi thường thêm dưới một nghìn tệ thì tính bằng một nghìn tệ"]},{"tag":"a","props":{"href":"/vi/tip/05-32"},"children":[{"tag":"span","props":{},"children":["32"]},"Mua món đồ lớn thì tra thông báo kiểm tra mẫu quốc gia, chứng nhận 3C và nhãn tiết kiệm năng lượng trước"]},{"tag":"a","props":{"href":"/vi/tip/05-33"},"children":[{"tag":"span","props":{},"children":["33"]},"Vòng tay đá, ngọc, đồng hồ, đồ chơi thời trang: tính theo「số tiền đã tiêu」, không tính theo「số tiền để dành」"]},{"tag":"a","props":{"href":"/vi/tip/05-34"},"children":[{"tag":"span","props":{},"children":["34"]},"Ngọc và đá quý chỉ nhận báo cáo kiểm nghiệm có nhãn CMA, và tra cơ quan cấp giấy trên trang chính thức của cơ quan đó"]},{"tag":"a","props":{"href":"/vi/tip/05-35"},"children":[{"tag":"span","props":{},"children":["35"]},"Hộp mù, bài bốc ngẫu nhiên: tính theo「số tiền này sẽ không quay lại」"]},{"tag":"a","props":{"href":"/vi/tip/05-36"},"children":[{"tag":"span","props":{},"children":["36"]},"Quan tâm thực phẩm có thêm gì thì mua loại đóng gói sẵn: quầy hàng bán lẻ không bắt buộc ghi bảng thành phần"]},{"tag":"a","props":{"href":"/vi/tip/05-37"},"children":[{"tag":"span","props":{},"children":["37"]},"Cổ phiếu lỗ cũng phải bán theo quy tắc định trước, đừng trông chờ mua thêm để hạ giá vốn mà lật lời"]},{"tag":"a","props":{"href":"/vi/tip/05-38"},"children":[{"tag":"span","props":{},"children":["38"]},"Muốn mua tài sản nước ngoài như cổ phiếu Mỹ thì đi qua quỹ QDII hoặc kênh Hồng Kông, đừng mở tài khoản ở công ty chứng khoán nước ngoài, cũng đừng dùng hạn mức đổi tiền hằng năm để mua"]},{"tag":"a","props":{"href":"/vi/tip/05-39"},"children":[{"tag":"span","props":{},"children":["39"]},"Chỉ mua bảo hiểm cho loại tổn thất mà bạn không gánh nổi, tổn thất gánh nổi thì để khoản dự phòng đỡ"]},{"tag":"a","props":{"href":"/vi/tip/05-40"},"children":[{"tag":"span","props":{},"children":["40"]},"Nhà có người sống dựa vào thu nhập của bạn thì mua bảo hiểm nhân thọ có thời hạn cho người kiếm tiền trước, đừng mua cho con trước"]},{"tag":"a","props":{"href":"/vi/tip/05-41"},"children":[{"tag":"span","props":{},"children":["41"]},"Ký bảo hiểm nhân thọ trên một năm rồi hối hận, hủy trong thời hạn cân nhắc, tiền phí trả lại gần hết"]},{"tag":"a","props":{"href":"/vi/tip/05-42"},"children":[{"tag":"span","props":{},"children":["42"]},"Trước khi ký ở quầy ngân hàng, nhìn rõ trong tay là tiền gửi hay bảo hiểm"]},{"tag":"a","props":{"href":"/vi/tip/05-43"},"children":[{"tag":"span","props":{},"children":["43"]},"Muốn hủy bảo hiểm thì tự tìm công ty bảo hiểm làm, đừng tìm「đại lý hủy bảo hiểm」, nghĩ là mình bị hiểu sai rồi thì gọi 12378 khiếu nại"]},{"tag":"a","props":{"href":"/vi/tip/05-44"},"children":[{"tag":"span","props":{},"children":["44"]},"Ghi người thụ hưởng là một người cụ thể trên hợp đồng bảo hiểm, có chuyện thì nhớ đi nhận tiền: bảo hiểm nhân thọ trong 5 năm, bảo hiểm khác trong 2 năm phải thực hiện yêu cầu"]},{"tag":"a","props":{"href":"/vi/tip/05-45"},"children":[{"tag":"span","props":{},"children":["45"]},"Đừng bỏ tiền mua Bitcoin, Tether hay tiền mã hóa khác, người rủ đầu tư cũng đừng theo: giao dịch không được luật bảo vệ, lỗ rồi kiện cũng không đòi lại được"]},{"tag":"a","props":{"href":"/vi/tip/05-46"},"children":[{"tag":"span","props":{},"children":["46"]},"Không có đơn vị sử dụng lao động mà tự đóng bảo hiểm hưu trí người lao động: đóng mức thấp nhất và đủ số năm trước là có lợi nhất; không phải cứ đóng là có lời, ngay mức thấp nhất cũng phải nhận lương hưu khoảng 10 năm mới hoàn vốn"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"Breadcrumbs"},"children":[{"tag":"a","props":{"href":"/vi/book"},"children":["Khám phá cuốn sách"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/vi/book/05"},"children":["Chương 5"," ·"," ","Đừng phí tiền"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"05-14"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["14"]},{"tag":"span","props":{"className":"life-evidence grade-c（争议）"},"children":["Bằng chứng"," ","C（争议）"]}]},{"tag":"h1","props":{"lang":"vi"},"children":["Uống nước máy đun sôi, không đặt nước bình cho máy nước hay mua nước chai quanh năm"]},{"tag":"p","props":{"lang":"vi","className":"life-entry-summary"},"children":["Nước máy Bắc Kinh quy ra 0,005 tệ một lít. Nước bình dùng cho máy nước tính 20 tệ một bình thì khoảng 1 tệ một lít, đắt hơn 200 lần. Một gia đình uống một bình mỗi tuần, một năm tốn hơn 1000 tệ; cùng lượng nước máy chưa tới 5 tệ. Nước máy có tiêu chuẩn quốc gia bắt buộc, bình thường đun sôi uống là được. Nước hôi, đục thì đun không làm sạch được, phải dừng uống và phản ánh."]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Chi phí"]},{"tag":"p","props":{},"children":["Mua một ẩm. Mỗi lần đun nước tốn một ít thời gian, cộng th…"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Lợi ích"]},{"tag":"p","props":{},"children":["Giá nước dân dụng Bắc Kinh bậc một là 5 tệ một mét khối, quy ra 0,005 tệ một lít. Bình nước dùng cho máy nước…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"Đánh dấu: Uống nước máy đun sôi, không đặt nước bình cho máy nước hay mua nước chai quanh năm"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"Hoàn tất"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"Kế hoạch thực hiện"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"Lưu"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Chia sẻ mẹo này"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Ẩn chi tiết"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Chi phí"]},{"tag":"p","props":{},"children":["Mua một ẩm. Mỗi lần đun nước tốn một ít thời gian, cộng thêm chút tiền khí đốt hoặc tiền điện."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Lợi ích"]},{"tag":"p","props":{},"children":["Giá nước dân dụng Bắc Kinh bậc một là 5 tệ một mét khối, quy ra 0,005 tệ một lít. Bình nước dùng cho máy nước ở nhà có 18,9 lít, giả định 20 tệ một bình thì khoảng 1,06 tệ một lít, gấp khoảng 210 lần nước máy. Một gia đình uống một bình mỗi tuần, một năm 52 bình, khoảng 983 lít; nước bình khoảng 1040 tệ, cùng lượng nước máy khoảng 4,9 tệ. Nước chai nhỏ tính 1 tệ 500 mililít thì 2 tệ một lít, gấp 400 lần nước máy. Nước uống sinh hoạt tuân theo tiêu chuẩn quốc gia bắt buộc GB 5749-2022, ban hành ngày 15 tháng 3 năm 2022, có hiệu lực từ ngày 1 tháng 4 năm 2023. Cơ quan quản lý là Cục Kiểm soát và Phòng ngừa bệnh tật quốc gia (Trung Quốc, giá nước năm 2015 và tiêu chuẩn năm 2022)."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Nguồn gốc"]},{"tag":"p","props":{"className":"life-citations"},"children":["北京市发展和改革委员会. 居民用水价格表. ",{"tag":"a","props":{"href":"https://fgw.beijing.gov.cn/bmcx/djcx/jzldj/202003/t20200331_1752796.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://fgw.beijing.gov.cn/bmcx/djcx/jzldj/202003/t20200331_1752796.htm"]},"；国家市场监督管理总局 国家标准全文公开系统. GB 5749-2022 生活饮用水卫生标准. ",{"tag":"a","props":{"href":"https://openstd.samr.gov.cn/bzgk/std/newGbInfo?hcno=99E9C17E3547A3C0CE2FD1FFD9F2F7BE","target":"_blank","rel":"noopener noreferrer"},"children":["https://openstd.samr.gov.cn/bzgk/std/newGbInfo?hcno=99E9C17E3547A3C0CE2FD1FFD9F2F7BE"]},"；杭州市联合调查组 (2025). 关于杭州市余杭区部分小区供水异常调查情况通报（2025 年 7 月 23 日），新华网转载 ",{"tag":"a","props":{"href":"http://www.news.cn/20250723/1be62dac3b0b4461a643791ff552e93d/c.html","target":"_blank","rel":"noopener noreferrer"},"children":["http://www.news.cn/20250723/1be62dac3b0b4461a643791ff552e93d/c.html"]},"；杭州市余杭区人民政府. 余杭区 2025 年 4 月／5 月／6 月水源水水质监测数据（杭州余杭水务控股集团公开，检测单位杭州嘉澍环境监测有限公司，附件 PDF 表 1 第 24 项「粪大肠菌群」） ",{"tag":"a","props":{"href":"https://www.yuhang.gov.cn/art/2025/5/8/art_1229204072_59140140.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.yuhang.gov.cn/art/2025/5/8/art_1229204072_59140140.html"]},"、",{"tag":"a","props":{"href":"https://www.yuhang.gov.cn/art/2025/6/5/art_1229204072_59142885.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.yuhang.gov.cn/art/2025/6/5/art_1229204072_59142885.html"]},"、",{"tag":"a","props":{"href":"https://www.yuhang.gov.cn/art/2025/7/3/art_1229204072_59146464.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.yuhang.gov.cn/art/2025/7/3/art_1229204072_59146464.html"]},"；公安部网络安全保卫局 (2025). 编造虚假「警情通报」，捏造「粪水」谣言，邵某豪被刑事拘留 ",{"tag":"a","props":{"href":"http://www.news.cn/politics/20250722/3178b3bd189c4eb4b293982e92aab438/c.html","target":"_blank","rel":"noopener noreferrer"},"children":["http://www.news.cn/politics/20250722/3178b3bd189c4eb4b293982e92aab438/c.html"]},"；重庆市市场监督管理局 (2022). 桶装饮用水消费提示（2022 年 10 月 25 日） ",{"tag":"a","props":{"href":"https://scjgj.cq.gov.cn/bkzs/spbk/202210/t20221025_11222964.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://scjgj.cq.gov.cn/bkzs/spbk/202210/t20221025_11222964.html"]}]},{"tag":"a","props":{"href":"https://fgw.beijing.gov.cn/bmcx/djcx/jzldj/202003/t20200331_1752796.htm","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Liên kết mở nguồn"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Ghi chú sách"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["Tranh cãi ở chỗ «đạt chuẩn» kiểm tra nước ra khỏi nhà máy và nước ở cuối đường ống. Nguồn nước hoặc mạng cấp nước có sự cố thì có thể tạm thời không đạt. Ngày 16 tháng 7 năm 2025, nước thô vào nhà máy Renhe tại Yuhang, Hàng Châu có mùi bất thường, nước máy một số khu ở Renhe và Liangzhu có mùi hôi. Kết luận chính thức là tảo phân hủy trong điều kiện thiếu ôxy, tạo chất thioether. Sau khi đổi nguồn nước, không phát hiện coliform tổng số và Escherichia coli trong nước ra khỏi nhà máy, mọi chỉ tiêu đạt tiêu chuẩn GB 5749-2022. Sau đó 7 cán bộ bị truy trách nhiệm, miễn toàn bộ tiền nước tháng 7 và thay lõi lọc miễn phí. Nhưng coliform phân trong cùng nguồn nước đã tăng liên tục mấy tháng trước sự cố. Tại cửa lấy nước Yongsheng của sông Tiaoxi, tháng 4 là 10 trên lít, tháng 5 là 7300 trên lít, tháng 6 là 16000 trên lít. Giới hạn loại III của tiêu chuẩn nước mặt GB 3838 là 10000 trên lít. Cùng tháng, hồ Siling 28000 trên lít, hồ Mantoushan 24000 trên lít cũng vượt. Đun sôi chỉ diệt vi sinh vật, không loại bỏ chất tạo mùi hay hóa chất hòa tan trong nước. Có mùi lạ, nước vàng hoặc đục thì dừng uống, phản ánh với doanh nghiệp cấp nước và 12345, tạm uống nước chai; đừng mong đun thêm vài phút sẽ xử lý được. Nhưng đây là sự cố cục bộ, thỉnh thoảng xảy ra, địa phương cũng bồi thường theo sự việc, vẫn không là lý do mua nước chai quanh năm. Tin «nối nhầm ống nước phân» trên mạng là thông báo công an giả, người đăng đã bị tạm giữ hình sự (xem phần 9). Giá 20 tệ một bình và 1 tệ chai 500 mililít đều là giả định để tính tiền; hãy tính lại theo giá thực tế thành phố của bạn. Nước bình cũng không hẳn sạch hơn: Cục Giám sát và Quản lý thị trường Trùng Khánh nhắc rằng sau mở nắp, giữ càng lâu thì nguy cơ ô nhiễm vi sinh càng cao; máy nước phải rửa ít nhất một lần mỗi 2 đến 3 tháng. Cơ sở cấp nước thứ cấp ở khu cũ không đạt thì có thể lắp lọc, hoặc chỉ mua nước uống trong trường hợp ấy. Giá nước mỗi nơi khác nhau, số Bắc Kinh chỉ để thấy quy mô."]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Ghi chú của tôi"]},{"tag":"button","props":{"type":"button"},"children":["Viết một lời nhắc cho chính bạn…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/vi/tip/05-13"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Trước"]},"Làm một lần liên kết dùng chung tài khoản trên app bảo hiểm y tế, tiền trong tài khoản cá nhân của bảo hiểm y tế người lao động dùng được cho vợ chồng, cha mẹ, con cái"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/vi/tip/05-15"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Tiếp theo"]},"Đừng giao dịch cổ phiếu liên tục, thị trường lên rầm rộ rồi đổ sập thì càng phải ít ra tay hơn"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["Thêm trong chủ đề này"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/05-10"},"children":[{"tag":"strong","props":{},"children":["Dạy trẻ nhớ một câu: bất cứ ai bảo trẻ cầm điện thoại của cha mẹ ra thao tác, hoặc đọc mã xác minh, đều là kẻ lừa"]},{"tag":"span","props":{},"children":["Sáu loại lừa đảo này mỗi loại một kiểu, nhưng bước cuối luôn là một đ…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/05-11"},"children":[{"tag":"strong","props":{},"children":["Từ chối gói bảo hành mở rộng (延保) cho thiết bị điện tử"]},{"tag":"span","props":{},"children":["Gói bảo hành mở rộng thường được bán bằng 10% đến 50% giá gốc. Người …"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/05-12"},"children":[{"tag":"strong","props":{},"children":["Ưu tiên thuốc generic đã đạt đánh giá tính nhất quán và thuốc trong gói đấu thầu tập trung"]},{"tag":"span","props":{},"children":["Đợt đấu thầu thuốc thứ hai của quốc gia giảm giá trung bình 53%, loại…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi