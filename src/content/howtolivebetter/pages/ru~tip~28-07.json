hidden":"true"},"children":[{"tag":"path","props":{"d":"M18 20a6 6 0 0 0-12 0"},"children":[]},{"tag":"circle","props":{"cx":"12","cy":"10","r":"4"},"children":[]},{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},{"tag":"span","props":{},"children":["Войти"]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/ru/book/28"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"К содержанию"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["Не ломайте здоровье ради внешности"]},{"tag":"nav","props":{"aria-label":"Советы главы"},"children":[{"tag":"a","props":{"href":"/ru/tip/28-01"},"children":[{"tag":"span","props":{},"children":["01"]},"Не стоит прибегать к экстремальным диетам, голоданию или вызыванию рвоты для контроля веса — если хотите похудеть, делайте это с помощью физических упражнений"]},{"tag":"a","props":{"href":"/ru/tip/28-02"},"children":[{"tag":"span","props":{},"children":["02"]},"Прежде чем колоть, вживлять нити или ложиться под нож, проверьте две вещи: есть ли в лицензии учреждения пункт «косметологическая медицина» и является ли оперирующий лечащим врачом-специалистом (主诊医师资格)"]},{"tag":"a","props":{"href":"/ru/tip/28-03"},"children":[{"tag":"span","props":{},"children":["03"]},"При наполнении лица избегайте переносицы, межбровья и лба; тем более не ищите неофициальные инъекции ради экономии"]},{"tag":"a","props":{"href":"/ru/tip/28-04"},"children":[{"tag":"span","props":{},"children":["04"]},"Таблетки для похудения, «жиросжигающий» кофе, конфеты для стройности и «энзимные» сливы (сливы, якобы вымоченные в энзимах) с обещанием «быстро похудеть» — не покупать"]},{"tag":"a","props":{"href":"/ru/tip/28-05"},"children":[{"tag":"span","props":{},"children":["05"]},"Анаболические стероиды («уколы для массы», «таблетки») — не средство нарастить мышцы"]},{"tag":"a","props":{"href":"/ru/tip/28-06"},"children":[{"tag":"span","props":{},"children":["06"]},"Если хотите препарат для похудения — идите в больницу за рецептом, а не покупайте в интернет-магазине, который отправляет без рецепта"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/ru/tip/28-07","data-status":"active"},"children":[{"tag":"span","props":{},"children":["07"]},"Половые гормоны применяйте только по назначению врача и с регулярными повторными обследованиями; не покупайте через интернет и не увеличивайте дозу сами"]},{"tag":"a","props":{"href":"/ru/tip/28-08"},"children":[{"tag":"span","props":{},"children":["08"]},"Если «кажется, что я уродлив» уже дошло до постоянных разглядываний в зеркале и навязчивых мыслей об исправлении, сначала пройдите оценку образа тела и только потом говорите об операции"]},{"tag":"a","props":{"href":"/ru/tip/28-09"},"children":[{"tag":"span","props":{},"children":["09"]},"Для исправления прикуса обратитесь очно к врачу с ортодонтической квалификацией и регулярно приходите на контроль; не покупайте элайнеры онлайн для самостоятельного ношения дома"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"Навигация"},"children":[{"tag":"a","props":{"href":"/ru/book"},"children":["Книга"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/ru/book/28"},"children":["Глава 28"," ·"," ","Не ломайте здоровье ради внешности"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"28-07"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["07"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["Доказательства"," ","A"]}]},{"tag":"h1","props":{"lang":"ru"},"children":["Половые гормоны применяйте только по назначению врача и с регулярными повторными обследованиями; не покупайте через интернет и не увеличивайте дозу сами"]},{"tag":"p","props":{"lang":"ru","className":"life-entry-summary"},"children":["Этот пункт не обсуждает, стоит ли применять, — он о том, как применять. В исследовании трансгендерных людей со средним сроком наблюдения около четырёх лет у трансгендерных женщин (у подавляющего большинства — терапия эстрогенами) венозных тромбов было заметно больше, чем у ровесников из контроля: за два года на тысячу человек приходится 4.1 лишнего случая, за восемь — 16.7; у тех, кто начал терапию уже в период наблюдения, разница по тромбам и ишемическому инсульту ещё заметнее; по инфарктам в целом различий не увидели. Суть в том, что тромбы — то, что можно проверять и предупреждать заранее, но только если есть кто-то, кто проверяет регулярно; на пути «купить в интернете и самому подогнать дозу» такого человека как раз нет."]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Затраты"]},{"tag":"p","props":{},"children":["Регулярные записи на приём и повторная сдача крови — неско…"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Польза"]},{"tag":"p","props":{},"children":["База электронных медицинских карт Kaiser Permanente (2,842 трансгендерных женщины и 2,118 трансгендерных мужчи…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"Отметить: Половые гормоны применяйте только по назначению врача и с регулярными повторными обследованиями; не покупайте через интернет и не увеличивайте дозу сами"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"Сделано"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"В планах"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"В избранное"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Поделиться советом"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Скрыть подробности"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Затраты"]},{"tag":"p","props":{},"children":["Регулярные записи на приём и повторная сдача крови — несколько сотен юаней и несколько полудней в год"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Польза"]},{"tag":"p","props":{},"children":["База электронных медицинских карт Kaiser Permanente (2,842 трансгендерных женщины и 2,118 трансгендерных мужчин, среднее наблюдение 4.0 и 3.6 года; к каждой группе подобрано примерно в 10 раз больше цисгендерных контролей по году рождения, расе, месту наблюдения и времени включения — всего 48 686 цисгендерных мужчин и 48 775 цисгендерных женщин): разница рисков венозной тромбоэмболии у трансгендерных женщин за 2 и 8 лет относительно цисгендерных мужчин — 4.1 (95% CI 1.6–6.7) и 16.7 (6.4–27.5) на 1000 человек, относительно цисгендерных женщин — 3.4 (1.1–5.6) и 13.7 (4.1–22.7); по ишемическому инсульту и инфаркту миокарда в целом группы близки, но у трансгендерных женщин, начавших гормональную терапию в период наблюдения, различия по венозным тромбам и ишемическому инсульту более выражены; по трансгендерным мужчинам этих недостаточно для выводов. Вывод авторов: «эти результаты могут указывать на необходимость долгосрочной настороженности в отношении сосудистых побочных эффектов эстрогенов при трансгендерной гормональной терапии»"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Первоисточники"]},{"tag":"p","props":{"className":"life-citations"},"children":["Getahun D et al. (2018). Cross-sex Hormones and Acute Cardiovascular Events in Transgender Persons: A Cohort Study. Ann Intern Med. ",{"tag":"a","props":{"href":"https://doi.org/10.7326/M17-2785","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.7326/M17-2785"]},"；国家市场监督管理总局 (2022). 药品网络销售监督管理办法（总局令第 58 号，第九条）. ",{"tag":"a","props":{"href":"https://www.gov.cn/gongbao/content/2022/content_5717002.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/gongbao/content/2022/content_5717002.htm"]}]},{"tag":"a","props":{"href":"https://doi.org/10.7326/M17-2785","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Открыть источник"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Примечание автора"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["Само исследование указывает на своё ограничение: невозможно узнать, сколько людей получало препараты вне системы, поэтому деление на «принимающих и не принимающих» изначально нечистое — и это как раз объясняет, почему приём должен быть включён в регулярное наблюдение. Исследование мерило сосудистые события и не оценивает показания и пользу самой гормональной терапии — это другой пласт доказательств. То же правило распространяется на все случаи применения половых гормонов: контрацептивы, гормональная терапия в климактерическом периоде, заместительный приём тестостерона; где препарат куплен в интернете, доза сверяется по интернет-постам, тромбы и показатели печени и почек не проверяются, — риск возникает именно на отрезке «никто не наблюдает», а не в мотиве приёма. Нормальный путь в Китае — оценка, назначение и наблюдение в эндокринологическом или профильном отделении официального медицинского учреждения. 〔17〕"]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Моя заметка"]},{"tag":"button","props":{"type":"button"},"children":["Запишите напоминание…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/ru/tip/28-06"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Предыдущий"]},"Если хотите препарат для похудения — идите в больницу за рецептом, а не покупайте в интернет-магазине, который отправляет без рецепта"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/ru/tip/28-08"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Следующий"]},"Если «кажется, что я уродлив» уже дошло до постоянных разглядываний в зеркале и навязчивых мыслей об исправлении, сначала пройдите оценку образа тела и только потом говорите об операции"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["Другие советы по этой теме"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/28-01"},"children":[{"tag":"strong","props":{},"children":["Не стоит прибегать к экстремальным диетам, голоданию или вызыванию рвоты для контроля веса — если хотите похудеть, делайте это с помощью физических упражнений"]},{"tag":"span","props":{},"children":["У людей с нервной анорексией смертность примерно в 5,9 раз выше, чем …"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/28-02"},"children":[{"tag":"strong","props":{},"children":["Прежде чем колоть, вживлять нити или ложиться под нож, проверьте две вещи: есть ли в лицензии учреждения пункт «косметологическая медицина» и является ли оперирующий лечащим врачом-специалистом (主诊医师资格)"]},{"tag":"span","props":{},"children":["Всё, что связано с операцией, уколом, применением медицинских изделий…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/28-03"},"children":[{"tag":"strong","props":{},"children":["При наполнении лица избегайте переносицы, межбровья и лба; тем более не ищите неофициальные инъекции ради экономии"]},{"tag":"span","props":{},"children":["Филлер попадает в сосуд лица, ток крови несёт его обратно, он закупор…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/28-04"},"children":[{"tag":"strong","props":{},"children":["Таблетки для похудения, «жиросжигающий» кофе, конфеты для стройности и «энзимные» сливы (сливы, якобы вымоченные в энзимах) с обещанием «быстро похудеть» — не покупать"]},{"tag":"span","props":{},"children":["Самый часто обнаруживаемый незаконно добавляемый компонент в таких пр…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/28-05"},"children":[{"tag":"strong","props":{},"children":["Анаболические стероиды («уколы для массы», «таблетки») — не средство нарастить мышцы"]},{"tag":"span","props":{},"children":["В Дании отследили 545 человек, у которых тест на допинг в фитнес-клуб…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/28-09"},"children":[{"tag":"strong","props":{},"children":["Для исправления прикуса обратитесь очно к врачу с ортодонтической квалификацией и регулярно приходите на контроль; не покупайте элайнеры онлайн для самостоятельного ношения дома"]},{"tag":"span","props":{},"children":["Прозрачные элайнеры в Китае относятся к медицинским изделиям II класс…"]}]}]}]},{"tag":"a","props":{"className":"life-text-link","href":"/ru/book/28"