en":[]},{"tag":"path","props":{"d":"M20 12h2"},"children":[]},{"tag":"path","props":{"d":"m6.34 17.66-1.41 1.41"},"children":[]},{"tag":"path","props":{"d":"m19.07 4.93-1.41 1.41"},"children":[]}]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"17","height":"17","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-moon life-theme-icon-dark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"},"children":[]}]}]},{"tag":"button","props":{"type":"button","className":"life-language-switch","aria-label":"Русский Выбрать язык","aria-haspopup":"menu","aria-expanded":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-globe","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]},{"tag":"path","props":{"d":"M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"},"children":[]},{"tag":"path","props":{"d":"M2 12h20"},"children":[]}]},{"tag":"span","props":{},"children":["Русский"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]}]},{"tag":"a","props":{"className":"life-account","href":"/ru/sign-in"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"17","height":"17","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle-user-round","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M18 20a6 6 0 0 0-12 0"},"children":[]},{"tag":"circle","props":{"cx":"12","cy":"10","r":"4"},"children":[]},{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},{"tag":"span","props":{},"children":["Войти"]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/ru/book/27"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"К содержанию"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["Беременность и роды: от обнаружения беременности до выписки из больницы и оформления документов"]},{"tag":"nav","props":{"aria-label":"Советы главы"},"children":[{"tag":"a","props":{"href":"/ru/tip/27-01"},"children":[{"tag":"span","props":{},"children":["01"]},"Подготовка к беременности: начните принимать по 0,4 мг фолиевой кислоты ежедневно за три месяца до зачатия и продолжайте до начала второго триместра"]},{"tag":"a","props":{"href":"/ru/tip/27-02"},"children":[{"tag":"span","props":{},"children":["02"]},"Оформление «Книжки здоровья матери и ребёнка» в общественной медицинской службе до 13-й недели беременности позволяет воспользоваться бесплатными осмотрами"]},{"tag":"a","props":{"href":"/ru/tip/27-03"},"children":[{"tag":"span","props":{},"children":["03"]},"Первый скрининг во время беременности позволяет выявить ВИЧ, сифилис и гепатит В; при положительном результате предоставляется бесплатная профилактика"]},{"tag":"a","props":{"href":"/ru/tip/27-04"},"children":[{"tag":"span","props":{},"children":["04"]},"Во время всей беременности не стоит курить и пить — и членам семьи тоже нельзя курить в доме"]},{"tag":"a","props":{"href":"/ru/tip/27-05"},"children":[{"tag":"span","props":{},"children":["05"]},"Женщинам с факторами риска преэклампсии после 12-й недели беременности следует принимать по одной таблетке низкодозированной аспирина в день"]},{"tag":"a","props":{"href":"/ru/tip/27-06"},"children":[{"tag":"span","props":{},"children":["06"]},"Скрининг на гестационный диабет после 24-й недели беременности — не стоит бояться процедуры с сахарным раствором"]},{"tag":"a","props":{"href":"/ru/tip/27-07"},"children":[{"tag":"span","props":{},"children":["07"]},"Запомните этот список «Срочно в больницу» — он актуален как во время беременности, так и в течение года после родов"]},{"tag":"a","props":{"href":"/ru/tip/27-08"},"children":[{"tag":"span","props":{},"children":["08"]},"При разрыве плодных оболочек нужно лечь на спину, приподнять таз и вызвать скорую — не ходить и не принимать душ"]},{"tag":"a","props":{"href":"/ru/tip/27-09"},"children":[{"tag":"span","props":{},"children":["09"]},"Если хотите эпидуральную анальгезию, просто скажите об этом — она не повышает риск кесарева сечения"]},{"tag":"a","props":{"href":"/ru/tip/27-10"},"children":[{"tag":"span","props":{},"children":["10"]},"Не стоит самостоятельно требовать кесарево сечение без медицинских показаний, а также не стоит назначать операцию ради выбора конкретной даты"]},{"tag":"a","props":{"href":"/ru/tip/27-11"},"children":[{"tag":"span","props":{},"children":["11"]},"Проверьте статус участия в программе медстраховки для беременных заранее — даже супруга без работы сможет получить компенсацию расходов на роды"]},{"tag":"a","props":{"href":"/ru/tip/27-12"},"children":[{"tag":"span","props":{},"children":["12"]},"Оформите «Свидетельство о рождении» до выписки из больницы, заранее продумайте имя ребёнка и не допустите опечаток"]},{"tag":"a","props":{"href":"/ru/tip/27-13"},"children":[{"tag":"span","props":{},"children":["13"]},"Не отказывайтесь от скрининга крови из пяточки и проверки слуха у новорожденных"]},{"tag":"a","props":{"href":"/ru/tip/27-14"},"children":[{"tag":"span","props":{},"children":["14"]},"Оформите медстраховку для ребенка сразу после получения свидетельства о рождении — не ждите регистрации по месту жительства"]},{"tag":"a","props":{"href":"/ru/tip/27-15"},"children":[{"tag":"span","props":{},"children":["15"]},"Регистрация рождения ребенка в отделении полиции в течение месяца после появления на свет"]},{"tag":"a","props":{"href":"/ru/tip/27-16"},"children":[{"tag":"span","props":{},"children":["16"]},"Не пропускайте плановый осмотр на 42-й день после родов — он служит и скринингом на послеродовую депрессию"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/ru/tip/27-17","data-status":"active"},"children":[{"tag":"span","props":{},"children":["17"]},"При беременности кошку отдавать не нужно: лоток пусть чистит кто-то другой каждый день, мясо готовьте до полной готовности, с землёй работайте в перчатках"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"Навигация"},"children":[{"tag":"a","props":{"href":"/ru/book"},"children":["Книга"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/ru/book/27"},"children":["Глава 27"," ·"," ","Беременность и роды: от обнаружения беременности до выписки из больницы и оформления документов"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"27-17"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["17"]},{"tag":"span","props":{"className":"life-evidence grade-b"},"children":["Доказательства"," ","B"]}]},{"tag":"h1","props":{"lang":"ru"},"children":["При беременности кошку отдавать не нужно: лоток пусть чистит кто-то другой каждый день, мясо готовьте до полной готовности, с землёй работайте в перчатках"]},{"tag":"p","props":{"lang":"ru","className":"life-entry-summary"},"children":["Токсоплазма — это паразит. Если заразиться им впервые во время беременности, возможен выкидыш, а у ребёнка могут пострадать глаза и мозг. Кошка в доме вероятность заражения не повышает, поэтому отдавать её не нужно. Опаснее недожаренное мясо и работа с землёй без мытья рук. Лоток достаточно поручить кому-то другому каждый день."]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Затраты"]},{"tag":"p","props":{},"children":["Бесплатно. Лоток каждый день чистит кто-то из домашних. Ес…"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Польза"]},{"tag":"p","props":{},"children":["Американский Центр по контролю и профилактике заболеваний (CDC) сообщает, что первичное заражение токсоплазмой…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"Отметить: При беременности кошку отдавать не нужно: лоток пусть чистит кто-то другой каждый день, мясо готовьте до полной готовности, с землёй работайте в перчатках"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"Сделано"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"В планах"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"В избранное"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Поделиться советом"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Скрыть подробности"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Затраты"]},{"tag":"p","props":{},"children":["Бесплатно. Лоток каждый день чистит кто-то из домашних. Если больше некому, купите упаковку одноразовых перчаток. Трудность в другом: мясо нужно есть только полностью прожаренным, никакого стейка с кровью и недожаренной баранины."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Польза"]},{"tag":"p","props":{},"children":["Американский Центр по контролю и профилактике заболеваний (CDC) сообщает, что первичное заражение токсоплазмой незадолго до беременности или во время неё передаётся плоду. У большинства инфицированных детей при рождении симптомов нет, но позже они могут ослепнуть или получить интеллектуальную инвалидность. У немногих детей тяжёлое поражение глаз или мозга есть уже при рождении. Национальная служба здравоохранения Великобритании (NHS) сообщает, что заражение при беременности может привести к выкидышу. Центр диагностики токсоплазмоза в Лионе (Франция) учёл 603 женщины с подтверждённым заражением во время беременности, большинство из них принимали противопаразитарные препараты. Общая доля случаев, когда инфекция передалась плоду, — 29% (95% ДИ 25–33, доверительный интервал). При заражении на 13-й неделе плоду передавалось около 6% случаев, на 36-й неделе — около 72%. Чем раньше заражение, тем выше вероятность, что у ребёнка появятся симптомы. Самый высокий риск ранних симптомов у ребёнка, около 10%, был при заражении на сроке от 24 до 30 недель. В шести европейских городах сравнили беременных с новым заражением и без него. Кошка в доме: ОШ 1,0 (95% ДИ 0,7–1,5), разницы нет. Самостоятельная уборка лотка: ОШ 1,3 (95% ДИ 0,8–2,1), разница может быть случайной. Недожаренная баранина: ОШ 3,13 (95% ДИ 1,4–7,2), риск примерно в 3 раза выше, чем у тех, кто её не ел. Контакт с землёй: ОШ 1,81 (95% ДИ 1,2–2,7), примерно на 80% выше. В разных городах от 30% до 63% случаев заражения удавалось отнести на счёт недожаренного или солёного и вяленого мяса, а от 6% до 17% — на счёт контакта с землёй. Рекомендации CDC для беременных: если лоток может поменять кто-то другой, пусть меняет он. Если некому, наденьте одноразовые перчатки, а после уборки вымойте руки с мылом. Менять наполнитель нужно каждый день, потому что паразиту в кошачьем кале нужно от 1 до 5 дней, чтобы стать заразным. Во время беременности не заводите новую кошку, не берите и не гладьте бездомных кошек, особенно котят. Кошку держите дома и кормите только кормом или варёной едой, без сырого мяса. В материале китайского CDC тоже сказано, что будущему отцу лучше взять уборку лотка на себя, а при соблюдении мер предосторожности кошку можно оставить. NHS прямо пишет, что погладить кошку или держать её дома — не способ заразиться токсоплазмозом."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Первоисточники"]},{"tag":"p","props":{"className":"life-citations"},"children":["Centers for Disease Control and Prevention. Toxoplasmosis: Risk Factors. ",{"tag":"a","props":{"href":"https://www.cdc.gov/toxoplasmosis/risk-factors/index.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.cdc.gov/toxoplasmosis/risk-factors/index.html"]},"；Centers for Disease Control and Prevention. Preventing Toxoplasmosis. ",{"tag":"a","props":{"href":"https://www.cdc.gov/toxoplasmosis/prevention/index.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.cdc.gov/toxoplasmosis/prevention/index.html"]},"；NHS. Toxoplasmosis. ",{"tag":"a","props":{"href":"https://www.nhs.uk/conditions/toxoplasmosis/","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.nhs.uk/conditions/toxoplasmosis/"]},"；中国疾病预防控制中心 (2025). 孕期弓形虫感染，都是「吸猫」惹的祸吗？ ",{"tag":"a","props":{"href":"https://www.chinacdc.cn/jkkp/crb/qtcr/202501/t20250103_303681.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.chinacdc.cn/jkkp/crb/qtcr/202501/t20250103_303681.html"]},"；Cook AJ, Gilbert RE, Buffolano W, et al. (2000). Sources of toxoplasma infection in pregnant women: European multicentre case-control study. BMJ, 321(7254), 142-147. ",{"tag":"a","props":{"href":"https://doi.org/10.1136/bmj.321.7254.142","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1136/bmj.321.7254.142"]},"；Dunn D, Wallon M, Peyron F, Petersen E, Peckham C, Gilbert R (1999). Mother-to-child transmission of toxoplasmosis: risk estimates for clinical counselling. Lancet, 353(9167), 1829-1833. ",{"tag":"a","props":{"href":"https://doi.org/10.1016/s0140-6736(98)08220-8","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1016/s0140-6736(98)08220-8"]}]},{"tag":"a","props":{"href":"https://www.cdc.gov/toxoplasmosis/risk-factors/index.html","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Открыть источник"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Примечание автора"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["Кошка обычно выделяет токсоплазму с калом лишь несколько недель после первого заражения. Взрослая кошка, уже болевшая раньше, выделяет её ещё реже. Кошка, которая живёт дома и не ест сырого мяса, и заразиться-то вряд ли успеет. Заразиться можно и без кошки: источники — недожаренное мясо, немытые овощи и фрукты, земля, загрязнённая кошачьим калом, и сырая вода. Поэтому делайте так: готовьте мясо до полной готовности, а нож, доску и руки после сырого мяса мойте; овощи и фрукты промывайте под проточной водой; для работы в саду и с землёй надевайте перчатки и потом мойте руки. NHS также советует не есть сырокопчёные и вяленые мясные изделия вроде салями и пармской ветчины и не пить непастеризованное козье молоко. Европейское исследование подробно не спрашивало про салат и немытые овощи, и в 14–49% случаев источник заражения найти не удалось. Нужно ли сдавать анализ на антитела к токсоплазме, спросите у врача, ведущего беременность. Уровень B выставлен потому, что цифры риска для кошек и мяса получены в одном исследовании и со слов участниц уже после заражения. Рекомендации взяты у официальных организаций, а исследований о том, насколько им следование снижает число заражений, нет. Оценка «средний» для эффекта — суждение автора, обоснование в записи о проверке. Польза достаётся вам и ребёнку."]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Моя заметка"]},{"tag":"button","props":{"type":"button"},"children":["Запишите напоминание…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/ru/tip/27-16"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Предыдущий"]},"Не пропускайте плановый осмотр на 42-й день после родов — он служит и скринингом на послеродовую депрессию"]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["Другие советы по этой теме"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/27-10"},"children":[{"tag":"strong","props":{},"children":["Не стоит самостоятельно требовать кесарево сечение без медицинских показаний, а также не стоит назначать операцию ради выбора конкретной даты"]},{"tag":"span","props":{},"children":["Согласно данным Всемирной организации здравоохранения, когда доля кес…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/27-11"},"children":[{"tag":"strong","props":{},"children":["Проверьте статус участия в программе медстраховки для беременных заранее — даже супруга без работы сможет получить компенсацию расходов на роды"]},{"tag":"span","props":{},"children":["Если ваш работодатель платит взносы в программу медстраховки, то расх…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/27-12"},"children":[{"tag":"strong","props":{},"children":["Оформите «Свидетельство о рождении» до выписки из больницы, заранее продумайте имя