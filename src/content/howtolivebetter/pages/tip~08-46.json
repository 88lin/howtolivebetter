e":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"加入待做"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"收藏"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"分享这条建议"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"收起详情"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["成本"]},{"tag":"p","props":{"className":"life-citations"},"children":["门锁换成要用钥匙才能反锁的，窗户加锁，门外装一盏感应灯，一般几十到几百元。换整扇防盗门要上千元。难在每次出门都真的锁上门窗，夏天开着窗时也要记得。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["收益"]},{"tag":"p","props":{"className":"life-citations"},"children":["英格兰和威尔士的犯罪调查，问了 2008 到 2012 年间 37416 户人家装了哪些防盗设施。再拿这些人家和被盗的人家比。什么都没装的只占全部人家的 4.9%，却占了被人进屋偷东西人家的 36.6%。作者算的是「保护倍数」：被盗几率是什么都没装人家的几分之一。门锁加窗锁是 12.54 倍，被盗几率降到约十二分之一。这里的门锁指双锁或者「死锁」（锁舌要用钥匙才能收回）。门锁、窗锁再加门外的感应灯或定时灯，是 34.41 倍。再加屋里的定时灯，是 49 倍。只装一样的，门外灯约 3 倍，门锁约 2.8 倍。单装窗锁看不出差别。装五样的，并不比装对了的三样强。只装报警器、别的都不装，被盗几率反而比什么都没装的高。挂假报警器盒子的，有人想闯进来没闯成的几率也更高。锁要真锁上才算数。撬锁、砸窗、拆门板进屋的盗窃，1993 到 2006/07 年从每千户 31 起降到 7 起。降了 77%。门窗没锁、直接走进去的那种，一直是每千户 7 起，没降（英格兰和威尔士）"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["来源"]},{"tag":"p","props":{"className":"life-citations"},"children":["Tseloni A, Thompson R, Grove L, Tilley N, Farrell G (2017). The effectiveness of burglary security devices. Security Journal 30(2):646–664. ",{"tag":"a","props":{"href":"https://doi.org/10.1057/sj.2014.30","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1057/sj.2014.30"]},"；Tilley N, Thompson R, Farrell G, Grove L, Tseloni A (2015). Do burglar alarms increase burglary risk? A counter-intuitive finding and possible explanations. Crime Prevention and Community Safety 17(1):1–19. ",{"tag":"a","props":{"href":"https://doi.org/10.1057/cpcs.2014.17","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1057/cpcs.2014.17"]},"；Tseloni A, Farrell G, Thompson R, Evans E, Tilley N (2017). Domestic burglary drop and the security hypothesis. Crime Science 6:3. ",{"tag":"a","props":{"href":"https://doi.org/10.1186/s40163-017-0064-2","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1186/s40163-017-0064-2"]},"；国家市场监督管理总局、国家标准化管理委员会 (2022). GB 17565-2022 防盗安全门通用技术条件. ",{"tag":"a","props":{"href":"https://openstd.samr.gov.cn/bzgk/gb/newGbInfo?hcno=A75C1C66CB989D0A40BFA7A262C93290","target":"_blank","rel":"noopener noreferrer"},"children":["https://openstd.samr.gov.cn/bzgk/gb/newGbInfo?hcno=A75C1C66CB989D0A40BFA7A262C93290"]},"；全国人大 (2020). 民法典（第七百一十五条）. ",{"tag":"a","props":{"href":"https://www.spp.gov.cn/spp/fl/202006/t20200602_463888.shtml","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.spp.gov.cn/spp/fl/202006/t20200602_463888.shtml"]},""]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["原书备注"]},{"tag":"p","props":{"className":"life-citations"},"children":["争议：报警器那一半有反方数据。同一批作者用 1992 到 1996 年的数据算过，那时加装报警器是能降低被盗几率的。作者也说这个反常结果要谨慎看待，一种可能是被偷过的人家才去装报警器。所有数字都是英国的，而且只是比较装了和没装的人家，没有分组对照，所以给 B。这些数字只管入室盗窃，没有数据说门锁能挡住入室抢劫。真遇到有人在家里，先退开报警，见第 10 条（起了冲突先报警不动手）。退无可退时，见第 11 条（躲不掉的侵害可以还手）。租房的，换锁、加窗锁先跟房东说好。民法典规定，租客没经房东同意就加装、改装，房东可以要求恢复原状或者赔偿。防盗安全门有强制性国家标准 GB 17565-2022，2024 年 1 月 1 日起实施。买的时候可以看一眼。受益人主要是你自己和家人。"]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["我的备注"]},{"tag":"button","props":{"type":"button"},"children":["写下对自己有用的提醒…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/tip/08-45"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["上一条"]},"熟人让你「帮忙刷个脸、做个见证」去办贷款，或者要你念验证码，别答应：这叫 AB 贷，借款人是你，不是担保人"]}]},{"tag":"span","props":{},"children":[]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["本主题的其他建议"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/08-39"},"children":[{"tag":"strong","props":{},"children":["报警当场要受案回执，不立案要书面通知：7 日内可申请复议，再 7 日可申请复核，检察院能通知公安立案"]},{"tag":"span","props":{},"children":["报了警要当场拿到受案回执，这是你报过案的凭据。公安决定不立案，应当给你书面的不予立案通知书。不服可以 7 日内申请复议，还不服再 7 日内申请复核。你也可以找检…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/08-40"},"children":[{"tag":"strong","props":{},"children":["别给办案、执法的人送钱送卡：行贿自己也判，对监察、执法、司法人员行贿还要从重"]},{"tag":"span","props":{},"children":["「花点钱把事摆平」在刑法里是独立的罪，送钱的也要判。行贿判 3 年以下，情节严重的判 3 到 10 年，特别严重的判 10 年以上或者无期。对监察、行政执法、司…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/08-41"},"children":[{"tag":"strong","props":{},"children":["可能翻脸的电话和面谈，直接开录音：自己参加的谈话，不用先征得对方同意"]},{"tag":"span","props":{},"children":["借钱、欠款、赔偿、退款、劳动纠纷，电话里说清楚了却没留下东西，几个月后双方就可能各说一套。你自己参加的谈话可以录下来，没提前告诉对方，不会单凭这一点就不能当证据…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/08-42"},"children":[{"tag":"strong","props":{},"children":["现场出了事，先拍全景，再拍位置关系，最后拍损坏和伤情，原图原视频别删"]},{"tag":"span","props":{},"children":["只对着车上一道划痕或者地上一件东西拍特写，过几天没人知道它原来在哪。先拍一段全景，把路口、门牌、车、人和周围都收进去，再拍相互位置，最后拍细节。要挪动东西或者车…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/08-43"},"children":[{"tag":"strong","props":{},"children":["被家暴了：先报警留下出警记录，再去法院申请人身安全保护令，不用先离婚，也不收费"]},{"tag":"span","props":{},"children":["按多国的数据，被杀害的女性三分之一以上是伴侣下的手，往往是长期家暴的结局。同样挨打的女性里，被掐过脖子的，被杀的几率是没被掐过的 7 倍多。所以挨了打就报警，再…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/08-44"},"children":[{"tag":"strong","props":{},"children":["家里人赌博欠了债，别急着替他还：赌债法律不保护，为赌借的钱也不算夫妻共同债务"]},{"tag":"span","props":{},"children":["在赌桌上欠的钱，法院不保护。债主明知他借钱去赌还借给他，这笔钱法院也不保护。一方为了赌博借的钱，不能算成两口子一起还的债。没经过审判，法院不能让没借钱的一方替他…"]}]}]}]},{"tag":"a","props":{"className":"life-text-link","href":"/book/08"},"children":["阅读整个主题：别把自己搭进去：法律与财产安全 ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"15","height":"15","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]}]}]},{"tag":"nav","props":{"className":"life-tabbar","aria-label":"主导航"},"children":[{"tag":"a","props":{"className":"","href":"/book"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"21","height":"21","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-book-open","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M12 7v14"},"children":[]},{"tag":"path","props":{"d":"M3 18a1 1 0 0 1-1-1V4a1 1 0 0 