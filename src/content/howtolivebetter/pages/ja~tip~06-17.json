tag":"span","props":{},"children":["08"]},"リストバンドやスマートウォッチによる運動量の数値化で減量できると期待しないでください"]},{"tag":"a","props":{"href":"/ja/tip/06-09"},"children":[{"tag":"span","props":{},"children":["09"]},"「より健康に」なるために、割高なオーガニック食品を買わないでください"]},{"tag":"a","props":{"href":"/ja/tip/06-10"},"children":[{"tag":"span","props":{},"children":["10"]},"「体調を整える」ために、サプリメントや膏方、滋養食品に大金を投じない"]},{"tag":"a","props":{"href":"/ja/tip/06-11"},"children":[{"tag":"span","props":{},"children":["11"]},"腸の問題がない限り、プロバイオティクスを長期的に摂取しない"]},{"tag":"a","props":{"href":"/ja/tip/06-12"},"children":[{"tag":"span","props":{},"children":["12"]},"「免疫力を高める」ために、無理に冷水シャワーを浴びない"]},{"tag":"a","props":{"href":"/ja/tip/06-13"},"children":[{"tag":"span","props":{},"children":["13"]},"デトックス、腸洗浄、酵素、アルカリ水などの製品を買わないでください"]},{"tag":"a","props":{"href":"/ja/tip/06-14"},"children":[{"tag":"span","props":{},"children":["14"]},"「毎日 8 杯の水を飲む」という目標を満たすために、無理に水を飲まないでください"]},{"tag":"a","props":{"href":"/ja/tip/06-15"},"children":[{"tag":"span","props":{},"children":["15"]},"占いやタロット、星座占いで決断を下すために、お金を使わないでください"]},{"tag":"a","props":{"href":"/ja/tip/06-16"},"children":[{"tag":"span","props":{},"children":["16"]},"「視力を守る」ためにブルーライトカット眼鏡を買わないでください。また「数ヶ月画面を見続けると目がダメになる」という言葉も信じないでください。ただし、目の張り、痛み、充血は緊急事態として扱うべきです"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/ja/tip/06-17","data-status":"active"},"children":[{"tag":"span","props":{},"children":["17"]},"献血を健康法と考えないでください：「デトックス、血中脂質低下、心筋梗塞予防」を裏付けるランダム化比較試験はありません。頻繁な献血は、本当に鉄欠乏を引き起こします"]},{"tag":"a","props":{"href":"/ja/tip/06-18"},"children":[{"tag":"span","props":{},"children":["18"]},"一般的な健康診断パッケージに頼って病気を防ごうとせず、年齢と性別に基づいた、エビデンスのある検査項目を受けましょう"]},{"tag":"a","props":{"href":"/ja/tip/06-19"},"children":[{"tag":"span","props":{},"children":["19"]},"尿酸値が高いと診断されても、痛風の発作が一度もない場合は、安易に降尿酸薬の服用を始めないでください"]},{"tag":"a","props":{"href":"/ja/tip/06-20"},"children":[{"tag":"span","props":{},"children":["20"]},"検診で胆石が見つかったからといって、痛みがないのに予防的に胆嚢を切除しないでください"]},{"tag":"a","props":{"href":"/ja/tip/06-21"},"children":[{"tag":"span","props":{},"children":["21"]},"腎結石予防のためにカルシウムを控えないでください"]},{"tag":"a","props":{"href":"/ja/tip/06-22"},"children":[{"tag":"span","props":{},"children":["22"]},"「運気転換」「金運アップ」「開運（養人）」のために、水晶、ブレスレット、貔貅（ピーシュ）などの品物を買わないでください"]},{"tag":"a","props":{"href":"/ja/tip/06-23"},"children":[{"tag":"span","props":{},"children":["23"]},"買い物で気分やステータスを改善しようと期待しないでください"]},{"tag":"a","props":{"href":"/ja/tip/06-24"},"children":[{"tag":"span","props":{},"children":["24"]},"「周囲のレベルに合わせる」ために、家や車、コミュニティを変えるために余計な出費をしないでください"]},{"tag":"a","props":{"href":"/ja/tip/06-25"},"children":[{"tag":"span","props":{},"children":["25"]},"「意志力は筋肉のように、使えばなくなる」という説を信じないでください"]},{"tag":"a","props":{"href":"/ja/tip/06-26"},"children":[{"tag":"span","props":{},"children":["26"]},"朝食を抜くことや 16:8 の間欠的断食で体重をコントロールしようと思わないでください。食事の時間は、長期的に継続できるものを選びましょう"]},{"tag":"a","props":{"href":"/ja/tip/06-27"},"children":[{"tag":"span","props":{},"children":["27"]},"「自慰は体に悪い」「禁欲すれば良くなる」を信じないでください。本当に見るべきは、睡眠、仕事、そして人間関係に支障が出ているかどうかです"]},{"tag":"a","props":{"href":"/ja/tip/06-28"},"children":[{"tag":"span","props":{},"children":["28"]},"「性的指向の矯正」や「同性愛治療」に金を使わないで。家族を送り込むのもやめてください"]},{"tag":"a","props":{"href":"/ja/tip/06-29"},"children":[{"tag":"span","props":{},"children":["29"]},"「正しい持ち上げ方」や運搬研修だけで腰痛を防げると思わず、重さと回数を減らし、普段から運動する"]},{"tag":"a","props":{"href":"/ja/tip/06-30"},"children":[{"tag":"span","props":{},"children":["30"]},"骨折後にカルシウムを大量に補ったり骨スープを飲んだりすれば、骨が早くつながるとは期待しない"]},{"tag":"a","props":{"href":"/ja/tip/06-31"},"children":[{"tag":"span","props":{},"children":["31"]},"AIチャットボットだけで病状や法律問題を判断しない。受診・裁判・大きな支出の前に、根拠の原文を確認する"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"現在地"},"children":[{"tag":"a","props":{"href":"/ja/book"},"children":["本を読む"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/ja/book/06"},"children":["第6章"," ·"," ","アンチ・リスト"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"06-17"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["17"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["エビデンス"," ","A"]}]},{"tag":"h1","props":{"lang":"ja"},"children":["献血を健康法と考えないでください：「デトックス、血中脂質低下、心筋梗塞予防」を裏付けるランダム化比較試験はありません。頻繁な献血は、本当に鉄欠乏を引き起こします"]},{"tag":"p","props":{"lang":"ja","className":"life-entry-summary"},"children":["献血がデトックス、血中脂質低下、心筋梗塞予防に効くという話は、信頼できません。継続的に献血できる人は、もともと健康状態が良いのです。その要因を除くと、毎年1回多く献血する人の死亡率の低下幅は、約2割から 7.5% に縮小します。実際に人を比較した試験では、死亡者数に差はありませんでした。逆に、頻繁すぎる献血は、鉄欠乏が原因で、実際に無力感や寒気を感じさせる原因となります。"]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["費用・手間"]},{"tag":"p","props":{},"children":["お金はかかりません。1回の献血は、書類記入、採血、その後の経過観察と休息を含めて約1時間かかります。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["効果"]},{"tag":"p","props":{},"children":["フィンランドのKuopio研究では、2862名の42歳から60歳の男性を平均約9年間追跡調査しました。"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"記録する：献血を健康法と考えないでください：「デトックス、血中脂質低下、心筋梗塞予防」を裏付けるランダム化比較試験はありません。頻繁な献血は、本当に鉄欠乏を引き起こします"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"できている"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"やることに追加"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"お気に入り"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"このヒントを共有"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"詳細を閉じる"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["費用・手間"]},{"tag":"p","props":{},"children":["お金はかかりません。1回の献血は、書類記入、採血、その後の経過観察と休息を含めて約1時間かかります。その後数週間、体は失われた鉄分を補おうと働き続けます。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["効果"]},{"tag":"p","props":{},"children":["フィンランドのKuopio研究では、2862名の42歳から60歳の男性を平均約9年間追跡調査しました。統計開始前の24ヶ月間に献血歴があった153人のうち、1人（0.7%）に急性心筋梗塞が発生しました。一方、献血歴のない2529人のうち、316人（12.5%）が発生しました（両者の割合の差 P<0.0001）。年齢やその他の冠動脈疾患のリスク要因の影響を調整した後、献血歴のある人の心筋梗塞リスクは約88%低いことが示されました。相対リスクは0.12（95% CI 0.02–0.86、P=0.035）でした。ただし、これは追跡調査による記録であり、対照群を用いた比較試験ではありません。北欧のSCANDATデータベースには1,182,495名の献血者が含まれ、累計で9,526,627人年の追跡調査が行われ、そのうち15,401人が死亡しています。年齢や性別などの特性のみを調整した場合、年に1回の追加献血を行うと、死亡率は18.6%低くなります（95% CI 16.8%–20.4%）。さらに「健康状態が良好であることのみが献血の許可条件である」という要因も調整すると、減少幅は7.5%（5.7%–9.4%）にとどまります。著者の結論は「健康に有益であるという確実な証拠とは言い切れない」というものです。FeASTランダム化比較試験では、症状のある下肢動脈疾患患者1277名を対象とし、6ヶ月ごとに定期的な瀉血（しゃけつ）による鉄分除去を行うグループと、対照グループにランダムに分けました。主な評価項目は全死亡であり、125/636（20%）対 148/641（23%）であった。HRは0.85（HRはハザード比であり、1は両群に差がないことを示す）。95% CI 0.67–1.08、P=0.17。死亡に心筋梗塞および脳卒中（生存者を含む）を合わせた項目については、180（28%）対 205（32%）で、HRは0.88（0.72–1.07、P=0.20）であった。いずれの項目においても差は認められなかった。INTERVALランダム化比較試験では、45,263名の全血ドナーを対象とした。これらの参加者は、3つの献血間隔に分けられた。男性は12週、10週、8週、女性は16週、14週、12週であった。間隔を短縮したことで、2年間に採取された血液量は明らかに増加しました（男性 8 週群は 12 週群よりも 1.69 ユニット多く、95% CI 1.59–1.80）。QOL（生活の質）、身体活動、認知機能については、各群間で差は見られませんでした。しかし、倦怠感、息切れ、めまい、ふらつき、およびむずむず脚症候群（夜間に脚の不快感で横になれない状態）など、献血に伴う不快感は増加しました。同時に、ヘモグロビン値とフェリチンの平均値はより低くなり、ヘモグロビン値の低下により献血が延期された回数も増加しました（各項目 P<0.0001）。鉄欠乏は身体の熱産生に影響を及ぼします：鉄欠乏性貧血の女性 10 名、鉄貯蔵が枯渇しているがまだ貧血ではない人 8 名、対照群の女性 12 名が、28 ℃の水に 100 分間浸かりました。貧血群の直腸温は 36.0±0.2 ℃、対照群は 36.2±0.1 ℃（P=0.001）であった。酸素消費量は 5.28±0.26 対 5.99±0.29 mL·min⁻¹·kg⁻¹（P=0.04）であった。甲状腺ホルモンであるチロキシンとトリヨードチロニンもより低値であった（P<0.002）。この主張は、献血を行う人々はもともと繰り返しスクリーニングを受けている健康な人々であり、「鉄分を排出することで心臓を保護できる」という仮説がランダム化試験では検証されなかったため、一見成立するように見える"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["出典"]},{"tag":"p","props":{"className":"life-citations"},"children":["Salonen JT, Tuomainen TP, Salonen R, Lakka TA, Nyyssönen K (1998). Donation of blood is associated with reduced risk of myocardial infarction. The Kuopio Ischaemic Heart Disease Risk Factor Study. American Journal of Epidemiology, 148(5), 445-451. ",{"tag":"a","props":{"href":"https://doi.org/10.1093/oxfordjournals.aje.a009669","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1093/oxfordjournals.aje.a009669"]},"；Ullum H, Rostgaard K, Kamper-Jørgensen M, et al. (2015). Blood donation and blood donor mortality after adjustment for a healthy donor effect. Transfusion, 55(10), 2479-2485. ",{"tag":"a","props":{"href":"https://doi.org/10.1111/trf.13205","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1111/trf.13205"]},"；Zacharski LR, Chow BK, Howes PS, et al. (2007). Reduction of iron stores and cardiovascular outcomes in patients with peripheral arterial disease: a randomized controlled trial. JAMA, 297(6), 603-610. ",{"tag":"a","props":{"href":"https://doi.org/10.1001/jama.297.6.603","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1001/jama.297.6.603"]},"；Di Angelantonio E, Thompson SG, Kaptoge S, et al. (2017). Efficiency and safety of varying the frequency of whole blood donation (INTERVAL): a randomised trial of 45 000 donors. Lancet, 390(10110), 2360-2371. ",{"tag":"a","props":{"href":"https://doi.org/10.1016/S0140-6736(17)31928-1","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1016/S0140-6736(17)31928-1"]},"；Beard JL, Borel MJ, Derr J (1990). Impaired thermoregulation and thyroid function in iron-deficiency anemia. American Journal of Clinical Nutrition, 52(5), 813-819. ",{"tag":"a","props":{"href":"https://doi.org/10.1093/ajcn/52.5.813","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1093/ajcn/52.5.813"]},"；全国人大常委会 (1997). 中华人民共和国献血法（第二、九、十四条）. ",{"tag":"a","props":{"href":"https://flk.npc.gov.cn/detail?id=2c909fdd678bf17901678bf5e71801f9","target":"_blank","rel":"noopener noreferrer"},"children":["https://flk.npc.gov.cn/detail?id=2c909fdd678bf17901678bf5e71801f9"]},"；国家卫生健康委等 (2024-01-08). 关于进一步做好无偿献血者激励奖励工作的通知. ",{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/202401/content_6924875.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/zhengce/zhengceku/202401/content_6924875.htm"]}]},{"tag":"a","props":{"href":"https://doi.org/10.1093/oxfordjournals.aje.a009669","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["出典を開く"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["著者の注記"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["否定すべきは「自分の体のために献血する」という考え方であり、献血という行為そのものではありません。血液は他人のために使われるものであり、本書の受益者の分類に従えば、第④段階（見知らぬ他人）に該当します。真に自分自身に還元されるのは、制度によって与えられる恩恵です。『献血法』第14条では、無償献血者が自身の病院での血液使用において、採血、保管、分離、検査に関する諸費用が免除されること、また配偶者および直系親族は、省級政府の規定に従って免除または減額されることが定められています。国家衛生健康委員会による 2024 年 1 月の通知には、28 個の省において、無償献血者とその親族が省内の病院で血液を使用する際の費用が、退院時に直接免除または減額されることが明記されています。無償献血奉仕賞を受賞した方は、現地の「三免」政策に基づき、公共交通機関の無料利用、政府投資による公園の無料入園、および公立病院の一般外来診療費の免除を受けることができます。献血を行う際は、法定のインターバルに従ってください。《献血法》第9条では、1回につき通常 200 ml、最大で 400 mlを超えないものと規定されています。2回の間隔は 6 ヶ月以上空ける必要があります。推奨される年齢は 18 歳から 55 歳までです。名誉や団体の指標を満たすために、間隔を最短にまで詰め込まないようにしてください。女性、低体重の方、月経量が多い方は、もともと体内の鉄分が不足しやすいため、繰り返し献血を行う方は自費で一度フェリチン値を検査することをお勧めします。献血後如果持續感到乏力、畏寒，或者晚上躺下時腿部不適且忍不住想動（即「不寧腿症候群」），請不要自行猜測是「元氣受損」，應去檢查血常規和鐵蛋白。若檢查出缺鐵，請遵照醫囑進行補鐵，同時拉長獻血間隔。關於畏寒的部分，人體證據僅有 10 人，是用來解釋為什麼會發生這種情況，而非指有多少人會出現這種症狀。"]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["自分のメモ"]},{"tag":"button","props":{"type":"button"},"children":["自分へのメモを書く…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/ja/tip/06-16"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["前へ"]},"「視力を守る」ためにブルーライトカット眼鏡を買わないでください。また「数ヶ月画面を見続けると目がダメになる」という言葉も信じないでください。ただし、目の張り、痛み、充血は緊急事態として扱うべきです"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/ja/tip/06-18"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["次へ"]},"一般的な健康診断パッケージに頼って病気を防ごうとせず、年齢と性別に基づいた、エビデンスのある検査項目を受けましょう"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["このテーマの他の提案"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/06-13"},"children":[{"tag":"strong","props":{},"children":["デトックス、腸洗浄、酵素、アルカリ水などの製品を買わないでください"]},{"tag":"span","props":{},"children":["デトックス産業は非常に大きく発展していますが、それを支持する臨床的エビデンスは極めて少なく、市販されているデトックスダイエットについて真剣…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/06-14"},"children":[{"tag":"strong","props":{},"children":["「毎日 8 杯の水を飲む」という目標を満たすために、無理に水を飲まないでください"]},{"tag":"span","props":{},"children":["「毎日 8 杯」という説の出所を専門に追跡した人がいますが、それを支持する研究は一つも見つかりませんでした。食べ物や他の飲料にはもともと大…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/06-15"},"children":[{"tag":"strong","props":{},"children":["占いやタロット、星座占いで決断を下すために、お金を使わないでください"]},{"tag":"span","props":{},"children":["有名な教室実験があります。学生に渡された「性格分析」は、実は全員に配布された全く同じものでしたが、多くの学生が非常に当たっていると感じまし…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/06-19"},"children":[{"tag":"strong","props":{},"children":["尿酸値が高いと診断されても、痛風の発作が一度もない場合は、安易に降尿酸薬の服用を始めないでください"]},{"tag":"span","props":{},"children":["尿酸値が基準値を超えていても、痛風の発作や痛風結節（痛風石）の経験がない場合、米国リウマチ学会は、まずは降尿酸薬の服用を控えることを推奨し…"]}]}]},{"tag":