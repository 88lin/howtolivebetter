re2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Chia sẻ mẹo này"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Ẩn chi tiết"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Chi phí"]},{"tag":"p","props":{},"children":["Đăng ký miễn phí, đi theo quy trình của nhà cung cấp đám mây thì khoảng mấy tuần. Đo kiểm phân cấp bảo vệ thì tính phí theo cấp. Phân cấp bảo vệ gọi tắt là等保, là bộ biện pháp quản lý an toàn do nhà nước phân cấp theo mức độ quan trọng của hệ thống, yêu cầu website và hệ thống thực hiện, website nhỏ thường không phải đo kiểm."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Lợi ích"]},{"tag":"p","props":{},"children":["Dịch vụ thông tin internet có tính thương mại thì phải xin phép, không tính thương mại thì phải đăng ký. Không có phép, không đăng ký thì không được làm. Không đăng ký thì cơ quan quản lý viễn thông buộc phải sửa, không sửa thì buộc đóng trang web. Kinh doanh không được phép thì bị tịch thu thu nhập bất hợp pháp, và phạt bằng 3 đến 5 lần thu nhập bất hợp pháp, hoặc phạt từ 100.000 đến 1.000.000 tệ. Trang chủ website không ghi số đăng ký thì phạt từ 5.000 đến 50.000 tệ. Đơn vị vận hành mạng phải theo hệ thống phân cấp bảo vệ (等保) để ra quy chế quản lý an toàn, phòng chống tấn công, lưu nhật ký mạng không dưới 6 tháng, sao lưu và mã hoá dữ liệu theo phân loại. Không thực hiện thì bị buộc phải sửa, bị cảnh cáo. Không sửa hoặc để xảy ra hậu quả thì phạt từ 10.000 đến 100.000 tệ, người phụ trách phạt từ 5.000 đến 50.000 tệ (toàn quốc)"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Nguồn gốc"]},{"tag":"p","props":{"className":"life-citations"},"children":["国务院 (2011). 互联网信息服务管理办法（2011 年修订，第四、十九、二十二条）. ",{"tag":"a","props":{"href":"https://www.gov.cn/gongbao/content/2011/content_1860864.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/gongbao/content/2011/content_1860864.htm"]},"；全国人大常委会 (2025). 网络安全法（2025 年修正，2026 年 1 月 1 日施行，第二十三、六十一条；2016 年文本为第二十一、五十九条）. ",{"tag":"a","props":{"href":"https://www.cac.gov.cn/2025-12/29/c_1768735112911946.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.cac.gov.cn/2025-12/29/c_1768735112911946.htm"]}]},{"tag":"a","props":{"href":"https://www.gov.cn/gongbao/content/2011/content_1860864.htm","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Liên kết mở nguồn"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Ghi chú sách"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["Máy chủ trong nước không đăng ký thì tên miền cơ bản không phân giải được. Đăng ký thì làm thế nào, không gắn số đăng ký bị phạt bao nhiêu, làm sao biết nhà cung cấp dịch vụ có chứng chỉ hay không, xem mục 4 ở phần 26 (đặt máy chủ trong nước thì phải đăng ký). Hai cái bẫy hay gặp: đăng ký là cá nhân không kinh doanh nhưng thực tế lại có thu tiền; đổi tên miền hoặc đổi chủ thể mà không đi làm thay đổi đăng ký. Giữ nhật ký 6 tháng vừa là nghĩa vụ vừa là tự bảo vệ, khi có sự cố thì chứng minh được việc đó không phải do mình."]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Ghi chú của tôi"]},{"tag":"button","props":{"type":"button"},"children":["Viết một lời nhắc cho chính bạn…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/vi/tip/11-15"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Trước"]},"Ứng dụng chỉ thu thập thông tin cá nhân cần thiết cho nghiệp vụ, dưới 14 tuổi phải có sự đồng ý của người giám hộ, chính sách bảo mật phải viết rõ"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/vi/tip/11-17"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Tiếp theo"]},"Trước khi cung cấp dịch vụ AI tạo sinh cho công chúng, phải đánh giá an toàn và đăng ký thuật toán theo quy định, nội dung tạo ra phải gắn nhãn"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["Thêm trong chủ đề này"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/11-11"},"children":[{"tag":"strong","props":{},"children":["Không bán công cụ vượt tường, không bán tài khoản VPN, không dựng loại nút mạng đó cho người khác"]},{"tag":"span","props":{},"children":["Tự dựng đường truyền để ra nước ngoài, hoặc dùng kênh quốc tế ngoài k…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/11-12"},"children":[{"tag":"strong","props":{},"children":["Đã ký thỏa thuận không cạnh tranh, sau khi nghỉ việc công ty không trả bồi thường hằng tháng thì gửi văn bản yêu cầu, đủ 3 tháng không trả thì có thể chấm dứt; vị trí chưa từng tiếp cận bí mật thương mại thì có thể yêu cầu xác nhận điều khoản không có hiệu lực"]},{"tag":"span","props":{},"children":["Không cạnh tranh nghĩa là sau khi nghỉ việc, một khoảng thời gian khô…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/11-13"},"children":[{"tag":"strong","props":{},"children":["Mã nguồn viết trong giờ làm việc hoặc bằng nguồn lực công ty thì thuộc công ty, dự án mã nguồn mở của bạn thì tự làm bằng thời gian và thiết bị của bạn, không trộn mã công ty"]},{"tag":"span","props":{},"children":["Phần mềm chủ yếu viết ra dựa trên thiết bị, mạng nội bộ hoặc dữ liệu …"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/11-14"},"children":[{"tag":"strong","props":{},"children":["Làm sản phẩm bằng mã nguồn mở như GPL, thì mở theo yêu cầu của giấy phép hoặc đổi giấy phép, đừng coi là「không ai quản」"]},{"tag":"span","props":{},"children":["Xâm phạm quyền tác giả thì bồi thường theo thiệt hại của bên bị xâm p…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/11-18"},"children":[{"tag":"strong","props":{},"children":["Không làm, phát hành công cụ tự bỏ qua hoặc chặn quảng cáo của ứng dụng khác; miễn phí, không nối mạng vẫn có thể bị phán cạnh tranh không lành mạnh"]},{"tag":"span","props":{},"children":["Làm phần mềm thay người dùng bỏ qua, chặn quảng cáo ứng dụng khác có …"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/11-19"},"children":[{"tag":"strong","props":{},"children":["Không mở «trạm trung chuyển AI» bán lại giao diện mô hình nước ngoài giá thấp: đã có chủ trạm ở Thượng Hải bị tạm giữ hình sự"]},{"tag":"span","props":{},"children":["Trạm trung chuyển AI là trang bán lại giao diện mô hình lớn nước ngoà…"]}]}]}]},{"tag":"a","props":{"className":"life-text-link","href":"/vi/book/11"},"children":["Đọc toàn bộ chủ đề: Vạch đỏ lập trình viên và người làm kỹ thuật dễ vấp"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"15","height":"15","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"