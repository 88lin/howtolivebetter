height":"18","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-up-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M7 7h10v10"},"children":[]},{"tag":"path","props":{"d":"M7 17 17 7"},"children":[]}]}]}]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/ru/book/31"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"К содержанию"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["Какие пути открываются после 18 лет"]},{"tag":"div","props":{"data-ad-dock-host":"true"},"children":[]},{"tag":"nav","props":{"aria-label":"Советы главы"},"children":[{"tag":"a","props":{"href":"/ru/tip/31-01"},"children":[{"tag":"span","props":{},"children":["01"]},"Сначала сверьте требования: возрастные и образовательные критерии для двенадцати вариантов карьерного пути чётко прописаны в документах"]},{"tag":"a","props":{"href":"/ru/tip/31-02"},"children":[{"tag":"span","props":{},"children":["02"]},"Мужчины, которым исполнилось 18 лет, должны до 31 октября пройти регистрацию на военную службу; срочная служба длится два года"]},{"tag":"a","props":{"href":"/ru/tip/31-03"},"children":[{"tag":"span","props":{},"children":["03"]},"Отказ от военной службы после подачи заявления влечет серьезные ограничения на два года"]},{"tag":"a","props":{"href":"/ru/tip/31-04"},"children":[{"tag":"span","props":{},"children":["04"]},"Два главных преимущества для студентов, решивших пойти в армию: государство компенсирует до 20 000 юаней в год за обучение, сохраняет за ними право на учёбу на протяжении двух лет и предусматривает отдельную программу поступления в магистратуру"]},{"tag":"a","props":{"href":"/ru/tip/31-05"},"children":[{"tag":"span","props":{},"children":["05"]},"После увольнения с военной службы работу по распределению предоставляют лишь в шести случаях; при самостоятельном трудоустройстве необходимо явиться в органы гражданской администрации в течение 30 дней"]},{"tag":"a","props":{"href":"/ru/tip/31-06"},"children":[{"tag":"span","props":{},"children":["06"]},"Три важных показателя после увольнения: единовременная выплата, зачёт военного стажа и налоговая льгота в 20 000 юаней в год"]},{"tag":"a","props":{"href":"/ru/tip/31-07"},"children":[{"tag":"span","props":{},"children":["07"]},"Не только экзамен на госслужбу — есть и другие пути попасть в систему: после двух лет работы по программе «Три поддержки, один помощник» можно претендовать на 10% вакансий, выделенных специально для участников этой программы"]},{"tag":"a","props":{"href":"/ru/tip/31-08"},"children":[{"tag":"span","props":{},"children":["08"]},"По истечении трёхлетнего срока службы, при успешной аттестации и желании остаться работать, учителя из программы «Специальные рабочие места» должны быть незамедлительно зачислены в штат"]},{"tag":"a","props":{"href":"/ru/tip/31-09"},"children":[{"tag":"span","props":{},"children":["09"]},"Поступление на службу в пожарную охрану и в штат гражданских специалистов Вооружённых сил — ещё два пути открытого набора, причём порог входа здесь ниже, чем при сдаче государственного экзамена"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/ru/tip/31-10","data-status":"active"},"children":[{"tag":"span","props":{},"children":["10"]},"Образование — это не разовое решение: для экзаменов по самообразованию нет ограничений по возрасту и уровню образования; поступить можно также через экзамены для взрослых или в Открытый университет"]},{"tag":"a","props":{"href":"/ru/tip/31-11"},"children":[{"tag":"span","props":{},"children":["11"]},"Отсутствие трудоустройства не означает отсутствие соцстраха: пенсионное и медицинское страхование придётся оформлять самостоятельно в месте работы, ограничения по прописке уже сняты"]},{"tag":"a","props":{"href":"/ru/tip/31-12"},"children":[{"tag":"span","props":{},"children":["12"]},"Для курьеров, водителей такси и грузоперевозчиков платформа сама оплачивает страховку от профессиональных травм за каждый выполненный заказ — вам платить не придётся"]},{"tag":"a","props":{"href":"/ru/tip/31-13"},"children":[{"tag":"span","props":{},"children":["13"]},"Два пути получения государственной должности в день подачи заявлений на поступление в вуз: бесплатное обучение для будущих учителей и для медиков, но за это придётся отработать 6 лет"]},{"tag":"a","props":{"href":"/ru/tip/31-14"},"children":[{"tag":"span","props":{},"children":["14"]},"Прежде чем ехать работать за границу, проверьте, имеет ли компания лицензию на международное трудоустройство: она не вправе требовать от вас залог"]},{"tag":"a","props":{"href":"/ru/tip/31-15"},"children":[{"tag":"span","props":{},"children":["15"]},"Работа на иностранную компанию из дома: такие доходы считаются внутренними по налоговому законодательству. Налог нужно декларировать самостоятельно, а перевод средств следует оформлять как «оплату труда сотрудника»"]},{"tag":"a","props":{"href":"/ru/tip/31-16"},"children":[{"tag":"span","props":{},"children":["16"]},"Работа на себя без трудоустройства: для старта нужно сначала изучить кредиты под гарантию государства — личный лимит до 300 тысяч юаней, причём половину процентов оплачивает казна"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"Навигация"},"children":[{"tag":"a","props":{"href":"/ru/book"},"children":["Книга"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/ru/book/31"},"children":["Глава 31"," ·"," ","Какие пути открываются после 18 лет"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"31-10"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["10"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["Доказательства"," ","A"]}]},{"tag":"h1","props":{"lang":"ru"},"children":["Образование — это не разовое решение: для экзаменов по самообразованию нет ограничений по возрасту и уровню образования; поступить можно также через экзамены для взрослых или в Открытый университет"]},{"tag":"p","props":{"lang":"ru","className":"life-entry-summary"},"children":["Если в восемнадцать лет вы не смогли поступить в вуз, позже остаются три официальных пути: экзамены по самообразованию, экзамены для взрослых и Открытый университет. Для экзаменов по самообразованию нет ограничений по возрасту или уровню образования, однако студенты дневных форм обучения участвовать не могут. Для экзаменов для взрослых требуется аттестат о среднем или среднем специальном образовании. Все три пути требуют времени, но не зависят от того, как вы сдали экзамены в восемнадцать лет."]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Затраты"]},{"tag":"p","props":{},"children":["Ежегодные расходы на регистрацию и учебные материалы соста…"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Польза"]},{"tag":"p","props":{},"children":["Положения об экзаменах по самообразованию изложены в «Временном положении о системе экзаменов по самообразован…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"Отметить: Образование — это не разовое решение: для экзаменов по самообразованию нет ограничений по возрасту и уровню образования; поступить можно также через экзамены для взрослых или в Открытый университет"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"Сделано"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"В планах"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"В избранное"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Поделиться советом"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Скрыть подробности"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Затраты"]},{"tag":"p","props":{},"children":["Ежегодные расходы на регистрацию и учебные материалы составляют всего несколько сотен юаней. Однако потребуется длительное самостоятельное обучение или посещение вечерних занятий. Для получения степени бакалавра без отрыва от работы минимальный срок обучения — два с половиной года; главная сложность — в необходимости упорно продолжать учёбу."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Польза"]},{"tag":"p","props":{},"children":["Положения об экзаменах по самообразованию изложены в «Временном положении о системе экзаменов по самообразованию в высшем образовании». В статье 3 указано: «Граждане Китайской Народной Республики, независимо от пола, возраста, национальности, расы и уровня образования, могут участвовать в экзаменах по самообразованию в соответствии с настоящим Положением». Статья 20 запрещает участие студентам дневных форм обучения. Статья 25 перечисляет три условия для получения диплома: успешное сдача всех предметов, выполнение выпускной работы или практического задания, а также положительная оценка личных качеств. При выполнении всех требований выдаётся диплом. В этом же пункте говорится, что «лицам, получившим дипломы бакалавра или специалиста, государство признаёт их образовательный уровень». Статья 32 регламентирует оплату труда: «После трудоустройства лица, не работавшие ранее, получают заработную плату наравне с выпускниками обычных вузов». Статья 21 «Закона об образовании» гласит: «Государство внедряет систему экзаменов по самообразованию в высшем образовании; лицам, успешно сдавшим экзамены, выдаются соответствующие дипломы или свидетельства об образовании». Правила приёма на экзамены для взрослых изложены в «Методике приёма в вузы для взрослых на 2025 год». К участию допускаются «работающие граждане и прочие лица, не являющиеся студентами высших и средних учебных заведений, имеющих государственную аккредитацию». Кандидаты на программы «бакалавриат после средней школы» и «бакалавриат после колледжа» должны иметь аттестат о среднем образовании или эквивалентную квалификацию; для поступления на программу «бакалавриат после колледжа» требуется диплом специалиста, диплом бакалавра или аналогичный документ. Минимальный срок обучения в дневной форме — четыре года для «бакалавриата после средней школы» и два года для «бакалавриата после колледжа» и «бакалавриата после колледжа»; в заочной форме — пять лет для «бакалавриата после средней школы» и два с половиной года для остальных программ. Дневная форма подразумевает полный отрыв от работы и учёбу в вузе; заочная — совмещение трудовой деятельности с обучением. Положения об Открытом университете содержатся в «Мнении Министерства образования о развитии Открытого университета». В нём сказано: «В Открытом университете действует система регистрации; студенты, освоившие программу и набравшие необходимое количество кредитов, получают сертификаты по предметам; при выполнении всех требований выдаются дипломы и неакадемические свидетельства; при соответствии критериям присуждаются учёные степени» (по всей стране)."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Первоисточники"]},{"tag":"p","props":{"className":"life-citations"},"children":["国务院 (1988, 2014 修订). 高等教育自学考试暂行条例（第三、二十、二十五、三十二条）. ",{"tag":"a","props":{"href":"https://flk.npc.gov.cn/detail?id=ff8080816f3cbb3c016f415d64e5236d","target":"_blank","rel":"noopener noreferrer"},"children":["https://flk.npc.gov.cn/detail?id=ff8080816f3cbb3c016f415d64e5236d"]},"（国家法律法规数据库）；全国人大常委会 (2018). 高等教育法（第二十一条）. ",{"tag":"a","props":{"href":"https://flk.npc.gov.cn/detail?id=ff8080816f135f46016f20df64ec16c5","target":"_blank","rel":"noopener noreferrer"},"children":["https://flk.npc.gov.cn/detail?id=ff8080816f135f46016f20df64ec16c5"]},"（国家法律法规数据库）；教育部办公厅 (2025). 关于做好 2025 年全国成人高校招生工作的通知（教学厅〔2025〕6 号）及附件《2025 年全国成人高校招生办法》. ",{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/202509/content_7040877.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/zhengce/zhengceku/202509/content_7040877.htm"]},"；教育部 (2016). 关于办好开放大学的意见（教职成〔2016〕2 号）. ",{"tag":"a","props":{"href":"http://www.gov.cn/gongbao/content/2016/content_5067956.htm","target":"_blank","rel":"noopener noreferrer"},"children":["http://www.gov.cn/gongbao/content/2016/content_5067956.htm"]},"；教育部 (2007). 关于进一步做好高等学校各类招生管理工作的通知（教发〔2007〕13 号）：「普通专升本招生计划按不超过当年应届普通高职（专科）毕业生5%的比例安排」. ",{"tag":"a","props":{"href":"http://www.moe.gov.cn/s78/A03/s7050/201006/t20100607_88782.html","target":"_blank","rel":"noopener noreferrer"},"children":["http://www.moe.gov.cn/s78/A03/s7050/201006/t20100607_88782.html"]},"；中国政府网 (2020). 今年扩招硕士18.9万，专升本32.2万——毕业生就业帮扶发力，教育部副部长翁铁慧：「扩大普通高校专升本的规模，同比争取增加32.2万人」. ",{"tag":"a","props":{"href":"http://www.gov.cn/zhengce/2020-02/29/content_5484774.htm","target":"_blank","rel":"noopener noreferrer"},"children":["http://www.gov.cn/zhengce/2020-02/29/content_5484774.htm"]},"；福建省教育考试院 (2026). 转发时引「教育部高校学生司《关于做好2026年普通高等学校专升本考试招生工作的通知》（教学司函〔2025〕53号）」. ",{"tag":"a","props":{"href":"https://www.eeafj.cn/gkzsb/20260310/14437.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.eeafj.cn/gkzsb/20260310/14437.html"]}]},{"tag":"a","props":{"href":"https://flk.npc.gov.cn/detail?id=ff8080816f3cbb3c016f415d64e5236d","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Открыть источник"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Примечание автора"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["Существует также обычный формат программы «повышения уровня образования для выпускников колледжей» (Zhuanshengben) для выпускников очных отделений средних специальных учебных заведений. Официальный документ на национальном уровне — это уведомление Министерства образования от 2007 года, в котором указано, что план приема на программы повышения уровня не должен превышать 5% от числа выпускников колледжей текущего года. Начиная с 2020 года, Министерство образования увеличило масштаб программы «Zhuanshengben», увеличив число участников на 32.2 тысяч человек по сравнению с предыдущим годом; фактически, установленный лимит в 5% уже не соблюдается. Конкретные ежегодные планы оформляются в виде официальных писем Департамента по работе со студентами вузов Министерства образования, например, за 2026 год это письмо Департамента учебной работы 〔2025〕 № 53. Данное письмо не публикуется в открытом доступе, его номер можно увидеть только в документах, пересланных провинциями. Критерии приема определяются каждой провинцией самостоятельно, и в основном принимаются только выпускники очных отделений колледжей данной провинции текущего года, поэтому в основном тексте условия не прописаны. Начиная с осени 2025 года, программы дополнительного образования для получения высшего образования больше не называются «дистанционным» или «заочным» обучением, теперь они унифицированы под названием «неочная форма обучения». Речь идет о категории программ для взрослых, направленных на повышение уровня образования; следует проявлять осторожность при виде рекламы, использующей старые названия. Получение дополнительного образования и вопрос «какое обучение навыкам наиболее выгодно» — это две разные темы, последняя рассматривается в разделе 23. О «быстром получении сертификата» за деньги и поддельных дипломах см. пункт 8 раздела 23."]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Моя заметка"]},{"tag":"button","props":{"type":"button"},"children":["Запишите напоминание…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/ru/tip/31-09"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Предыдущий"]},"Поступление на службу в пожарную охрану и в штат гражданских специалистов Вооружённых сил — ещё два пути открытого набора, причём порог входа здесь ниже, чем при сдаче государственного экзамена"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/ru/tip/31-11"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Следующий"]},"Отсутствие трудоустройства не означает отсутствие соцстраха: пенсионное и медицинское страхование придётся оформлять самостоятельно в месте работы, ограничения по прописке уже сняты"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["Другие советы по этой теме"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/31-06"},"children":[{"tag":"strong","props":{},"children":["Три важных показателя 