g":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"分享这条建议"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"收起详情"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["成本"]},{"tag":"p","props":{},"children":["维生素 B12 补充剂一瓶几十元，每天吃一粒。孩子辅食里加蛋、肉、鱼，花不了多少钱。难在全家认定吃素更健康时，要改主意"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["收益"]},{"tag":"p","props":{},"children":["美国疾控中心 2003 年报告了两个孩子。两人都是吃素的妈妈喂母乳带大的，都缺维生素 B12，都长不大、发育落后。第一个孩子的妈妈吃了 7 年全素。孩子 15 个月大时住院，查出严重贫血，脑部核磁显示全脑萎缩。补上 B12 之后孩子有进步，但到 32 个月大，说话和语言仍然落后。报告说，婴幼儿缺 B12 最常见的原因是妈妈饮食里缺。喂母乳的孩子一般在 4 到 8 个月大时显出来。缺得久了，有的孩子会留下不可逆的神经损伤，轻重看缺得多重、缺了多久。不靠强化的可靠来源只有动物性食物：肉、奶制品和蛋。植物里天然的 B12 大多人体用不上。加了 B12 的谷物、豆奶、营养酵母可以当稳定来源。报告要求吃素的人，尤其是怀孕和喂奶的女性，弄清自己吃的东西里有多少 B12，或者去问营养专业人员。欧洲儿科胃肠肝病和营养学会 2017 年的辅食立场文件写明，所有婴儿都要吃富含铁的辅食，包括肉类或铁强化食品。全素饮食只应在医生或营养师的适当监督下进行，父母要明白不按建议补充的严重后果。国家卫健委 2020 年的喂养核心信息要求，辅食每天不少于 4 种，并且至少包括一种动物性食物、一种蔬菜和一种谷薯类食物"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["原始出处"]},{"tag":"p","props":{"className":"life-citations"},"children":["Centers for Disease Control and Prevention (2003). Neurologic impairment in children associated with maternal dietary deficiency of cobalamin—Georgia, 2001. MMWR, 52(4), 61-64. ",{"tag":"a","props":{"href":"https://www.cdc.gov/mmwr/preview/mmwrhtml/mm5204a1.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.cdc.gov/mmwr/preview/mmwrhtml/mm5204a1.htm"]},"；Fewtrell M, Bronsky J, Campoy C, et al. (2017). Complementary Feeding: A Position Paper by the European Society for Paediatric Gastroenterology, Hepatology, and Nutrition (ESPGHAN) Committee on Nutrition. Journal of Pediatric Gastroenterology and Nutrition, 64(1), 119-132. ",{"tag":"a","props":{"href":"https://doi.org/10.1097/MPG.0000000000001454","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1097/MPG.0000000000001454"]},"；国家卫生健康委办公厅 (2020). 婴幼儿喂养健康教育核心信息. ",{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/2020-08/01/content_5531915.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/zhengce/zhengceku/2020-08/01/content_5531915.htm"]},"；Melina V, Craig W, Levin S (2016). Position of the Academy of Nutrition and Dietetics: Vegetarian Diets. Journal of the Academy of Nutrition and Dietetics, 116(12), 1970-1980. ",{"tag":"a","props":{"href":"https://doi.org/10.1016/j.jand.2016.09.025","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1016/j.jand.2016.09.025"]},"（备注里的反方）"]},{"tag":"a","props":{"href":"https://www.cdc.gov/mmwr/preview/mmwrhtml/mm5204a1.htm","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["打开来源链接"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["原书备注"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["争议：美国营养与饮食学会 2016 年的立场是，规划得当的素食和全素适合人生各个阶段，包括怀孕、喂奶、婴儿和儿童。但它同样写明，吃全素的人要有可靠的 B12 来源，比如强化食品或补充剂。两边分歧在全素能不能喂婴儿，在「必须补 B12」上没有分歧。吃蛋奶的素食风险低一些，但很少吃蛋奶的一样会缺。报告里第二个孩子的妈妈吃素 20 年，几乎不碰肉、鱼和奶制品。缺 B12 早期的症状没有特点，美国疾控中心说贫血指标不适合拿来筛查。孩子长得慢、发育跟不上，看病时主动告诉医生家里吃素，查什么由医生定。医生给的治疗别因为信偏方就拒绝，见第 16 节第 4 条（别为了试偏方停掉正规治疗）。辅食怎么加见本节第 4 条（6 个月起加辅食），孕期的叶酸见第 27 节第 1 条（每天补 0.4 毫克叶酸）。"]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["我的备注"]},{"tag":"button","props":{"type":"button"},"children":["写下对自己有用的提醒…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/tip/20-13"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["上一条"]},"盯住新生儿黄疸的几个信号：出生 24 小时内就黄、越来越黄、叫不醒不吃奶、大便发白，就当天去医院"]}]}]},{