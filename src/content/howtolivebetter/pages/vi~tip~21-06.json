{"path":"/vi/tip/21-06","title":"Rút tiền ở nước ngoài một năm không được quá 100.000 tệ nhân dân tệ, tính gộp tất cả thẻ mang tên bạn | HowToLiveBetter","description":"Hạn mức rút tiền mặt ở nước ngoài không tính từng thẻ một, mà tính tất cả thẻ ngân hàng trong tên bạn (kể cả thẻ phụ) cộng lại, mỗi năm dương lịch 10…","lang":"vi","styles":["/sites/howtolivebetter/styles/bca54bebe9c1bd3b.css"],"bodyClass":"font-sans antialiased","nodes":[{"tag":"div","props":{"className":"life-site"},"children":[{"tag":"div","props":{"className":"life-header-slot","aria-hidden":"true"},"children":[]},{"tag":"header","props":{"className":"life-header"},"children":[{"tag":"div","props":{"className":"life-header-inner"},"children":[{"tag":"a","props":{"className":"life-brand","aria-label":"H ✳ HowToLiveBetter — trang chủ","href":"/vi"},"children":[{"tag":"span","props":{"className":"life-brand-mark","aria-hidden":"true"},"children":["H",{"tag":"span","props":{},"children":["✳"]}]},{"tag":"span","props":{},"children":["HowToLive",{"tag":"span","props":{},"children":["Better"]}]}]},{"tag":"nav","props":{"className":"life-nav","aria-label":"Điều hướng chính"},"children":[{"tag":"a","props":{"className":"life-nav-link","href":"/vi/book"},"children":[{"tag":"span","props":{},"children":["Khám phá cuốn sách"]}]},{"tag":"a","props":{"className":"life-nav-link","href":"/vi/top-50"},"children":[{"tag":"span","props":{},"children":["Top 50"]}]},{"tag":"a","props":{"className":"life-nav-link","href":"/vi/daily"},"children":[{"tag":"span","props":{},"children":["Nhiệm vụ hàng ngày"]}]},{"tag":"a","props":{"className":"life-nav-link","href":"/vi/dashboard"},"children":[{"tag":"span","props":{},"children":["Bảng kiểm tra của tôi"]}]},{"tag":"button","props":{"type":"button","className":"life-nav-link life-nav-more","aria-haspopup":"menu","aria-expanded":"false"},"children":[{"tag":"span","props":{},"children":["Nhiều hơn"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"15","hei