-back-link","href":"/ja/book/25"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"目次に戻る"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["人が亡くなった後、何をすべきか"]},{"tag":"div","props":{"data-ad-dock-host":"true"},"children":[]},{"tag":"nav","props":{"aria-label":"この章のヒント"},"children":[{"tag":"a","props":{"href":"/ja/tip/25-01"},"children":[{"tag":"span","props":{},"children":["01"]},"自宅または屋外で亡くなった際、まずは自然死か不自然死（事故、死因不明、独居で後から発見された場合など）かを判別してください。直ちに警察へ通報し、遺体や現場には触れないでください。"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/ja/tip/25-02","data-status":"active"},"children":[{"tag":"span","props":{},"children":["02"]},"死亡診断書は、その後のすべての手続きの鍵となります：病院での死亡は当該医療機関、自宅での自然死は地域のコミュニティ衛生サービス機関へ、発行は1日以内"]},{"tag":"a","props":{"href":"/ja/tip/25-03"},"children":[{"tag":"span","props":{},"children":["03"]},"遺体の搬送、保管、火葬は葬儀場で行う必要があり、病院の安置所では葬儀業務は行われません。保管期間は通常 3 日を超えません。"]},{"tag":"a","props":{"href":"/ja/tip/25-04"},"children":[{"tag":"span","props":{},"children":["04"]},"死因に異議がある場合、48 時間以内に解剖を申し立て、同時に診療録を封印すること"]},{"tag":"a","props":{"href":"/ja/tip/25-05"},"children":[{"tag":"span","props":{},"children":["05"]},"中国の死亡後の戸籍抹消には法定期限がある。都市部は埋葬前、農村部は1か月以内"]},{"tag":"a","props":{"href":"/ja/tip/25-06"},"children":[{"tag":"span","props":{},"children":["06"]},"葬祭サービスは基本項目と非基本項目に分かれており、基本項目のリストおよび料金は法律に基づいて定められています"]},{"tag":"a","props":{"href":"/ja/tip/25-07"},"children":[{"tag":"span","props":{},"children":["07"]},"抱き合わせ販売、表示価格への上乗せ、一項目を複数項目に分割しての請求に遭遇したら、記録して通報しましょう"]},{"tag":"a","props":{"href":"/ja/tip/25-08"},"children":[{"tag":"span","props":{},"children":["08"]},"葬儀代理、用品代行購入、企画・司会などの仲介業は、県級の民政局への届出が必要です"]},{"tag":"a","props":{"href":"/ja/tip/25-09"},"children":[{"tag":"span","props":{},"children":["09"]},"各地に分散しているお金は、個別に引き出す必要があります：積立金（公積金）残高、社会保険給付、労災給付"]},{"tag":"a","props":{"href":"/ja/tip/25-10"},"children":[{"tag":"span","props":{},"children":["10"]},"故人のアカウントおよび個人情報について、近親者は閲覧、複製、訂正、削除を請求できます"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"現在地"},"children":[{"tag":"a","props":{"href":"/ja/book"},"children":["本を読む"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/ja/book/25"},"children":["第25章"," ·"," ","人が亡くなった後、何をすべきか"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"25-02"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["02"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["エビデンス"," ","A"]}]},{"tag":"h1","props":{"lang":"ja"},"children":["死亡診断書は、その後のすべての手続きの鍵となります：病院での死亡は当該医療機関、自宅での自然死は地域のコミュニティ衛生サービス機関へ、発行は1日以内"]},{"tag":"p","props":{"lang":"ja","className":"life-entry-summary"},"children":["病院で亡くなった場合は、治療を担当した医療機関に死亡診断書の発行を依頼してください。自宅で自然に亡くなった場合は、居住地域を管轄するコミュニティ衛生サービス機関または郷鎮衛生院に依頼してください。死因が明確であれば、1日以内に発行されます。戸籍抹消、火葬、公積金（住宅積立金）の引き出し、社会保障給付の受領、保険金請求、相続手続きなど、あらゆる手続きで必要となります。入手したら、あらかじめ多めにコピーを取っておきましょう。"]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["費用・手間"]},{"tag":"p","props":{},"children":["無料。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["効果"]},{"tag":"p","props":{},"children":["『人口死亡情報登録管理規範（試行）』によれば、医療衛生機関内で死亡した場合は「救済を担当した医療衛生機関が発行」し、病院や診療所で亡くなった場合は、治療を担当した機関に依頼することになります。"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"記録する：死亡診断書は、その後のすべての手続きの鍵となります：病院での死亡は当該医療機関、自宅での自然死は地域のコ