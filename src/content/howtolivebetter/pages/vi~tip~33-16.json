,"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Chia sẻ mẹo này"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Ẩn chi tiết"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Chi phí"]},{"tag":"p","props":{},"children":["Nằm viện phục hồi chức năng mỗi ngày vài trăm tệ, phần tự trả thay đổi tuỳ địa phương. Thời gian tính theo tháng. Ngày nào cũng phải tập, rất chán."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Lợi ích"]},{"tag":"p","props":{},"children":["Tổng quan hệ thống Cochrane đưa vào 29 thử nghiệm, 5902 người tham gia, so sánh chăm sóc có tổ chức trong khoa đột quỵ với các cách chăm sóc khác. Tại lần theo dõi cuối (trung vị 1 năm), tỷ số khả năng của kết cục xấu (tử vong, tàn tật hoặc phải vào cơ sở chăm sóc) là 0.77 (95% CI 0.69–0.87, khoảng tin cậy), tỷ số khả năng của tử vong là 0.76 (95% CI 0.66–0.88), tỷ số khả năng của tử vong hoặc phụ thuộc người khác là 0.75 (95% CI 0.66–0.85), chất lượng bằng chứng ở mức trung bình. Quy đổi ra tuyệt đối thì cứ 100 người được chăm sóc trong khoa đột quỵ thì có thêm 2 người sống sót, thêm 6 người ở được tại nhà, thêm 6 người tự lo. Mặt khác, thử nghiệm AVERT phân bổ ngẫu nhiên 2104 bệnh nhân ở 56 khoa đột quỵ cấp cứu tại 5 nước, so sánh「chăm sóc thông thường」với「chăm sóc thông thường cộng vận động sớm cường độ cao」. Sau ba tháng, kết cục tốt (0—2 điểm theo thang Rankin cải tiến) là nhóm vận động cực sớm 480 người (46%), nhóm thông thường 525 người (50%), tỷ số khả năng sau điều chỉnh 0.73 (95% CI 0.59–0.90, P=0.004). Tử vong là 88 người so với 72 người, không ra khác biệt (tỷ số khả năng 1.34, 95% CI 0.93–1.93, P=0.113)"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Nguồn gốc"]},{"tag":"p","props":{"className":"life-citations"},"children":["Langhorne P, Ramachandra S; Stroke Unit Trialists' Collaboration (2020). Organised inpatient (stroke unit) care for stroke: network meta-analysis. Cochrane Database of Systematic Reviews, 4:CD000197. ",{"tag":"a","props":{"href":"https://doi.org/10.1002/14651858.CD000197.pub4","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1002/14651858.CD000197.pub4"]},"；AVERT Trial Collaboration group (2015). Efficacy and safety of very early mobilisation within 24 h of stroke onset (AVERT): a randomised controlled trial. Lancet, 386(9988):46-55. ",{"tag":"a","props":{"href":"https://doi.org/10.1016/S0140-6736(15)60690-0","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1016/S0140-6736(15)60690-0"]}]},{"tag":"a","props":{"href":"https://doi.org/10.1002/14651858.CD000197.pub4","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Liên kết mở nguồn"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Ghi chú sách"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["Tranh cãi: Cả hai bằng chứng này đều đến từ đột quỵ, áp sang chấn thương tủy sống, cắt chiết, bỏng và các nguyên nhân khuyết tật khác thì là suy diễn lan. Kết quả AVERT nói rằng「càng sớm càng mạnh」không đúng, không phải là「vận động sớm không có ích」. Trong thử nghiệm, đa số người ở cả hai nhóm đều xuống giường trong vòng 24 giờ, khác nhau ở tần suất và tổng lượng. Khi chọn cơ sở, xem nó có khoa phục hồi chức năng không, có nhân viên chuyên trách về phục hồi chức năng và trị liệu hoạt động tự do không, đừng chỉ nhìn hai chữ「phục hồi」trên biển hiệu. Chuyển viện giữa tuyến cơ sở và bệnh viện hạng A, mức đồng chi trả tính thế nào, xem mục 1 ở phần 24 (chuyển viện theo từng bậc). Phục hồi chức năng cộng đồng và lắp thiết bị hỗ trợ xem mục 7 của phần này (hỏi hết ở hội người khuyết tật cấp huyện)."]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Ghi chú của tôi"]},{"tag":"button","props":{"type":"button"},"children":["Viết một lời nhắc cho chính bạn…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/vi/tip/33-15"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Trước"]},"Mất hoặc không cử động được hai chi dưới bên phải vẫn thi được giấy phép lái xe, loại xe được phép lái gọi là C5"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/vi/tip/33-17"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Tiếp theo"]},"Nghe kém thì đi lắp máy trợ thính, lý do lắp là để nghe rõ, không phải để phòng chứng mất trí nhớ"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["Thêm trong chủ đề này"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/33-12"},"children":[{"tag":"strong","props":{},"children":["Chó dẫn đường cho người mù được vào nơi công cộng và phương tiện giao thông công cộng, người mù đi xe buýt trong thành phố miễn phí"]},{"tag":"span","props":{},"children":["Pháp luật quy định nơi công cộng và giao thông công cộng phải tạo điề…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/33-13"},"children":[{"tag":"strong","props":{},"children":["Thí sinh khuyết tật dự kỳ thi tuyển sinh đại học có thể xin biện pháp hỗ trợ hợp lý, dùng đề braille thì kéo dài thời gian thi thêm một nửa"]},{"tag":"span","props":{},"children":["Thí sinh khuyết tật dự kỳ thi tuyển sinh đại học có thể xin đề braill…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/33-14"},"children":[{"tag":"strong","props":{},"children":["Trẻ khuyết tật xin nhập học, nhà trường không được từ chối; trẻ không đến được trường thì phòng giáo dục sắp xếp giảng viên đến tận nhà"]},{"tag":"span","props":{},"children":["Trường mầm non và mọi loại trường không được từ chối trẻ khuyết tật đ…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/33-18"},"children":[{"tag":"strong","props":{},"children":["Nói một người thành niên「không quản lý được việc của mình」thì phải xin tòa án công nhận, người nhà nói không tính"]},{"tag":"span","props":{},"children":["Một người thành niên có「không có năng lực hành vi dân sự」hay「có năng …"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/33-19"},"children":[{"tag":"strong","props":{},"children":["Người giám hộ của người thành niên được xác định theo thứ tự luật định; người được giám hộ gây hại cho người khác thì người giám hộ bồi thường"]},{"tag":"span","props":{},"children":["Người thành niên mất năng lực hành vi thì người giám hộ được xác định…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/33-20"},"children":[{"tag":"strong","props":{},"children":["Bị từ chối tuyển, không được chuyển biên chế, bị trả lương thiếu vì khuyết tật thì có thể kiện, nhưng hãy tính chi phí trong quá trình trước"]},{"tag":"span","props":{},"children":["Pháp luật cấm phân biệt đối xử với người khuyết tật trong việc tuyển …"]}]}]}]},{"tag":"a","props":{"className":"life-text-link","href":"/vi/book/33"},"children":["Đọc toàn bộ chủ đề: Sống sau khi bị khuyết tật"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"15","height":"15","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","