ja/tip/20-10"},"children":[{"tag":"span","props":{},"children":["10"]},"おむつ選びはブランドではなく3つのポイントを見る：サイズ感、交換頻度、抜き打ち検査の通知歴"]},{"tag":"a","props":{"href":"/ja/tip/20-11"},"children":[{"tag":"span","props":{},"children":["11"]},"大型用品は「借りる、中古を買う、新品を買う」の順で検討し、一度に揃えようとしない"]},{"tag":"a","props":{"href":"/ja/tip/20-12"},"children":[{"tag":"span","props":{},"children":["12"]},"重度の湿疹や卵アレルギーがある場合、ピーナッツを避けるのではなく、医師の指導に従って早めに取り入れる。ただし、粒のまま与えるのは絶対にNG"]},{"tag":"a","props":{"href":"/ja/tip/20-13"},"children":[{"tag":"span","props":{},"children":["13"]},"新生児黄疸を見逃さないためのサイン：生後 24 時間以内の黄疸、悪化する黄疸、呼びかけへの反応低下・授乳困難、白っぽい便が見られたら、当日中に病院へ"]},{"tag":"a","props":{"href":"/ja/tip/20-14"},"children":[{"tag":"span","props":{},"children":["14"]},"妊娠中や授乳中に菜食をしているなら、ビタミンB12を毎日補給する。子供の離乳食には動物性食品を入れ、完全菜食にするなら、まず医師に相談する"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"現在地"},"children":[{"tag":"a","props":{"href":"/ja/book"},"children":["本を読む"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/ja/book/20"},"children":["第20章"," ·"," ","生まれたばかりの赤ちゃんの育て方"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"20-09"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["09"]},{"tag":"span","props":{"className":"life-evidence grade-b"},"children":["エビデンス"," ","B"]}]},{"tag":"h1","props":{"lang":"ja"},"children":["どんなに疲れ、怒っていても、赤ちゃんを揺らしてはいけません"]},{"tag":"p","props":{"lang":"ja","className":"life-entry-summary"},"children":["赤ちゃんの頭は大きく、首には力がありません。強く揺さぶると、脳内や眼内に出血を引き起こし、命を落としたり、一生残る障害が残ったりする可能性があります。寝かしつけの際の軽い揺れは問題ありませんが、危険なのは制御できないほどの激しい揺さぶりです。怒りが抑えられなくなりそうな時は、一度赤ちゃんをベビーベッドに戻し、その場を数分間離れてください。抱っこして揺らすよりも、少し泣かせる方がずっと安全です。"]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["費用・手間"]},{"tag":"p","props":{},"children":["費用はかかりません。難しいのは、自分自身が疲れ果て、怒りに震えている時に手を止めることです。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["効果"]},{"tag":"p","props":{},"children":["赤ちゃんの頭部は占める割合が大きく、頸部の筋肉は弱いです。激しく揺さぶると、頭蓋内出血や網膜出血（脳や目の中の出血）を引き起こし、死に至ることもあれば、生涯にわたる障害を残すこともあります。"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"記録する：どんなに疲れ、怒っていても、赤ちゃんを揺らしてはいけません"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"できている"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"やることに追加"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true