"children":[{"tag":"div","props":{"className":"life-ad-rail","data-dock-active":"false","style":{"top":"94px"}},"children":[{"tag":"div","props":{"className":"life-ad-dock","hidden":true},"children":[{"tag":"aside","props":{"className":"life-ad-space life-ad-space-sponsored life-ad-space-compact","data-ad-placement":"ad_dock","data-ad-group":"reading","data-ad-creative":"read_product","data-ad-ready":"false","aria-label":"Реклама · Рекомендация сообщества"},"children":[{"tag":"button","props":{"type":"button","className":"life-ad-dismiss","aria-label":"Закрыть рекламу"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-x","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M18 6 6 18"},"children":[]},{"tag":"path","props":{"d":"m6 6 12 12"},"children":[]}]}]},{"tag":"div","props":{"className":"life-ad-space-brand"},"children":[{"tag":"img","props":{"src":"/sites/howtolivebetter/images/shengcai/logo.png","width":"565","height":"144","alt":"Официальный логотип Shengcai Youshu","decoding":"async"},"children":[]}]},{"tag":"div","props":{"className":"life-ad-space-copy"},"children":[{"tag":"span","props":{"className":"life-ad-space-label"},"children":["Реклама · Рекомендация сообщества"]},{"tag":"strong","props":{},"children":["Могут ли ваши знания стать полезным продуктом?"]},{"tag":"p","props":{},"children":["От электронных книг до инструментов: как участники находят потребности и создают то, чем можно пользоваться."]}]},{"tag":"div","props":{"className":"life-ad-space-actions"},"children":[{"tag":"a","props":{"className":"life-ad-space-link","href":"/ru/shengcaiyoushu?sc_group=reading&sc_creative=read_product&sc_placement=ad_dock"},"children":["О сообществе и примерах",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"18","height":"18","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-up-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M7 7h10v10"},"children":[]},{"tag":"path","props":{"d":"M7 17 17 7"},"children":[]}]}]}]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/ru/book/06"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"К содержанию"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["Перечень вредных средств"]},{"tag":"div","props":{"data-ad-dock-host":"true"},"children":[]},{"tag":"nav","props":{"aria-label":"Советы главы"},"children":[{"tag":"a","props":{"href":"/ru/tip/06-01"},"children":[{"tag":"span","props":{},"children":["01"]},"Не стоит принимать поливитамины ради долголетия или профилактики сердечно-сосудистых заболеваний"]},{"tag":"a","props":{"href":"/ru/tip/06-02"},"children":[{"tag":"span","props":{},"children":["02"]},"Не стоит принимать обычное рыбье масло ради профилактики сердечно-сосудистых заболеваний"]},{"tag":"a","props":{"href":"/ru/tip/06-03"},"children":[{"tag":"span","props":{},"children":["03"]},"Не стоит давать витамин D людям, у которых его уровень в норме, ради долголетия"]},{"tag":"a","props":{"href":"/ru/tip/06-04"},"children":[{"tag":"span","props":{},"children":["04"]},"Не стоит принимать антиоксидантные добавки ради профилактики рака (бета-каротин, витамин E, витамин A)"]},{"tag":"a","props":{"href":"/ru/tip/06-05"},"children":[{"tag":"span","props":{},"children":["05"]},"Не стоит рассчитывать на глюкозамин и хондроитин при лечении артрита коленного сустава"]},{"tag":"a","props":{"href":"/ru/tip/06-06"},"children":[{"tag":"span","props":{},"children":["06"]},"Не стоит использовать витамин C для профилактики простуды"]},{"tag":"a","props":{"href":"/ru/tip/06-07"},"children":[{"tag":"span","props":{},"children":["07"]},"Не стоит делать себе «полный ПЭТ-КТ» или «панель онкомаркеров», если у вас нет симптомов"]},{"tag":"a","props":{"href":"/ru/tip/06-08"},"children":[{"tag":"span","props":{},"children":["08"]},"Не стоит рассчитывать, что трекеры активности помогут вам похудеть"]},{"tag":"a","props":{"href":"/ru/tip/06-09"},"children":[{"tag":"span","props":{},"children":["09"]},"Не стоит переплачивать за органические продукты ради «большего здоровья»"]},{"tag":"a","props":{"href":"/ru/tip/06-10"},"children":[{"tag":"span","props":{},"children":["10"]},"Не стоит тратить большие деньги на БАДы, пастообразные смеси и пищевые добавки для «укрепления здоровья»"]},{"tag":"a","props":{"href":"/ru/tip/06-11"},"children":[{"tag":"span","props":{},"children":["11"]},"Не стоит долго принимать пробиотики при отсутствии проблем с кишечником"]},{"tag":"a","props":{"href":"/ru/tip/06-12"},"children":[{"tag":"span","props":{},"children":["12"]},"Не стоит заставлять себя принимать холодный душ ради «укрепления иммунитета»"]},{"tag":"a","props":{"href":"/ru/tip/06-13"},"children":[{"tag":"span","props":{},"children":["13"]},"Не стоит покупать продукты для детоксикации, очищения кишечника, энзимные добавки или щелочную воду"]},{"tag":"a","props":{"href":"/ru/tip/06-14"},"children":[{"tag":"span","props":{},"children":["14"]},"Не стоит заставлять себя пить воду лишь ради достижения цели «8 стаканов в день»"]},{"tag":"a","props":{"href":"/ru/tip/06-15"},"children":[{"tag":"span","props":{},"children":["15"]},"Не тратьте деньги на гадания, Таро или астрологию, чтобы принимать решения"]},{"tag":"a","props":{"href":"/ru/tip/06-16"},"children":[{"tag":"span","props":{},"children":["16"]},"Не стоит покупать очки с защитой от синего света, чтобы «охранять зрение», и не верьте утверждениям, будто «после нескольких месяцев работы за экраном зрение испортится». Однако сильная боль, отёчность и покраснение глаз — это повод для срочного обращения к врачу"]},{"tag":"a","props":{"href":"/ru/tip/06-17"},"children":[{"tag":"span","props":{},"children":["17"]},"Не стоит рассматривать донорство крови как способ укрепить здоровье: утверждения о «детоксикации, снижении уровня холестерина и профилактике инфаркта» не подтверждены рандомизированными исследованиями, а частое донорство действительно приводит к дефициту железа"]},{"tag":"a","props":{"href":"/ru/tip/06-18"},"children":[{"tag":"span","props":{},"children":["18"]},"Не стоит полагаться на стандартные пакеты медосмотров для профилактики — достаточно проводить те обследования, эффективность которых подтверждена данными, с учётом возраста и пола"]},{"tag":"a","props":{"href":"/ru/tip/06-19"},"children":[{"tag":"span","props":{},"children":["19"]},"Не стоит принимать препараты для снижения уровня мочевой кислоты только потому, что анализы показали её повышение, а боли никогда не было"]},{"tag":"a","props":{"href":"/ru/tip/06-20"},"children":[{"tag":"span","props":{},"children":["20"]},"Не стоит делать профилактическую операцию по удалению желчного пузыря только потому, что при обследовании обнаружили камни, а боли никогда не было"]},{"tag":"a","props":{"href":"/ru/tip/06-21"},"children":[{"tag":"span","props":{},"children":["21"]},"Не стоит отказываться от кальция ради профилактики камней в почках"]},{"tag":"a","props":{"href":"/ru/tip/06-22"},"children":[{"tag":"span","props":{},"children":["22"]},"Не стоит покупать кристаллы, браслеты или фигурки пи-сюй ради «улучшения удачи», «привлечения богатства» или «помощи в саморазвитии»"]},{"tag":"a","props":{"href":"/ru/tip/06-23"},"children":[{"tag":"span","props":{},"children":["23"]},"Не стоит рассчитывать, что покупки улучшат настроение или самооценку"]},{"tag":"a","props":{"href":"/ru/tip/06-24"},"children":[{"tag":"span","props":{},"children":["24"]},"Не тратьте лишние деньги на новую квартиру, машину или круг общения лишь ради того, чтобы «подняться в социальном статусе»"]},{"tag":"a","props":{"href":"/ru/tip/06-25"},"children":[{"tag":"span","props":{},"children":["25"]},"Не верьте утверждению «воля — это как мышца, которая быстро устает»"]},{"tag":"a","props":{"href":"/ru/tip/06-26"},"children":[{"tag":"span","props":{},"children":["26"]},"Не стоит рассчитывать, что завтрак или режим питания 16:8 помогут вам контролировать вес — выбирайте тот график, который сможете соблюдать долгое время"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/ru/tip/06-27","data-status":"active"},"children":[{"tag":"span","props":{},"children":["27"]},"Не верьте в то, что «мастурбация вредит здоровью» или что «нужно воздерживаться, чтобы стать лучше»; на самом деле важно лишь то, не мешает ли это вашему сну, работе и отношениям"]},{"tag":"a","props":{"href":"/ru/tip/06-28"},"children":[{"tag":"span","props":{},"children":["28"]},"Не тратьте деньги на «исправление сексуальной ориентации» или «лечение гомосексуальности», и не отправляйте туда своих близких"]},{"tag":"a","props":{"href":"/ru/tip/06-29"},"children":[{"tag":"span","props":{},"children":["29"]},"Не рассчитывайте предотвратить боль в пояснице «правильной техникой подъема» и курсами: уменьшайте вес и число подъемов, регулярно занимайтесь физической нагрузкой"]},{"tag":"a","props":{"href":"/ru/tip/06-30"},"children":[{"tag":"span","props":{},"children":["30"]},"Не рассчитывайте, что большие дозы кальция и костный бульон ускорят сращение перелома"]},{"tag":"a","props":{"href":"/ru/tip/06-31"},"children":[{"tag":"span","props":{},"children":["31"]},"Не стоит полагаться на ИИ-чат-бот в одиночку, когда нужно оценить болезнь или юридический вопрос: прежде чем идти к врачу, в суд или тратить большие деньги, найдите первоисточник, на который он ссылается, и проверьте по оригиналу"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"Навигация"},"children":[{"tag":"a","props":{"href":"/ru/book"},"children":["Книга"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/ru/book/06"},"children":["Глава 6"," ·"," ","Перечень вредных средств"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"06-27"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["27"]},{"tag":"span","props":{"className":"life-evidence grade-b"},"children":["Доказательства"," ","B"]}]},{"tag":"h1","props":{"lang":"ru"},"children":["Не верьте в то, что «мастурбация вредит здоровью» или что «нужно воздерживаться, чтобы стать лучше»; на самом деле важно лишь то, не мешает ли это вашему сну, работе и отношениям"]},{"tag":"p","props":{"lang":"ru","className":"life-entry-summary"},"children":["Исследования не говорят, что мастурбация вредит здоровью. У мужчин с более частой эякуляцией рака простаты примерно на пятую часть меньше, но некоторые исследования находят более высокий риск при частой эякуляции в молодости. У немногих после каждой эякуляции появляются слабость и симптомы как при гриппе на несколько дней: это редкое заболевание, с которым можно обратиться к урологу или андрологу. Ощущение «зависимости от порнографии» чаще связано с конфликтом с собственными моральными убеждениями."]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Затраты"]},{"tag":"p","props":{},"children":["Бесплатно. Вы экономите деньги, которые могли бы потратить…"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Польза"]},{"tag":"p","props":{},"children":["Сначала о теле. В США наблюдали 31925 мужчин до 2010 года. Они сами сообщали число эякуляций в месяц, и их гру…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"Отметить: Не верьте в то, что «мастурбация вредит здоровью» или что «нужно воздерживаться, чтобы стать лучше»; на самом деле важно лишь то, не мешает ли это вашему сну, работе и отношениям"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"Сделано"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"В планах"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"В избранное"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Поделиться советом"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Скрыть подробности"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Затраты"]},{"tag":"p","props":{},"children":["Бесплатно. Вы экономите деньги, которые могли бы потратить на «лечебные» народные средства для «укрепления почек» и курсы по «воздержанию», а также избавляетесь от долгосрочной тревоги, вызванной чувством вины."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Польза"]},{"tag":"p","props":{},"children":["Сначала о теле. В США наблюдали 31925 мужчин до 2010 года. Они сами сообщали число эякуляций в месяц, и их группировали по частоте. По сравнению с 4–7 разами в месяц, при более 21 раза HR рака простаты составляло 0,81 (95% ДИ 0,72–0,92, примерно на 19% ниже), если брать частоту в 20–29 лет. Для частоты в 40–49 лет HR было 0,78 (0,69–0,89, примерно на 22% ниже). В основном речь шла о низкорисковом раке простаты. Противоположные данные — британское исследование случай–контроль: 431 пациент с диагнозом до 60 лет и 409 участников контроля. При частой мастурбации в двадцать–тридцать лет риск был выше, в пятьдесят с лишним — ниже. Систематический обзор и метаанализ порнографии связывает ощущение «зависимости» не только с частотой просмотра, но и с несовпадением поведения и убеждений. У некоторых после каждой эякуляции действительно возникает недомогание, но это редкий синдром посторгазмического недомогания (POIS), а не общее «разрушение здоровья». Нужен врач, а не попытка вылечиться воздержанием. Среди 45 нидерландских пациентов у 87% симптомы начинались в течение 30 минут, у 80% была усталость и слабость, у 78% — гриппоподобные симптомы. У 37 пациентов французской больницы восстановление занимало в среднем 4,7 дня. Причина не выяснена. В нидерландской работе 29 из 33 прошедших кожную пробу (88%) реагировали на собственную сперму. Но китайская работа с 24 пациентами не обнаружила специфических к сперме аллергических антител; показатели тревоги и депрессии были повышены. Обзор 2025 года нашёл лишь 14 исследований лечения, из них 12 — описания отдельных случаев. Среди 211 специалистов по сексуальной медицине во всём мире только 18% сообщили об улучшении более чем у 30% пациентов (США / Великобритания / Нидерланды / Франция / Китай)."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Первоисточники"]},{"tag":"p","props":{"className":"life-citations"},"children":["Rider JR, Wilson KM, Sinnott JA, et al. (2016). Ejaculation Frequency and Risk of Prostate Cancer: Updated Results with an Additional Decade of Follow-up. European Urology, 70(6), 974–982. ",{"tag":"a","props":{"href":"https://doi.org/10.1016/j.eururo.2016.03.027","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1016/j.eururo.2016.03.027"]},"；Dimitropoulou P, Lophatananon A, Easton D, et al. (2009). Sexual activity and prostate cancer risk in men diagnosed at a younger age. BJU International, 103(2), 178–185. ",{"tag":"a","props":{"href":"https://doi.org/10.1111/j.1464-410x.2008.08030.x","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1111/j.1464-410x.2008.08030.x"]},"；Grubbs JB, Perry SL, Wilt JA, Reid RC. (2019). Pornography Problems Due to Moral Incongruence: An Integrative Model with a Systematic Review and Meta-Analysis. Archives of Sexual Behavior, 48(2), 397–415. ",{"tag":"a","props":{"href":"https://doi.org/10.1007/s10508-018-1248-x","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1007/s10508-018-1248-x"]},"；Waldinger MD, Meinardi MM, Zwinderman AH, Schweitzer DH. (2011). Postorgasmic Illness Syndrome (POIS) in 45 Dutch caucasian males: clinical characteristics and evidence for an immunogenic pathogenesis (Part 1). The Journal of Sexual Medicine, 8(4), 1164–1170. ",{"tag":"a","props":{"href":"https://doi.org/10.1111/j.1743-6109.2010.02166.x","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1111/j.1743-6109.2010.02166.x"]},"；Chea M, Teng M, Chesnel C, et al. (2023). Postorgasmic illness syndrome: one or several entities? A retrospective cohort study. The Journal of Sexual Medicine, 20(12), 1407–1413. ",{"tag":"a","props":{"href":"https://doi.org/10.1093/jsxmed/qdad139","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1093/jsxmed/qdad139"]},"；Xi GP, Yang RX, Zhang J, et al. (2023). Clinical characteristics, allergic response to autologous semen, and desensitization in patients with postorgasmic illness syndrome. Sexual Medicine, 11(6), qfad068. ",{"tag":"a","props":{"href":"https://doi.org/10.1093/sexmed/qfad068","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1093/sexmed/qfad068"]},"；Ponce S, Chapalamadugu M, Levine S, et al. (2025). Treatments for postorgasmic illness syndrome: a systematic review. The Journal of Sexual Medicine, 22(7), 1236–1243. ",{"tag":"a","props":{"href":"https://doi.org/10.1093/jsxmed/qdaf112","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1093/jsxmed/qdaf112"]},"；Duran MB, Rubin RS, Reisman Y, Serefoglu EC, et al. (2025). Recognition and practice patterns of sexual medicine experts towards postorgasmic illness syndrome. International Journal of Impotence Research, 37(6), 454–457. ",{"tag":"a","props":{"href":"https://doi.org/10.1038/s41443-023-00753-x","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1038/s41443-023-00753-x"]}]},{"tag":"a","props":{"href":"https://doi.org/10.1016/j.eururo.2016.03.027","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Открыть источник"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Примечание автора"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["Спорно. Обе работы о раке простаты были наблюдательными, без случайного распределения, а частоту вспоминали сами участники. Вывод ограничивается отсутствием обнаруженных доказательств вреда; он не обосновывает совет делать это чаще. Авторы британской работы допускают, что в возрасте за пятьдесят болезнь могла сначала снизить активность. В аннотации обзора порнографии нет размера эффекта, поэтому указан только характер связи. Польза малая, поскольку снижение касается главным образом низкорискового рака, а не смерти. Исследования недомогания после эякуляции включали лишь десятки пациентов. В литературе заболевание называют редким, но распространённость в общей популяции никто не измерял. Если почти после каждой эякуляции появляются слабость, симптомы как при гриппе и восстановление занимает дни, идите к урологу или андрологу и назовите POIS. Поводы обратиться к психиатру или психологу: недосыпание, пропуски работы, вред отношениям и невозможность остановиться при желании. О позднем отходе ко сну — раздел 3, пункт 9 (не жертвовать сном ради игр, коротких видео и порнографии). При тревоге об эрекции сначала проверьте сердечно-сосудистую систему — раздел 1, пункт 28. Правовые последствия отправки материалов в группы и продажи — раздел 9, пункт 4 (личный просмотр — отдельный вопрос). Польза прежде всего для вас."]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Моя заметка"]},{"tag":"button","props":{"type":"button"},"children":["Запишите напоминание…"]}]}]}]},{"tag":"nav","props":{"className