ren":[]}]},{"tag":"div","props":{},"children":[{"tag":"p","props":{},"children":["Ответьте на 5 вопросов за родителей и узнайте, что им стоит сделать в первую очередь: защита от мошенников, безопасные домашние лекарства, обследования, опека по соглашению и страхование долгосрочного ухода."]},{"tag":"div","props":{"className":"checkup-intro-actions"},"children":[{"tag":"button","props":{"type":"button","className":"life-button ghost"},"children":["Сделать для родителей",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]},{"tag":"a","props":{"className":"checkup-retake","href":"/ru/checkup/plans"},"children":["Мои планы действий"]}]}]}]},{"tag":"p","props":{"className":"checkup-fine"},"children":["Ответы сначала сохраняются на этом устройстве. Войдите, чтобы сохранить план для родителей в аккаунте и продолжить на другом устройстве. При включённой аналитике варианты входят в анонимные итоги."]}]},{"tag":"div","props":{"className":"page-guide"},"children":[{"tag":"section","props":{"aria-labelledby":"checkup-about-title"},"children":[{"tag":"div","props":{"className":"life-eyebrow"},"children":["О проверке жизни"]},{"tag":"h2","props":{"id":"checkup-about-title"},"children":["Что такое проверка жизни?"]},{"tag":"p","props":{},"children":["Проверка жизни — бесплатный тест из 5 вопросов. По вашему возрасту, способу передвижения, семейной ситуации, работе и тому, что вы хотите улучшить, она выбирает из 677 совета книги 10, которые вам стоит выполнить в первую очередь."]},{"tag":"p","props":{},"children":["Выбор основан на затратах и пользе, указанных в книге для каждого совета: сначала идут советы, которые требуют мало денег, времени и силы воли, а дают большую пользу. Из одной темы берётся не больше двух советов, уже выполненные пропускаются."]}]},{"tag":"section","props":{"aria-labelledby":"checkup-steps-title"},"children":[{"tag":"h2","props":{"id":"checkup-steps-title"},"children":["Три минуты: от 677 совета к вашим 10"]},{"tag":"ol","props":{"className":"page-guide-steps"},"children":[{"tag":"li","props":{},"children":[{"tag":"span","props":{},"children":["0","1"]},{"tag":"h3","props":{},"children":["Ответьте на 5 вопросов"]},{"tag":"p","props":{},"children":["Все вопросы с вариантами ответа, в большинстве можно выбрать несколько. Личные данные не нужны."]}]},{"tag":"li","props":{},"children":[{"tag":"span","props":{},"children":["0","2"]},{"tag":"h3","props":{},"children":["Посмотрите свои 10 советов"]},{"tag":"p","props":{},"children":["У каждого есть краткое пояснение и ссылка на полный текст. Отметить выполненным или добавить в задачи можно сразу."]}]},{"tag":"li","props":{},"children":[{"tag":"span","props":{},"children":["0","3"]},{"tag":"h3","props":{},"children":["Добавьте всё в задачи"]},{"tag":"p","props":{},"children":["Советы попадут в «Мой список»: там виден прогресс, а задачи можно выгрузить в календарь — по одной в неделю."]}]}]}]},{"tag":"section","props":{"className":"page-guide-faq","aria-labelledby":"checkup-faq-title"},"children":[{"tag":"h2","props":{"id":"checkup-faq-title"},"children":["Частые вопросы о проверке жизни"]},{"tag":"details","props":{},"children":[{"tag":"summary","props":{},"children":["Нужна регистрация или оплата?"]},{"tag":"p","props":{},"children":["Нет. Проверка, результаты и добавление в задачи работают без входа, список хранится в этом браузере. После входа его можно синхронизировать между устройствами."]}]},{"tag":"details","props":{},"children":[{"tag":"summary","props":{},"children":["Мои ответы куда-то отправляются?"]},{"tag":"p","props":{},"children":["Нет. Они хранятся только в этом браузере, чтобы в следующий раз показать прошлый результат. Ссылка для отправки тоже не содержит ваших ответов."]}]},{"tag":"details","props":{},"children":[{"tag":"summary","props":{},"children":["Как получается результат?"]},{"tag":"p","props":{},"children":["Каждый ответ повышает вес связанных тем. Затем советы оцениваются по пользе, деньгам, времени и силе воли из книги, а также по порядку советов внутри темы. Это прозрачное правило, а не персональная медицинская, юридическая или финансовая консультация."]}]},{"tag":"details","props":{},"children":[{"tag":"summary","props":{},"children":["Почему некоторые советы мне не подходят?"]},{"tag":"p","props":{},"children":["Пять вопросов не охватывают всех ситуаций. Неподходящие советы можно пропустить или продолжить выбор в книге по темам и уровню доказательств."]}]},{"tag":"details","props":{},"children":[{"tag":"summary","props":{},"children":["Как часто проходить проверку?"]},{"tag":"p","props":{},"children":["Когда меняется жизнь: новая работа, переезд, рождение ребёнка. Выполненные советы пропускаются, и вы получите следующую подборку."]}]}]}]}]},{"tag":"nav","props":{"className":"life-tabbar","aria-label":"Основная навигация"},"children":[{"tag":"a","props":{"className":"","href":"/ru/book"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"21","height":"21","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-book-open","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M12 7v14"},"children":[]},{"tag":"path","props":{"d":"M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z"},"children":[]}]},{"tag":"span","props":{},"children":["Книга"]}]},{"tag":"a","props":{"className":"","href":"/ru/top-50"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"21","height":"21","viewBox":"0 0 24 24","fill":"none","stroke":"currentCo