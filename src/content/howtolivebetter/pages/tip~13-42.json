e","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"返回目录"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["紧急情况：先做什么"]},{"tag":"div","props":{"data-ad-dock-host":"true"},"children":[]},{"tag":"nav","props":{"aria-label":"章节条目"},"children":[{"tag":"a","props":{"href":"/tip/13-01","className":""},"children":[{"tag":"span","props":{},"children":["01"]},"有人倒地没呼吸，立刻用力按压胸口，让旁人打 120 并找 AED"]},{"tag":"a","props":{"href":"/tip/13-02","className":""},"children":[{"tag":"span","props":{},"children":["02"]},"老人摔倒、有人倒地，先蹲下喊他、打 120，别急着把人扶起来；陌生人这档走开在国内也合法，停下来就别上手搬"]},{"tag":"a","props":{"href":"/tip/13-03","className":""},"children":[{"tag":"span","props":{},"children":["03"]},"突然嘴歪、一侧胳膊没劲、说话说不清，立刻打 120，不要等、不要自己开车去"]},{"tag":"a","props":{"href":"/tip/13-04","className":""},"children":[{"tag":"span","props":{},"children":["04"]},"突然天旋地转站不稳、看东西成双、一只眼发黑，或者手指点不到自己鼻尖，也按卒中打 120"]},{"tag":"a","props":{"href":"/tip/13-05","className":""},"children":[{"tag":"span","props":{},"children":["05"]},"一只眼睛突然像拉下窗帘一样黑掉，哪怕几分钟就自己好了，也当天按卒中去急诊"]},{"tag":"a","props":{"href":"/tip/13-06","className":""},"children":[{"tag":"span","props":{},"children":["06"]},"一只眼又胀又痛、发红，看灯有一圈彩虹，还头痛恶心想吐，当天去眼科急诊"]},{"tag":"a","props":{"href":"/tip/13-07","className":""},"children":[{"tag":"span","props":{},"children":["07"]},"胸口压着疼、闷、发紧超过 15 分钟不缓解，打 120，不要自己扛也不要自己开车"]},{"tag":"a","props":{"href":"/tip/13-08","className":""},"children":[{"tag":"span","props":{},"children":["08"]},"突然像被撕开一样的剧痛，从胸口往后背、往腰一路挪，打 120 并说清「疼在移动」"]},{"tag":"a","props":{"href":"/tip/13-09","className":""},"children":[{"tag":"span","props":{},"children":["09"]},"突然一记「这辈子最疼的头痛」，一小时内就到最疼，立刻去急诊做头颅 CT"]},{"tag":"a","props":{"href":"/tip/13-10","className":""},"children":[{"tag":"span","props":{},"children":["10"]},"老人磕过头之后两三周到几个月变得走路不稳、迟钝、嗜睡或者一侧没劲，去做头颅 CT"]},{"tag":"a","props":{"href":"/tip/13-11","className":""},"children":[{"tag":"span","props":{},"children":["11"]},"一条腿突然肿起来、发紧、按着疼，尽快就医；再加上突然喘不上气或者胸痛，立刻打 120"]},{"tag":"a","props":{"href":"/tip/13-12","className":""},"children":[{"tag":"span","props":{},"children":["12"]},"大出血先用手死死压住伤口，四肢压不住就上止血带，同时打 120"]},{"tag":"a","props":{"href":"/tip/13-13","className":""},"children":[{"tag":"span","props":{},"children":["13"]},"被狗、猫咬伤或抓破皮，先用肥皂水和流水交替冲 15 分钟，当天去打疫苗"]},{"tag":"a","props":{"href":"/tip/13-14","className":""},"children":[{"tag":"span","props":{},"children":["14"]},"烫伤后立刻用凉的流动水冲 20 分钟，别抹牙膏酱油"]},{"tag":"a","props":{"href":"/tip/13-15","className":""},"children":[{"tag":"span","props":{},"children":["15"]},"突然全身起疹、喘不上气或者发晕，按过敏性休克处理，立刻叫 120 并说清楚"]},{"tag":"a","props":{"href":"/tip/13-16","className":""},"children":[{"tag":"span","props":{},"children":["16"]},"有人抽搐倒地，清开周围、让他侧躺、看表计时，什么都别往嘴里塞"]},{"tag":"a","props":{"href":"/tip/13-17","className":""},"children":[{"tag":"span","props":{},"children":["17"]},"糖尿病人突然发抖、出冷汗、说话不清，先给 15 克糖，15 分钟后复测"]},{"tag":"a","props":{"href":"/tip/13-18","className":""},"children":[{"tag":"span","props":{},"children":["18"]},"有人触电，先断电，再用干燥的木棍之类挑开电源，不要直接上手拉"]},{"tag":"a","props":{"href":"/tip/13-19","className":""},"children":[{"tag":"span","props":{},"children":["19"]},"一氧化碳报警器响了，或者一屋子人同时头痛恶心，先出门再打电话"]},{"tag":"a","props":{"href":"/tip/13-20","className":""},"children":[{"tag":"span","props":{},"children":["20"]},"误服清洁剂、农药、药物先别催吐，带上瓶子立刻就医；溅到眼睛或皮肤用大量清水至少冲 15 分钟"]},{"tag":"a","props":{"href":"/tip/13-21","className":""},"children":[{"tag":"span","props":{},"children":["21"]},"酸碱等化学品溅到身上，立刻脱掉污染的衣服、用大量流动清水冲，眼睛要掰开眼皮冲，冲够时间再走"]},{"tag":"a","props":{"href":"/tip/13-22","className":""},"children":[{"tag":"span","props":{},"children":["22"]},"高温下头晕、恶心、不出汗或意识不清，立刻挪到阴凉处脱衣泼水降温，意识不清的不喂水、打 120"]},{"tag":"a","props":{"href":"/tip/13-23","className":""},"children":[{"tag":"span","props":{},"children":["23"]},"中暑的人只要清醒，就少量多次喝凉的淡盐水或运动饮料，别猛灌、别喝酒和高糖饮料"]},{"tag":"a","props":{"href":"/tip/13-24","className":""},"children":[{"tag":"span","props":{},"children":["24"]},"火灾时贴地爬、摸门再开门、门烫就别开，走楼梯不坐电梯，出去了别回头"]},{"tag":"a","props":{"href":"/tip/13-25","className":""},"children":[{"tag":"span","props":{},"children":["25"]},"看到有人溺水，先叫人和打 110/120，伸竿、抛漂浮物，自己不下水"]},{"tag":"a","props":{"href":"/tip/13-26","className":""},"children":[{"tag":"span","props":{},"children":["26"]},"有人噎住说不出话，1 岁以上的站到背后做 5 次拍背加 5 次腹部冲击，倒下就做心肺复苏"]},{"tag":"a","props":{"href":"/tip/13-27","className":""},"children":[{"tag":"span","props":{},"children":["27"]},"在戈壁、沙漠、无人区迷路或车坏了，留在原地或车旁，先报位置，再遮阳保温，省水，不乱走"]},{"tag":"a","props":{"href":"/tip/13-28","className":""},"children":[{"tag":"span","props":{},"children":["28"]},"发抖、说话含糊、走路打晃是失温，换掉湿衣、包起来，先暖躯干，喝热甜饮不喝酒"]},{"tag":"a","props":{"href":"/tip/13-29","className":""},"children":[{"tag":"span","props":{},"children":["29"]},"被蛇咬，坐下别动、摘掉戒指手表、尽快送医院打抗蛇毒血清，不切、不吸、不绑死"]},{"tag":"a","props":{"href":"/tip/13-30","className":""},"children":[{"tag":"span","props":{},"children":["30"]},"地震时先看自己在什么房子里：符合抗震设防的楼里就地躲，会垮的老房子门在几步外就出去"]},{"tag":"a","props":{"href":"/tip/13-31","className":""},"children":[{"tag":"span","props":{},"children":["31"]},"遇到熊、野猪、成群野狗，别跑，侧身慢慢退开"]},{"tag":"a","props":{"href":"/tip/13-32","className":""},"children":[{"tag":"span","props":{},"children":["32"]},"野外遇上雷雨，钻进有硬顶的车或建筑，避开山脊、孤树、水面和金属"]},{"tag":"a","props":{"href":"/tip/13-33","className":""},"children":[{"tag":"span","props":{},"children":["33"]},"上高原按睡眠海拔（当晚睡在多高）慢慢升，症状加重就下撤，不要硬扛"]},{"tag":"a","props":{"href":"/tip/13-34","className":""},"children":[{"tag":"span","props":{},"children":["34"]},"被蜱虫叮住，用尖头镊子贴着皮肤稳稳拉出来，别涂油别用火烧"]},{"tag":"a","props":{"href":"/tip/13-35","className":""},"children":[{"tag":"span","props":{},"children":["35"]},"野外的水一律烧开再喝，滚开一分钟就够，不用因为海拔高多煮"]},{"tag":"a","props":{"href":"/tip/13-36","className":""},"children":[{"tag":"span","props":{},"children":["36"]},"荒郊野外被陌生人索财，钱给他，不动手，记特征，脱身后报警"]},{"tag":"a","props":{"href":"/tip/13-37","className":""},"children":[{"tag":"span","props":{},"children":["37"]},"撞见一群人打架，退开走人，别上去拉架、别围观、别捡地上的家伙；要报警就退到安全距离打 110"]},{"tag":"a","props":{"href":"/tip/13-38","className":""},"children":[{"tag":"span","props":{},"children":["38"]},"可能被 HIV 暴露了，72 小时内去拿阻断药，越早越好"]},{"tag":"a","props":{"href":"/tip/13-39","className":""},"children":[{"tag":"span","props":{},"children":["39"]},"救人受了伤、搭进了钱，先找加害人和医保，再去申报见义勇为确认"]},{"tag":"a","props":{"href":"/tip/13-40","className":""},"children":[{"tag":"span","props":{},"children":["40"]},"刀、钢筋、玻璃扎进身体，压住异物周围止血，不要把它拔出来"]},{"tag":"a","props":{"href":"/tip/13-41","className":""},"children":[{"tag":"span","props":{},"children":["41"]},"怀疑骨折就别再动那个部位，托着不动、冷敷 20 分钟以内，别自己掰正"]},{"tag":"a","props":{"href":"/tip/13-42","className":"active"},"children":[{"tag":"span","props":{},"children":["42"]},"被性侵之后，先到安全的地方打 110；验伤之前别洗澡、别洗衣服、别收拾房间，72 小时内去医院"]},{"tag":"a","props":{"href":"/tip/13-43","className":""},"children":[{"tag":"span","props":{},"children":["43"]},"不满 1 岁的婴儿噎住哭不出声，趴着拍背 5 下、翻过来按胸口 5 下，轮着做，别按肚子"]},{"tag":"a","props":{"href":"/tip/13-44","className":""},"children":[{"tag":"span","props":{},"children":["44"]},"不满 1 岁的婴儿没反应、没正常呼吸，开免提打 120，做婴儿心肺复苏：按 30 下吹 2 口气"]}]}]},{"tag":"div","props":{"className":"life-tip-page","data-tip-locales":"zh,en,ru,es,ja,vi"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"当前位置"},"children":[{"tag":"a","props":{"href":"/book"},"children":["阅读全书"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/book/13"},"children":["第 13 章 · 紧急情况：先做什么"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"13-42"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["42"]},{"tag":"span","props":{"className":"life-evidence grade-b"},"children":["证据 B"]}]},{"tag":"h1","props":{"lang":"zh"},"children":["被性侵之后，先到安全的地方打 110；验伤之前别洗澡、别洗衣服、别收拾房间，72 小时内去医院"]},{"tag":"p","props":{"lang":"zh","className":"life-entry-summary"},"children":["身上、衣服上和屋里留下的痕迹，是指认对方最要紧的证据。所以验伤前尽量别洗澡，也别洗衣服、收拾房间，尽早打 110。紧急避孕药药店就有，越早吃越有效。72 小时内去医院，让医生判断要不要吃阻断药。"]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["成本"]},{"tag":"p","props":{},"children":["报警不花钱。紧急避孕药是非处方药，药店就能买。阻断药一个疗程上千元，要不要吃由医生判断，见本节第 38 条（72 小时内去拿阻断药）。难的是当时很难开口，也很想马上洗个澡。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["收益"]},{"tag":"p","props":{},"children":["北京市人民检察院的检察官说：「无论是未成年人还是成年人，遇到侵害，都应当第一时间拨打110报警」。及时报警、就医，「便于侦查机关及时勘查现场、提取物证痕迹、固定证据」。贵州省民政厅转载的人民日报防性侵手册写：「一旦不幸遭遇性侵害，最重要的事情就是留存证据」。要保留「体液、毛发、皮屑、通信记录等证据」…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"标记：被性侵之后，先到安全的地方打 110；验伤之前别洗澡、别洗衣服、别收拾房间，72 小时内去医院"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"已做到"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"加入待做"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"收藏"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"分享这条建议"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"收起详情"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["成本"]},{"tag":"p","props":{"className":"life-citations"},"children":["报警不花钱。紧急避孕药是非处方药，药店就能买。阻断药一个疗程上千元，要不要吃由医生判断，见本节第 38 条（72 小时内去拿阻断药）。难的是当时很难开口，也很想马上洗个澡。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["收益"]},{"tag":"p","props":{"className":"life-citations"},"children":["北京市人民检察院的检察官说：「无论是未成年人还是成年人，遇到侵害，都应当第一时间拨打110报警」。及时报警、就医，「便于侦查机关及时勘查现场、提取物证痕迹、固定证据」。贵州省民政厅转载的人民日报防性侵手册写：「一旦不幸遭遇性侵害，最重要的事情就是留存证据」。要保留「体液、毛发、皮屑、通信记录等证据」，「被侵害后，不要擅自洗澡、洗衣物、收拾房间、扔东西」。熟人作案的，保留通话、通信记录。对方事后威胁或者收买，也要留下证据。北京市西城区人民检察院写的是：「在接受身体检查之前尽量不要洗澡」。世界卫生组织说，紧急避孕可以用在「女性在未采取有效的避孕保护措施时遭受性侵犯」的时候。建议在 5 天内用，越早越有效。含左炔诺孕酮（一种孕激素）的紧急避孕药，用过的女性怀孕率是 1.2% 到 2.1%。国内药店卖的左炔诺孕酮片是非处方药。武汉市卫健委的说法是：在无防护性生活后「72小时以内，服药越早，预防妊娠效果越好」。艾滋病阻断药要尽可能 2 小时内吃上，最晚不超过 72 小时（全国）"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["来源"]},{"tag":"p","props":{"className":"life-citations"},"children":["北京市人民检察院 (2024). 法眼看剧丨看《九部的检察官》 未成年人面对不法侵害该如何保护自己？（转载中央广播电视总台中国之声）. ",{"tag":"a","props":{"href":"https://www.bjjc.gov.cn/c/bjoweb/mtbg1/75046.jhtml","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.bjjc.gov.cn/c/bjoweb/mtbg1/75046.jhtml"]},"；贵州省民政厅 (2024). 未成年人防性侵手册，请家长孩子查收！（转载人民日报）. ",{"tag":"a","props":{"href":"https://mzt.guizhou.gov.cn/xwzx/mzyw/202407/t20240723_85145012.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://mzt.guizhou.gov.cn/xwzx/mzyw/202407/t20240723_85145012.html"]},"；北京市西城区人民检察院 (2018). 她们为什么不再沉默……. ",{"tag":"a","props":{"href":"https://www.bjjc.gov.cn/c/xicheng/xjjsl/320654084.jhtml","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.bjjc.gov.cn/c/xicheng/xjjsl/320654084.jhtml"]},"；世界卫生组织 (2021). 紧急避孕（实况报道）. ",{"tag":"a","props":{"href":"https://www.who.int/zh/news-room/fact-sheets/detail/emergency-contraception","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.who.int/zh/news-room/fact-sheets/detail/emergency-contraception"]},"；武汉市卫生健康委员会 (2020). 安全合理使用紧急避孕药. ",{"tag":"a","props":{"href":"https://wjw.wuhan.gov.cn/ztzl_28/fyjkkp/szjk/202010/t20201009_1461161.shtml","target":"_blank","rel":"noopener noreferrer"},"children":["https://wjw.wuhan.gov.cn/ztzl_28/fyjkkp/szjk/202010/t20201009_1461161.shtml"]},"；北京市人民政府. 事前、事后分不清？六问六答全面了解艾滋病病毒暴露前/暴露后预防. ",{"tag":"a","props":{"href":"https://www.beijing.gov.cn/fuwu/bmfw/jhsyfwzdzx/sjazbr/fakp/202311/t20231110_3299397.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.beijing.gov.cn/fuwu/bmfw/jhsyfwzdzx/sjazbr/fakp/202311/t20231110_3299397.html"]},""]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["原书备注"]},{"tag":"p","props":{"className":"life-citations"},"children":["给 B 是因为这些是官方的办案经验和用药建议，没有「照做之后定罪率高多少」的数字。受益人主要是你自己和家人。紧急避孕药的 72 小时是国内说明书的口径，世界卫生组织说 5 天内都有用，但越晚越差，别拖。已经怀孕的，紧急避孕药没有作用。报警时如实说，不隐瞒，也不夸大。对方事后找你私了、给钱或者威胁你，都留下记录，别删。想好了再报警也可以，但证据会随时间消失。不管报不报警，都要在时限内去医院。录音见第 8 节第 41 条（录音）。对方事后拿照片、拿报警来要挟你，同样是犯罪，见第 8 节第 32 条（对方拿报警、发照片来要钱）。朋友出了这种事，陪对方去报警、去医院，别先劝对方洗个澡休息一下。"]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["我的备注"]},{"tag":"button","props":{"type":"button"},"children":["写下对自己有用的提醒…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/tip/13-41"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["上一条"]},"怀疑骨折就别再动那个部位，托着不动、冷敷 20 分钟以内，别自己掰正"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/tip/13-43"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["下一条"]},"不满 1 岁的婴儿噎住哭不出声，趴着拍背 5 下、翻过来按胸口 5 下，轮着做，别按肚子"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["本主题的其他建议"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/13-36"},"children":[{"tag":"strong","props":{},"children":["荒郊野外被陌生人索财，钱给他，不动手，记特征，脱身后报警"]},{"tag":"span","props":{},"children":["钱给他，不动手，不还嘴。对方为几百块冒的是抢劫罪：三年以上十年以下起步，入户、持枪、致人重伤死亡的十年以上，直到死刑。他拿了钱转身走，你追上去打就不再算正当防卫…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/13-37"},"children":[{"tag":"strong","props":{},"children":["撞见一群人打架，退开走人，别上去拉架、别围观、别捡地上的家伙；要报警就退到安全距离打 110"]},{"tag":"span","props":{},"children":["你一动手，劝架就成了参加打架。参加聚众斗殴判 3 年以下，人多、在马路上、拿了家伙的判 3 到 10 年。围观也容易被误伤。该做的是退开走人。愿意报警就退到安全…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/13-38"},"children":[{"tag":"strong","props":{},"children":["可能被 HIV 暴露了，72 小时内去拿阻断药，越早越好"]},{"tag":"span","props":{},