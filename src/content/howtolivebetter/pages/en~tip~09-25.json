th":"18","height":"18","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-up-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M7 7h10v10"},"children":[]},{"tag":"path","props":{"d":"M7 17 17 7"},"children":[]}]}]}]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/en/book/09"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"Back to index"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["Legal pitfalls that ordinary people often overlook"]},{"tag":"div","props":{"data-ad-dock-host":"true"},"children":[]},{"tag":"nav","props":{"aria-label":"Chapter entries"},"children":[{"tag":"a","props":{"href":"/en/tip/09-01"},"children":[{"tag":"span","props":{},"children":["01"]},"Do not share unverified messages about disasters, epidemics, or police incidents in groups; do not photoshop images or use AI to generate fake scene pictures"]},{"tag":"a","props":{"href":"/en/tip/09-02"},"children":[{"tag":"span","props":{},"children":["02"]},"Do not post, share, or comment images, memes, or remarks that insult heroes and martyrs, nor make jokes about the national flag or anthem"]},{"tag":"a","props":{"href":"/en/tip/09-03"},"children":[{"tag":"span","props":{},"children":["03"]},"After viewing content on foreign websites, simply close the page — do not screenshot, share, repost, or discuss it in any groups or comment sections"]},{"tag":"a","props":{"href":"/en/tip/09-04"},"children":[{"tag":"span","props":{},"children":["04"]},"Watching porn alone is fine, but don’t post it in groups, sell “resources,” or create groups"]},{"tag":"a","props":{"href":"/en/tip/09-05"},"children":[{"tag":"span","props":{},"children":["05"]},"Part-time jobs that ask you to use your own card to receive payments, withdraw cash, or transfer money — no matter how much extra pay they offer, avoid them"]},{"tag":"a","props":{"href":"/en/tip/09-06"},"children":[{"tag":"span","props":{},"children":["06"]},"Some people try to get you to “package loan applicants” for them and offer a commission based on the loan amount — don’t fall for it"]},{"tag":"a","props":{"href":"/en/tip/09-07"},"children":[{"tag":"span","props":{},"children":["07"]},"Keeping found items and not using them for personal gain; returning lost phones, wallets, or cash to owners or police"]},{"tag":"a","props":{"href":"/en/tip/09-08"},"children":[{"tag":"span","props":{},"children":["08"]},"Use your real identity to claim discounts — don’t register fake accounts or exploit loopholes to get more"]},{"tag":"a","props":{"href":"/en/tip/09-09"},"children":[{"tag":"span","props":{},"children":["09"]},"Never throw anything from balconies or windows — cigarette butts, trash bags, and bottles all count"]},{"tag":"a","props":{"href":"/en/tip/09-10"},"children":[{"tag":"span","props":{},"children":["10"]},"Do not buy imitation guns, BB guns, or air rifles online; avoid “toy guns” of unknown origin"]},{"tag":"a","props":{"href":"/en/tip/09-11"},"children":[{"tag":"span","props":{},"children":["11"]},"Register drones with your real name first; never fly near airports, military zones, or restricted urban airspace, and don’t tamper with altitude limits"]},{"tag":"a","props":{"href":"/en/tip/09-12"},"children":[{"tag":"span","props":{},"children":["12"]},"Do not secretly film others, nor install cameras in rented apartments, homestays, or hotel rooms"]},{"tag":"a","props":{"href":"/en/tip/09-13"},"children":[{"tag":"span","props":{},"children":["13"]},"Mahjong and poker can be played — no rake, no banker role, no organizing paid games, no online gambling"]},{"tag":"a","props":{"href":"/en/tip/09-14"},"children":[{"tag":"span","props":{},"children":["14"]},"Do not eat wild animals; do not buy, sell, or keep protected species as pets"]},{"tag":"a","props":{"href":"/en/tip/09-15"},"children":[{"tag":"span","props":{},"children":["15"]},"You cannot detain or confine someone to collect a debt, nor follow them home and refuse to leave"]},{"tag":"a","props":{"href":"/en/tip/09-16"},"children":[{"tag":"span","props":{},"children":["16"]},"Do not lend your ID card, do not use someone else’s ID card, and do not register, open accounts, or buy tickets using another person’s documents"]},{"tag":"a","props":{"href":"/en/tip/09-17"},"children":[{"tag":"span","props":{},"children":["17"]},"Cooperate when stopped or taken away by police — don’t push, hit, or grab their body cameras; especially if you’ve been drinking, stay calm"]},{"tag":"a","props":{"href":"/en/tip/09-18"},"children":[{"tag":"span","props":{},"children":["18"]},"Sexual relations with anyone under 14 are illegal; “she consented” is not a defense"]},{"tag":"a","props":{"href":"/en/tip/09-19"},"children":[{"tag":"span","props":{},"children":["19"]},"Do the math before you hit someone: detention, fines, and prison time"]},{"tag":"a","props":{"href":"/en/tip/09-20"},"children":[{"tag":"span","props":{},"children":["20"]},"If parents cannot care for their newborn, the only legal option is to register the adoption with the civil affairs bureau: paying someone to hand over the child may be prosecuted as child trafficking, while abandoning the child constitutes abandonment"]},{"tag":"a","props":{"href":"/en/tip/09-21"},"children":[{"tag":"span","props":{},"children":["21"]},"Don’t fabricate accidents or exaggerate damages to defraud insurance payouts: this is insurance fraud, and anyone helping you testify, assess damage, or repair your vehicle is equally liable"]},{"tag":"a","props":{"href":"/en/tip/09-22"},"children":[{"tag":"span","props":{},"children":["22"]},"Don’t sell your own organs, and don’t help others find donors: a kidney brings in just over $20,000, but the same kidney can be sold to a patient for $200,000. All proceeds are seized, plus a fine of 10–20 times the transaction amount"]},{"tag":"a","props":{"href":"/en/tip/09-23"},"children":[{"tag":"span","props":{},"children":["23"]},"Don’t engage in prostitution: the default penalty is 10–15 days in detention, not just a fine"]},{"tag":"a","props":{"href":"/en/tip/09-24"},"children":[{"tag":"span","props":{},"children":["24"]},"Distributing unauthorized Chinese-dubbed comics, pirated movies/TV shows, cloud storage links, and pirated e-books — even for free — is illegal; adding ads or charging membership fees can lead to criminal charges"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/en/tip/09-25","data-status":"active"},"children":[{"tag":"span","props":{},"children":["25"]},"To publish or monetize fan works, first obtain permission from the original copyright holder, or replace the borrowed characters’ names and relationships with your own"]},{"tag":"a","props":{"href":"/en/tip/09-26"},"children":[{"tag":"span","props":{},"children":["26"]},"Do not buy and carry batons, stun devices, daggers, or pepper spray for self-defense; keeping them in your car also counts as carrying"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"Breadcrumb"},"children":[{"tag":"a","props":{"href":"/en/book"},"children":["Explore the book"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/en/book/09"},"children":["Chapter 9"," ·"," ","Legal pitfalls that ordinary people often overlook"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"09-25"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["25"]},{"tag":"span","props":{"className":"life-evidence grade-b"},"children":["Evidence"," ","B"]}]},{"tag":"h1","props":{"lang":"en"},"children":["To publish or monetize fan works, first obtain permission from the original copyright holder, or replace the borrowed characters’ names and relationships with your own"]},{"tag":"p","props":{"lang":"en","className":"life-entry-summary"},"children":["Even fan fiction that only borrows character names, personalities and relationships may infringe copyright if published. Jiang Nan’s This Side of Youth borrowed more than 60 of Jin Yong’s characters. On appeal, he was ordered to pay 1.68 million yuan in compensation plus 200,000 yuan in expenses. The case lasted nine years and ended in a settlement in which he agreed not to reprint the work unchanged. The court said free fan fiction written for enjoyment must be assessed case by case."]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Cost"]},{"tag":"p","props":{},"children":["There are no upfront costs. Before publishing or selling y…"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Benefit"]},{"tag":"p","props":{},"children":["Jiang Nan’s novel The Young Here used names such as Guo Jing, Huang Rong, Qiao Feng, and Linghu Chong from Jin…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"Mark: To publish or monetize fan works, first obtain permission from the original copyright holder, or replace the borrowed characters’ names and relationships with your own"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"Done"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"Plan to do"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"Save"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Share this tip"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Hide details"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Cost"]},{"tag":"p","props":{},"children":["There are no upfront costs. Before publishing or selling your work, you must negotiate licensing terms with the rights holder. If an agreement cannot be reached, you may use your own characters, names, and relationships instead. Avoid referencing the original work in your book title, subtitle, or promotional material."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Benefit"]},{"tag":"p","props":{},"children":["Jiang Nan’s novel The Young Here used names such as Guo Jing, Huang Rong, Qiao Feng, and Linghu Chong from Jin Yong’s novels, telling stories about them on a university campus. When published in 2002, its subtitle was “The University Life of the Condor Heroes.” By the time of the lawsuit, it had multiple editions and over a million copies in circulation. In 2016, Jin Yong sued Jiang Nan and the publishers, seeking 5000000 yuan. The first-instance court found no copyright infringement: outside concrete plots, names, relationships, and personalities alone were difficult to classify as protected expression. It did find unfair competition because Jiang Nan used the originals’ reputation to attract readers. It awarded 1680000 yuan, calculated as 30% of 5600000 yuan in royalties over the years, plus 200000 yuan in lawyer fees. The Guangzhou Intellectual Property Court heard the appeal and found copyright infringement. It held that the plots were not substantially similar—there was no copying of the plot—but that the collective portrayal of more than 60 characters, including their names, personalities, relationships, and backgrounds, reflected Jin Yong’s selection and arrangement and constituted protected expression. Jiang Nan had infringed copyright in four Jin Yong novels. The subtitle deliberately linked to The Legend of the Condor Heroes and separately constituted unfair competition. The appellate court ordered Jiang Nan to stop unfair competition, publish a newspaper notice to eliminate its effects, and pay 1680000 yuan plus 200000 yuan in reasonable expenses. Two publishing and distribution companies were jointly liable for 330000 yuan of that amount, meaning they shared the duty to pay it. The court did not order infringement to stop, but required 30% of royalties from future reprints to be paid to the original rights holder. Both sides then sought retrial in the Guangdong High People’s Court. On September 19, 2025, they reached a settlement mediated by that court. They agreed not to characterize the matter as plagiarism. Jiang Nan acknowledged that he lacked copyright-law knowledge when writing, had not obtained Jin Yong’s adaptation permission beforehand, and had harmed Jin Yong. He agreed not to reprint the book unchanged; future reprints would no longer use original character names and related content from Jin Yong’s works. All parties confirmed that the subtitle constituted unfair competition. Jiang Nan had already paid the appellate award. Once the mediation document was signed for, both earlier judgments ceased to have legal effect. Another case involved Zhang Muye, pen name Tianxia Bachang, author of Ghost Blows Out the Light. In 2006, he transferred all economic copyright rights in the series to Shanghai Xuanting Entertainment Information Technology Co., Ltd. He later authorized publication of a new book, Mojin Xiaowei, using character names, relationships, and tomb-raiding rules from Ghost Blows Out the Light. Its cover used the film poster for Mojin: The Lost Legend, adapted from that series. Xuanting sued for 20000000 yuan. Shanghai’s Pudong court found that the new book had an independent plot and did not infringe copyright, but the cover falsely suggested a connection with the source novel for the film and constituted false advertising. It ordered two publishing and distribution companies to pay 900000 yuan, with the publisher jointly liable for 600000 yuan; the appeal upheld this. Statutorily, the adaptation right is the right to alter a work and create a new original work. Using a work through adaptation, translation, annotation, or similar means without the copyright holder’s permission entails civil liability such as stopping infringement and compensating losses (nationwide)."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Original sources"]},{"tag":"p","props":{"className":"life-citations"},"children":["广州知识产权法院 (2023). 金庸诉江南「同人作品第一案」有何深意（转载《法制与新闻》2023 年 7 月上期）. ",{"tag":"a","props":{"href":"https://www.gipc.gov.cn/front/content.action?id=7b7cb9a7b2cc45f286199fd427fc6b1f","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gipc.gov.cn/front/content.action?id=7b7cb9a7b2cc45f286199fd427fc6b1f"]},"；广东省高级人民法院 (2025). 「金庸诉江南」著作权及不正当竞争纠纷案在粤达成和解. ",{"tag":"a","props":{"href":"https://www.gdcourts.gov.cn/xwzx/fayuanxinmeiti/content/post_1843458.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gdcourts.gov.cn/xwzx/fayuanxinmeiti/content/post_1843458.html"]},"；国家版权局 (2020). 2019 年度上海十大版权典型案件发布（上海市版权局发布，案例六：「鬼吹灯」著作权侵权及不正当竞争纠纷案）. ",{"tag":"a","props":{"href":"https://www.ncac.gov.cn/xxfb/ywxx/202004/t20200430_47269.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.ncac.gov.cn/xxfb/ywxx/202004/t20200430_47269.html"]},"；全国人大常委会 (2020). 著作权法（2020 年修正，第三条，第十条第一款第十四项，第五十二条第六项，第五十四条）. ",{"tag":"a","props":{"href":"http://www.npc.gov.cn/npc/c2/c30834/202011/t20201119_308796.html","target":"_blank","rel":"noopener noreferrer"},"children":["http://www.npc.gov.cn/npc/c2/c30834/202011/t20201119_308796.html"]}]},{"tag":"a","props":{"href":"https://www.gipc.gov.cn/front/content.action?id=7b7cb9a7b2cc45f286199fd427fc6b1f","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Open source link"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Book note"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["The beneficiary is you. Rated B because the legal boundaries of fan fiction remain unsettled. The two courts reached different conclusions, and the case ended in mediation, leaving neither judgment effective. In questions and answers, the Guangdong High Court judge said the settlement bound only the parties to this case. Whether fan fiction infringes requires case-by-case analysis rather than a blanket answer. The judge described three steps: determine whether shared elements are abstract ideas or concrete expression; determine whether that expression is original to the first author; and determine whether an exception such as fair use applies. Borrowing one theme or setting therefore carries a different risk from borrowing an entire set of names, personalities, and relationships. This book found no official court decision about fan fiction posted online for free. Copyright law has no exception saying that charging nothing means no infringement. Include the cost of proceedings: the case lasted 9 years, from filing in July 2016 to settlement in September 2025, passing through first instance, appeal, and retrial review. Jin Yong himself died during the appeal. An original author who sells copyright may still be sued by the purchaser for writing a sequel, as happened to Tianxia Bachang. In copyright litigation, the winning party’s reasonable expenses to stop infringement can form part of compensation; the first-instance 200000 yuan here was lawyer fees. For risks from localizing, reposting, or sharing others’ works, see Item 24 in this section (localizing comics and reposting films and TV)."]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["My note"]},{"tag":"button","props":{"type":"button"},"children":["Write a reminder for yourself…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"l