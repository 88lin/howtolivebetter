ldren":[]},{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},{"tag":"span","props":{},"children":["ログイン"]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/ja/book/33"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"目次に戻る"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["障害を負った後の生き方"]},{"tag":"nav","props":{"aria-label":"この章のヒント"},"children":[{"tag":"a","props":{"href":"/ja/tip/33-01"},"children":[{"tag":"span","props":{},"children":["01"]},"脊髄損傷の後に突然の激しい頭痛や発汗が見られたら、まずは体を起こして座らせ、衣服を緩め、同時に 120 を呼ぶ"]},{"tag":"a","props":{"href":"/ja/tip/33-02"},"children":[{"tag":"span","props":{},"children":["02"]},"障害を負った後の最初の10年間は自殺のハイリスク期です。「前向きに考えれば大丈夫」で済ませないでください"]},{"tag":"a","props":{"href":"/ja/tip/33-03"},"children":[{"tag":"span","props":{},"children":["03"]},"精神障害の入院は自発的な意思を原則とし、本人の同意なしで行えるのは以下の2つのケースのみである"]},{"tag":"a","props":{"href":"/ja/tip/33-04"},"children":[{"tag":"span","props":{},"children":["04"]},"在自宅で障害者を介護している人は、自身の健康管理を怠らないこと"]},{"tag":"a","props":{"href":"/ja/tip/33-05"},"children":[{"tag":"span","props":{},"children":["05"]},"車椅子を長時間使用する場合は、クッションを減圧型に交換し、毎日坐骨と尾骨の状態を確認すること"]},{"tag":"a","props":{"href":"/ja/tip/33-06"},"children":[{"tag":"span","props":{},"children":["06"]},"「麻痺、失明、難聴を治せる」といった療法や器具を買わないこと"]},{"tag":"a","props":{"href":"/ja/tip/33-07"},"children":[{"tag":"span","props":{},"children":["07"]},"障害者手帳の交付後、県級の残聯（障害者連合会）へ行き、申請可能な事項を一度にすべて確認する"]},{"tag":"a","props":{"href":"/ja/tip/33-08"},"children":[{"tag":"span","props":{},"children":["08"]},"7 歳未満で、新たに障害や自閉症（孤独症）が判明した子供については、県級の残聯へリハビリ救済を申請する"]},{"tag":"a","props":{"href":"/ja/tip/33-09"},"children":[{"tag":"span","props":{},"children":["09"]},"自宅のスロープ、手すり、浴室のリフォームについては、県級以上の政府に補助金を申請できる"]},{"tag":"a","props":{"href":"/ja/tip/33-10"},"children":[{"tag":"span","props":{},"children":["10"]},"中国で仕事を探すときは障害者証の所持を伝える。採用で企業の負担金を減らせる"]},{"tag":"a","props":{"href":"/ja/tip/33-11"},"children":[{"tag":"span","props":{},"children":["11"]},"障害者の個人所得税は軽減される可能性があります。軽減額については、各省の税務局へ電話でご確認ください。"]},{"tag":"a","props":{"href":"/ja/tip/33-12"},"children":[{"tag":"span","props":{},"children":["12"]},"盲導犬は公共施設や公共交通機関への同伴が可能で、視覚障害者は市内のバスに無料で乗車できます"]},{"tag":"a","props":{"href":"/ja/tip/33-13"},"children":[{"tag":"span","props":{},"children":["13"]},"障害のある受験生は大学入試（高考）において合理的配慮を申請でき、点字答案を使用する場合、試験時間は1.5倍に延長される"]},{"tag":"a","props":{"href":"/ja/tip/33-14"},"children":[{"tag":"span","props":{},"children":["14"]},"障害のある子供の入学申請に対し、学校は拒否してはならない。登校が困難な場合は、教育局が訪問指導の手配を行う"]},{"tag":"a","props":{"href":"/ja/tip/33-15"},"children":[{"tag":"span","props":{},"children":["15"]},"右下肢または両下肢を欠損していても運転免許の取得は可能。準拠車種は C5 と呼ばれる"]},{"tag":"a","props":{"href":"/ja/tip/33-16"},"children":[{"tag":"span","props":{},"children":["16"]},"リハビリはリハビリテーション科のある正規の機関で行うこと。強度は療法士の指示に従う。激しければ良いというものではない"]},{"tag":"a","props":{"href":"/ja/tip/33-17"},"children":[{"tag":"span","props":{},"children":["17"]},"難聴を感じたら補聴器を検討すること。補聴器を使用する理由は「聞こえるようにするため」であり、「認知症予防のため」ではない"]},{"tag":"a","props":{"href":"/ja/tip/33-18"},"children":[{"tag":"span","props":{},"children":["18"]},"成人が「自身の事柄を管理できない」と判断するには、裁判所に申し立てて認定を受ける必要があり、家族の判断だけでは不十分である"]},{"tag":"a","props":{"href":"/ja/tip/33-19"},"children":[{"tag":"span","props":{},"children":["19"]},"成人の後見人は法定順序に従って定められます。被後見人が他人に損害を与えた場合、後見人が賠償します"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/ja/tip/33-20","data-status":"active"},"children":[{"tag":"span","props":{},"children":["20"]},"障害を理由とした採用拒否、正社員登用拒否、給与の過少支払いは訴えることが可能ですが、まずはプロセスに伴うコストを計算してください"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"現在地"},"children":[{"tag":"a","props":{"href":"/ja/book"},"children":["本を読む"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/ja/book/33"},"children":["第33章"," ·"," ","障害を負った後の生き方"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"33-20"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["20"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["エビデンス"," ","A"]}]},{"tag":"h1","props":{"lang":"ja"},"children":["障害を理由とした採用拒否、正社員登用拒否、給与の過少支払いは訴えることが可能ですが、まずはプロセスに伴うコストを計算してください"]},{"tag":"p","props":{"lang":"ja","className":"life-entry-summary"},"children":["法律は、採用、正社員登用、昇進、职称（職位）の評価、報酬、社会保険において、障害者を差別することを禁止しています。主管部門への投書や、裁判所への提訴が可能です。ただし、勝訴したとしても、相手方が弁護士費用を負担してくれるわけではありません。そのため、まずは投書を行い、同時に法律扶助を申請した上で、訴訟を検討してください。"]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["費用・手間"]},{"tag":"p","props":{},"children":["弁護士費用は数千から数万元で、自己負担となります。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["効果"]},{"tag":"p","props":{},"children":["《残疾人保障法》第三条：「残疾に基づく差別を禁止する。障害者を侮辱し、または侵害することを禁止する。"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"記録する：障害を理由とした採用拒否、正社員登用拒否、給与の過少支払いは訴えることが可能ですが、まずはプロセスに伴うコストを計算してください"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"できている"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"やることに追加"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"お気に入り"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"このヒントを共有"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"詳細を閉じる"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["費用・手間"]},{"tag":"p","props":{},"children":["弁護士費用は数千から数万元で、自己負担となります。第一審の通常手続は 6 ヶ月から始まり、延長も可能です。証拠は自身で保存する必要があります。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["効果"]},{"tag":"p","props":{},"children":["《残疾人保障法》第三条：「残疾に基づく差別を禁止する。障害者を侮辱し、または侵害することを禁止する。」第三十八条：「従業員の採用、本採用、昇進、職称の認定、労働報酬、福利厚生、休息・休暇、社会保険などの面において、障害人を差別してはならない。」同条はまた、障害のある従業員が所属する単位（組織）は、当該従業員の特性に応じて適切な労働条件および労働保護を提供し、かつ、実際の必要性に応じて作業場所、作業設備、および生活施設を改修すべきであることを規定している。第六十四条：「本法の規定に違反し、従業員の採用などの面において障害人を差別した場合は、関係主管部門が是正を命じるものとする。障害のある労働者は、法律に基づき人民法院に訴訟を提起することができる。」《残疾人就业条例》第四条：「雇用における障害人への差別を禁止する。」」第十三条：雇用主は、昇進、昇格、職位の評価、報酬、社会保険、福利厚生などの面において、障害を持つ従業員を差別してはならない。《法律援助法》第四十二条は、申請者が「一定の収入源を持たない未成年者、高齢者、障害者などの特定グループ」に属することを証明する資料がある場合、経済的困難状況の調査を免除すると規定している。第四十五条は、法律援助機関が高齢者や障害者に法律援助サービスを提供する場合、実際の状況に応じてバリアフリー施設、設備、およびサービスを提供しなければならないと規定している（全国）"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["出典"]},{"tag":"p","props":{"className":"life-citations"},"children":["中华人民共和国残疾人保障法（第三条、第三十八条、第六十四条）. ",{"tag":"a","props":{"href":"https://flk.npc.gov.cn/detail?id=ff8080816f135f46016f1d134c88132b","target":"_blank","rel":"noopener noreferrer"},"children":["https://flk.npc.gov.cn/detail?id=ff8080816f135f46016f1d134c88132b"]},"；国务院 (2007). 残疾人就业条例（第四条、第十三条）. ",{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/2008-03/28/content_6646.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/zhengce/zhengceku/2008-03/28/content_6646.htm"]},"；中华人民共和国法律援助法（第四十二条、第四十五条）. ",{"tag":"a","props":{"href":"https://flk.npc.gov.cn/detail?id=ff8081817b6472a3017b6577820f0061","target":"_blank","rel":"noopener noreferrer"},"children":["https://flk.npc.gov.cn/detail?id=ff8081817b6472a3017b6577820f0061"]}]},{"tag":"a","props":{"href":"https://flk.npc.gov.cn/detail?id=ff8080816f135f46016f1d134c88132b","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["出典を開く"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["著者の注記"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["プロセスに伴うコストをまず計算しなければなりません。第一審の通常手続は 6 ヶ月から始まり、延長可能。簡易手続は 3 ヶ月です。弁護士費用は《訴訟費用交納办法》第六条に列挙されている訴訟費用には含まれず、第二十九条の「敗訴側負担」にも弁護士費用は含まれません。したがって、まずはコストの低い2つの方法をとりましょう。一つは、人社部門または残聯（残疾人聯合会）へ投書し、主管部門に是正を命じてもらうこと。もう一つは、同時に法律扶助を申請することです。第四十二条により、障害者は経済的困難状況の調査を免除されます。証拠収集が最も困難な関門です。面接で拒否された際、相手が書面で理由を残すことは稀ですので、録音やチャット履歴などの記録を残せる限り残してください。既に採用されている場合は、労働紛争として仲裁の手続きをとります。証拠の保存と時効については第 19 節第 8 条（退職前の証拠保存）を参照してください。この条項の受益者はあなた自身です。"]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["自分のメモ"]},{"tag":"button","props":{"type":"button"},"children":["自分へのメモを書く…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/ja/tip/33-19"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["前へ"]},"成人の後見人は法定順序に従って定められます。被後見人が他人に損害を与えた場合、後見人が賠償します"]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["このテーマの他の提案"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/33-13"},"children":[{"tag":"strong","props":{},"children":["障害のある受験生は大学入試（高考）において合理的配慮を申請でき、点字答案を使用する場合、試験時間は1.5倍に延長される"]},{"tag":"span","props":{},"children":["障害のある受験生は、大学入試（高考）において、点字答案、拡大文字答案、外国語リスニング免除、別室受験、補聴器や車椅子の持ち込み、および試験…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/33-14"},"children":[{"tag":"strong","props":{},"children":["障害のある子供の入学申請に対し、学校は拒否してはならない。登校が困難な場合は、教育局が訪問指導の手配を行う"]},{"tag":"span","props":{},"children":["幼稚園および各種学校は、条件を満たす障害のある子供の入学申請を拒否してはならず、普通科・職業学校も同様です。介助が必要で登校が困難な子供に…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/33-15"},"children":[{"tag":"strong","props":{},"children":["右下肢または両下肢を欠損していても運転免許の取得は可能。準拠車種は C5 と呼ばれる"]},{"tag":"span","props":{},"children":["右下肢または両下肢を欠損している、あるいは動かせない場合でも、自力で安定して座ることができ、上肢の条件を満たしている人は、障害者専用のオー…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/33-16"},"children":[{"tag":"strong","props":{},"children":["リハビリはリハビリテーション科のある正規の機関で行うこと。強度は療法士の指示に従う。激しければ良いというものではない"]},{"tag":"span","props":{},"children":["自宅に連れて帰り、自然回復を待つのが最もよくある間違いです。脳卒中後、多職種チームによる組織的なケアを受けた場合、1年後も生存し、自宅での…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/33-17"},"children":[{"tag":"strong","props":{},"children":["難聴を感じたら補聴器を検討すること。補聴器を使用する理由は「聞こえるようにするため」であり、「認知症予防のため」ではない"]},{"tag":"span","props":{},"children":["「補聴器の使用が認知症を予防できる」という説は、現時点では確立されていません。約1,000人を対象とした3年間の試験では、全体として差は見…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/33-18"},"children":[{"tag":"strong","props":{},"children":["成人が「自身の事柄を管理できない」と判断するには、裁判所に申し立てて認定を受ける必要があり、家族の判断だけでは不十分である"]},{"tag":"span","props":{},"children":["ある成人が「無能力（意思能力なし）」または「制限能力（制限付き意思能力）」に該当するかどうかは、裁判所のみが認定できます。家族、勤務先、地…"]}]}]}]},{"tag":"a","props":{"className":"life-text-link","href":"/ja/book/33"},"children":["テーマ全体を読む：障害を負った後の生き方"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"15","height":"15","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]}]}]},{"tag":"nav","props":{"className":"life-tabbar","aria-label":"メインナビゲーション"},"children":[{"tag":"a","props":{"className":"","href":"/ja/book