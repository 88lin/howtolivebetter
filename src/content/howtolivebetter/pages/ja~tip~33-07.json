circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},{"tag":"span","props":{},"children":["ログイン"]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/ja/book/33"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"目次に戻る"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["障害を負った後の生き方"]},{"tag":"nav","props":{"aria-label":"この章のヒント"},"children":[{"tag":"a","props":{"href":"/ja/tip/33-01"},"children":[{"tag":"span","props":{},"children":["01"]},"脊髄損傷の後に突然の激しい頭痛や発汗が見られたら、まずは体を起こして座らせ、衣服を緩め、同時に 120 を呼ぶ"]},{"tag":"a","props":{"href":"/ja/tip/33-02"},"children":[{"tag":"span","props":{},"children":["02"]},"障害を負った後の最初の10年間は自殺のハイリスク期です。「前向きに考えれば大丈夫」で済ませないでください"]},{"tag":"a","props":{"href":"/ja/tip/33-03"},"children":[{"tag":"span","props":{},"children":["03"]},"精神障害の入院は自発的な意思を原則とし、本人の同意なしで行えるのは以下の2つのケースのみである"]},{"tag":"a","props":{"href":"/ja/tip/33-04"},"children":[{"tag":"span","props":{},"children":["04"]},"在自宅で障害者を介護している人は、自身の健康管理を怠らないこと"]},{"tag":"a","props":{"href":"/ja/tip/33-05"},"children":[{"tag":"span","props":{},"children":["05"]},"車椅子を長時間使用する場合は、クッションを減圧型に交換し、毎日坐骨と尾骨の状態を確認すること"]},{"tag":"a","props":{"href":"/ja/tip/33-06"},"children":[{"tag":"span","props":{},"children":["06"]},"「麻痺、失明、難聴を治せる」といった療法や器具を買わないこと"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/ja/tip/33-07","data-status":"active"},"children":[{"tag":"span","props":{},"children":["07"]},"障害者手帳の交付後、県級の残聯（障害者連合会）へ行き、申請可能な事項を一度にすべて確認する"]},{"tag":"a","props":{"href":"/ja/tip/33-08"},"children":[{"tag":"span","props":{},"children":["08"]},"7 歳未満で、新たに障害や自閉症（孤独症）が判明した子供については、県級の残聯へリハビリ救済を申請する"]},{"tag":"a","props":{"href":"/ja/tip/33-09"},"children":[{"tag":"span","props":{},"children":["09"]},"自宅のスロープ、手すり、浴室のリフォームについては、県級以上の政府に補助金を申請できる"]},{"tag":"a","props":{"href":"/ja/tip/33-10"},"children":[{"tag":"span","props":{},"children":["10"]},"中国で仕事を探すときは障害者証の所持を伝える。採用で企業の負担金を減らせる"]},{"tag":"a","props":{"href":"/ja/tip/33-11"},"children":[{"tag":"span","props":{},"children":["11"]},"障害者の個人所得税は軽減される可能性があります。軽減額については、各省の税務局へ電話でご確認ください。"]},{"tag":"a","props":{"href":"/ja/tip/33-12"},"children":[{"tag":"span","props":{},"children":["12"]},"盲導犬は公共施設や公共交通機関への同伴が可能で、視覚障害者は市内のバスに無料で乗車できます"]},{"tag":"a","props":{"href":"/ja/tip/33-13"},"children":[{"tag":"span","props":{},"children":["13"]},"障害のある受験生は大学入試（高考）において合理的配慮を申請でき、点字答案を使用する場合、試験時間は1.5倍に延長される"]},{"tag":"a","props":{"href":"/ja/tip/33-14"},"children":[{"tag":"span","props":{},"children":["14"]},"障害のある子供の入学申請に対し、学校は拒否してはならない。登校が困難な場合は、教育局が訪問指導の手配を行う"]},{"tag":"a","props":{"href":"/ja/tip/33-15"},"children":[{"tag":"span","props":{},"children":["15"]},"右下肢または両下肢を欠損していても運転免許の取得は可能。準拠車種は C5 と呼ばれる"]},{"tag":"a","props":{"href":"/ja/tip/33-16"},"children":[{"tag":"span","props":{},"children":["16"]},"リハビリはリハビリテーション科のある正規の機関で行うこと。強度は療法士の指示に従う。激しければ良いというものではない"]},{"tag":"a","props":{"href":"/ja/tip/33-17"},"children":[{"tag":"span","props":{},"children":["17"]},"難聴を感じたら補聴器を検討すること。補聴器を使用する理由は「聞こえるようにするため」であり、「認知症予防のため」ではない"]},{"tag":"a","props":{"href":"/ja/tip/33-18"},"children":[{"tag":"span","props":{},"children":["18"]},"成人が「自身の事柄を管理できない」と判断するには、裁判所に申し立てて認定を受ける必要があり、家族の判断だけでは不十分である"]},{"tag":"a","props":{"href":"/ja/tip/33-19"},"children":[{"tag":"span","props":{},"children":["19"]},"成人の後見人は法定順序に従って定められます。被後見人が他人に損害を与えた場合、後見人が賠償します"]},{"tag":"a","props":{"href":"/ja/tip/33-20"},"children":[{"tag":"span","props":{},"children":["20"]},"障害を理由とした採用拒否、正社員登用拒否、給与の過少支払いは訴えることが可能ですが、まずはプロセスに伴うコストを計算してください"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"現在地"},"children":[{"tag":"a","props":{"href":"/ja/book"},"children":["本を読む"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/ja/book/33"},"children":["第33章"," ·"," ","障害を負った後の生き方"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"33-07"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["07"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["エビデンス"," ","A"]}]},{"tag":"h1","props":{"lang":"ja"},"children":["障害者手帳の交付後、県級の残聯（障害者連合会）へ行き、申請可能な事項を一度にすべて確認する"]},{"tag":"p","props":{"lang":"ja","className":"life-entry-summary"},"children":["障害者手帳自体に現金が支給されるわけではなく、それは「鍵」のようなものです。その後に続くのは、それぞれ独立した複数の手当であり、その一つひとつを自分で申請する必要があり、自動的に支給されることはありません。初めて残聯へ行く際に、リストにある項目を一つずつ確認しておくことで、何度も足を運ぶ手間を省けます。"]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["費用・手間"]},{"tag":"p","props":{},"children":["無料。県級の残聯へ一度行き、午前中にかけて質問します。その後、回るべき部署は一つだけではありません。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["効果"]},{"tag":"p","props":{},"children":["証書に付随する待遇は少なくとも6項目あり、それぞれ根拠が異なります。1つ目は、障がい者生活補助金および重度障がい者介護補助金です（詳細は第 7 節第 8 条を参照、2種類の補助金）。"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"記録する：障害者手帳の交付後、県級の残聯（障害者連合会）へ行き、申請可能な事項を一度にすべて確認する"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"できている"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"やることに追加"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"お気に入り"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"このヒントを共有"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"詳細を閉じる"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["費用・手間"]},{"tag":"p","props":{},"children":["無料。県級の残聯へ一度行き、午前中にかけて質問します。その後、回るべき部署は一つだけではありません。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["効果"]},{"tag":"p","props":{},"children":["証書に付随する待遇は少なくとも6項目あり、それぞれ根拠が異なります。1つ目は、障がい者生活補助金および重度障がい者介護補助金です（詳細は第 7 節第 8 条を参照、2種類の補助金）。2つ目は、障がい児リハビリテーション支援です（本節第 8 条を参照、リハビリテーション支援）。3つ目は、基本型補助器具の支給補助です。根拠は『障害予防および障害者リハビリテーション条例』第26条です。4つ目は、家庭内バリアフリー改修補助です（本節第 9 条を参照、スロープ・手すりおよび浴室改修）。5つ目は、定員雇用および雇用サービスです（本節第 10 条を参照、積極的な証書提示）。6つ目は、個人所得税の軽減です（本節第 11 条を参照、所得税軽減）。《障害の予防および障害者のリハビリテーションに関する条例》第26条には、国は重点的なリハビリテーションプロジェクトを実施することにより、都市部および農村部の貧困層の障害者や重度の障害者に対して、基本的なリハビリテーションサービスを提供し、「国の関連規定に従って、基本型補助器具の配備に対して補助金を支給する」と明記されている。第20条では、県級以上の人民政府の関連部門および残聯（障害者連合会）は、コミュニティのリソースを活用して、リハビリテーション施設を設置するか、あるいはサービスを購入し、リハビリテーション指導、日常生活能力訓練、リハビリテーションケア、補助器具の配備、情報相談、および紹介などのコミュニティ・リハビリテーション業務を実施すべきであると規定されている（全国、2017 年 7 月 1 日より施行）"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["出典"]},{"tag":"p","props":{"className":"life-citations"},"children":["国务院 (2017). 残疾预防和残疾人康复条例（第二十条、第二十六条）. ",{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/2017-02/27/content_5171308.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/zhengce/zhengceku/2017-02/27/content_5171308.htm"]}]},{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/2017-02/27/content_5171308.htm","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["出典を開く"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["著者の注記"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["証明書の発行手続き自体については、第 24 節第 10 条（障害者手帳）を参照してください。補助基準や具体的な方法は、その多くが省級レベルで決定されるため、同じ項目でも省が異なれば数倍の差が出ることがあります。質問する際は、各項目の名称をメモしておき、帰宅後にその名称をもとに現地の残聯公式サイトや政府サイトで、窓口の口頭の説明だけでなく、必ず原文を再度確認してください。一度ですべて聞き出せるとは思わず、1年ごとに再度確認してください。政策は変わります。"]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["自分のメモ"]},{"tag":"button","props":{"type":"button"},"children":["自分へのメモを書く…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/ja/tip/33-06"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["前へ"]},"「麻痺、失明、難聴を治せる」といった療法や器具を買わないこと"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/ja/tip/33-08"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["次へ"]},"7 歳未満で、新たに障害や自閉症（孤独症）が判明した子供については、県級の残聯へリハビリ救済を申請する"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["このテーマの他の提案"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/33-03"},"children":[{"tag":"strong","props":{},"children":["精神障害の入院は自発的な意思を原則とし、本人の同意なしで行えるのは以下の2つのケースのみである"]},{"tag":"span","props":{},"children":["家族や勤務先の一言だけで、人を精神科病院に留め置くことはできない。法律が認めるのは2つの状況のみである。すなわち、すでに自傷行為を行った、…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/33-04"},"children":[{"tag":"strong","props":{},"children":["在自宅で障害者を介護している人は、自身の健康管理を怠らないこと"]},{"tag":"span","props":{},"children":["介護者が疲れ果ててしまうのは、単なるわがまま