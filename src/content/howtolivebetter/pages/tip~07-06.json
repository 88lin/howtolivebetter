6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"分享这条建议"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"收起详情"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["成本"]},{"tag":"p","props":{"className":"life-citations"},"children":["不花钱。向出事那个地方的乡镇政府或者街道办提出申请，说清楚家里出了什么事。比如火灾、交通事故、家人突发重大疾病，或者日常非花不可的开销突然涨上来。突发急难走「小额快救」，不查家底、不公示，一般 3 天内办完。看病上学开销突然涨上来的，要公示后审批。材料按当地给的清单准备，通常跑 1 到 2 趟。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["收益"]},{"tag":"p","props":{"className":"life-citations"},"children":["两类家庭可以拿临时救助。一类是因为意外事件、家庭成员突发重大疾病这些原因，连吃住看病这些最基本的开销都一时撑不住的家庭。另一类是非花不可的开销突然增加、超出自己承受能力的低保家庭。救哪些事、给多少钱，由县级以上地方政府自己定并公布（全国制度，金额地方定，2014 年起）。2026 年 7 月 1 日起施行的社会救助法，把对象写成「遭遇突发性、紧迫性、灾难性等困难导致基本生活暂时出现严重困难的人员」，发救助金或者配发实物。申请临时救助向「急难发生地」的乡镇政府、街道办提出。情况紧急、金额较小的，应当先救助，事后补手续。民政部、财政部 2025 年底的文件定了怎么发。突发变故、意外伤害、重大疾病这类急难，走「小额快救」，不再核对家庭经济状况，也不公示，办理时限一般不超过 3 天，最高档不超过当地 1 个月的低保标准。因为看病、上学这类开销突然增加而陷入困难的低保边缘家庭和刚性支出困难家庭，公示后救助，原则上「一次审批、分阶段发放」。小额快救以外的临时救助，最高档不超过当地月低保标准的 6 倍（全国，2026 年起，具体标准地方定）"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["来源"]},{"tag":"p","props":{"className":"life-citations"},"children":["国务院 (2014, 2019 修订). 社会救助暂行办法（国务院令第 649 号，第四十七、四十八、四十九条）. ",{"tag":"a","props":{"href":"https://www.gov.cn/gongbao/content/2019/content_5468952.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/gongbao/content/2019/content_5468952.htm"]},"；全国人大常委会 (2026). 社会救助法（2026 年 7 月 1 日起施行，第二十九条、第三十七条第二款、第五十条；第二十九条：「对遭遇突发性、紧迫性、灾难性等困难导致基本生活暂时出现严重困难的人员，由社会救助管理部门采取发放救助金或者配发实物等方式给予临时救助。」第三十七条第二款：「申请临时救助，由本人或者与其共同生活的家庭成员向急难发生地乡镇人民政府、街道办事处提出。」第五十条：「对申请临时救助，情况紧急、救助金额较小、需立即采取救助措施的，应当先行救助。」）. ",{"tag":"a","props":{"href":"https://flk.npc.gov.cn/detail?id=016c39ca7739492cab1fe3aef22941c7","target":"_blank","rel":"noopener noreferrer"},"children":["https://flk.npc.gov.cn/detail?id=016c39ca7739492cab1fe3aef22941c7"]},"；民政部、财政部 (2025). 关于进一步健全完善临时救助制度的意见（民发〔2025〕68 号，第二部分第一、二、五项：「“小额快救”办理时限一般不超过3天」「最高档救助标准不超过当地1个月最低生活保障标准」「原则上采取“一次审批、分阶段发放”的方式」「最高档救助标准不超过当地月最低生活保障标准的6倍」）. ",{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/202601/content_7056503.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/zhengce/zhengceku/202601/content_7056503.htm"]},""]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["原书备注"]},{"tag":"p","props":{"className":"life-citations"},"children":["不要求你已经是低保户。具体金额各地差得很多，以当地当年公布的为准。社会救助法施行后，《社会救助暂行办法》没有被明文废止，截至 2026 年 10 月国家法律法规数据库仍标为有效。两者说法不一致的地方，按法律的规定办。"]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["我的备注"]},{"tag":"button","props":{"type":"button"},"children":["写下对自己有用的提醒…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/tip/07-05"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["上一条"]},"找活先用免费的公共就业服务和零工市场，不找收费中介"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/tip/07-07"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["下一条"]},"收入低于当地低保线就申请低保，比低保线略高或者看病上学花得多的申请医疗、教育、住房、就业救助"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["本主题的其他建议"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/07-02"},"children":[{"tag":"strong","props":{},"children":["被欠薪先投诉劳动监察，再申请劳动仲裁，两条路都不收费，多数案子几个月内有结果"]},{"tag":"span","props":{},"children":["先打 12333 或者去人社局劳动监察投诉，立案后 60 个工作日内查完。查实了能责令公司限期付钱，逾期不付还要多赔 50% 到 100%。再不行就申请劳动仲裁…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/07-03"},"children":[{"tag":"strong","props":{},"children":["打不起官司就申请法律援助，讨薪、赡养费、工伤这类案子本来就在范围内"]},{"tag":"span","props":{},"children":["讨薪、要赡养费、要社保或低保待遇、见义勇为受了损失，都能申请免费法律援助。打 12348，或者去当地的法律援助中心。现在不用回原籍开经济困难证明，本人如实说明就…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/07-04"},"children":[{"tag":"strong","props":{},"children":["走投无路时去救助站，管吃住和返乡车票"]},{"tag":"span","props":{},"children":["救助站管吃、管住，生病了送医院，还帮你联系家里人，没钱回家的发车票。一般住不超过 10 天。自愿来、自愿走，不是收容，也不发现金。车票按户籍地或者住所地开，去之…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/07-08"},"children":[{"tag":"strong","props":{},"children":["持残疾人证的去申请残疾人两项补贴"]},{"tag":"span","props":{},"children":["低保家庭里的残疾人，可以领生活补贴。残疾等级是一级、二级，又需要长期照护的，可以领护理补贴，两项能同时领。标准各省自己定，差别很大，具体问街道。带上第二代残疾人…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/07-09"},"children":[{"tag":"strong","props":{},"children":["居民医保每年 400 元不要断，困难户可减免"]},{"tag":"span","props":{},"children":["个人一年交 400 元起，2025 年财政再按人头补不低于 700 元。特困人员全额资助，低保对象定额资助。断缴是有代价的：没在集中期参保、或者没连着交的，交完…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/07-10"},"children":[{"tag":"strong","props":{},"children":["得了重病先走医保、大病保险、医疗救助和异地备案，不碰网贷"]},{"tag":"span","props":{},"children":["顺序是固定的：跨省住院前先在「国家医保局」公众号里备案，出院直接结算，不用先垫全款。报销完自己还掏不起的，向乡镇或者街道申请医疗救助。在职的按工龄有 3 到 2…"]}]}]}]},{"tag":"a","props":{"className":"life-text-link","href":"/book/07"},"children":["阅读整个主题：没钱的时候怎么活 ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"15","height":"15","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]}]}]},{"tag":"nav","props":{"className":"life-tabbar","aria-label":"主导航"},"children":[{"tag":"a","props":{"className":"","href":"/book"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"21","height":"21","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","stroke