w.w3.org/2000/svg","width":"18","height":"18","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-up-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M7 7h10v10"},"children":[]},{"tag":"path","props":{"d":"M7 17 17 7"},"children":[]}]}]}]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/es/book/11"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"Volver al índice"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["Las líneas rojas que los programadores y los técnicos suelen pisar"]},{"tag":"div","props":{"data-ad-dock-host":"true"},"children":[]},{"tag":"nav","props":{"aria-label":"Consejos del capítulo"},"children":[{"tag":"a","props":{"href":"/es/tip/11-01"},"children":[{"tag":"span","props":{},"children":["01"]},"Antes de actuar, pregunta: ¿denunciarán el fabricante, la plataforma o la empresa? Si te investigan penalmente, busca enseguida un abogado penalista"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/es/tip/11-02","data-status":"active"},"children":[{"tag":"span","props":{},"children":["02"]},"No crees ni vendas trampas o ayudas para videojuegos, incluidas las de IA que «solo leen la pantalla sin tocar la memoria», ni versiones modificadas que añadan funciones a aplicaciones como WeChat"]},{"tag":"a","props":{"href":"/es/tip/11-03"},"children":[{"tag":"span","props":{},"children":["03"]},"No escribas ni vendas scripts de reventa de entradas, compras relámpago, pedidos falsos ni aprovechamiento de promociones, aunque sea solo «apretar botones de forma automatizada»"]},{"tag":"a","props":{"href":"/es/tip/11-04"},"children":[{"tag":"span","props":{},"children":["04"]},"Los rastreadores solo rastrean páginas públicas que no piden inicio de sesión; sin saltarse el antirrastreo, sin tocar datos personales, y los datos rastreados no se venden"]},{"tag":"a","props":{"href":"/es/tip/11-05"},"children":[{"tag":"span","props":{},"children":["05"]},"No aceptes encargos de desarrollo de Apps de juego, estafa o pornografía, ni montes canales de pago ni desbloquees cuentas para el «cliente»"]},{"tag":"a","props":{"href":"/es/tip/11-06"},"children":[{"tag":"span","props":{},"children":["06"]},"Al irte de la empresa entrega todas las cuentas y permisos; no borres bases de datos, no dejes puertas traseras, no cambies contraseñas para dejar el sistema bloqueado, aunque la empresa te deba dinero"]},{"tag":"a","props":{"href":"/es/tip/11-07"},"children":[{"tag":"span","props":{},"children":["07"]},"Al irte no te lleves el código fuente, las listas de clientes ni la documentación técnica; no los subas a una nube personal y no los reutilices en el siguiente empleo"]},{"tag":"a","props":{"href":"/es/tip/11-08"},"children":[{"tag":"span","props":{},"children":["08"]},"No ejecutes tus programas en ordenadores, servidores o cámaras ajenos, ni uses las máquinas de la empresa para minar criptomonedas"]},{"tag":"a","props":{"href":"/es/tip/11-09"},"children":[{"tag":"span","props":{},"children":["09"]},"Sin autorización por escrito, no testes los sistemas ajenos; ni las «buenas intenciones» ni el «aviso posterior» son motivo para quedar fuera del delito"]},{"tag":"a","props":{"href":"/es/tip/11-10"},"children":[{"tag":"span","props":{},"children":["10"]},"Reporta las vulnerabilidades conforme a las normas; antes del parche, ni detalles públicos, ni herramientas de explotación, ni entrega al extranjero"]},{"tag":"a","props":{"href":"/es/tip/11-11"},"children":[{"tag":"span","props":{},"children":["11"]},"No vendas herramientas para saltar el bloqueo ni cuentas de VPN, ni montes nodos de ese tipo para otros"]},{"tag":"a","props":{"href":"/es/tip/11-12"},"children":[{"tag":"span","props":{},"children":["12"]},"Si firmaste un pacto de no competencia, reclámalo por escrito cuando la empresa no pague la compensación mensual tras tu salida; si pasan 3 meses sin pagar puedes rescindirlo; en un puesto sin contacto con secretos comerciales puedes pedir que se declare que la cláusula no surte efecto"]},{"tag":"a","props":{"href":"/es/tip/11-13"},"children":[{"tag":"span","props":{},"children":["13"]},"El código escrito en horario de trabajo y con recursos de la empresa es de la empresa; tus proyectos de código abierto hazlos con tu tiempo y tus equipos, y no mezcles código de la empresa"]},{"tag":"a","props":{"href":"/es/tip/11-14"},"children":[{"tag":"span","props":{},"children":["14"]},"El uso de código abierto como GPL para crear productos: es obligatorio abrir el código o cambiar la licencia según lo exija la licencia; no se puede alegar que «nadie se entera»"]},{"tag":"a","props":{"href":"/es/tip/11-15"},"children":[{"tag":"span","props":{},"children":["15"]},"Una App solo recoge los datos personales que el negocio necesita de verdad; los menores de 14 años necesitan el consentimiento del tutor; la política de privacidad se escribe con claridad"]},{"tag":"a","props":{"href":"/es/tip/11-16"},"children":[{"tag":"span","props":{},"children":["16"]},"Antes de lanzar un sitio web o app, hay que registrarlo en el sistema ICP y conservar los registros durante al menos 6 meses según los requisitos de protección de niveles"]},{"tag":"a","props":{"href":"/es/tip/11-17"},"children":[{"tag":"span","props":{},"children":["17"]},"Antes de ofrecer al público un servicio de IA generativa, haz la evaluación de seguridad y el registro de algoritmo conforme a las normas, y marca el contenido generado"]},{"tag":"a","props":{"href":"/es/tip/11-18"},"children":[{"tag":"span","props":{},"children":["18"]},"No crees ni distribuyas herramientas que omitan o bloqueen automáticamente anuncios de otras aplicaciones: aunque sean gratuitas y no se conecten a internet, pueden constituir competencia desleal"]},{"tag":"a","props":{"href":"/es/tip/11-19"},"children":[{"tag":"span","props":{},"children":["19"]},"No montes un «intermediario de IA» para revender a bajo precio interfaces de modelos extranjeros: un responsable en Shanghái ya ha sido detenido penalmente"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"Ruta de navegación"},"children":[{"tag":"a","props":{"href":"/es/book"},"children":["Libro"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/es/book/11"},"children":["Capítulo 11"," ·"," ","Las líneas rojas que los programadores y los técnicos suelen pisar"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"11-02"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["02"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["Evidencia"," ","A"]}]},{"tag":"h1","props":{"lang":"es"},"children":["No crees ni vendas trampas o ayudas para videojuegos, incluidas las de IA que «solo leen la pantalla sin tocar la memoria», ni versiones modificadas que añadan funciones a aplicaciones como WeChat"]},{"tag":"p","props":{"lang":"es","className":"life-entry-summary"},"children":["Con vender a 20 personas, o ganar 5 000 yuanes, ya basta para la «gravedad de las circunstancias»: hasta 3 años de prisión; si es especialmente grave, de 3 a 7 años. Alguien hizo cheats de ver a través de las paredes y de apuntado automático: en 3 meses vendió más de 80 000 yuanes ; condena de 1 año suspendida en 1 y 5 000 yuanes de multa. Quien consiguió el programa del servidor y abrió servidores privados que recibieron más de 20 000 000 de yuanes en recargas fue condenado a 4 años, con multa de hasta 10 000 000 de yuanes."]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Coste"]},{"tag":"p","props":{},"children":["No cuesta dinero. El precio es renunciar a esos encargos y…"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Beneficio"]},{"tag":"p","props":{},"children":["Proporcionar programas o herramientas destinados específicamente a invadir o controlar ilegalmente sistemas in…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"Marcar: No crees ni vendas trampas o ayudas para videojuegos, incluidas las de IA que «solo leen la pantalla sin tocar la memoria», ni versiones modificadas que añadan funciones a aplicaciones como WeChat"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"Hecho"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"Por hacer"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"Guardar"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Compartir consejo"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Ocultar detalles"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Coste"]},{"tag":"p","props":{},"children":["No cuesta dinero. El precio es renunciar a esos encargos y a los ingresos de esos «apañitos». Lo difícil es que ese dinero entra rápido y no se ve quién va a reclamarlo."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Beneficio"]},{"tag":"p","props":{},"children":["Proporcionar programas o herramientas destinados específicamente a invadir o controlar ilegalmente sistemas informáticos, en casos graves, se castiga con hasta 3 años y multa conjunta o independiente. Conjunta significa prisión y multa; independiente, solo multa. En casos especialmente graves, de 3 a 7 años y multa. El umbral de «grave» es proporcionar herramientas en 20 o más ocasiones a personas o ganar al menos 5000 yuanes ilícitamente. Ganancia ilícita es lo obtenido con esa actividad. Eludir o destruir intencionadamente las medidas técnicas de protección del titular también puede constituir infracción penal de derechos de autor, con hasta 3 años o, en casos graves, de 3 a 10 años. Casos oficiales: Wang y otros fabricaron y vendieron trampas que leían y modificaban la memoria del juego para ver a través de objetos y apuntar automáticamente. En 3 meses vendieron más de 80.000 yuanes y ganaron más de 30.000. La condena fue de 1 año, suspendida durante 1 año, y multa de 5000 yuanes. Suspenderla durante 1 año significa no entrar de inmediato en prisión; si no se vuelve a delinquir ese año, no hay que cumplirla. Xiang y otros vendieron trampas de la serie «TZ» por más de 200.000 yuanes; Xiang recibió 3 años suspendidos durante 3 años y multa de 20.000 yuanes. Liu y otros obtuvieron el programa del servidor del juego, alteraron parámetros para abrir servidores privados y recaudaron más de 20 millones de yuanes en recargas. Recibieron penas entre 4 años y 2 años y 6 meses, y multas entre 10 millones y 1.3 millones de yuanes. No afecta solo a videojuegos. Una empresa de Shanghái creó paquetes de firmware que añadían a WeChat decenas de funciones, como reenviar, dar «me gusta» y enviar mensajes masivos automáticamente, y vendió 2381 dispositivos como «móviles de marketing». En 2019, el tribunal de Xuhui, Shanghái, la condenó por infracción penal de derechos de autor a una multa de 500.000 yuanes; el responsable recibió 1 año y 6 meses suspendidos durante 1 año y 6 meses (ámbito nacional)."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Fuentes originales"]},{"tag":"p","props":{"className":"life-citations"},"children":["全国人大 (2020). 刑法（根据刑法修正案（十一）修正，第二百八十五条第三款、第二百一十七条第六项）. ",{"tag":"a","props":{"href":"https://jtgl.beijing.gov.cn/jgj/jgxx/flfg/fl/11033925/index.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://jtgl.beijing.gov.cn/jgj/jgxx/flfg/fl/11033925/index.html"]},"；最高人民法院、最高人民检察院 (2011). 关于办理危害计算机信息系统安全刑事案件应用法律若干问题的解释（第三条）. ",{"tag":"a","props":{"href":"https://ga.sz.gov.cn/ZWGK/ZCFG/ZCJD/content/post_1304363.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://ga.sz.gov.cn/ZWGK/ZCFG/ZCJD/content/post_1304363.html"]},"（深圳市公安局转载）；最高人民检察院 (2026). 上海静安：严惩制售游戏外挂黑灰产共护清朗网络空间. ",{"tag":"a","props":{"href":"https://www.spp.gov.cn/spp/zdgz/202608/t20260825_735480.shtml","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.spp.gov.cn/spp/zdgz/202608/t20260825_735480.shtml"]},"；最高人民检察院 (2021). 2020 年度检察机关保护知识产权典型案例（案例五）. ",{"tag":"a","props":{"href":"https://www.spp.gov.cn/spp/xwfbh/wsfbt/202104/t20210425_516525.shtml","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.spp.gov.cn/spp/xwfbh/wsfbt/202104/t20210425_516525.shtml"]},"；国家版权局 (2020). 2019 年度上海十大版权典型案件发布（上海市版权局发布，案例八：上海昱宫网络科技有限公司等侵犯著作权案）. ",{"tag":"a","props":{"href":"https://www.ncac.gov.cn/xxfb/ywxx/202004/t20200430_47269.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.ncac.gov.cn/xxfb/ywxx/202004/t20200430_47269.html"]}]},{"tag":"a","props":{"href":"https://jtgl.beijing.gov.cn/jgj/jgxx/flfg/fl/11033925/index.html","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Abrir fuente"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Nota del autor"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["Los cheats de los casos judiciales ya publicados son todos de leer y escribir la memoria del juego y saltarse el antitrampas. De las asistencias «que solo capturan la pantalla o solo simulan pulsaciones» no se conocen todavía precedentes oficiales. Pero el caso de reventa de entradas del punto 3 muestra que sin tocar la memoria y solo enviando peticiones también se puede condenar por el delito de obtención ilícita de datos. Al final, si hay delito y por cuál, lo decide el órgano instructor según el material que el fabricante entrega al denunciar, no lo dice el autor. Con vender a 20 personas basta para la «gravedad de las circunstancias», y es una cifra muy pequeña."]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Mi nota"]},{"tag":"button","props":{"type":"button"},"children":["Escribe un recordatorio…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/es/tip/11-01"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Anterior"]},"Antes de actuar, pregunta: ¿denunciarán el fabricante, la plataforma o la empresa? Si te investigan penalmente, busca enseguida un abogado penalista"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/es/tip/11-03"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Siguiente"]},"No escribas ni vendas scripts de reventa de entradas, compras relámpago, pedidos falsos ni aprovechamiento de promociones, aunque sea solo «apretar botones de forma automatizada»"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children"