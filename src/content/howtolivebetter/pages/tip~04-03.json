pe":"button"},"children":["写下对自己有用的提醒…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/tip/04-02"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["上一条"]},"开工前写下退出条件"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/tip/04-04"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["下一条"]},"估工期时按过去同类任务的实际耗时估，不按计划推"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["本主题的其他建议"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/04-01"},"children":[{"tag":"strong","props":{},"children":["把「打算做」写成「几点、在哪、遇到什么就做什么」"]},{"tag":"span","props":{},"children":["把「我要做这件事」改写成「周二早 8 点坐到书桌前就先写引言」。94 项检验合起来算，这么写的人把目标做成的比例明显更高，属于中到大的效果。改的只是一句话的写法…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/04-05"},"children":[{"tag":"strong","props":{},"children":["会前发议程，没议程的会不开；能站着开就站着开"]},{"tag":"span","props":{},"children":["会前发了议程的会，参会者更容易觉得这个会有用。实验里，坐着开的会比站着开的长 34%，而两种开法做出的决定，好坏没有差别。"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/04-06"},"children":[{"tag":"strong","props":{},"children":["砍会议数量，能用文字异步解决的不开会"]},{"tag":"span","props":{},"children":["当天开的会越多，人越累，自己感觉手上的活也越多。砍掉一个会，省下的时间就是那个会本身的长度，一分不打折。"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/04-07"},"children":[{"tag":"strong","props":{},"children":["把大任务拆成子任务再估时、再开工"]},{"tag":"span","props":{},"children":["人估工期的时候，不会自动把任务拆开一件件算。先把子任务列出来再估，就能少估短一截。拆开之后，每一小步都能马上动手，也就不那么容易拖。"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/04-08"},"children":[{"tag":"strong","props":{},"children":["给没有外部截止的事自己定一个日期"]},{"tag":"span","props":{},"children":["有别人定的截止日期时，80.6% 的学生能在那之前做完。按自己预计的时间做完的，只有 38.7%。什么时候做完，几乎由截止日期决定，和自己估的关系不大。所以没有…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/04-09"},"children":[{"tag":"strong","props":{},"children":["把拖延当成在躲开难受，不要当成不够努力"]},{"tag":"span","props":{},"children":["拖延和懒、和性格关系不大。最能看出一个人拖不拖的，是这件事本身让他多难受、他觉不觉得自己做得成、他有多容易被眼前的东西带走。所以有用的是把任务改得没那么难受、把…"]}]}]}]},{"tag":"a","props":{"className":"life-text-link","href":"/book/04"},"children":["阅读整个主题：不要浪费时间 ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"15","height":"15","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]}]}]},{"tag":"nav","props":{"className":"life-tabbar","aria-label":"主导航"},"children":[{"tag":"a","props":{"className":"","href":"/book"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"21","height":"21","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-book-open","aria-hidden":"true"},"childre