2"},"children":[{"tag":"span","props":{},"children":["12"]},"导盲犬可以带进公共场所和公共交通，盲人免费坐市内公交"]},{"tag":"a","props":{"href":"/tip/33-13"},"children":[{"tag":"span","props":{},"children":["13"]},"残疾人参加高考可以申请合理便利，用盲文卷的考试时间加一半"]},{"tag":"a","props":{"href":"/tip/33-14"},"children":[{"tag":"span","props":{},"children":["14"]},"残疾孩子申请入学，学校不得拒收；到不了校的由教育局安排送教上门"]},{"tag":"a","props":{"href":"/tip/33-15"},"children":[{"tag":"span","props":{},"children":["15"]},"右下肢或者双下肢没了也能考驾照，准驾车型叫 C5"]},{"tag":"a","props":{"href":"/tip/33-16"},"children":[{"tag":"span","props":{},"children":["16"]},"康复在有康复医学科的正规机构做，强度听治疗师的，不是越猛越好"]},{"tag":"a","props":{"href":"/tip/33-17"},"children":[{"tag":"span","props":{},"children":["17"]},"听力下降就去配助听器，配它的理由是听得见，不是防痴呆"]},{"tag":"a","props":{"href":"/tip/33-18"},"children":[{"tag":"span","props":{},"children":["18"]},"说一个成年人「管不了自己的事」，要向法院申请认定，家属说了不算"]},{"tag":"a","props":{"href":"/tip/33-19"},"children":[{"tag":"span","props":{},"children":["19"]},"成年人的监护人按法定顺序定；被监护人伤了别人，由监护人赔"]},{"tag":"a","props":{"href":"/tip/33-20"},"children":[{"tag":"span","props":{},"children":["20"]},"因为残疾被拒招、不转正、少发钱，可以告，但先把过程成本算清"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"当前位置"},"children":[{"tag":"a","props":{"href":"/book"},"children":["阅读全书"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/book/33"},"children":["第 33 章"," ·"," ","残疾之后怎么活"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"33-04"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["04"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["证据"," ","A"]}]},{"tag":"h1","props":{"lang":"zh"},"children":["长期照护家里残疾人的那个人，自己的身体要有人盯着"]},{"tag":"p","props":{"lang":"zh","className":"life-entry-summary"},"children":["照护者累垮不是矫情。一项美