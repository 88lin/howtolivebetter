:"path","props":{"d":"M20 12h2"},"children":[]},{"tag":"path","props":{"d":"m6.34 17.66-1.41 1.41"},"children":[]},{"tag":"path","props":{"d":"m19.07 4.93-1.41 1.41"},"children":[]}]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"17","height":"17","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-moon life-theme-icon-dark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"},"children":[]}]}]},{"tag":"button","props":{"type":"button","className":"life-language-switch","aria-label":"Русский Выбрать язык","aria-haspopup":"menu","aria-expanded":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-globe","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]},{"tag":"path","props":{"d":"M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"},"children":[]},{"tag":"path","props":{"d":"M2 12h20"},"children":[]}]},{"tag":"span","props":{},"children":["Русский"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]}]},{"tag":"a","props":{"className":"life-account","href":"/ru/sign-in"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"17","height":"17","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle-user-round","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M18 20a6 6 0 0 0-12 0"},"children":[]},{"tag":"circle","props":{"cx":"12","cy":"10","r":"4"},"children":[]},{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},{"tag":"span","props":{},"children":["Войти"]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/ru/book/09"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"К содержанию"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["Частые юридические подводные камни для обычных людей"]},{"tag":"nav","props":{"aria-label":"Советы главы"},"children":[{"tag":"a","props":{"href":"/ru/tip/09-01"},"children":[{"tag":"span","props":{},"children":["01"]},"Не пересылайте в чатах сообщения о стихийных бедствиях, эпидемиях или происшествиях, достоверность которых неизвестна, не делайте фотошоп и не создавайте с помощью ИИ изображения места происшествия"]},{"tag":"a","props":{"href":"/ru/tip/09-02"},"children":[{"tag":"span","props":{},"children":["02"]},"Не публиковать и не пересылать изображения, мемы и комментарии, оскорбляющие героев и мучеников, не шутить над государственным флагом и гимном"]},{"tag":"a","props":{"href":"/ru/tip/09-03"},"children":[{"tag":"span","props":{},"children":["03"]},"После просмотра материалов на зарубежных сайтах их нужно сразу закрывать: не делать скриншоты, не пересылать, не размещать в чатах и не комментировать"]},{"tag":"a","props":{"href":"/ru/tip/09-04"},"children":[{"tag":"span","props":{},"children":["04"]},"Смотреть порнографию для личного пользования — это ваше право, но не стоит выкладывать её в чаты, продавать как «ресурсы» или создавать специальные группы"]},{"tag":"a","props":{"href":"/ru/tip/09-05"},"children":[{"tag":"span","props":{},"children":["05"]},"«Подработка»: вам предлагают использовать свою банковскую карту для получения денег, снятия наличных и переводов; какой бы вознаграждение ни предлагали, не соглашайтесь на это"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/ru/tip/09-06","data-status":"active"},"children":[{"tag":"span","props":{},"children":["06"]},"Люди предлагают вам участвовать в «оформлении документов» для получения кредита и обещают процент от суммы — ничего из этого делать не стоит"]},{"tag":"a","props":{"href":"/ru/tip/09-07"},"children":[{"tag":"span","props":{},"children":["07"]},"Найти чужую банковскую карту и не снимать с неё деньги; найти телефон или кошелёк — связаться с владельцем или отнести в отделение полиции, а не забирать себе"]},{"tag":"a","props":{"href":"/ru/tip/09-08"},"children":[{"tag":"span","props":{},"children":["08"]},"Получать скидки можно только под своим настоящим именем: нельзя регистрировать множество фиктивных аккаунтов, используя виртуальные номера, и нельзя пытаться получать бонусы повторно, используя системные уязвимости"]},{"tag":"a","props":{"href":"/ru/tip/09-09"},"children":[{"tag":"span","props":{},"children":["09"]},"Не выбрасывайте ничего с балкона и из окон — ни окурки, ни мусорные пакеты, ни бутылки"]},{"tag":"a","props":{"href":"/ru/tip/09-10"},"children":[{"tag":"span","props":{},"children":["10"]},"Не покупайте в интернете имитации огнестрельного оружия, пневматические пистолеты и пистолеты с металлическими шариками; избегайте «игрушечного оружия» неизвестного происхождения"]},{"tag":"a","props":{"href":"/ru/tip/09-11"},"children":[{"tag":"span","props":{},"children":["11"]},"Перед покупкой дрона необходимо пройти регистрацию, запрещено летать над аэропортами, военными объектами и в зонах с ограниченным воздушным движением; также нельзя обходить ограничения по высоте"]},{"tag":"a","props":{"href":"/ru/tip/09-12"},"children":[{"tag":"span","props":{},"children":["12"]},"Не снимайте других тайком, не устанавливайте камеры в съёмных квартирах, гостевых домах и гостиничных номерах"]},{"tag":"a","props":{"href":"/ru/tip/09-13"},"children":[{"tag":"span","props":{},"children":["13"]},"Можно играть в маджонг и в карты: не брать проценты, не быть крупье, не организовывать игру за деньги, не участвовать в онлайн-азартных играх"]},{"tag":"a","props":{"href":"/ru/tip/09-14"},"children":[{"tag":"span","props":{},"children":["14"]},"Не употреблять диких животных в пищу, не покупать, не продавать и не держать под охраной находящихся животных в качестве домашних питомцев"]},{"tag":"a","props":{"href":"/ru/tip/09-15"},"children":[{"tag":"span","props":{},"children":["15"]},"Взыскание долга без задержания, лишения свободы или преследования до дома"]},{"tag":"a","props":{"href":"/ru/tip/09-16"},"children":[{"tag":"span","props":{},"children":["16"]},"Не одалживайте свой паспорт, не пользуйтесь чужим паспортом, не регистрируйтесь, не оформляйте карты и не покупайте билеты по чужим документам"]},{"tag":"a","props":{"href":"/ru/tip/09-17"},"children":[{"tag":"span","props":{},"children":["17"]},"Сотрудничайте с полицией: не сопротивляйтесь, не бейте и не пытайтесь отобрать камеру, особенно если вы выпили"]},{"tag":"a","props":{"href":"/ru/tip/09-18"},"children":[{"tag":"span","props":{},"children":["18"]},"Секс с девочкой младше 14 лет запрещён — «её согласие» не является оправданием"]},{"tag":"a","props":{"href":"/ru/tip/09-19"},"children":[{"tag":"span","props":{},"children":["19"]},"Рассчитайте все последствия перед тем, как поднять руку: арест, штрафы и тюремное заключение"]},{"tag":"a","props":{"href":"/ru/tip/09-20"},"children":[{"tag":"span","props":{},"children":["20"]},"Если родители не могут воспитывать ребенка, единственным законным выходом является регистрация в органах гражданской администрации: передача ребенка за деньги может квалифицироваться как торговля детьми, а оставление его без присмотра — как оставление в беде"]},{"tag":"a","props":{"href":"/ru/tip/09-21"},"children":[{"tag":"span","props":{},"children":["21"]},"Не подделывайте происшествия и не завышайте ущерб для получения выплат: это страховое мошенничество, а лица, которые помогают вам давать показания, проводить экспертизу или оценку ущерба, также привлекаются к ответственности"]},{"tag":"a","props":{"href":"/ru/tip/09-22"},"children":[{"tag":"span","props":{},"children":["22"]},"Не продавайте свои органы и не помогайте другим в поиске доноров: за одну почку можно получить чуть более 20 тысяч юаней, а перепродать её пациенту — уже за 200–220 тысяч; при этом все вырученные средства конфискуются, а к ним добавляется штраф в размере 10–20 кратной суммы сделки. Всего же за незаконную торговлю органами можно лишиться 10,34 миллиона юаней, а также выплатить штраф в размере 190 тысяч, 210 тысяч, 7,5 тысяч, 150 тысяч и 56 тысяч юаней"]},{"tag":"a","props":{"href":"/ru/tip/09-23"},"children":[{"tag":"span","props":{},"children":["23"]},"Не ходите на путаны: по умолчанию предусмотрено административное задержание на 10–15 суток, а не просто штраф"]},{"tag":"a","props":{"href":"/ru/tip/09-24"},"children":[{"tag":"span","props":{},"children":["24"]},"Перевод комиксов, размещение фильмов и сериалов, распространение ссылок на облачные хранилища и пиратских электронных книг без взимания платы — всё это тоже нарушение авторских прав; размещение рекламы и взимание членских взносов может привести к уголовному наказанию"]},{"tag":"a","props":{"href":"/ru/tip/09-25"},"children":[{"tag":"span","props":{},"children":["25"]},"Публикация фанфиков и вторичных произведений: как избежать нарушения авторских прав"]},{"tag":"a","props":{"href":"/ru/tip/09-26"},"children":[{"tag":"span","props":{},"children":["26"]},"Не покупайте для самообороны дубинки, электрошокеры, кинжалы и перцовый спрей, чтобы носить с собой: хранение в машине тоже считается ношением"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"Навигация"},"children":[{"tag":"a","props":{"href":"/ru/book"},"children":["Книга"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/ru/book/09"},"children":["Глава 9"," ·"," ","Частые юридические подводные камни для обычных людей"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"09-06"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["06"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["Доказательства"," ","A"]}]},{"tag":"h1","props":{"lang":"ru"},"children":["Люди предлагают вам участвовать в «оформлении документов» для получения кредита и обещают процент от суммы — ничего из этого делать не стоит"]},{"tag":"p","props":{"lang":"ru","className":"life-entry-summary"},"children":["Помощь в «оформлении документов» для кредита и получение процента — это по сути мошенничество. Была задержана группа из 126 человек, которая выдавала безработных за «надёжных клиентов» и получила более 30 миллионов юаней в кредитах от более чем 80 банков. Те, кто подписывал документы, получали 30% от суммы кредита. Из 80 осуждённых 76 человек получили сроки от 1 года 4 месяцев до 6 лет 6 месяцев. Кредит оформляется на конкретного человека, поэтому долг тоже остаётся за ним."]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Затраты"]},{"tag":"p","props":{},"children":["Ничего не тратится. Просто откажитесь. Не одалживайте свой…"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Польза"]},{"tag":"p","props":{},"children":["С помощью обмана можно получить кредиты, акцепты векселей, аккредитивы, гарантии от банков и других финансовых…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"Отметить: Люди предлагают вам участвовать в «оформлении документов» для получения кредита и обещают процент от суммы — ничего из этого делать не стоит"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"Сделано"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"В планах"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"В избранное"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Поделиться советом"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Скрыть подробности"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Затраты"]},{"tag":"p","props":{},"children":["Ничего не тратится. Просто откажитесь. Не одалживайте свой паспорт и кредитную историю другим, не подписывайте кредитные договоры, которые не читали, и не ходите в банк вместо других людей, чтобы подписать документы."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Польза"]},{"tag":"p","props":{},"children":["С помощью обмана можно получить кредиты, акцепты векселей, аккредитивы, гарантии от банков и других финансовых организаций. Если такие действия наносят крупный ущерб, виновному грозит до 3 лет лишения свободы, а также штраф. При особо крупном ущербе или других тяжких обстоятельствах срок увеличивается до 3–7 лет с наложением штрафа. Уголовное дело возбуждается при прямом ущербе от 500 тысяч юаней. Если человек не собирался возвращать деньги и использовал поддельные проекты, договоры, документы или свидетельства о праве собственности для получения кредита, это уже мошенничество. При сумме свыше 50 тысяч юаней грозит до 5 лет лишения свободы и штраф от 20 тысяч до 200 тысяч юаней. При крупном или особо крупном ущербе срок увеличивается до 10 лет и пожизненного заключения. Подделка, изменение или незаконная продажа официальных документов, печатей государственных органов наказывается до 3 лет лишения свободы, а при тяжких обстоятельствах — от 3 до 10 лет. Пример: та же группа из 126 человек обманула более 80 банков в 16 регионах, выдав безработных за «надёжных клиентов». «Подставные» лица получали 30% от суммы кредита. Прокуратура привлекла к ответственности 105 таких людей. В 2026 году 76 из 80 осуждённых получили сроки от 1 года 4 месяцев до 6 лет 6 месяцев за мошенничество. Ещё 4 человека, которые снимали деньги для группировки, были приговорены одновременно за мошенничество и отмывание денег — сроки от 2 лет 4 месяцев до 7 лет 6 месяцев. Данная статья о мошенничестве при получении кредитов действует с марта 2021 года по поправкам к Уголовному кодексу."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Первоисточники"]},{"tag":"p","props":{"className":"life-citations"},"children":["全国人大常委会 (2020). 刑法修正案（十一）（第十一条，修改刑法第一百七十五条之一）. ",{"tag":"a","props":{"href":"https://www.spp.gov.cn/spp/fl/202012/t20201227_503700.shtml","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.spp.gov.cn/spp/fl/202012/t20201227_503700.shtml"]},"；全国人大 (1997). 刑法（第八十八、一百九十三、二百八十条）. ",{"tag":"a","props":{"href":"https://www.spp.gov.cn/spp/fl/201802/t20180206_364975.shtml","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.spp.gov.cn/spp/fl/201802/t20180206_364975.shtml"]},"；最高人民检察院、公安部 (2022). 关于公安机关管辖的刑事案件立案追诉标准的规定（二）（第二十二、四十五条）. ",{"tag":"a","props":{"href":"https://www.spp.gov.cn/spp/xwfbh/wsfbt/202204/t20220429_555906.shtml","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.spp.gov.cn/spp/xwfbh/wsfbt/202204/t20220429_555906.shtml"]},"；最高人民检察院 (2026). 骗贷流水线背后藏洗钱黑手（检察日报）. ",{"tag":"a","props":{"href":"https://www.spp.gov.cn/spp/zdgz/202604/t20260428_726494.shtml","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.spp.gov.cn/spp/zdgz/202604/t20260428_726494.shtml"]},"；全国人大常委会 (2012). 出境入境管理法（第十二条）. ",{"tag":"a","props":{"href":"https://www.nia.gov.cn/n741440/n741547/c1013311/content.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.nia.gov.cn/n741440/n741547/c1013311/content.html"]},"（国家移民管理局）；全国人大常委会 (2023 修正). 民事诉讼法（第二百六十六条）. ",{"tag":"a","props":{"href":"https://amr.guizhou.gov.cn/zwgk/xxgkml/jcxxgk/zcfg/fl/202401/t20240129_83645867.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://amr.guizhou.gov.cn/zwgk/xxgkml/jcxxgk/zcfg/fl/202401/t20240129_83645867.html"]},"（贵州省市场监管局转载）"]},{"tag":"a","props":{"href":"https://www.spp.gov.cn/spp/fl/202012/t20201227_503700.shtml","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Открыть источник"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Примечание автора"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["В одном из дел фраза «Я изначально планировал вернуть деньги» не была принята во внимание. Прокуратура установила, что эти люди не имели работы и имущества, не могли выплатить долг, а полученные средства уже потратили, поэтому было признано, что они изначально не собирались возвращать деньги. Те, кто снимал деньги для группировки, могут быть привлечены ещё и за отмывание денег. Кредит оформляется на конкретного человека, поэтому он и является заёмщиком. Даже если состава преступления нет, долг и запись в кредитной истории остаются за ним. Скрыться за границей не получится: после возбуждения дела розыск продолжается бессрочно. Лицам, не отбывшим полный срок, запрет на выезд не снимается. Запрет на выезд может наложить суд в гражданских делах, если обязательства не выполнены, а также в отношении подозреваемых и обвиняемых. О том, как снимать наличные по чужим картам (пункт 5 этого раздела) и как обнаружить, что кто-то оформил кредит на ваше имя, читайте в пункте 9 раздела 8."]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Моя заметка"]},{"tag":"button","props":{"type":"button"},"children":["Запишите напоминание…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/ru/tip/09-05"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Предыдущий"]},"«Подработка»: вам предлагают использовать свою банковскую карту для получения денег, снятия наличных и переводов; какой бы вознаграждение ни предлагали, не соглашайтесь на это"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/ru/tip/09-07"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Следующий"]},"Найти чужую банковскую карту и не снимать с неё деньги; найти телефон или кошелёк — связаться с владельцем или отнести в отделение полиции, а не забирать себе"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["Другие советы по этой теме"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/09-02"},"children":[{"tag":"strong","props":{},"children":["Не публиковать и не пересылать изображения, мемы и комментарии, оскорбляющие героев и мучеников, не шутить над государственным флагом и гимном"]},{"tag":"span","props":{},"children":["За шутки над героями, флагом или гимном предусмотрено административно…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/09-03"},"children":[{"tag":"strong","props":{},"children":["После просмотра материалов на зарубежных сайтах их нужно сразу закрывать: не делать скриншоты, не пересылать, не размещать в чатах и не комментировать"]},{"tag":"span","props":{},"children":["Эти статьи закона наказывают за распространение информации, а не за е…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/09-04"},"children":[{"tag":"strong","props":{},"children":["Смотреть порнографию для личного пользования — это ваше право, но не стоит выкладывать её в чаты, продавать как «ресурсы» или создавать специальные группы"]},{"tag":"span","props":{},"children":["Смотреть порнографию лично — это не запрещено законом. Однако один ед…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/09-08"},"children":[{"tag":"strong","props":{},"children":["Получать скидки можно только под своим настоящим именем: нельзя регистрировать множество фиктивных аккаунтов, используя виртуальные номера, и нельзя пытаться получать бонусы повторно, используя системные уязвимости"]},{"tag":"span","props":{},"children":["Использование своего настоящего имени и одного аккаунта для получения…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/09-09"},"children":[{"tag":"strong","props":{},"children":["Не выбрасывайте ничего с балкона и из окон — ни окурки, ни мусорные пакеты, ни бутылки"]},{"tag":"span","props":{},"children":["Выбрасывание предметов вниз с высоты может привести к административно…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/09-10"},"children":[{"tag":"strong","props":{},"children":["Не покупайте в интернете имитации огнестрельного оружия, пневматические пистолеты и пистолеты с металлическими шариками; избегайте «игрушечного оружия» неизвестного происхождения"]},{"tag":"span","props":{},"children":["Пневматические пистолеты и пистолеты с металлическими шариками, приоб…"]}]}]}]},{"tag":"a","props":{"className":"life-text-link","href":"/ru/book/09"},"children":["Читать всю тему: Частые юридические подводные камни для обычных людей"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"15","height":"15","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]}]}]},{"tag":"nav","props":{"className":"life-tabbar","aria-label":"Основная навигация"},"children":[{"tag":"a","props":{"className":"","href":"/ru/book"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"21","height":"21","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-book-open","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M12 7v14"},"children":[]},{"tag":"path","props":{"d":"M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z"},"children":[]}]},{"tag":"span","props":{},"children":["Книга"]}]},{"tag":"a","props":{"className":"","href":"/ru/top-50"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"21","height":"21","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-star","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.