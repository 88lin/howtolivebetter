ldren":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"加入待做"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"收藏"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"分享这条建议"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"收起详情"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["成本"]},{"tag":"p","props":{"className":"life-citations"},"children":["学费和住宿费都不用你出，还能拿生活费补助。代价是毕业后 6 年不能自由择业，违约要退钱、交违约金、进信用记录。难在这 6 年里换不了地方。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["收益"]},{"tag":"p","props":{"className":"life-citations"},"children":["公费师范生看《教育部直属师范大学本研衔接师范生公费教育实施办法》（2024 年，2018 年办法同时废止）。第二条：由中央财政承担学生在校期间学费、住宿费并给予生活费补助。第三条：重点为中西部地区省会城市之外的地（市、州、盟）及以下培养。它还写着「不得定向到直辖市、计划单列市或省会城市主城区任教（五个自治区、陆地边境省份、海南省、贵州省、青海省除外）」。第九条：毕业后一般回生源所在省份定向地（市、州、盟）中小学任教，「承诺从事中小学教育工作 6 年以上」。到城镇学校工作的，「应到农村义务教育学校任教服务至少 1 年」。第十三条：没履约或者履约期限不够的，按协议承担责任。后果之一是「违约行为纳入信用记录，并及时与全国信用信息共享平台共享，违约相关材料归入本人人事档案」。另一句是「履约任务完成前不得到定向地（市、州、盟）之外从教，不得被招录（聘用）为其他公务人员。完成履约任务后即修复相关信用」。协议约定的服务期没干满之前，别的公职岗位报不了；干满了，信用记录才恢复。第六条：录取后经考察不适合从教的，入学 1 年内退还已享受的公费教育费用，并调整到非师范专业。第十四条：没在规定学习年限内取得教育硕士学历学位证书和教师资格证书的，按违约处理，退费并缴纳违约金。第二十一条：各地在现有事业编制总量内，解决公费师范生到中小学任教所需编制。第十二条写着，地市组织用人学校对公费师范生专项招聘，「通过双向选择等方式切实为每位毕业的公费师范生落实任教学校和岗位」。农村订单定向免费医学生看另一份通知。录取后、获得入学通知书前，须与培养学校和定向就业所在地县级卫生健康、人社部门签署协议。协议里要「承诺毕业后到定向农村基层医疗卫生机构服务 6 年」。履约就是按协议去指定的地方干满。编制这一块，通知写的是省级卫生健康部门「要积极争取当地机构编制部门支持，在当地编制总量内，按照规定程序，妥善解决定向医学毕业生就业安置问题」。到中西部报到的，由县里专项招聘，「办理事业单位正式工作人员聘用手续」。履约报到就业后，须参加 3 年全科专业住院医师规范化培训，简称规培。规培就是毕业后在医院按统一标准接着练本事的阶段。培训期间原人事、工资关系不变。违约记录归入个人人事档案，并作为医疗卫生机构等行政事业单位公开招录（招聘）、住院医师规范化培训招收、研究生招生录取的诚信评价依据。恶意违约的人，通过「信用中国」网站全国公示，并实行失信联合惩戒。违约的培训年限不计入服务期。没按协议退还费用和违约金的，由县级卫生健康行政部门通过法律途径追缴（全国）"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["来源"]},{"tag":"p","props":{"className":"life-citations"},"children":["国务院办公厅 (2024). 关于转发教育部等部门《教育部直属师范大学本研衔接师范生公费教育实施办法》的通知（国办发〔2024〕27 号，第二、三、六、九、十二、十三、十四、二十一条）. ",{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/202406/content_6957261.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/zhengce/zhengceku/202406/content_6957261.htm"]},"；国家卫生健康委、中央编办、国家发展改革委、教育部、财政部、人力资源社会保障部、国家中医药局 (2019). 关于做好农村订单定向免费培养医学生就业安置和履约管理工作的通知. ",{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/2019-11/13/content_5451684.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/zhengce/zhengceku/2019-11/13/content_5451684.htm"]},""]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["原书备注"]},{"tag":"p","props":{"className":"life-citations"},"children":["2024 年那份办法把公费师范生改成了「本研衔接」（本科接着读教育硕士）。2018 年的老办法已经废止，网上还在传的「本科毕业直接任教」是旧说法。办法发布前已经签了协议的，按原协议走。「有编制」不等于「进去就不用管」：编制要在现有总量里腾，具体岗位由地市组织用人学校专门招聘，你和学校互相挑。定向医学生的编制，文件只写了要争取、要妥善解决，各省做法不一样，填志愿前看本省文件。定向医学生服务期满想走是可以的，文件写明「服务期满，对自主择业的应予同意」。已经违约的也有办法把违约记录消掉。代价是按原协议、或者改到省内其他农村基层机构再干满至少 6 年，已交的费用和违约金不退。医学生还要算上 3 年规培的时间，整个周期比师范长。各省还有自己的公费师范生和定向医学生计划，条件由省里定，填志愿前看当年本省的招生文件。"]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["我的备注"]},{"tag":"button","props":{"type":"button"},"children":["写下对自己有用的提醒…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/tip/31-12"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["上一条"]},"送外卖、跑网约车、拉同城货运，平台按单给你交职业伤害保障费，自己不缴"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/tip/31-14"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["下一条"]},"想出国打工，先查这家公司有没有对外劳务合作经营资格：它不得向你收押金"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["本主题的其他建议"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/31-08"},"children":[{"tag":"strong","props":{},"children":["特岗教师三年服务期满、考核合格又愿意留下的，应当及时入编"]},{"tag":"span","props":{},"children":["特岗计划是少数几条写明「期满入编」的路。条件是本科及以上学历、以师范类专业为主，年龄不超过 30 周岁，还要有相应的教师资格证。服务期三年，这三年同等条件下的待…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/31-09"},"children":[{"tag":"strong","props":{},"children":["消防员和军队文职是另外两个公开招录的口子，门槛比考公低"]},{"tag":"span","props":{},"children":["这两条路都不卡「大专以上」这道门槛。消防员招 18 到 22 周岁、高中以上文化程度的人，大专以上学历的人和退役士兵可以放宽到 24 周岁。军队文职只要求年满…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/31-10"},"children":[{"tag":"strong","props":{},"children":["学历不是一锤子买卖：自考不限年龄和已受教育程度，成人高考和开放大学都能补，学历只认学信网查得到的，「免考包过」的学历提升班别报"]},{"tag":"span","props":{},"children":["十八岁没读成书，后面还有自考、成人高考、开放大学三条正规通道。自考不限年龄和原来的学历，但全日制在校生不能报。毕业证要在学信网查得到才算数，查得到以后学校也改不…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/31-11"},"children":[{"tag":"strong","props":{},"children":["不进单位就是灵活就业：养老和医疗要自己在就业地参保，户籍限制已经放开"]},{"tag":"span","props":{},"children":["不进单位，不等于没有社保这回事，只是没人替你交那一半。文件要求各地放开灵活就业人员在就业地参保的户籍限制，个别超大城市可以逐步放开。所以别把「自由」理解成不用管…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/31-15"},"children":[{"tag":"strong","props":{},"children":["在家给境外公司远程干活，这笔钱在税法上算境内所得：个税自己报，收汇走「职工报酬」"]},{"tag":"span","props":{},"children":["这笔钱算境内还是境外，看的是你在哪儿干活，不是钱从哪儿打进来。人在国内远程给境外公司干活，算境内所得，要在境内交个税。境外公司在中国没有机构的，没人替你代扣，这…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/31-16"},"children":[{"tag":"strong","props":{},"children":["不进单位自己干，起步钱先看创业担保贷款：个人最高 30 万、财政贴一半利息"]},{"tag":"span","props":{},"children":["属于高校毕业生、退役军人、失业人员这类重点群体的，借钱起步先看这笔有财政贴息的。个人最高能借 30 万元，最长 3 年，利息由财政替你出一半。申请时你和配偶名下…"]}]}]}]},{"tag":"a","props":{"className":"life-text-link","href":"/book/31"},"children":["阅读整个主题：十八岁之后有哪几条路 ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"15","height":"15","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]}]}]},{"tag":"nav","props":{"className":"life-tabbar","aria-label":"主导航"},"children":[{"tag":"a","props":{"className":"","href":"/book"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"21","height":"21","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-book-open","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M12 7v14"},"children":[]},{"tag":"path","props":{"d":"M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-