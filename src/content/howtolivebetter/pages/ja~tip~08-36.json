ta-ad-group":"reading","data-ad-creative":"read_product","data-ad-ready":"false","aria-label":"広告 · コミュニティ紹介"},"children":[{"tag":"button","props":{"type":"button","className":"life-ad-dismiss","aria-label":"広告を閉じる"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-x","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M18 6 6 18"},"children":[]},{"tag":"path","props":{"d":"m6 6 12 12"},"children":[]}]}]},{"tag":"div","props":{"className":"life-ad-space-brand"},"children":[{"tag":"img","props":{"src":"/sites/howtolivebetter/images/shengcai/logo.png","width":"565","height":"144","alt":"生財有術の公式ロゴ","decoding":"async"},"children":[]}]},{"tag":"div","props":{"className":"life-ad-space-copy"},"children":[{"tag":"span","props":{"className":"life-ad-space-label"},"children":["広告 · コミュニティ紹介"]},{"tag":"strong","props":{},"children":["学んだ知識は、役立つ製品になる？"]},{"tag":"p","props":{},"children":["電子書籍や小さなツール。需要を見つけ、知識を使える形にする参加者の実践を紹介します。"]}]},{"tag":"div","props":{"className":"life-ad-space-actions"},"children":[{"tag":"a","props":{"className":"life-ad-space-link","href":"/ja/shengcaiyoushu?sc_group=reading&sc_creative=read_product&sc_placement=ad_dock"},"children":["コミュニティと事例を見る",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"18","height":"18","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-up-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M7 7h10v10"},"children":[]},{"tag":"path","props":{"d":"M7 17 17 7"},"children":[]}]}]}]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/ja/book/08"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"目次に戻る"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["自分を犠牲にしないために：法律と財産の安全を守る"]},{"tag":"div","props":{"data-ad-dock-host":"true"},"children":[]},{"tag":"nav","props":{"aria-label":"この章のヒント"},"children":[{"tag":"a","props":{"href":"/ja/tip/08-01"},"children":[{"tag":"span","props":{},"children":["01"]},"交通事故に遭ったら、まずは停車、救護、通報。逃走してはいけない"]},{"tag":"a","props":{"href":"/ja/tip/08-02"},"children":[{"tag":"span","props":{},"children":["02"]},"詐欺に気づいたら、すぐに 110 または 96110 に電話して支払停止を依頼すること。自分で調べるのは後回しに"]},{"tag":"a","props":{"href":"/ja/tip/08-03"},"children":[{"tag":"span","props":{},"children":["03"]},"詐欺防止の鉄則を覚えよう：電話を鵜呑みにしない、情報を明かさない、リンクをクリックしない、送金は必ず確認する。最も一般的な7つの詐欺はこのパターンです"]},{"tag":"a","props":{"href":"/ja/tip/08-04"},"children":[{"tag":"span","props":{},"children":["04"]},"ビデオで顔を見ること、電話で声を聞くことは「本人確認」とはみなさない。送金が絡む場合は一旦電話を切り、自分の連絡先に登録されている古い番号にかけ直すこと"]},{"tag":"a","props":{"href":"/ja/tip/08-05"},"children":[{"tag":"span","props":{},"children":["05"]},"容疑をかけられた、または召喚された場合は、まず弁護士を依頼すること。示談はせず、記録を削除しないこと"]},{"tag":"a","props":{"href":"/ja/tip/08-06"},"children":[{"tag":"span","props":{},"children":["06"]},"問題が起きたら自ら説明しに行く：自首すれば刑期を最大4割減刑できる可能性があり、軽い犯罪ならさらに減刑や免罰もあり得る。「公訴時効を逃れる」という道は閉ざされている"]},{"tag":"a","props":{"href":"/ja/tip/08-07"},"children":[{"tag":"span","props":{},"children":["07"]},"飲酒した後はハンドルに触れない。電気自動車や「少しだけ動かす」場合も含む"]},{"tag":"a","props":{"href":"/ja/tip/08-08"},"children":[{"tag":"span","props":{},"children":["08"]},"銀行カード、SIMカード、決済アカウントを他人に貸さない。「資金洗浄（跑分）」は副業ではない"]},{"tag":"a","props":{"href":"/ja/tip/08-09"},"children":[{"tag":"span","props":{},"children":["09"]},"年に2回、無料で自分の信用報告書をチェックし、身に覚えのないローンやカードがないか確認する"]},{"tag":"a","props":{"href":"/ja/tip/08-10"},"children":[{"tag":"span","props":{},"children":["10"]},"衝突が起きたら、手を出さずにまず通報すること。先に手を出した側が、ほぼ確実に損をする"]},{"tag":"a","props":{"href":"/ja/tip/08-11"},"children":[{"tag":"span","props":{},"children":["11"]},"避けられない侵害に対しては反撃可能だが、現在手を出し続けている人物に対してのみ行うこと。相手が止まれば、あなたも止めること"]},{"tag":"a","props":{"href":"/ja/tip/08-12"},"children":[{"tag":"span","props":{},"children":["12"]},"誰と恨みができたとしても（賃金未払い、解雇、金銭トラブルなど）―― 復讐ではなく、苦情申し立て、仲裁、訴訟の手続きを踏むこと"]},{"tag":"a","props":{"href":"/ja/tip/08-13"},"children":[{"tag":"span","props":{},"children":["13"]},"どれほど恨みがあっても無関係な人には手を出さない：車で群衆に突っ込む行為や公共の場での凶行は「危険な方法による公共の安全への危害罪」となり、刑期は3年から。死者が出れば10年以上、最高で死刑"]},{"tag":"a","props":{"href":"/ja/tip/08-14"},"children":[{"tag":"span","props":{},"children":["14"]},"「道連れにしてやる」「共倒れになってやる」といった考えが浮かんだら、緊急事態として対処：その場を離れ、車の鍵や刃物を他人に預け、12356 に電話する"]},{"tag":"a","props":{"href":"/ja/tip/08-15"},"children":[{"tag":"span","props":{},"children":["15"]},"周囲の人が「誰も幸せになれないようにしてやる」「子供を連れて逃げる」と言い出した時、感情的な言葉だと思わないで：近親者は直接受診させることができ、警察は通報を受けたら必ず対応しなければなりません"]},{"tag":"a","props":{"href":"/ja/tip/08-16"},"children":[{"tag":"span","props":{},"children":["16"]},"ネット上では誹謗中傷やデマ、未確認情報の拡散をしないこと。ネットリンチを受けた際は、まず証拠を残してから警察へ通報すること"]},{"tag":"a","props":{"href":"/ja/tip/08-17"},"children":[{"tag":"span","props":{},"children":["17"]},"署名前に書類を最後まで読み、代理署名はせず、白紙には署名しない"]},{"tag":"a","props":{"href":"/ja/tip/08-18"},"children":[{"tag":"span","props":{},"children":["18"]},"借金の際は借用書を明記すること。他人への保証人になる前には、代わりに返済する意思があるかよく考えること"]},{"tag":"a","props":{"href":"/ja/tip/08-19"},"children":[{"tag":"span","props":{},"children":["19"]},"権利保護には期限があります：民事訴訟時効は 3 年、労働仲裁は 1 年、期限を過ぎると相手の「時効超過」の一言で十分です"]},{"tag":"a","props":{"href":"/ja/tip/08-20"},"children":[{"tag":"span","props":{},"children":["20"]},"提訴された、強制執行された場合は、財産を正直に報告し、支払える分だけ支払うこと。不動産や現金を親族や会社に移してはいけません"]},{"tag":"a","props":{"href":"/ja/tip/08-21"},"children":[{"tag":"span","props":{},"children":["21"]},"消費制限または失信リストへの掲載を受けた場合は、まずどの条項に基づいて掲載されたのかを確認し、訂正可能な場合は訂正を申請すること"]},{"tag":"a","props":{"href":"/ja/tip/08-22"},"children":[{"tag":"span","props":{},"children":["22"]},"ネットショッピングや中古取引で詐欺に遭ったら、まずはプラットフォームへ通報、次に警察へ通報、その上で訴訟を起こす価値があるかを検討"]},{"tag":"a","props":{"href":"/ja/tip/08-23"},"children":[{"tag":"span","props":{},"children":["23"]},"恋愛および婚姻における高額な贈与は、交付する前に慎重に検討を。交付後は原則として取り消せません"]},{"tag":"a","props":{"href":"/ja/tip/08-24"},"children":[{"tag":"span","props":{},"children":["24"]},"結納金は振込で行い、用途を明記し、チャット履歴を保存すること。結婚を口実とした金銭要求は返還請求が可能"]},{"tag":"a","props":{"href":"/ja/tip/08-25"},"children":[{"tag":"span","props":{},"children":["25"]},"婚前財産を恐れる必要はありません。不動産の名義追加や親の出資は事前に明確に書き留めておくこと"]},{"tag":"a","props":{"href":"/ja/tip/08-26"},"children":[{"tag":"span","props":{},"children":["26"]},"結婚前に相手の婚姻状況を確認すること。結婚を口実にお金を騙し取る行為は詐欺罪として追及されます"]},{"tag":"a","props":{"href":"/ja/tip/08-27"},"children":[{"tag":"span","props":{},"children":["27"]},"出張修理、車両点検、リフォームなどは、作業前に必ず価格を確認し、全工程を傍らで見守ること"]},{"tag":"a","props":{"href":"/ja/tip/08-28"},"children":[{"tag":"span","props":{},"children":["28"]},"「名義上の代表者」にならないこと。会社設立のために身分証を他人に貸さないこと"]},{"tag":"a","props":{"href":"/ja/tip/08-29"},"children":[{"tag":"span","props":{},"children":["29"]},"出入国時に見知らぬ人の荷物を預からないこと。出所不明の小包を代理受領しないこと"]},{"tag":"a","props":{"href":"/ja/tip/08-30"},"children":[{"tag":"span","props":{},"children":["30"]},"中国で犬を飼うなら必ずリードを使う。未装着の事故は無過失責任で賠償する。狂犬病ワクチンと飼育登録も忘れない"]},{"tag":"a","props":{"href":"/ja/tip/08-31"},"children":[{"tag":"span","props":{},"children":["31"]},"相手が意識不明、睡眠中、または 14 歳未満である可能性がある場合は、性交渉を行わないこと"]},{"tag":"a","props":{"href":"/ja/tip/08-32"},"children":[{"tag":"span","props":{},"children":["32"]},"性交渉やビデオチャットの後、相手が通報、写真の拡散、勤務先への連絡を盾に金銭を要求してきた場合、一銭も払わず、記録も削除せず、直ちに警察へ通報すること"]},{"tag":"a","props":{"href":"/ja/tip/08-33"},"children":[{"tag":"span","props":{},"children":["33"]},"事実を捏造して通報された場合、以下の追及が可能です：治安行政処分に該当する場合は 5 日からの拘留、犯罪に該当する場合は 3 年以下の懲役"]},{"tag":"a","props":{"href":"/ja/tip/08-34"},"children":[{"tag":"span","props":{},"children":["34"]},"証拠不十分であれば本来無罪とされるべきであり、強要された自白は排除されるべきである。判決後には上訴や再審の道がある"]},{"tag":"a","props":{"href":"/ja/tip/08-35"},"children":[{"tag":"span","props":{},"children":["35"]},"勾留後に不起訴、不起訴処分または無罪判決を受けた場合、国家賠償を申請できます。賠償額は日割り計算されます"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/ja/tip/08-36","data-status":"active"},"children":[{"tag":"span","props":{},"children":["36"]},"被害者として賠償を請求する場合、12315、訴訟、または弁護士を通じて行い、相手と二人きりで会う約束をしないこと。「金を払えば、公表しない」という言い方をセットにしないこと"]},{"tag":"a","props":{"href":"/ja/tip/08-37"},"children":[{"tag":"span","props":{},"children":["37"]},"ネット炎上（ネットいじめ）に遭ったら：まずは防御設定、証拠保全、そしてプラットフォームへの通報・禁止命令・警察への通報の3つの道から選択"]},{"tag":"a","props":{"href":"/ja/tip/08-38"},"children":[{"tag":"span","props":{},"children":["38"]},"「保険をかけてから手を下す」という道は、法律上最初から完全に塞がれています：金銭は一切受け取れず、罪は殺人罪と保険詐欺罪の併合罪として処罰されます"]},{"tag":"a","props":{"href":"/ja/tip/08-39"},"children":[{"tag":"span","props":{},"children":["39"]},"警察への通報時はその場で受理票を受け取ること、不立案（事件化しない）の場合は書面での通知が必要：7 日以内に再審査を申請でき、さらに 7 日以内に再審査請求が可能。検察庁は警察に立案を通知できます"]},{"tag":"a","props":{"href":"/ja/tip/08-40"},"children":[{"tag":"span","props":{},"children":["40"]},"捜査・執行官への金銭やカードの贈賄は避けること：贈賄側も処罰の対象となり、監察・執行・司法関係者への贈賄はより重い刑が科される"]},{"tag":"a","props":{"href":"/ja/tip/08-41"},"children":[{"tag":"span","props":{},"children":["41"]},"トラブルに発展しそうな電話や面談は、直接録音する：自分が参加している会話なら、相手の事前の同意は不要"]},{"tag":"a","props":{"href":"/ja/tip/08-42"},"children":[{"tag":"span","props":{},"children":["42"]},"現場で事故が起きたら、まず全景、次に位置関係、最後に損傷と怪我の状況を撮影すること。元の写真や動画は削除しないでください"]},{"tag":"a","props":{"href":"/ja/tip/08-43"},"children":[{"tag":"span","props":{},"children":["43"]},"ドメスティック・バイオレンス（DV）を受けた時：まずは警察に通報して出動記録を残し、その後に裁判所へ人身安全保護命令を申請しましょう。離婚を先に済ませる必要はなく、費用もかかりません"]},{"tag":"a","props":{"href":"/ja/tip/08-44"},"children":[{"tag":"span","props":{},"children":["44"]},"家族がギャンブルで借金を作った場合、すぐに肩代わりして返済しないでください：ギャンブルの借金は法律で保護されず、ギャンブルのために借りたお金も夫婦の共同債務とはみなされません"]},{"tag":"a","props":{"href":"/ja/tip/08-45"},"children":[{"tag":"span","props":{},"children":["45"]},"知人から「顔認証の協力や証人になってほしい」と融資の手伝いを頼まれたら、決して応じてはいけない：これは「ABローン」と呼ばれ、借り手はあなたであり、保証人ではありません"]},{"tag":"a","props":{"href":"/ja/tip/08-46"},"children":[{"tag":"span","props":{},"children":["46"]},"ドアと窓に錠を付け、玄関外にセンサーライトを設置し、外出時は必ず施錠する。侵入窃盗の予防はこの組み合わせで、警報器だけの効果は認められない"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"現在地"},"children":[{"tag":"a","props":{"href":"/ja/book"},"children":["本を読む"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/ja/book/08"},"children":["第8章"," ·"," ","自分を犠牲にしないために：法律と財産の安全を守る"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"08-36"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["36"]},{"tag":"span","props":{"className":"life-evidence grade-b"},"children":["エビデンス"," ","B"]}]},{"tag":"h1","props":{"lang":"ja"},"children":["被害者として賠償を請求する場合、12315、訴訟、または弁護士を通じて行い、相手と二人きりで会う約束をしないこと。「金を払えば、公表しない」という言い方をセットにしないこと"]},{"tag":"p","props":{"lang":"ja","className":"life-entry-summary"},"children":["被害者として加害者に賠償を請求すること自体には法的根拠があり、「請求額が高い」という理由だけで自動的に恐喝罪になることはありません。しかし、その代償は非常に大きくなる可能性があります。郭利氏は、一度恐喝罪で懲役5年の判決を受け、その後に再審で無罪が宣告されました。したがって、記録が残る手段をとり、相手が指定する場所に二人きりで話し合いに行かないこと。「金を払えば、公表しない」という条件を口にしないようにしてください。"]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["費用・手間"]},{"tag":"p","props":{},"children":["費用はかかりません。12315、裁判所への提訴、または弁護士への依頼を通じて行います。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["効果"]},{"tag":"p","props":{},"children":["公的な事例：2008 年、関係当局が一部のロットの「施恩」ブランド粉ミルクにメラミンが含まれていると発表した後、郭利の娘の検査結果は「両腎の中央集合系内に数個の点状の高エコーが認められる」であった。"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"記録する：被害者として賠償を請求する場合、12315、訴訟、または弁護士を通じて行い、相手と二人きりで会う約束をしないこと。「金を払えば、公表しない」という言い方をセットにしないこと"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"できている"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"やることに追加"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"お気に入り"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"このヒントを共有"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"詳細を閉じる"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["費用・手間"]},{"tag":"p","props":{},"children":["費用はかかりません。12315、裁判所への提訴、または弁護士への依頼を通じて行います。話し合いの際は、全行程を録音してください。難しいのは、相手と二人きりで交渉したいという衝動を抑えることです。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["効果"]},{"tag":"p","props":{},"children":["公的な事例：2008 年、関係当局が一部のロットの「施恩」ブランド粉ミルクにメラミンが含まれていると発表した後、郭利の娘の検査結果は「両腎の中央集合系内に数個の点状の高エコーが認められる」であった。郭利は販売業者および施恩会社に対して何度も賠償を求め、メディアに告発した。2009 年 6 月、両者は合意に達し、施恩会社は 40 万元を補償し、郭利は追及を行わないこと、および賠償請求を放棄することを書面で表明した。その後、会社が被害届を提出したため、郭利は潮安県人民法院により恐喝罪で禁錮5年の判決を受けた。広東省人民検察院は再審の勧告を行った。勧告では「現存する証拠は、郭利に不法に占有する主観的な目的があったことを立証するには不十分である」とされた。郭利は法定後見人として、「粉ミルクの製造メーカーに対して賠償を請求する権利があり、その請求行為には法的根拠がある」としている。「消費者は、自身の正当な権利を侵害する行為に対し、大衆メディアを通じて暴露し、批判する権利を有する」とも記載されている。2017年4月7日、広東省高級人民法院は郭利の無罪を再審で宣告した。その理由は、「原審における、郭利が不法に利得を得る目的で、脅迫や強要の手法を用いて財物を強引に要求したという事実認定は不明確であり、証拠不十分である。郭利の行為の性質は民事紛争の範囲を超えていない」というものである。郭利は2009年から7月23日まで、2014年から7月22日までの間、1826日間拘禁された（広東、2017年の再審による判決変更）"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["出典"]},{"tag":"p","props":{"className":"life-citations"},"children":["广东省人民检察院 (2017). 广东省检察院再审建议对郭利案改判无罪. ",{"tag":"a","props":{"href":"http://www.gd.jcy.gov.cn/jcyw2/201704/t20170411_1975029.shtml","target":"_blank","rel":"noopener noreferrer"},"children":["http://www.gd.jcy.gov.cn/jcyw2/201704/t20170411_1975029.shtml"]},"（广东省人民检察院官网）；广东省高级人民法院赔偿委员会 (2018). 郭利以再审无罪为由申请、广东省潮州市中级人民法院赔偿的国家赔偿案件（（2018）粤委赔 11 号）. ",{"tag":"a","props":{"href":"https://www.gdcourts.gov.cn/caipanwenshuxuandeng/caipanwenshuxuandeng/content/post_1045709.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gdcourts.gov.cn/caipanwenshuxuandeng/caipanwenshuxuandeng/content/post_1045709.html"]}]},{"tag":"a","props":{"href":"http://www.gd.jcy.gov.cn/jcyw2/201704/t20170411_1975029.shtml","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["出典を開く"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["著者の注記"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["Bに費用がかからないのは、これがあくまで一つの事例であり、普遍的な割合ではないためです。これは同時に二つのことを示しています。すなわち、賠償請求自体は合法であること、そして、依然として警察から事件として立件される可能性があるということです。最もリスクの低い方法は、賠償請求を弁護士に任せるか、直接裁判所に提訴し、自分自身は相手と直接接触しないことです。相手が自身の所在地での「面談による解決」を求めてきたときは特に注意が必要です。通報や立件は通常、相手の所在地で行われるからです。和解合意書に署名した場合は、その合意に従うべきであり、署名した後に別途高額な賠償を請求することは、「脅迫」と解釈される最も危険な行為です。立件された後の対処については、本節の第 5、34、35 条（まず弁護士に相談、証拠不十分なら無罪となるべき、国家賠償）を参照してください。相手が弱みを握って金銭を要求してくるケースについては、本節の第 32 条（相手が通報や写真の拡散を盾に金を要求する場合）を参照してください。"]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["自分のメモ"]},{"tag":"button","props":{"type":"button"},"children":["自分へのメモを書く…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/ja/tip/08-35"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["前へ"]},"勾留後に不起訴、不起訴処分または無罪判決を受けた場合、国家賠償を申請できます。賠償額は日割り計算されます"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/ja/tip/08-37"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["次へ"]},"ネット炎上（ネットいじめ）に遭ったら：まずは防御設定、証拠保全、そしてプラットフォームへの通報・禁止命令・警察への通報の3つの道から選択"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["このテーマの他の提案"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/08-32"},"children":[{"tag":"strong","props":{},"children":["性交渉やビデオチャットの後、相手が通報、写真の拡散、勤務先への連絡を盾に金銭を要求してきた場合、一銭も払わず、記録も削除せず、直ちに警察へ通報すること"]},{"tag":"span","props":{},"children":["「警察に通報する」「写真を勤務先に送る」と脅して金銭を要求することは、恐喝罪にあたります。一銭も払わず、記録も削除せず、その場で警察署へ通…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/08-33"},"children":[{"tag":"strong","props":{},"children":["事実を捏造して通報された場合、以下の追及が可能です：治安行政処分に該当する場合は 5 日からの拘留、犯罪に該当する場合は 3 年以下の懲役"]},{"tag":"span","props":{},"children":["事実を捏造して他人を誣告（むこく）し、刑事責任や治安行政処分を受けさせようとすることは、それ自体が違法です。この場合、5 日以下の拘留、ま…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/08-34"},"children":[{"tag":"strong","props":{},"children":["証拠不十分であれば本来無罪とされるべきであり、強要された自白は排除されるべきである。判決後には上訴や再審の道がある"]},{"tag":"span","props":{},"children":["有罪判決の基準は刑事訴訟法に明記されている。確定的な証拠は法定の手続きを経て真実であることが確認され、かつ全証拠を総合して合理的な疑いを排…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/08-38"},"children":[{"tag":"strong","props":{},"children":["「保険をかけてから手を下す」という道は、法律上最初から完全に塞がれています：金銭は一切受け取れず、罪は殺人罪と保険詐欺罪の併合罪として処罰されます"]},{"tag":"span","props":{},"children":["4つの門はすべて閉ざされています。家族に内緒で死亡を条件とした保険をかけることは、契約が無効となります。保険契約者が被保険者の死亡を故意に…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/08-39"},"children":[{"tag":"strong","props":{},"children":["警察への通報時はその場で受理票を受け取ること、不立案（事件化しない）の場合は書面での通知が必要：7 日以内に再審査を申請でき、さらに 7 日以内に再審査請求が可能。検察庁は警察に立案を通知できます"]},{"tag":"span","props":{},"children":["通報した際は、その場で受理票を受け取ってください。これは通報した唯一の証拠となります。警察が立案しない（事件化しない）と決定した場合、書面…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/08-40"},"children":[{"tag":"strong","props":{},"children":["捜査・執行官への金銭やカードの贈賄は避けること：贈賄側も処罰の対象となり、監察・執行・司法関係者への贈賄はより重い刑が科される"]},{"tag":"span","props":{},"children":["「金を払って事態を収める」ことは、刑法において独立した罪であり、逮捕されるのは金を受け取った側だけではありません。贈賄は 3 年以下の懲役…"]}]}]}]},{"tag":"a","props":{"className":"life-text-link","href":"/ja/book/08"},"children":["テーマ全体を読む：自分を犠牲にしないために：法律と財産の安全を守る"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"15","height":"15","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]}]}]}]},{"tag":"aside","props":{"className":"life-ad-space life-ad-space-sponsored","data-ad-placement":"ad_footer","data-ad-group":"reading","data-ad-creative":"read_product","data-ad-ready":"false","aria-label":"広告 · コミュニティ紹介"},"children":[{"tag":"div","props":{"className":"life-ad-space-brand"},"children":[{"tag":"img","props":{"src":"/sites/howtolivebetter/images/shengcai/logo.png","width":"565","height":"144","alt":"生財有術の公式ロゴ","decoding":"async"},"children":[]}]},{"tag":"div","props":{"className":"life-ad-space-copy"},"children":[{"tag":"span","props":{"className":"life-ad-space-label"},"children":["広告 · コミュニティ紹介"]},{"tag":"strong","props":{},"children":["学んだ知識は、役立つ製品になる？"]},{"tag":"p","props":{},"children":["電子書籍や小さなツール。需要を見つけ、知識を使える形にする参加者の実践を紹介します。"]}]},{"tag":"div","props":{"className":"life-ad-space-actions"},"children":[{"tag":"a","props":{"className":"life-ad-space-link","href":"/ja/shengcaiyous