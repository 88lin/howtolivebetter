d":"M18 20a6 6 0 0 0-12 0"},"children":[]},{"tag":"circle","props":{"cx":"12","cy":"10","r":"4"},"children":[]},{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},{"tag":"span","props":{},"children":["Đăng nhập để đồng bộ hóa"]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/vi/book/07"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"Quay lại mục lục"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["Sống thế nào khi hết tiền"]},{"tag":"nav","props":{"aria-label":"Các mục trong chương"},"children":[{"tag":"a","props":{"href":"/vi/tip/07-01"},"children":[{"tag":"span","props":{},"children":["01"]},"Mất việc thì xin trợ cấp thất nghiệp trực tuyến trước"]},{"tag":"a","props":{"href":"/vi/tip/07-02"},"children":[{"tag":"span","props":{},"children":["02"]},"Bị nợ lương thì khiếu nại giám sát lao động trước, không được thì xin hoà giải lao động, cả hai đường đều miễn phí"]},{"tag":"a","props":{"href":"/vi/tip/07-03"},"children":[{"tag":"span","props":{},"children":["03"]},"Không đủ tiền kiện tụng thì xin trợ giúp pháp lý, các vụ đòi lương, cấp dưỡng, tai nạn lao động vốn đã nằm trong phạm vi"]},{"tag":"a","props":{"href":"/vi/tip/07-04"},"children":[{"tag":"span","props":{},"children":["04"]},"Không còn đường lui thì đến trạm cứu hộ, ở ăn ở và có vé về quê"]},{"tag":"a","props":{"href":"/vi/tip/07-05"},"children":[{"tag":"span","props":{},"children":["05"]},"Tìm việc thì dùng dịch vụ việc làm công cộng miễn phí và thị trường việc lẻ trước, đừng qua môi giới thu phí"]},{"tag":"a","props":{"href":"/vi/tip/07-06"},"children":[{"tag":"span","props":{},"children":["06"]},"Gặp biến cố đột ngột thì xin trợ cấp tạm thời trước"]},{"tag":"a","props":{"href":"/vi/tip/07-07"},"children":[{"tag":"span","props":{},"children":["07"]},"Thu nhập thấp hơn mức trợ cấp người có thu nhập thấp ở địa phương thì xin trợ cấp người có thu nhập thấp"]},{"tag":"a","props":{"href":"/vi/tip/07-08"},"children":[{"tag":"span","props":{},"children":["08"]},"Người có giấy chứng nhận người khuyết tật thì đi xin hai khoản trợ cấp cho người khuyết tật"]},{"tag":"a","props":{"href":"/vi/tip/07-09"},"children":[{"tag":"span","props":{},"children":["09"]},"Đừng để bảo hiểm y tế cư dân bị đứt quãng mỗi năm 400 tệ, hộ khó khăn được miễn giảm"]},{"tag":"a","props":{"href":"/vi/tip/07-10"},"children":[{"tag":"span","props":{},"children":["10"]},"Mắc bệnh nặng thì đi theo bảo hiểm y tế, bảo hiểm bệnh nan y, trợ cấp y tế và đăng ký khám ngoài tỉnh trước, đừng đụng vào vay tiền trên mạng"]},{"tag":"a","props":{"href":"/vi/tip/07-11"},"children":[{"tag":"span","props":{},"children":["11"]},"Mất thẻ căn cước thì đi làm lại ngay, gấp thì xin thẻ tạm trước"]},{"tag":"a","props":{"href":"/vi/tip/07-12"},"children":[{"tag":"span","props":{},"children":["12"]},"Làm xong đăng ký thất nghiệp thì hãy xin công nhận là người khó khăn việc làm, để nhận trợ cấp bảo hiểm xã hội hoặc làm công việc công ích"]},{"tag":"a","props":{"href":"/vi/tip/07-13"},"children":[{"tag":"span","props":{},"children":["13"]},"Trong thời gian thất nghiệp thì đi nhận trợ cấp đào tạo nghề, trợ cấp thực tập việc làm và trợ cấp bảo hiểm xã hội, đừng tự bỏ tiền học khóa"]},{"tag":"a","props":{"href":"/vi/tip/07-14"},"children":[{"tag":"span","props":{},"children":["14"]},"Tìm việc đừng chỉ nộp hồ sơ, hãy dùng cách có hệ thống: học kỹ thuật, đặt mục tiêu, nhờ người khác giúp"]},{"tag":"a","props":{"href":"/vi/tip/07-15"},"children":[{"tag":"span","props":{},"children":["15"]},"Không nộp tiền cọc, không giữ giấy tờ, không ký「培训贷」, không vào đa cấp, không vay lãi cao"]},{"tag":"a","props":{"href":"/vi/tip/07-16"},"children":[{"tag":"span","props":{},"children":["16"]},"Khó ở nhà thì xếp hàng chờ nhà ở công lập trước"]},{"tag":"a","props":{"href":"/vi/tip/07-17"},"children":[{"tag":"span","props":{},"children":["17"]},"Ép chi phí ở và ăn xuống mức thấp nhất: thuê chung theo tháng thay vì thuê theo ngày, tự nấu ăn và bếp ăn trợ giúp thay cho đồ ăn giao"]},{"tag":"a","props":{"href":"/vi/tip/07-18"},"children":[{"tag":"span","props":{},"children":["18"]},"Bảo hiểm xã hội đứt quãng thì đừng hoảng: lương hưu tính theo số năm tích luỹ, bảo hiểm y tế nộp bù theo quy định"]},{"tag":"a","props":{"href":"/vi/tip/07-19"},"children":[{"tag":"span","props":{},"children":["19"]},"Từng vào tù, từng phá sản, từng bị đưa vào danh sách không thi hành án, pháp luật vẫn còn đường bắt đầu lại, trước hết làm hết thủ tục"]},{"tag":"a","props":{"href":"/vi/tip/07-20"},"children":[{"tag":"span","props":{},"children":["20"]},"Trước khi mắc bệnh nặng, ngoài bảo hiểm y tế cơ bản thì mua một bảo hiểm y tế hoặc bảo hiểm bệnh hiểm nặng hạn một năm, và đọc kỹ bốn chữ「保证续保」"]},{"tag":"a","props":{"href":"/vi/tip/07-21"},"children":[{"tag":"span","props":{},"children":["21"]},"Thật sự không có chỗ ngủ, nơi mở cửa 24 giờ chỉ cứu vãn được một đêm, ưu tiên đến trạm cứu hộ"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/vi/tip/07-22","data-status":"active"},"children":[{"tag":"span","props":{},"children":["22"]},"Bị nợ lương công nhân, trước hết phân biệt ai là người thuê bạn"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"Breadcrumbs"},"children":[{"tag":"a","props":{"href":"/vi/book"},"children":["Khám phá cuốn sách"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/vi/book/07"},"children":["Chương 7"," ·"," ","Sống thế nào khi hết tiền"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"07-22"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["22"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["Bằng chứng"," ","A"]}]},{"tag":"h1","props":{"lang":"vi"},"children":["Bị nợ lương công nhân, trước hết phân biệt ai là người thuê bạn"]},{"tag":"p","props":{"lang":"vi","className":"life-entry-summary"},"children":["Xưởng, cửa hàng chưa đăng ký kinh doanh mà nợ lương thì vẫn khiếu nại giám sát lao động, xin hoà giải lao động được, chủ xưởng bản thân cũng có thể bị truy đuổi. Công trường mà đối tác thầu nhận thầu lại, nợ tiền thì tổng thầu hoặc chủ đầu tư trả. Chỉ làm việc riêng cho gia đình hoặc cá nhân, ví dụ làm giúp việc nhà, thì không phải tranh chấp lao động, phải ra tòa khởi kiện."]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Chi phí"]},{"tag":"p","props":{},"children":["Không tốn tiền. Trước hết làm rõ ba việc: đối phương có đa…"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Lợi ích"]},{"tag":"p","props":{},"children":["Điều 2 của Luật hợp đồng lao động giới hạn đơn vị sử dụng lao động ở doanh nghiệp, tổ chức kinh tế cá thể, đơn…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"Đánh dấu: Bị nợ lương công nhân, trước hết phân biệt ai là người thuê bạn"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"Hoàn tất"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"Kế hoạch thực hiện"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"Lưu"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Chia sẻ mẹo này"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Ẩn chi tiết"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Chi phí"]},{"tag":"p","props":{},"children":["Không tốn tiền. Trước hết làm rõ ba việc: đối phương có đang mở cửa hàng, đặt nhà máy, làm ăn không; công việc có được giao thầu lại từ công ty hoặc công trường không; bạn có làm việc trong nhà người ta không. Đối phương có giấy phép hay không, tra trên Hệ thống công khai thông tin tín dụng doanh nghiệp quốc gia."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Lợi ích"]},{"tag":"p","props":{},"children":["Điều 2 của Luật hợp đồng lao động giới hạn đơn vị sử dụng lao động ở doanh nghiệp, tổ chức kinh tế cá thể, đơn vị phi lợi nhuệ dân sự tư nhân và các tổ chức khác, người tự nhiên không thuộc diện. Giải thích tư pháp của Tòa án nhân dân tối cao về tranh chấp lao động liệt kê vài loại tranh chấp không phải tranh chấp lao động. Một là tranh chấp giữa gia đình hoặc cá nhân với người làm giúp việc nhà. Hai là tranh chấp giữa thợ cá thể với người làm thuê, người học nghề. Ba là tranh chấp giữa hộ kinh doanh nông thôn với người lao động. Mấy loại này phải ra tòa kiện như tranh chấp dân sự thông thường, thời hiệu khởi kiện 3 năm. Đơn vị sử dụng lao động không có giấy phép kinh doanh không nằm trong ngoại lệ đó. Điều 93 của Luật hợp đồng lao động quy định, đơn vị sử dụng lao động không đủ tư cách kinh doanh hợp pháp mà người lao động đã làm việc, đơn vị đó hoặc nhà đầu tư của họ phải trả tiền lương, bồi thường thường hưu và bồi thường tổn thất. Điều 29 của bản giải thích đó quy định, khi người lao động có tranh chấp với đơn vị sử dụng lao động chưa đăng ký kinh doanh, giấy phép bị thu hồi, hoặc hết hạn hoạt động mà vẫn tiếp tục kinh doanh, thì phải đưa đơn vị sử dụng lao động hoặc nhà đầu tư của họ vào vị thế bị đơn. Điều 33 của Quy định giám sát bảo hiểm lao động quy định, với đơn vị không có giấy phép kinh doanh hoặc đã bị thu hồi giấy phép theo quy định mà vẫn có hành vi sử dụng lao động, thì cơ quan giám sát bảo hiểm lao động tiến hành giám sát. Người cá thể nhận thầu mà tuyển dụng lao động trái pháp luật, gây thiệt hại cho người lao động, thì tổ chức giao thầu và người nhận thầu cá thể chịu trách nhiệm liên đới về bồi thường (Điều 94 của Luật hợp đồng lao động). Chủ đầu tư hoặc tổng thầu gói thầu, chia thầu cho cá nhân hoặc đơn vị không đủ tư cách kinh doanh hợp pháp, dẫn tới nợ lương công nhân lao động di cư, thì chủ đầu tư hoặc tổng thầu trả (Điều 36 của Quy định bảo đảm thanh toán tiền lương công nhân lao động di cư) (toàn quốc)"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Nguồn gốc"]},{"tag":"p","props":{"className":"life-citations"},"children":["全国人大常委会 (2012 修正). 劳动合同法（第二、九十三、九十四条）. ",{"tag":"a","props":{"href":"https://fgk.chinatax.gov.cn/zcfgk/c100009/c5193025/content.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://fgk.chinatax.gov.cn/zcfgk/c100009/c5193025/content.html"]},"（国家税务总局政策法规库转载）；最高人民法院 (2020). 关于审理劳动争议案件适用法律问题的解释（一）（法释〔2020〕26 号，第二、二十九条）. ",{"tag":"a","props":{"href":"https://www.court.gov.cn/fabu/xiangqing/282121.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.court.gov.cn/fabu/xiangqing/282121.html"]},"；国务院 (2004). 劳动保障监察条例（国务院令第 423 号，第三十三条）. ",{"tag":"a","props":{"href":"https://www.gov.cn/gongbao/content/2004/content_63042.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/gongbao/content/2004/content_63042.htm"]},"；国务院 (2019). 保障农民工工资支付条例（国务院令第 724 号，第三十六条）. ",{"tag":"a","props":{"href":"https://www.gov.cn/gongbao/content/2020/content_5469641.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/gongbao/content/2020/content_5469641.htm"]},"；全国人大 (2020). 民法典（第一百八十八条）. ",{"tag":"a","props":{"href":"https://www.spp.gov.cn/spp/fl/202006/t20200602_463888.shtml","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.spp.gov.cn/spp/fl/202006/t20200602_463888.shtml"]},"；国务院 (2006). 诉讼费用交纳办法（国务院令第 481 号，第六、二十九条）. ",{"tag":"a","props":{"href":"https://www.gov.cn/ziliao/flfg/2006-12/29/content_483682.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/ziliao/flfg/2006-12/29/content_483682.htm"]},"；全国人大常委会 (2023 修正). 民事诉讼法（第一百五十二、二百二十五条）. ",{"tag":"a","props":{"href":"https://amr.guizhou.gov.cn/zwgk/xxgkml/jcxxgk/zcfg/fl/202401/t20240129_83645867.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://amr.guizhou.gov.cn/zwgk/xxgkml/jcxxgk/zcfg/fl/202401/t20240129_83645867.html"]},"（贵州省市场监管局转载）"]},{"tag":"a","props":{"href":"https://fgk.chinatax.gov.cn/zcfgk/c100009/c5193025/content.html","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Liên kết mở nguồn"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Ghi chú sách"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["Hãy phân biệt theo thứ tự này. Xem trước công việc có được giao lại từ công ty hay công trường không, có thì tìm công ty giao thầu hoặc tổng thầu. Quy định tài khoản lương riêng trên công trường và tổng thầu phải trả trước, xem mục 2 của phần này (bị nợ lương thì khiếu nại giám sát lao động trước). Xem tiếp đối phương có đang làm ăn không: mở cửa hàng, đặt nhà máy, mở xưởng, có giấy phép hay không thì đều đi theo giám sát và hoà giải, khi hoà giải thì đưa cả chủ xưởng vào danh sách bị đơn. Phần còn lại là làm việc riêng cho gia đình hoặc cá nhân thì mới ra tòa. Ra tòa phải tự khởi kiện, tự đưa chứng cứ, xét sơ thẩm theo thủ tục thông thường mất từ 6 tháng trở lên. Phí luật sư không nằm trong khoản phí tố tụng mà tòa buộc bên thua trả, thuê luật sư phải tự bỏ tiền, không đủ thì xin trợ giúp pháp lý, xem mục 3 của phần này (trợ giúp pháp lý). Trong tay có giấy nợ thì có thể xin lệnh thanh toán trước, số tiền nhỏ thì đi theo thủ tục tố tụng giá trị thấp, xem mục 22 ở phần 8 (bị lừa trong giao dịch cũ, tố tụng giá trị thấp). Thời hiệu khởi kiện 3 năm, xem mục 19 ở phần 8 (bảo vệ quyền lợi có thời hạn). Đi đường nào cũng không bảo đảm tiền về tay, đối phương không có tài sản thì thắng kiện cũng không được tiền."]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Ghi chú của tôi"]},{"tag":"button","props":{"type":"button"},"children":["Viết một lời nhắc cho chính bạn…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/vi/tip/07-21"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Trước"]},"Thật sự không có chỗ ngủ, nơi mở cửa 24 giờ chỉ cứu vãn được một đêm, ưu tiên đến trạm cứu hộ"]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["Thêm trong chủ đề này"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/07-15"},"children":[{"tag":"strong","props":{},"children":["Không nộp tiền cọc, không giữ giấy tờ, không ký「培训贷」, không vào đa cấp, không vay lãi cao"]},{"tag":"span","props":{},"children":["Đơn vị sử dụng lao động không được giữ thẻ căn cước của bạn, không đư…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/07-16"},"children":[{"tag":"strong","props":{},"children":["Khó ở nhà thì xếp hàng chờ nhà ở công lập trước"]},{"tag":"span","props":{},"children":["Phải đồng thời thoả ba điều kiện: ở địa phương không có nhà, hoặc diệ…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/07-17"},"children":[{"tag":"strong","props":{},"children":["Ép chi phí ở và ăn xuống mức thấp nhất: thuê chung theo tháng thay vì thuê theo ngày, tự nấu ăn và bếp ăn trợ giúp thay cho đồ ăn giao"]},{"tag":"span","props":{},"children":["Trong chi tiêu bình quân đầu người cả nước năm 2025, ăn chiếm 29.3%, …"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/07-18"},"children":[{"tag":"strong","props":{},"children":["Bảo hiểm xã hội đứt quãng thì đừng hoảng: lương hưu tính theo số năm tích luỹ, bảo hiểm y tế nộp bù theo quy định"]},{"tag":"span","props":{},"children":["Lương hưu tính theo số năm tích luỹ, không tính theo số năm liên tục,…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/07-19"},"children":[{"tag":"strong","props":{},"children":["Từng vào tù, từng phá sản, từng bị đưa vào danh sách không thi hành án, pháp luật vẫn còn đường bắt đầu lại, trước hết làm hết thủ tục"]},{"tag":"span","props":{},"children":["Người vừa hết án tù không bị phân biệt đối xử về việc làm, học tập, b…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/07-20"},"children":[{"tag":"strong","props":{},"children":["Trước khi mắc bệnh nặng, ngoài bảo hiểm y tế cơ bản thì mua một bảo hiểm y tế hoặc bảo hiểm bệnh hiểm nặng hạn một năm, và đọc kỹ bốn chữ「保证续保」"]},{"tag":"span","props":{},"children":["Loại bảo hiểm này bù đúng phần bạn phải tự bỏ sau khi bảo hiểm y tế h…"]}]}]}]},{"tag":"a","props":{"className":"life-text-link","href":"/vi/book/07"},"children":["Đọc toàn bộ chủ đề: Sống thế nào khi hết tiền"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"15","height":"15","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]}]}]},{"tag":"nav","props":{"className":"life-tabbar","aria-label":"Điều hướng chính"},"children":[{"tag":"a","props":{"className":"","href":"/vi/book"},"children":[{"tag":"svg","props":{"xmlns"