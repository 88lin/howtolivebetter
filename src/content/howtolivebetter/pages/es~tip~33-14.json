:"18","height":"18","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-up-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M7 7h10v10"},"children":[]},{"tag":"path","props":{"d":"M7 17 17 7"},"children":[]}]}]}]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/es/book/33"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"Volver al índice"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["Cómo vivir después de una discapacidad"]},{"tag":"div","props":{"data-ad-dock-host":"true"},"children":[]},{"tag":"nav","props":{"aria-label":"Consejos del capítulo"},"children":[{"tag":"a","props":{"href":"/es/tip/33-01"},"children":[{"tag":"span","props":{},"children":["01"]},"Después de una lesión medular, si aparece un dolor de cabeza intenso y sudoración repentina, primero hay que ayudar a la persona a sentarse erguida, aflojarle la ropa y llamar al 120"]},{"tag":"a","props":{"href":"/es/tip/33-02"},"children":[{"tag":"span","props":{},"children":["02"]},"Los primeros diez años tras la discapacidad son el periodo de mayor riesgo de suicidio; no lo trate como algo que se resuelve «animándose»"]},{"tag":"a","props":{"href":"/es/tip/33-03"},"children":[{"tag":"span","props":{},"children":["03"]},"La hospitalización por trastorno mental se rige por el principio de voluntariedad; solo hay dos supuestos en los que se puede ingresar sin el consentimiento de la persona"]},{"tag":"a","props":{"href":"/es/tip/33-04"},"children":[{"tag":"span","props":{},"children":["04"]},"Quien cuida a largo plazo de la persona con discapacidad de la casa también necesita que alguien vigile su propio cuerpo"]},{"tag":"a","props":{"href":"/es/tip/33-05"},"children":[{"tag":"span","props":{},"children":["05"]},"Para quien pasa muchas horas en silla de ruedas: cambie el cojín por uno de descarga de presión y revise a diario la zona del isquion y el coxis"]},{"tag":"a","props":{"href":"/es/tip/33-06"},"children":[{"tag":"span","props":{},"children":["06"]},"No compre terapias ni aparatos que prometan «curar la parálisis, la ceguera o la sordera»"]},{"tag":"a","props":{"href":"/es/tip/33-07"},"children":[{"tag":"span","props":{},"children":["07"]},"Una vez obtenido el certificado de discapacidad, pregunte de una sola vez en la federación de personas con discapacidad del condado todo lo que se puede solicitar"]},{"tag":"a","props":{"href":"/es/tip/33-08"},"children":[{"tag":"span","props":{},"children":["08"]},"Si el niño tiene menos de 7 años y además una discapacidad o autismo, solicite en la federación de personas con discapacidad del condado la ayuda a la rehabilitación"]},{"tag":"a","props":{"href":"/es/tip/33-09"},"children":[{"tag":"span","props":{},"children":["09"]},"Las rampas, los pasamanos y la reforma del baño de la casa pueden optar a una subvención del gobierno de nivel de condado o superior"]},{"tag":"a","props":{"href":"/es/tip/33-10"},"children":[{"tag":"span","props":{},"children":["10"]},"Al buscar empleo en China, indique que tiene certificado de discapacidad: contratarle puede reducir un pago obligatorio de la empresa"]},{"tag":"a","props":{"href":"/es/tip/33-11"},"children":[{"tag":"span","props":{},"children":["11"]},"El impuesto sobre la renta de las personas físicas de una persona con discapacidad puede reducirse; cuánto, pregúntelo por teléfono a la administración tributaria provincial"]},{"tag":"a","props":{"href":"/es/tip/33-12"},"children":[{"tag":"span","props":{},"children":["12"]},"Los perros guía pueden entrar en lugares públicos y transporte público; las personas ciegas viajan gratis en el transporte urbano"]},{"tag":"a","props":{"href":"/es/tip/33-13"},"children":[{"tag":"span","props":{},"children":["13"]},"En la prueba nacional de acceso a la universidad, las personas con discapacidad pueden solicitar ajustes razonables; con examen en braille el tiempo se amplía la mitad"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/es/tip/33-14","data-status":"active"},"children":[{"tag":"span","props":{},"children":["14"]},"Si un niño con discapacidad solicita la matrícula, la escuela no puede rechazarlo; si no puede llegar al centro, la oficina de educación organiza la enseñanza a domicilio"]},{"tag":"a","props":{"href":"/es/tip/33-15"},"children":[{"tag":"span","props":{},"children":["15"]},"Sin la pierna derecha o sin ambas piernas también se puede sacar el permiso de conducir: la clase de vehículo se llama C5"]},{"tag":"a","props":{"href":"/es/tip/33-16"},"children":[{"tag":"span","props":{},"children":["16"]},"La rehabilitación hágase en instituciones serias con servicio de medicina de rehabilitación, con la intensidad que indique el terapeuta: no es cuanto más fuerte mejor"]},{"tag":"a","props":{"href":"/es/tip/33-17"},"children":[{"tag":"span","props":{},"children":["17"]},"Ante la pérdida de audición, colóquese audífonos; la razón de ponerlos es oír, no prevenir la demencia"]},{"tag":"a","props":{"href":"/es/tip/33-18"},"children":[{"tag":"span","props":{},"children":["18"]},"Declarar que un adulto «no puede regirse por sí mismo» exige una solicitud al tribunal; la familia no decide sola"]},{"tag":"a","props":{"href":"/es/tip/33-19"},"children":[{"tag":"span","props":{},"children":["19"]},"El tutor de un adulto se designa por el orden legal; si la persona bajo tutela lesiona a alguien, responde el tutor"]},{"tag":"a","props":{"href":"/es/tip/33-20"},"children":[{"tag":"span","props":{},"children":["20"]},"Si le rechazan por discapacidad en la contratación, no le hacen fijo o le pagan menos, puede demandar, pero primero calcule bien el coste del proceso"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"Ruta de navegación"},"children":[{"tag":"a","props":{"href":"/es/book"},"children":["Libro"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/es/book/33"},"children":["Capítulo 33"," ·"," ","Cómo vivir después de una discapacidad"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"33-14"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["14"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["Evidencia"," ","A"]}]},{"tag":"h1","props":{"lang":"es"},"children":["Si un niño con discapacidad solicita la matrícula, la escuela no puede rechazarlo; si no puede llegar al centro, la oficina de educación organiza la enseñanza a domicilio"]},{"tag":"p","props":{"lang":"es","className":"life-entry-summary"},"children":["El reglamento dice con claridad que las instituciones de educación preescolar y las escuelas de todos los niveles y tipos no pueden negarse a admitir a las personas con discapacidad que reúnan los requisitos al solicitar la matrícula. Lo mismo las escuelas de formación profesional ordinarias. Los niños y adolescentes con discapacidad en edad escolar que necesiten una persona dedicada a su cuidado y no puedan acudir a la escuela reciben de la oficina de educación del condado, que lo organiza en conjunto, enseñanza a domicilio o educación a distancia, y quedan incorporados a la gestión del expediente académico. Cómo se organizan la matrícula y el cambio de escuela lo decide la oficina de educación del condado tras encargar la evaluación al comité de expertos en educación de personas con discapacidad; no lo decide la escuela por su cuenta."]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Coste"]},{"tag":"p","props":{},"children":["No cuesta dinero. Hay que presentar una solicitud y posibl…"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Beneficio"]},{"tag":"p","props":{},"children":["Artículo 7 del Reglamento sobre la educación de personas con discapacidad: «las instituciones de educación pre…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"Marcar: Si un niño con discapacidad solicita la matrícula, la escuela no puede rechazarlo; si no puede llegar al centro, la oficina de educación organiza la enseñanza a domicilio"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"Hecho"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"Por hacer"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"Guardar"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Compartir consejo"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Ocultar detalles"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Coste"]},{"tag":"p","props":{},"children":["No cuesta dinero. Hay que presentar una solicitud y posiblemente pasar una evaluación. Si la escuela se desentiende, hay que acudir más arriba, a la oficina de educación."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Beneficio"]},{"tag":"p","props":{},"children":["Artículo 7 del Reglamento sobre la educación de personas con discapacidad: «las instituciones de educación preescolar, las escuelas de todos los niveles y tipos y demás instituciones educativas deben impartir la educación de personas con discapacidad conforme a este reglamento y a las leyes y reglamentos nacionales pertinentes; ante la solicitud de matrícula de personas con discapacidad que cumplan las condiciones fijadas por las leyes y reglamentos, no pueden negarse a admitirlas». Artículo 29: «las escuelas de formación profesional ordinarias no pueden negarse a admitir a las personas con discapacidad que cumplan las normas de admisión fijadas por el Estado, y los centros de formación profesional ordinarios deben admitirlas de manera activa». El reglamento dispone además que los niños y adolescentes con discapacidad en edad escolar que necesiten una persona dedicada a su cuidado y no puedan acudir a la escuela reciben la enseñanza obligatoria, organizada de forma coordinada por el departamento de educación del gobierno popular del condado, mediante la enseñanza a domicilio o la educación a distancia, entre otras vías, y quedan incorporados a la gestión del expediente académico. El artículo 20 dispone que el departamento de educación del gobierno popular del condado debe, junto con el departamento de salud, el de asuntos civiles y la federación de personas con discapacidad, constituir un comité de expertos en educación de personas con discapacidad formado por especialistas en educación, psicología, rehabilitación y trabajo social; este comité evalúa el estado físico, la capacidad de recibir educación y la capacidad de adaptarse al estudio y la vida escolar, y propone recomendaciones de matrícula o cambio de escuela; el resultado de la evaluación es privacidad del niño, y las unidades y personal relacionados tienen el deber de guardarlo en secreto. El artículo 23 dispone que los estudiantes con discapacidad escolarizados en aulas ordinarias pueden aplicar el plan de currículo, los estándares y los libros de texto de la enseñanza obligatoria ordinaria, pero las exigencias sobre su aprendizaje pueden tener una flexibilidad moderada. El artículo 52 dispone que las personas con discapacidad que participen en exámenes educativos nacionales y necesiten condiciones de apoyo y ajustes razonables pueden presentar la solicitud (en todo el país, en vigor desde el 1 de mayo de 2017)"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Fuentes originales"]},{"tag":"p","props":{"className":"life-citations"},"children":["国务院 (2017). 残疾人教育条例（第七条、第二十条、第二十三条、第二十九条、第五十二条）. ",{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/2017-02/23/content_5170264.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/zhengce/zhengceku/2017-02/23/content_5170264.htm"]}]},{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/2017-02/23/content_5170264.htm","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Abrir fuente"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Nota del autor"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["Que la escuela diga de palabra «aquí no tenemos condiciones» no cuenta. Exija una respuesta por escrito y vaya con ella a la oficina de educación del condado. La evaluación la encarga la oficina de educación al comité de expertos. Aquella frase del artículo 23 de que «las exigencias de aprendizaje pueden tener flexibilidad moderada» es muy útil: cite cuando la escuela quiera expulsar por las notas. Cómo conservar las pruebas si su hijo sufre acoso escolar y qué procedimiento debe seguir la escuela, véase la sección 30, entrada 3 (acoso escolar). Los ajustes razonables del examen de acceso a la universidad, en la entrada 13 de esta sección (ajustes razonables). El beneficiario de esta entrada es su hijo."]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Mi nota"]},{"tag":"button","props":{"type":"button"},"children":["Escribe un recordatorio…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/es/tip/33-13"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":