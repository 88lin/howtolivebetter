strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["成本"]},{"tag":"p","props":{"className":"life-citations"},"children":["几百到一千多元，各地价格不一样。要提前问医院和麻醉科能不能做。难在得自己开口提"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["收益"]},{"tag":"p","props":{"className":"life-citations"},"children":["Cochrane 系统综述的结论是：硬膜外镇痛在减轻产痛、提高产妇对镇痛的满意度上，比不用硬膜外的办法更有效。无痛分娩用的就是硬膜外镇痛。同一篇还说，「硬膜外镇痛对剖宫产风险和长期腰痛没有影响」。器械助产（用器械把孩子接出来）增加的现象，在 2005 年以后的研究中已经看不到。2024 年起，国家医保局的产科类医疗服务价格项目立项指南，把「分娩镇痛」「导乐分娩」「亲情陪产」单独立了项。理由正是原先没有独立的价格项目，医院提供分娩镇痛的积极性被压低"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["来源"]},{"tag":"p","props":{"className":"life-citations"},"children":["Anim-Somuah M, Smyth RMD, Cyna AM, Cuthbert A (2018). Epidural versus non-epidural or no analgesia for pain management in labour. Cochrane Database of Systematic Reviews, (5), CD000331. ",{"tag":"a","props":{"href":"https://doi.org/10.1002/14651858.CD000331.pub4","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1002/14651858.CD000331.pub4"]},"；国家医疗保障局 (2024). 重构产科服务价格项目 助力构建生育友好型社会. ",{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/202406/content_6957553.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/zhengce/202406/content_6957553.htm"]},""]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["原书备注"]},{"tag":"p","props":{"className":"life-citations"},"children":["「打无痛会腰疼一辈子」和「打无痛会难产要挨刀」这两条流传最广的说法都没有依据。Cochrane 把硬膜外镇痛和别的镇痛办法放在一起汇总，结论是它对剖宫产风险和长期腰痛都没有影响。真实的副作用是这些：血压偏低、发热、腿发软、尿不出来，以及第一、第二产程变长、更可能要用缩宫素。做不做自己定，但别因为传言放弃。能不能做还要看医院有没有 24 小时在场的麻醉医生，产检的时候就问清楚"]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["我的备注"]},{"tag":"button","props":{"type":"button"},"children":["写下对自己有用的提醒…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/tip/27-08"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["上一条"]},"破水了就地平躺、垫高臀部、打 120，不要走动也不要洗澡"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/tip/27-10"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["下一条"]},"没有医学指征就别主动要求剖宫产，也别为了挑日子开刀"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["本主题的其他建议"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/27-05"},"children":[{"tag":"strong","props":{},"children":["有子痫前期高危因素的，孕 12 周后开始每天一片小剂量阿司匹林"]},{"tag":"span","props":{},"children":["子痫前期是孕期的一种高血压病。上一胎得过、怀多胎、有慢性高血压、孕前有糖尿病、有肾病或自身免疫病的人算高危。高危的人从孕 12 周起每天一片小剂量阿司匹林，子痫…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/27-06"},"children":[{"tag":"strong","props":{},"children":["孕 24 周及以后做一次妊娠期糖尿病筛查，别嫌喝糖水麻烦"]},{"tag":"span","props":{},"children":["妊娠期糖尿病就是怀孕之后才出现的血糖高。孕 24 周以后花半个上午，喝一次糖水、抽几次血，就能查出来。不查也不管，胎儿长得过大、难产、挨一刀、子痫前期和新生儿低…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/27-07"},"children":[{"tag":"strong","props":{},"children":["背下这张「立刻去医院」的清单，孕期和产后一年内都算数"]},{"tag":"span","props":{},"children":["任何一条出现，当天就去医院，别在家等一晚。头痛不好或越来越重、看东西变样、发烧到 38 ℃。手或脸肿得厉害、喘不上气、胸痛或心跳快。肚子剧痛不缓解、胎动停了或明…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/27-11"},"children":[{"tag":"strong","props":{},"children":["怀孕前就确认生育保险的参保状态，未就业的配偶也能报生育医疗费用"]},{"tag":"span","props":{},"children":["单位交了生育保险，生孩子的医疗费和产假期间的津贴都从这笔基金里出。配偶没工作的，医疗费这一块也能报。参保月数够不够、在外地生要不要先备案，都得提前问，事后补不了…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/27-12"},"children":[{"tag":"strong","props":{},"children":["出院前把《出生医学证明》办掉，名字提前想好、别写错字"]},{"tag":"span","props":{},"children":["这张证是上户口、参保、上学的前置件，而且只有接生的那家机构能第一次开。出了院再回头补，要另走一套流程、多交材料。名字里的字，先确认户籍系统打得出来。"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/27-13"},"children":[{"tag":"strong","props":{},"children":["新生儿足跟血筛查和听力筛查都别拒绝"]},{"tag":"span","props":{},"children":["扎一次足跟血、做一次听力测试，能在孩子看起来完全正常的时候，查出甲减、苯丙酮尿症和听力障碍。等症状显出来，智力上的损害已经补不回来了。"]}]}]}]},{"tag":"a","props":{"className":"life-text-link","href":"/book/27"},"children":["阅读整个主题：怀孕和生产：从发现怀孕到出院办证 ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"15","height":"15","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]}]}]},{"tag":"nav","props":{"className":"life-tabbar","aria-label":"主导航"},"children":[{"tag":"a","props":{"cl