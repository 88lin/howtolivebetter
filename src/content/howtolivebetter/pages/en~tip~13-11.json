idth":"18","height":"18","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-up-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M7 7h10v10"},"children":[]},{"tag":"path","props":{"d":"M7 17 17 7"},"children":[]}]}]}]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/en/book/13"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"Back to index"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["Emergency situations: what to do first"]},{"tag":"div","props":{"data-ad-dock-host":"true"},"children":[]},{"tag":"nav","props":{"aria-label":"Chapter entries"},"children":[{"tag":"a","props":{"href":"/en/tip/13-01"},"children":[{"tag":"span","props":{},"children":["01"]},"Immediate chest compressions can save lives when someone collapses and stops breathing — call 120 and fetch an AED too"]},{"tag":"a","props":{"href":"/en/tip/13-02"},"children":[{"tag":"span","props":{},"children":["02"]},"If an older person falls or someone collapses, crouch down, call to them and dial 120 before lifting them; walking away from a stranger is also legal in China, but if you stop, do not move them"]},{"tag":"a","props":{"href":"/en/tip/13-03"},"children":[{"tag":"span","props":{},"children":["03"]},"Sudden facial drooping, weakness in one arm, and slurred speech — call 120 immediately; don’t wait or drive yourself"]},{"tag":"a","props":{"href":"/en/tip/13-04"},"children":[{"tag":"span","props":{},"children":["04"]},"Sudden dizziness, double vision, loss of vision in one eye, or inability to touch one’s nose — all warrant calling 120 for stroke suspicion"]},{"tag":"a","props":{"href":"/en/tip/13-05"},"children":[{"tag":"span","props":{},"children":["05"]},"One eye suddenly goes dark, as if a curtain has been pulled shut; even if it clears up within minutes, seek emergency care for stroke on the same day"]},{"tag":"a","props":{"href":"/en/tip/13-06"},"children":[{"tag":"span","props":{},"children":["06"]},"One eye is swollen, painful, red; there’s a rainbow halo around lights; plus headache, nausea, and vomiting — so an emergency eye visit is needed that same day"]},{"tag":"a","props":{"href":"/en/tip/13-07"},"children":[{"tag":"span","props":{},"children":["07"]},"Chest pressure, tightness, or heaviness lasting more than 15 minutes without relief — call 120; do not drive yourself"]},{"tag":"a","props":{"href":"/en/tip/13-08"},"children":[{"tag":"span","props":{},"children":["08"]},"Sudden tearing pain that spreads from the chest to the back and waist — call 120 and describe it as “pain moving downward”"]},{"tag":"a","props":{"href":"/en/tip/13-09"},"children":[{"tag":"span","props":{},"children":["09"]},"A sudden “worst headache of one’s life” that peaks within an hour — go to the ER for a head CT right away"]},{"tag":"a","props":{"href":"/en/tip/13-10"},"children":[{"tag":"span","props":{},"children":["10"]},"After an elderly person suffers a head injury, they may develop unsteady gait, sluggishness, excessive sleepiness, or weakness on one side of the body two to three weeks later — a CT scan is recommended"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/en/tip/13-11","data-status":"active"},"children":[{"tag":"span","props":{},"children":["11"]},"A leg suddenly swells, feels tight, and is tender to the touch — seek medical care promptly; if shortness of breath or chest pain develops suddenly, call 120 immediately"]},{"tag":"a","props":{"href":"/en/tip/13-12"},"children":[{"tag":"span","props":{},"children":["12"]},"For severe bleeding, first press firmly on the wound with your hand; if this fails on limbs, apply a tourniquet and call 120 immediately"]},{"tag":"a","props":{"href":"/en/tip/13-13"},"children":[{"tag":"span","props":{},"children":["13"]},"For dog or cat bites and scratches, rinse the area with soap and running water for 15 minutes, then get vaccinated on the same day"]},{"tag":"a","props":{"href":"/en/tip/13-14"},"children":[{"tag":"span","props":{},"children":["14"]},"Immediately rinse a burn with cool running water for 20 minutes; avoid applying toothpaste or soy sauce"]},{"tag":"a","props":{"href":"/en/tip/13-15"},"children":[{"tag":"span","props":{},"children":["15"]},"Sudden widespread rash, difficulty breathing, or dizziness — treat as anaphylactic shock; call 120 immediately and explain the situation clearly"]},{"tag":"a","props":{"href":"/en/tip/13-16"},"children":[{"tag":"span","props":{},"children":["16"]},"Someone is having a seizure — clear the area, place them on their side, time the episode, and don’t put anything in their mouth"]},{"tag":"a","props":{"href":"/en/tip/13-17"},"children":[{"tag":"span","props":{},"children":["17"]},"Diabetic patients suddenly start shaking, break out in cold sweats, and have slurred speech — first give 15 grams of sugar, then retest after 15 minutes"]},{"tag":"a","props":{"href":"/en/tip/13-18"},"children":[{"tag":"span","props":{},"children":["18"]},"If someone is electrocuted, cut the power first, then use a dry wooden stick to pry the source of electricity away; never pull the victim by hand directly"]},{"tag":"a","props":{"href":"/en/tip/13-19"},"children":[{"tag":"span","props":{},"children":["19"]},"If a carbon monoxide alarm goes off, or if several people in a room suddenly get headaches, nausea, or dizziness, get everyone outside before calling for help"]},{"tag":"a","props":{"href":"/en/tip/13-20"},"children":[{"tag":"span","props":{},"children":["20"]},"If someone accidentally ingests detergent, pesticides, or medicine, do not induce vomiting — take the container and seek medical help right away; if it splashes into the eyes or onto the skin, rinse thoroughly with water for at least 15 minutes"]},{"tag":"a","props":{"href":"/en/tip/13-21"},"children":[{"tag":"span","props":{},"children":["21"]},"In case of splashes of acids, alkalis or other chemicals on the body, immediately remove contaminated clothing and rinse with copious amounts of running water; for eyes, gently pull the eyelids apart and rinse thoroughly before leaving the scene"]},{"tag":"a","props":{"href":"/en/tip/13-22"},"children":[{"tag":"span","props":{},"children":["22"]},"Dizziness, nausea, lack of sweating or confusion in high heat — move to shade immediately, remove clothing and apply cool water to cool down; do not give water to anyone who is unconscious, call 120 right away"]},{"tag":"a","props":{"href":"/en/tip/13-23"},"children":[{"tag":"span","props":{},"children":["23"]},"For people suffering from heatstroke, as long as they remain conscious, they should drink small amounts of cool, lightly salted water or sports drinks at frequent intervals — never gulp down large quantities. Alcohol and sugary drinks must be avoided"]},{"tag":"a","props":{"href":"/en/tip/13-24"},"children":[{"tag":"span","props":{},"children":["24"]},"Stay low to the ground during a fire, test doors before opening them, and never use elevators — once outside, don’t look back"]},{"tag":"a","props":{"href":"/en/tip/13-25"},"children":[{"tag":"span","props":{},"children":["25"]},"Upon seeing someone drowning, shout for help and call 110/120, then reach out a pole or floating objects — never enter the water yourself"]},{"tag":"a","props":{"href":"/en/tip/13-26"},"children":[{"tag":"span","props":{},"children":["26"]},"If someone is choking and can’t speak, stand behind them (age 1 and over) and perform 5 back blows followed by 5 abdominal thrusts; if they collapse, start CPR immediately"]},{"tag":"a","props":{"href":"/en/tip/13-27"},"children":[{"tag":"span","props":{},"children":["27"]},"If lost or stranded in the Gobi Desert, a desert, or any remote area, stay put next to your vehicle. First, transmit your location, then shield yourself from the sun and retain body heat, conserve water, and avoid wandering off"]},{"tag":"a","props":{"href":"/en/tip/13-28"},"children":[{"tag":"span","props":{},"children":["28"]},"Shivering, slurred speech, and unsteady walking are signs of hypothermia; change into dry clothes, wrap up, warm the torso first, and give sweet hot drinks instead of alcohol"]},{"tag":"a","props":{"href":"/en/tip/13-29"},"children":[{"tag":"span","props":{},"children":["29"]},"After a snake bite, stay still, remove rings and watches, and rush to a hospital offering antivenom — no cutting, no suction, no tight binding"]},{"tag":"a","props":{"href":"/en/tip/13-30"},"children":[{"tag":"span","props":{},"children":["30"]},"First, figure out what kind of building you’re in during an earthquake: if it meets seismic safety standards, stay right where you are; if it’s an old structure prone to collapse, head outside right away"]},{"tag":"a","props":{"href":"/en/tip/13-31"},"children":[{"tag":"span","props":{},"children":["31"]},"If you encounter a bear, wild boar or a pack of stray dogs, do not run; move away slowly, sideways"]},{"tag":"a","props":{"href":"/en/tip/13-32"},"children":[{"tag":"span","props":{},"children":["32"]},"If caught in a thunderstorm outdoors, get into a hard-topped vehicle or building; avoid ridges, lone trees, water surfaces, and metal objects"]},{"tag":"a","props":{"href":"/en/tip/13-33"},"children":[{"tag":"span","props":{},"children":["33"]},"Gradually increase your sleeping altitude when heading to high elevations; if symptoms worsen, descend immediately — don’t tough it out"]},{"tag":"a","props":{"href":"/en/tip/13-34"},"children":[{"tag":"span","props":{},"children":["34"]},"To remove a tick, use fine-point tweezers to pull it straight out along the skin — don’t apply oil, don’t use heat"]},{"tag":"a","props":{"href":"/en/tip/13-35"},"children":[{"tag":"span","props":{},"children":["35"]},"Always boil any water taken from the wild before drinking it; one minute of boiling is sufficient — there’s no need to extend the time just because you’re at high altitude"]},{"tag":"a","props":{"href":"/en/tip/13-36"},"children":[{"tag":"span","props":{},"children":["36"]},"If a stranger demands money in a remote area, hand over cash, avoid any confrontation, note their features, and call police after escaping"]},{"tag":"a","props":{"href":"/en/tip/13-37"},"children":[{"tag":"span","props":{},"children":["37"]},"If you stumble upon a group fight, walk away immediately — don’t try to break it up, don’t stand around watching, and don’t pick up any weapons on the ground. If you want to call the police, retreat to a safe distance and dial 110"]},{"tag":"a","props":{"href":"/en/tip/13-38"},"children":[{"tag":"span","props":{},"children":["38"]},"If you may have been exposed to HIV, get PEP within 72 hours — the sooner, the better"]},{"tag":"a","props":{"href":"/en/tip/13-39"},"children":[{"tag":"span","props":{},"children":["39"]},"After saving someone and getting injured or incurring expenses, first seek compensation from the perpetrator and yibao; then apply for recognition as a person acting in the public interest"]},{"tag":"a","props":{"href":"/en/tip/13-40"},"children":[{"tag":"span","props":{},"children":["40"]},"Knives, rebar, glass piercing the body – apply pressure around the foreign object to stop bleeding; do not pull it out"]},{"tag":"a","props":{"href":"/en/tip/13-41"},"children":[{"tag":"span","props":{},"children":["41"]},"If you suspect a fracture, keep the injured part still and supported, apply cold for no more than 20 minutes, and do not realign it yourself"]},{"tag":"a","props":{"href":"/en/tip/13-42"},"children":[{"tag":"span","props":{},"children":["42"]},"After being sexually assaulted, first go to a safe place to call 110; before forensic examination, do not bathe, do not wash clothes, and do not clean your room; go to the hospital within 72 hours"]},{"tag":"a","props":{"href":"/en/tip/13-43"},"children":[{"tag":"span","props":{},"children":["43"]},"When a baby under 1 year is choking and cannot cry out, alternate 5 back blows (face-down) and 5 chest thrusts — never press the belly"]},{"tag":"a","props":{"href":"/en/tip/13-44"},"children":[{"tag":"span","props":{},"children":["44"]},"If a baby under 1 is unresponsive and not breathing normally, call 120 on speakerphone and perform infant CPR: 30 compressions, then 2 breaths"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"Breadcrumb"},"children":[{"tag":"a","props":{"href":"/en/book"},"children":["Explore the book"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/en/book/13"},"children":["Chapter 13"," ·"," ","Emergency situations: what to do first"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"13-11"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["11"]},{"tag":"span","props":{"className":"life-evidence grade-b"},"children":["Evidence"," ","B"]}]},{"tag":"h1","props":{"lang":"en"},"children":["A leg suddenly swells, feels tight, and is tender to the touch — seek medical care promptly; if shortness of breath or chest pain develops suddenly, call 120 immediately"]},{"tag":"p","props":{"lang":"en","className":"life-entry-summary"},"children":["If one leg suddenly swells, becomes noticeably thicker than the other, and is painful to press, get a leg vein ultrasound done as soon as possible. Should shortness of breath, chest pain when taking a deep breath, a rapid heartbeat, or dizziness appear, a blood clot may have traveled to the lungs — call 120 right away. Among people diagnosed with pulmonary embolism, 17.4% die within three months. Sitting still for more than four hours roughly doubles the risk, though the actual chance for any one person remains very low."]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Cost"]},{"tag":"p","props":{},"children":["An ultrasound of the leg veins (lower extremity venous ult…"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Benefit"]},{"tag":"p","props":{},"children":["The International Cooperative Registry on Pulmonary Embolism (ICOPER) gathered data from 2,454 patients with c…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"Mark: A leg suddenly swells, feels tight, and is tender to the touch — seek medical care promptly; if shortness of breath or chest pain develops suddenly, call 120 immediately"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"Done"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"ta