ren":[{"tag":"span","props":{},"children":["09"]},"不要为了「更健康」花溢价买有机食品"]},{"tag":"a","props":{"href":"/tip/06-10","className":""},"children":[{"tag":"span","props":{},"children":["10"]},"不要花大钱买保健品、膏方、滋补品来「调理身体」"]},{"tag":"a","props":{"href":"/tip/06-11","className":""},"children":[{"tag":"span","props":{},"children":["11"]},"不要在没有肠道问题时长期吃益生菌"]},{"tag":"a","props":{"href":"/tip/06-12","className":""},"children":[{"tag":"span","props":{},"children":["12"]},"不要为了「增强免疫力」逼自己洗冷水澡"]},{"tag":"a","props":{"href":"/tip/06-13","className":""},"children":[{"tag":"span","props":{},"children":["13"]},"不要买排毒、清肠、酵素、碱性水这类产品"]},{"tag":"a","props":{"href":"/tip/06-14","className":""},"children":[{"tag":"span","props":{},"children":["14"]},"不要为了凑够「每天 8 杯水」强迫自己喝水"]},{"tag":"a","props":{"href":"/tip/06-15","className":""},"children":[{"tag":"span","props":{},"children":["15"]},"不要花钱算命、看塔罗、看星座来做决定"]},{"tag":"a","props":{"href":"/tip/06-16","className":""},"children":[{"tag":"span","props":{},"children":["16"]},"不要买防蓝光眼镜来「保护视力」，也不要相信「对着屏幕干几个月眼睛就废了」，但眼睛胀痛发红要当急症"]},{"tag":"a","props":{"href":"/tip/06-17","className":"active"},"children":[{"tag":"span","props":{},"children":["17"]},"不要把献血当保健：「排毒、降血脂、防心梗」没有随机试验支持，频繁献倒是真会缺铁"]},{"tag":"a","props":{"href":"/tip/06-18","className":""},"children":[{"tag":"span","props":{},"children":["18"]},"不要靠通用体检套餐防病，按年龄性别做那几项有证据的筛查"]},{"tag":"a","props":{"href":"/tip/06-19","className":""},"children":[{"tag":"span","props":{},"children":["19"]},"不要因为体检查出尿酸高、但从没痛过，就开始吃降尿酸药"]},{"tag":"a","props":{"href":"/tip/06-20","className":""},"children":[{"tag":"span","props":{},"children":["20"]},"不要因为体检查出胆囊结石、但从没疼过，就去预防性切胆囊"]},{"tag":"a","props":{"href":"/tip/06-21","className":""},"children":[{"tag":"span","props":{},"children":["21"]},"不要为了防肾结石把钙戒掉"]},{"tag":"a","props":{"href":"/tip/06-22","className":""},"children":[{"tag":"span","props":{},"children":["22"]},"不要为了「转运」「招财」「养人」买水晶、手串、貔貅这类物件"]},{"tag":"a","props":{"href":"/tip/06-23","className":""},"children":[{"tag":"span","props":{},"children":["23"]},"不要指望买东西改善心情或身份感"]},{"tag":"a","props":{"href":"/tip/06-24","className":""},"children":[{"tag":"span","props":{},"children":["24"]},"不要为了「在周围人里往上挪一档」多花钱换房、换车、换圈子"]},{"tag":"a","props":{"href":"/tip/06-25","className":""},"children":[{"tag":"span","props":{},"children":["25"]},"不要相信「意志力像肌肉，用一会儿就没了」"]},{"tag":"a","props":{"href":"/tip/06-26","className":""},"children":[{"tag":"span","props":{},"children":["26"]},"不要指望吃早餐或 16:8 轻断食帮你控制体重，吃饭时间挑你能长期坚持的"]},{"tag":"a","props":{"href":"/tip/06-27","className":""},"children":[{"tag":"span","props":{},"children":["27"]},"不要相信「手淫伤身」「戒色才能变好」，真正要看的是有没有耽误睡觉、工作和关系"]},{"tag":"a","props":{"href":"/tip/06-28","className":""},"children":[{"tag":"span","props":{},"children":["28"]},"不要花钱做「性取向矫正」「同性恋治疗」，也不要把家里人送去"]},{"tag":"a","props":{"href":"/tip/06-29","className":""},"children":[{"tag":"span","props":{},"children":["29"]},"不要指望学会「正确搬运姿势」、上搬运培训就能防腰痛，要减的是搬的重量和次数，平时多锻炼"]},{"tag":"a","props":{"href":"/tip/06-30","className":""},"children":[{"tag":"span","props":{},"children":["30"]},"不要指望骨折之后猛补钙、喝骨头汤能让骨头长得更快"]},{"tag":"a","props":{"href":"/tip/06-31","className":""},"children":[{"tag":"span","props":{},"children":["31"]},"不要指望靠 AI 聊天机器人自己判断病情和法律问题，看病、打官司、花大钱之前，把它说的依据找到原文核一遍"]},{"tag":"a","props":{"href":"/tip/06-32","className":""},"children":[{"tag":"span","props":{},"children":["32"]},"不要因为「人随时会死，早点把钱花完才快乐」就不存钱，三十岁的人约九成能活到六十岁"]}]}]},{"tag":"div","props":{"className":"life-tip-page","data-tip-locales":"zh,en,ru,es,ja,vi"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"当前位置"},"children":[{"tag":"a","props":{"href":"/book"},"children":["阅读全书"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/book/06"},"children":["第 6 章 · 反面清单"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"06-17"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["17"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["证据 A"]}]},{"tag":"h1","props":{"lang":"zh"},"children":["不要把献血当保健：「排毒、降血脂、防心梗」没有随机试验支持，频繁献倒是真会缺铁"]},{"tag":"p","props":{"lang":"zh","className":"life-entry-summary"},"children":["说献血能排毒、降血脂、防心梗，靠不住。能一直去献血的人，本来身体就更好，把这层扣掉，每年多献一次血的死亡率降幅从近两成缩到 7.5%。真正把人分开对比的试验里，死亡人数没有差别。反过来，献得太勤确实会让人没力气、怕冷，原因是缺铁。"]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["成本"]},{"tag":"p","props":{},"children":["不花钱。一次献血，填表、采血加上留下观察休息，大约要一小时。之后几周，身体一直在把丢掉的铁补回来。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["收益"]},{"tag":"p","props":{},"children":["芬兰 Kuopio 研究跟踪了 2862 名 42 至 60 岁的男性，平均将近 9 年。开始统计之前的 24 个月里献过血的有 153 人，其中 1 人（0.7%）发生了急性心梗。没献过的 2529 人里有 316 人（12.5%）发生（两个比例的差异 P<0.0001）。把年龄和其他冠心病危险因…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"标记：不要把献血当保健：「排毒、降血脂、防心梗」没有随机试验支持，频繁献倒是真会缺铁"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"已做到"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"加入待做"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"收藏"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"分享这条建议"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"收起详情"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["成本"]},{"tag":"p","props":{"className":"life-citations"},"children":["不花钱。一次献血，填表、采血加上留下观察休息，大约要一小时。之后几周，身体一直在把丢掉的铁补回来。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["收益"]},{"tag":"p","props":{"className":"life-citations"},"children":["芬兰 Kuopio 研究跟踪了 2862 名 42 至 60 岁的男性，平均将近 9 年。开始统计之前的 24 个月里献过血的有 153 人，其中 1 人（0.7%）发生了急性心梗。没献过的 2529 人里有 316 人（12.5%）发生（两个比例的差异 P<0.0001）。把年龄和其他冠心病危险因素的影响扣掉之后，献过血的人心梗风险低约 88%。相对风险 0.12（95% CI 0.02–0.86，P=0.035）。但这只是跟踪记录出来的，没有分组对照。北欧 SCANDAT 数据库里有 1,182,495 名献血者，累计跟踪 9,526,627 人年，其中 15,401 人死亡。只扣掉年龄性别这类特征时，每年多献一次血，死亡率低 18.6%（95% CI 16.8%–20.4%）。再把「一直健康才一直被允许献血」这一层也扣掉，降幅只剩 7.5%（5.7%–9.4%）。作者的结论是「不能解释为有益健康的确凿证据」。FeAST 随机分组对照试验找了 1277 名有症状的下肢动脉疾病患者，随机分成两组，一组每 6 个月定期放血减铁，一组做对照。主要看的是全因死亡，125/636（20%）对 148/641（23%）。HR 0.85（HR 是风险比，1 就是两边一个样）。95% CI 0.67–1.08，P=0.17。死亡加上没死的心梗与卒中合起来算，是 180（28%）对 205（32%），HR 0.88（0.72–1.07，P=0.20）。两项都没看出差别。INTERVAL 随机分组试验找了 45,263 名献全血的人。这些人分成三种献血间隔。男性是 12 周、10 周、8 周，女性是 16 周、14 周、12 周。间隔缩短之后，两年内采到的血明显更多（男性 8 周组比 12 周组多 1.69 单位，95% CI 1.59–1.80）。生活质量、体力活动、认知功能各组都没看出差别。但献血带来的不适更多，包括乏力、气短、眩晕、头晕和不宁腿（夜里腿难受得躺不住）。同时血红蛋白与铁蛋白的平均值更低，因为血红蛋白低而被推迟献血的次数也更多（各项 P<0.0001）。缺铁会影响身体产热：10 名缺铁性贫血的女性、8 名铁储备已经耗光但还没贫血的人、12 名对照女性，在 28 ℃ 的水里泡 100 分钟。贫血那组直肠温度 36.0±0.2 ℃，对照组 36.2±0.1 ℃（P=0.001）。耗氧量 5.28±0.26 对 5.99±0.29 mL·min⁻¹·kg⁻¹（P=0.04）。甲状腺素和三碘甲状腺原氨酸这两种甲状腺激素也更低（P<0.002）。这个说法看起来成立，是因为献血的人本来就是被反复筛查过的健康人，而「把铁放掉就能护心」这个假说在随机试验里没验出来"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["来源"]},{"tag":"p","props":{"className":"life-citations"},"children":["Salonen JT, Tuomainen TP, Salonen R, Lakka TA, Nyyssönen K (1998). Donation of blood is associated with reduced risk of myocardial infarction. The Kuopio Ischaemic Heart Disease Risk Factor Study. American Journal of Epidemiology, 148(5), 445-451. ",{"tag":"a","props":{"href":"https://doi.org/10.1093/oxfordjournals.aje.a009669","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1093/oxfordjournals.aje.a009669"]},"；Ullum H, Rostgaard K, Kamper-Jørgensen M, et al. (2015). Blood donation and blood donor mortality after adjustment for a healthy donor effect. Transfusion, 55(10), 2479-2485. ",{"tag":"a","props":{"href":"https://doi.org/10.1111/trf.13205","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1111/trf.13205"]},"；Zacharski LR, Chow BK, Howes PS, et al. (2007). Reduction of iron stores and cardiovascular outcomes in patients with peripheral arterial disease: a randomized controlled trial. JAMA, 297(6), 603-610. ",{"tag":"a","props":{"href":"https://doi.org/10.1001/jama.297.6.603","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1001/jama.297.6.603"]},"；Di Angelantonio E, Thompson SG, Kaptoge S, et al. (2017). Efficiency and safety of varying the frequency of whole blood donation (INTERVAL): a randomised trial of 45 000 donors. Lancet, 390(10110), 2360-2371. ",{"tag":"a","props":{"href":"https://doi.org/10.1016/S0140-6736(17)31928-1","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1016/S0140-6736(17)31928-1"]},"；Beard JL, Borel MJ, Derr J (1990). Impaired thermoregulation and thyroid function in iron-deficiency anemia. American Journal of Clinical Nutrition, 52(5), 813-819. ",{"tag":"a","props":{"href":"https://doi.org/10.1093/ajcn/52.5.813","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1093/ajcn/52.5.813"]},"；全国人大常委会 (1997). 中华人民共和国献血法（第二、九、十四条）. ",{"tag":"a","props":{"href":"https://flk.npc.gov.cn/detail?id=2c909fdd678bf17901678bf5e71801f9","target":"_blank","rel":"noopener noreferrer"},"children":["https://flk.npc.gov.cn/detail?id=2c909fdd678bf17901678bf5e71801f9"]},"；国家卫生健康委等 (2024-01-08). 关于进一步做好无偿献血者激励奖励工作的通知. ",{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/202401/content_6924875.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/zhengce/zhengceku/202401/content_6924875.htm"]},""]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["原书备注"]},{"tag":"p","props":{"className":"life-citations"},"children":["要否掉的是「为了自己的身体去献血」，不是献血这件事本身。血是给别人用的，按本书的受益人分档落在第④档（陌生人）。真正能回到你自己这边的，是制度给的那一份。《献血法》第十四条规定，无偿献血的人自己在医院用血，采集、储存、分离、检验这几笔费用都免交，配偶和直系亲属可以按省级政府的规定免交或者少交。国家卫健委 2024 年 1 月的通知写明，28 个省份已经做到无偿献血者和亲属在省内医院用血的费用出院时直接减免。拿到无偿献血奉献奖的人，还可以按当地的「三免」政策免费坐公共交通、免费逛政府投资主办的公园、免交公立医院的普通门诊诊察费。要献就按法定间隔来。《献血法》第九条规定，每次一般 200 毫升，最多不超过 400 毫升。两次之间间隔不少于 6 个月。提倡的年龄是 18 至 55 周岁。别为了凑荣誉或者团体指标，把间隔压到最短。女性、体重偏低的人、月经量多的人，身体里的铁本来就紧张，反复献血的人可以自费查一次铁蛋白。献完之后如果一直乏力、怕冷，或者晚上躺下腿里难受得忍不住要动（这叫不宁腿），别自己猜是「元气伤了」，去查血常规和铁蛋白。查出缺铁就按医生说的补铁，同时把献血间隔拉长。怕冷那一段的人体证据只有 10 个人，用来解释为什么会这样，不是说有多少人会这样"]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["我的备注"]},{"tag":"button","props":{"type":"button"},"children":["写下对自己有用的提醒…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/tip/06-16"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["上一条"]},"不要买防蓝光眼镜来「保护视力」，也不要相信「对着屏幕干几个月眼睛就废了」，但眼睛胀痛发红要当急症"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/tip/06-18"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["下一条"]},"不要靠通用体检套餐防病，按年龄性别做那几项有证据的筛查"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["本主题的其他建议"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/06-13"},"children":[{"tag":"strong","props":{},"children":["不要买排毒、清肠、酵素、碱性水这类产品"]},{"tag":"span","props":{},"children":["排毒这个产业做得很大，可支持它的临床证据非常少，也没人拿市面上卖的排毒饮食认真做过试验。有人去查饮食酸碱、碱性水和癌症有没有关系，够格的研究只找到 1 篇，也没…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/06-14"},"children":[{"tag":"strong","props":{},"children":["不要为了凑够「每天 8 杯水」强迫自己喝水"]},{"tag":"span","props":{},"children":["有人专门去追「每天 8 杯水」的出处，一项支持它的研究都没找到。食物和别的饮料里本来就带着大量水分，所以用不着喝那么多。渴了就喝，看看尿的颜色就够了。天热干活、…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/06-15"},"children":[{"tag":"strong","props":{},"children":["不要花钱算命、看塔罗、看星座来做决定"]},{"tag":"span","props":{},"children":["有个经典的课堂实验：学生拿到的「个人性格分析」其实人手一份、一模一样，大家却普遍觉得很准。算命显得准，道理就在这里。占星师挑对的次数和瞎猜差不多。代价不只几十块…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/06-19"},"children":[{"tag":"strong","props":{},"children":["不要因为体检查出尿酸高、但从没痛过，就开始吃降尿酸药"]},{"tag":"span","props":{},"children":["尿酸超标、但从没发作过痛风也没长痛风石的人，美国风湿病学会建议先不吃降尿酸药。24 个人吃满 3 年，才拦得住一次痛风发作。想靠它护肾也落空了，吃药的人肾功能照…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/06-20"},"children":[{"tag":"strong","props":{},"children":["不要因为体检查出胆囊结石、但从没疼过，就去预防性切胆囊"]},{"tag":"span","props":{},"children":["胆囊里有石头、但从没疼过的人，近九年里约八成一直没出症状。不动它，每年出胆囊炎、胰腺炎这类急症的约千分之一到千分之三。切胆囊也不是零风险，约 1.5% 的人胆管…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/06-21"},"children":[{"tag":"strong","props":{},"children":["不要为了防肾结石把钙戒掉"]},{"tag":"span","props":{},"children":["长过草酸钙结石的人常被劝少吃钙，试验的结果正好反过来。反复长结石的男性正常吃钙、同时少吃动物蛋白和盐，五年里复发的人只有吃低钙饮食的一半。英国的指南也写明不要限…"]}]}]}]},{"tag":"a","props":{"className":"life-text-link","href":"/book/06"},"children":["阅读整个主题：反面清单 ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"15","height":"15","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]}]}]},{"tag":"nav","props":{"className":"life-tabbar","aria-label":"主导航"},"children":[{"tag":"a","props":{"className":"","href":"/book"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"21","height":"21","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-book-open","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M12 7v14"},"children":[]},{"tag":"path","props":{"d":"M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z"},"children":[]}]},{"tag":"span","props":{},"children":["全书"]}]},{"tag":"a","props":{"className":"","href":"/top-50"},"children":[{"tag":"svg","props