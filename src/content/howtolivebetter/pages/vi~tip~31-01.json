,"fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-up-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M7 7h10v10"},"children":[]},{"tag":"path","props":{"d":"M7 17 17 7"},"children":[]}]}]}]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/vi/book/31"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"Quay lại mục lục"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["Sau mười tám tuổi có những con đường nào"]},{"tag":"div","props":{"data-ad-dock-host":"true"},"children":[]},{"tag":"nav","props":{"aria-label":"Các mục trong chương"},"children":[{"tag":"a","props":{"aria-current":"page","className":"active","href":"/vi/tip/31-01","data-status":"active"},"children":[{"tag":"span","props":{},"children":["01"]},"Đối chiếu điều kiện trước đã: yêu cầu về tuổi và trình độ của mười hai con đường đều được viết thành văn bản"]},{"tag":"a","props":{"href":"/vi/tip/31-02"},"children":[{"tag":"span","props":{},"children":["02"]},"Năm thứ mười tám tuổi phải đăng ký nghĩa vụ quân sự trước ngày 31 tháng 10; quân nhân lính nghĩa vụ nhập ngũ đúng hai năm"]},{"tag":"a","props":{"href":"/vi/tip/31-03"},"children":[{"tag":"span","props":{},"children":["03"]},"Sau khi được truy xuất mà từ chối nghĩa vụ quân sự thì trong hai năm không được xuất cảnh, không được học tiếp, và không vào được cơ quan công chức hay doanh nghiệp nhà nước"]},{"tag":"a","props":{"href":"/vi/tip/31-04"},"children":[{"tag":"span","props":{},"children":["04"]},"Hai điều thật nhất khi sinh viên đại học đi nghĩa vụ quân sự: học phí mỗi năm bù tối đa 20000 tệ, giữ học vị hai năm, và có một kế hoạch riêng cho tuyển sinh cao học"]},{"tag":"a","props":{"href":"/vi/tip/31-05"},"children":[{"tag":"span","props":{},"children":["05"]},"Sau khi giải ngũ chỉ có sáu trường hợp được chính quyền bố trí việc làm; người tự tìm việc phải đến đăng ký trong vòng 30 ngày"]},{"tag":"a","props":{"href":"/vi/tip/31-06"},"children":[{"tag":"span","props":{},"children":["06"]},"Ba khoản sau khi giải ngũ: tiền trở cấp một lần, thời gian phục vụ tính vào thâm niên công, và tự làm ăn thì mỗi năm giảm 20000 tệ thuế"]},{"tag":"a","props":{"href":"/vi/tip/31-07"},"children":[{"tag":"span","props":{},"children":["07"]},"Muốn vào hệ thống cơ quan công chức không chỉ có thi cao công chức: làm đủ hai năm ở chương trình phục vụ cơ sở thì dự được kế hoạch tuyển định hướng dành riêng cho 10% mỗi năm"]},{"tag":"a","props":{"href":"/vi/tip/31-08"},"children":[{"tag":"span","props":{},"children":["08"]},"Giáo viên vị trí đặc biệt hết hạn ba năm, đạt kết quả đánh giá và còn muốn ở lại thì phải được chuyển thành biên chế đúng thời hạn"]},{"tag":"a","props":{"href":"/vi/tip/31-09"},"children":[{"tag":"span","props":{},"children":["09"]},"Lính cứu hộ và nhân sự văn chứng quân đội là hai cửa tuyển công khai khác, ngưỡng thấp hơn thi công chức"]},{"tag":"a","props":{"href":"/vi/tip/31-10"},"children":[{"tag":"span","props":{},"children":["10"]},"Bằng cấp không phải việc mua một lần là xong: thi tự học không giới hạn tuổi cũng không xem trình độ đã học, thi lớn và đại học mở đều bổ sung được"]},{"tag":"a","props":{"href":"/vi/tip/31-11"},"children":[{"tag":"span","props":{},"children":["11"]},"Không vào cơ quan công chức thì làm việc linh hoạt: hưu trí và y tế phải tự tham gia bảo hiểm ở nơi làm việc, hạn chế về hộ khẩu đã được nới"]},{"tag":"a","props":{"href":"/vi/tip/31-12"},"children":[{"tag":"span","props":{},"children":["12"]},"Giao đồ ăn, chạy xe ô tô công nghệ, chở hàng trong thành phố: sàn trả phí bảo hiểm tai nạn lao động theo từng đơn, bạn không phải đóng"]},{"tag":"a","props":{"href":"/vi/tip/31-13"},"children":[{"tag":"span","props":{},"children":["13"]},"Hai con đường chốt được chỗ làm việc có biên chế ngay từ ngày điền nguyện vọng kỳ thi gaokao: sinh viên sư phạm có học phí và sinh viên y khoa định hướng, cái giá là thực hiện cam kết 6 năm"]},{"tag":"a","props":{"href":"/vi/tip/31-14"},"children":[{"tag":"span","props":{},"children":["14"]},"Muốn đi làm công ăn nước ngoài, trước hết tra công ty này có giấy phép hợp tác lao động ngoài biên giới không: công ty không được đòi bạn đặt tiền"]},{"tag":"a","props":{"href":"/vi/tip/31-15"},"children":[{"tag":"span","props":{},"children":["15"]},"Làm việc từ xa cho công ty nước ngoài ngay tại nhà, khoản tiền này theo luật thuế tính là thu nhập trong nước: thuế thu nhập cá nhân tự kê khai, tiền về nước đi theo khoản「thù lao lao động」"]},{"tag":"a","props":{"href":"/vi/tip/31-16"},"children":[{"tag":"span","props":{},"children":["16"]},"Không vào cơ quan mà tự làm ăn, tiền khởi đầu hãy xem khoản vay bảo đảm khởi nghiệp: cá nhân tối đa 30 vạn, Nhà nước trợ một nửa lãi suất"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"Breadcrumbs"},"children":[{"tag":"a","props":{"href":"/vi/book"},"children":["Khám phá cuốn sách"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/vi/book/31"},"children":["Chương 31"," ·"," ","Sau mười tám tuổi có những con đường nào"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"31-01"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["01"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["Bằng chứng"," ","A"]}]},{"tag":"h1","props":{"lang":"vi"},"children":["Đối chiếu điều kiện trước đã: yêu cầu về tuổi và trình độ của mười hai con đường đều được viết thành văn bản"]},{"tag":"p","props":{"lang":"vi","className":"life-entry-summary"},"children":["Điều kiện về tuổi và trình độ của mười hai con đường đều được viết trong văn bản. Đi làm công ăn thường phải đủ mười sáu tuổi. Đi nghĩa vụ quân sự là nam giới đủ mười tám tuổi, người tốt nghiệp đại học có thể nới đến hai mươi bốn tuổi. Thi tuyển công chức cần từ mười tám đến ba mươi lăm tuổi, trình độ từ cao đẳng trở lên. Còn thi tự học và đăng ký làm hộ kinh doanh cá thể thì không xem trình độ, cũng không xem tuổi."]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Chi phí"]},{"tag":"p","props":{},"children":["Không tốn tiền. Dành mười phút đối chiếu một lượt, xem mìn…"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Lợi ích"]},{"tag":"p","props":{},"children":["Đi nghĩa vụ quân sự thì xem Luật nghĩa vụ quân sự (兵役法):「年满十八周岁的男性公民，应当被征集服现役；"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"Đánh dấu: Đối chiếu điều kiện trước đã: yêu cầu về tuổi và trình độ của mười hai con đường đều được viết thành văn bản"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"Hoàn tất"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"Kế hoạch thực hiện"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"Lưu"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Chia sẻ mẹo này"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Ẩn chi tiết"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Chi phí"]},{"tag":"p","props":{},"children":["Không tốn tiền. Dành mười phút đối chiếu một lượt, xem mình có đủ điều kiện không."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Lợi ích"]},{"tag":"p","props":{},"children":["Đi nghĩa vụ quân sự thì xem Luật nghĩa vụ quân sự (兵役法):「年满十八周岁的男性公民，应当被征集服现役；当年未被征集的，在二十二周岁以前仍可以被征集服现役。普通高等学校毕业生的征集年龄可以放宽至二十四周岁，研究生的征集年龄可以放宽至二十六周岁」, tức nam công dân đủ mười tám tuổi thì phải được truy xuất nhập ngũ; người không được truy xuất trong năm đó thì trước hai mươi hai tuổi vẫn có thể được truy xuất; tuổi truy xuất của người tốt nghiệp đại học thường có thể nới đến hai mươi bốn tuổi, của nghiên cứu sinh nới đến hai mươi sáu tuổi. Thi tuyển công chức thì xem Điều mười tám của Quy định tuyển dụng công chức《公务员录用规定》. Điều kiện dự thi gồm「年龄为十八周岁以上，三十五周岁以下」「具有大学专科以上文化程度」, tức từ mười tám tuổi trở lên và dưới ba mươi lăm tuổi, có trình độ từ cao đẳng trở lên. Hai điều kiện này có thể được điều chỉnh cho phù hợp nếu được cơ quan quản lý công chức cấp tỉnh trở lên phê duyệt. Điều mười chín của quy định đó liệt kê năm loại người không được dự thi. Ví dụ người từng bị kết án hình sự vì tội phạm, người bị sa thải khỏi chức vụ công, người bị đưa vào danh sách cấm đoán để trừng phạt liên ngành vì mất uy tín. Tuyển lính cứu hộ thì xem《Biện pháp tuyển lính trong đội cứu hộ và cứu nạn tổng hợp quốc gia》《国家综合性消防救援队伍消防员招录办法》. Điều năm:「年龄为 18 周岁以上、22 周岁以下」「具有高中以上文化程度」. Điều sáu:「大学专科以上学历人员、解放军和武警部队退役士兵……年龄可以放宽至 24 周岁」. Quân nhân văn chứng thì xem Điều chín của《Quy chế nhân sự văn chứng Quân giải phóng nhân dân Trung Quốc》《中国人民解放军文职人员条例》, điều kiện cơ bản có「年满 18 周岁」. Điều mười chín của quy chế đó ghi rõ đối với chức vụ cấp bậc thấp thì tuổi tối đa khi tuyển lần đầu là 35 tuổi. Cơ quan hành chính sự vệ tổ chức tuyển dụng công chức thì xem Điều tám của《Quy chế quản lý nhân sự của cơ quan hành chính sự vệ》《事业单位人事管理条例》:「事业单位新聘用工作人员，应当面向社会公开招聘」. Hộ kinh doanh cá thể thì xem《Quy chế thúc đẩy phát triển hộ kinh doanh cá thể》《促进个体工商户发展条例》:「有经营能力的公民……依法登记为个体工商户的，适用本条例」. Thi tự học thì xem《Quy chế lâm thời về thi tự học bậc đại học》《高等教育自学考试暂行条例》. Điều ba:「中华人民共和国公民，不受性别、年龄、民族、种族和已受教育程度的限制，均可依照本条例的规定参加高等教育自学考试」. Điều hai mươi:「各级各类全日制学校的在校生不得报考」. Sinh viên chính quy có học phí do Nhà nước bảo trả thì xem Điều hai của《Biện pháp thực hiện chế độ giáo dục có học phí cho sinh viên sư phạm liên thông bậc đại học và sau đại học của các trường đại học sư phạm trực thuộc Bộ Giáo dục》《教育部直属师范大学本研衔接师范生公费教育实施办法》. Bộ này chỉ tuyển ở sáu trường đại học sư phạm trực thuộc Bộ. Cụ thể là Đại học Bắc Kinh, Đại học Hoa Đông, Đại học Đông Bắc, Đại học Hoa Trung, Đại học Thiển Tây và Đại học Tây Nam. Bậc đại học và bậc sau đại học thiết kế liền nhau, chia thành từng đoạn đánh giá, học xong bậc đại học thì tiếp tục học sau đại học. Học phí và tiền ở trong suốt thời gian học do ngân sách trung ương chi trả, ngoài ra còn có trợ cấp sinh hoạt. Điều năm của biện pháp đó quy định「招收公费师范生实行提前批次录取」, tức nhận sinh viên có học phí theo lô nhập trước các lô bình thường. Sinh viên y khoa định hướng thì xem《Thông báo về việc làm tốt công tác bố trí việc làm và quản lý thực hiện cam kết cho sinh viên y khoa được đào tạo miễn phí theo đơn đặt hàng nông thôn》《关于做好农村订单定向免费培养医学生就业安置和履约管理工作的通知》. Nó viết:「在录取后、获得入学通知书前，须与培养学校和定向就业所在地的县级卫生健康行政部门……人力资源社会保障部门签署协议」. Đi làm công ăn ở nước ngoài thì xem《Quy chế quản lý hợp tác lao động ngoài biên giới》《对外劳务合作管理条例》. Điều năm: muốn làm hợp tác lao động ngoài biên giới thì phải được cơ quan quản lý thương mại phê duyệt và có tư cách kinh doanh. Điều bảy khoản bốn:「未依法取得对外劳务合作经营资格证书并办理登记，不得从事对外劳务合作」. Công ty không có giấy phép đó mà tổ chức người đi làm công ăn nước ngoài thì bản thân nó đã vi phạm pháp. Điều tám khoản hai:「任何单位和个人不得以商务、旅游、留学等名义组织劳务人员赴国外工作」. Nhận việc qua sàn và làm việc tự do không có ngưỡng trình độ theo luật; căn cứ tự tham gia bảo hiểm xã hội và bảo hiểm tai nạn lao động xem mục 11 và 12 của phần này. Đi làm thuê thì xem Luật Giáo dục bắt buộc: «Cấm đơn vị sử dụng lao động tuyển trẻ em, thiếu niên trong độ tuổi phải học giáo dục bắt buộc». Điều 2 của Quy định cấm sử dụng lao động trẻ em ghi rõ không được tuyển người chưa đủ 16 tuổi; về chế tài, xem phần 23, mục 1 (chưa đủ 16 tuổi)."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Nguồn gốc"]},{"tag":"p","props":{"className":"life-citations"},"children":["全国人大常委会 (2021). 兵役法（第二十条）. ",{"tag":"a","props":{"href":"http://www.mod.gov.cn/regulatory/2021-08/20/content_4892491.htm","target":"_blank","rel":"noopener noreferrer"},"children":["http://www.mod.gov.cn/regulatory/2021-08/20/content_4892491.htm"]},"（国防部刊登）；中共中央组织部 (2019). 公务员录用规定（第十八、十九条）. ",{"tag":"a","props":{"href":"https://www.12371.cn/2020/01/08/ARTI1578447606460158.shtml","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.12371.cn/2020/01/08/ARTI1578447606460158.shtml"]},"（共产党员网刊登）；人力资源社会保障部、应急管理部 (2021). 国家综合性消防救援队伍消防员招录办法（人社部发〔2021〕58 号，第五、六条）. ",{"tag":"a","props":{"href":"https://www.gov.cn/z