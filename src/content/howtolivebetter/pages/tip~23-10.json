,{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"分享这条建议"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"收起详情"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["成本"]},{"tag":"p","props":{"className":"life-citations"},"children":["不花钱。选之前先按这个维度把想学的活过一遍。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["收益"]},{"tag":"p","props":{"className":"life-citations"},"children":["给美国 702 个职业逐个估「这活多大概率能交给计算机做」（可计算化概率评估），结果是约 47% 的就业岗位处于高风险区间。模型里决定风险高低的，是三处机器目前迈不过去的坎，作者叫它「工程瓶颈」。一是感知与操作，包括手指灵巧度、手部灵巧度、在狭窄空间和别扭姿势下作业。二是创造性智能（想出新东西的能力）。三是社会智能（跟人打交道的能力）。所以环境非标准、需要手上功夫和临场判断的活，被替代的概率一贯更低，不是个别职业的偶然。流程固定、以信息处理为主的岗位风险最高"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["来源"]},{"tag":"p","props":{"className":"life-citations"},"children":["Frey CB, Osborne MA (2017). The future of employment: how susceptible are jobs to computerisation? Technological Forecasting and Social Change, 114, 254-280. ",{"tag":"a","props":{"href":"https://doi.org/10.1016/j.techfore.2016.08.019","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1016/j.techfore.2016.08.019"]},""]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["原书备注"]},{"tag":"p","props":{"className":"life-citations"},"children":["争议。这项研究是 2013 年一份没正式发表的论文稿，打分打的是「整个职业能不能被机器接手」。后来有研究改成拆到一件件具体任务上去估，算出来的高风险比例低得多。它也不说这事会在哪一年发生。用它时别盯着 47% 这个数，要看它点出的那三处卡住机器的地方。现场安装、检修、护理这类活比纯文书更抗替代，原因就在这里。所以「学个技能」优先该选需要到现场、面对非标准环境的那种"]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["我的备注"]},{"tag":"button","props":{"type":"button"},"children":["写下对自己有用的提醒…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/tip/23-09"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["上一条"]},"培训优先走政府补贴渠道，别一上来就自费报商业班"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/tip/23-11"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["下一条"]},"学之前先确认这个技能有没有等级评价，等级能不能换成钱"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["本主题的其他建议"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/23-06"},"children":[{"tag":"strong","props":{},"children":["把「读书还是打工」算成一道题：先去打工早挣的三年工资，对上接着读书换来的、往后几十年的年收入差"]},{"tag":"span","props":{},"children":["先去打工，能早挣几年工资，但这笔钱只拿一次。接着读书，往后每年都比不读的多挣一些，要连着拿三四十年。所以要把这两笔钱放在一起比。中国城镇多读一年书，一年收入大约…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/23-07"},"children":[{"tag":"strong","props":{},"children":["先记住基准线：多受一年教育，全球平均的私人回报（落到自己收入上的那部分）约为每年 9%"]},{"tag":"span","props":{},"children":["按全世界平均算，多读一年书，个人收入每年高约 9%，女性的回报一直高于男性。这个数说的是正规上学，报一个班不能直接套。拿它当尺子：一个课程要你花 3 万元和半年…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/23-08"},"children":[{"tag":"strong","props":{},"children":["花钱考证之前，先查这张证在不在国家职业资格目录或人社部备案的评价机构名单里"]},{"tag":"span","props":{},"children":["有些机构打着新职业、技能等级的名义乱办班、乱收费、滥发证，还有假冒权威机构的，人社部专门治理过。报名前按三步查：这个职业在不在国家职业资格目录、发证机构是不是人…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/23-12"},"children":[{"tag":"strong","props":{},"children":["别把「网上说工资高」当成缺人，去查当地的紧缺职业目录和补贴目录"]},{"tag":"span","props":{},"children":["各地给哪个工种的培训补贴多，是按急需紧缺程度和培训成本定的，所以补贴额度能看出当地缺不缺人。网上说的「某工种月入多少」，多半是招聘平台的挂牌价或个人自述。你看到…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/23-13"},"children":[{"tag":"strong","props":{},"children":["同样的钱和时间，优先选能直接上岗的短周期项目"]},{"tag":"span","props":{},"children":["政策鼓励的是能短期就业的「短平快」培训，还有职业院校的微专业。挑项目只看一条：学完有没有一个具体岗位能投简历。学一年半载、结业还要「再积累经验」的，实际花掉的时…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/23-14"},"children":[{"tag":"strong","props":{},"children":["学完先合上书自己考一遍，别回头重读"]},{"tag":"span","props":{},"children":["读完再读一遍感觉很熟，其实记不牢。合上书考自己一遍，效果明显更好，课堂上加了小测验，成绩提高属于中等幅度。给十种常用学法排名时，自测排在最高一档。读完一节先默写…"]}]}]}]},{"tag":"a","props":{"className":"life-text-link","href":"/book/23"},"children":["阅读整个主题：学什么技能划算 ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"15","height":"15","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]}]}]}]},{"tag":"aside","props":{"className":"life-ad-space life-ad-space-sponsored","data-ad-placement":"ad_footer","data-ad-group":"reading","data-ad-creative":"read_product","data-ad-ready":"false","aria-label":"广告 · 社区推荐"},"children":[{"tag":"div","props":{"className":"life-ad-space-brand"},"children":[{"tag":"img","props":{"src":"/sites/howtolivebetter/images/shengcai/logo.png","width":"565","height":"144","alt":"生财有术官方 Logo","decoding":"async"},"children":[]}]},{"tag":"div","props":{"className":"life-ad-space-copy"},"children":[{"tag":"span","props":{"className":"life-ad-space-label"},"children":["广告 · 社区推荐"]},{"tag":"strong","props":{},"children":["读过的知识，能不能做成有用的产品？"]},{"tag":"p","props":{},"children":["从电子书、资料到小工具，看看圈友怎样发现需求，把内容变成实际交付。"]}]},{"tag":"div","props":{"className":"life-ad-space-actions"},"children":[{"tag":"a","props":{"className":"life-ad-space-link","href":"/shengcaiyoushu?sc_group=reading&sc_creative=read_product&sc_placement=ad_footer"},"children":["看看社区与案例",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"18","height":"18","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-up-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":