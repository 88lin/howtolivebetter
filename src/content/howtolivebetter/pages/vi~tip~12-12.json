-hidden":"true"},"children":[{"tag":"path","props":{"d":"M18 20a6 6 0 0 0-12 0"},"children":[]},{"tag":"circle","props":{"cx":"12","cy":"10","r":"4"},"children":[]},{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},{"tag":"span","props":{},"children":["Đăng nhập để đồng bộ hóa"]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/vi/book/12"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"Quay lại mục lục"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["Khởi nghiệp: đừng làm mất khoản tiết kiệm của gia đình"]},{"tag":"nav","props":{"aria-label":"Các mục trong chương"},"children":[{"tag":"a","props":{"href":"/vi/tip/12-01"},"children":[{"tag":"span","props":{},"children":["01"]},"Chỉ dùng số tiền mà lỡ mất trắng vẫn chịu được để khởi nghiệp, không đụng vốn của cả nhà, không vay tiền để mở hàng"]},{"tag":"a","props":{"href":"/vi/tip/12-02"},"children":[{"tag":"span","props":{},"children":["02"]},"Đừng ký bảo đảm cá nhân cho khoản vay của công ty, người phối ngẫu càng đừng ký theo"]},{"tag":"a","props":{"href":"/vi/tip/12-03"},"children":[{"tag":"span","props":{},"children":["03"]},"Chọn đúng loại hình kinh doanh trước khi mở hàng: hộ cá thể và cổ phần công chung phải trả đến cùng, chỉ công ty hữu hạn mới「hữu hạn」"]},{"tag":"a","props":{"href":"/vi/tip/12-04"},"children":[{"tag":"span","props":{},"children":["04"]},"Đừng làm cổ phân danh nghĩa, đừng giữ cổ phần thay người khác"]},{"tag":"a","props":{"href":"/vi/tip/12-05"},"children":[{"tag":"span","props":{},"children":["05"]},"Trước khi nhượng quyền, kiểm tra hồ sơ đăng ký ở Bộ Thương mại, lấy bản công bố bằng văn bản, ghi「thời gian cân nhắc」vào hợp đồng"]},{"tag":"a","props":{"href":"/vi/tip/12-06"},"children":[{"tag":"span","props":{},"children":["06"]},"Trước khi đăng ký, chốt tên, địa điểm kinh doanh, phạm vi kinh doanh và vốn đăng ký, đủ hồ sơ thì lấy được giấy phép ngay tại chỗ"]},{"tag":"a","props":{"href":"/vi/tip/12-07"},"children":[{"tag":"span","props":{},"children":["07"]},"Ngành cần giấy phép thì chưa có giấy thì không khai trương"]},{"tag":"a","props":{"href":"/vi/tip/12-08"},"children":[{"tag":"span","props":{},"children":["08"]},"Làm thực phẩm thì xem trước mình ở bậc nào: sản xuất và ăn uống phải có giấy phép, chỉ bán đóng gói sẵn thì kê khai, bán thịt rau tươi không cần giấy"]},{"tag":"a","props":{"href":"/vi/tip/12-09"},"children":[{"tag":"span","props":{},"children":["09"]},"Đóng túi để bán thì là thực phẩm đóng gói sẵn: trên nhãn, ngày sản xuất, hạn sử dụng, bảng thành phần thiếu mục nào cũng không được"]},{"tag":"a","props":{"href":"/vi/tip/12-10"},"children":[{"tag":"span","props":{},"children":["10"]},"Thực phẩm thường không được nói là chữa bệnh: nhãn, hướng dẫn, quảng cáo và lời livestream đều tính"]},{"tag":"a","props":{"href":"/vi/tip/12-11"},"children":[{"tag":"span","props":{},"children":["11"]},"Ngành thực phẩm có đường ranh giới hình sự: bán thịt chết bệnh, hàng vượt tiêu chuẩn là đủ thành tội, trộn thêm nguyên liệu độc hại thì không tính tiền, khởi tội năm năm"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/vi/tip/12-12","data-status":"active"},"children":[{"tag":"span","props":{},"children":["12"]},"Có giấy phép là bắt đầu có nghĩa vụ kê khai, không có doanh thu vẫn phải kê khai đúng hạn (nộp một tờ toàn số không)"]},{"tag":"a","props":{"href":"/vi/tip/12-13"},"children":[{"tag":"span","props":{},"children":["13"]},"Hoá đơn chỉ xuất theo giao dịch thật, người nộp thuế quy mô nhỏ hãy dùng hết ngưỡng miễn thuế"]},{"tag":"a","props":{"href":"/vi/tip/12-14"},"children":[{"tag":"span","props":{},"children":["14"]},"Ai tự xưng cơ quan thuế đòi bạn nộp tiền khai thuế đều là lừa đảo, làm thủ tục thuế chỉ đi qua cổng thuế điện tử và 12366"]},{"tag":"a","props":{"href":"/vi/tip/12-15"},"children":[{"tag":"span","props":{},"children":["15"]},"Nhận tiền thì viết「定金」chứ đừng viết「订金」, tiền phạt vi phạm phải ghi rõ con số, hạn thanh toán thì soi như cho vay"]},{"tag":"a","props":{"href":"/vi/tip/12-16"},"children":[{"tag":"span","props":{},"children":["16"]},"Người lao động tháng đầu phải ký hợp đồng bằng văn bản, 30 ngày đăng ký bảo hiểm xã hội"]},{"tag":"a","props":{"href":"/vi/tip/12-17"},"children":[{"tag":"span","props":{},"children":["17"]},"Lương trả theo hợp đồng và theo pháp luật, tăng lương, cho vay, thưởng đều phải qua văn bản"]},{"tag":"a","props":{"href":"/vi/tip/12-18"},"children":[{"tag":"span","props":{},"children":["18"]},"Bán trước rồi mới sản xuất: dùng bán trước và đơn nhỏ để kiểm chứng có người mua, rồi mới bỏ tiền vào sản xuất"]},{"tag":"a","props":{"href":"/vi/tip/12-19"},"children":[{"tag":"span","props":{},"children":["19"]},"Làm xong mẫu thì so qua danh sách sản xuất hàng loạt, rồi hãy nói chuyện khoảng sản xuất"]},{"tag":"a","props":{"href":"/vi/tip/12-20"},"children":[{"tag":"span","props":{},"children":["20"]},"Mỗi lô hàng nhập về để lại một bộ hoá đơn và thông tin nhà cung cấp, giá nhập thấp hơn hẳn giá thị trường thì không nhập: hàng giả do nhân viên mua, người bị kết án là chủ"]},{"tag":"a","props":{"href":"/vi/tip/12-21"},"children":[{"tag":"span","props":{},"children":["21"]},"Hình ảnh trên hàng, bao bì, treo thẻ và ảnh quảng cáo thì tự làm hoặc mua giấy uỷ quyền, đổi màu, thêm biểu tượng không tính là「đã sửa」"]},{"tag":"a","props":{"href":"/vi/tip/12-22"},"children":[{"tag":"span","props":{},"children":["22"]},"Ở đúng vị trí thì làm theo quy trình, còn cái thiện ý ngoài quy trình thì nghĩ kỹ trách nhiệm thuộc về ai"]},{"tag":"a","props":{"href":"/vi/tip/12-23"},"children":[{"tag":"span","props":{},"children":["23"]},"Lỗ thì rút lui theo thủ tục: huỷ được kiểu rút gọn thì huỷ, vỡ nợ thì đi phá sản, đừng để yên"]},{"tag":"a","props":{"href":"/vi/tip/12-24"},"children":[{"tag":"span","props":{},"children":["24"]},"Trước khi chi tiền thuê người khác quản lý cửa hàng trực tuyến, tham gia khóa đào tạo mở cửa hàng, hoặc thực hiện mô hình 'không nguồn hàng', hãy hỏi rõ liệu sau này có phải trả thêm tiền hay không, và nguồn doanh số sẽ đến từ đâu"]},{"tag":"a","props":{"href":"/vi/tip/12-25"},"children":[{"tag":"span","props":{},"children":["25"]},"Mở công ty hoặc hộ cá thể ở Trung Quốc: từ 1 tháng 1 đến 30 tháng 6 nộp báo cáo năm trước qua mạng, không kinh doanh cũng phải nộp, không mất phí"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"Breadcrumbs"},"children":[{"tag":"a","props":{"href":"/vi/book"},"children":["Khám phá cuốn sách"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/vi/book/12"},"children":["Chương 12"," ·"," ","Khởi nghiệp: đừng làm mất khoản tiết kiệm của gia đình"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"12-12"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["12"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["Bằng chứng"," ","A"]}]},{"tag":"h1","props":{"lang":"vi"},"children":["Có giấy phép là bắt đầu có nghĩa vụ kê khai, không có doanh thu vẫn phải kê khai đúng hạn (nộp một tờ toàn số không)"]},{"tag":"p","props":{"lang":"vi","className":"life-entry-summary"},"children":["Có giấy phép là phải kê khai thuế đúng hạn. Không kiếm được đồng nào vẫn phải kê khai, chỉ là các con số trên bảng điền toàn số không. Không kê khai thì trước hết phạt dưới 2000 tệ, tình tiết nặng phạt từ 2000 tệ đến 1 vạn tệ. Liên tục ba tháng không kê khai bất kỳ loại thuế nào, hệ thống sẽ tự động xếp bạn vào diện không bình thường, không phát được hoá đơn."]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Chi phí"]},{"tag":"p","props":{},"children":["Không tốn tiền. Tự kê khai theo tháng hoặc theo quý trên c…"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Lợi ích"]},{"tag":"p","props":{},"children":["「Người nộp thuế trong thời hạn nộp thuế không có số thuế phải nộp thì vẫn phải làm thủ tục kê khai thuế theo q…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"Đánh dấu: Có giấy phép là bắt đầu có nghĩa vụ kê khai, không có doanh thu vẫn phải kê khai đúng hạn (nộp một tờ toàn số không)"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"Hoàn tất"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","pro