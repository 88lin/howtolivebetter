 17.66 1.41 1.41"},"children":[]},{"tag":"path","props":{"d":"M2 12h2"},"children":[]},{"tag":"path","props":{"d":"M20 12h2"},"children":[]},{"tag":"path","props":{"d":"m6.34 17.66-1.41 1.41"},"children":[]},{"tag":"path","props":{"d":"m19.07 4.93-1.41 1.41"},"children":[]}]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"17","height":"17","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-moon life-theme-icon-dark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"},"children":[]}]}]},{"tag":"button","props":{"type":"button","className":"life-language-switch","aria-label":"Русский Выбрать язык","aria-haspopup":"menu","aria-expanded":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-globe","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]},{"tag":"path","props":{"d":"M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"},"children":[]},{"tag":"path","props":{"d":"M2 12h20"},"children":[]}]},{"tag":"span","props":{},"children":["Русский"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]}]},{"tag":"a","props":{"className":"life-account","href":"/ru/sign-in"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"17","height":"17","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle-user-round","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M18 20a6 6 0 0 0-12 0"},"children":[]},{"tag":"circle","props":{"cx":"12","cy":"10","r":"4"},"children":[]},{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},{"tag":"span","props":{},"children":["Войти"]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/ru/book/17"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"К содержанию"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["Пожилые люди в семье"]},{"tag":"nav","props":{"aria-label":"Советы главы"},"children":[{"tag":"a","props":{"href":"/ru/tip/17-01"},"children":[{"tag":"span","props":{},"children":["01"]},"Возьмите согласие у пожилого человека, пока он в здравом уме, и оформите письменное назначение опекуна"]},{"tag":"a","props":{"href":"/ru/tip/17-02"},"children":[{"tag":"span","props":{},"children":["02"]},"Составление завещания: важно помнить, что более позднее завещание отменяет предыдущее, а нотариально заверенное больше не имеет приоритета"]},{"tag":"a","props":{"href":"/ru/tip/17-03"},"children":[{"tag":"span","props":{},"children":["03"]},"Деньги пожилых людей следует хранить отдельно на специальном счёте, а для крупных трат ввести правило двойного подтверждения"]},{"tag":"a","props":{"href":"/ru/tip/17-04"},"children":[{"tag":"span","props":{},"children":["04"]},"Фраза, которую пожилой человек может произнести в любой момент, чтобы отговориться от нежелательных предложений"]},{"tag":"a","props":{"href":"/ru/tip/17-05"},"children":[{"tag":"span","props":{},"children":["05"]},"Не стоит связываться ни с какими схемами «инвестиций в пенсионное обеспечение», где от пожилых людей требуют предоплаты: оформление карт, покупка мест в домах престарелых, приобретение жилья для пенсионеров, организация путешествий для пожилых и продажа товаров для них — всё это одна и та же схема незаконного привлечения средств"]},{"tag":"a","props":{"href":"/ru/tip/17-06"},"children":[{"tag":"span","props":{},"children":["06"]},"Не стоит связываться ни с какими другими программами «пенсия на основе недвижимости», кроме официальной программы страховых компаний. Ни в коем случае не давайте в залог свой дом ради покупки финансовых продуктов"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/ru/tip/17-07","data-status":"active"},"children":[{"tag":"span","props":{},"children":["07"]},"Пожилые люди, которые длительное время лежат в постели или имеют тяжелую утрату функций, могут обратиться в органы медстраховки по месту регистрации за оформлением страховки на длительный уход; она предназначена не только для пожилых"]},{"tag":"a","props":{"href":"/ru/tip/17-08"},"children":[{"tag":"span","props":{},"children":["08"]},"Если в семье кто-то длительное время прикован к постели, пролежни становятся главной угрозой: нужно купить электрическую воздушную подушку, регулярно переворачивать больного и каждый день проверять места с выступающими костями"]},{"tag":"a","props":{"href":"/ru/tip/17-09"},"children":[{"tag":"span","props":{},"children":["09"]},"Если катаракта у пожилого человека уже мешает безопасно ходить, идите к офтальмологу за оценкой операции; при двух глазах второй не откладывайте надолго"]},{"tag":"a","props":{"href":"/ru/tip/17-10"},"children":[{"tag":"span","props":{},"children":["10"]},"Если пожилой человек выгуливает собаку, держите поводок в ладони, а не наматывайте на руку, делайте его короче и сначала приучите собаку не рваться вперёд на поводке"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"Навигация"},"children":[{"tag":"a","props":{"href":"/ru/book"},"children":["Книга"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/ru/book/17"},"children":["Глава 17"," ·"," ","Пожилые люди в семье"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"17-07"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["07"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["Доказательства"," ","A"]}]},{"tag":"h1","props":{"lang":"ru"},"children":["Пожилые люди, которые длительное время лежат в постели или имеют тяжелую утрату функций, могут обратиться в органы медстраховки по месту регистрации за оформлением страховки на длительный уход; она предназначена не только для пожилых"]},{"tag":"p","props":{"lang":"ru","className":"life-entry-summary"},"children":["Страховка на длительный уход помогает оплачивать услуги по уходу за счёт фонда медстраховки. Люди с тяжелой утратой функций, чьё состояние сохраняется более полугода, могут подать заявление в органы медстраховки по месту регистрации. При соблюдении всех условий расходы на уход не нужно предварительно оплачивать из собственных средств: при страховании по программе для работников фонд возмещает около 70% расходов, а при страховании по программе для жителей сельской местности и городов — около 50%. При этом расходы на проживание в стационаре, питание и прочее не покрываются. Часто её путают с программой по уходу за пожилыми, однако в документах указано «застрахованные лица» без ограничений по возрасту, поэтому подать заявление могут и молодые люди с тяжелой утратой функций."]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Затраты"]},{"tag":"p","props":{},"children":["Для оформления нужно один раз подать заявление в органы ме…"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Польза"]},{"tag":"p","props":{},"children":["Для оплачиваемых по страховке услуг по длительному уходу не установлен порог первоначальных расходов, то есть…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"Отметить: Пожилые люди, которые длительное время лежат в постели или имеют тяжелую утрату функций, могут обратиться в органы медстраховки по месту регистрации за оформлением страховки на длительный уход; она предназначена не только для пожилых"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"Сделано"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"В планах"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"В избранное"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Поделиться советом"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Скрыть подробности"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Затраты"]},{"tag":"p","props":{},"children":["Для оформления нужно один раз подать заявление в органы медстраховки по месту регистрации и пройти оценку степени утраты функций. Если оценка проходит с первого раза, её стоимость оплачивает фонд страхования, то есть платить за неё не придётся."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Польза"]},{"tag":"p","props":{},"children":["Для оплачиваемых по страховке услуг по длительному уходу не установлен порог первоначальных расходов, то есть не нужно сначала оплачивать определённую сумму из собственных средств. При страховании по программе для работников фонд возмещает около 70% расходов, а при страховании по программе для жителей сельской местности и городов — около 50%. Максимальная сумма выплат за год (годовой лимит) не превышает 50% среднедушевого располагаемого дохода жителей этого региона за предыдущий год."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Первоисточники"]},{"tag":"p","props":{"className":"life-citations"},"children":["国家医保局等八部门 (2026). 关于印发《加快建立长期护理保险制度实施方案》的通知. ",{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/202603/content_7063915.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/zhengce/zhengceku/202603/content_7063915.htm"]},"：保障对象为「按规定参保缴费且失能状态长期持续（一般为6个月以上），经申请通过评估认定的失能人员」，「制度起步阶段保障重度失能人员」；「待遇享受不设起付标准。符合规定的长期护理服务费用，按未就业城乡居民参保政策参保的，基金支付比例为50%左右；按单位职工参保政策参保的，基金支付比例为70%左右，退休人员享受单位职工参保待遇」；「参保人员基金年度最高支付限额不超过统筹地区上年度城乡居民人均可支配收入的50%」；「待遇享受固定等待期原则上按照6个月设置」；另见中共中央办公厅、国务院办公厅《关于加快建立长期护理保险制度的意见》. ",{"tag":"a","props":{"href":"https://www.gov.cn/gongbao/2026/issue_12666/202604/content_7065119.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/gongbao/2026/issue_12666/202604/content_7065119.html"]}]},{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/202603/content_7063915.htm","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Открыть источник"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Примечание автора"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["Для оформления страховки состояние утраты функций должно быть «длительным и постоянным (обычно более 6 месяцев)»; несколько недель после госпитализации ещё не дают права на оформление. Перед получением выплат существует 6-месячный период ожидания. Расходы на проживание в стационаре, питание и прочее, не связанные с уходом, страховкой не покрываются. Медицинские расходы, которые должна оплачивать обычная медстраховка, также не входят в компетенцию этой программы. Лица, уже получающие пособие по уходу по линии страхования от несчастных случаев на производстве, не могут одновременно воспользоваться этими выплатами. Данная страховка и пособие по уходу из двух видов социальных выплат для инвалидов оформляются по разным процедурам и не пересекаются по суммам; подробности см. в пункте 7.8 этого раздела. При получении услуг по уходу дома или в общественных учреждениях действуют льготные проценты возмещения, поэтому не обязательно помещать пациента в специализированное учреждение. Программа внедряется в разных регионах поэтапно, поэтому критерии оценки утраты функций могут отличаться. Сначала позвоните по номеру 12393 или в органы медстраховки по месту регистрации, чтобы узнать, запущена ли программа в вашем регионе и как записаться на оценку. Если оценка не пройдена с первого раза, не стоит отчаиваться: при ухудшении состояния можно подать заявление повторно."]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Моя заметка"]},{"tag":"button","props":{"type":"button"},"children":["Запишите напоминание…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/ru/tip/17-06"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Предыдущий"]},"Не стоит связываться ни с какими другими программами «пенсия на основе недвижимости», кроме официальной программы страховых компаний. Ни в коем случае не давайте в залог свой дом ради покупки финансовых продуктов"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/ru/tip/17-08"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Следующий"]},"Если в семье кто-то длительное время прикован к постели, пролежни становятся главной угрозой: нужно купить электрическую воздушную подушку, регулярно переворачивать больного и каждый день проверять места с выступающими костями"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["Другие советы по этой теме"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/17-02"},"children":[{"tag":"strong","props":{},"children":["Составление завещания: важно помнить, что более позднее завещание отменяет предыдущее, а нотариально заверенное больше не имеет приоритета"]},{"tag":"span","props":{},"children":["Закон признает шесть видов завещаний, но при несоблюдении формальных …"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/17-03"},"children":[{"tag":"strong","props":{},"children":["Деньги пожилых людей следует хранить отдельно на специальном счёте, а для крупных трат ввести правило двойного подтверждения"]},{"tag":"span","props":{},"children":["Мошенники сначала дарят пожилым мелочи и окружают заботой, накапливаю…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/17-04"},"children":[{"tag":"strong","props":{},"children":["Фраза, которую пожилой человек может произнести в любой момент, чтобы отговориться от нежелательных предложений"]},{"tag":"span","props":{},"children":["Продавцы и мошенники давят на месте, чтобы вы заплатили без размышлен…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/17-05"},"children":[{"tag":"strong","props":{},"children":["Не стоит связываться ни с какими схемами «инвестиций в пенсионное обеспечение», где от пожилых людей требуют предоплаты: оформление карт, покупка мест в домах престарелых, приобретение жилья для пенсионеров, организация путешествий для пожилых и продажа товаров для них — всё это одна и та же схема незаконного привлечения средств"]},{"tag":"span","props":{},"children":["Любая схема пенсионного обеспечения, где от пожилых людей требуют пре…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/17-09"},"children":[{"tag":"strong","props":{},"children":["Если катаракта у пожилого человека уже мешает безопасно ходить, идите к офтальмологу за оценкой операции; при двух глазах второй не откладывайте надолго"]},{"tag":"span","props":{},"children":["У женщин 70+ ранняя операция на первом глазу за год снизила число пад…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/17-10"},"children":[{"tag":"strong","props":{},"children":["Если пожилой человек выгуливает собаку, держите поводок в ладони, а не наматывайте на руку, делайте его короче и сначала приучите собаку не рваться вперёд на поводке"]},{"tag":"span","props":{},"children":["В США число переломов у людей от 65 лет при прогулке с собакой на пов…"]}]}]}]},{"tag":"a","props":{"className":"life-text-link","href":"/ru/book/17"},"children":["Читать всю тему: Пожилые люди в семье"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"15","height":"15","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]}]}]},{"tag":"nav","props":{"className":"life-tabbar","aria-label":"Основная навигация"},"children":[{"tag":"a","props":{"className":"","href":"/ru/book"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg",