ght":"17","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-moon life-theme-icon-dark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"},"children":[]}]}]},{"tag":"button","props":{"type":"button","className":"life-language-switch","aria-label":"中文 选择语言","aria-haspopup":"menu","aria-expanded":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-globe","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]},{"tag":"path","props":{"d":"M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"},"children":[]},{"tag":"path","props":{"d":"M2 12h20"},"children":[]}]},{"tag":"span","props":{},"children":["中文"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]}]},{"tag":"a","props":{"className":"life-account","href":"/sign-in"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"17","height":"17","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle-user-round","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M18 20a6 6 0 0 0-12 0"},"children":[]},{"tag":"circle","props":{"cx":"12","cy":"10","r":"4"},"children":[]},{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},{"tag":"span","props":{},"children":["登录同步"]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/book/16"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"返回目录"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["得了慢性病之后怎么活"]},{"tag":"nav","props":{"aria-label":"章节条目"},"children":[{"tag":"a","props":{"href":"/tip/16-01","className":""},"children":[{"tag":"span","props":{},"children":["01"]},"药按医嘱吃满，别感觉好了就停"]},{"tag":"a","props":{"href":"/tip/16-02","className":""},"children":[{"tag":"span","props":{},"children":["02"]},"先办门诊慢特病认定再办异地备案，高血压、糖尿病、放化疗、透析、抗排异就能异地直接结算"]},{"tag":"a","props":{"href":"/tip/16-03","className":""},"children":[{"tag":"span","props":{},"children":["03"]},"复查按医生给的间隔做，把每次的指标记在同一个本子上"]},{"tag":"a","props":{"href":"/tip/16-04","className":""},"children":[{"tag":"span","props":{},"children":["04"]},"别为了试偏方、保健品停掉正规治疗"]},{"tag":"a","props":{"href":"/tip/16-05","className":""},"children":[{"tag":"span","props":{},"children":["05"]},"病情稳定的慢性病，在社区医院一次可以开到 12 周的药"]},{"tag":"a","props":{"href":"/tip/16-06","className":""},"children":[{"tag":"span","props":{},"children":["06"]},"在社区签家庭医生之前，问清楚哪些进医保、哪些自费"]},{"tag":"a","props":{"href":"/tip/16-07","className":""},"children":[{"tag":"span","props":{},"children":["07"]},"确诊糖尿病就去查一次眼底，之后按医生给的间隔查；每年查一次脚"]},{"tag":"a","props":{"href":"/tip/16-08","className":""},"children":[{"tag":"span","props":{},"children":["08"]},"得过肾结石就把水喝到每天 2.5–3 升，盐降到 6 克以内"]},{"tag":"a","props":{"href":"/tip/16-09","className":""},"children":[{"tag":"span","props":{},"children":["09"]},"确诊痛风后长了痛风石、影像上看到骨头被啃出缺损或每年发作 2 次以上的，就长期吃降尿酸药，把血尿酸压到 360 µmol/L 以下并一直维持"]},{"tag":"a","props":{"href":"/tip/16-10","className":"active"},"children":[{"tag":"span","props":{},"children":["10"]},"得过痛风的，吃烧烤、聚餐时别一顿吃下大量肉和海鲜，酒也要少喝"]},{"tag":"a","props":{"href":"/tip/16-11","className":""},"children":[{"tag":"span","props":{},"children":["11"]},"查出乙肝表面抗原阳性的，每半年做一次肝脏 B 超加甲胎蛋白，按医生评估决定吃不吃抗病毒药，吃上了别自己停"]},{"tag":"a","props":{"href":"/tip/16-12","className":""},"children":[{"tag":"span","props":{},"children":["12"]},"确诊慢阻肺的，复诊时让医生或药师看你当面用一遍吸入剂；因为急性加重住过院的，出院后去做肺康复"]},{"tag":"a","props":{"href":"/tip/16-13","className":""},"children":[{"tag":"span","props":{},"children":["13"]},"有糖尿病的每年查一次尿白蛋白肌酐比和血肌酐，有高血压的也要查，早点发现慢性肾病"]},{"tag":"a","props":{"href":"/tip/16-14","className":""},"children":[{"tag":"span","props":{},"children":["14"]},"结肠癌做完手术和化疗的，参加有人指导的运动方案，坚持练满三年"]}]}]},{"tag":"div","props":{"className":"life-tip-page","data-tip-locales":"zh"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"当前位置"},"children":[{"tag":"a","props":{"href":"/book"},"children":["阅读全书"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/book/16"},"children":["第 16 章 · 得了慢性病之后怎么活"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"16-10"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["10"]},{"tag":"span","props":{"className":"life-evidence grade-b"},"children":["证据 B"]}]},{"tag":"h1","props":{"lang":"zh"},"children":["得过痛风的，吃烧烤、聚餐时别一顿吃下大量肉和海鲜，酒也要少喝"]},{"tag":"p","props":{"lang":"zh","className":"life-entry-summary"},"children":["得过痛风的人，前两天吃进的嘌呤最多时，发作的可能是吃得最少时的近 5 倍，吃着降尿酸药也一样。前一天喝了两到四杯酒，发作的可能高约一半，啤酒、白酒、葡萄酒都算。"]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["成本"]},{"tag":"p","props":{},"children":["不花钱。吃烧烤、聚餐时少点肉串和海鲜，少喝酒。难在饭桌上管住自己。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["收益"]},{"tag":"p","props":{},"children":["一项研究在网上跟踪 633 名痛风病人 1 年，拿每个人发作前的两天和他自己没发作的两天比（病例交叉研究）。嘌呤是食物里的一种成分，在体内会变成尿酸。把两天吃进的嘌呤总量从少到多分成五档，和最少那档比，后四档发作的可能分别是 1.17、1.38、2.21、4.76 倍（OR，趋势 P<0.001）。…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"标记：得过痛风的，吃烧烤、聚餐时别一顿吃下大量肉和海鲜，酒也要少喝"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"已做到"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"加入待做"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"收藏"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"分享这条建议"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"收起详情"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["成本"]},{"tag":"p","props":{"className":"life-citations"},"children":["不花钱。吃烧烤、聚餐时少点肉串和海鲜，少喝酒。难在饭桌上管住自己。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["收益"]},{"tag":"p","props":{"className":"life-citations"},"children":["一项研究在网上跟踪 633 名痛风病人 1 年，拿每个人发作前的两天和他自己没发作的两天比（病例交叉研究）。嘌呤是食物里的一种成分，在体内会变成尿酸。把两天吃进的嘌呤总量从少到多分成五档，和最少那档比，后四档发作的可能分别是 1.17、1.38、2.21、4.76 倍（OR，趋势 P<0.001）。只算动物来源的嘌呤，是 1.42、1.34、1.77、2.41 倍。只算植物来源的，是 1.12、0.99、1.32、1.39 倍。按性别、喝不喝酒、吃不吃利尿药、别嘌醇、消炎止痛药、秋水仙碱分开看，结果都一样。同一批研究者的另一项研究看了 724 名痛风病人发作前 24 小时喝的酒。和没喝的比，喝 1 杯以上到 2 杯的是 1.36 倍（95% CI 1.00–1.88，可信范围），2 杯以上到 4 杯的是 1.51 倍（1.09–2.09）。葡萄酒、啤酒、烈酒各自都和发作有关。没得过痛风的人看另一项跟踪研究：美国 47150 名男性跟踪 12 年，只记录、不分组。肉吃得最多的五分之一，比最少的五分之一得痛风的风险高约 41%（RR 1.41，1.07–1.86）。海鲜高约 51%（1.51，1.17–1.95）。奶制品吃得最多的反而低约 44%（0.56，0.42–0.74）。嘌呤多的蔬菜和蛋白质总量看不出关系。同一批人里，每天多喝一瓶 12 盎司（约 355 毫升）啤酒，风险高约 49%（1.49，1.32–1.70）。烈酒每天一杯高约 15%（1.15，1.04–1.28）。葡萄酒看不出统计上的差别（1.04，0.88–1.22）"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["来源"]},{"tag":"p","props":{"className":"life-citations"},"children":["Zhang Y, Chen C, Choi H, Chaisson C, Hunter D, Niu J, Neogi T (2012). Purine-rich foods intake and recurrent gout attacks. Annals of the Rheumatic Diseases, 71(9), 1448-1453. ",{"tag":"a","props":{"href":"https://doi.org/10.1136/annrheumdis-2011-201215","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1136/annrheumdis-2011-201215"]},"；Neogi T, Chen C, Niu J, Chaisson C, Hunter DJ, Zhang Y (2014). Alcohol quantity and type on risk of recurrent gout attacks: an internet-based case-crossover study. The American Journal of Medicine, 127(4), 311-318. ",{"tag":"a","props":{"href":"https://doi.org/10.1016/j.amjmed.2013.12.019","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1016/j.amjmed.2013.12.019"]},"；Choi HK, Atkinson K, Karlson EW, Willett W, Curhan G (2004). Purine-rich foods, dairy and protein intake, and the risk of gout in men. New England Journal of Medicine, 350(11), 1093-1103. ",{"tag":"a","props":{"href":"https://doi.org/10.1056/NEJMoa035700","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1056/NEJMoa035700"]},"；Choi HK, Atkinson K, Karlson EW, Willett W, Curhan G (2004). Alcohol intake and risk of incident gout in men: a prospective study. Lancet, 363(9417), 1277-1281. ",{"tag":"a","props":{"href":"https://doi.org/10.1016/S0140-6736(04)16000-5","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1016/S0140-6736(04)16000-5"]},"；Major TJ, Topless RK, Dalbeth N, Merriman TR (2018). Evaluation of the diet wide contribution to serum urate levels: meta-analysis of population based cohorts. BMJ, 363, k3951. ",{"tag":"a","props":{"href":"https://doi.org/10.1136/bmj.k3951","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1136/bmj.k3951"]},""]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["原书备注"]},{"tag":"p","props":{"className":"life-citations"},"children":["主要写给已经发作过的人。没得过痛风的人，吃什么对尿酸的影响比一般人想的小。美国 16760 名没有痛风的白人成年人里，饮食习惯能解释的血尿酸差别不超过 0.3%，常见的基因差别能解释 23.9%。所以身边有人吃烧烤喝啤酒吃出了痛风，饮食是诱因之一，体质占得更多。研究看的是吃下去的肉、海鲜和酒的量，不分烤不烤，凉菜海鲜配啤酒一样算。三项研究都只跟踪记录、不分组，发作时吃了什么是病人自己在网上报的，对象都是美国人，中国人的数据没找到。奶制品那个数也只是跟踪记录，没有试验证明多喝奶能防痛风。少吃不能代替降尿酸药，靠忌口降得有限，见第 9 条（确诊痛风就长期吃降尿酸药）。加工肉和酒按死亡率算的账见第 2 节第 18 条（少吃加工肉）和第 2 节第 19 条（少喝或不喝酒）"]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["我的备注"]},{"tag":"button","props":{"type":"button"},"children":["写下对自己有用的提醒…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/tip/16-09"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["上一条"]},"确诊痛风后长了痛风石、影像上看到骨头被啃出缺损或每年发作 2 次以上的，就长期吃降尿酸药，把血尿酸压到 360 µmol/L 以下并一直维持"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/tip/16-11"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["下一条"]},"查出乙肝表面抗原阳性的，每半年做一次肝脏 B 超加甲胎蛋白，按医生评估决定吃不吃抗病毒药，吃上了别自己停"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["本主题的其他建议"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/16-03"},"children":[{"tag":"strong","props":{},"children":["复查按医生给的间隔做，把每次的指标记在同一个本子上"]},{"tag":"span","props":{},"children":["慢性病看的是一段时间里的变化，不是某一次的数值。光自己在家量血压，看不出血压因此降下来。把读数带给医生、让医生照着调药，血压才降得多一些。换医院时，标着互认标志…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/16-04"},"children":[{"tag":"strong","props":{},"children":["别为了试偏方、保健品停掉正规治疗"]},{"tag":"span","props":{},"children":["本来能治的癌症，只用替代疗法、不做正规治疗的人，死亡风险是正规治疗的 2.5 倍。边治边用补充疗法的人更常拒绝手术、化疗和放疗，多出来的死亡就出在这里。有的草药…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/16-05"},"children":[{"tag":"strong","props":{},"children":["病情稳定的慢性病，在社区医院一次可以开到 12 周的药"]},{"tag":"span","props":{},"children":["病情稳定、吃的药也没换的人，在社区卫生服务中心一次最多能开 12 周的药。省掉每月往返大医院排队挂号的半天。在同一个参保地里，住基层医院的报销比例原则上要比上一…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/16-06"},"children":[{"tag":"strong","props":{},"children":["在社区签家庭医生之前，问清楚哪些进医保、哪些自费"]},{"tag":"span","props":{},"children":["签约的基本服务包按规定走医保。个性化服务包的钱要全部自己出。有人推销「升级包」的时候，先问清楚这是基本包还是个性化包、备没备案、一年多少钱。"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/16-07"},"children":[{"tag":"strong","props":{},"children":["确诊糖尿病就去查一次眼底，之后按医生给的间隔查；每年查一次脚"]},{"tag":"span","props":{},"children":["糖尿病伤到眼底、伤到脚，在坏到看不见、烂起来之前几乎没有感觉。早查出来还有得治。2 型糖尿病确诊当时就查一次散瞳眼底，1 型在发病 5 年后开始查。查过一两次没…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/16-08"},"children":[{"tag":"strong","props":{},"children":["得过肾结石就把水喝到每天 2.5–3 升，盐降到 6 克以内"]},{"tag":"span","props":{},"children":["第一次长了钙结石、又查不出原因的人，什么都不做的话，五年里约四分之一会再长。每天把水喝够的人，五年里复发的只有一成多，少了一半多。英国指南给的量是每天喝 2.5…"]}]}]}]},{"tag":"a","props":{"className":"life-text-link","href":"/book/16"},"children":["阅读整个主题：得了慢性病之后怎么活 ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"15","height":"15","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]}]}]},{"tag":"nav","props":{"className":"life-tabbar","aria-label":"主导航"},"children":[{"tag":"a","props":{"className":"","href":"/book"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"21","height":"21","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-book-open","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M12 7v14"},"children":[]},{"tag":"path","props":{"d":"M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1