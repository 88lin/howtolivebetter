":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"分享这条建议"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"收起详情"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["成本"]},{"tag":"p","props":{"className":"life-citations"},"children":["不花钱。要花点时间接一家持牌支付机构的产品。持牌支付机构就是拿到了央行支付牌照的公司。用它的分账或者担保交易功能，买家的钱直接结给卖家，不进平台自己的账户"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["收益"]},{"tag":"p","props":{"className":"life-citations"},"children":["法规说的支付业务，是「根据收款人或者付款人提交的电子支付指令转移货币资金」。说白了就是按别人的指令替人转钱。要做这门生意，「应当经中国人民银行批准，取得支付业务许可」。注册资本最低 1 亿元，而且是实缴货币资本，这 1 亿元要真金白银打进公司账户。「未经依法批准，擅自设立非银行支付机构、从事或者变相从事支付业务的，由中国人民银行依法予以取缔，没收违法所得」。没批准就干这件事的，直接关停，挣的钱收走。违法所得 50 万元以上的，再罚违法所得的 1 到 5 倍。没有违法所得、或者不足 50 万元的，罚 50 万到 200 万元。法定代表人和直接负责的人另外罚 10 万到 50 万元。刑法还把「非法从事资金支付结算业务」算作非法经营。情节严重的判 5 年以下，特别严重的判 5 年以上。什么算「情节严重」，最高人民法院和最高人民检察院的解释里划了线。这条线是非法经营数额 500 万元以上，或者违法所得 10 万元以上（全国，2024 年 5 月起）"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["来源"]},{"tag":"p","props":{"className":"life-citations"},"children":["国务院 (2023). 非银行支付机构监督管理条例（国务院令第 768 号，第二、六、八、二十七、四十七条）. ",{"tag":"a","props":{"href":"https://www.gov.cn/gongbao/2024/issue_11086/202401/content_6924970.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/gongbao/2024/issue_11086/202401/content_6924970.html"]}," ; 中国人民银行 (2024). 非银行支付机构监督管理条例实施细则（中国人民银行令〔2024〕第 4 号，第六十八条）. ",{"tag":"a","props":{"href":"https://www.gov.cn/gongbao/2024/issue_11546/202408/content_6970979.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/gongbao/2024/issue_11546/202408/content_6970979.html"]}," ; 全国人大 (1997). 刑法（第二百二十五条第三项）. ",{"tag":"a","props":{"href":"https://www.spp.gov.cn/spp/fl/201802/t20180206_364975.shtml","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.spp.gov.cn/spp/fl/201802/t20180206_364975.shtml"]}," ; 最高人民法院、最高人民检察院 (2019). 关于办理非法从事资金支付结算业务、非法买卖外汇刑事案件适用法律若干问题的解释（第一、三、四条）. ",{"tag":"a","props":{"href":"https://www.spp.gov.cn/xwfbh/wsfbt/201901/t20190131_407161.shtml","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.spp.gov.cn/xwfbh/wsfbt/201901/t20190131_407161.shtml"]},""]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["原书备注"]},{"tag":"p","props":{"className":"life-citations"},"children":["把钱设计成不进你的账户，这是唯一稳妥的做法。市面上管这种代收代付叫「二清」，但官方文件里没有这个词。实施细则用的说法是「变相从事支付业务」，意思是没经批准却按用户的指令替人转钱。最高人民法院和最高人民检察院的那份解释只列了三种情形：编假交易套现、用单位账户套现、用支票套现。它没有点名平台代收代付，所以不能说平台代收代付「一定构成犯罪」"]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["我的备注"]},{"tag":"button","props":{"type":"button"},"children":["写下对自己有用的提醒…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"span","props":{},"children":[]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/tip/26-02"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["下一条"]},"收费的网站多数要许可证，自己卖货不让别人入驻的不用，撮合交易的是另一类许可，免费的只要备案"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["本主题的其他建议"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/26-03"},"children":[{"tag":"strong","props":{},"children":["做直播要网络文化经营许可证，做视听节目的那张证民营基本拿不到"]},{"tag":"span","props":{},"children":["做直播、做游戏解说，要省级文化部门发的网络文化经营许可证。证上的经营范围里得写明网络表演。受理后 20 日内出结果，证管 3 年。播过的视频自己要留满 60 天…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/26-04"},"children":[{"tag":"strong","props":{},"children":["服务器放境内就要备案，接入商必须自己持有增值电信许可"]},{"tag":"span","props":{},"children":["服务器放在境内，开站前就要备案。备案不花钱，跟着服务器在服务商那里提交，一般几天到几周。没备案会被责令限期改正，再罚 1 万元，不改就关站。主页上不挂备案号，另…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/26-05"},"children":[{"tag":"strong","props":{},"children":["让用户上来卖东西，平台就要核验登记、报送信息、留存三年"]},{"tag":"span","props":{},"children":["让别人上你的平台卖东西，你就要先核卖家的身份、地址、联系方式和许可证，再登记建档。建完档，至少每六个月回头再核一次。卖家是谁要报给市场监管，纳税的情况每季度报给…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/26-06"},"children":[{"tag":"strong","props":{},"children":["用户发的内容你要管：审核机制、举报入口、发现违法立即停传并报告"]},{"tag":"span","props":{},"children":["用户发的东西，出了事由平台负责。你要把这套制度建起来：注册、发帖审核、评论审核、每天巡查、出事怎么处置。页面显眼的地方放举报入口。看到违法信息，马上停止传播、留…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/26-07"},"children":[{"tag":"strong","props":{},"children":["提供信息发布、即时通讯服务，必须要求用户提供真实身份信息"]},{"tag":"span","props":{},"children":["你的网站能发帖，或者能聊天，就要在用户开通服务时要他的真实身份信息。不给的，不能让他用。做法是后台存真名，页面上显示什么昵称由他自己定，核验用手机号就行。不做实…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/26-08"},"children":[{"tag":"strong","props":{},"children":["不给未满 16 周岁的人开直播，打赏按年龄分档处理"]},{"tag":"span","props":{},"children":["不满 16 周岁的人，不能在你这里注册开播账号。满 16 周岁的要核验身份，还要父母或其他监护人同意。打赏分三档：不满 8 岁不能打赏，8 到 16 岁要监护人…"]}]}]}]},{"tag":"a","props":{"className":"life-text-link","href":"/book/26"},"children":["阅读整个主题：做一个网站或平台：资质、备案和服务器 ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"15","height":"15","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]}]}]}]},{"tag":"aside","props":{"className":"life-ad-space life-ad-space-sponsored","data-ad-placement":"ad_footer","data-ad-group":"reading","data-ad-creative":"read_product","data-ad-ready":"false","aria-label":"广告 · 社区推荐"},"children":[{"tag":"div","props":{"className":"life-ad-space-brand"},"children":[{"tag":"img","props":{"src":"/sites/howtolivebetter/images/shengcai/logo.png","width":"565","height":"144","alt":"生财有术官方 Logo","decoding":"async"},"children":[]}]},{"tag":"div","props":{"className":"life-ad-space-copy"},"children":[{"tag":"span","props":{"className":"life-ad-space-label"},"children":["广告 · 社区推荐"]},{"tag":"strong","props":{},"children":["读过的知识，能不能做成有用的产品？"]},{"tag":"p","props":{},"children":["从电子书、资料到小工具，看看圈友怎样发现需求，把内容变成实际交付。"]}]},{"tag":"div","props":{"className":"life-ad-space-actions"},"children":[{"tag":"a","props":{"className":"life-ad-space-link","href":"/shengcaiyoushu?sc_group=reading&sc_creative=read