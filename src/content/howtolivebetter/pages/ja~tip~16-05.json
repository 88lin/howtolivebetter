an","props":{},"children":["09"]},"痛風と診断されたら、尿酸値を 360 µmol/L 以下に抑え、それを維持するために長期的な降尿酸薬の服用が必要です"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"現在地"},"children":[{"tag":"a","props":{"href":"/ja/book"},"children":["本を読む"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/ja/book/16"},"children":["第16章"," ·"," ","慢性疾患と共にどう生きるか"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"16-05"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["05"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["エビデンス"," ","A"]}]},{"tag":"h1","props":{"lang":"ja"},"children":["病状が安定している慢性疾患なら、地域のクリニックで一度に 12 週分まで処方可能です"]},{"tag":"p","props":{"lang":"ja","className":"life-entry-summary"},"children":["病状が安定しており、服用している薬も変わっていない人は、地域の保健サービスセンターで一度に 12 週分までの薬を処方してもらえます。これにより、毎月大病院へ行って列に並び、診察予約を取るための半日を節約できます。同じ保険適用地域内であれば、一次医療機関（地域の病院）の自己負担率は、通常、上位の病院よりも10パーセントポイントほど高くなります。"]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["費用・手間"]},{"tag":"p","props":{},"children":["費用はかかりません。地域の保健サービスセンターへ行き、長期処方が可能かどうか一言尋ねるだけです。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["効果"]},{"tag":"p","props":{},"children":["毎月大病院へ行って列に並び、薬を受け取る手間が省けます。同じ保険適用地域（統籌地区とも呼ばれる）内では、原則として一次医療機関の払い戻し率は、上位の病院よりも約 10 パーセントポイント高くなります。"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"記録する：病状が安定している慢性疾患なら、地域のクリニックで一度に 12 週分まで処方可能です"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColo