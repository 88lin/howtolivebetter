:"/ja/book/09"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"目次に戻る"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["一般人が陥りやすい法律のレッドライン"]},{"tag":"div","props":{"data-ad-dock-host":"true"},"children":[]},{"tag":"nav","props":{"aria-label":"この章のヒント"},"children":[{"tag":"a","props":{"href":"/ja/tip/09-01"},"children":[{"tag":"span","props":{},"children":["01"]},"グループ内で、真偽不明の災害、疫病、事件に関する情報を転送しないこと。画像の加工や、AIによる現場画像の捏造を行わないこと"]},{"tag":"a","props":{"href":"/ja/tip/09-02"},"children":[{"tag":"span","props":{},"children":["02"]},"英烈を侮辱する画像、絵文字、コメントを投稿・転送しないこと。国旗や国歌をネタにしないこと。"]},{"tag":"a","props":{"href":"/ja/tip/09-03"},"children":[{"tag":"span","props":{},"children":["03"]},"海外サイトの内容は見た後に閉じるだけ。スクリーンショットも、転送も、グループへの持ち込みも、コメント欄での追随もせず。"]},{"tag":"a","props":{"href":"/ja/tip/09-04"},"children":[{"tag":"span","props":{},"children":["04"]},"アダルト動画は個人で楽しむ分には自由ですが、グループ内に投稿したり、「素材」を販売したり、グループを作成したりしないでください。"]},{"tag":"a","props":{"href":"/ja/tip/09-05"},"children":[{"tag":"span","props":{},"children":["05"]},"「副業」として自分のカードで入金、出金、送金を行うよう指示される案件、どんなに報酬が高くても断ること"]},{"tag":"a","props":{"href":"/ja/tip/09-06"},"children":[{"tag":"span","props":{},"children":["06"]},"「融資書類の偽造」を勧誘し、融資額に応じたキックバックを提示する者がいても、一切応じないこと"]},{"tag":"a","props":{"href":"/ja/tip/09-07"},"children":[{"tag":"span","props":{},"children":["07"]},"拾得銀行カードをそのままにせず、携帯電話や財布を拾った際は持ち去らず、持ち主に連絡するか警察に届ける"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/ja/tip/09-08","data-status":"active"},"children":[{"tag":"span","props":{},"children":["08"]},"特典は自身の真の身分で受け取る。仮想番号による大量のサブアカウント登録や、脆弱性を利用した繰り返し取得は行わない"]},{"tag":"a","props":{"href":"/ja/tip/09-09"},"children":[{"tag":"span","props":{},"children":["09"]},"バルコニーや窓からいかなる物も投げ出さない。吸い殻、ゴミ袋、酒瓶もすべて対象"]},{"tag":"a","props":{"href":"/ja/tip/09-10"},"children":[{"tag":"span","props":{},"children":["10"]},"模造銃、鋼鉄玉銃、エアガンをネットで購入しない、出所不明の「おもちゃの銃」を買わない"]},{"tag":"a","props":{"href":"/ja/tip/09-11"},"children":[{"tag":"span","props":{},"children":["11"]},"ドローンを購入したらまず実名登録を行う。空港、軍事区域、および都市の規制空域では飛行させない。高度制限の解除（ハッキング）は行わない"]},{"tag":"a","props":{"href":"/ja/tip/09-12"},"children":[{"tag":"span","props":{},"children":["12"]},"他人の盗撮をしない。賃貸物件、民泊、ホテルの客室にカメラを設置しない"]},{"tag":"a","props":{"href":"/ja/tip/09-13"},"children":[{"tag":"span","props":{},"children":["13"]},"麻雀やポーカーは可能ですが、手数料を取らない、胴元にならない、場を設けて集金しない、オンラインギャンブルは行わないこと"]},{"tag":"a","props":{"href":"/ja/tip/09-14"},"children":[{"tag":"span","props":{},"children":["14"]},"野生動物を食べない、売買しない、保護動物をペットとして飼育しない"]},{"tag":"a","props":{"href":"/ja/tip/09-15"},"children":[{"tag":"span","props":{},"children":["15"]},"債権回収において、人を拘束したり、監禁したり、相手の自宅まで押しかけて居座ったりしてはいけない"]},{"tag":"a","props":{"href":"/ja/tip/09-16"},"children":[{"tag":"span","props":{},"children":["16"]},"身分証は貸さない、他人の身分証を使わない、他人の身分証で登録・カード作成・チケット購入を行わない"]},{"tag":"a","props":{"href":"/ja/tip/09-17"},"children":[{"tag":"span","props":{},"children":["17"]},"警察に止められたり連行されたりした際は協力すること。押し返さない、殴らない、执法記録カメラを奪わない。飲酒している時はなおさら自制が必要。"]},{"tag":"a","props":{"href":"/ja/tip/09-18"},"children":[{"tag":"span","props":{},"children":["18"]},"相手が 14 歳未満の場合、性交渉は成立しません。「本人の同意」は理由になりません"]},{"tag":"a","props":{"href":"/ja/tip/09-19"},"children":[{"tag":"span","props":{},"children":["19"]},"手を出して人を殴る前に、この代償を計算しておくこと：拘留、賠償、刑罰"]},{"tag":"a","props":{"href":"/ja/tip/09-20"},"children":[{"tag":"span","props":{},"children":["20"]},"子供を育てられない場合、民政局への登録という唯一の合法的な道があります：金銭を受け取って子供を渡すと人身売買罪に問われる可能性があり、放置すれば遺棄罪になります"]},{"tag":"a","props":{"href":"/ja/tip/09-21"},"children":[{"tag":"span","props":{},"children":["21"]},"事故を捏造せず、損失を誇張して保険金を騙し取らないこと：これは保険詐欺罪です。証言、修理、鑑定を手伝った人も共犯となります"]},{"tag":"a","props":{"href":"/ja/tip/09-22"},"children":[{"tag":"span","props":{},"children":["22"]},"自分の臓器を売らない、他人のドナー探しを手伝わない：腎臓が手元に残るのは 2 万強、同じものが転売されると 20 万、売得金は没収され、さらに取引額の 10 倍から 20 倍の罰金が科される"]},{"tag":"a","props":{"href":"/ja/tip/09-23"},"children":[{"tag":"span","props":{},"children":["23"]},"売春をしない：標準的な罰則は 10 日から 15 日の拘留であり、単なる罰金では済みません"]},{"tag":"a","props":{"href":"/ja/tip/09-24"},"children":[{"tag":"span","props":{},"children":["24"]},"漫画の中国語化、映画・ドラマの無断転載、クラウドストレージ資源の共有、海賊版電子書籍の配布は、無償であっても著作権侵害。広告掲載や会員費の徴収があれば、刑事罰の対象となる可能性あり"]},{"tag":"a","props":{"href":"/ja/tip/09-25"},"children":[{"tag":"span","props":{},"children":["25"]},"二次創作を出版・販売する場合は、まず原作者の許諾を得るか、借りたキャラクター名や関係性を自分のものに書き換える"]},{"tag":"a","props":{"href":"/ja/tip/09-26"},"children":[{"tag":"span","props":{},"children":["26"]},"護身のため伸縮警棒、電撃器、短剣、催涙スプレーを買って携帯しない。車内に置くのも携帯に当たる"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"現在地"},"children":[{"tag":"a","props":{"href":"/ja/book"},"children":["本を読む"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/ja/book/09"},"children":["第9章"," ·"," ","一般人が陥りやすい法律のレッドライン"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"09-08"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["08"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["エビデンス"," ","A"]}]},{"tag":"h1","props":{"lang":"ja"},"children":["特典は自身の真の身分で受け取る。仮想番号による大量のサブアカウント登録や、脆弱性を利用した繰り返し取得は行わない"]},{"tag":"p","props":{"lang":"ja","className":"life-entry-summary"},"children":["自身の真の身分を用い、一つのアカウントで一度だけクーポンを受け取ることは、処罰の範囲には含まれません。偽ユーザーを大量に登録し、自分で注文して自分で受注することで大量に取得する行為は、詐欺として扱われます。3000 元の詐欺で 3 年以下の懲役、3 万元以上で 3 から 10 年の懲役となります。ある配達員が、1つ 0.1 元の仮想番号を使用してクーポンを不正利用し、9 万余元を現金化したケースでは、同案の 12 人がすべて刑に処されました。"]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["費用・手間"]},{"tag":"p","props":{},"children":["費用はかかりません。「ポイ活タスクグループ」での活動を断念すること。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["効果"]},{"tag":"p","props":{},"children":["他人または公金を詐取し、その額が較大である場合は、3 年以下の懲役、および罰金（懲役と罰金の両方、または罰金のみが科される可能性がある）に処される。"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"記録する：特典は自身の真の身分で受け取る。仮想番号による大量のサブアカウント登録や、脆弱性を利用した繰り返し取得は行わない"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"できている"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"やることに追加"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"お気に入り"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"このヒントを共有"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"詳細を閉じる"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["費用・手間"]},{"tag":"p","props":{},"children":["費用はかかりません。「ポイ活タスクグループ」での活動を断念すること。プラットフォームに脆弱性を見つけても、手を出さないこと。難しいのは、特典を大量複製可能な収入と考えてしまう誘惑に耐えることです。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["効果"]},{"tag":"p","props":{},"children":["他人または公金を詐取し、その額が較大である場合は、3 年以下の懲役、および罰金（懲役と罰金の両方、または罰金のみが科される可能性がある）に処される。額が巨大である場合、またはその他の重大な情状がある場合は、3 年から 10 年の懲役および罰金に処される。額が特別に巨大である場合、またはその他の特別に重大な情状がある場合は、10 年以上の懲役または無期懲役に処され、罰金または財産の没収が科される。「較大」「巨大」「特別に巨大」の3つの区分については、各省が以下の範囲内で地域の基準を定める。較大は 3000 元から 1 万元以上。巨大は 3 万元から 10 万元以上、特別に巨大は 50 万元以上である。犯罪の手口を他人に教えたり「チュートリアル」を販売したりした者は、犯罪手法の伝授罪により 5 年以下の懲役、重大な場合は 5 年から 10 年の懲役、特に重大な場合は 10 年以上の懲役または無期懲役に処される。携帯電話番号や認証コードの売買に関わる上下流の者は、公民個人情報侵害罪により 3 年以下の懲役、特に重大な場合は 3 年から 7 年の懲役に処される。大量のアカウント、ネットワークアドレスを用いた自動切り替えシステム、および大量のSMS認証を受け取るための受取プラットフォーム（接码平台）の使用は、それ自体が電気通信ネットワーク詐欺防止法第14条で明示的に禁止されている。電話カードやインターネットアカウントの不法な売買、賃貸、貸与、および他人の実名認証を代行することは、第31条に該当する。第14条に違反した場合、得た利益はすべて没収され、さらに得た利益の 1 倍から 10 倍の罰金が科される。利益を得られなかった場合、または得られた利益が 5 万元に満たない場合は、50 万元以下の罰金に処され、情状が重い場合は 15 日以下の拘留に処される。第三十一条に違反した場合は、同様に 1 倍から 10 倍の罰金に処され、利益を得られなかった場合または得られた利益が 2 万元に満たない場合は 20 万元以下の罰金に処され、情状が重い場合は 15 日以下の拘留に処される。电信ネットワーク詐欺に加担し、刑に値するほどではない場合は、10 から 15 日の拘留に処される。得られた利益は没収され、さらに 1 から 10 倍の罰金が科される。利益を得られなかった場合または得られた利益が 1 万元に満たない場合は、10 万元以下の罰金に処される。公式事例1：デリバリー配達員の劉某某は、仮想携帯電話番号を1個 0.1 元で購入し、あるプラットフォームの新規ユーザーとして登録した。彼は 29 から 15 の割引が適用される新規クーポンを上限まで使用して注文を行い、その後、商品を小規模店舗に転売して現金化を図った。彼はまた、仮想番号を使用して互いに招待し合い、2元から20元のボーナスを受け取っていました。彼と配達員の譚某某は、それぞれ9万元余りと7万元余りを詐取しました。上海市楊浦区検察院は12人を詐欺罪で起訴し、裁判所は3年6ヶ月の懲役、または3ヶ月の拘留を言い渡しました。公式事例2：王某は、オンラインショップの返金と仮想抽選コイン回収のタイムラグを利用しました。彼は1156件の返金を行い、フィギュアを224点持ち去り、その金額は24.9万元余りにのぼりました。彼はまた、中古プラットフォームで換金していました。裁判所は詐欺罪により、懲役3年、執行猶予4年を言い渡し、罰金3万元を科しました。彼は審理期間中に詐欺罪で得た利益を返還し、罰金を前払いし、合計で33万元に達しました。公的な事例3：ある配車プラットフォームの新ユーザー向けクーポンおよびドライバーへの補助金が、「自分で配車を依頼し、自分で受注する」という虚偽の走行実績偽装によって詐取された。これは 19 省 70 余の都市に関わり、金額は 200 余万元にのぼる。遼寧省朝陽市龍城区検察院は 163 人を起訴し、全員に有罪判決が下された。主犯の黄某および蔡某は、詐欺罪、公民個人情報侵害罪、犯罪手法伝授罪の併合罪（複数の罪を合算して刑期を算出）により、それぞれ 3 年 6 ヶ月の判決を受けた。また、情状が軽微な共犯者 34 名については、検察院は不起訴処分としたが、行政処分を行うため引き続き公安局へ送致した（全国規模）"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["出典"]},{"tag":"p","props":{"className":"life-citations"},"children":["全国人大 (2020). 刑法（根据刑法修正案（十一）修正，第二百五十三条之一、第二百六十六条、第二百九十五条）. ",{"tag":"a","props":{"href":"https://jtgl.beijing.gov.cn/jgj/jgxx/flfg/fl/11033925/index.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://jtgl.beijing.gov.cn/jgj/jgxx/flfg/fl/11033925/index.html"]},"（北京市公安交通管理局转载）；最高人民法院、最高人民检察院 (2011). 关于办理诈骗刑事案件具体应用法律若干问题的解释（法释〔2011〕7 号，第一条）. ",{"tag":"a","props":{"href":"https://www.spp.gov.cn/spp/sfjs/201802/t20180201_363736.shtml","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.spp.gov.cn/spp/sfjs/201802/t20180201_363736.shtml"]},"；全国人大常委会 (2022). 反电信网络诈骗法（第十四、三十一、三十八、四十二、四十四条）. ",{"tag":"a","props":{"href":"https://www.spp.gov.cn/spp/fl/202209/t20220902_575631.shtml","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.spp.gov.cn/spp/fl/202209/t20220902_575631.shtml"]},"；全国人大 (2020). 民法典（第九百八十五条）. ",{"tag":"a","props":{"href":"https://www.spp.gov.cn/spp/fl/202006/t20200602_463888.shtml","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.spp.gov.cn/spp/fl/202006/t20200602_463888.shtml"]},"；最高人民检察院 (2021). 剑指电信网络诈骗｜不法分子盯上了电商经济的漏洞（检察日报）. ",{"tag":"a","props":{"href":"https://www.spp.gov.cn/spp/zdgz/202106/t20210607_520557.shtml","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.spp.gov.cn/spp/zdgz/202106/t20210607_520557.shtml"]},"；最高人民检察院 (2025). 如此「薅羊毛」涉嫌诈骗（检察日报）. ",{"tag":"a","props":{"href":"https://www.spp.gov.cn/spp/zdgz/202508/t20250826_704625.shtml","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.spp.gov.cn/spp/zdgz/202508/t20250826_704625.shtml"]},"；最高人民检察院 (2024). 辽宁朝阳龙城区：办理系列电信网络诈骗案（法治日报）. ",{"tag":"a","props":{"href":"https://www.spp.gov.cn/spp/zdgz/202401/t20240124_641099.shtml","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.spp.gov.cn/spp/zdgz/202401/t20240124_641099.shtml"]},"；看看新闻 (2026-08-25). 男子网购870多个手机号薅车企羊毛 窃电40余万（记者陈敏佳）. ",{"tag":"a","props":{"href":"https://www.kankanews.com/detail/80290xAJDw6","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.kankanews.com/detail/80290xAJDw6"]},"（网页存档 ",{"tag":"a","props":{"href":"https://web.archive.org/web/20261005044233/https://www.kankanews.com/detail/80290xAJDw6","target":"_blank","rel":"noopener noreferrer"},"children":["https://web.archive.org/web/20261005044233/https://www.kankanews.com/detail/80290xAJDw6"]},"）"]},{"tag":"a","props":{"href":"https://jtgl.beijing.gov.cn/jgj/jgxx/flfg/fl/11033925/index.html","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["出典を開く"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["著者の注記"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["境界は「どれだけ得したか」ではなく、偽りがあるかです。本当の身元で参加し、1 アカウント 1 回の特典を自分に使うなら正規の割引です。多くもらうため架空のユーザーを登録し、取引を捏造し、返金済みを隠すのは、本当だと誤信させて物を渡させる詐欺で、金額は刑期を決めるだけです。自動車会社の無料充電でも事例があります。2026 年 8 月の看看新聞は、上海の 2 人が大量の仮想電話番号を買い、ある新エネルギー自動車会社 App の子アカウントに順次登録したと報じました。各アカウントで「先に充電、後で支払い」を 2 回使って解除し、料金を払わず、充電機会をトラック運転手へ売りました。浦東新区検察院は窃盗ではなく詐欺とし、逮捕を承認しました。報道のみで判決・公式通知はありません。刑事罰の金額に達しなくても、利用停止、特典の回収、不当利得の返還請求があります。電信詐欺に関与し犯罪に達しない場合も拘留と罰金があります。「グループで指示され、件ごとの報酬をもらった」ことは自分の行為の性質を変えません。方法を教えたり、アカウント・電話番号を転売すれば別の罪にもなり、併せて処理されます。受益者はあなた自身です。自作・販売スクリプトは第11節第3項、カード・アカウント販売は第8節第8項（銀行カードを貸す）と本節第16項（身分証を貸さない）を参照してください。"]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["自分のメモ"]},{"tag":"button","props":{"type":"button"},"children":["自分へのメモを書く…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/ja/tip/09-07"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["前へ"]},"拾得銀行カードをそのままにせず、携帯電話や財布を拾った際は持ち去らず、持ち主に連絡するか警察に届ける"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/ja/tip/09-09"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["次へ"]},"バルコニーや窓からいかなる物も投げ出さない。吸い殻、ゴミ袋、酒瓶もすべて対象"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["このテーマの他の提案"]},{"tag":"ul","props":{},"children":[{"tag":