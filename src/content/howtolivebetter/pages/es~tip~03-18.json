ound","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M18 20a6 6 0 0 0-12 0"},"children":[]},{"tag":"circle","props":{"cx":"12","cy":"10","r":"4"},"children":[]},{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},{"tag":"span","props":{},"children":["Iniciar sesión"]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/es/book/03"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"Volver al índice"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["No desperdicies energía"]},{"tag":"nav","props":{"aria-label":"Consejos del capítulo"},"children":[{"tag":"a","props":{"href":"/es/tip/03-01"},"children":[{"tag":"span","props":{},"children":["01"]},"Desactiva las notificaciones no esenciales y deja el teléfono fuera de la vista mientras trabajas"]},{"tag":"a","props":{"href":"/es/tip/03-02"},"children":[{"tag":"span","props":{},"children":["02"]},"Fija una hora de despertar, también los fines de semana"]},{"tag":"a","props":{"href":"/es/tip/03-03"},"children":[{"tag":"span","props":{},"children":["03"]},"Duerme entre 7 y 8 horas cada noche; no des por suficientes 6 horas"]},{"tag":"a","props":{"href":"/es/tip/03-04"},"children":[{"tag":"span","props":{},"children":["04"]},"Nada de cafeína después de las dos de la tarde"]},{"tag":"a","props":{"href":"/es/tip/03-05"},"children":[{"tag":"span","props":{},"children":["05"]},"Revisa el correo y los mensajes en un número fijo de tandas al día"]},{"tag":"a","props":{"href":"/es/tip/03-06"},"children":[{"tag":"span","props":{},"children":["06"]},"Cuando trabajes en algo que exige pensar de corrido, blinda hasta las interrupciones de unos segundos"]},{"tag":"a","props":{"href":"/es/tip/03-07"},"children":[{"tag":"span","props":{},"children":["07"]},"Haz una sola cosa a la vez; no respondas mensajes durante una reunión"]},{"tag":"a","props":{"href":"/es/tip/03-08"},"children":[{"tag":"span","props":{},"children":["08"]},"Una hora antes de dormir, sin pantallas luminosas; si quieres leer, papel o tinta electrónica"]},{"tag":"a","props":{"href":"/es/tip/03-09"},"children":[{"tag":"span","props":{},"children":["09"]},"Dormir a la hora indicada, sin quedarse despierto por videojuegos, videos cortos o contenido pornográfico"]},{"tag":"a","props":{"href":"/es/tip/03-10"},"children":[{"tag":"span","props":{},"children":["10"]},"No tomes decisiones importantes ni envíes mensajes delicados de madrugada"]},{"tag":"a","props":{"href":"/es/tip/03-11"},"children":[{"tag":"span","props":{},"children":["11"]},"Si te da sueño por la tarde, duerme 10 minutos, no media hora"]},{"tag":"a","props":{"href":"/es/tip/03-12"},"children":[{"tag":"span","props":{},"children":["12"]},"En la oficina de planta abierta, usa tapones para los oídos o busca una sala tranquila para el trabajo que exige memoria"]},{"tag":"a","props":{"href":"/es/tip/03-13"},"children":[{"tag":"span","props":{},"children":["13"]},"No aumentes sin límite las horas semanales de trabajo: a partir de unas 49 horas, cada hora extra aporta cada vez menos producción"]},{"tag":"a","props":{"href":"/es/tip/03-14"},"children":[{"tag":"span","props":{},"children":["14"]},"Cuando te descubras dándole vueltas a la misma mala experiencia, cámbialo por una tarea que exija las manos"]},{"tag":"a","props":{"href":"/es/tip/03-15"},"children":[{"tag":"span","props":{},"children":["15"]},"Trata los pensamientos del tipo «seguro que irá a peor» como un síntoma, no como un hecho"]},{"tag":"a","props":{"href":"/es/tip/03-16"},"children":[{"tag":"span","props":{},"children":["16"]},"Reduce las relaciones que te desgastan y aprende a rechazar las peticiones que no quieres atender"]},{"tag":"a","props":{"href":"/es/tip/03-17"},"children":[{"tag":"span","props":{},"children":["17"]},"Cuando te enojes, sal antes de responder; trata al otro como si fuera el tiempo, no un enemigo"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/es/tip/03-18","data-status":"active"},"children":[{"tag":"span","props":{},"children":["18"]},"Cuando el ánimo esté bajo, empieza por lo que tiene mejor relación costo-beneficio: moverte, tomar el sol, dormir a horario, hablar con alguien, llamar al 12356"]},{"tag":"a","props":{"href":"/es/tip/03-19"},"children":[{"tag":"span","props":{},"children":["19"]},"Trata a los policías, médicos y cajeros como personas que trabajan según normas, no como roles: lo que mueve los asuntos son los documentos y los plazos, no la emoción"]},{"tag":"a","props":{"href":"/es/tip/03-20"},"children":[{"tag":"span","props":{},"children":["20"]},"No conviertas «cómo le va a los demás» en lectura diaria: limita o apaga las aplicaciones de novedades de la gente de tu edad"]},{"tag":"a","props":{"href":"/es/tip/03-21"},"children":[{"tag":"span","props":{},"children":["21"]},"Cuando sientas que «todos me han visto hacer el ridículo», divide esa estimación entre dos"]},{"tag":"a","props":{"href":"/es/tip/03-22"},"children":[{"tag":"span","props":{},"children":["22"]},"Trata la idea de «los demás me exigen ser perfecto» como un síntoma, no como un hecho"]},{"tag":"a","props":{"href":"/es/tip/03-23"},"children":[{"tag":"span","props":{},"children":["23"]},"Cuando esté enojado, no intente desahogarse rompiendo cosas, golpeando un saco de boxeo o corriendo; primero calme su cuerpo"]},{"tag":"a","props":{"href":"/es/tip/03-24"},"children":[{"tag":"span","props":{},"children":["24"]},"Escribir durante varios días sobre lo que uno tiene en mente puede ayudar, pero no se debe esperar que cure enfermedades"]},{"tag":"a","props":{"href":"/es/tip/03-25"},"children":[{"tag":"span","props":{},"children":["25"]},"Para el dolor menstrual, toma analgésicos como ibuprofeno en vez de aguantarlo; si te impide trabajar o estudiar o no mejora tras tres meses de medicación, acude a ginecología"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"Ruta de navegación"},"children":[{"tag":"a","props":{"href":"/es/book"},"children":["Libro"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/es/book/03"},"children":["Capítulo 3"," ·"," ","No desperdicies energía"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"03-18"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["18"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["Evidencia"," ","A"]}]},{"tag":"h1","props":{"lang":"es"},"children":["Cuando el ánimo esté bajo, empieza por lo que tiene mejor relación costo-beneficio: moverte, tomar el sol, dormir a horario, hablar con alguien, llamar al 12356"]},{"tag":"p","props":{"lang":"es","className":"life-entry-summary"},"children":["Para la depresión, en un análisis que reúne 218 ensayos aleatorizados, caminar rápido y trotar dieron los mejores resultados, con yoga y entrenamiento de fuerza un poco detrás, y a mayor intensidad, mayor efecto. La exposición a la luz es muy eficaz para la depresión estacional y también funciona en la no estacional. Los cursos de autoayuda de terapia cognitivo-conductual en internet sirven, y con síntomas más marcados es mejor que alguien te acompañe. Si te aparecen pensamientos oscuros, llama primero al 12356."]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Coste"]},{"tag":"p","props":{},"children":["No cuesta dinero, o casi nada. Caminata rápida, trote o en…"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Beneficio"]},{"tag":"p","props":{},"children":["Un metaanálisis en red que reúne 218 ensayos controlados aleatorizados y 14 170 personas: frente a controles q…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"Marcar: Cuando el ánimo esté bajo, empieza por lo que tiene mejor relación costo-beneficio: moverte, tomar el sol, dormir a horario, hablar con alguien, llamar al 12356"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"Hecho"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"Por hacer"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"Guardar"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Compartir consejo"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Ocultar detalles"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Coste"]},{"tag":"p","props":{},"children":["No cuesta dinero, o casi nada. Caminata rápida, trote o entrenamiento de fuerza varias veces por semana. Salir de día a tomar el sol. Un horario fijo. Una llamada cuando las ideas se oscurecen."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Beneficio"]},{"tag":"p","props":{},"children":["Un metaanálisis en red que reúne 218 ensayos controlados aleatorizados y 14 170 personas: frente a controles que también hacían otra actividad, caminar o trotar tiene para la depresión un tamaño de efecto g = -0,62 (intervalo de confianza del 95% de -0,80 a -0,45), yoga -0,55, entrenamiento de fuerza -0,49, y más efecto cuanto mayor la intensidad. Un metaanálisis de terapia de luz: tamaño de efecto 0,84 en depresión estacional (de 0,60 a 1,08) y 0,53 en la no estacional (de 0,18 a 0,89). Otro análisis reúne los datos de cada paciente de los estudios de terapia cognitivo-conductual por internet, es decir, los cursos de autoayuda en línea: con guía y sin guía superan al control, y en los casos moderados o graves es mejor con guía. Moderado o grave significa más de 9 puntos en el PHQ-9. El 12356 es la línea nacional de ayuda psicológica y opera no menos de 18 horas diarias."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Fuentes originales"]},{"tag":"p","props":{"className":"life-citations"},"children":["Noetel M 等 (2024). Effect of exercise for depression: systematic review and network meta-analysis of randomised controlled trials. BMJ. ",{"tag":"a","props":{"href":"https://doi.org/10.1136/bmj-2023-075847","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1136/bmj-2023-075847"]},"；Golden RN 等 (2005). The efficacy of light therapy in the treatment of mood disorders: a review and meta-analysis of the evidence. American Journal of Psychiatry. ",{"tag":"a","props":{"href":"https://doi.org/10.1176/appi.ajp.162.4.656","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1176/appi.ajp.162.4.656"]},"；Karyotaki E 等 (2021). Internet-Based Cognitive Behavioral Therapy for Depression: A Systematic Review and Individual Patient Data Network Meta-analysis. JAMA Psychiatry. ",{"tag":"a","props":{"href":"https://doi.org/10.1001/jamapsychiatry.2020.4364","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1001/jamapsychiatry.2020.4364"]},"；国家卫生健康委 (2024). 关于应用\"12356\"全国统一心理援助热线电话号码的通知（国卫医政函〔2024〕259 号）. ",{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/202412/content_6994470.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/zhengce/zhengceku/202412/content_6994470.htm"]}]},{"tag":"a","props":{"href":"https://doi.org/10.1136/bmj-2023-075847","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Abrir fuente"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Nota del autor"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["Todo esto son medidas de apoyo para la depresión leve o moderada. En casos moderados o graves, o con ideas de suicidio, hay que acudir a un médico, empezando por llamar al 12356 (véase la sección 1, punto 25). Los ensayos de ejercicio son en su mayoría de muestra pequeña, y no se puede cegar a nadie sobre quién hace ejercicio, como se hace con las pastillas. Los estudios de luz llegan hasta 2003 y también con muestras pequeñas. «Dormir a horario» y «hablar con alguien» son experiencia del autor, sin literatura propia. No conviertas «moverte» en una exigencia para quien está deprimido: caminar diez minutos ya cuenta."]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Mi nota"]},{"tag":"button","props":{"type":"button"},"children":["Escribe un recordatorio…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/es/tip/03-17"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Anterior"]},"Cuando te enojes, sal antes de responder; trata al otro como si fuera el tiempo, no un enemigo"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/es/tip/03-19"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Siguiente"]},"Trata a los policías, médicos y cajeros como personas que trabajan según normas, no como roles: lo que mueve los asuntos son los documentos y los plazos, no la emoción"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewB