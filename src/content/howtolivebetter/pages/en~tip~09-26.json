"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-up-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M7 7h10v10"},"children":[]},{"tag":"path","props":{"d":"M7 17 17 7"},"children":[]}]}]}]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/en/book/09"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"Back to index"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["Legal pitfalls that ordinary people often overlook"]},{"tag":"div","props":{"data-ad-dock-host":"true"},"children":[]},{"tag":"nav","props":{"aria-label":"Chapter entries"},"children":[{"tag":"a","props":{"href":"/en/tip/09-01"},"children":[{"tag":"span","props":{},"children":["01"]},"Do not share unverified messages about disasters, epidemics, or police incidents in groups; do not photoshop images or use AI to generate fake scene pictures"]},{"tag":"a","props":{"href":"/en/tip/09-02"},"children":[{"tag":"span","props":{},"children":["02"]},"Do not post, share, or comment images, memes, or remarks that insult heroes and martyrs, nor make jokes about the national flag or anthem"]},{"tag":"a","props":{"href":"/en/tip/09-03"},"children":[{"tag":"span","props":{},"children":["03"]},"After viewing content on foreign websites, simply close the page — do not screenshot, share, repost, or discuss it in any groups or comment sections"]},{"tag":"a","props":{"href":"/en/tip/09-04"},"children":[{"tag":"span","props":{},"children":["04"]},"Watching porn alone is fine, but don’t post it in groups, sell “resources,” or create groups"]},{"tag":"a","props":{"href":"/en/tip/09-05"},"children":[{"tag":"span","props":{},"children":["05"]},"Part-time jobs that ask you to use your own card to receive payments, withdraw cash, or transfer money — no matter how much extra pay they offer, avoid them"]},{"tag":"a","props":{"href":"/en/tip/09-06"},"children":[{"tag":"span","props":{},"children":["06"]},"Some people try to get you to “package loan applicants” for them and offer a commission based on the loan amount — don’t fall for it"]},{"tag":"a","props":{"href":"/en/tip/09-07"},"children":[{"tag":"span","props":{},"children":["07"]},"Keeping found items and not using them for personal gain; returning lost phones, wallets, or cash to owners or police"]},{"tag":"a","props":{"href":"/en/tip/09-08"},"children":[{"tag":"span","props":{},"children":["08"]},"Use your real identity to claim discounts — don’t register fake accounts or exploit loopholes to get more"]},{"tag":"a","props":{"href":"/en/tip/09-09"},"children":[{"tag":"span","props":{},"children":["09"]},"Never throw anything from balconies or windows — cigarette butts, trash bags, and bottles all count"]},{"tag":"a","props":{"href":"/en/tip/09-10"},"children":[{"tag":"span","props":{},"children":["10"]},"Do not buy imitation guns, BB guns, or air rifles online; avoid “toy guns” of unknown origin"]},{"tag":"a","props":{"href":"/en/tip/09-11"},"children":[{"tag":"span","props":{},"children":["11"]},"Register drones with your real name first; never fly near airports, military zones, or restricted urban airspace, and don’t tamper with altitude limits"]},{"tag":"a","props":{"href":"/en/tip/09-12"},"children":[{"tag":"span","props":{},"children":["12"]},"Do not secretly film others, nor install cameras in rented apartments, homestays, or hotel rooms"]},{"tag":"a","props":{"href":"/en/tip/09-13"},"children":[{"tag":"span","props":{},"children":["13"]},"Mahjong and poker can be played — no rake, no banker role, no organizing paid games, no online gambling"]},{"tag":"a","props":{"href":"/en/tip/09-14"},"children":[{"tag":"span","props":{},"children":["14"]},"Do not eat wild animals; do not buy, sell, or keep protected species as pets"]},{"tag":"a","props":{"href":"/en/tip/09-15"},"children":[{"tag":"span","props":{},"children":["15"]},"You cannot detain or confine someone to collect a debt, nor follow them home and refuse to leave"]},{"tag":"a","props":{"href":"/en/tip/09-16"},"children":[{"tag":"span","props":{},"children":["16"]},"Do not lend your ID card, do not use someone else’s ID card, and do not register, open accounts, or buy tickets using another person’s documents"]},{"tag":"a","props":{"href":"/en/tip/09-17"},"children":[{"tag":"span","props":{},"children":["17"]},"Cooperate when stopped or taken away by police — don’t push, hit, or grab their body cameras; especially if you’ve been drinking, stay calm"]},{"tag":"a","props":{"href":"/en/tip/09-18"},"children":[{"tag":"span","props":{},"children":["18"]},"Sexual relations with anyone under 14 are illegal; “she consented” is not a defense"]},{"tag":"a","props":{"href":"/en/tip/09-19"},"children":[{"tag":"span","props":{},"children":["19"]},"Do the math before you hit someone: detention, fines, and prison time"]},{"tag":"a","props":{"href":"/en/tip/09-20"},"children":[{"tag":"span","props":{},"children":["20"]},"If parents cannot care for their newborn, the only legal option is to register the adoption with the civil affairs bureau: paying someone to hand over the child may be prosecuted as child trafficking, while abandoning the child constitutes abandonment"]},{"tag":"a","props":{"href":"/en/tip/09-21"},"children":[{"tag":"span","props":{},"children":["21"]},"Don’t fabricate accidents or exaggerate damages to defraud insurance payouts: this is insurance fraud, and anyone helping you testify, assess damage, or repair your vehicle is equally liable"]},{"tag":"a","props":{"href":"/en/tip/09-22"},"children":[{"tag":"span","props":{},"children":["22"]},"Don’t sell your own organs, and don’t help others find donors: a kidney brings in just over $20,000, but the same kidney can be sold to a patient for $200,000. All proceeds are seized, plus a fine of 10–20 times the transaction amount"]},{"tag":"a","props":{"href":"/en/tip/09-23"},"children":[{"tag":"span","props":{},"children":["23"]},"Don’t engage in prostitution: the default penalty is 10–15 days in detention, not just a fine"]},{"tag":"a","props":{"href":"/en/tip/09-24"},"children":[{"tag":"span","props":{},"children":["24"]},"Distributing unauthorized Chinese-dubbed comics, pirated movies/TV shows, cloud storage links, and pirated e-books — even for free — is illegal; adding ads or charging membership fees can lead to criminal charges"]},{"tag":"a","props":{"href":"/en/tip/09-25"},"children":[{"tag":"span","props":{},"children":["25"]},"To publish or monetize fan works, first obtain permission from the original copyright holder, or replace the borrowed characters’ names and relationships with your own"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/en/tip/09-26","data-status":"active"},"children":[{"tag":"span","props":{},"children":["26"]},"Do not buy and carry batons, stun devices, daggers, or pepper spray for self-defense; keeping them in your car also counts as carrying"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"Breadcrumb"},"children":[{"tag":"a","props":{"href":"/en/book"},"children":["Explore the book"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/en/book/09"},"children":["Chapter 9"," ·"," ","Legal pitfalls that ordinary people often overlook"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"09-26"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["26"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["Evidence"," ","A"]}]},{"tag":"h1","props":{"lang":"en"},"children":["Do not buy and carry batons, stun devices, daggers, or pepper spray for self-defense; keeping them in your car also counts as carrying"]},{"tag":"p","props":{"lang":"en","className":"life-entry-summary"},"children":["If found carrying items such as daggers, switchblades, police batons, or stun devices, you may face up to 5 days’ detention. Taking them into stations, shopping centers, or buses can mean 5 to 10 days. Using them can also work against you: a person who was punched by an unarmed opponent stabbed them with a knife hidden in advance and received 4 years for excessive self-defense."]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Cost"]},{"tag":"p","props":{},"children":["No expense. Keep anything already bought at home;"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Benefit"]},{"tag":"p","props":{},"children":["Start with Article 38 of the Public Security Administration Punishments Law. Illegally carrying state-controll…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"Mark: Do not buy and carry batons, stun devices, daggers, or pepper spray for self-defense; keeping them in your car also counts as carrying"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"Done"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"Plan to do"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"Save"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Share this tip"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Hide details"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Cost"]},{"tag":"p","props":{},"children":["No expense. Keep anything already bought at home; do not carry it outside or put it in the car. If trouble occurs, retreat and call the police first; fight back only if you cannot escape."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Benefit"]},{"tag":"p","props":{},"children":["Start with Article 38 of the Public Security Administration Punishments Law. Illegally carrying state-controlled items such as crossbows and daggers brings up to 5 days’ detention and possibly an additional fine of up to 1000 yuan. Minor circumstances bring a warning or a fine up to 500 yuan. Taking them into public places or public transport brings 5 to 10 days’ detention and possibly an additional fine up to 1000 yuan. Article 130 of the Criminal Law is harsher: illegally carrying controlled knives into public places or public transport, endangering public safety in serious circumstances, carries up to 3 years. The Ministry of Public Security’s 2007 criteria list five classes of controlled knives. First, daggers with a handle, guard, and blood groove and a tip angle below 60 degrees. Second, triangular scrapers. Third, self-locking spring knives, commonly called switchblades. Fourth, knives with a tip angle below 60 degrees and blade longer than 150 mm. Fifth, knives with a tip angle above 60 degrees and blade longer than 220 mm. Unsharpened martial-arts or decorative gift knives with rounded tips are excluded. Police batons are police equipment. The People’s Police Law allows only police to possess and use it. Possession by others entails confiscation, up to 15 days’ detention or a warning, and possibly a fine up to 5 times the unlawful proceeds. The railway prohibited-items list includes police batons, tear-gas devices, stun devices, and defensive devices as controlled items. None may be carried aboard or checked as luggage. Keeping them in a car can also result in enforcement: a driver carrying controlled knives through a checkpoint was found by police and placed in administrative detention. For consequences of actual use, the self-defense guidelines list using or preparing to use a weapon among factors distinguishing defense from mutual fighting. Official case: Yang argued with someone who threatened to find others for revenge. Yang went home and concealed two knives on himself. When the other person returned and punched him in the face with an empty hand, Yang stabbed their chest and abdomen, killing them. The court recognized a defensive element but found excessive self-defense because the attack was an unarmed punch and the stabbing targeted vital areas. He received 4 years for intentional injury (nationwide; the Public Security Administration Punishments Law took effect January 1, 2026)."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Original sources"]},{"tag":"p","props":{"className":"life-citations"},"children":["全国人大常委会 (2025). 治安管理处罚法（2025 年修订，第三十八条）. ",{"tag":"a","props":{"href":"https://www.spp.gov.cn/spp/fl/202506/t20250627_699863.shtml","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.spp.gov.cn/spp/fl/202506/t20250627_699863.shtml"]},"；全国人大 (1997). 刑法（第二十、一百三十条，这两条未经修正案修改）. ",{"tag":"a","props":{"href":"https://www.spp.gov.cn/spp/fl/201802/t20180206_364975.shtml","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.spp.gov.cn/spp/fl/201802/t20180206_364975.shtml"]},"；公安部 (2007). 关于印发《管制刀具认定标准》的通知（公通字〔2007〕2 号）. ",{"tag":"a","props":{"href":"https://www.gd.gov.cn/zwgk/wjk/zcfgk/content/post_2937075.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gd.gov.cn/zwgk/wjk/zcfgk/content/post_2937075.html"]},"（广东省人民政府转载）；全国人大常委会 (2012 修正). 人民警察法（第三十六条）. ",{"tag":"a","props":{"href":"https://jtgl.beijing.gov.cn/jgj/jgxx/flfg/fl/203770/index.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://jtgl.beijing.gov.cn/jgj/jgxx/flfg/fl/203770/index.html"]},"（北京市公安交通管理局转载）；国务院 (1996). 人民警察使用警械和武器条例（第三条）. ",{"tag":"a","props":{"href":"http://jyglj.guizhou.gov.cn/szs/zwgk/xxgkml/zcwj/201808/t20180807_25452524.html","target":"_blank","rel":"noopener noreferrer"},"children":["http://jyglj.guizhou.gov.cn/szs/zwgk/xxgkml/zcwj/201808/t20180807_25452524.html"]},"（贵州省监狱管理局转载）；国家铁路局、公安部 (2022). 关于公布《铁路旅客禁止、限制携带和托运物品目录》的公告（2022 年第 1 号）. ",{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/2022-05/31/content_5693212.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/zhengce/zhengceku/2022-05/31/content_5693212.htm"]},"；晋江市人民政府 (2022). 警方提醒！携带这些物品，可能会被拘留！. ",{"tag":"a","props":{"href":"https://www.jinjiang.gov.cn/ztzl/jjgazl/jfts/202209/t20220913_2775463.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.jinjiang.gov.cn/ztzl/jjgazl/jfts/202209/t20220913_2775463.htm"]},"；最高人民法院、最高人民检察院、公安部 (2020). 关于依法适用正当防卫制度的指导意见（法发〔2020〕31 号，第 9 条）. ",{"tag":"a","props":{"href":"https://www.court.gov.cn/zixun/xiangqing/251611.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.court.gov.cn/zixun/xiangqing/251611.html"]},"；最高人民法院 (2020). 涉正当防卫典型案例（案例四）. ",{"tag":"a","props":{"href":"https://www.court.gov.cn/zixun/xiangqing/251621.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.court.gov.cn/zixun/xiangqing/251621.html"]},"；最高人民检察院 (2018). 第十二批指导性案例（检例第 45 号陈某正当防卫案）. ",{"tag":"a","props":{"href":"https://www.spp.gov.cn/spp/jczdal/201812/t20181219_402920.shtml","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.spp.gov.cn/spp/jczdal/201812/t20181219_402920.shtml"]}]},{"tag":"a","props":{"href":"https://www.spp.gov.cn/spp/fl/202506/t20250627_699863.shtml","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Open source link"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Book note"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["The beneficiary is you. Carrying a knife does not automatically rule out lawful self-defense. In Procuratorate Guiding Case No. 45, student Chen was attacked by 9 people, drew a fruit knife he was carrying, and fought back; this was still recognized as self-defense. The procuratorate stated that the issue was intent to engage in mutual fighting, not possession of a tool. The disadvantages lie in two areas. First, if the item itself is unlawful, discovery brings penalties whether used or not. Second, having a knife at hand can make it easy to stab in response to a punch or push; causing serious injury or worse may turn it into excessive self-defense. This book found no nationwide text prohibiting personal possession of pepper spray, only that it cannot be taken on trains. Nor did it find a uniform nationwide text determining whether extendable batons sold online qualify as police batons. If trouble occurs, first see Section 8, Item 10 (call the police before fighting when a conflict starts). If retreat is impossible, see Section 8, Item 11 (you may fight back against an unavoidable attack). For strangers demanding money in an isolated outdoor place, see Section 13, Item 36."]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["My note"]},{"tag":"button","props":{"type":"button"},"children":["Write a reminder for yourself…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/en/tip/09-25"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Previous"]},"To publish or monetize fan works, first obtain perm