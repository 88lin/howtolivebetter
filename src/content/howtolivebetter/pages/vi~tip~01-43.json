http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"Hoàn tất"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"Kế hoạch thực hiện"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"Lưu"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Chia sẻ mẹo này"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Ẩn chi tiết"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Chi phí"]},{"tag":"p","props":{},"children":["Không tốn tiền. Hỏi một câu, rồi dành thời gian nghe họ nói. Khó ở việc mở lời: nhiều người sợ hỏi lại gợi ra ý nghĩ ấy."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Lợi ích"]},{"tag":"p","props":{},"children":["2342 học sinh tại 6 trường trung học ở bang New York được chia ngẫu nhiên theo lớp thành hai nhóm. Bảng hỏi của một nhóm có câu hỏi về tự sát, nhóm kia không có. Ngay sau khi làm bảng hỏi và 2 ngày sau, mức khó chịu của hai nhóm không khác biệt (P = .66 và P = .41; P lớn hơn 0.05 tức là không thấy khác biệt có ý nghĩa thống kê). Sau 2 ngày, tỷ lệ nói đã có ý nghĩ tự sát là 4.7% ở nhóm được hỏi và 3.9% ở nhóm không được hỏi, không thấy khác biệt có ý nghĩa thống kê (P = .49). Học sinh vốn có triệu chứng trầm cảm sau khi được hỏi còn ít khó chịu hơn (P = .01). Học sinh từng tự sát không thành sau khi được hỏi còn ít ý nghĩ tự sát hơn (P = .02). Một phân tích gộp năm 2022 đánh giá 17 nghiên cứu, gộp so sánh giữa «được hỏi» và «không được hỏi» của 8 nghiên cứu. Sau khi hỏi, ý nghĩ và hành vi tự sát, tự làm hại không nhằm tự sát, cùng đau khổ tâm lý đều không tăng có ý nghĩa thống kê, cả ngay lúc đó lẫn sau này. Bằng chứng mạnh nhất là 8 thử nghiệm đối chứng ngẫu nhiên, nguy cơ sai lệch thấp hoặc chưa rõ. Một tổng quan tài liệu năm 2014 cũng viết rằng không nghiên cứu nào thấy ý nghĩ tự sát tăng có ý nghĩa thống kê sau khi hỏi."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Nguồn gốc"]},{"tag":"p","props":{"className":"life-citations"},"children":["Gould MS, Marrocco FA, Kleinman M, Thomas JG, Mostkoff K, Cote J, Davies M (2005). Evaluating iatrogenic risk of youth suicide screening programs: a randomized controlled trial. JAMA, 293(13), 1635-1643. ",{"tag":"a","props":{"href":"https://doi.org/10.1001/jama.293.13.1635","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1001/jama.293.13.1635"]},"；Polihronis C, Cloutier P, Kaur J, Skinner R, Cappelli M (2022). What's the harm in asking? A systematic review and meta-analysis on the risks of asking about suicide-related behaviors and self-harm with quality appraisal. Archives of Suicide Research, 26(2), 325-347. ",{"tag":"a","props":{"href":"https://doi.org/10.1080/13811118.2020.1793857","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1080/13811118.2020.1793857"]},"；Dazzi T, Gribble R, Wessely S, Fear NT (2014). Does asking about suicide and related behaviours induce suicidal ideation? What is the evidence? Psychological Medicine, 44(16), 3361-3363. ",{"tag":"a","props":{"href":"https://doi.org/10.1017/S0033291714001299","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1017/S0033291714001299"]}]},{"tag":"a","props":{"href":"https://doi.org/10.1001/jama.293.13.1635","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Liên kết mở nguồn"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Ghi chú sách"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["Lý do cho mức B: các nghiên cứu này chỉ cho thấy việc hỏi không gây hại, không nghiên cứu nào tính hỏi có thể giảm bao nhiêu ca tử vong do tự sát. Lợi ích xếp mức nhỏ cũng vì không có số liệu tử vong, chỉ có tiêu chí thay thế «ý nghĩ không tăng». Cách hỏi trong nghiên cứu chủ yếu là bảng hỏi và phỏng vấn nghiên cứu, không phải người nhà, bạn bè hỏi trực tiếp; áp dụng sang hỏi trực tiếp là suy luận. Nếu hỏi ra họ thật sự từng nghĩ vậy, trước hết đừng bỏ đi, ở bên cùng họ gọi 12356, dời thuốc và thuốc trừ sâu ra xa; xem mục 25 của phần này (có ý nghĩ tự sát thì gọi 12356). Nếu họ nói sẽ kéo người khác theo hoặc đã chuẩn bị phương tiện, người thân gần có thể đưa đi khám trực tiếp, cũng có thể báo 110; xem phần 8, mục 15 (người thân gần có thể đưa đi khám trực tiếp). Từ lúc ý nghĩ nảy lên đến lúc hành động thường chỉ vài chục phút; xem mục 32 của phần này (ý nghĩ tự sát vừa nảy lên thì nói ngay với người bên cạnh). Người hưởng lợi chủ yếu là vợ chồng và người thân trực hệ; cũng có thể hỏi bạn bè, đồng nghiệp."]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Ghi chú của tôi"]},{"tag":"button","props":{"type":"button"},"children":["Viết một lời nhắc cho chính bạn…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/vi/tip/01-42"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Trước"]},"Lắp chắn bảo vệ, đeo kính bảo hộ cùng tấm che mặt rồi mới dùng máy mài góc; giữ chắc bằng hai tay, đừng lắp lưỡi cưa gỗ để cắt gỗ"]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["Thêm trong chủ đề này"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/01-36"},"children":[{"tag":"strong","props":{},"children":["Không nhặt, không tháo, không bán phần kim loại không rõ lai lịch, thấy ký hiệu cỏ ba lá thì tránh xa"]},{"tag":"span","props":{},"children":["Bức xạ không có mùi, không có màu, không có nhiệt độ. Hầu hết nguồn p…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/01-37"},"children":[{"tag":"strong","props":{},"children":["Cờ bạc tới mức vay tiền còn cờ, tâm trạng lúc nào cũng tụt thì gọi 12356, rồ