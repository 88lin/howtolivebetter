"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"分享这条建议"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"收起详情"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["成本"]},{"tag":"p","props":{"className":"life-citations"},"children":["印标签几分钱到几毛钱一张。每一批都要把日期和配料填对，要占一些时间。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["收益"]},{"tag":"p","props":{"className":"life-citations"},"children":["食品安全法：预包装食品（装进包装再卖的食品）包装上必须有标签。标签要标明名称、规格、净含量、生产日期，成分或者配料表，生产者的名称、地址、联系方式，保质期。还有产品标准代号、贮存条件、所用食品添加剂在国家标准里的通用名称、生产许可证编号。法律法规或者食品安全标准另外要求标的，也要标。散装食品是不装袋、按需称的那种。卖散装食品，容器和外包装上也要标：食品的名称，生产日期或者生产批号，保质期，生产经营者的名称、地址、联系方式等内容。做的、卖的预包装食品没标签，或者标签、说明书不符合本法规定的，挣到的钱和食品一起没收。这批货按售价算的总金额（货值金额）不足一万元的，另罚 5000 元以上 5 万元以下。货值金额一万元以上的，按货值的 5 倍以上 10 倍以下罚。情节严重的勒令停产停业，直到把许可证收回。标签、说明书只是有小毛病（瑕疵），既不影响食品安全也不会让消费者误解的，先勒令改正，拒不改才罚 2000 元以下。新版《预包装食品标签通则》编号 GB 7718-2025，2025 年 3 月 16 日发布，2027 年 3 月 16 日起实施，中间有两年过渡期。它要求在包装上设置独立区域，同时展示生产日期和保质期到期日。日期要用高对比度、容易看清的字体和颜色，并且按年-月-日的顺序排列（全国）"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["来源"]},{"tag":"p","props":{"className":"life-citations"},"children":["全国人大常委会 (2025 年第三次修正). 食品安全法（第六十七、六十八、一百二十五条）. ",{"tag":"a","props":{"href":"https://flk.npc.gov.cn/detail?id=7b5a76d0461745a08d3f964916b87ef3","target":"_blank","rel":"noopener noreferrer"},"children":["https://flk.npc.gov.cn/detail?id=7b5a76d0461745a08d3f964916b87ef3"]},"；国家卫生健康委员会、国家市场监督管理总局 (2025). 关于发布《食品安全国家标准 预包装食品标签通则》（GB 7718-2025）等 50 项食品安全国家标准和 9 项修改单的公告（2025 年第 2 号）. ",{"tag":"a","props":{"href":"https://jkw.lasa.gov.cn/wswyh/wjzl/202504/a90766908ef24869a74f7373bf42463f.shtml","target":"_blank","rel":"noopener noreferrer"},"children":["https://jkw.lasa.gov.cn/wswyh/wjzl/202504/a90766908ef24869a74f7373bf42463f.shtml"]},"（拉萨市卫生健康委员会转载公告全文）；最高人民法院 (2024). 关于审理食品药品惩罚性赔偿纠纷案件适用法律若干问题的解释（法释〔2024〕9 号，第六、八条）. ",{"tag":"a","props":{"href":"http://gongbao.court.gov.cn/Details/bf531a70471f10d377788f28d3d8f8.html","target":"_blank","rel":"noopener noreferrer"},"children":["http://gongbao.court.gov.cn/Details/bf531a70471f10d377788f28d3d8f8.html"]},"（标签瑕疵与必标事项缺失的分档）；北京市市场监督管理局 (2026). 找不到生产日期？食品标签要「变脸」！新规这些重点必看. ",{"tag":"a","props":{"href":"https://scjgj.beijing.gov.cn/zwxx/scjgdt/202605/t20260507_4639154.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://scjgj.beijing.gov.cn/zwxx/scjgdt/202605/t20260507_4639154.html"]},"（实施日期、过渡期与日期展示新要求）"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["原书备注"]},{"tag":"p","props":{"className":"life-citations"},"children":["标签的毛病分两种，罚多少、赔多少都跟着这个分法走。一种是小毛病，比如错别字、字号不规范，既不影响食品安全，也不会让人误解。这种市场监管部门只让你改，拒不改才罚 2000 元以下，买家也要不到十倍赔偿。另一种是该标的没标，比如漏了生产日期、保质期。司法解释明文说这不算小毛病：罚款按货值算，不足一万元的罚 5000 元到 5 万元，一万元以上的罚货值的 5 到 10 倍。而且买家还能另外向你要食品价款的十倍赔偿，不足一千元的按一千元算（见第 5 节第 31 条，食品的十倍赔偿）。GB 7718-2025 的逐条要求，本条只核到了公告和官方解读给出的日期与展示方式，具体格式以标准原文为准。"]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["我的备注"]},{"tag":"button","props":{"type":"button"},"children":["写下对自己有用的提醒…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/tip/12-08"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["上一条"]},"做食品先看自己落在哪一档：生产和做餐饮要许可，只卖预包装的改备案，卖生鲜肉菜不用证"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/tip/12-10"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["下一条"]},"普通食品不许说能治病：标签、说明书、广告和直播话术都算"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["本主题的其他建议"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/12-05"},"children":[{"tag":"strong","props":{},"children":["加盟前先查商务部备案，拿到书面披露，把「冷静期」写进合同"]},{"tag":"span","props":{},"children":["按规定，品牌方自己得先开 2 个直营店、经营满 1 年，签约后 15 日内还要去商务部门备案。签约前，它必须把加盟费、保证金怎么退、现有门店赚不赚钱等 12 项…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/12-06"},"children":[{"tag":"strong","props":{},"children":["注册前把名称、经营场所、经营范围和注册资本定下来，材料齐了当场就能领执照"]},{"tag":"span","props":{},"children":["登记本身不花钱，注册费 2015 年起就停征了。要交的材料只有五项：申请书、身份或资格证明、经营场所文件、章程或合伙协议（个体户不用交），加上法规另外点名要的。…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/12-07"},"children":[{"tag":"strong","props":{},"children":["要许可证的行当，证没下来不开张"]},{"tag":"span","props":{},"children":["没证就开张，轻的是勒令停业、把挣到的钱收走，再罚 1 万元以下。要是做的是专营专卖的东西，或者证券、期货、保险、资金支付结算这几类，情节严重就构成非法经营罪，判…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/12-11"},"children":[{"tag":"strong","props":{},"children":["食品这一行有刑事线：卖病死肉、超标货就够罪，掺了有毒有害的不看金额、起刑五年"]},{"tag":"span","props":{},"children":["前面几条罚的是钱，这条抓的是人。卖病死肉、检验不合格的肉，或者农残兽残重金属严重超标的东西，只要「足以」让人吃出严重中毒就够罪，不用真有人吃坏，判 3 年以下。…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/12-12"},"children":[{"tag":"strong","props":{},"children":["领了执照就开始有申报义务，没有收入也要按期零申报（照报一张全是零的表）"]},{"tag":"span","props":{},"children":["领了执照就要按期报税。一分钱没赚也要报，只是表上数字全填零。不报先罚 2000 元以下，情节严重的罚 2000 到 1 万。连着三个月所有税种都不报，系统会自动…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/12-13"},"children":[{"tag":"strong","props":{},"children":["发票只按真实交易开，小规模纳税人用足免税额"]},{"tag":"span","props":{},"children":["你要是按简易办法交税的小规模纳税人，一个月卖不到 10 万、一个季度卖不到 30 万，增值税就免了。本来按 3% 交的，同期也减到按 1% 交。反过来，「找人开…"]}]}]}]},{"tag":"a","props":{"className":"life-text-link","href":"/book/12"},"children":["阅读整个主题：创业与做生意：别把家底赔进去 ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"15","height":"15","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]}]