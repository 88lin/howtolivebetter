nd","className":"lucide lucide-circle-user-round","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M18 20a6 6 0 0 0-12 0"},"children":[]},{"tag":"circle","props":{"cx":"12","cy":"10","r":"4"},"children":[]},{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},{"tag":"span","props":{},"children":["Đăng nhập để đồng bộ hóa"]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/vi/book/12"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"Quay lại mục lục"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["Khởi nghiệp: đừng làm mất khoản tiết kiệm của gia đình"]},{"tag":"nav","props":{"aria-label":"Các mục trong chương"},"children":[{"tag":"a","props":{"href":"/vi/tip/12-01"},"children":[{"tag":"span","props":{},"children":["01"]},"Chỉ dùng số tiền mà lỡ mất trắng vẫn chịu được để khởi nghiệp, không đụng vốn của cả nhà, không vay tiền để mở hàng"]},{"tag":"a","props":{"href":"/vi/tip/12-02"},"children":[{"tag":"span","props":{},"children":["02"]},"Đừng ký bảo đảm cá nhân cho khoản vay của công ty, người phối ngẫu càng đừng ký theo"]},{"tag":"a","props":{"href":"/vi/tip/12-03"},"children":[{"tag":"span","props":{},"children":["03"]},"Chọn đúng loại hình kinh doanh trước khi mở hàng: hộ cá thể và cổ phần công chung phải trả đến cùng, chỉ công ty hữu hạn mới「hữu hạn」"]},{"tag":"a","props":{"href":"/vi/tip/12-04"},"children":[{"tag":"span","props":{},"children":["04"]},"Đừng làm cổ phân danh nghĩa, đừng giữ cổ phần thay người khác"]},{"tag":"a","props":{"href":"/vi/tip/12-05"},"children":[{"tag":"span","props":{},"children":["05"]},"Trước khi nhượng quyền, kiểm tra hồ sơ đăng ký ở Bộ Thương mại, lấy bản công bố bằng văn bản, ghi「thời gian cân nhắc」vào hợp đồng"]},{"tag":"a","props":{"href":"/vi/tip/12-06"},"children":[{"tag":"span","props":{},"children":["06"]},"Trước khi đăng ký, chốt tên, địa điểm kinh doanh, phạm vi kinh doanh và vốn đăng ký, đủ hồ sơ thì lấy được giấy phép ngay tại chỗ"]},{"tag":"a","props":{"href":"/vi/tip/12-07"},"children":[{"tag":"span","props":{},"children":["07"]},"Ngành cần giấy phép thì chưa có giấy thì không khai trương"]},{"tag":"a","props":{"href":"/vi/tip/12-08"},"children":[{"tag":"span","props":{},"children":["08"]},"Làm thực phẩm thì xem trước mình ở bậc nào: sản xuất và ăn uống phải có giấy phép, chỉ bán đóng gói sẵn thì kê khai, bán thịt rau tươi không cần giấy"]},{"tag":"a","props":{"href":"/vi/tip/12-09"},"children":[{"tag":"span","props":{},"children":["09"]},"Đóng túi để bán thì là thực phẩm đóng gói sẵn: trên nhãn, ngày sản xuất, hạn sử dụng, bảng thành phần thiếu mục nào cũng không được"]},{"tag":"a","props":{"href":"/vi/tip/12-10"},"children":[{"tag":"span","props":{},"children":["10"]},"Thực phẩm thường không được nói là chữa bệnh: nhãn, hướng dẫn, quảng cáo và lời livestream đều tính"]},{"tag":"a","props":{"href":"/vi/tip/12-11"},"children":[{"tag":"span","props":{},"children":["11"]},"Ngành thực phẩm có đường ranh giới hình sự: bán thịt chết bệnh, hàng vượt tiêu chuẩn là đủ thành tội, trộn thêm nguyên liệu độc hại thì không tính tiền, khởi tội năm năm"]},{"tag":"a","props":{"href":"/vi/tip/12-12"},"children":[{"tag":"span","props":{},"children":["12"]},"Có giấy phép là bắt đầu có nghĩa vụ kê khai, không có doanh thu vẫn phải kê khai đúng hạn (nộp một tờ toàn số không)"]},{"tag":"a","props":{"href":"/vi/tip/12-13"},"children":[{"tag":"span","props":{},"children":["13"]},"Hoá đơn chỉ xuất theo giao dịch thật, người nộp thuế quy mô nhỏ hãy dùng hết ngưỡng miễn thuế"]},{"tag":"a","props":{"href":"/vi/tip/12-14"},"children":[{"tag":"span","props":{},"children":["14"]},"Ai tự xưng cơ quan thuế đòi bạn nộp tiền khai thuế đều là lừa đảo, làm thủ tục thuế chỉ đi qua cổng thuế điện tử và 12366"]},{"tag":"a","props":{"href":"/vi/tip/12-15"},"children":[{"tag":"span","props":{},"children":["15"]},"Nhận tiền thì viết「定金」chứ đừng viết「订金」, tiền phạt vi phạm phải ghi rõ con số, hạn thanh toán thì soi như cho vay"]},{"tag":"a","props":{"href":"/vi/tip/12-16"},"children":[{"tag":"span","props":{},"children":["16"]},"Người lao động tháng đầu phải ký hợp đồng bằng văn bản, 30 ngày đăng ký bảo hiểm xã hội"]},{"tag":"a","props":{"href":"/vi/tip/12-17"},"children":[{"tag":"span","props":{},"children":["17"]},"Lương trả theo hợp đồng và theo pháp luật, tăng lương, cho vay, thưởng đều phải qua văn bản"]},{"tag":"a","props":{"href":"/vi/tip/12-18"},"children":[{"tag":"span","props":{},"children":["18"]},"Bán trước rồi mới sản xuất: dùng bán trước và đơn nhỏ để kiểm chứng có người mua, rồi mới bỏ tiền vào sản xuất"]},{"tag":"a","props":{"href":"/vi/tip/12-19"},"children":[{"tag":"span","props":{},"children":["19"]},"Làm xong mẫu thì so qua danh sách sản xuất hàng loạt, rồi hãy nói chuyện khoảng sản xuất"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/vi/tip/12-20","data-status":"active"},"children":[{"tag":"span","props":{},"children":["20"]},"Mỗi lô hàng nhập về để lại một bộ hoá đơn và thông tin nhà cung cấp, giá nhập thấp hơn hẳn giá thị trường thì không nhập: hàng giả do nhân viên mua, người bị kết án là chủ"]},{"tag":"a","props":{"href":"/vi/tip/12-21"},"children":[{"tag":"span","props":{},"children":["21"]},"Hình ảnh trên hàng, bao bì, treo thẻ và ảnh quảng cáo thì tự làm hoặc mua giấy uỷ quyền, đổi màu, thêm biểu tượng không tính là「đã sửa」"]},{"tag":"a","props":{"href":"/vi/tip/12-22"},"children":[{"tag":"span","props":{},"children":["22"]},"Ở đúng vị trí thì làm theo quy trình, còn cái thiện ý ngoài quy trình thì nghĩ kỹ trách nhiệm thuộc về ai"]},{"tag":"a","props":{"href":"/vi/tip/12-23"},"children":[{"tag":"span","props":{},"children":["23"]},"Lỗ thì rút lui theo thủ tục: huỷ được kiểu rút gọn thì huỷ, vỡ nợ thì đi phá sản, đừng để yên"]},{"tag":"a","props":{"href":"/vi/tip/12-24"},"children":[{"tag":"span","props":{},"children":["24"]},"Trước khi chi tiền thuê người khác quản lý cửa hàng trực tuyến, tham gia khóa đào tạo mở cửa hàng, hoặc thực hiện mô hình 'không nguồn hàng', hãy hỏi rõ liệu sau này có phải trả thêm tiền hay không, và nguồn doanh số sẽ đến từ đâu"]},{"tag":"a","props":{"href":"/vi/tip/12-25"},"children":[{"tag":"span","props":{},"children":["25"]},"Mở công ty hoặc hộ cá thể ở Trung Quốc: từ 1 tháng 1 đến 30 tháng 6 nộp báo cáo năm trước qua mạng, không kinh doanh cũng phải nộp, không mất phí"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"Breadcrumbs"},"children":[{"tag":"a","props":{"href":"/vi/book"},"children":["Khám phá cuốn sách"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/vi/book/12"},"children":["Chương 12"," ·"," ","Khởi nghiệp: đừng làm mất khoản tiết kiệm của gia đình"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"12-20"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["20"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["Bằng chứng"," ","A"]}]},{"tag":"h1","props":{"lang":"vi"},"children":["Mỗi lô hàng nhập về để lại một bộ hoá đơn và thông tin nhà cung cấp, giá nhập thấp hơn hẳn giá thị trường thì không nhập: hàng giả do nhân viên mua, người bị kết án là chủ"]},{"tag":"p","props":{"lang":"vi","className":"life-entry-summary"},"children":["Bán hàng giả, thu được 3 vạn, hoặc bán đến mức 5 vạn, là đủ bị kết án, phạt tù từ 3 năm trở xuống. Hàng nằm trong kho chưa bán ra cũng tính.「Tôi không biết là hàng giả」không phải do bạn quyết định: giá nhập thấp hơn giá thị trường rõ rệt mà không nói được lý do thì bị coi là bạn biết. Giữ hợp đồng mua, hoá đơn, chứng từ chuyển khoản và thông tin nhà cung cấp thì mới có đường miễn bồi thường."]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Chi phí"]},{"tag":"p","props":{},"children":["Không tốn tiền. Mỗi lô hàng đều giữ lại mấy thứ: hợp đồng…"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Lợi ích"]},{"tag":"p","props":{},"children":["Biết là hàng giả nhãn hiệu đã đăng ký mà vẫn bán, số tiền thu được (thu nhập bất hợp pháp) đủ 3 vạn tệ, hoặc s…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"Đánh dấu: Mỗi lô hàng nhập về để lại một bộ hoá đơn và thông tin nhà cung cấp, giá nhập thấp hơn hẳn giá thị trường thì không nhập: hàng giả do nhân viên mua, người bị kết án là chủ"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"Hoàn tất"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"Kế hoạch thực hiện"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"Lưu"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Chia sẻ mẹo này"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Ẩn chi tiết"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Chi phí"]},{"tag":"p","props":{},"children":["Không tốn tiền. Mỗi lô hàng đều giữ lại mấy thứ: hợp đồng mua, hoá đơn, chứng từ chuyển khoản, giấy phép kinh doanh và giấy uỷ quyền của nhà cung cấp. Rồi đặt một quy tắc nội bộ: ai mua hàng thì người đó ký, giá thấp hơn giá thị trường rõ rệt thì không mua. Khó ở chỗ phải bỏ qua mấy lô hàng rẻ trông rất có lãi."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Lợi ích"]},{"tag":"p","props":{},"children":["Biết là hàng giả nhãn hiệu đã đăng ký mà vẫn bán, số tiền thu được (thu nhập bất hợp pháp) đủ 3 vạn tệ, hoặc số tiền bán ra đủ 5 vạn tệ, thì đã tới ngưỡng phải kết án. Phạt tù từ 3 năm trở xuống, kèm phạt tiền, hoặc chỉ phạt tiền. Đạt mười lần mức này thì phạt tù từ 3 năm đến 10 năm và phạt tiền. Hàng vẫn còn trong kho chưa bán cũng tính: giá trị lô hàng đạt từ ba lần mức giá bán trở lên thì cũng cấu thành tội. Từ「biết」không cần bạn tự nhận. Bản giải thích tư pháp năm 2025 của Tòa án nhân dân tối cao và Viện kiểm sát nhân dân tối cao liệt kê năm tình huống có thể trực tiếp coi là bạn biết, trừ khi bạn đưa được bằng chứng chứng minh thật sự không biết. Một là biết nhãn hiệu đăng ký trên hàng đã bị sửa, đổi hoặc phủ. Hai là làm giả, sửa giấy uỷ quyền của chủ sở hữu nhãn hiệu, hoặc biết giấy đó bị làm giả, sửa. Ba là đã chịu xử lý hình sự hoặc xử phạt hành chính vì bán hàng giả, lại bán tiếp loại hàng đó. Bốn là không có lý do chính đáng mà mua hoặc bán với giá thấp hơn hẳn giá thị trường. Năm là sau khi cơ quan thực thi hành chính hoặc cơ quan tư pháp phát hiện, chuyển đi, huỷ hàng vi phạm và chứng từ kế toán, hoặc đưa ra chứng minh giả. Công ty phạm tội này thì「phạt tiền cho đơn vị, và xử phạt những người phụ trách trực tiếp cùng những người chịu trách nhiệm trực tiếp khác」theo cùng điều đó. Nghĩa là công ty bị phạt tiền, còn người quyết định và người thực hiện thì bị xử theo cùng điều. Vậy hàng do nhân viên mua, người bị phạt và bị kết án vẫn là người quyết định. Ngược lại, Luật Nhãn hiệu để lại một lối thoát: lúc bán mà thật sự không biết hàng đó vi phạm nhãn hiệu đã đăng ký của người khác,「có thể chứng minh mình có mua hàng đó một cách hợp pháp và nêu tên người cung cấp thì không phải chịu trách nhiệm bồi thường」. Có được miễn bồi thường hay không, tất cả tuỳ vào có hoá đơn và thông tin nhà cung cấp hay không, không giữ thì không dùng được điều này (toàn quốc, bản giải thích tư pháp có hiệu lực từ ngày 26 tháng 4 năm 2025)"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Nguồn gốc"]},{"tag":"p","props":{"className":"life-citations"},"children":["全国人大常委会 (2020). 刑法修正案（十一）（第十七、二十四项，即刑法第二百一十四、二百二十条）. ",{"tag":"a","props":{"href":"https://www.spp.gov.cn/zdgz/202012/t20201227_503682.shtml","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.spp.gov.cn/zdgz/202012/t20201227_503682.shtml"]},"；最高人民法院、最高人民检察院 (2025). 关于办理侵犯知识产权刑事案件适用法律若干问题的解释（法释〔2025〕5 号，2025 年 4 月 26 日起施行）. ",{"tag":"a","props":{"href":"https://www.spp.gov.cn/xwfbh/wsfbt/202504/t20250424_693977.shtml","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.spp.gov.cn/xwfbh/wsfbt/202504/t20250424_693977.shtml"]},"；全国人大常委会 (2019). 商标法（2019 年修正，第五十七、六十四条；2026 年 6 月 26 日修订后为第七十二、七十八条，自 2027 年 1 月 1 日起施行）. ",{"tag":"a","props":{"href":"https://www.cnipa.gov.cn/art/2019/7/30/art_95_28179.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.cnipa.gov.cn/art/2019/7/30/art_95_28179.html"]},"、",{"tag":"a","props":{"href":"https://www.cnipa.gov.cn/art/2026/6/26/art_95_206942.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.cnipa.gov.cn/art/2026/6/26/art_95_206942.html"]}]},{"tag":"a","props":{"href":"https://www.spp.gov.cn/zdgz/202012/t20201227_503682.shtml","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Liên kết mở nguồn"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Ghi chú sách"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["Mỹ phẩm, đồ uống, hàng mẹ và bé, hàng điện tử, quần áo là những nhóm hàng hay xảy ra vụ việc loại này. Điểm chung là cùng một mã hàng có khoảng chênh giá rất lớn. Các nói「hàng kênh」「hàng tồn cuối」「hàng miễn thuế nước ngoài」đều không thay thế được hoá đơn. Ngoài phạt tù còn có một mức xử phạt hành chính: xác định được vi phạm thì tịch thu hàng vi phạm và công cụ, doanh thu vi phạm từ 5 vạn tệ trở lên còn có thể bị phạt kèm không quá 5 lần. Đã nhập hàng về mới phát hiện sai thì dừng bán ngay, niêm phong lại, rồi liên hệ hãng hoặc cơ quan quản lý thị trường. Đừng bán tiếp, đừng huỷ hàng và sổ sách. Huỷ chứng cứ đúng là rơi vào tình huống thứ năm「bị coi là bạn biết hàng giả」nêu trên. Dùng hình ảnh của người khác xem ở mục 21 của phần này (hình ảnh thì tự làm hoặc mua giấy uỷ quyền). Có một kiểu lừa đảo nhắm vào đúng điều này: có người chủ động mang đến, nói mẻ bút hay món nhỏ khác cho bạn miễn phí, đặt trong cửa hàng bán rồi chia tiền. Vài ngày sau có người đến mua, lấy bằng chứng tại chỗ, rồi đòi bồi thường vì vi phạm. Hàng cho không thì thiếu đúng cả ba điều kiện để được miễn bồi thường: không có hợp đồng mua và chứng từ chuyển khoản, không nói được nhà cung cấp thật, giá rõ ràng bất thường. Không mục「có mua hợp pháp và nêu tên nhà cung cấp」nào dùng được. Vì vậy ai chủ động giao hàng tới, không đưa hoá đơn, chỉ để lại một tài khoản WeChat thì đều không lên kệ. Thật sự muốn làm đại lý, hãy ký hợp đồng đại lý bằng văn bản, giữ lại bản sao căn cước và giấy phép kinh doanh của bên kia, ghi rõ hàng thuộc về ai, vi phạm thì tính vào ai."]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Ghi chú của tôi"]},{"tag":"button","props":{"type":"button"},"children":["Viết một lời nhắc cho chính bạn…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/vi/tip/12-19"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Trước"]},"Làm xong mẫu thì so qua danh sách sản xuất hàng loạt, rồi hãy nói chuyện khoảng sản xuất"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/vi/tip/12-21"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Tiếp theo"]},"Hình ảnh trên hàng, bao bì, treo thẻ và ảnh quảng cáo thì tự làm hoặc mua giấy uỷ quyền, đổi màu, thêm biểu tượng không tính là「đã sửa」"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["Thêm trong chủ đề này"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/12-16"},"children":[{"tag":"strong","props":{},"children":["Người lao động tháng đầu phải ký hợp đồng bằng văn bản, 30 ngày đăng ký bảo hiểm xã hội"]},{"tag":"span","props":{},"children":["Người đã đi làm đủ một tháng mà chưa ký hợp đồng bằng văn bản thì từ …"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/12-17"},"children":[{"tag":"strong","props":{},"children":["Lương trả theo hợp đồng và theo pháp luật, tăng lương, cho vay, thưởng đều phải qua văn bản"]},{"tag":"span","props":{},"children":["Lương phải trả đúng hạn, đủ số, theo hợp đồng và theo pháp luật. Nợ l…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/12-18"},"children":[{"tag":"strong","props":{},"children":["Bán trước rồi mới sản xuất: dùng bán trước và đơn nhỏ để kiểm chứng có người mua, rồi mới bỏ tiền vào sản xuất"]},{"tag":"span","props":{},"children":["Có người theo dõi 116 công ty mới ở Italia khoảng một năm: người khởi…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/12-22"},"children":[{"tag":"strong","props":{},"children":["