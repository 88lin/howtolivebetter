an","props":{},"children":["登录同步"]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/book/16"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"返回目录"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["得了慢性病之后怎么活"]},{"tag":"nav","props":{"aria-label":"章节条目"},"children":[{"tag":"a","props":{"href":"/tip/16-01","className":""},"children":[{"tag":"span","props":{},"children":["01"]},"药按医嘱吃满，别感觉好了就停"]},{"tag":"a","props":{"href":"/tip/16-02","className":""},"children":[{"tag":"span","props":{},"children":["02"]},"先办门诊慢特病认定再办异地备案，高血压、糖尿病、放化疗、透析、抗排异就能异地直接结算"]},{"tag":"a","props":{"href":"/tip/16-03","className":""},"children":[{"tag":"span","props":{},"children":["03"]},"复查按医生给的间隔做，把每次的指标记在同一个本子上"]},{"tag":"a","props":{"href":"/tip/16-04","className":""},"children":[{"tag":"span","props":{},"children":["04"]},"别为了试偏方、保健品停掉正规治疗"]},{"tag":"a","props":{"href":"/tip/16-05","className":""},"children":[{"tag":"span","props":{},"children":["05"]},"病情稳定的慢性病，在社区医院一次可以开到 12 周的药"]},{"tag":"a","props":{"href":"/tip/16-06","className":""},"children":[{"tag":"span","props":{},"children":["06"]},"在社区签家庭医生之前，问清楚哪些进医保、哪些自费"]},{"tag":"a","props":{"href":"/tip/16-07","className":""},"children":[{"tag":"span","props":{},"children":["07"]},"确诊糖尿病就去查一次眼底，之后按医生给的间隔查；每年查一次脚"]},{"tag":"a","props":{"href":"/tip/16-08","className":""},"children":[{"tag":"span","props":{},"children":["08"]},"得过肾结石就把水喝到每天 2.5–3 升，盐降到 6 克以内"]},{"tag":"a","props":{"href":"/tip/16-09","className":""},"children":[{"tag":"span","props":{},"children":["09"]},"确诊痛风后长了痛风石、影像上看到骨头被啃出缺损或每年发作 2 次以上的，就长期吃降尿酸药，把血尿酸压到 360 µmol/L 以下并一直维持"]},{"tag":"a","props":{"href":"/tip/16-10","className":""},"children":[{"tag":"span","props":{},"children":["10"]},"得过痛风的，吃烧烤、聚餐时别一顿吃下大量肉和海鲜，酒也要少喝"]},{"tag":"a","props":{"href":"/tip/16-11","className":""},"children":[{"tag":"span","props":{},"children":["11"]},"查出乙肝表面抗原阳性的，每半年做一次肝脏 B 超加甲胎蛋白，按医生评估决定吃不吃抗病毒药，吃上了别自己停"]},{"tag":"a","props":{"href":"/tip/16-12","className":"active"},"children":[{"tag":"span","props":{},"children":["12"]},"确诊慢阻肺的，复诊时让医生或药师看你当面用一遍吸入剂；因为急性加重住过院的，出院后去做肺康复"]},{"tag":"a","props":{"href":"/tip/16-13","className":""},"children":[{"tag":"span","props":{},"children":["13"]},"有糖尿病的每年查一次尿白蛋白肌酐比和血肌酐，有高血压的也要查，早点发现慢性肾病"]},{"tag":"a","props":{"href":"/tip/16-14","className":""},"children":[{"tag":"span","props":{},"children":["14"]},"结肠癌做完手术和化疗的，参加有人指导的运动方案，坚持练满三年"]}]}]},{"tag":"div","props":{"className":"life-tip-page","data-tip-locales":"zh"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"当前位置"},"children":[{"tag":"a","props":{"href":"/book"},"children":["阅读全书"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/book/16"},"children":["第 16 章 · 得了慢性病之后怎么活"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"16-12"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["12"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["证据 A"]}]},{"tag":"h1","props":{"lang":"zh"},"children":["确诊慢阻肺的，复诊时让医生或药师看你当面用一遍吸入剂；因为急性加重住过院的，出院后去做肺康复"]},{"tag":"p","props":{"lang":"zh","className":"life-entry-summary"},"children":["用吸入剂的人里，只有约三成手法完全对，有些错误会让药吸不进肺里。出了关键错误的病人，因为加重住院或看急诊的比例高约一倍。急性加重住院后做肺康复，再住院的可能少一半以上，生活质量和走路能力也会好些。能不能少死人，还没看出来。"]},{"tag":"div","props":{"className":"life-