en":[]},{"tag":"path","props":{"d":"M2 12h2"},"children":[]},{"tag":"path","props":{"d":"M20 12h2"},"children":[]},{"tag":"path","props":{"d":"m6.34 17.66-1.41 1.41"},"children":[]},{"tag":"path","props":{"d":"m19.07 4.93-1.41 1.41"},"children":[]}]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"17","height":"17","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-moon life-theme-icon-dark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"},"children":[]}]}]},{"tag":"button","props":{"type":"button","className":"life-language-switch","aria-label":"English Choose language","aria-haspopup":"menu","aria-expanded":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-globe","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]},{"tag":"path","props":{"d":"M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"},"children":[]},{"tag":"path","props":{"d":"M2 12h20"},"children":[]}]},{"tag":"span","props":{},"children":["English"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]}]},{"tag":"a","props":{"className":"life-account","href":"/en/sign-in"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"17","height":"17","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle-user-round","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M18 20a6 6 0 0 0-12 0"},"children":[]},{"tag":"circle","props":{"cx":"12","cy":"10","r":"4"},"children":[]},{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},{"tag":"span","props":{},"children":["Sign in to sync"]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/en/book/07"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"Back to index"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["How to get by when you have little money"]},{"tag":"nav","props":{"aria-label":"Chapter entries"},"children":[{"tag":"a","props":{"href":"/en/tip/07-01"},"children":[{"tag":"span","props":{},"children":["01"]},"Apply online for unemployment benefits if you’ve lost your job"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/en/tip/07-02","data-status":"active"},"children":[{"tag":"span","props":{},"children":["02"]},"First file a complaint with the Human Resources and Social Security Bureau, then apply for final and binding one-instance arbitration — both options are free, and most cases yield results within a few months"]},{"tag":"a","props":{"href":"/en/tip/07-03"},"children":[{"tag":"span","props":{},"children":["03"]},"If you can’t afford legal fees, apply for free legal aid – cases involving unpaid wages, alimony, or workplace injuries all qualify"]},{"tag":"a","props":{"href":"/en/tip/07-04"},"children":[{"tag":"span","props":{},"children":["04"]},"When you have nowhere else to turn, go to a shelter – they provide food, lodging, and even a ticket home"]},{"tag":"a","props":{"href":"/en/tip/07-05"},"children":[{"tag":"span","props":{},"children":["05"]},"Use free public employment services and gig platforms first — avoid paid agencies"]},{"tag":"a","props":{"href":"/en/tip/07-06"},"children":[{"tag":"span","props":{},"children":["06"]},"Apply for emergency assistance when unexpected crises occur"]},{"tag":"a","props":{"href":"/en/tip/07-07"},"children":[{"tag":"span","props":{},"children":["07"]},"Apply for dibao if your household income falls below the local threshold"]},{"tag":"a","props":{"href":"/en/tip/07-08"},"children":[{"tag":"span","props":{},"children":["08"]},"Apply for the two disability subsidies using a disability certificate"]},{"tag":"a","props":{"href":"/en/tip/07-09"},"children":[{"tag":"span","props":{},"children":["09"]},"Do not miss the annual 400‑yuan payment for basic medical insurance; subsidies are available for low‑income households"]},{"tag":"a","props":{"href":"/en/tip/07-10"},"children":[{"tag":"span","props":{},"children":["10"]},"When suffering from a serious illness, first use yibao, dibao, medical assistance, and register for cross‑regional treatment — avoid online loans"]},{"tag":"a","props":{"href":"/en/tip/07-11"},"children":[{"tag":"span","props":{},"children":["11"]},"Replace a lost ID card immediately; get a temporary ID if you need it urgently"]},{"tag":"a","props":{"href":"/en/tip/07-12"},"children":[{"tag":"span","props":{},"children":["12"]},"After registering as unemployed, seek recognition as a person facing employment difficulties to receive social insurance subsidies or placement in public-interest jobs"]},{"tag":"a","props":{"href":"/en/tip/07-13"},"children":[{"tag":"span","props":{},"children":["13"]},"Apply for vocational training subsidies, employment internship subsidies, and social insurance subsidies during unemployment — don’t pay for training courses out of pocket"]},{"tag":"a","props":{"href":"/en/tip/07-14"},"children":[{"tag":"span","props":{},"children":["14"]},"Job hunting isn’t just about sending resumes — use a systematic approach: learn skills, set goals, and ask for help"]},{"tag":"a","props":{"href":"/en/tip/07-15"},"children":[{"tag":"span","props":{},"children":["15"]},"No deposits, no ID retention, no “training loans”, no pyramid schemes, no usurious loans"]},{"tag":"a","props":{"href":"/en/tip/07-16"},"children":[{"tag":"span","props":{},"children":["16"]},"Public rental housing for those with housing difficulties"]},{"tag":"a","props":{"href":"/en/tip/07-17"},"children":[{"tag":"span","props":{},"children":["17"]},"Keep food and housing costs to a minimum: opt for monthly shared housing instead of daily rentals, and cook at home or use senior meal services rather than ordering takeout"]},{"tag":"a","props":{"href":"/en/tip/07-18"},"children":[{"tag":"span","props":{},"children":["18"]},"Don’t panic if your social insurance lapses: pension is calculated cumulatively, medical insurance is restored per rules"]},{"tag":"a","props":{"href":"/en/tip/07-19"},"children":[{"tag":"span","props":{},"children":["19"]},"Even those who have served time, filed for bankruptcy, or ended up on a blacklist still have legal avenues to start over — provided they complete all required procedures"]},{"tag":"a","props":{"href":"/en/tip/07-20"},"children":[{"tag":"span","props":{},"children":["20"]},"Before facing a serious illness, consider adding a one‑year medical or critical‑illness policy to your basic medical insurance; make sure it includes the phrase “guaranteed renewal”"]},{"tag":"a","props":{"href":"/en/tip/07-21"},"children":[{"tag":"span","props":{},"children":["21"]},"If there’s nowhere else to sleep, 24‑hour venues can only serve as a temporary overnight stop; shelters should be the first choice"]},{"tag":"a","props":{"href":"/en/tip/07-22"},"children":[{"tag":"span","props":{},"children":["22"]},"If wages are owed to you, first figure out who actually employed you: unlicensed workshops and labor subcontractors still go through labor inspection; only work for a household or individual as a private helper belongs in court"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"Breadcrumb"},"children":[{"tag":"a","props":{"href":"/en/book"},"children":["Explore the book"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/en/book/07"},"children":["Chapter 7"," ·"," ","How to get by when you have little money"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"07-02"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["02"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["Evidence"," ","A"]}]},{"tag":"h1","props":{"lang":"en"},"children":["First file a complaint with the Human Resources and Social Security Bureau, then apply for final and binding one-instance arbitration — both options are free, and most cases yield results within a few months"]},{"tag":"p","props":{"lang":"en","className":"life-entry-summary"},"children":["Both processes cost nothing. Start by calling 12333 or visiting the local Human Resources and Social Security Bureau’s labor inspection office. Within 60 working days of acceptance, they will investigate and can order the employer to pay wages; failure to comply results in an additional penalty of 50% to 100% of the owed amount. If that doesn’t work, file for arbitration, which must be concluded within 45 days. However, “case closure” does not guarantee payment: if the employer has no assets or the owner has fled, even a favorable ruling may leave you unpaid. In 2024, the total amount of wages successfully recovered through enforcement efforts reached 2.3 trillion yuan."]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Cost"]},{"tag":"p","props":{},"children":["There are no fees for either option. You’ll need to gather…"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Benefit"]},{"tag":"p","props":{},"children":["The first step is to file a complaint. Call 12333 or visit the local labor inspection office. By law, they mus…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"Mark: First file a complaint with the Human Resources and Social Security Bureau, then apply for final and binding one-instance arbitration — both options are free, and most cases yield results within a few months"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"Done"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"Plan to do"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"Save"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Share this tip"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Hide details"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Cost"]},{"tag":"p","props":{},"children":["There are no fees for either option. You’ll need to gather your employment contract, pay stubs, attendance records, bank transfer statements, and any relevant chat logs, then visit the local Human Resources and Social Security Bureau or arbitration commission one to three times. There is a one-year deadline (known legally as the arbitration statute of limitations) for filing an arbitration claim. Employees still working for the employer are exempt from this deadline; those who have already left must file within one year of their departure. The main difficulty lies in making repeated trips and collecting all necessary evidence, which can be discouraging."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Benefit"]},{"tag":"p","props":{},"children":["The first step is to file a complaint. Call 12333 or visit the local labor inspection office. By law, they must complete their investigation within 60 working days, extendable by another 30 days for complex cases. If violations are confirmed, they can order immediate wage payment; noncompliance triggers an extra penalty of 50% to 100% of the original amount. In 2024, labor inspectors nationwide handled 137,000 cases, securing back pay totaling 8.65 billion yuan for 654,000 workers. If you possess a written IOU or clear wage records, you may also request a payment order directly from a local court; such orders are issued within 15 days of application. The second step is arbitration, which must be finalized within 45 days, extendable by 15 days. Workers seeking unpaid wages may request provisional enforcement even before the full trial concludes. Claims up to 12 times the local monthly minimum wage qualify as final and binding one-instance arbitration, meaning the employer cannot appeal further. In 2024, 4.257 million arbitration cases were filed, with 4.156 million resolved, resulting in 93.47 billion yuan recovered. Mediation succeeded in 79.6% of cases, while 98.2% of arbitrations concluded successfully, and 73.7% never reached court. Critics claiming resolution takes “six months to a year” refer to cases that proceed to civil litigation after arbitration: a first-instance trial lasts six months (or three months under simplified procedures), followed by a three-month appeals phase. In 2024, courts resolved 88,000 labor wage cases, recovering 28.54 billion yuan, and 998 individuals were convicted under criminal statutes for wage theft."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Original sources"]},{"tag":"p","props":{"className":"life-citations"},"children":["人力资源社会保障部 (2025). 2024 年度人力资源和社会保障事业发展统计公报. ",{"tag":"a","props":{"href":"https://www.mohrss.gov.cn/SYrlzyhshbzb/zwgk/szrs/tjgb/202506/W020250616518526345602.pdf","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.mohrss.gov.cn/SYrlzyhshbzb/zwgk/szrs/tjgb/202506/W020250616518526345602.pdf"]},"；最高人民法院 (2025). 最高人民法院工作报告. ",{"tag":"a","props":{"href":"https://www.gov.cn/yaowen/liebiao/202503/content_7013680.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/yaowen/liebiao/202503/content_7013680.htm"]},"；国务院 (2004). 劳动保障监察条例（国务院令第 423 号，第九、十七、二十六条）. ",{"tag":"a","props":{"href":"https://www.gov.cn/gongbao/content/2004/content_63042.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/gongbao/content/2004/content_63042.htm"]},"；全国人大常委会 (2007). 劳动争议调解仲裁法（主席令第八十号，第二十七、四十三、四十四、四十七、五十、五十三条）. ",{"tag":"a","props":{"href":"https://chinajob.mohrss.gov.cn/h5/c/2022-07-15/356212.shtml","target":"_blank","rel":"noopener noreferrer"},"children":["https://chinajob.mohrss.gov.cn/h5/c/2022-07-15/356212.shtml"]},"；全国人大常委会 (2012 修正). 劳动合同法（第三十、八十五条）. ",{"tag":"a","props":{"href":"https://fgk.chinatax.gov.cn/zcfgk/c100009/c5193025/content.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://fgk.chinatax.gov.cn/zcfgk/c100009/c5193025/content.html"]},"；全国人大常委会 (2023 修正). 民事诉讼法（第一百零九、一百五十二、一百六十四、一百八十三、二百二十五、二百二十七条）. ",{"tag":"a","props":{"href":"https://amr.guizhou.gov.cn/zwgk/xxgkml/jcxxgk/zcfg/fl/202401/t20240129_83645867.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://amr.guizhou.gov.cn/zwgk/xxgkml/jcxxgk/zcfg/fl/202401/t20240129_83645867.html"]},"；全国人大常委会 (2011). 刑法修正案（八）第四十一条，即刑法第二百七十六条之一. ",{"tag":"a","props":{"href":"http://www.npc.gov.cn/cwhhdbdh/c6626/c14002/c14003/201905/t20190523_390477.html","target":"_blank","rel":"noopener noreferrer"},"children":["http://www.npc.gov.cn/cwhhdbdh/c6626/c14002/c14003/201905/t20190523_390477.html"]},"；最高人民法院 (2013). 关于审理拒不支付劳动报酬刑事案件适用法律若干问题的解释（法释〔2013〕3 号，第三条）. ",{"tag":"a","props":{"href":"https://www.court.gov.cn/fabu/xiangqing/5041.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.court.gov.cn/fabu/xiangqing/5041.html"]},"；国务院 (2019). 保障农民工工资支付条例（国务院令第 724 号，第十、二十六、三十、三十一、三十二、四十一条）. ",{"tag":"a","props":{"href":"https://www.gov.cn/gongbao/content/2020/content_5469641.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/gongbao/content/2020/content_5469641.htm"]},"；全国人大常委会 (2021). 法律援助法（第三十一、四十二条）. ",{"tag":"a","props":{"href":"https://www.beijing.gov.cn/zhengce/zhengcefagui/qtwj/202504/t20250402_4053713.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.beijing.gov.cn/zhengce/zhengcefagui/qtwj/202504/t20250402_4053713.html"]}]},{"tag":"a","props":{"href":"https://www.mohrss.gov.cn/SYrlzyhshbzb/zwgk/szrs/tjgb/202506/W020250616518526345602.pdf","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Open source link"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Book note"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["These pathways are effective, but it’s crucial to distinguish between “case closure” and actual payment receipt. The 98.2% closure rate reflects only procedural completion; many workers still receive nothing if employers lack assets or abscond. The Supreme People’s Court publishes only total enforcement figures (2.3 trillion yuan in 2024) and a “high completion rate,” offering no data on how much of that actually reaches workers. The term “arbitration termination rate” lacks an official definition here; it is interpreted as cases never appealed to court. Criminal prosecution thresholds apply when wages remain unpaid for three months or more: either to a single worker for 5,000 to 20,000 yuan, or to ten or more workers for a combined total of 30,000 to 100,000 yuan. Provincial courts set exact amounts within these ranges; check your local figure before filing. Construction workers benefit from dedicated wage accounts and guarantees by general contractors, making direct appeals to contractors less effective. Legal aid for migrant workers seeking unpaid wages is granted regardless of financial status. Legal citations derive from State Taxation Administration and Guizhou Market Supervision Administration pages (both on ",{"tag":"a","props":{"href":"http://gov.cn/","target":"_blank","rel":"noopener noreferrer"},"children":["gov.cn"]},"), as the National People’s Congress website remains inaccessible; verification of the Eighth Criminal Law Amendment relied on manual curl checks."]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["My note"]},{"tag":"button","props":{"type":"button"},"children":["Write a reminder for yourself…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/en/tip/07-01"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Previous"]},"Apply online for unemployment benefits if you’ve lost your job"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/en/tip/07-03"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Next"]},"If you can’t afford legal fees, apply for free legal aid – cases involving unpaid wages, alimony, or workplace injuries all qualify"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"childre