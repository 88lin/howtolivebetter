dren":[{"tag":"span","props":{},"children":["09"]},"不要为了「更健康」花溢价买有机食品"]},{"tag":"a","props":{"href":"/tip/06-10","className":""},"children":[{"tag":"span","props":{},"children":["10"]},"不要花大钱买保健品、膏方、滋补品来「调理身体」"]},{"tag":"a","props":{"href":"/tip/06-11","className":""},"children":[{"tag":"span","props":{},"children":["11"]},"不要在没有肠道问题时长期吃益生菌"]},{"tag":"a","props":{"href":"/tip/06-12","className":""},"children":[{"tag":"span","props":{},"children":["12"]},"不要为了「增强免疫力」逼自己洗冷水澡"]},{"tag":"a","props":{"href":"/tip/06-13","className":""},"children":[{"tag":"span","props":{},"children":["13"]},"不要买排毒、清肠、酵素、碱性水这类产品"]},{"tag":"a","props":{"href":"/tip/06-14","className":""},"children":[{"tag":"span","props":{},"children":["14"]},"不要为了凑够「每天 8 杯水」强迫自己喝水"]},{"tag":"a","props":{"href":"/tip/06-15","className":""},"children":[{"tag":"span","props":{},"children":["15"]},"不要花钱算命、看塔罗、看星座来做决定"]},{"tag":"a","props":{"href":"/tip/06-16","className":""},"children":[{"tag":"span","props":{},"children":["16"]},"不要买防蓝光眼镜来「保护视力」，也不要相信「对着屏幕干几个月眼睛就废了」，但眼睛胀痛发红要当急症"]},{"tag":"a","props":{"href":"/tip/06-17","className":""},"children":[{"tag":"span","props":{},"children":["17"]},"不要把献血当保健：「排毒、降血脂、防心梗」没有随机试验支持，频繁献倒是真会缺铁"]},{"tag":"a","props":{"href":"/tip/06-18","className":""},"children":[{"tag":"span","props":{},"children":["18"]},"不要靠通用体检套餐防病，按年龄性别做那几项有证据的筛查"]},{"tag":"a","props":{"href":"/tip/06-19","className":""},"children":[{"tag":"span","props":{},"children":["19"]},"不要因为体检查出尿酸高、但从没痛过，就开始吃降尿酸药"]},{"tag":"a","props":{"href":"/tip/06-20","className":""},"children":[{"tag":"span","props":{},"children":["20"]},"不要因为体检查出胆囊结石、但从没疼过，就去预防性切胆囊"]},{"tag":"a","props":{"href":"/tip/06-21","className":""},"children":[{"tag":"span","props":{},"children":["21"]},"不要为了防肾结石把钙戒掉"]},{"tag":"a","props":{"href":"/tip/06-22","className":""},"children":[{"tag":"span","props":{},"children":["22"]},"不要为了「转运」「招财」「养人」买水晶、手串、貔貅这类物件"]},{"tag":"a","props":{"href":"/tip/06-23","className":""},"children":[{"tag":"span","props":{},"children":["23"]},"不要指望买东西改善心情或身份感"]},{"tag":"a","props":{"href":"/tip/06-24","className":""},"children":[{"tag":"span","props":{},"children":["24"]},"不要为了「在周围人里往上挪一档」多花钱换房、换车、换圈子"]},{"tag":"a","props":{"href":"/tip/06-25","className":""},"children":[{"tag":"span","props":{},"children":["25"]},"不要相信「意志力像肌肉，用一会儿就没了」"]},{"tag":"a","props":{"href":"/tip/06-26","className":""},"children":[{"tag":"span","props":{},"children":["26"]},"不要指望吃早餐或 16:8 轻断食帮你控制体重，吃饭时间挑你能长期坚持的"]},{"tag":"a","props":{"href":"/tip/06-27","className":""},"children":[{"tag":"span","props":{},"children":["27"]},"不要相信「手淫伤身」「戒色才能变好」，真正要看的是有没有耽误睡觉、工作和关系"]},{"tag":"a","props":{"href":"/tip/06-28","className":""},"children":[{"tag":"span","props":{},"children":["28"]},"不要花钱做「性取向矫正」「同性恋治疗」，也不要把家里人送去"]},{"tag":"a","props":{"href":"/tip/06-29","className":"active"},"children":[{"tag":"span","props":{},"children":["29"]},"不要指望学会「正确搬运姿势」、上搬运培训就能防腰痛，要减的是搬的重量和次数，平时多锻炼"]},{"tag":"a","props":{"href":"/tip/06-30","className":""},"children":[{"tag":"span","props":{},"children":["30"]},"不要指望骨折之后猛补钙、喝骨头汤能让骨头长得更快"]},{"tag":"a","props":{"href":"/tip/06-31","className":""},"children":[{"tag":"span","props":{},"children":["31"]},"不要指望靠 AI 聊天机器人自己判断病情和法律问题，看病、打官司、花大钱之前，把它说的依据找到原文核一遍"]},{"tag":"a","props":{"href":"/tip/06-32","className":""},"children":[{"tag":"span","props":{},"children":["32"]},"不要因为「人随时会死，早点把钱花完才快乐」就不存钱，三十岁的人约九成能活到六十岁"]}]}]},{"tag":"div","props":{"className":"life-tip-page","data-tip-locales":"zh,en,ru,es,ja,vi"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"当前位置"},"children":[{"tag":"a","props":{"href":"/book"},"children":["阅读全书"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/book/06"},"children":["第 6 章 · 反面清单"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"06-29"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["29"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["证据 A"]}]},{"tag":"h1","props":{"lang":"zh"},"children":["不要指望学会「正确搬运姿势」、上搬运培训就能防腰痛，要减的是搬的重量和次数，平时多锻炼"]},{"tag":"p","props":{"lang":"zh","className":"life-entry-summary"},"children":["上过搬运姿势培训的工人，后来腰痛的并不比没上过的少。搬东西时腰弯得多的人，也没看出更容易腰痛。和腰痛有关的是搬得重、搬得多，每次多搬 10 公斤或每天多搬 10 次，风险高约一成。平时规律锻炼的人，腰痛发作少三成多到四成多。"]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["成本"]},{"tag":"p","props":{},"children":["不花钱。不用再为搬东西时腰弯没弯较劲，也不用为护腰课和护腰带花钱。要做的是两件事。重的东西拆开搬、用推车或找人一起搬，这只多花几分钟。每周抽几次时间锻炼，这要长期坚持。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["收益"]},{"tag":"p","props":{},"children":["先看培训。Cochrane 系统综述 2011 年版汇总了 9 项随机分组的试验，共 20101 名员工。其中 7 项试验、19317 人的结果是：上过搬运培训的人和什么都没做的人，后来报告的腰痛差不多（OR 1.17，95% CI 0.68–2.02，可信范围跨过 1）。和只看了一段视频的人比，R…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"标记：不要指望学会「正确搬运姿势」、上搬运培训就能防腰痛，要减的是搬的重量和次数，平时多锻炼"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"已做到"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"加入待做"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"收藏"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"分享这条建议"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"收起详情"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["成本"]},{"tag":"p","props":{"className":"life-citations"},"children":["不花钱。不用再为搬东西时腰弯没弯较劲，也不用为护腰课和护腰带花钱。要做的是两件事。重的东西拆开搬、用推车或找人一起搬，这只多花几分钟。每周抽几次时间锻炼，这要长期坚持。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["收益"]},{"tag":"p","props":{"className":"life-citations"},"children":["先看培训。Cochrane 系统综述 2011 年版汇总了 9 项随机分组的试验，共 20101 名员工。其中 7 项试验、19317 人的结果是：上过搬运培训的人和什么都没做的人，后来报告的腰痛差不多（OR 1.17，95% CI 0.68–2.02，可信范围跨过 1）。和只看了一段视频的人比，RR 0.93（0.69–1.25），也差不多。证据质量是中等。作者的结论是，搬运建议和培训不管配不配搬运工具，都防不住腰痛和腰痛造成的失能。再看弯腰。2020 年一篇系统综述汇总了搬东西时腰弯多少的研究，证据质量低。唯一一项跟踪研究里，后来腰痛和没腰痛的人，搬东西时腰最多弯的角度只差 1.5 度（−0.7 到 3.7），不显著。11 项研究里有 9 项没看到两组有差别。另有 7 项研究换了一种量法，腰痛的人搬东西时腰反而少弯 6.0 度（−11.2 到 −0.9）。作者的结论是，没有证据说腰弯得多会招来腰痛。最后看该怎么做。一篇荟萃汇总了 8 项跟踪研究：每次搬的东西每重 10 公斤，腰痛风险 OR 1.11（1.05–1.18，高约 11%）。每天每多搬 10 次，OR 1.09（1.03–1.15，高约 9%）。另一篇汇总了 21 项随机试验、30850 人。锻炼加讲解让腰痛发作的风险 RR 0.55（0.41–0.74，低约 45%），证据质量中等。单靠锻炼 RR 0.65（0.50–0.86，低约 35%），证据质量低到很低。单靠讲解 RR 1.03（0.83–1.27），护腰带 RR 1.01（0.71–1.44），都看不出效果。英国健康与安全执行局（HSE）的官方指南也写明：单靠培训保证不了搬运安全，好的搬运手法也替代不了配搬运工具、改进任务和货物。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["来源"]},{"tag":"p","props":{"className":"life-citations"},"children":["Verbeek JH, Martimo KP, Karppinen J, Kuijer PP, Viikari-Juntura E, Takala EP. (2011). Manual material handling advice and assistive devices for preventing and treating back pain in workers. Cochrane Database of Systematic Reviews, CD005958. ",{"tag":"a","props":{"href":"https://doi.org/10.1002/14651858.CD005958.pub3","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1002/14651858.CD005958.pub3"]},"；Saraceni N, Kent P, Ng L, Campbell A, Straker L, O'Sullivan P. (2020). To Flex or Not to Flex? Is There a Relationship Between Lumbar Spine Flexion During Lifting and Low Back Pain? A Systematic Review With Meta-analysis. Journal of Orthopaedic & Sports Physical Therapy, 50(3), 121–130. ",{"tag":"a","props":{"href":"https://doi.org/10.2519/jospt.2020.9218","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.2519/jospt.2020.9218"]},"；Coenen P, Gouttebarge V, van der Burght AS, et al. (2014). The effect of lifting during work on low back pain: a health impact assessment based on a meta-analysis. Occupational and Environmental Medicine, 71(12), 871–877. ",{"tag":"a","props":{"href":"https://doi.org/10.1136/oemed-2014-102346","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1136/oemed-2014-102346"]},"；Steffens D, Maher CG, Pereira LS, et al. (2016). Prevention of Low Back Pain: A Systematic Review and Meta-analysis. JAMA Internal Medicine, 176(2), 199–208. ",{"tag":"a","props":{"href":"https://doi.org/10.1001/jamainternmed.2015.7431","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1001/jamainternmed.2015.7431"]},"；Health and Safety Executive. Manual handling at work: Training; Good handling technique. ",{"tag":"a","props":{"href":"https://www.hse.gov.uk/msd/manual-handling/training.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.hse.gov.uk/msd/manual-handling/training.htm"]},"；",{"tag":"a","props":{"href":"https://www.hse.gov.uk/msd/manual-handling/good-handling-technique.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.hse.gov.uk/msd/manual-handling/good-handling-technique.htm"]},"；反方：Wai EK, Roffey DM, Bishop P, Kwon BK, Dagenais S. (2010). Causal assessment of occupational lifting and low back pain: results of a systematic review. The Spine Journal, 10(6), 554–566. ",{"tag":"a","props":{"href":"https://doi.org/10.1016/j.spinee.2010.03.033","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1016/j.spinee.2010.03.033"]},""]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["原书备注"]},{"tag":"p","props":{"className":"life-citations"},"children":["争议。搬得重、搬得多这一侧说法不一。2010 年一篇系统综述找到 9 项高质量研究，4 项看到关联，5 项没看到。作者认为工作中搬东西不太可能单独导致腰痛。所以「少搬重的」只有关联证据，证明不了因果。弯腰那篇的研究质量低，多数只比了同一时间的两群人。培训那篇的可信范围很宽，它也说没有随机试验看过培训能不能治已有的腰痛。HSE 仍然教一套手法：东西贴近腰，脚站稳，别扭腰，别猛拽。起身时背、髋、膝都微微弯，比完全弯腰或完全蹲下都好。照做没坏处，只是别指望它单独防住腰痛。收益定中，因为按降幅锻炼够得上大，但单靠锻炼的证据质量低，锻炼加讲解也没看出能少请病假，腰痛又不致命。锻炼怎么做见第 2 节第 16 条（每周做 30–60 分钟力量训练）和第 2 节第 11 条（每天走到 7000–8000 步）。受益人是你自己。"]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["我的备注"]},{"tag":"button","props":{"type":"button"},"children":["写下对自己有用的提醒…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/tip/06-28"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["上一条"]},"不要花钱做「性取向矫正」「同性恋治疗」，也不要把家里人送去"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/tip/06-30"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["下一条"]},"不要指望骨折之后猛补钙、喝骨头汤能让骨头长得更快"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["本主题的其他建议"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/06-23"},"children":[{"tag":"strong","props":{},"children":["不要指望买东西改善心情或身份感"]},{"tag":"span","props":{},"children":["把钱和物质看得越重的人，自己觉得越不幸福，但关联很弱，也分不出谁导致谁。还有研究发现，花钱买一段经历比买东西更让人快乐。所以心情差的时候，把钱花在一次出门、一顿…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/06-24"},"children":[{"tag":"strong","props":{},"children":["不要为了「在周围人里往上挪一档」多花钱换房、换车、换圈子"]},{"tag":"span","props":{},"children":["拿收入一样的人来比，邻居挣得越多，这个人报告的幸福感越低。这只发生在学历和自己相同、又常来往的邻居之间。所以为了搬进一个人人都比你宽裕的地方而多花的钱，买到的是…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/06-25"},"children":[{"tag":"strong","props":{},"children":["不要相信「意志力像肌肉，用一会儿就没了」"]},{"tag":"span","props":{},"children":["流行的说法是：先做一件费自控的事，接下来就更容易破功，所以要省着用意志力。23 个实验室、2141 人按同一套方案重做了这个实验，结果几乎是零。别再用「今天意志…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/06-26"},"children":[{"tag":"strong","props":{},"children":["不要指望吃早餐或 16:8 轻断食帮你控制体重，吃饭时间挑你能长期坚持的"]},{"tag":"span","props":{},"children":["流行说法是不吃早餐会让人午饭晚饭暴食，一天总量反而更多。试验里不是这样：不吃早餐的人一天少吃了两百多千卡，体重还略轻一点。16:8 和单纯少吃比，一年下来体重也…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/06-27"},"children":[{"tag":"strong","props":{},"children":["不要相信「手淫伤身」「戒色才能变好」，真正要看的是有没有耽误睡觉、工作和关系"]},{"tag":"span","props":{},"children":["没有研究说手淫伤身。射精多的男性前列腺癌少约两成，但也有研究看到年轻时次数多的人风险偏高。少数人每次射精后都会没力气、像感冒，几天才好，这是一种罕见病，可以去泌…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/06-31"},"children":[{"tag":"strong","props":{},"children":["不要指望靠 AI 聊天机器人自己判断病情和法律问题，看病、打官司、花大钱之前，把它说的依据找到原文核一遍"]},{"tag":"span","props":{},"children":["把完整病例交给 AI，九成以上它能认出是什么病。但普通人拿它问症状，认出病的反而比自己上网查的人少，该不该去急诊也没判得更准。问法律问题，通用 AI 至少 58…"]}]}]}]},{"tag":"a","props":{"className":"life-text-link","href":"/book/06"},"children":["阅读整个主题：反面清单 ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"15","height":"15","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]}]}]},{"tag":"nav","props":{"className":"life-tabbar","aria-label":"主导航"},"children":[{"tag":"a","props":{"className":"","href":"/book"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"21","height":"21","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-book-open","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M12 7v14"},"children":[]},{"tag":"path","props":{"d":"M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z"},"children":[]}]},{"tag":"span","props":{},"children":["全书"]}]},{"tag":"a","props":{"className":"","href":"/top-50"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"21","height":"21","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-star","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679