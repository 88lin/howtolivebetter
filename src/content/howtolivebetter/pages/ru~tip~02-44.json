горячую линию 12320, чтобы узнать, есть ли такие услуги в вашем регионе"]},{"tag":"a","props":{"href":"/ru/tip/02-06"},"children":[{"tag":"span","props":{},"children":["06"]},"Курящим, уже не способным бросить, можно попробовать электронные сигареты, а некурящим — лучше не прикасаться к ним"]},{"tag":"a","props":{"href":"/ru/tip/02-07"},"children":[{"tag":"span","props":{},"children":["07"]},"Отказ от сладких напитков, даже безсахарных, не решает проблему"]},{"tag":"a","props":{"href":"/ru/tip/02-08"},"children":[{"tag":"span","props":{},"children":["08"]},"Не жевать бетель"]},{"tag":"a","props":{"href":"/ru/tip/02-09"},"children":[{"tag":"span","props":{},"children":["09"]},"Замена обычной соли на низконатриевую (калийную) соль дома"]},{"tag":"a","props":{"href":"/ru/tip/02-10"},"children":[{"tag":"span","props":{},"children":["10"]},"Регулярно чистите зубы и ежедневно удаляйте остатки пищи из межзубных промежутков; при потере зубов своевременно обращайтесь к стоматологу"]},{"tag":"a","props":{"href":"/ru/tip/02-11"},"children":[{"tag":"span","props":{},"children":["11"]},"Ежедневно нужно делать 7000–8000 шагов или набирать 150–300 минут быстрой ходьбы в неделю"]},{"tag":"a","props":{"href":"/ru/tip/02-12"},"children":[{"tag":"span","props":{},"children":["12"]},"При гипертонии и повышенном уровне холестерина следует принимать лекарства строго по назначению врача, не прекращая терапию самостоятельно"]},{"tag":"a","props":{"href":"/ru/tip/02-13"},"children":[{"tag":"span","props":{},"children":["13"]},"Спать примерно 7 часов в сутки и соблюдать режим"]},{"tag":"a","props":{"href":"/ru/tip/02-14"},"children":[{"tag":"span","props":{},"children":["14"]},"Регулярно занимайтесь ракеточными видами спорта: теннисом, бадминтоном, настольным теннисом"]},{"tag":"a","props":{"href":"/ru/tip/02-15"},"children":[{"tag":"span","props":{},"children":["15"]},"Соберите несколько коротких физических нагрузок вроде подъема по лестнице или быстрой ходьбы в суммарный объем в 4–5 минут в день"]},{"tag":"a","props":{"href":"/ru/tip/02-16"},"children":[{"tag":"span","props":{},"children":["16"]},"30–60 минут силовых тренировок в неделю"]},{"tag":"a","props":{"href":"/ru/tip/02-17"},"children":[{"tag":"span","props":{},"children":["17"]},"Не сидите подряд слишком долго — время от времени вставайте и двигайтесь"]},{"tag":"a","props":{"href":"/ru/tip/02-18"},"children":[{"tag":"span","props":{},"children":["18"]},"Меньше употреблять переработанное мясо (ветчину, бекон, колбасу, консервированное мясо)"]},{"tag":"a","props":{"href":"/ru/tip/02-19"},"children":[{"tag":"span","props":{},"children":["19"]},"Пейте как можно меньше или вообще не пейте"]},{"tag":"a","props":{"href":"/ru/tip/02-20"},"children":[{"tag":"span","props":{},"children":["20"]},"Людям, которые ежедневно пьют алкоголь и при прекращении приема испытывают дрожь и тревогу, не стоит самостоятельно бросать пить"]},{"tag":"a","props":{"href":"/ru/tip/02-21"},"children":[{"tag":"span","props":{},"children":["21"]},"Хотите пить меньше? Сначала посчитайте, сколько выпили за неделю, а потом поговорите с врачом несколько минут"]},{"tag":"a","props":{"href":"/ru/tip/02-22"},"children":[{"tag":"span","props":{},"children":["22"]},"Ежедневное употребление небольшой горсти орехов"]},{"tag":"a","props":{"href":"/ru/tip/02-23"},"children":[{"tag":"span","props":{},"children":["23"]},"Замена части красного мяса на рыбу и птицу"]},{"tag":"a","props":{"href":"/ru/tip/02-24"},"children":[{"tag":"span","props":{},"children":["24"]},"Замените часть белого риса и пшеничной муки на цельнозерновые продукты"]},{"tag":"a","props":{"href":"/ru/tip/02-25"},"children":[{"tag":"span","props":{},"children":["25"]},"Пить чай более трёх раз в неделю"]},{"tag":"a","props":{"href":"/ru/tip/02-26"},"children":[{"tag":"span","props":{},"children":["26"]},"Три–четыре чашки кофе в день без сахара и сливок"]},{"tag":"a","props":{"href":"/ru/tip/02-27"},"children":[{"tag":"span","props":{},"children":["27"]},"Съедать по 5 порций (около 400 г) фруктов и овощей в день"]},{"tag":"a","props":{"href":"/ru/tip/02-28"},"children":[{"tag":"span","props":{},"children":["28"]},"Меньше употреблять сверхобработанные продукты (чипсы, быстрые лапша, выпечка, полуфабрикаты)"]},{"tag":"a","props":{"href":"/ru/tip/02-29"},"children":[{"tag":"span","props":{},"children":["29"]},"Переход с угля и дров на электричество или газ для приготовления пищи и отопления"]},{"tag":"a","props":{"href":"/ru/tip/02-30"},"children":[{"tag":"span","props":{},"children":["30"]},"Дайте горячему напитку остыть, прежде чем пить — не пейте слишком горячий чай, суп или кофе"]},{"tag":"a","props":{"href":"/ru/tip/02-31"},"children":[{"tag":"span","props":{},"children":["31"]},"Выходите на солнце днём — не сидите всё время в помещении"]},{"tag":"a","props":{"href":"/ru/tip/02-32"},"children":[{"tag":"span","props":{},"children":["32"]},"Поддерживайте ИМТ в пределах 20–25: при избыточном весе нужно худеть"]},{"tag":"a","props":{"href":"/ru/tip/02-33"},"children":[{"tag":"span","props":{},"children":["33"]},"Употребление перца чили более четырех раз в неделю"]},{"tag":"a","props":{"href":"/ru/tip/02-34"},"children":[{"tag":"span","props":{},"children":["34"]},"Выпивать по одной-две порции молока или йогурта в день"]},{"tag":"a","props":{"href":"/ru/tip/02-35"},"children":[{"tag":"span","props":{},"children":["35"]},"Яйца можно есть, но не стоит употреблять по три-четыре штуки в день"]},{"tag":"a","props":{"href":"/ru/tip/02-36"},"children":[{"tag":"span","props":{},"children":["36"]},"При возможности принимайте ванну, а не ограничивайтесь душем"]},{"tag":"a","props":{"href":"/ru/tip/02-37"},"children":[{"tag":"span","props":{},"children":["37"]},"Ограничьте дневной сон полчаса — не более часа; если вам необходимо спать по часу-два, чтобы чувствовать себя нормально, стоит выяснить причину"]},{"tag":"a","props":{"href":"/ru/tip/02-38"},"children":[{"tag":"span","props":{},"children":["38"]},"После бессонной ночи ложитесь спать пораньше на следующий вечер — не откладывайте это на выходные"]},{"tag":"a","props":{"href":"/ru/tip/02-39"},"children":[{"tag":"span","props":{},"children":["39"]},"Чем дольше человек работает в ночную смену, тем выше риск сердечно-сосудистых заболеваний; при возможности стоит сменить работу"]},{"tag":"a","props":{"href":"/ru/tip/02-40"},"children":[{"tag":"span","props":{},"children":["40"]},"Покупайте готовую упакованную растительную нефть с номером разрешения SC, а не самодельное арахисовое масло из частных мастерских"]},{"tag":"a","props":{"href":"/ru/tip/02-41"},"children":[{"tag":"span","props":{},"children":["41"]},"Замена свиного и сливочного жира на растительное масло в приготовлении пищи — не требует покупки разных видов масел ради здоровья, а льняное масло не защищает сердце"]},{"tag":"a","props":{"href":"/ru/tip/02-42"},"children":[{"tag":"span","props":{},"children":["42"]},"Включайте вытяжку при жарке и тушении — с момента зажигания плиты и до конца готовки"]},{"tag":"a","props":{"href":"/ru/tip/02-43"},"children":[{"tag":"span","props":{},"children":["43"]},"Если приливы и ночная потливость в период менопаузы мешают жить, обратитесь к гинекологу для оценки гормональной терапии: не терпите и не покупайте лекарства самостоятельно, а для профилактики болезней сердца её не используйте"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/ru/tip/02-44","data-status":"active"},"children":[{"tag":"span","props":{},"children":["44"]},"Если собаку и так хотели завести, засчитывайте ежедневные прогулки с ней в норму шагов, но не заводите собаку ради долголетия"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"Навигация"},"children":[{"tag":"a","props":{"href":"/ru/book"},"children":["Книга"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/ru/book/02"},"children":["Глава 2"," ·"," ","Не умирайте медленно"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"02-44"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["44"]},{"tag":"span","props":{"className":"life-evidence grade-b"},"children":["Доказательства"," ","B"]}]},{"tag":"h1","props":{"lang":"ru"},"children":["Если собаку и так хотели завести, засчитывайте ежедневные прогулки с ней в норму шагов, но не заводите собаку ради долголетия"]},{"tag":"p","props":{"lang":"ru","className":"life-entry-summary"},"children":["Люди с собаками в среднем умирают за тот же период примерно на четверть реже, а после инфаркта или инсульта владельцы собак выигрывают ещё больше. Но когда учтены другие различия, крупные исследования в Великобритании и Норвегии разницы не видят, а связи с содержанием кошки нет вообще. Поэтому не заводите собаку ради долголетия; если и так хотели, считайте ежедневную прогулку с ней обычной ходьбой."]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Затраты"]},{"tag":"p","props":{},"children":["Собака — это постоянные траты: корм, прививки, глистогонны…"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Польза"]},{"tag":"p","props":{},"children":["В объединённом анализе 10 наблюдательных исследований, около 3 840 000 человек, наблюдение в среднем 10,1 года…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"Отметить: Если собаку и так хотели завести, засчитывайте ежедневные прогулки с ней в норму шагов, но не заводите собаку ради долголетия"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"Сделано"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"В планах"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"В избранное"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Поделиться советом"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Скрыть подробности"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Затраты"]},{"tag":"p","props":{},"children":["Собака — это постоянные траты: корм, прививки, глистогонные, лечение, регистрация, и так до конца жизни собаки. Каждый день нужно находить время на прогулку, а при поездках искать, кому оставить животное. Трудно именно ходить каждый день: завёл собаку — и бросить уже нельзя. Официальной статистики о том, сколько в Китае стоит содержание собаки, нет, поэтому цифру здесь не приводим."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Польза"]},{"tag":"p","props":{},"children":["В объединённом анализе 10 наблюдательных исследований, около 3 840 000 человек, наблюдение в среднем 10,1 года, у владельцев собак риск смерти был ниже примерно на 24% (относительный риск 0,76, 95% ДИ 0,67–0,86). Сердечно-сосудистая смертность — ниже примерно на 31% (0,69, 0,67–0,71). Среди людей, перенёсших ишемическую болезнь сердца, у тех, у кого дома есть собака, риск ниже примерно на 65% (0,35, 0,17–0,69). Авторы пишут, что в этом объединённом расчёте другие факторы не учитывались. В национальном шведском регистровом исследовании около 3 430 000 человек учитывали доход, семейное положение и другое. У живущих в одиночку владельцев собак риск смерти ниже примерно на 33% (HR 0,67, 0,65–0,69), у живущих с другими людьми — ниже примерно на 11% (HR 0,89, 0,87–0,91). Среди шведских пациентов после инфаркта у живущих в одиночку владельцев собак риск смерти ниже примерно на 33% (HR 0,67, 0,61–0,75), а у живущих с партнёром или детьми — ниже примерно на 15% (HR 0,85, 0,80–0,90). После ишемического инсульта соответственно ниже примерно на 27% (HR 0,73, 0,66–0,80) и примерно на 12% (HR 0,88, 0,83–0,93). Возражения: в британском объединённом анализе 6 обследований здоровья, 59 352 человека, наблюдение в среднем 11,5 года, после полной поправки связи владения собакой со смертью нет (HR 1,03, 0,98–1,09) и с сердечно-сосудистой смертью тоже нет (HR 1,07, 0,96–1,18). В норвежском исследовании с медианой наблюдения 18,5 года риск смерти у владельцев собак почти такой же (HR 1,00, 0,91–1,09), и активнее других они там не были. В шведском регистре близнецов среди 34 202 человек, у которых удалось спросить про образ жизни, связь между собакой и более низким риском болезней сердца и смерти воспроизвести не удалось. В австралийском исследовании 15 735 человек, наблюдение 4 года, риск смерти у владельцев собак был ниже примерно на 23% (OR 0,77, 0,59–0,99), и часть этого можно объяснить большей активностью. Кошки, птицы и рыбки со смертностью не связаны. В заявлении Американской кардиологической ассоциации 2013 года сказано, что держать питомца, особенно собаку, для снижения сердечно-сосудистого риска «может быть разумно» — это самая слабая степень рекомендации. В том же заявлении прямо не советуют брать, спасать или покупать питомца главным образом ради снижения сердечно-сосудистого риска."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Первоисточники"]},{"tag":"p","props":{"className":"life-citations"},"children":["Kramer CK, Mehmood S, Suen RS (2019). Dog ownership and survival: a systematic review and meta-analysis. Circulation: Cardiovascular Quality and Outcomes, 12(10), e005554. ",{"tag":"a","props":{"href":"https://doi.org/10.1161/CIRCOUTCOMES.119.005554","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1161/CIRCOUTCOMES.119.005554"]},"；Mubanga M, Byberg L, Nowak C, 等 (2017). Dog ownership and the risk of cardiovascular disease and death – a nationwide cohort study. Scientific Reports, 7, 15821. ",{"tag":"a","props":{"href":"https://doi.org/10.1038/s41598-017-16118-6","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1038/s41598-017-16118-6"]},"；Mubanga M, Byberg L, Egenvall A, Ingelsson E, Fall T (2019). Dog ownership and survival after a major cardiovascular event: a register-based prospective study. Circulation: Cardiovascular Quality and Outcomes, 12(10), e005342. ",{"tag":"a","props":{"href":"https://doi.org/10.1161/CIRCOUTCOMES.118.005342","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1161/CIRCOUTCOMES.118.005342"]},"；Ding D, Bauman AE, Sherrington C, 等 (2018). Dog ownership and mortality in England: a pooled analysis of six population-based cohorts. American Journal of Preventive Medicine, 54(2), 289-293. ",{"tag":"a","props":{"href":"https://doi.org/10.1016/j.amepre.2017.09.012","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1016/j.amepre.2017.09.012"]},"；Torske MO, Krokstad S, Stamatakis E, Bauman A (2017). Dog ownership and all-cause mortality in a population cohort in Norway: the HUNT study. PLoS ONE, 12(6), e0179832. ",{"tag":"a","props":{"href":"https://doi.org/10.1371/journal.pone.0179832","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1371/journal.pone.0179832"]},"；Taniguchi Y, Ikeuchi T, Yong J (2024). Dog, cat, bird, fish, and other pet ownership and mortality: evidence from the HILDA cohort. PLoS ONE, 19(8), e0305546. ",{"tag":"a","props":{"href":"https://doi.org/10.1371/journal.pone.0305546","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1371/journal.pone.0305546"]},"；Mubanga M, Byberg L, Egenvall A, 等 (2019). Dog ownership and cardiovascular risk factors: a nationwide prospective register-based cohort study. BMJ Open, 9(3), e023447. ",{"tag":"a","props":{"href":"https://doi.org/10.1136/bmjopen-2018-023447","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1136/bmjopen-2018-023447"]},"；Levine GN, Allen K, Braun LT, 等 (2013). Pet ownership and cardiovascular risk: a scientific statement from the American Heart Association. Circulation, 127(23), 2353-2363. ",{"tag":"a","props":{"href":"https://doi.org/10.1161/CIR.0b013e31829201e1","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1161/CIR.0b013e31829201e1"]}]},{"tag":"a","props":{"href":"https://doi.org/10.1161/CIRCOUTCOMES.119.005554","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Открыть источник"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Примечание автора"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["Спорно. Всё перечисленное — наблюдение без разделения на группы, поэтому из него нельзя вывести «заведите собаку ради долголетия». Люди, которые заводят собак, могли быть здоровее и активнее и раньше, а больные и люди с инвалидностью могли реже заводить собак; эти различия полностью не убрать. Цифра 24% в объединённом анализе не поправлена ни на что, а в исследованиях, где удалось спросить про образ жизни, разница исчезла. В другом шведском исследовании владельцы собак даже чуть чаще начинали принимать лекарства от давления и холестерина, так что даже если риск смерти и правда ниже, то не потому, что снизились давление или липиды. Практический вывод один: если собака уже есть или вы и так хотели её завести, засчитывайте ежедневную прогулку в норму шагов; сколько этого достаточно, см. пункт 11 этого раздела (7000–8000 шагов в день). Про поводок, прививки и ответственность за укусы см. раздел 8, пункт 30 (собаку нужно выгуливать на поводке). О том, как пожилым родственникам держать поводок, чтобы не упасть, см. раздел 17, пункт 10 (пожилые люди и прогулки с собакой). Величина эффекта механически определена как «большая» по объединённым 24%, но эта цифра не поправлена. Главный выгодоприобретатель этого пункта — вы сами."]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Моя заметка"]},{"tag":"button","props":{"type":"button"},"children":["Запишите напоминание…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/ru/tip/02-43"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Предыдущий"]},"Если приливы и ночная потливость в период менопаузы мешают жить, обратитесь к гинекологу для оценки гормональной терапии: не терпите и не покупайте лекарства самостоятельно, а для профилактики болезней сердца её не используйте"]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["Другие советы по этой теме"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/02-37"},"children":[{"tag":"strong","props":{},"children":["Ограничьте дневной сон полчаса — не более часа; если вам необходимо спать по часу-два, чтобы чувствовать себя нормально, стоит выяснить причину"]},{"tag":"span","props":{},"children":["У людей, спящих днём не более часа, не повышается риск смертности и х…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/02-38"},"children":[{"tag":"strong","props":{},"children":["После бессонной ночи ложитесь спать пораньше на следующий вечер — не откладывайте это на выходные"]},{"tag":"span","props":{},"children":["У людей, которые после недосыпа не компенсировали его на следующую но…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/02-39"},"children":[{"tag":"strong","props":{},"children":["Чем дольше человек работает в ночную смену, тем выше риск сердечно-сосудистых заболеваний; при возможности стоит сменить работу"]},{"tag":"span","props":{},"children":["У людей, работающих в ночную смену, сердечно-сосудистых заболеваний п…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/02-40"},"children":[{"tag":"strong","props":{},"children":["Покупайте готовую упакованную растительную нефть с номером разрешения SC, а не самодельное арахисовое масло из частных мастерских"]},{"tag":"span","props":{},"children":["Если арахис намокнет и заплесневеет, в нём образуется афлатоксин — по…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/02-41"},"children":[{"tag":"strong","props":{},"children":["Замена свиного и сливочного жира на растительное масло в приготовлении пищи — не требует покупки разных видов масел ради здоровья, а льняное масло не защищает сердце"]},{"tag":"span","props":{},"children":["Уменьшение потребления насыщенных жиров, содержащихся в свином жире и…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/02-42"},"children":[{"tag":"strong","props":{},"children":["Включайте вытяжку при жарке и тушении — с момента зажигания плиты и до конца готовки"]},{"tag":"span","props":{},"children":["У некурящих китайских женщин, которые не включают или редко пользуютс…"]}]}]}]},{"tag":"a","props":{"className":"life-text-link","href":"/ru/book/02"},"children":["Читать всю тему: Не умирайте медленно"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"15","height":"15","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]}]}]},{"tag":"nav","props":{"className":"life-tabbar","aria-label":"Основная навигация"},"children":[{"tag":"a","props":{"className":"","href":"/ru/book"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"21","height":"21","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-book-open","aria-hidden":"true"},"chi