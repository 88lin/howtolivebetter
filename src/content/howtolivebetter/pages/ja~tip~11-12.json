x":"12","cy":"10","r":"4"},"children":[]},{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},{"tag":"span","props":{},"children":["ログイン"]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/ja/book/11"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"目次に戻る"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["エンジニアや技術者が陥りやすいレッドライン（禁忌事項）"]},{"tag":"nav","props":{"aria-label":"この章のヒント"},"children":[{"tag":"a","props":{"href":"/ja/tip/11-01"},"children":[{"tag":"span","props":{},"children":["01"]},"行動に移る前にまず確認する：メーカー、プラットフォーム、会社が警察に届け出るか。刑事責任を追及されたら、すぐ刑事事件の弁護士を探す"]},{"tag":"a","props":{"href":"/ja/tip/11-02"},"children":[{"tag":"span","props":{},"children":["02"]},"ゲームのチートや補助ツールを作らず、売らない。「画面だけ読み、メモリには触れない」AI 補助も含む。微信などに機能を追加した改造版も売らない"]},{"tag":"a","props":{"href":"/ja/tip/11-03"},"children":[{"tag":"span","props":{},"children":["03"]},"チケット争奪、タイムセール、注文操作、ポイ活（羊毛剥ぎ）のためのスクリプトを書かない・販売しない。たとえそれが単なる「ボタンの自動クリック」であっても"]},{"tag":"a","props":{"href":"/ja/tip/11-04"},"children":[{"tag":"span","props":{},"children":["04"]},"クローラーはログイン不要の公開ページのみを巡回する。回避策や個人情報には触れず、取得したデータは販売しない"]},{"tag":"a","props":{"href":"/ja/tip/11-05"},"children":[{"tag":"span","props":{},"children":["05"]},"ギャンブル、詐欺、アダルトAppの開発案件は受けない。「クライアント」のために決済チャネルの構築やアカウントの凍結解除を行わない"]},{"tag":"a","props":{"href":"/ja/tip/11-06"},"children":[{"tag":"span","props":{},"children":["06"]},"退職時にはアカウント権限をすべて返却する。データベースの削除、バックドアの設置、パスワード変更によるシステムのロックは行わない。たとえ会社から未払い賃金があったとしても"]},{"tag":"a","props":{"href":"/ja/tip/11-07"},"children":[{"tag":"span","props":{},"children":["07"]},"退職時にソースコード、顧客リスト、技術文書を持ち出さない、個人のクラウドストレージにアップロードしない、転職先で再利用しない"]},{"tag":"a","props":{"href":"/ja/tip/11-08"},"children":[{"tag":"span","props":{},"children":["08"]},"他人のコンピュータ、サーバ、カメラ上で自作プログラムを動作させない、会社の機器をマイニングに使用しない"]},{"tag":"a","props":{"href":"/ja/tip/11-09"},"children":[{"tag":"span","props":{},"children":["09"]},"書面による許可なく他人のシステムをテストしない、「善意」や「事後報告」は免責理由にならない"]},{"tag":"a","props":{"href":"/ja/tip/11-10"},"children":[{"tag":"span","props":{},"children":["10"]},"脆弱性は規定に従って報告すること。修正前は詳細を公開せず、悪用ツールを配布せず、国外へ渡さないこと"]},{"tag":"a","props":{"href":"/ja/tip/11-11"},"children":[{"tag":"span","props":{},"children":["11"]},"検閲回避ツールやVPNアカウントを販売しない、他人のためにこのようなノードを構築しない"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/ja/tip/11-12","data-status":"active"},"children":[{"tag":"span","props":{},"children":["12"]},"競業避止義務契約を締結した場合、退職後に会社が毎月補償金を支払わないときは書面で催告すること。3 ヶ月支払われなければ解除可能。営業秘密に触れていない職務については、条項の不適用を請求できる"]},{"tag":"a","props":{"href":"/ja/tip/11-13"},"children":[{"tag":"span","props":{},"children":["13"]},"勤務時間中や会社の資産を使用して書いたコードは会社に帰属する。個人のオープンソースプロジェクトは、自身の時間とデバイスを使用し、会社のコードと混在させないこと"]},{"tag":"a","props":{"href":"/ja/tip/11-14"},"children":[{"tag":"span","props":{},"children":["14"]},"GPLなどのオープンソースコードを使用して製品を作る際、ライセンスの要求に従ってオープンソース化するか、ライセンスを変更しなければ、「誰も見ていない」とは言えない"]},{"tag":"a","props":{"href":"/ja/tip/11-15"},"children":[{"tag":"span","props":{},"children":["15"]},"アプリでは業務上必要な個人情報のみを収集すること。14歳未満は保護者の同意が必要。プライバシーポリシーに明記すること"]},{"tag":"a","props":{"href":"/ja/tip/11-16"},"children":[{"tag":"span","props":{},"children":["16"]},"ウェブサイトやAppの公開前にICP備案（登録）を行い、等級保護の要件に従って 6 ヶ月以上のログを保存すること"]},{"tag":"a","props":{"href":"/ja/tip/11-17"},"children":[{"tag":"span","props":{},"children":["17"]},"生成AIサービスを一般に提供する際は、規定に基づき安全評価とアルゴリズムの届出を行い、生成コンテンツに識別標識を付与すること"]},{"tag":"a","props":{"href":"/ja/tip/11-18"},"children":[{"tag":"span","props":{},"children":["18"]},"他社 App の広告を自動でスキップ・遮断するツールを作らず、公開しない。無料で通信しなくても不正競争と認定される可能性がある"]},{"tag":"a","props":{"href":"/ja/tip/11-19"},"children":[{"tag":"span","props":{},"children":["19"]},"海外モデル API を安く転売する「AI 中継サイト」を開かない。上海では運営者が刑事拘留された"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"現在地"},"children":[{"tag":"a","props":{"href":"/ja/book"},"children":["本を読む"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/ja/book/11"},"children":["第11章"," ·"," ","エンジニアや技術者が陥りやすいレッドライン（禁忌事項）"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"11-12"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["12"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["エビデンス"," ","A"]}]},{"tag":"h1","props":{"lang":"ja"},"children":["競業避止義務契約を締結した場合、退職後に会社が毎月補償金を支払わないときは書面で催告すること。3 ヶ月支払われなければ解除可能。営業秘密に触れていない職務については、条項の不適用を請求できる"]},{"tag":"p","props":{"lang":"ja","className":"life-entry-summary"},"children":["競業避止とは、退職後の一定期間、競合他社での勤務を禁止するもので、最長は 2 年です。会社は毎月補償金を支払う必要があります。金額の定めがない場合は、退職前 12 ヶ月の平均賃金の 30% とし、現地の最低賃金を下回らないものとします。会社の理由により 3 ヶ月支払われなかった場合、解除を請求できます。2025 年以降、営業秘密に触れていない職務については、条項の不適用を請求できます。"]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["費用・手間"]},{"tag":"p","props":{},"children":["費用はかかりません。退職時に競業避止契約の原本と、会社が毎月支払っていない証拠を保管しておいてください。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["効果"]},{"tag":"p","props":{},"children":["競業避止義務は、経営幹部、上級技術者、およびその他守秘義務を負う者にのみ適用されます。"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"記録する：競業避止義務契約を締結した場合、退職後に会社が毎月補償金を支払わないときは書面で催告すること。3 ヶ月支払われなければ解除可能。営業秘密に触れていない職務については、条項の不適用を請求できる"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"できている"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"やることに追加"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"お気に入り"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"このヒントを共有"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"詳細を閉じる"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["費用・手間"]},{"tag":"p","props":{},"children":["費用はかかりません。退職時に競業避止契約の原本と、会社が毎月支払っていない証拠を保管しておいてください。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["効果"]},{"tag":"p","props":{},"children":["競業避止義務は、経営幹部、上級技術者、およびその他守秘義務を負う者にのみ適用されます。期間は最長 2 年です。会社は、この期間中、毎月経済的補償を支払わなければなりません。補償額の定めがない場合は、離職前 12 ヶ月間の平均賃金の 30% とし、現地の最低賃金を下回らないものとします。会社の責に帰すべき理由により 3 ヶ月間支払いが滞った場合、労働者は当該競業避止義務の解除を請求できます。会社側から自発的に解除する場合、追加で 3 ヶ月分の補償を支払う必要があります。2025 年以降、職務において営業秘密を知らず、かつ接触もしていない労働者は、当該条項の不適用を請求できます。合意された範囲が、本人が実際に知っている秘密の範囲を超えている場合、その超過部分は無効となります。公的事例：ある製薬会社が最高技術責任者（CTO）の鄭氏を提訴し、違約金として 710 万元を請求した。裁判所は、転職先の製品が前職の製品の代替品には当たらないと認定し、競業避止義務の範囲は彼が実際に知得した秘密に限定されるべきとした。請求はすべて棄却された（全国）"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["出典"]},{"tag":"p","props":{"className":"life-citations"},"children":["全国人大常委会 (2012). 劳动合同法（2012 年修正，第二十三、二十四条）. ",{"tag":"a","props":{"href":"https://yjglj.fushun.gov.cn/008/20260622/d846d3c2-df3d-4c4c-af16-898ede43e1ee.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://yjglj.fushun.gov.cn/008/20260622/d846d3c2-df3d-4c4c-af16-898ede43e1ee.html"]},"（抚顺市应急管理局转载）；最高人民法院 (2020). 关于审理劳动争议案件适用法律问题的解释（一）（第三十六至四十条）. ",{"tag":"a","props":{"href":"https://www.court.gov.cn/zixun/xiangqing/282121.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.court.gov.cn/zixun/xiangqing/282121.html"]},"；最高人民法院 (2025). 关于审理劳动争议案件适用法律问题的解释（二）（法释〔2025〕12 号，第十三至十五条）. ",{"tag":"a","props":{"href":"https://www.court.gov.cn/zixun/xiangqing/472691.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.court.gov.cn/zixun/xiangqing/472691.html"]},"；最高人民法院 (2025). 劳动争议典型案例（案例四）. ",{"tag":"a","props":{"href":"https://www.court.gov.cn/zixun/xiangqing/472681.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.court.gov.cn/zixun/xiangqing/472681.html"]}]},{"tag":"a","props":{"href":"https://yjglj.fushun.gov.cn/008/20260622/d846d3c2-df3d-4c4c-af16-898ede43e1ee.html","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["出典を開く"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","pr