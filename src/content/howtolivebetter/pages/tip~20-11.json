org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["成本"]},{"tag":"p","props":{"className":"life-citations"},"children":["不用额外花钱，省下来的钱通常以千元计。难在忍住不一次性把东西配齐"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["收益"]},{"tag":"p","props":{"className":"life-citations"},"children":["婴儿车、婴儿床、抱被、玩具的使用期都很短，二手市场上供给远大于需求。二手货要守住三条安全边界。第一条是安全座椅。美国国家公路交通安全管理局建议，座椅出过中度或重度车祸就要换掉，绝不再用。五条全满足才算轻微碰撞，座椅可以接着用。五条是：车能自己开走，离座椅最近的车门没坏，车上没人受伤，气囊没弹出，座椅上看不出损伤。二手座椅要确认五项才可以用。五项是：没出过中度以上车祸，标签上有生产日期和型号，没被召回，零件齐全，说明书还在。生产日期和型号用来查召回、查座椅是不是太旧。第二条是床垫。苏格兰有一项研究，拿猝死的婴儿和同龄健康婴儿比，回头查各自睡什么床垫。平时睡别的孩子用过的床垫，婴儿猝死综合征的风险更高（OR 3.07，约为 3 倍，95% CI 1.51–6.22）。床垫来自别人家时是 4.78，来自自己家时是 1.64，后者算不上有差别。作者说，现有证据还不够判断是不是床垫本身造成的。第三条是婴儿床。美国从 2011 年 6 月 28 日起执行新的婴儿床强制标准，二手婴儿床也要符合。传统的一侧护栏能上下放的款式被淘汰了。美国消费品安全委员会说，旧床要拆坏了测才知道合不合格，所以给不出自查办法。2007 年 11 月到 2010 年 4 月，美国报告了 147 起和标准尺寸婴儿床有关的死亡。其中 35 起是床的结构出了问题，18 起和能放下的护栏出故障有关。螺丝松动至少造成 10 起死亡。美国法律把斜躺式婴儿睡篮列为禁售品，不管哪年生产的都算，2023 年写进了监管规定（美国、英国）"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["来源"]},{"tag":"p","props":{"className":"life-citations"},"children":["省钱部分为作者经验，无直接文献；US NHTSA. Car Seat Use After a Crash. ",{"tag":"a","props":{"href":"https://www.nhtsa.gov/car-seats-and-booster-seats/car-seat-use-after-crash","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.nhtsa.gov/car-seats-and-booster-seats/car-seat-use-after-crash"]},"；US NHTSA. Used Car Seat Safety Checklist. ",{"tag":"a","props":{"href":"https://www.nhtsa.gov/car-seats-and-booster-seats/used-car-seat-safety-checklist","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.nhtsa.gov/car-seats-and-booster-seats/used-car-seat-safety-checklist"]},"；Tappin D, Brooke H, Ecob R, Gibson A (2002). Used infant mattresses and sudden infant death syndrome in Scotland: case-control study. BMJ, 325(7371), 1007. ",{"tag":"a","props":{"href":"https://doi.org/10.1136/bmj.325.7371.1007","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1136/bmj.325.7371.1007"]},"；Blair P, Fleming P, Smith I (1997). Case-control study of sudden infant death syndrome in Scotland. Income level or bed sharing would confound any effect of previous use of mattress. BMJ, 315(7111), 812. ",{"tag":"a","props":{"href":"https://doi.org/10.1136/bmj.315.7111.812a","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1136/bmj.315.7111.812a"]},"；US Consumer Product Safety Commission (2010). Safety Standards for Full-Size Baby Cribs and Non-Full-Size Baby Cribs; Final Rule. Federal Register 2010-32178. ",{"tag":"a","props":{"href":"https://www.federalregister.gov/documents/2010/12/28/2010-32178/safety-standards-for-full-size-baby-cribs-and-non-full-size-baby-cribs-final-rule","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.federalregister.gov/documents/2010/12/28/2010-32178/safety-standards-for-full-size-baby-cribs-and-non-full-size-baby-cribs-final-rule"]},"；US Consumer Product Safety Commission (2023). Ban of Inclined Sleepers for Infants. Federal Register 2023-17350. ",{"tag":"a","props":{"href":"https://www.federalregister.gov/documents/2023/08/16/2023-17350/ban-of-inclined-sleepers-for-infants","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.federalregister.gov/documents/2023/08/16/2023-17350/ban-of-inclined-sleepers-for-infants"]},"；冲动消费见第 5 节"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["原书备注"]},{"tag":"p","props":{"className":"life-citations"},"children":["证据等级仍是 C，因为省钱这一半没有文献。三条安全边界各有出处，但都是美国和英国的。国内没查到官方对二手婴儿床、二手安全座椅的专门提示。床垫那项研究有人提出异议：1997 年有学者来信说，家庭收入和同床睡会混淆二手床垫的影响。坐车为什么要用安全座椅，见第 1 节第 10 条（安全座椅）。婴儿怎么睡、床上放什么，见本节第 1 条（仰着睡）。月子会所、早教课、婴儿游泳馆这几类，本书不推荐也不否定。但它们都是可花可不花的一笔大钱，适用第 5 节讲的 24 小时冷静期"]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["我的备注"]},{"tag":"button","props":{"type":"button"},"children":["写下对自己有用的提醒…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/tip/20-10"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["上一条"]},"尿布不看牌子看三件事：合不合身、换得勤不勤、有没有被抽检通报过"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/tip/20-12"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["下一条"]},"孩子有严重湿疹或鸡蛋过敏，别躲着花生，按医生指导早点加上，但绝不能喂整粒"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["本主题的其他建议"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/20-06"},"children":[{"tag":"strong","props":{},"children":["不满 1 岁不喂蜂蜜"]},{"tag":"span","props":{},"children":["孩子不满 1 岁，不要喂蜂蜜。蜂蜜水、拌进辅食里的蜂蜜、含蜂蜜的糕点，都算。蜂蜜里可能带有引起肉毒中毒的细菌。大人肚子里的菌群能压住它，婴儿压不住。"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/20-07"},"children":[{"tag":"strong","props":{},"children":["出生时的维生素 K 针一定要打"]},{"tag":"span","props":{},"children":["新生儿身体里存的维生素 K 很少，不补可能出血，晚出现的那种常常是脑子里出血。塔什干没普遍做这种预防，每 10 万个新生儿有 478 个出这种血。做了预防，估计…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/20-08"},"children":[{"tag":"strong","props":{},"children":["不满 3 个月的婴儿体温到 38 ℃ 就直接去医院，不在家观察"]},{"tag":"span","props":{},"children":["孩子不满 3 个月，体温到 38 ℃ 就直接去医院。不要在家观察，也不要先喂退烧药再等等看。美国儿科学会专门给看着状态还可以的发热婴儿定了处理办法，所以「看着精…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/20-09"},"children":[{"tag":"strong","props":{},"children":["无论多累多气都不要摇晃婴儿"]},{"tag":"span","props":{},"children":["婴儿的头大，脖子没力气。用力摇晃会让他脑子里、眼睛里出血，可能要了他的命，也可能留下一辈子的残疾。哄睡时轻轻晃不算，危险的是控制不住的猛晃。快压不住火时，把孩子…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/20-13"},"children":[{"tag":"strong","props":{},"children":["盯住新生儿黄疸的几个信号：出生 24 小时内就黄、叫不醒不吃奶，就当天去医院；越来越黄、大便发白，就尽快去查"]},{"tag":"span","props":{},"children":["八成以上的新生儿会有点黄。出生不满 24 小时就黄，或者黄的同时比平时嗜睡叫不醒、不吃奶、身子发软或发硬，要马上去医院。过了 24 小时越来越黄，或者大便颜色发…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/20-14"},"children":[{"tag":"strong","props":{},"children":["怀孕、喂奶时在吃素，就补维生素 B12 或吃强化食品；孩子的辅食要有动物性食物，非要全素先找医生"]},{"tag":"span","props":{},"children":["维生素 B12 几乎只在肉、蛋、奶里有，吃全素的要靠强化食品或补充剂。妈妈吃全素又没补，喂母乳的孩子就容易缺。孩子多在 4 到 8 个月大时出问题：长不大、发育…"]}]}]}]},{"tag":"a","props":{"className":"life-text-link","href":"/book/20"},"children":["阅读整个主题：刚出生的孩子怎么带 ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"15","height":"15","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":