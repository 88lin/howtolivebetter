ssName":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Ocultar detalles"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Coste"]},{"tag":"p","props":{},"children":["0; solo se aplaza la decisión, y el precio es que puedes perder alguna oportunidad"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Beneficio"]},{"tag":"p","props":{},"children":["Evita decisiones patrimoniales irreversibles justo tras un golpe, cuando peor se juzga: vender la casa, renunciar, invertir de una vez ayudas o indemnizaciones, casarse de nuevo deprisa o avalar. Suelen ser desde decenas de miles de yuanes hasta una vivienda, por eso el beneficio es medio. Los documentos oficiales chinos incluyen cambios familiares, desempleo y abandono escolar entre los riesgos de crisis psicológica que la comunidad debe detectar: son situaciones que requieren apoyo externo. La guía de duelo del NIA estadounidense señala la dificultad de decidir y aconseja aplazar grandes decisiones hasta sentirse mejor, si es posible. En pleno duelo puede costar pensar con claridad: evite cambios como vender la casa o dejar el trabajo. Un estudio con tres experimentos asignó al azar una inducción de tristeza y luego ofreció dinero ahora o en 3 meses. Frente a quienes estaban tranquilos, los tristes aceptaban entre un 13% y un 34% menos para no esperar. Era tristeza inducida, no duelo real. En 2023 la FTC advirtió de impostores de funerarias que amenazaban con cancelar el funeral si no se pagaba más inmediatamente. Su primer consejo: resistir la urgencia; un negocio legítimo dará tiempo para decidir."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Fuentes originales"]},{"tag":"p","props":{"className":"life-citations"},"children":["国家卫生健康委等 25 部门 (2026). 健全社会心理服务体系和危机干预机制实施方案（国卫医政发〔2026〕8 号）. ",{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/202604/content_7065035.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/zhengce/zhengceku/202604/content_7065035.htm"]},"；National Institute on Aging. Coping With Grief and Loss（「Postpone major decisions if possible」一段，页面 2026-01-26 更新）. ",{"tag":"a","props":{"href":"https://www.nia.nih.gov/health/grief-and-mourning/coping-grief-and-loss","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.nia.nih.gov/health/grief-and-mourning/coping-grief-and-loss"]},"；Lerner JS, Li Y, Weber EU (2013). The financial costs of sadness. Psychological Science, 24(1), 72-79. ",{"tag":"a","props":{"href":"https://doi.org/10.1177/0956797612450302","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1177/0956797612450302"]},"；Puig A, Federal Trade Commission (2023-06-15). Imposters prey on families preparing for the funeral of a loved one. ",{"tag":"a","props":{"href":"https://consumer.ftc.gov/consumer-alerts/2023/06/imposters-prey-families-preparing-funeral-loved-one","target":"_blank","rel":"noopener noreferrer"},"children":["https://consumer.ftc.gov/consumer-alerts/2023/06/imposters-prey-families-preparing-funeral-loved-one"]}]},{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/202604/content_7065035.htm","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Abrir fuente"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13"