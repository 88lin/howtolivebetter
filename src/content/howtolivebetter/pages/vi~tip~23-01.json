n":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Chi phí"]},{"tag":"p","props":{},"children":["Không tốn tiền. Tốn một phút để tính xem mình bao nhiêu tuổi."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Lợi ích"]},{"tag":"p","props":{},"children":["Luật Giáo dục bắt buộc (义务教育法) quy định ở Điều mười một:「凡年满六周岁的儿童，其父母或者其他法定监护人应当送其入学接受并完成义务教育」. Điều mười bốn:「禁止用人单位招用应当接受义务教育的适龄儿童、少年」. Điều năm mươi tám: trẻ em đủ tuổi đi học mà không có lý do chính đáng, không cho đi học đúng quy định luật này, thì chính quyền xã hoặc giáo dục của chính quyền huyện địa phương「给予批评教育，责令限期改正」. Quy định cấm sử dụng lao động trẻ em (禁止使用童工规定) Điều hai: cơ quan nhà nước, tổ chức xã hội, doanh nghiệp và đơn vị sự nghiệp, đơn vị phi lợi nhuận tư nhân, hay hộ kinh doanh cá thể「均不得招用不满16周岁的未成年人」. Điều sáu:「按照每使用一名童工每月处5000元罚款的标准给予处罚」, quá hạn không sửa thì phạt mỗi người mỗi tháng 1 vạn tệ. Điều bảy: giới thiệu lao động trẻ em đi làm thì「按照每介绍一人处5000元罚款」. Điều mười: lao động trẻ em ốm hay bị thương thì người sử dụng lao động「应当负责送到医疗机构治疗，并负担治疗期间的全部医疗和生活费用」, thương tật hoặc tử vong thì còn phải bồi thường một lần. Điều mười ba chỉ chừa một ngoại lệ: đơn vị văn hoá và thể thao, có sự đồng ý của cha mẹ hoặc người giám hộ khác, được thuê người làm nghệ thuật chuyên nghiệp và vận động viên dưới 16 tuổi (toàn quốc)"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Nguồn gốc"]},{"tag":"p","props":{"className":"life-citations"},"children":["全国人大常委会 (2018). 义务教育法（2018 年第二次修正，第十一、十四、五十八条）. ",{"tag":"a","props":{"href":"http://www.moe.gov.cn/jyb_sjzl/sjzl_zcfg/zcfg_jyfl/202110/t20211029_575949.html","target":"_blank","rel":"noopener noreferrer"},"children":["http://www.moe.gov.cn/jyb_sjzl/sjzl_zcfg/zcfg_jyfl/202110/t20211029_575949.html"]},"（教育部刊登）；国务院 (2002). 禁止使用童工规定（国务院令第 364 号，第二、六、七、十、十三条）. ",{"tag":"a","props":{"href":"http://www.gov.cn/gongbao/content/2002/content_61798.htm","target":"_blank","rel":"noopener noreferrer"},"children":["http://www.gov.cn/gongbao/content/2002/content_61798.htm"]}]},{"tag":"a","props":{"href":"http://www.moe.gov.cn/jyb_sjzl/sjzl_zcfg/zcfg_jyfl/202110/t20211029_575949.html","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Liên kết mở nguồn"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Ghi chú sách"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["Người hưởng lợi là bạn. Sau 16 tuổi thì đi làm công là hợp pháp. Nhưng những chỗ nhận một người 16 tuổi không học vấn đúng là loại mục 10 của phần này nói tới (chọn kỹ năng chống bị máy thay), quy trình cố định, dễ bị máy đẩy ra nhất. Tiền làm thêm giờ, nghỉ phép năm, ưu đãi tai nạn lao động mà phần 19 nói tới, đều đặt điều kiện là có quan hệ lao động và có bằng chứng. Việc chui không có cả hai, nên số tiền đó cũng không lấy được."]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Ghi chú của tôi"]},{"tag":"button","props":{"type":"button"},"children":["Viết một lời nhắc cho chính bạn…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"span","props":{},"children":[]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/vi/tip/23-02"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Tiếp theo"]},"Cũng đưa「học có ích không」vào bảng tính tỷ lệ tử vong: mỗi thêm một năm học, nguy cơ tử vong ở người lớn giảm khoảng 1.9%"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["Thêm trong chủ đề này"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/23-03"},"children":[{"tag":"strong","props":{},"children":["Trước khi kết luận «học vấn có mất giá không», xem cơ cấu học vấn cả nước: mỗi 100000 người chỉ có 15467 người có trình độ đại học (tổng điều tra 2020, ước tính từ mẫu 2025 khoảng 19%)"]},{"tag":"span","props":{},"children":["Trong tổng điều tra dân số 2020, người học tới cao đẳng trở lên chiếm…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/23-04"},"children":[{"tag":"strong","props":{},"children":["Trường hợp「không đủ tiền để đi học」thì tính theo chính sách trước đã: học phí trường trung cấp chuyên nghiệp đã miễn phần lớn, học bổng 2300 tệ, học vay tối đa 2 vạn tệ một năm"]},{"tag":"span","props":{},"children":["Trong trường trung cấp chuyên nghiệp công lập, học sinh nông thôn, họ…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/23-05"},"children":[{"tag":"strong","props":{},"children":["Không đỗ được trường phổ thông không phải là hết đường: trường trung cấp chuyên nghiệp có tuyển sinh liên thông và thi riêng, tuyển dụng lao động kỹ thuật còn được hạ yêu cầu học vấn"]},{"t