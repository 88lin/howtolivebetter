g":"div","props":{"className":"life-ad-rail","data-dock-active":"false","style":{"top":"94px"}},"children":[{"tag":"div","props":{"className":"life-ad-dock","hidden":true},"children":[{"tag":"aside","props":{"className":"life-ad-space life-ad-space-sponsored life-ad-space-compact","data-ad-placement":"ad_dock","data-ad-group":"reading","data-ad-creative":"read_product","data-ad-ready":"false","aria-label":"Advertisement · Community recommendation"},"children":[{"tag":"button","props":{"type":"button","className":"life-ad-dismiss","aria-label":"Close ad"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-x","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M18 6 6 18"},"children":[]},{"tag":"path","props":{"d":"m6 6 12 12"},"children":[]}]}]},{"tag":"div","props":{"className":"life-ad-space-brand"},"children":[{"tag":"img","props":{"src":"/sites/howtolivebetter/images/shengcai/logo.png","width":"565","height":"144","alt":"Official Shengcai Youshu logo","decoding":"async"},"children":[]}]},{"tag":"div","props":{"className":"life-ad-space-copy"},"children":[{"tag":"span","props":{"className":"life-ad-space-label"},"children":["Advertisement · Community recommendation"]},{"tag":"strong","props":{},"children":["Could what you know become a useful product?"]},{"tag":"p","props":{},"children":["From ebooks to small tools, explore how members spot needs and turn knowledge into something people can use."]}]},{"tag":"div","props":{"className":"life-ad-space-actions"},"children":[{"tag":"a","props":{"className":"life-ad-space-link","href":"/en/shengcaiyoushu?sc_group=reading&sc_creative=read_product&sc_placement=ad_dock"},"children":["Explore the community and examples",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"18","height":"18","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-up-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M7 7h10v10"},"children":[]},{"tag":"path","props":{"d":"M7 17 17 7"},"children":[]}]}]}]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/en/book/12"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"Back to index"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["Starting a business: how to protect your personal assets"]},{"tag":"div","props":{"data-ad-dock-host":"true"},"children":[]},{"tag":"nav","props":{"aria-label":"Chapter entries"},"children":[{"tag":"a","props":{"href":"/en/tip/12-01"},"children":[{"tag":"span","props":{},"children":["01"]},"Only invest money you can afford to lose — never use family savings or borrowed funds"]},{"tag":"a","props":{"href":"/en/tip/12-02"},"children":[{"tag":"span","props":{},"children":["02"]},"Never sign personal guarantees for corporate loans; spouses should definitely avoid signing too"]},{"tag":"a","props":{"href":"/en/tip/12-03"},"children":[{"tag":"span","props":{},"children":["03"]},"Choosing the right legal entity before launching: sole proprietors and general partners are fully liable, while limited liability companies offer “limited” liability"]},{"tag":"a","props":{"href":"/en/tip/12-04"},"children":[{"tag":"span","props":{},"children":["04"]},"Improperly listed shareholders: never hold shares on someone else’s behalf"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/en/tip/12-05","data-status":"active"},"children":[{"tag":"span","props":{},"children":["05"]},"Check the Ministry of Commerce records before signing; obtain written disclosures and include a “cooling-off period” in the contract"]},{"tag":"a","props":{"href":"/en/tip/12-06"},"children":[{"tag":"span","props":{},"children":["06"]},"Determine the business name, location, scope of operations, and registered capital before registration; with complete documents, you can obtain the business license on the spot"]},{"tag":"a","props":{"href":"/en/tip/12-07"},"children":[{"tag":"span","props":{},"children":["07"]},"Businesses requiring licenses must wait until they obtain one"]},{"tag":"a","props":{"href":"/en/tip/12-08"},"children":[{"tag":"span","props":{},"children":["08"]},"Figure out which category you fall into: producing or preparing food requires a permit, selling only pre-packaged goods needs a filing, while selling fresh meat and vegetables needs no permit at all"]},{"tag":"a","props":{"href":"/en/tip/12-09"},"children":[{"tag":"span","props":{},"children":["09"]},"Packaging food for sale makes it prepackaged food: labels must include production date, shelf life, and ingredient list without exception"]},{"tag":"a","props":{"href":"/en/tip/12-10"},"children":[{"tag":"span","props":{},"children":["10"]},"General foods must not claim therapeutic effects: this applies to labels, instructions, ads, and live-stream scripts alike"]},{"tag":"a","props":{"href":"/en/tip/12-11"},"children":[{"tag":"span","props":{},"children":["11"]},"The food industry faces criminal penalties: selling meat from diseased animals or products exceeding safety limits is already a crime; adding toxic or harmful non-food substances carries a minimum five-year sentence regardless of revenue"]},{"tag":"a","props":{"href":"/en/tip/12-12"},"children":[{"tag":"span","props":{},"children":["12"]},"Once you obtain a business license, you must file tax returns on schedule — even if you have no income, you still need to submit a return with all zeros"]},{"tag":"a","props":{"href":"/en/tip/12-13"},"children":[{"tag":"span","props":{},"children":["13"]},"Invoices must reflect actual transactions; small taxpayers can fully utilize tax exemptions"]},{"tag":"a","props":{"href":"/en/tip/12-14"},"children":[{"tag":"span","props":{},"children":["14"]},"Scammers pretending to be tax officials demanding payments are fraudsters; tax filings must be done via the e-Tax Service or by calling 12366"]},{"tag":"a","props":{"href":"/en/tip/12-15"},"children":[{"tag":"span","props":{},"children":["15"]},"Writing “deposit” instead of “advance payment” in contracts, specifying penalty amounts, and treating credit terms as loans"]},{"tag":"a","props":{"href":"/en/tip/12-16"},"children":[{"tag":"span","props":{},"children":["16"]},"Sign a written contract within the first month of employment; register for social insurance within 30 days"]},{"tag":"a","props":{"href":"/en/tip/12-17"},"children":[{"tag":"span","props":{},"children":["17"]},"Wages must be paid according to contracts and laws; raises, loans, and bonuses all require written documentation"]},{"tag":"a","props":{"href":"/en/tip/12-18"},"children":[{"tag":"span","props":{},"children":["18"]},"Sell first, then produce: use pre-orders and small orders to confirm demand before investing in manufacturing"]},{"tag":"a","props":{"href":"/en/tip/12-19"},"children":[{"tag":"span","props":{},"children":["19"]},"Run the prototype through the production checklist before starting full production"]},{"tag":"a","props":{"href":"/en/tip/12-20"},"children":[{"tag":"span","props":{},"children":["20"]},"Keep copies of invoices and supplier documentation for every shipment; avoid purchasing goods priced significantly below market rates: if an employee buys counterfeit products, the employer can still be held legally responsible"]},{"tag":"a","props":{"href":"/en/tip/12-21"},"children":[{"tag":"span","props":{},"children":["21"]},"Whether creating designs yourself or purchasing licensed artwork, simply changing colors or adding icons does not count as “modifications” for copyright purposes"]},{"tag":"a","props":{"href":"/en/tip/12-22"},"children":[{"tag":"span","props":{},"children":["22"]},"Follow procedures at work; think carefully about who bears responsibility before offering unsolicited help"]},{"tag":"a","props":{"href":"/en/tip/12-23"},"children":[{"tag":"span","props":{},"children":["23"]},"Exit the process as planned when losses occur: opt for simplified deregistration when possible, or file for bankruptcy if debts exceed assets — don’t leave things unattended"]},{"tag":"a","props":{"href":"/en/tip/12-24"},"children":[{"tag":"span","props":{},"children":["24"]},"Before paying for third‑party store management, e‑commerce training, or “dropshipping” services, be sure to ask whether extra fees will be required and where the sales figures actually come from"]},{"tag":"a","props":{"href":"/en/tip/12-25"},"children":[{"tag":"span","props":{},"children":["25"]},"Companies and individual businesses in China must report the previous year online from January 1 to June 30, even without business activity; annual reports are free"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"Breadcrumb"},"children":[{"tag":"a","props":{"href":"/en/book"},"children":["Explore the book"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/en/book/12"},"children":["Chapter 12"," ·"," ","Starting a business: how to protect your personal assets"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"12-05"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["05"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["Evidence"," ","A"]}]},{"tag":"h1","props":{"lang":"en"},"children":["Check the Ministry of Commerce records before signing; obtain written disclosures and include a “cooling-off period” in the contract"]},{"tag":"p","props":{"lang":"en","className":"life-entry-summary"},"children":["By law, a franchisor must first operate at least two company-owned stores for a full year, and must register those stores with the Ministry of Commerce within 15 days after signing the franchise agreement. Before signing, it must also furnish you with written disclosures on 12 specific topics, including franchise fees, refund policies for deposits, and the profitability of existing stores. If a brand fails to register, refuses to provide these disclosures, or demands payment before letting you see the contract, you should walk away immediately."]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Cost"]},{"tag":"p","props":{},"children":["There is no cost involved. Simply visit the Ministry of Co…"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Benefit"]},{"tag":"p","props":{},"children":["Legal requirements mandate that any franchisor maintain at least two company-owned stores that have been opera…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"Mark: Check the Ministry of Commerce records before signing; obtain written disclosures and include a “cooling-off period” in the contract"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"Done"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"Plan to do"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"Save"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Share this tip"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Hide details"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Cost"]},{"tag":"p","props":{},"children":["There is no cost involved. Simply visit the Ministry of Commerce’s “Franchise Information Management System” website to verify whether the brand has been registered. Then ask the franchisor to provide you with written disclosures covering all required details prior to signing, along with the contract itself. This whole process takes just a few hours."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Benefit"]},{"tag":"p","props":{},"children":["Legal requirements mandate that any franchisor maintain at least two company-owned stores that have been operating for at least one year. Within 15 days of signing the franchise contract, it must register those stores with the relevant authorities; failure to do so results in fines ranging from 10,000 to 50,000 yuan. If registration is delayed further, fines rise to 50,000–100,000 yuan and the violation is publicly announced. Prior to signing, the franchisor must provide you with written disclosures on 12 mandatory topics, such as exact fee structures, conditions under which deposits are refundable, current franchisee numbers and their financial performance, summaries of audited financial statements from the past two years, and any past litigation or arbitration involving the brand. The contract must also explicitly state that franchisees may unilaterally terminate the agreement within a defined “cooling-off period” following signing. Should the franchisor conceal any facts or provide false information, franchisees retain the right to void the contract (effective nationwide since May 2007)."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Original sources"]},{"tag":"p","props":{"className":"life-citations"},"children":["国务院 (2007). 商业特许经营管理条例（国务院令第 485 号，第七、八、十二、二十二、二十三、二十五条）. ",{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/2008-03/28/content_4179.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/zhengce/zhengceku/2008-03/28/content_4179.htm"]},"；商务部 (2012). 商业特许经营信息披露管理办法（商务部令 2012 年第 2 号，第五、九条）. ",{"tag":"a","props":{"href":"http://www.gov.cn/gongbao/content/2012/content_2177025.htm","target":"_blank","rel":"noopener noreferrer"},"children":["http://www.gov.cn/gongbao/content/2012/content_2177025.htm"]},"；商务部. 商业特许经营信息管理系统. ",{"tag":"a","props":{"href":"https://txjy.syggs.mofcom.gov.cn/","target":"_blank","rel":"noopener noreferrer"},"children":["https://txjy.syggs.mofcom.gov.cn/"]}]},{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/2008-03/28/content_4179.htm","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Open source link"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Book note"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["If a brand cannot be verified via the registration database, refuses to provide required disclosures, or insists on payment before contract review, you should avoid it entirely. The “cooling-off period” refers to the specific window after signing during which franchisees may withdraw from the agreement unilaterally; this duration must be explicitly stated in the contract, as regulations only prescribe that it must be “a reasonable period.” When reviewing any disclosed figures regarding average sales, gross profit, or net profit among existing franchisees, always ask the brand to substantiate their sources, as regulations require them to disclose such data transparently. Schemes that skip “franchise” and charge only for “store operations” or “opening-store training” are covered in item 24 (store operations and opening-store training)."]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["My note"]},{"tag":"button","props":{"type":"button"},"children":["Write a reminder for yourself…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/en/tip/12-04"}