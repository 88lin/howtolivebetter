":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Chia sẻ mẹo này"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Ẩn chi tiết"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Chi phí"]},{"tag":"p","props":{},"children":["Không tốn tiền. Gặp ba kiểu lời mời「nộp tiền trước rồi lên ca」「đào tạo trước rồi xếp việc」「kéo người khác vào」 thì từ chối ngay tại chỗ. Giữ lại lịch sử chat và chứng từ chuyển khoản. Khó ở chỗ càng thiếu tiền càng muốn đánh cược, nói「không」 ngay tại chỗ không phải dễ."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Lợi ích"]},{"tag":"p","props":{},"children":["Công ty không được giữ thẻ căn cước và các giấy tờ khác của bạn, không được bắt bạn tìm người bảo lãnh, cũng không được đổi tên khác để thu tiền hay vật. Vi phạm thì bị buộc trả lại, kèm phạt từ 500 tệ đến 2000 tệ cho mỗi người. Môi giới việc làm cũng không được giữ giấy tờ, không được thu tiền cọc, không giới thiệu được việc thì phải hoàn phí môi giới. Giả danh tuyển dụng để dụ dỗ bạn nộp tiền đào tạo trước hoặc vay tiền trước, đó là kiểu lừa đảo「招转培」「培训贷」mà Bộ Nhân sự và Xã hội cùng bốn cơ quan khác đã cảnh báo đích danh. Kiểu tính hoa hồng theo số người kéo vào, phải nộp tiền mới được tham gia thì thuộc đa cấp, người tham gia có thể bị phạt dưới 2000 tệ. Phần lãi vay ngoài vượt quá 4 lần LPR kỳ hạn một năm tính tại thời điểm ký hợp đồng thì tòa án không hỗ trợ. Quy tắc mới này thay thế cách cũ chia ba đoạn theo hai mức 24%, 36% (toàn quốc, áp dụng từ tháng 8 năm 2020)"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Nguồn gốc"]},{"tag":"p","props":{"className":"life-citations"},"children":["全国人大常委会 (2007). 劳动合同法（主席令第六十五号，第九、八十四条）. ",{"tag":"a","props":{"href":"https://www.gov.cn/gongbao/content/2007/content_711013.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/gongbao/content/2007/content_711013.htm"]},"；劳动保障部 (2007). 就业服务与就业管理规定（劳动保障部令第 28 号，第十四、五十五、五十八条）. ",{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/2022-11/28/content_5711307.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/zhengce/2022-11/28/content_5711307.htm"]},"；人力资源社会保障部等五部门 (2026). 警惕「招转培」「培训贷」等风险提示. ",{"tag":"a","props":{"href":"https://chinajob.mohrss.gov.cn/h5/c/2026-05-18/543038.shtml","target":"_blank","rel":"noopener noreferrer"},"children":["https://chinajob.mohrss.gov.cn/h5/c/2026-05-18/543038.shtml"]},"；国务院 (2005). 禁止传销条例（国务院令第 444 号，第二、七、二十四条）. ",{"tag":"a","props":{"href":"https://www.gov.cn/gongbao/content/2005/content_80604.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/gongbao/content/2005/content_80604.htm"]},"；最高人民法院 (2020). 关于修改《关于审理民间借贷案件适用法律若干问题的规定》的决定（法释〔2020〕6 号，第二十六条）. ",{"tag":"a","props":{"href":"https://www.court.gov.cn/fabu/xiangqing/249031.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.court.gov.cn/fabu/xiangqing/249031.html"]},"；最高人民法院 (2020). 民间借贷利率司法保护上限调整为「一年期 LPR 的 4 倍」. ",{"tag":"a","props":{"href":"https://www.court.gov.cn/zixun/xiangqing/249051.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.court.gov.cn/zixun/xiangqing/249051.html"]}]},{"tag":"a","props":{"href":"https://www.gov.cn/gongbao/content/2007/content_711013.htm","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Liên kết mở nguồn"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Ghi chú sách"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["4 lần LPR là mức lãi suất mà tòa án sẵn sàng bảo vệ, không phải「vay rồi không phải trả」, khoản gốc vẫn phải trả. Bản giải thích tư pháp này đã được sửa đổi thêm một lần vào tháng 12 năm 2020, thứ tự điều khoản có thay đổi, phải dựa vào bản đang có hiệu lực. Cách tính phí dịch vụ của các khoản vay trả góp và vayvay trực tuyến thành lãi suất hàng năm, xem tại mục 7, chương 5 (chuyển lãi suất thành lãi suất hàng năm). Càng vội vàng cần tiền, càng dễ bị những chiêu trò này nhắm vào. Trước hết hãy sử dụng các kênh chính thống ở phần trên: trợ cấp bảo hiểm thất nghiệp, khiếu nại thanh tra lao động, trợ giúp pháp lý, trạm cứu trợ, trợ cấp tạm thời."]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Ghi chú của tôi"]},{"tag":"button","props":{"type":"button"},"children":["Viết một lời nhắc cho chính bạn…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/vi/tip/07-14"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Trước"]},"Tìm việc đừng chỉ nộp hồ sơ, hãy dùng cách có hệ thống: học kỹ thuật, đặt mục tiêu, nhờ người khác giúp"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/vi/tip/07-16"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Tiếp theo"]},"Khó ở nhà thì xếp hàng chờ nhà ở công lập trước"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["Thêm trong chủ đề này"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/07-11"},"children":[{"tag":"strong","props":{},"children":["Mất thẻ căn cước thì đi làm lại ngay, gấp thì xin thẻ tạm trước"]},{"tag":"span","props":{},"children":["Thẻ làm lại, tính từ ngày nộp đơn thì cấp giấy trong 60 ngày. Gấp thì…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/07-12"},"children":[{"tag":"strong","props":{},"children":["Làm xong đăng ký thất nghiệp thì hãy xin công nhận là người khó khăn việc làm, để nhận trợ cấp bảo hiểm xã hội hoặc làm công việc công ích"]},{"tag":"span","props":{},"children":["Được công nhận rồi, bạn tự đóng bảo hiểm xã hội thì nhận được trợ cấp…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/07-13"},"children":[{"tag":"strong","props":{},"children":["Trong thời gian thất nghiệp thì đi nhận trợ cấp đào tạo nghề, trợ cấp thực tập việc làm và trợ cấp bảo hiểm xã hội, đừng tự bỏ tiền học khóa"]},{"tag":"span","props":{},"children":["Đào tạo không phải tự bỏ tiền. Học và có chứng chỉ theo quy định thì …"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/07-17"},"children":[{"tag":"strong","props":{},"children":["Ép chi phí ở và ăn xuống mức thấp nhất: thuê chung theo tháng thay vì thuê theo ngày, tự nấu ăn và bếp ăn trợ giúp thay cho đồ ăn giao"]},{"tag":"span","props":{},"children":["Trong chi tiêu bình quân đầu người cả nước năm 2025, ăn chiếm 29.3%, …"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/07-18"},"children":[{"tag":"strong","props":{},"children":["Bảo hiểm xã hội đứt quãng thì đừng hoảng: lương hưu tính theo số năm tích luỹ, bảo hiểm y tế nộp bù theo quy định"]},{"tag":"span","props":{},"children":["Lương hưu tính theo số năm tích luỹ, không tính theo số năm liên tục,…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/07-19"},"children":[{"tag":"strong","props":{},"children":["Từng vào tù, từng phá sản, từng bị đưa vào danh sách không thi hành án, pháp luật vẫn còn đường bắt đầu lại, trước hết làm hết thủ tục"]},{"tag":"span","props":{},"children":["Người vừa hết án tù không bị phân biệt đối xử về việc làm, học tập, b…"]}]}]}]},{"tag":"a","props":{"className":"life-text-link","href":"/vi/book/07"},"children":["Đọc toàn bộ chủ đề: Sống thế nào khi hết tiền"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"15","height":"15","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]}]}]},{"tag":"nav","props":{"className":"life-tabbar","aria-label":"Điều hướng chính"},"children":[{"tag":"a","props":{"className":"","href":"/vi/book"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"21","height":"21","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-book-open","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M12 7v14"},"children":[]},{"tag":"path","props":{"d":"M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z"},"children":[]}]},{"tag":"span","props":{},"children":["Sách"]}]},{"tag":"a","props":{"className":"","href":"/vi/top-50"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"21","height":"21","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-star","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0