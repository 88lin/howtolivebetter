s":{"href":"/tip/30-11","className":""},"children":[{"tag":"span","props":{},"children":["11"]},"孩子撑不住了可以休学，学籍学校必须给他留着，最长 1 年"]},{"tag":"a","props":{"href":"/tip/30-12","className":""},"children":[{"tag":"span","props":{},"children":["12"]},"查出视力不良，去医院做散瞳验光，之后按医生给的间隔复查"]},{"tag":"a","props":{"href":"/tip/30-13","className":""},"children":[{"tag":"span","props":{},"children":["13"]},"恒磨牙长出来以后做窝沟封闭"]},{"tag":"a","props":{"href":"/tip/30-14","className":"active"},"children":[{"tag":"span","props":{},"children":["14"]},"孩子爱打游戏，先看睡觉、作业和出门活动有没有被挤掉，别光盯着玩了多久"]},{"tag":"a","props":{"href":"/tip/30-15","className":""},"children":[{"tag":"span","props":{},"children":["15"]},"孩子说自己喜欢同性，别骂、别赶出家门、别送去「矫正」：家里的态度和他会不会自杀有关"]},{"tag":"a","props":{"href":"/tip/30-16","className":""},"children":[{"tag":"span","props":{},"children":["16"]},"管孩子别动手打，也别吼骂、骂他笨：常挨打挨骂的孩子，行为和情绪问题都更多"]},{"tag":"a","props":{"href":"/tip/30-17","className":""},"children":[{"tag":"span","props":{},"children":["17"]},"孩子难管、自己总忍不住打骂，去上一期教具体做法的家长课"]},{"tag":"a","props":{"href":"/tip/30-18","className":""},"children":[{"tag":"span","props":{},"children":["18"]},"别把孩子送进封闭管理的「戒网瘾学校」「特训营」：法律禁止用伤害身心的办法戒网瘾，已经有孩子被关死"]}]}]},{"tag":"div","props":{"className":"life-tip-page","data-tip-locales":"zh,en,ru,es,ja,vi"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"当前位置"},"children":[{"tag":"a","props":{"href":"/book"},"children":["阅读全书"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/book/30"},"children":["第 30 章 · 上学以后的孩子"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"30-14"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["14"]},{"tag":"span","props":{"className":"life-evidence grade-b"},"children":["证据 B"]}]},{"tag":"h1","props":{"lang":"zh"},"children":["孩子爱打游戏，先看睡觉、作业和出门活动有没有被挤掉，别光盯着玩了多久"]},{"tag":"p","props":{"lang":"zh","className":"life-entry-summary"},"children":["真正够得上「游戏障碍」的，大约每百人里两三个。问卷门槛定得低、专挑青少年查，比例就会虚高。拿游戏公司的真实记录看，玩多玩少和心情好坏几乎没关系。未成年人按规定只能在周五、周六、周日和节假日晚上 8 点到 9 点玩。"]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["成本"]},{"tag":"p","props":{},"children":["不花钱。每周留意一次孩子几点睡、作业交没交、有没有出门活动。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["收益"]},{"tag":"p","props":{},"children":["一篇荟萃分析汇总了 17 个国家的 53 项研究、226247 人。游戏障碍的患病率是 3.05%（95% CI 2.38–3.91，这是可信范围）。只算抽样更严格的研究，是 1.96%。各研究结果差得远，77% 的差别出在用的是哪份问卷上。样本是青少年、门槛分数低、样本小，都会让比例偏高。另一项研…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"标记：孩子爱打游戏，先看睡觉、作业和出门活动有没有被挤掉，别光盯着玩了多久"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"已做到"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"加入待做"]},{"tag":"button","props":{"type":"but