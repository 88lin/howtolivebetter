ook/31"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"目次に戻る"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["18歳以降、どのような道があるか"]},{"tag":"div","props":{"data-ad-dock-host":"true"},"children":[]},{"tag":"nav","props":{"aria-label":"この章のヒント"},"children":[{"tag":"a","props":{"href":"/ja/tip/31-01"},"children":[{"tag":"span","props":{},"children":["01"]},"まずは基準を確認：12のルートの年齢と学歴要件は明文化されています"]},{"tag":"a","props":{"href":"/ja/tip/31-02"},"children":[{"tag":"span","props":{},"children":["02"]},"18歳の 10 月 31 日までに兵役登録を行う必要があります。義務兵の現役期間は2年間です"]},{"tag":"a","props":{"href":"/ja/tip/31-03"},"children":[{"tag":"span","props":{},"children":["03"]},"徴兵に応じた後に兵役を拒否した場合、2年間は出国や進学・復学が禁止され、公務員や国営企業への採用も不可となります"]},{"tag":"a","props":{"href":"/ja/tip/31-04"},"children":[{"tag":"span","props":{},"children":["04"]},"大学生の兵役で最も実利的な2点：授業料が毎年最大 20000 元補助、学籍は2年間保持、大学院入試の特別枠あり"]},{"tag":"a","props":{"href":"/ja/tip/31-05"},"children":[{"tag":"span","props":{},"children":["05"]},"退役後、政府による就業配置が行われるのは6つのケースのみ；自主就業の場合は 30 日以内に届け出が必要"]},{"tag":"a","props":{"href":"/ja/tip/31-06"},"children":[{"tag":"span","props":{},"children":["06"]},"退役後の3つの勘定：一時金としての退役金、軍歴の勤続年数算入、自主事業の場合は毎年 20000 元の減税"]},{"tag":"a","props":{"href":"/ja/tip/31-07"},"children":[{"tag":"span","props":{},"children":["07"]},"公務員試験以外にも公務員への道はある：基礎サービスプロジェクトで2年間勤務すれば、毎年 10% の定向採用計画に応募可能"]},{"tag":"a","props":{"href":"/ja/tip/31-08"},"children":[{"tag":"span","props":{},"children":["08"]},"特崗教師（特別採用教員）は、3年間の服務期間終了後、評価に合格し、かつ継続を希望する場合は、速やかに正規採用（入編）されるべきである"]},{"tag":"a","props":{"href":"/ja/tip/31-09"},"children":[{"tag":"span","props":{},"children":["09"]},"消防士と軍事文職は、公務員試験とは別の公開採用枠であり、門戸は公務員試験よりも低い"]},{"tag":"a","props":{"href":"/ja/tip/31-10"},"children":[{"tag":"span","props":{},"children":["10"]},"学歴は一度きりの取引ではない：自考（社会自学試験）は年齢や既修学歴を問わず、成人高考や開放大学でも補完が可能"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/ja/tip/31-11","data-status":"active"},"children":[{"tag":"span","props":{},"children":["11"]},"組織に属さなければ「フリーランス」：年金と医療保険は就業地での加入が必要、戸籍による制限は緩和済み"]},{"tag":"a","props":{"href":"/ja/tip/31-12"},"children":[{"tag":"span","props":{},"children":["12"]},"出前置配送、配网約車、市内貨物輸送などの業務において、プラットフォームが注文ごとに職業傷害保障費を負担し、自身での支払いは不要"]},{"tag":"a","props":{"href":"/ja/tip/31-13"},"children":[{"tag":"span","props":{},"children":["13"]},"大学入試の志望校記入日に公務員枠を確定できる2つの道：公費師範生と定向医学生、代償は 6 年間の義務履行"]},{"tag":"a","props":{"href":"/ja/tip/31-14"},"children":[{"tag":"span","props":{},"children":["14"]},"海外での就労を希望するなら、まずこの会社に「対外労務合作経営資格」があるか確認すること：預かり金を請求することは禁止されています"]},{"tag":"a","props":{"href":"/ja/tip/31-15"},"children":[{"tag":"span","props":{},"children":["15"]},"海外企業のリモートワーク、この収入は税法上「国内所得」とみなされます：個人所得税は自身で申告し、送金は「給与所得」として処理すること"]},{"tag":"a","props":{"href":"/ja/tip/31-16"},"children":[{"tag":"span","props":{},"children":["16"]},"会社に属さず自力で起業するなら、まずは創業保証ローンをチェック：個人向け最高 30 万円、利息の半分を財政が補助"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"現在地"},"children":[{"tag":"a","props":{"href":"/ja/book"},"children":["本を読む"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/ja/book/31"},"children":["第31章"," ·"," ","18歳以降、どのような道があるか"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"31-11"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["11"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["エビデンス"," ","A"]}]},{"tag":"h1","props":{"lang":"ja"},"children":["組織に属さなければ「フリーランス」：年金と医療保険は就業地での加入が必要、戸籍による制限は緩和済み"]},{"tag":"p","props":{"lang":"ja","className":"life-entry-summary"},"children":["組織に属さないことは、社会保険がないことを意味するわけではありません。単に、半分を代行して支払ってくれる人がいないだけです。文書では、各地においてフリーランス（柔軟な雇用形態の労働者）が就業地で社会保険に加入する際の戸籍制限を緩和することを求めており、一部の超巨大都市では段階的に緩和することが可能です。したがって、「自由」を社会保険を気にしなくてよいことだと誤解しないでください。未払いが続くと、年金や医療保険の払い戻しは、未納ルールに基づいて計算されることになります。"]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["費用・手間"]},{"tag":"p","props":{},"children":["年金と医療保険は全額自己負担となり、現地の保険料算出基準（缴费基数）に基づいて計算されるため、毎月千元単位の費用がか…"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["効果"]},{"tag":"p","props":{},"children":["「新形態の雇用形態における労働者の労働保障権益の維持に関する指導意見」を参考にしてください。"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"記録する：組織に属さなければ「フリーランス」：年金と医療保険は就業地での加入が必要、戸籍による制限は緩和済み"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"できている"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"やることに追加"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"お気に入り"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"このヒントを共有"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"詳細を閉じる"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["費用・手間"]},{"tag":"p","props":{},"children":["年金と医療保険は全額自己負担となり、現地の保険料算出基準（缴费基数）に基づいて計算されるため、毎月千元単位の費用がかかります。保険料算出基準とは、保険料を計算するための基準となる数値のことです。これはフリーランスが最も見落としがちな固定支出であり、毎月遅滞なく支払わなければならない点が困難です。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["効果"]},{"tag":"p","props":{},"children":["「新形態の雇用形態における労働者の労働保障権益の維持に関する指導意見」を参考にしてください。そこには、「各地において、柔軟な雇用形態の労働者が就業地で基本年金保険および基本医療保険に加入する際の戸籍制限を撤廃しなければならない。一部の超大型都市において一足飛びの実現が困難な場合は、現地の実情に合わせて、積極的に条件を整え、段階的に開放していくものとする。従業員基本年金保険および従業員基本医療保険に加入していない柔軟な雇用形態の労働者に対し、規定に従って都市・農村住民基本年金保険および都市・農村住民基本医療保険への加入を促し、カバーすべき対象はすべてカバーするようにする。企業に対し、法律に従った社会保険への加入を督促すること。企業は、労働関係の確立条件を完全には満たさない新形態の雇用形態の労働者が、自身の状況に応じて適切な社会保険に加入できるよう、導き、支援しなければならない」と記されています。同一の文書において、雇用を3つの類型に分類している：「労働関係の成立要件を満たす場合、企業は法律に基づき労働者と労働契約を締結しなければならない。労働関係の成立要件を完全には満たさないが、企業が労働者に対して労働管理を行う場合……企業に対し労働者との書面による合意の締結を指導する……個人がプラットフォームに依拠して自主的に経営活動を行い、フリーランスとして従事する場合などは、民事法に基づき双方の権利義務を調整する」（全国、2021 年より）"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["出典"]},{"tag":"p","props":{"className":"life-citations"},"children":["人力资源社会保障部等八部门 (2021). 关于维护新就业形态劳动者劳动保障权益的指导意见（人社部发〔2021〕56 号，第二、八条）. ",{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/2021-07/23/content_5626761.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/zhengce/zhengceku/2021-07/23/content_5626761.htm"]},"；国务院办公厅 (2020). 关于支持多渠道灵活就业的意见（国办发〔2020〕27 号）. ",{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/2020-07/31/content_5531613.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/zhengce/zhengceku/2020-07/31/content_5531613.htm"]}]},{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/2021-07/23/content_5626761.htm","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["出典を開く"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["著者の注記"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["原文は戸籍による制限を「緩和する」としており、超大都市には例外の余地も残しています。「全国ですでに撤廃された」という意味ではありません。どこまで緩和されているかは、加入したい都市に問い合わせてください。便益の規模を「大」としたのは、納付の中断で失うのが年金と医療の給付そのもので、その価値が 1 万元を大きく超えるためです。ただし費用も現実にかかり、全額自己負担で毎月 1,000 元以上になります。社会保険の納付が中断した後の追加納付や年数の累計については、第 7 節第 18 条（社会保険の納付中断）を参照してください。都市を移った後、年金保険と医療保険の加入関係を移す方法は、第 19 節第 19 条（年金保険と医療保険の加入関係を新しい加入地へ移す）を参照してください。従業員基本年金保険を自分で納付するときの納付水準と、何年受給すれば払った分を回収できるかは、第 5 節第 46 条（従業員基本年金保険を自分で納付する）を参照してください。また、政府が指定した場所と時間に農産物や日用品を売る場合、または自分の技能で、法律上許可が不要な住民向けサービスを行う場合は、営業許可証の取得は不要です。これは国办发〔2020〕27 号に記載されています。"]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["自分のメモ"]},{"tag":"button","props":{"type":"button"},"children":["自分へのメモを書く…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/ja/tip/31-10"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["前へ"]},"学歴は一度きりの取引ではない：自考（社会自学試験）は年齢や既修学歴を問わず、成人高考や開放大学でも補完が可能"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/ja/tip/31-12"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["次へ"]},"出前置配送、配网約車、市内貨物輸送などの業務において、プラットフォームが注文ごとに職業傷害保障費を負担し、自身での支払いは不要"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["このテーマの他の提案"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/31-07"},"children":[{"tag":"strong","props":{},"children":["公務員試験以外にも公務員への道はある：基礎サービスプロジェクトで2年間勤務すれば、毎年 10% の定向採用計画に応募可能"]},{"tag":"span","props":{},"children":["公務員を目指す道は、公務員試験だけではありません。「三支一扶」のような基礎サービスプロジェクトで2年間勤務し、評価に合格すれば、それらの対…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/31-08"},"children":[{"tag":"strong","props":{},"children":["特崗教師（特別採用教員）は、3年間の服務期間終了後、評価に合格し、かつ継続を希望する場合は、速やかに正規採用（入編）されるべきである"]},{"tag":"span","props":{},"children":["特崗計画は、数少ない「任期終了後の正規採用」が明記されているル