です"]},{"tag":"a","props":{"href":"/ja/tip/21-09"},"children":[{"tag":"span","props":{},"children":["09"]},"ビザ申請、留学、移住のエージェントを探すなら、まず移民管理機関に登録されているか確認しましょう"]},{"tag":"a","props":{"href":"/ja/tip/21-10"},"children":[{"tag":"span","props":{},"children":["10"]},"見知らぬ人のために招待状を作成したり、自分の名義で出入国手続きを行わせたりしないでください"]},{"tag":"a","props":{"href":"/ja/tip/21-11"},"children":[{"tag":"span","props":{},"children":["11"]},"出国前に、旅程、宿泊先、同行者を家族の一人に送り、どのくらいの頻度で連絡するか決めておく"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"現在地"},"children":[{"tag":"a","props":{"href":"/ja/book"},"children":["本を読む"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/ja/book/21"},"children":["第21章"," ·"," ","海外渡航、旅行と国外での安全"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"21-01"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["01"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["エビデンス"," ","A"]}]},{"tag":"h1","props":{"lang":"ja"},"children":["出発前に外交部の安全提醒を確認しましょう。「渡航中止」と表示されている場所には行かないこと"]},{"tag":"p","props":{"lang":"ja","className":"life-entry-summary"},"children":["2026年9月15日より、国外の安全リスクを4段階に分けた外交部の基準のうち、最高レベルである「渡航中止」に該当する高リスクな国や地域を避けることが行政法規に盛り込まれました。ビザ申請や出国審査の際、職員から注意喚起を受けたり、必要に応じて渡航を止められたりすることもあります。出発前にそのページを一度確認するだけ、数分で終わる作業です。"]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["費用・手間"]},{"tag":"p","props":{},"children":["無料。中国領事サービス網を開いて確認するだけで、数分で読み終わります。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["効果"]},{"tag":"p","props":{},"children":["外交部はリスクの高さに応じて、国外の安全提醒を公開しています。低から高へ、おおよそ「安全に注意」「安全対策を強化」「渡航に注意」「渡航中止」の4段階です。"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","a