ldren":["04"]},"Trước khi đi khám chữa bệnh ở tỉnh khác, hỏi một câu ở nơi bạn đang sống, tính cần thiết về nguyên tắc phải có bác sĩ phó trưởng khoa đánh giá"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/vi/tip/24-05","data-status":"active"},"children":[{"tag":"span","props":{},"children":["05"]},"Mỗi lần khám xong, tự giữ lại một bộ hồ sơ bệnh án, kết quả xét nghiệm và ảnh"]},{"tag":"a","props":{"href":"/vi/tip/24-06"},"children":[{"tag":"span","props":{},"children":["06"]},"Có nghi ngờ về chẩn đoán và điều trị thì yêu cầu niêm phong hồ sơ bệnh án ngay tại chỗ, hai bên cùng có mặt, lập danh mục, mỗi bên giữ một bản"]},{"tag":"a","props":{"href":"/vi/tip/24-07"},"children":[{"tag":"span","props":{},"children":["07"]},"Chấn thương nặng thì đi thẳng bàn tiền phân loại của khoa cấp cứu, đừng xếp hàng ở cửa sổ lấy số khám"]},{"tag":"a","props":{"href":"/vi/tip/24-08"},"children":[{"tag":"span","props":{},"children":["08"]},"Không có tiền, không có giấy tờ, không nói rõ mình là ai, cấp cứu vẫn phải cứu trước"]},{"tag":"a","props":{"href":"/vi/tip/24-09"},"children":[{"tag":"span","props":{},"children":["09"]},"Giám định thương tật phải đợi điều trị kết thúc rồi hãy làm, làm sớm thì cấp độ bị chấp thấp"]},{"tag":"a","props":{"href":"/vi/tip/24-10"},"children":[{"tag":"span","props":{},"children":["10"]},"Sau khi chữa xong mà thật sự còn tổn thương chức năng, đi tới hội liên hiệp người khuyết tật cấp huyện nơi có hộ khẩu để xin giấy chứng nhận người khuyết tật"]},{"tag":"a","props":{"href":"/vi/tip/24-11"},"children":[{"tag":"span","props":{},"children":["11"]},"Cảm ơn bác sĩ đã cứu bạn: dùng thư cảm ơn, băng đỏ tặng ơn và đánh giá mức độ hài lòng, đừng dùng phong bao; quy tắc cấm là tài sản, không phải lòng biết ơn"]},{"tag":"a","props":{"href":"/vi/tip/24-12"},"children":[{"tag":"span","props":{},"children":["12"]},"Trước khi cấy răng hỏi rõ giá trọn gói gồm gì, ưu tiên cơ sở cam kết tham gia quản lý giá, đừng tin quảng cáo giá rẻ"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"Breadcrumbs"},"children":[{"tag":"a","props":{"href":"/vi/book"},"children":["Khám phá cuốn sách"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/vi/book/24"},"children":["Chương 24"," ·"," ","Khám bệnh: tốn ít tiền hơn và đi lại ít hơn"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"24-05"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["05"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["Bằng chứng"," ","A"]}]},{"tag":"h1","props":{"lang":"vi"},"children":["Mỗi lần khám xong, tự giữ lại một bộ hồ sơ bệnh án, kết quả xét nghiệm và ảnh"]},{"tag":"p","props":{"lang":"vi","className":"life-entry-summary"},"children":["Quyền tra cứu và sao chép hồ sơ bệnh án của chính bạn là quyền mà luật trao cho bạn. Hồ sơ khám ngoại trú, sổ nhập viện, phiếu xét nghiệm, ảnh, hồ sơ phẫu thuật và gây mê, tư liệu bệnh lý, bảng chi phí đều sao chép được. Bệnh viện có một cửa sổ riêng tiếp nhận, chỉ được thu phí sao chép. Đổi bệnh viện, tìm bác sĩ khác xem lại, xin bảo hiểm thương mại, khi thật sự có tranh chấp, đều dựa vào bộ hồ sơ này."]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Chi phí"]},{"tag":"p","props":{},"children":["Không tốn tiền. Bệnh viện được thu phí sao chép theo quy đ…"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Lợi ích"]},{"tag":"p","props":{},"children":["Quy định nêu rõ quyền tra cứu, sao chép hồ sơ bệnh án là quyền của bệnh nhân. Phạm vi gồm hồ sơ khám ngoại trú…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"Đánh dấu: Mỗi lần khám xong, tự giữ lại một bộ hồ sơ bệnh