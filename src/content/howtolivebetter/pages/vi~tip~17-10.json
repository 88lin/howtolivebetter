ildren":["05"]},"Mấy thứ「đầu tư dưỡng già」yêu cầu người già nộp tiền trước thì đừng đụng: mua thẻ, mua giường, mua căn hộ dưỡng già, dưỡng già du lịch, mua sản phẩm cho người già đều là một kiểu huy động vốn trái phép"]},{"tag":"a","props":{"href":"/vi/tip/17-06"},"children":[{"tag":"span","props":{},"children":["06"]},"Trừ bảo hiểm ngược chiều thế chấp nhà ở cho người già của công ty bảo hiểm, mấy thứ「dưỡng già dựa vào nhà」còn lại đừng đụng, tuyệt đối không thế chấp nhà đi mua sản phẩm tài chính"]},{"tag":"a","props":{"href":"/vi/tip/17-07"},"children":[{"tag":"span","props":{},"children":["07"]},"Người già trong nhà nằm liệt giường lâu ngày hoặc mất khả năng tự chăm sóc nặng, hãy tới cơ quan bảo hiểm y tế nơi tham gia bảo hiểm để xin bảo hiểm chăm sóc dài hạn; nó không chỉ dành cho người già"]},{"tag":"a","props":{"href":"/vi/tip/17-08"},"children":[{"tag":"span","props":{},"children":["08"]},"Khi trong nhà có người nằm liệt giường lâu ngày, hãy coi loét áp lực là kẻ thù số một: dùng nệm hơi điện, xoay người đúng giờ, mỗi ngày soi một lần chỗ xương nhô ra"]},{"tag":"a","props":{"href":"/vi/tip/17-09"},"children":[{"tag":"span","props":{},"children":["09"]},"Người lớn tuổi bị đụng thủy tinh thể đã ảnh hưởng tới việc nhìn đường thì đi đánh giá ở khoa mắt để phẫu thuật; ai đụng cả hai mắt thì đừng kéo dài mắt thứ hai"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/vi/tip/17-10","data-status":"active"},"children":[{"tag":"span","props":{},"children":["10"]},"Người cao tuổi dắt chó: nắm dây trong lòng bàn tay, đừng quấn quanh tay, thu ngắn dây và huấn luyện chó không lao mạnh khi dắt"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"Breadcrumbs"},"children":[{"tag":"a","props":{"href":"/vi/book"},"children":["Khám phá cuốn sách"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/vi/book/17"},"children":["Chương 17"," ·"," ","Khi nhà có người lớn tuổi"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"17-10"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["10"]},{"tag":"span","props":{"className":"life-evidence grade-b"},"children":["Bằng chứng"," ","B"]}]},{"tag":"h1","props":{"lang":"vi"},"children":["Người cao tuổi dắt chó: nắm dây trong lòng bàn tay, đừng quấn quanh tay, thu ngắn dây và huấn luyện chó không lao mạnh khi dắt"]},{"tag":"p","props":{"lang":"vi","className":"life-entry-summary"},"children":["Ở Mỹ, người từ 65 tuổi gãy xương khi dắt chó tăng từ khoảng 1700 lên khoảng 4400 mỗi năm, 80% là nữ. Hông là vị trí gãy hay gặp nhất, gần 30% phải nhập viện. Khoảng 75% ca tổn thương tay do dây dắt là dây quấn quanh tay rồi chó giật. Vì vậy nắm dây trong lòng bàn tay, thu ngắn và huấn luyện chó không lao tới."]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Chi phí"]},{"tag":"p","props":{},"children":["Cầm và thu ngắn dây không tốn tiền, đi cùng người cao tuổi…"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Lợi ích"]},{"tag":"p","props":{},"children":["Dữ liệu cấp cứu Mỹ ước tính toàn quốc người từ 65 tuổi gãy xương khi dắt chó khoảng 1671 năm 2004, khoảng 4396…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"Đánh dấu: Người cao tuổi dắt chó: nắm dây trong lòng bàn tay, đừng quấn quanh tay, thu ngắn dây và huấn luyện chó không lao mạnh khi dắt"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"Hoàn tất"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"Kế hoạch thực hiện"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"Lưu"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Chia sẻ mẹo này"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Ẩn chi tiết"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Chi phí"]},{"tag":"p","props":{},"children":["Cầm và thu ngắn dây không tốn tiền, đi cùng người cao tuổi một lần để chỉ là được. Huấn luyện chó không lao mạnh cần thời gian, tự dạy hoặc thuê người huấn luyện; thuê thì tốn tiền, giá mỗi nơi rất khác. Khó là người cao tuổi quen dây rút và quấn quanh cổ tay, phải đổi thói quen."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Lợi ích"]},{"tag":"p","props":{},"children":["Dữ liệu cấp cứu Mỹ ước tính toàn quốc người từ 65 tuổi gãy xương khi dắt chó khoảng 1671 năm 2004, khoảng 4396 năm 2017, tăng có ý nghĩa thống kê. 78.6% người gãy xương là nữ, 28.7% nhập viện. Theo vị trí riêng, hông nhiều nhất với 17.3%; theo vùng lớn, chi trên nhiều nhất với 52.1%. Bộ dữ liệu cấp cứu toàn Mỹ khác từ 2001–2018 ước tính khoảng 360000 lượt bị thương liên quan dây dắt chó (chính xác 356746); 193483 bị chó kéo, 136767 bị vấp hoặc dây quấn. Số bị thương trên một triệu người tăng từ 25.4 lên 105.5. Một phòng khám phẫu thuật bàn tay nhận 443 bệnh nhân bị dây dắt gây thương tích trong 5 năm; khoảng 75% do tay hoặc ngón bị quấn rồi chó giật (tóm tắt ghi 337 người, 75.9%). Khoảng một phần năm phải mổ (96 người, 21.6%). CDC Mỹ thống kê từ 2001–2006 mỗi năm khoảng 86629 lượt chấn thương do ngã liên quan chó mèo, 88.0% liên quan chó. Trong các ca ngã liên quan chó, 26% xảy ra khi dắt, 21.2% do chó đẩy hoặc kéo ngã."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Nguồn gốc"]},{"tag":"p","props":{"className":"life-citations"},"children":["Pirruccio K, Yoon YM, Ahn J (2019). Fractures in Elderly Americans Associated With Walking Leashed Dogs. JAMA Surgery, 154(5), 458-459. ",{"tag":"a","props":{"href":"https://doi.org/10.1001/jamasurg.2019.0061","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1001/jamasurg.2019.0061"]},"；Forrester MB (2020). Dog leash-related injuries treated at emergency departments. American Journal of Emergency Medicine, 38(9), 1782-1786. ",{"tag":"a","props":{"href":"https://doi.org/10.1016/j.ajem.2020.05.082","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1016/j.ajem.2020.05.082"]},"；Plusch K, Givner D, Wiafe B, Lutsky K, Beredjiklian P (2026). Hand and Wrist Dog-Leash Injuries in the Outpatient Setting: A Review of 443 Cases. Hand, 21(4), 582-586. ",{"tag":"a","props":{"href":"https://doi.org/10.1177/15589447241299128","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1177/15589447241299128"]},"；CDC (2009). Nonfatal fall-related injuries associated with dogs and cats — United States, 2001-2006. MMWR, 58(11), 277-281. ",{"tag":"a","props":{"href":"https://www.cdc.gov/mmwr/preview/mmwrhtml/mm5811a1.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.cdc.gov/mmwr/preview/mmwrhtml/mm5811a1.htm"]},"；Rosa R, Buckley RE (2024). Leash-related injuries associated with dog walking: an understudied risk for dog owners? Journal of the American Veterinary Medical Association, 262(7), 973-978. ",{"tag":"a","props":{"href":"https://doi.org/10.2460/javma.23.11.0608","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.2460/javma.23.11.0608"]}]},{"tag":"a","props":{"href":"https://doi.org/10.1001/jamasurg.2019.0061","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Liên kết mở nguồn"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Ghi chú sách"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["Nắm dây trong lòng bàn tay, đừng quấn quanh tay là lời khuyên của bác sĩ phòng khám phẫu thuật bàn tay ấy. Họ nói rõ nó bảo vệ ngón và cổ tay, không ngăn được chó lao kéo người ngã. Họ cũng khuyên thu ngắn: dây ngắn thì chó không lấy được tốc độ, lực kéo nhẹ hơn; dây dài còn dễ quấn vật gây vấp. Dây rút thả dài cũng là dây dài. Nhưng chưa nghiên cứu riêng dây rút hay dây thường dễ gây ngã hơn; tổng quan 2024 nói chưa có dữ liệu loại dây lúc bị thương. CDC Mỹ và tác giả bài gãy xương đều đề nghị huấn luyện chó không lao tới khi dắt. Bài gãy xương còn khuyên người cao tuổi đang định nuôi chọn chó nhỏ hơn. Chưa nghiên cứu tính các biện pháp giảm ngã bao nhiêu nên lợi ích xếp nhỏ theo nhận định. Xương chịu ngã được không xem phần 1, điều 39 (đo mật độ xương), điều 40 (chẩn đoán loãng xương thì dùng thuốc). Tập thăng bằng xem phần 1, điều 13 (thăng bằng và sức chân). Dắt chó có tính vận động không xem phần 2, điều 44 (tính dắt chó vào lượng đi bộ). Người hưởng lợi chủ yếu là bố mẹ, ông bà của bạn."]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Ghi chú của tôi"]},{"tag":"button","props":{"type":"button"},"children":["Viết một lời nhắc cho chính bạn…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/vi/tip/17-09"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Trước"]},"Người lớn tuổi bị đụng thủy tinh thể đã ảnh hưởng tới việc nhìn đường thì đi đánh giá ở khoa mắt để phẫu thuật; ai đụng cả hai mắt thì đừng kéo dài mắt thứ hai"]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["Thêm trong chủ đề này"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/17-03"},"children":[{"tag":"strong","props":{},"children":["Tiền của người già để riêng một tài khoản, chi tiêu lớn thì đặt quy tắc hai người xác nhận"]},{"tag":"span","props":{},"children":["Kẻ lừa người cao tuổi thường tặng quà nhỏ, hỏi han để tích lũy lòng t…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/17-04"},"children":[{"tag":"strong","props":{},"children":["Cho người già một câu để nói ra bất cứ lúc nào mà thoát khỏi việc"]},{"tag":"span","props":{},"children":["Bán hàng và lừa đảo dựa vào áp lực tại chỗ, khiến bạn trả tiền chưa k…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/17-05"},"children":[{"tag":"strong","props":{},"children":["Mấy thứ「đầu tư dưỡng già」yêu cầu người già nộp tiền trước thì đừng đụng: mua thẻ, mua giường, mua căn hộ dưỡng già, dưỡng già du lịch, mua sản phẩm cho người già đều là một kiểu huy động vốn trái phép"]},{"tag":"span","props":{},"children":["Mấy món dưỡng già yêu cầu người già nộp tiền trước mà lại hứa sinh lờ…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/17-06"},"children":[{"tag":"strong","props":{},"children":["Trừ bảo hiểm ngược chiều thế chấp nhà ở cho người già của công ty bảo hiểm, mấy thứ「dưỡng già dựa vào nhà」còn lại đừng đụng, tuyệt đối không thế chấp nhà đi mua sản phẩm tài chính"]},{"tag":"span","props":{},"children":["Dưỡng già dựa vào nhà chính quy chỉ có một loại, tức bảo hiểm ngược c…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/17-07"},"children":[{"tag":"strong","props":{},"children":["Người già trong nhà nằm liệt giường lâu ngày hoặc mất khả năng tự chăm sóc nặng, hãy tới cơ quan bảo hiểm y tế nơi tham gia bảo hiểm để xin bảo hiểm chăm sóc dài hạn; nó không chỉ dành cho người già"]},{"tag":"span","props":{},"children":["Bảo hiểm chăm sóc dài hạn trả giúp bạn phí thuê người chăm sóc. Nếu t…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/17-08"},"children":[{"tag":"strong","props":{},"children":["Khi trong nhà có người nằm liệt giường lâu ngày, hãy coi loét áp lực là kẻ thù số một: dùng nệm hơi điện, xoay người đúng giờ, mỗi ngày soi một lần chỗ xương nhô ra"]},{"tag":"