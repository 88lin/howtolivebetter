"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-up-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M7 7h10v10"},"children":[]},{"tag":"path","props":{"d":"M7 17 17 7"},"children":[]}]}]}]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/en/book/28"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"Back to index"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["Don’t harm your body just to change its appearance"]},{"tag":"div","props":{"data-ad-dock-host":"true"},"children":[]},{"tag":"nav","props":{"aria-label":"Chapter entries"},"children":[{"tag":"a","props":{"aria-current":"page","className":"active","href":"/en/tip/28-01","data-status":"active"},"children":[{"tag":"span","props":{},"children":["01"]},"Do not use extreme dieting, fasting, or self-induced vomiting to control weight; if you want to lose weight, focus on exercise instead"]},{"tag":"a","props":{"href":"/en/tip/28-02"},"children":[{"tag":"span","props":{},"children":["02"]},"Two things to check before getting injections, thread lifts, or surgery: does the facility’s license list “medical aesthetics,” and is the practitioner a licensed attending physician?"]},{"tag":"a","props":{"href":"/en/tip/28-03"},"children":[{"tag":"span","props":{},"children":["03"]},"Facial fillers should avoid the bridge of the nose, glabellar area, and forehead — and never opt for unregulated clinics just to save money"]},{"tag":"a","props":{"href":"/en/tip/28-04"},"children":[{"tag":"span","props":{},"children":["04"]},"Don’t buy weight‑loss pills, coffee, candies, or “enzymatic plums” (plums claimed to be soaked in enzymes) that promise rapid results"]},{"tag":"a","props":{"href":"/en/tip/28-05"},"children":[{"tag":"span","props":{},"children":["05"]},"Do not use anabolic steroids (“muscle‑building injections” or “oral pills”) to build muscle"]},{"tag":"a","props":{"href":"/en/tip/28-06"},"children":[{"tag":"span","props":{},"children":["06"]},"If you need weight-loss medication, get a prescription from a doctor — don’t buy it from online shops that ship it without one"]},{"tag":"a","props":{"href":"/en/tip/28-07"},"children":[{"tag":"span","props":{},"children":["07"]},"Sex hormone therapy should only be used when prescribed by a doctor and with regular follow‑up; do not buy it online and do not adjust the dose on your own"]},{"tag":"a","props":{"href":"/en/tip/28-08"},"children":[{"tag":"span","props":{},"children":["08"]},"If the feeling of “being unattractive” has reached the point where you constantly check your reflection and obsess over changes, get a body image assessment before considering surgery"]},{"tag":"a","props":{"href":"/en/tip/28-09"},"children":[{"tag":"span","props":{},"children":["09"]},"For orthodontic treatment, see a qualified orthodontic doctor in person and attend follow-ups; do not buy aligners online and wear them yourself at home"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"Breadcrumb"},"children":[{"tag":"a","props":{"href":"/en/book"},"children":["Explore the book"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/en/book/28"},"children":["Chapter 28"," ·"," ","Don’t harm your body just to change its appearance"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"28-01"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["01"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["Evidence"," ","A"]}]},{"tag":"h1","props":{"lang":"en"},"children":["Do not use extreme dieting, fasting, or self-induced vomiting to control weight; if you want to lose weight, focus on exercise instead"]},{"tag":"p","props":{"lang":"en","className":"life-entry-summary"},"children":["People with anorexia nervosa have a mortality rate roughly 5.9 times higher than their peers. Over a period of one year, 5.1 out of every 1,000 individuals in this group die. One in five of those who die commit suicide. The root cause of this is dieting: a three-year study of students at 44 secondary schools found that girls who engaged in severe dieting were 18 times more likely to develop eating disorders than those who did not diet. If you want to manage your weight, increase physical activity rather than cutting food intake to the point of hunger."]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Cost"]},{"tag":"p","props":{},"children":["No cost at all. In fact, it saves money you would otherwis…"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Benefit"]},{"tag":"p","props":{},"children":["This conclusion comes from a combined analysis of 36 studies that tracked a total of 166,642 person-years of d…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"Mark: Do not use extreme dieting, fasting, or self-induced vomiting to control weight; if you want to lose weight, focus on exercise instead"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"Done"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"Plan to do"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"Save"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Share this tip"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Hide details"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Cost"]},{"tag":"p","props":{},"children":["No cost at all. In fact, it saves money you would otherwise spend on weight-loss products."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Benefit"]},{"tag":"p","props":{},"children":["This conclusion comes from a combined analysis of 36 studies that tracked a total of 166,642 person-years of data on individuals with anorexia nervosa. Their standardized mortality ratio was 5.86, meaning their mortality rate is about 5.9 times higher than that of the general population. As noted above, 5.1 deaths occur per 1,000 person-years, and roughly one-fifth of these deaths are suicides. For bulimia nervosa, the standardized mortality ratio is 1.93, and for other eating disorders it is 1.92 — both values are roughly 1.9 times higher than those of the general population. Another study conducted in 44 secondary schools in Victoria, Australia, followed 14–15-year-old students for three years, with six rounds of assessments during that time. It found that 21.8 new cases of eating disorders occurred per 1,000 person-years among girls; girls who dieted severely were 18 times more likely to develop such disorders than those who did not, while those with moderate dieting habits had an 5 times higher risk. After adjusting for prior dieting habits and existing mental health issues, factors such as BMI, physical activity levels, and gender no longer predicted the development of eating disorders. The authors concluded that for adolescents, using exercise rather than diet restriction to manage weight appears to lower the risk of developing eating disorders."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Original sources"]},{"tag":"p","props":{"className":"life-citations"},"children":["Arcelus J et al. (2011). Mortality rates in patients with anorexia nervosa and other eating disorders. A meta-analysis of 36 studies. Arch Gen Psychiatry. ",{"tag":"a","props":{"href":"https://doi.org/10.1001/archgenpsychiatry.2011.74","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1001/archgenpsychiatry.2011.74"]},"；Patton GC et al. (1999). Onset of adolescent eating disorders: population based cohort study over 3 years. BMJ. ",{"tag":"a","props":{"href":"https://doi.org/10.1136/bmj.318.7186.765","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1136/bmj.318.7186.765"]}]},{"tag":"a","props":{"href":"https://doi.org/10.1001/archgenpsychiatry.2011.74","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Open source link"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Book note"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["The term “severe dieting” here refers to long-term food intake that is far below the body’s actual needs; it does not include skipping a single meal or foregoing late-night snacks. If you or someone you know exhibits symptoms such as self-induced vomiting, feelings of guilt after binge eating, or an inability to stop weighing oneself, it is recommended to seek help from a psychiatrist or a clinical psychology department at a general hospital. This is a medical condition with established treatment methods, and it is not a matter of lacking willpower. For information on the relationship between BMI and mortality, please refer to Section 2, Item 32, which discusses long-term weight ranges rather than weight-loss methods."]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["My note"]},{"tag":"button","props":{"type":"button"},"children":["Write a reminder for yourself…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"span","props":{},"children":[]},{"tag":"a","props":{"className":"life-tip-pager-link next","href