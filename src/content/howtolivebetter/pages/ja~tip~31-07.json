n":[]},{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},{"tag":"span","props":{},"children":["ログイン"]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/ja/book/31"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"目次に戻る"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["18歳以降、どのような道があるか"]},{"tag":"nav","props":{"aria-label":"この章のヒント"},"children":[{"tag":"a","props":{"href":"/ja/tip/31-01"},"children":[{"tag":"span","props":{},"children":["01"]},"まずは基準を確認：12のルートの年齢と学歴要件は明文化されています"]},{"tag":"a","props":{"href":"/ja/tip/31-02"},"children":[{"tag":"span","props":{},"children":["02"]},"18歳の 10 月 31 日までに兵役登録を行う必要があります。義務兵の現役期間は2年間です"]},{"tag":"a","props":{"href":"/ja/tip/31-03"},"children":[{"tag":"span","props":{},"children":["03"]},"徴兵に応じた後に兵役を拒否した場合、2年間は出国や進学・復学が禁止され、公務員や国営企業への採用も不可となります"]},{"tag":"a","props":{"href":"/ja/tip/31-04"},"children":[{"tag":"span","props":{},"children":["04"]},"大学生の兵役で最も実利的な2点：授業料が毎年最大 20000 元補助、学籍は2年間保持、大学院入試の特別枠あり"]},{"tag":"a","props":{"href":"/ja/tip/31-05"},"children":[{"tag":"span","props":{},"children":["05"]},"退役後、政府による就業配置が行われるのは6つのケースのみ；自主就業の場合は 30 日以内に届け出が必要"]},{"tag":"a","props":{"href":"/ja/tip/31-06"},"children":[{"tag":"span","props":{},"children":["06"]},"退役後の3つの勘定：一時金としての退役金、軍歴の勤続年数算入、自主事業の場合は毎年 20000 元の減税"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/ja/tip/31-07","data-status":"active"},"children":[{"tag":"span","props":{},"children":["07"]},"公務員試験以外にも公務員への道はある：基礎サービスプロジェクトで2年間勤務すれば、毎年 10% の定向採用計画に応募可能"]},{"tag":"a","props":{"href":"/ja/tip/31-08"},"children":[{"tag":"span","props":{},"children":["08"]},"特崗教師（特別採用教員）は、3年間の服務期間終了後、評価に合格し、かつ継続を希望する場合は、速やかに正規採用（入編）されるべきである"]},{"tag":"a","props":{"href":"/ja/tip/31-09"},"children":[{"tag":"span","props":{},"children":["09"]},"消防士と軍事文職は、公務員試験とは別の公開採用枠であり、門戸は公務員試験よりも低い"]},{"tag":"a","props":{"href":"/ja/tip/31-10"},"children":[{"tag":"span","props":{},"children":["10"]},"学歴は一度きりの取引ではない：自考（社会自学試験）は年齢や既修学歴を問わず、成人高考や開放大学でも補完が可能"]},{"tag":"a","props":{"href":"/ja/tip/31-11"},"children":[{"tag":"span","props":{},"children":["11"]},"組織に属さなければ「フリーランス」：年金と医療保険は就業地での加入が必要、戸籍による制限は緩和済み"]},{"tag":"a","props":{"href":"/ja/tip/31-12"},"children":[{"tag":"span","props":{},"children":["12"]},"出前置配送、配网約車、市内貨物輸送などの業務において、プラットフォームが注文ごとに職業傷害保障費を負担し、自身での支払いは不要"]},{"tag":"a","props":{"href":"/ja/tip/31-13"},"children":[{"tag":"span","props":{},"children":["13"]},"大学入試の志望校記入日に公務員枠を確定できる2つの道：公費師範生と定向医学生、代償は 6 年間の義務履行"]},{"tag":"a","props":{"href":"/ja/tip/31-14"},"children":[{"tag":"span","props":{},"children":["14"]},"海外での就労を希望するなら、まずこの会社に「対外労務合作経営資格」があるか確認すること：預かり金を請求することは禁止されています"]},{"tag":"a","props":{"href":"/ja/tip/31-15"},"children":[{"tag":"span","props":{},"children":["15"]},"海外企業のリモートワーク、この収入は税法上「国内所得」とみなされます：個人所得税は自身で申告し、送金は「給与所得」として処理すること"]},{"tag":"a","props":{"href":"/ja/tip/31-16"},"children":[{"tag":"span","props":{},"children":["16"]},"会社に属さず自力で起業するなら、まずは創業保証ローンをチェック：個人向け最高 30 万円、利息の半分を財政が補助"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"現在地"},"children":[{"tag":"a","props":{"href":"/ja/book"},"children":["本を読む"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/ja/book/31"},"children":["第31章"," ·"," ","18歳以降、どのような道があるか"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"31-07"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["07"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["エビデンス"," ","A"]}]},{"tag":"h1","props":{"lang":"ja"},"children":["公務員試験以外にも公務員への道はある：基礎サービスプロジェクトで2年間勤務すれば、毎年 10% の定向採用計画に応募可能"]},{"tag":"p","props":{"lang":"ja","className":"life-entry-summary"},"children":["公務員を目指す道は、公務員試験だけではありません。「三支一扶」のような基礎サービスプロジェクトで2年間勤務し、評価に合格すれば、それらの対象者のみを対象とした定向採用計画に応募できます。各省は毎年、公務員採用計画の 10% 程度をこれらの対象者のために割り当てています。3年以内に大学院入試（考研）に合格すれば、筆記試験の総点にさらに 10 点が加算されます。代償は、この2年間の給与が市場賃金ではなく、財政補助金であることです。"]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["費用・手間"]},{"tag":"p","props":{},"children":["費用はかかりません。代償は、郷鎮などの基礎自治体で2年間勤務することです。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["効果"]},{"tag":"p","props":{},"children":["第4期「三支一扶」計画の通知には「服務期間は2年間」と記載されています。また、「各省（区、市）は、毎年公務員採用計画の 10％程度を、『三支一扶』計画などの基层サービスプロジェクト従事者を対象とした定向採用に充てるものと…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"記録する：公務員試験以外にも公務員への道はある：基礎サービスプロジェクトで2年間勤務すれば、毎年 10% の定向採用計画に応募可能"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"できている"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"やることに追加"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"お気に入り"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"このヒントを共有"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"詳細を閉じる"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["費用・手間"]},{"tag":"p","props":{},"children":["費用はかかりません。代償は、郷鎮などの基礎自治体で2年間勤務することです。この2年間の報酬は市場賃金ではなく財政補助金であるため、この2年間を耐え抜く忍耐力が求められます。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["効果"]},{"tag":"p","props":{},"children":["第4期「三支一扶」計画の通知には「服務期間は2年間」と記載されています。また、「各省（区、市）は、毎年公務員採用計画の 10％程度を、『三支一扶』計画などの基层サービスプロジェクト従事者を対象とした定向採用に充てるものとする。各省（区、市）の県・郷レベルの基层事業単位における公開採用の際、当該地域の状況に応じて一定数または一定割合のポストを設け、『三支一扶』の服務期間を終了し、評価に合格した人員を対象とした专项採用を行う……採用後は試用期間を設けないことができる」とも記載されています。定向採用および专项採用とは、この枠は基层サービスプロジェクトに従事した経験のある人のみが受験可能であり、それ以外の方は応募できないことを意味します。同じ通知には次のように記されています。「任期終了後の考核に合格した『三支一扶』職員が、3年以内に全国修士研究生入学試験を受験する場合、筆記試験の総点に 10 点を加算し、同等の条件下で優先的に採用する……。高専（専門学校）卒業生が任期を終了し、考核に合格した場合は、試験免除で成人高等教育の本科（大学）課程に入学することができる」。試験免除とは、再度試験を受ける必要がなく、直接編入学ができることを意味します。また、通知には「『三支要扶』計画への参加前に職歴のない者が、任期を終了し、考核に合格した場合、2年間にわたり、公的機関や企業・事業所の採用試験、起業、戸籍登録、進学などの面において、新卒者と同様の政策を享受できる。『三支一扶』職員の基层（基層）での奉仕期間は勤続年数として計算され、その就業開始日は、基層への着任日から起算される」とも記されています。中央財政の補助基準は、西部地域は1人あたり年間 3 万元、中部地域は 2.4 万元、東部地域は 1.2 万元です。中共中央・国務院の意見書には、「基层サービスプロジェクトに参加する前に職歴のない者が、サービス期間を終了し、かつ評価に合格した後、2 年以内であれば、公務員・公的機関の採用試験（募集）、各種企業への就職、起業、戸籍登録、進学などの面において、新卒大学生と同等の関連政策を享受することができる」と記されています。また、同意見書には、「省級以上の機関における公務員の採用は、特殊な職務を除き、規定に従い一律に 2 年以上の基层勤務経験を有する者の中から採用される」とも記されています。もう一つの道は「西部計画」です。これは「共青団中央、教育部、財政部、人力資源社会保障部が共同で組織・実施」します。大学の卒業予定者または大学院生を対象に、「西部地域の基層組織にて 1—3 年間のボランティア活動に従事する」プログラム（全国規模）を募集しています"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["出典"]},{"tag":"p","props":{"className":"life-citations"},"children":["中共中央组织部、人力资源社会保障部等十部门 (2021). 关于实施第四轮高校毕业生「三支一扶」计划的通知（人社部发〔2021〕32 号，第七、八、九、十一、十二、十三条）. ",{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/2021-06/04/content_5615404.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/zhengce/zhengceku/2021-06/04/content_5615404.htm"]},"；中共中央办公厅、国务院办公厅 (2017). 关于进一步引导和鼓励高校毕业生到基层工作的意见（第五、十六、十八条）. ",{"tag":"a","props":{"href":"http://www.gov.cn/gongbao/content/2017/content_5171278.htm","target":"_blank","rel":"noopener noreferrer"},"children":["http://www.gov.cn/gongbao/content/2017/content_5171278.htm"]},"；全国大学生志愿服务西部计划项目管理办公室 (2026). 2026—2027 年度大学生志愿服务西部计划招募协议书. ",{"tag":"a","props":{"href":"http://xibu.youth.cn/tzgg/202604/t20260423_16623558.htm","target":"_blank","rel":"noopener noreferrer"},"children":["http://xibu.youth.cn/tzgg/202604/t20260423_16623558.htm"]}]},{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/2021-06/04/content_5615404.htm","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["出典を開く"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["著者の注記"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["第4期「三支一扶」計画の期間は 2021 年から 2025 年までです。今回の調査では、第5期の文書および 2026 年度の通知は見つかりませんでした。応募前にその年の募集公告を確認してください。2025 年には中央財政により 34430 名の募集が支援されました。西部計画の実施案の原文はネット上では見つからず、公式サイトの政策欄も内容が表示されません。任期終了後の優遇措置については、中弁・国弁（中共中央・国務院）によるすべての基礎サービスプロジェクトを対象とした文書に従います。この2年間の報酬は市場賃金ではなく財政補助金であるため、この代償は2年後の定向採用のメリットと合わせて考える必要があります。"]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["自分のメモ"]},{"tag":"button","props":{"type":"button"},"children":["自分へのメモを書く…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/ja/tip/31-06"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["前へ"]},"退役後の3つの勘定：一時金としての退役金、軍歴の勤続年数算入、自主事業の場合は毎年 20000 元の減税"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/ja/tip/31-08"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["次へ"]},"特崗教師（特別採用教員）は、3年間の服務期間終了後、評価に合格し、かつ継続を希望する場合は、速やかに正規採用（入編）されるべきである"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","prop