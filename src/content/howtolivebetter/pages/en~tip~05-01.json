":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-up-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M7 7h10v10"},"children":[]},{"tag":"path","props":{"d":"M7 17 17 7"},"children":[]}]}]}]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/en/book/05"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"Back to index"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["Don’t waste money"]},{"tag":"div","props":{"data-ad-dock-host":"true"},"children":[]},{"tag":"nav","props":{"aria-label":"Chapter entries"},"children":[{"tag":"a","props":{"aria-current":"page","className":"active","href":"/en/tip/05-01","data-status":"active"},"children":[{"tag":"span","props":{},"children":["01"]},"Turn off all automatic renewals and switch to manual renewal upon expiry"]},{"tag":"a","props":{"href":"/en/tip/05-02"},"children":[{"tag":"span","props":{},"children":["02"]},"Conduct the annual tax reconciliation from March to June; be sure to include all eligible special deductions"]},{"tag":"a","props":{"href":"/en/tip/05-03"},"children":[{"tag":"span","props":{},"children":["03"]},"Housing provident fund isn’t just for buying a home: it can be used for renting, home renovations, and paying property taxes, effective from September 20, 2026 under new regulations"]},{"tag":"a","props":{"href":"/en/tip/05-04"},"children":[{"tag":"span","props":{},"children":["04"]},"Recalculate your mobile and broadband plans annually: downgrade unused services, and file a complaint if the carrier refuses to comply"]},{"tag":"a","props":{"href":"/en/tip/05-05"},"children":[{"tag":"span","props":{},"children":["05"]},"Not buying lottery tickets"]},{"tag":"a","props":{"href":"/en/tip/05-06"},"children":[{"tag":"span","props":{},"children":["06"]},"Walk away the moment you see “high returns,” “guaranteed returns,” or “sure profits”"]},{"tag":"a","props":{"href":"/en/tip/05-07"},"children":[{"tag":"span","props":{},"children":["07"]},"Avoid making minimum payments on credit cards, and never sign up for installment plans or consumer loans for purchases; if borrowing is unavoidable, first convert the interest rate to an annual percentage rate before comparing options"]},{"tag":"a","props":{"href":"/en/tip/05-08"},"children":[{"tag":"span","props":{},"children":["08"]},"Don’t give streamers tips, don’t make in‑game purchases, and don’t make impulsive buys"]},{"tag":"a","props":{"href":"/en/tip/05-09"},"children":[{"tag":"span","props":{},"children":["09"]},"When kids make in-app purchases or send gifts, parents can demand refunds for large sums spent by kids over eight if they never gave consent"]},{"tag":"a","props":{"href":"/en/tip/05-10"},"children":[{"tag":"span","props":{},"children":["10"]},"Teaching kids one key phrase: anyone who asks them to use a parent’s phone to enter verification codes is a scammer"]},{"tag":"a","props":{"href":"/en/tip/05-11"},"children":[{"tag":"span","props":{},"children":["11"]},"Skipping extended warranties for electronics"]},{"tag":"a","props":{"href":"/en/tip/05-12"},"children":[{"tag":"span","props":{},"children":["12"]},"Prefer generic drugs that have passed consistency evaluation and those selected in centralized procurement"]},{"tag":"a","props":{"href":"/en/tip/05-13"},"children":[{"tag":"span","props":{},"children":["13"]},"Once you set up family medical expense sharing in the yibao app, funds from your individual medical insurance account can be used to pay for your spouse, parents, and children’s medical care and medication"]},{"tag":"a","props":{"href":"/en/tip/05-14"},"children":[{"tag":"span","props":{},"children":["14"]},"Drink boiled tap water instead of routinely ordering large water-dispenser bottles or buying small bottled water"]},{"tag":"a","props":{"href":"/en/tip/05-15"},"children":[{"tag":"span","props":{},"children":["15"]},"Infrequent stock trading"]},{"tag":"a","props":{"href":"/en/tip/05-16"},"children":[{"tag":"span","props":{},"children":["16"]},"Don’t borrow money to invest, avoid leverage, and never buy assets you don’t understand"]},{"tag":"a","props":{"href":"/en/tip/05-17"},"children":[{"tag":"span","props":{},"children":["17"]},"Using broad-market index funds instead of actively managed funds as a long-term core holding (the portion of money you keep invested for years)"]},{"tag":"a","props":{"href":"/en/tip/05-18"},"children":[{"tag":"span","props":{},"children":["18"]},"When picking similar funds, go for those with lower fees"]},{"tag":"a","props":{"href":"/en/tip/05-19"},"children":[{"tag":"span","props":{},"children":["19"]},"Don’t put all your money into one stock, one platform, or one property"]},{"tag":"a","props":{"href":"/en/tip/05-20"},"children":[{"tag":"span","props":{},"children":["20"]},"Individuals paying income tax at a rate of 10% or higher can open a private pension account; up to 12,000 yuan per year can be deducted from taxable income. For those paying no tax or only a 3% rate, opening such an account is not worthwhile"]},{"tag":"a","props":{"href":"/en/tip/05-21"},"children":[{"tag":"span","props":{},"children":["21"]},"Paying for gym visits individually or on short-term plans is only worthwhile if you have a consistent attendance record spanning over a year"]},{"tag":"a","props":{"href":"/en/tip/05-22"},"children":[{"tag":"span","props":{},"children":["22"]},"Sign a written contract before paying a deposit; if a business faces risks, it must stop taking payments, and you have the right to get back any unused balance if it shuts down"]},{"tag":"a","props":{"href":"/en/tip/05-23"},"children":[{"tag":"span","props":{},"children":["23"]},"Implementing a 24-hour cooling-off period for non-essential big-ticket purchases; making full use of the seven-day no-questions-asked return policy for online shopping"]},{"tag":"a","props":{"href":"/en/tip/05-24"},"children":[{"tag":"span","props":{},"children":["24"]},"Don’t fall for “strikethrough prices” or impulse buying during sales"]},{"tag":"a","props":{"href":"/en/tip/05-25"},"children":[{"tag":"span","props":{},"children":["25"]},"It’s better to choose a non‑return insurance plan and treat any “refunds” or dividends as non‑guaranteed benefits"]},{"tag":"a","props":{"href":"/en/tip/05-26"},"children":[{"tag":"span","props":{},"children":["26"]},"Get sufficient third‑party liability coverage: the mandatory insurance limits are uniform nationwide and relatively low, so any excess must be paid out of your own pocket"]},{"tag":"a","props":{"href":"/en/tip/05-27"},"children":[{"tag":"span","props":{},"children":["27"]},"Set aside an emergency fund equal to 3–6 months of living expenses in a readily accessible account"]},{"tag":"a","props":{"href":"/en/tip/05-28"},"children":[{"tag":"span","props":{},"children":["28"]},"Run a quick comparison before paying off your mortgage — don’t rely on gut feeling"]},{"tag":"a","props":{"href":"/en/tip/05-29"},"children":[{"tag":"span","props":{},"children":["29"]},"When shopping online, follow platform rules and laws — not influencers or “positive reviews”"]},{"tag":"a","props":{"href":"/en/tip/05-30"},"children":[{"tag":"span","props":{},"children":["30"]},"If something goes wrong after buying from a livestream, first ask the platform for the seller’s and influencer’s details — they’re required to provide them"]},{"tag":"a","props":{"href":"/en/tip/05-31"},"children":[{"tag":"span","props":{},"children":["31"]},"If you buy unsafe food, you can demand ten times the purchase price as compensation; if the amount is under 1,000 yuan, you’re still entitled to 1,000 yuan"]},{"tag":"a","props":{"href":"/en/tip/05-32"},"children":[{"tag":"span","props":{},"children":["32"]},"Check national inspection reports, 3C certification, and energy labels before buying big-ticket items"]},{"tag":"a","props":{"href":"/en/tip/05-33"},"children":[{"tag":"span","props":{},"children":["33"]},"Bracelets, jade, luxury watches, and collectibles should be judged by “how much you spend” rather than “how much you save”"]},{"tag":"a","props":{"href":"/en/tip/05-34"},"children":[{"tag":"span","props":{},"children":["34"]},"For jewelry and gemstones, only test reports bearing the CMA mark are acceptable; you must also verify the issuing agency on the regulator’s official website"]},{"tag":"a","props":{"href":"/en/tip/05-35"},"children":[{"tag":"span","props":{},"children":["35"]},"Random sales such as blind boxes and gacha games are treated as “money that won’t come back”"]},{"tag":"a","props":{"href":"/en/tip/05-36"},"children":[{"tag":"span","props":{},"children":["36"]},"If you care about what’s in your food, buy pre-packaged products: loose goods at retail counters aren’t legally required to list ingredients"]},{"tag":"a","props":{"href":"/en/tip/05-37"},"children":[{"tag":"span","props":{},"children":["37"]},"Stocks that have lost value should also be sold according to pre‑set rules — don’t try to even out costs by buying more"]},{"tag":"a","props":{"href":"/en/tip/05-38"},"children":[{"tag":"span","props":{},"children":["38"]},"Planning to invest in overseas assets such as U.S. stocks? Use QDII funds or the Hong Kong Stock Connect program — don’t open accounts with foreign brokers, and don’t use your annual foreign exchange quota for buying foreign stocks"]},{"tag":"a","props":{"href":"/en/tip/05-39"},"children":[{"tag":"span","props":{},"children":["39"]},"Only buy insurance for losses your savings can’t cover; use an emergency fund for losses you can afford"]},{"tag":"a","props":{"href":"/en/tip/05-40"},"children":[{"tag":"span","props":{},"children":["40"]},"If someone at home depends on your income, buy term life insurance for the breadwinner first — not for your kids"]},{"tag":"a","props":{"href":"/en/tip/05-41"},"children":[{"tag":"span","props":{},"children":["41"]},"Regretting a personal insurance policy signed for over a year? You can cancel it during the cooling-off period and get most of your premium back"]},{"tag":"a","props":{"href":"/en/tip/05-42"},"children":[{"tag":"span","props":{},"children":["42"]},"Before signing at the bank counter, check whether it’s a deposit or insurance"]},{"tag":"a","props":{"href":"/en/tip/05-43"},"children":[{"tag":"span","props":{},"children":["43"]},"To cancel your insurance policy, contact the insurer directly — don’t use “policy cancellation agents.” If you feel misled, call 12378 for free assistance"]},{"tag":"a","props":{"href":"/en/tip/05-44"},"children":[{"tag":"span","props":{},"children":["44"]},"Writing a specific beneficiary on the policy lets family claim the payout: 5 years for life insurance, 2 years for other policies"]},{"tag":"a","props":{"href":"/en/tip/05-45"},"children":[{"tag":"span","props":{},"children":["45"]},"Do not buy cryptocurrencies such as Bitcoin or Tether, or join others’ investment schemes: trades lack legal protection, and suing will not recover investment losses"]},{"tag":"a","props":{"href":"/en/tip/05-46"},"children":[{"tag":"span","props":{},"children":["46"]},"If you have no employer, pay into China’s employee pension scheme yourself at the lowest contribution tier and first meet the minimum contribution period; even at the lowest tier, it takes about 10 years of pension payments to recover the cost"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"Breadcrumb"},"children":[{"tag":"a","props":{"