s":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Поделиться советом"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Скрыть подробности"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Затраты"]},{"tag":"p","props":{},"children":["Для проведения небольшой пробной партии потребуется несколько сотен юаней. Кроме того, необходимо потратить несколько часов на расчет следующих показателей: процент годности продукции (сколько из 100 изделий можно реализовать), минимальный объем заказа и условия оплаты у поставщиков, сумма, которая потребуется на формирование запасов, расходы на упаковку и логистику, а также требования к сертификации и разрешениям, включая регистрацию товарного знака. Самое сложное — удержаться от соблазна сразу приступить к массовому производству, не выполнив эти расчеты."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Польза"]},{"tag":"p","props":{},"children":["Разница между производством одного образца и тысячи изделий заключается в том, куда направляются финансовые средства. Процент годности определяет реальную себестоимость продукции — это доля изготовленных изделий, которые соответствуют стандартам и могут быть реализованы. Минимальный объем заказа у поставщиков и условия оплаты показывают, какую сумму придется вложить изначально. Размер запасов влияет на то, когда эти средства вернутся в оборот. Продукция, внесенная в перечень товаров, подлежащих обязательной сертификации, должна пройти проверку и иметь на себе знак сертификации, прежде чем ее можно будет выпускать в продажу. Нарушение этого правила влечет ответственность по соответствующим нормативным актам. Для организации ресторанного бизнеса и продажи продуктов питания требуется получить разрешение на ведение пищевой деятельности (действует по всей стране)."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Первоисточники"]},{"tag":"p","props":{"className":"life-citations"},"children":["质检总局 (2009). 强制性产品认证管理规定（质检总局令第 117 号，第二、四十九条）. ",{"tag":"a","props":{"href":"http://www.gov.cn/gongbao/content/2010/content_1533513.htm","target":"_blank","rel":"noopener noreferrer"},"children":["http://www.gov.cn/gongbao/content/2010/content_1533513.htm"]},"；市场监管总局 (2023). 食品经营许可和备案管理办法（市场监管总局令第 78 号，第四条）. ",{"tag":"a","props":{"href":"https://www.gov.cn/gongbao/2023/issue_10606/202307/content_6894763.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/gongbao/2023/issue_10606/202307/content_6894763.html"]}]},{"tag":"a","props":{"href":"http://www.gov.cn/gongbao/content/2010/content_1533513.htm","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Открыть источник"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Примечание автора"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["Предложенный перечень мер основан на практическом опыте, а информация о нормативных актах проверена по первоисточникам. Перед запуском производства рекомендуется проверить в базе данных Государственного управления интеллектуальной собственности наличие похожих зарегистрированных товарных знаков, а затем подать заявку на регистрацию собственного знака. Информация о запретах на использование чужих товарных знаков и изображений приведена в пунктах 20 и 21 (необходимо сохранять чеки на закупки, а изображения создавать самостоятельно или приобретать лицензию на их использование). Актуальный перечень товаров, подлежащих обязательной сертификации, публикуется Государственным управлением по надзору за рынком."]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Моя заметка"]},{"tag":"button","props":{"type":"button"},"children":["Запишите напоминание…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/ru/tip/12-18"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Предыдущий"]},"Продавать сначала, а потом производить: проверить спрос через предзаказы и мелкие заказы, прежде чем вкладывать средства в производство"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/ru/tip/12-20"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Следующий"]},"Сохраняйте документы и эти поставщика; не закупайте товары по цене, значительно ниже рыночной: если сотрудник привез подделку, ответственность несет руководитель"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["Другие советы по этой теме"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/12-15"},"children":[{"tag":"strong","props":{},"children":["При написании «задаток» вместо «предоплата» соблюдайте правила двойного возврата, четко пропишите размер неустойки, а предоставление отсрочки платежа рассматривайте как выдачу займа"]},{"tag":"span","props":{},"children":["Только при использовании формулировки «задаток» действуют правила дво…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/12-16"},"children":[{"tag":"strong","props":{},"children":["Заключение письменного трудового договора в первый месяц работы и регистрация в соцстрахе в течение 30 дней"]},{"tag":"span","props":{},"children":["Если сотрудник проработал месяц, а письменный договор так и не был за…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/12-17"},"children":[{"tag":"strong","props":{},"children":["Зарплата выплачивается согласно договору и закону; повышения, займы и премии оформляются письменно"]},{"tag":"span","props":{},"children":["Зарплату нужно выплачивать вовремя и в полном объеме согласно договор…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/12-21"},"children":[{"tag":"strong","props":{},"children":["Для товаров, упаковки, этикеток и рекламных изображений нужно либо создавать графику самостоятельно, либо покупать лицензию; изменение цвета или добавление своего значка не считается «изменением»"]},{"tag":"span","props":{},"children":["Если изменить цвет, фон или добавить свой значок к чужому изображению…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/12-22"},"children":[{"tag":"strong","props":{},"children":["Соблюдение установленных правил на рабочем месте и чёткое понимание ответственности при проявлении доброй воли вне этих рамок"]},{"tag":"span","props":{},"children":["Возьмём, к примеру, медицинских сестёр: согласно нормативным актам, п…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/12-23"},"children":[{"tag":"strong","props":{},"children":["Если убытки — действуйте по процедуре: при возможности проводите упрощённую ликвидацию, а если активы не покрывают долги — подавайте на банкротство, не оставляйте дело без внимания"]},{"tag":"span","props":{},"children":["Если задолженностей по кредитам, заработной плате, налогам или социал…"]}]}]}]},{"tag":"a","props":{"className":"life-text-link","href":"/ru/book/12"},"children":["Читать всю тему: Открытие бизнеса: как не потеря