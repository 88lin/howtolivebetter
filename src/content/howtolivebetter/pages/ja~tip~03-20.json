:"/ja/book/03"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"目次に戻る"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["エネルギーを無駄にしない"]},{"tag":"div","props":{"data-ad-dock-host":"true"},"children":[]},{"tag":"nav","props":{"aria-label":"この章のヒント"},"children":[{"tag":"a","props":{"href":"/ja/tip/03-01"},"children":[{"tag":"span","props":{},"children":["01"]},"不要な通知をオフにし、仕事中はスマホを視界の外に置く"]},{"tag":"a","props":{"href":"/ja/tip/03-02"},"children":[{"tag":"span","props":{},"children":["02"]},"起床時間を固定する、週末も同様に"]},{"tag":"a","props":{"href":"/ja/tip/03-03"},"children":[{"tag":"span","props":{},"children":["03"]},"毎晩 7 から 8 時間は睡眠を確保する。「6 時間で十分だ」と過信しない"]},{"tag":"a","props":{"href":"/ja/tip/03-04"},"children":[{"tag":"span","props":{},"children":["04"]},"午後2時以降はカフェインを控える"]},{"tag":"a","props":{"href":"/ja/tip/03-05"},"children":[{"tag":"span","props":{},"children":["05"]},"メールやメッセージの確認を、1日の中で決まった回数のまとめて処理に変更する"]},{"tag":"a","props":{"href":"/ja/tip/03-06"},"children":[{"tag":"span","props":{},"children":["06"]},"連続的な思考を要する仕事をする際は、たとえ数秒の遮断であっても排除する"]},{"tag":"a","props":{"href":"/ja/tip/03-07"},"children":[{"tag":"span","props":{},"children":["07"]},"一度に一つのことだけを行う。会議中にメッセージを返信しながら行わない"]},{"tag":"a","props":{"href":"/ja/tip/03-08"},"children":[{"tag":"span","props":{},"children":["08"]},"寝る前の1時間は発光する画面を見ない。見るなら紙の本か電子ペーパー（E-ink）にする"]},{"tag":"a","props":{"href":"/ja/tip/03-09"},"children":[{"tag":"span","props":{},"children":["09"]},"時間になったら寝る。ゲーム、ショート動画、ポルノコンテンツのために夜更かしをしない"]},{"tag":"a","props":{"href":"/ja/tip/03-10"},"children":[{"tag":"span","props":{},"children":["10"]},"深夜には重大な決断を下さず、重要なメッセージも送らない"]},{"tag":"a","props":{"href":"/ja/tip/03-11"},"children":[{"tag":"span","props":{},"children":["11"]},"午後に眠くなったら 10 分間の昼寝をする。30分寝てはいけない"]},{"tag":"a","props":{"href":"/ja/tip/03-12"},"children":[{"tag":"span","props":{},"children":["12"]},"オープンオフィスで作業する際は、耳栓を使うか、記憶力を要する仕事には静かな部屋を探す"]},{"tag":"a","props":{"href":"/ja/tip/03-13"},"children":[{"tag":"span","props":{},"children":["13"]},"週の労働時間をただ増やし続けない：49時間前後を超えると、1時間追加して得られる成果は次第に少なくなる"]},{"tag":"a","props":{"href":"/ja/tip/03-14"},"children":[{"tag":"span","props":{},"children":["14"]},"嫌な出来事を何度も思い返している自分に気づいたら、手を動かす作業に切り替える"]},{"tag":"a","props":{"href":"/ja/tip/03-15"},"children":[{"tag":"span","props":{},"children":["15"]},"「事態はきっと悪化する」といった考えを、事実ではなく「症状」として捉える"]},{"tag":"a","props":{"href":"/ja/tip/03-16"},"children":[{"tag":"span","props":{},"children":["16"]},"消耗させる人間関係を減らし、断りたい依頼は断る術を学ぶ"]},{"tag":"a","props":{"href":"/ja/tip/03-17"},"children":[{"tag":"span","props":{},"children":["17"]},"怒ったときはまずその場を離れ、相手を「敵」ではなく「天気」として扱う"]},{"tag":"a","props":{"href":"/ja/tip/03-18"},"children":[{"tag":"span","props":{},"children":["18"]},"気分が落ち込んだ時にまず行うべき、最もコストパフォーマンスの高い数事：体を動かす、日光を浴びる、規則正しく眠る、誰かに話す、12356に電話する"]},{"tag":"a","props":{"href":"/ja/tip/03-19"},"children":[{"tag":"span","props":{},"children":["19"]},"警察、医師、窓口担当者を「ルールに従って働く人」として捉える：役割（キャラクター）として見ない。物事を動かすのは感情ではなく、書類と期限である"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/ja/tip/03-20","data-status":"active"},"children":[{"tag":"span","props":{},"children":["20"]},"「他人の生活がどうであるか」を毎日の日課にしない：同年代の動向をチェックするアプリには制限を設けるか、オフにする"]},{"tag":"a","props":{"href":"/ja/tip/03-21"},"children":[{"tag":"span","props":{},"children":["21"]},"「みんなに恥をさらした」と感じたときは、その予測を半分にしてみてください"]},{"tag":"a","props":{"href":"/ja/tip/03-22"},"children":[{"tag":"span","props":{},"children":["22"]},"「他人に完璧であることを求められている」を事実ではなく、症状として捉える"]},{"tag":"a","props":{"href":"/ja/tip/03-23"},"children":[{"tag":"span","props":{},"children":["23"]},"怒ったときは物を叩きつける、サンドバッグを叩く、走り回ることで発散しようとせず、まずは身体を落ち着かせる"]},{"tag":"a","props":{"href":"/ja/tip/03-24"},"children":[{"tag":"span","props":{},"children":["24"]},"心に悩みがあるとき、数日間にわたって考えや感情を書き留めることはできますが、それが治療になるとは期待しないでください"]},{"tag":"a","props":{"href":"/ja/tip/03-25"},"children":[{"tag":"span","props":{},"children":["25"]},"月経痛にはイブプロフェンなどの鎮痛薬を使い、我慢しない。仕事や学校を休むほど痛い、3か月服用しても抑えられないなら婦人科で調べる"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"現在地"},"children":[{"tag":"a","props":{"href":"/ja/book"},"children":["本を読む"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/ja/book/03"},"children":["第3章"," ·"," ","エネルギーを無駄にしない"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"03-20"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["20"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["エビデンス"," ","A"]}]},{"tag":"h1","props":{"lang":"ja"},"children":["「他人の生活がどうであるか」を毎日の日課にしない：同年代の動向をチェックするアプリには制限を設けるか、オフにする"]},{"tag":"p","props":{"lang":"ja","className":"life-entry-summary"},"children":["ネット上で自分より良く暮らしている人と比較する習慣がある人は、しばしば感情が悪化し、自尊心が低下する傾向にあります。Facebookを4週間休止した人は、幸福感がわずかに向上しましたが、時事問題への理解度は一段階低下しました。3つのSNSをそれぞれ1日10分に制限した人は、3週間後、孤独感と抑えがちな抑うつ状態がともに低下しました。"]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["費用・手間"]},{"tag":"p","props":{},"children":["費用はかかりません。アプリに制限をかける、あるいはアカウントを停止するのは、わずか数分の作業です。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["効果"]},{"tag":"p","props":{},"children":["複数の研究を統合したメタ分析（54の独立したサンプル、94のエフェクトサイズ、N = 36,583、3レベルのランダム効果モデルを使用）によれば、オンラインにおける上方社会比較と心理的不適応の平均相関は r = 0.33…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"記録する：「他人の生活がどうであるか」を毎日の日課にしない：同年代の動向をチェックするアプリには制限を設けるか、オフにする"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"できている"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"やることに追加"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"お気に入り"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"このヒントを共有"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"詳細を閉じる"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["費用・手間"]},{"tag":"p","props":{},"children":["費用はかかりません。アプリに制限をかける、あるいはアカウントを停止するのは、わずか数分の作業です。難しいのは、その後二度と開かないことであり、慣性を長期的に抑え込む必要があります。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["効果"]},{"tag":"p","props":{},"children":["複数の研究を統合したメタ分析（54の独立したサンプル、94のエフェクトサイズ、N = 36,583、3レベルのランダム効果モデルを使用）によれば、オンラインにおける上方社会比較と心理的不適応の平均相関は r = 0.330（95% CI 0.289–0.370、信頼区間）です。具体的な結果を個別に見ていくと、他人から軽んじられることを恐れるといった社会的評価に関するネガティブな感情は 0.438、不安は 0.382、抑うつは 0.306、幸福感の低さは 0.268、自尊心の低さは 0.263 でした。年齢、文化的背景、データ収集の年は、この関連性の強さに影響を与えません。長期的な追跡調査から得られた結果も、同時点の調査結果より強いわけではありません。また、別のランダム化比較試験では、被験者は2,743名の米国Facebookユーザーでした。そのうち61%の人が、102ドル未満の負担であれば利用停止を受け入れると回答しました。これらの人々を、4週間休止グループと対照グループにランダムに分けました。休止グループは、通常の被験者よりも毎日60分の空き時間ができました。主観的幸福感指数は0.09標準偏差向上しました。内訳は、生活満足度 0.12、不安 0.10、抑うつ 0.09、喜び 0.08 です。多重比較による偶然の要素を排除した後でも、これらの数値は有効です。著者は、人を前向きにする心理的介入を一つの参照として挙げています。この種の介入による主観的幸福感への影響は約 +0.34 標準偏差、抑うつへの影響は約 -0.23 標準偏差です。したがって、この効果は通常の心理的介入の約25%から40%に相当します。同時期の代償として、時事知識指数は0.19標準偏差低下し、政治的立場の対立度は0.16低下しました。実験終了後、休止グループのFacebook利用時間は、対照グループよりも依然として1日あたり12分少なく（0.31標準偏差、減少率23%）、アプリの使用を抑える効果が残っていました。もう一つのランダム化比較試験では、被験者は143名の大学生で、2つのグループにランダムに分けられました。一方のグループはFacebook、Instagram、Snapchatの各プラットフォームを1日10分に制限し、もう一方は通常通り使用しました。3週間後、制限グループでは孤独感と抑うつが明らかに低下しました。両グループともに、不安とFOMO（取り残される恐怖）は開始時よりも低い数値を示しました。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["出典"]},{"tag":"p","props":{"className":"life-citations"},"children":["Lei Y, Hu S, Sun Y, Zheng L (2026). \"Looking up\" linked to feeling down: a meta-analysis of online upward social comparison and psychological maladjustment. Frontiers in Psychology. ",{"tag":"a","props":{"href":"https://doi.org/10.3389/fpsyg.2026.1825169","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.3389/fpsyg.2026.1825169"]},"；Allcott H, Braghieri L, Eichmeyer S, Gentzkow M (2020). The Welfare Effects of Social Media. American Economic Review, 110(3), 629–676. ",{"tag":"a","props":{"href":"https://doi.org/10.1257/aer.20190658","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1257/aer.20190658"]},"；Allcott H, Braghieri L, Eichmeyer S, Gentzkow M (2019). The Welfare Effects of Social Media. NBER Working Paper No. 25514（本条引用的具体数字按这一版逐字核对，刊出版的摘要不含数字）. ",{"tag":"a","props":{"href":"https://www.nber.org/papers/w25514","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.nber.org/papers/w25514"]},"；Hunt MG, Marx R, Lipson C, Young J (2018). No More FOMO: Limiting Social Media Decreases Loneliness and Depression. Journal of Social and Clinical Psychology, 37(10), 751–768. ",{"tag":"a","props":{"href":"https://doi.org/10.1521/jscp.2018.37.10.751","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1521/jscp.2018.37.10.751"]}]},{"tag":"a","props":{"href":"https://doi.org/10.3389/fpsyg.2026.1825169","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["出典を開く"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["著者の注記"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["「相関」の半分は、2つの事象が同時に起こっていることを示しているに過ぎず、どちらかが原因であると読み取ることはできません。著者自身も、さらなる長期的な追跡調査が必要であると述べています。ランダム化グループ分けの半分については因果関係を言えますが、被験者は201なる2018年の米国中間選挙前のFacebookユーザーであり、これを中国のプラットフォームにそのまま当てはめるのは無理があります。Huntの研究はわずか143名の大学生のみであり、それもこの1件のみです。エフェクトサイズはそれほど大きくないので、アプリを閉じるだけで感情の問題が解決すると期待してはいけません。阻止すべきは「他人の生活がどうであるか」を見るタイプの利用であり、家族や友人との連絡、情報検索、仕事探しなどは含まれません。どうしても抑えられない場合は、まずは通知をオフにする、「知り合いかも」やホーム画面のレコメンドをオフにすることから始めてください。総スクリーンタイムに関する計算については、第4節第15、16条（ショート動画の厳格な上限、流れてくるニュースを見ない）を参照。気分が落ち込んだ時にまず何をすべきかについては、本節第18条（体を動かす、日光を浴びる、規則正しく眠る）を参照。買い物によってアイデンティティを取り戻そうとすることについては、第6節第23条を参照。 「一段上のレベルへ」行くために余分に費用をかけることについては、第6節第24条を参照。"]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["自分のメモ"]},{"tag":"button","props":{"type":"button"},"children":["自分へのメモを書く…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/ja/tip/03-19"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["前へ"]},"警察、医師、窓口担当者を「ルールに従って働く人」として捉える：役割（キャラクター）として見ない。物事を動かすのは感情ではなく、書類と期限である"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/ja/tip/03-21"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["次へ"]},"「みんなに恥をさらした」と感じたときは、その予測を半分にしてみてください"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["このテーマの他の提案"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/03-16"},"children":[{"tag":"strong","props":{},"children":["消耗させる人間関係を減らし、断りたい依頼は断る術を学ぶ"]},{"tag":"span","props":{},"children":["あなたを消耗させる人がもたらす損失は、あなたを支えてくれる人がもたらす利益よりも大きく、かつ一貫しています。ですから、まずは引き算をしてか…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/03-17"},"children":[{"tag":"strong","props":{},"children":["怒ったときはまずその場を離れ、相手を「敵」ではなく「天気」として扱う"]},{"tag":"span","props":{},"children":["起きたことを別の角度から見直すことも、相手の立場に立って考えることも、感情を鎮める効果があり、後者の方がより効果的です。感情を表に出さない…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/03-18"},"children":[{"tag":"strong","props":{},"children":["気分が落ち込んだ時にまず行うべき、最もコストパフォーマンスの高い数事：体を動かす、日光を浴びる、規則正しく眠る、誰かに話す、12356に電話する"]},{"tag":"span","props":{},"children":["うつ状態に対しては、早歩きやジョギングが最も効果的であり、強度が大きいほど効果が高まります。詳細は第 22 節第 6 条（気分が悪いときは…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/03-22"},"children":[{"tag":"strong","props":{},"children":["「他人に完璧であることを求められている」を事実ではなく、症状として捉える"]},{"tag":"span","props":{},"children":["「周囲から完璧であることを求められ、できなければ否定される」と感じている人は、自殺念慮を抱きやすい傾向にあります。「自分自身に完璧を求めて…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/03-23"},"children":[{"tag":"strong","props":{},"children":["怒ったときは物を叩きつける、サンドバッグを叩く、走り回ることで発散しようとせず、まずは身体を落ち着かせる"]},{"tag":"span","props":{},"children":["サンドバッグを叩く、物を投げつける、走り回るといった、身体をより興奮させるような発散方法は、全体として怒りを鎮めることはできません。ゆっく…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/03-24"},"children":[{"tag":"strong","props":{},"children":["心に悩みがあるとき、数日間にわたって考えや感情を書き留めることはできますが、それが治療になるとは期待しないでください"]},{"tag":"span","props":{},"children":["嫌な出来事を書き出すことは、平均して多少のメリットがありますが、ごくわずかです。メタ分析の結果も一致しておらず、2つのまとめでは効果がない…"]}]}]}]},{"tag":"a","props":{"className":"life-text-link","href":"/ja/book/03"},"children":["テーマ全体を読む：エネルギーを無駄にしない"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"15","height":"15","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"c