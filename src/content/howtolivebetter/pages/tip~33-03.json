trokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"加入待做"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"收藏"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"分享这条建议"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"收起详情"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["成本"]},{"tag":"p","props":{"className":"life-citations"},"children":["不花钱。把两条情形记住，需要时能说出口。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["收益"]},{"tag":"p","props":{"className":"life-citations"},"children":["《精神卫生法》第三十条写明「精神障碍的住院治疗实行自愿原则」。只有诊断结论和病情评估表明就诊者是严重精神障碍患者、并且有下列情形之一的，才应当实施住院治疗。一是「已经发生伤害自身的行为，或者有伤害自身的危险的」。二是「已经发生危害他人安全的行为，或者有危害他人安全的危险的」。第三十一条：属于第一种情形的，经监护人同意医疗机构才实施住院治疗，监护人不同意的不得实施。第三十二条：属于第二种情形而本人或者监护人有异议的，可以要求再次诊断，应当自收到诊断结论之日起三日内提出，由二名初次诊断医师以外的精神科执业医师作出；对再次诊断结论仍有异议的，可以自主委托依法取得执业资质的鉴定机构做精神障碍医学鉴定。第三十五条：再次诊断结论或者鉴定报告表明不能确定为严重精神障碍患者、或者患者不需要住院治疗的，医疗机构不得对其实施住院治疗。第七十八条：将非精神障碍患者故意作为精神障碍患者送入医疗机构治疗的，依法承担赔偿责任（全国，2013 年 5 月 1 日起施行，2018 年修正）"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["来源"]},{"tag":"p","props":{"className":"life-citations"},"children":["中华人民共和国精神卫生法（2018 年修正，第三十条、第三十一条、第三十二条、第三十五条、第七十八条）. ",{"tag":"a","props":{"href":"https://flk.npc.gov.cn/detail?id=2c909fdd678bf17901678bf7448a066d","target":"_blank","rel":"noopener noreferrer"},"children":["https://flk.npc.gov.cn/detail?id=2c909fdd678bf17901678bf7448a066d"]},""]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["原书备注"]},{"tag":"p","props":{"className":"life-citations"},"children":["反过来，也不是谁都不能送医。第二十八条规定，疑似精神障碍患者已经发生伤害自身、危害他人安全的行为，或者有这个危险的，其近亲属、所在单位、当地公安机关应当立即采取措施予以制止，并将其送往医疗机构进行精神障碍诊断。医疗机构接到送诊的，不得拒绝作出诊断。所以「送去做诊断」和「留下来住院」是两道门，前一道低，后一道高。第七十五条列了医疗机构的责任，违反规定实施约束隔离、把非精神障碍患者诊断成精神障碍患者，要被处分直至吊销执业证书。身边人有伤人冲动时怎么办，见第 8 节。"]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["我的备注"]},{"tag":"button","props":{"type":"button"},"children":["写下对自己有用的提醒…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/tip/33-02"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["上一条"]},"致残之后的头十年是自杀的高风险期，别当成「想开点」就行的事"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/tip/33-04"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["下一条"]},"长期照护家里残疾人的那个人，自己的身体要有人盯着"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["本主题的其他建议"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/33-01"},"children":[{"tag":"strong","props":{},"children":["脊髓损伤之后突然剧烈头痛、出汗，先扶坐直、松开衣物，同时叫 120"]},{"tag":"span","props":{},"children":["脊髓损伤的人，身体的报警线路断了一截。膀胱憋着、衣服勒着，本人可能没感觉，血压却会猛往上冲。信号是突然剧烈头痛和出汗。这时先把人扶坐直、松开勒紧的衣物、看是不是…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/33-05"},"children":[{"tag":"strong","props":{},"children":["长期坐轮椅的，坐垫换成减压型，每天看一遍坐骨和尾骨"]},{"tag":"span","props":{},"children":["普通海绵坐垫压久了会把皮肤压破，破了愈合很慢，容易感染。养老院里用减压坐垫的老人，坐骨那里的压疮明显更少，但把尾骨一起算就没看出差别。轮椅本身也要按人的尺寸配，…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/33-06"},"children":[{"tag":"strong","props":{},"children":["别买「能治好瘫痪、失明、耳聋」的疗法和器械"]},{"tag":"span","props":{},"children":["广告法把话说死了。医疗、药品、医疗器械的广告，不许保证疗效，不许说治愈率和有效率，不许找人现身说法。所以「三个疗程站起来」「多少人已经康复」这类话本身就是违法广…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/33-07"},"children":[{"tag":"strong","props":{},"children":["残疾人证办下来之后，去县级残联把能申请的东西一次问全"]},{"tag":"span","props":{},"children":["残疾人证本身不发钱，它是一把钥匙。接在它后面的是好几笔各自独立的待遇，每一笔都要自己去申请，不会自动上门。第一次去残联，就把清单上的项目一项项问过来，比来回跑几…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/33-08"},"children":[{"tag":"strong","props":{},"children":["孩子不满 7 岁又有残疾或者孤独症的，去县级残联申请康复救助"]},{"tag":"span","props":{},"children":["国家给 0 到 6 岁的残疾儿童和孤独症儿童建了一套康复救助制度，管手术、辅助器具和康复训练。救助对象先保困难家庭，地方财力允许的可以放宽年龄和家庭经济条件。这…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/33-09"},"children":[{"tag":"strong","props":{},"children":["家里的坡道、扶手和浴室改造，可以向县级以上政府申请补贴"]},{"tag":"span","props":{},"children":["《无障碍环境建设法》写了一条：县级以上政府应当支持、指导家庭无障碍设施改造，对符合条件的残疾人、老年人家庭应当给予适当补贴。这类项目一般由残联牵头，按年度名额做…"]}]}]}]},{"tag":"a","props":{"className":"life-text-link","href":"/book/33"},"children":["阅读整个主题：残疾之后怎么活 ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"15","height":"15","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor",