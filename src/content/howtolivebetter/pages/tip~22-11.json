{"path":"/tip/22-11","title":"喝了酒别泡温泉、蒸桑拿，回家也别泡热水澡 | HowToLiveBetter","description":"在芬兰，死在桑拿房里的人有一半喝过酒。在东京，做过尸检的洗澡死亡者约四分之一血液酒精不低，一份浴缸溺死记录里醉酒是最多见的诱因。日本官方把「喝了酒别泡澡」列为防溺水的要点。同伴喝多了，也别让他一个人进去泡。","lang":"zh","styles":["/sites/howtolivebetter/styles/bca54bebe9c1bd3b.css"],"bodyClass":"font-sans antialiased","nodes":[{"tag":"div","props":{"className":"life-site"},"children":[{"tag":"div","props":{"className":"life-header-slot","aria-hidden":"true"},"children":[]},{"tag":"header","props":{"className":"life-header"},"children":[{"tag":"div","props":{"className":"life-header-inner"},"children":[{"tag":"a","props":{"className":"life-brand","aria-label":"H ✳ HowToLiveBetter 首页","href":"/"},"children":[{"tag":"span","props":{"className":"life-brand-mark","aria-hidden":"true"},"children":["H",{"tag":"span","props":{},"children":["✳"]}]},{"tag":"span","props":{},"children":["HowToLive",{"tag":"span","props":{},"children":["Better"]}]}]},{"tag":"nav","props":{"className":"life-nav","aria-label":"主导航"},"children":[{"tag":"a","props":{"className":"life-nav-link","href":"/book"},"children":[{"tag":"span","props":{},"children":["阅读全书"]}]},{"tag":"a","props":{"className":"life-nav-link","href":"/top-50"},"children":[{"tag":"span","props":{},"children":["精选 50 条"]}]},{"tag":"a","props":{"className":"life-nav-link","href":"/daily"},"children":[{"tag":"span","props":{},"children":["每日任务"]}]},{"tag":"a","props":{"className":"life-nav-link","href":"/dashboard"},"children":[{"tag":"span","props":{},"children":["我的清单"]}]},{"tag":"button","props":{"type":"button","className":"life-nav-link life-nav-more","aria-haspopup":"menu","aria-expanded":"false"},"children":[{"tag":"span","props":{},"children":["更多"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"15","height":"15","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down","aria-hidden":"true"},"children":[{"tag"