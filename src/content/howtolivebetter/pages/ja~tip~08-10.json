ead_product","data-ad-ready":"false","aria-label":"広告 · コミュニティ紹介"},"children":[{"tag":"button","props":{"type":"button","className":"life-ad-dismiss","aria-label":"広告を閉じる"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-x","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M18 6 6 18"},"children":[]},{"tag":"path","props":{"d":"m6 6 12 12"},"children":[]}]}]},{"tag":"div","props":{"className":"life-ad-space-brand"},"children":[{"tag":"img","props":{"src":"/sites/howtolivebetter/images/shengcai/logo.png","width":"565","height":"144","alt":"生財有術の公式ロゴ","decoding":"async"},"children":[]}]},{"tag":"div","props":{"className":"life-ad-space-copy"},"children":[{"tag":"span","props":{"className":"life-ad-space-label"},"children":["広告 · コミュニティ紹介"]},{"tag":"strong","props":{},"children":["学んだ知識は、役立つ製品になる？"]},{"tag":"p","props":{},"children":["電子書籍や小さなツール。需要を見つけ、知識を使える形にする参加者の実践を紹介します。"]}]},{"tag":"div","props":{"className":"life-ad-space-actions"},"children":[{"tag":"a","props":{"className":"life-ad-space-link","href":"/ja/shengcaiyoushu?sc_group=reading&sc_creative=read_product&sc_placement=ad_dock"},"children":["コミュニティと事例を見る",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"18","height":"18","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-up-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M7 7h10v10"},"children":[]},{"tag":"path","props":{"d":"M7 17 17 7"},"children":[]}]}]}]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/ja/book/08"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"目次に戻る"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["自分を犠牲にしないために：法律と財産の安全を守る"]},{"tag":"div","props":{"data-ad-dock-host":"true"},"children":[]},{"tag":"nav","props":{"aria-label":"この章のヒント"},"children":[{"tag":"a","props":{"href":"/ja/tip/08-01"},"children":[{"tag":"span","props":{},"children":["01"]},"交通事故に遭ったら、まずは停車、救護、通報。逃走してはいけない"]},{"tag":"a","props":{"href":"/ja/tip/08-02"},"children":[{"tag":"span","props":{},"children":["02"]},"詐欺に気づいたら、すぐに 110 または 96110 に電話して支払停止を依頼すること。自分で調べるのは後回しに"]},{"tag":"a","props":{"href":"/ja/tip/08-03"},"children":[{"tag":"span","props":{},"children":["03"]},"詐欺防止の鉄則を覚えよう：電話を鵜呑みにしない、情報を明かさない、リンクをクリックしない、送金は必ず確認する。最も一般的な7つの詐欺はこのパターンです"]},{"tag":"a","props":{"href":"/ja/tip/08-04"},"children":[{"tag":"span","props":{},"children":["04"]},"ビデオで顔を見ること、電話で声を聞くことは「本人確認」とはみなさない。送金が絡む場合は一旦電話を切り、自分の連絡先に登録されている古い番号にかけ直すこと"]},{"tag":"a","props":{"href":"/ja/tip/08-05"},"children":[{"tag":"span","props":{},"children":["05"]},"容疑をかけられた、または召喚された場合は、まず弁護士を依頼すること。示談はせず、記録を削除しないこと"]},{"tag":"a","props":{"href":"/ja/tip/08-06"},"children":[{"tag":"span","props":{},"children":["06"]},"問題が起きたら自ら説明しに行く：自首すれば刑期を最大4割減刑できる可能性があり、軽い犯罪ならさらに減刑や免罰もあり得る。「公訴時効を逃れる」という道は閉ざされている"]},{"tag":"a","props":{"href":"/ja/tip/08-07"},"children":[{"tag":"span","props":{},"children":["07"]},"飲酒した後はハンドルに触れない。電気自動車や「少しだけ動かす」場合も含む"]},{"tag":"a","props":{"href":"/ja/tip/08-08"},"children":[{"tag":"span","props":{},"children":["08"]},"銀行カード、SIMカード、決済アカウントを他人に貸さない。「資金洗浄（跑分）」は副業ではない"]},{"tag":"a","props":{"href":"/ja/tip/08-09"},"children":[{"tag":"span","props":{},"children":["09"]},"年に2回、無料で自分の信用報告書をチェックし、身に覚えのないローンやカードがないか確認する"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/ja/tip/08-10","data-status":"active"},"children":[{"tag":"span","props":{},"children":["10"]},"衝突が起きたら、手を出さずにまず通報すること。先に手を出した側が、ほぼ確実に損をする"]},{"tag":"a","props":{"href":"/ja/tip/08-11"},"children":[{"tag":"span","props":{},"children":["11"]},"避けられない侵害に対しては反撃可能だが、現在手を出し続けている人物に対してのみ行うこと。相手が止まれば、あなたも止めること"]},{"tag":"a","props":{"href":"/ja/tip/08-12"},"children":[{"tag":"span","props":{},"children":["12"]},"誰と恨みができたとしても（賃金未払い、解雇、金銭トラブルなど）―― 復讐ではなく、苦情申し立て、仲裁、訴訟の手続きを踏むこと"]},{"tag":"a","props":{"href":"/ja/tip/08-13"},"children":[{"tag":"span","props":{},"children":["13"]},"どれほど恨みがあっても無関係な人には手を出さない：車で群衆に突っ込む行為や公共の場での凶行は「危険な方法による公共の安全への危害罪」となり、刑期は3年から。死者が出れば10年以上、最高で死刑"]},{"tag":"a","props":{"href":"/ja/tip/08-14"},"children":[{"tag":"span","props":{},"children":["14"]},"「道連れにしてやる」「共倒れになってやる」といった考えが浮かんだら、緊急事態として対処：その場を離れ、車の鍵や刃物を他人に預け、12356 に電話する"]},{"tag":"a","props":{"href":"/ja/tip/08-15"},"children":[{"tag":"span","props":{},"children":["15"]},"周囲の人が「誰も幸せになれないようにしてやる」「子供を連れて逃げる」と言い出した時、感情的な言葉だと思わないで：近親者は直接受診させることができ、警察は通報を受けたら必ず対応しなければなりません"]},{"tag":"a","props":{"href":"/ja/tip/08-16"},"children":[{"tag":"span","props":{},"children":["16"]},"ネット上では誹謗中傷やデマ、未確認情報の拡散をしないこと。ネットリンチを受けた際は、まず証拠を残してから警察へ通報すること"]},{"tag":"a","props":{"href":"/ja/tip/08-17"},"children":[{"tag":"span","props":{},"children":["17"]},"署名前に書類を最後まで読み、代理署名はせず、白紙には署名しない"]},{"tag":"a","props":{"href":"/ja/tip/08-18"},"children":[{"tag":"span","props":{},"children":["18"]},"借金の際は借用書を明記すること。他人への保証人になる前には、代わりに返済する意思があるかよく考えること"]},{"tag":"a","props":{"href":"/ja/tip/08-19"},"children":[{"tag":"span","props":{},"children":["19"]},"権利保護には期限があります：民事訴訟時効は 3 年、労働仲裁は 1 年、期限を過ぎると相手の「時効超過」の一言で十分です"]},{"tag":"a","props":{"href":"/ja/tip/08-20"},"children":[{"tag":"span","props":{},"children":["20"]},"提訴された、強制執行された場合は、財産を正直に報告し、支払える分だけ支払うこと。不動産や現金を親族や会社に移してはいけません"]},{"tag":"a","props":{"href":"/ja/tip/08-21"},"children":[{"tag":"span","props":{},"children":["21"]},"消費制限または失信リストへの掲載を受けた場合は、まずどの条項に基づいて掲載されたのかを確認し、訂正可能な場合は訂正を申請すること"]},{"tag":"a","props":{"href":"/ja/tip/08-22"},"children":[{"tag":"span","props":{},"children":["22"]},"ネットショッピングや中古取引で詐欺に遭ったら、まずはプラットフォームへ通報、次に警察へ通報、その上で訴訟を起こす価値があるかを検討"]},{"tag":"a","props":{"href":"/ja/tip/08-23"},"children":[{"tag":"span","props":{},"children":["23"]},"恋愛および婚姻における高額な贈与は、交付する前に慎重に検討を。交付後は原則として取り消せません"]},{"tag":"a","props":{"href":"/ja/tip/08-24"},"children":[{"tag":"span","props":{},"children":["24"]},"結納金は振込で行い、用途を明記し、チャット履歴を保存すること。結婚を口実とした金銭要求は返還請求が可能"]},{"tag":"a","props":{"href":"/ja/tip/08-25"},"children":[{"tag":"span","props":{},"children":["25"]},"婚前財産を恐れる必要はありません。不動産の名義追加や親の出資は事前に明確に書き留めておくこと"]},{"tag":"a","props":{"href":"/ja/tip/08-26"},"children":[{"tag":"span","props":{},"children":["26"]},"結婚前に相手の婚姻状況を確認すること。結婚を口実にお金を騙し取る行為は詐欺罪として追及されます"]},{"tag":"a","props":{"href":"/ja/tip/08-27"},"children":[{"tag":"span","props":{},"children":["27"]},"出張修理、車両点検、リフォームなどは、作業前に必ず価格を確認し、全工程を傍らで見守ること"]},{"tag":"a","props":{"href":"/ja/tip/08-28"},"children":[{"tag":"span","props":{},"children":["28"]},"「名義上の代表者」にならないこと。会社設立のために身分証を他人に貸さないこと"]},{"tag":"a","props":{"href":"/ja/tip/08-29"},"children":[{"tag":"span","props":{},"children":["29"]},"出入国時に見知らぬ人の荷物を預からないこと。出所不明の小包を代理受領しないこと"]},{"tag":"a","props":{"href":"/ja/tip/08-30"},"children":[{"tag":"span","props":{},"children":["30"]},"中国で犬を飼うなら必ずリードを使う。未装着の事故は無過失責任で賠償する。狂犬病ワクチンと飼育登録も忘れない"]},{"tag":"a","props":{"href":"/ja/tip/08-31"},"children":[{"tag":"span","props":{},"children":["31"]},"相手が意識不明、睡眠中、または 14 歳未満である可能性がある場合は、性交渉を行わないこと"]},{"tag":"a","props":{"href":"/ja/tip/08-32"},"children":[{"tag":"span","props":{},"children":["32"]},"性交渉やビデオチャットの後、相手が通報、写真の拡散、勤務先への連絡を盾に金銭を要求してきた場合、一銭も払わず、記録も削除せず、直ちに警察へ通報すること"]},{"tag":"a","props":{"href":"/ja/tip/08-33"},"children":[{"tag":"span","props":{},"children":["33"]},"事実を捏造して通報された場合、以下の追及が可能です：治安行政処分に該当する場合は 5 日からの拘留、犯罪に該当する場合は 3 年以下の懲役"]},{"tag":"a","props":{"href":"/ja/tip/08-34"},"children":[{"tag":"span","props":{},"children":["34"]},"証拠不十分であれば本来無罪とされるべきであり、強要された自白は排除されるべきである。判決後には上訴や再審の道がある"]},{"tag":"a","props":{"href":"/ja/tip/08-35"},"children":[{"tag":"span","props":{},"children":["35"]},"勾留後に不起訴、不起訴処分または無罪判決を受けた場合、国家賠償を申請できます。賠償額は日割り計算されます"]},{"tag":"a","props":{"href":"/ja/tip/08-36"},"children":[{"tag":"span","props":{},"children":["36"]},"被害者として賠償を請求する場合、12315、訴訟、または弁護士を通じて行い、相手と二人きりで会う約束をしないこと。「金を払えば、公表しない」という言い方をセットにしないこと"]},{"tag":"a","props":{"href":"/ja/tip/08-37"},"children":[{"tag":"span","props":{},"children":["37"]},"ネット炎上（ネットいじめ）に遭ったら：まずは防御設定、証拠保全、そしてプラットフォームへの通報・禁止命令・警察への通報の3つの道から選択"]},{"tag":"a","props":{"href":"/ja/tip/08-38"},"children":[{"tag":"span","props":{},"children":["38"]},"「保険をかけてから手を下す」という道は、法律上最初から完全に塞がれています：金銭は一切受け取れず、罪は殺人罪と保険詐欺罪の併合罪として処罰されます"]},{"tag":"a","props":{"href":"/ja/tip/08-39"},"children":[{"tag":"span","props":{},"children":["39"]},"警察への通報時はその場で受理票を受け取ること、不立案（事件化しない）の場合は書面での通知が必要：7 日以内に再審査を申請でき、さらに 7 日以内に再審査請求が可能。検察庁は警察に立案を通知できます"]},{"tag":"a","props":{"href":"/ja/tip/08-40"},"children":[{"tag":"span","props":{},"children":["40"]},"捜査・執行官への金銭やカードの贈賄は避けること：贈賄側も処罰の対象となり、監察・執行・司法関係者への贈賄はより重い刑が科される"]},{"tag":"a","props":{"href":"/ja/tip/08-41"},"children":[{"tag":"span","props":{},"children":["41"]},"トラブルに発展しそうな電話や面談は、直接録音する：自分が参加している会話なら、相手の事前の同意は不要"]},{"tag":"a","props":{"href":"/ja/tip/08-42"},"children":[{"tag":"span","props":{},"children":["42"]},"現場で事故が起きたら、まず全景、次に位置関係、最後に損傷と怪我の状況を撮影すること。元の写真や動画は削除しないでください"]},{"tag":"a","props":{"href":"/ja/tip/08-43"},"children":[{"tag":"span","props":{},"children":["43"]},"ドメスティック・バイオレンス（DV）を受けた時：まずは警察に通報して出動記録を残し、その後に裁判所へ人身安全保護命令を申請しましょう。離婚を先に済ませる必要はなく、費用もかかりません"]},{"tag":"a","props":{"href":"/ja/tip/08-44"},"children":[{"tag":"span","props":{},"children":["44"]},"家族がギャンブルで借金を作った場合、すぐに肩代わりして返済しないでください：ギャンブルの借金は法律で保護されず、ギャンブルのために借りたお金も夫婦の共同債務とはみなされません"]},{"tag":"a","props":{"href":"/ja/tip/08-45"},"children":[{"tag":"span","props":{},"children":["45"]},"知人から「顔認証の協力や証人になってほしい」と融資の手伝いを頼まれたら、決して応じてはいけない：これは「ABローン」と呼ばれ、借り手はあなたであり、保証人ではありません"]},{"tag":"a","props":{"href":"/ja/tip/08-46"},"children":[{"tag":"span","props":{},"children":["46"]},"ドアと窓に錠を付け、玄関外にセンサーライトを設置し、外出時は必ず施錠する。侵入窃盗の予防はこの組み合わせで、警報器だけの効果は認められない"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"現在地"},"children":[{"tag":"a","props":{"href":"/ja/book"},"children":["本を読む"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/ja/book/08"},"children":["第8章"," ·"," ","自分を犠牲にしないために：法律と財産の安全を守る"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"08-10"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["10"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["エビデンス"," ","A"]}]},{"tag":"h1","props":{"lang":"ja"},"children":["衝突が起きたら、手を出さずにまず通報すること。先に手を出した側が、ほぼ確実に損をする"]},{"tag":"p","props":{"lang":"ja","className":"life-entry-summary"},"children":["暴行の場合、5日から10日の拘留、および500から1000の罰金。集団暴行、高齢者・妊婦・子供・障がい者への暴行、または繰り返しの暴行は、10日から15日の拘留、および1000から2000の罰金。軽傷に至った場合は刑事事件となり、3年以下の判決、重傷の場合は3年から10年の判決となる。二人で殴り合う状態は正当防衛とはみなされず、先に手を出した側がほぼ確実に損をする。人が多い場所へ退避して通報することは、反撃するよりも効果的である。"]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["費用・手間"]},{"tag":"p","props":{},"children":["費用はかからない。人が多い場所へ退避して通報し、相手の動きを監視カメラに残すこと。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["効果"]},{"tag":"p","props":{},"children":["他人を殴打、または故意に傷害した場合は、5日から10日の拘留に処し、500元から1000元の罰金を科す。"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"記録する：衝突が起きたら、手を出さずにまず通報すること。先に手を出した側が、ほぼ確実に損をする"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"できている"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"やることに追加"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"お気に入り"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"このヒントを共有"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"詳細を閉じる"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["費用・手間"]},{"tag":"p","props":{},"children":["費用はかからない。人が多い場所へ退避して通報し、相手の動きを監視カメラに残すこと。難しいのは、言い返したり突き飛ばしたりしたい衝動を抑えることである。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["効果"]},{"tag":"p","props":{},"children":["他人を殴打、または故意に傷害した場合は、5日から10日の拘留に処し、500元から1000元の罰金を科す。集団での暴行、高齢者・妊婦・子供・障がい者に対する暴行、繰り返しの暴行、または一度に複数人を殴打した場合は、10日から15日の拘留に処し、1000元から2000元の罰金を科す。集団での喧嘩は「挑発行為（尋釁滋事）」として処理され、最高で15日の拘留および2000元の罰金が科される。挑発行為とは、不当に騒ぎを起こしたり、トラブルを捏造したりすることを指す。故意に他人の身体を傷害し、犯罪を構成した場合は、3年以下の懲役とする。重傷を負わせた場合は、3年から10年の懲役とする。二人で互いに殴り合うことは、法律上「相互闘争」と呼ばれ、正当防衛とはみなされない。ただし、相手が先に手を出してきた場合や、その手段が明らかに過剰である場合、あるいは、回避しようと努力したにもかかわらず相手が攻撃を続けてきた場合、反撃は一般的に防衛と認定される。過剰防衛とは、反撃が度を越した状態を指し、明らかに必要限度を超え、かつ重大な損害を与えたという2つの条件を同時に満たす必要があります。たとえ実際に過剰であったとしても、刑を軽減または免除されるべきです（全国、治安管理処罰法 2026 年 1 月 1 日より施行）"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["出典"]},{"tag":"p","props":{"className":"life-citations"},"children":["全国人大常委会 (2025). 治安管理处罚法（2025 年修订，第三十、五十一条）. ",{"tag":"a","props":{"href":"https://www.spp.gov.cn/spp/fl/202506/t20250627_699863.shtml","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.spp.gov.cn/spp/fl/202506/t20250627_699863.shtml"]},"；全国人大 (1997). 刑法（第二十、二百三十四条）. ",{"tag":"a","props":{"href":"https://www.spp.gov.cn/spp/fl/201802/t20180206_364975.shtml","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.spp.gov.cn/spp/fl/201802/t20180206_364975.shtml"]},"；最高人民法院、最高人民检察院、公安部 (2020). 关于依法适用正当防卫制度的指导意见（法发〔2020〕31 号，第 6、9、11、14 条）. ",{"tag":"a","props":{"href":"https://www.court.gov.cn/zixun/xiangqing/251611.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.court.gov.cn/zixun/xiangqing/251611.html"]}]},{"tag":"a","props":{"href":"https://www.spp.gov.cn/spp/fl/202506/t20250627_699863.shtml","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["出典を開く"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["著者の注記"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["治安管理処罰法の 2025 年改正で条文番号はすべて変わり、他人への殴打は旧第43条から第51条になりました。旧番号の資料は古いものです。「軽傷なら刑事罰」の軽傷は鑑定基準で決まりますが、本節では確認していません。相手が倒れた、逃げた場合は侵害が止まっており、追いかけて殴れば防衛ではありません。護身用のナイフ、伸縮警棒、電撃器は普段持っていて発見されても処罰されます。第9節第26項（護身のために伸縮警棒・電撃器を買わない）を参照してください。"]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["自分のメモ"]},{"tag":"button","props":{"type":"button"},"children":["自分へのメモを書く…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/ja/tip/08-09"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["前へ"]},"年に2回、無料で自分の信用報告書をチェックし、身に覚えのないローンやカードがないか確認する"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/ja/tip/08-11"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["次へ"]},"避けられない侵害に対しては反撃可能だが、現在手を出し続けている人物に対してのみ行うこと。相手が止まれば、あなたも止めること"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag