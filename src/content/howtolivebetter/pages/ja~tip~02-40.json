ls"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["費用・手間"]},{"tag":"p","props":{},"children":["購入場所を変えるだけで、費用はほぼ変わりません。パッケージに「SC」で始まる食品生産許可番号があるかを確認するだけです。難しいのは、手作り油を買う習慣がある年配の家族を説得することです。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["効果"]},{"tag":"p","props":{},"children":["アフラトキシンは、国際がん研究機関（IARC）によって 1 級の（発がん性が確定している）発がん性物質に分類されており、主に肝がんを引き起こします。広州で行われたある研究では、2010 年から 2022 年間の小規模工房で圧搾されたピーナッツ油に含まれるアフラトキシンB1 を測定しました。中央値は 1.29 μg/kg で、サンプルの半数は 0.12 から 6.58 の間にありました。現地の小規模工房管理条例の施行後、油中の毒素は直ちに 2.865 μg/kg 減少し、その後も毎年 2.593 ずつ減少しました。自家圧搾油を日常的に摂取する地域の住民における肝機能異常の割合もそれに伴い低下しました（PR 0.650、95% CI 0.469–0.902、信頼区間）、約 35% 低下しました。広西で行われた 1611 名の妊婦を対象とした追跡調査では、81.7% 自製ピーナッツオイルを摂取。摂取した人の場合、低出生体重児のリスクが約9割高く（aOR 1.9、1.1–3.2）、早産の可能性は約8割高くなります（aOR 1.8、1.1–3.0）。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["出典"]},{"tag":"p","props":{"className":"life-citations"},"children":["Lei J, Li Y, Wang Y, 等 (2024). The impact of small food workshops management regulations on aflatoxin B1 in home-made peanut oil and the liver function of high-consumption area residents: an interrupted time series study in Guangzhou, China. Frontiers in Public Health, 12. ",{"tag":"a","props":{"href":"https://doi.org/10.3389/fpubh.2024.1484414","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.3389/fpubh.2024.1484414"]},"；Zhong Y, Lu H, Jiang Y, 等 (2024). Effect of homemade peanut oil consumption during pregnancy on low birth weight and preterm birth outcomes: a cohort study in Southwestern China. Global Health Action, 17. ",{"tag":"a","props":{"href":"https://doi.org/10.1080/16549716.2024.2336312","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1080/16549716.2024.2336312"]},"；IARC (2012). Chemical Agents and Related Occupations. IARC Monographs on the Evaluation of Carcinogenic Risks to Humans, Vol 100F. ",{"tag":"a","props":{"href":"https://publications.iarc.fr/123","target":"_blank","rel":"noopener noreferrer"},"children":["https://publications.iarc.fr/123"]},"；国家卫生计生委、国家食品药品监督管理总局 (2017). 食品安全国家标准 食品中真菌毒素限量（GB 2761-2017）"]},{"tag":"a","props":{"href":"https://doi.org/10.3389/fpubh.2024.1484414","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["出典を開く"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["著者の注記"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["両方の研究とも、追跡記録のみであり、対照群を用いたグループ分けは行われていません。広州の研究の終着点は肝機能検査の結果であり、肝がんや死亡率ではありません。手作り油に含まれる毒素の中央値は、実は国の基準であるピーナッツ油の制限値 20 μg/kg よりも低く、リスクは長年の摂取や、個別の高濃度ロットに起因します。国の制限値はすべてのピーナッツ油に適用されますが、包装済み油は生産許可と出荷検査を通過しています。一方、小規模な業者は各省の管理規定に従っていますが、抜き取り検査の頻度ははるかに低くなります。本条の主な受益者は、あなた自身と、一緒に食事をする家族です。"]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["自分のメモ"]},{"tag":"button","props":{"type":"button"},"children":["自分へのメモを書く…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/ja/tip/02-39"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["前へ"]},"夜勤の期間が長いほど心血管リスクは高まる。配置転換ができるなら早めに検討を"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/ja/tip/02-41"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["次へ"]},"料理にラードやバターの代わりに植物油を使用：健康のために油を使い分ける必要はなく、亜麻仁油に心臓保護を期待しても意味がない"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["このテーマの他の提案"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/02-36"},"children":[{"tag":"strong","props":{},"children":["条件が許すなら入浴を、シャワーだけで済ませない"]},{"tag":"span","props":{},"children":["ほぼ毎日入浴する人は、週に2回未満の人に比べて、心血管イベントのリスクが約 28% 低く、脳出血のリスクが約 46% 低くなります。"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/02-37"},"children":[{"tag":"strong","props":{},"children":["昼寝は30分以内に抑えること。1時間を超えないように。1〜2時間寝ないと持ちこたえられない場合は原因を調べること"]},{"tag":"span","props":{},"children":["昼寝が1時間を超えない人は、死亡および慢性疾患のリスクは上昇せず、脳の覚醒度もより高まります。1時間を超える睡眠をとる人は、冠動脈疾患のリ…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/02-38"},"children":[{"tag":"strong","props":{},"children":["徹夜明けの翌晩には睡眠を補うこと。週末まで溜め込まない"]},{"tag":"span","props":{},"children":["睡眠不足の翌晩に睡眠を補えなかった人は、規則正しい生活の人に比べて死亡リスクが約 15% 高く、大幅に睡眠不足な上、補えなかった人のリスク…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/02-42"},"children":[{"tag":"strong","props":{},"children":["炒め物や揚げ物の際は換気扇を回すこと。火をつけた瞬間から料理が終わるまで。"]},{"tag":"span","props":{},"children":["非喫煙者の中国人女性において、調理中に換気扇を回さない、あるいは回す頻度が極めて低い場合、肺がんのリスクは常時回している場合の約2倍になり…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/02-43"},"children":[{"tag":"strong","props":{},"children":["閉経前後のほてりや寝汗が生活に支障をきたすなら、婦人科でホルモン療法の評価を受ける。我慢せず、自己判断で薬を買わず、心臓病予防にも使わない"]},{"tag":"span","props":{},"children":["閉経前後のほてりや寝汗にホルモン療法を使うと、ほてりの回数はプラセボより約75%少なくなります。一方で、乳がん、血栓、脳卒中は少し増え、そ…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/02-44"},"children":[{"tag":"strong","props":{},"children":["もともと犬を飼いたい人は毎日の散歩を歩行量に含める。長生きだけを目的に飼わない"]},{"tag":"span","props":{},"children":["犬を飼う人は同じ期間に死亡する確率が平均約4分の1低く、心筋梗塞や脳卒中後では差がさらに大きい研究があります。ただし他の違いを調整すると、…"]}]}]}]},{"tag":"a","props":{"className":"life-text-link","href":"/ja/book/02"},"children":["テーマ全体を読む：ゆっくり死なないために"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"15","height":"15","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]}]}]},{"tag":"nav","props":{"className":"life-tabbar","aria-label":"メインナビゲーション"},"children":[{"tag":"a","props":{"className":"","href":"/ja/book"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"21","height":"21","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-book-open","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M12 7v14"},"children":[]},{"tag":"path","props":{"d":