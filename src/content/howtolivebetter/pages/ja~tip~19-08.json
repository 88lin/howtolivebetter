:"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"詳細を閉じる"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["費用・手間"]},{"tag":"p","props":{},"children":["費用はかかりません。30分ほど使って資料を保存するだけです。難しいのは、退職前に保存することを忘れないことです。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["効果"]},{"tag":"p","props":{},"children":["パソコンとアカウントを返すと資料は取り出せなくなります。中国の労働紛争は「主張する者が立証」し、会社が保有する証拠は会社が出さなければ不利益を負います。本人が入手できない会社の資料は仲裁廷が期限内提出を求められます。懲戒解雇、解雇、契約解除、賃金減額、勤続年数の争いは会社が立証します。残業代は違い、まず実際に残業したことを本人が示します。残業記録が会社にあると証明でき、会社が出さない場合に初めて会社が不利益を負います。賃金支払い記録の保存義務は2年以上だけです。給与支払い時には個人の給与明細も交付します。書面契約がなくても給与記録、社会保険納付記録、社員証、採用登録票、勤怠、同僚の証言で労働関係を証明できます。チャットは電子データで証拠に使え、原本を提出します。原記録から直接印刷したものも原本とされます。上海の検察院の事件では労働者が10年分の最低賃金差額を請求しましたが、一審・二審は退職前の2年だけ認めました。会社の保存義務が2年のため前8年は本人が立証するという理由でした。本人は10年分の明細と銀行取引記録を持っていましたが会社が明細の真正を否認しました。2024年8月に検察監督を申請し、検察院の抗訴後、会社は調停により1.9万元を追加で支払いました。提訴は2021年の人員整理時で、監督申請まで約3年かかりました（中国全国）。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["出典"]},{"tag":"p","props":{"className":"life-citations"},"children":["全国人大常委会 (2007). 劳动争议调解仲裁法（第六、三十九条）. ",{"tag":"a","props":{"href":"https://rsj.ankang.gov.cn/Content-2150407.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://rsj.ankang.gov.cn/Content-2150407.html"]},"（安康市人力资源和社会保障局转载）；最高人民法院 (2020). 关于审理劳动争议案件适用法律问题的解释（一）（法释〔2020〕26 号，第四十二、四十四条）. ",{"tag":"a","props":{"href":"https://www.court.gov.cn/fabu/xiangqing/282121.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.court.gov.cn/fabu/xiangqing/282121.html"]},"；最高人民法院 (2019). 关于民事诉讼证据的若干规定（法释〔2019〕19 号，第十四、十五条）. ",{"tag":"a","props":{"href":"https://www.court.gov.cn/zixun/xiangqing/212721.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.court.gov.cn/zixun/xiangqing/212721.html"]},"；劳动部 (1994). 工资支付暂行规定（第六条），黑龙江省人民政府「政策帮你问」引述. ",{"tag":"a","props":{"href":"https://www.hlj.gov.cn/hlj/c116413/202402/c00_31712524.shtml","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.hlj.gov.cn/hlj/c116413/202402/c00_31712524.shtml"]},"；劳动和社会保障部 (2005). 关于确立劳动关系有关事项的通知（劳社部发〔2005〕12 号），黑龙江省人民政府「政策帮你问」引述. ",{"tag":"a","props":{"href":"https://hlj.gov.cn/hlj/c116413/202408/c00_31757488.shtml","target":"_blank","rel":"noopener noreferrer"},"children":["https://hlj.gov.cn/hlj/c116413/202408/c00_31757488.shtml"]},"；郭勇辉, 边琬茹 (2025). 两年之外的工资支付情况举证责任应由谁承担？检察日报. ",{"tag":"a","props":{"href":"https://www.spp.gov.cn/spp/llyj/202508/t20250806_703164.shtml","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.spp.gov.cn/spp/llyj/202508/t20250806_703164.shtml"]},"（最高人民检察院网站刊载）；维权路径见第 7 节"]},{"tag":"a","props":{"href":"https://rsj.ankang.gov.cn/Content-2150407.html","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["出典を開く"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["著者の注記"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["保管するのは自分の労働関係の資料です。会社のソースコード、顧客名簿、技術文書まで持ち出さないでください。リスクは第11節を参照。チャットは画面写真だけにせず、携帯の原記録を削除しないでください。給与明細と銀行明細は毎月保存するのがよく、退職から何年も経つと会社には2年前より古い記録の保存義務がありません。上海の事件は検察院の抗訴で覆りましたが、多くの人がそこまで進めるわけではありません。退職時には離職証明も求めてください。本節第17条を参照してください。"]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["自分のメモ"]},{"tag":"button","props":{"type":"button"},"children":["自分へのメモを書く…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/ja/tip/19-07"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["前へ"]},"「自己都合による自主退職」にはサインしないでください。一度サインしてしまうと、解雇予告手当（N）がもらえなくなります"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/ja/tip/19-09"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["次へ"]},"粉塵、騒音、化学物質を扱う業務に就く前に、契約書に危害に関する記載があるか確認しましょう。3回の職業健康診断は会社が手配し、費用を負担します"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["このテーマの他の提案"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/19-04"},"children":[{"tag":"strong","props":{},"children":["解雇時のN（経済補償金）の計算方法：勤続1年につき1ヶ月分の給与、6ヶ月未満は半月分"]},{"tag":"span","props":{},"children":["解雇時に会社が支払うべき経済補償金の計算方法は以下の通りです：勤続1年につき1ヶ月分の給与を支払い、6ヶ月以上1年未満の場合は1年として計…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/19-05"},"children":[{"tag":"strong","props":{},"children":["会社が 30 日前に通知せず解雇する場合、さらに1ヶ月分の給与を支払う必要がある"]},{"tag":"span","props":{},"children":["会社が、病気による就業不能、業務遂行不能、または状況の重大な変化を理由にあなたを解雇する場合、30日前の書面による通知を行わないのであれば…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/19-06"},"children":[{"tag":"strong","props":{},"children":["不当解雇（違法解雇）の場合、賠償金は経済補償金基準の2倍となる"]},{"tag":"span","props":{},"children":["会社による解雇が不当解雇（違法解除）に該当する場合、賠償金は経済補償金の基準の2倍、つまり一般に言われる「2N」となります。不当解雇に該当…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/19-10"},"children":[{"tag":"strong","props":{},"children":["粉塵、騒音、化学毒物による損傷は不可逆：防護具は会社が提供しなければならず、防護措置のない作業は拒否できる"]},{"tag":"span","props":{},"children":["じん肺、騒音性難聴、化学的な眼部灼傷はすべて法定の職業病であり、肺や聴力が損なわれると元に戻りません。あなたには、当該業務にどのような危害…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/19-11"},"children":[{"tag":"strong","props":{},"children":["仕事中の負傷や通勤中の交通事故、まず最初に行うべきは労災認定。会社が申請しない場合は自分で申請できる"]},{"tag":"span","props":{},"children":["仕事中の負傷は労災に当たります。通勤中の交通事故でも、あなたに主な責任がない場合は労災とみなされます。しかし、労災認定を行わなければ、医療…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/19-12"},"children":[{"tag":"strong","props":{},"children":["「出勤した時点で労災」を信じないで：急な体調不良時は、まず 120 へ。打刻のために急いで向かうのではなく。"]},{"tag":"span","props":{},"children":["急な体調不良のまま会社へ急いでも、手当が増えるわけではありません。労災とみなされるには、勤務時間内かつ勤務場所内での発症が条件であり、移動…"]}]}]}]},{"tag":"a","props":{"className":"life-text-link","href":"/ja/book/19"},"children":["テーマ全体を読む：在職、離職、および労災"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"15","height":"15","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]}]}]}]},{"tag":"aside","props":{"className":"life-ad-space life-ad-space-sponsored","data-ad-placement":"ad_footer","data-ad-group":"reading","data-ad-creative":"read_product","data-ad-ready":"false","aria-label":"広告 · コミュニティ紹介"},"children":[{"tag":"div","props":{"className":"life-ad-space-brand"},"children":[{"tag":"img","props":{"src":"/sites/howtolivebetter/images/shengcai/logo.png","width":"565","height":"144","alt":"生財有術の公式ロゴ","decoding":"async"},"children":[]}]},{"tag":"div","props":{"className":"life-ad-space-copy"},"children":[{"tag":"span","props":{"className":"life-ad-space-label"},"children":["広告 · コミュニティ紹介"]},{"tag":"strong","props":{},"children":["学んだ知識は、役立つ製品になる？"]},{"tag":"p","props":{},"children":["電子書籍や小さなツール。需要を見つけ、知識を使える形にする参加者の実践を紹介します。"]}]},{"tag":"div","props":{"className":"life-ad-space-actions"},"children":[{"tag":"a","props":{"className":"life-ad-space-link","href":"/ja/shengcaiyoushu?sc_group=reading&sc_creative=read_product&sc_placement=ad_footer"},"children":["コミュニティと事例を見る",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"18","height":"18","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-up-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M7 7h10v10"},"children":[]