me":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Share this tip"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Hide details"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Cost"]},{"tag":"p","props":{},"children":["No monetary cost. The real challenge is overcoming the habit of “just one more episode.” The easiest solution is to keep phones out of the bedroom."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Benefit"]},{"tag":"p","props":{},"children":["In 2025, Chinese residents averaged 6.97 hours of nighttime sleep, with an average bedtime of 12:10 a.m. (Chinese Sleep Research Society). Compared to people who did not use portable devices before bed, those who did were 2.17 times more likely to get insufficient sleep (OR 2.17), 1.46 times more likely to suffer poor sleep quality (OR 1.46), and 2.72 times more likely to feel daytime drowsiness (OR 2.72). Even merely having devices in the bedroom without use yielded similar odds: 1.79, 1.53, and 2.27 respectively (OR 1.79/1.53/2.27). These figures come from a combined analysis of 20 concurrent surveys involving 125,198 children and adolescents. Another concurrent study of 844 adults aged 18–94 found that those who used phones after turning off the lights took longer to fall asleep, spent less time actually asleep in bed, and felt more fatigued during the day."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Original sources"]},{"tag":"p","props":{"className":"life-citations"},"children":["Carter et al. (2016). Association Between Portable Screen-Based Media Device Access or Use and Sleep Outcomes. JAMA Pediatrics. ",{"tag":"a","props":{"href":"https://doi.org/10.1001/jamapediatrics.2016.2341","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1001/jamapediatrics.2016.2341"]},"；Exelmans & Van den Bulck (2016). Bedtime mobile phone use and sleep in adults. Social Science & Medicine. ",{"tag":"a","props":{"href":"https://doi.org/10.1016/j.socscimed.2015.11.037","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1016/j.socscimed.2015.11.037"]},"；中国睡眠研究会 (2026). 2026 中国睡眠健康研究白皮书（福建省卫健委转载健康报报道）. ",{"tag":"a","props":{"href":"https://wjw.fujian.gov.cn/jggk/csxx/xcc/mtbd/202603/t20260323_7114382.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://wjw.fujian.gov.cn/jggk/csxx/xcc/mtbd/202603/t20260323_7114382.htm"]},"；Grubbs JB 等 (2018). Pornography Problems Due to Moral Incongruence: An Integrative Model with a Systematic Review and Meta-Analysis. Archives of Sexual Behavior. ",{"tag":"a","props":{"href":"https://doi.org/10.1007/s10508-018-1248-x","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1007/s10508-018-1248-x"]},"（备注里的争议方之一）；Prause N, Pfaus J (2015). Viewing Sexual Stimuli Associated with Greater Sexual Responsiveness, Not Erectile Dysfunction. Sexual Medicine. ",{"tag":"a","props":{"href":"https://doi.org/10.1002/sm2.58","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1002/sm2.58"]},"（备注里的争议方之二）"]},{"tag":"a","props":{"href":"https://doi.org/10.1001/jamapediatrics.2016.2341","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Open source link"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Book note"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["Controversial. The costs of staying up late itself can be found in item 3 of this section (getting 7 to 8 hours of sleep per night). Regarding the impact of pornographic content on the energy and mental capacity of ordinary people, there is currently no reliable evidence to clarify whether it is the cause. An analysis summarizing multiple studies suggests that so-called \"pornography problems\" stem more from a discrepancy between an individual's beliefs and their own behavior, rather than the content itself. Another study aggregated data from 280 men. The result showed no relationship between viewing duration and erectile function during sexual activity with a partner. This item specifically addresses its displacement of sleep time. Regarding the two figures, 6.97 hours and 0:10, the official website of the China Sleep Research Society has not posted a release (checked in 9 month, 2026 year); please refer to the Health News report reposted by the Fujian Provincial Health Commission."]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["My note"]},{"tag":"button","props":{"type":"button"},"children":["Write a reminder for yourself…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/en/tip/03-08"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Previous"]},"Avoid glowing screens one hour before bed; if you must, read paper books or e-ink devices instead"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/en/tip/03-10"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Next"]},"Don’t make major decisions or send important messages late at night"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"