hildren":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Chia sẻ mẹo này"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Ẩn chi tiết"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Chi phí"]},{"tag":"p","props":{},"children":["Phí luật sư vài nghìn tới vài chục nghìn tệ, do bạn tự trả. Bản án sơ thẩm theo thủ tục thông thường kéo dài từ 6 tháng, có thể kéo dài hơn. Bằng chứng bạn phải tự giữ."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Lợi ích"]},{"tag":"p","props":{},"children":["Điều ba của Luật Bảo đảm người khuyết tật:「禁止基于残疾的歧视。禁止侮辱、侵害残疾人。」— cấm phân biệt đối xử dựa trên khuyết tật; cấm xúc phạm, xâm phạm người khuyết tật. Điều ba mươi tám:「在职工的招用、转正、晋级、职称评定、劳动报酬、生活福利、休息休假、社会保险等方面，不得歧视残疾人。」— trong việc tuyển dụng, chuyển biên chế, thăng chức, xếp chức danh, lương lao động, phúc lợi sinh hoạt, nghỉ ngơi, bảo hiểm xã hội cho công nhân viên, không được phân biệt đối xử với người khuyết tật. Cùng điều đó còn quy định, đơn vị có công nhân viên khuyết tật phải căn cứ đặc điểm của họ để cung cấp điều kiện lao động và bảo vệ lao động thích hợp, và tuỳ nhu cầu thực tế để cải tạo nơi làm việc, thiết bị lao động và cơ sở sinh hoạt. Điều sáu mươi tư:「违反本法规定，在职工的招用等方面歧视残疾人的，由有关主管部门责令改正；残疾人劳动者可以依法向人民法院提起诉讼。」— vi phạm luật này mà phân biệt đối xử với người khuyết tật trong việc tuyển dụng công nhân viên và các mặt khác, thì bị cơ quan chủ quản có liên quan buộc phải sửa chữa; người lao động khuyết tật có thể kiện Tòa án nhân dân theo pháp luật. Điều bốn của Quy định về việc làm của người khuyết tật:「禁止在就业中歧视残疾人。」— cấm phân biệt đối xử với người khuyết tật trong việc làm. Điều mười ba của quy định đó quy định, đơn vị sử dụng lao động không được phân biệt đối xử với công nhân viên khuyết tật trong việc thăng chức, thăng cấp, xếp chức danh, lương, bảo hiểm xã hội, phúc lợi sinh hoạt. Điều bốn mươi hai của Luật Trợ giúp pháp lý quy định, người nộp đơn có giấy tờ chứng minh thuộc「无固定生活来源的未成年人、老年人、残疾人等特定群体」thì được miễn kiểm tra tình trạng khó khăn về tài chính. Điều bốn mươi lăm quy định, cơ sở trợ giúp pháp lý có cung cấp dịch vụ trợ giúp pháp lý cho người cao tuổi, người khuyết tật thì phải theo tình hình thực tế mà cung cấp thiết bị và dịch vụ không vướng (toàn quốc)"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Nguồn gốc"]},{"tag":"p","props":{"className":"life-citations"},"children":["中华人民共和国残疾人保障法（第三条、第三十八条、第六十四条）. ",{"tag":"a","props":{"href":"https://flk.npc.gov.cn/detail?id=ff8080816f135f46016f1d134c88132b","target":"_blank","rel":"noopener noreferrer"},"children":["https://flk.npc.gov.cn/detail?id=ff8080816f135f46016f1d134c88132b"]},"；国务院 (2007). 残疾人就业条例（第四条、第十三条）. ",{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/2008-03/28/content_6646.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/zhengce/zhengceku/2008-03/28/content_6646.htm"]},"；中华人民共和国法律援助法（第四十二条、第四十五条）. ",{"tag":"a","props":{"href":"https://flk.npc.gov.cn/detail?id=ff8081817b6472a3017b6577820f0061","target":"_blank","rel":"noopener noreferrer"},"children":["https://flk.npc.gov.cn/detail?id=ff8081817b6472a3017b6577820f0061"]}]},{"tag":"a","props":{"href":"https://flk.npc.gov.cn/detail?id=ff8080816f135f46016f1d134c88132b","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Liên kết mở nguồn"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Ghi chú sách"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["Chi phí trong quá trình phải tính trước. Bản án sơ thẩm theo thủ tục thông thường kéo dài từ 6 tháng, có thể kéo dài hơn; thủ tục giản lược là 3 tháng. Phí luật sư không nằm trong các khoản phí tụng mà điều sáu của Biện pháp quản lý việc nộp phí tụng liệt kê; câu「bên thua kiện chịu phí」trong điều hai mươi chín không gồm phí luật sư. Vì vậy hãy đi trước hai đường rẻ tiền: khiếu nại với cơ quan nhân sự và xã hội hoặc hội người khuyết tật, để cơ quan chủ quản buộc phải sửa chữa; đồng thời xin trợ giúp pháp lý, điều bốn mươi hai miễn kiểm tra tình trạng khó khăn tài chính cho người khuyết tật. Thu thập chứng cứ là khó nhất. Khi bị từ chối phỏng vấn, phía bên kia hiếm khi để lại lý do bằng văn bản, ghi âm được, giữ lại được lịch sử trò chuyện thì cứ giữ. Đã đi làm rồi thì đi theo hoà giải lao động vì tranh chấp lao động, cách giữ chứng cứ và thời hiệu xem mục 8 ở phần 19 (giữ chứng cứ trước khi nghỉ việc). Người hưởng mục này là bạn."]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Ghi chú của tôi"]},{"tag":"button","props":{"type":"button"},"children":["Viết một lời nhắc cho chính bạn…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/vi/tip/33-19"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Trước"]},"Người giám hộ của người thành niên được xác định theo thứ tự luật định; người được giám hộ gây hại cho người khác thì người giám hộ bồi thường"]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["Thêm trong chủ đề này"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/33-13"},"children":[{"tag":"strong","props":{},"children":["Thí sinh khuyết tật dự kỳ thi tuyển sinh đại học có thể xin biện pháp hỗ trợ hợp lý, dùng đề braille thì kéo dài thời gian thi thêm một nửa"]},{"tag":"span","props":{},"children":["Thí sinh khuyết tật dự kỳ thi tuyển sinh đại học có thể xin đề braill…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/33-14"},"children":[{"tag":"strong","props":{},"children":["Trẻ khuyết tật xin nhập học, nhà trường không được từ chối; trẻ không đến được trường thì phòng giáo dục sắp xếp giảng viên đến tận nhà"]},{"tag":"span","props":{},"children":["Trường mầm non và mọi loại trường không được từ chối trẻ khuyết tật đ…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/33-15"},"children":[{"tag":"strong","props":{},"children":["Mất hoặc không cử động được hai chi dưới bên phải vẫn thi được giấy phép lái xe, loại xe được phép lái gọi là C5"]},{"tag":"span","props":{},"children":["Người mất hoặc không cử động được chi dưới bên phải hoặc cả hai chi d…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/33-16"},"children":[{"tag":"strong","props":{},"children":["Phục hồi chức năng làm ở cơ sở chính quy có khoa phục hồi chức năng, cường độ nghe người trị liệu, tập càng nặng càng không tốt"]},{"tag":"span","props":{},"children":["Đưa người bệnh về nhà nằm chờ tự hồi phục là sai lầm thường gặp nhất.…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/33-17"},"children":[{"tag":"strong","props":{},"children":["Nghe kém thì đi lắp máy trợ thính, lý do lắp là để nghe rõ, không phải để phòng chứng mất trí nhớ"]},{"tag":"span","props":{},"children":["Câu「đeo máy trợ thính phòng chứng mất trí nhớ」hiện chưa đứng vững. Mộ…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/33-18"},"children":[{"tag":"strong","props":{},"children":["Nói một người thành niên「không quản lý được việc của mình」thì phải xin tòa án công nhận, người nhà nói không tính"]},{"tag":"span","props":{},"children":["Một người thành niên có「không có năng lực hành vi dân sự」hay「có năng …"]}]}]}]},{"tag":"a","props":{"className":"life-text-link","href":"/vi/book/33"},"children":["Đọc toàn bộ chủ đề: Sống sau khi bị khuyết tật"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"15","height":"15","viewBox":"0 0 24 24","fill":"non