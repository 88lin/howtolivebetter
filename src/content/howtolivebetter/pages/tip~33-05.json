n":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"收起详情"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["成本"]},{"tag":"p","props":{"className":"life-citations"},"children":["一个减压坐垫几百元到上千元。每天看一遍，一分钟。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["收益"]},{"tag":"p","props":{"className":"life-citations"},"children":["这项随机临床试验在 12 家养老院做，2004 到 2008 年招募 232 名 65 岁以上、每天坐轮椅 6 小时以上、Braden 评分 18 分以下的住户。所有人先配了合身的轮椅，再随机分成两组。一组用皮肤保护型坐垫（空气、黏性流体加泡沫、或者凝胶加泡沫），一组用 7.6 厘米厚的分段式泡沫坐垫。随访 6 个月或者到发生压疮为止。坐骨结节部位的压疮，分段泡沫组 8 例（6.7%），皮肤保护型坐垫组 1 例（0.9%），P=0.04。把坐骨和骶尾部的压疮合起来算，分段泡沫组 21 例（17.6%），皮肤保护型坐垫组 12 例（10.6%），P=0.14，没有做出差别"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["来源"]},{"tag":"p","props":{"className":"life-citations"},"children":["Brienza D, Kelsey S, Karg P, et al. (2010). A randomized clinical trial on preventing pressure ulcers with wheelchair seat cushions. Journal of the American Geriatrics Society, 58(12):2308-2314. ",{"tag":"a","props":{"href":"https://doi.org/10.1111/j.1532-5415.2010.03168.x","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1111/j.1532-5415.2010.03168.x"]},""]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["原书备注"]},{"tag":"p","props":{"className":"life-citations"},"children":["定 B 的原因有两条。第一，样本只有 232 人，主要终点的 P 值 0.04 刚过线，次要终点没有做出差别。第二，人群是养老院里的高龄住户，套到年轻的轮椅使用者身上属于往外推。试验里所有人都先配了合身的轮椅，所以「合身」和「坐垫」是一起起作用的，别只换坐垫。长期卧床的压疮防护，气垫床和定时翻身，见第 17 节第 8 条（压疮）。基本型辅助器具的配置补贴怎么申请，见本节第 7 条（去县级残联问全）。"]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["我的备注"]},{"tag":"button","props":{"type":"button"},"children":["写下对自己有用的提醒…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/tip/33-04"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["上一条"]},"长期照护家里残疾人的那个人，自己的身体要有人盯着"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/tip/33-06"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["下一条"]},"别买「能治好瘫痪、失明、耳聋」的疗法和器械"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["本主题的其他建议"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/33-01"},"children":[{"tag":"strong","props":{},"children":["脊髓损伤之后突然剧烈头痛、出汗，先扶坐直、松开衣物，同时叫 120"]},{"tag":"span","props":{},"children":["脊髓损伤的人，身体的报警线路断了一截。膀胱憋着、衣服勒着，本人可能没感觉，血压却会猛往上冲。信号是突然剧烈头痛和出汗。这时先把人扶坐直、松开勒紧的衣物、看是不是…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/33-02"},"children":[{"tag":"strong","props":{},"children":["脊髓损伤致残之后的头十年是自杀的高风险期，别当成「想开点」就行的事"]},{"tag":"span","props":{},"children":["英国两家脊髓损伤中心的长期随访发现，这群人的自杀率是普通人的五倍。九成以上的自杀发生在受伤后的头十年。受伤原因本身就是自杀的人，风险还要高出一截。"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/33-03"},"children":[{"tag":"strong","props":{},"children":["精神障碍住院以自愿为原则，只有两种情形可以不经本人同意"]},{"tag":"span","props":{},"children":["家属或单位一句话，不能把一个人留在精神病院住院。法律只认两种情况，而且要先诊断为严重精神障碍：伤了自己或有这个危险，危害了别人或有这个危险。第一种要监护人同意才…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/33-07"},"children":[{"tag":"strong","props":{},"children":["残疾人证办下来之后，去县级残联把能申请的东西一次问全"]},{"tag":"span","props":{},"children":["残疾人证本身不发钱，它是一把钥匙。接在它后面的是好几笔各自独立的待遇，每一笔都要自己去申请，不会自动上门。第一次去残联，就把清单上的项目一项项问过来，比来回跑几…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/33-08"},"children":[{"tag":"strong","props":{},"children":["孩子不满 7 岁又有残疾或者孤独症的，去县级残联申请康复救助"]},{"tag":"span","props":{},"children":["国家给 0 到 6 岁的残疾儿童和孤独症儿童建了一套康复救助制度，管手术、辅助器具和康复训练。救助对象先保困难家庭，地方财力允许的可以放宽年龄和家庭经济条件。救…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/33-09"},"children":[{"tag":"strong","props":{},"children":["家里的坡道、扶手和浴室改造，可以向县级以上政府申请补贴"]},{"tag":"span","props":{},"children":["《无障碍环境建设法》写了一条：县级以上政府应当支持、指导家庭无障碍设施改造。对符合条件的残疾人、老年人家庭，应当给予适当补贴。补多少、改哪几项由各地定，先去当地…"]}]}]}]},{"tag":"a","props":{"className":"life-text-link","href":"/book/33"},"children":["阅读整个主题：残疾之后怎么活 ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"1