国際免許証」の多くは無効な紙切れです"]},{"tag":"a","props":{"href":"/ja/tip/21-09"},"children":[{"tag":"span","props":{},"children":["09"]},"ビザ申請、留学、移住のエージェントを探すなら、まず移民管理機関に登録されているか確認しましょう"]},{"tag":"a","props":{"href":"/ja/tip/21-10"},"children":[{"tag":"span","props":{},"children":["10"]},"見知らぬ人のために招待状を作成したり、自分の名義で出入国手続きを行わせたりしないでください"]},{"tag":"a","props":{"href":"/ja/tip/21-11"},"children":[{"tag":"span","props":{},"children":["11"]},"出国前に、旅程、宿泊先、同行者を家族の一人に送り、どのくらいの頻度で連絡するか決めておく"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"現在地"},"children":[{"tag":"a","props":{"href":"/ja/book"},"children":["本を読む"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/ja/book/21"},"children":["第21章"," ·"," ","海外渡航、旅行と国外での安全"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"21-06"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["06"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["エビデンス"," ","A"]}]},{"tag":"h1","props":{"lang":"ja"},"children":["海外での現金引き出しは、年間 10 万人民元を超えてはなりません。これはご本人名義のすべてのカードの合計として計算されます"]},{"tag":"p","props":{"lang":"ja","className":"life-entry-summary"},"children":["海外での現金引き出し限度額は、カード1枚ごとではなく、ご本人名義のすべての銀行カード（付帯カードも含む）の合計で、各暦年につき 10 万人民元までです。上限に達した場合、その年の残りの期間および翌年は海外での現金引き出しができなくなります。停止されるのは現金引き出しのみであり、カード決済による支払いは影響を受けず、毎年の 5 万ドルの外貨購入枠も消費しません。"]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["費用・手間"]},{"tag":"p","props":{},"children":["費用はかかりません。出発前に今回の旅行でいくら現金が必要か見積もり、残りはカード決済を利用しましょう。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["効果"]},{"tag":"p","props":{},"children":["根拠は、国家外貨管理局の「銀行カードによる海外での多額の現金引き出し取引の規範化に関する通知」（汇发〔2017〕29 号、2018 年 1 月 1 日より施行）。"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"記録する：海外での現金引き出しは、年間 10 万人民元を超えてはなりません。これはご本人名義のすべてのカードの合計として計算されます"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"できている"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"やることに追加"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"お気に入り"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":