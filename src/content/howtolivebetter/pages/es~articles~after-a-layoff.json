6 6 0 0 0-12 0"},"children":[]},{"tag":"circle","props":{"cx":"12","cy":"10","r":"4"},"children":[]},{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},{"tag":"span","props":{},"children":["Iniciar sesión"]}]}]}]},{"tag":"main","props":{"className":"life-longread"},"children":[{"tag":"a","props":{"className":"life-back-link active","href":"/es/articles","data-status":"active","aria-current":"page"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"Todos los artículos"]},{"tag":"header","props":{"className":"life-longread-header"},"children":[{"tag":"div","props":{},"children":[{"tag":"div","props":{"className":"life-eyebrow"},"children":["Artículos"]},{"tag":"h1","props":{"lang":"es"},"children":["Qué hacer primero tras un despido"]},{"tag":"p","props":{"lang":"es"},"children":["Tras un despido o una rescisión, lo que hay que tramitar está repartido entre la sección 19, la sección 7 y otras. Abajo va ordenado en el tiempo. Cada paso dice solo qué hacer; ci…"]},{"tag":"a","props":{"className":"life-longread-chapter","href":"/es/book/19"},"children":["Capítulo relacionado"," · ","Empleo, salida del empleo y accidentes de trabajo",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"img","props":{"src":"/sites/howtolivebetter/images/book-chapters/19-work-rights-editorial.webp","srcSet":"/sites/howtolivebetter/images/book-chapters/19-work-rights-editorial-thumb.webp 600w, /sites/howtolivebetter/images/book-chapters/19-work-rights-editorial-md.webp 900w, /sites/howtolivebetter/images/book-chapters/19-work-rights-editorial.webp 1200w","sizes":"(max-width: 760px) 100vw, 450px","alt":"","width":"1200","height":"800","fetchPriority":"high"},"children":[]}]},{"tag":"div","props":{"className":"life-longread-layout"},"children":[{"tag":"aside","props":{"className":"life-longread-toc"},"children":[{"tag":"details","props":{"open":true},"children":[{"tag":"summary","props":{},"children":["En esta página"]},{"tag":"nav","props":{"aria-label":"En esta página"},"children":[{"tag":"a","props":{"href":"#el-mismo-día-antes-de-firmar-nada"},"children":["El mismo día: antes de firmar nada"]},{"tag":"a","props":{"href":"#ese-día-y-los-primeros-días-cerrar-el-dinero"},"children":["Ese día y los primeros días: cerrar el dinero"]},{"tag":"a","props":{"href":"#la-primera-semana"},"children":["La primera semana"]},{"tag":"a","props":{"href":"#el-primer-mes"},"children":["El primer mes"]},{"tag":"a","props":{"href":"#los-meses-siguientes"},"children":["Los meses siguientes"]}]}]}]},{"tag":"div","props":{"className":"life-longread-main"},"children":[{"tag":"article","props":{"className":"life-article-body","lang":"es"},"children":[{"tag":"blockquote","props":{},"children":["\n",{"tag":"p","props":{},"children":["Traducción no oficial de ",{"tag":"a","props":{"href":"/articles/after-a-layoff"},"children":["docs/被裁了之后先做什么.md"]},". En caso de discrepancias, prevalece el original en chino."]},"\n"]},"\n",{"tag":"p","props":{},"children":[{"tag":"a","props":{"href":"https://github.com/dlgrv/HowToLiveBetter/blob/5a8aac6e715851066661ab6524c3a4e650f7e9d7/README.es.md","target":"_blank","rel":"noopener noreferrer"},"children":["← Volver al índice"]}]},"\n",{"tag":"p","props":{},"children":["Tras un despido o una rescisión, lo que hay que tramitar está repartido entre la ",{"tag":"a","props":{"href":"/es/book/19","title":"Empleo, salida del empleo y accidentes de trabajo"},"children":["sección 19"]},", la ",{"tag":"a","props":{"href":"/es/book/07","title":"Cómo vivir cuando no hay dinero"},"children":["sección 7"]}," y otras. Abajo va ordenado en el tiempo. Cada paso dice solo qué hacer; cifras, detalles y fuentes están en el punto citado entre paréntesis. Si solo le deben el salario y sigue empleado, vaya directo al ",{"tag":"a","props":{"href":"/es/book/07"},"children":["punto 2 de la sección 7"]}," (salarios atrasados: primero queja ante inspección laboral)."]},"\n",{"tag":"h2","props":{"id":"el-mismo-día-antes-de-firmar-nada"},"children":["El mismo día: antes de firmar nada"]},"\n",{"tag":"ol","props":{},"children":["\n",{"tag":"li","props":{},"children":["Si le entregan un formulario de «baja voluntaria por motivos personales», no lo firme. Si firma, suelen desaparecer la indemnización económica y la prestación por desempleo. Véase ",{"tag":"a","props":{"href":"/es/book/19"},"children":["sección 19, punto 7"]}," (no firmar «baja voluntaria por motivos personales»)."]},"\n",{"tag":"li","props":{},"children":["Si dicen «firme primero la salida y la indemnización aparte», exija que la compensación quede escrita en el acuerdo en el acto. Si no está escrita, no firme; negarse ese día no tiene consecuencia legal. Véase ",{"tag":"a","props":{"href":"/es/book/19"},"children":["sección 19, punto 7"]}," (no firmar «baja voluntaria por motivos personales»)."]},"\n",{"tag":"li","props":{},"children":["Encienda una grabadora en la conversación. En una charla a la que usted asiste, no hace falta consentimiento previo de la otra parte. Véase ",{"tag":"a","props":{"href":"/es/book/08"},"children":["sección 8, punto 41"]}," (empezar a grabar)."]},"\n",{"tag":"li","props":{},"children":["Antes de devolver el ordenador y las cuentas, guarde nóminas, registros de asistencia, contrato, historial de seguro social y chats. Véase ",{"tag":"a","props":{"href":"/es/book/19"},"children":["sección 19, punto 8"]}," (guardar pruebas antes de irse)."]},"\n",{"tag":"li","props":{},"children":["Guarde solo material suyo relacionado con el empleo. No se lleve código fuente, listas de clientes ni documentos técnicos de la empresa. Véase ",{"tag":"a","props":{"href":"/es/book/11"},"children":["sección 11, punto 7"]}," (no llevarse el código al irse)."]},"\n",{"tag":"li","props":{},"children":["Devuelva los accesos limpiamente: no borre datos ni cambie contraseñas, aunque la empresa le deba dinero. Véase ",{"tag":"a","props":{"href":"/es/book/11"},"children":["sección 11, punto 6"]}," (devolver accesos a cuentas)."]},"\n"]},"\n",{"tag":"h2","props":{"id":"ese-día-y-los-primeros-días-cerrar-el-dinero"},"children":["Ese día y los primeros días: cerrar el dinero"]},"\n",{"tag":"ol","props":{},"children":["\n",{"tag":"li","props":{},"children":["Calcule primero la N: un mes de salario por cada año completo de servicio; medio mes por periodos inferiores a seis meses. Véase ",{"tag":"a","props":{"href":"/es/book/19"},"children":["sección 19, punto 4"]}," (calcular la N tras un despido)."]},"\n",{"tag":"li","props":{},"children":["El salario mensual es la media de los 12 meses anteriores a la salida; primas, complementos y subsidios cuentan. Los empleadores suelen minimizarla. Véase ",{"tag":"a","props":{"href":"/es/book/19"},"children":["sección 19, punto 4"]}," (calcular la N tras un despido)."]},"\n",{"tag":"li","props":{},"children":["Primero pregunta en qué supuesto legal se basa la empresa para extinguir el contrato. Solo hay tres supuestos que dan derecho a un mes de salario adicional: no poder trabajar después de una enfermedad; no poder desempeñar el puesto incluso tras formación o un cambio de puesto; o un cambio importante de las circunstancias existentes al firmar el contrato, sin lograr un acuerdo. Si, en uno de esos tres supuestos, la empresa no te avisa por escrito con 30 días de antelación, además de N debe pagar otro mes de salario; durante la negociación, separa ese mes del resto. Los despidos por causas económicas y las extinciones de mutuo acuerdo no dan derecho a ese mes adicional. Véase la ",{"tag":"a","props":{"href":"/es/book/19#19-05","title":"Si la empresa no avisó con 30 días de antelación, debe pagar un mes de salario más"},"children":["sección 19, punto 5"]}," (falta de preaviso de 30 días)."]},"\n",{"tag":"li","props":{},"children":["En despido ilegal, la indemnización es 2N. Si el despido fue ilegal — pregunte a asistencia jurídica o a un abogado antes de negociar o ir a arbitraje. Véase ",{"tag":"a","props":{"href":"/es/book/19"},"children":["sección 19, punto 6"]}," (despido ilegal)."]},"\n",{"tag":"li","props":{},"children":["Las vacaciones anuales no disfrutadas se pagan al separarse, prorrateadas al tiempo trabajado del año. Véase ",{"tag":"a","props":{"href":"/es/book/19"},"children":["sección 19, punto 2"]}," (vacaciones anuales)."]},"\n",{"tag":"li","props":{},"children":["Incluya en el total cualquier horas extra no pagadas. Véase ",{"tag":"a","props":{"href":"/es/book/19"},"children":["sección 19, punto 1"]}," (pago de horas extra)."]},"\n"]},"\n",{"tag":"h2","props":{"id":"la-primera-semana"},"children":["La primera semana"]},"\n",{"tag":"ol","props":{},"children":["\n",{"tag":"li","props":{},"children":["Inscríbase como desempleado. La prestación por desempleo corre desde la fecha de inscripción; un mes de retraso cuesta un mes de beneficio. Véase ",{"tag":"a","props":{"href":"/es/book/07"},"children":["sección 7, punto 1"]}," (seguro de desempleo)."]},"\n",{"tag":"li","props":{},"children":["La inscripción se hace en servicios públicos de empleo, como centros de empleo; no hay tasa. Véase ",{"tag":"a","props":{"href":"/es/book/07"},"children":["sección 7, punto 5"]}," (servicios públicos de empleo)."]},"\n",{"tag":"li","props":{},"children":["Solicite la prestación en la app «掌上 12333» o en el mini-programa de la tarjeta electrónica de seguro social. Hace falta al menos un año de cotizaciones y una separación que no sea baja voluntaria. Véase ",{"tag":"a","props":{"href":"/es/book/07"},"children":["sección 7, punto 1"]}," (seguro de desempleo)."]},"\n",{"tag":"li","props":{},"children":["Mientras cobra desempleo, el seguro médico de empleado lo paga el sistema de desempleo; no se da de alta aparte. Véase ",{"tag":"a","props":{"href":"/es/book/07"},"children":["sección 7, punto 1"]}," (seguro de desempleo)."]},"\n",{"tag":"li","props":{},"children":["Si no puede pagar un juicio, llame al 12348 para asistencia jurídica. Ya no hace falta certificado de pobreza del lugar de origen. Véase ",{"tag":"a","props":{"href":"/es/book/07"},"children":["sección 7, punto 3"]}," (asistencia jurídica)."]},"\n",{"tag":"li","props":{},"children":["Si firmó un pacto de no competencia, guarde el original. La empresa debe pagar compensación mensual; si deja de pagar tres meses por causas suyas, puede pedir rescindir el pacto. Véase ",{"tag":"a","props":{"href":"/es/book/11"},"children":["sección 11, punto 12"]}," (pacto de no competencia)."]},"\n",{"tag":"li","props":{},"children":["Fije una rutina: levántese a la misma hora y reserve un bloque fijo para buscar trabajo; no pase el día entero en casa. Véase ",{"tag":"a","props":{"href":"/es/book/29"},"children":["sección 29, punto 3"]}," (tras perder el empleo, rutina primero)."]},"\n"]},"\n",{"tag":"h2","props":{"id":"el-primer-mes"},"children":["El primer mes"]},"\n",{"tag":"ol","props":{},"children":["\n",{"tag":"li","props":{},"children":["Si aún no pagaron salario u horas extra, llame al 12333 para quejar ante inspección laboral y después pida arbitraje laboral. Ambas vías son gratuitas. Véase ",{"tag":"a","props":{"href":"/es/book/07"},"children":["sección 7, punto 2"]}," (salarios atrasados: inspección primero)."]},"\n",{"tag":"li","props":{},"children":["Si el empleador era un taller sin licencia, igualmente inspección y arbitraje. La deuda de un subcontratista laboral puede reclamarse al contratista general; trabajo como ayuda doméstica para un particular — por vía judicial. Véase ",{"tag":"a","props":{"href":"/es/book/07"},"children":["sección 7, punto 22"]}," (saber quién le empleó)."]},"\n",{"tag":"li","props":{},"children":["El arbitraje laboral debe presentarse dentro del año tras la salida. Pasado el plazo, basta con «plazo de prescripción vencido». Véase ",{"tag":"a","props":{"href":"/es/book/08"},"children":["sección 8, punto 19"]}," (un año para arbitraje laboral)."]},"\n",{"tag":"li","props":{},"children":["Para buscar empleo, empiece en servicios públicos de empleo; colocación y orientación son gratis — no use agencias de pago. Véase ",{"tag":"a","props":{"href":"/es/book/07"},"children":["sección 7, punto 5"]}," (servicios públicos de empleo)."]},"\n",{"tag":"li","props":{},"children":["No confíe solo en el currículum. Aprenda a buscar, fije metas claras y pida referencias a contactos. Véase ",{"tag":"a","props":{"href":"/es/book/07"},"children":["sección 7, punto 14"]}," (búsqueda sistemática de empleo)."]},"\n",{"tag":"li","props":{},"children":["Rechace en el acto ofertas de «pague antes de empezar», «formación y luego colocación» o «reclute a otros». Véase ",{"tag":"a","props":{"href":"/es/book/07"},"children":["sección 7, punto 15"]}," (sin «préstamos para formación»)."]},"\n",{"tag":"li","props":{},"children":["Antes de pagar formación, consulte el catálogo local de subsidios de formación profesional del bureau de recursos humanos. Véase ",{"tag":"a","props":{"href":"/es/book/07"},"children":["sección 7, punto 13"]}," (subsidios de formación profesional)."]},"\n",{"tag":"li","props":{},"children":["Compruebe si califica para el reconocimiento de «persona con dificultades de empleo» — por edad o desempleo prolongado. Tras el reconocimiento puede haber subsidios al seguro social y prioridad en empleos de interés público. Véase ",{"tag":"a","props":{"href":"/es/book/07"},"children":["sección 7, punto 12"]}," (reconocimiento de dificultades de empleo)."]},"\n"]},"\n",{"tag":"h2","props":{"id":"los-meses-siguientes"},"children":["Los meses siguientes"]},"\n",{"tag":"ol","props":{},"children":["\n",{"tag":"li","props":{},"children":["Cubra gastos con el fondo de emergencia primero; no pida préstamos ni venda inversiones con pérdida. Véase ",{"tag":"a","props":{"href":"/es/book/05"},"children":["sección 5, punto 27"]}," (fondo de emergencia)."]},"\n",{"tag":"li","props":{},"children":["En los tres primeros meses, posponga decisiones irreversibles: vender vivienda, invertir de golpe la indemnización, socios, avalar deudas ajenas — todo cuenta. Véase ",{"tag":"a","props":{"href":"/es/book/29"},"children":["sección 29, punto 12"]}," (decisiones irreversibles)."]},"\n",{"tag":"li","props":{},"children":["Cuando se acabe el desempleo y siga sin trabajo, no se quede sin cobertura médica. Puede pagar usted el seguro médico de residentes una vez al año; tras un corte en el pago, no pagan reclamaciones durante tres meses. Véase ",{"tag":"a","props":{"href":"/es/book/07"},"children":["sección 7, punto 9"]}," (seguro médico de residentes)."]},"\n",{"tag":"li","props":{},"children":["Un corte en cotizaciones a la pensión no borra años anteriores; el beneficio usa años acumulados. No pague a intermediarios por alta «afiliada» ilegal. Véase ",{"tag":"a","props":{"href":"/es/book/07"},"children":["sección 7, punto 18"]}," (interrupción del seguro social)."]},"\n",{"tag":"li","props":{},"children":["Si el ingreso familiar cae por debajo del mínimo vital local, solicite el dibao. Véase ",{"tag":"a","props":{"href":"/es/book/07"},"children":["sección 7, punto 7"]}," (solicitar dibao)."]},"\n",{"tag":"li","props":{},"children":["Si necesita hablar con alguien, llame al 12356; es gratis. Véase ",{"tag":"a","props":{"href":"/es/book/29"},"children":["sección 29, punto 11"]}," (llamar al 12356)."]},"\n",{"tag":"li","props":{},"children":["Por lo que aún le deban, vigile el plazo de un año desde la fecha de salida. Véase ",{"tag":"a","props":{"href":"/es/book/08"},"children":["sección 8, punto 19"]}," (un año para arbitraje laboral)."]},"\n"]},"\n"]},{"tag":"footer","props":{"className":"life-article-attribution"},"children":[{"tag":"p","props":{},"children":["Artículo reproducido del proyecto abierto HowToLiveBetter, conservando el texto y las notas. Consulta las actualizaciones en el repositorio original."]},{"tag":"a","props":{"href":"https://github.com/dlgrv/HowToLiveBetter/blob/5a8aac6e715851066661ab6524c3a4e650f7e9d7/docs/research/es/After-A-Layoff-What-To-Do-First.md","target":"_blank","rel":"noopener noreferrer"},"children":["Ver versión original · 5a8aac6",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"14","height":"14","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]},{"tag":"span","props":{},"children":["Importado: 2026-10-11"]},{"tag":"p","props":{},"children":["Los enlaces llevan al consejo correspondiente en nuestra edición; la numeración de la fuente puede ser distinta."]}]},{"tag":"div","props":{"className":"life-quick-share"},"children":[{"tag":"button","props":{"type":"button"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-copy","aria-hidden":"true"},"children":[{"tag":"rect","props":{"width":"14","height":"14","x":"8","y":"8","rx":"2","ry":"2"},"children":[]},{"tag":"path","props":{"d":"M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h