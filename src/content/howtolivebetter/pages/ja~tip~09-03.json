n":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["費用・手間"]},{"tag":"p","props":{},"children":["費用はかかりません。ページを閉じれば、それで終わりです。保存せず、転送せず、国内プラットフォームへ持ち込まない。自身の身元が特定できるアカウントで、海外プラットフォームにて長期的に政治的な内容を発信しない。海外の機関、組織、個人からの原稿料や助成金も受け取らない。難しいのは、目に余る内容を見た時に、スクリーンショットを撮らず、共有しないよう自制することです。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["効果"]},{"tag":"p","props":{},"children":["流言、誹謗、またはその他の方法を用いて、国家政権の転覆や社会主義制度の打破を扇動した者は、5 年以下の懲役とする。主導者（法条では「首要分子」と呼ぶ）または罪状が重大な者は、5 年以上の懲役とし、最高 15 年の有期懲役とする。国家の分裂および国家の統一を破壊することを扇動した者の刑期も上記と同様とする。国外の機関、組織、個人と結託してこれら二つの行為を行った場合は、加重処罰の対象となる。国内外の機関、組織、または個人が資金を提供して他者にこれらを行わせた場合、直接責任を負う者には 5 年以下の懲役、情状が重大な者には 5 年以上の懲役を科す。国外の機関、組織、または人員のために、国家機密または情報を窃取、探偵、買収、または不法に提供した者は、5 年から 10 年の懲役とする。この項目において、情状が特に重い場合は10年以上の懲役または無期懲役に、情状が比較的軽い場合は5年以下の懲役に処される。国家の安全を危害する犯罪については、一律に1年から5年の政治的権利の剥奪を併科するものとし、この期間中は選挙権および公職に就く資格が剥奪される。また、財産の没収を併科し、個人の財産を国に帰属させることもできる。行政処分についても規定がある。いかなる個人および組織も、ネットワークを利用して国家の安全、名誉、利益を危害する活動に従事してはならない。また、国家政権の転覆や社会主義制度の打倒を扇動してはならない。国家の分裂や国家の統一を破壊することを扇動してはならない。これらの情報を公開または伝達した場合は、関連する法律および行政法規に基づき処罰される（全国）。また、伝達を行わなくても成立する類型が別途存在する。テロリズムや極端主義を宣伝するものであると知りながら、不法に所持している場合、その状況が深刻であれば処罰の対象となります。対象となるものには、書籍、音声・映像資料、またはその他の物品が含まれます。刑罰は、3 年以下の有期懲役、拘役（短期の拘禁）、または管制（拘禁はされないが行動が制限される）となります。また、罰金が併科または単独で科されることもあります。つまり、刑罰と同時に罰金が科される場合もあれば、罰金のみが科される場合もあります。根拠は刑法第120条の6であり、刑法修正案第9によって追加されたものです。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["出典"]},{"tag":"p","props":{"className":"life-citations"},"children":["全国人大 (1997). 刑法（第四十五、五十五、五十六、一百零三、一百零五、一百零六、一百零七、一百一十一、一百一十三条，这几条未经修正案修改）. ",{"tag":"a","props":{"href":"https://www.spp.gov.cn/spp/fl/201802/t20180206_364975.shtml","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.spp.gov.cn/spp/fl/201802/t20180206_364975.shtml"]},"；全国人大常委会 (2025). 网络安全法（2025 年修正，2026 年 1 月 1 日施行，第十三条第二款、第七十一条第一项）. ",{"tag":"a","props":{"href":"https://www.cac.gov.cn/2025-12/29/c_1768735112911946.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.cac.gov.cn/2025-12/29/c_1768735112911946.htm"]},"；全国人大常委会 (2015). 刑法修正案（九）（新增第一百二十条之六）. 国家信访局转载全文 ",{"tag":"a","props":{"href":"https://www.gjxfj.gov.cn/gjxfj/fgwj/flfg/webinfo/2017/03/1601761496614423.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gjxfj.gov.cn/gjxfj/fgwj/flfg/webinfo/2017/03/1601761496614423.htm"]}]},{"tag":"a","props":{"href":"https://www.spp.gov.cn/spp/fl/201802/t20180206_364975.shtml","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["出典を開く"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["著者の注記"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["ここで引用されているこれらの法律は、他者を扇動すること、外部へ流布すること、他者に提供することに対して罰を科すものであり、単に所有しているだけでは対象となりません。テロリズムや極端主義に関する資料は、条文に明記された例外であり、自身の手に持っているだけで罪に問われる可能性があります（第120条の6）。したがって、この種のものは絶対に保存してはいけません。目にした場合は、そこで止めてください。スクリーンショットを撮って保存しない、転送しない、コメントを付けない、他の人を巻き込んで転送させない。転送することやコメント欄で同調して発言することは、捜査時にはいずれも「拡散」とみなされ、「ただ転送しただけ」では免責されません。内容が海外のプラットフォームに由来する場合、罰則が加重される可能性もあります。真偽が不確かなものは、なおさら転送しないでください。本節の第 1 条（真偽不明な情報を転送しない）を参照してください。VPNなどの回避ツールの使用自体に対する罰則については、第 11 節第 11 条を参照してください。この種の内容を外部に転送しても、実質的な利益は一切得られず、その代償は懲役、政治的権利の剥奪、および財産の没収です。公開・照会可能な同種の案件は、海外メディアや家族が公開した文書にのみ見られます。例えば、海外のプラットフォームで長期間政治的なコメントを投稿していたブロガーは、2023 年の判決を受け、7 年の刑に処されました。本書では、公式なルートで照合可能な判決書を入手できていないため、事例の添付はせず、法条文に基づいてのみ記述しています。"]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["自分のメモ"]},{"tag":"button","props":{"type":"button"},"children":["自分へのメモを書く…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/ja/tip/09-02"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["前へ"]},"英烈を侮辱する画像、絵文字、コメントを投稿・転送しないこと。国旗や国歌をネタにしないこと。"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/ja/tip/09-04"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["次へ"]},"アダルト動画は個人で楽しむ分には自由ですが、グループ内に投稿したり、「素材」を販売したり、グループを作成したりしないでください。"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["このテーマの他の提案"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/09-01"},"children":[{"tag":"strong","props":{},"children":["グループ内で、真偽不明の災害、疫病、事件に関する情報を転送しないこと。画像の加工や、AIによる現場画像の捏造を行わないこと"]},{"tag":"span","props":{},"children":["災害、疫病、事件に関するニュースが偽物だと知りながら拡散した場合、自分で捏造した場合と同じ重い罰則が科されます。自分で捏造していなくても同…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/09-05"},"children":[{"tag":"strong","props":{},"children":["「副業」として自分のカードで入金、出金、送金を行うよう指示される案件、どんなに報酬が高くても断ること"]},{"tag":"span","props":{},"children":["この種の副業で稼げるのは数百元程度ですが、その代償は前科がつくことです。ある人物は、身分証と 1 枚の銀行カードを持って指定の場所へ行き、…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/09-06"},"children":[{"tag":"strong","props":{},"children":["「融資書類の偽造」を勧誘し、融資額に応じたキックバックを提示する者がいても、一切応じないこと"]},{"tag":"span","props":{},"children":["他人の「融資書類の偽造」を手伝い、手数料を受け取る行為は詐欺罪として扱われます。126人からなるグループが、無職の人を「優良顧客」に仕立て…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/09-07"},"children":[{"tag":"strong","props":{},"children":["拾得銀行カードをそのままにせず、携帯電話や財布を拾った際は持ち去らず、持ち主に連絡するか警察に届ける"]},{"tag":"span","props":{},"children":["拾った物を自分のものとして使い、金額が「相当な額」に達しても返還しない場合、2 年以下の懲役、金額が多額な場合は 2 から 5 年の懲役と…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/09-08"},"children":[{"tag":"strong","props":{},"children":["特典は自身の真の身分で受け取る。仮想番号による大量のサブアカウント登録や、脆弱性を利用した繰り返し取得は行わない"]},{"tag":"span","props":{},"children":["自身の真の身分を用い、一つのアカウントで一度だけクーポンを受け取ることは、処罰の範囲には含まれません。偽ユーザーを大量に登録し、自分で注文…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/09-09"},"children":[{"tag":"strong","props":{},"children":["バルコニーや窓からいかなる物も投げ出さない。吸い殻、ゴミ袋、酒瓶もすべて対象"]},{"tag":"span","props":{},"children":["階下へ物を投げ捨てる行為は、人に当たらない場合でも 5 日の拘留および 1000 元の罰金が科せられ、悪質な場合は 10 日から 15 日…"]}]}]}]},{"tag":"a","props":{"className":"life-text-link","href":"/ja/book/09"},"children":["テーマ全体を読む：一般人が陥りやすい法律のレッドライン","