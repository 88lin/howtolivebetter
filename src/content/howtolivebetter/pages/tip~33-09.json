wBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"收起详情"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["成本"]},{"tag":"p","props":{"className":"life-citations"},"children":["申请不花钱。改造本身多数有补贴，自己可能还要补一部分。要跑残联和街道。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["收益"]},{"tag":"p","props":{"className":"life-citations"},"children":["《无障碍环境建设法》第十九条：「县级以上人民政府应当支持、指导家庭无障碍设施改造。对符合条件的残疾人、老年人家庭应当给予适当补贴。」第十八条规定，对既有的不符合无障碍设施工程建设标准的居住建筑、居住区、公共建筑、公共场所、交通运输设施、城乡道路等，县级以上人民政府应当根据实际情况制定有针对性的无障碍设施改造计划并组织实施。第六十二条规定，任何组织和个人有权向政府有关主管部门提出加强和改进无障碍环境建设的意见和建议，对违反本法规定的行为进行投诉、举报；主管部门接到投诉举报「应当及时处理并予以答复」。第六十三条规定，对违反本法规定损害社会公共利益的行为，人民检察院可以提出检察建议或者提起公益诉讼（全国，2023 年 9 月 1 日起施行）"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["来源"]},{"tag":"p","props":{"className":"life-citations"},"children":["中华人民共和国无障碍环境建设法（第十八条、第十九条、第六十二条、第六十三条）. ",{"tag":"a","props":{"href":"https://flk.npc.gov.cn/detail?id=ff80818188d7430b0189018493370940","target":"_blank","rel":"noopener noreferrer"},"children":["https://flk.npc.gov.cn/detail?id=ff80818188d7430b0189018493370940"]},""]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["原书备注"]},{"tag":"p","props":{"className":"life-citations"},"children":["定 B 是因为法律只写了「应当给予适当补贴」，补多少、谁算符合条件全交给地方，没有全国统一的数字。先在当地残联官网查「困难重度残疾人家庭无障碍改造」。名额多数按年度分配，排队要早。小区加装电梯、楼道改造是另一套流程，走住建部门。公共场所的无障碍设施不达标，按第六十二条向主管部门投诉，它要给你答复。"]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["我的备注"]},{"tag":"button","props":{"type":"button"},"children":["写下对自己有用的提醒…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/tip/33-08"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["上一条"]},"孩子不满 7 岁又有残疾或者孤独症的，去县级残联申请康复救助"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/tip/33-10"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["下一条"]},"找工作时主动说明自己持残疾人证，企业招你能抵掉一笔钱"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["本主题的其他建议"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/33-05"},"children":[{"tag":"strong","props":{},"children":["长期坐轮椅的，坐垫换成减压型，每天看一遍坐骨和尾骨"]},{"tag":"span","props":{},"children":["普通海绵坐垫压久了会把皮肤压破，破了愈合很慢，容易感染。养老院里用减压坐垫的老人，坐骨那里的压疮明显更少，但把尾骨一起算就没看出差别。轮椅本身也要按人的尺寸配，…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/33-06"},"children":[{"tag":"strong","props":{},"children":["别买「能治好瘫痪、失明、耳聋」的疗法和器械"]},{"tag":"span","props":{},"children":["广告法把话说死了。医疗、药品、医疗器械的广告，不许保证疗效，不许说治愈率和有效率，不许找人现身说法。所以「三个疗程站起来」「多少人已经康复」这类话本身就是违法广…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/33-07"},"children":[{"tag":"strong","props":{},"children":["残疾人证办下来之后，去县级残联把能申请的东西一次问全"]},{"tag":"span","props":{},"children":["残疾人证本身不发钱，它是一把钥匙。接在它后面的是好几笔各自独立的待遇，每一笔都要自己去申请，不会自动上门。第一次去残联，就把清单上的项目一项项问过来，比来回跑几…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/33-11"},"children":[{"tag":"strong","props":{},"children":["残疾人的个人所得税可以减征，减多少打电话问省税务局"]},{"tag":"span","props":{},"children":["个人所得税法写着，残疾人的所得可以减征个税。但是减多少、减多久，法律交给了省级政府定，所以各省不一样。有的省按年度定一个减免限额，有的按比例减。办法是打 123…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/33-12"},"children":[{"tag":"strong","props":{},"children":["导盲犬可以带进公共场所和公共交通，盲人免费坐市内公交"]},{"tag":"span","props":{},"children":["法律写明，公共场所和公共交通要为带导盲犬、导听犬、辅助犬的残疾人提供便利。盲人凭有效证件免费坐市内公交、地铁和渡船，残疾人可以免费带随身必备的辅助器具。被拦下来…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/33-13"},"children":[{"tag":"strong","props":{},"children":["残疾人参加高考可以申请合理便利，用盲文卷的考试时间加一半"]},{"tag":"span","props":{},"children":["残疾考生参加高考，可以申请盲文卷、大字卷、免外语听力、单独考场、带助听器和轮椅进场，考试时间也能延长。这些不会自动给，要按省里规定的时间交书面申请，附第二代以上…"]}]}]}]},{"tag":"a","props":{"className":"life-text-link","href":"/book/33"},"children":["阅读整个主题：残疾之后怎么活 ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"15","height":"15","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children