":"path","props":{"d":"M18 20a6 6 0 0 0-12 0"},"children":[]},{"tag":"circle","props":{"cx":"12","cy":"10","r":"4"},"children":[]},{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},{"tag":"span","props":{},"children":["Đăng nhập để đồng bộ hóa"]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/vi/book/01"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"Quay lại mục lục"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["Đừng chết sớm"]},{"tag":"nav","props":{"aria-label":"Các mục trong chương"},"children":[{"tag":"a","props":{"href":"/vi/tip/01-01"},"children":[{"tag":"span","props":{},"children":["01"]},"Cài dây đai an toàn, cả hàng trước lẫn hàng sau"]},{"tag":"a","props":{"href":"/vi/tip/01-02"},"children":[{"tag":"span","props":{},"children":["02"]},"Chạy xe máy, xe điện thì đội mũ bảo hiểm và cài chặt dây"]},{"tag":"a","props":{"href":"/vi/tip/01-03"},"children":[{"tag":"span","props":{},"children":["03"]},"Lắp báo động khói; mùa đông đốt than hay dùng gas trong nhà thì lắp thêm báo động ô-xít cacbon"]},{"tag":"a","props":{"href":"/vi/tip/01-04"},"children":[{"tag":"span","props":{},"children":["04"]},"Ống gas và bếp gas đến hạn thì thay, đừng tự sửa ống, công ty gas đến nhà bán hàng thì từ chối thẳng"]},{"tag":"a","props":{"href":"/vi/tip/01-05"},"children":[{"tag":"span","props":{},"children":["05"]},"Không hái, không mua, không ăn nấm hoang, mọi cách nhận biết kiểu dân gian đều không có cơ sở"]},{"tag":"a","props":{"href":"/vi/tip/01-06"},"children":[{"tag":"span","props":{},"children":["06"]},"Không đẩy xe điện vào hành lang, không vào thang máy, không sạc trong nhà"]},{"tag":"a","props":{"href":"/vi/tip/01-07"},"children":[{"tag":"span","props":{},"children":["07"]},"Đo huyết áp, cao rồi thì uống thuốc hạ cho tới mức chuẩn"]},{"tag":"a","props":{"href":"/vi/tip/01-08"},"children":[{"tag":"span","props":{},"children":["08"]},"Từ 35 tuổi, cứ thừa cân là đi xét đường huyết lúc nhịn một lần, xét ra bình thường thì ba năm xét lại"]},{"tag":"a","props":{"href":"/vi/tip/01-09"},"children":[{"tag":"span","props":{},"children":["09"]},"Không chạy quá tốc độ, không lái xe sau khi uống rượu"]},{"tag":"a","props":{"href":"/vi/tip/01-10"},"children":[{"tag":"span","props":{},"children":["10"]},"Khi đi ô tô, dùng ghế an toàn cho trẻ dưới 4 tuổi, đừng ôm trong lòng"]},{"tag":"a","props":{"href":"/vi/tip/01-11"},"children":[{"tag":"span","props":{},"children":["11"]},"Nhà có trẻ nhỏ thì lắp chặn cửa sổ và ban công, lưới chống muỗi không tính là biện pháp bảo vệ"]},{"tag":"a","props":{"href":"/vi/tip/01-12"},"children":[{"tag":"span","props":{},"children":["12"]},"Trẻ em ở gần nước thì không được rời mắt, chèo thuyền hay bơi ngoài trời thì mặc áo phao"]},{"tag":"a","props":{"href":"/vi/tip/01-13"},"children":[{"tag":"span","props":{},"children":["13"]},"Trên 60 tuổi tập thăng bằng và sức chân, cải tạo phòng tắm và cầu thang trong nhà"]},{"tag":"a","props":{"href":"/vi/tip/01-14"},"children":[{"tag":"span","props":{},"children":["14"]},"Xét nghiệm 5 chỉ số viêm gan B, không có kháng thể thì tiêm vaccine"]},{"tag":"a","props":{"href":"/vi/tip/01-15"},"children":[{"tag":"span","props":{},"children":["15"]},"Bị đinh sắt, gai gỗ đâm vào hoặc vết thương dính đất thì xử lý ngay trong ngày, tiện thể hỏi có cần tiêm phòng uốn dương không"]},{"tag":"a","props":{"href":"/vi/tip/01-16"},"children":[{"tag":"span","props":{},"children":["16"]},"Phụ nữ tiêm vaccine HPV, càng sớm càng tốt"]},{"tag":"a","props":{"href":"/vi/tip/01-17"},"children":[{"tag":"span","props":{},"children":["17"]},"Phụ nữ từ 40 tuổi làm xét nghiệm sàng lọc ung thư vú, chụp mammogram mỗi hai năm một lần"]},{"tag":"a","props":{"href":"/vi/tip/01-18"},"children":[{"tag":"span","props":{},"children":["18"]},"Phụ nữ trên 30 tuổi làm xét nghiệm sàng lọc ung thư cổ tử cung, ưu tiên xét nghiệm HPV"]},{"tag":"a","props":{"href":"/vi/tip/01-19"},"children":[{"tag":"span","props":{},"children":["19"]},"Từ 45 đến 50 tuổi làm xét nghiệm sàng lọc ung thư trực tràng và ruột già, bằng xét nghiệm miễn dịch hoá học tìm máu ẩn trong phân hoặc nội soi đại tràng"]},{"tag":"a","props":{"href":"/vi/tip/01-20"},"children":[{"tag":"span","props":{},"children":["20"]},"Người bệnh tim mạch và người cao tuổi tiêm vaccine cúm mỗi năm"]},{"tag":"a","props":{"href":"/vi/tip/01-21"},"children":[{"tag":"span","props":{},"children":["21"]},"Từ 50 tuổi, tiêm vaccine thủy độc"]},{"tag":"a","props":{"href":"/vi/tip/01-22"},"children":[{"tag":"span","props":{},"children":["22"]},"Người từ 65 tuổi tiêm vaccine phế cầu khuẩu"]},{"tag":"a","props":{"href":"/vi/tip/01-23"},"children":[{"tag":"span","props":{},"children":["23"]},"Xét nghiệm vi khuẩn H. pylori, dương tính thì diệt trùng"]},{"tag":"a","props":{"href":"/vi/tip/01-24"},"children":[{"tag":"span","props":{},"children":["24"]},"Người hút thuốc nặng chụp CT ngực liều thấp mỗi năm một lần"]},{"tag":"a","props":{"href":"/vi/tip/01-25"},"children":[{"tag":"span","props":{},"children":["25"]},"Bị trầm cảm hoặc có ý nghĩ tự sát thì bấm 12356, trong nhà không tích trữ thuốc ngủ và thuốc trừ sâu"]},{"tag":"a","props":{"href":"/vi/tip/01-26"},"children":[{"tag":"span","props":{},"children":["26"]},"Chuẩn bị bình chữa cháy, chăn chữa cháy, mặt nạ thở để chạy thoát và túi sơ cứu, kiểm tra mỗi năm một lần"]},{"tag":"a","props":{"href":"/vi/tip/01-27"},"children":[{"tag":"span","props":{},"children":["27"]},"Trong nước tiểu có máu nhìn thấy bằng mắt, dù không đau, dù ngày mai đã sạch, vẫn phải khám một lần"]},{"tag":"a","props":{"href":"/vi/tip/01-28"},"children":[{"tag":"span","props":{},"children":["28"]},"Chức năng cương có vấn đề, đi khám tim mạch trước, đừng coi đó chỉ là chuyện ấy"]},{"tag":"a","props":{"href":"/vi/tip/01-29"},"children":[{"tag":"span","props":{},"children":["29"]},"Giảm cân, cai thuốc lá, kiểm soát huyết áp và đường huyết thì chức năng cương tốt lên theo"]},{"tag":"a","props":{"href":"/vi/tip/01-30"},"children":[{"tag":"span","props":{},"children":["30"]},"Dùng bao cao su suốt quá trình quan hệ tình dục, không dùng chung kim tiêm với người khác"]},{"tag":"a","props":{"href":"/vi/tip/01-31"},"children":[{"tag":"span","props":{},"children":["31"]},"Đã từng có hành vi nguy cơ cao thì đi xét HIV/AIDS một lần, trung tâm kiểm soát bệnh miễn phí, kết quả được giữ kín"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/vi/tip/01-32","data-status":"active"},"children":[{"tag":"span","props":{},"children":["32"]},"Ý nghĩ tự sát vừa nảy lên thì kể ngay một người bên cạnh, giao mấy chút phút ấy ra"]},{"tag":"a","props":{"href":"/vi/tip/01-33"},"children":[{"tag":"span","props":{},"children":["33"]},"Đừng coi「cứu được」là chốt chặn cuối cùng: uống thuốc trừ sâu hay hít khí than, cấp cứu giữ được mạng nhưng không giữ được phổi và não"]},{"tag":"a","props":{"href":"/vi/tip/01-34"},"children":[{"tag":"span","props":{},"children":["34"]},"Đừng cược vào chuyện「nằm vài ngày là khỏe」khi ngã từ trên cao: phần lớn người vào ICU chấn thương vẫn sống, cái giá thì tính theo năm"]},{"tag":"a","props":{"href":"/vi/tip/01-35"},"children":[{"tag":"span","props":{},"children":["35"]},"Đừng đổi tiền lấy chuyện「thiếu một quả thận cũng không sao」: quả còn lại phải làm việc thay hai quả, người bán thận sau đó có 86% nói sức khoẻ xấu đi"]},{"tag":"a","props":{"href":"/vi/tip/01-36"},"children":[{"tag":"span","props":{},"children":["36"]},"Không nhặt, không tháo, không bán phần kim loại không rõ lai lịch, thấy ký hiệu cỏ ba lá thì tránh xa"]},{"tag":"a","props":{"href":"/vi/tip/01-37"},"children":[{"tag":"span","props":{},"children":["37"]},"Cờ bạc tới mức vay tiền còn cờ, tâm trạng lúc nào cũng tụt thì gọi 12356, rồi giao thẻ ngân hàng và mật khẩu thanh toán cho người nhà giữ"]},{"tag":"a","props":{"href":"/vi/tip/01-38"},"children":[{"tag":"span","props":{},"children":["38"]},"Nam giới có quan hệ tình dục với nam và có hành vi nguy cơ cao: đi bệnh viện AIDS được chỉ định hỏi thuốc phòng trước phơi nhiễm, uống đúng giờ thì giảm hơn bảy phần mười số ca nhiễm"]},{"tag":"a","props":{"href":"/vi/tip/01-39"},"children":[{"tag":"span","props":{},"children":["39"]},"Phụ nữ từ 65 tuổi nên làm một lần xét mật độ xương bằng X-quang năng lượng kép, phụ nữ sau mãn kinh có yếu tố nguy cơ loãng xương thì không cần đợi tới 65 tuổi"]},{"tag":"a","props":{"href":"/vi/tip/01-40"},"children":[{"tag":"span","props":{},"children":["40"]},"Xét ra loãng xương, hoặc đã từng gãy xương chỉ vì ngã nhẹ, thì xin bác sĩ kê thuốc chống loãng xương và dùng đều, đừng thay bằng bổ sung canxi"]},{"tag":"a","props":{"href":"/vi/tip/01-41"},"children":[{"tag":"span","props":{},"children":["41"]},"Lên băng ngoài trời thì khoan lỗ đo độ dày trước, dưới 15 xentimét thì đừng lên, đừng tới chỗ băng trên sông và quanh hố đào giấu"]},{"tag":"a","props":{"href":"/vi/tip/01-42"},"children":[{"tag":"span","props":{},"children":["42"]},"Lắp chắn bảo vệ, đeo kính bảo hộ cùng tấm che mặt rồi mới dùng máy mài góc; giữ chắc bằng hai tay, đừng lắp lưỡi cưa gỗ để cắt gỗ"]},{"tag":"a","props":{"href":"/vi/tip/01-43"},"children":[{"tag":"span","props":{},"children":["43"]},"Hỏi thẳng người bên cạnh có tâm trạng bất thường: «Bạn có nghĩ đến tự sát không?». Hỏi không làm họ muốn tự sát hơn"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"Breadcrumbs"},"children":[{"tag":"a","props":{"href":"/vi/book"},"children":["Khám phá cuốn sách"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/vi/book/01"},"children":["Chương 1"," ·"," ","Đừng chết sớm"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"01-32"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["32"]},{"tag":"span","props":{"className":"life-evidence grade-b"},"children":["Bằng chứng"," ","B"]}]},{"tag":"h1","props":{"lang":"vi"},"children":["Ý nghĩ tự sát vừa nảy lên thì kể ngay một người bên cạnh, giao mấy chút phút ấy ra"]},{"tag":"p","props":{"lang":"vi","className":"life-entry-summary"},"children":["Gần một nửa số người từng tự sát không thành công nói rằng, từ lúc ý nghĩ nảy lên tới lúc ra tay không quá 10 phút, nên phần phải trụ qua thường chỉ là mấy chút phút ấy. Ba phần tư số người trong khoảng thời gian đó có tiếp xúc với người bên cạnh, chỉ là không mở miệng. Người từng vào viện vì tự làm hại mình, sau 1 năm khoảng 2% chết vì tự sát, trên 9 năm khoảng 7%, tuyệt đối phần lớn sau đó không chết vì tự sát."]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Chi phí"]},{"tag":"p","props":{},"children":["Không tốn tiền. Chỗ khó là lúc đó mở miệng, và chịu nhận r…"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Lợi ích"]},{"tag":"p","props":{},"children":["82 người từng tự sát không thành công được phỏng vấn trong 3 ngày nhập viện: 47.6%（39 người）nói, từ lần đầu ti…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"Đánh dấu: Ý nghĩ tự sát vừa nảy lên thì kể ngay một người bên cạnh, giao mấy chút phút ấy ra"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"Hoàn tất"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"Kế hoạch thực hiện"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"Lưu"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Chia sẻ mẹo này"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Ẩn chi tiết"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Chi phí"]},{"tag":"p","props":{},"children":["Không tốn tiền. Chỗ khó là lúc đó mở miệng, và chịu nhận ra mấy giờ ấy mình không ở một mình được."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Lợi ích"]},{"tag":"p","props":{},"children":["82 người từng tự sát không thành công được phỏng vấn trong 3 ngày nhập viện: 47.6%（39 người）nói, từ lần đầu tiên trong đợt này ý nghĩ tự sát nảy lên tới lúc thật sự ra tay không quá 10 phút. Người mà quá trình này kéo dài hơn một chút thì điểm ý định tự sát rõ ràng cao hơn. Điểm trên thang đo tính bốc đột không có liên quan gì với độ dài của quá trình. 76.8%（63 người）nói, trong khoảng thời gian đó có tiếp xúc nào đó với bạn tình, người nhà hoặc bạn bè. Kết luận của tác giả là: cửa sổ can thiệp thường rất ngắn, chuyên gia trong giai đoạn này can thiệp được rất hạn chế, nên phải phổ biến cách nhận biết dấu hiệu và cách can thiệp cho người thường. Một bài tổng quan hệ thống khác gộp 90 nghiên cứu theo dõi. Người tới khám vì tự làm hại mình, tỷ lệ sau 1 năm lại tự làm hại mình mà không chết, lấy giá trị trung vị là 16%. Sau 1 năm chết vì tự sát là 2%. Theo dõi trên 9 năm, khoảng 7% chết vì tự sát"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Nguồn gốc"]},{"tag":"p","props":{"className":"life-citations"},"children":["Deisenhammer EA, Ing CM, Strauss R, Kemmler G, Hinterhuber H, Weiss EM (2009). The duration of the suicidal process: how much time is left for intervention between consideration and accomplishment of a suicide attempt? Journal of Clinical Psychiatry, 70(1), 19-24. ",{"tag":"a","props":{"href":"https://doi.org/10.4088/JCP.07m03904","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.4088/JCP.07m03904"]},"；Owens D, Horrocks J, House A (2002). Fatal and non-fatal repetition of self-harm: systematic review. British Journal of Psychiatry, 181, 193-199. ",{"tag":"a","props":{"href":"https://doi.org/10.1192/bjp.181.3.193","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1192/bjp.181.3.193"]}]},{"tag":"a","props":{"href":"https://doi.org/10.4088/JCP.07m03904","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Liên kết mở nguồn"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Ghi chú sách"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["Lý do cho mức B: nghiên cứu của Deisenhammer chỉ có 82 người, ở một bệnh viện, dựa vào người bệnh nhớ lại sau sự việc. Bài của Owens đưa ra tỷ lệ lấy giá trị trung vị của 90 nghiên cứu làm khác nhau, không phải gộp chúng thành một con số. Chính bài đó còn viết rõ, nguy cơ tự sát của người tự làm hại mình vẫn cao hơn người thường hàng trăm lần. Vì thế câu「tuyệt đối phần lớn sau đó không chết vì tự sát」nói về cả nhóm người bị hại này, không phải bảo đảm cho một người nào cả, có bệnh thì vẫn phải khám. Dời xa phương tiện gây chết và gọi 12356 xem mục 25 của phần này. Mấy việc nên làm trước khi tâm trạng xuống thấp xem mục 18 ở phần 3. Di chứng còn lại sau khi được cứu xem mục 33 của phần này. Nghi người bên cạnh có ý nghĩ này thì có thể hỏi trực tiếp, xem mục 43 của phần này (hỏi trực tiếp người bên cạnh có tâm trạng bất thường). Khi người bên cạnh để lộ ý nghĩ ấy thì bạn làm được gì, xem mục 15 ở phần 8."]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Ghi chú của tôi"]},{"tag":"button","props":{"type":"button"},"children":["Viết một lời nhắc cho chính bạn…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/vi/tip/01-31"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","