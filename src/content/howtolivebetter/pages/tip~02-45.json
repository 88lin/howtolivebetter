ildren":["09"]},"把家里的食盐换成低钠盐（钾盐）"]},{"tag":"a","props":{"href":"/tip/02-10","className":""},"children":[{"tag":"span","props":{},"children":["10"]},"认真刷牙，每天清一次牙缝，缺了牙去看牙医"]},{"tag":"a","props":{"href":"/tip/02-11","className":""},"children":[{"tag":"span","props":{},"children":["11"]},"每天走到 7000–8000 步，或者每周累计快走 150–300 分钟"]},{"tag":"a","props":{"href":"/tip/02-12","className":""},"children":[{"tag":"span","props":{},"children":["12"]},"成年后定期查血脂，40 岁前每 2 到 5 年一次、40 岁起每年一次；有高血压、高血脂就按医嘱规律吃药，别自行停"]},{"tag":"a","props":{"href":"/tip/02-13","className":""},"children":[{"tag":"span","props":{},"children":["13"]},"每晚睡 7 小时左右，作息固定"]},{"tag":"a","props":{"href":"/tip/02-14","className":""},"children":[{"tag":"span","props":{},"children":["14"]},"常打网球、羽毛球、乒乓球这类球拍类运动"]},{"tag":"a","props":{"href":"/tip/02-15","className":""},"children":[{"tag":"span","props":{},"children":["15"]},"把爬楼梯、快走赶路这类零碎的用力活动攒到每天四五分钟"]},{"tag":"a","props":{"href":"/tip/02-16","className":""},"children":[{"tag":"span","props":{},"children":["16"]},"每周做 30–60 分钟力量训练"]},{"tag":"a","props":{"href":"/tip/02-17","className":""},"children":[{"tag":"span","props":{},"children":["17"]},"别连着坐太久，隔一阵起身动一动"]},{"tag":"a","props":{"href":"/tip/02-18","className":""},"children":[{"tag":"span","props":{},"children":["18"]},"少吃加工肉（火腿、培根、香肠、午餐肉）"]},{"tag":"a","props":{"href":"/tip/02-19","className":""},"children":[{"tag":"span","props":{},"children":["19"]},"少喝或不喝酒"]},{"tag":"a","props":{"href":"/tip/02-20","className":""},"children":[{"tag":"span","props":{},"children":["20"]},"每天都喝酒、一停就手抖心慌的人，别自己硬戒"]},{"tag":"a","props":{"href":"/tip/02-21","className":""},"children":[{"tag":"span","props":{},"children":["21"]},"想少喝酒，先把一周喝了多少数出来，再找医生聊几分钟"]},{"tag":"a","props":{"href":"/tip/02-22","className":""},"children":[{"tag":"span","props":{},"children":["22"]},"每天吃一小把坚果"]},{"tag":"a","props":{"href":"/tip/02-23","className":""},"children":[{"tag":"span","props":{},"children":["23"]},"把一部分红肉换成鱼和禽肉"]},{"tag":"a","props":{"href":"/tip/02-24","className":""},"children":[{"tag":"span","props":{},"children":["24"]},"把一部分精米白面换成全谷物"]},{"tag":"a","props":{"href":"/tip/02-25","className":""},"children":[{"tag":"span","props":{},"children":["25"]},"每周喝三次以上茶"]},{"tag":"a","props":{"href":"/tip/02-26","className":""},"children":[{"tag":"span","props":{},"children":["26"]},"每天喝三到四杯咖啡，咖啡因总量不超过 400 mg，不加糖不加奶盖"]},{"tag":"a","props":{"href":"/tip/02-27","className":""},"children":[{"tag":"span","props":{},"children":["27"]},"每天吃够 5 份（约 400 g）水果蔬菜"]},{"tag":"a","props":{"href":"/tip/02-28","className":""},"children":[{"tag":"span","props":{},"children":["28"]},"少吃超加工食品（薯片、方便面、糕点、速食）"]},{"tag":"a","props":{"href":"/tip/02-29","className":""},"children":[{"tag":"span","props":{},"children":["29"]},"做饭、取暖不烧煤和柴，换成电或燃气"]},{"tag":"a","props":{"href":"/tip/02-30","className":""},"children":[{"tag":"span","props":{},"children":["30"]},"热的东西放一放再喝，不喝滚烫的茶、汤和咖啡"]},{"tag":"a","props":{"href":"/tip/02-31","className":""},"children":[{"tag":"span","props":{},"children":["31"]},"白天出门晒晒太阳，别整天不见光"]},{"tag":"a","props":{"href":"/tip/02-32","className":""},"children":[{"tag":"span","props":{},"children":["32"]},"把 BMI 控制在 20–25，超重就减"]},{"tag":"a","props":{"href":"/tip/02-33","className":""},"children":[{"tag":"span","props":{},"children":["33"]},"每周吃四次以上辣椒"]},{"tag":"a","props":{"href":"/tip/02-34","className":""},"children":[{"tag":"span","props":{},"children":["34"]},"每天喝一两份奶或酸奶"]},{"tag":"a","props":{"href":"/tip/02-35","className":""},"children":[{"tag":"span","props":{},"children":["35"]},"鸡蛋不用戒，一天一个以内就行"]},{"tag":"a","props":{"href":"/tip/02-36","className":""},"children":[{"tag":"span","props":{},"children":["36"]},"有条件就泡澡，别只冲淋浴"]},{"tag":"a","props":{"href":"/tip/02-37","className":""},"children":[{"tag":"span","props":{},"children":["37"]},"把午睡控制在半小时内，别超过一小时，非得睡一两小时才撑得住就去查原因"]},{"tag":"a","props":{"href":"/tip/02-38","className":""},"children":[{"tag":"span","props":{},"children":["38"]},"熬夜之后第二天晚上就补觉，别攒到周末"]},{"tag":"a","props":{"href":"/tip/02-39","className":""},"children":[{"tag":"span","props":{},"children":["39"]},"上夜班干得越久心血管风险越高，能转岗就趁早转"]},{"tag":"a","props":{"href":"/tip/02-40","className":""},"children":[{"tag":"span","props":{},"children":["40"]},"买预包装、有 SC 编号的食用油，不买小作坊散装自榨花生油"]},{"tag":"a","props":{"href":"/tip/02-41","className":""},"children":[{"tag":"span","props":{},"children":["41"]},"做饭用植物油代替猪油和黄油，不必为了健康换着买油，也别指望亚麻籽油护心"]},{"tag":"a","props":{"href":"/tip/02-42","className":""},"children":[{"tag":"span","props":{},"children":["42"]},"炒菜、煎炸时打开抽油烟机，从开火一直开到做完"]},{"tag":"a","props":{"href":"/tip/02-43","className":""},"children":[{"tag":"span","props":{},"children":["43"]},"绝经前后潮热盗汗影响到生活，就去妇科评估激素治疗，别硬扛也别自己买药，更别拿它防心脏病"]},{"tag":"a","props":{"href":"/tip/02-44","className":""},"children":[{"tag":"span","props":{},"children":["44"]},"本来就想养狗的，把每天遛狗算进走路量，别为了长寿专门去养狗"]},{"tag":"a","props":{"href":"/tip/02-45","className":"active"},"children":[{"tag":"span","props":{},"children":["45"]},"查出糖尿病前期（血糖偏高、还没到糖尿病），就靠少吃、减重、多动把糖尿病往后推，每半年复查一次血糖"]},{"tag":"a","props":{"href":"/tip/02-46","className":""},"children":[{"tag":"span","props":{},"children":["46"]},"家里的花生、玉米、坚果和米面发了霉，整包扔掉，别挑掉霉的吃剩下的；嚼到发苦的坚果马上吐掉"]},{"tag":"a","props":{"href":"/tip/02-47","className":""},"children":[{"tag":"span","props":{},"children":["47"]},"别吃淡水鱼虾做的鱼生、生鱼片、鱼生粥和醉虾，常吃过的去医院查一次肝吸虫，查出来按医嘱吃吡喹酮"]}]}]},{"tag":"div","props":{"className":"life-tip-page","data-tip-locales":"zh"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"当前位置"},"children":[{"tag":"a","props":{"href":"/book"},"children":["阅读全书"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/book/02"},"children":["第 2 章 · 不要慢慢死"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"02-45"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["45"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["证据 A"]}]},{"tag":"h1","props":{"lang":"zh"},"children":["查出糖尿病前期（血糖偏高、还没到糖尿病），就靠少吃、减重、多动把糖尿病往后推，每半年复查一次血糖"]},{"tag":"p","props":{"lang":"zh","className":"life-entry-summary"},"children":["血糖偏高、还没到糖尿病的人，少吃、多动、减掉一点体重，得糖尿病的风险能低三到六成。中国大庆的试验跟了 30 年，这么做的人死亡的概率低约四分之一，平均多活约一年半。但美国和芬兰的同类试验没看出死亡率有差别。"]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["成本"]},{"tag":"p","props":{},"children":["不花钱，少吃还能省一点。每周快走这类中等强度活动至少 150 分钟，摊到每天二十来分钟。每天比原来少吃 400 到 500 千卡。难在要一直坚持，体重减下来以后还要维持住。每半年抽一次血复查，空腹血糖十几元。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["收益"]},{"tag":"p","props":{},"children":["大庆研究是在黑龙江大庆做的随机分组试验，按诊所分组。577 名糖耐量受损（糖尿病前期的一种）的成年人分进对照组，或者三种干预组：只管饮食、只加运动、两样都做。干预做了 6 年。6 年里得糖尿病的累计比例，对照组是 67.7%。饮食组 43.8%，运动组 41.1%，饮食加运动组 46.0%。扣掉体重…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"标记：查出糖尿病前期（血糖偏高、还没到糖尿病），就靠少吃、减重、多动把糖尿病往后推，每半年复查一次血糖"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"已做到"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"加入待做"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"收藏"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"分享这条建议"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"收起详情"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["成本"]},{"tag":"p","props":{"className":"life-citations"},"children":["不花钱，少吃还能省一点。每周快走这类中等强度活动至少 150 分钟，摊到每天二十来分钟。每天比原来少吃 400 到 500 千卡。难在要一直坚持，体重减下来以后还要维持住。每半年抽一次血复查，空腹血糖十几元。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["收益"]},{"tag":"p","props":{"className":"life-citations"},"children":["大庆研究是在黑龙江大庆做的随机分组试验，按诊所分组。577 名糖耐量受损（糖尿病前期的一种）的成年人分进对照组，或者三种干预组：只管饮食、只加运动、两样都做。干预做了 6 年。6 年里得糖尿病的累计比例，对照组是 67.7%。饮食组 43.8%，运动组 41.1%，饮食加运动组 46.0%。扣掉体重指数和空腹血糖的差别后，三组得糖尿病的风险分别低约 31%、46%、42%。偏瘦和超重的人（体重指数以 25 为界）降幅差不多。跟到 23 年，干预组心血管死亡低约 41%（HR 0.59，95% CI 0.36–0.96，可信范围）。总死亡低约 29%（HR 0.71，0.51–0.99）。得糖尿病的低约 45%（HR 0.55，0.40–0.76）。跟到 30 年，干预组得糖尿病的时间往后推了 3.96 年（按中位数算）。心血管事件低约 26%（HR 0.74，0.59–0.92）。眼底、肾、神经的严重小血管并发症低约 35%（HR 0.65，0.45–0.95）。心血管死亡低约 33%（HR 0.67，0.48–0.94）。总死亡低约 26%（HR 0.74，0.61–0.89）。平均多活 1.44 年（0.20–2.68）。美国 DPP 试验把 3234 名血糖偏高的人随机分组。生活方式组的目标是体重至少减 7%，每周活动至少 150 分钟。平均跟了 2.8 年，生活方式组得糖尿病的风险比安慰剂组低 58%（95% CI 48%–66%）。吃二甲双胍的组低 31%（17%–43%），比改生活方式差。跟到平均 15 年，生活方式组仍低 27%（HR 0.73，0.65–0.83），但差距逐年缩小。跟到中位 21 年，生活方式组的总死亡率和安慰剂组没有差别（HR 1.02，0.81–1.28）。心血管死亡也没有差别（HR 1.18，0.77–1.81）。芬兰 DPS 试验随机分了 522 名超重的糖耐量受损者。4 年累计得糖尿病的，干预组 11%，对照组 23%。试验期间风险低 58%。停掉一对一辅导后接着跟，到中位 7 年时仍低 43%。平均跟到 10.6 年，总死亡没有明显差别（HR 0.57，0.21–1.58）。心血管病也没有（HR 1.04，0.72–1.51）。健康中国行动给的界线是：空腹血糖 6.1 到 7.0 mmol/L（不含 7.0）就算糖尿病前期。喝糖水后 2 小时血糖 7.8 到 11.1 mmol/L（不含 11.1）也算。它建议超重或肥胖的人把体重指数降到或接近 24，或者体重至少减 7%。每天饮食总热量至少少 400 到 500 千卡，中等强度活动每周至少 150 分钟。每半年查一次空腹血糖或餐后 2 小时血糖。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["来源"]},{"tag":"p","props":{"className":"life-citations"},"children":["Pan XR, Li GW, Hu YH, 等 (1997). Effects of diet and exercise in preventing NIDDM in people with impaired glucose tolerance. The Da Qing IGT and Diabetes Study. Diabetes Care, 20(4), 537-544. ",{"tag":"a","props":{"href":"https://doi.org/10.2337/diacare.20.4.537","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.2337/diacare.20.4.537"]},"；Li G, Zhang P, Wang J, 等 (2014). Cardiovascular mortality, all-cause mortality, and diabetes incidence after lifestyle intervention for people with impaired glucose tolerance in the Da Qing Diabetes Prevention Study: a 23-year follow-up study. Lancet Diabetes & Endocrinology, 2(6), 474-480. ",{"tag":"a","props":{"href":"https://doi.org/10.1016/S2213-8587(14)70057-9","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1016/S2213-8587(14)70057-9"]},"；Gong Q, Zhang P, Wang J, 等 (2019). Morbidity and mortality after lifestyle intervention for people with impaired glucose tolerance: 30-year results of the Da Qing Diabetes Prevention Outcome Study. Lancet Diabetes & Endocrinology, 7(6), 452-461. ",{"tag":"a","props":{"href":"https://doi.org/10.1016/S2213-8587(19)30093-2","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1016/S2213-8587(19)30093-2"]},"；Knowler WC, Barrett-Connor E, Fowler SE, 等 (2002). Reduction in the incidence of type 2 diabetes with lifestyle intervention or metformin. NEJM, 346(6), 393-403. ",{"tag":"a","props":{"href":"https://doi.org/10.1056/NEJMoa012512","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1056/NEJMoa012512"]},"；Diabetes Prevention Program Research Group (2015). Long-term effects of lifestyle intervention or metformin on diabetes development and microvascular complications over 15-year follow-up: the Diabetes Prevention Program Outcomes Study. Lancet Diabetes & Endocrinology, 3(11), 866-875. ",{"tag":"a","props":{"href":"https://doi.org/10.1016/S2213-8587(15)00291-0","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1016/S2213-8587(15)00291-0"]},"；Lee CG, Heckman-Stoddard B, Dabelea D, 等 (2021). Effect of Metformin and Lifestyle Interventions on Mortality in the Diabetes Prevention Program and Diabetes Prevention Program Outcomes Study. Diabetes Care, 44(12), 2775-2782. ",{"tag":"a","props":{"href":"https://doi.org/10.2337/dc21-1046","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.2337/dc21-1046"]},"（争议方）；Tuomilehto J, Lindström J, Eriksson JG, 等 (2001). Prevention of type 2 diabetes mellitus by changes in lifestyle among subjects with impaired glucose tolerance. NEJM, 344(18), 1343-1350. ",{"tag":"a","props":{"href":"https://doi.org/10.1056/NEJM200105033441801","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1056/NEJM200105033441801"]},"；Lindström J, Ilanne-Parikka P, Peltonen M, 等 (2006). Sustained reduction in the incidence of type 2 diabetes by lifestyle intervention: follow-up of the Finnish Diabetes Prevention Study. Lancet, 368(9548), 1673-1679. ",{"tag":"a","props":{"href":"https://doi.org/10.1016/S0140-6736(06)69701-8","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1016/S0140-6736(06)69701-8"]},"；Uusitupa M, Peltonen M, Lindström J, 等 (2009). Ten-year mortality and cardiovascular morbidity in the Finnish Diabetes Prevention Study—secondary analysis of the randomized trial. PLoS ONE, 4(5), e5656. ",{"tag":"a","props":{"href":"https://doi.org/10.1371/journal.pone.0005656","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1371/journal.pone.0005656"]},"（争议方）；健康中国行动推进委员会 (2019). 健康中国行动（2019—2030年），（十四）糖尿病防治行动（湖南省卫生健康委员会转载）. ",{"tag":"a","props":{"href":"https://wjw.hunan.gov.cn/wjw/ztzl/knowledge/tzggzcfg/202003/t20200303_11359594.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://wjw.hunan.gov.cn/wjw/ztzl/knowledge/tzggzcfg/202003/t20200303_11359594.html"]},""]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["原书备注"]},{"tag":"p","props":{"className":"life-citations"},"children":["争议。三项试验都看到得糖尿病的人少了、得的时间晚了。但能不能少死，只有大庆试验看到了。大庆只有 577 人，作者自己也说人数少，因为试验本来是为看糖尿病设计的。美国 DPP 试验结束后，每个人都被请去上了改过的生活方式课，安慰剂组也不例外。芬兰试验的作者写明，人数可能不够，看不出小的差别。所以推迟糖尿病是确定的，延寿还没有定论。美国和芬兰试验里的人平均体重指数在 30 以上。大庆的人平均只有 25.7。试验只劝体重指数超过 25 的人减重，体重也没减多少。作者认为主要靠改吃法和多动。所以不胖的人也照样要改吃法、多动。先停掉甜饮料，见本节第 7 条（不喝含糖饮料）。运动量够不够，对照本节第 11 条（每天走到 7000–8000 步）。体重减到哪儿，对照本节第 32 条（把 BMI 控制在 20–25）。怎么查出来，见第 1 节第 8 条（查一次空腹血糖）。二甲双胍也能少得糖尿病，但效果不如改生活方式，要不要吃由医生定。收益量级按大庆总死亡率低约 26% 定为大，但美国和芬兰的试验没有重复出来。本条受益人主要是你自己。"]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["我的备注"]},{"tag":"button","props":{"type":"button"},"children":["写下对自己有用的提醒…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/tip/02-44"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["上一条"]},"本来就想养狗的，把每天遛狗算进走路量，别为了长寿专门去养狗"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/tip/02-46"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["下一条"]},"家里的花生、玉米、坚果和米面发了霉，整包扔掉，别挑掉霉的吃剩下的；嚼到发苦的坚果马上吐掉"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["本主题的其他建议"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/02-03"},"children":[{"tag":"strong","props":{},"children":["戒烟别光靠忍，先去拿药：吃伐尼克兰的成功率能翻一倍多"]},{"tag":"span","props":{},"children":["吃伐尼克兰的人戒成的比例，是吃安慰剂的两倍多。用尼古丁贴片、咀嚼胶这类替代品的，比不用药的高五成左右。贴片和咀嚼胶一起用，还能再高两成多。"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/02-04"},"children":[{"tag":"strong","props":{},"children":["定一个戒烟日，到那天一次停掉，别先慢慢减"]},{"tag":"span","props":{},"children":["很多人打算先每天少抽几根，慢慢减到零。可到了第六个月，定好日子一次停掉的人里 22% 没再抽，慢慢减的只有 15.5%。所以定一个日子，到那天一次停掉。"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/02-05"},"children":[{"tag":"strong","props":{},"children":["去戒烟门诊，或者打 12320 问当地有没有戒烟服务"]},{"tag":"span","props":{},"children":["药和「有人定期问你」是两件事，合起来更管用。一边吃药一边有专人跟进的人，戒成的比例接近只听一句简短建议的人的两倍。电话也算：戒烟热线多次主动回访，成功率高两成半…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/02-06"},"children":[{"tag":"strong","props":{},"children":["已经戒不掉再考虑电子烟，本来不吸烟的人别碰"]},{"tag":"span","props":{},"children":["把烟换成含尼古丁的电子烟，戒成的人比用尼古丁替代品多约六成，这个结论很可靠。但长期吸的安全数据还不够，不能当成无害。这些试验比的都是想戒烟的人，本来不吸烟的人别…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/02-07"},"children":[{"tag":"strong","props":{},"children":["不喝含糖饮料，换成无糖的也不算解决"]},{"tag":"span","props":{},"children":["美国的研究里，每天喝两份以上甜饮料的人，同期死亡的概率比几乎不喝的人高约两成。每天一到两份的，也高一成多。换成无糖的也没见着好处：每天喝两杯以上代糖饮料的人，反…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/02-08"},"children":[{"tag":"strong","props":{},"children":["不嚼槟榔"]},{"tag":"span","props":{},"children":["嚼槟榔的人，同期死亡的概率比不嚼的人高约两成。糖尿病和代谢综合征的风险高约五成。口腔癌和食管癌的风险还要另算。"]}]}]}]},{"tag":"a","props":{"className":"life-text-link","href":"/book/02"},"children":["阅读整个主题：不要慢慢死 ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"15","height":"15","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]}]}]},{"tag":"nav","props":{"className":"life-tabbar","aria-label":"主导航"},"children":[{"tag":"a","props":{"className":"","href":"/book"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"21","height":"21","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-book-open","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M12 7v14"},"children":[]},{"tag":"path","props":{"d":"M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z"},"children":[]}]},{"tag":"span","props":{},"children":["全书"]}]},{"tag":"a","props":{"className":"","href":"/top-50"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"21","height":"21","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-star","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.5