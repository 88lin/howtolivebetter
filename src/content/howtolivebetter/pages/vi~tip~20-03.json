a-hidden":"true"},"children":[{"tag":"path","props":{"d":"M18 20a6 6 0 0 0-12 0"},"children":[]},{"tag":"circle","props":{"cx":"12","cy":"10","r":"4"},"children":[]},{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},{"tag":"span","props":{},"children":["Đăng nhập để đồng bộ hóa"]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/vi/book/20"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"Quay lại mục lục"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["Chăm trẻ mới sinh"]},{"tag":"nav","props":{"aria-label":"Các mục trong chương"},"children":[{"tag":"a","props":{"href":"/vi/tip/20-01"},"children":[{"tag":"span","props":{},"children":["01"]},"Cho trẻ trong giai đoạn nhũ nhi nằm ngửa khi ngủ trên mặt phẳng chắc, cùng phòng khác giường và không để đồ mềm trên giường"]},{"tag":"a","props":{"href":"/vi/tip/20-02"},"children":[{"tag":"span","props":{},"children":["02"]},"Tiêm mũi đầu tiên vaccine viêm gan B trong vòng 24 giờ sau khi sinh"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/vi/tip/20-03","data-status":"active"},"children":[{"tag":"span","props":{},"children":["03"]},"Tiêm đủ các loại vaccine trong lịch tiêm chuẩn của quốc gia, toàn bộ miễn phí, lỡ mất thì chỉ bù những liều chưa tiêm"]},{"tag":"a","props":{"href":"/vi/tip/20-04"},"children":[{"tag":"span","props":{},"children":["04"]},"Sáu tháng đầu chỉ cho bú mẹ, không cần cho uống nước, từ 6 tháng thêm thức ăn dặm và tiếp tục cho bú mẹ"]},{"tag":"a","props":{"href":"/vi/tip/20-05"},"children":[{"tag":"span","props":{},"children":["05"]},"Pha sữa công thức bằng nước trên 70 ℃, pha xong để nguội rồi cho uống, phần còn lại thì đổi đi"]},{"tag":"a","props":{"href":"/vi/tip/20-06"},"children":[{"tag":"span","props":{},"children":["06"]},"Không cho con dưới 1 tuổi ăn mật ong"]},{"tag":"a","props":{"href":"/vi/tip/20-07"},"children":[{"tag":"span","props":{},"children":["07"]},"Mũi tiêm vitamin K lúc sinh nhất định phải tiêm"]},{"tag":"a","props":{"href":"/vi/tip/20-08"},"children":[{"tag":"span","props":{},"children":["08"]},"Trẻ dưới 3 tháng tuổi, nhiệt độ chạm 38 ℃ thì đi bệnh viện luôn, không quan sát ở nhà"]},{"tag":"a","props":{"href":"/vi/tip/20-09"},"children":[{"tag":"span","props":{},"children":["09"]},"Dù mệt mỏi, giận dữ đến đâu cũng đừng lắc đứa trẻ"]},{"tag":"a","props":{"href":"/vi/tip/20-10"},"children":[{"tag":"span","props":{},"children":["10"]},"Bỉ thì không xem nhãn hiệu, xem ba điều: vừa thân không, có thay đủ tần suất không, có bị thông báo kiểm tra mẫu rồi không"]},{"tag":"a","props":{"href":"/vi/tip/20-11"},"children":[{"tag":"span","props":{},"children":["11"]},"Với đồ lớn thì cứ theo thứ tự 「mượn, mua đồ cũ, mua mới」, đừng mua đủ một lần"]},{"tag":"a","props":{"href":"/vi/tip/20-12"},"children":[{"tag":"span","props":{},"children":["12"]},"Con bị eczema nặng hoặc dị ứng trứng, đừng né đậu phộng, sớm thêm theo hướng dẫn của bác sĩ, nhưng tuyệt đối không cho ăn hạt cả nguyên"]},{"tag":"a","props":{"href":"/vi/tip/20-13"},"children":[{"tag":"span","props":{},"children":["13"]},"Canh mấy dấu hiệu vàng da ở trẻ sơ sinh: vàng trong 24 giờ đầu sau khi sinh, vàng đậm dần, gọi không dậy không bú, phân màu trắng thì trong ngày đó đi bệnh viện"]},{"tag":"a","props":{"href":"/vi/tip/20-14"},"children":[{"tag":"span","props":{},"children":["14"]},"Ăn chay khi mang thai, cho con bú thì bổ sung vitamin B12 hằng ngày; thức ăn dặm của con phải có thực phẩm động vật, nhất quyết thuần chay thì hỏi bác sĩ trước"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"Breadcrumbs"},"children":[{"tag":"a","props":{"href":"/vi/book"},"children":["Khám phá cuốn sách"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/vi/book/20"},"children":["Chương 20"," ·"," ","Chăm trẻ mới sinh"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"20-03"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["03"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["Bằng chứng"," ","A"]}]},{"tag":"h1","props":{"lang":"vi"},"children":["Tiêm đủ các loại vaccine trong lịch tiêm chuẩn của quốc gia, toàn bộ miễn phí, lỡ mất thì chỉ bù những liều chưa tiêm"]},{"tag":"p","props":{"lang":"vi","className":"life-entry-summary"},"children":["Vaccine trong lịch tiêm chuẩn của quốc gia miễn phí suốt quá trình, cơ sở tiêm chủng không được thu tiền. Khi con vào nhà trẻ, vào trường, giấy chứng nhận tiêm chủng đều bị kiểm tra, mũi bị bỏ sót sẽ bị phát hiện và bù thêm. Lỡ mất thì chỉ bù những liều chưa tiêm, không phải tiêm lại từ đầu, đổi nhà sản xuất vẫn tiêm tiếp được. Với eczema, mề đay, viêm mũi dị ứng, hen suyễn, chỉ cần bệnh ổn định là tiêm bình thường, vàng da sơ sinh cũng vậy."]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Chi phí"]},{"tag":"p","props":{},"children":["Không tốn tiền. Luật viết rõ 「接种单位接种免疫规划疫苗不得收取任何费用」, tức c…"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Lợi ích"]},{"tag":"p","props":{},"children":["Khi con vào nhà trẻ, vào trường, cơ sở giáo dục và trường học phải kiểm tra giấy chứng nhận tiêm chủng. Phát h…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"Đánh dấu: Tiêm đủ các loại vaccine trong lịch tiêm chuẩn của quốc gia, toàn bộ miễn phí, lỡ mất thì chỉ bù những liều chưa tiêm"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"Hoàn tất"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"Kế hoạch thực hiện"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"Lưu"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Chia sẻ mẹo này"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Ẩn chi tiết"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Chi phí"]},{"tag":"p","props":{},"children":["Không tốn tiền. Luật viết rõ 「接种单位接种免疫规划疫苗不得收取任何费用」, tức cơ sở tiêm chủng không được thu bất kỳ khoản phí nào khi tiêm vaccine trong lịch tiêm chuẩn. Phải chạy vài lần phòng tiêm chủng theo đúng tuổi tháng. Giữ kỹ giấy chứng nhận tiêm chủng (预防接种证), đừng đánh mất"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Lợi ích"]},{"tag":"p","props":{},"children":["Khi con vào nhà trẻ, vào trường, cơ sở giáo dục và trường học phải kiểm tra giấy chứng nhận tiêm chủng. Phát hiện vaccine trong lịch tiêm chuẩn của quốc gia chưa tiêm đúng quy định thì phải báo cơ sở tiêm chủng, và phối hợp thúc giám hộ bổ sung. Vì vậy những mũi bỏ sót không thể kéo dài, khi vào trường chắc chắn bị kiểm tra ra. Hiện áp dụng là phiên bản 2026. Vaccine viêm gan C và virus gây u nhú (HPV) đã được đưa vào lịch tiêm chuẩn của quốc gia. Vaccine bạch hậu, ho gà, u dị và tải đổi tuổi bắt đầu tiêm từ 3 tháng tuổi thành 2 tháng tuổi, tổng cộng 5 liều, mỗi liều tiêm 1 lần ở 2 tháng tuổi, 4 tháng tuổi, 6 tháng tuổi, 18 tháng tuổi và 6 tuổi. Trẻ đúng tuổi ở Tây Tạng, Thanh Hải, Tân Cương và Binh đoàn Xây dựng Thủ công Tân Cương, từ tháng 3 năm 2026 cũng tiêm vaccine viêm não Nhật Bản thường quy. Một số vaccine có thể tiêm cùng một ngày: các vaccine trong lịch tiêm chuẩn của quốc gia ở giai đoạn hiện tại đều có thể tiêm đồng thời theo lịch tiêm hoặc theo nguyên tắc bù liều. Vaccine tiêm bắp từ hai loại trở lên phải tiêm ở các vị trí khác nhau, 「严禁将两种或多种疫苗混合吸入同一支注射器内接种」, cấm tuyệt đối trộn hai hay nhiều vaccine vào cùng một bơm tiêm để tiêm. Vaccine mũi tiêm không tiêm cùng ngày, giữa các vaccine giảm độc liều sống tiêm bắp từ hai loại trở lên phải cách nhau không dưới 28 ngày. Khoảng cách giữa vaccine bất hoạt, vaccine giảm độc liều sống dạng uống và vaccine khác không bị hạn chế. Nguyên tắc bù liều cho trẻ dưới 18 tuổi là càng sớm càng tốt, 「只需补种未完成的剂次，无需重新开始全程接种」, tức chỉ cần bù phần liều chưa hoàn thành, không phải tiêm lại toàn bộ, cùng một loại vaccine đổi nhà sản xuất thì tiêm tiếp được (toàn quốc, phiên bản 2026)"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Nguồn gốc"]},{"tag":"p","props":{"className":"life-citations"},"children":["全国人大常委会 (2019). 疫苗管理法（第四十八、四十九条）. ",{"tag":"a","props":{"href":"http://ynswsjkw.yn.gov.cn/html/2019/faguiguizhangxin_0731/6509.html","target":"_blank","rel":"noopener noreferrer"},"children":["http://ynswsjkw.yn.gov.cn/html/2019/faguiguizhangxin_0731/6509.html"]},"（云南省卫生健康委员会转载）；国家疾病预防控制局、国家卫生健康委 (2026). 《国家免疫规划疫苗儿童免疫程序及说明（2026 年版）》解读问答. ",{"tag":"a","props":{"href":"https://www.ndcpa.gov.cn/jbkzzx/c100013/common/content/content_2073002930292035584.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.ndcpa.gov.cn/jbkzzx/c100013/common/content/content_2073002930292035584.html"]}]},{"tag":"a","props":{"href":"http://ynswsjkw.yn.gov.cn/html/2019/faguiguizhangxin_0731/6509.html","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Liên kết mở nguồn"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Ghi chú sách"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["Hiểu lầm phổ biến nhất là 「孩子体质不好，先别打」, tức con có thể chất yếu, thôi chưa tiêm. Cách hiểu chính thức là: cái gọi là 「过敏性体质」, người trong nhà có bệnh dị ứng, con trước đây từng dị ứng với thức ăn hoặc thuốc, đều không phải lý do không tiêm. Viêm da cơ địa (eczema), mề đay, viêm mũi dị ứng, hen phế quản, chỉ cần bệnh ổn định là tiêm bình thường. Đang uống thuốc chống dị ứng, hoặc đang dùng corticoid dạng hít, vẫn tiêm được. Vàng da sinh lý và vàng da do sữa mẹ ở trẻ sơ sinh cũng tiêm bình thường. Chỉ có hai trường hợp thật sự không tiêm: trước đây từng bị phản ứng dị ứng nặng cấp thỉnh khi tiêm cùng một loại vaccine, hoặc dị ứng nặng với một thành phần đã biết có trong vaccine. Trẻ bị suy giảm miễn nhiễm, cùng trẻ đang hóa trị, xạ trị hoặc đang dùng thuốc ức chế miễn dịch, phải đánh giá riêng từng trẻ, đến phòng tiêm chủng nói rõ tình hình rồi mới quyết định. Xem mục 2 của phần này về mũi vaccine viêm gan B đầu tiên. Vaccine ngoài lịch tiêm chuẩn, do người dân tự trả, thu thêm tiền vaccine và phí dịch vụ tiêm, không liên quan đến phần miễn phí nói ở đây."]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Ghi chú của tôi"]},{"tag":"button","props":{"type":"button"},"children":["Viết một lời nhắc cho chính bạn…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/vi/tip/20-02"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Trước"]},"Tiêm mũi đầu tiên vaccine viêm gan B trong vòng 24 giờ sau khi sinh"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/vi/tip/20-04"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Tiếp theo"]},"Sáu tháng đầu chỉ cho bú mẹ, không cần cho uống nước, từ 6 tháng thêm thức ăn dặm và tiếp tục cho bú mẹ"]},{"tag":"svg","props":{