keLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"收起详情"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["成本"]},{"tag":"p","props":{"className":"life-citations"},"children":["不花钱，也不花时间。只要记住一点：这些数字说的是已婚的人里死亡率更低，是两件事同时出现，不是结婚让你活得久。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["收益"]},{"tag":"p","props":{"className":"life-citations"},"children":["一项针对老年人的荟萃分析，把多项研究汇总重算，共 53 组比较、25 万余人。已婚相对非婚的全因死亡 RR 0.88，95% CI 0.85–0.91（RR 是风险比，CI 是可信范围），同期死亡的概率低约 12%。同一项里丧偶 1.11、离异或分居 1.16、未婚 1.11，分别高约 11%、16%、11%。男女无差异。最保守的估计是 RR 0.94，只低约 6%。另一项荟萃分析比的是未婚（从未结婚）相对已婚，用了 95 篇文献、5 亿余人。结果 HR 1.24（1.19–1.30），同期死亡的概率高约 24%。而且年纪越大，差距越小。还有一项按性别拆的荟萃分析，21 项研究、789 万余人：不论男女，非婚都与总死亡、癌症死亡、心血管死亡同时出现。男性这边的心血管死亡和总死亡差距更大。未婚男性相对未婚女性，卒中死亡多 31%，全因死亡多 9%"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["来源"]},{"tag":"p","props":{"className":"life-citations"},"children":["Manzoli L, et al. (2007). Marital status and mortality in the elderly: a systematic review and meta-analysis. Soc Sci Med 64:77–94. ",{"tag":"a","props":{"href":"https://doi.org/10.1016/j.socscimed.2006.08.031","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1016/j.socscimed.2006.08.031"]},"；Roelfs DJ, et al. (2011). The rising relative risk of mortality for singles: meta-analysis and meta-regression. Am J Epidemiol 174(4):379–389. ",{"tag":"a","props":{"href":"https://doi.org/10.1093/aje/kwr111","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1093/aje/kwr111"]},"；Wang Y, et al. (2020). Sex differences in the association between marital status and the risk of cardiovascular, cancer, and all-cause mortality: a systematic review and meta-analysis of 7,881,040 individuals. Glob Health Res Policy 5:4. ",{"tag":"a","props":{"href":"https://doi.org/10.1186/s41256-020-00133-8","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1186/s41256-020-00133-8"]},""]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["原书备注"]},{"tag":"p","props":{"className":"life-citations"},"children":["争议在于结婚的人本来就是被挑过的：健康、收入高、社交多的人，既更容易结婚，也更容易活得久。三项荟萃用的都是现成人群的观察数据，只是跟踪记录，没有分组对照。作者自己也写了有发表偏倚或方法局限。Roelfs 还发现研究做得越严谨，算出的差距越小。这些数字以欧美人群为主，对国内只能当量级参考"]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["我的备注"]},{"tag":"button","props":{"type":"button"},"children":["写下对自己有用的提醒…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/tip/10-07"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["上一条"]},"先看登记数据再听长辈：结婚率、离婚率各是什么口径"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/tip/10-09"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["