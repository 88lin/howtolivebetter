 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"收藏"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"分享这条建议"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"收起详情"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["成本"]},{"tag":"p","props":{"className":"life-citations"},"children":["不花钱。要建一条固定流程：收到通知、转给卖家、收卖家的申辩、把结果公示出来。每一步都留档"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["收益"]},{"tag":"p","props":{"className":"life-citations"},"children":["权利人「有权通知电子商务平台经营者采取删除、屏蔽、断开链接、终止交易和服务等必要措施。通知应当包括构成侵权的初步证据」。权利人就是商标、著作权、专利这些权利的主人。光发一句话不算，要附上初步证据。平台接到通知后，「应当及时采取必要措施，并将该通知转送平台内经营者；未及时采取必要措施的，对损害的扩大部分与平台内经营者承担连带责任」。你拖着不处理，多出来的那部分损失，你要和卖家一起赔。卖家申辩之后，平台「在转送声明到达知识产权权利人后十五日内，未收到权利人已经投诉或者起诉通知的，应当及时终止所采取的措施」。意思是把卖家的申辩转给权利人，等 15 天。对方既没投诉也没起诉，就把删掉、下架的恢复回去。平台知道或者应当知道有侵权却不处理的，与侵权人承担连带责任。知识产权部门还可以责令你限期改正，逾期不改的罚 5 万到 50 万元，情节严重的罚 50 万到 200 万元。反过来，「恶意发出错误通知，造成平台内经营者损失的，加倍承担赔偿责任」（全国）"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["来源"]},{"tag":"p","props":{"className":"life-citations"},"children":["全国人大常委会 (2018). 电子商务法（第四十二、四十三、四十四、四十五、八十四条）. ",{"tag":"a","props":{"href":"https://flk.npc.gov.cn/detail?id=2c909fdd678bf17901678bf8af050b81","target":"_blank","rel":"noopener noreferrer"},"children":["https://flk.npc.gov.cn/detail?id=2c909fdd678bf17901678bf8af050b81"]}," ; 全国人大 (2020). 民法典（第一千一百九十五、一千一百九十六、一千一百九十七条）. ",{"tag":"a","props":{"href":"https://www.court.gov.cn/zixun/xiangqing/233181.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.court.gov.cn/zixun/xiangqing/233181.html"]},""]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["原书备注"]},{"tag":"p","props":{"className":"life-citations"},"children":["你不是电商平台，只是一般网站，那就走民法典的通知删除规则。区别在于对方申辩之后你要等多久：电商法给了明确的 15 日，民法典只写「合理期限」。另外，把收到的通知、卖家的申辩和你的处理结果公示出来，是电商法第四十四条的明文要求。平台自己组织上传盗版，或者明知侵权还放着不管，「收到通知就删」这条规则护不住它。见第 9 节第 24 条（汉化漫画、搬运影视剧）"]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["我的备注"]},{"tag":"button","props":{"type":"button"},"children":["写下对自己有用的提醒…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/tip/26-08"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["上一条"]},"不给未满 16 周岁的人开直播，打赏按年龄分档处理"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/tip/26-10"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["下一条"]},"用户信息不要随手放到境外，出境有法定条件和人数门槛"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["本主题的其他建议"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/26-03"},"children":[{"tag":"strong","props":{},"children":["做直播要网络文化经营许可证，做视听节目的那张证民营基本拿不到"]},{"tag":"span","props":{},"children":["做直播、做游戏解说，要省级文化部门发的网络文化经营许可证，经营范围里得写明网络表演。受理后 20 日内出结果，证管 3 年。播过的视频自己要留满 60 天。没办…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/26-04"},"children":[{"tag":"strong","props":{},"children":["服务器放境内就要备案，App 和小程序上架前也要备案，接入商必须自己持有增值电信许可"]},{"tag":"span","props":{},"children":["服务器放在境内，开站前就要备案，不花钱，一般几天到几周。没备案先责令改正、罚 1 万元，不改就关站。App 和小程序也要先备案，没备案的，应用商店和小程序平台不…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/26-05"},"children":[{"tag":"strong","props":{},"children":["让用户上来卖东西，平台就要核验登记、报送信息、留存三年"]},{"tag":"span","props":{},"children":["让别人上你的平台卖东西，你就要先核卖家的身份、地址、联系方式和许可证，再登记建档。建完档，至少每六个月回头再核一次。卖家是谁要报给市场监管，纳税的情况每季度报给…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/26-06"},"children":[{"tag":"strong","props":{},"children":["用户发的内容你要管：审核机制、举报入口、发现违法立即停传并报告"]},{"tag":"span","props":{},"children":["用户发的东西，平台要负责管，注册、发帖审核、评论审核、每天巡查、出事处置都要有制度。页面显眼的地方放举报入口。看到违法信息，马上停止传播、留好记录、报给主管部门…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/26-07"},"children":[{"tag":"strong","props":{},"children":["提供信息发布、即时通讯服务，必须要求用户提供真实身份信息"]},{"tag":"span","props":{},"children":["你的网站能发帖，或者能聊天，就要在用户开通服务时要他的真实身份信息。不给的，不能让他用。直播的规定是后台存真名，页面上显示什么昵称由他自己定，可以用手机号核验。…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/26-11"},"children":[{"tag":"strong","props":{},"children":["选服务器先看停机能不能忍，再看有没有人运维，最后才比价"]},{"tag":"span","props":{},"children":["三档的差别不在价格，在出事那天你手上有什么。大厂有备案通道，资质公开，坏了有公告、有赔偿条款，能找到人。小服务商便宜一半，可它超售、跑路、被上游封掉的时候，你连…"]}]}]}]},{"tag":"a","props":{"className":"life-text-link","href":"/book/26"},"children":["阅读整个主题：做一个网站或平台：资质、备案和服务器 ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"15","height":"15","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]}]}]},{"tag":"nav","props":{"className":"life-tabbar","aria-label":"主导航"},"children":[{"tag":"a","props":{"className":"","href":"/book"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"21","height":"21","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-book-op