e":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"分享这条建议"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"收起详情"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["成本"]},{"tag":"p","props":{"className":"life-citations"},"children":["不花钱。平时留好上班的证据：工资流水、考勤、工牌、工作群聊天记录。单位不认就要申请劳动仲裁。仲裁不收费，受理后 45 天内结案，最多再延 15 天。不服的还能去法院，一审普通程序 6 个月起，律师费自己出。难在人还在这家干，开口要钱要顶住压力。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["收益"]},{"tag":"p","props":{"className":"life-citations"},"children":["劳动合同法规定，建立劳动关系要签书面劳动合同。上班当天没签的，要从上班那天起一个月内签。上班超过一个月、不满一年还没签的，单位要每月付你两倍的工资。实施条例写明了起止时间：从上班满一个月的第二天算起，到补签合同的前一天为止。上班满一年还没签的，双倍工资算到满一年的前一天，最多 11 个月。从满一年那天起，就当双方已经签了无固定期限劳动合同，单位要马上补签。无固定期限合同就是没有约定到期日的合同。2025 年 9 月起施行的最高法司法解释规定，双倍工资按月算，不满一个月的按实际工作日算。单位能证明没签是因为不可抗力，或者是你本人故意、重大过失不签的，不用付。上班第一个月内，单位书面通知你签、你不签的，单位可以书面通知终止劳动关系。这时单位不给经济补偿，只付你干了的那些天的工资。已经算作无固定期限合同的那段时间，再要双倍工资，法院不支持（全国）"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["来源"]},{"tag":"p","props":{"className":"life-citations"},"children":["全国人大常委会 (2012 修正). 劳动合同法（第十、十四、八十二条）. ",{"tag":"a","props":{"href":"https://fgk.chinatax.gov.cn/zcfgk/c100009/c5193025/content.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://fgk.chinatax.gov.cn/zcfgk/c100009/c5193025/content.html"]},"（国家税务总局政策法规库转载）；国务院 (2008). 劳动合同法实施条例（国务院令第 535 号，第五、六、七条）. ",{"tag":"a","props":{"href":"https://www.gov.cn/gongbao/content/2008/content_1107604.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/gongbao/content/2008/content_1107604.htm"]},"；最高人民法院 (2025). 关于审理劳动争议案件适用法律问题的解释（二）（法释〔2025〕12 号，第六、七、九条）. ",{"tag":"a","props":{"href":"https://www.court.gov.cn/zixun/xiangqing/472691.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.court.gov.cn/zixun/xiangqing/472691.html"]},"；最高人民法院 (2023). 关于审理劳动争议案件适用法律问题的解释（二）（征求意见稿，第四条）. ",{"tag":"a","props":{"href":"https://www.court.gov.cn/zixun/xiangqing/420002.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.court.gov.cn/zixun/xiangqing/420002.html"]},"；北京市高级人民法院、北京市劳动人事争议仲裁委员会 (2024). 关于审理劳动争议案件解答（一）（京高法发〔2024〕534 号，第 41 问、第 42 问）. ",{"tag":"a","props":{"href":"https://www.beijing.gov.cn/zhengce/fygfxwj/202405/t20240530_3699652.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.beijing.gov.cn/zhengce/fygfxwj/202405/t20240530_3699652.html"]},"；全国人大常委会 (2007). 劳动争议调解仲裁法（第二十七、四十三、五十三条）. ",{"tag":"a","props":{"href":"https://rsj.ankang.gov.cn/Content-2150407.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://rsj.ankang.gov.cn/Content-2150407.html"]},"（安康市人力资源和社会保障局转载）；国务院 (2006). 诉讼费用交纳办法（国务院令第 481 号，第六、十三条）. ",{"tag":"a","props":{"href":"https://www.gov.cn/ziliao/flfg/2006-12/29/content_483682.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/ziliao/flfg/2006-12/29/content_483682.htm"]},""]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["原书备注"]},{"tag":"p","props":{"className":"life-citations"},"children":["多拿的那一份工资要在多久内去要，最高法没有定全国口径。2023 年的征求意见稿写过一条时效规则，2025 年正式公布的解释里没有保留。北京的口径是，多出来的那一份适用 1 年的仲裁时效。从你提出要求那天往前倒推一年，按日算。各地算法不完全一样，但拖得越久，能要回的月数越少。所以在职时或者离职后，尽快申请仲裁。仲裁时效的一般规则见第 8 节第 19 条（维权有期限）。补签合同时把日期倒签到上班第一天的，北京的口径是一般不再支持双倍工资。除非你能证明，补签不是你自愿的。从单位一侧看这件事，见第 12 节第 16 条（用人第一个月内签书面合同）。"]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["我的备注"]},{"tag":"button","props":{"type":"button"},"children":["写下对自己有用的提醒…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/tip/19-19"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["上一条"]},"换城市工作时，把养老和医保关系转到新参保地，缴费年限接着累计，别办退保"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/tip/19-21"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["下一条"]},"单位不交或少交社保，先投诉让它补缴；想因此辞职拿经济补偿，辞职通知里要写明是因为单位没依法缴社保"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["本主题的其他建议"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/19-03"},"children":[{"tag":"strong","props":{},"children":["试用期有法定上限、工资不得低于 80%，而且只能约定一次"]},{"tag":"span","props":{},"children":["合同签 3 个月到 1 年的，试用期最多 1 个月，签 1 到 3 年的最多 2 个月，签 3 年以上的最多 6 个月。同一家公司只能试用你一次，转正后调个岗再…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/19-04"},"children":[{"tag":"strong","props":{},"children":["被裁先算清 N：每满一年一个月工资，不满六个月按半个月"]},{"tag":"span","props":{},"children":["被裁时公司要给的经济补偿这样算：干满一年给一个月工资，满半年不满一年按一年算，不满半年给半个月。这里的月工资是走人前 12 个月的平均数，奖金、津贴、补贴都要算…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/19-05"},"children":[{"tag":"strong","props":{},"children":["公司以病后干不了、不胜任或情况大变为由辞退你，没提前 30 天通知的，还要多付一个月工资"]},{"tag":"span","props":{},"children":["公司因为你病后干不了、干不了工作或者情况大变而辞退你，要提前 30 天书面通知。没通知的，要在 N 之外再多给一个月工资，这就是常说的 N+1。谈的时候把这一个…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/19-06"},"children":[{"tag":"strong","props":{},"children":["公司违法解除的，赔偿金是经济补偿标准的二倍"]},{"tag":"span","props":{},"children":["公司属于违法解除的，赔偿金按经济补偿的标准翻倍，就是常说的 2N。是不是违法解除要看具体情形。先找法律援助或者律师问清楚，再决定是跟公司谈，还是去仲裁。"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/19-07"},"children":[{"tag":"strong","props":{},"children":["不要签「个人原因主动辞职」，那一签就没有 N 了"]},{"tag":"span","props":{},"children":["签字承认「个人原因主动辞职」，经济补偿和失业保险金通常一起落空。自己提出离职，本来就不在给补偿的那几种情形里，公司欠薪、不缴社保这类过错除外。不必当天签，冷静一…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/19-08"},"children":[{"tag":"strong","props":{},"children":["离职前把工资条、考勤、劳动合同、社保记录和聊天记录先存下来"]},{"tag":"span","props":{},"children":["辞退、扣工资这类争议由单位举证，但加班要你先证明，单位的工资记录也只需要留两年。电脑和账号一交回去，这些材料就拿不到了。手里有工资条、考勤、社保记录和聊天原始记…"]}]}]}]},{"tag":"a","props":{"className":"life-text-link","href":"/book/19"},"children":["阅读整个主题：在职、离职和工伤 ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"15","height":"15","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]}]}]},{"tag":"nav","props":{"className":"life-tabbar","aria-label":"主导航"},"children":[{"tag":"a","props":{"className":"","href":"/book"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"21","height":"21","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-book-open","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M12 7v14"},"children":[]},{"tag":"path","props":{"d":"M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z"},"children":[]}]},{"tag":"span","props":{},"children":["全书"]}]},{"tag":"a","props":{"className":"","href":"/top-50"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"21","height":"21","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lu