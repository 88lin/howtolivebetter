","props":{"className":"life-ad-rail","data-dock-active":"false","style":{"top":"94px"}},"children":[{"tag":"div","props":{"className":"life-ad-dock","hidden":true},"children":[{"tag":"aside","props":{"className":"life-ad-space life-ad-space-sponsored life-ad-space-compact","data-ad-placement":"ad_dock","data-ad-group":"reading","data-ad-creative":"read_product","data-ad-ready":"false","aria-label":"Реклама · Рекомендация сообщества"},"children":[{"tag":"button","props":{"type":"button","className":"life-ad-dismiss","aria-label":"Закрыть рекламу"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-x","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M18 6 6 18"},"children":[]},{"tag":"path","props":{"d":"m6 6 12 12"},"children":[]}]}]},{"tag":"div","props":{"className":"life-ad-space-brand"},"children":[{"tag":"img","props":{"src":"/sites/howtolivebetter/images/shengcai/logo.png","width":"565","height":"144","alt":"Официальный логотип Shengcai Youshu","decoding":"async"},"children":[]}]},{"tag":"div","props":{"className":"life-ad-space-copy"},"children":[{"tag":"span","props":{"className":"life-ad-space-label"},"children":["Реклама · Рекомендация сообщества"]},{"tag":"strong","props":{},"children":["Могут ли ваши знания стать полезным продуктом?"]},{"tag":"p","props":{},"children":["От электронных книг до инструментов: как участники находят потребности и создают то, чем можно пользоваться."]}]},{"tag":"div","props":{"className":"life-ad-space-actions"},"children":[{"tag":"a","props":{"className":"life-ad-space-link","href":"/ru/shengcaiyoushu?sc_group=reading&sc_creative=read_product&sc_placement=ad_dock"},"children":["О сообществе и примерах",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"18","height":"18","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-up-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M7 7h10v10"},"children":[]},{"tag":"path","props":{"d":"M7 17 17 7"},"children":[]}]}]}]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/ru/book/12"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"К содержанию"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["Открытие бизнеса: как не потерять все сбережения"]},{"tag":"div","props":{"data-ad-dock-host":"true"},"children":[]},{"tag":"nav","props":{"aria-label":"Советы главы"},"children":[{"tag":"a","props":{"href":"/ru/tip/12-01"},"children":[{"tag":"span","props":{},"children":["01"]},"Инвестируйте только те средства, которые можете позволить себе потерять — не трогайте семейные сбережения и не берите кредиты"]},{"tag":"a","props":{"href":"/ru/tip/12-02"},"children":[{"tag":"span","props":{},"children":["02"]},"Не ставьте личную гарантию за компанию, а супругу тем более не вовлекайте"]},{"tag":"a","props":{"href":"/ru/tip/12-03"},"children":[{"tag":"span","props":{},"children":["03"]},"Правильный выбор формы бизнеса до открытия: при индивидуальном предпринимательстве и обычном партнерстве ответственность неограниченна, а в ООО она «ограничена»"]},{"tag":"a","props":{"href":"/ru/tip/12-04"},"children":[{"tag":"span","props":{},"children":["04"]},"Неправомерное включение в число акционеров — риск нести чужие долги"]},{"tag":"a","props":{"href":"/ru/tip/12-05"},"children":[{"tag":"span","props":{},"children":["05"]},"Перед подписанием договора проверьте наличие регистрации в Министерстве коммерции и получите письменную информацию; обязательно включите в договор условие о «периоде раздумий»"]},{"tag":"a","props":{"href":"/ru/tip/12-06"},"children":[{"tag":"span","props":{},"children":["06"]},"Перед регистрацией нужно определить название, место ведения бизнеса, сферу деятельности и размер уставного капитала — при наличии всех документов бизнес-лицензию выдадут сразу"]},{"tag":"a","props":{"href":"/ru/tip/12-07"},"children":[{"tag":"span","props":{},"children":["07"]},"Бизнес, требующий лицензии: начинать работу можно только после её получения"]},{"tag":"a","props":{"href":"/ru/tip/12-08"},"children":[{"tag":"span","props":{},"children":["08"]},"Определите, к какой категории вы относитесь: для производства продуктов питания и ресторанного бизнеса требуется разрешение, для продажи только готовой упакованной продукции достаточно регистрации, а для продажи свежих овощей и мяса разрешение не нужно"]},{"tag":"a","props":{"href":"/ru/tip/12-09"},"children":[{"tag":"span","props":{},"children":["09"]},"Упаковка продукта делает его предварительно упакованной пищевой продукцией: на этикетке обязательно указываются дата производства, срок годности и состав"]},{"tag":"a","props":{"href":"/ru/tip/12-10"},"children":[{"tag":"span","props":{},"children":["10"]},"На обычные продукты питания нельзя указывать, что они лечат болезни: это касается этикеток, инструкций, рекламы и текстов для прямых трансляций"]},{"tag":"a","props":{"href":"/ru/tip/12-11"},"children":[{"tag":"span","props":{},"children":["11"]},"В этой сфере действуют уголовные нормы: продажа мяса от больных животных или продукции с превышенным содержанием вредных веществ уже является преступлением; добавление в пищу токсичных и вредных веществ влечет наказание от 5 лет лишения свободы независимо от суммы оборота"]},{"tag":"a","props":{"href":"/ru/tip/12-12"},"children":[{"tag":"span","props":{},"children":["12"]},"После получения бизнес-лицензии возникает обязанность по подаче налоговой отчетности; даже при отсутствии дохода её нужно подавать с нуля (заполняя все поля нулями)"]},{"tag":"a","props":{"href":"/ru/tip/12-13"},"children":[{"tag":"span","props":{},"children":["13"]},"Счета-фактуры выписываются только по реальным сделкам; малые предприятия могут полностью освободиться от НДС"]},{"tag":"a","props":{"href":"/ru/tip/12-14"},"children":[{"tag":"span","props":{},"children":["14"]},"Мошенники выдают себя за сотрудников налоговой службы и требуют оплаты и подачи деклараций; на самом деле это обман. Официальные каналы для налоговых дел — электронная налоговая система и горячая линия 12366"]},{"tag":"a","props":{"href":"/ru/tip/12-15"},"children":[{"tag":"span","props":{},"children":["15"]},"При написании «задаток» вместо «предоплата» соблюдайте правила двойного возврата, четко пропишите размер неустойки, а предоставление отсрочки платежа рассматривайте как выдачу займа"]},{"tag":"a","props":{"href":"/ru/tip/12-16"},"children":[{"tag":"span","props":{},"children":["16"]},"Заключение письменного трудового договора в первый месяц работы и регистрация в соцстрахе в течение 30 дней"]},{"tag":"a","props":{"href":"/ru/tip/12-17"},"children":[{"tag":"span","props":{},"children":["17"]},"Зарплата выплачивается согласно договору и закону; повышения, займы и премии оформляются письменно"]},{"tag":"a","props":{"href":"/ru/tip/12-18"},"children":[{"tag":"span","props":{},"children":["18"]},"Продавать сначала, а потом производить: проверить спрос через предзаказы и мелкие заказы, прежде чем вкладывать средства в производство"]},{"tag":"a","props":{"href":"/ru/tip/12-19"},"children":[{"tag":"span","props":{},"children":["19"]},"Сначала сверяем образец с перечнем требований для массового производства, а потом приступаем к запуску"]},{"tag":"a","props":{"href":"/ru/tip/12-20"},"children":[{"tag":"span","props":{},"children":["20"]},"Сохраняйте документы и эти поставщика; не закупайте товары по цене, значительно ниже рыночной: если сотрудник привез подделку, ответственность несет руководитель"]},{"tag":"a","props":{"href":"/ru/tip/12-21"},"children":[{"tag":"span","props":{},"children":["21"]},"Для товаров, упаковки, этикеток и рекламных изображений нужно либо создавать графику самостоятельно, либо покупать лицензию; изменение цвета или добавление своего значка не считается «изменением»"]},{"tag":"a","props":{"href":"/ru/tip/12-22"},"children":[{"tag":"span","props":{},"children":["22"]},"Соблюдение установленных правил на рабочем месте и чёткое понимание ответственности при проявлении доброй воли вне этих рамок"]},{"tag":"a","props":{"href":"/ru/tip/12-23"},"children":[{"tag":"span","props":{},"children":["23"]},"Если убытки — действуйте по процедуре: при возможности проводите упрощённую ликвидацию, а если активы не покрывают долги — подавайте на банкротство, не оставляйте дело без внимания"]},{"tag":"a","props":{"href":"/ru/tip/12-24"},"children":[{"tag":"span","props":{},"children":["24"]},"Прежде чем тратить деньги на аутсорсинг управления интернет-магазином, курсы по открытию магазина или схему «без собственного товара», выясните, потребуются ли дополнительные расходы и откуда возьмётся продажная статистика"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/ru/tip/12-25","data-status":"active"},"children":[{"tag":"span","props":{},"children":["25"]},"Компании и индивидуальные предприниматели в Китае ежегодно с 1 января по 30 июня подают онлайн отчёт за прошлый год, даже без деятельности; отчёт бесплатен"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"Навигация"},"children":[{"tag":"a","props":{"href":"/ru/book"},"children":["Книга"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/ru/book/12"},"children":["Глава 12"," ·"," ","Открытие бизнеса: как не потерять все сбережения"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"12-25"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["25"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["Доказательства"," ","A"]}]},{"tag":"h1","props":{"lang":"ru"},"children":["Компании и индивидуальные предприниматели в Китае ежегодно с 1 января по 30 июня подают онлайн отчёт за прошлый год, даже без деятельности; отчёт бесплатен"]},{"tag":"p","props":{"lang":"ru","className":"life-entry-summary"},"children":["В первой половине года компании и индивидуальные предприниматели подают онлайн годовой отчёт за прошлый год. Иначе попадают в перечень аномально действующих; после подачи пропущенного отчёта можно просить исключения. Отчёт бесплатен. Звонящие с требованием заплатить за пропуск через мини-программу или публичный аккаунт — мошенники; за такое уже давали больше 10 лет тюрьмы. Сначала сами проверьте официальную систему."]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Затраты"]},{"tag":"p","props":{},"children":["Бесплатно. Раз в год заполните отчёт в Государственной сис…"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Польза"]},{"tag":"p","props":{},"children":["Компании в Китае с 1 января по 30 июня ежегодно подают и публикуют через Государственную систему раскрытия кре…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"Отметить: Компании и индивидуальные предприниматели в Китае ежегодно с 1 января по 30 июня подают онлайн отчёт за прошлый год, даже без деятельности; отчёт бесплатен"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"Сделано"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"В планах"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"В избранное"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Поделиться советом"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Скрыть подробности"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Затраты"]},{"tag":"p","props":{},"children":["Бесплатно. Раз в год заполните отчёт в Государственной системе раскрытия кредитной информации предприятий Китая. Индивидуальные предприниматели могут подать бумажный отчёт. Его получает рыночный регулятор, а месячные и квартальные налоговые декларации — налоговая служба. Налоги не заменяют годовой отчёт. Трудность — не забыть ежегодную обязанность."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Польза"]},{"tag":"p","props":{},"children":["Компании в Китае с 1 января по 30 июня ежегодно подают и публикуют через Государственную систему раскрытия кредитной информации предприятий годовой отчёт за предыдущий год для рыночного регулятора. Пропуск срока означает включение в перечень аномально действующих предприятий и предусмотренное законом административное наказание. Перечень общедоступен. Включённым предприятиям ограничивают или запрещают участие в госзакупках и строительных тендерах. Индивидуальные предприниматели подают отчёт в те же сроки, онлайн или на бумаге. Открывшиеся в текущем году начинают со следующего. Они выбирают, публиковать ли содержание, но за отсутствие отчёта тоже попадают в перечень. Подав пропущенные отчёты, можно обратиться к регулятору по месту регистрации за исключением из перечня. Если компания не отчётна 2 года подряд, не исправляется после включения в перечень и недоступна по зарегистрированному адресу, лицензию отзывают. Отчёты компаний публичны. Даже когда индивидуальный предприниматель не публикует содержание, система показывает факт подачи. Поэтому отчётность и нахождение в перечне можно проверить самостоятельно. Государственное управление рыночного регулирования предупреждает о звонках от лжерегуляторов: якобы отчёт просрочен, предприятие уже в перечне, надо найти определённую мини-программу или публичный аккаунт и заплатить посреднику. Управление подчёркивает: годовой отчёт бесплатен; подача и исключение из перечня — только через официальные каналы, например государственную систему. За такие схемы судят как за мошенничество. В деле суда уезда Цзиндэ провинции Аньхой агентство регистрации компаний велело операторам скрывать свою личность, чтобы предприниматели приняли их за регулятора. Через стороннюю мини-программу брали 98–398 юаней «за ручную подготовку материалов». Обмануты 10099 предпринимателей по стране, похищено более 3,19 млн юаней. Трое главных виновных получили от 10 лет 6 месяцев до 10 лет 8 месяцев. В деле суда района Наньху города Цзясин в мини-программе даже мелко было написано «подача бесплатна». Это не помешало обвинительному приговору: операторы намеренно скрывали возможность самостоятельной онлайн-подачи и выдумывали большие штрафы. Девять человек получили от 8 месяцев до 4 лет (по всему Китаю)."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Первоисточники"]},{"tag":"p","props":{"className":"life-citations"},"children":["国务院 (2024 修订). 企业信息公示暂行条例（国务院令第 777 号修订，第八、十八、十九条）. ",{"tag":"a","props":{"href":"https://flk.npc.gov.cn/detail?id=ff8081819c46fcc5019cd18fc6e9557d","target":"_blank","rel":"noopener noreferrer"},"children":["https://flk.npc.gov.cn/detail?id=ff8081819c46fcc5019cd18fc6e9557d"]},"（国家法律法规数据库）；市场监管总局 (2025). 关于修改《个体工商户年度报告办法》等四部规章的决定（市场监管总局令第 108 号，附重新公布的个体工商户年度报告办法第三、五、八、十、十三、十六条，企业经营异常名录管理办法第六、十一条）. ",{"tag":"a","props":{"href":"https://www.gov.cn/gongbao/2026/issue_12546/202602/content_7057451.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/gongbao/2026/issue_12546/202602/content_7057451.html"]},"；市场监管总局 (2023). @所有经营主体，这些都是假的（中国政府网部门动态转载，原发市场监管总局「市说新语」微信公众号）. ",{"tag":"a","props":{"href":"https://www.gov.cn/lianbo/bumen/202311/content_6917465.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/lianbo/bumen/202311/content_6917465.htm"]},"；市场监管总局 (2024). 市场监管总局发布提示：年报不收费，切勿受骗上当（滨州市市场监督管理局转载）. ",{"tag":"a","props":{"href":"http://amr.binzhou.gov.cn/art/2024/12/16/art_164869_10306521.html","target":"_blank","rel":"noopener noreferrer"},"children":["http://amr.binzhou.gov.cn/art/2024/12/16/art_164869_10306521.html"]},"；安徽省旌德县人民法院 (2025). 冒充市场监管人员以年审申报收费诈骗个体工商户案（无锡市市场监督管理局转载）. ",{"tag":"a","props":{"href":"https://scjgj.wuxi.gov.cn/doc/2025/03/20/4524579.shtml","target":"_blank","rel":"noopener noreferrer"},"children":["https://scjgj.wuxi.gov.cn/doc/2025/03/20/4524579.shtml"]},"；嘉兴市南湖区人民法院 (2024). 企业年报要费用？莫入「年报诈骗」陷阱. ",{"tag":"a","props":{"href":"http://nhcourt.gov.cn/art/2024/7/23/art_1217290_58718476.html","target":"_blank","rel":"noopener noreferrer"},"children":["http://nhcourt.gov.cn/art/2024/7/23/art_1217290_58718476.html"]}]},{"tag":"a","props":{"href":"https://flk.npc.gov.cn/detail?id=ff8081819c46fcc5019cd18fc6e9557d","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Открыть источник"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Примечание автора"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["Если звонят о пропущенном годовом отчёте, повесьте трубку, сами проверьте систему или позвоните регулятору по месту регистрации. Не открывайте ссылки из SMS и не платите через указанные звонящим мини-программы или аккаунты. Это та же схема, что выдавать себя за налоговую — пункт 14. Если деньги уже переведены, немедленно звоните 110 или 96110 для остановки платежа. Правила годовой отчётности индивидуальных предпринимателей и ведения перечня аномально действующих предприятий дважды менялись в 2025 году; действующие редакции вступили в силу 25 декабря 2025 года. Годовой отчёт и налоговая декларация — разные обязанности; о налогах см. пункт 12 (своевременно подавать нулевую декларацию без дохода). Соблюдайте оба срока. После отзыва лицензии ответственный законный представитель 3 года не может занимать эту должность — см. пункт 23 (выходить из убыточного бизнеса по процедуре). Если продолжать не планируете, оформляйте прекращение по этой процедуре, а не игнорируйте отчёты. Польза прежде всего для вас."]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Моя заметка"]},{"tag":"button","props":{"type":"button"},"children":["Запишите напоминание…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/ru/tip/12-24"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Предыдущий"]},"Прежде чем тратить деньги на аутсорсинг управления интернет-магазином, курсы по открытию магазина или схему «без собственного товара», выясните, потребуются ли дополнительные расходы и откуда возьмётся продажная статистика"]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["Другие советы по этой теме"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/12-18"},"children":[{"tag":"strong","props":{},"children":["Продавать сначала, а потом производить: проверить спрос через предзаказы и мелкие заказы, прежде чем вкладывать средства в производство"]},{"tag":"span","props":{},"children":["В течение года наблюдали за 116 новыми итальянскими компаниями. Предп…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/12-19"},"children":[{"tag":"strong","props":{},"children":["Сначала сверяем образец с перечнем требований для массового производства, а потом приступаем к запуску"]},{"tag":"span","props":{},"children":["Разница между производством одного образца и тысячи изделий заключает…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/12-20"},"children":[{"tag":"strong","props":{},"children":["Сохраняйте документы и эти поставщика; не закупайте товары по цене, значительно ниже рыночной: если сотрудник привез подделку, ответственность несет руководитель"]},{"tag":"span","props":{},"children":["Если за продажу подделок вы получите доход в 30 000 юаней или более 5…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/12-21"},"children":[{"tag":"strong","props":{},"children":["Для товаров, упаковки, этикеток и рекламных изображений нужно либо создавать графику самостоятельно, либо покупать лицензию; изменение цвета или добавление своего значка не считается «изменением»"]},{"tag":"span","props":{},"children":["Если изменить цвет, фон или добавить свой значок к чужому изображению…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/12-22"},"children":[{"tag":"strong","props":{},"children":["Соблюдение установленных правил на рабочем месте и чёткое понимание ответственности при проявлении доброй воли вне этих рамок"]},{"tag":"span","props":{},"children":["Возьмём, к примеру, медицинских сестёр: согласно нормативным актам, п…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/12-23"},"children":[{"tag":"strong","props":{},"children":["Если убытки — действуйте по процедуре: при возможности проводите упрощённую ликвидацию, а если активы не покрывают долги — подавайте на банкротство, не оставляйте дело без внимания"]},{"tag":"span","props":{},"children":["Если задолженностей по кредитам, заработной плате, налогам или социал…"]}]}]}]},{"tag":"a","props":{"className":"life-text-link","href":"/ru/book/12"},"children":["Читать всю тему: Открыт