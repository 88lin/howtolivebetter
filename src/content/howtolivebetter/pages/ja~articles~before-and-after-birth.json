ン"]}]}]}]},{"tag":"main","props":{"className":"life-longread"},"children":[{"tag":"a","props":{"className":"life-back-link active","href":"/ja/articles","data-status":"active","aria-current":"page"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"記事一覧へ"]},{"tag":"header","props":{"className":"life-longread-header"},"children":[{"tag":"div","props":{},"children":[{"tag":"div","props":{"className":"life-eyebrow"},"children":["詳しく読む"]},{"tag":"h1","props":{"lang":"ja"},"children":["子供の誕生前後にすべきこと：時系列チェックリスト"]},{"tag":"p","props":{"lang":"ja"},"children":["妊活から生後1歳まで、時系列に沿って検査、書類、医療保険、育児事項を整理。"]},{"tag":"a","props":{"className":"life-longread-chapter","href":"/ja/book/27"},"children":["関連する章"," · ","妊娠と出産：妊娠の判明から退院・手続きまで",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"img","props":{"src":"/sites/howtolivebetter/images/book-chapters/27-pregnancy-editorial.webp","srcSet":"/sites/howtolivebetter/images/book-chapters/27-pregnancy-editorial-thumb.webp 600w, /sites/howtolivebetter/images/book-chapters/27-pregnancy-editorial-md.webp 900w, /sites/howtolivebetter/images/book-chapters/27-pregnancy-editorial.webp 1200w","sizes":"(max-width: 760px) 100vw, 450px","alt":"","width":"1200","height":"800","fetchPriority":"high"},"children":[]}]},{"tag":"div","props":{"className":"life-longread-layout"},"children":[{"tag":"aside","props":{"className":"life-longread-toc"},"children":[{"tag":"details","props":{"open":true},"children":[{"tag":"summary","props":{},"children":["この記事の目次"]},{"tag":"nav","props":{"aria-label":"この記事の目次"},"children":[{"tag":"a","props":{"href":"#一妊活時"},"children":["一、妊活時"]},{"tag":"a","props":{"href":"#二妊娠中出産前"},"children":["二、妊娠中、出産前"]},{"tag":"a","props":{"href":"#三入院出産時"},"children":["三、入院・出産時"]},{"tag":"a","props":{"href":"#四退院前"},"children":["四、退院前"]},{"tag":"a","props":{"href":"#五生後1ヶ月まで"},"children":["五、生後1ヶ月まで"]},{"tag":"a","props":{"href":"#六生後1ヶ月から1歳まで"},"children":["六、生後1ヶ月から1歳まで"]}]}]}]},{"tag":"div","props":{"className":"life-longread-main"},"children":[{"tag":"article","props":{"className":"life-article-body","lang":"ja"},"children":[{"tag":"p","props":{},"children":["本書はテーマごとに節が分かれており、妊娠、出産、育児に関する事項は複数の節に分散しています。このリストでは、それらを妊活から生後1歳まで、時系列に沿って並べ替えました。各項目には「何をすべきか」のみを記載しています。「なぜすべきか」「その根拠の確かさ」については、後ろの括弧内の項目を参照してください。該当する段階に到達したら、その小見出しから順に確認してください。"]},"\n",{"tag":"h2","props":{"id":"一妊活時"},"children":["一、妊活時"]},"\n",{"tag":"ol","props":{},"children":["\n",{"tag":"li","props":{},"children":["毎日 0.4 mg の葉酸を摂取してください。開始は3ヶ月前から。",{"tag":"a","props":{"href":"/ja/book/27#27-01","title":"妊娠の準備から毎日 0.4 mgの葉酸を摂取し、妊娠初期の 3 ヶ月まで継続しましょう"},"children":["第27節第1条"]},"（葉酸）を参照。"]},"\n",{"tag":"li","props":{},"children":["社会保険または医療保険の窓口に電話し、出産育児一時金等のための継続加入月数が足りているか確認してください。",{"tag":"a","props":{"href":"/ja/book/27#27-11","title":"妊娠前に出産保険の加入状況を確認しておきましょう。未就業の配偶者も出産医療費の請求が可能です"},"children":["第27節第11条"]},"（出産保険）を参照。"]},"\n",{"tag":"li","props":{},"children":["同居する家族に対し、今後室内での喫煙を禁止することを伝えておいてください。",{"tag":"a","props":{"href":"/ja/book/02#02-02","title":"自宅や車内での喫煙は避け、客人に自宅での喫煙もさせない"},"children":["第2節第2条"]},"（家や車内での喫煙禁止）を参照。"]},"\n",{"tag":"li","props":{},"children":["家族の生計をあなたの収入に依存している場合、先に収入を得ている方の定期生命保険に加入させておいてください。",{"tag":"a","props":{"href":"/ja/book/05#05-40","title":"家族の生活をあなたの収入に依存している人がいるなら、子供より先に稼ぎ手に対して定期死亡保険を検討すべきです"},"children":["第5節第40条"]},"（定期生命保険）を参照。"]},"\n"]},"\n",{"tag":"h2","props":{"id":"二妊娠中出産前"},"children":["二、妊娠中、出産前"]},"\n",{"tag":"ol","props":{},"children":["\n",{"tag":"li","props":{},"children":["妊娠13週までに地域の保健センターへ行き、「母子健康手帳」を作成してください。無料の妊婦健診はここから受けられます。",{"tag":"a","props":{"href":"/ja/book/27#27-02","title":"妊娠 13 週までに地域保健センターで『母子健康手帳』を作成し、無料妊婦健診の枠を活用しましょう"},"children":["第27節第2条"]},"（母子健康手帳）を参照。"]},"\n",{"tag":"li","props":{},"children":["初回の妊婦健診で、エイズ、梅毒、B型肝炎の検査を受けてください。検査費用は自己負担不要です。",{"tag":"a","props":{"href":"/ja/book/27#27-03","title":"初回産前検診でHIV、梅毒、B型肝炎の3項目を検査しましょう。陽性であっても無料の予防措置があります"},"children":["第27節第3条"]},"（エイズ、梅毒、B型肝炎）を参照。"]},"\n",{"tag":"li","props":{},"children":["妊娠期間中は禁煙し、飲酒も一切控えてください。",{"tag":"a","props":{"href":"/ja/book/27#27-04","title":"妊娠期間中はタバコもアルコールも一切控え、家族も室内での喫煙は避けてください"},"children":["第27節第4条"]},"（タバコもアルコールも厳禁）を参照。"]},"\n",{"tag":"li","props":{},"children":["妊婦健診では既往歴を正確に伝えてください。妊娠高血圧症候群のリスクがある場合は、医師の判断により妊娠12週後から低用量アスピリンを服用することがあります。第2術27節第5条（低用量アスピリン）を参照。"]},"\n",{"tag":"li","props":{},"children":["妊娠24週以降、妊娠糖尿病のスクリーニング検査を受けてください。",{"tag":"a","props":{"href":"/ja/book/27#27-06","title":"妊娠 24 週以降に妊娠糖尿病のスクリーニングを一度受けましょう。糖水が面倒だと思わないで"},"children":["第27節第6条"]},"（妊娠糖尿病スクリーニング）を参照。"]},"\n",{"tag":"li","props":{},"children":["妊娠20週以降は、イブプロフェンなどの鎮痛剤を自己判断で服用しないでください。",{"tag":"a","props":{"href":"/ja/book/34#34-05","title":"妊娠 20 週以降は、イブプロフェンなどの鎮痛薬を自己判断で服用しないでください"},"children":["第34節第5条"]},"（イブプロフェンなどの鎮痛剤）を参照。"]},"\n",{"tag":"li","props":{},"children":["「すぐに病院へ行くべき症状」のリストを、本人だけでなく同居人も含めて共有しておいてください。",{"tag":"a","props":{"href":"/ja/book/27#27-07","title":"「すぐに病院へ」のチェックリストを保存してください。妊娠中および産後1年間に有効です"},"children":["第27節第7条"]},"（すぐに病院へ行くべきリスト）を参照。"]},"\n",{"tag":"li","props":{},"children":["妊婦健診の際に、無痛分娩が可能かどうか病院に確認してください。",{"tag":"a","props":{"href":"/ja/book/27#27-09","title":"無痛分娩を希望する場合ははっきりと伝えましょう。帝王切開のリスクは高まりません"},"children":["第27節第9条"]},"（無痛分娩）を参照。"]},"\n",{"tag":"li","props":{},"children":["医学的な適応がない限り、積極的に帝王切開を希望しないでください。",{"tag":"a","props":{"href":"/ja/book/27#27-10","title":"医学的適応がない限り、積極的に帝王切開を求めないでください。また、日取りを選ぶために手術を行うことも避けてください"},"children":["第27節第10条"]},"（帝王切開）を参照。"]},"\n",{"tag":"li","props":{},"children":["保険加入地以外で出産する場合は、事前に「他地域での出産届（異地生育备案）」が必要か確認してください。",{"tag":"a","props":{"href":"/ja/book/27#27-11","title":"妊娠前に出産保険の加入状況を確認しておきましょう。未就業の配偶者も出産医療費の請求が可能です"},"children":["第27節第11条"]},"（出産保険）を参照。"]},"\n",{"tag":"li","props":{},"children":["産休は少なくとも98日間です。産前休暇として先に15日間取得することも可能です。",{"tag":"a","props":{"href":"/ja/book/18#18-02","title":"産休は 98 日間。出産手当金は出産保険基金より、前年度の事業所の従業員月平均賃金に基づいて支給されます"},"children":["第18節第2条"]},"（産休）を参照。"]},"\n",{"tag":"li","props":{},"children":["会社が妊娠を理由に減給や配置転換を行った場合は、書面による通知やチャットの履歴を保存しておいてください。",{"tag":"a","props":{"href":"/ja/book/18","title":"子育ては割に合うのか"},"children":["第18節"]},"第向3条（妊娠、出産、授乳を理由とした減給の禁止）を参照。"]},"\n",{"tag":"li","props":{},"children":["ベビーベッドやベビーカーは、まずはレンタルを検討し、手に入らなければ中古を購入してください。ただし、チャイルドシートとマットレスは中古品を避けてください。",{"tag":"a","props":{"href":"/ja/book/20#20-11","title":"大型用品は「借りる、中古を買う、新品を買う」の順で検討し、一度に揃えようとしない"},"children":["第20節第11条"]},"（レンタル、中古購入、新品購入）を参照。"]},"\n",{"tag":"li","props":{},"children":["おむつは、まず少量パックを購入して1週間試し、肌に合うことを確認してからまとめ買いしてください。",{"tag":"a","props":{"href":"/ja/book/20#20-10","title":"おむつ選びはブランドではなく3つのポイントを見る：サイズ感、交換頻度、抜き打ち検査の通知歴"},"children":["第20節第10条"]},"（おむつ）を参照。"]},"\n",{"tag":"li","props":{},"children":["名前は事前に考えておき、戸籍システムで入力可能な漢字であることを確認してください。",{"tag":"a","props":{"href":"/ja/book/27#27-12","title":"退院前に「出生医学証明書」を済ませましょう。名前は事前に考えておき、誤字がないようにしてください"},"children":["第27節第12条"]},"（出生証明書）を参照。"]},"\n"]},"\n",{"tag":"h2","props":{"id":"三入院出産時"},"children":["三、入院・出産時"]},"\n",{"tag":"ol","props":{},"children":["\n",{"tag":"li","props":{},"children":["破水した場合は、その場で仰向けに寝て、臀部を高くし、120（救急）に電話してください。動かないでください。",{"tag":"a","props":{"href":"/ja/book/27#27-08","title":"破水した場合はその場で仰向けに寝て、臀部を高くし、120 に電話してください。歩き回ったり入浴したりしないでください"},"children":["第27節第8条"]},"（破水）を参照。"]},"\n",{"tag":"li","props":{},"children":["出産後、最初の1時間以内に授乳を開始してください。",{"tag":"a","props":{"href":"/ja/book/20#20-04","title":"最初の 6 ヶ月は母乳のみ、水さえも不要、6 ヶ月から離乳食を開始し母乳を継続"},"children":["第20節第4条"]},"（母乳のみ）を参照。"]},"\n",{"tag":"li","props":{},"children":["出生後24時間以内に、B型肝炎ワクチンの第1回接種を行ってください。母親がB型肝炎表面抗原陽性の場合は、同時にB型肝炎免疫グロブリンを投与します。",{"tag":"a","props":{"href":"/ja/book/20#20-02","title":"出生後 24 時間以内にB型肝炎ワクチンの第1回目を接種する"},"children":["第20節第2条"]},"（B型肝炎ワクチン第1回目）を参照。"]},"\n",{"tag":"li","props":{},"children":["ビタミンK注射は必ず受けてください。自宅出産や非正規の施設で出産する場合は、自ら確認してください。",{"tag":"a","props":{"href":"/ja/book/20#20-07","title":"出生時のビタミンK注射は必ず受けてください"},"children":["第20節第7条"]},"（ビタミンK注射）を参照。"]},"\n",{"tag":"li","props":{},"children":["かかとの採血検査（新生児マススクリーニング）および聴覚検査は拒否しないでください。同意書に署名する前に、どの項目が自費診療になるかを確認してください。",{"tag":"a","props":{"href":"/ja/book/27#27-13","title":"新生児の踵（かかと）採血スクリーニングと聴覚スクリーニングは、どちらも拒否しないでください"},"children":["第27節第13条"]},"（かかとの採血および聴覚検査）を参照。"]},"\n"]},"\n",{"tag":"h2","props":{"id":"四退院前"},"children":["四、退院前"]},"\n",{"tag":"ol","props":{},"children":["\n",{"tag":"li","props":{},"children":["「出生証明書」の発行手続きを行い、両親と子供の名前、身分証番号が、一字一句間違っていないか照合してください。",{"tag":"a","props":{"href":"/ja/book/27#27-12","title":"退院前に「出生医学証明書」を済ませましょう。名前は事前に考えておき、誤字がないようにしてください"},"children":["第27節第12条"]},"（出生証明書）を参照。"]},"\n",{"tag":"li","props":{},"children":["出生証明書に基づき、オンラインで子供の住民医療保険への加入手続きを行ってください。住民登録（落戸）を待つ必要はありません。不明な点は12393へ問い合わせてください。",{"tag":"a","props":{"href":"/ja/book/27#27-14","title":"出生医学証明書を受け取ったらすぐに子供の住民医療保険に加入しましょう。戸籍登録（落戸）を待たないでください"},"children":["第27節第14条"]},"（住民医療保険）を参照。"]},"\n",{"tag":"li","props":{},"children":["帰宅時、チャイルドシートは必ず使用してください。1歳未満は後向きに設置し、抱っこしたままの移動は避けてください。",{"tag":"a","props":{"href":"/ja/book/01#01-10","title":"車に乗るときは4歳以下の子どもをチャイルドシートに座らせ、抱っこしない"},"children":["第1節第10条"]},"（チャイルドシート）を参照。"]},"\n"]},"\n",{"tag":"h2","props":{"id":"五生後1ヶ月まで"},"children":["五、生後1ヶ月まで"]},"\n",{"tag":"ol","props":{},"children":["\n",{"tag":"li","props":{},"children":["生後1ヶ月以内に、派出所にて出生届を提出してください。",{"tag":"a","props":{"href":"/ja/book/27#27-15","title":"子供の出生後、一ヶ月以内に派出所へ出生届を提出してください"},"children":["第27節第15条"]},"（出生届の提出）を参照。"]},"\n",{"tag":"li","props":{},"children":["住民登録完了後、子供の居住地にて育児手当の申請を行ってください（子供1人につき年間3600元）。",{"tag":"a","props":{"href":"/ja/book/18#18-01","title":"まずは受け取れる分を計算しましょう：国の育児手当は子供1人につき年間 3600 元、3 歳まで支給"},"children":["第18節第1条"]},"（育児手当）を参照。"]},"\n",{"tag":"li","props":{},"children":["子供は仰向けで、硬い平らな面で寝かせ、添い寝はしても添い寝（同じ布団）はせず、布団の中に柔らかいものを置かないでください。",{"tag":"a","props":{"href":"/ja/book/20#20-01","title":"乳児は仰向けで硬い平面に寝かせる。同じ部屋でも別の寝床にし、柔らかい物を置かない"},"children":["第20節第1条"]},"（仰向け寝）を参照。"]},"\n",{"tag":"li","props":{},"children":["粉ミルクを使用する場合は、70℃以上のお湯で溶かし、飲み残しは捨ててください。",{"tag":"a","props":{"href":"/ja/book/20#20-05","title":"ミルクを作る際は 70 ℃ 以上の水を使用し、作った後に冷ましてから与えてください。飲み残しは捨ててください"},"children":["第20節第5条"]},"（粉ミルクの調製）を参照。"]},"\n",{"tag":"li","props":{},"children":["生後3ヶ月未満の子供の体温が38℃に達した場合は、すぐに病院へ行ってください。",{"tag":"a","props":{"href":"/ja/book/20#20-08","title":"3ヶ月未満の乳児は、体温が 38 ℃ に達したら、自宅で様子を見ず、すぐに病院へ行ってください"},"children":["第20節第8条"]},"（体温が38℃の場合）を参照。"]},"\n",{"tag":"li","props":{},"children":["感情が抑えきれなくなりそうな時は、子供をベビーベッドに戻し、数分間その場を離れてください。",{"tag":"a","props":{"href":"/ja/book/20#20-09","title":"どんなに疲れ、怒っていても、赤ちゃんを揺らしてはいけません"},"children":["第20節第9条"]},"（赤ちゃんを揺らさない）を参照。"]},"\n",{"tag":"li","props":{},"children":["母親用の「すぐに病院へ行くべき症状」のリストは、産後1年間は有効です。",{"tag":"a","props":{"href":"/ja/book/27#27-07","title":"「すぐに病院へ」のチェックリストを保存してください。妊娠中および産後1年間に有効です"},"children":["第27節第7条"]},"（すぐに病院へ行くべきリスト）を参照。"]},"\n"]},"\n",{"tag":"h2","props":{"id":"六生後1ヶ月から1歳まで"},"children":["六、生後1ヶ月から1歳まで"]},"\n",{"tag":"ol","props":{},"children":["\n",{"tag":"li","props":{},"children":["産後42日目に健診を受けてください。これには産後うつ病のスクリーニングも含まれます。",{"tag":"a","props":{"href":"/ja/book/27#27-16","title":"産後 42 日のこの検診を飛ばさないで。産後うつのスクリーニングでもあります"},"children":["第27節第16条"]},"（産後42日）を参照。"]},"\n",{"tag":"li","props":{},"children":["月齢に合わせて定期予防接種を受けてください。百日咳・ジフテリア・破傷風（DPT）は生後2ヶ月から開始します。",{"tag":"a","props":{"href":"/ja/book/20#20-03","title":"国の定期接種計画に従って必要なワクチンをすべて完了させる。全行程無料。接種を逃した場合は、未完了の回数分のみ追加接種する"},"children":["第20節第3条"]},"（国家予防接種計画）を参照。"]},"\n",{"tag":"li","props":{},"children":["生後6ヶ月までは母乳のみを与えてください。6ヶ月以降は離乳食を開始し、毎日、鉄分の多い動物性食品を取り入れてください。",{"tag":"a","props":{"href":"/ja/book/20#20-04","title":"最初の 6 ヶ月は母乳のみ、水さえも不要、6 ヶ月から離乳食を開始し母乳を継続"},"children":["第20節第4条"]},"（6ヶ月からの離乳食）を参照。"]},"\n",{"tag":"li","props":{},"children":["1歳未満には蜂蜜を与えないでください。",{"tag":"a","props":{"href":"/ja/book/20#20-06","title":"1歳未満には蜂蜜を与えない"},"children":["第20節第6条"]},"（蜂蜜）を参照。"]},"\n",{"tag":"li","props":{},"children":["重度の湿疹や卵アレルギーがある場合は、まず医師に相談し、ピーナッツを早期に導入するかどうかを決定してください。",{"tag":"a","props":{"href":"/ja/book/20#20-12","title":"重度の湿疹や卵アレルギーがある場合、ピーナッツを避けるのではなく、医師の指導に従って早めに取り入れる。ただし、粒のまま与えるのは絶対にNG"},"children":["第20節第12条"]},"（ピーナッツを避けない）を参照。"]},"\n",{"tag":"li","props":{},"children":["2歳未満の子供が風邪を引いた際、市販の総合風邪薬を自己判断で飲ませないでください。",{"tag":"a","props":{"href":"/ja/book/34#34-04","title":"2 歳以下の子供が風邪を引いたとき、市販の総合感冒薬や咳止め薬を自己判断で飲ませないでください"},"children":["第34節第4条"]},"（総合風邪薬）を参照。"]},"\n",{"tag":"li","props":{},"children":["窓やベランダには補助錠（ストッパー）を取り付けてください。網戸だけでは防護になりません。",{"tag":"a","props":{"href":"/ja/book/01#01-11","title":"お子さんがいる家庭は窓やベランダにストッパーを。網戸は防護策になりません"},"children":["第1節第11条"]},"（窓とベランダの補助錠設置）を参照。"]},"\n",{"tag":"li","props":{},"children":["0歳から3歳までは、スマートフォンやタブレットなどの画面を見せないでください。",{"tag":"a","props":{"href":"/ja/book/30#30-05","title":"0 歳から 3 歳まではスクリーンを与えない、3 歳から 6 歳までは極力与えない、小中学生の学習目的以外での使用は1日 1 時間を超えないこと"},"children":["第30節第5条"]},"（スクリーンを見せない）を参照。"]},"\n",{"tag":"li","props":{},"children":["仕事に復帰した後、子供が1歳未満の場合、毎日1時間の授乳時間を確保してください。",{"tag":"a","props":{"href":"/ja/book/18#18-03","title":"知っておくべきこと：妊娠、出産、授乳を理由とした減給や解雇は禁止されています"},"children":["第18節第3条"]},"（授乳）を参照。"]},"\n",{"tag":"li","props":{},"children":["職域医療保険の個人口座を「家族共済（家庭共済）」に紐付けておき、子供の通院や薬代に使えるようにしてください。",{"tag":"a","props":{"href":"/ja/book/05#05-13","title":"医療保険Appで「家族共済」の紐付けを行えば、従業員医療保険の個人口座の資金を配偶者、父母、子供の通院や薬代に利用可能に"},"children":["第5節第13条"]},"（家族共済）を参照。"]},"\n",{"tag":"li","props":{},"children":["毎年の所得税確定申告の際、「3歳未満の乳幼児の養育費」に関する控除を記入してください。",{"tag":"a","props":{"href":"/ja/book/05#05-02","title":"毎年3月から6月にかけて確定申告を行い、特別控除の項目は漏れなく記入する"},"children":["第5節第2条"]},"（特別追加控除）を参照。"]},"\n"]},"\n"]},{"tag":"footer","props":{"className":"life-article-attribution"},"children":[{"tag":"p","props":{},"children":["このページには当サイトが中国語原文から機械翻訳した文章が含まれ、専門家による校閲は行っていません。医療・法律・金融情報は原文と出典を確認してください。"]},{"tag":"a","props":{"href":"https://github.com/eternity4719/HowToLiveBetter/blob/33362aff50f97f413b22ddfcdb355d2a536a5700/docs/%E5%AD%A9%E5%AD%90%E5%87%BA%E7%94%9F%E5%89%8D%E5%90%8E%E8%A6%81%E5%8A%9E%E7%9A%84%E4%BA%8B.md","target":"_blank","rel":"noopener noreferrer"},"children":["出典の版を見る · 33362af",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"14","height":"14","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]},{"tag":"span","props":{},"children":["取り込み日：2026-10-11"]},{"tag":"p","props":{},"children":["参照リンクは当サイトの版で対応するヒントに移動します。原文の番号とは異なる場合があります。"]}]},{"tag":"div","props":{"className":"life-quick-share"},"children":[{"tag":"button","props":{"type":"button"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-copy","aria-hidden":"true"},"children":[{"tag":"rect","props":{"width":"14","height":"14","x":"8","y":"8","rx":"2","ry":"2"},"children":[]},{"tag":"path","props":{"d":"M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"},"children":[]}]},"リンクをコピー"]},{"tag":"span","props":{"role":"status"},"children":[]}]}," ",{"tag