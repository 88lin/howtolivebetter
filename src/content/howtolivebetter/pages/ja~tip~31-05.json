ewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["費用・手間"]},{"tag":"p","props":{},"children":["費用はかかりません。退役証明書を持参し、配置先の退役軍人事務部門へ1回手続きに行きます。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["効果"]},{"tag":"p","props":{},"children":["《退役軍人安置条例》第25条では、配置地の人民政府が職務を割り当てる6つの状況を列挙しています。原文は以下の通りです：「（一）下士官が 12 年以上の現役勤務を終えた場合；（二）現役勤務期間中に個人が勲章や名誉称号を授与された場合；（（三）現役勤務期間中に個人が3等戦功、2等功以上の賞罰を受けた場合；（四）現役勤務期間中に個人が1級の表彰を受けた場合；（五）戦傷により 5 級から 8 級の障害等級と判定された場合；（六）烈士の子女である場合」。また、同条例には「配置地の人民政府は、退役した下士官および義務兵の職務割り当て任務を、受け入れ後 6 ヶ月以内に完了させなければならない」とも記されています。雇用主は「規定に従い、3 年以上の長期または中期雇用契約または労働契約を締結しなければならない」とされています。そのうち、企業が軍歴 10 年以上の退役軍士を受け入れる場合、「無期限労働契約を締結しなければならない」。無期限とは、契約書に終了日を記載しないことを指す。就業配置を待機している期間は、「現地の月間最低賃金基準に従い、月ごとに生活補助金を支給する」。自身の理由により規定通りの配置が行われなかった場合は、「当該組織の同等の条件にある人員の平均賃金の 80% 以上の基準に従い、就業するまで月ごとに生活費を支給する」。配置方法による再配置の対象外となるケースには、中国共産党の党籍を剥奪された場合や刑事罰を受けた場合が含まれる。自主雇用期間については第五十一条を参照：「自主雇用となる退役軍士および義務兵は、退役が承認された日から 30 日以内に、配置地の人民政府退役軍人工作主管部門へ届け出なければならない。」正当な理由なく、規定の時刻に 30 日を超えて遅刻した場合は、安置待遇を放棄したものとみなされます。」（全国、2024 年 9 月 1 日より施行）"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["出典"]},{"tag":"p","props":{"className":"life-citations"},"children":["国务院、中央军委 (2024). 退役军人安置条例（国务院、中央军委令第 787 号，2024 年 7 月 29 日公布、9 月 1 日施行；第二十五、三十一、三十二、三十五、五十一、七十五条）. ",{"tag":"a","props":{"href":"https://www.gov.cn/gongbao/2024/issue_11526/202408/content_6969192.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/gongbao/2024/issue_11526/202408/content_6969192.html"]},"；全国人大常委会 (2020). 退役军人保障法（第十三、十四、十五条）. ",{"tag":"a","props":{"href":"http://www.mod.gov.cn/gfbw/fgwx/flfg/16048597.html","target":"_blank","rel":"noopener noreferrer"},"children":["http://www.mod.gov.cn/gfbw/fgwx/flfg/16048597.html"]},"（国防部刊登）"]},{"tag":"a","props":{"href":"https://www.gov.cn/gongbao/2024/issue_11526/202408/content_6969192.html","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["出典を開く"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["著者の注記"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["この条例の施行と同じ日に、2011 年の《退役士兵安置条例》（国務院、中央軍事委員会令 第 608 号）は廃止されました。ネット上の多くのガイドでは旧条例が引用されており、条件の表現が既に変わっています。旧版では「平時に二等功以上の功績を授与された、または戦時に三等功以上の功績を授与された場合」と記載されていました。30 日という期限は自主就業の区分にのみ適用され、その他の配置方式は「規定の時間に従って」届け出ることになっています。届け出の際には退役軍人優待証が交付され、その後の退役金、就業・起業支援、および教育支援などはすべてここからつながります。"]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["自分のメモ"]},{"tag":"button","props":{"type":"button"},"children":["自分へのメモを書く…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/ja/tip/31-04"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColo