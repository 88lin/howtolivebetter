{"d":"M2 12h2"},"children":[]},{"tag":"path","props":{"d":"M20 12h2"},"children":[]},{"tag":"path","props":{"d":"m6.34 17.66-1.41 1.41"},"children":[]},{"tag":"path","props":{"d":"m19.07 4.93-1.41 1.41"},"children":[]}]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"17","height":"17","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-moon life-theme-icon-dark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"},"children":[]}]}]},{"tag":"button","props":{"type":"button","className":"life-language-switch","aria-label":"English Choose language","aria-haspopup":"menu","aria-expanded":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-globe","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]},{"tag":"path","props":{"d":"M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"},"children":[]},{"tag":"path","props":{"d":"M2 12h20"},"children":[]}]},{"tag":"span","props":{},"children":["English"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]}]},{"tag":"a","props":{"className":"life-account","href":"/en/sign-in"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"17","height":"17","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle-user-round","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M18 20a6 6 0 0 0-12 0"},"children":[]},{"tag":"circle","props":{"cx":"12","cy":"10","r":"4"},"children":[]},{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},{"tag":"span","props":{},"children":["Sign in to sync"]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/en/book/19"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"Back to index"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["While employed, upon leaving the job, and for work‑related injuries"]},{"tag":"nav","props":{"aria-label":"Chapter entries"},"children":[{"tag":"a","props":{"href":"/en/tip/19-01"},"children":[{"tag":"span","props":{},"children":["01"]},"Overtime pay is calculated at three rates: 1.5×, 2×, and 3× the regular wage; failure to pay warrants a complaint to labor authorities, and non‑payment after the deadline incurs an additional penalty of 50%–100% of the owed amount"]},{"tag":"a","props":{"href":"/en/tip/19-02"},"children":[{"tag":"span","props":{},"children":["02"]},"Annual leave is calculated based on total years of service: 5, 10, or 15 days. If unused, employees receive 300% of their daily wage as compensation"]},{"tag":"a","props":{"href":"/en/tip/19-03"},"children":[{"tag":"span","props":{},"children":["03"]},"There is a legal limit on probation periods, wages must be at least 80% of the regular rate, and only one probation period may be set per employee"]},{"tag":"a","props":{"href":"/en/tip/19-04"},"children":[{"tag":"span","props":{},"children":["04"]},"Calculating N: One month’s salary per full year of service; half a month for periods under six months"]},{"tag":"a","props":{"href":"/en/tip/19-05"},"children":[{"tag":"span","props":{},"children":["05"]},"If a company fires you without 30 days’ notice, it must pay an extra month’s salary"]},{"tag":"a","props":{"href":"/en/tip/19-06"},"children":[{"tag":"span","props":{},"children":["06"]},"When a company unlawfully terminates employment, the compensation equals twice the standard severance amount"]},{"tag":"a","props":{"href":"/en/tip/19-07"},"children":[{"tag":"span","props":{},"children":["07"]},"Never sign “voluntary resignation for personal reasons”; doing so forfeits your entitlements"]},{"tag":"a","props":{"href":"/en/tip/19-08"},"children":[{"tag":"span","props":{},"children":["08"]},"Save pay stubs, attendance records, employment contracts, social insurance documents, and chat logs before leaving your job"]},{"tag":"a","props":{"href":"/en/tip/19-09"},"children":[{"tag":"span","props":{},"children":["09"]},"Before taking up a post where there is dust, noise, or chemicals, check whether the contract mentions any occupational hazards; the employer must arrange and pay for three occupational health examinations"]},{"tag":"a","props":{"href":"/en/tip/19-10"},"children":[{"tag":"span","props":{},"children":["10"]},"Damage caused by dust, noise, and chemical toxins is irreversible: employers must provide protective gear, and workers can refuse unsafe tasks"]},{"tag":"a","props":{"href":"/en/tip/19-11"},"children":[{"tag":"span","props":{},"children":["11"]},"If you’re injured at work or hit while commuting, the first step is to get a work‑injury determination; if your employer won’t file it, you must do it yourself"]},{"tag":"a","props":{"href":"/en/tip/19-12"},"children":[{"tag":"span","props":{},"children":["12"]},"Don’t believe the myth that “staying at work counts as a workplace injury”: if you suddenly feel unwell, call 120 first — don’t rush to clock in"]},{"tag":"a","props":{"href":"/en/tip/19-13"},"children":[{"tag":"span","props":{},"children":["13"]},"Even if the employer fails to enroll you in workers’ compensation insurance, you still qualify for full benefits paid entirely by the employer at the same rates"]},{"tag":"a","props":{"href":"/en/tip/19-14"},"children":[{"tag":"span","props":{},"children":["14"]},"After injuries stabilize, undergo a work capacity assessment; disability grades translate directly into compensation"]},{"tag":"a","props":{"href":"/en/tip/19-15"},"children":[{"tag":"span","props":{},"children":["15"]},"Three types of compensation for work-related deaths: funeral allowance, survivor’s pension, and one-time death benefit"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/en/tip/19-16","data-status":"active"},"children":[{"tag":"span","props":{},"children":["16"]},"If you’ve been bullied, insulted, or mistreated at work for a long time, don’t just endure it: document everything as evidence, then take action based on the nature of the abuse"]},{"tag":"a","props":{"href":"/en/tip/19-17"},"children":[{"tag":"span","props":{},"children":["17"]},"When you leave a job, ask the employer for a termination certificate stating contract term, separation date, position, and years of service"]},{"tag":"a","props":{"href":"/en/tip/19-18"},"children":[{"tag":"span","props":{},"children":["18"]},"Before spending severance pay, check individual income tax: amounts within three times the local prior-year average employee wage are tax-free; the excess is taxed separately, not merged into that year’s salary"]},{"tag":"a","props":{"href":"/en/tip/19-19"},"children":[{"tag":"span","props":{},"children":["19"]},"When moving to another city for work, transfer your pension and medical insurance to the new place of enrollment; contribution years keep adding up, so do not withdraw from pension insurance"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"Breadcrumb"},"children":[{"tag":"a","props":{"href":"/en/book"},"children":["Explore the book"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/en/book/19"},"children":["Chapter 19"," ·"," ","While employed, upon leaving the job, and for work‑related injuries"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"19-16"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["16"]},{"tag":"span","props":{"className":"life-evidence grade-b"},"children":["Evidence"," ","B"]}]},{"tag":"h1","props":{"lang":"en"},"children":["If you’ve been bullied, insulted, or mistreated at work for a long time, don’t just endure it: document everything as evidence, then take action based on the nature of the abuse"]},{"tag":"p","props":{"lang":"en","className":"life-entry-summary"},"children":["Employees who experience workplace bullying have a roughly 60% higher risk of developing heart disease or having a stroke, and this risk rises with the severity of the bullying. After several years, they are also about twice as likely to entertain suicidal thoughts compared to their peers. Being constantly insulted and mistreated is far from a minor inconvenience that can simply be “tolerated.”"]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Cost"]},{"tag":"p","props":{},"children":["There’s no monetary cost. However, it does take time to re…"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Benefit"]},{"tag":"p","props":{},"children":["From a health perspective: three Swedish and Danish cohorts comprising 79,201 working adults aged 18–65 were s…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"Mark: If you’ve been bullied, insulted, or mistreated at work for a long time, don’t just endure it: document everything as evidence, then take action based on the nature of the abuse"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"Done"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"Plan to do"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"Save"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Share this tip"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Hide details"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Cost"]},{"tag":"p","props":{},"children":["There’s no monetary cost. However, it does take time to record details such as dates, witnesses, exact quotes from the abuser, and to keep original screenshots and emails. Legal proceedings like arbitration or lawsuits can last several months. Changing jobs is the most costly option; you must weigh these factors yourself."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Benefit"]},{"tag":"p","props":{},"children":["From a health perspective: three Swedish and Danish cohorts comprising 79,201 working adults aged 18–65 were studied over an average of 12.4 years. At baseline, none had cardiovascular disease; 9% reported having experienced workplace bullying in the previous year. Those who endured bullying faced a 59% higher risk of developing cardiovascular disease (coronary heart disease or cerebrovascular disease; HR 1.59, 95% CI 1.28–1.98). Individuals subjected to workplace violence faced a 25% higher risk (HR 1.25, 95% CI 1.12–1.40); both risks increased with the frequency of abuse. A Norwegian nationwide survey of 1,846 workers, followed over three rounds of testing spaced two to three years apart, found that bullied individuals were roughly twice as likely to develop suicidal thoughts (OR 2.05, 95% CI 1.08–3.89). Conversely, people with prior suicidal thoughts did not later become more prone to bullying. From a legal standpoint: China currently lacks specific legislation addressing “workplace bullying”; actions must be evaluated against existing laws. Employers found guilty of insults, corporal punishment, physical assault, unlawful searches, or unlawful detention of workers face administrative penalties and must compensate for any harm; criminal acts incur further legal consequences. If an employer uses violence or threats to compel work, employees may terminate their contracts immediately without notice and are entitled to financial compensation. Employers must also implement measures to prevent and curb sexual harassment by leveraging authority or hierarchical relationships; victims may seek civil redress from harassers. Labor arbitration cases are resolved within 45 days of acceptance, with a possible extension of 15 days for complex cases."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Original sources"]},{"tag":"p","props":{"className":"life-citations"},"children":["Xu T 等 (2019). Workplace bullying and workplace violence as risk factors for cardiovascular disease: a multi-cohort study. European Heart Journal. ",{"tag":"a","props":{"href":"https://doi.org/10.1093/eurheartj/ehy683","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1093/eurheartj/ehy683"]},"；Nielsen MB, Nielsen GH, Notelaers G, Einarsen S (2015). Workplace Bullying and Suicidal Ideation: A 3-Wave Longitudinal Norwegian Study. American Journal of Public Health. ",{"tag":"a","props":{"href":"https://doi.org/10.2105/AJPH.2015.302855","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.2105/AJPH.2015.302855"]},"；全国人大常委会 (2007). 劳动合同法（第三十八条第二款、第四十六条、第八十八条）. ",{"tag":"a","props":{"href":"https://www.gov.cn/gongbao/content/2007/content_711013.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/gongbao/content/2007/content_711013.htm"]},"；全国人大 (2020). 民法典（第一千零一十条）. 最高人民检察院转载全文 ",{"tag":"a","props":{"href":"https://www.spp.gov.cn/spp/fl/202006/t20200602_463888.shtml","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.spp.gov.cn/spp/fl/202006/t20200602_463888.shtml"]},"；全国人大常委会 (2022 年修订). 妇女权益保障法（第二十五条）. ",{"tag":"a","props":{"href":"https://flk.npc.gov.cn/detail?id=ff808181841257210184281512de0eec","target":"_blank","rel":"noopener noreferrer"},"children":["https://flk.npc.gov.cn/detail?id=ff808181841257210184281512de0eec"]},"；全国人大常委会 (2007). 劳动争议调解仲裁法（第四十三条）. 安康市人社局转载全文 ",{"tag":"a","props":{"href":"https://rsj.ankang.gov.cn/Content-2150407.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://rsj.ankang.gov.cn/Content-2150407.html"]}]},{"tag":"a","props":{"href":"https://doi.org/10.1093/eurheartj/ehy683","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Open source link"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Book note"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["This grade is assigned because the health data derive from observational studies rather than randomized controlled trials, and “bullying” was self-reported by participants. This guidance does not advocate quitting a job at the first sign of mistreatment; the personal cost of changing jobs must be considered. Four practical steps can be taken: first, begin documenting incidents immediately; refer to Section 8, Item 41 for guidance on recording audio evidence. Second, submit written complaints through official internal channels and retain proof of such submissions. Third, if physical assault, unlawful confinement, or public humiliation occurs, contact law enforcement. Fourth, if forced to leave due to unpaid wages or lack of social insurance contributions, follow Section 7 (“Do not voluntarily resign”) and Section 8 (“Preserve evidence prior to leaving”) of this chapter. For details on calculating compensation, see Section 4 (“Calculate your entitlements after layoffs”). Mere neglect, exclusion, or minor mistreatment rarely violate any specific statutes; in such cases, internal complaints, job transfers, or changing employers are the primary remedies. Arbitration proceedings may take up to 60 days, while civil lawsuits typically require at least six months; legal fees must be borne by the plaintiff. If the situation becomes unbearable, call 12356 as outlined in Section 1, Item 25."]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["My note"]},{"tag":"button","props":{"type":"button"},"children":["Write a reminder for yourself…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/en/tip/19-15"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Previous"]},"Three types of compensation for work-related deaths: funeral allowance, survivor’s pension, and one-time death benefit"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/en/tip/19-17"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Next"]},"When you leave a job, ask the employer for a termination certificate stating contract term, separation date, position, and years of service"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"