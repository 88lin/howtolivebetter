back-link","href":"/ja/book/12"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"目次に戻る"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["起業とビジネス：全財産を失わないために"]},{"tag":"div","props":{"data-ad-dock-host":"true"},"children":[]},{"tag":"nav","props":{"aria-label":"この章のヒント"},"children":[{"tag":"a","props":{"href":"/ja/tip/12-01"},"children":[{"tag":"span","props":{},"children":["01"]},"失ってもよい金額のみで起業する：家財を投じず、借金をして開業しない"]},{"tag":"a","props":{"href":"/ja/tip/12-02"},"children":[{"tag":"span","props":{},"children":["02"]},"会社への融資に対して個人保証に署名しない、配偶者も絶対に署名しない"]},{"tag":"a","props":{"href":"/ja/tip/12-03"},"children":[{"tag":"span","props":{},"children":["03"]},"開業前に正しい主体を選ぶ：個人事業主と組合員は最後まで責任を負い、有限会社のみが「有限」となる"]},{"tag":"a","props":{"href":"/ja/tip/12-04"},"children":[{"tag":"span","props":{},"children":["04"]},"名義上の株主にならない、他人のために株式を保有（名義貸し）しない"]},{"tag":"a","props":{"href":"/ja/tip/12-05"},"children":[{"tag":"span","props":{},"children":["05"]},"加盟前に商務部の備案を確認し、書面による開示を受け、契約書に「クーリングオフ期間」を明記する"]},{"tag":"a","props":{"href":"/ja/tip/12-06"},"children":[{"tag":"span","props":{},"children":["06"]},"登録前に名称、営業所、経営範囲、登録資本金を確定させる。書類が揃っていればその場で免許を取得できる"]},{"tag":"a","props":{"href":"/ja/tip/12-07"},"children":[{"tag":"span","props":{},"children":["07"]},"許可証が必要な業種：許可が下りるまで営業禁止"]},{"tag":"a","props":{"href":"/ja/tip/12-08"},"children":[{"tag":"span","props":{},"children":["08"]},"食品販売はまず自分の区分を確認：製造・飲食は許可が必要、既包装の販売は届出のみ、生鮮肉・野菜は許可不要"]},{"tag":"a","props":{"href":"/ja/tip/12-09"},"children":[{"tag":"span","props":{},"children":["09"]},"袋詰め販売は「既包装食品」：ラベルの製造日、賞味期限、原材料名はすべて必須"]},{"tag":"a","props":{"href":"/ja/tip/12-10"},"children":[{"tag":"span","props":{},"children":["10"]},"一般食品で病気が治せると言うのは禁止：ラベル、説明書、広告、ライブ配信の台本すべてが対象"]},{"tag":"a","props":{"href":"/ja/tip/12-11"},"children":[{"tag":"span","props":{},"children":["11"]},"食品業界には刑事罰のラインがある：病死した肉や基準超過品を売れば罪に問われ、有害物質の混入は金額に関わらず、刑期は5年起算"]},{"tag":"a","props":{"href":"/ja/tip/12-12"},"children":[{"tag":"span","props":{},"children":["12"]},"営業許可取得後から申告義務が発生。収入がなくても期限内に「ゼロ申告」を行うこと（すべてゼロの書類を提出する）"]},{"tag":"a","props":{"href":"/ja/tip/12-13"},"children":[{"tag":"span","props":{},"children":["13"]},"請求書は実際の取引に基づいてのみ発行し、小規模納税者は免税枠を最大限活用する"]},{"tag":"a","props":{"href":"/ja/tip/12-14"},"children":[{"tag":"span","props":{},"children":["14"]},"税務局を名乗り納税を催促してくるのはすべて詐欺です。納税手続きは電子税務局と 12366 を通じてのみ行ってください"]},{"tag":"a","props":{"href":"/ja/tip/12-15"},"children":[{"tag":"span","props":{},"children":["15"]},"「手付金（定金）」と記載し「予約金（订金）」とは書かないこと。違約金は金額を明記し、支払猶予期間（売掛）は貸付として審査すること"]},{"tag":"a","props":{"href":"/ja/tip/12-16"},"children":[{"tag":"span","props":{},"children":["16"]},"雇用後の最初の1ヶ月以内に書面契約を締結し、30 日以内に社会保険登録を行う"]},{"tag":"a","props":{"href":"/ja/tip/12-17"},"children":[{"tag":"span","props":{},"children":["17"]},"賃金は契約と法律に従って支払い、昇給、貸付、ボーナスはすべて書面で行う"]},{"tag":"a","props":{"href":"/ja/tip/12-18"},"children":[{"tag":"span","props":{},"children":["18"]},"販売してから製造：予約販売と小規模注文で需要を検証してから、製造に投資する"]},{"tag":"a","props":{"href":"/ja/tip/12-19"},"children":[{"tag":"span","props":{},"children":["19"]},"サンプル完成後は、まず量産チェックリストを確認してから着手すること"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/ja/tip/12-20","data-status":"active"},"children":[{"tag":"span","props":{},"children":["20"]},"仕入れのたびに伝票と仕入れ元情報を保管すること。市場価格より明らかに低い仕入れ値のものは仕入れない：従業員が仕入れた偽物で、社長が判決を受けた事例"]},{"tag":"a","props":{"href":"/ja/tip/12-21"},"children":[{"tag":"span","props":{},"children":["21"]},"商品、パッケージ、タグ、宣伝画像に使用する図案は、自作するかライセンスを購入すること。色の変更やアイコンの追加は「改変」とはみなされない"]},{"tag":"a","props":{"href":"/ja/tip/12-22"},"children":[{"tag":"span","props":{},"children":["22"]},"職務においては規定に従って行動し、規定外の善意はまず責任の所在を明確にすること"]},{"tag":"a","props":{"href":"/ja/tip/12-23"},"children":[{"tag":"span","props":{},"children":["23"]},"損失が出たら手続きに従って退場を：簡便な注銷ができるなら注銷し、債務超過なら破産を。放置してはいけない"]},{"tag":"a","props":{"href":"/ja/tip/12-24"},"children":[{"tag":"span","props":{},"children":["24"]},"ネットショップの運営代行、開店セミナー、 「無在庫販売」に手を出して費用を支払う前に、追加料金の有無と売上の出所を必ず確認すること"]},{"tag":"a","props":{"href":"/ja/tip/12-25"},"children":[{"tag":"span","props":{},"children":["25"]},"中国で会社や個人事業を営むなら、毎年1月1日〜6月30日に前年の年次報告をオンライン提出。営業がなくても必要で、無料"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"現在地"},"children":[{"tag":"a","props":{"href":"/ja/book"},"children":["本を読む"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/ja/book/12"},"children":["第12章"," ·"," ","起業とビジネス：全財産を失わないために"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"12-20"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["20"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["エビデンス"," ","A"]}]},{"tag":"h1","props":{"lang":"ja"},"children":["仕入れのたびに伝票と仕入れ元情報を保管すること。市場価格より明らかに低い仕入れ値のものは仕入れない：従業員が仕入れた偽物で、社長が判決を受けた事例"]},{"tag":"p","props":{"lang":"ja","className":"life-entry-summary"},"children":["偽物を販売し、3 万、あるいは 5 万まで売り上げた場合、刑罰の対象となり、3 年以下の懲役となります。商品が倉庫に滞留して売れていなくても、同様にカウントされます。「偽物だとは知らなかった」という言い訳は通用しません。仕入れ値が市場価格より明らかに低いにもかかわらず、その理由を説明できない場合、知っていたとみなされます。購入契約書、請求書、支払い記録、および仕入れ元の情報を保管しておくことが、免責への唯一の道です。"]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["費用・手間"]},{"tag":"p","props":{},"children":["費用はかかりません。毎回の仕入れにおいて、以下のものを保管してください：購入契約書、請求書、支払い記録、仕入れ元の営…"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["効果"]},{"tag":"p","props":{},"children":["偽造された登録商標の商品であることを知りながら販売し、得た利益（不当利得）が 3 万元に達するか、あるいは販売額が 5 万元に達した場合、刑事罰の対象となります。"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"記録する：仕入れのたびに伝票と仕入れ元情報を保管すること。市場価格より明らかに低い仕入れ値のものは仕入れない：従業員が仕入れた偽物で、社長が判決を受けた事例"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"できている"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"やることに追加"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"お気に入り"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"このヒントを共有"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"詳細を閉じる"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["費用・手間"]},{"tag":"p","props":{},"children":["費用はかかりません。毎回の仕入れにおいて、以下のものを保管してください：購入契約書、請求書、支払い記録、仕入れ元の営業許可証および授権書類。さらに、社内ルールを定めてください：仕入れた担当者が署名すること、市場価格より明らかに低いものは一律で仕入れないこと。難しいのは、利益が出そうに見える低価格の商品を、見逃さずに済むことです。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["効果"]},{"tag":"p","props":{},"children":["偽造された登録商標の商品であることを知りながら販売し、得た利益（不当利得）が 3 万元に達するか、あるいは販売額が 5 万元に達した場合、刑事罰の対象となります。3 年以下の懲役、および罰金、または罰金のみが科されます。この基準の10倍に達した場合は、3 年から 10 年の懲役および罰金が科されます。倉庫に保管されていてまだ売れていない在庫についても、その価値が販売額の基準の3倍を超えている場合は、同様に犯罪を構成します。「知っていた」ことについて、自ら認める必要はありません。最高人民法院および最高人民検察院による 2025 年の司法解釈では、あなたが知っていたと直接認定される5つのケースが列挙されており、本当に知らなかったことを証明できる証拠がある場合を除きます。一つ目は、商品上の登録商標が改ざん、交換、または上書きされていることを知っている場合です。二、商標登録権者の授権書類を偽造、改ざんすること、または当該書類が偽造、改ざんされていることを知りながら使用すること。三、模倣品の販売により刑事罰または行政処分を受けたことがあり、かつ同一のものを販売すること。四、正当な理由なく、明らかに市場価格を大幅に下回る価格で仕入れ、または販売すること。五、行政執行機関または司法機関によって侵害商品や会計伝票などの証拠の移転、破棄、または虚偽の証明の提供が発覚したこと。会社がこの条項に抵触した場合、「法人に対して罰金を科し、直接責任のある管理職およびその他の直接責任者」に対しても同一の条項に基づき処分を下す。つまり、会社に罰金が科されるとともに、決定を下した責任者および担当者にも同一の条項が適用される。したがって、たとえ従業員が商品を仕入れたとしても、処罰および判決を受けるのは決定を下した責任者となる。逆に、商標法には一つの回避策が用意されています。販売時にその商品が他者の登録商標を侵害していることを知らなかった場合、「当該商品が適法に取得されたものであることを証明し、かつ提供者を明らかにできるときは、損害賠償責任を負わない」とされています。免責されるかどうかは、領収書や仕入れ先の情報があるかどうかにかかっており、記録が残っていない場合はこの条項を適用できません（全国、司法解釈 2025 年 4 月 26 日より施行）"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["出典"]},{"tag":"p","props":{"className":"life-citations"},"children":["全国人大常委会 (2020). 刑法修正案（十一）（第十七、二十四项，即刑法第二百一十四、二百二十条）. ",{"tag":"a","props":{"href":"https://www.spp.gov.cn/zdgz/202012/t20201227_503682.shtml","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.spp.gov.cn/zdgz/202012/t20201227_503682.shtml"]},"；最高人民法院、最高人民检察院 (2025). 关于办理侵犯知识产权刑事案件适用法律若干问题的解释（法释〔2025〕5 号，2025 年 4 月 26 日起施行）. ",{"tag":"a","props":{"href":"https://www.spp.gov.cn/xwfbh/wsfbt/202504/t20250424_693977.shtml","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.spp.gov.cn/xwfbh/wsfbt/202504/t20250424_693977.shtml"]},"；全国人大常委会 (2019). 商标法（2019 年修正，第五十七、六十四条；2026 年 6 月 26 日修订后为第七十二、七十八条，自 2027 年 1 月 1 日起施行）. ",{"tag":"a","props":{"href":"https://www.cnipa.gov.cn/art/2019/7/30/art_95_28179.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.cnipa.gov.cn/art/2019/7/30/art_95_28179.html"]},"、",{"tag":"a","props":{"href":"https://www.cnipa.gov.cn/art/2026/6/26/art_95_206942.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.cnipa.gov.cn/art/2026/6/26/art_95_206942.html"]}]},{"tag":"a","props":{"href":"https://www.spp.gov.cn/zdgz/202012/t20201227_503682.shtml","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["出典を開く"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["著者の注記"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["化粧品、酒類、ベビー・マタニティ用品、デジタル機器、衣類は、この種の案件が発生しやすいカテゴリーです。共通点は、同一の商品に極めて大きな価格差が存在することです。「流通品」「在庫処分品」「海外免税品」といった言葉も、領収書や伝票の代わりにはなりません。刑事罰に加えて、行政処分も科されます。侵害が認定された場合、侵害商品および道具は没収され、違法経営額が 5 万元以上の場合は、さらに 5 倍以下の罰金が科される可能性があります。仕入れ後に間違いに気づいた場合は、直ちに販売を停止し、商品を封印した上で、ブランド側または市場監督管理部門に連絡してください。販売を継続したり、商品や帳簿を破棄したりしないでください。証拠の破棄は、当局による「偽物であることを認識していたと推定される」第5のケースにまさに該当してしまいます。他人のデザインを使用することについては、第 21 条を参照してください（デザインは自社で作成するか、ライセンスを購入する必要があります）。この手口に特化した典型的なパターンがあります。自ら訪問してきて、「このペンや他の小物を無料で差し上げるので、店に置いて売って、後で利益を分配しましょう」と持ちかけるものです。数日後、誰かが商品を購入してその場で証拠を掴み、権利侵害として損害賠償を請求してきます。無料で提供された品物については、免責を認めるための3つの条件が、あいにくすべて欠けています。つまり、仕入れ契約書や支払記録がなく、真の提供者を特定できず、価格が明らかに不自然であるということです。「適法に取得し、かつ提供者を説明できること」という条項が全く適用できません。したがって、自ら配送に来て、領収書も渡さず、WeChatのIDだけを残していくようなケースは、一律で棚に並べないようにしています。もし本当に委託販売を行うのであれば、書面による委託販売契約を締結し、相手の身分証明書と営業許可証の写しを保管した上で、商品の所有権が誰にあるのか、侵害が発生した際に誰が責任を負うのかを明記しておくべきです。"]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["自分のメモ"]},{"tag":"button","props":{"type":"button"},"children":["自分へのメモを書く…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/ja/tip/12-19"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["前へ"]},"サンプル完成後は、まず量産チェックリストを確認してから着手すること"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/ja/tip/12-21"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["次へ"]},"商品、パッケージ、タグ、宣伝画像に使用する図案は、自作するかライセンスを購入すること。色の変更やアイコンの追加は「改変」とはみなされない"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["このテーマの他の提案"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/12-16"},"children":[{"tag":"strong","props":{},"children":["雇用後の最初の1ヶ月以内に書面契約を締結し、30 日以内に社会保険登録を行う"]},{"tag":"span","props":{},"children":["入社後1ヶ月が経過しても書面契約が締結されていない場合、2ヶ月目から1年が経過するまで、毎月2倍の賃金を支払わなければなりません。社会保険…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/12-17"},"children":[{"tag":"strong","props":{},"children":["賃金は契約と法律に従って支払い、昇給、貸付、ボーナスはすべて書面で行う"]},{"tag":"span","props":{},"children":["賃金は契約および法律に基づき、期日通りに全額支払わなければなりません。未払いの場合、従業員は直接裁判所に支払督促を申し立てることができます…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/12-18"},"children":[{"tag":"strong","props":{},"children":["販売してから製造：予約販売と小規模注文で需要を検証してから、製造に投資する"]},{"tag":"span","props":{},"children":["ある起業家が、イタリアの新規企業 116 社を約1年間追跡しました。「まず仮説を立て、市場のフィードバックを用いて検証する」という手法をと…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/12-22"},"children":[{"tag":"strong","props":{},"children":["職務においては規定に従って行動し、規定外の善意はまず責任の所在を明確にすること"]},{"tag":"span","props":{},"children":["看護師を例に挙げると：条例には、患者の病状が危急であることを発見した際は、直ちに医師に通知しなければならない、医師の指示が規定に違反してい…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/12-23"},"children":[{"tag":"strong","props":{},"children":["損失が出たら手続きに従って退場を：簡便な注銷ができるなら注銷し、債務超過なら破産を。放置してはいけない"]},{"tag":"span","props":{},"children":["債務、未払賃金、税金、社会保険料の未払いがない場合、全投資家が誓約書を作成し、20 日間公示して異議がなければ簡便な注銷が可能です。個人事…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/12-24"},"children":[{"tag":"strong","props":{},"children":["ネットショップの運営代行、開店セミナー、 「無在庫販売」に手を出して費用を支払う前に、追加料金の有無と売上の出所を必ず確認すること"]},{"tag":"span","props":{},"children":["この種の詐欺は、まず少額を支払わせ、その後「プランのアップグレード」「仕入れ代金の立て替え」「凍結解除金」などの名目で、何度も追加送金を要…"]}]}]}]},{"tag":"a","props":{"className":"life-text-link","href":"/ja/book/12"},"children":["テーマ全体を読む：起業とビジネス：全財産を失わないために"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"15","height":"15","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinec