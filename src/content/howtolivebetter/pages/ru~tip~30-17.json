},"children":[]},{"tag":"path","props":{"d":"m6.34 17.66-1.41 1.41"},"children":[]},{"tag":"path","props":{"d":"m19.07 4.93-1.41 1.41"},"children":[]}]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"17","height":"17","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-moon life-theme-icon-dark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"},"children":[]}]}]},{"tag":"button","props":{"type":"button","className":"life-language-switch","aria-label":"Русский Выбрать язык","aria-haspopup":"menu","aria-expanded":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-globe","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]},{"tag":"path","props":{"d":"M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"},"children":[]},{"tag":"path","props":{"d":"M2 12h20"},"children":[]}]},{"tag":"span","props":{},"children":["Русский"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]}]},{"tag":"a","props":{"className":"life-account","href":"/ru/sign-in"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"17","height":"17","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle-user-round","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M18 20a6 6 0 0 0-12 0"},"children":[]},{"tag":"circle","props":{"cx":"12","cy":"10","r":"4"},"children":[]},{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},{"tag":"span","props":{},"children":["Войти"]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/ru/book/30"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"К содержанию"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["Дети после поступления в школу"]},{"tag":"nav","props":{"aria-label":"Советы главы"},"children":[{"tag":"a","props":{"href":"/ru/tip/30-01"},"children":[{"tag":"span","props":{},"children":["01"]},"Внезапная сильная боль в мошонке у мальчика — повод немедленно ехать в больницу, не дожидаясь конца уроков"]},{"tag":"a","props":{"href":"/ru/tip/30-02"},"children":[{"tag":"span","props":{},"children":["02"]},"Не откладывайте необходимое лечение «до окончания экзаменов» — для некоторых состояний существует временное окно, зависящее от сроков роста костей, а не от расписания экзаменов"]},{"tag":"a","props":{"href":"/ru/tip/30-03"},"children":[{"tag":"span","props":{},"children":["03"]},"Ребёнок подвергся издевательствам: в тот же день следует сообщить об этом в школу и потребовать письменного рассмотрения дела; в случаях избиения, отъёма денег или распространения слухов необходимо сразу вызывать полицию"]},{"tag":"a","props":{"href":"/ru/tip/30-04"},"children":[{"tag":"span","props":{},"children":["04"]},"Чтобы предотвратить близорукость, детям необходимо проводить на улице не менее 2 часов в день — это единственный метод, подтвержденный рандомизированными исследованиями"]},{"tag":"a","props":{"href":"/ru/tip/30-05"},"children":[{"tag":"span","props":{},"children":["05"]},"Детям до 3 лет экраны не давать, детям от 3 до 6 лет — по возможности тоже не давать; школьникам использовать экраны в неучебных целях не более 1 часа в день"]},{"tag":"a","props":{"href":"/ru/tip/30-06"},"children":[{"tag":"span","props":{},"children":["06"]},"Восприятие близорукости как необратимого повреждения: чем выше степень близорукости, тем выше риск развития отслойки сетчатки, макулярной дегенерации и глаукомы в будущем"]},{"tag":"a","props":{"href":"/ru/tip/30-07"},"children":[{"tag":"span","props":{},"children":["07"]},"Каждый год нужно внимательно изучать выданный школьникам медицинский осмотр — при выявлении отклонений в тот же год следует обратиться к врачу"]},{"tag":"a","props":{"href":"/ru/tip/30-08"},"children":[{"tag":"span","props":{},"children":["08"]},"Проведение скрининга на депрессию для подростков 12–18 лет: не следует считать школьные психологические тесты диагнозом"]},{"tag":"a","props":{"href":"/ru/tip/30-09"},"children":[{"tag":"span","props":{},"children":["09"]},"Не покупайте товары и услуги, которые якобы «излечивают близорукость» или «снижают степень близорукости»"]},{"tag":"a","props":{"href":"/ru/tip/30-10"},"children":[{"tag":"span","props":{},"children":["10"]},"Для сна, учебного расписания, физических занятий и ранжирования учеников существуют чёткие правила; если школа их не соблюдает, можно об этом заявить"]},{"tag":"a","props":{"href":"/ru/tip/30-11"},"children":[{"tag":"span","props":{},"children":["11"]},"Ребенку можно взять академический отпуск, если он не справляется с учебой; при этом школа обязана сохранить его ученический статус на срок до 1 года"]},{"tag":"a","props":{"href":"/ru/tip/30-12"},"children":[{"tag":"span","props":{},"children":["12"]},"Обнаружена плохая острота зрения: в больнице проводят проверку с применением мидриатика, а затем по рекомендации врача делают повторные осмотры"]},{"tag":"a","props":{"href":"/ru/tip/30-13"},"children":[{"tag":"span","props":{},"children":["13"]},"Герметизация фиссур на постоянных коренных зубах после их прорезывания"]},{"tag":"a","props":{"href":"/ru/tip/30-14"},"children":[{"tag":"span","props":{},"children":["14"]},"Ребенок любит играть в игры: сначала проверьте, не пострадали ли сон, уроки и прогулки, а не только время, проведенное за игрой"]},{"tag":"a","props":{"href":"/ru/tip/30-15"},"children":[{"tag":"span","props":{},"children":["15"]},"Ребенок говорит, что ему нравятся люди своего пола: не ругайте, не выгоняйте из дома и не отправляйте на «исправление»: отношение в семье напрямую связано с риском самоубийства"]},{"tag":"a","props":{"href":"/ru/tip/30-16"},"children":[{"tag":"span","props":{},"children":["16"]},"Не бейте ребёнка и не кричите, не называя его глупым или ленивым: у часто наказываемых телом или словами детей чаще проблемы с поведением и настроением"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/ru/tip/30-17","data-status":"active"},"children":[{"tag":"span","props":{},"children":["17"]},"Если с ребёнком не справляетесь и снова бьёте или кричите, пройдите курс с конкретными родительскими навыками"]},{"tag":"a","props":{"href":"/ru/tip/30-18"},"children":[{"tag":"span","props":{},"children":["18"]},"Не отправляйте детей в закрытые «школы лечения интернет-зависимости» и «спецлагеря»: закон запрещает вредные методы, а дети уже погибали в заключении"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"Навигация"},"children":[{"tag":"a","props":{"href":"/ru/book"},"children":["Книга"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/ru/book/30"},"children":["Глава 30"," ·"," ","Дети после поступления в школу"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"30-17"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["17"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["Доказательства"," ","A"]}]},{"tag":"h1","props":{"lang":"ru"},"children":["Если с ребёнком не справляетесь и снова бьёте или кричите, пройдите курс с конкретными родительскими навыками"]},{"tag":"p","props":{"lang":"ru","className":"life-entry-summary"},"children":["Программы, где учат конкретным приёмам, в рандомизированных испытаниях снижают у детей драки и нарушения правил, а настроение родителей улучшается. Родители реже бьют и кричат — сильнее сразу после курса, через год–два эффект меньше, но остаётся. В Шанхае похожие испытания тоже дали положительный результат."]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Затраты"]},{"tag":"p","props":{},"children":["Родительские школы при школах, детсадах и в сообществах —…"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Польза"]},{"tag":"p","props":{},"children":["Cochrane объединил 13 испытаний, 10 рандомизированных, 1 078 родителей детей 3–12 лет с проблемами поведения.…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"Отметить: Если с ребёнком не справляетесь и снова бьёте или кричите, пройдите курс с конкретными родительскими навыками"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"Сделано"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"В планах"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"В избранное"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Поделиться советом"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Скрыть подробности"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Затраты"]},{"tag":"p","props":{},"children":["Родительские школы при школах, детсадах и в сообществах — государственные и бесплатные. Программы с доказанной эффективностью — раз в неделю или две, 1–2 часа за занятие, 4–24 недели. Нужно практиковать дома. Трудно дойти до конца и отрабатывать каждый день."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Польза"]},{"tag":"p","props":{},"children":["Cochrane объединил 13 испытаний, 10 рандомизированных, 1 078 родителей детей 3–12 лет с проблемами поведения. После обучения проблемы поведения у детей снизились. По отчёту родителей SMD −0,53 (95% CI −0,72 to −0,34); независимые оценщики −0,44 (−0,77 to −0,11). SMD совпадает с d; 0,5 — средний эффект. Психическое здоровье родителей улучшилось −0,36 (−0,52 to −0,20). Жёсткое или негативное родительство снизилось: по отчёту родителей −0,77 (−0,96 to −0,59), независимо −0,42 (−0,67 to −0,16). Авторы называют это краткосрочным эффектом. Другой метаанализ просмотрел 346 рандомизированных испытаний; 60 измеряли удары или крики в 22 странах. Удары/крики сразу после курса d = −0,46 (−0,59 to −0,33). Через 1–6 месяцев −0,24 (−0,37 to −0,11). Через 7–24 месяца −0,18 (−0,34 to −0,02), со временем слабеет. Большинство данных — от родителей. В Китае в Шанхае рандомизировали 81 родителя на групповое обучение Triple P против листа ожидания; после курса и через 6 месяцев адаптация ребёнка, практики воспитания и настроение родителей были лучше, чем в группе ожидания. Сельское испытание в детсаде, 191 опекун: онлайн-уроки в своём темпе плюс две групповые дискуссии против только книги; через две недели самоотчёт о жестоком обращении с ребёнком был примерно на 33% ниже (IRR 0,67). Через три месяца проблемы поведения у детей ниже (d = −0,40). Закон о содействии семейному образованию обязывает родителей изучать знания о семейном воспитании. Школы и детсады могут вести родительские школы с регулярными публичными консультациями; уличные комитеты — общественные родительские школы. Органы провинциального уровня должны давать публичные онлайн-родительские школы и горячие линии. Учреждения семейного просвещения не могут вести коммерческие курсы (по всей стране, с 1 января 2022 года)."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Первоисточники"]},{"tag":"p","props":{"className":"life-citations"},"children":["Furlong M, McGilloway S, Bywater T, Hutchings J, Smith SM, Donnelly M. (2012). Behavioural and cognitive-behavioural group-based parenting programmes for early-onset conduct problems in children aged 3 to 12 years. Cochrane Database of Systematic Reviews, (2), CD008225. ",{"tag":"a","props":{"href":"https://doi.org/10.1002/14651858.CD008225.pub2","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1002/14651858.CD008225.pub2"]},"；Backhaus S, Leijten P, Jochim J, Melendez-Torres GJ, Gardner F. (2023). Effects over time of parenting interventions to reduce physical and emotional violence against children: a systematic review and meta-analysis. eClinicalMedicine, 60, 102003. ",{"tag":"a","props":{"href":"https://doi.org/10.1016/j.eclinm.2023.102003","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1016/j.eclinm.2023.102003"]},"；Guo M, Morawska A, Sanders MR. (2016). A Randomized Controlled Trial of Group Triple P With Chinese Parents in Mainland China. Behavior Modification, 40(6), 825–851. ",{"tag":"a","props":{"href":"https://doi.org/10.1177/0145445516644221","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1177/0145445516644221"]},"；Wang W, Zhang H. (2026). A self-directed parenting program to reduce the risk of child maltreatment in rural China: A cluster randomized controlled trial. Child Abuse & Neglect, 173, 107937. ",{"tag":"a","props":{"href":"https://doi.org/10.1016/j.chiabu.2026.107937","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1016/j.chiabu.2026.107937"]},"；全国人大常委会 (2021). 家庭教育促进法（第十八、二十五、三十一、三十八、四十条）. ",{"tag":"a","props":{"href":"https://flk.npc.gov.cn/detail?id=ff8081817cac3b2d017cac5a6c6f0109","target":"_blank","rel":"noopener noreferrer"},"children":["https://flk.npc.gov.cn/detail?id=ff8081817cac3b2d017cac5a6c6f0109"]}]},{"tag":"a","props":{"href":"https://doi.org/10.1002/14651858.CD008225.pub2","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Открыть источник"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Примечание автора"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["Уровень A — Cochrane и объединённые рандомизированные испытания. Общее: инструкторы учат конкретным навыкам (игра с ребёнком, похвала, поощрения, дисциплина); родители практикуют и получают «домашку». Программы, где только раздавали материалы или только обсуждали, исключили — значит, одноразовые лекции доказательствами не покрыты. Содержание местных публичных родительских школ разное и может не совпадать с этой моделью — ищите многонедельные курсы с отработкой навыков. Названия часто включают Triple P, Incredible Years, Parent–Child Interaction Therapy (PCIT). Книга не рекомендует конкретных провайдеров или платные продукты. Снижение ударов через год–два слабеет; после курса продолжайте практику. Получатели — ребёнок и вы. Если у ребёнка уже тяжёлые эмоциональные проблемы — к психиатру или детскому психологу; пункт 8 этого раздела (скрининг депрессии)."]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Моя заметка"]},{"tag":"button","props":{"type":"button"},"children":["Запишите напоминание…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/ru/tip/30-16"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Предыдущий"]},"Не бейте ребёнка и не кричите, не называя его глупым или ленивым: у часто наказываемых телом или словами детей чаще проблемы с поведением и настроением"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/ru/tip/30-18"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Следующий"]},"Не отправляйте детей в закрытые «школы лечения интернет-зависимости» и «спецлагеря»: закон запрещает вредные методы, а дети уже погибали в заключении"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["Другие советы по этой теме"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/30-10"},"children":[{"tag":"strong","props":{},"children":["Для сна, учебного расписания, физических занятий и ранжирования учеников существуют чёткие правила; если школа их не соблюдает, можно об этом заявить"]},{"tag":"span","props":{},"children":["Все эти требования прописаны чёрным по белому: младшеклассники должны…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/30-11"},"children":[{"tag":"strong","props":{},"children":["Ребенку можно взять академический отпуск, если он не справляется с учебой; при этом школа обязана сохранить его ученический статус на срок до 1 года"]},{"tag":"span","props":{},"children":["Академический отпуск предусмотрен официальной системой. После подачи …"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/30-12"},"children":[{"tag":"strong","props":{},"children":["Обнаружена плохая острота зрения: в больнице проводят проверку с применением мидриатика, а затем по рекомендации врача делают повторные осмотры"]},{"tag":"span","props":{},"children":["Проверка с применением мидриатика подразумевает закапывание специальн…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/30-13"},"children":[{"tag":"strong","props":{},"children":["Герметизация фиссур на постоянных коренных зубах после их прорезывания"]},{"tag":"span","props":{},"children":["Герметизация фиссур заключается в заполнении специальным составом угл…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/30-14"},"children":[{"tag":"strong","props":{},"children":["Ребенок любит играть в игры: сначала проверьте, не пострадали ли сон, уроки и прогулки, а не только время, проведенное за игрой"]},{"tag":"span","props":{},"children":["Настоящее «игровое расстройство» встречается примерно у двух-трех чел…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/30-15"},"children":[{"tag":"strong","props":{},"children":["Ребенок говорит, что ему нравятся люди своего пола: не ругайте, не выгоняйте из дома и не отправляйте на «исправление»: отношение в семье напрямую связано с риском самоубийства"]},{"tag":"span","props":{},"children":["Среди китайских школьников, которым нравятся люди своего пола или пре…"]}]}]}]},{"tag":"a","props":{"className":"life-text-link","href":"/ru/book/30"},"children":["Читать всю тему: Дети после поступления в школу"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"15","height":"15","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","ari