lassName":""},"children":[{"tag":"span","props":{},"children":["39"]},"上夜班干得越久心血管风险越高，能转岗就趁早转"]},{"tag":"a","props":{"href":"/tip/02-40","className":""},"children":[{"tag":"span","props":{},"children":["40"]},"买预包装、有 SC 编号的食用油，不买小作坊散装自榨花生油"]},{"tag":"a","props":{"href":"/tip/02-41","className":""},"children":[{"tag":"span","props":{},"children":["41"]},"做饭用植物油代替猪油和黄油，不必为了健康换着买油，也别指望亚麻籽油护心"]},{"tag":"a","props":{"href":"/tip/02-42","className":""},"children":[{"tag":"span","props":{},"children":["42"]},"炒菜、煎炸时打开抽油烟机，从开火一直开到做完"]},{"tag":"a","props":{"href":"/tip/02-43","className":""},"children":[{"tag":"span","props":{},"children":["43"]},"绝经前后潮热盗汗影响到生活，就去妇科评估激素治疗，别硬扛也别自己买药，更别拿它防心脏病"]},{"tag":"a","props":{"href":"/tip/02-44","className":"active"},"children":[{"tag":"span","props":{},"children":["44"]},"本来就想养狗的，把每天遛狗算进走路量，别为了长寿专门去养狗"]},{"tag":"a","props":{"href":"/tip/02-45","className":""},"children":[{"tag":"span","props":{},"children":["45"]},"查出糖尿病前期（血糖偏高、还没到糖尿病），就靠少吃、减重、多动把糖尿病往后推，每半年复查一次血糖"]},{"tag":"a","props":{"href":"/tip/02-46","className":""},"children":[{"tag":"span","props":{},"children":["46"]},"家里的花生、玉米、坚果和米面发了霉，整包扔掉，别挑掉霉的吃剩下的；嚼到发苦的坚果马上吐掉"]},{"tag":"a","props":{"href":"/tip/02-47","className":""},"children":[{"tag":"span","props":{},"children":["47"]},"别吃淡水鱼虾做的鱼生、生鱼片、鱼生粥和醉虾，常吃过的去医院查一次肝吸虫，查出来按医嘱吃吡喹酮"]}]}]},{"tag":"div","props":{"className":"life-tip-page","data-tip-locales":"zh,en,ru,es,ja,vi"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"当前位置"},"children":[{"tag":"a","props":{"href":"/book"},"children":["阅读全书"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/book/02"},"children":["第 2 章 · 不要慢慢死"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"02-44"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["44"]},{"tag":"span","props":{"className":"life-evidence grade-b"},"children":["证据 B"]}]},{"tag":"h1","props":{"lang":"zh"},"children":["本来就想养狗的，把每天遛狗算进走路量，别为了长寿专门去养狗"]},{"tag":"p","props":{"lang":"zh","className":"life-entry-summary"},"children":["养狗的人同期死亡的概率平均低约四分之一，心梗、中风之后养狗的人低得更多。但扣掉其他差别以后，英国和挪威的大研究都看不出差别，养猫也看不出关联。所以别为了长寿专门养狗，本来想养的，把每天遛狗当成走路。"]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["成本"]},{"tag":"p","props":{},"children":["养狗是一直要花的钱，狗粮、疫苗、驱虫、看病、办证都要掏，要一直管到狗老死。每天要抽时间遛狗，出差旅行要找人照看。难在要天天坚持，养了就不能想停就停。国内没有官方统计养一只狗要花多少钱，这里不写数字。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["收益"]},{"tag":"p","props":{},"children":["把 10 项跟踪研究合起来算，约 384 万人，平均跟了 10.1 年。养狗的人死亡风险低约 24%（RR 0.76，95% CI 0.67–0.86，这是可信范围）。心血管死亡低约 31%（RR 0.69，0.67–0.71）。得过冠心病的人里，家里有狗的低约 65%（RR 0.35，0.17–0…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"标记：本来就想养狗的，把每天遛狗算进走路量，别为了长寿专门去养狗"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"已做到"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"加入待做"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"收藏"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"分享这条建议"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"收起详情"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["成本"]},{"tag":"p","props":{"className":"life-citations"},"children":["养狗是一直要花的钱，狗粮、疫苗、驱虫、看病、办证都要掏，要一直管到狗老死。每天要抽时间遛狗，出差旅行要找人照看。难在要天天坚持，养了就不能想停就停。国内没有官方统计养一只狗要花多少钱，这里不写数字。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["收益"]},{"tag":"p","props":{"className":"life-citations"},"children":["把 10 项跟踪研究合起来算，约 384 万人，平均跟了 10.1 年。养狗的人死亡风险低约 24%（RR 0.76，95% CI 0.67–0.86，这是可信范围）。心血管死亡低约 31%（RR 0.69，0.67–0.71）。得过冠心病的人里，家里有狗的低约 65%（RR 0.35，0.17–0.69）。作者写明，这个汇总没有扣除其他因素。瑞典全国约 343 万人的登记研究扣除了收入、婚姻等因素。独居的人养狗，死亡风险低约 33%（HR 0.67，0.65–0.69）。和别人同住的低约 11%（HR 0.89，0.87–0.91）。瑞典心梗之后的病人里，独居养狗的死亡风险低约 33%（HR 0.67，0.61–0.75），和伴侣或孩子同住的低约 15%（HR 0.85，0.80–0.90）。缺血性中风之后分别低约 27%（HR 0.73，0.66–0.80）和 12%（HR 0.88，0.83–0.93）。反方：英国 6 批健康调查共 59352 人，平均跟了 11.5 年。全部校正后，养狗和死亡没有关联（HR 1.03，0.98–1.09），和心血管死亡也没有（HR 1.07，0.96–1.18）。挪威一项研究跟了中位 18.5 年，养狗的人死亡风险几乎一样（HR 1.00，0.91–1.09）。那里养狗的人活动量也不比别人多。瑞典双胞胎登记里有 34202 人能问到生活习惯，在他们身上，养狗和心血管病、死亡风险低的关系没能重复出来。澳大利亚一项研究 15735 人跟了 4 年，养狗的人死亡风险低约 23%（OR 0.77，0.59–0.99），其中一部分能用活动量多来解释。养猫、养鸟、养鱼都看不出和死亡有关。美国心脏协会 2013 年的声明说，养宠物尤其是养狗，用来降心血管风险「可能合理」，这是最弱一档的推荐。同一份声明明确反对主要为了降心血管风险去领养、救助或买宠物。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["来源"]},{"tag":"p","props":{"className":"life-citations"},"children":["Kramer CK, Mehmood S, Suen RS (2019). Dog ownership and survival: a systematic review and meta-analysis. Circulation: Cardiovascular Quality and Outcomes, 12(10), e005554. ",{"tag":"a","props":{"href":"https://doi.org/10.1161/CIRCOUTCOMES.119.005554","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1161/CIRCOUTCOMES.119.005554"]},"；Mubanga M, Byberg L, Nowak C, 等 (2017). Dog ownership and the risk of cardiovascular disease and death – a nationwide cohort study. Scientific Reports, 7, 15821. ",{"tag":"a","props":{"href":"https://doi.org/10.1038/s41598-017-16118-6","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1038/s41598-017-16118-6"]},"；Mubanga M, Byberg L, Egenvall A, Ingelsson E, Fall T (2019). Dog ownership and survival after a major cardiovascular event: a register-based prospective study. Circulation: Cardiovascular Quality and Outcomes, 12(10), e005342. ",{"tag":"a","props":{"href":"https://doi.org/10.1161/CIRCOUTCOMES.118.005342","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1161/CIRCOUTCOMES.118.005342"]},"；Ding D, Bauman AE, Sherrington C, 等 (2018). Dog ownership and mortality in England: a pooled analysis of six population-based cohorts. American Journal of Preventive Medicine, 54(2), 289-293. ",{"tag":"a","props":{"href":"https://doi.org/10.1016/j.amepre.2017.09.012","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1016/j.amepre.2017.09.012"]},"；Torske MO, Krokstad S, Stamatakis E, Bauman A (2017). Dog ownership and all-cause mortality in a population cohort in Norway: the HUNT study. PLoS ONE, 12(6), e0179832. ",{"tag":"a","props":{"href":"https://doi.org/10.1371/journal.pone.0179832","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1371/journal.pone.0179832"]},"；Taniguchi Y, Ikeuchi T, Yong J (2024). Dog, cat, bird, fish, and other pet ownership and mortality: evidence from the HILDA cohort. PLoS ONE, 19(8), e0305546. ",{"tag":"a","props":{"href":"https://doi.org/10.1371/journal.pone.0305546","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1371/journal.pone.0305546"]},"；Mubanga M, Byberg L, Egenvall A, 等 (2019). Dog ownership and cardiovascular risk factors: a nationwide prospective register-based cohort study. BMJ Open, 9(3), e023447. ",{"tag":"a","props":{"href":"https://doi.org/10.1136/bmjopen-2018-023447","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1136/bmjopen-2018-023447"]},"；Levine GN, Allen K, Braun LT, 等 (2013). Pet ownership and cardiovascular risk: a scientific statement from the American Heart Association. Circulation, 127(23), 2353-2363. ",{"tag":"a","props":{"href":"https://doi.org/10.1161/CIR.0b013e31829201e1","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1161/CIR.0b013e31829201e1"]},""]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["原书备注"]},{"tag":"p","props":{"className":"life-citations"},"children":["争议。上面全是跟踪记录，没有分组对照，所以推不出「为了长寿去养狗」。会养狗的人可能本来就更健康、更爱动，有病或残疾的人可能本来就不太会养狗，这些差别扣不干净。汇总里那个 24% 没扣任何因素，能问到生活习惯的几项研究里，差别都没了。瑞典另一项研究里，养狗的人开始吃降压药、降脂药的反而略多一点，所以就算死亡风险真的低，也不是靠血压血脂降下来的。能落地的只有一件事：已经养了或本来就想养的，把每天遛狗算进走路的量，够不够看本节第 11 条（每天走到 7000–8000 步）。牵绳、打疫苗、狗伤人要赔的事见第 8 节第 30 条（养狗必须牵绳）。家里老人遛狗怎么握绳防摔，见第 17 节第 10 条（老人遛狗）。收益量级按汇总的 24% 机械定为大，但这个数没扣混杂。本条受益人主要是你自己。"]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["我的备注"]},{"tag":"button","props":{"type":"button"},"children":["写下对自己有用的提醒…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/tip/02-43"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["上一条"]},"绝经前后潮热盗汗影响到生活，就去妇科评估激素治疗，别硬扛也别自己买药，更别拿它防心脏病"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/tip/02-45"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["下一条"]},"查出糖尿病前期（血糖偏高、还没到糖尿病），就靠少吃、减重、多动把糖尿病往后推，每半年复查一次血糖"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["本主题的其他建议"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/02-37"},"children":[{"tag":"strong","props":{},"children":["把午睡控制在半小时内，别超过一小时，非得睡一两小时才撑得住就去查原因"]},{"tag":"span","props":{},"children":["午睡不超过一小时的人，死亡和慢性病的风险没有升高，脑子还更清醒一些。睡过一小时的人，冠心病风险高约三成，糖尿病和肥胖高约两成。所以定个闹钟，半小时叫醒自己。要是…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/02-38"},"children":[{"tag":"strong","props":{},"children":["熬夜之后第二天晚上就补觉，别攒到周末"]},{"tag":"span","props":{},"children":["少睡之后第二天晚上没补上的人，死亡风险比作息规律的人高约 15%，少得厉害又不补的高约 42%。补上了的人看不出风险升高。所以熬了夜，第二天晚上就早点上床。"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/02-39"},"children":[{"tag":"strong","props":{},"children":["上夜班干得越久心血管风险越高，能转岗就趁早转"]},{"tag":"span","props":{},"children":["上夜班的人，心血管病比不上夜班的人多约 13%，心血管死亡多约 27%。而且干得越久越多：每多上 5 年夜班，心血管病再多约 7%。所以这笔账按年数算，能转岗就…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/02-40"},"children":[{"tag":"strong","props":{},"children":["买预包装、有 SC 编号的食用油，不买小作坊散装自榨花生油"]},{"tag":"span","props":{},"children":["花生受潮发霉会长黄曲霉毒素，它是明确的致癌物，主要伤肝。广州管住小作坊之后，常吃自榨油的居民肝功能异常少了约三成半。广西的孕妇吃自榨花生油，孩子出生体重偏低的风…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/02-41"},"children":[{"tag":"strong","props":{},"children":["做饭用植物油代替猪油和黄油，不必为了健康换着买油，也别指望亚麻籽油护心"]},{"tag":"span","props":{},"children":["少吃猪油黄油这类饱和脂肪、换成植物油，心脏病和中风这类事少约一成七，但总的死亡风险没看出变化。大豆油、玉米油、菜籽油之间换来换去，没有证据说有什么区别。亚麻籽油…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/02-42"},"children":[{"tag":"strong","props":{},"children":["炒菜、煎炸时打开抽油烟机，从开火一直开到做完"]},{"tag":"span","props":{},"children":["不吸烟的中国女性，炒菜时不开或很少开抽油烟机，得肺癌的风险约是常开的两倍。住过厨房通风差的房子，风险也高约五成，烧煤的人家最明显。"]}]}]}]},{"tag":"a","props":{"className":"life-text-link","href":"/book/02"},"children":["阅读整个主题：不要慢慢死 ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"15","height":"15","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]}]}]},{"tag":"nav","props":{"className":"life-tabbar","aria-label":"主导航"},"children":[{"tag":"a","props":{"className":"","href":"/book"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"21","height":"21","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-book-open","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M12 7v14"},"children":[]},{"tag":"path","props":{"d":"M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z"},"children":[]}]},{"tag":"span","props":{},"children":["全书"]}]},{"tag":"a","props":{"className":"","href":"/top-50"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.or