"x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Chia sẻ mẹo này"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Ẩn chi tiết"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Chi phí"]},{"tag":"p","props":{},"children":["Một chiếc đệm giảm áp giá vài trăm tệ đến hơn một nghìn tệ. Mỗi ngày xem một lượt, một phút."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Lợi ích"]},{"tag":"p","props":{},"children":["Thử nghiệm lâm sàng ngẫu nhiên này làm ở 12 viện dưỡng lão, từ năm 2004 đến năm 2008 tuyển 232 cư dân trên 65 tuổi, mỗi ngày ngồi xe lăn hơn 6 giờ, điểm Braden dưới 18. Tất cả đều được lắp xe lăn vừa vặn trước, rồi chia ngẫu nhiên thành hai nhóm. Một nhóm dùng đệm bảo vệ da (bọt khí, chất lỏng dính cộng bọt, hoặc gel cộng bọt), một nhóm dùng đệm bọt cắt khúc dày 7.6 cm. Theo dõi 6 tháng hoặc cho đến khi xuất hiện loét. Loét ở vùng mỏm ngồi, nhóm bọt cắt khúc 8 ca (6.7%), nhóm đệm bảo vệ da 1 ca (0.9%), P=0.04. Tính gộp loét ở xương ngồi và vùng cùng cụt, nhóm bọt cắt khúc 21 ca (17.6%), nhóm đệm bảo vệ da 12 ca (10.6%), P=0.14, không ra khác biệt"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Nguồn gốc"]},{"tag":"p","props":{"className":"life-citations"},"children":["Brienza D, Kelsey S, Karg P, et al. (2010). A randomized clinical trial on preventing pressure ulcers with wheelchair seat cushions. Journal of the American Geriatrics Society, 58(12):2308-2314. ",{"tag":"a","props":{"href":"https://doi.org/10.1111/j.1532-5415.2010.03168.x","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1111/j.1532-5415.2010.03168.x"]}]},{"tag":"a","props":{"href":"https://doi.org/10.1111/j.1532-5415.2010.03168.x","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Liên kết mở nguồn"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Ghi chú sách"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["Chọn B có hai lý do. Thứ nhất mẫu chỉ có 232 người, P của điểm chính 0.04 vừa vượt qua, điểm phụ không ra khác biệt. Thứ hai đối tượng là cư dân cao tuổi ở viện dưỡng lão, áp sang người dùng xe lăn trẻ tuổi thì là suy diễn lan. Trong thử nghiệm tất cả đều được lắp xe lăn vừa vặn trước, nên「vừa vặn」và「đệm」cùng có tác dụng, đừng chỉ đổi đệm. Phòng loét cho người nằm lâu: đệm khí và lật người đúng giờ, xem mục 8 ở phần 17 (loét). Cách nộp đơn xin trợ cấp lắp thiết bị hỗ trợ kiểu cơ bản, xem mục 7 của phần này (hỏi hết ở hội người khuyết tật cấp huyện)."]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Ghi chú của tôi"]},{"tag":"button","props":{"type":"button"},"children":["Viết một lời nhắc cho chính bạn…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/vi/tip/33-04"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Trước"]},"Người chăm lâu dài người khuyết tật trong nhà, sức khỏe của chính mình cũng phải có người nhìn"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/vi/tip/33-06"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Tiếp theo"]},"Đừng mua các liệu pháp và thiết bị「chữa khỏi bại liệt, mù lòa, điếc」"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"