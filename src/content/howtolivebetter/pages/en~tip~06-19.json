":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-up-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M7 7h10v10"},"children":[]},{"tag":"path","props":{"d":"M7 17 17 7"},"children":[]}]}]}]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/en/book/06"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"Back to index"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["Items to avoid"]},{"tag":"div","props":{"data-ad-dock-host":"true"},"children":[]},{"tag":"nav","props":{"aria-label":"Chapter entries"},"children":[{"tag":"a","props":{"href":"/en/tip/06-01"},"children":[{"tag":"span","props":{},"children":["01"]},"Don’t take multivitamins for longevity or heart protection"]},{"tag":"a","props":{"href":"/en/tip/06-02"},"children":[{"tag":"span","props":{},"children":["02"]},"Don’t take regular fish oil capsules to prevent heart disease"]},{"tag":"a","props":{"href":"/en/tip/06-03"},"children":[{"tag":"span","props":{},"children":["03"]},"Don’t give vitamin D supplements to people who already have enough"]},{"tag":"a","props":{"href":"/en/tip/06-04"},"children":[{"tag":"span","props":{},"children":["04"]},"Don’t take antioxidant supplements to prevent cancer (beta-carotene, vitamin E, vitamin A)"]},{"tag":"a","props":{"href":"/en/tip/06-05"},"children":[{"tag":"span","props":{},"children":["05"]},"Don’t expect glucosamine/chondroitin to treat knee osteoarthritis"]},{"tag":"a","props":{"href":"/en/tip/06-06"},"children":[{"tag":"span","props":{},"children":["06"]},"Don’t rely on vitamin C to prevent colds"]},{"tag":"a","props":{"href":"/en/tip/06-07"},"children":[{"tag":"span","props":{},"children":["07"]},"Don’t get a whole-body PET-CT or tumor marker panel if you have no symptoms"]},{"tag":"a","props":{"href":"/en/tip/06-08"},"children":[{"tag":"span","props":{},"children":["08"]},"Don’t expect fitness trackers or smartwatches to help you lose weight"]},{"tag":"a","props":{"href":"/en/tip/06-09"},"children":[{"tag":"span","props":{},"children":["09"]},"Don’t pay a premium for organic food just to be “healthier”"]},{"tag":"a","props":{"href":"/en/tip/06-10"},"children":[{"tag":"span","props":{},"children":["10"]},"Don’t spend a lot of money on health supplements, herbal formulas, or tonics to “improve your health”"]},{"tag":"a","props":{"href":"/en/tip/06-11"},"children":[{"tag":"span","props":{},"children":["11"]},"Don’t take probiotics long-term if you have no gut problems"]},{"tag":"a","props":{"href":"/en/tip/06-12"},"children":[{"tag":"span","props":{},"children":["12"]},"Don’t force yourself to take cold showers just to “boost immunity”"]},{"tag":"a","props":{"href":"/en/tip/06-13"},"children":[{"tag":"span","props":{},"children":["13"]},"Don’t buy products marketed for detox, colon cleansing, enzymes, or alkaline water"]},{"tag":"a","props":{"href":"/en/tip/06-14"},"children":[{"tag":"span","props":{},"children":["14"]},"Don’t force yourself to drink water just to hit “8 glasses a day”"]},{"tag":"a","props":{"href":"/en/tip/06-15"},"children":[{"tag":"span","props":{},"children":["15"]},"Don’t spend money on fortune‑telling, tarot, or astrology to make decisions"]},{"tag":"a","props":{"href":"/en/tip/06-16"},"children":[{"tag":"span","props":{},"children":["16"]},"Don’t buy blue-light-blocking glasses to “protect your vision,” and don’t believe claims that staring at screens for months will ruin your eyes — but severe eye pain, redness, and swelling require immediate medical attention"]},{"tag":"a","props":{"href":"/en/tip/06-17"},"children":[{"tag":"span","props":{},"children":["17"]},"Don’t treat blood donation as a health habit: claims that it “detoxifies, lowers cholesterol, and prevents heart attacks” lack randomized trial support, while frequent donation truly causes iron deficiency"]},{"tag":"a","props":{"href":"/en/tip/06-18"},"children":[{"tag":"span","props":{},"children":["18"]},"Don’t rely on generic health check packages to prevent disease; instead, get the evidence‑based screenings appropriate for your age and gender"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/en/tip/06-19","data-status":"active"},"children":[{"tag":"span","props":{},"children":["19"]},"Don’t start taking uric‑acid‑lowering drugs just because a checkup shows high uric acid but you’ve never had symptoms"]},{"tag":"a","props":{"href":"/en/tip/06-20"},"children":[{"tag":"span","props":{},"children":["20"]},"Don’t have a gallbladder removed prophylactically just because an ultrasound found gallstones but you’ve never felt any pain"]},{"tag":"a","props":{"href":"/en/tip/06-21"},"children":[{"tag":"span","props":{},"children":["21"]},"Don’t cut calcium out to prevent kidney stones"]},{"tag":"a","props":{"href":"/en/tip/06-22"},"children":[{"tag":"span","props":{},"children":["22"]},"Don’t buy crystals, bracelets, or Pixiu figurines for “good luck,” “wealth attraction,” or “health benefits”"]},{"tag":"a","props":{"href":"/en/tip/06-23"},"children":[{"tag":"span","props":{},"children":["23"]},"Don’t expect shopping to lift your mood or boost your sense of self-worth"]},{"tag":"a","props":{"href":"/en/tip/06-24"},"children":[{"tag":"span","props":{},"children":["24"]},"Don’t spend extra money to “move up a rung” among your peers by buying a new house, car, or social circle"]},{"tag":"a","props":{"href":"/en/tip/06-25"},"children":[{"tag":"span","props":{},"children":["25"]},"Don’t believe that “willpower is like a muscle that runs out after use”"]},{"tag":"a","props":{"href":"/en/tip/06-26"},"children":[{"tag":"span","props":{},"children":["26"]},"Don’t expect skipping breakfast or the 16:8 intermittent fasting method to help you control your weight; instead, pick a meal timing you can stick to long-term"]},{"tag":"a","props":{"href":"/en/tip/06-27"},"children":[{"tag":"span","props":{},"children":["27"]},"Do not believe that \"masturbation harms the body\" or that \"abstinence is the only way to improve\"; what truly matters is whether it interferes with your sleep, work, and relationships"]},{"tag":"a","props":{"href":"/en/tip/06-28"},"children":[{"tag":"span","props":{},"children":["28"]},"Do not spend money on \"conversion therapy\" or \"gay علاج,\" and do not send your family members to undergo it either"]},{"tag":"a","props":{"href":"/en/tip/06-29"},"children":[{"tag":"span","props":{},"children":["29"]},"Do not expect “correct lifting posture” or lifting training to prevent back pain; reduce the weight and number of lifts, and exercise regularly"]},{"tag":"a","props":{"href":"/en/tip/06-30"},"children":[{"tag":"span","props":{},"children":["30"]},"Do not expect extra calcium or bone broth to make a fracture heal faster"]},{"tag":"a","props":{"href":"/en/tip/06-31"},"children":[{"tag":"span","props":{},"children":["31"]},"Don’t rely on an AI chatbot alone to judge a medical or legal problem; before seeing a doctor, going to court or spending big money, find the source it cites and check it against the original"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"Breadcrumb"},"children":[{"tag":"a","props":{"href":"/en/book"},"children":["Explore the book"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/en/book/06"},"children":["Chapter 6"," ·"," ","Items to avoid"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"06-19"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["19"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["Evidence"," ","A"]}]},{"tag":"h1","props":{"lang":"en"},"children":["Don’t start taking uric‑acid‑lowering drugs just because a checkup shows high uric acid but you’ve never had symptoms"]},{"tag":"p","props":{"lang":"en","className":"life-entry-summary"},"children":["People whose uric acid levels are high but who’ve never had gout attacks or tophus deposits mainly gain peace of mind from taking uric‑acid‑lowering drugs. According to calculations by the American College of Rheumatology, you’d need to treat 24 people for three full years just to prevent a single gout episode. These drugs also won’t protect your kidneys; in randomized trials the rate of kidney‑function decline was identical in patients taking them and those on a placebo. What truly helps is keeping weight, alcohol, and sugary drinks in check — and only treating gout after an actual attack occurs."]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Cost"]},{"tag":"p","props":{},"children":["There’s no cost at all;"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Benefit"]},{"tag":"p","props":{},"children":["The 2020 gout guidelines from the American College of Rheumatology address asymptomatic hyperuricemia, defined…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"Mark: Don’t start taking uric‑acid‑lowering drugs just because a checkup shows high uric acid but you’ve never had symptoms"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"Done"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"Plan to do"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"Save"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Share this tip"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Hide details"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Cost"]},{"tag":"p","props":{},"children":["There’s no cost at all; you also avoid long‑term medication expenses, regular follow‑ups, and the risks linked to unnecessary drug use."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Benefit"]},{"tag":"p","props":{},"children":["The 2020 gout guidelines from the American College of Rheumatology address asymptomatic hyperuricemia, defined as blood uric‑acid levels above 6.8 mg/dL in people who’ve never had gout or tophus. Under certain conditions the guidelines advise against initiating any uric‑acid‑lowering therapy — drugs such as allopurinol, febuxostat, or probenecid. Evidence supporting this recommendation is rated “high.” A footnote clarifies that, based on attributable risk, 24 patients must be treated for three years to prevent one gout episode. The CKD‑FIX trial enrolled 363 participants with stage 3 or 4 chronic kidney disease; they had no gout history but faced a higher risk of worsening kidney function. One group received 100–300 mg of allopurinol daily while the other got a placebo; after 104 weeks the annual change in eGFR — a key kidney‑function marker measured in mL/min/1.73 m² — was –3.33 (95 % CI –4.11 to –2.55) in the drug group versus –3.23 (–3.98 to –2.47) in the placebo group. The difference between groups was –0.10 (–1.18 to 0.97), with a P‑value of 0.85, meaning kidney‑function decline proceeded at the same pace. Serious adverse events occurred in 46 % of patients on allopurinol versus 44 % on placebo. The PERL trial involved 530 type 1 diabetics with early‑to‑moderate diabetic kidney disease; after three years of allopurinol therapy the drug was withdrawn for two months to gauge its effect. Allopurinol lowered blood uric‑acid from 6.1 mg/dL to 3.9 mg/dL, yet after discontinuation the eGFR difference between groups narrowed to just 0.001 mL/min/1.73 m² (95 % CI –1.9 to 1.9, P = 0.99). Moreover, urinary albumin excretion rose 40 % (range 0–80 %) in the allopurinol group. The apparent “benefit” stems largely from the intuitive notion that any elevated marker warrants medication."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Original sources"]},{"tag":"p","props":{"className":"life-citations"},"children":["FitzGerald JD, Dalbeth N, Mikuls T, et al. (2020). 2020 American College of Rheumatology Guideline for the Management of Gout. Arthritis Care & Research, 72(6), 744-760（表 1 及其脚注）. ",{"tag":"a","props":{"href":"https://doi.org/10.1002/acr.24180","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1002/acr.24180"]},"；Badve SV, Pascoe EM, Tiku A, et al. (2020). Effects of Allopurinol on the Progression of Chronic Kidney Disease. New England Journal of Medicine, 382(26), 2504-2513. ",{"tag":"a","props":{"href":"https://doi.org/10.1056/NEJMoa1915833","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1056/NEJMoa1915833"]},"；Doria A, Galecki AT, Spino C, et al. (2020). Serum Urate Lowering with Allopurinol and Kidney Function in Type 1 Diabetes. New England Journal of Medicine, 382(26), 2493-2503. ",{"tag":"a","props":{"href":"https://doi.org/10.1056/NEJMoa1916624","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1056/NEJMoa1916624"]}]},{"tag":"a","props":{"href":"https://doi.org/10.1002/acr.24180","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Open source link"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Book note"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["This recommendation specifically discourages lifelong uric‑acid‑lowering therapy in people who’ve never experienced gout; it does not imply that high uric‑acid levels are harmless. The same guidelines outline exceptions where treatment may be warranted: first‑time gout attacks accompanied by stage 3 or higher chronic kidney disease, blood uric‑acid levels exceeding 9 mg/dL (≈535 µmol/L), or a history of uric‑acid kidney stones. Those who’ve already had gout attacks, have tophus deposits, or show bone erosion on imaging should indeed start medication — see Section 16, Item 9 for details. Roughly 7.4 % of Han Chinese carry the HLA‑B",{"tag":"em","props":{},"children":["5801 genotype, compared to just 0.7 % of Caucasians; carriers face a markedly higher risk of life‑threatening hypersensitivity reactions, with Asian patients three times more prone to severe skin syndromes than white patients. Given this risk, it’s prudent to avoid allopurinol unless absolutely necessary; testing for the HLA‑B"]},"5801 variant before prescribing is advisable, as noted in Section 16, Item 9. The kidney studies involved patients with chronic kidney disease or type 1 diabetes, so their findings shouldn’t be extrapolated to suggest that high uric‑acid levels are completely benign for all kidneys. They merely refute the claim that uric‑acid‑lowering drugs protect kidney function."]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["My note"]},{"tag":"button","props":{"type":"button"},"children":["Write a reminder for yourself…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/en/tip/06-18"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Previous"]},"Don’t r