000/svg","width":"18","height":"18","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-up-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M7 7h10v10"},"children":[]},{"tag":"path","props":{"d":"M7 17 17 7"},"children":[]}]}]}]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/en/book/17"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"Back to index"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["Having elderly family members at home"]},{"tag":"div","props":{"data-ad-dock-host":"true"},"children":[]},{"tag":"nav","props":{"aria-label":"Chapter entries"},"children":[{"tag":"a","props":{"href":"/en/tip/17-01"},"children":[{"tag":"span","props":{},"children":["01"]},"While the elderly are still lucid, designate a future guardian in writing"]},{"tag":"a","props":{"href":"/en/tip/17-02"},"children":[{"tag":"span","props":{},"children":["02"]},"Make a will — remember that later ones override earlier ones, and notarized wills no longer take priority"]},{"tag":"a","props":{"href":"/en/tip/17-03"},"children":[{"tag":"span","props":{},"children":["03"]},"Keep the elderly person’s money in a separate account and set a rule requiring two people to approve any large withdrawals"]},{"tag":"a","props":{"href":"/en/tip/17-04"},"children":[{"tag":"span","props":{},"children":["04"]},"A ready-made phrase for seniors to deflect unwanted offers"]},{"tag":"a","props":{"href":"/en/tip/17-05"},"children":[{"tag":"span","props":{},"children":["05"]},"Avoid any “investment-based senior care” schemes that require upfront payments: card enrollment, prepaid care fees, buying senior housing units, travel-based care programs, and sales of senior products all fall under the same category of illegal fundraising"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/en/tip/17-06","data-status":"active"},"children":[{"tag":"span","props":{},"children":["06"]},"Apart from the housing reverse mortgage insurance offered by insurers, you should avoid all other “housing-for-pension” schemes — never mortgage your home to buy financial products"]},{"tag":"a","props":{"href":"/en/tip/17-07"},"children":[{"tag":"span","props":{},"children":["07"]},"For elderly individuals at home who are bedridden or severely disabled, apply to the local yibao (basic medical insurance) office for long-term care insurance; it is not limited to seniors only"]},{"tag":"a","props":{"href":"/en/tip/17-08"},"children":[{"tag":"span","props":{},"children":["08"]},"For families with someone bedridden at home, pressure ulcers are a top concern: use an electric alternating-pressure air mattress, turn the patient regularly, and check bony areas daily"]},{"tag":"a","props":{"href":"/en/tip/17-09"},"children":[{"tag":"span","props":{},"children":["09"]},"If an older person’s cataracts already affect walking safely, have an eye doctor assess surgery; when both eyes are affected, do not delay the second eye too long"]},{"tag":"a","props":{"href":"/en/tip/17-10"},"children":[{"tag":"span","props":{},"children":["10"]},"When an older person walks a dog, hold the leash in the palm and never wrap it around the hand, keep the leash short, and train the dog first not to lunge forward on the leash"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"Breadcrumb"},"children":[{"tag":"a","props":{"href":"/en/book"},"children":["Explore the book"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/en/book/17"},"children":["Chapter 17"," ·"," ","Having elderly family members at home"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"17-06"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["06"]},{"tag":"span","props":{"className":"life-evidence grade-b"},"children":["Evidence"," ","B"]}]},{"tag":"h1","props":{"lang":"en"},"children":["Apart from the housing reverse mortgage insurance offered by insurers, you should avoid all other “housing-for-pension” schemes — never mortgage your home to buy financial products"]},{"tag":"p","props":{"lang":"en","className":"life-entry-summary"},"children":["The only legitimate “housing-for-pension” option is the housing reverse mortgage insurance provided by insurers, which is currently still in the pilot phase and used by very few people. Door‑to‑door sales pitches have nothing to do with this official program. Scammers trick seniors into mortgaging their homes so they can use the borrowed money to buy financial products recommended by the fraudsters — essentially a “pay‑old‑debts‑with‑new‑money” Ponzi scheme. Regulators report cases where seniors were unaware their homes had been mortgaged; as a result they ended up losing their property while still owing a loan."]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Cost"]},{"tag":"p","props":{},"children":["There’s no cost involved. Keep your property deed in your…"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Benefit"]},{"tag":"p","props":{},"children":["The China Banking and Insurance Regulatory Commission’s Consumer Protection Bureau clearly distinguishes betwe…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"Mark: Apart from the housing reverse mortgage insurance offered by insurers, you should avoid all other “housing-for-pension” schemes — never mortgage your home to buy financial products"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"Done"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"Plan to do"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"Save"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Share this tip"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Hide details"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Cost"]},{"tag":"p","props":{},"children":["There’s no cost involved. Keep your property deed in your own hands and don’t hand it over to anyone promoting “housing-for-pension” schemes. Before signing any mortgage, guarantee, or loan agreements, show them to your children first. The difficulty lies in the fact that promoters often come repeatedly and appear very enthusiastic, leaving seniors feeling awkward about refusing them."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Benefit"]},{"tag":"p","props":{},"children":["The China Banking and Insurance Regulatory Commission’s Consumer Protection Bureau clearly distinguishes between the genuine and the fraudulent schemes. The legitimate program is called “Housing Reverse Mortgage Insurance for Seniors.” Eligible seniors who fully own their homes may mortgage them to an insurer while continuing to live there, rent it out, or otherwise use it. Any sale or disposal of the property requires consent from the mortgagee — the insurer. Seniors then receive a pension according to agreed terms until their death. This service remains a pilot project with limited participants. Illegal operators label their schemes “housing‑for‑pension,” but they bear no relation to the official program; they merely exploit national policy to promote illegal fundraising. Their modus operandi is to persuade seniors to mortgage their homes and then use the proceeds to purchase recommended financial products — often a classic Ponzi arrangement. The original warning states that some participants are completely unaware their homes have been mortgaged, ultimately resulting in loss of the property and outstanding debt. A useful guideline for evaluating returns is also provided: if a financial product promises a yield above 6 %, it should be viewed with suspicion; above 8 % it becomes highly risky; and anything over 10 % means you should expect to lose all principal — “high returns with guaranteed principal” is a hallmark of financial fraud. The same warning also stresses the need to be cautious when signing contracts and never to sign blank documents (National level, June 2021)."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Original sources"]},{"tag":"p","props":{"className":"life-citations"},"children":["中国银保监会消费者权益保护局 (2021). 关于警惕「投资养老」「以房养老」金融诈骗的风险提示（2021 年第三期）. ",{"tag":"a","props":{"href":"https://dfjrjgj.hunan.gov.cn/dfjrjgj/yhlj/202106/t20210608_19450856.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://dfjrjgj.hunan.gov.cn/dfjrjgj/yhlj/202106/t20210608_19450856.html"]},"（湖南省地方金融监督管理局转载）；民政部、中国银保监会 (2021). 关于养老领域非法集资的风险提示（第四种表现形式：以宣称「以房养老」为名非法集资）. ",{"tag":"a","props":{"href":"https://www.mca.gov.cn/n152/n164/c36171/content.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.mca.gov.cn/n152/n164/c36171/content.html"]}]},{"tag":"a","props":{"href":"https://dfjrjgj.hunan.gov.cn/dfjrjgj/yhlj/202106/t20210608_19450856.html","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Open source link"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Book note"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["This grade B reflects that the statements derive from regulatory risk warnings and expert judgment rather than empirical research data. The 6 %, 8 %, and 10 % thresholds are reference points suggested by regulators for consumers, not legally mandated standards. The former CBIRC has been merged into the National Financial Regulatory Administration; the original announcement page is no longer accessible, so we cite a reposted version from a provincial financial regulator. The core issue here is not merely possible losses on financial investments, but that after mortgaging their homes seniors still carry a loan obligation — a loss far exceeding any potential principal loss. General rules concerning contract signing and blank documents are covered in Section 8, Item 17; steps to halt fraudulent transactions after being scammed are outlined in Section 8, Item 2."]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["My note"]},{"tag":"button","props":{"type":"button"},"children":["Write a reminder for yourself…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/en/tip/17-05"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Previous"]},"Avoid any “investment-based senior care” schemes that require upfront payments: card enrollment, prepaid care fees, buying senior housing units, travel-based care programs, and sales of senior products all fall under the same category of illegal fundraising"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/en/tip/17-07"},"children":[{"tag":"span","props":{},"children":[{"tag