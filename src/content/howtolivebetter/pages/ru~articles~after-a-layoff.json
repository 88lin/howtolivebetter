 6 0 0 0-12 0"},"children":[]},{"tag":"circle","props":{"cx":"12","cy":"10","r":"4"},"children":[]},{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},{"tag":"span","props":{},"children":["Войти"]}]}]}]},{"tag":"main","props":{"className":"life-longread"},"children":[{"tag":"a","props":{"className":"life-back-link active","href":"/ru/articles","data-status":"active","aria-current":"page"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"Все статьи"]},{"tag":"header","props":{"className":"life-longread-header"},"children":[{"tag":"div","props":{},"children":[{"tag":"div","props":{"className":"life-eyebrow"},"children":["Статьи"]},{"tag":"h1","props":{"lang":"ru"},"children":["После увольнения: что делать сначала"]},{"tag":"p","props":{"lang":"ru"},"children":["После сокращения или увольнения дела разбросаны по разделу 19, разделу 7 и ещё нескольким. Ниже они выстроены по времени. В каждом шаге — только действие; цифры, детали и источники…"]},{"tag":"a","props":{"className":"life-longread-chapter","href":"/ru/book/19"},"children":["Глава по теме"," · ","Заработная плата, увольнение и производственные травмы",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"img","props":{"src":"/sites/howtolivebetter/images/book-chapters/19-work-rights-editorial.webp","srcSet":"/sites/howtolivebetter/images/book-chapters/19-work-rights-editorial-thumb.webp 600w, /sites/howtolivebetter/images/book-chapters/19-work-rights-editorial-md.webp 900w, /sites/howtolivebetter/images/book-chapters/19-work-rights-editorial.webp 1200w","sizes":"(max-width: 760px) 100vw, 450px","alt":"","width":"1200","height":"800","fetchPriority":"high"},"children":[]}]},{"tag":"div","props":{"className":"life-longread-layout"},"children":[{"tag":"aside","props":{"className":"life-longread-toc"},"children":[{"tag":"details","props":{"open":true},"children":[{"tag":"summary","props":{},"children":["В этой статье"]},{"tag":"nav","props":{"aria-label":"В этой статье"},"children":[{"tag":"a","props":{"href":"#в-день-увольнения-пока-ничего-не-подписывайте"},"children":["В день увольнения: пока ничего не подписывайте"]},{"tag":"a","props":{"href":"#в-тот-же-день-и-первые-дни-зафиксировать-деньги"},"children":["В тот же день и первые дни: зафиксировать деньги"]},{"tag":"a","props":{"href":"#первая-неделя"},"children":["Первая неделя"]},{"tag":"a","props":{"href":"#первый-месяц"},"children":["Первый месяц"]},{"tag":"a","props":{"href":"#следующие-месяцы"},"children":["Следующие месяцы"]}]}]}]},{"tag":"div","props":{"className":"life-longread-main"},"children":[{"tag":"article","props":{"className":"life-article-body","lang":"ru"},"children":[{"tag":"blockquote","props":{},"children":["\n",{"tag":"p","props":{},"children":["Неофициальный перевод файла ",{"tag":"a","props":{"href":"/articles/after-a-layoff"},"children":["docs/被裁了之后先做什么.md"]},". При расхождениях приоритет у китайского оригинала."]},"\n"]},"\n",{"tag":"p","props":{},"children":[{"tag":"a","props":{"href":"https://github.com/dlgrv/HowToLiveBetter/blob/5a8aac6e715851066661ab6524c3a4e650f7e9d7/README.ru.md","target":"_blank","rel":"noopener noreferrer"},"children":["← К оглавлению"]}]},"\n",{"tag":"p","props":{},"children":["После сокращения или увольнения дела разбросаны по разделу 19, разделу 7 и ещё нескольким. Ниже они выстроены по времени. В каждом шаге — только действие; цифры, детали и источники — в пункте, указанном в скобках. Если вам должны только зарплату и вы ещё не уволены, сразу к ",{"tag":"a","props":{"href":"/ru/book/07"},"children":["пункту 2 раздела 7"]}," (задержка зарплаты: сначала жалоба в инспекцию труда)."]},"\n",{"tag":"h2","props":{"id":"в-день-увольнения-пока-ничего-не-подписывайте"},"children":["В день увольнения: пока ничего не подписывайте"]},"\n",{"tag":"ol","props":{},"children":["\n",{"tag":"li","props":{},"children":["Если дают бланк «увольнение по собственному желанию по личным причинам» — не подписывайте. После подписи обычно пропадают и экономическая компенсация, и пособие по безработице. См. ",{"tag":"a","props":{"href":"/ru/book/19"},"children":["пункт 7 раздела 19"]}," (не подписывать «увольнение по собственному желанию»)."]},"\n",{"tag":"li","props":{},"children":["Если говорят «сначала подпишите оформление, компенсацию потом» — настаивайте, чтобы сумма была вписана в соглашение сразу. Не вписали — не подписывайте; отказ в этот день юридически ни к чему не обязывает. См. ",{"tag":"a","props":{"href":"/ru/book/19"},"children":["пункт 7 раздела 19"]}," (не подписывать «увольнение по собственному желанию»)."]},"\n",{"tag":"li","props":{},"children":["Включите диктофон на разговор. На беседе, где вы сами присутствуете, согласие второй стороны заранее не нужно. См. ",{"tag":"a","props":{"href":"/ru/book/08"},"children":["пункт 41 раздела 8"]}," (начать запись)."]},"\n",{"tag":"li","props":{},"children":["До сдачи компьютера и доступов сохраните расчётные листы, учёт посещаемости, трудовой договор, сведения о соцстраховании и переписку. См. ",{"tag":"a","props":{"href":"/ru/book/19"},"children":["пункт 8 раздела 19"]}," (сохранить доказательства до ухода)."]},"\n",{"tag":"li","props":{},"children":["Сохраняйте только материалы, связанные с вашим трудом. Не забирайте исходный код, списки клиентов и технические документы компании. См. ",{"tag":"a","props":{"href":"/ru/book/11"},"children":["пункт 7 раздела 11"]}," (не забирать исходный код при уходе)."]},"\n",{"tag":"li","props":{},"children":["Сдайте доступы аккуратно: не удаляйте данные и не меняйте пароли, даже если компания вам должна. См. ",{"tag":"a","props":{"href":"/ru/book/11"},"children":["пункт 6 раздела 11"]}," (вернуть доступы к аккаунтам)."]},"\n"]},"\n",{"tag":"h2","props":{"id":"в-тот-же-день-и-первые-дни-зафиксировать-деньги"},"children":["В тот же день и первые дни: зафиксировать деньги"]},"\n",{"tag":"ol","props":{},"children":["\n",{"tag":"li","props":{},"children":["Сначала посчитайте N: один месячный оклад за каждый полный год работы; за период меньше шести месяцев — полмесяца. См. ",{"tag":"a","props":{"href":"/ru/book/19"},"children":["пункт 4 раздела 19"]}," (расчёт N после сокращения)."]},"\n",{"tag":"li","props":{},"children":["Месячный оклад — среднее за 12 месяцев до ухода; премии, надбавки и доплаты входят. Работодатели часто занижают базу. См. ",{"tag":"a","props":{"href":"/ru/book/19"},"children":["пункт 4 раздела 19"]}," (расчёт N после сокращения)."]},"\n",{"tag":"li","props":{},"children":["Сначала уточните, по какой норме компания расторгает договор. Дополнительный месяц зарплаты предусмотрен лишь в трёх случаях: после болезни вы не можете выполнять работу; не справляетесь с работой даже после обучения или перевода на другую должность; обстоятельства, существовавшие при заключении договора, существенно изменились, а договориться не удалось. В этих трёх случаях, если компания не уведомила вас письменно за 30 дней, сверх N она должна выплатить ещё месячную зарплату. При переговорах выделяйте этот месяц отдельно. При экономическом сокращении и расторжении по соглашению сторон такого дополнительного месяца нет. См. ",{"tag":"a","props":{"href":"/ru/book/19#19-05","title":"Компания увольняет вас без предварительного уведомления за 30 дней и обязана выплатить дополнительную зарплату за месяц"},"children":["раздел 19, пункт 5"]}," (нет уведомления за 30 дней)."]},"\n",{"tag":"li","props":{},"children":["При незаконном увольнении компенсация — 2N. Законно ли увольнение — уточните у юридической помощи или адвоката, прежде чем договариваться или идти в арбитраж. См. ",{"tag":"a","props":{"href":"/ru/book/19"},"children":["пункт 6 раздела 19"]}," (незаконное увольнение)."]},"\n",{"tag":"li","props":{},"children":["Неиспользованный ежегодный отпуск оплачивают при расставании пропорционально отработанной части года. См. ",{"tag":"a","props":{"href":"/ru/book/19"},"children":["пункт 2 раздела 19"]}," (ежегодный отпуск)."]},"\n",{"tag":"li","props":{},"children":["В общую сумму включите неоплаченные сверхурочные. См. ",{"tag":"a","props":{"href":"/ru/book/19"},"children":["пункт 1 раздела 19"]}," (оплата сверхурочных)."]},"\n"]},"\n",{"tag":"h2","props":{"id":"первая-неделя"},"children":["Первая неделя"]},"\n",{"tag":"ol","props":{},"children":["\n",{"tag":"li","props":{},"children":["Встаньте на учёт как безработный. Пособие по безработице идёт с даты постановки на учёт; месяц задержки — минус месяц выплат. См. ",{"tag":"a","props":{"href":"/ru/book/07"},"children":["пункт 1 раздела 7"]}," (пособие по безработице)."]},"\n",{"tag":"li","props":{},"children":["Учёт безработных оформляют в государственных службах занятости, например в центрах занятости; платы нет. См. ",{"tag":"a","props":{"href":"/ru/book/07"},"children":["пункт 5 раздела 7"]}," (государственные службы занятости)."]},"\n",{"tag":"li","props":{},"children":["Пособие по безработице подают в приложении «掌上 12333» или в мини-программе электронной карты соцстрахования. Нужен минимум год взносов и уход не «по собственному желанию». См. ",{"tag":"a","props":{"href":"/ru/book/07"},"children":["пункт 1 раздела 7"]}," (пособие по безработице)."]},"\n",{"tag":"li","props":{},"children":["Пока получаете пособие по безработице, медстрахование работника платится через систему безработицы; отдельно оформлять не нужно. См. ",{"tag":"a","props":{"href":"/ru/book/07"},"children":["пункт 1 раздела 7"]}," (пособие по безработице)."]},"\n",{"tag":"li","props":{},"children":["Если на суд не хватает денег — звоните 12348 за юридической помощью. Справку о малоимущности из родного города больше не требуют. См. ",{"tag":"a","props":{"href":"/ru/book/07"},"children":["пункт 3 раздела 7"]}," (юридическая помощь)."]},"\n",{"tag":"li","props":{},"children":["Если подписывали соглашение о неконкуренции — сохраните оригинал. Компания должна платить ежемесячную компенсацию; если три месяца не платит по своей вине, можно добиваться расторжения. См. ",{"tag":"a","props":{"href":"/ru/book/11"},"children":["пункт 12 раздела 11"]}," (соглашение о неконкуренции)."]},"\n",{"tag":"li","props":{},"children":["Наладьте режим дня: вставайте в одно время и выделите фиксированный блок на поиск работы; не сидите дома целый день. См. ",{"tag":"a","props":{"href":"/ru/book/29"},"children":["пункт 3 раздела 29"]}," (после потери работы — сначала режим)."]},"\n"]},"\n",{"tag":"h2","props":{"id":"первый-месяц"},"children":["Первый месяц"]},"\n",{"tag":"ol","props":{},"children":["\n",{"tag":"li","props":{},"children":["Если зарплату или сверхурочные всё ещё не выплатили — сначала 12333, жалоба в инспекцию труда, затем трудовой арбитраж. Оба пути бесплатны. См. ",{"tag":"a","props":{"href":"/ru/book/07"},"children":["пункт 2 раздела 7"]}," (задержка зарплаты: сначала инспекция)."]},"\n",{"tag":"li","props":{},"children":["Если работодатель — нелегальная мастерская, всё равно инспекция и арбитраж. Долг субподрядчика можно предъявить генеральному подрядчику; работа «няней» у домохозяина — через суд. См. ",{"tag":"a","props":{"href":"/ru/book/07"},"children":["пункт 22 раздела 7"]}," (кто ваш работодатель)."]},"\n",{"tag":"li","props":{},"children":["В трудовой арбитраж — в течение года после ухода. После срока достаточно «истёк срок исковой давности». См. ",{"tag":"a","props":{"href":"/ru/book/08"},"children":["пункт 19 раздела 8"]}," (год на трудовой арбитраж)."]},"\n",{"tag":"li","props":{},"children":["Поиск работы начинайте в государственных службах занятости; трудоустройство и консультации бесплатны — не платите агентствам. См. ",{"tag":"a","props":{"href":"/ru/book/07"},"children":["пункт 5 раздела 7"]}," (государственные службы занятости)."]},"\n",{"tag":"li","props":{},"children":["Не ограничивайтесь резюме. Освойте приёмы поиска, задайте ясные цели, просите знакомых о рекомендациях. См. ",{"tag":"a","props":{"href":"/ru/book/07"},"children":["пункт 14 раздела 7"]}," (системный поиск работы)."]},"\n",{"tag":"li","props":{},"children":["Сразу отказывайтесь от «сначала заплатите — потом выход», «сначала обучение — потом устройство», «приводите других». См. ",{"tag":"a","props":{"href":"/ru/book/07"},"children":["пункт 15 раздела 7"]}," (без «кредитов на обучение»)."]},"\n",{"tag":"li","props":{},"children":["Перед платным обучением проверьте у местного бюро труда каталог субсидий на профобучение. См. ",{"tag":"a","props":{"href":"/ru/book/07"},"children":["пункт 13 раздела 7"]}," (субсидии на профобучение)."]},"\n",{"tag":"li","props":{},"children":["Узнайте, подходите ли под статус «лицо с трудностями трудоустройства» — например возраст или длительная безработица. После признания возможны субсидии на соцстрахование и приоритет на общественные работы. См. ",{"tag":"a","props":{"href":"/ru/book/07"},"children":["пункт 12 раздела 7"]}," (признание «трудностей трудоустройства»)."]},"\n"]},"\n",{"tag":"h2","props":{"id":"следующие-месяцы"},"children":["Следующие месяцы"]},"\n",{"tag":"ol","props":{},"children":["\n",{"tag":"li","props":{},"children":["На жизнь сначала тратьте резервный фонд; не берите кредиты и не продавайте вложения в убыток. См. ",{"tag":"a","props":{"href":"/ru/book/05"},"children":["пункт 27 раздела 5"]}," (резервный фонд)."]},"\n",{"tag":"li","props":{},"children":["В первые три месяца отложите необратимые решения: продажа жилья, крупные вложения выходного пособия, партнёрства, поручительство за чужие долги — всё это сюда. См. ",{"tag":"a","props":{"href":"/ru/book/29"},"children":["пункт 12 раздела 29"]}," (необратимые решения)."]},"\n",{"tag":"li","props":{},"children":["Когда пособие по безработице кончилось, а работы нет — не оставляйте себя без медстрахования. Можно самому платить жительское медстрахование раз в год; после перерыва в оплате выплаты не платят три месяца. См. ",{"tag":"a","props":{"href":"/ru/book/07"},"children":["пункт 9 раздела 7"]}," (жительское медстрахование)."]},"\n",{"tag":"li","props":{},"children":["Перерыв во взносах на пенсию не обнуляет прошлые годы; льгота считается по накопленным годам. Не платите посредникам за незаконное «прикрепление». См. ",{"tag":"a","props":{"href":"/ru/book/07"},"children":["пункт 18 раздела 7"]}," (перерыв в соцстраховании)."]},"\n",{"tag":"li","props":{},"children":["Если доход семьи ниже местной линии минимального обеспечения — подайте на dibao (минимальное обеспечение). См. ",{"tag":"a","props":{"href":"/ru/book/07"},"children":["пункт 7 раздела 7"]}," (оформление dibao)."]},"\n",{"tag":"li","props":{},"children":["Если нужно поговорить — звоните 12356; бесплатно. См. ",{"tag":"a","props":{"href":"/ru/book/29"},"children":["пункт 11 раздела 29"]}," (позвонить 12356)."]},"\n",{"tag":"li","props":{},"children":["За долгами, которые вам ещё должны, следите за годом с даты ухода. См. ",{"tag":"a","props":{"href":"/ru/book/08"},"children":["пункт 19 раздела 8"]}," (год на трудовой арбитраж)."]},"\n"]},"\n"]},{"tag":"footer","props":{"className":"life-article-attribution"},"children":[{"tag":"p","props":{},"children":["Статья воспроизведена из открытого проекта HowToLiveBetter с сохранением формулировок и примечаний. Обновления смотрите в исходном репозитории."]},{"tag":"a","props":{"href":"https://github.com/dlgrv/HowToLiveBetter/blob/5a8aac6e715851066661ab6524c3a4e650f7e9d7/docs/research/ru/%D0%9F%D0%BE%D1%81%D0%BB%D0%B5-%D1%83%D0%B2%D0%BE%D0%BB%D1%8C%D0%