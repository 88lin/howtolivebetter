[]},{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},{"tag":"span","props":{},"children":["ログイン"]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/ja/book/07"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"目次に戻る"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["お金がない時をどう生き抜くか"]},{"tag":"nav","props":{"aria-label":"この章のヒント"},"children":[{"tag":"a","props":{"href":"/ja/tip/07-01"},"children":[{"tag":"span","props":{},"children":["01"]},"失業した際は、まずオンラインで失業保険金の申請を"]},{"tag":"a","props":{"href":"/ja/tip/07-02"},"children":[{"tag":"span","props":{},"children":["02"]},"賃金未払いの場合は、まず労働監察へ通報、次に労働仲裁を申請。どちらのルートも費用は無料で、多くの案件は数ヶ月以内に結果が出ます"]},{"tag":"a","props":{"href":"/ja/tip/07-03"},"children":[{"tag":"span","props":{},"children":["03"]},"訴訟費用が払えない場合は法律扶助を申請。賃金請求、扶養料、労災などの案件は、もともと対象範囲に含まれています"]},{"tag":"a","props":{"href":"/ja/tip/07-04"},"children":[{"tag":"span","props":{},"children":["04"]},"行き場を失った時は救助施設へ。食事・宿泊・帰路のチケットを支給"]},{"tag":"a","props":{"href":"/ja/tip/07-05"},"children":[{"tag":"span","props":{},"children":["05"]},"仕事探しはまず無料の公共雇用サービスやギグワーク市場を利用。有料の仲介業者は避ける"]},{"tag":"a","props":{"href":"/ja/tip/07-06"},"children":[{"tag":"span","props":{},"children":["06"]},"不測の事態には、まず臨時救助を申請"]},{"tag":"a","props":{"href":"/ja/tip/07-07"},"children":[{"tag":"span","props":{},"children":["07"]},"収入が地域の最低生活保障基準を下回る場合は、低保（最低生活保障）を申請する"]},{"tag":"a","props":{"href":"/ja/tip/07-08"},"children":[{"tag":"span","props":{},"children":["08"]},"障害者手帳を所持している方は、障害者向け2つの補助金を申請する"]},{"tag":"a","props":{"href":"/ja/tip/07-09"},"children":[{"tag":"span","props":{},"children":["09"]},"住民医療保険の年間 400 元の支払いを中断させないこと。困難世帯は免除・減額が可能"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/ja/tip/07-10","data-status":"active"},"children":[{"tag":"span","props":{},"children":["10"]},"重病になったら、まず医療保険、大病保険、医療扶助、そして他地域での受診登録を行い、ネットローンには手を出さないこと"]},{"tag":"a","props":{"href":"/ja/tip/07-11"},"children":[{"tag":"span","props":{},"children":["11"]},"身分証を紛失したらすぐに再発行手続きを、急ぎの場合は臨時身分証を先に受け取る"]},{"tag":"a","props":{"href":"/ja/tip/07-12"},"children":[{"tag":"span","props":{},"children":["12"]},"失業登録後、就労困難者認定を目指し、社会保険補助金または公益的雇用枠を獲得する"]},{"tag":"a","props":{"href":"/ja/tip/07-13"},"children":[{"tag":"span","props":{},"children":["13"]},"失業期間に職業訓練手当、就業インターン手当、社会保険補助を申請しましょう。自費で講習に通わないでください"]},{"tag":"a","props":{"href":"/ja/tip/07-14"},"children":[{"tag":"span","props":{},"children":["14"]},"就職活動は履歴書を送るだけでは不十分です。システム的な方法を使いましょう：スキルを学び、目標を定め、周囲の助けを借りる"]},{"tag":"a","props":{"href":"/ja/tip/07-15"},"children":[{"tag":"span","props":{},"children":["15"]},"保証金を取られない、身分証を預けない、「訓練ローン」に手を出さない、マルチ商法に入らない、高利貸しから借りない"]},{"tag":"a","props":{"href":"/ja/tip/07-16"},"children":[{"tag":"span","props":{},"children":["16"]},"住居に困っているなら、公営賃貸住宅（公租房）の優先枠を"]},{"tag":"a","props":{"href":"/ja/tip/07-17"},"children":[{"tag":"span","props":{},"children":["17"]},"住居費と食費を最小限に抑える：シェアハウスの月極利用で日極利用を代替、自炊と食堂利用でデリバリーを代替"]},{"tag":"a","props":{"href":"/ja/tip/07-18"},"children":[{"tag":"span","props":{},"children":["18"]},"社会保険の未加入（断缴）に慌てない：年金は累計で計算、医療保険はルールに従って追加入金"]},{"tag":"a","props":{"href":"/ja/tip/07-19"},"children":[{"tag":"span","props":{},"children":["19"]},"服役、破産、信用ブラックリストへの登録など、法律上はやり直す道があります。まずは手続きを完了させましょう"]},{"tag":"a","props":{"href":"/ja/tip/07-20"},"children":[{"tag":"span","props":{},"children":["20"]},"重病に備え、基本医療保険に加えて1年更新の医療保険または重大疾病保険を検討する際は、「継続保証」の4文字を必ず確認すること"]},{"tag":"a","props":{"href":"/ja/tip/07-21"},"children":[{"tag":"span","props":{},"children":["21"]},"本当に寝る場所がない場合、24 時間だけ利用できる場所はあくまで緊急避難用です。まずは救助所を優先してください"]},{"tag":"a","props":{"href":"/ja/tip/07-22"},"children":[{"tag":"span","props":{},"children":["22"]},"賃金未払いの際は、まず雇い主が誰かを確認すること：無免許の作業場や請負業者（工頭）に対しても労働監察を請求可能、家庭や個人向けの私的な仕事の場合のみ裁判所へ"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"現在地"},"children":[{"tag":"a","props":{"href":"/ja/book"},"children":["本を読む"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/ja/book/07"},"children":["第7章"," ·"," ","お金がない時をどう生き抜くか"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"07-10"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["10"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["エビデンス"," ","A"]}]},{"tag":"h1","props":{"lang":"ja"},"children":["重病になったら、まず医療保険、大病保険、医療扶助、そして他地域での受診登録を行い、ネットローンには手を出さないこと"]},{"tag":"p","props":{"lang":"ja","className":"life-entry-summary"},"children":["手順は決まっています。省外での入院前には、まず「国家医保局」の公式WeChatアカウントで受診登録（备案）を行ってください。退院時に直接精算ができるため、一度全額を立て替える必要はありません。精算後も支払いきれない場合は、町や街（街道）の窓口に医療扶助を申請してください。在職中の場合は、勤続年数に応じて 3 から 24 ヶ月の療養期間が認められ、この期間中、会社は解雇できません。ネットローンや民間の高利貸しには絶対に手を出さないでください。"]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["費用・手間"]},{"tag":"p","props":{},"children":["費用はかかりません。手順は固定されており、一歩ずつ進めることが重要です。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["効果"]},{"tag":"p","props":{},"children":["国は、基本医療保険、大病保険、医療扶助を合わせて「三重制度」と呼び、層を重ねて補償を行っています。"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"記録する：重病になったら、まず医療保険、大病保険、医療扶助、そして他地域での受診登録を行い、ネットローンには手を出さないこと"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"できている"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"やることに追加"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"お気に入り"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"このヒントを共有"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"詳細を閉じる"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["費用・手間"]},{"tag":"p","props":{},"children":["費用はかかりません。手順は固定されており、一歩ずつ進めることが重要です。第一ステップ：省外での入院前に、WeChatの「国家医保局」公式アカウント内にある「国家異地就医备案」ミニプログラムで受診登録を行います。第二ステップ：退院時に直接精算します。第三ステップ：精算後も自己負担額が重すぎる場合は、町政府または街道事務所に医療扶助を申請します。第四ステップ：就業中の場合は、療養期間に基づき病欠を申請します。療養期間とは、病気で休業しているが解雇はされない期間のことです。労災に該当する場合は労災保険を利用します。第五ステップ：クレジットカードの支払いが困難な場合は、自ら銀行に相談し、分割払いの交渉を行ってください。第六ステップ：どうしても足りない場合は、民政部が指定する個人支援プラットフォームで募金を行います。必要な書類は主に診断書、費用明細、精算書であり、2 から 4 回の移動が必要です。困難な点は、病の最中に、手続きのために何度も足を運ばなければならないことです。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["効果"]},{"tag":"p","props":{},"children":["国は、基本医療保険、大病保険、医療扶助を合わせて「三重制度」と呼び、層を重ねて補償を行っています。低所得者および特別困窮者は、規定に適合する医療費について 70% 以上の割合で救助されます。もともと困窮していなかったものの、重病により困窮状態に陥った患者は、自ら申請を行うことで救助を受けることが可能です。省をまたぐ入院については、事前に届け出を行うことで、退院時に直接精算ができ、全額を立て替えてから保険加入地へ払い戻しを申請する必要がありません。病気による休業には 3 から 24 ヶ月の療養期間が設けられており、具体的な期間は勤続年数に応じて決定されます。この期間中、会社は労働契約を解除することはできず、病欠手当は現地の最低賃金の 80% を下回ってはなりません。労災労働者には、療養のために仕事を休む「停工留薪期」があり、その期間中の元の賃金および福利厚生はそのまま支給され、企業が月ごとに支払います。通常、この期間は 12 ヶ月を超えないものとします。クレジットカードの債務が返済能力を超えており、かつ本人が返済の意思がある場合、銀行と個別的な分割払いの交渉を行うことができます。これにより、債務の返済計画を再編成することが可能で、最長 5 年までとなります。合意書を締結すれば、銀行は督促を停止しなければなりません。本人のためにインターネット上で資金を募る個人向けの支援プラットフォームは、国務院民政部門の指定を受けたものでなければなりません。プラットフォームは、支援要請の情報が真実であるかを確認する必要があります。寄付された資金は、支援者本人、または本人が提供した口座（全国）にのみ振り込むことができます。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["出典"]},{"tag":"p","props":{"className":"life-citations"},"children":["国务院办公厅 (2021). 关于健全重特大疾病医疗保险和救助制度的意见（国办发〔2021〕42 号）. ",{"tag":"a","props":{"href":"https://www.gov.cn/gongbao/content/2021/content_5659514.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/gongbao/content/2021/content_5659514.htm"]},"；国家医保局 (2025). 跨省异地就医如何直接报销？. ",{"tag":"a","props":{"href":"https://www.nhsa.gov.cn/art/2025/3/16/art_14_16010.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.nhsa.gov.cn/art/2025/3/16/art_14_16010.html"]},"；劳动部 (1994). 企业职工患病或非因工负伤医疗期规定（劳部发〔1994〕479 号，第二、三条）. ",{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/2022-08/31/content_5711269.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/zhengce/2022-08/31/content_5711269.htm"]},"；劳动部 (1995). 关于贯彻执行《劳动法》若干问题的意见（劳部发〔1995〕309 号，第 59 条）. ",{"tag":"a","props":{"href":"http://hrss.jl.gov.cn/ldgx/ldyggl/201608/t20160824_2401358.html","target":"_blank","rel":"noopener noreferrer"},"children":["http://hrss.jl.gov.cn/ldgx/ldyggl/201608/t20160824_2401358.html"]},"（吉林省人社厅转载）；国务院 (2010 修订). 工伤保险条例（国务院令第 586 号，第三十、三十三条）. ",{"tag":"a","props":{"href":"https://www.gov.cn/gongbao/content/2011/content_1778064.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/gongbao/content/2011/content_1778064.htm"]},"；银监会 (2011). 商业银行信用卡业务监督管理办法（银监会令 2011 年第 2 号，第七十条）. ",{"tag":"a","props":{"href":"https://www.gov.cn/gongbao/content/2011/content_1893974.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/gongbao/content/2011/content_1893974.htm"]},"；全国人大常委会 (2023). 关于修改慈善法的决定（第一百二十四条）. ",{"tag":"a","props":{"href":"https://www.gov.cn/yaowen/liebiao/202312/content_6923390.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/yaowen/liebiao/202312/content_6923390.htm"]},"；民政部等五部门 (2024). 个人求助网络服务平台管理办法（令第 75 号，第三、十一、十三、十七条）. ",{"tag":"a","props":{"href":"https://www.gov.cn/gongbao/2024/issue_11646/202410/content_6980857.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/gongbao/2024/issue_11646/202410/content_6980857.html"]}]},{"tag":"a","props":{"href":"https://www.gov.cn/gongbao/content/2021/content_5659514.htm","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["出典を開く"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["著者の注記"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["医療扶助の自己負担割合や年間の上限額は、加入している地域によって決まります。療養期間は、総勤続年数や現在の勤務先での勤続年数に基づき6段階に分かれています。療養期間が終了すると、会社から合法的に解雇される可能性があるため、自分がどの段階に該当するか事前に確認しておきましょう。救急搬送された方も、事前の届出が必要なリストに含まれています。医療保険局のページには、救急の場合に自動的に届出が受理されるか、事後に手続きが可能かについては記載されていないため、加入地域の窓口に電話で問い合わせてください。ネットローンや民間の高利貸しには手を出さないこと。裁判所が保護するのは、1年期LPRの 4 倍までというラインです（高利貸しを避けるについては第 15 条を参照）。そのラインを超えた部分については保護されず、元本は返済する必要があります。病床に伏せっているような状態では、このような訴訟に取り組む精力は残っていないでしょう。急重傷病は別問題です。お金がなくても 120 を呼ぶ必要があり、病院は救済を拒否、回避、または遅延させることはできません。その際の救急費用は疾病応急救助基金が支払います。第 24 節第 8 条を参照してください（救急もまずは救命が優先されます）。労部発〔1995〕309 号の原文ページは人社部の公式サイトでは開けません。内容は省人社庁の転載に基づいています。"]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["自分のメモ"]},{"tag":"button","props":{"type":"button"},"children":["自分へのメモを書く…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/ja/tip/07-09"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["前へ"]},"住民医療保険の年間 400 元の支払いを中断させないこと。困難世帯は免除・減額が可能"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/ja/tip/07-11"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["次へ"]},"身分証を紛失したらすぐに再発行手続きを、急ぎの場合は臨時身分証を先に受け取る"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor",