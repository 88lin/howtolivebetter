1","y2":"10.49"},"children":[]}]},"Tạo thẻ chia sẻ"]},{"tag":"p","props":{"className":"bingo-small"},"children":["Tấm thẻ chỉ bao gồm các hành động và dấu tích, không có tên của bạn, ghi chú hoặc các danh sách khác. Ai có liên kết này cũng có thể xem cái nhìn nhanh này; nó sẽ không cập nhật với tiến trình sau này."]},{"tag":"div","props":{"className":"bingo-sync-note"},"children":[{"tag":"p","props":{},"children":["Hoàn thành sẽ được chia sẻ với Danh sách Của Tôi. Những thành tựu hiện có sẽ tự động sáng lên; chạm lại để đánh dấu là lên kế hoạch. Việc thay thế sẽ giữ lại các bản ghi trước đó."]},{"tag":"p","props":{},"children":["Lựa chọn bảng của bạn sẽ được lưu trong trình duyệt này. Đăng nhập để đồng bộ tiến độ hành động."]},{"tag":"a","props":{"className":"life-text-link","href":"/vi/dashboard"},"children":["Bảng kiểm tra của tôi",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"15","height":"15","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]}]}]},{"tag":"section","props":{"className":"bingo-explainer"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"bingo-overline"},"children":["01"]},{"tag":"h2","props":{},"children":["Làm cho nó thuộc về bạn"]},{"tag":"p","props":{},"children":["Thay thế bất kỳ hành động nào không phù hợp, hoặc xáo trộn toàn bộ bảng."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"bingo-overline"},"children":["02"]},{"tag":"h2","props":{},"children":["Thực hiện một, đánh dấu một"]},{"tag":"p","props":{},"children":["Hoàn thành một hàng, cột hoặc đường chéo và vui mừng một chút về tiến bộ của mình."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"bingo-overline"},"children":["03"]},{"tag":"h2","props":{},"children":["Chia sẻ nó đi"]},{"tag":"p","props":{},"children":["Lưu lại một hình ảnh hoặc chia sẻ liên kết để bạn bè có thể thử cùng bảng này."]}]}]},{"tag":"section","props":{"className":"bingo-method"},"children":[{"tag":"h2","props":{},"children":["Hành động nhỏ xứng đáng được một chút chú ý"]},{"tag":"p","props":{},"children":["Những hành động này đến từ các gợi ý được mô tả là không yêu cầu chi phí bổ sung. Chúng vẫn tốn thời gian và nỗ lực. Chọn những điều phù hợp, và sử dụng Đọc để xem đầy đủ chi phí, lợi ích và nguồn gốc. Các dấu kiểm là bản ghi của bạn; các đường thẳng là một chút phần thưởng nhỏ."]},{"tag":"a","props":{"className":"life-text-link","href":"/vi/book"},"children":["Khám phá cuốn sách",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"15","height":"15","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"div","props":{"className":"page-guide"},"children":[{"tag":"section","props":{"className":"page-guide-faq","aria-labelledby":"bingo-faq-title"},"children":[{"tag":"h2","props":{"id":"bingo-faq-title"},"children":["FAQ về Bingo"]},{"tag":"details","props":{},"children":[{"tag":"summary","props":{},"children":["Tôi có phải hoàn thành tất cả chín ô cùng lúc không?"]},{"tag":"p","props":{},"children":["Không. Khi bạn hoàn thành, thẻ sẽ được lưu trong trình duyệt này và vẫn còn đó lần sau, vì vậy bạn có thể hoàn thành theo tốc độ riêng của mình. Bạn cũng có thể gửi những ô chưa hoàn thành sang danh sách của tôi chỉ bằng một lần chạm."]}]},{"tag":"details","props":{},"children":[{"tag":"summary","props":{},"children":["Thẻ này có liên quan đến danh sách của tôi như thế nào?"]},{"tag":"p","props":{},"children":["Chúng chia sẻ cùng một trạng thái. Một ô bạn đánh dấu sẽ được ghi nhận là hoàn thành trong danh sách của tôi, và bất kỳ điều gì đã hoàn thành trong danh sách của bạn sẽ tự động được đánh dấu trên thẻ."]}]},{"tag":"details","props":{},"children":[{"tag":"summary","props":{},"children":["Việc đổi chỗ một ô có xóa lịch sử của tôi không?"]},{"tag":"p","props":{},"children":["Không. Việc đổi chỗ chỉ thay đổi nội dung hiển thị trên thẻ; các bản ghi hiện có của bạn vẫn được giữ nguyên."]}]},{"tag":"details","props":{},"children":[{"tag":"summary","props":{},"children":["Thẻ chia sẻ tiết lộ điều gì?"]},{"tag":"p","props":{},"children":["Chỉ có các mục trên thẻ này và những mục đã hoàn thành, chứ không bao gồm tên của bạn, ghi chú hoặc các danh sách khác. Đây là một bản chụp màn hình và không cập nhật theo tiến trình sau này."]}]}]}]}]},{"tag":"aside","props":{"className":"life-ad-space life-ad-space-sponsored","data-ad-placement":"ad_footer","data-ad-group":"practice","data-ad-creative":"practice_time","data-ad-ready":"false","aria-label":"Quảng cáo · Giới thiệu cộng đồng"},"children":[{"tag":"div","props":{"className":"life-ad-space-brand"},"children":[{"tag":"img","props":{"src":"/sites/howtolivebetter/images/shengcai/logo.png","width":"565","height":"144","alt":"Logo chính thức của Shengcai Youshu","decoding":"async"},"children":[]}]},{"tag":"div","props":{"className":"life-ad-space-copy"},"children":[{"tag":"span","props":{"className":"life-ad-space-label"},"children":["Quảng cáo · Giới thiệu cộng đồng"]},{"tag":"strong","props":{},"children":["Biến hướng dẫn thành trải nghiệm thực hành."]},{"tag":"p","props":{},"children":["Dự án Xiaohongshu bắt đầu từ học tạo ảnh AI và chọn sản phẩm, áp dụng kiến thức hằng ngày vào thực tế."]}]},{"tag":"div","props":{"className":"life-ad-space-actions"},"children":[{"tag":"a","props":{"className":"life-ad-space-link","href":"/vi/shengcaiyoushu?sc_group=practice&sc_creative=practice_time&sc_placement=ad_footer"},"children":["Xem cộng đồng và các v