keLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"このヒントを共有"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"詳細を閉じる"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["費用・手間"]},{"tag":"p","props":{},"children":["費用はかかりません。代償として、物件はあなたの所有にはならず、一度の賃貸期間は最長で 20 年であり、期間満了時には改めて大家と交渉する必要があります。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["効果"]},{"tag":"p","props":{},"children":["国務院事務局の文書には明確に記されています：「都市住民は、農村部の宅基地、農民住宅、または『小产权房』を購入してはならない」。同じ文書では、農民が住宅を売却または賃貸した後は、宅基地の再申請は認められないとも規定されています。2019 年の中央農村工作弁公室および農業農村部の文書でも、「都市住民による農村部の宅基地購入を厳禁する」と改めて述べられています。一方で、同じ文書は合法的な方法も示しています：都市住民は農家住宅を居住または経営のために借りることは可能であり、賃貸契約の期間は20年を超えてはならず、期間満了時には双方の合意により別途定めることができます。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["出典"]},{"tag":"p","props":{"className":"life-citations"},"children":["国务院办公厅 (2007). 关于严格执行有关农村集体建设用地法律和政策的通知（国办发〔2007〕71 号）. ",{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/2008-03/28/content_2395.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/zhengce/zhengceku/2008-03/28/content_2395.htm"]},"；中央农村工作领导小组办公室、农业农村部 (2019). 关于进一步加强农村宅基地管理的通知（中农发〔2019〕11 号）第五、六部分. ",{"tag":"a","props":{"href":"https://www.moa.gov.cn/govpublic/NCJJTZ/201909/t20190920_6328397.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.moa.gov.cn/govpublic/NCJJTZ/201909/t20190920_6328397.htm"]}]},{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/2008-03/28/content_2395.htm","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["出典を開く"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["著者の注記"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["宅基地とは、村の村民に家を建てるために割り当てられた土地であり、その村の村民にのみ割り当てられます。農家住宅を借りる際は、貸主である農家と書面による契約を交わし、賃貸期間、賃料、改築・増築の可否、および改装費用が期間満了時にどう扱われるかを明記してください。文書では、賃貸期間は 20 年を超えないと規定されています。「50 年間借りる」「70 年間借りる」といった契約は避け、また数年分の賃料を一括で支払うことも避けてください。また、文書では、宅基地を利用して田舎に別荘や私的な会館を建設することも禁止されており、村民との「共同建設」のために資金を出すことも避けてください。"]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["自分のメモ"]},{"tag":"button","props":{"type":"button"},"children":["自分へのメモを書く…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/ja/tip/15-08"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["前へ"]},"仕切り部屋（隔壁部屋）は借りないこと：最小の賃貸単位は元々の設計通りの部屋であり、キッチン、トイレ、バルコニーは居住用として使用できない"]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["このテーマの他の提案"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/15-02"},"children":[{"tag":"strong","props":{},"children":["断水・断電、鍵の交換、立ち入りによる退去の脅迫を受けた場合は、まず通報して証拠を残す：法規はこれらの方法で退去を強要することを禁止しています"]},{"tag":"span","props":{},"children":["大家は、断水・断電、鍵の交換、立ち入りによる脅迫によって、契約解除や退去を強要することはできず、法規で明示的に禁止されています。このような…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/15-03"},"children":[{"tag":"strong","props":{},"children":["仲介業者は賃料や敷金の代理受領・代理支払いはできません。お金は直接大家に支払ってください"]},{"tag":"span","props":{},"children":["規定により、賃料や敷金は仲介業者による代理受領や代理支払いはできず、直接大家に支払う必要があります。お金が仲介業者を経由すると、業者が持ち…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/15-04"},"children":[{"tag":"strong","props":{},"children":["サービスアパートメントを