ed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"已做到"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"加入待做"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"收藏"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"分享这条建议"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"收起详情"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["成本"]},{"tag":"p","props":{"className":"life-citations"},"children":["不花钱。打卡背面或者 App 里公布的官方客服电话，说清楚自己还不上，但愿意还。要备好收入、失业或者生病的证明，常常要打好几次电话。谈成了就按新计划按月还，还清之前不能再办信用卡。难在要主动接银行的电话，一遍遍讲自己的难处。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["收益"]},{"tag":"p","props":{"className":"life-citations"},"children":["信用卡这边有明文规定。欠款超出你的还款能力、你又仍然愿意还的，银行「可以」和你平等协商，签个性化分期还款协议。协议最长不超过 5 年。协议要写清欠多少、每期还多少、还款期间收不收年费和利息。双方签了协议，银行和它委托的催收机构要停止催收。你不按协议还，就不受这个限制。谈成的是口头协议的，银行必须留录音，至少留到欠款还清那天。已经办过分期的欠款不能再分期，个性化分期是唯一的例外（2022 年监管通知）。2025 年人民银行废止旧的银行卡办法时，写明信用卡继续按这些规定管。网贷没有个性化分期这样的统一规定，能不能延期、分期，看合同和放款的机构。放款的是消费金融公司的，规章禁止它用暴力、威胁、恐吓、骚扰的手段催收。银行和消费金融公司都不许找和债务无关的人催收。收费中介那边，金融监管总局等五部门 2026 年联合发了风险提示。提示说「贷款/信用卡不用还」「债务协商」「债务置换」「征信洗白」都属于不实信息。这类「代理维权」会收高额服务费，你中途想退出，还可能被告违约。他们会收集你的银行卡、手机卡、家庭住址和孩子的学校。照他们教的提供假材料、恶意逃债、投诉施压，情节严重的可能涉嫌违法犯罪。北京银保监局 2022 年也点名了「停息挂账」「停止催收」「全额免息」这类广告。它说听信这些人拖着不还、不跟银行联系，很可能在征信上留下逾期的不良记录。国家发展改革委 2022 年专项治理「征信修复」。通知说，这些人混淆征信异议和信用修复的概念，以「征信修复、洗白、铲单」为名行骗。征信上的不良信息，从不良行为或者事件结束那天起保存 5 年，满 5 年删除。保存期内，你可以给这条记录加一段说明，征信机构要记下来（全国）"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["来源"]},{"tag":"p","props":{"className":"life-citations"},"children":["银监会 (2011). 商业银行信用卡业务监督管理办法（银监会令 2011 年第 2 号，第六十八、七十条）. ",{"tag":"a","props":{"href":"https://www.gov.cn/gongbao/content/2011/content_1893974.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/gongbao/content/2011/content_1893974.htm"]},"；银保监会、中国人民银行 (2022). 关于进一步促进信用卡业务规范健康发展的通知（银保监规〔2022〕13 号，第十九、三十条）. ",{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/2022-07/07/content_5699827.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/zhengce/zhengceku/2022-07/07/content_5699827.htm"]},"；中国人民银行、金融监管总局 (2025). 关于废止《银行卡业务管理办法》的决定（令〔2025〕第 6 号）. ",{"tag":"a","props":{"href":"https://www.gov.cn/gongbao/2025/issue_12206/202508/content_7035429.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/gongbao/2025/issue_12206/202508/content_7035429.html"]},"；金融监管总局 (2024). 消费金融公司管理办法（令 2024 年第 4 号，第五十三、五十六条）. ",{"tag":"a","props":{"href":"https://www.gov.cn/gongbao/2024/issue_11346/202405/content_6951507.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/gongbao/2024/issue_11346/202405/content_6951507.html"]},"；金融监管总局、中央网信办、公安部、中国人民银行、中国证监会 (2026-02-06). 关于警惕不法「代理维权」短视频及直播陷阱的风险提示（中央网信办官网转载）. ",{"tag":"a","props":{"href":"https://www.cac.gov.cn/2026-02/06/c_1772110875635198.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.cac.gov.cn/2026-02/06/c_1772110875635198.htm"]},"；北京银保监局 (2022-10-25). 警惕非法「代理处置信用卡债务」风险提示（信用阜新转载，阜新市发展和改革委员会主办）. ",{"tag":"a","props":{"href":"https://credit.fuxin.gov.cn/fxts/202210/t20221027_33939.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://credit.fuxin.gov.cn/fxts/202210/t20221027_33939.html"]},"；国家发展改革委办公厅 (2022). 关于重点开展「征信修复」问题专项治理的通知. ",{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/2022-04/01/content_5682847.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/zhengce/zhengceku/2022-04/01/content_5682847.htm"]},"；国务院 (2013). 征信业管理条例（国令第 631 号，第十六条）. ",{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/2013-01/29/content_2303.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/zhengce/zhengceku/2013-01/29/content_2303.htm"]},"；最高人民法院、最高人民检察院 (2018 修正). 关于办理妨害信用卡管理刑事案件具体应用法律若干问题的解释（法释〔2018〕19 号，第六、八条）. ",{"tag":"a","props":{"href":"https://www.court.gov.cn/fabu/xiangqing/132701.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.court.gov.cn/fabu/xiangqing/132701.html"]},"；宁夏金融监管局 (2026-06-16). 关于防范非法代理退保的风险提示（12378 热线）. ",{"tag":"a","props":{"href":"https://www.nfra.gov.cn/branch/ningxia/view/pages/common/ItemDetail.html?docId=1261442&itemId=2188","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.nfra.gov.cn/branch/ningxia/view/pages/common/ItemDetail.html?docId=1261442&itemId=2188"]},"；全国人大常委会 (2023 修正). 民事诉讼法（第一百五十二、一百六十四条）. ",{"tag":"a","props":{"href":"https://amr.guizhou.gov.cn/zwgk/xxgkml/jcxxgk/zcfg/fl/202401/t20240129_83645867.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://amr.guizhou.gov.cn/zwgk/xxgkml/jcxxgk/zcfg/fl/202401/t20240129_83645867.html"]},"（贵州省市场监管局转载）；国务院 (2006). 诉讼费用交纳办法（国务院令第 481 号，第六、二十九条）. ",{"tag":"a","props":{"href":"https://www.gov.cn/ziliao/flfg/2006-12/29/content_483682.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/ziliao/flfg/2006-12/29/content_483682.htm"]},""]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["原书备注"]},{"tag":"p","props":{"className":"life-citations"},"children":["个性化分期写的是银行「可以」协商，不是必须答应，银行有权拒绝。谈不拢，银行可以去法院起诉你还钱。一审普通程序 6 个月起，简易程序 3 个月。你请律师的钱要自己出，它不在法院判给输家承担的诉讼费用里。判了还不上就进执行，见第 8 节第 20 条（被起诉、被执行了）。被列入失信名单的，见第 8 节第 21 条（列入失信名单）。单纯还不上不是犯罪。两高的司法解释写明，不能只凭没按时还款就认定你想占有这笔钱。透支后跑掉、换联系方式躲催收、转移财产的，才可能被认定为恶意透支。恶意透支按信用卡诈骗罪追究，没还的本金 5 万元以上就算数额较大。所以银行的电话要接，换了号码和住址要告诉银行。借新还旧只会让利息越滚越多，比贷款先看年化利率，见第 5 节第 7 条（把利息换成年化利率）。民间高息借款见第 15 条（不借高利贷）。催收打到你的家人、同事那里，或者辱骂威胁你，先向放款机构投诉。银行没解决的，打 12378 银行保险消费者投诉热线，免费。威胁人身安全的直接打 110。征信记录有错的，免费查和提异议见第 8 节第 9 条（免费查征信）。生了重病还不上的，同时看第 10 条（重病先走医保和医疗救助）。找「代理退保」是同一类套路，见第 5 节第 43 条（别找代理退保）。受益人主要是你自己。"]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["我的备注"]},{"tag":"button","props":{"type":"button"},"children":["写下对自己有用的提醒…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/tip/07-22"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["上一条"]},"被欠了工钱，先分清雇你的是谁：没执照的作坊和包工头照样找劳动监察，给家庭或个人干私活才去法院"]}]},{"tag":"span","props":{},"children":[]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["本主题的其他建议"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/07-03"},"children":[{"tag":"strong","props":{},"children":["打不起官司就申请法律援助，讨薪、赡养费、工伤这类案子本来就在范围内"]},{"tag":"span","props":{},"children":["讨薪、要赡养费、要社保或低保待遇、见义勇为受了损失，都能申请免费法律援助。打 12348，或者去当地的法律援助中心。现在不用回原籍开经济困难证明，本人如实说明就…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/07-04"},"children":[{"tag":"strong","props":{},"children":["走投无路时去救助站，管吃住和返乡车票"]},{"tag":"span","props":{},"children":["救助站管吃、管住，生病了送医院，还帮你联系家里人，没钱回家的发车票。一般住不超过 10 天。自愿来、自愿走，不是收容，也不发现金。车票按户籍地或者住所地开，去之…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/07-05"},"children":[{"tag":"strong","props":{},"children":["找活先用免费的公共就业服务和零工市场，不找收费中介"]},{"tag":"span","props":{},"children":["就业服务中心、人力资源市场这些公家机构，介绍工作、职业指导、政策咨询、办就业和失业登记，全都不收钱。法律还明文不许它们拿这些服务去赚钱。零工市场的登记和发布信息…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/07-06"},"children":[{"tag":"strong","props":{},"children":["突发变故先申请临时救助"]},{"tag":"span","props":{},"children":["家里突然出事，比如火灾、车祸、家人突发重病，把基本生活一时压垮了，可以向出事地的乡镇政府或者街道办申请临时救助，不要求你是低保户。这类急难一般 3 天内办完，最…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/07-07"},"children":[{"tag":"strong","props":{},"children":["收入低于当地低保线就申请低保，比低保线略高或者看病上学花得多的申请医疗、教育、住房、就业救助"]},{"tag":"span","props":{},"children":["全家人均收入低于当地低保线、财产也符合规定的，就可以申请。2024 年末，全国城市低保线平均每人每月 798.1 元，农村 593.9 元。钱按差额补，也可分档…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/07-08"},"children":[{"tag":"strong","props":{},"children":["持残疾人证的去申请残疾人两项补贴"]},{"tag":"span","props":{},"children":["低保家庭里的残疾人，可以领生活补贴。残疾等级是一级、二级，又需要长期照护的，可以领护理补贴，两项能同时领。标准各省自己定，差别很大，具体问街道。带上第二代残疾人…"]}]}]}]},{"tag":"a","props":{"className":"life-text-link","href":"/book/07"},"children":["阅读整个主题：没钱的时候怎么活 ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"15","height":"15","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round