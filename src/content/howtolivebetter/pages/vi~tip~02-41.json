iewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Chi phí"]},{"tag":"p","props":{},"children":["Không tốn thêm tiền. Dầu thực vật vốn đã là lựa chọn chính của đa số hộ gia đình. Chỗ khó là bỏ thói quen dùng mỡ lợn để xào và rưới cơm."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Lợi ích"]},{"tag":"p","props":{},"children":["Cochrane gộp 15 thử nghiệm chia nhóm ngẫu nhiên, 56.675 người, mỗi thử nghiệm kéo dài ít nhất hai năm. Ăn ít mỡ bão hòa thì tổng số sự kiện tim mạch thấp hơn khoảng 17% (RR 0.83, 0.70–0.98). Tỷ lệ tử vong toàn nguyên gần như không đổi (RR 0.96, 0.90–1.03), tử vong tim mạch cũng không đổi (RR 0.95, 0.80–1.12). Đổi sang chất béo không bão hòa nhiều (thành phần chính của dầu đậu nành và dầu ngô) và đổi sang carbohydrate thì không thấy khác biệt. Đổi sang chất béo không bão hòa đơn (thành phần chính của dầu cải và dầu ô liu) thì dữ liệu quá ít, không nói rõ được. Một bài tổng quan Cochrane khác gộp 19 thử nghiệm chia nhóm ngẫu nhiên, 6461 người: ăn nhiều omega-6 (axit linoleic) thì với tỷ lệ tử vong toàn nguyên RR 1.00 (0.88–1.12), với sự kiện tim mạch RR 0.97 (0.81–1.15), không thấy lợi ích cũng không thấy hại. Bài thứ ba gộp 86 thử nghiệm chia nhóm ngẫu nhiên, 162.796 người: ăn nhiều omega-3 nguồn thực vật (thành phần chính của dầu hạt lanh và dầu tía lô), tỷ lệ tử vong toàn nguyên RR 1.01 (0.84–1.20), sự kiện bệnh tim mạch vành RR 1.00 (0.82–1.22), gần như không có tác dụng."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Nguồn gốc"]},{"tag":"p","props":{"className":"life-citations"},"children":["Hooper L, Martin N, Jimoh OF, 等 (2020). Reduction in saturated fat for cardiovascular disease. Cochrane Database of Systematic Reviews, (5), CD011737. ",{"tag":"a","props":{"href":"https://doi.org/10.1002/14651858.CD011737.pub3","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1002/14651858.CD011737.pub3"]},"；Hooper L, Al-Khudairy L, Abdelhamid AS, 等 (2018). Omega-6 fats for the primary and secondary prevention of cardiovascular disease. Cochrane Database of Systematic Reviews, (11), CD011094. ",{"tag":"a","props":{"href":"https://doi.org/10.1002/14651858.CD011094.pub4","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1002/14651858.CD011094.pub4"]},"；Abdelhamid AS, Brown TJ, Brainard JS, 等 (2020). Omega-3 fatty acids for the primary and secondary prevention of cardiovascular disease. Cochrane Database of Systematic Reviews, (3), CD003177. ",{"tag":"a","props":{"href":"https://doi.org/10.1002/14651858.CD003177.pub5","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1002/14651858.CD003177.pub5"]},"；中国营养学会 (2022). 中国居民膳食指南（2022）. 人民卫生出版社"]},{"tag":"a","props":{"href":"https://doi.org/10.1002/14651858.CD011737.pub3","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Liên kết mở nguồn"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Ghi chú sách"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["Tranh cãi: có người cho rằng lượng omega-6 trong dầu đậu nành và dầu ngô quá nhiều nên gây viêm, do đó phải ăn ít và đổi dầu. Các thử nghiệm chia nhóm ngẫu nhiên trong bài omega-6 nói trên không thấy hại, tác giả tự chấm chất lượng bằng chứng là thấp. Mức lợi ích đặt là vừa dựa trên sự kiện tim mạch giảm 17%, còn tỷ lệ tử vong toàn nguyên thì không đổi. Dầu nào cũng phải kiểm soát lượng dùng, hướng dẫn khẩu phần khuyên mỗi người mỗi ngày dùng 25 đến 30 g dầu nấu ăn."]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Ghi chú của tôi"]},{"tag":"button","props":{"type":"button"},"children":["Viết một lời nhắc cho chính bạn…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/vi/tip/02-40"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Trước"]},"Mua dầu ăn đóng gói có số SC, đừng mua dầu điều tự ép tẩy từ xưởng nhỏ bán rời"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/vi/tip/02-42"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Tiếp theo"]},"Khi xào và khi chiên rán thì bật máy hút mùi, từ lúc bật bếp cho tới khi nấu xong"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill"