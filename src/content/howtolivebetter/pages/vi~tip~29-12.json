urrentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-up-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M7 7h10v10"},"children":[]},{"tag":"path","props":{"d":"M7 17 17 7"},"children":[]}]}]}]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/vi/book/29"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"Quay lại mục lục"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["Sau một cú đánh nặng"]},{"tag":"div","props":{"data-ad-dock-host":"true"},"children":[]},{"tag":"nav","props":{"aria-label":"Các mục trong chương"},"children":[{"tag":"a","props":{"href":"/vi/tip/29-01"},"children":[{"tag":"span","props":{},"children":["01"]},"Trong mấy ngày đầu sau khi người thân qua đời, đừng ở một mình; người có bệnh tim, huyết áp cao, tiểu đường thì vẫn uống thuốc như cũ, đau tức ngực thì gọi 120"]},{"tag":"a","props":{"href":"/vi/tip/29-02"},"children":[{"tag":"span","props":{},"children":["02"]},"Trong tuần bạn được báo mắc bệnh nặng, đừng đi lấy kết quả một mình, quyết định gì ngoài điều trị thì đẩy lùi"]},{"tag":"a","props":{"href":"/vi/tip/29-03"},"children":[{"tag":"span","props":{},"children":["03"]},"Sau khi thất nghiệp, ổn định giờ sinh hoạt, bảo hiểm y tế và nhịp đi tìm việc trước, đừng ở nhà suốt ngày"]},{"tag":"a","props":{"href":"/vi/tip/29-04"},"children":[{"tag":"span","props":{},"children":["04"]},"Người thân chết vì tự tử, tai nạn hoặc bị giết thì đừng trông chờ tự gượng, hãy chủ động đi tìm giúp đỡ chuyên môn"]},{"tag":"a","props":{"href":"/vi/tip/29-05"},"children":[{"tag":"span","props":{},"children":["05"]},"Trong nửa năm đầu sau khi mất bạn đời, giao việc canh bữa cơm, việc ngủ, thuốc bệnh mạn tính và lịch tái khám cho một người cố định"]},{"tag":"a","props":{"href":"/vi/tip/29-06"},"children":[{"tag":"span","props":{},"children":["06"]},"Không có người thân cũng không có bạn bè thì thay「người canh giữ bạn」bằng ba thứ: hàng xóm có vào được nhà bạn, danh sách thăm viếng của cộng đồng, và người liên hệ khẩn cấp trong điện thoại"]},{"tag":"a","props":{"href":"/vi/tip/29-07"},"children":[{"tag":"span","props":{},"children":["07"]},"Sau khi cha mẹ qua đời, nói thật với con, để con dự lễ tang, đừng đưa con đi nơi khác để «đổi không khí»"]},{"tag":"a","props":{"href":"/vi/tip/29-08"},"children":[{"tag":"span","props":{},"children":["08"]},"Nỗi buồn kéo dài quá nửa năm vẫn đứng yên, ngày nào cũng không nổi, thì đi đăng ký khoa tâm thần hoặc tâm lý lâm sàng"]},{"tag":"a","props":{"href":"/vi/tip/29-09"},"children":[{"tag":"span","props":{},"children":["09"]},"Đừng vội trả tiền làm tư vấn đau buồn, xem trước nỗi buồn của mình có thật sự bị kẹt không (các triệu chứng ở mục 8)"]},{"tag":"a","props":{"href":"/vi/tip/29-10"},"children":[{"tag":"span","props":{},"children":["10"]},"Sau khi sống xa nhau hoặc ly hôn, đừng để bảo hiểm y tế bị gián đoạn, đừng dựa vào rượu để chịu đựng"]},{"tag":"a","props":{"href":"/vi/tip/29-11"},"children":[{"tag":"span","props":{},"children":["11"]},"Muốn có người để nói chuyện thì gọi 12356, người chưa thành niên và thanh niên gọi 12355, muốn khám bác sĩ thì đăng ký khám tâm lý ngoại trú"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/vi/tip/29-12","data-status":"active"},"children":[{"tag":"span","props":{},"children":["12"]},"Trong ba tháng đầu sau biến cố, mọi quyết định lớn không thể đảo ngược đều đẩy lùi"]},{"tag":"a","props":{"href":"/vi/tip/29-13"},"children":[{"tag":"span","props":{},"children":["13"]},"Đừng dùng cái chết làm cách trả nợ: bảo hiểm nhân thọ trong hai năm đầu không bồi, tai nạn lao động không công nhận, và nợ vẫn bị lấy từ tài sản thừa kế trước"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"Breadcrumbs"},"children":[{"tag":"a","props":{"href":"/vi/book"},"children":["Khám phá cuốn sách"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/vi/book/29"},"children":["Chương 29"," ·"," ","Sau một cú đánh nặng"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"29-12"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["12"]},{"tag":"span","props":{"className":"life-evidence grade-b"},"children":["Bằng chứng"," ","B"]}]},{"tag":"h1","props":{"lang":"vi"},"children":["Trong ba tháng đầu sau biến cố, mọi quyết định lớn không thể đảo ngược đều đẩy lùi"]},{"tag":"p","props":{"lang":"vi","className":"life-entry-summary"},"children":["Khoảng thời gian này khả năng phán đoán của bạn với mọi thứ được gọi là «cơ hội» là tệ nhất. Người nói rằng liên lạc được với người đã mất, người nói rằng giúp bạn lấy lại số tiền, người khuyên bạn nghỉ việc đi nơi khác làm lại, người rủ bạn góp vốn, đều sẽ tìm đến. Việc nào số tiền vượt quá thu nhập một tháng, hoặc phải trả giá lớn nếu hối hận, đều dời lùi ba tháng. Kể cho một người không có lợi ích gì với việc này nghe trước, đừng quyết trong ngày"]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Chi phí"]},{"tag":"p","props":{},"children":["Không tốn tiền, chỉ là đẩy quyết định lùi, có thể vì thế b…"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Lợi ích"]},{"ta