lns":"http://www.w3.org/2000/svg","width":"18","height":"18","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-up-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M7 7h10v10"},"children":[]},{"tag":"path","props":{"d":"M7 17 17 7"},"children":[]}]}]}]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/en/book/06"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"Back to index"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["Items to avoid"]},{"tag":"div","props":{"data-ad-dock-host":"true"},"children":[]},{"tag":"nav","props":{"aria-label":"Chapter entries"},"children":[{"tag":"a","props":{"href":"/en/tip/06-01"},"children":[{"tag":"span","props":{},"children":["01"]},"Don’t take multivitamins for longevity or heart protection"]},{"tag":"a","props":{"href":"/en/tip/06-02"},"children":[{"tag":"span","props":{},"children":["02"]},"Don’t take regular fish oil capsules to prevent heart disease"]},{"tag":"a","props":{"href":"/en/tip/06-03"},"children":[{"tag":"span","props":{},"children":["03"]},"Don’t give vitamin D supplements to people who already have enough"]},{"tag":"a","props":{"href":"/en/tip/06-04"},"children":[{"tag":"span","props":{},"children":["04"]},"Don’t take antioxidant supplements to prevent cancer (beta-carotene, vitamin E, vitamin A)"]},{"tag":"a","props":{"href":"/en/tip/06-05"},"children":[{"tag":"span","props":{},"children":["05"]},"Don’t expect glucosamine/chondroitin to treat knee osteoarthritis"]},{"tag":"a","props":{"href":"/en/tip/06-06"},"children":[{"tag":"span","props":{},"children":["06"]},"Don’t rely on vitamin C to prevent colds"]},{"tag":"a","props":{"href":"/en/tip/06-07"},"children":[{"tag":"span","props":{},"children":["07"]},"Don’t get a whole-body PET-CT or tumor marker panel if you have no symptoms"]},{"tag":"a","props":{"href":"/en/tip/06-08"},"children":[{"tag":"span","props":{},"children":["08"]},"Don’t expect fitness trackers or smartwatches to help you lose weight"]},{"tag":"a","props":{"href":"/en/tip/06-09"},"children":[{"tag":"span","props":{},"children":["09"]},"Don’t pay a premium for organic food just to be “healthier”"]},{"tag":"a","props":{"href":"/en/tip/06-10"},"children":[{"tag":"span","props":{},"children":["10"]},"Don’t spend a lot of money on health supplements, herbal formulas, or tonics to “improve your health”"]},{"tag":"a","props":{"href":"/en/tip/06-11"},"children":[{"tag":"span","props":{},"children":["11"]},"Don’t take probiotics long-term if you have no gut problems"]},{"tag":"a","props":{"href":"/en/tip/06-12"},"children":[{"tag":"span","props":{},"children":["12"]},"Don’t force yourself to take cold showers just to “boost immunity”"]},{"tag":"a","props":{"href":"/en/tip/06-13"},"children":[{"tag":"span","props":{},"children":["13"]},"Don’t buy products marketed for detox, colon cleansing, enzymes, or alkaline water"]},{"tag":"a","props":{"href":"/en/tip/06-14"},"children":[{"tag":"span","props":{},"children":["14"]},"Don’t force yourself to drink water just to hit “8 glasses a day”"]},{"tag":"a","props":{"href":"/en/tip/06-15"},"children":[{"tag":"span","props":{},"children":["15"]},"Don’t spend money on fortune‑telling, tarot, or astrology to make decisions"]},{"tag":"a","props":{"href":"/en/tip/06-16"},"children":[{"tag":"span","props":{},"children":["16"]},"Don’t buy blue-light-blocking glasses to “protect your vision,” and don’t believe claims that staring at screens for months will ruin your eyes — but severe eye pain, redness, and swelling require immediate medical attention"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/en/tip/06-17","data-status":"active"},"children":[{"tag":"span","props":{},"children":["17"]},"Don’t treat blood donation as a health habit: claims that it “detoxifies, lowers cholesterol, and prevents heart attacks” lack randomized trial support, while frequent donation truly causes iron deficiency"]},{"tag":"a","props":{"href":"/en/tip/06-18"},"children":[{"tag":"span","props":{},"children":["18"]},"Don’t rely on generic health check packages to prevent disease; instead, get the evidence‑based screenings appropriate for your age and gender"]},{"tag":"a","props":{"href":"/en/tip/06-19"},"children":[{"tag":"span","props":{},"children":["19"]},"Don’t start taking uric‑acid‑lowering drugs just because a checkup shows high uric acid but you’ve never had symptoms"]},{"tag":"a","props":{"href":"/en/tip/06-20"},"children":[{"tag":"span","props":{},"children":["20"]},"Don’t have a gallbladder removed prophylactically just because an ultrasound found gallstones but you’ve never felt any pain"]},{"tag":"a","props":{"href":"/en/tip/06-21"},"children":[{"tag":"span","props":{},"children":["21"]},"Don’t cut calcium out to prevent kidney stones"]},{"tag":"a","props":{"href":"/en/tip/06-22"},"children":[{"tag":"span","props":{},"children":["22"]},"Don’t buy crystals, bracelets, or Pixiu figurines for “good luck,” “wealth attraction,” or “health benefits”"]},{"tag":"a","props":{"href":"/en/tip/06-23"},"children":[{"tag":"span","props":{},"children":["23"]},"Don’t expect shopping to lift your mood or boost your sense of self-worth"]},{"tag":"a","props":{"href":"/en/tip/06-24"},"children":[{"tag":"span","props":{},"children":["24"]},"Don’t spend extra money to “move up a rung” among your peers by buying a new house, car, or social circle"]},{"tag":"a","props":{"href":"/en/tip/06-25"},"children":[{"tag":"span","props":{},"children":["25"]},"Don’t believe that “willpower is like a muscle that runs out after use”"]},{"tag":"a","props":{"href":"/en/tip/06-26"},"children":[{"tag":"span","props":{},"children":["26"]},"Don’t expect skipping breakfast or the 16:8 intermittent fasting method to help you control your weight; instead, pick a meal timing you can stick to long-term"]},{"tag":"a","props":{"href":"/en/tip/06-27"},"children":[{"tag":"span","props":{},"children":["27"]},"Do not believe that \"masturbation harms the body\" or that \"abstinence is the only way to improve\"; what truly matters is whether it interferes with your sleep, work, and relationships"]},{"tag":"a","props":{"href":"/en/tip/06-28"},"children":[{"tag":"span","props":{},"children":["28"]},"Do not spend money on \"conversion therapy\" or \"gay علاج,\" and do not send your family members to undergo it either"]},{"tag":"a","props":{"href":"/en/tip/06-29"},"children":[{"tag":"span","props":{},"children":["29"]},"Do not expect “correct lifting posture” or lifting training to prevent back pain; reduce the weight and number of lifts, and exercise regularly"]},{"tag":"a","props":{"href":"/en/tip/06-30"},"children":[{"tag":"span","props":{},"children":["30"]},"Do not expect extra calcium or bone broth to make a fracture heal faster"]},{"tag":"a","props":{"href":"/en/tip/06-31"},"children":[{"tag":"span","props":{},"children":["31"]},"Don’t rely on an AI chatbot alone to judge a medical or legal problem; before seeing a doctor, going to court or spending big money, find the source it cites and check it against the original"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"Breadcrumb"},"children":[{"tag":"a","props":{"href":"/en/book"},"children":["Explore the book"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/en/book/06"},"children":["Chapter 6"," ·"," ","Items to avoid"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"06-17"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["17"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["Evidence"," ","A"]}]},{"tag":"h1","props":{"lang":"en"},"children":["Don’t treat blood donation as a health habit: claims that it “detoxifies, lowers cholesterol, and prevents heart attacks” lack randomized trial support, while frequent donation truly causes iron deficiency"]},{"tag":"p","props":{"lang":"en","className":"life-entry-summary"},"children":["The idea that donating blood helps “detoxify,” lowers cholesterol, or prevents heart attacks is not reliable. Those conclusions stem from observational data, and people who regularly donate are generally healthier to begin with. When this baseline difference is accounted for, the original claim that “each additional yearly donation lowers mortality by 18.6%” drops to just 7.5%. One actual randomized trial found no difference in death rates between donors and non-donors. On the other hand, donating too often does make people feel weak and cold — precisely because of iron loss."]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Cost"]},{"tag":"p","props":{},"children":["There is no monetary cost. A single donation — including r…"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Benefit"]},{"tag":"p","props":{},"children":["The Kuopio study in Finland followed 2862 men aged 42–60 for nearly nine years. In the 24 months prior to trac…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"Mark: Don’t treat blood donation as a health habit: claims that it “detoxifies, lowers cholesterol, and prevents heart attacks” lack randomized trial support, while frequent donation truly causes iron deficiency"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"Done"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"Plan to do"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"Save"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Share this tip"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Hide details"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Cost"]},{"tag":"p","props":{},"children":["There is no monetary cost. A single donation — including registration, drawing blood, and post-donation observation — takes about an hour. Over the following weeks, the body works to replenish the lost iron."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Benefit"]},{"tag":"p","props":{},"children":["The Kuopio study in Finland followed 2862 men aged 42–60 for nearly nine years. In the 24 months prior to tracking, 153 men donated blood; only one (0.7%) suffered an acute heart attack. Among the remaining 2529 non-donors, 316 (12.5%) experienced the same outcome (P<0.0001). After adjusting for age and other coronary risk factors, donors showed an 88% lower risk of heart attack; the relative risk was 0.12 (95% CI 0.02–0.86, P=0.035). However, this result came from an observational study without randomization. The Nordic SCANDAT database included 1182495 donors observed over 9526627 person-years; 15401 deaths occurred. After controlling for age and gender, each extra yearly donation lowered mortality by 18.6% (95% CI 16.8%–20.4%). Once the fact that only healthy individuals are allowed to donate was factored in, the benefit fell to 7.5% (95% CI 5.7%–9.4%). Researchers concluded this does not constitute solid proof of health benefits. The FeAST randomized trial enrolled 1277 patients with symptomatic peripheral artery disease; one group received regular blood removal every six months to reduce iron levels, while the other served as a control. Overall mortality rates were 125 out of 636 (20%) versus 148 out of 641 (23%). HR 0.85 (95% CI 0.67–1.08, P=0.17). Combined outcomes of death, heart attack, and stroke also showed no significant difference: 180 out of 205 (28% vs 32%) with HR 0.88 (95% CI 0.72–1.07, P=0.20). The INTERVAL trial involved 45263 whole-blood donors divided into three groups based on donation intervals: 12 weeks, 10 weeks, or 8 weeks for men; 16 weeks, 14 weeks, or 12 weeks for women. Shorter intervals indeed yielded more blood within two years (the 8-week group produced 1.69 extra units compared to the 12-week group, 95% CI 1.59–1.80). Yet no differences emerged in quality of life, physical activity, or cognitive function. However, more donors reported fatigue, shortness of breath, dizziness, lightheadedness, and restless legs — especially at night. Average hemoglobin and ferritin levels also dropped, and more donations were postponed due to low hemoglobin (all P<0.0001). Iron deficiency impairs heat production: ten women with iron-deficiency anemia, eight with depleted iron stores but no anemia, and twelve controls were immersed in 28°C water for 100 minutes. The anemia group’s rectal temperature averaged 36.0±0.2°C versus 36.2±0.1°C in controls (P=0.001); oxygen consumption was 5.28±0.26 versus 5.99±0.29 mL·min⁻¹·kg⁻¹ (P=0.04). Thyroid hormones thyroxine and triiodothyronine were also lower (P<0.002). This pattern occurs because donors are repeatedly screened for good health; the hypothesis that “removing iron protects the heart” has not been confirmed in randomized trials."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Original sources"]},{"tag":"p","props":{"className":"life-citations"},"children":["Salonen JT, Tuomainen TP, Salonen R, Lakka TA, Nyyssönen K (1998). Donation of blood is associated with reduced risk of myocardial infarction. The Kuopio Ischaemic Heart Disease Risk Factor Study. American Journal of Epidemiology, 148(5), 445-451. ",{"tag":"a","props":{"href":"https://doi.org/10.1093/oxfordjournals.aje.a009669","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1093/oxfordjournals.aje.a009669"]},"；Ullum H, Rostgaard K, Kamper-Jørgensen M, et al. (2015). Blood donation and blood donor mortality after adjustment for a healthy donor effect. Transfusion, 55(10), 2479-2485. ",{"tag":"a","props":{"href":"https://doi.org/10.1111/trf.13205","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1111/trf.13205"]},"；Zacharski LR, Chow BK, Howes PS, et al. (2007). Reduction of iron stores and cardiovascular outcomes in patients with peripheral arterial disease: a randomized controlled trial. JAMA, 297(6), 603-610. ",{"tag":"a","props":{"href":"https://doi.org/10.1001/jama.297.6.603","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1001/jama.297.6.603"]},"；Di Angelantonio E, Thompson SG, Kaptoge S, et al. (2017). Efficiency and safety of varying the frequency of whole blood donation (INTERVAL): a randomised trial of 45 000 donors. Lancet, 390(10110), 2360-2371. ",{"tag":"a","props":{"href":"https://doi.org/10.1016/S0140-6736(17)31928-1","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1016/S0140-6736(17)31928-1"]},"；Beard JL, Borel MJ, Derr J (1990). Impaired thermoregulation and thyroid function in iron-deficiency anemia. American Journal of Clinical Nutrition, 52(5), 813-819. ",{"tag":"a","props":{"href":"https://doi.org/10.1093/ajcn/52.5.813","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1093/ajcn/52.5.813"]},"；全国人大常委会 (1997). 中华人民共和国献血法（第二、九、十四条）. ",{"tag":"a","props":{"href":"https://flk.npc.gov.cn/detail?id=2c909fdd678bf17901678bf5e71801f9","target":"_blank","rel":"noopener noreferrer"},"children":["https://flk.npc.gov.cn/detail?id=2c909fdd678bf17901678bf5e71801f9"]},"；国家卫生健康委等 (2024-01-08). 关于进一步做好无偿献血者激励奖励工作的通知. ",{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/202401/content_6924875.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/zhengce/zhengceku/202401/content_6924875.htm"]}]},{"tag":"a","props":{"href":"https://doi.org/10.1093/oxfordjournals.aje.a009669","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Open source link"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Book note"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["This entry does not oppose blood donation itself, but rather the notion that it serves as a personal health practice. Donated blood is used for others, and according to the beneficiary classification in this book, it falls under category 4, which refers to strangers. What actually benefits the donor is the policy-related perks. Article 14 of the Blood Donation Law stipulates that unpaid blood donors are exempt from fees related to blood collection, storage, separation, and testing when using blood services themselves; their spouses and direct relatives may also be exempt or receive fee reductions as specified by provincial governments. In January 2024, the National Health Commission announced that 55 provinces and regions have implemented policies allowing unpaid blood donors and their relatives to have such hospital fees waived directly at discharge. Those who receive the National Blood Donation Award are also eligible for local “three free” policies, which cover free public transport, free entry to government-run parks, and waived outpatient consultation fees at public hospitals. Donors should adhere to the legally mandated intervals: Article 9 of the Blood Donation Law states that each donation should be 200 milliliters at minimum and 400 milliliters at maximum, with at least six months between donations. The recommended age range for donation is 18–55 years. Do not shorten the interval merely to meet honor criteria or group targets. Women, those with lower body weight, and individuals with heavy menstrual flow already have limited iron reserves; regular donors may opt for a self-funded ferritin test. If persistent fatigue, cold intolerance, or restless legs at night occur after donation, these are not signs of “vital energy depletion” but likely due to iron deficiency; a blood test and ferritin check are advised, followed by iron supplementation and extended donation intervals as directed by a doctor. The evidence for cold intolerance specifically comes from a study involving just 2024 participants, and this figure is included here solely to illustrate the phenomenon, not to indicate how many people experience it."]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["My note"]},{"tag":"button","props":{"type":"button"},"children":["Write a reminder for yourself…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/en/tip/06-16"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Previous"]},"Don’t buy blue-light-blocking glasses to “protect your vision,” and don’t believe claims that staring at screens for months will ruin your eyes — but severe eye pain, redness, and swelling require immediate medical attention"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/en/tip/06-18"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Next"]},"Don’t rely on generic health check packages to prevent disease; instead, get the evidence‑based screenings appropria