life-detail-label"},"children":["Lợi ích"]},{"tag":"p","props":{},"children":["Mỗi năm ở Mỹ có khoảng 3500 trẻ sơ sinh chết vì những nguyên nhân liên quan đến giấc ngủ. Trong đó có hội chứng đột tử ở trẻ sơ sinh, các ca không rõ nguyên nhân, và trẻ bị nghẹt thở do tai nạn trên giường. Môi trường ngủ an toàn do Hiệp hội Nhi khoa Hoa Kỳ đưa ra là 「仰卧位；使用坚实、不倾斜的睡眠表面；同房不同床；避免柔软的寝具和过热」, tức nằm ngửa; dùng mặt ngủ cứng, không nghiêng; cùng phòng khác giường; tránh chăn ga mềm và tránh nóng quá. Còn vài việc cũng làm giảm rủi ro: cho bú mẹ, không cho con tiếp xúc với nicotine và rượu, tiêm phòng đúng lịch, dùng núm vú."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Nguồn gốc"]},{"tag":"p","props":{"className":"life-citations"},"children":["Moon RY, Carlin RF, Hand I, Task Force on Sudden Infant Death Syndrome and the Committee on Fetus and Newborn (2022). Sleep-Related Infant Deaths: Updated 2022 Recommendations for Reducing Infant Deaths in the Sleep Environment. Pediatrics, 150(1), e2022057990. ",{"tag":"a","props":{"href":"https://doi.org/10.1542/peds.2022-057990","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1542/peds.2022-057990"]}]},{"tag":"a","props":{"href":"https://doi.org/10.1542/peds.2022-057990","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Liên kết mở nguồn"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"c