read-toc"},"children":[{"tag":"details","props":{"open":true},"children":[{"tag":"summary","props":{},"children":["本文目录"]},{"tag":"nav","props":{"aria-label":"本文目录"},"children":[{"tag":"a","props":{"href":"#当天签字之前"},"children":["当天：签字之前"]},{"tag":"a","props":{"href":"#当天到头几天把钱算清"},"children":["当天到头几天：把钱算清"]},{"tag":"a","props":{"href":"#头一周"},"children":["头一周"]},{"tag":"a","props":{"href":"#头一个月"},"children":["头一个月"]},{"tag":"a","props":{"href":"#之后几个月"},"children":["之后几个月"]}]}]}]},{"tag":"div","props":{"className":"life-longread-main"},"children":[{"tag":"article","props":{"className":"life-article-body","lang":"zh"},"children":[{"tag":"p","props":{},"children":["被裁员、被辞退之后要办的事，散在",{"tag":"a","props":{"href":"/book/19","title":"在职、离职和工伤"},"children":["第 19 节"]},"、",{"tag":"a","props":{"href":"/book/07","title":"没钱的时候怎么活"},"children":["第 7 节"]},"和别的几节里。下面按时间先后排成一份清单。每一步只写做什么，细节、数字和依据都在括号前指的那一条里。只是被欠薪、人还没走的，直接看",{"tag":"a","props":{"href":"/book/07#07-02","title":"被欠薪先投诉劳动监察，再申请劳动仲裁，两条路都不收费，多数案子几个月内有结果"},"children":["第 7 节第 2 条"]},"（被欠薪先投诉劳动监察）。"]},"\n",{"tag":"h2","props":{"id":"当天签字之前"},"children":["当天：签字之前"]},"\n",{"tag":"ol","props":{},"children":["\n",{"tag":"li","props":{},"children":["公司递来「个人原因主动辞职」的单子，不签。签了，经济补偿和失业保险金通常一起落空。见",{"tag":"a","props":{"href":"/book/19#19-07","title":"不要签「个人原因主动辞职」，那一签就没有 N 了"},"children":["第 19 节第 7 条"]},"（不要签「个人原因主动辞职」）。"]},"\n",{"tag":"li","props":{},"children":["公司说「先签了好走流程，补偿另外给」，就要求当场把补偿写进协议。不写就不签，当天不签没有任何法律后果。见",{"tag":"a","props":{"href":"/book/19#19-07","title":"不要签「个人原因主动辞职」，那一签就没有 N 了"},"children":["第 19 节第 7 条"]},"（不要签「个人原因主动辞职」）。"]},"\n",{"tag":"li","props":{},"children":["谈话时直接开录音。你自己参加的谈话，不用先征得对方同意。见",{"tag":"a","props":{"href":"/book/08#08-41","title":"可能翻脸的电话和面谈，直接开录音：自己参加的谈话，不用先征得对方同意"},"children":["第 8 节第 41 条"]},"（开录音）。"]},"\n",{"tag":"li","props":{},"children":["交回电脑和账号之前，把工资条、考勤、劳动合同、社保记录和聊天记录存下来。见",{"tag":"a","props":{"href":"/book/19#19-08","title":"离职前把工资条、考勤、劳动合同、社保记录和聊天记录先存下来"},"children":["第 19 节第 8 条"]},"（离职前存证据）。"]},"\n",{"tag":"li","props":{},"children":["只存自己的劳动关系材料。公司的源码、客户名单和技术文档不带走。见",{"tag":"a","props":{"href":"/book/11#11-07","title":"离职不带走源码、客户名单和技术文档，不上传个人网盘，不在下家复用"},"children":["第 11 节第 7 条"]},"（离职不带走源码）。"]},"\n",{"tag":"li","props":{},"children":["账号权限交清，不删数据，不改密码，哪怕公司欠你钱。见",{"tag":"a","props":{"href":"/book/11#11-06","title":"离职时交清账号权限，不删库、不留后门、不改密码锁系统，哪怕公司欠你钱"},"children":["第 11 节第 6 条"]},"（交清账号权限）。"]},"\n"]},"\n",{"tag":"h2","props":{"id":"当天到头几天把钱算清"},"children":["当天到头几天：把钱算清"]},"\n",{"tag":"ol","props":{},"children":["\n",{"tag":"li","props":{},"children":["先算 N：每满一年给一个月工资，不满半年给半个月。见",{"tag":"a","props":{"href":"/book/19#19-04","title":"被裁先算清 N：每满一年一个月工资，不满六个月按半个月"},"children":["第 19 节第 4 条"]},"（被裁先算清 N）。"]},"\n",{"tag":"li","props":{},"children":["月工资按走人前 12 个月的平均数算，奖金、津贴、补贴都要算进去。这一点最容易被公司做低。见",{"tag":"a","props":{"href":"/book/19#19-04","title":"被裁先算清 N：每满一年一个月工资，不满六个月按半个月"},"children":["第 19 节第 4 条"]},"（被裁先算清 N）。"]},"\n",{"tag":"li","props":{},"children":["先问清公司按哪一条跟你解除。只有三种情形会多一个月工资：你病后干不了活，你干不了工作、培训或调岗后还干不了，订合同时的情况大变、协商不成。这三种里公司没提前 30 天书面通知你，N 之外还要多给一个月工资，谈的时候把这一个月单独列出来。经济性裁员、协商解除都没有这一个月。见",{"tag":"a","props":{"href":"/book/19#19-05","title":"公司辞退你没提前 30 天通知，还要多付一个月工资"},"children":["第 19 节第 5 条"]},"（没提前 30 天通知）。"]},"\n",{"tag":"li","props":{},"children":["公司是违法解除的，赔偿金按 2N 算。算不算违法解除，先找法律援助或律师问清楚，再决定是谈还是去仲裁。见",{"tag":"a","props":{"href":"/book/19#19-06","title":"公司违法解除的，赔偿金是经济补偿标准的二倍"},"children":["第 19 节第 6 条"]},"（违法解除）。"]},"\n",{"tag":"li","props":{},"children":["没休完的年休假，离职时按当年已经干了多久折算结清。见",{"tag":"a","props":{"href":"/book/19#19-02","title":"年休假按累计工龄算 5、10、15 天，没休成的按日工资 300% 折钱"},"children":["第 19 节第 2 条"]},"（年休假）。"]},"\n",{"tag":"li","props":{},"children":["欠着的加班费一起算进去。见",{"tag":"a","props":{"href":"/book/19#19-01","title":"加班费按 1.5 倍、2 倍、3 倍三档算，不给就投诉劳动监察，逾期不付还要加付 50% 到 100%"},"children":["第 19 节第 1 条"]},"（加班费）。"]},"\n"]},"\n",{"tag":"h2","props":{"id":"头一周"},"children":["头一周"]},"\n",{"tag":"ol","props":{},"children":["\n",{"tag":"li","props":{},"children":["去办失业登记。失业保险金从办登记那天起算，晚办一个月就少拿一个月。见",{"tag":"a","props":{"href":"/book/07#07-01","title":"失业了先在线申领失业保险金"},"children":["第 7 节第 1 条"]},"（失业保险金）。"]},"\n",{"tag":"li","props":{},"children":["失业登记在就业服务中心这类公共就业服务机构办，不收钱。见",{"tag":"a","props":{"href":"/book/07#07-05","title":"找活先用免费的公共就业服务和零工市场，不找收费中介"},"children":["第 7 节第 5 条"]},"（公共就业服务）。"]},"\n",{"tag":"li","props":{},"children":["在「掌上 12333」App 或电子社保卡小程序上申领失业保险金。交满 1 年、又不是你主动辞职的，才能领。见",{"tag":"a","props":{"href":"/book/07#07-01","title":"失业了先在线申领失业保险金"},"children":["第 7 节第 1 条"]},"（失业保险金）。"]},"\n",{"tag":"li","props":{},"children":["领失业保险金这段时间，职工医保由失业保险替你交，不用自己另外参保。见",{"tag":"a","props":{"href":"/book/07#07-01","title":"失业了先在线申领失业保险金"},"children":["第 7 节第 1 条"]},"（失业保险金）。"]},"\n",{"tag":"li","props":{},"children":["打不起官司的，打 12348 申请法律援助。现在不用回原籍开经济困难证明。见",{"tag":"a","props":{"href":"/book/07#07-03","title":"打不起官司就申请法律援助，讨薪、赡养费、工伤这类案子本来就在范围内"},"children":["第 7 节第 3 条"]},"（法律援助）。"]},"\n",{"tag":"li","props":{},"children":["签过竞业协议的，留好原件。公司要按月给补偿，因公司原因 3 个月没给，你可以请求解除。见",{"tag":"a","props":{"href":"/book/11#11-12","title":"签了竞业协议，离职后公司不按月给补偿就书面催告，满 3 个月没给可以解除；没接触过商业秘密的岗位可请求确认条款不生效"},"children":["第 11 节第 12 条"]},"（竞业协议）。"]},"\n",{"tag":"li","props":{},"children":["把作息固定下来：按点起床，把找工作排进固定日程，别整天待在家里。见",{"tag":"a","props":{"href":"/book/29#29-03","title":"失业之后先把作息、医保和找工作的节奏固定下来，别整天待在家里"},"children":["第 29 节第 3 条"]},"（失业之后先把作息固定下来）。"]},"\n"]},"\n",{"tag":"h2","props":{"id":"头一个月"},"children":["头一个月"]},"\n",{"tag":"ol","props":{},"children":["\n",{"tag":"li","props":{},"children":["工资、加班费拖着不给的，先打 12333 投诉劳动监察，再申请劳动仲裁。两条路都不收费。见",{"tag":"a","props":{"href":"/book/07#07-02","title":"被欠薪先投诉劳动监察，再申请劳动仲裁，两条路都不收费，多数案子几个月内有结果"},"children":["第 7 节第 2 条"]},"（被欠薪先投诉劳动监察）。"]},"\n",{"tag":"li","props":{},"children":["雇你的是没执照的作坊，照样走监察和仲裁。包工头欠的钱找总包，给家庭或个人干私活的才去法院。见",{"tag":"a","props":{"href":"/book/07#07-22","title":"被欠了工钱，先分清雇你的是谁：没执照的作坊和包工头照样找劳动监察，给家庭或个人干私活才去法院"},"children":["第 7 节第 22 条"]},"（先分清雇你的是谁）。"]},"\n",{"tag":"li","props":{},"children":["劳动仲裁要在离职后 1 年内提出。过了期限，对方一句「超过时效」就够。见",{"tag":"a","props":{"href":"/book/08#08-19","title":"维权有期限：民事诉讼时效 3 年，劳动仲裁 1 年，过了对方一句「超过时效」就够"},"children":["第 8 节第 19 条"]},"（劳动仲裁 1 年）。"]},"\n",{"tag":"li","props":{},"children":["找工作先去公共就业服务机构，职业介绍和职业指导都免费，不找收费中介。见",{"tag":"a","props":{"href":"/book/07#07-05","title":"找活先用免费的公共就业服务和零工市场，不找收费中介"},"children":["第 7 节第 5 条"]},"（公共就业服务）。"]},"\n",{"tag":"li","props":{},"children":["求职别只投简历。学求职技巧，定明确目标，开口托熟人内推。见",{"tag":"a","props":{"href":"/book/07#07-14","title":"求职别只投简历，用系统方法：学技巧、定目标、找人帮"},"children":["第 7 节第 14 条"]},"（求职用系统方法）。"]},"\n",{"tag":"li","props":{},"children":["听到「先交钱再上岗」「先培训再安排工作」「拉人头」，当场拒绝。见",{"tag":"a","props":{"href":"/book/07#07-15","title":"不交押金、不押证件、不签「培训贷」、不进传销、不借高利贷"},"children":["第 7 节第 15 条"]},"（不签「培训贷」）。"]},"\n",{"tag":"li","props":{},"children":["想学技能，先查当地人社局的「职业培训补贴目录」，别自费报班。见",{"tag":"a","props":{"href":"/book/07#07-13","title":"失业期间去领职业培训补贴、就业见习补贴和社保补贴，别自费上培训班"},"children":["第 7 节第 13 条"]},"（职业培训补贴）。"]},"\n",{"tag":"li","props":{},"children":["看看自己够不够就业困难人员认定，比如大龄、长期失业。认定下来，自己交社保有补贴，还能排公益性岗位。见",{"tag":"a","props":{"href":"/book/07#07-12","title":"办失业登记后争取就业困难人员认定，拿社保补贴或公益性岗位"},"children":["第 7 节第 12 条"]},"（就业困难人员认定）。"]},"\n"]},"\n",{"tag":"h2","props":{"id":"之后几个月"},"children":["之后几个月"]},"\n",{"tag":"ol","props":{},"children":["\n",{"tag":"li","props":{},"children":["生活费先从应急金里出，不去借钱，也不亏着卖掉投资。见",{"tag":"a","props":{"href":"/book/05#05-27","title":"先存出 3 到 6 个月生活费的应急金，放在随时能取的地方"},"children":["第 5 节第 27 条"]},"（应急金）。"]},"\n",{"tag":"li","props":{},"children":["头三个月里，不可逆的大决定往后推。卖房、拿补偿款一次性去投资、合伙、替人担保，都算。见",{"tag":"a","props":{"href":"/book/29#29-12","title":"变故后的头三个月，凡是不可逆的大决定一律往后推"},"children":["第 29 节第 12 条"]},"（不可逆的大决定）。"]},"\n",{"tag":"li","props":{},"children":["失业保险金领完了还没找到工作，医保别空着。居民医保可以自己按年交，断缴后重新交有 3 个月看病不给报。见",{"tag":"a","props":{"href":"/book/07#07-09","title":"居民医保每年 400 元不要断，困难户可减免"},"children":["第 7 节第 9 条"]},"（居民医保）。"]},"\n",{"tag":"li","props":{},"children":["养老保险断了不清零，按累计年限算。不用花钱找人挂靠代缴。见",{"tag":"a","props":{"href":"/book/07#07-18","title":"社保断缴不要慌：养老按累计算，医保按规则补"},"children":["第 7 节第 18 条"]},"（社保断缴）。"]},"\n",{"tag":"li","props":{},"children":["家里收入掉到当地低保线以下，申请低保。见",{"tag":"a","props":{"href":"/book/07#07-07","title":"收入低于当地低保线就申请低保"},"children":["第 7 节第 7 条"]},"（申请低保）。"]},"\n",{"tag":"li","props":{},"children":["撑不住了想找人说话，打 12356，免费。见",{"tag":"a","props":{"href":"/book/29#29-11","title":"要人陪着说话打 12356，未成年人和青少年打 12355，要看医生挂心理门诊"},"children":["第 29 节第 11 条"]},"（打 12356）。"]},"\n",{"tag":"li","props":{},"children":["还没要回来的钱，盯住离职满 1 年这个期限。见",{"tag":"a","props":{"href":"/book/08#08-19","title":"维权有期限：民事诉讼时效 3 年，劳动仲裁 1 年，过了对方一句「超过时效」就够"},"children":["第 8 节第 19 条"]},"（劳动仲裁 1 年）。"]},"\n"]},"\n"]},{"tag":"footer","props":{"className":"life-article-attribution"},"children":[{"tag":"p","props":{},"children":["本文转载自《高性价比人生指南》开源仓库，保留原文表达与待核实标记，最新内容以原作者仓库为准。"]},{"tag":"a","props":{"href":"https://github.com/eternity4719/HowToLiveBetter/blob/33362aff50f97f413b22ddfcdb355d2a536a5700/docs/%E8%A2%AB%E8%A3%81%E4%BA%86%E4%B9%8B%E5%90%8E%E5%85%88%E5%81%9A%E4%BB%80%E4%B9%88.md","target":"_blank","rel":"noopener noreferrer"},"children":["查看来源版本 · 33362af",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"14","height":"14","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]},{"tag":"span","props":{},"children":["导入日期：2026-10-11"]},{"tag":"p","props":{},"children":["文中的条目链接按本站收录版本的对应主题对齐；原文编号可能与当前条目编号不同。"]}]},{"tag":"div","props":{"className":"life-quick-share"},"children":[{"tag":"button","props":{"type":"button"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/s