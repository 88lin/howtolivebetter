ag":"a","props":{"href":"/ja/tip/26-09"},"children":[{"tag":"span","props":{},"children":["09"]},"権利侵害の通知を受けた際は速やかに処理すること。異議申し立ての転送後、15日以内に進展がなければ復旧させる"]},{"tag":"a","props":{"href":"/ja/tip/26-10"},"children":[{"tag":"span","props":{},"children":["10"]},"ユーザー情報は安易に国外へ持ち出さないでください。国外への持ち出しには法的な条件と人数制限があります"]},{"tag":"a","props":{"href":"/ja/tip/26-11"},"children":[{"tag":"span","props":{},"children":["11"]},"サーバー選びは、まずダウンタイムに耐えられるか、次に運用担当者がいるかを確認し、最後に価格を比較すること"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"現在地"},"children":[{"tag":"a","props":{"href":"/ja/book"},"children":["本を読む"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/ja/book/26"},"children":["第26章"," ·"," ","ウェブサイトやプラットフォームの構築：資格、届出、サーバー"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"26-05"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["05"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["エビデンス"," ","A"]}]},{"tag":"h1","props":{"lang":"ja"},"children":["ユーザーに販売を許可する場合、プラットフォームは登録情報の照合、情報の報告、および3年間の保存を行う義務がある"]},{"tag":"p","props":{"lang":"ja","className":"life-entry-summary"},"children":["他者に自社プラットフォームでの販売を許可する場合、まず販売者の身元、住所、連絡先、および許可証を照合し、登録・アーカイブ化する必要があります。アーカイブ作成後は、少なくとも6ヶ月ごとに再確認を行わなければなりません。販売者が誰であるかは市場監督管理部門に報告し、納税状況は四半期ごとに税務当局に報告する必要があります。商品および取引記録は3年間保存してください。一つでも怠った場合は、まず是正を命じられ、是なされない場合は 2 万から 10 万元の罰金が科せられます。"]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["費用・手間"]},{"tag":"p","props":{},"children":["費用はかかりません。管理画面上で販売者の資格照合を行い、登録アーカイブを作成する必要があります。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["効果"]},{"tag":"p","props":{},"children":["法律はプラットフォームに対し、一定の要件を課しています。原文では「プラットフォームへの参入を申請し、商品を販売またはサービスを提供する事業者に対し、その身分、住所、連絡先、行政許可などの真実の情報を提出させ、照合・登録を…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"記録する：ユーザーに販売を許可する場合、プラットフォームは登録情報の照合、情報の報告、および3年間の保存を行う義務がある"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"できている"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"やることに追加"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"お気に入り"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"このヒントを共有"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"詳細を閉じる"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["費用・手間"]},{"tag":"p","props":{},"children":["費用はかかりません。管理画面上で販売者の資格照合を行い、登録アーカイブを作成する必要があります。税務関連情報は四半期ごとに一度報告し、取引データは3年間保存します。困難な点は、これが一度きりの作業ではなく、継続的な業務であることです。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["効果"]},{"tag":"p","props":{},"children":["法律はプラットフォームに対し、一定の要件を課しています。原文では「プラットフォームへの参入を申請し、商品を販売またはサービスを提供する事業者に対し、その身分、住所、連絡先、行政許可などの真実の情報を提出させ、照合・登録を行い、登録ファイルを構築するとともに、定期的に照合・更新を行わなければならない」とされています。販売者は参入前に、身分、住所、連絡先、および取得すべき許可証を提出する必要があります。これらを一度照合して登録・ファイル化し、その後、一定期間ごとに再度照合を行う必要があります。「定期的に」とはどのくらいの頻度かというと、部門規則ではより詳細に「少なくとも6ヶ月に1回は照合・更新を行うものとする」と定められています。また、市場監督管理部門に対してプラットフォーム内の事業者の身分情報を報告する必要があります。税務当局への報告も必要であり、原文では「税務徴収管理の法律および行政法規の規定に従い、プラットフォーム内の事業者の身分情報および納税に関連する情報を税務当局に報告する」とされています。したがって、販売者が誰であるかは市場監督管理部門に報告する必要があり、販売者の身元および納税状況は税務当局に報告する必要があります。商品・サービス情報および取引情報は「取引完了日から少なくとも3年間」保存しなければなりません。これは、1件の取引が完了した日から数えて、データを少なくとも3年間保持することを意味します。上記のいずれかに違反した場合は、期限内の是正を命じられます。期限内に是正されない場合は、2万から10万元の罰金が科されます。重大な事態においては、営業停止・整理を命じられ、さらに10万から50万元の罰金が科されます。税務関連情報は「四半期終了後の翌月内」に報告する必要があります。各四半期が終了した後の翌月中に報告を完了させなければなりません。期限内に報告しなかった場合の罰則は（全国的に）同様です。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["出典"]},{"tag":"p","props":{"className":"life-citations"},"children":["全国人大常委会 (2018). 电子商务法（第十、二十七、二十八、三十一、八十条）. ",{"tag":"a","props":{"href":"https://flk.npc.gov.cn/detail?id=2c909fdd678bf17901678bf8af050b81","target":"_blank","rel":"noopener noreferrer"},"children":["https://flk.npc.gov.cn/detail?id=2c909fdd678bf17901678bf8af050b81"]}," ; 市场监管总局 (2021). 网络交易监督管理办法（市场监管总局令第 37 号，第八、二十四、二十五、三十一条）. ",{"tag":"a","props":{"href":"https://www.gov.cn/gongbao/content/2021/content_5602020.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/gongbao/content/2021/content_5602020.htm"]}," ; 国务院 (2025). 互联网平台企业涉税信息报送规定（国务院令第 810 号，第二、三、四、十条）. ",{"tag":"a","props":{"href":"https://www.gov.cn/gongbao/2025/issue_12146/202507/content_7030983.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/gongbao/2025/issue_12146/202507/content_7030983.html"]}," ; 国家税务总局 (2025). 关于互联网平台企业报送涉税信息有关事项的公告（税务总局公告 2025 年第 15 号）. ",{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/202506/content_7029727.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/zhengce/zhengceku/202506/content_7029727.htm"]}]},{"tag":"a","props":{"href":"https://flk.npc.gov.cn/detail?id=2c909fdd678bf17901678bf8af050b81","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["出典を開く"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["著者の注記"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["販売者自身も市場主体としての登録を行う必要があります。法律では、登録が不要なケースがいくつか列挙されています。「個人による自社生産の農副産物および家庭手工業製品の販売、および個人が自身のスキルを利用して、許可を必要としない便益的な労務活動や小規模な取引活動を行う場合」です。「小規模な取引」には具体的な数値があり、ネットワーク取引監督管理弁法第8条では、年間取引額が 10 万元と定められています。プラットフォーム側には、他に2つのすべきことがあります。登録済み販売者と未登録販売者をそれぞれ区別して表示すること、および消費者のレビューの削除を禁止することです。"]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["自分のメモ"]},{"tag":"button","props":{"type":"button"},"children":["自分へのメモを書く…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/ja/tip/26-04"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["前へ"]},"サーバーを国内に置く場合は备案（届出）が必要であり、接続事業者は自ら付加価値通信許可を保有していなければならない"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/ja/tip/26-06"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["次へ"]},"ユーザーが投稿したコンテンツの管理義務：審査メカニズム、通報窓口、違法発見時の即時停止および報告"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["このテーマの他の提案"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/26-01"},"children":[{"tag":"strong","props":{},"children":["プラットフォームが自ら代金を受け取ってから販売者に送金するのではなく、ライセンスを持つ決済機関を通じて直接決済される仕組みにすること"]},{"tag":"span","props":{},"children":["購入者の資金が一度あなたの口座に入り、それを販売者に転送する行為は、決済業務を行っていることになります。このビジネスを行うには、中国人民銀…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/26-02"},"children":[{"tag":"strong","props":{},"children":["有料サイトの多くは許可証が必要。自社販売のみ（他者の出店不可）なら不要。仲介取引は別の許可が必要。無料なら届出のみでOK"]},{"tag":"span","props":{},"children":["ユーザーから料金を徴収するサイトは、多くの場合、事前に「増値電信業務経営許可証」を取得する必要があります。この許可証は個人では取得できませ…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/26-03"},"children":[{"tag":"strong","props":{},"children":["ライブ配信にはネットワーク文化経営許可証が必要。視聴覚番組用の許可証は民間企業ではほぼ取得不可能"]},{"tag":"span","props":{},"children":["