"m6.34 17.66-1.41 1.41"},"children":[]},{"tag":"path","props":{"d":"m19.07 4.93-1.41 1.41"},"children":[]}]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"17","height":"17","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-moon life-theme-icon-dark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"},"children":[]}]}]},{"tag":"button","props":{"type":"button","className":"life-language-switch","aria-label":"Español Elegir idioma","aria-haspopup":"menu","aria-expanded":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-globe","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]},{"tag":"path","props":{"d":"M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"},"children":[]},{"tag":"path","props":{"d":"M2 12h20"},"children":[]}]},{"tag":"span","props":{},"children":["Español"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]}]},{"tag":"a","props":{"className":"life-account","href":"/es/sign-in"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"17","height":"17","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle-user-round","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M18 20a6 6 0 0 0-12 0"},"children":[]},{"tag":"circle","props":{"cx":"12","cy":"10","r":"4"},"children":[]},{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},{"tag":"span","props":{},"children":["Iniciar sesión"]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/es/book/02"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"Volver al índice"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["No morir lentamente"]},{"tag":"nav","props":{"aria-label":"Consejos del capítulo"},"children":[{"tag":"a","props":{"href":"/es/tip/02-01"},"children":[{"tag":"span","props":{},"children":["01"]},"Dejar de fumar, cuanto antes mejor"]},{"tag":"a","props":{"href":"/es/tip/02-02"},"children":[{"tag":"span","props":{},"children":["02"]},"No fume en casa ni en el coche, y no permita que sus invitados fumen en su hogar"]},{"tag":"a","props":{"href":"/es/tip/02-03"},"children":[{"tag":"span","props":{},"children":["03"]},"Dejar de fumar no se logra solo con resistencia: primero hay que tomar medicación; la tasa de éxito se duplica"]},{"tag":"a","props":{"href":"/es/tip/02-04"},"children":[{"tag":"span","props":{},"children":["04"]},"Elija una fecha para dejar de fumar y no reduzca la cantidad gradualmente"]},{"tag":"a","props":{"href":"/es/tip/02-05"},"children":[{"tag":"span","props":{},"children":["05"]},"Acuda a una clínica para dejar de fumar o llame al 12320 para preguntar si hay servicios disponibles en su zona"]},{"tag":"a","props":{"href":"/es/tip/02-06"},"children":[{"tag":"span","props":{},"children":["06"]},"Quienes ya son fumadores no deben pensar en usar cigarrillos electrónicos; quienes nunca han fumado, mejor ni los prueben"]},{"tag":"a","props":{"href":"/es/tip/02-07"},"children":[{"tag":"span","props":{},"children":["07"]},"No beber bebidas azucaradas; cambiar a versiones sin azúcar tampoco soluciona el problema"]},{"tag":"a","props":{"href":"/es/tip/02-08"},"children":[{"tag":"span","props":{},"children":["08"]},"No masticar betel"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/es/tip/02-09","data-status":"active"},"children":[{"tag":"span","props":{},"children":["09"]},"Cambie la sal de cocina por sal baja en sodio (sal de potasio)"]},{"tag":"a","props":{"href":"/es/tip/02-10"},"children":[{"tag":"span","props":{},"children":["10"]},"Cepíllese los dientes a fondo y limpie los espacios interdentales a diario; reponga los dientes que falten sin demora"]},{"tag":"a","props":{"href":"/es/tip/02-11"},"children":[{"tag":"span","props":{},"children":["11"]},"Caminar entre 7000 y 8000 pasos al día, o hacer ejercicio rápido durante 150–300 minutos a la semana"]},{"tag":"a","props":{"href":"/es/tip/02-12"},"children":[{"tag":"span","props":{},"children":["12"]},"Quienes padecen hipertensión o hipercolesterolemia deben tomar los medicamentos según las indicaciones médicas; no deben interrumpirlos por su cuenta"]},{"tag":"a","props":{"href":"/es/tip/02-13"},"children":[{"tag":"span","props":{},"children":["13"]},"Dormir unas 7 horas cada noche y mantener una rutina regular"]},{"tag":"a","props":{"href":"/es/tip/02-14"},"children":[{"tag":"span","props":{},"children":["14"]},"Practica regularmente deportes de raqueta como tenis, bádminton o tenis de mesa"]},{"tag":"a","props":{"href":"/es/tip/02-15"},"children":[{"tag":"span","props":{},"children":["15"]},"Acumular actividades de esfuerzo breves, como subir escaleras o caminar rápido, hasta sumar unos cuatro o cinco minutos al día"]},{"tag":"a","props":{"href":"/es/tip/02-16"},"children":[{"tag":"span","props":{},"children":["16"]},"Hacer entrenamiento de fuerza 30–60 minutos por semana"]},{"tag":"a","props":{"href":"/es/tip/02-17"},"children":[{"tag":"span","props":{},"children":["17"]},"No se quede sentado durante mucho tiempo seguido; levántese de vez en cuando"]},{"tag":"a","props":{"href":"/es/tip/02-18"},"children":[{"tag":"span","props":{},"children":["18"]},"Consumir menos carne procesada (jamón, tocino, salchichas, carne enlatada)"]},{"tag":"a","props":{"href":"/es/tip/02-19"},"children":[{"tag":"span","props":{},"children":["19"]},"Beber menos o no beber alcohol"]},{"tag":"a","props":{"href":"/es/tip/02-20"},"children":[{"tag":"span","props":{},"children":["20"]},"Personas que beben a diario y sufren temblores y palpitaciones al dejarlo: no intenten dejarlo solos"]},{"tag":"a","props":{"href":"/es/tip/02-21"},"children":[{"tag":"span","props":{},"children":["21"]},"Si quieres beber menos, primero cuenta cuánto bebes a la semana y luego habla unos minutos con el médico"]},{"tag":"a","props":{"href":"/es/tip/02-22"},"children":[{"tag":"span","props":{},"children":["22"]},"Consumir un puñado pequeño de frutos secos cada día"]},{"tag":"a","props":{"href":"/es/tip/02-23"},"children":[{"tag":"span","props":{},"children":["23"]},"Cambiar parte de la carne roja por pescado y carne de ave"]},{"tag":"a","props":{"href":"/es/tip/02-24"},"children":[{"tag":"span","props":{},"children":["24"]},"Cambie parte del arroz blanco y la harina refinada por cereales integrales"]},{"tag":"a","props":{"href":"/es/tip/02-25"},"children":[{"tag":"span","props":{},"children":["25"]},"Beber té más de tres veces por semana"]},{"tag":"a","props":{"href":"/es/tip/02-26"},"children":[{"tag":"span","props":{},"children":["26"]},"Beber de tres a cuatro tazas de café al día, sin azúcar ni nata"]},{"tag":"a","props":{"href":"/es/tip/02-27"},"children":[{"tag":"span","props":{},"children":["27"]},"Consumir 5 porciones diarias (unos 400 g) de frutas y verduras"]},{"tag":"a","props":{"href":"/es/tip/02-28"},"children":[{"tag":"span","props":{},"children":["28"]},"Consumir menos alimentos ultraprocesados (patatas fritas, fideos instantáneos, pasteles, comidas rápidas)"]},{"tag":"a","props":{"href":"/es/tip/02-29"},"children":[{"tag":"span","props":{},"children":["29"]},"Cambiar de carbón y leña a electricidad o gas para cocinar y calentarse"]},{"tag":"a","props":{"href":"/es/tip/02-30"},"children":[{"tag":"span","props":{},"children":["30"]},"Deje enfriar las bebidas calientes antes de beberlas; evite el té, la sopa y el café muy calientes"]},{"tag":"a","props":{"href":"/es/tip/02-31"},"children":[{"tag":"span","props":{},"children":["31"]},"Salir al sol durante el día, no evites la luz natural"]},{"tag":"a","props":{"href":"/es/tip/02-32"},"children":[{"tag":"span","props":{},"children":["32"]},"Mantener el IMC entre 20 y 25; si se tiene sobrepeso, hay que adelgazar"]},{"tag":"a","props":{"href":"/es/tip/02-33"},"children":[{"tag":"span","props":{},"children":["33"]},"Consumir chile más de cuatro veces por semana"]},{"tag":"a","props":{"href":"/es/tip/02-34"},"children":[{"tag":"span","props":{},"children":["34"]},"Beber una o dos porciones de leche o yogur al día"]},{"tag":"a","props":{"href":"/es/tip/02-35"},"children":[{"tag":"span","props":{},"children":["35"]},"No es necesario evitar los huevos, pero no los consumas tres o cuatro al día"]},{"tag":"a","props":{"href":"/es/tip/02-36"},"children":[{"tag":"span","props":{},"children":["36"]},"Si es posible, tome un baño de inmersión; no se limite a una ducha"]},{"tag":"a","props":{"href":"/es/tip/02-37"},"children":[{"tag":"span","props":{},"children":["37"]},"Limite la siesta a media hora, no más de una hora; si necesita dormir una o dos horas para aguantar, debería investigar el motivo"]},{"tag":"a","props":{"href":"/es/tip/02-38"},"children":[{"tag":"span","props":{},"children":["38"]},"Dormir más la noche siguiente a una noche de desvelo, sin esperar al fin de semana"]},{"tag":"a","props":{"href":"/es/tip/02-39"},"children":[{"tag":"span","props":{},"children":["39"]},"Cuanto más tiempo trabaje de noche, mayor es el riesgo cardiovascular; si puede, cámbiese de puesto cuanto antes"]},{"tag":"a","props":{"href":"/es/tip/02-40"},"children":[{"tag":"span","props":{},"children":["40"]},"Compre aceite de cacahuete envasado con un número de autorización SC; evite el aceite casero de pequeños productores"]},{"tag":"a","props":{"href":"/es/tip/02-41"},"children":[{"tag":"span","props":{},"children":["41"]},"Cambiar el aceite vegetal por manteca de cerdo o mantequilla al cocinar no requiere cambiar de aceite por motivos de salud, ni tampoco hay que esperar que el aceite de linaza proteja el corazón"]},{"tag":"a","props":{"href":"/es/tip/02-42"},"children":[{"tag":"span","props":{},"children":["42"]},"Encender el extractor de humos al cocinar y mantenerlo encendido hasta terminar"]},{"tag":"a","props":{"href":"/es/tip/02-43"},"children":[{"tag":"span","props":{},"children":["43"]},"Si los sofocos y los sudores nocturnos alrededor de la menopausia afectan a tu vida, acude a ginecología para valorar la terapia hormonal; no los aguantes ni compres medicamentos por tu cuenta, y no la uses para prevenir enfermedades cardíacas"]},{"tag":"a","props":{"href":"/es/tip/02-44"},"children":[{"tag":"span","props":{},"children":["44"]},"Si ya quería un perro, cuente el paseo diario como parte de sus pasos, pero no tenga un perro solo por longevidad"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"Ruta de navegación"},"children":[{"tag":"a","props":{"href":"/es/book"},"children":["Libro"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/es/book/02"},"children":["Capítulo 2"," ·"," ","No morir lentamente"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"02-09"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["09"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["Evidencia"," ","A"]}]},{"tag":"h1","props":{"lang":"es"},"children":["Cambie la sal de cocina por sal baja en sodio (sal de potasio)"]},{"tag":"p","props":{"lang":"es","className":"life-entry-summary"},"children":["Las personas que hayan sufrido un ictus o que, siendo mayores de 60 años, padezcan hipertensión, al cambiar la sal de cocina por sal baja en sodio reducen su probabilidad de fallecer en los siguientes cinco años en aproximadamente un 12 %, y la probabilidad de sufrir un ictus en un 14 %."]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Coste"]},{"tag":"p","props":{},"children":["Un paquete cuesta unos pocos yuanes más que la sal normal.…"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Beneficio"]},{"tag":"p","props":{},"children":["En un ensayo clínico aleatorizado realizado en zonas rurales de China, se dividió a 20 995 participantes —todo…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"Marcar: Cambie la sal de cocina por sal baja en sodio (sal de potasio)"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"Hecho"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"Por hacer"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"Guardar"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Compartir consejo"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Ocultar detalles"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Coste"]},{"tag":"p","props":{},"children":["Un paquete cuesta unos pocos yuanes más que la sal normal. Puede cambiarla al hacer la compra sin dedicarle tiempo adicional; el sabor prácticamente no varía."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Beneficio"]},{"tag":"p","props":{},"children":["En un ensayo clínico aleatorizado realizado en zonas rurales de China, se dividió a 20 995 participantes —todos ellos personas que habían padecido un ictus o mayores de 60 años con hipertensión— en dos grupos. El seguimiento duró 4,74 años. Los resultados mostraron que el grupo que consumió sal baja en sodio presentó una reducción del riesgo de muerte de alrededor del 12 % (RR 0,88) en comparación con el grupo que usó sal normal; el riesgo de ictus disminuyó aproximadamente un 14 % (RR 0,86) y el de eventos cardiovasculares principales, un 13 % (RR 0,87). No se observaron diferencias estadísticamente significativas entre ambos grupos en cuanto a la incidencia de niveles elevados de potasio en sangre."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Fuentes originales"]},{"tag":"p","props":{"className":"life-citations"},"children":["Neal B 等 (2021). Effect of Salt Substitution on Cardiovascular Events and Death. NEJM. ",{"tag":"a","props":{"href":"https://doi.org/10.1056/NEJMoa2105675","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1056/NEJMoa2105675"]},"；O'Donnell M 等 (2014). Urinary sodium and potassium excretion, mortality, and cardiovascular events. NEJM. ",{"tag":"a","props":{"href":"https://doi.org/10.1056/NEJMoa1311889","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1056/NEJMoa1311889"]},"（争议方 PURE）"]},{"tag":"a","props":{"href":"https://doi.org/10.1056/NEJMoa2105675","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Abrir fuente"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Nota del autor"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["Existen controversias al respecto. El estudio PURE únicamente realizó un seguimiento a largo plazo sin asignar grupos aleatorios; sus resultados indican que quienes excretan menos de 3 g de sodio al día presentan un riesgo de muerte y eventos cardiovasculares un 27 % mayor, mientras que aquellos que excretan más de 7 g diarios tienen un riesgo un 15 % superior. Según estos hallazgos, tanto un consumo excesivo como insuficiente de sodio resultan perjudiciales; lo óptimo se sitúa en un rango intermedio. No obstante, en el ensayo aleatorizado chino mencionado, la sal baja en sodio se utilizó solo como sustitución parcial, por lo que el nivel de sodio ingerido no baja tanto como sugiere el estudio PURE. Asimismo, hay que tener en cuenta que los participantes del ensayo eran personas mayores de alto riesgo; los beneficios de este cambio serán mucho menores en jóvenes sanos. Quienes padezcan insuficiencia renal o tomen medicamentos que retienen potasio deben consultar a su médico antes de realizar este cambio."]}]}]},{"tag":"section","props":{"className":"jd-entry-products"},"children":[{"tag":"div","props":{"className":"jd-section-heading"},"children":[{"tag":"h2","props":{},"children":["Productos relacionados"]},{"tag":"a","props":{"href":"/es/products"},"children":["Todos los productos"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"14","height":"14","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-up-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M7 7h10v10"},"children":[]},{"tag":"path","props":{"d":"M7 17 17 7"},"children":[]}]}]}]},{"tag":"p","props":{},"children":["Algunos productos útiles para esta situación."]},{"tag":"div","props":{"className":"jd-product-grid"},"children":[{"tag":"article","props":{"className":"jd-product","id":"jd-100051495797"},"children":[{"tag":"div","props":{"className":"jd-product-image"},"children":[{"tag":"img","props":{"src":"/sites/howtolivebetter/external/img30.360buyimg.com/n0/jfs/t1/266106/38/25614/63295/67c15b43Ff8573329/3a729dd8df8bf72c.jpg","alt":"Sal baja en sodio China Salt · sin yodo","loading":"lazy","width":"280","height":"280","referr