1 2 2v16z"},"children":[]}]},"お気に入り"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"このヒントを共有"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"詳細を閉じる"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["費用・手間"]},{"tag":"p","props":{},"children":["費用はかかりません。電話一本で済みます。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["効果"]},{"tag":"p","props":{},"children":["戸籍登録条例第八条第二項：「市民が不慮の事故により死亡した、または死因が不明な場合、戸主および発見者は直ちに現地の公安派出所または郷・鎮人民委員会に報告しなければならない」。意味：事故が発生した場合、または死因が不明な場合、戸主および発見者は速やかに派出所または郷鎮政府に報告しなければならない。葬儀管理条例第二十三条：「自然人が正常に死亡した場合、医療衛生機関は速やかに死亡診断書を発行しなければならない。公安機関による法的な処置の対象となり、かつ医療衛生機関による救済を受けていない非正常な死亡案件（事）の故人については、公安機関が死亡診断書を発行するものとする」。意味：通常の病死については、診療を行った医療機関が死亡診断書を発行する。病院での救済を受けず、かつ公安の処理対象となるケースについては、公安が発行する。非正常な死亡の死亡診断書は、公安のみが発行できる。現場で（警察などの）介入があったとすると、説明がつかないし、対応も難しくなります。その後の火葬、死亡届の受理、保険金請求も、すべてこの一枚の書類で行き詰まってしまいます"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["出典"]},{"tag":"p","props":{"className":"life-citations"},"children":["全国人大常委会 (1958). 中华人民共和国户口登记条例（第八条）. ",{"tag":"a","props":{"href":"http://www.gd.gov.cn/zwgk/wjk/zcfgk/content/mpost_2531969.html","target":"_blank","rel":"noopener noreferrer"},"children":["http://www.gd.gov.cn/zwgk/wjk/zcfgk/content/mpost_2531969.html"]},"（广东省人民政府门户网站刊登）；国务院 (2026). 殡葬管理条例（国务院令第 824 号，自 2026 年 3 月 30 日起施行，第二十三条）. ",{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/202601/content_7054169.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/zhengce/zhengceku/202601/content_7054169.htm"]}]},{"tag":"a","props":{"href":"http://www.gd.gov.cn/zwgk/wjk/zcfgk/content/mpost_2531969.html","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["出典を開く"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["著者の注記"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["長期の病気療養中や自宅での看取りは、自然死とみなされます。生前に診察を受けていた医療機関、または居住地域のコミュニティ衛生サービスセンターや郷鎮衛生院に証明書の発行を依頼できます。死亡診断書は、救護にあたった者が発行します（第 2 条（死亡診断書）を参照）。どちらのケースか判断できない場合は、不自然死として処理し、まずは 110 に連絡してください。警察の調査が終われば、同様に証明書を発行できます。もし通報前に現場を片付けてしまうと、誰も助けることができません。遺体を動かしたり、遺体を清拭・着替えさせたりしないでください。また、薬の瓶や書き置きなども片付けないでください。"]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["自分のメモ"]},{"tag":"button","props":{"type":"button"},"children":["自分へのメモを書く…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"span","props":{},"children":[]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/ja/tip/25-02"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["次へ"]},"死亡診断書は、その後のすべての手続きの鍵となります：病院での死亡は当該医療機関、自宅での自然死は地域のコミュニティ衛生サービス機関へ、発行は1日以内"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["このテーマの他の提案"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/25-03"},"children":[{"tag":"strong","props":{},"children":["遺体の搬送、保管、火葬は葬儀場で行う必要があり、病院の安置所では葬儀業務は行われません。保管期間は通常 3 日を超えません。"]},{"tag":"span","props":{},"children":["搬送、保管、防腐、整容、火葬は、葬儀場のみが行うことができます。病院の安置所は葬儀業務を行わず、遺体を一時的に安置するのみです。葬儀場での