"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},{"tag":"span","props":{},"children":["ログイン"]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/ja/book/31"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"目次に戻る"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["18歳以降、どのような道があるか"]},{"tag":"nav","props":{"aria-label":"この章のヒント"},"children":[{"tag":"a","props":{"href":"/ja/tip/31-01"},"children":[{"tag":"span","props":{},"children":["01"]},"まずは基準を確認：12のルートの年齢と学歴要件は明文化されています"]},{"tag":"a","props":{"href":"/ja/tip/31-02"},"children":[{"tag":"span","props":{},"children":["02"]},"18歳の 10 月 31 日までに兵役登録を行う必要があります。義務兵の現役期間は2年間です"]},{"tag":"a","props":{"href":"/ja/tip/31-03"},"children":[{"tag":"span","props":{},"children":["03"]},"徴兵に応じた後に兵役を拒否した場合、2年間は出国や進学・復学が禁止され、公務員や国営企業への採用も不可となります"]},{"tag":"a","props":{"href":"/ja/tip/31-04"},"children":[{"tag":"span","props":{},"children":["04"]},"大学生の兵役で最も実利的な2点：授業料が毎年最大 20000 元補助、学籍は2年間保持、大学院入試の特別枠あり"]},{"tag":"a","props":{"href":"/ja/tip/31-05"},"children":[{"tag":"span","props":{},"children":["05"]},"退役後、政府による就業配置が行われるのは6つのケースのみ；自主就業の場合は 30 日以内に届け出が必要"]},{"tag":"a","props":{"href":"/ja/tip/31-06"},"children":[{"tag":"span","props":{},"children":["06"]},"退役後の3つの勘定：一時金としての退役金、軍歴の勤続年数算入、自主事業の場合は毎年 20000 元の減税"]},{"tag":"a","props":{"href":"/ja/tip/31-07"},"children":[{"tag":"span","props":{},"children":["07"]},"公務員試験以外にも公務員への道はある：基礎サービスプロジェクトで2年間勤務すれば、毎年 10% の定向採用計画に応募可能"]},{"tag":"a","props":{"href":"/ja/tip/31-08"},"children":[{"tag":"span","props":{},"children":["08"]},"特崗教師（特別採用教員）は、3年間の服務期間終了後、評価に合格し、かつ継続を希望する場合は、速やかに正規採用（入編）されるべきである"]},{"tag":"a","props":{"href":"/ja/tip/31-09"},"children":[{"tag":"span","props":{},"children":["09"]},"消防士と軍事文職は、公務員試験とは別の公開採用枠であり、門戸は公務員試験よりも低い"]},{"tag":"a","props":{"href":"/ja/tip/31-10"},"children":[{"tag":"span","props":{},"children":["10"]},"学歴は一度きりの取引ではない：自考（社会自学試験）は年齢や既修学歴を問わず、成人高考や開放大学でも補完が可能"]},{"tag":"a","props":{"href":"/ja/tip/31-11"},"children":[{"tag":"span","props":{},"children":["11"]},"組織に属さなければ「フリーランス」：年金と医療保険は就業地での加入が必要、戸籍による制限は緩和済み"]},{"tag":"a","props":{"href":"/ja/tip/31-12"},"children":[{"tag":"span","props":{},"children":["12"]},"出前置配送、配网約車、市内貨物輸送などの業務において、プラットフォームが注文ごとに職業傷害保障費を負担し、自身での支払いは不要"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/ja/tip/31-13","data-status":"active"},"children":[{"tag":"span","props":{},"children":["13"]},"大学入試の志望校記入日に公務員枠を確定できる2つの道：公費師範生と定向医学生、代償は 6 年間の義務履行"]},{"tag":"a","props":{"href":"/ja/tip/31-14"},"children":[{"tag":"span","props":{},"children":["14"]},"海外での就労を希望するなら、まずこの会社に「対外労務合作経営資格」があるか確認すること：預かり金を請求することは禁止されています"]},{"tag":"a","props":{"href":"/ja/tip/31-15"},"children":[{"tag":"span","props":{},"children":["15"]},"海外企業のリモートワーク、この収入は税法上「国内所得」とみなされます：個人所得税は自身で申告し、送金は「給与所得」として処理すること"]},{"tag":"a","props":{"href":"/ja/tip/31-16"},"children":[{"tag":"span","props":{},"children":["16"]},"会社に属さず自力で起業するなら、まずは創業保証ローンをチェック：個人向け最高 30 万円、利息の半分を財政が補助"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"現在地"},"children":[{"tag":"a","props":{"href":"/ja/book"},"children":["本を読む"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/ja/book/31"},"children":["第31章"," ·"," ","18歳以降、どのような道があるか"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"31-13"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["13"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["エビデンス"," ","A"]}]},{"tag":"h1","props":{"lang":"ja"},"children":["大学入試の志望校記入日に公務員枠を確定できる2つの道：公費師範生と定向医学生、代償は 6 年間の義務履行"]},{"tag":"p","props":{"lang":"ja","className":"life-entry-summary"},"children":["これら2つの道はいずれも、国が先に費用を負担し、卒業後に合意に基づき指定された場所で 6 年間勤務するものです。公費師務生は教育部直属の6つの師範大学のみで募集され、前期批（先行入試）で录取されます。定向医学生は入学通知書を受け取る前に三者間合意書に署名する必要があります。契約違反をすると、費用の返還、違約金の支払い、さらには信用記録への記載が伴います。この 6 年間を受け入れられるかよく考えてから、志望校を記入してください。"]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["費用・手間"]},{"tag":"p","props":{},"children":["授業料も宿泊費も自己負担の必要がなく、生活費の補助も受けられます。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["効果"]},{"tag":"p","props":{},"children":["公費師範生は『教育部直属師範大学本研銜接師範生公費教育実施办法』（2024 年、2018 年の旧制度は同時に廃止）を参照すること。"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"記録する：大学入試の志望校記入日に公務員枠を確定できる2つの道：公費師範生と定向医学生、代償は 6 年間の義務履行"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"できている"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"やることに追加"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"お気に入り"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"このヒントを共有"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"詳細を閉じる"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["費用・手間"]},{"tag":"p","props":{},"children":["授業料も宿泊費も自己負担の必要がなく、生活費の補助も受けられます。代償は、卒業後 6 年間は自由に職を選べないことであり、契約違反には費用の返還、違約金の支払い、信用記録への記載が伴います。難しい点は、この 6 年間は勤務地の変更ができないことです。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["効果"]},{"tag":"p","props":{},"children":["公費師範生は『教育部直属師範大学本研銜接師範生公費教育実施办法』（2024 年、2018 年の旧制度は同時に廃止）を参照すること。第二条：中央財政が学生の在学期間中の授業料、宿泊費を負担し、生活費の補助を行う。第三条：重点は中西部地域の省都以外の地（市、州、盟）およびそれ以下の地域での育成とする。また、「直轄市、計画単列市、または省都の中心部への定員派遣は禁止する（5つの自治区、陸地国境省、海南省、貴州省、青海省は除く）」とも記載されている。第九条：卒業後は原則として、出身省の指定された地（市、州、盟）の中小学校に赴任し、「6 年以上の中小学校教育業務に従事することを約束する」ものとする。都市部の学校に勤務する場合、「農村部の義務教育学校で少なくとも 1 年間勤務しなければならない」と定められています。第13条：義務を履行しなかった場合、または履行期間が不足している場合は、合意に基づき責任を負うものとします。その結果の一つとして、「契約違反行為は信用記録に記載され、全国信用情報共有プラットフォームと速やかに共有され、違反に関する資料は本人の人事記録に組み込まれる」とあります。また、「履行任務を完了するまでは、指定された地域（市、州、盟）以外での教職に就くことはできず、他の公務員としての採用（雇用）も認められない。履行任務の完了後、関連する信用は回復する」とも記されています。合意された服務期間を満了するまでは、他の公務職への応募はできません。期間を満了して初めて、信用記録が回復します。第6条：採用後の調査において教職に適さないと判断された場合は、入学後 1 年以内に受領済みの公費教育費を返還し、非師範専門へと変更されるものとします。第十四条：規定の修業年限内に教育修士の学位記および教員資格証を取得できなかった場合は、契約違反として取り扱い、授業料の返還および違約金の支払いを命じる。第二十一条：各地域は、既存の定員枠の範囲内で、公費師範生の中小学校への配属に必要な定員を確保するものとする。農村部向けオーダーメイド型無料医学生については、別途通知を参照のこと。合格後、入学許可証を受け取る前に、養成校および就業予定地の県級衛生健康・人社部門と協議書を締結しなければならない。協議書には「卒業後、指定された農村部の基礎医療衛生機関にて 6 年間勤務することを約束する」旨を記載すること。契約の履行とは、協議書に基づき指定された場所で規定の期間勤務することである。履行として就業に就いた後は、3 年間の全科専門住院医师規範化培訓（標準化研修）に参加しなければならない。これは、卒業後に病院にて統一された基準に従ってさらなる技能習得を行う段階を指す。研修期間中、元の人事および給与関係は変更されません。契約違反の記録は個人の人事ファイルに記載され、医療機関等の行政機関における公開採用（募集）、住院医师規範化培训（レジデント研修）の受け入れ、および大学院入試における誠実性の評価基準となります。悪意のある契約違反者は、「信用中国」ウェブサイトを通じて全国に公示され、信用失墜者に対する共同制裁の対象となります。違反した研修年数は奉仕期間には算入されません。合意に基づき費用および違約金を返還しない場合は、県級衛生健康行政部門が法的手段を通じて回収（全国）を行います。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["出典"]},{"tag":"p","props":{"className":"life-citations"},"children":["国务院办公厅 (2024). 关于转发教育部等部门《教育部直属师范大学本研衔接师范生公费教育实施办法》的通知（国办发〔2024〕27 号，第二、三、六、九、十三、十四、二十一条）. ",{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/202406/content_6957261.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/zhengce/zhengceku/202406/content_6957261.htm"]},"；国家卫生健康委、中央编办、国家发展改革委、教育部、财政部、人力资源社会保障部、国家中医药局 (2019). 关于做好农村订单定向免费培养医学生就业安置和履约管理工作的通知. ",{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/2019-11/13/content_5451684.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/zhengce/zhengceku/2019-11/13/content_5451684.htm"]}]},{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/202406/content_6957261.htm","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["出典を開く"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["著者の注記"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["2024 年のあの制度では、公費師範生は「学部・修士連携」（学部の後に教育学修士課程へ進む形式）に変更されました。2018 年の旧制度はすでに廃止されており、ネット上で今も流布している「学部卒業後、直接教職に就く」という話は古いものです。制度の公布前にすでに契約を締結していた場合は、元の契約に従います。「定員（編制）がある」ことは「入職すれば何も心配いらない」ことと同義ではありません。定員は既存の総枠の中から空きを作る必要があり、具体的なポストは各自治体の組織や採用学校が個別に募集を行い、本人と学校が互いに選考することになります。定向医学生（特定の地域勤務を条件とした学生）は、奉仕期間終了後に離脱を希望することは可能です。文書には「奉仕期間終了後、自主的な就職希望には同意を与えるものとする」と明記されています。すでに契約違反（違約）状態にある場合でも、違約記録を抹消する方法はあります。その代償として、元の契約通りに勤務するか、あるいは省内の他の農村部などの基層機関で少なくとも 6 年間勤務し直す必要があり、支払い済みの費用や違約金は返還されません。医学生には 3 年間の正規研修期間も含まれるため、全体の期間は師範大学よりも長くなります。各省には独自の公費師範生および定員医学生制度があり、条件は各省によって定められています。志願前には、その年の当該省の募集要項を確認してください。"]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["自分のメモ"]},{"tag":"button","props":{"type":"button"},"children":["自分へのメモを書く…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/ja/tip/31-12"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["前へ"]},"出前置配送、配网約車、市内貨物輸送などの業務において、プラットフォームが注文ごとに職業傷害保障費を負担し、自身での支払いは不要"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/ja/tip/31-14"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["次へ"]},"海外での就労を希望するなら、まずこの会社に「対外労務合作経営資格」があるか確認すること：預かり金を請求することは禁止されています"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["このテーマの他の提案"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/31-08"},"children":[{"tag":"strong","props":{},"children":["特崗教師（特別採用教員）は、3年間の服務期間終了後、評価に合格し、かつ継続を希望する場合は、速やかに正規採用（入編）されるべきである"]},{"tag":"span","props":{},"children":["特崗計画は、数少ない「任期終了後の正規採用」が明記されているルートの一つです。条件は、学士以上の学位（主に師範系専攻）、 30 歳以下、か…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/31-09"},"children":[{"tag":"strong","props":{},"children":["消防士と軍事文職は、公務員試験とは別の公開採用枠であり、門戸は公務員試験よりも低い"]},{"tag":"span","props":{},"children":["これら2つのルートはいずれも「専門学校（大専）以上」というハードルに縛られません。消防士は 18 から 22 歳、高校卒業以上の学歴の人を…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/31-10"},"children":[{"tag":"strong","props":{},"children":["学歴は一度きりの取引ではない：自考（社会自学試験）は年齢や既修学歴を問わず、成人高考や開放大学でも補完が可能"]},{"tag":"span","props":{},"children":["18歳の時に学業を断念したとしても、その後には自考、成人高考、開放大学という3つの正規のルートがあります。自考は年齢やこれまでの学歴を問い…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/31-11"},"children":[{"tag":"strong","props":{},"children":["組織に属さなければ「フリーランス」：年金と医療保険は就業地での加入が必要、戸籍による制限は緩和済み"]},{"tag":"span","props":{},"children":["組織に属さないことは、社会保険がないことを意味するわけではありません。単に、半分を代行して支払ってくれる人がいないだけです。文書では、各地…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/31-15"},"children":[{"tag":"strong","props":{},"children":["海外企業のリモートワーク、この収入は税法上「国内所得」とみなされます：個人所得税は自身で申告し、送金は「給与所得」として処理すること"]},{"tag":"span","props":{},"