g","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"分享这条建议"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"收起详情"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["成本"]},{"tag":"p","props":{"className":"life-citations"},"children":["不花钱。花一分钟算一下自己多大。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["收益"]},{"tag":"p","props":{"className":"life-citations"},"children":["《义务教育法》第十一条：「凡年满六周岁的儿童，其父母或者其他法定监护人应当送其入学接受并完成义务教育」。第十四条：「禁止用人单位招用应当接受义务教育的适龄儿童、少年」。第五十八条：没有正当理由、不按本法规定送适龄儿童少年入学的，由当地乡镇人民政府或者县级人民政府教育行政部门「给予批评教育，责令限期改正」。《禁止使用童工规定》第二条：国家机关、社会团体、企业事业单位、民办非企业单位或者个体工商户「均不得招用不满16周岁的未成年人」。第六条：「按照每使用一名童工每月处5000元罚款的标准给予处罚」，逾期不改正的按每人每月 1 万元罚。第七条：介绍童工去就业的，「按照每介绍一人处5000元罚款」。第十条：童工患病或者受伤的，用人单位「应当负责送到医疗机构治疗，并负担治疗期间的全部医疗和生活费用」，伤残或死亡的还要一次性赔偿。第十三条只留了一个例外：文艺、体育单位经父母或者其他监护人同意，可以招用不满 16 周岁的专业文艺工作者、运动员（全国）"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["来源"]},{"tag":"p","props":{"className":"life-citations"},"children":["全国人大常委会 (2018). 义务教育法（2018 年第二次修正，第十一、十四、五十八条）. ",{"tag":"a","props":{"href":"http://www.moe.gov.cn/jyb_sjzl/sjzl_zcfg/zcfg_jyfl/202110/t20211029_575949.html","target":"_blank","rel":"noopener noreferrer"},"children":["http://www.moe.gov.cn/jyb_sjzl/sjzl_zcfg/zcfg_jyfl/202110/t20211029_575949.html"]},"（教育部刊登）；国务院 (2002). 禁止使用童工规定（国务院令第 364 号，第二、六、七、十、十三条）. ",{"tag":"a","props":{"href":"http://www.gov.cn/gongbao/content/2002/content_61798.htm","target":"_blank","rel":"noopener noreferrer"},"children":["http://www.gov.cn/gongbao/content/2002/content_61798.htm"]},""]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["原书备注"]},{"tag":"p","props":{"className":"life-citations"},"children":["受益人是自己。满 16 岁以后打工是合法的。但肯要一个 16 岁、没学历的人的岗位，正好是本节第 10 条（挑抗自动化的技能）讲的那一类：流程固定，最容易被机器顶掉。第 19 节讲的加班费、年休假、工伤待遇，前提都是有劳动关系、有证据。黑工这两样都没有，那些钱也就拿不到"]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["我的备注"]},{"tag":"button","props":{"type":"button"},"children":["写下对自己有用的提醒…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"span","props":{},"children":[]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/tip/23-02"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["下一条"]},"把「读书有没有用」也放进死亡率账里：每多受一年教育，成人死亡风险降约 1.9%"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["本主题的其他建议"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/23-03"},"children":[{"tag":"strong","props":{},"children":["判断「学历是不是贬值了」之前，先看全国的学历结构：每 10 万人里只有 15467 人有大学文化程度（2020 年普查，2025 年抽样推算约 19%）"]},{"tag":"span","props":{},"children":["2020 年人口普查时，全国念到大专及以上的约占 15%。2025 年的抽样调查推算约 19%，五年里多了几个百分点。两次都是初中学历的人最多。15 岁以上的人…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/23-04"},"children":[{"tag":"strong","props":{},"children":["「读不起」先按政策算一遍：中职学费大多已免，助学金 2300 元，助学贷款每年最高 2 万"]},{"tag":"span","props":{},"children":["公办中职里，农村学生、城市涉农专业学生和家庭困难学生已经免学费。中职和普通高中的助学金，2025 年春季起每年 2300 元。上了大学，助学金每年 3700 元…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/23-05"},"children":[{"tag":"strong","props":{},"children":["没考上普高不等于路断了：中职有贯通招生和单独考试，技能岗位招聘还可以降学历要求"]},{"tag":"span","props":{},"children":["2022 年的职业教育法写明：职业教育和普通教育地位同等重要。中职可以和高职贯通招生，高职还必须留出招生计划或者单独考试，专门招中职毕业生。用人单位也不得因为你…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/23-06"},"children":[{"tag":"strong","props":{},"children":["把「读书还是打工」算成一道题：先去打工早挣的三年工资，对上接着读书换来的、往后几十年的年收入差"]},{"tag":"span","props":{},"children":["先去打工，能早挣几年工资，但这笔钱只拿一次。接着读书，往后每年都比不读的多挣一些，要连着拿三四十年。所以要把这两笔钱放在一起比。中国城镇多读一年书，一年收入大约…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/23-07"},"children":[{"tag":"strong","props":{},"children":["先记住基准线：多受一年教育，全球平均的私人回报（落到自己收入上的那部分）约为每年 9%"]},{"tag":"span","props":{},"children":["按全世界平均算，多读一年书，个人收入每年高约 9%，女性的回报一直高于男性。这个数说的是正规上学，报一个班不能直接套。拿它当尺子：一个课程要你花 3 万元和半年…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/23-08"},"children":[{"tag":"strong","props":{},"children":["花钱考证之前，先查这张证在不在国家职业资格目录或人社部备案的评价机构名单里"]},{"tag":"span","props":{},"children":["有些机构打着新职业、技能等级的名义乱办班、乱收费、滥发证，还有假冒权威机构的，人社部专门治理过。报名前按三步查：这个职业在不在国家职业资格目录、发证机构是不是人…"]}]}]}]},{"tag":"a","props":{"className":"life-text-link","href":"/book/23"},"children":["阅读整个主题：学什么技能划算 ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"15","height":"15","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]}]}]},{"tag":"nav","props":{"className":"life-tabbar","aria-label":"主导航"},"children":[{"tag":"a","props":{"className":"","href":"/book"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"21","height":"21","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-book-open","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M12 7v14"},"children":[]},{"tag":"path","props":{"d":"M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z"},"children":[]}]},{"tag":"span","props":{},"children":["全书"]}]},{"tag":"a","props":{"className":"","href":"/top-50"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"21","height":"21","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-star","aria-hidden":"true"},"children":[