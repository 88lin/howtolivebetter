e"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Затраты"]},{"tag":"p","props":{},"children":["Никаких расходов нет. Сложность лишь в том, что приходится каждый раз парковать велосипед в специальной зоне для зарядки внизу дома, пройдя дополнительные несколько десятков метров."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Польза"]},{"tag":"p","props":{},"children":["В указанном положении МЧС чётко прописано: «Запрещается парковать электровелосипеды или заряжать их в общественных холлах, коридорах, на лестничных клетках и у выходов из многоквартирных домов». На этих территориях парковка и зарядка категорически запрещены. Нарушителей ждут те же штрафы, что и выше."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Первоисточники"]},{"tag":"p","props":{"className":"life-citations"},"children":["应急管理部 (2021). 高层民用建筑消防安全管理规定（应急管理部令第 5 号，第三十七条、第四十七条）. ",{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/2021-08/01/content_5628815.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/zhengce/zhengceku/2021-08/01/content_5628815.htm"]},"；应急管理部 (2023). 关于政协第十三届全国委员会第五次会议第00969号提案答复的函：「2021年，全国共接报电动自行车火灾1.8万起，造成65人死亡、222人受伤，直接财产损失达2.21亿元，其中发生在建筑物内3782起，造成60人死亡、175人受伤」. ",{"tag":"a","props":{"href":"https://www.mem.gov.cn/gk/jytabljggk/zxwytadfzy/2022zx/202301/t20230119_440918.shtml","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.mem.gov.cn/gk/jytabljggk/zxwytadfzy/2022zx/202301/t20230119_440918.shtml"]},"；应急管理部 (2025). 2025年1月15日新闻发布会：「火灾起数同比下降42.2%，伤亡人数下降超过90%」. ",{"tag":"a","props":{"href":"https://www.mem.gov.cn/xw/xwfbh/2025n01y15xwfbh_6337/","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.mem.gov.cn/xw/xwfbh/2025n01y15xwfbh_6337/"]}]},{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/2021-08/01/content_5628815.htm","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Открыть источник"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Примечание автора"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["Не покупайте модифицированные аккумуляторы, не используйте зарядные устройства неизвестных марок и не оставляйте их на зарядке на всю ночь без присмотра. Как только литиевый аккумулятор загорается, он полностью охватывает пламенем всё вокруг в течение нескольких десятков секунд, одновременно выделяя чрезвычайно токсичный дым. Если пожар произойдет, когда транспортное средство припарковано в подъезде, сгорит ваш единственный путь к спасению. Согласно данным, опубликованным Министерством по чрезвычайным ситуациям, в 2021 году по всей стране произошло 18 тысяч пожаров с участием электровелосипедов, в результате чего погибло 65 человек. Из них 3782 пожаров произошли внутри зданий, что привело к 60 смертям, при этом погибшие находились почти все в помещениях. После проведения мероприятий по исправлению ситуации в 2024 году количество пожаров снизилось на 42.2% по сравнению с предыдущим годом, а число пострадавших сократилось более чем на 90%, при этом абсолютные показатели за тот год не разглашались."]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Моя заметка"]},{"tag":"button","props":{"type":"button"},"children":["Запишите напоминание…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/ru/tip/01-05"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Предыдущий"]},"Не собирайте, не покупайте и не ешьте дикие грибы; никакие «народные способы» их распознавания не работают"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/ru/tip/01-07"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Следующий"]},"Измерение давления и приём лекарств для его снижения до нормы"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["Другие советы по этой теме"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/01-02"},"children":[{"tag":"str