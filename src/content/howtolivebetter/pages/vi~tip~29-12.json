ldren":[]}]},"Lưu"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Chia sẻ mẹo này"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Ẩn chi tiết"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Chi phí"]},{"tag":"p","props":{},"children":["Không tốn tiền, chỉ là đẩy quyết định lùi, có thể vì thế bỏ lỡ một số cơ hội. Khó ở chỗ lúc đó người ta thấy cơ hội không đợi mình"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Lợi ích"]},{"tag":"p","props":{},"children":["Tránh quyết định tài sản không đảo ngược được ngay sau cú sốc, lúc phán đoán kém nhất: bán nhà, nghỉ việc, đầu tư một lần tiền trợ cấp hoặc bồi thường, vội tái hôn, bảo lãnh người khác. Quy mô thường từ hàng chục nghìn nhân dân tệ tới một căn nhà nên lợi ích xếp trung bình. Văn bản Trung Quốc cũng coi «biến cố gia đình, thất nghiệp, bỏ học» là nguy cơ khủng hoảng tâm lý cộng đồng phải chủ động rà soát; trạng thái này vốn cần người ngoài hỗ trợ. Hướng dẫn tang chế của Viện Lão hóa Quốc gia Mỹ (NIA) liệt kê «khó quyết định» là biểu hiện thường gặp, khuyên nếu có thể thì hoãn quyết định lớn đến khi khá hơn; đang đau buồn, có thể chưa nghĩ rõ thì đừng thay đổi lớn như bán nhà, nghỉ việc. Một nghiên cứu gồm ba thí nghiệm phân ngẫu nhiên một số người vào trạng thái buồn, rồi cho chọn «nhận tiền ngay» hay «sau 3 tháng». So với người bình tĩnh, người buồn sẵn lòng nhận ít hơn 13%–34% để khỏi chờ 3 tháng. Đây là nỗi buồn gây ra trong thí nghiệm, không phải tang chế thật. Năm 2023, FTC Mỹ cảnh báo kẻ giả nhà tang lễ nói gia đình không trả thêm ngay sẽ hủy tang lễ. Lời khuyên đầu tiên là chống áp lực «làm ngay», cơ sở đứng đắn sẽ cho thời gian quyết định."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Nguồn gốc"]},{"tag":"p","props":{"className":"life-citations"},"children":["国家卫生健康委等 25 部门 (2026). 健全社会心理服务体系和危机干预机制实施方案（国卫医政发〔2026〕8 号）. ",{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/202604/content_7065035.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/zhengce/zhengceku/202604/content_7065035.htm"]},"；National Institute on Aging. Coping With Grief and Loss（「Postpone major decisions if possible」一段，页面 2026-01-26 更新）. ",{"tag":"a","props":{"href":"https://www.nia.nih.gov/health/grief-and-mourning/coping-grief-and-loss","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.nia.nih.gov/health/grief-and-mourning/coping-grief-and-loss"]},"；Lerner JS, Li Y, Weber EU (2013). The financial costs of sadness. Psychological Science, 24(1), 72-79. ",{"tag":"a","props":{"href":"https://doi.org/10.1177/0956797612450302","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1177/0956797612450302"]},"；Puig A, Federal Trade Commission (2023-06-15). Imposters prey on families preparing for the funeral of a loved one. ",{"tag":"a","props":{"href":"https://consumer.ftc.gov/consumer-alerts/2023/06/imposters-prey-families-preparing-funeral-loved-one","target":"_blank","rel":"noopener noreferrer"},"children":["https://consumer.ftc.gov/consumer-alerts/2023/06/imposters-prey-families-preparing-funeral-loved-one"]}]},{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/202604/content_7065035.htm","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Liên kết mở nguồn"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Ghi chú sách"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["Không có người không liên quan lợi ích để trao đổi thì ở Trung Quốc gọi 12356 nói một lượt (điều 11 phần này), hoặc tự viết rồi ba ngày sau đọc lại. Xếp B vì hướng «hoãn» được hướng dẫn tang chế chính thức và một thử nghiệm ngẫu nhiên hỗ trợ. Nhưng chưa nghiên cứu trực tiếp so kết quả tài sản của người tang chế hoãn và không hoãn. NIA chỉ nói «đến khi khá hơn», không nêu thời gian. «Ba tháng» và «vượt thu nhập một tháng» đều là ngưỡng tác giả tự đặt. Lừa đảo người tang chế và cao tuổi xem phần 17 (đầu tư dưỡng lão, dưỡng lão bằng nhà), phần 6 (bói toán). Bẫy bảo lãnh, giấy nợ xem phần 8. Có khoản tiền phải chủ động làm, không nằm trong «hoãn»: số dư quỹ nhà ở, quyền lợi bảo hiểm xã hội, ba khoản tử vong lao động, xem phần 25 và 19."]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Ghi chú của tôi"]},{"tag":"button","props":{"type":"button"},"children":["Viết một lời nhắc cho chính bạn…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/vi/tip/29-11"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Trước"]},"Muốn có người để nói chuyện thì gọi 12356, người chưa thành niên và thanh niên gọi 12355, muốn khám bác sĩ thì đăng ký khám tâm lý ngoại trú"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/vi/tip/29-13"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Tiếp theo"]},"Đừng dùng cái chết làm cách trả nợ: bảo hiểm nhân thọ trong hai năm đầu không bồi, tai nạn lao động không công nhận, và nợ vẫn bị lấy từ tài sản thừa kế trước"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["Thêm trong chủ đề này"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/29-05"},"children":[{"tag":"strong","props":{},"children":["Trong nửa năm đầu sau khi mất bạn đời, giao việc canh bữa cơm, việc ngủ, thuốc bệnh mạn tính và lịch tái khám cho một người cố định"]},{"tag":"span","props":{},"children":["Trong nửa năm đầu sau khi mất bạn đời, xác suất tử vong cùng kỳ cao h…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/29-06"},"children":[{"tag":"strong","props":{},"children":["Không có người thân cũng không có bạn bè thì thay「người canh giữ bạn」bằng ba thứ: hàng xóm có vào được nhà bạn, danh sách thăm viếng của cộng đồng, và người liên hệ khẩn cấp trong điện thoại"]},{"tag":"span","props":{},"children":["Khi không có người thân cũng không có bạn bè, có hai việc phải lo: có…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/29-07"},"children":[{"tag":"strong","props":{},"children":["Sau khi cha mẹ qua đời, nói thật với con, để con dự lễ tang, đừng đưa con đi nơi khác để «đổi không khí»"]},{"tag":"span","props":{},"children":["Trẻ mất cha hoặc mẹ trước 18 tuổi, khi bước vào đầu tuổi trưởng thành…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/29-08"},"children":[{"tag":"strong","props":{},"children":["Nỗi buồn kéo dài quá nửa năm vẫn đứng yên, ngày nào cũng không nổi, thì đi đăng ký khoa tâm thần hoặc tâm lý lâm sà