ll":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"加入待做"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"收藏"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"分享这条建议"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"收起详情"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["成本"]},{"tag":"p","props":{"className":"life-citations"},"children":["自费，一针几十到一百多元。去社区接种门诊跑一趟。难在要挑说明书没把孕妇列为禁忌的那一款"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["收益"]},{"tag":"p","props":{"className":"life-citations"},"children":["世界卫生组织 2022 年的立场文件汇总了已有研究。孕妇得流感，住院的风险约是没怀孕的人的 7 倍（OR 6.8，95% CI 6–7.7，可信范围）。孟加拉一项试验把 340 名孕妇随机分成两组。一组打流感灭活疫苗，一组打肺炎球菌疫苗作对照，跟到孩子出生后 24 周。打流感疫苗的，孩子确诊流感 6 例，对照 16 例，疫苗效力 63%（95% CI 5–85）。母亲自己发烧加呼吸道病少 36%（95% CI 4–57）。南非两项试验用了安慰剂，医生和孕妇都不知道打的是哪一针。没感染艾滋病的孕妇里，确诊流感从 3.6% 降到 1.8%，效力 50.4%（95% CI 14.5–71.2）。她们的孩子从 3.6% 降到 1.9%，效力 48.8%（95% CI 11.6–70.4）。把 4 项试验和 3 项观察研究合起来算，孩子 6 个月内确诊流感低约 48%（95% CI 33–59）。4 项观察研究看孩子因确诊流感住院，低约 72%（95% CI 39–87）。另一篇汇总只合算两项试验，确诊流感低 34%（95% CI 15–50）。但孩子的「流感样病」没有差别，流感样病就是没化验、只看症状像流感。孕妇自己的住院看四个国家 2010 到 2016 年的病历。因确诊流感住院，打过疫苗的低约 40%（95% CI 12–59）。安全性方面，一篇汇总收了 40 项研究。打过疫苗的死胎 aOR 0.84（0.65–1.08），先天畸形 1.03（0.99–1.07）。这两项差别都在误差范围内。早产 0.87（0.78–0.96），低约 13%。美国查了 2012 到 2015 年三个流感季。流产前 28 天内打过疫苗的 aOR 0.9（0.6–1.5），没有关联。中国疾控中心 2026—2027 年度指南把孕妇列为优先接种人群。它说孕期任何阶段接种都能保护 6 月龄以下的婴儿，孕晚期效果更好。减毒活疫苗孕妇禁止接种"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["来源"]},{"tag":"p","props":{"className":"life-citations"},"children":["World Health Organization (2022). Vaccines against influenza: WHO position paper – May 2022. Weekly Epidemiological Record, 97(19), 185-208. ",{"tag":"a","props":{"href":"https://iris.who.int/server/api/core/bitstreams/420b8e49-9f16-461d-a5d8-263069778432/content","target":"_blank","rel":"noopener noreferrer"},"children":["https://iris.who.int/server/api/core/bitstreams/420b8e49-9f16-461d-a5d8-263069778432/content"]},"；Zaman K, Roy E, Arifeen SE, et al. (2008). Effectiveness of maternal influenza immunization in mothers and infants. New England Journal of Medicine, 359(15), 1555-1564. ",{"tag":"a","props":{"href":"https://doi.org/10.1056/NEJMoa0708630","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1056/NEJMoa0708630"]},"；Madhi SA, Cutland CL, Kuwanda L, et al. (2014). Influenza vaccination of pregnant women and protection of their infants. New England Journal of Medicine, 371(10), 918-931. ",{"tag":"a","props":{"href":"https://doi.org/10.1056/NEJMoa1401480","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1056/NEJMoa1401480"]},"；Nunes MC, Madhi SA (2018). Influenza vaccination during pregnancy for prevention of influenza confirmed illness in the infants: A systematic review and meta-analysis. Human Vaccines & Immunotherapeutics, 14(3), 758-766. ",{"tag":"a","props":{"href":"https://doi.org/10.1080/21645515.2017.1345385","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1080/21645515.2017.1345385"]},"；Jarvis JR, Dorey RB, Warricker FDM, Alwan NA, Jones CE (2020). The effectiveness of influenza vaccination in pregnancy in relation to child health outcomes: Systematic review and meta-analysis. Vaccine, 38(7), 1601-1613. ",{"tag":"a","props":{"href":"https://doi.org/10.1016/j.vaccine.2019.12.056","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1016/j.vaccine.2019.12.056"]},"；Thompson MG, Kwong JC, Regan AK, et al. (2019). Influenza Vaccine Effectiveness in Preventing Influenza-associated Hospitalizations During Pregnancy: A Multi-country Retrospective Test Negative Design Study, 2010-2016. Clinical Infectious Diseases, 68(9), 1444-1453. ",{"tag":"a","props":{"href":"https://doi.org/10.1093/cid/ciy737","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1093/cid/ciy737"]},"；Giles ML, Krishnaswamy S, Macartney K, Cheng A (2019). The safety of inactivated influenza vaccines in pregnancy for birth outcomes: a systematic review. Human Vaccines & Immunotherapeutics, 15(3), 687-699. ",{"tag":"a","props":{"href":"https://doi.org/10.1080/21645515.2018.1540807","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1080/21645515.2018.1540807"]},"；Donahue JG, Kieke BA, King JP, et al. (2019). Inactivated influenza vaccine and spontaneous abortion in the Vaccine Safety Datalink in 2012-13, 2013-14, and 2014-15. Vaccine, 37(44), 6673-6681. ",{"tag":"a","props":{"href":"https://doi.org/10.1016/j.vaccine.2019.09.035","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1016/j.vaccine.2019.09.035"]},"；Donahue JG, Kieke BA, King JP, et al. (2017). Association of spontaneous abortion with receipt of inactivated influenza vaccine containing H1N1pdm09 in 2010-11 and 2011-12. Vaccine, 35(40), 5314-5322. ",{"tag":"a","props":{"href":"https://doi.org/10.1016/j.vaccine.2017.06.069","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1016/j.vaccine.2017.06.069"]},"（备注里的反方研究）；中国疾病预防控制中心 (2026). 中国流感疫苗预防接种技术指南（2026—2027）. ",{"tag":"a","props":{"href":"https://www.chinacdc.cn/jkyj/mygh02/jswj2026/202609/t20260902_1839739.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.chinacdc.cn/jkyj/mygh02/jswj2026/202609/t20260902_1839739.html"]},""]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["原书备注"]},{"tag":"p","props":{"className":"life-citations"},"children":["争议。美国 2017 年一项研究发现，流产前 28 天内打过流感疫苗的人流产更多（aOR 2.0，1.1–3.6）。偏高只出在上一季也打过含甲型 H1N1 疫苗的人身上。作者自己说这证明不了因果。同一批人又查了后来三个流感季，没有再看到这个关联，所以各国仍说孕期任何阶段都能打。国内有的流感疫苗说明书还把孕妇列为禁忌。指南建议挑说明书里没把孕妇列为禁忌的那一款，打之前告诉接种医生你怀孕了。只打注射的灭活疫苗。鼻子里喷的是减毒活疫苗，国内只给 3 到 17 岁用，孕妇禁止接种。最好在当地流感季开始前打完，一般是 9 到 10 月。错过了，整个流感季里都还能补。孩子不满 6 个月不能打流感疫苗，所以孕期这一针是孩子出生后头几个月主要的保护。同住的家人和带孩子的人也是优先接种人群，成年人自己打流感疫苗的账见第 1 节第 20 条（打流感疫苗）。收益栏里没有死亡率的数字，收益量级按确诊流感和住院定，理由在核实记录里。好处落在你自己和孩子身上"]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["我的备注"]},{"tag":"button","props":{"type":"button"},"children":["写下对自己有用的提醒…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/tip/27-17"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["上一条"]},"怀孕了不用把猫送走，猫砂换别人每天铲，肉要做熟、碰土戴手套"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/tip/27-19"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["下一条"]},"怀孕 28 周以后入睡时侧着躺，左侧右侧都行，别仰面躺着睡"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["本主题的其他建议"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/27-03"},"children":[{"tag":"strong","props":{},"children":["第一次产检就把艾滋病、梅毒、乙肝三项查掉，查出来艾滋病也有免费的阻断"]},{"tag":"span","props":{},"children":["第一次产检就把艾滋病、梅毒、乙肝这三样查掉。艾滋病的初筛不用自己掏钱。真查出来也不是绝路。查出艾滋病，国家免费给治疗和咨询。查出梅毒，尽早用青霉素治。查出乙肝，…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/27-04"},"children":[{"tag":"strong","props":{},"children":["整个孕期一支烟一口酒都不要，家里人也别在屋里抽"]},{"tag":"span","props":{},"children":["孕期抽烟，孩子早产、生下来太小、唇腭裂的概率都往上走，孕期和生产时异常出血的风险翻一倍。孕妇抽烟，或者孩子出生后吸到烟，婴儿猝死的风险都更高。什么时候戒都还来得…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/27-05"},"children":[{"tag":"strong","props":{},"children":["有子痫前期高危因素的，孕 12 周后开始每天一片小剂量阿司匹林"]},{"tag":"span","props":{},"children":["子痫前期是孕期的一种高血压病。上一胎得过、怀多胎、有慢性高血压、孕前有糖尿病、有肾病或自身免疫病的人算高危。高危的人从孕 12 周起每天一片小剂量阿司匹林，子痫…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/27-06"},"children":[{"tag":"strong","props":{},"children":["孕 24 周及以后做一次妊娠期糖尿病筛查，别嫌喝糖水麻烦"]},{"tag":"span","props":{},"children":["妊娠期糖尿病就是怀孕之后才出现的血糖高。孕 24 周以后花半个上午，喝一次糖水、抽几次血，就能查出来。不查也不管，胎儿长得过大、难产、挨一刀、子痫前期和新生儿低…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/27-07"},"children":[{"tag":"strong","props":{},"children":["背下这张「立刻去医院」的清单，孕期和产后一年内都算数"]},{"tag":"span","props":{},"children":["下面任何一条出现，当天就去医院，别在家等一晚，产后一年内也算。头痛不好或越来越重、看东西变样、发烧到 38 ℃、手或脸肿得厉害。喘不上气、胸痛或心跳快、肚子剧痛…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/27-08"},"children":[{"tag":"strong","props":{},"children":["破水了就地平躺、垫高臀部、打 120，不要走动也不要洗澡"]},{"tag":"span","props":{},"children":["破水了不是慢慢收拾东西再出发。正确做法是就地躺下、把屁股垫高、打 120。站着走动，羊水流得更快，脐带可能跟着被冲下来。那是能要孩子命的急症。"]}]}]}]},{"tag":"a","props":{"className":"life-text-link","href":"/book/27"},"children":["阅读整个主题：怀孕和生产：从发现怀孕到出院办证 ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"15","height":"15","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]}]}]},{"tag":"nav","props":{"className":"life-tabbar","aria-label":"主导航"},"children":[{"tag":"a","props":{"className":"","href":"/book"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"21","height":"21","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-book-open","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M12 7v14"},"children":[]},{"tag":"path","props":{"d":"M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z"},"children":[]}]},{"tag":"span","props":{},"children":["全书"]}]},{"tag":"a","props":{"className":"","href":"/top-50"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"21","height":"21","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-star","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 2.122 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.122 2.122 0 0 0 1.597-1.16z"},"children":[]}]},{"tag":"span","props":{},"children":["精选"]}]},{"tag":"a","props":{"className":"","hre