opener noreferrer"},"children":["Bản gốc tiếng Trung"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]}]},{"tag":"section","props":{"className":"life-glossary-content","aria-label":"Hiểu rõ các con số."},"children":[{"tag":"div","props":{"className":"life-glossary-toolbar"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-glossary-count"},"children":["41"]},{"tag":"span","props":{},"children":["thuật ngữ"]}]},{"tag":"label","props":{"className":"life-glossary-search"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"18","height":"18","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-search","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m21 21-4.34-4.34"},"children":[]},{"tag":"circle","props":{"cx":"11","cy":"11","r":"8"},"children":[]}]},{"tag":"input","props":{"placeholder":"Tìm kiếm thuật ngữ hoặc định nghĩa","aria-label":"Tìm kiếm thuật ngữ hoặc định nghĩa","value":""},"children":[]}]}]},{"tag":"div","props":{"className":"life-glossary-list"},"children":[{"tag":"article","props":{"className":"life-glossary-row","id":"term-01","lang":"vi"},"children":[{"tag":"span","props":{"className":"life-glossary-number"},"children":["01"]},{"tag":"h2","props":{},"children":["Tử vong toàn nguyên"]},{"tag":"p","props":{},"children":["Tỷ lệ người trong một nhóm chết trong một khoảng thời gian, bất kể nguyên nhân. Cuốn sách dùng nó để đo người ta sống bao lâu. Tài liệu nghiên cứu gọi là all-cause mortality, viết tắt ACM"]}]},{"tag":"article","props":{"className":"life-glossary-row","id":"term-02","lang":"vi"},"children":[{"tag":"span","props":{"className":"life-glossary-number"},"children":["02"]},{"tag":"h2","props":{},"children":["HR"]},{"tag":"p","props":{},"children":["Tỷ số nguy cấp. Trong cùng khoảng thời gian, nhóm đã làm việc đó xảy ra sự kiện (chết, bệnh) nhanh hơn bao nhiêu so với nhóm không làm, chia cho nhau. HR 0.87 nghĩa là thấp hơn nhóm không làm 13%, HR 1.21 nghĩa là cao hơn 21%"]}]},{"tag":"article","props":{"className":"life-glossary-row","id":"term-03","lang":"vi"},"children":[{"tag":"span","props":{"className":"life-glossary-number"},"children":["03"]},{"tag":"h2","props":{},"children":["RR"]},{"tag":"p","props":{},"children":["Rủi ro tương đối. Tỷ lệ xác suất xảy ra một sự kiện giữa hai nhóm. Cách đọc số giống HR"]}]},{"tag":"article","props":{"className":"life-glossary-row","id":"term-04","lang":"vi"},"children":[{"tag":"span","props":{"className":"life-glossary-number"},"children":["04"]},{"tag":"h2","props":{},"children":["OR"]},{"tag":"p","props":{},"children":["Tỷ số khả năng. Cũng là so sánh hai nhóm, nhưng cách tính hơi khác RR một chút. Khi sự kiện hiếm thì nó gần RR. Khi sự kiện thường thì nó làm khoảng cách trông lớn hơn thực tế"]}]},{"tag":"article","props":{"className":"life-glossary-row","id":"term-05","lang":"vi"},"children":[{"tag":"span","props":{"className":"life-glossary-number"},"children":["05"]},{"tag":"h2","props":{},"children":["IRR"]},{"tag":"p","props":{},"children":["Tỷ số tỷ lệ mắc bệnh. Tỷ lệ mắc là phần người mới mắc bệnh trong một khoảng thời gian. Chia tỷ lệ của nhóm này cho nhóm kia. Cách đọc số giống RR"]}]},{"tag":"article","props":{"className":"life-glossary-row","id":"term-06","lang":"vi"},"children":[{"tag":"span","props":{"className":"life-glossary-number"},"children":["06"]},{"tag":"h2","props":{},"children":["RaR"]},{"tag":"p","props":{},"children":["Tỷ số tỷ lệ. Nó so số lần một việc xảy ra, ví dụ bao nhiêu lần ngã, chứ không phải bao nhiêu người có sự kiện. Cách đọc số giống RR"]}]},{"tag":"article","props":{"className":"life-glossary-row","id":"term-07","lang":"vi"},"children":[{"tag":"span","props":{"className":"life-glossary-number"},"children":["07"]},{"tag":"h2","props":{},"children":["Tỷ số tử vong chuẩn hoá"]},{"tag":"p","props":{},"children":["Viết tắt SMR. Số người trong nhóm này thật sự chết, chia cho số người cùng tuổi được kỳ vọng sẽ chết. 5.86 nghĩa là nhóm đó chết gấp 5.86 lần so với người cùng tuổi"]}]},{"tag":"article","props":{"className":"life-glossary-row","id":"term-08","lang":"vi"},"children":[{"tag":"span","props":{"className":"life-glossary-number"},"children":["08"]},{"tag":"h2","props":{},"children":["Chênh lệch rủi ro"]},{"tag":"p","props":{},"children":["Lấy xác suất xảy ra một sự kiện của nhóm này trừ nhóm kia, ra con số thường xem cứ một nghìn người thì dư ra bao nhiêu ca. Một tỷ số chỉ nói cao gấp bao nhiêu lần. Chênh lệch rủi ro nói thật là dư thêm bao nhiêu người"]}]},{"tag":"article","props":{"className":"life-glossary-row","id":"term-09","lang":"vi"},"children":[{"tag":"span","props":{"className":"life-glossary-number"},"children":["09"]},{"tag":"h2","props":{},"children":["Khoảng tin cậy 95%"]},{"tag":"p","props":{},"children":["Khoảng tin cậy 95%. Một con số từ nghiên cứu luôn kèm sai số, và đây là khoảng mà giá trị thật có thể rơi vào. Với một tỷ số thì là khoảng có qua 1. Với một con số có dấu cộng trừ thì là khoảng có qua 0. Dù thế nào thì khác biệt giữa hai nhóm cũng có thể là ngẫu nhiên, và phần nội dung khi đó sẽ ghi \"không có ý nghĩa thống kê\""]}]},{"tag":"article","props":{"className":"life-glossary-row","id":"term-10","lang":"vi"},"children":[{"tag":"span","props":{"className":"life-glossary-number"},"children":["10"]},{"tag":"h2","props":{},"children":["RCT"]},{"tag":"p","props":{},"children":["Thử nghiệm chia nhóm ngẫu nhiên có đối chứng. Người ta được chia ngẫu nhiên thành hai nhóm kiểu rút thăm, một nhóm làm việc đó, một nhóm không, rồi sau đó so kết quả. Đây là cách thuyết phục nhất để chứng minh chính việc đó đã tạo ra tác dụng"]}]},{"tag":"article","props":{"className":"life-glossary-row","id":"term-11","lang":"vi"},"children":[{"tag":"span","props":{"className":"life-glossary-number"},"children":["11"]},{"tag":"h2","props":{},"children":["Phân tích tổng hợp"]},{"tag":"p","props":{},"children":["Kết quả nhiều nghiên cứu được gộp lại và tính lại để ra một con số chung"]}]},{"tag":"article","props":{"className":"life-glossary-row","id":"term-12","lang":"vi"},"children":[{"tag":"span","props":{"className":"life-glossary-number"},"children":["12"]},{"tag":"h2","props":{},"children":["Nghiên cứu mẫu theo thời gian"]},{"tag":"p","props":{},"children":["Một nhóm lớn người được chọn ra, theo dõi nhiều năm, và ghi lại ai có sự kiện. Nó cho thấy hai thứ đi cùng nhau, nhưng không cho thấy cái thứ nhất gây ra cái thứ hai"]}]},{"tag":"article","props":{"className":"life-glossary-row","id":"term-13","lang":"vi"},"children":[{"tag":"span","props":{"className":"life-glossary-number"},"children":["13"]},{"tag":"h2","props":{},"children":["Chỉ ghi nhận và theo dõi"]},{"tag":"p","props":{},"children":["Một nghiên cứu quan sát. Người nghiên cứu chỉ ghi lại từ bên ngoài, không phân ai làm gì. Những yếu tố khác có thể kéo kết quả đi nơi khác, xem mục nhiễu và nhân quả ngược trong bảng này, nên hãy đọc số với chút thận trọng"]}]},{"tag":"article","props":{"className":"life-glossary-row","id":"term-14","lang":"vi"},"children":[{"tag":"span","props":{"className":"life-glossary-number"},"children":["14"]},{"tag":"h2","props":{},"children":["Nhiễu"]},{"tag":"p","props":{},"children":["Một yếu tố thứ ba làm thay đổi cả nguyên nhân lẫn kết quả cùng lúc, khiến hai thứ trông có liên quan nhân quả. Người ăn nhiều rau thường tập thể dục nhiều hơn, và không rõ cái nào mới là nguyên nhân"]}]},{"tag":"article","props":{"className":"life-glossary-row","id":"term-15","lang":"vi"},"children":[{"tag":"span","props":{"className":"life-glossary-number"},"children":["15"]},{"tag":"h2","props":{},"children":["Nhân quả ngược"]},{"tag":"p","props":{},"children":["Chiều nhân quả bị ngược: trông như cái thứ nhất gây ra cái thứ hai, trong khi thật ra cái thứ hai gây ra cái thứ nhất. Không phải ngủ nhiều làm bạn chết sớm. Là người bệnh nặng thì ngủ nhiều hơn"]}]},{"tag":"article","props":{"className":"life-glossary-row","id":"term-16","lang":"vi"},"children":[{"tag":"span","props":{"className":"life-glossary-number"},"children":["16"]},{"tag":"h2","props":{},"children":["d, g"]},{"tag":"p","props":{},"children":["Cỡ tác dụng, cho biết khoảng cách giữa hai nhóm lớn tới đâu. Khoảng cách đó được đổi thành số lần của mức biến động thường ngày: 0.2 tính là nhỏ, 0.5 là vừa, 0.8 là lớn"]}]},{"tag":"article","props":{"className":"life-glossary-row","id":"term-17","lang":"vi"},"children":[{"tag":"span","props":{"className":"life-glossary-number"},"children":["17"]},{"tag":"h2","props":{},"children":["r"]},{"tag":"p","props":{},"children":["Hệ số tương quan. Hai thứ đi cùng nhau sát bao nhiêu, từ -1 đến 1. 0.1 tính là yếu, 0.3 là vừa, 0.5 là mạnh"]}]},{"tag":"article","props":{"className":"life-glossary-row","id":"term-18","lang":"vi"},"children":[{"tag":"span","props":{"className":"life-glossary-number"},"children":["18"]},{"tag":"h2","props":{},"children":["MET"]},{"tag":"p","props":{},"children":["Một đơn vị cường độ vận động. Ngồi yên là 1 MET, đi bộ nhanh khoảng 3 đến 4 MET. Viết dạng MET·h thì là cường độ nhân với số giờ đã dùng, tức tổng khối lượng vận động"]}]},{"tag":"article","props":{"className":"life-glossary-row","id":"term-19","lang":"vi"},"children":[{"tag":"span","props":{"className":"life-glossary-number"},"children":["19"]},{"tag":"h2","props":{},"children":["GRADE"]},{"tag":"p","props":{},"children":["Một hệ thống chấm điểm dùng khắp thế giới, xếp một mảnh bằng chứng đáng tin tới đâu qua bốn bậc: cao, trung bình, thấp và rất thấp"]}]},{"tag":"article","props":{"className":"life-glossary-row","id":"term-20","lang":"vi"},"children":[{"tag":"span","props":{"className":"life-glossary-number"},"children":["20"]},{"tag":"h2","props":{},"children":["Ý định điều trị"]},{"tag":"p","props":{},"children":["Khi tính tác dụng, người ta tính trên nhóm được bảo đi sàng lọc, chứ không phải nhóm thật sự đã đi. Trong số người được bảo đi có người không bao giờ đi, nên cách này làm lợi ích của việc sàng lọc trông nhỏ hơn so với đối với người thật sự đi"]}]},{"tag":"article","props":{"className":"life-glossary-row","id":"term-21","lang":"vi"},"children":[{"tag":"span","props":{"className":"life-glossary-number"},"children":["21"]},{"tag":"h2","props":{},"children":["Bao năm"]},{"tag":"p","props":{},"children":["Đơn vị tính tổng lượng thuốc lá một người đã hút. Số bao mỗi ngày nhân với số năm đã hút. 30 bao năm là hút mỗi ngày một bao trong 30 năm"]}]},{"tag":"article","props":{"className":"life-glossary-row","id":"term-22","lang":"vi"},"children":[{"tag":"span","props":{"className":"life-glossary-number"},"children":["22"]},{"tag":"h2","props":{},"children":["BMI"]},{"tag":"p","props":{},"children":["Chỉ số khối cơ thể, con số thông dụng cho cân nặng so với kích thước: cân nặng tính bằng kilogram chia cho chiều cao tính bằng mét bình phương"]}]},{"tag":"article","props":{"className":"life-glossary-row","id":"term-23","lang":"vi"},"children":[{"tag":"span","props":{"className":"life-glossary-number"},"children":["23"]},{"tag":"h2","props":{},"children":["LDL"]},{"tag":"p","props":{},"children":["Mỡ máu cholesterol mật độ thấp, thường gọi là cholesterol xấu"]}]},{"tag":"article","props":{"className":"life-glossary-row","id":"term-24","lang":"vi"},"children":[{"tag":"span","props":{"className":"life-glossary-number"},"children":["24"]},{"tag":"h2","props":{},"children":["eGFR"]},{"tag":"p","props":{},"children":["Tốc độ lọc cầu thận ước tính, đo khả năng lọc của thận, tính bằng mL/phút/1.73 m². Số càng thấp thì chức năng thận càng kém, và các giai đoạn bệnh thận mãn tính được xếp theo nó"]}]},{"tag":"article","props":{"className":"life-glossary-row","id":"term-25","lang":"vi"},"children":[{"tag":"span","props":{"className":"life-glossary-number"},"children":["25"]},{"tag":"h2","props":{},"children":["HBsAg"]},{"tag":"p","props":{},"children":["Kháng nguyên bề mặt viêm gan B, một dòng trên kết quả xét nghiệm. Kết quả dương nghĩa là đã nhiễm virus viêm gan B"]}]},{"tag":"article","props":{"className":"life-glossary-row","id":"term-26","lang":"vi"},"children":[{"tag":"span","props":{"className":"life-glossary-number"},"children":["26"]},{"tag":"h2","props":{},"children":["HPV"]},{"tag":"p","props":{},"children":["Virus HPV. Nó có nhiều chủng, và nhiễm một số chủng trong thời gian dài dẫn tới ung thư cổ tử cung"]}]},{"tag":"article","props":{"className":"life-glossary-row","id":"term-27","lang":"vi"},"children":[{"tag":"span","props":{"className":"life-glossary-number"},"children":["27"]},{"tag":"h2","props":{},"children":["LDCT"]},{"tag":"p","props":{},"children":["Chụp CT phổi liều thấp. Lượng tia X khoảng một phần năm đến một phần mười của một lần chụp CT thường"]}]},{"tag":"article","props":{"className":"life-glossary-row","id":"term-28","lang":"vi"},"children":[{"tag":"span","props":{"className":"life-glossary-number"},"children":["28"]},{"tag":"h2","props":{},"children":["PM2.5"]},{"tag":"p","props":{},"children":["Hạt bụi mịn lơ lửng trong không khí, nhỏ hơn 2.5 micrô mét"]}]},{"tag":"article","props":{"className":"life-glossary-row","id":"term-29","lang":"vi"},"children":[{"tag":"span","props":{"className":"life-glossary-number"},"children":["29"]},{"tag":"h2","props":{},"children":["NOVA"]},{"tag":"p","props":{},"children":["Một cách chia thức ăn thành bốn nhóm theo mức độ chế biến. \"Thực phẩm chế biến công nghiệp\" là nhóm thứ tư"]}]},{"tag":"article","props":{"className":"life-glossary-row","id":"term-30","lang":"vi"},"children":[{"tag":"span","props":{"className":"life-glossary-number"},"children":["30"]},{"tag":"h2","props":{},"children":["LPR"]},{"tag":"p","props":{},"children":["Lãi suất gốc, mốc chuẩn của lãi suất cho vay ở Trung Quốc. Nó được công bố ngày 20 hằng tháng, và cả lãi suất vay mua nhà lẫn trần lãi trong cho vay tư nhân đều tính từ nó"]}]},{"tag":"article","props":{"className":"life-glossary-row","id":"term-31","lang":"vi"},"children":[{"tag":"span","props":{"className":"life-glossary-number"},"children":["31"]},{"tag":"h2","props":{},"children":["Phán quyết có hiệu lực cuối cùng"]},{"tag":"p","props":{},"children":["Kết quả hoà giải lao động có hiệu lực ngay, và chủ lao động không được đưa cùng việc đó ra tòa"]}]},{"tag":"article","props":{"className":"life-glossary-row","id":"term-32","lang":"vi"},"children":[{"tag":"span","props":{"className":"life-glossary-number"},"children":["32"]},{"tag":"h2","props":{},"children":["Tỷ số cưới thô, tỷ số ly dân thô"]},{"tag":"p","props":{},"children":["Số cuộc cưới và ly dân đăng ký trong năm, trên mỗi nghìn người. Còn một con số thứ ba là tỷ lệ ly dân trên cưới, bằng số ly dân chia cho số cưới trong cùng năm. Nó không phải cùng một thứ với hai cái kia, nên đừng đọc chung"]}]},{"tag":"article","props":{"className":"life-glossary-row","id":"term-33","lang":"vi"},"children":[{"tag":"span","props":{"className":"life-glossary-number"},"children":["33"]},{"tag":"h2","props":{},"children":["AED"]},{"tag":"p","props":{},"children":["Máy khử rung cấp ngoại vi tự động. Hộp cấp cứu màu đỏ hoặc màu vàng thường thấy ở nơi công cộng. Bật lên và làm theo hướng dẫn bằng giọng. Có sốc hay không là do chính máy quyết định"]}]},{"tag":"article","props":{"className":"life-glossary-row","id":"term-34","lang":"vi"},"children":[{"tag":"span","props":{"className":"life-glossary-number"},"children":["34"]},{"tag":"h2","props":{},"children":["CPR"]},{"tag":"p","props":{},"children":["Hồi sinh tim phổi. Ấn mạnh lồng ngực khi tim đã ngừng, để máu vẫn chảy"]}]},{"tag":"article","props":{"className":"life-glossary-row","id":"term-35","lang":"vi"},"children":[{"tag":"span","props":{"className":"life-glossary-number"},"children":["35"]},{"tag":"h2","props":{},"children":["Chứng nhận CCC"]},{"tag":"p","props":{},"children":["Chứng nhận bắt buộc của Trung Quốc, chứng nhận sản phẩm bắt buộc của Trung Quốc. Sản phẩm nằm trong danh sách này không được xuất kho và không được bán nếu không mang dấu này"]}]},{"tag":"article","props":{"className":"life-glossary-row","id":"term-36","lang":"vi"},"children":[{"tag":"span","props":{"className":"life-glossary-number"},"children":["36"]},{"tag":"h2","props":{},"children":["Đăng ký ICP"]},{"tag":"p","props":{},"children":["Thủ tục đăng ký mà một trang web hay ứng dụng phải hoàn tất trong hệ thống của Bộ Công nghiệp và Thông tin trước khi đưa lên mạng"]}]},{"tag":"article","props":{"className":"life-glossary-row","id":"term-37","lang":"vi"},"children":[{"tag":"span","props":{"className":"life-glossary-number"},"children":["37"]},{"tag":"h2","props":{},"children":["Phân loại bảo vệ"]},{"tag":"p","props":{},"children":["Hệ thống phân loại bảo vệ an ninh mạng. Một hệ thống được xếp vào một trong nhiều cấp tuỳ mức độ quan trọng, và cấp càng cao thì càng phải có nhiều biện pháp bảo mật"]}]},{"tag":"article","props":{"className":"life-glossary-row","id":"term-38","lang":"vi"},"children":[{"tag":"span","props":{"className":"life-glossary-number"},"children":["38"]},{"tag":"h2","props":{},"children":["GPL"]},{"tag":"p","props":{},"children":["Giấy phép nguồn mở. Sản phẩm làm bằng mã loại này thì khi phát hành thường cũng phải công bố mã nguồn của chính nó"]}]},{"tag":"article","props":{"className":"life-glossary-row","id":"term-39","lang":"vi"},"children":[{"tag":"span","props":{"className":"life-glossary-number"},"children":["39"]},{"tag":"h2","props":{},"children":["Điều khoản không cạnh tranh"]},{"tag":"p","props":{},"children":["Thỏa thuận ký với chủ lao động: trong một khoảng thời gian sau khi bạn nghỉ việc, bạn không đi làm cho đối thủ. Trong khoảng thời gian đó chủ lao động phải trả lương cho bạn hằng tháng, tối đa 2 năm"]}]},{"tag":"article","props":{"className":"life-glossary-row","id":"term-40","lang":"vi"},"children":[{"tag":"span","props":{"className":"life-glossary-number"},"children":["40"]},{"tag":"h2","props":{},"children":["Vốn góp"]},{"tag":"p","props":{},"children":["Số tiền bạn cam kết góp khi đăng ký công ty. Đã cam kết rồi thì phải góp đủ trong thời hạn luật quy định. Đó không phải một con số viết ra cho đẹp"]}]},{"tag":"article","props":{"className":"life-glossary-row","id":"term-41","lang":"vi"},"children":[{"tag":"span","props":{"className":"life-glossary-number"},"children":["41"]},{"tag":"h2","props":{},"children":["Tiền cọc và tiền đặt cọc"]},{"tag":"p","props":{},"children":["Hai từ chỉ khác nhau một chữ, mà khác biệt về tác dụng thì lớn. 订金 là tiền trả trước, ai đổi ý thì không mất gì. 定金 kèm điều khoản phạt: bên đã nhận tiền phải trả gấp đôi nếu đổi ý, tối đa 20% giá trị hợp đồng"]}]}]}]}]},{"tag":"nav","props":{"className":"life-tabbar","aria-label":"Điều hướng chính"},"children":[{"tag":"a","props":{"className":"","href":"/vi/book"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"21","height":"21","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-book-open","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M12 7v14"},"children":[]},{"tag":"path","props":{"d":"M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z"},"children":[]}]},{"tag":"span","props":{},"children":["Sách"]}]},{"tag":"a","props":{"className":"","href":"/vi/top-50"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"21","height":"21","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-star","aria-hidden":"true"},"children":[{