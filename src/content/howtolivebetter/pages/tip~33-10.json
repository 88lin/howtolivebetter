t":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"收起详情"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["成本"]},{"tag":"p","props":{"className":"life-citations"},"children":["不花钱。面试时多说一句话。难在开口。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["收益"]},{"tag":"p","props":{"className":"life-citations"},"children":["《残疾人就业条例》第八条：「用人单位安排残疾人就业的比例不得低于本单位在职职工总数的1.5%。具体比例由省、自治区、直辖市人民政府根据本地区的实际情况规定。」第九条：达不到所在地省级人民政府规定比例的，应当缴纳残疾人就业保障金。《残疾人就业保障金征收使用管理办法》第八条给了公式：「保障金年缴纳额=（上年用人单位在职职工人数×所在地省、自治区、直辖市人民政府规定的安排残疾人就业比例-上年用人单位实际安排的残疾人就业人数）×上年用人单位在职职工年平均工资」。第十六条：自工商登记注册之日起 3 年内，对安排残疾人就业未达到规定比例、在职职工总数 20 人以下（含 20 人）的小微企业，免征保障金。《残疾人保障法》第三十六条规定，国家对安排残疾人就业达到、超过规定比例或者集中安排残疾人就业的用人单位，依法给予税收优惠（全国，残疾人就业条例 2007 年 5 月 1 日起施行）"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["来源"]},{"tag":"p","props":{"className":"life-citations"},"children":["国务院 (2007). 残疾人就业条例（第八条、第九条）. ",{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/2008-03/28/content_6646.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/zhengce/zhengceku/2008-03/28/content_6646.htm"]},"；财政部、国家税务总局、中国残联 (2015). 残疾人就业保障金征收使用管理办法（财税〔2015〕72 号，第六条、第八条、第十六条）. ",{"tag":"a","props":{"href":"http://www.gov.cn/zhengce/zhengceku/2015-09/15/content_5650063.htm","target":"_blank","rel":"noopener noreferrer"},"children":["http://www.gov.cn/zhengce/zhengceku/2015-09/15/content_5650063.htm"]},"；中华人民共和国残疾人保障法（第三十六条）. ",{"tag":"a","props":{"href":"https://flk.npc.gov.cn/detail?id=ff8080816f135f46016f1d134c88132b","target":"_blank","rel":"noopener noreferrer"},"children":["https://flk.npc.gov.cn/detail?id=ff8080816f135f46016f1d134c88132b"]},""]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["原书备注"]},{"tag":"p","props":{"className":"life-citations"},"children":["对刚注册三年内、20 人以下的小微企业，这个理由不成立，别指望。保障金的减免政策这些年一直在调，具体以当年财政部的公告为准。另外，按比例就业要求的是真实用工。挂名领工资、让单位拿你去抵保障金，是骗取行为，你也会被牵进去。就业困难人员认定和社保补贴见第 7 节第 12 条（就业困难人员）。职业培训补贴见第 7 节第 13 条（职业培训补贴）。这条的受益人是你自己。"]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["我的备注"]},{"tag":"button","props":{"type":"button"},"children":["写下对自己有用的提醒…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/tip/33-09"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["上一条"]},"家里的坡道、扶手和浴室改造，可以向县级以上政府申请补贴"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/tip/33-11"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["下一条"]},"残疾人的个人所得税可以减征，减多少打电话问省税务局"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16