,{"tag":"path","props":{"d":"M20 12h2"},"children":[]},{"tag":"path","props":{"d":"m6.34 17.66-1.41 1.41"},"children":[]},{"tag":"path","props":{"d":"m19.07 4.93-1.41 1.41"},"children":[]}]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"17","height":"17","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-moon life-theme-icon-dark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"},"children":[]}]}]},{"tag":"button","props":{"type":"button","className":"life-language-switch","aria-label":"Русский Выбрать язык","aria-haspopup":"menu","aria-expanded":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-globe","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]},{"tag":"path","props":{"d":"M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"},"children":[]},{"tag":"path","props":{"d":"M2 12h20"},"children":[]}]},{"tag":"span","props":{},"children":["Русский"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]}]},{"tag":"a","props":{"className":"life-account","href":"/ru/sign-in"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"17","height":"17","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle-user-round","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M18 20a6 6 0 0 0-12 0"},"children":[]},{"tag":"circle","props":{"cx":"12","cy":"10","r":"4"},"children":[]},{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},{"tag":"span","props":{},"children":["Войти"]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/ru/book/33"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"К содержанию"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["Как жить после инвалидности"]},{"tag":"nav","props":{"aria-label":"Советы главы"},"children":[{"tag":"a","props":{"href":"/ru/tip/33-01"},"children":[{"tag":"span","props":{},"children":["01"]},"Внезапная сильная головная боль и потоотделение после травмы спинного мозга: сначала помогите пострадавшему сесть прямо, ослабьте одежду и вызовите скорую помощь"]},{"tag":"a","props":{"href":"/ru/tip/33-02"},"children":[{"tag":"span","props":{},"children":["02"]},"Первые десять лет после инвалидизации — период высокого риска суицида; это нельзя списывать на «просто нужно настроиться на позитивный лад»"]},{"tag":"a","props":{"href":"/ru/tip/33-03"},"children":[{"tag":"span","props":{},"children":["03"]},"Госпитализация при психических расстройствах основывается на добровольном согласии; существуют лишь два исключения, когда допускается госпитализация без согласия пациента"]},{"tag":"a","props":{"href":"/ru/tip/33-04"},"children":[{"tag":"span","props":{},"children":["04"]},"За тем, кто долгое время ухаживает за инвалидом в семье, нужно присматривать и за собственным здоровьем"]},{"tag":"a","props":{"href":"/ru/tip/33-05"},"children":[{"tag":"span","props":{},"children":["05"]},"Для людей, которые долгое время пользуются инвалидной коляской, стоит заменить сиденье на специальное противопролежневое и каждый день проверять состояние седалищной и копчиковой костей"]},{"tag":"a","props":{"href":"/ru/tip/33-06"},"children":[{"tag":"span","props":{},"children":["06"]},"Не покупайте методы лечения и приборы, которые «излечивают паралич, слепоту и глухоту»"]},{"tag":"a","props":{"href":"/ru/tip/33-07"},"children":[{"tag":"span","props":{},"children":["07"]},"После получения удостоверения инвалида сходите в органы гражданской администрации на уровне уезда и уточните сразу все доступные льготы"]},{"tag":"a","props":{"href":"/ru/tip/33-08"},"children":[{"tag":"span","props":{},"children":["08"]},"Для детей младше 7 лет с инвалидностью или аутизмом необходимо обратиться в органы гражданской администрации на уровне уезда для получения помощи по реабилитации"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/ru/tip/33-09","data-status":"active"},"children":[{"tag":"span","props":{},"children":["09"]},"За модернизацию пандусов, поручней и ванных комнат в доме можно подать заявку на субсидию в органы гражданской администрации на уровне уезда и выше"]},{"tag":"a","props":{"href":"/ru/tip/33-10"},"children":[{"tag":"span","props":{},"children":["10"]},"При трудоустройстве стоит самостоятельно упомянуть о наличии удостоверения инвалида — это позволит работодателю сэкономить деньги"]},{"tag":"a","props":{"href":"/ru/tip/33-11"},"children":[{"tag":"span","props":{},"children":["11"]},"Налог на доходы физических лиц для людей с инвалидностью может быть уменьшен; сколько именно — уточните по телефону в налоговой службе вашего региона"]},{"tag":"a","props":{"href":"/ru/tip/33-12"},"children":[{"tag":"span","props":{},"children":["12"]},"Собак-поводырей можно приводить в общественные места и на общественный транспорт; слепые люди могут бесплатно ездить на городском общественном транспорте"]},{"tag":"a","props":{"href":"/ru/tip/33-13"},"children":[{"tag":"span","props":{},"children":["13"]},"Лица с инвалидностью, сдающие вступительные экзамены, могут получить необходимые удобства; при использовании шрифта Брайля время экзамена увеличивается на 50%"]},{"tag":"a","props":{"href":"/ru/tip/33-14"},"children":[{"tag":"span","props":{},"children":["14"]},"Органы гражданской администрации не вправе отказывать в зачислении детям с инвалидностью; для тех, кто не может посещать школу, местные органы образования организуют обучение на дому"]},{"tag":"a","props":{"href":"/ru/tip/33-15"},"children":[{"tag":"span","props":{},"children":["15"]},"Люди без правой или обеих нижних конечностей тоже могут получить водительские права категории C5"]},{"tag":"a","props":{"href":"/ru/tip/33-16"},"children":[{"tag":"span","props":{},"children":["16"]},"Реабилитацию следует проходить в специализированных учреждениях, где есть отделение реабилитологии; интенсивность занятий определяет врач-реабилитолог, и она не обязательно должна быть максимальной"]},{"tag":"a","props":{"href":"/ru/tip/33-17"},"children":[{"tag":"span","props":{},"children":["17"]},"Снижение слуха — повод подобрать слуховой аппарат. Его назначают ради того, чтобы слышать, а не для профилактики слабоумия"]},{"tag":"a","props":{"href":"/ru/tip/33-18"},"children":[{"tag":"span","props":{},"children":["18"]},"Если говорят, что взрослый человек «не может самостоятельно распоряжаться своими делами», для этого нужно подать в суд заявление о признании его недееспособным или ограниченно дееспособным; мнение родственников здесь не имеет значения"]},{"tag":"a","props":{"href":"/ru/tip/33-19"},"children":[{"tag":"span","props":{},"children":["19"]},"Порядок назначения опекунов для совершеннолетних определяется законом; если подопечный причинил вред другим, ответственность несет опекун"]},{"tag":"a","props":{"href":"/ru/tip/33-20"},"children":[{"tag":"span","props":{},"children":["20"]},"Если вас не взяли на работу, не перевели на постоянную ставку или урезали зарплату из‑за инвалидности, вы можете подать в суд, но сначала рассчитайте все связанные расходы"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"Навигация"},"children":[{"tag":"a","props":{"href":"/ru/book"},"children":["Книга"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/ru/book/33"},"children":["Глава 33"," ·"," ","Как жить после инвалидности"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"33-09"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["09"]},{"tag":"span","props":{"className":"life-evidence grade-b"},"children":["Доказательства"," ","B"]}]},{"tag":"h1","props":{"lang":"ru"},"children":["За модернизацию пандусов, поручней и ванных комнат в доме можно подать заявку на субсидию в органы гражданской администрации на уровне уезда и выше"]},{"tag":"p","props":{"lang":"ru","className":"life-entry-summary"},"children":["В «Законе о создании безбарьерной среды» указано: органы гражданской администрации на уровне уезда и выше обязаны поддерживать и направлять модернизацию безбарьерных элементов в домах, а семьям инвалидов и пожилых людей, соответствующим требованиям, полагаются соответствующие субсидии. Обычно такие проекты курирует союз инвалидов, и лимиты на финансирование устанавливаются ежегодно, поэтому регистрироваться следует как можно раньше. Размер субсидии и перечень работ определяются в каждом регионе индивидуально."]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Затраты"]},{"tag":"p","props":{},"children":["Подача заявки не требует затрат. В большинстве случаев на…"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Польза"]},{"tag":"p","props":{},"children":["Статья 19 «Закона о создании безбарьерной среды» гласит: «Органы гражданской администрации на уровне уезда и в…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"Отметить: За модернизацию пандусов, поручней и ванных комнат в доме можно подать заявку на субсидию в органы гражданской администрации на уровне уезда и выше"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"Сделано"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"В планах"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"В избранное"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Поделиться советом"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Скрыть подробности"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Затраты"]},{"tag":"p","props":{},"children":["Подача заявки не требует затрат. В большинстве случаев на саму модернизацию предусмотрены субсидии, но вам, возможно, придётся доплатить часть суммы. Понадобится обратиться в союз инвалидов и в местную администрацию."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Польза"]},{"tag":"p","props":{},"children":["Статья 19 «Закона о создании безбарьерной среды» гласит: «Органы гражданской администрации на уровне уезда и выше обязаны поддерживать и направлять модернизацию безбарьерных элементов в домах. Семьям инвалидов и пожилых людей, соответствующим требованиям, полагаются соответствующие субсидии». В статье 18 указано, что в отношении уже существующих жилых домов, жилых комплексов, общественных зданий, мест общественного пользования, транспортных объектов и городских/сельских дорог, не соответствующих нормам проектирования безбарьерной среды, органы гражданской администрации на уровне уезда и выше обязаны разработать и реализовать целевые планы модернизации. Статья 62 предусматривает, что любые организации и граждане вправе направлять в компетентные органы предложения по улучшению безбарьерной среды, а также жалобы и сообщения о нарушениях закона; такие органы обязаны «незамедлительно рассмотреть обращение и дать ответ». В статье 63 указано, что в случае нарушений, ущемляющих общественные интересы, прокуратура вправе выдать рекомендации или инициировать публичный иск (закон вступил в силу 1 сентября 2023 года на всей территории страны)."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Первоисточники"]},{"tag":"p","props":{"className":"life-citations"},"children":["中华人民共和国无障碍环境建设法（第十八条、第十九条、第六十二条、第六十三条）. ",{"tag":"a","props":{"href":"https://flk.npc.gov.cn/detail?id=ff80818188d7430b0189018493370940","target":"_blank","rel":"noopener noreferrer"},"children":["https://flk.npc.gov.cn/detail?id=ff80818188d7430b0189018493370940"]}]},{"tag":"a","props":{"href":"https://flk.npc.gov.cn/detail?id=ff80818188d7430b0189018493370940","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Открыть источник"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Примечание автора"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["Уровень B выбран, поскольку в законе лишь говорится о «предоставлении соответствующих субсидий», а конкретные суммы и критерии соответствия оставлены на усмотрение регионов, без единого общенационального показателя. Сначала рекомендуется проверить на официальном сайте союза инвалидов местность «Модернизация безбарьерной среды в домах семей с тяжелой формой инвалидности». Лимиты на финансирование обычно распределяются ежегодно, поэтому регистрироваться следует заранее. Установка лифтов в жилых комплексах и модернизация лестничных клеток регулируются отдельно, через органы строительства. Если безбарьерные элементы в общественных местах не соответствуют нормам, можно подать жалобу в компетентные органы согласно статье 62, и они обязаны дать ответ."]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Моя заметка"]},{"tag":"button","props":{"type":"button"},"children":["Запишите напоминание…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/ru/tip/33-08"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Предыдущий"]},"Для детей младше 7 лет с инвалидностью или аутизмом необходимо обратиться в органы гражданской администрации на уровне уезда для получения помощи по реабилитации"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/ru/tip/33-10"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Следующий"]},"При трудоустройстве стоит самостоятельно упомянуть о наличии удостоверения инвалида — это позволит работодателю сэкономить деньги"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["Другие советы по этой теме"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/33-05"},"children":[{"tag":"strong","props":{},"children":["Для людей, которые долгое время