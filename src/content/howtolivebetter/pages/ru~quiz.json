ать исходный пункт",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]}]}]}]},{"tag":"section","props":{"aria-labelledby":"quiz-scoring-title"},"children":[{"tag":"h2","props":{"id":"quiz-scoring-title"},"children":["Разберите решения, из которых сложился результат"]},{"tag":"p","props":{"className":"quiz-guide-lead"},"children":["20 вопросов по пять баллов. За ошибку баллы не снимаются, максимум — 100. Результат показывает число правильных ответов в каждой теме и помогает выбрать дальнейшее чтение."]},{"tag":"div","props":{"className":"quiz-level-grid"},"children":[{"tag":"article","props":{},"children":[{"tag":"span","props":{},"children":["90–100 баллов"]},{"tag":"h3","props":{},"children":["Зоркий наблюдатель"]},{"tag":"p","props":{},"children":["Большинство решений верны. Проверьте условия в оставшихся ошибках."]}]},{"tag":"article","props":{},"children":[{"tag":"span","props":{},"children":["70–85 баллов"]},{"tag":"h3","props":{},"children":["Вдумчивый участник"]},{"tag":"p","props":{},"children":["Хорошая основа. Начните с темы, где меньше правильных ответов."]}]},{"tag":"article","props":{},"children":[{"tag":"span","props":{},"children":["50–65 баллов"]},{"tag":"h3","props":{},"children":["Есть слепые зоны"]},{"tag":"p","props":{},"children":["Есть привычные заблуждения. Сопоставьте свои доводы с объяснениями."]}]},{"tag":"article","props":{},"children":[{"tag":"span","props":{},"children":["0–45 баллов"]},{"tag":"h3","props":{},"children":["Впереди новые знания"]},{"tag":"p","props":{},"children":["Выберите одну ошибку и разберитесь в совете перед практикой."]}]}]},{"tag":"p","props":{"className":"quiz-fine"}