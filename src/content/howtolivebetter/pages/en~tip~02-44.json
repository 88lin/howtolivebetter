{"path":"/en/tip/02-44","title":"If you already wanted a dog, count the daily walk toward your steps — don’t get a dog just for longevity | HowToLiveBetter","description":"Dog owners are on average about a quarter less likely to die over the same period, and those who keep a dog after a heart attack or stroke do even be…","lang":"en","styles":["/sites/howtolivebetter/styles/bca54bebe9c1bd3b.css"],"bodyClass":"font-sans antialiased","nodes":[{"tag":"div","props":{"className":"life-site"},"children":[{"tag":"div","props":{"className":"life-header-slot","aria-hidden":"true"},"children":[]},{"tag":"header","props":{"className":"life-header"},"children":[{"tag":"div","props":{"className":"life-header-inner"},"children":[{"tag":"a","props":{"className":"life-brand","aria-label":"H ✳ HowToLiveBetter home","href":"/en"},"children":[{"tag":"span","props":{"className":"life-brand-mark","aria-hidden":"true"},"children":["H",{"tag":"span","props":{},"children":["✳"]}]},{"tag":"span","props":{},"children":["HowToLive",{"tag":"span","props":{},"children":["Better"]}]}]},{"tag":"nav","props":{"className":"life-nav","aria-label":"Main navigation"},"children":[{"tag":"a","props":{"className":"life-nav-link","href":"/en/book"},"children":[{"tag":"span","props":{},"children":["Explore the book"]}]},{"tag":"a","props":{"className":"life-nav-link","href":"/en/top-50"},"children":[{"tag":"span","props":{},"children":["Top 50"]}]},{"tag":"a","props":{"className":"life-nav-link","href":"/en/daily"},"children":[{"tag":"span","props":{},"children":["Daily task"]}]},{"tag":"a","props":{"className":"life-nav-link","href":"/en/dashboard"},"children":[{"tag":"span","props":{},"children":["My checklist"]}]},{"tag":"button","props":{"type":"button","className":"life-nav-link life-nav-more","aria-haspopup":"menu","aria-expanded":"false"},"children":[{"tag":"span","props":{},"children":["More"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"15","height":"15","viewBox":"0 0 24 2