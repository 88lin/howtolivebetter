n","props":{},"children":["08"]},"障害者手帳を所持している方は、障害者向け2つの補助金を申請する"]},{"tag":"a","props":{"href":"/ja/tip/07-09"},"children":[{"tag":"span","props":{},"children":["09"]},"住民医療保険の年間 400 元の支払いを中断させないこと。困難世帯は免除・減額が可能"]},{"tag":"a","props":{"href":"/ja/tip/07-10"},"children":[{"tag":"span","props":{},"children":["10"]},"重病になったら、まず医療保険、大病保険、医療扶助、そして他地域での受診登録を行い、ネットローンには手を出さないこと"]},{"tag":"a","props":{"href":"/ja/tip/07-11"},"children":[{"tag":"span","props":{},"children":["11"]},"身分証を紛失したらすぐに再発行手続きを、急ぎの場合は臨時身分証を先に受け取る"]},{"tag":"a","props":{"href":"/ja/tip/07-12"},"children":[{"tag":"span","props":{},"children":["12"]},"失業登録後、就労困難者認定を目指し、社会保険補助金または公益的雇用枠を獲得する"]},{"tag":"a","props":{"href":"/ja/tip/07-13"},"children":[{"tag":"span","props":{},"children":["13"]},"失業期間に職業訓練手当、就業インターン手当、社会保険補助を申請しましょう。自費で講習に通わないでください"]},{"tag":"a","props":{"href":"/ja/tip/07-14"},"children":[{"tag":"span","props":{},"children":["14"]},"就職活動は履歴書を送るだけでは不十分です。システム的な方法を使いましょう：スキルを学び、目標を定め、周囲の助けを借りる"]},{"tag":"a","props":{"href":"/ja/tip/07-15"},"children":[{"tag":"span","props":{},"children":["15"]},"保証金を取られない、身分証を預けない、「訓練ローン」に手を出さない、マルチ商法に入らない、高利貸しから借りない"]},{"tag":"a","props":{"href":"/ja/tip/07-16"},"children":[{"tag":"span","props":{},"children":["16"]},"住居に困っているなら、公営賃貸住宅（公租房）の優先枠を"]},{"tag":"a","props":{"href":"/ja/tip/07-17"},"children":[{"tag":"span","props":{},"children":["17"]},"住居費と食費を最小限に抑える：シェアハウスの月極利用で日極利用を代替、自炊と食堂利用でデリバリーを代替"]},{"tag":"a","props":{"href":"/ja/tip/07-18"},"children":[{"tag":"span","props":{},"children":["18"]},"社会保険の未加入（断缴）に慌てない：年金は累計で計算、医療保険はルールに従って追加入金"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/ja/tip/07-19","data-status":"active"},"children":[{"tag":"span","props":{},"children":["19"]},"服役、破産、信用ブラックリストへの登録など、法律上はやり直す道があります。まずは手続きを完了させましょう"]},{"tag":"a","props":{"href":"/ja/tip/07-20"},"children":[{"tag":"span","props":{},"children":["20"]},"重病に備え、基本医療保険に加えて1年更新の医療保険または重大疾病保険を検討する際は、「継続保証」の4文字を必ず確認すること"]},{"tag":"a","props":{"href":"/ja/tip/07-21"},"children":[{"tag":"span","props":{},"children":["21"]},"本当に寝る場所がない場合、24 時間だけ利用できる場所はあくまで緊急避難用です。まずは救助所を優先してください"]},{"tag":"a","props":{"href":"/ja/tip/07-22"},"children":[{"tag":"span","props":{},"children":["22"]},"賃金未払いの際は、まず雇い主が誰かを確認すること：無免許の作業場や請負業者（工頭）に対しても労働監察を請求可能、家庭や個人向けの私的な仕事の場合のみ裁判所へ"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"現在地"},"children":[{"tag":"a","props":{"href":"/ja/book"},"children":["本を読む"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/ja/book/07"},"children":["第7章"," ·"," ","お金がない時をどう生き抜くか"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"07-19"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["19"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["エビデンス"," ","A"]}]},{"tag":"h1","props":{"lang":"ja"},"children":["服役、破産、信用ブラックリストへの登録など、法律上はやり直す道があります。まずは手続きを完了させましょう"]},{"tag":"p","props":{"lang":"ja","className":"life-entry-summary"},"children":["刑期を終えて出所した者は、就業、就学、社会保障において差別されてはならず、生活が困難な場合は政府による定住・就労支援の対象となる。犯罪時に 18 歳未満で、かつ 5 年以下の判決を受けた場合は、犯罪歴は封印され、兵役への志願や就職の際に報告する必要はない。信用失墜者リスト（失信名簿）の期間は 2 年であり、債務を完済した後は、裁判所は 3 営業日以内にリストから削除しなければならない。成人の前科は封印されないため、兵役や就職の際には事実をありのままに報告しなければならない。"]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["費用・手間"]},{"tag":"p","props":{},"children":["手数料はかかりません。刑期を終えて出所した場合は、戸籍地または居住地の司法所や街路事務所へ出頭し、安置・教育（政府に…"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["効果"]},{"tag":"p","props":{},"children":["刑期を終えて出所した者は、法律に基づき他の市民と平等な権利を有し、雇用、就学、および社会保障の享受において差別を受けない。"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"記録する：服役、破産、信用ブラックリストへの登録など、法律上はやり直す道があります。まずは手続きを完了させましょう"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"できている"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"やることに追加"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"お気に入り"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"このヒントを共有"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"詳細を閉じる"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["費用・手間"]},{"tag":"p","props":{},"children":["手数料はかかりません。刑期を終えて出所した場合は、戸籍地または居住地の司法所や街路事務所へ出頭し、安置・教育（政府による配置および扶助）を申請してください。失信被執行人（債務不履行者）リストに掲載されている場合は、未払いの債務をすべて完済した上で、執行裁判所に名前の削除を申請してください。深圳で 3 年以上の社会保険に加入している個人は、個人破産を申請できます。各ステップにおいて書類の準備や面談への対応が必要であり、さらに 1 から 3 年の考察期間があります。困難な点は、過去の出来事を何度も繰り返し説明しなければならないこと、そして考察期間を耐え忍ばなければならないことです。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["効果"]},{"tag":"p","props":{},"children":["刑期を終えて出所した者は、法律に基づき他の市民と平等な権利を有し、雇用、就学、および社会保障の享受において差別を受けない。生活が困難な場合は、戸籍地または居住地の政府により、配置の支援や法律に基づく救済・扶助が行われる（刑務所法 2026 年改正、11 月 1 日より施行）。中央政府の 2010 年の文書では、彼らに対する職業訓練の強化、条件を満たす場合の低所得者扶助（低保）への組み入れ、および移行期安置施設の設立を求めている。犯罪時に 18 歳未満であり、かつ刑期が 5 年未満である場合、犯罪歴は封印され、兵役への志願や求職の際に報告する必要はない。本人が犯罪経歴証明書を申請した場合は、3 営業日以内に発行される。信用失墜者リスト（失信名簿）への掲載期間は 2 年である。債務を完済した、あるいは相手方と和解に至ったなどの場合には、裁判所は 3 営業日以内に氏名を削除しなければならない。深圳経済特区個人破産条例は、現在唯一の個人破産に関する法規です。破産宣告後、3 年の試行期間を無事に経過すれば、未払いの債務を免除することができます。法人が期限内の債務を返済できず、負債が資産を上回っている場合（債務超過）、更生、和解、または破産清算を申請することができ、債務はこの企業と共に清算されます（全国規模の制度ですが、個人破産は深圳のみ適用されます）"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["出典"]},{"tag":"p","props":{"className":"life-citations"},"children":["全国人大常委会 (2026). 监狱法（2026 年修订，第五十九、六十、六十二条）. ",{"tag":"a","props":{"href":"https://www.spp.gov.cn/spp/fl/202604/t20260430_726746.shtml","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.spp.gov.cn/spp/fl/202604/t20260430_726746.shtml"]},"；中共中央办公厅、国务院办公厅 (2010). 转发《中央社会治安综合治理委员会关于进一步加强刑满释放解除劳教人员安置帮教工作的意见》的通知（中办发〔2010〕5 号）. ",{"tag":"a","props":{"href":"http://www.hnziyang.gov.cn/jc_zy/63/84/content_19460.html","target":"_blank","rel":"noopener noreferrer"},"children":["http://www.hnziyang.gov.cn/jc_zy/63/84/content_19460.html"]},"（益阳市资阳区政府转载）；全国人大常委会 (2018). 刑事诉讼法（2018 年修正，第二百八十六条）. ",{"tag":"a","props":{"href":"https://www.spp.gov.cn/zdgz/201810/t20181027_396818.shtml","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.spp.gov.cn/zdgz/201810/t20181027_396818.shtml"]},"；最高人民法院、最高人民检察院、公安部、司法部 (2022). 关于未成年人犯罪记录封存的实施办法（第九、十五条）. ",{"tag":"a","props":{"href":"https://gat.hunan.gov.cn/gat/jwgk/zfxxgk/xxgkml/zcfgjjd/zcfg/202205/t20220531_24795836.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://gat.hunan.gov.cn/gat/jwgk/zfxxgk/xxgkml/zcfgjjd/zcfg/202205/t20220531_24795836.html"]},"（湖南省公安厅转载）；最高人民法院 (2017 修正). 关于公布失信被执行人名单信息的若干规定（第二、十条）. ",{"tag":"a","props":{"href":"https://www.court.gov.cn/fabu/xiangqing/37182.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.court.gov.cn/fabu/xiangqing/37182.html"]},"；深圳市人大常委会 (2020). 深圳经济特区个人破产条例（第二、二十三、九十五、九十七、一百零三条）. ",{"tag":"a","props":{"href":"https://sf.sz.gov.cn/xxgk/xxgkml/zcfg/content/post_8586018.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://sf.sz.gov.cn/xxgk/xxgkml/zcfg/content/post_8586018.html"]},"；全国人大常委会 (2006). 企业破产法（主席令第五十四号，第二、七条）. ",{"tag":"a","props":{"href":"http://www.gov.cn/gongbao/content/2006/content_413952.htm","target":"_blank","rel":"noopener noreferrer"},"children":["http://www.gov.cn/gongbao/content/2006/content_413952.htm"]}]},{"tag":"a","props":{"href":"https://www.spp.gov.cn/spp/fl/202604/t20260430_726746.shtml","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["出典を開く"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["著者の注記"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["成人の犯罪歴は抹消されません。刑法第100条では、兵役への志願や就職の際、刑事罰を受けた事実をありのままに報告することを義務付けています。公務員、裁判官、弁護士、教師などの職業については、別途、政治審査に関する法的制限があります。2026年11月1日以前の刑務法現行テキストは、第37条および第38条に対応しますが、条文番号は効力発生後のテキストに従います。中办发〔2010〕5号の原文は中央政府網では見つからず、区政府の転載に基づいています。個人破産における審査期間中は、飛行機のファーストクラスの利用、高額な消費、不動産の購入は禁止されています。故意に他人の身体を侵害して生じた賠償金など、8種類の債務は免責の対象外です。また、詐欺によって得た免責は、取り消される可能性があります。失信リストから削除されたことは、信用記録（征信記録）が綺麗になったことを意味するわけではありません。これらは二つの異なるシステムです。"]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["自分のメモ"]},{"tag":"button","props":{"type":"button"},"children":["自分へのメモを書く…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/ja/tip/07-18"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["前へ"]},"社会保険の未加入（断缴）に慌てない：年金は累計で計算、医療保険はルールに従って追加入金"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/ja/tip/07-20"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["次へ"]},"重病に備え、基本医療保険に加えて1年更新の医療保険または重大疾病保険を検討する際は、「継続保証」の4文字を必ず確認すること"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["このテーマの他の提案"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/07-14"},"children":[{"tag":"strong","props":{},"children":["就職活動は履歴書を送るだけでは不十分です。システム的な方法を使いましょう：スキルを学び、目標を定め