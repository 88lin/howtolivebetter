ck-active":"false","style":{"top":"94px"}},"children":[{"tag":"div","props":{"className":"life-ad-dock","hidden":true},"children":[{"tag":"aside","props":{"className":"life-ad-space life-ad-space-sponsored life-ad-space-compact","data-ad-placement":"ad_dock","data-ad-group":"reading","data-ad-creative":"read_product","data-ad-ready":"false","aria-label":"Реклама · Рекомендация сообщества"},"children":[{"tag":"button","props":{"type":"button","className":"life-ad-dismiss","aria-label":"Закрыть рекламу"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-x","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M18 6 6 18"},"children":[]},{"tag":"path","props":{"d":"m6 6 12 12"},"children":[]}]}]},{"tag":"div","props":{"className":"life-ad-space-brand"},"children":[{"tag":"img","props":{"src":"/sites/howtolivebetter/images/shengcai/logo.png","width":"565","height":"144","alt":"Официальный логотип Shengcai Youshu","decoding":"async"},"children":[]}]},{"tag":"div","props":{"className":"life-ad-space-copy"},"children":[{"tag":"span","props":{"className":"life-ad-space-label"},"children":["Реклама · Рекомендация сообщества"]},{"tag":"strong","props":{},"children":["Могут ли ваши знания стать полезным продуктом?"]},{"tag":"p","props":{},"children":["От электронных книг до инструментов: как участники находят потребности и создают то, чем можно пользоваться."]}]},{"tag":"div","props":{"className":"life-ad-space-actions"},"children":[{"tag":"a","props":{"className":"life-ad-space-link","href":"/ru/shengcaiyoushu?sc_group=reading&sc_creative=read_product&sc_placement=ad_dock"},"children":["О сообществе и примерах",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"18","height":"18","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-up-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M7 7h10v10"},"children":[]},{"tag":"path","props":{"d":"M7 17 17 7"},"children":[]}]}]}]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/ru/book/23"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"К содержанию"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["Какие навыки выгодно осваивать"]},{"tag":"div","props":{"data-ad-dock-host":"true"},"children":[]},{"tag":"nav","props":{"aria-label":"Советы главы"},"children":[{"tag":"a","props":{"href":"/ru/tip/23-01"},"children":[{"tag":"span","props":{},"children":["01"]},"Лицам младше 16 лет не разрешено «устраиваться на работу»: за найм таких подростков работодателя штрафуют на 5000 юаней в месяц, поэтому берут их только нелегальные предприятия"]},{"tag":"a","props":{"href":"/ru/tip/23-02"},"children":[{"tag":"span","props":{},"children":["02"]},"Учёт влияния образования на смертность: каждый дополнительный год обучения снижает риск смерти у взрослых примерно на 1,9%"]},{"tag":"a","props":{"href":"/ru/tip/23-03"},"children":[{"tag":"span","props":{},"children":["03"]},"Прежде чем судить об обесценивании образования, посмотрите на структуру образования в Китае: лишь 15467 из 100000 имеют образование уровня колледжа или выше (перепись 2020 года; по выборочной оценке 2025 года — около 19%)"]},{"tag":"a","props":{"href":"/ru/tip/23-04"},"children":[{"tag":"span","props":{},"children":["04"]},"«Не хватает денег на учёбу»: сначала посчитаем по правилам: в большинстве случаев обучение в средних профессиональных учебных заведениях бесплатно, стипендия составляет 2300 юаней в год, а максимальная сумма образовательного кредита — 20 000 юаней в год"]},{"tag":"a","props":{"href":"/ru/tip/23-05"},"children":[{"tag":"span","props":{},"children":["05"]},"Неудача на вступительных в обычную старшую школу не означает тупик: в системе профессионального образования существуют программы непрерывного обучения и отдельные вступительные экзамены, а работодатели могут снижать требования к уровню образования для соискателей из профессиональных училищ"]},{"tag":"a","props":{"href":"/ru/tip/23-06"},"children":[{"tag":"span","props":{},"children":["06"]},"«Учиться или идти работать» как одна задача: зарплата за три года, если сразу пойти работать, против разницы в годовом доходе на десятилетия вперёд, которую даёт продолжение учёбы"]},{"tag":"a","props":{"href":"/ru/tip/23-07"},"children":[{"tag":"span","props":{},"children":["07"]},"Запомните базовый показатель: в среднем по миру дополнительный год обучения повышает личный доход примерно на 9% в год"]},{"tag":"a","props":{"href":"/ru/tip/23-08"},"children":[{"tag":"span","props":{},"children":["08"]},"Прежде чем тратить деньги на получение сертификата, проверьте, входит ли он в Государственный реестр профессиональных квалификаций или перечень аккредитованных организаций Министерства труда и социальной защиты"]},{"tag":"a","props":{"href":"/ru/tip/23-09"},"children":[{"tag":"span","props":{},"children":["09"]},"Сначала ищите государственные субсидии на обучение, а не сразу оплачивайте коммерческие курсы из собственного кармана"]},{"tag":"a","props":{"href":"/ru/tip/23-10"},"children":[{"tag":"span","props":{},"children":["10"]},"При выборе навыка отдавайте предпочтение тем, где требуется работать руками и принимать решения на месте — такие профессии сложнее всего автоматизировать"]},{"tag":"a","props":{"href":"/ru/tip/23-11"},"children":[{"tag":"span","props":{},"children":["11"]},"Перед обучением проверьте, есть ли у данной профессии официальная система уровней и можно ли их обменять на деньги"]},{"tag":"a","props":{"href":"/ru/tip/23-12"},"children":[{"tag":"span","props":{},"children":["12"]},"Не стоит воспринимать утверждения в интернете о высокой зарплате как признак дефицита рабочих кадров — лучше изучите местные списки востребованных профессий и программы субсидий"]},{"tag":"a","props":{"href":"/ru/tip/23-13"},"children":[{"tag":"span","props":{},"children":["13"]},"За те же деньги и время лучше выбирать краткосрочные программы, позволяющие сразу приступить к работе"]},{"tag":"a","props":{"href":"/ru/tip/23-14"},"children":[{"tag":"span","props":{},"children":["14"]},"После изучения раздела закройте книгу и проверьте себя — не перечитывайте его заново"]},{"tag":"a","props":{"href":"/ru/tip/23-15"},"children":[{"tag":"span","props":{},"children":["15"]},"Распределите то же время на несколько дней, а не учитесь за один раз"]},{"tag":"a","props":{"href":"/ru/tip/23-16"},"children":[{"tag":"span","props":{},"children":["16"]},"Не стоит считать выделение важных моментов, повторное чтение и составление кратких выводов основными методами обучения"]},{"tag":"a","props":{"href":"/ru/tip/23-17"},"children":[{"tag":"span","props":{},"children":["17"]},"Смешанная практика разных типов заданий, а не по 20 одинаковых подряд"]},{"tag":"a","props":{"href":"/ru/tip/23-18"},"children":[{"tag":"span","props":{},"children":["18"]},"Не стоит выбирать методы обучения, исходя из того, что «я — визуал, а он — аудиал»"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/ru/tip/23-19","data-status":"active"},"children":[{"tag":"span","props":{},"children":["19"]},"Проверяйте себя, составляя вопросы на основе будущего применения материала, а не просто заучивая его дословно"]},{"tag":"a","props":{"href":"/ru/tip/23-20"},"children":[{"tag":"span","props":{},"children":["20"]},"Сначала определите, к какой серии и уровню относится ваша профессия, а затем выберите подходящий способ подачи заявки в зависимости от типа вашей организации"]},{"tag":"a","props":{"href":"/ru/tip/23-21"},"children":[{"tag":"span","props":{},"children":["21"]},"Получение начальных и средних профессиональных званий, например в сфере бухгалтерского учета, происходит посредством единого общенационального экзамена. Для регистрации необходимо сопоставить свое образование и стаж работы с требованиями"]},{"tag":"a","props":{"href":"/ru/tip/23-22"},"children":[{"tag":"span","props":{},"children":["22"]},"Не обращайтесь к посредникам для прохождения аттестации, не заказывайте написание статей у сторонних лиц и не подделывайте документы: при выявлении нарушений звание будет аннулировано, а в карточку добросовестности внесут запись на 3 года"]},{"tag":"a","props":{"href":"/ru/tip/23-23"},"children":[{"tag":"span","props":{},"children":["23"]},"Наличие профессионального звания не гарантирует повышение зарплаты: сначала уточните, проводится ли оно в рамках установленного соотношения вакансий, или же получение звания не подразумевает автоматическое назначение на должность"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"Навигация"},"children":[{"tag":"a","props":{"href":"/ru/book"},"children":["Книга"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/ru/book/23"},"children":["Глава 23"," ·"," ","Какие навыки выгодно осваивать"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"23-19"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["19"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["Доказательства"," ","A"]}]},{"tag":"h1","props":{"lang":"ru"},"children":["Проверяйте себя, составляя вопросы на основе будущего применения материала, а не просто заучивая его дословно"]},{"tag":"p","props":{"lang":"ru","className":"life-entry-summary"},"children":["Проверка себя без открытой книги даёт пользу, выходящую далеко за пределы простого запоминания текста. В рамках метаанализа, объединившего 192 исследования с участием более 10 000 человек, было установлено, что такой подход эффективен и для вопросов другого типа, в том числе практических и логических; при этом эффект оказался умеренным. Однако в двух случаях он практически не проявляется: когда меняют местами формулировку вопроса и правильный ответ, а также когда материал встречается в книге впервые и ранее никогда не проверялся на знание."]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Затраты"]},{"tag":"p","props":{},"children":["Не требует никаких затрат — ни денег, ни времени. Изменяет…"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Польза"]},{"tag":"p","props":{},"children":["В рамках данного метаанализа были проанализированы исследования за более чем 40 лет, включая 67 опубликованных…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"Отметить: Проверяйте себя, составляя вопросы на основе будущего применения материала, а не просто заучивая его дословно"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"Сделано"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"В планах"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"В избранное"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Поделиться советом"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Скрыть подробности"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Затраты"]},{"tag":"p","props":{},"children":["Не требует никаких затрат — ни денег, ни времени. Изменяется лишь метод тренировки: вместо «заучивания дословно» используйте «составление вопросов на основе будущего применения материала». Главная сложность здесь — предварительно продумать, как именно этот материал пригодится в будущем."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Польза"]},{"tag":"p","props":{},"children":["В рамках данного метаанализа были проанализированы исследования за более чем 40 лет, включая 67 опубликованных и неопубликованных статей, 122 эксперимента и 192 показателя переноса знаний; общее число участников составило 10 382 человека. По сравнению с вариантом «простого повторного прочтения без проверки», практические тесты действительно способствуют переносу знаний в иные условия; соответствующий показатель d равен 0,40 (95% ДИ: от 0,31 до 0,50). Наиболее сильный перенос наблюдается при смене типа вопросов, при проверке практических и логических задач, а также вопросов медицинской диагностики и вопросов с похожими ключевыми словами. Наименьший эффект отмечается при замене местами стимула и ответа, при работе с материалом, который ранее встречался, но не проверялся, а также при решении типовых примеров. На величину переноса сильно влияют такие факторы, как совпадение формата ответа при тренировке и проверке, наличие детальной обратной связи после попыток вспомнить информацию, а также результат первичного теста. Авторы использовали два метода для коррекции публикационной предвзятости; при этом величина влияния регулирующих факторов почти не изменилась, однако оценка начального уровня эффективности оказалась значительно занижена. Если ни один из вышеперечисленных факторов отсутствует, положительный перенос знаний зачастую не наблюдается."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Первоисточники"]},{"tag":"p","props":{"className":"life-citations"},"children":["Pan SC, Rickard TC (2018). Transfer of test-enhanced learning: meta-analytic review and synthesis. Psychological Bulletin, 144(7), 710-756. ",{"tag":"a","props":{"href":"https://doi.org/10.1037/bul0000151","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1037/bul0000151"]}]},{"tag":"a","props":{"href":"https://doi.org/10.1037/bul0000151","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Открыть источник"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Примечание автора"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["В обиходе термин «заучивание» часто объединяет два разных действия: повторное прочтение материала (выделение ключевых моментов, повторение текста) и активное вспоминание без открытой книги. Первый вариант в обзоре десяти методов обучения получил самую низкую оценку; подробности по этому поводу см. в пункте 16 (не стоит считать выделение текста, повторное прочтение и составление кратких выжимок основными методами обучения). Необходимо применять именно второй подход — активное вспоминание без книги; детали см. в пункте 14 (самопроверка без открытой книги), а также в пункте 15 (распределение тренировок на несколько дней). Сначала продумайте, как именно материал пригодится в будущем: потребуется ли выбрать правильный вариант из нескольких предложенных или сделать вывод на основе имеющихся данных, после чего составляйте вопросы в таком же формате. Также полезно попрактиковаться в обратном порядке: составлять вопросы с заменой местами формулировки и ответа, поскольку в рамках данного метаанализа именно такой вариант демонстрирует наименьший перенос знаний; поэтому важно отработать оба направления."]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Моя заметка"]},{"tag":"button","props":{"type":"button"},"children":["Запишите напоминание…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/ru/tip/23-18"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Предыдущий"]},"Не стоит выбирать методы обучения, исходя из того, что «я — визуал, а он — аудиал»"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/ru/tip/23-20"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Следующий"]},"Сначала определите, к какой серии и уровню относится ваша профессия, а затем выберите подходящий способ подачи заявки в зависимости от типа вашей организации"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["Другие советы по этой теме"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/23-15"},"children":[{"tag":"strong","props":{},"children":["Распределите то же время на несколько дней, а не учитесь за один раз"]},{"tag":"span","props":{},"children":["Если разделить одно и то же время на несколько дней, материал запомин…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/23-16"},"children":[{"tag":"strong","props":{},"children":["Не стоит считать выделение важных моментов, повторное чтение и составление кратких выводов основными методами обучения"]},{"tag":"span","props":{},"children":["Среди десяти распространённых методов обучения выделение важных момен…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/23-17"},"children":[{"tag":"strong","props":{},"children":["Смешанная практика разных типов заданий, а не по 20 одинаковых подряд"]},{"tag":"span","props":{},"children":["Если выполнять много однотипных заданий подряд, результаты сразу полу…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/23-21"},"children":[{"tag":"strong","props":{},"children":["Получение начальных и средних профессиональных званий, например в сфере бухгалтерского учета, происходит посредством единого общенационального экзамена. Для регистрации необходимо сопоставить свое образование и стаж работы с требованиями"]},{"tag":"span","props":{},"children":["Для ряда начальных и средних профессиональных званий достаточно сдать…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/23-22"},"children":[{"tag":"strong","props":{},"children":["Не обращайтесь к посредникам для прохождения аттестации, не заказывайте написание статей у сторонних лиц и не подделывайте документы: при выявлении нарушений звание будет аннулировано, а в карточку добросовестности внесут запись на 3 года"]},{"tag":"span","props":{},"children":["Если вы получили звание с помощью поддельных документов, написания ст…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/23-23"},"children":[{"tag":"strong","props":{},"children":["Наличие профессионального звания не гарантирует повышение зарплаты: сначала уточните, проводится ли оно в рамках установленного соотношения вакансий, или же получение звания не подразумевает автоматическое назначение на должность"]},{"tag":"span","props":{},"children":["Профессиональное звание служит основанием для назначения на должность…"]}]}]}]},{"tag":"a","props":{"className":"life-text-link","href":"/ru/book/23"},"children":["Читать всю тему: Какие навыки выгодно осваивать"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"15","height":"15","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]}]}]}]},{"tag":"aside","props":{"className":"life-ad-space life-ad-space-sponsored","data-ad-placement":"ad_footer","data-ad-group":"reading","data-ad-creative":"read_product","data-ad-ready":"false","aria-label":"Реклама · Рекомендация сообщества"},"children":[{"tag":"div","props":{"className":"life-ad-space-brand"},"children":[{"tag":"img","props":{"src":"/sites/howtolivebetter/images/shengcai/logo.png","width":"565","height":"144","alt":"Официальный логотип Shengcai Youshu","decoding":"async"},"children":[]}]},{"tag":"div","props":{"className":"life-ad-space-copy"},"children":[{"tag":"span","props":{"className":"life-ad-space-label"},"children":["Реклама · Рекомендация сообщества"]},{"tag":"strong","props":{},"children":["Могут ли ваши знания стать полезным продуктом?"]},{"tag":"p","props":{},"children":["От электронных книг до инструментов: как участники находят потребности и создают то, чем можно пользоваться."]}]},{"tag":"div","props":{"className":"life-ad-space-actions"},"children":[{"tag":"a","props":{"className":"life-ad-space-link","href":"/ru/shengcaiyoushu?sc_group=reading&sc_creative=read_product&sc_placement=ad_footer"},"children":["О сообществе и примерах",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"18","height":"18","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-up-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M7 7h10v10"},"children":[]},{"tag":"path","props":{"d":"M7 17 17 7"},"children":[]}]}]},{"tag":"a","props":{"className":"life-ad-space-