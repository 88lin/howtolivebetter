},"children":[{"tag":"div","props":{"className":"life-ad-rail","data-dock-active":"false","style":{"top":"94px"}},"children":[{"tag":"div","props":{"className":"life-ad-dock","hidden":true},"children":[{"tag":"aside","props":{"className":"life-ad-space life-ad-space-sponsored life-ad-space-compact","data-ad-placement":"ad_dock","data-ad-group":"reading","data-ad-creative":"read_product","data-ad-ready":"false","aria-label":"Реклама · Рекомендация сообщества"},"children":[{"tag":"button","props":{"type":"button","className":"life-ad-dismiss","aria-label":"Закрыть рекламу"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-x","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M18 6 6 18"},"children":[]},{"tag":"path","props":{"d":"m6 6 12 12"},"children":[]}]}]},{"tag":"div","props":{"className":"life-ad-space-brand"},"children":[{"tag":"img","props":{"src":"/sites/howtolivebetter/images/shengcai/logo.png","width":"565","height":"144","alt":"Официальный логотип Shengcai Youshu","decoding":"async"},"children":[]}]},{"tag":"div","props":{"className":"life-ad-space-copy"},"children":[{"tag":"span","props":{"className":"life-ad-space-label"},"children":["Реклама · Рекомендация сообщества"]},{"tag":"strong","props":{},"children":["Могут ли ваши знания стать полезным продуктом?"]},{"tag":"p","props":{},"children":["От электронных книг до инструментов: как участники находят потребности и создают то, чем можно пользоваться."]}]},{"tag":"div","props":{"className":"life-ad-space-actions"},"children":[{"tag":"a","props":{"className":"life-ad-space-link","href":"/ru/shengcaiyoushu?sc_group=reading&sc_creative=read_product&sc_placement=ad_dock"},"children":["О сообществе и примерах",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"18","height":"18","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-up-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M7 7h10v10"},"children":[]},{"tag":"path","props":{"d":"M7 17 17 7"},"children":[]}]}]}]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/ru/book/01"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"К содержанию"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["Как не умереть раньше времени"]},{"tag":"div","props":{"data-ad-dock-host":"true"},"children":[]},{"tag":"nav","props":{"aria-label":"Советы главы"},"children":[{"tag":"a","props":{"href":"/ru/tip/01-01"},"children":[{"tag":"span","props":{},"children":["01"]},"Пристегните ремень безопасности — как спереди, так и сзади"]},{"tag":"a","props":{"href":"/ru/tip/01-02"},"children":[{"tag":"span","props":{},"children":["02"]},"Надевание шлема при езде на мотоцикле и электровелосипеде"]},{"tag":"a","props":{"href":"/ru/tip/01-03"},"children":[{"tag":"span","props":{},"children":["03"]},"Установка дымовых извещателей; зимой в домах с отоплением углём или газом — ещё и извещателей на угарный газ"]},{"tag":"a","props":{"href":"/ru/tip/01-04"},"children":[{"tag":"span","props":{},"children":["04"]},"Заменяйте газовые шланги и плиты по истечении срока службы, не вносите изменения в трубопровод самостоятельно, а при навязчивых предложениях от газовой компании смело отказывайтесь"]},{"tag":"a","props":{"href":"/ru/tip/01-05"},"children":[{"tag":"span","props":{},"children":["05"]},"Не собирайте, не покупайте и не ешьте дикие грибы; никакие «народные способы» их распознавания не работают"]},{"tag":"a","props":{"href":"/ru/tip/01-06"},"children":[{"tag":"span","props":{},"children":["06"]},"Электровелосипеды нельзя везти в подъезды, в лифты и заряжать дома"]},{"tag":"a","props":{"href":"/ru/tip/01-07"},"children":[{"tag":"span","props":{},"children":["07"]},"Измерение давления и приём лекарств для его снижения до нормы"]},{"tag":"a","props":{"href":"/ru/tip/01-08"},"children":[{"tag":"span","props":{},"children":["08"]},"После 35 лет при наличии избыточного веса стоит сдать анализ на уровень глюкозы в крови; если результат в норме, повторять исследование раз в три года"]},{"tag":"a","props":{"href":"/ru/tip/01-09"},"children":[{"tag":"span","props":{},"children":["09"]},"Не превышать скорость и не садиться за руль в нетрезвом виде"]},{"tag":"a","props":{"href":"/ru/tip/01-10"},"children":[{"tag":"span","props":{},"children":["10"]},"Использование при поездках детских автокресел для детей младше 4 лет, а не держание их на руках"]},{"tag":"a","props":{"href":"/ru/tip/01-11"},"children":[{"tag":"span","props":{},"children":["11"]},"Установите ограничители на окна и балконы, если в доме есть дети; москитные сетки не являются защитой"]},{"tag":"a","props":{"href":"/ru/tip/01-12"},"children":[{"tag":"span","props":{},"children":["12"]},"Детей у воды нужно держать под присмотром; при катании на лодках и плавании в естественных водоемах следует надевать спасательные жилеты"]},{"tag":"a","props":{"href":"/ru/tip/01-13"},"children":[{"tag":"span","props":{},"children":["13"]},"Упражнения на равновесие и силу ног для людей старше 60 лет, а также модернизация ванной комнаты и лестниц в доме"]},{"tag":"a","props":{"href":"/ru/tip/01-14"},"children":[{"tag":"span","props":{},"children":["14"]},"Анализ на наличие антител к гепатиту B и вакцинация при их отсутствии"]},{"tag":"a","props":{"href":"/ru/tip/01-15"},"children":[{"tag":"span","props":{},"children":["15"]},"При уколе гвоздем, занозе или загрязнении раны землёй необходимо сразу обратиться за помощью и спросить, нужна ли прививка от столбняка"]},{"tag":"a","props":{"href":"/ru/tip/01-16"},"children":[{"tag":"span","props":{},"children":["16"]},"Чем раньше женщины получают вакцину против ВПЧ, тем лучше"]},{"tag":"a","props":{"href":"/ru/tip/01-17"},"children":[{"tag":"span","props":{},"children":["17"]},"Скрининг рака молочной железы для женщин: маммография каждые два года начиная с 40 лет"]},{"tag":"a","props":{"href":"/ru/tip/01-18"},"children":[{"tag":"span","props":{},"children":["18"]},"Женщинам старше 30 лет для скрининга рака шейки матки рекомендуется тестирование на ВПЧ"]},{"tag":"a","props":{"href":"/ru/tip/01-19"},"children":[{"tag":"span","props":{},"children":["19"]},"Скрининг колоректального рака с 45–50 лет: иммунохимический тест на скрытую кровь в кале или колоноскопия"]},{"tag":"a","props":{"href":"/ru/tip/01-20"},"children":[{"tag":"span","props":{},"children":["20"]},"Людям с сердечно-сосудистыми заболеваниями и пожилым людям стоит делать прививку от гриппа каждый год"]},{"tag":"a","props":{"href":"/ru/tip/01-21"},"children":[{"tag":"span","props":{},"children":["21"]},"Вакцинация против опоясывающего герпеса после 50 лет"]},{"tag":"a","props":{"href":"/ru/tip/01-22"},"children":[{"tag":"span","props":{},"children":["22"]},"Вакцинация против пневмококковой инфекции для людей старше 65 лет"]},{"tag":"a","props":{"href":"/ru/tip/01-23"},"children":[{"tag":"span","props":{},"children":["23"]},"Обследование на наличие хеликобактера пилори и его эрадикация"]},{"tag":"a","props":{"href":"/ru/tip/01-24"},"children":[{"tag":"span","props":{},"children":["24"]},"Тяжелым курильщикам раз в год следует делать низкодозовую КТ грудной клетки"]},{"tag":"a","props":{"href":"/ru/tip/01-25"},"children":[{"tag":"span","props":{},"children":["25"]},"При возникновении депрессии или суицидальных мыслей звоните по номеру 12356; дома не храните снотворные и пестициды"]},{"tag":"a","props":{"href":"/ru/tip/01-26"},"children":[{"tag":"span","props":{},"children":["26"]},"Подготовьте огнетушитель, огнезащитное одеяло, респиратор для эвакуации и аптечку первой помощи, проверяя их раз в год"]},{"tag":"a","props":{"href":"/ru/tip/01-27"},"children":[{"tag":"span","props":{},"children":["27"]},"Появление в моче крови, видимой невооруженным глазом — даже если нет боли и даже если кровь исчезает на следующий день — требует обязательного обследования"]},{"tag":"a","props":{"href":"/ru/tip/01-28"},"children":[{"tag":"span","props":{},"children":["28"]},"Проблемы с эрекцией? Сначала проверьте сердечно-сосудистую систему, а не списывайте это лишь на «сексуальные трудности»"]},{"tag":"a","props":{"href":"/ru/tip/01-29"},"children":[{"tag":"span","props":{},"children":["29"]},"Снижение веса, отказ от курения и контроль уровня сахара и давления способствуют улучшению эректильной функции"]},{"tag":"a","props":{"href":"/ru/tip/01-30"},"children":[{"tag":"span","props":{},"children":["30"]},"Использование презервативов на протяжении всего полового акта, а также отказ от совместного использования игл"]},{"tag":"a","props":{"href":"/ru/tip/01-31"},"children":[{"tag":"span","props":{},"children":["31"]},"Пройдите тестирование на ВИЧ, если у вас были рискованные контакты: Центр по контролю заболеваний делает это бесплатно, а результаты остаются конфиденциальными"]},{"tag":"a","props":{"href":"/ru/tip/01-32"},"children":[{"tag":"span","props":{},"children":["32"]},"Как только возникла мысль о самоубийстве, сразу расскажите об этом близкому человеку и отдайте эти несколько десятков минут ему"]},{"tag":"a","props":{"href":"/ru/tip/01-33"},"children":[{"tag":"span","props":{},"children":["33"]},"Не стоит воспринимать «спасение жизни» как гарантию: при отравлении паракватом или угарным газом в отделении неотложной помощи удаётся спасти жизнь, но лёгкие и мозг часто повреждаются необратимо"]},{"tag":"a","props":{"href":"/ru/tip/01-34"},"children":[{"tag":"span","props":{},"children":["34"]},"Не стоит рассчитывать на быстрое выздоровление после падения с высоты: большинство пациентов, попавших в травматологическое отделение интенсивной терапии, выживают, но цена этого — годы жизни"]},{"tag":"a","props":{"href":"/ru/tip/01-35"},"children":[{"tag":"span","props":{},"children":["35"]},"Не стоит обменивать «отсутствие одной почки» на деньги: оставшаяся почка теперь выполняет работу за две, а 86% людей, продавших почку, позже отмечают ухудшение здоровья"]},{"tag":"a","props":{"href":"/ru/tip/01-36"},"children":[{"tag":"span","props":{},"children":["36"]},"Не подбирайте, не разбирайте и не продавайте металлические детали неизвестного происхождения; держитесь подальше от зон с предупреждающими знаками в виде клевера"]},{"tag":"a","props":{"href":"/ru/tip/01-37"},"children":[{"tag":"span","props":{},"children":["37"]},"Когда вы берете в долг, чтобы продолжить играть, и находитесь в подавленном состоянии, сначала позвоните по номеру 12356, а затем передайте свои банковские карты и пароли от платежных систем членам семьи для контроля"]},{"tag":"a","props":{"href":"/ru/tip/01-38"},"children":[{"tag":"span","props":{},"children":["38"]},"Для МСМ с высоким риском сексуального контакта: обращение в специализированные центры по вопросам ПКП (доконтактной профилактики) позволяет снизить риск заражения ВИЧ более чем на 70%"]},{"tag":"a","props":{"href":"/ru/tip/01-39"},"children":[{"tag":"span","props":{},"children":["39"]},"Женщинам 65 лет и старше сделайте рентгеновскую денситометрию (DXA); женщинам после менопаузы с факторами риска остеопороза не обязательно ждать 65 лет"]},{"tag":"a","props":{"href":"/ru/tip/01-40"},"children":[{"tag":"span","props":{},"children":["40"]},"При остеопорозе или переломе от лёгкого падения попросите врача назначить противоостеопоротические препараты и принимайте их, не заменяя лечение одними кальцием"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/ru/tip/01-41","data-status":"active"},"children":[{"tag":"span","props":{},"children":["41"]},"Перед выходом на дикий лёд необходимо просверлить отверстия и измерить его толщину — не стоит выходить, если она меньше 15 см. Избегайте льда на реках и вблизи лунок для ловли рыбы"]},{"tag":"a","props":{"href":"/ru/tip/01-42"},"children":[{"tag":"span","props":{},"children":["42"]},"Перед работой с болгаркой установите кожух, наденьте защитные очки и лицевой щиток, держите ее двумя руками и не ставьте пильный диск для дерева"]},{"tag":"a","props":{"href":"/ru/tip/01-43"},"children":[{"tag":"span","props":{},"children":["43"]},"Прямо спросите человека, чьё состояние вызывает тревогу: «Ты думал о самоубийстве?» Вопрос не усиливает это желание"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"Навигация"},"children":[{"tag":"a","props":{"href":"/ru/book"},"children":["Книга"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/ru/book/01"},"children":["Глава 1"," ·"," ","Как не умереть раньше времени"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"01-41"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["41"]},{"tag":"span","props":{"className":"life-evidence grade-c"},"children":["Доказательства"," ","C"]}]},{"tag":"h1","props":{"lang":"ru"},"children":["Перед выходом на дикий лёд необходимо просверлить отверстия и измерить его толщину — не стоит выходить, если она меньше 15 см. Избегайте льда на реках и вблизи лунок для ловли рыбы"]},{"tag":"p","props":{"lang":"ru","className":"life-entry-summary"},"children":["Официальные российские рекомендации гласят, что для безопасного катания взрослым людям толщина льда должна составлять минимум 15 см. В США и Канаде минимальный порог — 10 см, причём учитывается только свежий прозрачный лёд. Мутный лёд по прочности уступает прозрачному вдвое, поэтому его толщину следует удваивать. На одном и том же водоёме толщина льда может сильно различаться: в одном месте она составит 30 см, а в нескольких шагах оттуда — всего 2-3 см, поэтому измерять её нужно постоянно во время движения."]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Затраты"]},{"tag":"p","props":{},"children":["Самый простой вариант — посетить официальный каток под при…"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Польза"]},{"tag":"p","props":{},"children":["Согласно данным Метеорологического управления Китая, при толщине льда 15 см взрослые люди могут безопасно ката…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"Отметить: Перед выходом на дикий лёд необходимо просверлить отверстия и измерить его толщину — не стоит выходить, если она меньше 15 см. Избегайте льда на реках и вблизи лунок для ловли рыбы"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"Сделано"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"В планах"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"В избранное"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Поделиться советом"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Скрыть подробности"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Затраты"]},{"tag":"p","props":{},"children":["Самый простой вариант — посетить официальный каток под присмотром персонала, это не потребует больших затрат. Если же вы хотите выйти на дикий лёд, возьмите с собой ледоруб или сверло для измерения толщины. Также пригодятся спасательные ледовые крюки — это два острых шипа с рукоятками, которые крепятся к груди. Все эти принадлежности обойдутся в несколько десятков-сотен юаней. При этом придётся останавливаться и измерять толщину льда на каждом участке пути, что займёт дополнительное время."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Польза"]},{"tag":"p","props":{},"children":["Согласно данным Метеорологического управления Китая, при толщине льда 15 см взрослые люди могут безопасно кататься на нём. Для открытия открытых катков также требуется, чтобы толщина льда достигала 15 см. Управление водных ресурсов Пекина указывает, что для открытия официальных естественных катков толщина льда должна составлять 15 см, а в течение последующей недели температура воздуха должна удерживаться в диапазоне от -8°C до +1°C без сильных ветров. На диких водоёмах часто встречаются лунки, пробитые рыбаками, после чего лёд в этом месте снова замерзает с трудом. Руководство Департамента природных ресурсов штата Миннесота (США) касается только свежих прозрачных льдов: если их толщина меньше 4 дюймов (около 10 см), выходить на них нельзя, а при такой толщине можно ходить и ловить рыбу. Мутный лёд, образовавшийся после таяния и повторного замерзания снега, по прочности уступает прозрачному вдвое, поэтому его толщину следует удваивать. На одном и том же водоёме толщина льда может сильно различаться: в одном месте она составит 30 см, а в нескольких шагах оттуда — всего 2-3 см. Лёд на проточных водах обычно опасен, особенно вблизи ручьёв, мостов и водопропускных труб. Лёд у берега также может быть тоньше, чем в открытой части водоёма. Национальное метеорологическое управление США устанавливает такой же порог толщины льда в 4 дюйма для ходьбы, ловли рыбы и катания. Канадский центр охраны труда и безопасности ссылается на рекомендации Красного Креста Канады: для группы людей, выходящих на лёд для катания или ходьбы, требуется толщина 15 см, а для массовых катальных мероприятий — 20 см. Все эти рекомендации являются мерами безопасности, однако никакие исследования не подтверждают, насколько снижается количество смертельных случаев при их соблюдении (в Китае, США и Канаде)."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Первоисточники"]},{"tag":"p","props":{"className":"life-citations"},"children":["中国气象局 (2019). 想要冰上健步走，多厚的冰才安全？ ",{"tag":"a","props":{"href":"https://www.cma.gov.cn/kppd/kppdqxyr/kppdtyqx/201901/t20190124_513302.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.cma.gov.cn/kppd/kppdqxyr/kppdtyqx/201901/t20190124_513302.html"]},"；北京市水务局 (2024). 北京正规河湖冰场还未达开放标准，别冒险滑「野冰」. ",{"tag":"a","props":{"href":"https://swj.beijing.gov.cn/swdt/ztzl/fnsbaqztxc/fnszlxx/202412/t20241226_3973959.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://swj.beijing.gov.cn/swdt/ztzl/fnsbaqztxc/fnszlxx/202412/t20241226_3973959.html"]},"；Minnesota Department of Natural Resources. General ice thickness guidelines. ",{"tag":"a","props":{"href":"https://www.dnr.state.mn.us/safety/ice/thickness.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.dnr.state.mn.us/safety/ice/thickness.html"]},"；Minnesota Department of Natural Resources. Ice safety. ",{"tag":"a","props":{"href":"https://www.dnr.state.mn.us/safety/ice/index.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.dnr.state.mn.us/safety/ice/index.html"]},"；Minnesota Department of Natural Resources. Steps for surviving immersion. ",{"tag":"a","props":{"href":"https://www.dnr.state.mn.us/safety/ice/survival.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.dnr.state.mn.us/safety/ice/survival.html"]},"；National Weather Service. Winter Weather Safety: Ice and Frost. ",{"tag":"a","props":{"href":"https://www.weather.gov/safety/winter-ice-frost","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.weather.gov/safety/winter-ice-frost"]},"；Canadian Centre for Occupational Health and Safety. Working on or near Ice Covered Water - Basic Information. ",{"tag":"a","props":{"href":"https://www.ccohs.ca/oshanswers/hsprograms/work_ice.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.ccohs.ca/oshanswers/hsprograms/work_ice.html"]}]},{"tag":"a","props":{"href":"https://www.cma.gov.cn/kppd/kppdqxyr/kppdtyqx/201901/t20190124_513302.html","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Открыть источник"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Примечание автора"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["Во всех официальных руководствах подчёркивается, что абсолютно безопасного льда не существует, а достаточная толщина — лишь минимальный порог, а не гарантия безопасности. Наиболее опасными периодами являются ранняя зима, когда лёд только начинает образовываться, и ранняя весна, когда он начинает таять. Если вы всё же провалились под лёд, не снимайте одежду — воздух, задерживаемый в толстой одежде, поможет вам держаться на поверхности. Повернитесь в сторону, откуда пришли — там лёд обычно прочнее. Приложите руки к льду, вбейте в него спасательные крюки, оттолкнитесь ногами и вытяните тело на поверхность. После этого не вставайте, а лежа на спине отползите подальше от лунки, после чего согрейтесь; при сильном переохлаждении необходимо срочно обратиться в больницу. Если вы увидели, что кто-то провалился под лёд, не бегите к нему на помощь — следуйте инструкциям из раздела 13, пункт 25 (действия при виде тонущего человека без возможности самостоятельно спуститься в воду): сначала позовите на помощь, вызовите службу 112, а затем подайте пострадавшему палку или бросьте верёвку. Основными бенефициарами этих рекомендаций являетесь вы сами и дети, с которыми вы вышли на лёд."]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Моя заметка"]},{"tag":"button","props":{"type":"button"},"children":["Запишите напоминание…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/ru/tip/01-40"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Предыдущий"]},"При остеопорозе или переломе от лёгкого падения попросите врача назначить противоостеопоротические препараты и принимайте их, не заменяя лечение одними кальцием"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/ru/tip/01-42"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Следующий"]},"Перед работой с болгаркой установите кожух, наденьте защитные очки и лицевой щиток, держите ее двумя руками и не ставьте пильный диск для дерева"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["Другие советы по этой теме"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/01-35"},"children":[{"tag":"strong","props":{},"children":["Не стоит обменивать «отсутствие одной почки» на деньги: оставшаяся почка теперь выполняет работу за две, а 86% людей, продавших почку, позже отмечают ухудшение здоровья"]},{"tag":"span","props":{},"children":["Начнём с самого лучшего варианта: официальные доноры, прошедшие тщате…"]}]}]},{"tag":"li","props":{},"chil