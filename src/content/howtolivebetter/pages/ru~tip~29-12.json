ath","props":{"d":"m6.34 17.66-1.41 1.41"},"children":[]},{"tag":"path","props":{"d":"m19.07 4.93-1.41 1.41"},"children":[]}]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"17","height":"17","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-moon life-theme-icon-dark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"},"children":[]}]}]},{"tag":"button","props":{"type":"button","className":"life-language-switch","aria-label":"Русский Выбрать язык","aria-haspopup":"menu","aria-expanded":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-globe","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]},{"tag":"path","props":{"d":"M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"},"children":[]},{"tag":"path","props":{"d":"M2 12h20"},"children":[]}]},{"tag":"span","props":{},"children":["Русский"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]}]},{"tag":"a","props":{"className":"life-account","href":"/ru/sign-in"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"17","height":"17","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle-user-round","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M18 20a6 6 0 0 0-12 0"},"children":[]},{"tag":"circle","props":{"cx":"12","cy":"10","r":"4"},"children":[]},{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},{"tag":"span","props":{},"children":["Войти"]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/ru/book/29"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"К содержанию"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["Что важно знать после тяжёлой утраты"]},{"tag":"nav","props":{"aria-label":"Советы главы"},"children":[{"tag":"a","props":{"href":"/ru/tip/29-01"},"children":[{"tag":"span","props":{},"children":["01"]},"В первые дни после утраты близкого человека не оставайтесь одни; людям с сердечно-сосудистыми заболеваниями, гипертонией и диабетом следует продолжать принимать лекарства. Если возникает давящая боль в груди, немедленно звоните по номеру 120 (скорая помощь)"]},{"tag":"a","props":{"href":"/ru/tip/29-02"},"children":[{"tag":"span","props":{},"children":["02"]},"В неделю после получения диагноза тяжёлого заболевания не ходите за результатами анализов в одиночку, а важные решения, не связанные с лечением, отложите"]},{"tag":"a","props":{"href":"/ru/tip/29-03"},"children":[{"tag":"span","props":{},"children":["03"]},"После потери работы важно наладить режим дня, оформить медстраховку (ибао) и составить четкий график поиска работы — не стоит целыми днями сидеть дома"]},{"tag":"a","props":{"href":"/ru/tip/29-04"},"children":[{"tag":"span","props":{},"children":["04"]},"Людям, потерявшим близких в результате самоубийства, несчастного случая или убийства, не стоит пытаться справиться в одиночку — нужно обращаться за профессиональной помощью"]},{"tag":"a","props":{"href":"/ru/tip/29-05"},"children":[{"tag":"span","props":{},"children":["05"]},"В первые полгода после потери супруга поручите приём лекарств, питание, сон и медицинские осмотры конкретному человеку"]},{"tag":"a","props":{"href":"/ru/tip/29-06"},"children":[{"tag":"span","props":{},"children":["06"]},"Если у вас нет ни родственников, ни друзей, замените «человека, который за вами следит» на три вещи: соседа, которому можно дать ключ от дома, список социальной помощи в вашем районе и контакты экстренной помощи в телефоне"]},{"tag":"a","props":{"href":"/ru/tip/29-07"},"children":[{"tag":"span","props":{},"children":["07"]},"Как поступить, если умер один из родителей: рассказать ребёнку правду, позволить ему присутствовать на прощании, не отправлять в другую среду"]},{"tag":"a","props":{"href":"/ru/tip/29-08"},"children":[{"tag":"span","props":{},"children":["08"]},"Горе длится более полугода, жизнь не налаживается: когда обращаться к психиатру или клиническому психологу"]},{"tag":"a","props":{"href":"/ru/tip/29-09"},"children":[{"tag":"span","props":{},"children":["09"]},"Не стоит сразу тратить деньги на консультации по горю: сначала проверьте, действительно ли ваше горе застряло (см. симптомы из пункта 8)"]},{"tag":"a","props":{"href":"/ru/tip/29-10"},"children":[{"tag":"span","props":{},"children":["10"]},"После раздельного проживания или развода не прекращайте медстраховку и не заменяйте её алкоголем"]},{"tag":"a","props":{"href":"/ru/tip/29-11"},"children":[{"tag":"span","props":{},"children":["11"]},"Чтобы поговорить с кем-то, звоните на 12356; несовершеннолетним и подросткам — на 12355; для визита к врачу обращайтесь в психологическую клинику"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/ru/tip/29-12","data-status":"active"},"children":[{"tag":"span","props":{},"children":["12"]},"В первые три месяца после случившегося откладывайте все необратимые крупные решения"]},{"tag":"a","props":{"href":"/ru/tip/29-13"},"children":[{"tag":"span","props":{},"children":["13"]},"Не стоит рассматривать смерть как способ погасить долги: в течение двух лет по страховке на случай смерти выплат не будет, не признают и несчастный случай на производстве, а долги всё равно списываются в первую очередь из наследства"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"Навигация"},"children":[{"tag":"a","props":{"href":"/ru/book"},"children":["Книга"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/ru/book/29"},"children":["Глава 29"," ·"," ","Что важно знать после тяжёлой утраты"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"29-12"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["12"]},{"tag":"span","props":{"className":"life-evidence grade-b"},"children":["Доказательства"," ","B"]}]},{"tag":"h1","props":{"lang":"ru"},"children":["В первые три месяца после случившегося откладывайте все необратимые крупные решения"]},{"tag":"p","props":{"lang":"ru","className":"life-entry-summary"},"children":["В этот период ваша способность объективно оценивать различные «возможности» находится на самом низком уровне. К вам будут обращаться люди, обещающие связь с умершим, обещающие удвоить ваши деньги, советующие уволиться и переехать в другой город, или предлагающие стать партнёрами. Установите для себя жёсткое правило: все решения, связанные с суммами, превышающими ваш месячный доход, или такие, за отмену которых придётся заплатить большую цену, нужно отложить на три месяца. Сначала обсудите их с человеком, не заинтересованным в этом вопросе — вам просто нужно не принимать решение в тот же день."]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Затраты"]},{"tag":"p","props":{},"children":["Никаких затрат нет — просто откладывается принятие решения…"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Польза"]},{"tag":"p","props":{},"children":["Помогает избежать совершения необратимых финансовых действий в период, когда вы только пережили удар и ваше су…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"Отметить: В первые три месяца после случившегося откладывайте все необратимые крупные решения"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"Сделано"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"В планах"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"В избранное"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Поделиться советом"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Скрыть подробности"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Затраты"]},{"tag":"p","props":{},"children":["Никаких затрат нет — просто откладывается принятие решения, однако из-за этого можно упустить некоторые возможности. В тот момент может показаться, что возможности ускользают."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Польза"]},{"tag":"p","props":{},"children":["Помогает избежать совершения необратимых финансовых действий в период, когда вы только пережили удар и ваше суждение находится в наихудшем состоянии. К таким действиям относятся продажа жилья, увольнение, единовременное вложение пособий или компенсаций, поспешный повторный брак, выступление в качестве поручителя. Суммы таких решений обычно составляют от нескольких десятков тысяч до стоимости целого дома, и именно поэтому эффект оценивается как средний. Официальные документы также относят «семейные трагедии, потерю работы или обучения» к факторам риска психологического кризиса, требующим вмешательства со стороны сообщества. То есть в это время ваше состояние само по себе требует поддержки со стороны других людей. Руководство Национального института старения США (NIA) называет затруднения принятия решений обычным проявлением горя и советует, если возможно, отложить важные жизненные решения до улучшения состояния. В горе, когда мысли неясны, лучше не продавать дом и не увольняться. Работа с тремя экспериментами случайным образом вызывала грусть у части участников, затем давала выбор: деньги сейчас или через 3 месяца. Грустные соглашались на 13–34% меньшую сумму, чтобы не ждать, по сравнению с эмоционально нейтральными. Это вызванная экспериментом грусть, не реальная утрата близкого. FTC США в 2023 году предупредила: мошенники представляются похоронным бюро и грозят отменой похорон без немедленной доплаты. Первый совет — не поддаваться срочности: честная компания даёт время решить."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Первоисточники"]},{"tag":"p","props":{"className":"life-citations"},"children":["国家卫生健康委等 25 部门 (2026). 健全社会心理服务体系和危机干预机制实施方案（国卫医政发〔2026〕8 号）. ",{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/202604/content_7065035.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/zhengce/zhengceku/202604/content_7065035.htm"]},"；National Institute on Aging. Coping With Grief and Loss（「Postpone major decisions if possible」一段，页面 2026-01-26 更新）. ",{"tag":"a","props":{"href":"https://www.nia.nih.gov/health/grief-and-mourning/coping-grief-and-loss","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.nia.nih.gov/health/grief-and-mourning/coping-grief-and-loss"]},"；Lerner JS, Li Y, Weber EU (2013). The financial costs of sadness. Psychological Science, 24(1), 72-79. ",{"tag":"a","props":{"href":"https://doi.org/10.1177/0956797612450302","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1177/0956797612450302"]},"；Puig A, Federal Trade Commission (2023-06-15). Imposters prey on families preparing for the funeral of a loved one. ",{"tag":"a","props":{"href":"https://consumer.ftc.gov/consumer-alerts/2023/06/imposters-prey-families-preparing-funeral-loved-one","target":"_blank","rel":"noopener noreferrer"},"children":["https://consumer.ftc.gov/consumer-alerts/2023/06/imposters-prey-families-preparing-funeral-loved-one"]}]},{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/202604/content_7065035.htm","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Открыть источник"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Примечание автора"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["Если незаинтересованного человека рядом нет, позвоните 12356 (пункт 11 этого раздела), или запишите и перечитайте через три дня. Уровень B: направление совета поддерживают официальное руководство о горе и рандомизированный эксперимент. Но никто прямо не сравнивал финансовые результаты скорбящих при отсрочке и без неё. NIA говорит лишь «пока не станет лучше», без срока. «Три месяца» и «свыше месячного дохода» — пороги автора. Обман скорбящих и пожилых — раздел 17 (пенсионные инвестиции, пенсия за счёт жилья) и раздел 6 (гадание). Поручительства и расписки — раздел 8. Некоторые деньги нужно оформлять активно, не откладывая: остаток жилищного фонда, выплаты соцстраха, три выплаты при гибели на работе — разделы 25 и 19."]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Моя заметка"]},{"tag":"button","props":{"type":"button"},"children":["Запишите напоминание…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/ru/tip/29-11"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Предыдущий"]},"Чтобы поговорить с кем-то, звоните на 12356; несовершеннолетним и подросткам — на 12355; для визита к врачу обращайтесь в психологическую клинику"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/ru/tip/29-13"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Следующий"]},"Не стоит рассматривать смерть как способ погасить долги: в течение двух лет по страховке на случай смерти выплат не будет, не признают и несчастный случай на производстве, а долги всё равно списываются в первую очередь из наследства"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["Другие советы по этой теме"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/29-05"},"children":[{"tag":"strong","props":{},"children":["В первые полгода после потери супруга поручите приём лекарств, питание, сон и медицинские осмотры конкретному человеку"]},{"tag":"span","props":{},"children":["В первые полгода после смерти супруга вероятность умереть выше пример…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/29-06"},"children":[{"tag":"strong","props":{},"children":["Если у вас нет ни родственников, ни друзей, замените «человека, который за вами следит» на три вещи: соседа, которому можно дать ключ от дома, список социальной помощи в вашем районе и контакты экстренной помощи в телефоне"]},{"tag":"span","props":{},"children":["Если у вас нет ни родных, ни друзей, важно позаботиться о двух вещах:…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/29-07"},"children":[{"tag":"strong","props":{},"children":["Как поступить, если умер один из родителей: рассказать ребёнку правду, позволить ему присутствовать на прощании, не отправлять в другую среду"]},{"tag":"span","props":{},"children":["У детей, потерявших отца или мать до 18 лет, вероятность умереть в ра…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/29-08"},"children":[{"tag":"strong","props":{},"children":["Горе длится более полугода, жизнь не налаживается: когда обращаться к психиатру или клиническому психологу"]},{"tag":"span","props":{},"children":["Примерно у одного из десяти взрослых, переживших утрату близкого чело…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/29-09"},"children":[{"tag":"strong","props":{},"children":["Не стоит сразу тратить деньги на консультации по горю: сначала проверьте, действительно ли ваше горе застряло (см. симптомы из пункта 8)"]},{"tag":"span","props":{},"children":["Если предлагать психологическую помощь всем людям, пережившим утрату,…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/29-10"},"children":[{"tag":"strong","props":{},"children":["После раздельного проживания или развода не прекращайте медстраховку и не заменяйте её алкоголем"]},{"tag":"span","props":{},"children":["Анализ данных по 6,5 миллионам человек из 11 стран показал, что у люд…"]}]}]}]},{"tag":"a","props":{"className":"life-text-link","href":"/ru/book/29"},"children":["Читать всю тему: Что важно знать после тяжёлой утраты"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"15","height":