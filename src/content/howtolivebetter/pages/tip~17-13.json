{"path":"/tip/17-13","title":"老人记性越来越差、开始耽误过日子，带去医院的记忆门诊或者神经内科查一次，先排除抑郁、吃的药、听不清看不清这类能改的原因 | HowToLiveBetter","description":"记性越来越差，不一定就是老糊涂。先查有没有抑郁、药吃得不对、听不清看不清这些能改的原因。但真能治好的很少，痴呆里真正好转的不到百分之一。查早了还有个用处：趁老人还能自己做主，把将来谁替他管钱、管看病定下来。","lang":"zh","styles":["/sites/howtolivebetter/styles/bca54bebe9c1bd3b.css"],"bodyClass":"font-sans antialiased","nodes":[{"tag":"div","props":{"className":"life-site"},"children":[{"tag":"div","props":{"className":"life-header-slot","aria-hidden":"true"},"children":[]},{"tag":"header","props":{"className":"life-header"},"children":[{"tag":"div","props":{"className":"life-header-inner"},"children":[{"tag":"a","props":{"className":"life-brand","aria-label":"H ✳ HowToLiveBetter 首页","href":"/"},"children":[{"tag":"span","props":{"className":"life-brand-mark","aria-hidden":"true"},"children":["H",{"tag":"span","props":{},"children":["✳"]}]},{"tag":"span","props":{},"children":["HowToLive",{"tag":"span","props":{},"children":["Better"]}]}]},{"tag":"nav","props":{"className":"life-nav","aria-label":"主导航"},"children":[{"tag":"a","props":{"className":"life-nav-link","href":"/book"},"children":[{"tag":"span","props":{},"children":["阅读全书"]}]},{"tag":"a","props":{"className":"life-nav-link","href":"/top-50"},"children":[{"tag":"span","props":{},"children":["精选 50 条"]}]},{"tag":"a","props":{"className":"life-nav-link","href":"/daily"},"children":[{"tag":"span","props":{},"children":["每日任务"]}]},{"tag":"a","props":{"className":"life-nav-link","href":"/dashboard"},"children":[{"tag":"span","props":{},"children":["我的清单"]}]},{"tag":"button","props":{"type":"button","className":"life-nav-link life-nav-more","aria-haspopup":"menu","aria-expanded":"false"},"children":[{"tag":"span","props":{},"children":["更多"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"15","height":"15","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down","