rue"},"children":[{"tag":"path","props":{"d":"M18 20a6 6 0 0 0-12 0"},"children":[]},{"tag":"circle","props":{"cx":"12","cy":"10","r":"4"},"children":[]},{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},{"tag":"span","props":{},"children":["Войти"]}]}]}]},{"tag":"aside","props":{"className":"life-ad-space life-ad-space-sponsored life-ad-space-compact","data-ad-placement":"ad_header","data-ad-group":"reading","data-ad-creative":"read_product","data-ad-ready":"false","aria-label":"Реклама · Рекомендация сообщества"},"children":[{"tag":"div","props":{"className":"life-ad-space-brand"},"children":[{"tag":"img","props":{"src":"/sites/howtolivebetter/images/shengcai/logo.png","width":"565","height":"144","alt":"Официальный логотип Shengcai Youshu","decoding":"async"},"children":[]}]},{"tag":"div","props":{"className":"life-ad-space-copy"},"children":[{"tag":"span","props":{"className":"life-ad-space-label"},"children":["Реклама · Рекомендация сообщества"]},{"tag":"strong","props":{},"children":["Могут ли ваши знания стать полезным продуктом?"]},{"tag":"p","props":{},"children":["От электронных книг до инструментов: как участники находят потребности и создают то, чем можно пользоваться."]}]},{"tag":"div","props":{"className":"life-ad-space-actions"},"children":[{"tag":"a","props":{"className":"life-ad-space-link","href":"/ru/shengcaiyoushu?sc_group=reading&sc_creative=read_product&sc_placement=ad_header"},"children":["О сообществе и примерах",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"18","height":"18","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-up-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M7 7h10v10"},"children":[]},{"tag":"path","props":{"d":"M7 17 17 7"},"children":[]}]}]}]}]},{"tag":"div","props":{"className":"life-ad-layout life-ad-layout-toc"},"children":[{"tag":"div","props":{"className":"life-ad-rail","data-dock-active":"false","style":{"top":"94px"}},"children":[{"tag":"div","props":{"className":"life-ad-dock","hidden":true},"children":[{"tag":"aside","props":{"className":"life-ad-space life-ad-space-sponsored life-ad-space-compact","data-ad-placement":"ad_dock","data-ad-group":"reading","data-ad-creative":"read_product","data-ad-ready":"false","aria-label":"Реклама · Рекомендация сообщества"},"children":[{"tag":"button","props":{"type":"button","className":"life-ad-dismiss","aria-label":"Закрыть рекламу"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-x","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M18 6 6 18"},"children":[]},{"tag":"path","props":{"d":"m6 6 12 12"},"children":[]}]}]},{"tag":"div","props":{"className":"life-ad-space-brand"},"children":[{"tag":"img","props":{"src":"/sites/howtolivebetter/images/shengcai/logo.png","width":"565","height":"144","alt":"Официальный логотип Shengcai Youshu","decoding":"async"},"children":[]}]},{"tag":"div","props":{"className":"life-ad-space-copy"},"children":[{"tag":"span","props":{"className":"life-ad-space-label"},"children":["Реклама · Рекомендация сообщества"]},{"tag":"strong","props":{},"children":["Могут ли ваши знания стать полезным продуктом?"]},{"tag":"p","props":{},"children":["От электронных книг до инструментов: как участники находят потребности и создают то, чем можно пользоваться."]}]},{"tag":"div","props":{"className":"life-ad-space-actions"},"children":[{"tag":"a","props":{"className":"life-ad-space-link","href":"/ru/shengcaiyoushu?sc_group=reading&sc_creative=read_product&sc_placement=ad_dock"},"children":["О сообществе и примерах",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"18","height":"18","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-up-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M7 7h10v10"},"children":[]},{"tag":"path","props":{"d":"M7 17 17 7"},"children":[]}]}]}]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/ru/book/09"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"К содержанию"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["Частые юридические подводные камни для обычных людей"]},{"tag":"div","props":{"data-ad-dock-host":"true"},"children":[]},{"tag":"nav","props":{"aria-label":"Советы главы"},"children":[{"tag":"a","props":{"href":"/ru/tip/09-01"},"children":[{"tag":"span","props":{},"children":["01"]},"Не пересылайте в чатах сообщения о стихийных бедствиях, эпидемиях или происшествиях, достоверность которых неизвестна, не делайте фотошоп и не создавайте с помощью ИИ изображения места происшествия"]},{"tag":"a","props":{"href":"/ru/tip/09-02"},"children":[{"tag":"span","props":{},"children":["02"]},"Не публиковать и не пересылать изображения, мемы и комментарии, оскорбляющие героев и мучеников, не шутить над государственным флагом и гимном"]},{"tag":"a","props":{"href":"/ru/tip/09-03"},"children":[{"tag":"span","props":{},"children":["03"]},"После просмотра материалов на зарубежных сайтах их нужно сразу закрывать: не делать скриншоты, не пересылать, не размещать в чатах и не комментировать"]},{"tag":"a","props":{"href":"/ru/tip/09-04"},"children":[{"tag":"span","props":{},"children":["04"]},"Смотреть порнографию для личного пользования — это ваше право, но не стоит выкладывать её в чаты, продавать как «ресурсы» или создавать специальные группы"]},{"tag":"a","props":{"href":"/ru/tip/09-05"},"children":[{"tag":"span","props":{},"children":["05"]},"«Подработка»: вам предлагают использовать свою банковскую карту для получения денег, снятия наличных и переводов; какой бы вознаграждение ни предлагали, не соглашайтесь на это"]},{"tag":"a","props":{"href":"/ru/tip/09-06"},"children":[{"tag":"span","props":{},"children":["06"]},"Люди предлагают вам участвовать в «оформлении документов» для получения кредита и обещают процент от суммы — ничего из этого делать не стоит"]},{"tag":"a","props":{"href":"/ru/tip/09-07"},"children":[{"tag":"span","props":{},"children":["07"]},"Найти чужую банковскую карту и не снимать с неё деньги; найти телефон или кошелёк — связаться с владельцем или отнести в отделение полиции, а не забирать себе"]},{"tag":"a","props":{"href":"/ru/tip/09-08"},"children":[{"tag":"span","props":{},"children":["08"]},"Получать скидки можно только под своим настоящим именем: нельзя регистрировать множество фиктивных аккаунтов, используя виртуальные номера, и нельзя пытаться получать бонусы повторно, используя системные уязвимости"]},{"tag":"a","props":{"href":"/ru/tip/09-09"},"children":[{"tag":"span","props":{},"children":["09"]},"Не выбрасывайте ничего с балкона и из окон — ни окурки, ни мусорные пакеты, ни бутылки"]},{"tag":"a","props":{"href":"/ru/tip/09-10"},"children":[{"tag":"span","props":{},"children":["10"]},"Не покупайте в интернете имитации огнестрельного оружия, пневматические пистолеты и пистолеты с металлическими шариками; избегайте «игрушечного оружия» неизвестного происхождения"]},{"tag":"a","props":{"href":"/ru/tip/09-11"},"children":[{"tag":"span","props":{},"children":["11"]},"Перед покупкой дрона необходимо пройти регистрацию, запрещено летать над аэропортами, военными объектами и в зонах с ограниченным воздушным движением; также нельзя обходить ограничения по высоте"]},{"tag":"a","props":{"href":"/ru/tip/09-12"},"children":[{"tag":"span","props":{},"children":["12"]},"Не снимайте других тайком, не устанавливайте камеры в съёмных квартирах, гостевых домах и гостиничных номерах"]},{"tag":"a","props":{"href":"/ru/tip/09-13"},"children":[{"tag":"span","props":{},"children":["13"]},"Можно играть в маджонг и в карты: не брать проценты, не быть крупье, не организовывать игру за деньги, не участвовать в онлайн-азартных играх"]},{"tag":"a","props":{"href":"/ru/tip/09-14"},"children":[{"tag":"span","props":{},"children":["14"]},"Не употреблять диких животных в пищу, не покупать, не продавать и не держать под охраной находящихся животных в качестве домашних питомцев"]},{"tag":"a","props":{"href":"/ru/tip/09-15"},"children":[{"tag":"span","props":{},"children":["15"]},"Взыскание долга без задержания, лишения свободы или преследования до дома"]},{"tag":"a","props":{"href":"/ru/tip/09-16"},"children":[{"tag":"span","props":{},"children":["16"]},"Не одалживайте свой паспорт, не пользуйтесь чужим паспортом, не регистрируйтесь, не оформляйте карты и не покупайте билеты по чужим документам"]},{"tag":"a","props":{"href":"/ru/tip/09-17"},"children":[{"tag":"span","props":{},"children":["17"]},"Сотрудничайте с полицией: не сопротивляйтесь, не бейте и не пытайтесь отобрать камеру, особенно если вы выпили"]},{"tag":"a","props":{"href":"/ru/tip/09-18"},"children":[{"tag":"span","props":{},"children":["18"]},"Секс с девочкой младше 14 лет запрещён — «её согласие» не является оправданием"]},{"tag":"a","props":{"href":"/ru/tip/09-19"},"children":[{"tag":"span","props":{},"children":["19"]},"Рассчитайте все последствия перед тем, как поднять руку: арест, штрафы и тюремное заключение"]},{"tag":"a","props":{"href":"/ru/tip/09-20"},"children":[{"tag":"span","props":{},"children":["20"]},"Если родители не могут воспитывать ребенка, единственным законным выходом является регистрация в органах гражданской администрации: передача ребенка за деньги может квалифицироваться как торговля детьми, а оставление его без присмотра — как оставление в беде"]},{"tag":"a","props":{"href":"/ru/tip/09-21"},"children":[{"tag":"span","props":{},"children":["21"]},"Не подделывайте происшествия и не завышайте ущерб для получения выплат: это страховое мошенничество, а лица, которые помогают вам давать показания, проводить экспертизу или оценку ущерба, также привлекаются к ответственности"]},{"tag":"a","props":{"href":"/ru/tip/09-22"},"children":[{"tag":"span","props":{},"children":["22"]},"Не продавайте свои органы и не помогайте другим в поиске доноров: за одну почку можно получить чуть более 20 тысяч юаней, а перепродать её пациенту — уже за 200–220 тысяч; при этом все вырученные средства конфискуются, а к ним добавляется штраф в размере 10–20 кратной суммы сделки. Всего же за незаконную торговлю органами можно лишиться 10,34 миллиона юаней, а также выплатить штраф в размере 190 тысяч, 210 тысяч, 7,5 тысяч, 150 тысяч и 56 тысяч юаней"]},{"tag":"a","props":{"href":"/ru/tip/09-23"},"children":[{"tag":"span","props":{},"children":["23"]},"Не ходите на путаны: по умолчанию предусмотрено административное задержание на 10–15 суток, а не просто штраф"]},{"tag":"a","props":{"href":"/ru/tip/09-24"},"children":[{"tag":"span","props":{},"children":["24"]},"Перевод комиксов, размещение фильмов и сериалов, распространение ссылок на облачные хранилища и пиратских электронных книг без взимания платы — всё это тоже нарушение авторских прав; размещение рекламы и взимание членских взносов может привести к уголовному наказанию"]},{"tag":"a","props":{"href":"/ru/tip/09-25"},"children":[{"tag":"span","props":{},"children":["25"]},"Публикация фанфиков и вторичных произведений: как избежать нарушения авторских прав"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/ru/tip/09-26","data-status":"active"},"children":[{"tag":"span","props":{},"children":["26"]},"Не покупайте для самообороны дубинки, электрошокеры, кинжалы и перцовый спрей, чтобы носить с собой: хранение в машине тоже считается ношением"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"Навигация"},"children":[{"tag":"a","props":{"href":"/ru/book"},"children":["Книга"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/ru/book/09"},"children":["Глава 9"," ·"," ","Частые юридические подводные камни для обычных людей"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"09-26"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["26"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["Доказательства"," ","A"]}]},{"tag":"h1","props":{"lang":"ru"},"children":["Не покупайте для самообороны дубинки, электрошокеры, кинжалы и перцовый спрей, чтобы носить с собой: хранение в машине тоже считается ношением"]},{"tag":"p","props":{"lang":"ru","className":"life-entry-summary"},"children":["За обнаруженное ношение кинжала, выкидного ножа, полицейской дубинки, электрошокера и подобных вещей возможно задержание до 5 суток. Вокзал, торговый центр или автобус — 5–10 суток. Применение тоже может обернуться против вас: человек, получивший удар кулаком от невооруженного противника, ударил его заранее спрятанным ножом и получил 4 года за превышение самообороны."]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Затраты"]},{"tag":"p","props":{},"children":["Без денежных затрат. Уже купленное оставьте дома, не носит…"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Польза"]},{"tag":"p","props":{},"children":["Сначала статья 38 Закона о наказаниях за нарушения общественного порядка. Незаконное ношение контролируемых го…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"Отметить: Не покупайте для самообороны дубинки, электрошокеры, кинжалы и перцовый спрей, чтобы носить с собой: хранение в машине тоже считается ношением"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"Сделано"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"В планах"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"В избранное"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Поделиться советом"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Скрыть подробности"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Затраты"]},{"tag":"p","props":{},"children":["Без денежных затрат. Уже купленное оставьте дома, не носите наружу и не кладите в машину. При происшествии сначала отступите и вызовите полицию; отвечайте силой, только если избежать нападения нельзя."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Польза"]},{"tag":"p","props":{},"children":["Сначала статья 38 Закона о наказаниях за нарушения общественного порядка. Незаконное ношение контролируемых государством предметов, например арбалетов и кинжалов, влечет задержание до 5 суток, возможно со штрафом до 1000 юаней. При малозначительности — предупреждение или штраф до 500 юаней. Пронос в общественное место или общественный транспорт — задержание на 5–10 суток, возможно со штрафом до 1000 юаней. Статья 130 Уголовного кодекса строже: незаконный пронос контролируемых ножей в общественное место или транспорт, создающий опасность для общества при серьезных обстоятельствах, — до 3 лет. Критерии Министерства общественной безопасности 2007 года перечисляют пять типов контролируемых ножей. Первый — кинжал с рукоятью, гардой и кровостоком, угол острия меньше 60 градусов. Второй — трехгранный скребок. Третий — пружинный нож с автоматической фиксацией, обычно называемый выкидным. Четвертый — нож с углом острия меньше 60 градусов и клинком длиннее 150 мм. Пятый — с углом больше 60 градусов и клинком длиннее 220 мм. Незаточенные тренировочные и сувенирные ножи с закругленным острием не относятся к ним. Полицейская дубинка — специальное средство полиции. Закон о народной полиции разрешает владение и использование таких средств только полиции. У других их конфискуют; возможны задержание до 15 суток либо предупреждение и дополнительно штраф до 5 размеров незаконного дохода. Железнодорожный список запрещенных предметов включает полицейские дубинки, слезоточивые устройства, электрошокеры и защитные устройства как контролируемые предметы. Их нельзя ни брать с собой, ни сдавать в багаж. В машине их тоже обнаруживают: водитель с контролируемыми ножами прошел через проверочный пункт, полиция нашла их и назначила административное задержание. Последствия применения описаны в руководстве по самообороне: использование или подготовка оружия — один из факторов различения защиты и обоюдной драки. Официальное дело: Ян поссорился с человеком, тот пригрозил привести людей для мести. Ян пошел домой и спрятал на себе два ножа. Вернувшийся противник без оружия ударил его кулаком в лицо; Ян ударил ножом в грудь и живот, противник погиб. Суд признал защитный характер действий, но счел их превышением: нападение было лишь ударом кулака, а нож направлен в жизненно важные органы. Ян получил 4 года за умышленное причинение вреда здоровью (вся страна; Закон о наказаниях за нарушения общественного порядка действует с 1 января 2026 года)."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Первоисточники"]},{"tag":"p","props":{"className":"life-citations"},"children":["全国人大常委会 (2025). 治安管理处罚法（2025 年修订，第三十八条）. ",{"tag":"a","props":{"href":"https://www.spp.gov.cn/spp/fl/202506/t20250627_699863.shtml","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.spp.gov.cn/spp/fl/202506/t20250627_699863.shtml"]},"；全国人大 (1997). 刑法（第二十、一百三十条，这两条未经修正案修改）. ",{"tag":"a","props":{"href":"https://www.spp.gov.cn/spp/fl/201802/t20180206_364975.shtml","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.spp.gov.cn/spp/fl/201802/t20180206_364975.shtml"]},"；公安部 (2007). 关于印发《管制刀具认定标准》的通知（公通字〔2007〕2 号）. ",{"tag":"a","props":{"href":"https://www.gd.gov.cn/zwgk/wjk/zcfgk/content/post_2937075.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gd.gov.cn/zwgk/wjk/zcfgk/content/post_2937075.html"]},"（广东省人民政府转载）；全国人大常委会 (2012 修正). 人民警察法（第三十六条）. ",{"tag":"a","props":{"href":"https://jtgl.beijing.gov.cn/jgj/jgxx/flfg/fl/203770/index.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://jtgl.beijing.gov.cn/jgj/jgxx/flfg/fl/203770/index.html"]},"（北京市公安交通管理局转载）；国务院 (1996). 人民警察使用警械和武器条例（第三条）. ",{"tag":"a","props":{"href":"http://jyglj.guizhou.gov.cn/szs/zwgk/xxgkml/zcwj/201808/t20180807_25452524.html","target":"_blank","rel":"noopener noreferrer"},"children":["http://jyglj.guizhou.gov.cn/szs/zwgk/xxgkml/zcwj/201808/t20180807_25452524.html"]},"（贵州省监狱管理局转载）；国家铁路局、公安部 (2022). 关于公布《铁路旅客禁止、限制携带和托运物品目录》的公告（2022 年第 1 号）. ",{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/2022-05/31/content_5693212.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/zhengce/zhengceku/2022-05/31/content_5693212.htm"]},"；晋江市人民政府 (2022). 警方提醒！携带这些物品，可能会被拘留！. ",{"tag":"a","props":{"href":"https://www.jinjiang.gov.cn/ztzl/jjgazl/jfts/202209/t20220913_2775463.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.jinjiang.gov.cn/ztzl/jjgazl/jfts/202209/t20220913_2775463.htm"]},"；最高人民法院、最高人民检察院、公安部 (2020). 关于依法适用正当防卫制度的指导意见（法发〔2020〕31 号，第 9 条）. ",{"tag":"a","props":{"href":"https://www.court.gov.cn/zixun/xiangqing/251611.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.court.gov.cn/zixun/xiangqing/251611.html"]},"；最高人民法院 (2020). 涉正当防卫典型案例（案例四）. ",{"tag":"a","props":{"href":"https://www.court.gov.cn/zixun/xiangqing/251621.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.court.gov.cn/zixun/xiangqing/251621.html"]},"；最高人民检察院 (2018). 第十二批指导性案例（检例第 45 号陈某正当防卫案）. ",{"tag":"a","props":{"href":"https://www.spp.gov.cn/spp/jczdal/201812/t20181219_402920.shtml","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.spp.gov.cn/spp/jczdal/201812/t20181219_402920.shtml"]}]},{"tag":"a","props":{"href":"https://www.spp.gov.cn/spp/fl/202506/t20250627_699863.shtml","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Открыть источник"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Примечание автора"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["Получатель пользы — вы. Само ношение ножа не исключает законную самооборону автоматически. В руководящем прокурорском деле № 45 студента Чэня избивали 9 человек; он достал носимый с собой фруктовый нож и ответил, что все равно признали самообороной. Прокуратура указала: важен умысел на обоюдную драку, а не наличие инструмента. Недостатки в двух вещах. Во-первых, незаконный предмет наказуем уже при обычной проверке, независимо от использования. Во-вторых, нож под рукой легко применить в ответ на один удар или толчок; тяжкая травма и более серьезные последствия могут означать превышение обороны. Книга не нашла национального текста, запрещающего личное владение перцовым спреем; известно лишь, что его нельзя брать в поезд. Единого национального текста о признании продаваемых онлайн телескопических дубинок полицейскими также не найдено. При происшествии сначала см. раздел 8, пункт 10 (при конфликте сначала вызывайте полицию). Если отступать некуда — раздел 8, пункт 11 (неизбежному нападению можно дать отпор). Если незнакомец требует деньги в безлюдном месте, см. раздел 13, пункт 36."]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Моя заметка"]},{"tag":"button","props":{"type":"button"},"children":["Запишите напоминание…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/ru/tip/09-25"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Предыдущий"]},"Публикация фанфиков и вторичных произведений: как избежать нарушения авторских прав"]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["Другие советы по этой теме"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/09-19"},"children":[{"tag":"strong","props":{},"children":["Рассчитайте все последствия перед тем, как поднять руку: арест, штрафы и тюремное заключение"]},{"tag":"span","props":{},"children":["Если вы один раз поднимете руку: вас арестуют на 5–10 дней и оштрафую…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/09-20"},"children":[{"tag":"strong","props":{},"children":["Если родители не могут воспитывать ребенка, единственным законным выходом является регистрация в органах гражданской администрации: передача ребенка за деньги может квалифицироваться как торговля детьми, а оставление его без присмотра — как оставление в беде"]},{"tag":"span","props":{},"children":["Если воспитывать ребенка невозможно, есть один законный путь — обрати…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/09-21"},"children":[{"tag":"strong","props":{},"children":["Не подделывайте происшествия и не завышайте ущерб для получения выплат: это страховое мошенничество, а лица, которые помогают вам давать показания, проводить экспертизу или оценку ущерба, также привлекаются к ответственности"]},{"tag":"span","props":{},"children":["Подделка обстоятельств происшествия, завышение размера ущерба для пол…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/09-22"},"children":[{"tag":"strong","props":{},"children":["Не продавайте свои органы и не помогайте другим в поиске доноров: за одну почку можно получить чуть более 20 тысяч юаней, а перепродать её пациенту — уже за 200–220 тысяч; при этом все вырученные средства конфискуются, а к ним добавляется штраф в размере 10–20 кратной суммы сделки. Всего же за незаконную торговлю органами можно лишиться 10,34 миллиона юаней, а также выплатить штраф в размере 190 тысяч, 210 тысяч, 7,5 тысяч, 150 тысяч и 56 тысяч юаней"]},{"tag":"span","props":{},"children":["Схема «поиск донора в интернете и немедленная оплата» не имеет законн…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/09-23"},"children":[{"tag":"strong","props":{},"children":["Не ходите на путаны: по умолчанию предусмотрено административное задержание на 10–15 суток, а не просто штраф"]},{"tag":"span","props":{},"children":["Если вас поймают, не обойдётся лишь штрафом. Согласно закону, по умол…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/09-24"},"children":[{"tag":"strong","props":{},"children":["Перевод комиксов, размещение фильмов и сериалов, распространение ссылок на облачные хранилища и пиратских электронных книг без взимания платы — всё это тоже нарушение авторских прав; размещение рекламы и взимание членских взносов может привести к уголовному наказанию"]},{"tag":"span","props":{},"children":["Перевод и публикация чужих произведений без разрешения автора, даже е…"]}]}]}]},{"tag":"a","props":{"className":"life-text-link","href":"/ru/book/09"},"children":["Читать всю тему: Частые юридические подводные камни для обычных людей"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/s