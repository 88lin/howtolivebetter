c_placement=ad_dock"},"children":["О сообществе и примерах",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"18","height":"18","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-up-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M7 7h10v10"},"children":[]},{"tag":"path","props":{"d":"M7 17 17 7"},"children":[]}]}]}]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/ru/book/17"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"К содержанию"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["Пожилые люди в семье"]},{"tag":"div","props":{"data-ad-dock-host":"true"},"children":[]},{"tag":"nav","props":{"aria-label":"Советы главы"},"children":[{"tag":"a","props":{"href":"/ru/tip/17-01"},"children":[{"tag":"span","props":{},"children":["01"]},"Возьмите согласие у пожилого человека, пока он в здравом уме, и оформите письменное назначение опекуна"]},{"tag":"a","props":{"href":"/ru/tip/17-02"},"children":[{"tag":"span","props":{},"children":["02"]},"Составление завещания: важно помнить, что более позднее завещание отменяет предыдущее, а нотариально заверенное больше не имеет приоритета"]},{"tag":"a","props":{"href":"/ru/tip/17-03"},"children":[{"tag":"span","props":{},"children":["03"]},"Деньги пожилых людей следует хранить отдельно на специальном счёте, а для крупных трат ввести правило двойного подтверждения"]},{"tag":"a","props":{"href":"/ru/tip/17-04"},"children":[{"tag":"span","props":{},"children":["04"]},"Фраза, которую пожилой человек может произнести в любой момент, чтобы отговориться от нежелательных предложений"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/ru/tip/17-05","data-status":"active"},"children":[{"tag":"span","props":{},"children":["05"]},"Не стоит связываться ни с какими схемами «инвестиций в пенсионное обеспечение», где от пожилых людей требуют предоплаты: оформление карт, покупка мест в домах престарелых, приобретение жилья для пенсионеров, организация путешествий для пожилых и продажа товаров для них — всё это одна и та же схема незаконного привлечения средств"]},{"tag":"a","props":{"href":"/ru/tip/17-06"},"children":[{"tag":"span","props":{},"children":["06"]},"Не стоит связываться ни с какими другими программами «пенсия на основе недвижимости», кроме официальной программы страховых компаний. Ни в коем случае не давайте в залог свой дом ради покупки финансовых продуктов"]},{"tag":"a","props":{"href":"/ru/tip/17-07"},"children":[{"tag":"span","props":{},"children":["07"]},"Пожилые люди, которые длительное время лежат в постели или имеют тяжелую утрату функций, могут обратиться в органы медстраховки по месту регистрации за оформлением страховки на длительный уход; она предназначена не только для пожилых"]},{"tag":"a","props":{"href":"/ru/tip/17-08"},"children":[{"tag":"span","props":{},"children":["08"]},"Если в семье кто-то длительное время прикован к постели, пролежни становятся главной угрозой: нужно купить электрическую воздушную подушку, регулярно переворачивать больного и каждый день проверять места с выступающими костями"]},{"tag":"a","props":{"href":"/ru/tip/17-09"},"children":[{"tag":"span","props":{},"children":["09"]},"Если катаракта у пожилого человека уже мешает безопасно ходить, идите к офтальмологу за оценкой операции; при двух глазах второй не откладывайте надолго"]},{"tag":"a","props":{"href":"/ru/tip/17-10"},"children":[{"tag":"span","props":{},"children":["10"]},"Если пожилой человек выгуливает собаку, держите поводок в ладони, а не наматывайте на руку, делайте его короче и сначала приучите собаку не рваться вперёд на поводке"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"Навигация"},"children":[{"tag":"a","props":{"href":"/ru/book"},"children":["Книга"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/ru/book/17"},"children":["Глава 17"," ·"," ","Пожилые люди в семье"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"17-05"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["05"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["Доказательства"," ","A"]}]},{"tag":"h1","props":{"lang":"ru"},"children":["Не стоит связываться ни с какими схемами «инвестиций в пенсионное обеспечение», где от пожилых людей требуют предоплаты: оформление карт, покупка мест в домах престарелых, приобретение жилья для пенсионеров, организация путешествий для пожилых и продажа товаров для них — всё это одна и та же схема незаконного привлечения средств"]},{"tag":"p","props":{"lang":"ru","className":"life-entry-summary"},"children":["Любая схема пенсионного обеспечения, где от пожилых людей требуют предоплаты и обещают доход, является мошенничеством: оформление карт, предварительная оплата услуг, покупка мест в домах престарелых, приобретение жилья для пенсионеров, организация путешествий для пожилых, продажа товаров для них. Вернуть потраченные деньги по закону не получится, и убытки придётся нести самостоятельно. В официальных сообщениях приводятся примеры: одни злоумышленники под видом продажи мест в домах престарелых собрали 136 млн юаней, обманув более 2100 человек. Единственный способ предотвратить это — не дать людям заплатить."]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Затраты"]},{"tag":"p","props":{},"children":["Ничего не стоит. Просто зачитайте пожилым людям перечислен…"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Польза"]},{"tag":"p","props":{},"children":["Органы гражданской администрации выделяют пять основных признаков таких схем;"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"Отметить: Не стоит связываться ни с какими схемами «инвестиций в пенсионное обеспечение», где от пожилых людей требуют предоплаты: оформление карт, покупка мест в домах престарелых, приобретение жилья для пенсионеров, организация путешествий для пожилых и продажа товаров для них — всё это одна и та же схема незаконного привлечения средств"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"Сделано"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"В планах"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"В избранное"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Поделиться советом"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Скрыть подробности"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Затраты"]},{"tag":"p","props":{},"children":["Ничего не стоит. Просто зачитайте пожилым людям перечисленные ниже формы мошенничества — это займёт всего несколько минут. В дальнейшем, если предложат подобное, сразу отказывайтесь: не ходите на лекции, не посещайте экскурсии, не оставляйте контактные данные. Сложность в том, что если человек уже несколько раз бывал на таких мероприятиях и подружился с организаторами, его трудно отговорить."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Польза"]},{"tag":"p","props":{},"children":["Органы гражданской администрации выделяют пять основных признаков таких схем; знание этих признаков надёжнее, чем доверие конкретным лицам. Первый признак — выдача себя за организацию по пенсионному обеспечению: у мошенников нет реального учреждения, они арендуют помещение и заявляют о партнёрстве с настоящими домами престарелых. Второй признак — предложение «услуг по пенсионному обеспечению»: продажа «VIP-карт», «членских карт», «предоплатных карт», побуждение к предварительной оплате услуг при явном несоответствии количества предлагаемых мест реальным возможностям учреждения. Третий признак — инвестиции в «проекты по пенсионному обеспечению»: вложения в оздоровительные комплексы для пожилых, покупка вымышленных домов престарелых, долгосрочная аренда мест, система взаимопомощи «банк времени». При этом обещаются возврат вложенных средств, аренда с последующим выкупом и прочие выгоды. Четвёртый признак — продажа «товаров для пожилых»: выкуп товаров, хранение и перепродажа, возврат части средств при покупке, бесплатные медицинские осмотры, раздача подарков, проведение презентаций и лекций по оздоровлению, приглашение врачей для консультаций. Пятый признак — предложение «путешествий для пожилых»: дешёвые или бесплатные поездки, начисление бонусных баллов, которые можно обменять на услуги. Законодательно возврат таких средств не предусмотрен. В статье 25 Положения о предотвращении и пресечении незаконного привлечения средств указано: «Убытки, понесённые в результате участия в таких схемах, возлагаются на самих участников». То есть потерянные деньги придётся признать своими. В качестве примера можно привести случай, когда Дай Мопин и его сообщники под видом продажи мест в домах престарелых собрали 136 млн юаней, обманув более 2100 человек; Дай Мопин был приговорён к 15 годам лишения свободы и штрафу в 400 тыс. юаней. Цао Момин организовал мошенничество с инвестициями в пенсионную сферу, собрав 13,207 млрд юаней от более чем 110 тыс. человек; он был приговорён к пожизненному заключению, лишению политических прав и конфискации всего имущества. Продажа БАДов также относится к мошенничеству. Ни Моронг приглашал пожилых людей на бесплатные обеды, дарил подарки, предоставлял транспорт, после чего проводил лекции; спикеры использовали вымышленные биографии, примеры и завышенные цены, чтобы убедить слушателей в целебных свойствах противораковых средств. В итоге пожилые люди покупали «дигидрокверцетин» по цене, в десятки раз превышающей его реальную стоимость; общая сумма продаж составила более 620 тыс. юаней. Ни Моронг был приговорён к 10 годам и 3 месяцам лишения свободы с штрафом в 120 тыс. юаней (закон вступил в силу 1 мая 2021 года по всей стране)."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Первоисточники"]},{"tag":"p","props":{"className":"life-citations"},"children":["民政部 (2023). 关于养老服务领域非法集资的风险提示. ",{"tag":"a","props":{"href":"https://www.gov.cn/lianbo/bumen/202306/content_6886556.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/lianbo/bumen/202306/content_6886556.htm"]},"（中国政府网发布）；民政部、中国银保监会 (2021). 关于养老领域非法集资的风险提示. ",{"tag":"a","props":{"href":"https://www.mca.gov.cn/n152/n164/c36171/content.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.mca.gov.cn/n152/n164/c36171/content.html"]},"；国务院 (2021). 防范和处置非法集资条例（国务院令第 737 号，第二、二十五、三十条）. ",{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/2021-02/10/content_5586632.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/zhengce/zhengceku/2021-02/10/content_5586632.htm"]},"；最高人民检察院 (2022). 检察机关打击整治养老诈骗犯罪典型案例. ",{"tag":"a","props":{"href":"https://www.spp.gov.cn/xwfbh/wsfbt/202206/t20220617_560010.shtml","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.spp.gov.cn/xwfbh/wsfbt/202206/t20220617_560010.shtml"]},"；最高人民法院 (2025). 依法惩治涉民生领域诈骗犯罪典型案例（案例五 倪某荣诈骗案）. ",{"tag":"a","props":{"href":"https://www.court.gov.cn/zixun/xiangqing/482861.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.court.gov.cn/zixun/xiangqing/482861.html"]}]},{"tag":"a","props":{"href":"https://www.gov.cn/lianbo/bumen/202306/content_6886556.htm","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Открыть источник"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Примечание автора"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["Определять схему следует не по внешнему виду организации, а по двум критериям: требуется ли предоплата и обещается ли доход. Настоящие учреждения по пенсионному обеспечению продают услуги, а если в разговоре появляются слова «инвестиции», «доход», «возврат средств», значит, речь идёт о мошенничестве. То, что пожилых людей приглашают на лекции, поездки или медицинские осмотры, само по себе не является нарушением, и остановить это сложно. Единственный способ защиты — не дать им заплатить; для этого можно воспользоваться правилом двойного подтверждения из пункта 3. Если же деньги уже уплачены, необходимо немедленно позвонить по номеру 110 или 96110, чтобы заблокировать операцию, а также сообщить в местные органы, ответственные за борьбу с незаконным привлечением средств, как указано в пункте 8. Схема «пенси"]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Моя заметка"]},{"tag":"button","props":{"type":"button"},"children":["Запишите напоминание…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/ru/tip/17-04"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Предыдущий"]},"Фраза, которую пожилой человек может произнести в любой момент, чтобы отговориться от нежелательных предложений"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/ru/tip/17-06"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Следующий"]},"Не стоит связываться ни с какими другими программами «пенсия на основе недвижимости», кроме официальной программы страховых компаний. Ни в коем случае не давайте в залог свой дом ради покупки финансовых продуктов"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["Другие советы по этой теме"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/17-01"},"children":[{"tag":"strong","props":{},"children":["Возьмите согласие у пожилого человека, пока он в здравом уме, и оформите письменное назначение опекуна"]},{"tag":"span","props":{},"children":["Пока пожилой человек еще в полном уме, стоит потратить несколько соте…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/17-02"},"children":[{"tag":"strong","props":{},"children":["Составление завещания: важно помнить, что более позднее завещание отменяет предыдущее, а нотариально заверенное больше не имеет приоритета"]},{"tag":"span","props":{},"children":["Закон признает шесть видов завещаний, но при несоблюдении формальных …"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/17-03"},"children":[{"tag":"strong","props":{},"children":["Деньги пожилых людей следует хранить отдельно на специальном счёте, а для крупных трат ввести правило двойного подтверждения"]},{"tag":"span","props":{},"children":["Мошенники сначала дарят пожилым мелочи и окружают заботой, накапливаю…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/17-07"},"children":[{"tag":"strong","props":{},"children":["Пожилые люди, которые длительное время лежат в постели или имеют тяжелую утрату функций, могут обратиться в органы медстраховки по месту регистрации за оформлением страховки на длительный уход; она предназначена не только для пожилых"]},{"tag":"span","props":{},"children":["Страховка на длительный уход помогает оплачивать услуги по уходу за с…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/17-08"},"children":[{"tag":"strong","props":{},"children":["Если в семье кто-то длительное время прикован к постели, пролежни становятся главной угрозой: нужно купить электрическую воздушную подушку, регулярно переворачивать больного и каждый день проверять места с выступающими костями"]},{"tag":"span","props":{},"children":["Пролежни — это не просто поверхностная кожная травма. Среди 19 520 па…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/17-09"},"children":[{"tag":"strong","props":{},"children":["Если катаракта у пожилого человека уже мешает безопасно ходить, идите к офтальмологу за оценкой операции; при двух глазах второй не откладывайте надолго"]},{"tag":"span","props":{},"children":["У женщин 70+ ранняя операция на первом глазу за год снизила число пад…"]}]}]}]},{"tag":"a","props":{"className":"life-text-link","href":"/ru/book/17"},"children":["Читать всю тему: Пожилые люди в семье"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"15","height":"15","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"childr