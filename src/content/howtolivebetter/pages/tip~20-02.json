e lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["本主题的其他建议"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/20-04"},"children":[{"tag":"strong","props":{},"children":["前 6 个月只喂母乳，连水都不用喂，6 个月起加辅食并继续母乳"]},{"tag":"span","props":{},"children":["孩子出生后第一个小时里就开始喂奶。前 6 个月只喂母乳，连水都不用喂。满 6 个月起加辅食，每天要有含铁多的动物性食物，母乳接着喂到 2 岁或更久。母乳不够或者…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/20-05"},"children":[{"tag":"strong","props":{},"children":["冲奶粉用 70 ℃ 以上的水，冲好放凉再喂，喝剩的倒掉"]},{"tag":"span","props":{},"children":["奶粉不是无菌的，可能带一种细菌，新生儿感染后四成到八成会死。先倒热水，等降到约 73.8 ℃ 再放奶粉，能把这种菌杀到原来的十万分之一以下。热水会让维生素 C…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/20-06"},"children":[{"tag":"strong","props":{},"children":["不满 1 岁不喂蜂蜜"]},{"tag":"span","props":{},"children":["孩子不满 1 岁，不要喂蜂蜜。蜂蜜水、拌进辅食里的蜂蜜、含蜂蜜的糕点，都算。蜂蜜里可能带有引起肉毒中毒的细菌。大人肚子里的菌群能压住它，婴儿压不住。自家做的腌菜…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/20-07"},"children":[{"tag":"strong","props":{},"children":["出生时的维生素 K 针一定要打"]},{"tag":"span","props":{},"children":["新生儿身体里存的维生素 K 很少，不补可能出血，晚出现的那种常常是脑子里出血。在没普遍打这一针的地方，每 10 万个新生儿有 478 个出这种血。打了这一针，估…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/20-08"},"children":[{"tag":"strong","props":{},"children":["不满 3 个月的婴儿体温到 38 ℃ 就直接去医院，不在家观察"]},{"tag":"span","props":{},"children":["孩子不满 3 个月，体温到 38 ℃ 就直接去医院。不要在家观察，也不要先喂退烧药再等等看。这个月龄的孩子就算得的是严重细菌感染，也可能只表现为发热。所以「看着…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/20-09"},"children":[{"tag":"strong","props":{},"children":["无论多累多气都不要摇晃婴儿"]},{"tag":"span","props":{},"children":["婴儿的头大，脖子没力气。用力摇晃会让他脑子里、眼睛里出血，可能要了他的命，也可能留下一辈子的残疾。哄睡时轻轻晃不算，危险的是控制不住的猛晃。快压不住火时，把孩子…"]}]}]}]},{"tag":"a","props":{"className":"life-text-link","href":"/book/20"},"children":["阅读整个主题：刚出生的孩子怎么带 ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"15","height":"15","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]}]}]}]},{"tag":"aside","props":{"className":"life-ad-space life-ad-space-sponsored","data-ad-placement":"ad_footer","data-ad-group":"reading","data-ad-creative":"read_product","data-ad-ready":"false","aria-label":"广告 · 社区推荐"},"children":[{"tag":"div","props":{"className":"life-ad-space-brand"},"children":[{"tag":"img","props":{"src":"/sites/howtolivebetter/images/shengcai/logo.png","width":"565","height":"144","alt":"生财有术官方 Logo","decoding":"async"},"children":[]}]},{"tag":"div","props":{"className":"life-ad-space-copy"},"children":[{"tag":"span","props":{"className":"life-ad-space-label"},"children":["广告 · 社区推荐"]},{"tag":"strong","props":{},"children":["读过的知识，能不能做成有用的产品？"]},{"tag":"p","props":{},"children":["从电子书、资料到小工具，看看圈友怎样发现需求，把内容变成实际交付。"]}]},{"tag":"div","props":{"className":"life-ad-space-actions"},"children":[{"tag":"a","props":{"className":"life-ad-space-link","href":"/shengcaiyoushu?sc_group=reading&sc_creative=read_product&sc_placement=ad_footer"},"children":["看看社区与案例",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"18","height":"18","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-up-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M7 7h10v10"},"children":[]},{"tag":"path","props":{"d":"M7 17 17 7"},"children":[]}]}]},{"tag":"a","props":{"className":"life-ad-space-rent","href":"/advertise"},"children":