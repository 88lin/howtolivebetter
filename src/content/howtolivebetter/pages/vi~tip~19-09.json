[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"Hoàn tất"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"Kế hoạch thực hiện"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"Lưu"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Chia sẻ mẹo này"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Ẩn chi tiết"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Chi phí"]},{"tag":"p","props":{},"children":["Không tốn tiền. Lúc ký hợp đồng thì đọc hết từng dòng phần「thông báo nguy cơ bệnh nghề nghiệp」. Mỗi kết quả khám đều phải giữ một bản lại. Chỗ khó là phải hỏi trực tiếp và đòi được hồ sơ ngay tại chỗ."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Lợi ích"]},{"tag":"p","props":{},"children":["Luật phòng bệnh nghề nghiệp quy định, lúc ký hợp đồng lao động, đơn vị phải nói rõ bốn việc: làm việc đó có thể gây ra bệnh nghề nghiệp nào, để lại hậu quả gì, phòng ngừa ra sao, được hưởng gì. Nguyên văn điều luật là「如实告知劳动者，并在劳动合同中写明，不得隐瞒或者欺骗」. Sau khi đã ký hợp đồng mà lại điều chuyển bạn sang việc nguy hại chưa có trong hợp đồng thì phải thông báo thật lại, và bàn với bạn để sửa điều khoản hợp đồng. Đơn vị không làm được thì「劳动者有权拒绝从事存在职业病危害的作业，用人单位不得因此解除与劳动者所订立的劳动合同」. Tổng cộng ba lần khám: trước khi vào việc, trong thời gian làm việc, lúc rời việc.「职业健康检查费用由用人单位承担」, tiền do đơn vị chi, kết quả phải báo bằng văn bản cho chính người đó. Người chưa khám trước khi vào việc thì đơn vị không được bố trí làm việc có tiếp xúc với nguy cơ bệnh nghề nghiệp. Người vốn không phù hợp thể chất với kiểu việc đó (có chống chỉ định nghề nghiệp) thì cũng không được bố trí làm đúng những việc bị chống chỉ định ấy. Phát hiện tổn hại sức khoẻ liên quan tới công việc này thì phải điều chuyển người đó khỏi vị trí cũ và sắp xếp lại cho tử tế.**「对未进行离岗前职业健康检查的劳动者不得解除或者终止与其订立的劳动合同」**. Lúc nghỉ việc bạn「有权索取本人职业健康监护档案复印件，用人单位应当如实、无偿提供，并在所提供的复印件上签章」. Hồ sơ theo dõi sức khoẻ nghề nghiệp đó, đơn vị phải sao chép nguyên văn một bản cho bạn miễn phí, rồi đóng dấu lên bản sao (toàn quốc)"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Nguồn gốc"]},{"tag":"p","props":{"className":"life-citations"},"children":["全国人大常委会 (2018). 职业病防治法（2018 年修正，第三十三、三十五、三十六条）. ",{"tag":"a","props":{"href":"https://www.beijing.gov.cn/zhengce/zhengcefagui/qtwj/201711/t20171104_779851.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.beijing.gov.cn/zhengce/zhengcefagui/qtwj/201711/t20171104_779851.html"]},"（北京市人民政府转载）"]},{"tag":"a","props":{"href":"https://www.beijing.gov.cn/zhengce/zhengcefagui/qtwj/201711/t20171104_779851.html","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Liên kết mở nguồn"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Ghi chú sách"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["Lúc phỏng vấn mà hỏi ba câu thì đoán được đại thể chỗ này có nghiêm túc không: vị trí này có nguy cơ bệnh nghề nghiệp không, hợp đồng có ghi không, tiền khám trước khi vào việc do ai trả. Trả lời không nổi hoặc nói「làm trước đã」thì rủi ro tự tính lấy. Khám lúc rời việc là cái dễ bị bỏ sót nhất: không khám lúc rời việc thì đơn vị không được chấm dứt hoặc kết thúc hợp đồng lao động với bạn. Kết quả khám này sau này còn là hồ sơ then chốt để xin chẩn đoán bệnh nghề nghiệp, bản sao hồ sơ theo dõi cũng vậy, phải lấy được trước khi rời đi. Bản thân bệnh nghề nghiệp thì đi theo lối tai nạn lao động, quyền lợi xem mục 11 của phần này trở đi."]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Ghi chú của tôi"]},{"tag":"button","props":{"type":"button"},"children":["Viết một lời nhắc cho chính bạn…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/vi/tip/19-08"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Trước"]},"Trước khi nghỉ việc thì lưu trước phiếu lương, bản chấm công, hợp đồng lao động, hồ sơ bảo hiểm xã hội và lịch sử trò chuyện"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/vi/tip/19-10"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Tiếp theo"]},"Tổn thương do bụi, tiếng ồn, chất độc hoá học thì không hồi phục được: đơn vị phải cấp đồ dùng bảo vệ, công việc không có biện pháp bảo vệ thì được từ chối"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["Thêm trong chủ đề này"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/19-05"},"children":[{"tag":"strong","props":{},"children":["Công ty sa thải bạn mà không báo trước 30 ngày thì còn phải trả thêm một tháng lương"]},{"tag":"span","props":{},"children":["Công ty sa thải bạn vì sau khi ốm không làm nổi, không làm nổi công v…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/19-06"},"children":[{"tag":"strong","props":{},"children":["Công ty chấm dứt hợp đồng sai luật thì tiền bồi thường bằng hai lần mức bồi thường kinh tế"]},{"tag":"span","props":{},"children":["Nếu công ty chấm dứt hợp đồng sai luật thì tiền bồi thường gấp đôi mứ…"]}]}]},