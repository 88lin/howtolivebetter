hildren":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"分享这条建议"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"收起详情"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["成本"]},{"tag":"p","props":{"className":"life-citations"},"children":["0 到几十元，在社区或医院门诊填一份筛查问卷。12355 和 12356 两条热线打电话不要钱。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["收益"]},{"tag":"p","props":{"className":"life-citations"},"children":["美国预防服务工作组 2022 年发了一份推荐声明。它建议对 12 至 18 岁青少年筛查重度抑郁障碍（B 类推荐）。B 类的意思是把握中等、算下来好处也中等，值得做。对 11 岁及以下儿童筛查重度抑郁，证据不足（I 声明，即证据不够，给不出建议）。对儿童青少年专门筛查自杀风险，好处和坏处的证据都不足（I 声明）。文件指出，自杀是 10 至 19 岁人群的第二位死因。文件还指出，儿童青少年的重度抑郁和后来的很多问题关系密切。这些问题包括成年后抑郁反复发作、别的精神障碍，以及自杀念头、自杀未遂、自杀死亡的风险升高。《进一步加强中小学生心理健康工作十条措施》要求构建班主任、专兼职心理健康教师、精神科医师三级服务体系。每名学生每学年接受心理测评，一般不超过 1 次。文件还要求推进精神疾病转介就医和愈后复学机制。它要求发挥 12355 青少年服务台和 12356 心理援助热线的作用（全国，2025 年 10 月印发）"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["来源"]},{"tag":"p","props":{"className":"life-citations"},"children":["US Preventive Services Task Force (2022). Screening for Depression and Suicide Risk in Children and Adolescents: US Preventive Services Task Force Recommendation Statement. JAMA. ",{"tag":"a","props":{"href":"https://doi.org/10.1001/jama.2022.16946","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1001/jama.2022.16946"]},"；教育部办公厅 (2025). 进一步加强中小学生心理健康工作十条措施（教基厅〔2025〕2 号）. ",{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/202510/content_7045528.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/zhengce/zhengceku/202510/content_7045528.htm"]},""]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["原书备注"]},{"tag":"p","props":{"className":"life-citations"},"children":["给 B 是因为原文给的是推荐力度的评级，不是能换算成数字的效果。它还是美国的推荐，国内没有对应的官方筛查建议。筛查结果是阳性，只说明要再做一次评估，不等于确诊。有自杀念头时的处置见第 1 节第 25 条。家里的应对见第 29 节。"]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["我的备注"]},{"tag":"button","props":{"type":"button"},"children":["写下对自己有用的提醒…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/tip/30-07"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["上一条"]},"每年那次学生体检的报告单要自己看一遍，异常项当年带去医院查"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/tip/30-09"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["下一条"]},"不买号称能「治愈近视」「降低度数」的产品和服务"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["本主题的其他建议"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/30-04"},"children":[{"tag":"strong","props":{},"children":["让孩子每天在户外待够 2 小时，这是目前不花钱、不用药的办法里，唯一有随机试验支持的防近视办法"]},{"tag":"span","props":{},"children":["小学一年级每天多上 40 分钟户外课，三年后新近视的孩子从约四成降到约三成。卫健委给的量是每天白天在户外不少于 2 小时，或者一周加起来 14 小时。阴天也算数…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/30-05"},"children":[{"tag":"strong","props":{},"children":["0 到 3 岁不给屏幕，3 到 6 岁尽量不给，中小学生非学习用途每天不超过 1 小时"]},{"tag":"span","props":{},"children":["国家卫健委要求 0 到 3 岁不给屏幕，3 到 6 岁尽量别碰。中小学生不为学习用的，一次不超过 15 分钟、一天不超过 1 小时。理由是长时间近距离用眼会让近…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/30-06"},"children":[{"tag":"strong","props":{},"children":["把近视当成会留下的损伤：度数越深，将来视网膜脱离、黄斑病变、青光眼越多"]},{"tag":"span","props":{},"children":["近视不会自己好，度数也降不回去。它也不只是「戴个眼镜」的事。和不近视的人比，得近视性黄斑病变的可能，轻度近视高十几倍，600 度以上高几百倍。视网膜脱离，轻度高…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/30-10"},"children":[{"tag":"strong","props":{},"children":["睡眠、作业、体育和排名都有明文规定，学校做不到可以提"]},{"tag":"span","props":{},"children":["文件写明，小学生每天睡 10 小时，初中 9 小时，高中 8 小时。小学上午上课一般不早于 8:20，中学不早于 8:00。2025 年又规定每天体育活动不少于…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/30-11"},"children":[{"tag":"strong","props":{},"children":["孩子撑不住了可以休学，学籍学校必须给他留着，最长 1 年"]},{"tag":"span","props":{},"children":["休学有正式制度。父母或其他监护人提出申请，学校确认后报上级核准。一次最长 1 年，期满还要休就重新申请。休学期间学校要给孩子保留学籍，复学时回来接着上。具体办法…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/30-12"},"children":[{"tag":"strong","props":{},"children":["查出视力不良，去医院做散瞳验光，之后按医生给的间隔复查"]},{"tag":"span","props":{},"children":["散瞳验光是先滴一种眼药水，让眼睛里负责调焦的肌肉松下来，再验度数。这是在医院做的，诊断近视最准。卫健委写明这种药水对健康的眼睛不会造成损伤，停药后恢复正常。别拿…"]}]}]}]},{"tag":"a","props":{"className":"life-text-link","href":"/book/30"},"children":["阅读整个主题：上学以后的孩子 ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"15","height":"15","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]}]}]},{"tag":"nav","props":{"className":"life-tabbar","aria-label":"主导航"},"children":[{"tag":"a","props":{"className":"","href":"/book"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"21","height":"21","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-book-open","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M12 7v14"},"children":[]},{"tag":"path","props":{"d":"M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z"},"children":[]}]},{"tag":"span","props":{},"children":["全书"]}]},{"tag":"a","props":{"className":"","href":"/top-50"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"21","height":"21","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-star","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M11.525 2.295