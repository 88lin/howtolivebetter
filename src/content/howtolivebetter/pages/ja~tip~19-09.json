},"children":[]},{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},{"tag":"span","props":{},"children":["ログイン"]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/ja/book/19"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"目次に戻る"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["在職、離職、および労災"]},{"tag":"nav","props":{"aria-label":"この章のヒント"},"children":[{"tag":"a","props":{"href":"/ja/tip/19-01"},"children":[{"tag":"span","props":{},"children":["01"]},"残業代は 1.5 倍、2 倍、3 倍の3段階で計算されます。支払われない場合は労働監督署へ通報を。期限内に支払わない場合は 50% から 100% の追加支払い義務が生じます"]},{"tag":"a","props":{"href":"/ja/tip/19-02"},"children":[{"tag":"span","props":{},"children":["02"]},"年次有給休暇は累計勤続年数に基づき 5、10、15 日付与され、消化できなかった場合は日給の 300% で手当が支払われます"]},{"tag":"a","props":{"href":"/ja/tip/19-03"},"children":[{"tag":"span","props":{},"children":["03"]},"試用期間には法定の上限があり、給与は 80% を下回ってはならず、かつ一度しか設定できません"]},{"tag":"a","props":{"href":"/ja/tip/19-04"},"children":[{"tag":"span","props":{},"children":["04"]},"解雇時のN（経済補償金）の計算方法：勤続1年につき1ヶ月分の給与、6ヶ月未満は半月分"]},{"tag":"a","props":{"href":"/ja/tip/19-05"},"children":[{"tag":"span","props":{},"children":["05"]},"会社が 30 日前に通知せず解雇する場合、さらに1ヶ月分の給与を支払う必要がある"]},{"tag":"a","props":{"href":"/ja/tip/19-06"},"children":[{"tag":"span","props":{},"children":["06"]},"不当解雇（違法解雇）の場合、賠償金は経済補償金基準の2倍となる"]},{"tag":"a","props":{"href":"/ja/tip/19-07"},"children":[{"tag":"span","props":{},"children":["07"]},"「自己都合による自主退職」にはサインしないでください。一度サインしてしまうと、解雇予告手当（N）がもらえなくなります"]},{"tag":"a","props":{"href":"/ja/tip/19-08"},"children":[{"tag":"span","props":{},"children":["08"]},"退職前に、給与明細、勤怠記録、労働契約書、社会保険の記録、およびチャットの履歴を保存しておきましょう"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/ja/tip/19-09","data-status":"active"},"children":[{"tag":"span","props":{},"children":["09"]},"粉塵、騒音、化学物質を扱う業務に就く前に、契約書に危害に関する記載があるか確認しましょう。3回の職業健康診断は会社が手配し、費用を負担します"]},{"tag":"a","props":{"href":"/ja/tip/19-10"},"children":[{"tag":"span","props":{},"children":["10"]},"粉塵、騒音、化学毒物による損傷は不可逆：防護具は会社が提供しなければならず、防護措置のない作業は拒否できる"]},{"tag":"a","props":{"href":"/ja/tip/19-11"},"children":[{"tag":"span","props":{},"children":["11"]},"仕事中の負傷や通勤中の交通事故、まず最初に行うべきは労災認定。会社が申請しない場合は自分で申請できる"]},{"tag":"a","props":{"href":"/ja/tip/19-12"},"children":[{"tag":"span","props":{},"children":["12"]},"「出勤した時点で労災」を信じないで：急な体調不良時は、まず 120 へ。打刻のために急いで向かうのではなく。"]},{"tag":"a","props":{"href":"/ja/tip/19-13"},"children":[{"tag":"span","props":{},"children":["13"]},"会社が労災保険に加入していなくても、労災補償は受けられます。会社が同等の基準で全額負担します"]},{"tag":"a","props":{"href":"/ja/tip/19-14"},"children":[{"tag":"span","props":{},"children":["14"]},"症状が安定した後に労働能力鑑定を行い、障害等級を直接金額に換算する"]},{"tag":"a","props":{"href":"/ja/tip/19-15"},"children":[{"tag":"span","props":{},"children":["15"]},"労災死亡における3つの給付を明確に区別すること：葬儀補助金、扶養家族年金、一回限り労災死亡補助金"]},{"tag":"a","props":{"href":"/ja/tip/19-16"},"children":[{"tag":"span","props":{},"children":["16"]},"職場で長期にわたりいじめ、罵倒、嫌がらせを受けている場合、一人で耐え込まないこと：まずは証拠を残すために記録し、その性質に応じて、苦情申し立て、通報、または仲裁の手続きを進めること"]},{"tag":"a","props":{"href":"/ja/tip/19-17"},"children":[{"tag":"span","props":{},"children":["17"]},"退職時には会社に離職証明書を請求すること。契約期間、退職日、職種、勤続年数を明記させること"]},{"tag":"a","props":{"href":"/ja/tip/19-18"},"children":[{"tag":"span","props":{},"children":["18"]},"退職補償金を受け取る際はまず所得税を確認：現地の前年度従業員平均賃金の3倍以内は非課税、超過分は別途計算され、当年の給与とは合算されない"]},{"tag":"a","props":{"href":"/ja/tip/19-19"},"children":[{"tag":"span","props":{},"children":["19"]},"別の都市で働くときは、年金保険と医療保険の加入関係を新しい加入地へ移す。納付年数は累計されるので、脱退しない"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"現在地"},"children":[{"tag":"a","props":{"href":"/ja/book"},"children":["本を読む"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/ja/book/19"},"children":["第19章"," ·"," ","在職、離職、および労災"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"19-09"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["09"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["エビデンス"," ","A"]}]},{"tag":"h1","props":{"lang":"ja"},"children":["粉塵、騒音、化学物質を扱う業務に就く前に、契約書に危害に関する記載があるか確認しましょう。3回の職業健康診断は会社が手配し、費用を負担します"]},{"tag":"p","props":{"lang":"ja","className":"life-entry-summary"},"children":["契約締結時、会社は当該業務における職業病の危害、防護方法、および待遇について、事実に基づき契約書に記載しなければなりません。もし隠蔽されていた場合、あなたは当該業務を拒否することができ、会社はそれを理由にあなたを解雇することはできません。採用前、就業中、離職時の計3回の職業健康診断は、会社が手配し、費用を負担します。離職時の健康診断が行われていない場合、会社はあなたとの労働契約を解除することはできません。"]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["費用・手間"]},{"tag":"p","props":{},"children":["費用はかかりません。契約締結時には「職業病危害の告知」に関する部分を条文ごとにすべて確認してください。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["効果"]},{"tag":"p","props":{},"children":["職業病防治法（職業病予防法）の規定により、労働契約を締結する際、会社は以下の4点を明確に説明しなければなりません：この業務によってどのような職業病の危害が生じる可能性があるか、どのような結果（後遺症）を招くか、どのように…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"記録する：粉塵、騒音、化学物質を扱う業務に就く前に、契約書に危害に関する記載があるか確認しましょう。3回の職業健康診断は会社が手配し、費用を負担します"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"できている"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"やることに追加"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"お気に入り"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"このヒントを共有"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"詳細を閉じる"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["費用・手間"]},{"tag":"p","props":{},"children":["費用はかかりません。契約締結時には「職業病危害の告知」に関する部分を条文ごとにすべて確認してください。毎回の健康診断の結果は、各自で1部ずつ保管しておく必要があります。難しい点は、対面で質問し、対面で資料を受け取ることです。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["効果"]},{"tag":"p","props":{},"children":["職業病防治法（職業病予防法）の規定により、労働契約を締結する際、会社は以下の4点を明確に説明しなければなりません：この業務によってどのような職業病の危害が生じる可能性があるか、どのような結果（後遺症）を招くか、どのように防護するか、およびどのような待遇があるか。条文の原文には「労働者に対して事実を告知し、労働契約書に明記しなければならず、隠蔽または欺瞞をしてはならない」とあります。契約締結後に、契約書に記載のない有害な業務へ配置転換される場合は、改めて事実の告知を行い、契約条項の変更について協議する必要があります。会社がこれを怠った場合、「労働者は職業病の危害が存在する作業に従事することを拒否する権利を有し、使用者はこれを理由として労働者と締結した労働契約を解除してはならない」と定められています。健康診断は、採用前、就業期間中、離籍時の計3回です。「職業健康診断の費用は使用者が負担するものとする」とされており、費用は会社が支払い、結果は書面で本人に通知されなければなりません。採用前健康診断を受けていない者に対し、会社は職業病の危害に接触する業務への配置を行うことはできません。また、身体的条件がそもそも当該業務に適さない者（職業上の禁忌がある者）に対しても、これらの禁忌作業への配置は禁止されています。当該業務に関連する健康被害が判明した場合は、元の業務から配置転換し、適切な措置を講じなければなりません。**「離職前の職業健康診断を行っていない労働者に対し、締結済みの労働契約を解除または終了させてはならない」**。離職時、あなたは「自身の職業健康監視記録の写しを請求する権利を有し、使用者は事実に基づき無償で提供し、提供する写しに押印しなければならない」とされています。この職業健康監視記録については、会社は事実に基づいた写しを1部無料で提供し、その写しに社印を押印する必要があります（全国共通）。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["出典"]},{"tag":"p","props":{"className":"life-citations"},"children":["全国人大常委会 (2018). 职业病防治法（2018 年修正，第三十三、三十五、三十六条）. ",{"tag":"a","props":{"href":"https://www.beijing.gov.cn/zhengce/zhengcefagui/qtwj/201711/t20171104_779851.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.beijing.gov.cn/zhengce/zhengcefagui/qtwj/201711/t20171104_779851.html"]},"（北京市人民政府转载）"]},{"tag":"a","props":{"href":"https://www.beijing.gov.cn/zhengce/zhengcefagui/qtwj/201711/t20171104_779851.html","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["出典を開く"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["著者の注記"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["面接時に3つの質問をすることで、その会社がまともかどうかを概ね判断できます：この業務に職業病の危害があるか、契約書に記載されるか、採用前健康診断の費用は誰が負担するか。これらに答えられない、あるいは「まずは働いてみてから」と言う場合は、リスクを自分で判断してください。離職時の健康診断は最も見落とされやすい点です：離職時の健康診断が行われていない場合、会社はあなたとの労働契約を解除または終了させることはできません。この健康診断は、将来的に職業病の診断を申請する際の重要な資料となりますし、記録の写しも同様です。退職前に必ず手に入れておきましょう。職業病自体は労災として扱われるため、待遇については第 11 条以降を参照してください。"]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["自分のメモ"]},{"tag":"button","props":{"type":"button"},"children":["自分へのメモを書く…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/ja/tip/19-08"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["前へ"]},"退職前に、給与明細、勤怠記録、労働契約書、社会保険の記録、およびチャットの履歴を保存しておきましょう"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/ja/tip/19-10"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["次へ"]},"粉塵、騒音、化学毒物による損傷は不可逆：防護具は会社が提供しなければならず、防護措置のない作業は拒否できる"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["このテーマの他の提案"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/19-05"},"children":[{"tag":"strong","props":{},"children":["会社が 30 日前に通知せず解雇する場合、さらに1ヶ月分の給与を支払う必要がある"]},{"tag":"span","props":{},"children":["会社が、病気による就業不能、業務遂行不能、または状況の重大な変化を理由にあなたを解雇する場合、30日前の書面による通知を行わないのであれば…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/19-06"},"children":[{"tag":"strong","props":{},"children":["不当解雇（違法解雇）の場合、賠償金は経済補償金基準の2倍となる"]},{"tag":"span","props":{},"children":["会社による解雇が不当解雇（違法解除）に該当する場合、賠償金は経済補償金の基準の2倍、つまり一般に言われる「2N」となります。不当解雇に該当…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/19-07"},"children":[{"tag":"strong","props":{},"children":["「自己都合による自主退職」にはサインしないでください。一度サインしてしまうと、解雇予告手当（N）がもらえなくなります"]},{"tag":"span","props":{},"children":["「自己都合による自主退職」を認めるサインをしてしまうと、解雇予告手当と失業保険の両方を失うことになります。自ら退職を申し出ることは、本来、…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/19-11"},"children":[{"tag":"strong","props":{},"children":["仕事中の負傷や通勤中の交通事故、まず最初に行うべきは労災認定。会社が申請しない場合は自分で申請できる"]},{"tag":"span","props":{},"children":["仕事中の負傷は労災に当たります。通勤中の交通事故でも、あなたに主な責任がない場合は労災とみなされます。しかし、労災認定を行わなければ、医療…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/19-12"},"children":[{"tag":"strong","props":{},"children":["「出勤した時点で労災」を信じないで：急な体調不良時は、まず 120 へ。打刻のために急いで向かうのではなく。"]},{"tag":"span","props":{},"children":["急な体調不良のまま会社へ急いでも、手当が増えるわけではありません。労災とみなされるには、勤務時間内かつ勤務場所内での発症が条件であり、移動…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/19-13"},"children":[{"tag":"strong","props":{},"children":["会社が労災保険に加入していなくても、労災補償は受けられます。会社が同等の基準で全額負担します"]},{"tag":"span","props":{},"children":["会社が労災保険に加入していなくても、労災補償は同様に受けられます。単に、会社が同じ項目と基準に従って全額を支払う形に変わるだけで、一分も欠…"]}]}]}]},{"tag":"a","props":{"className":"life-text-link","href":"/ja/book/19"},"children":["テーマ全体を読む：在職、離職、および労災"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"15","height":"15","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","