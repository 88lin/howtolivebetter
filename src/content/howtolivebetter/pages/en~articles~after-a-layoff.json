 0 0 0-12 0"},"children":[]},{"tag":"circle","props":{"cx":"12","cy":"10","r":"4"},"children":[]},{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},{"tag":"span","props":{},"children":["Sign in to sync"]}]}]}]},{"tag":"main","props":{"className":"life-longread"},"children":[{"tag":"a","props":{"className":"life-back-link active","href":"/en/articles","data-status":"active","aria-current":"page"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"All long reads"]},{"tag":"header","props":{"className":"life-longread-header"},"children":[{"tag":"div","props":{},"children":[{"tag":"div","props":{"className":"life-eyebrow"},"children":["Long reads"]},{"tag":"h1","props":{"lang":"en"},"children":["What to Do First After a Layoff"]},{"tag":"p","props":{"lang":"en"},"children":["After a layoff or dismissal, the things you need to handle are scattered across Section 19, Section 7, and several other sections. Below they are ordered by time. Each step states …"]},{"tag":"a","props":{"className":"life-longread-chapter","href":"/en/book/19"},"children":["Related chapter"," · ","While employed, upon leaving the job, and for work‑related injuries",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"img","props":{"src":"/sites/howtolivebetter/images/book-chapters/19-work-rights-editorial.webp","srcSet":"/sites/howtolivebetter/images/book-chapters/19-work-rights-editorial-thumb.webp 600w, /sites/howtolivebetter/images/book-chapters/19-work-rights-editorial-md.webp 900w, /sites/howtolivebetter/images/book-chapters/19-work-rights-editorial.webp 1200w","sizes":"(max-width: 760px) 100vw, 450px","alt":"","width":"1200","height":"800","fetchPriority":"high"},"children":[]}]},{"tag":"div","props":{"className":"life-longread-layout"},"children":[{"tag":"aside","props":{"className":"life-longread-toc"},"children":[{"tag":"details","props":{"open":true},"children":[{"tag":"summary","props":{},"children":["On this page"]},{"tag":"nav","props":{"aria-label":"On this page"},"children":[{"tag":"a","props":{"href":"#the-day-of-before-you-sign-anything"},"children":["The day of: before you sign anything"]},{"tag":"a","props":{"href":"#that-day-through-the-first-few-days-nail-down-the-money"},"children":["That day through the first few days: nail down the money"]},{"tag":"a","props":{"href":"#the-first-week"},"children":["The first week"]},{"tag":"a","props":{"href":"#the-first-month"},"children":["The first month"]},{"tag":"a","props":{"href":"#the-months-after"},"children":["The months after"]}]}]}]},{"tag":"div","props":{"className":"life-longread-main"},"children":[{"tag":"article","props":{"className":"life-article-body","lang":"en"},"children":[{"tag":"blockquote","props":{},"children":["\n",{"tag":"p","props":{},"children":["Unofficial English translation of ",{"tag":"a","props":{"href":"/articles/after-a-layoff"},"children":["docs/被裁了之后先做什么.md"]},". In case of discrepancies the Chinese original takes precedence."]},"\n"]},"\n",{"tag":"p","props":{},"children":["After a layoff or dismissal, the things you need to handle are scattered across ",{"tag":"a","props":{"href":"/en/book/19","title":"While employed, upon leaving the job, and for work‑related injuries"},"children":["Section 19"]},", ",{"tag":"a","props":{"href":"/en/book/07","title":"How to get by when you have little money"},"children":["Section 7"]},", and several other sections. Below they are ordered by time. Each step states only what to do; details, numbers, and sources are in the entry cited in parentheses. If you are only owed wages and are still employed, go straight to ",{"tag":"a","props":{"href":"/en/book/07"},"children":["Section 7, item 2"]}," (wage arrears: complain to labor inspection first)."]},"\n",{"tag":"h2","props":{"id":"the-day-of-before-you-sign-anything"},"children":["The day of: before you sign anything"]},"\n",{"tag":"ol","props":{},"children":["\n",{"tag":"li","props":{},"children":["If the company hands you a “voluntary resignation for personal reasons” form, do not sign. If you sign, economic compensation and unemployment insurance benefits usually both disappear. See ",{"tag":"a","props":{"href":"/en/book/19"},"children":["Section 19, item 7"]}," (never sign “voluntary resignation for personal reasons”)."]},"\n",{"tag":"li","props":{},"children":["If they say “sign first to process the exit, compensation will come separately,” insist the compensation be written into the agreement on the spot. If it is not written in, do not sign; refusing to sign that day has no legal consequence. See ",{"tag":"a","props":{"href":"/en/book/19"},"children":["Section 19, item 7"]}," (never sign “voluntary resignation for personal reasons”)."]},"\n",{"tag":"li","props":{},"children":["Turn on a recorder for the conversation. For talks you attend yourself, you do not need the other party’s consent first. See ",{"tag":"a","props":{"href":"/en/book/08"},"children":["Section 8, item 41"]}," (start recording)."]},"\n",{"tag":"li","props":{},"children":["Before you return the computer and accounts, save pay stubs, attendance records, the employment contract, social-insurance records, and chat logs. See ",{"tag":"a","props":{"href":"/en/book/19"},"children":["Section 19, item 8"]}," (save evidence before leaving)."]},"\n",{"tag":"li","props":{},"children":["Save only your own employment-related materials. Do not take company source code, customer lists, or technical documents. See ",{"tag":"a","props":{"href":"/en/book/11"},"children":["Section 11, item 7"]}," (do not take source code when you leave)."]},"\n",{"tag":"li","props":{},"children":["Hand back account access cleanly: do not delete data or change passwords, even if the company owes you money. See ",{"tag":"a","props":{"href":"/en/book/11"},"children":["Section 11, item 6"]}," (return account access)."]},"\n"]},"\n",{"tag":"h2","props":{"id":"that-day-through-the-first-few-days-nail-down-the-money"},"children":["That day through the first few days: nail down the money"]},"\n",{"tag":"ol","props":{},"children":["\n",{"tag":"li","props":{},"children":["Calculate N first: one month’s salary per full year of service; half a month for periods under six months. See ",{"tag":"a","props":{"href":"/en/book/19"},"children":["Section 19, item 4"]}," (calculate N after a layoff)."]},"\n",{"tag":"li","props":{},"children":["Monthly salary is the average over the 12 months before you leave; bonuses, allowances, and subsidies all count. Employers often understate this. See ",{"tag":"a","props":{"href":"/en/book/19"},"children":["Section 19, item 4"]}," (calculate N after a layoff)."]},"\n",{"tag":"li","props":{},"children":["First ask which legal provision the company is using to terminate your employment. An extra month’s pay applies only in three situations: you cannot do the work after illness; you cannot perform the job even after training or reassignment; or the circumstances at the time of signing the contract have materially changed and negotiations have failed. In these three situations, if the company did not give you 30 days’ written notice, it must pay an extra month’s wages in addition to N. List this month separately when negotiating. Economic layoffs and termination by mutual agreement do not carry this extra month. See ",{"tag":"a","props":{"href":"/en/book/19#19-05","title":"If a company fires you without 30 days’ notice, it must pay an extra month’s salary"},"children":["Section 19, item 5"]}," (no 30-day advance notice)."]},"\n",{"tag":"li","props":{},"children":["For unlawful termination, compensation is 2N. Whether termination was unlawful—ask legal aid or a lawyer before you decide to negotiate or go to arbitration. See ",{"tag":"a","props":{"href":"/en/book/19"},"children":["Section 19, item 6"]}," (unlawful termination)."]},"\n",{"tag":"li","props":{},"children":["Unused annual leave must be paid out at separation, pro-rated to how much of the year you worked. See ",{"tag":"a","props":{"href":"/en/book/19"},"children":["Section 19, item 2"]}," (annual leave)."]},"\n",{"tag":"li","props":{},"children":["Include any unpaid overtime in the total. See ",{"tag":"a","props":{"href":"/en/book/19"},"children":["Section 19, item 1"]}," (overtime pay)."]},"\n"]},"\n",{"tag":"h2","props":{"id":"the-first-week"},"children":["The first week"]},"\n",{"tag":"ol","props":{},"children":["\n",{"tag":"li","props":{},"children":["Register as unemployed. Unemployment insurance starts from the registration date; a month’s delay costs you a month of benefits. See ",{"tag":"a","props":{"href":"/en/book/07"},"children":["Section 7, item 1"]}," (unemployment insurance)."]},"\n",{"tag":"li","props":{},"children":["Unemployment registration is done at public employment service agencies such as employment service centers; there is no fee. See ",{"tag":"a","props":{"href":"/en/book/07"},"children":["Section 7, item 5"]}," (public employment services)."]},"\n",{"tag":"li","props":{},"children":["Apply for unemployment insurance on the “掌上 12333” app or the electronic social-security card mini-program. You need at least one year of contributions and a separation that was not voluntary resignation. See ",{"tag":"a","props":{"href":"/en/book/07"},"children":["Section 7, item 1"]}," (unemployment insurance)."]},"\n",{"tag":"li","props":{},"children":["While you receive unemployment insurance, employee medical insurance is paid through the unemployment insurance system; you do not enroll separately. See ",{"tag":"a","props":{"href":"/en/book/07"},"children":["Section 7, item 1"]}," (unemployment insurance)."]},"\n",{"tag":"li","props":{},"children":["If you cannot afford to sue, call 12348 for legal aid. You no longer need to obtain a poverty certificate from your hometown. See ",{"tag":"a","props":{"href":"/en/book/07"},"children":["Section 7, item 3"]}," (legal aid)."]},"\n",{"tag":"li","props":{},"children":["If you signed a non-compete agreement, keep the original. The company must pay monthly compensation; if it fails to pay for three months for reasons on the company’s side, you may seek to terminate the agreement. See ",{"tag":"a","props":{"href":"/en/book/11"},"children":["Section 11, item 12"]}," (non-compete agreement)."]},"\n",{"tag":"li","props":{},"children":["Fix your daily routine: get up at a set time and schedule job search as a fixed block; do not stay home all day. See ",{"tag":"a","props":{"href":"/en/book/29"},"children":["Section 29, item 3"]}," (after job loss, fix your routine first)."]},"\n"]},"\n",{"tag":"h2","props":{"id":"the-first-month"},"children":["The first month"]},"\n",{"tag":"ol","props":{},"children":["\n",{"tag":"li","props":{},"children":["If wages or overtime pay are still unpaid, call 12333 to complain to labor inspection first, then apply for labor arbitration. Both routes are free. See ",{"tag":"a","props":{"href":"/en/book/07"},"children":["Section 7, item 2"]}," (wage arrears: labor inspection first)."]},"\n",{"tag":"li","props":{},"children":["If your employer was an unlicensed workshop, you still use inspection and arbitration. Money owed by a labor subcontractor goes against the general contractor; work for a household or individual as a private helper goes to court. See ",{"tag":"a","props":{"href":"/en/book/07"},"children":["Section 7, item 22"]}," (figure out who employed you)."]},"\n",{"tag":"li","props":{},"children":["Labor arbitration must be filed within one year after leaving. After the deadline, “time limit exceeded” is enough for the other side. See ",{"tag":"a","props":{"href":"/en/book/08"},"children":["Section 8, item 19"]}," (one-year labor arbitration limit)."]},"\n",{"tag":"li","props":{},"children":["For job search, start at public employment service agencies; job placement and career guidance are free—do not use paid agencies. See ",{"tag":"a","props":{"href":"/en/book/07"},"children":["Section 7, item 5"]}," (public employment services)."]},"\n",{"tag":"li","props":{},"children":["Do not rely on résumés alone. Learn job-search skills, set clear targets, and ask contacts for referrals. See ",{"tag":"a","props":{"href":"/en/book/07"},"children":["Section 7, item 14"]}," (systematic job search)."]},"\n",{"tag":"li","props":{},"children":["Refuse on the spot offers to “pay first before starting,” “train first then get placed,” or “recruit others to join.” See ",{"tag":"a","props":{"href":"/en/book/07"},"children":["Section 7, item 15"]}," (no “training loans”)."]},"\n",{"tag":"li","props":{},"children":["Before paying for skills training, check your local human-resources bureau’s vocational training subsidy catalog. See ",{"tag":"a","props":{"href":"/en/book/07"},"children":["Section 7, item 13"]}," (vocational training subsidies)."]},"\n",{"tag":"li","props":{},"children":["See whether you qualify for “person facing employment difficulties” recognition—for example older age or long-term unemployment. Once recognized, you may get social-insurance subsidies and priority for public-interest jobs. See ",{"tag":"a","props":{"href":"/en/book/07"},"children":["Section 7, item 12"]}," (employment-difficulties recognition)."]},"\n"]},"\n",{"tag":"h2","props":{"id":"the-months-after"},"children":["The months after"]},"\n",{"tag":"ol","props":{},"children":["\n",{"tag":"li","props":{},"children":["Cover living costs from your emergency fund first; do not borrow and do not sell investments at a loss. See ",{"tag":"a","props":{"href":"/en/book/05"},"children":["Section 5, item 27"]}," (emergency fund)."]},"\n",{"tag":"li","props":{},"children":["In the first three months, postpone irreversible decisions: selling a home, investing a lump-sum severance, partnerships, guaranteeing others’ debts—all count. See ",{"tag":"a","props":{"href":"/en/book/29"},"children":["Section 29, item 12"]}," (irreversible decisions)."]},"\n",{"tag":"li","props":{},"children":["When unemployment insurance runs out and you still have no job, do not leave medical coverage empty. You can pay resident medical insurance yearly yourself; after a break in payment, claims are denied for three months. See ",{"tag":"a","props":{"href":"/en/book/07"},"children":["Section 7, item 9"]}," (resident medical insurance)."]},"\n",{"tag":"li","props":{},"children":["A break in pension contributions does not zero out past years; benefits use cumulative years. Do not pay someone for illegal “affiliated” enrollment. See ",{"tag":"a","props":{"href":"/en/book/07"},"children":["Section 7, item 18"]}," (social insurance lapse)."]},"\n",{"tag":"li","props":{},"children":["If household income falls below the local minimum-living guarantee line, apply for dibao. See ",{"tag":"a","props":{"href":"/en/book/07"},"children":["Section 7, item 7"]}," (apply for dibao)."]},"\n",{"tag":"li","props":{},"children":["If you need someone to talk to, call 12356; it is free. See ",{"tag":"a","props":{"href":"/en/book/29"},"children":["Section 29, item 11"]}," (call 12356)."]},"\n",{"tag":"li","props":{},"children":["For money still owed to you, watch the one-year deadline from the date you left. See ",{"tag":"a","props":{"href":"/en/book/08"},"children":["Section 8, item 19"]}," (one-year labor arbitration limit)."]},"\n"]},"\n"]},{"tag":"footer","props":{"className":"life-article-attribution"},"children"