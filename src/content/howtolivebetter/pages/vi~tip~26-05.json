ldren":[{"tag":"path","props":{"d":"M18 20a6 6 0 0 0-12 0"},"children":[]},{"tag":"circle","props":{"cx":"12","cy":"10","r":"4"},"children":[]},{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},{"tag":"span","props":{},"children":["Đăng nhập để đồng bộ hóa"]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/vi/book/26"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"Quay lại mục lục"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["Làm một trang web hoặc nền tảng: giấy phép, đăng ký, máy chủ"]},{"tag":"nav","props":{"aria-label":"Các mục trong chương"},"children":[{"tag":"a","props":{"href":"/vi/tip/26-01"},"children":[{"tag":"span","props":{},"children":["01"]},"Để tiền không đi vào tài khoản của nền tảng rồi mới chuyển cho người bán, hãy cho tiền đi thẳng qua tổ chức thanh toán được cấp phép"]},{"tag":"a","props":{"href":"/vi/tip/26-02"},"children":[{"tag":"span","props":{},"children":["02"]},"Trang web thu phí thì cần giấy phép, bên tự bán hàng không cho người khác tham gia thì không cần, bên trung gian kết nối giao dịch là loại giấy phép khác, trang web miễn phí chỉ cần đăng ký khai báo"]},{"tag":"a","props":{"href":"/vi/tip/26-03"},"children":[{"tag":"span","props":{},"children":["03"]},"Phát trực tiếp thì cần giấy phép kinh doanh văn hóa trên mạng, còn giấy phép chương trình nghe nhìn thì công ty tư nhân gần như không xin được"]},{"tag":"a","props":{"href":"/vi/tip/26-04"},"children":[{"tag":"span","props":{},"children":["04"]},"Máy chủ đặt trong nước thì phải đăng ký khai báo, và nhà cung cấp dịch vụ truy cập phải tự có giấy phép viễn thông giá trị gia tăng"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/vi/tip/26-05","data-status":"active"},"children":[{"tag":"span","props":{},"children":["05"]},"Cho người dùng lên bán hàng thì nền tảng phải kiểm tra đăng ký, báo thông tin và lưu giữ ba năm"]},{"tag":"a","props":{"href":"/vi/tip/26-06"},"children":[{"tag":"span","props":{},"children":["06"]},"Nội dung người dùng đăng lên là bạn phải quản: có cơ chế duyệt, có cửa sổ báo việc, thấy nội dung vi phạm thì dừng truyền ngay và báo cáo"]},{"tag":"a","props":{"href":"/vi/tip/26-07"},"children":[{"tag":"span","props":{},"children":["07"]},"Cung cấp dịch vụ đăng thông tin và nhắn tin tức thì phải yêu cầu người dùng cung cấp thông tin danh tính thật"]},{"tag":"a","props":{"href":"/vi/tip/26-08"},"children":[{"tag":"span","props":{},"children":["08"]},"Không mở phát trực tiếp cho người chưa đủ 16 tuổi, tiền thưởng xử lý theo bậc tuổi"]},{"tag":"a","props":{"href":"/vi/tip/26-09"},"children":[{"tag":"span","props":{},"children":["09"]},"Nhận được thông báo vi phạm thì phải xử lý kịp thời, chuyển bản giải trình mà sau 15 ngày không có động tĩnh thì khôi phục lại"]},{"tag":"a","props":{"href":"/vi/tip/26-10"},"children":[{"tag":"span","props":{},"children":["10"]},"Đừng tùy tiện đặt thông tin người dùng ra nước ngoài, việc chuyển dữ liệu ra nước ngoài có điều kiện luật định và có ngưỡng số người"]},{"tag":"a","props":{"href":"/vi/tip/26-11"},"children":[{"tag":"span","props":{},"children":["11"]},"Chọn máy chủ thì xem sập có chịu được không, xem có ai trực vận hành không, cuối cùng mới so giá"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"Breadcrumbs"},"children":[{"tag":"a","props":{"href":"/vi/book"},"children":["Khám phá cuốn sách"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/vi/book/26"},"children":["Chương 26"," ·"," ","Làm một trang web hoặc nền tảng: giấy phép, đăng ký, máy chủ"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"26-05"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["05"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["Bằng chứng"," ","A"]}]},{"tag":"h1","props":{"lang":"vi"},"children":["Cho người dùng lên bán hàng thì nền tảng phải kiểm tra đăng ký, báo thông tin và lưu giữ ba năm"]},{"tag":"p","props":{"lang":"vi","className":"life-entry-summary"},"children":["Cho người khác lên nền tảng của bạn bán hàng thì trước hết bạn phải kiểm tra danh tính, địa chỉ, thông tin liên lạc và giấy phép của người bán, rồi đăng ký và lập hồ sơ. Lập hồ sơ xong thì ít nhất sáu tháng sau phải quay lại kiểm tra một lần. Người bán là ai thì báo cho cơ quan quản lý thị trường, tình hình kê thuế thì mỗi quý báo cho cơ quan thuế. Thông tin hàng hóa và bản ghi giao dịch giữ ba năm. Bỏ sót một việc thì trước hết bị buộc sửa, không sửa thì phạt tiền 2 vạn đến 10 vạn tệ."]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Chi phí"]},{"tag":"p","props":{},"children":["Không tốn tiền. Phải làm thủ tục kiểm tra tư cách người bá…"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Lợi ích"]},{"tag":"p","props":{},"children":["Luật có một đoạn yêu cầu với nền tảng. Nguyên văn là「应当要求申请进入平台销售商品或者提供服务的经营者提交其身份、地址、联系方式、行政许可等真实信息，进行核验、登记，建…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"Đánh dấu: Cho người dùng lên bán hàng thì nền tảng phải kiểm tra đăng ký, báo thông tin và lưu giữ ba năm"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"Hoàn tất"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"Kế hoạch thực hiện"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"Lưu"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Chia sẻ mẹo này"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Ẩn chi tiết"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Chi phí"]},{"tag":"p","props":{},"children":["Không tốn tiền. Phải làm thủ tục kiểm tra tư cách người bán trong hệ thống nền trả, còn phải lập một hồ sơ đăng ký. Mỗi quý báo một lần thông tin liên quan thuế, dữ liệu giao dịch giữ ba năm. Chỗ khó là đây là việc lặp lại hằng năm, không phải làm một lần là xong."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Lợi ích"]},{"tag":"p","props":{},"children":["Luật có một đoạn yêu cầu với nền tảng. Nguyên văn là「应当要求申请进入平台销售商品或者提供服务的经营者提交其身份、地址、联系方式、行政许可等真实信息，进行核验、登记，建立登记档案，并定期核验更新」— phải yêu cầu người kinh doanh xin vào nền tảng để bán hàng hoặc cung cấp dịch vụ nộp đúng thông tin thật gồm danh tính, địa chỉ, thông tin liên lạc và giấy phép hành chính, rồi kiểm tra, đăng ký, lập hồ sơ đăng ký, và định kỳ kiểm tra cập nhật lại. Trước khi người bán vào bán, anh ta phải nộp danh tính, địa chỉ, thông tin liên lạc và giấy phép mà anh ta phải có. Bạn kiểm tra một lượt, đăng ký và lập hồ sơ, sau đó còn phải quay lại kiểm tra sau một thời gian.「定期」là bao lâu? Quy chế của cơ quan có quyền nói rõ hơn:「至少每六个月核验更新一次」— ít nhất sáu tháng kiểm tra cập nhật một lần. Bạn còn phải báo thông tin danh tính của người kinh doanh trong nền tảng cho cơ quan quản lý thị trường. Phía thuế cũng phải báo, nguyên văn là「依照税收征收管理法律、行政法规的规定，向税务部门报送平台内经营者的身份信息和与纳税有关的信息」— theo luật và pháp lệnh về quản lý thuế, báo thông tin danh tính của người kinh doanh trong nền tảng và thông tin liên quan thuế cho cơ quan thuế. Nên người bán là ai thì báo cho cơ quan quản lý thị trường, còn danh tính và tình hình kê thuế của người bán thì báo cho cơ quan thuế. Thông tin hàng hóa, dịch vụ và giao dịch「保存时间自交易完成之日起不少于三年」— thời gian lưu giữ tính từ ngày giao dịch hoàn tất, không được ít hơn ba năm, tức là tính từ ngày một giao dịch xong là dữ liệu phải lưu ít nhất ba năm. Bất kỳ việc nào ở trên mà không làm thì bị buộc sửa trong thời hạn. Quá hạn không sửa thì phạt tiền 2 vạn đến 10 vạn tệ. Nghiêm trọng thì bị buộc đình chỉ kinh doanh để chỉnh phục, rồi phạt tiền 10 vạn đến 50 vạn tệ. Thông tin liên quan thuế phải「于季度终了的次月内」báo, tức là phải báo xong trong tháng kế tiếp sau khi kết thúc quý. Không báo đúng hạn thì mức phạt y hệt (toàn quốc)"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Nguồn gốc"]},{"tag":"p","props":{"className":"life-citations"},"children":["全国人大常委会 (2018). 电子商务法（第十、二十七、二十八、三十一、八十条）. ",{"tag":"a","props":{"href":"https://flk.npc.gov.cn/detail?id=2c909fdd678bf17901678bf8af050b81","target":"_blank","rel":"noopener noreferrer"},"children":["https://flk.npc.gov.cn/detail?id=2c909fdd678bf17901678bf8af050b81"]}," ; 市场监管总局 (2021). 网络交易监督管理办法（市场监管总局令第 37 号，第八、二十四、二十五、三十一条）. ",{"tag":"a","props":{"href":"https://www.gov.cn/gongbao/content/2021/content_5602020.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/gongbao/content/2021/content_5602020.htm"]}," ; 国务院 (2025). 互联网平台企业涉税信息报送规定（国务院令第 810 号，第二、三、四、十条）. ",{"tag":"a","props":{"href":"https://www.gov.cn/gongbao/2025/issue_12146/202507/content_7030983.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/gongbao/2025/issue_12146/202507/content_7030983.html"]}," ; 国家税务总局 (2025). 关于互联网平台企业报送涉税信息有关事项的公告（税务总局公告 2025 年第 15 号）. ",{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/202506/content_7029727.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/zhengce/zhengceku/202506/content_7029727.htm"]}]},{"tag":"a","props":{"href":"https://flk.npc.gov.cn/detail?id=2c909fdd678bf17901678bf8af050b81","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Liên kết mở nguồn"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Ghi chú sách"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["Người bán cũng phải tự đi đăng ký chủ thể kinh doanh. Luật liệt kê vài trường hợp không phải đăng ký:「个人销售自产农副产品、家庭手工业产品，个人利用自己的技能从事依法无须取得许可的便民劳务活动和零星小额交易活动」.「零星小额」có một con số cụ thể, Điều 8 của Quy định quản lý và giám sát giao dịch trên mạng ấn định là giá trị giao dịch trong một năm là 10 vạn tệ. Phía nền tảng còn phải làm hai việc: đánh dấu riêng người bán đã đăng ký và chưa đăng ký, và không cho xóa đánh giá của người tiêu dùng"]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Ghi chú của tôi"]},{"tag":"button","props":{"type":"button"},"children":["Viết một lời nhắc cho chính bạn…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/vi/tip/26-04"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Trước"]},"Máy chủ đặt trong nước thì phải đăng ký khai báo, và nhà cung cấp dịch vụ truy cập phải tự có giấy phép viễn thông giá trị gia tăng"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/vi/tip/26-06"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Tiếp theo"]},"Nội dung người dùng đăng lên là bạn phải quản: có cơ chế duyệt, có cửa sổ báo việc, thấy nội dung vi phạm thì dừng truyền ngay và báo cáo"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["Thêm trong chủ đề này"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/26-01"},"children":[{"tag":"strong","props":{},"children":["Để tiền không đi vào tài khoản của nền tảng rồi mới chuyển cho người bán, hãy cho tiền đi thẳng qua tổ chức thanh toán được cấp phép"]},{"tag":"span","props":{},"children":["Tiền của người mua vào tài khoản của bạn trước, rồi bạn chuyển tiếp c…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/26-02"},"children":[{"tag":"strong","props":{},"children":["Trang web thu phí thì cần giấy phép, bên tự bán hàng không cho người khác tham gia thì không cần, bên trung gian kết nối giao dịch là loại giấy phép khác, trang web miễn phí chỉ cần đăng ký khai báo"]},{"tag":"span","props":{},"children":["Trang web thu tiền người dùng thì phải xin giấy phép kinh doanh dịch …"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/26-03"},"children":[{"tag":"strong","props":{},"children":["Phát trực tiếp thì cần giấy phép kinh doanh văn hóa trên mạng, còn giấy phép chương trình nghe nhìn thì công ty tư nhân gần như không xin được"]},{"tag":"span","props":{},"children":["Phát trực tiếp hay thuyết minh trò chơi thì cần giấy phép kinh doanh …"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/26-07"},"children":[{"tag":"strong","props":{},"children":["Cung cấp dịch vụ đăng thông tin và nhắn tin tức thì phải yêu cầu người dùng cung cấp thông tin danh tính thật"]},{"tag":"span","props":{},"children":["Trang web của bạn cho đăng bài hoặc cho nhắn tin thì khi người dùng m…"]}]}]},{"tag":"li",