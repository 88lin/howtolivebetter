.org/2000/svg","width":"15","height":"15","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]}]},{"tag":"div","props":{"className":"life-header-tools"},"children":[{"tag":"button","props":{"type":"button","className":"life-sound-toggle","aria-label":"Desactivar sonidos","aria-pressed":"true","title":"Desactivar sonidos"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-volume2 lucide-volume-2","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M11 4.702a.705.705 0 0 0-1.203-.498L6.413 7.587A1.4 1.4 0 0 1 5.416 8H3a1 1 0 0 0-1 1v6a1 1 0 0 0 1 1h2.416a1.4 1.4 0 0 1 .997.413l3.383 3.384A.705.705 0 0 0 11 19.298z"},"children":[]},{"tag":"path","props":{"d":"M16 9a5 5 0 0 1 0 6"},"children":[]},{"tag":"path","props":{"d":"M19.364 18.364a9 9 0 0 0 0-12.728"},"children":[]}]}]},{"tag":"button","props":{"type":"button","className":"life-theme-trigger","aria-label":"Sistema","aria-haspopup":"menu","aria-expanded":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"17","height":"17","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-sun life-theme-icon-light","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"4"},"children":[]},{"tag":"path","props":{"d":"M12 2v2"},"children":[]},{"tag":"path","props":{"d":"M12 20v2"},"children":[]},{"tag":"path","props":{"d":"m4.93 4.93 1.41 1.41"},"children":[]},{"tag":"path","props":{"d":"m17.66 17.66 1.41 1.41"},"children":[]},{"tag":"path","props":{"d":"M2 12h2"},"children":[]},{"tag":"path","props":{"d":"M20 12h2"},"children":[]},{"tag":"path","props":{"d":"m6.34 17.66-1.41 1.41"},"children":[]},{"tag":"path","props":{"d":"m19.07 4.93-1.41 1.41"},"children":[]}]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"17","height":"17","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-moon life-theme-icon-dark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"},"children":[]}]}]},{"tag":"button","props":{"type":"button","className":"life-language-switch","aria-label":"Español Elegir idioma","aria-haspopup":"menu","aria-expanded":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-globe","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]},{"tag":"path","props":{"d":"M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"},"children":[]},{"tag":"path","props":{"d":"M2 12h20"},"children":[]}]},{"tag":"span","props":{},"children":["Español"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]}]},{"tag":"a","props":{"className":"life-account","href":"/es/sign-in"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"17","height":"17","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle-user-round","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M18 20a6 6 0 0 0-12 0"},"children":[]},{"tag":"circle","props":{"cx":"12","cy":"10","r":"4"},"children":[]},{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},{"tag":"span","props":{},"children":["Iniciar sesión"]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/es/book/01"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"Volver al índice"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["No mueras antes de tiempo"]},{"tag":"nav","props":{"aria-label":"Consejos del capítulo"},"children":[{"tag":"a","props":{"href":"/es/tip/01-01"},"children":[{"tag":"span","props":{},"children":["01"]},"Abróchate el cinturón, también en los asientos traseros"]},{"tag":"a","props":{"href":"/es/tip/01-02"},"children":[{"tag":"span","props":{},"children":["02"]},"Ponte casco en moto y bicicleta eléctrica, y abróchalo"]},{"tag":"a","props":{"href":"/es/tip/01-03"},"children":[{"tag":"span","props":{},"children":["03"]},"Instala detector de humo; si en invierno calientas con carbón o gas dentro de casa, añade también detector de monóxido de carbono"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/es/tip/01-04","data-status":"active"},"children":[{"tag":"span","props":{},"children":["04"]},"Cambia las mangueras y estufas de gas cuando caduquen; no modifiques tú mismo las tuberías y puedes rechazar directamente cualquier venta a domicilio de la compañía de gas"]},{"tag":"a","props":{"href":"/es/tip/01-05"},"children":[{"tag":"span","props":{},"children":["05"]},"No recojas, no compres y no comas setas silvestres; ningún «truco casero para identificarlas» es válido"]},{"tag":"a","props":{"href":"/es/tip/01-06"},"children":[{"tag":"span","props":{},"children":["06"]},"No introducir bicicletas eléctricas en pasillos, ascensores ni cargarlas en casa"]},{"tag":"a","props":{"href":"/es/tip/01-07"},"children":[{"tag":"span","props":{},"children":["07"]},"Mide la tensión y, si está alta, tómate la medicación hasta llegar al objetivo"]},{"tag":"a","props":{"href":"/es/tip/01-08"},"children":[{"tag":"span","props":{},"children":["08"]},"A partir de los 35 años, si tienes sobrepeso, hazte una glucemia en ayunas; aunque salga normal, repite cada tres años"]},{"tag":"a","props":{"href":"/es/tip/01-09"},"children":[{"tag":"span","props":{},"children":["09"]},"No corras al conducir y no bebas si vas a conducir"]},{"tag":"a","props":{"href":"/es/tip/01-10"},"children":[{"tag":"span","props":{},"children":["10"]},"En el coche, silla infantil homologada para menores de 4 años, no en brazos"]},{"tag":"a","props":{"href":"/es/tip/01-11"},"children":[{"tag":"span","props":{},"children":["11"]},"Con niños en casa, pon limitadores en ventanas y balcones; la mosquitera no es protección"]},{"tag":"a","props":{"href":"/es/tip/01-12"},"children":[{"tag":"span","props":{},"children":["12"]},"Junto al agua, no apartes los ojos de los niños; en barca o bañándose en el campo, chaleco salvavidas"]},{"tag":"a","props":{"href":"/es/tip/01-13"},"children":[{"tag":"span","props":{},"children":["13"]},"A partir de los 60 años, entrena equilibrio y fuerza de piernas, y adapta el baño y las escaleras de casa"]},{"tag":"a","props":{"href":"/es/tip/01-14"},"children":[{"tag":"span","props":{},"children":["14"]},"Hazte la analítica de hepatitis B (cinco marcadores) y, si no tienes anticuerpos, vacúnate"]},{"tag":"a","props":{"href":"/es/tip/01-15"},"children":[{"tag":"span","props":{},"children":["15"]},"Si te pincha un clavo o una astilla, o si la herida se contamina con tierra, acude al médico ese mismo día y pregunta si necesitas la vacuna contra el tétanos"]},{"tag":"a","props":{"href":"/es/tip/01-16"},"children":[{"tag":"span","props":{},"children":["16"]},"Vacúnate del VPH si eres mujer; cuanto antes, mejor"]},{"tag":"a","props":{"href":"/es/tip/01-17"},"children":[{"tag":"span","props":{},"children":["17"]},"A partir de los 40 años, cribado de mama cada dos años con mamografía"]},{"tag":"a","props":{"href":"/es/tip/01-18"},"children":[{"tag":"span","props":{},"children":["18"]},"A partir de los 30 años, cribado de cuello uterino en mujeres, priorizando la prueba del VPH"]},{"tag":"a","props":{"href":"/es/tip/01-19"},"children":[{"tag":"span","props":{},"children":["19"]},"A partir de los 45 o 50 años, cribado de cáncer colorrectal: test inmunológico de sangre oculta en heces o colonoscopia"]},{"tag":"a","props":{"href":"/es/tip/01-20"},"children":[{"tag":"span","props":{},"children":["20"]},"Personas con enfermedad cardiovascular y mayores: vacuna antigripal cada año"]},{"tag":"a","props":{"href":"/es/tip/01-21"},"children":[{"tag":"span","props":{},"children":["21"]},"Vacuna del herpes zóster a partir de los 50 años"]},{"tag":"a","props":{"href":"/es/tip/01-22"},"children":[{"tag":"span","props":{},"children":["22"]},"Vacuna neumocócica a partir de los 65 años"]},{"tag":"a","props":{"href":"/es/tip/01-23"},"children":[{"tag":"span","props":{},"children":["23"]},"Hazte la prueba de Helicobacter pylori y, si sale positiva, erradícalo"]},{"tag":"a","props":{"href":"/es/tip/01-24"},"children":[{"tag":"span","props":{},"children":["24"]},"Fumadores fuertes: TAC torácico de baja dosis una vez al año"]},{"tag":"a","props":{"href":"/es/tip/01-25"},"children":[{"tag":"span","props":{},"children":["25"]},"En depresión o con ideas de suicidio, llama al 12356; en casa no acumules somníferos ni pesticidas"]},{"tag":"a","props":{"href":"/es/tip/01-26"},"children":[{"tag":"span","props":{},"children":["26"]},"Ten a punto extintor, manta ignífuga, mascarilla de escape y botiquín, y revísalos una vez al año"]},{"tag":"a","props":{"href":"/es/tip/01-27"},"children":[{"tag":"span","props":{},"children":["27"]},"Si ves sangre en la orina a simple vista, aunque no duela y aunque al día siguiente ya esté limpia, hazte una revisión"]},{"tag":"a","props":{"href":"/es/tip/01-28"},"children":[{"tag":"span","props":{},"children":["28"]},"Si la erección falla, revisa primero el corazón; no lo tomes como un simple «asunto de eso»"]},{"tag":"a","props":{"href":"/es/tip/01-29"},"children":[{"tag":"span","props":{},"children":["29"]},"Perder peso, dejar el tabaco y controlar tensión y glucosa mejora la función eréctil"]},{"tag":"a","props":{"href":"/es/tip/01-30"},"children":[{"tag":"span","props":{},"children":["30"]},"Preservativo durante toda la relación sexual, y nunca compartas jeringuillas"]},{"tag":"a","props":{"href":"/es/tip/01-31"},"children":[{"tag":"span","props":{},"children":["31"]},"Tras una práctica de riesgo, hazte la prueba del VIH: gratis en el centro de control de enfermedades y con resultado confidencial"]},{"tag":"a","props":{"href":"/es/tip/01-32"},"children":[{"tag":"span","props":{},"children":["32"]},"En cuanto aparezca la idea de suicidarte, díselo primero a una persona de tu alrededor y entrega esos minutos"]},{"tag":"a","props":{"href":"/es/tip/01-33"},"children":[{"tag":"span","props":{},"children":["33"]},"No tomes «salvarse a tiempo» como red de seguridad: tras beber pesticida o inhalar gas, la urgencia salva la vida, pero no los pulmones ni el cerebro"]},{"tag":"a","props":{"href":"/es/tip/01-34"},"children":[{"tag":"span","props":{},"children":["34"]},"No apuestes a que «unos días en la cama y listo» con una caída de altura: la mayoría de los que entran en una UCI de traumatología sobrevive, pero el precio se paga por años"]},{"tag":"a","props":{"href":"/es/tip/01-35"},"children":[{"tag":"span","props":{},"children":["35"]},"No cambies dinero por que «con un solo riñón se vive igual»: el que queda trabaja por dos, y el 86 % de quienes vendieron un riñón dicen que su salud empeoró"]},{"tag":"a","props":{"href":"/es/tip/01-36"},"children":[{"tag":"span","props":{},"children":["36"]},"No recoja, no desmonte ni venda piezas metálicas de procedencia desconocida; manténgase alejado de las zonas señalizadas con el símbolo del trébol"]},{"tag":"a","props":{"href":"/es/tip/01-37"},"children":[{"tag":"span","props":{},"children":["37"]},"Cuando apuestas hasta el punto de pedir prestado para seguir jugando y te sientes deprimido, primero llama al 12356 y luego entrega tus tarjetas bancarias y contraseñas de pago a un familiar para que las gestione"]},{"tag":"a","props":{"href":"/es/tip/01-38"},"children":[{"tag":"span","props":{},"children":["38"]},"Hombres que tienen relaciones sexuales con hombres con conductas de alto riesgo: consultar en hospitales designados para el VIH sobre la profilaxis preexposición puede reducir el riesgo de infección en más del 70%"]},{"tag":"a","props":{"href":"/es/tip/01-39"},"children":[{"tag":"span","props":{},"children":["39"]},"A partir de los 65 años, las mujeres deben hacerse una densitometría ósea con rayos X de doble energía (DXA); las posmenopáusicas con factores de riesgo de osteoporosis no tienen que esperar a los 65"]},{"tag":"a","props":{"href":"/es/tip/01-40"},"children":[{"tag":"span","props":{},"children":["40"]},"Si le diagnostican osteoporosis o se fracturó con una caída leve, pida al médico fármacos contra la osteoporosis y manténgalos; no sustituya el tratamiento solo con calcio"]},{"tag":"a","props":{"href":"/es/tip/01-41"},"children":[{"tag":"span","props":{},"children":["41"]},"Antes de pisar el hielo natural, haga agujeros para medir su grosor; si es inferior a 15 cm, no lo haga. Evite el hielo de ríos y los bordes de los agujeros de pesca"]},{"tag":"a","props":{"href":"/es/tip/01-42"},"children":[{"tag":"span","props":{},"children":["42"]},"Antes de usar una amoladora angular, coloca el protector y ponte gafas y pantalla facial; sujétala con ambas manos y no montes una hoja de sierra para cortar madera"]},{"tag":"a","props":{"href":"/es/tip/01-43"},"children":[{"tag":"span","props":{},"children":["43"]},"Pregunta directamente a alguien cercano cuyo ánimo preocupa: «¿Has pensado en suicidarte?». Preguntar no aumenta esas ideas"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"Ruta de navegación"},"children":[{"tag":"a","props":{"href":"/es/book"},"children":["Libro"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/es/book/01"},"children":["Capítulo 1"," ·"," ","No mueras antes de tiempo"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"01-04"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["04"]},{"tag":"span","props":{"className":"life-evidence grade-c"},"children":["Evidencia"," ","C"]}]},{"tag":"h1","props":{"lang":"es"},"children":["Cambia las mangueras y estufas de gas cuando caduquen; no modifiques tú mismo las tuberías y puedes rechazar directamente cualquier venta a domicilio de la compañía de gas"]},{"tag":"p","props":{"lang":"es","className":"life-entry-summary"},"children":["Una manguera de gas conforme a la normativa cuesta unas decenas de yuanes. Cambiarla al caducar es una obligación del usuario según el “Reglamento de gestión del gas urbano”. El reglamento prohíbe expresamente modificar las tuberías o desmontar el contador de gas por cuenta propia. Asimismo, el mismo reglamento establece que las compañías de gas no pueden obligar a los usuarios a adquirir productos o servicios específicos. Por tanto, puedes rechazar sin problema cualquier oferta de venta a domicilio que afirme que “es obligatorio cambiarlo”."]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Coste"]},{"tag":"p","props":{},"children":["Una manguera de gas conforme a la normativa cuesta unas de…"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Beneficio"]},{"tag":"p","props":{},"children":["El reglamento señala como obligación del usuario “cambiar a tiempo los aparatos de combustión y las mangueras…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"Marcar: Cambia las mangueras y estufas de gas cuando caduquen; no modifiques tú mismo las tuberías y puedes rechazar directamente cualquier venta a domicilio de la compañía de gas"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"Hecho"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"Por hacer"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"Guardar"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Compartir consejo"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Ocultar detalles"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Coste"]},{"tag":"p","props":{},"children":["Una manguera de gas conforme a la normativa cuesta unas decenas de yuanes. Las estufas se cambian cada varios años; aproveche el momento para comprobar si han caducado."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Beneficio"]},{"tag":"p","props":{},"children":["El reglamento señala como obligación del usuario “cambiar a tiempo los aparatos de combustión y las mangueras cuyo uso haya sido prohibido o cuyo plazo de uso haya expirado”. Así, cuando una estufa o manguera haya caducado o esté prohibida, el usuario debe sustituirla. También prohíbe expresamente “instalar, modificar o desmontar sin autorización las instalaciones de gas y los contadores en el domicilio”, lo cual incluye cualquier intervención propia en tuberías o contadores. Por otro lado, el reglamento deja claro que los proveedores de gas no pueden exigir a los usuarios la compra de productos o la contratación de servicios determinados."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Fuentes originales"]},{"tag":"p","props":{"className":"life-citations"},"children":["国务院 (2010). 城镇燃气管理条例（国务院令第 583 号）第二十七条：「燃气用户应当遵守安全用气规则，使用合格的燃气燃烧器具和气瓶，及时更换国家明令淘汰或者使用年限已届满的燃气燃烧器具、连接管等」；第二十八条禁止行为含「（一）擅自操作公用燃气阀门」「（二）将燃气管道作为负重支架或者接地引线」「（四）擅自安装、改装、拆除户内燃气设施和燃气计量装置」；第二十条燃气经营者不得「（六）要求燃气用户购买其指定的产品或者接受其提供的服务」；第二十九条用户可就收费、服务向燃气管理等部门投诉，「有关部门应当自收到投诉之日起15个工作日内予以处理」. ",{"tag":"a","props":{"href":"http://www.gov.cn/gongbao/content/2010/content_1758214.htm","target":"_blank","rel":"noopener noreferrer"},"children":["http://www.gov.cn/gongbao/content/2010/content_1758214.htm"]},"；深圳市住房和建设局 (2024). 安全用气小知识（二）：「立即关闭家里的燃气总阀门」「迅速开门、开窗进行通风」「一定不要开、关家里的电灯、抽油烟机等电器」「人员应该迅速撤离，转移到安全的地方，并且及时拨打燃气公司的报警电话」. ",{"tag":"a","props":{"href":"https://zjj.sz.gov.cn/zcjzts/content/post_11882410.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://zjj.sz.gov.cn/zcjzts/content/post_11882410.html"]},"；张家港市应急管理局 (2024). 燃气安全使用知识：「不要情急之下打开排气扇进行通风」「应远离现场之后才能打电话求助」. ",{"tag":"a","props":{"href":"https://www.zjg.gov.cn/zjgszwz/yjaqzs/202411/72b4fad7399c48378302460c6ce2d55b.shtml","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.zjg.gov.cn/zjgszwz/yjaqzs/202411/72b4fad7399c48378302460c6ce2d55b.shtml"]}]},{"tag":"a","props":{"href":"http://www.gov.cn/gongbao/content/2010/content_1758214.htm","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Abrir fuente"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Nota del autor"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["Algunos vendedores se presentan a domicilio bajo el pretexto de “inspección de seguridad” y luego ofrecen válvulas de cierre automático y detectores de gas. Según el apartado 6 del artículo 20 del reglamento, la compañía de gas no puede obligarte a adquirir productos específicos; puedes rechazar la oferta o presentar una queja. Si percibe olor a gas, cierra primero la válvula general o la válvula del cilindro de gas en el caso de gas en botella; a continuación, abre puertas y ventanas para ventilar, pero no enciendas ni apagues ventiladores ni aparatos eléctricos como lámparas o campanas extractoras, ni utilices encendedores. Sal del lugar y, una vez fuera, llama al servicio de emergencias de la compañía de gas. La intoxicación por monóxido de carbono es un caso distinto; consulte la sección 13."]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Mi nota"]},{"tag":"button","props":{"type":"button"},"children":["Escribe un recordatorio…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/es/tip/01-03"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Anterior"]},"Instala detector de humo; si en invierno calientas con carbón o gas dentro de casa, añade también detector de monóxido de carbono"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/es/tip/01-05"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Siguiente"]},"No recojas, no compres y no comas setas silvestres; ningún «truco casero para identificarlas» es válido"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWid