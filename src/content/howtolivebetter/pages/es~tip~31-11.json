width":"18","height":"18","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-up-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M7 7h10v10"},"children":[]},{"tag":"path","props":{"d":"M7 17 17 7"},"children":[]}]}]}]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/es/book/31"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"Volver al índice"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["Qué caminos hay después de los 18 años"]},{"tag":"div","props":{"data-ad-dock-host":"true"},"children":[]},{"tag":"nav","props":{"aria-label":"Consejos del capítulo"},"children":[{"tag":"a","props":{"href":"/es/tip/31-01"},"children":[{"tag":"span","props":{},"children":["01"]},"Primero repasa los umbrales: los requisitos de edad y de estudios de las doce rutas están fijados por escrito"]},{"tag":"a","props":{"href":"/es/tip/31-02"},"children":[{"tag":"span","props":{},"children":["02"]},"El año en que cumples 18, antes del 31 de octubre hay que hacer el registro de servicio militar; el servicio activo del conscripto son dos años"]},{"tag":"a","props":{"href":"/es/tip/31-03"},"children":[{"tag":"span","props":{},"children":["03"]},"Tras aceptar el reclutamiento, negarse al servicio militar impide salir del país o retomar los estudios durante dos años, y cierra la puerta al funcionariado y a las empresas estatales"]},{"tag":"a","props":{"href":"/es/tip/31-04"},"children":[{"tag":"span","props":{},"children":["04"]},"Dos beneficios prácticos para estudiantes universitarios que se alistan: compensación anual de matrícula de hasta 20 000 yuanes, conservación de la matrícula por dos años y un plan especial para el acceso a posgrados"]},{"tag":"a","props":{"href":"/es/tip/31-05"},"children":[{"tag":"span","props":{},"children":["05"]},"Tras la baja, solo en seis casos el gobierno asigna un puesto de trabajo; quien queda en empleo por cuenta propia debe presentarse dentro de los 30 días"]},{"tag":"a","props":{"href":"/es/tip/31-06"},"children":[{"tag":"span","props":{},"children":["06"]},"Tres cuentas tras la baja: prima única por baja, los años de servicio militar cuentan como antigüedad laboral y deducción fiscal de 20 000 yuanes al año para quienes trabajan por cuenta propia"]},{"tag":"a","props":{"href":"/es/tip/31-07"},"children":[{"tag":"span","props":{},"children":["07"]},"El sector público no se entra solo por el examen de funcionario: dos años en un programa de servicio de base dan acceso al plan anual de admisión dirigida del 10 %"]},{"tag":"a","props":{"href":"/es/tip/31-08"},"children":[{"tag":"span","props":{},"children":["08"]},"El maestro de Puesto Especial que termina tres años de servicio, aprueba la evaluación y quiere quedarse debe ser incorporado a la plantilla sin demora"]},{"tag":"a","props":{"href":"/es/tip/31-09"},"children":[{"tag":"span","props":{},"children":["09"]},"Bombero y personal civil del ejército son otras dos puertas de contratación pública, con umbrales más bajos que el funcionariado"]},{"tag":"a","props":{"href":"/es/tip/31-10"},"children":[{"tag":"span","props":{},"children":["10"]},"La formación académica no es una decisión única: el examen de autoestudio no impone límites de edad ni de nivel educativo previo; el examen de ingreso para adultos y la Universidad Abierta también permiten completar estudios"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/es/tip/31-11","data-status":"active"},"children":[{"tag":"span","props":{},"children":["11"]},"Si no entras en una unidad de trabajo, eres empleo flexible: pensión y salud se afilian por tu cuenta en el lugar de empleo, y la restricción de registro de hogar ya se levantó"]},{"tag":"a","props":{"href":"/es/tip/31-12"},"children":[{"tag":"span","props":{},"children":["12"]},"Reparto de comida, auto de pasajeros, transporte urbano de carga: la plataforma paga la prima de protección contra daños profesionales por pedido, y tú no pagas"]},{"tag":"a","props":{"href":"/es/tip/31-13"},"children":[{"tag":"span","props":{},"children":["13"]},"Dos rutas que te aseguran la plantilla el mismo día en que rellenas las preferencias de la admisión a la universidad: normalistas a cuenta del Estado y estudiantes de medicina con destino asignado, al precio de 6 años de compromiso"]},{"tag":"a","props":{"href":"/es/tip/31-14"},"children":[{"tag":"span","props":{},"children":["14"]},"Quieres trabajar en el extranjero: comprueba primero si la empresa tiene la licencia de cooperación laboral con el exterior; no puede cobrarte depósito"]},{"tag":"a","props":{"href":"/es/tip/31-15"},"children":[{"tag":"span","props":{},"children":["15"]},"Trabajo remoto desde casa para una empresa extranjera: para la ley fiscal es renta de origen nacional; el impuesto sobre la renta lo declaras tú y el dinero entra por la vía de «remuneración de trabajadores»"]},{"tag":"a","props":{"href":"/es/tip/31-16"},"children":[{"tag":"span","props":{},"children":["16"]},"Sin entrar en una unidad, tú a lo tuyo: para el dinero de arranque mira primero el préstamo con garantía de emprendimiento — hasta 300 000 yuanes por persona y el Tesoro paga la mitad del interés"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"Ruta de navegación"},"children":[{"tag":"a","props":{"href":"/es/book"},"children":["Libro"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/es/book/31"},"children":["Capítulo 31"," ·"," ","Qué caminos hay después de los 18 años"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"31-11"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["11"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["Evidencia"," ","A"]}]},{"tag":"h1","props":{"lang":"es"},"children":["Si no entras en una unidad de trabajo, eres empleo flexible: pensión y salud se afilian por tu cuenta en el lugar de empleo, y la restricción de registro de hogar ya se levantó"]},{"tag":"p","props":{"lang":"es","className":"life-entry-summary"},"children":["No entrar en una unidad no significa que no exista el seguro social; solo que nadie paga esa mitad por ti. Los documentos piden a los lugares levantar la restricción de registro de hogar para que el empleo flexible se afilie en el lugar de empleo, y a las megaciudades se les deja hacerlo poco a poco. Así que no entiendas «libertad» como que el seguro social no va contigo: si dejas de cotizar, tanto la pensión como el reembolso médico se calculan por las reglas de la interrupción."]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Coste"]},{"tag":"p","props":{},"children":["La pensión y la salud se pagan íntegramente por tu cuenta:…"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Beneficio"]},{"tag":"p","props":{},"children":["Las Directrices sobre la protección de los derechos e intereses laborales y de seguridad social de los trabaja…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"Marcar: Si no entras en una unidad de trabajo, eres empleo flexible: pensión y salud se afilian por tu cuenta en el lugar de empleo, y la restricción de registro de hogar ya se levantó"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"Hecho"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"Por hacer"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"Guardar"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0