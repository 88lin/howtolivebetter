d":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"收藏"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"分享这条建议"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"收起详情"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["成本"]},{"tag":"p","props":{"className":"life-citations"},"children":["不花钱。住院期间隔几天要一次清单，对一遍十几分钟。难在拉下脸去问医生和护士。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["收益"]},{"tag":"p","props":{"className":"life-citations"},"children":["《医疗保障基金使用监督管理条例》规定，定点医院要「向参保人员如实出具费用单据和相关资料」。参保人也有权要求医院如实出具。医院不得过度检查，不得重复收费、超标准收费、分解项目收费。医保基金支付范围以外的药和服务，除了急诊、抢救，要经参保人或者近亲属、监护人同意。违反这几条的，由医保部门责令改正。造成医保基金损失的，责令退回，再罚损失金额的 1 到 2 倍。没经同意就用医保不报的项目、拒不改正的，罚 1 万到 5 万元。国家卫健委 2019 年的《医疗机构内部价格行为管理规定》要求医院建立费用清单制度，含电子清单。患者需要时，医院要给打印。清单要写明项目、药品、耗材的名称和编码，还有单价、计价单位、使用日期、数量、金额。按病种、按 DRG（按疾病分组打包付费）收费的，不在这项要求里。医院要在显著位置公布价格咨询和投诉电话，投诉实行首问负责制，接待的人要记下内容和处理结果。向医保部门举报，走它公布的网站、电话、传真、邮寄地址。可以匿名，实名举报的个人信息要保密。查证属实的，按国家规定给举报人奖励（全国，截至 2026 年 10 月）"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["来源"]},{"tag":"p","props":{"className":"life-citations"},"children":["国务院 (2021). 医疗保障基金使用监督管理条例（国务院令第 735 号，第十五、十七、三十五、三十八、三十九条）. ",{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/2021-02/19/content_5587668.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/zhengce/zhengceku/2021-02/19/content_5587668.htm"]},"：「除急诊、抢救等特殊情形外，提供医疗保障基金支付范围以外的医药服务的，应当经参保人员或者其近亲属、监护人同意。」「参保人员有权要求定点医药机构如实出具费用单据和相关资料。」；国家卫生健康委、国家中医药局 (2019). 关于印发医疗机构内部价格行为管理规定的通知（国卫财务发〔2019〕64 号，第十五、十六、十八条）. ",{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/2020-01/02/content_5466052.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/zhengce/zhengceku/2020-01/02/content_5466052.htm"]},"：「医疗机构应当建立费用清单（含电子清单）制度，以多种形式向患者提供医疗服务、药品、医用耗材等费用清单（病种、DRG除外），并在患者需要时提供打印服务。」；国家医疗保障局 (2022). 医疗保障基金使用监督管理举报处理暂行办法（国家医疗保障局令第 5 号，第六、七、八、十六、二十一、二十五条）. ",{"tag":"a","props":{"href":"http://www.gov.cn/gongbao/content/2022/content_5687509.htm","target":"_blank","rel":"noopener noreferrer"},"children":["http://www.gov.cn/gongbao/content/2022/content_5687509.htm"]},""]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["原书备注"]},{"tag":"p","props":{"className":"life-citations"},"children":["向医保部门举报，管的是医院违规用医保基金。条例写的是责令改正、退回医保基金和罚款，没写把多收你的那部分退给你。想把自己多掏的钱要回来，主要靠医院自己更正收费，所以先找医院的价格投诉窗口，清单和沟通记录都留着。为几百元去法院起诉，一审普通程序 6 个月起，律师费自己出，多半不划算。举报要写清具体线索：清单上哪一项、哪天、收了几次。只是想问报销政策的，打医保咨询电话，不算举报。看不懂的项目先问护士站或住院处，不一定是乱收费。医保不报的药不一定不该用，问清每天多少钱、有没有能报的替代药再签字。出院时要一份总清单，和病历一起存好，见第 5 条（病历和影像自己存一份）。收益量级定为中，是凭判断：没查到官方给出单个病人多付的金额，按本书阈值，几百到几千元算中。受益人主要是你自己和家人，替住院的老人对账尤其要紧"]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["我的备注"]},{"tag":"button","props":{"type":"button"},"children":["写下对自己有用的提醒…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/tip/24-14"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["上一条"]},"在医院确诊过、病情稳定的慢性病要续方，可以在这家医院的互联网医院线上复诊开药，第一次看这个病不能在网上看"]}]},{"tag":"span","props":{},"children":[]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["本主题的其他建议"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/24-03"},"children":[{"tag":"strong","props":{},"children":["要去大医院，走基层转诊或者医院的转诊中心，别找号贩子"]},{"tag":"span","props":{},"children":["医联体里牵头的大医院要留出一部分号和床位，专门给从基层转来的人。医院还要设转诊中心，或者指定一个固定部门专管转诊，2027 年全覆盖。挂不到号不等于没有路，不用…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/24-04"},"children":[{"tag":"strong","props":{},"children":["跨省异地就医之前先在本地问一句，必要性原则上要副主任医师以上评估"]},{"tag":"span","props":{},"children":["要不要去外地看病，原则上由二、三级医院副主任医师以上的医生评估。临时外出就医报销多少，和在参保地同级别医院会有差别，具体看本地规定。出发前在本地问一句，比人到了…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/24-05"},"children":[{"tag":"strong","props":{},"children":["每次看完病，把病历、检查报告和影像自己存一份"]},{"tag":"span","props":{},"children":["查阅和复制自己的病历，是法律给你的权利。门诊病历、住院志、化验单、影像、手术和麻醉记录、病理资料、费用清单都能复制。医院要指定专门的部门或人员受理，只能收工本费…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/24-06"},"children":[{"tag":"strong","props":{},"children":["对诊疗有疑问就当场要求封存病历，双方在场、开清单、各执一份"]},{"tag":"span","props":{},"children":["对治疗有疑问，可以要求把病历封存起来。封存要医患双方都在场，开清单、签字盖章、各拿一份。病历还没写完的，先封已经写完的那部分。怀疑是输液、输血、打针、用药出的问…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/24-07"},"children":[{"tag":"strong","props":{},"children":["急重的伤病直奔急诊预检分诊台，别去挂号窗口排队"]},{"tag":"span","props":{},"children":["急诊不按先来后到，按病情轻重分四级排。定级的地方是急诊入口的预检分诊台，不是挂号窗口。到了先报最危险的那一条：大出血、喘不上气、意识不清、像心脏病那样的胸痛、疼…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/24-08"},"children":[{"tag":"strong","props":{},"children":["没带钱、没带证件、说不清自己是谁，急诊也必须先救"]},{"tag":"span","props":{},"children":["国家有一笔疾病应急救助基金，专付两种人的急救费：身份查不出来的，和掏不出钱的。医院不能拒绝或拖延抢救，急救中心也不能因为钱的问题不出车。所以别因为没钱在家硬扛，…"]}]}]}]},{"tag":"a","props":{"className":"life-text-link","href":"/book/24"},"children":["阅读整个主题：看病：怎么少花钱少走弯路 ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"15","height":"15","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"p