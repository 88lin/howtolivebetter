fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"このヒントを共有"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"詳細を閉じる"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["費用・手間"]},{"tag":"p","props":{},"children":["登記のステップに費用はかかりません。企業および個人事業主の登録登記手数料は、2015 年 1 月 1 日から徴収が停止されています。現地の政務サービスサイト、または政務窓口で自身で行えば、数時間で完了します。印鑑の作成、会計代行の依頼、登録住所の確保（住所貸し）は、市場でのサービス購入であり、政府が徴収する費用ではありません。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["効果"]},{"tag":"p","props":{},"children":["条例では、提出が必要な書類は以下の5項目と明確に定められています。「（一）申請書」。「（二）申請人の資格証明書類、および自然人の身分証明書」。「（三）住所または主要な事業所の関連書類」。「（四）会社、非会社企業法人、農民専門合作社（連合社）の定款、または合伙企業の合伙契約書」。「（五）法律、行政法規、および国務院市場監督管理部門が規定するその他の提出書類」。これを分かりやすく言い換えると、申請書1部、本人確認および申請資格を証明する書類1部、店舗または事務所の使用権を証明する書類1部、会社の定款または合伙契約書、そして法規で別途指定された書類となります。会社は、法定代表者、取締役、監査役、および役員の就任書類と身分証明書も提出する必要があります。なお、個人事業主は定款の提出は不要です。名称は「申請人が法律に基づき自主的に申告」するものとし、自ら決定し、自ら申告します。資本金は「払込期日前の届出制」を採用しており、あらかじめ出資額を記載するだけで、その場で現金を準備する必要はありません。経営範囲は、登記機関が公表している分類から選択します。書類が揃っており、形式も正しければ、「確認の上、その場で登記」されます。その場で完了できない場合は、「3 営業日以内」に完了し、複雑な事情がある場合はさらに 3 営業日の猶予が与えられます。「営業許可証の発行日は市場主体の設立日」となります：許可証に印字された日が、会社または店舗の設立日となります（全国、2022 年 3 月より）"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["出典"]},{"tag":"p","props":{"className":"life-citations"},"children":["国务院 (2021). 市场主体登记管理条例（国务院令第 746 号，第十、十三、十四、十六、十九、二十一条）. ",{"tag":"a","props":{"href":"https://www.gov.cn/gongbao/content/2021/content_5636139.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/gongbao/content/2021/content_5636139.htm"]}," ; 市场监管总局 (2022). 市场主体登记管理条例实施细则（市场监管总局令第 52 号，第十二、二十五、二十六条）. ",{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/2022-03/02/content_5676403.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/zhengce/zhengceku/2022-03/02/content_5676403.htm"]}," ; 财政部、国家发展改革委 (2014). 关于取消、停征和免征一批行政事业性收费的通知（财税〔2014〕101 号，附件 1）. ",{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/2014-12/23/content_5023513.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/zhengce/2014-12/23/content_5023513.htm"]}]},{"tag":"a","props":{"href":"https://www.gov.cn/gongbao/content/2021/content_5636139.htm","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["出典を開く"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["著者の注記"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["登記自体は無料であり、徴収された費用は、その多くが代行業者への手数料です。印鑑作成の価格は市場が決めるものです。国務院事務局は「印鑑作成業者の指定を厳禁する」と明示しているため、「指定の場所で作らなければならない」という要求に従う必要はありません。登録資本金をいくらに設定するかは、対外的な見栄には影響しませんが、あなたの責任の限度額を決定します。また、5 年以内に全額払い込む必要があります。詳細は本節第 3 条（開業前の適切な主体選択）を参照してください。経営範囲に許認可が必要な項目が含まれる場合、許可が下りるまで開業できません。詳細は本節第 7 条（許認可が必要な業種）を参照してください。"]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["自分のメモ"]},{"tag":"button","props":{"type":"button"},"children":["自分へのメモを書く…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/ja/tip/12-05"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["前へ"]},"加盟前に商務部の備案を確認し、書面による開示を受け、契約書に「クーリングオフ期間」を明記する"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/ja/tip/12-07"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"childr