10"},"children":[{"tag":"span","props":{},"children":["10"]},"一般食品で病気が治せると言うのは禁止：ラベル、説明書、広告、ライブ配信の台本すべてが対象"]},{"tag":"a","props":{"href":"/ja/tip/12-11"},"children":[{"tag":"span","props":{},"children":["11"]},"食品業界には刑事罰のラインがある：病死した肉や基準超過品を売れば罪に問われ、有害物質の混入は金額に関わらず、刑期は5年起算"]},{"tag":"a","props":{"href":"/ja/tip/12-12"},"children":[{"tag":"span","props":{},"children":["12"]},"営業許可取得後から申告義務が発生。収入がなくても期限内に「ゼロ申告」を行うこと（すべてゼロの書類を提出する）"]},{"tag":"a","props":{"href":"/ja/tip/12-13"},"children":[{"tag":"span","props":{},"children":["13"]},"請求書は実際の取引に基づいてのみ発行し、小規模納税者は免税枠を最大限活用する"]},{"tag":"a","props":{"href":"/ja/tip/12-14"},"children":[{"tag":"span","props":{},"children":["14"]},"税務局を名乗り納税を催促してくるのはすべて詐欺です。納税手続きは電子税務局と 12366 を通じてのみ行ってください"]},{"tag":"a","props":{"href":"/ja/tip/12-15"},"children":[{"tag":"span","props":{},"children":["15"]},"「手付金（定金）」と記載し「予約金（订金）」とは書かないこと。違約金は金額を明記し、支払猶予期間（売掛）は貸付として審査すること"]},{"tag":"a","props":{"href":"/ja/tip/12-16"},"children":[{"tag":"span","props":{},"children":["16"]},"雇用後の最初の1ヶ月以内に書面契約を締結し、30 日以内に社会保険登録を行う"]},{"tag":"a","props":{"href":"/ja/tip/12-17"},"children":[{"tag":"span","props":{},"children":["17"]},"賃金は契約と法律に従って支払い、昇給、貸付、ボーナスはすべて書面で行う"]},{"tag":"a","props":{"href":"/ja/tip/12-18"},"children":[{"tag":"span","props":{},"children":["18"]},"販売してから製造：予約販売と小規模注文で需要を検証してから、製造に投資する"]},{"tag":"a","props":{"href":"/ja/tip/12-19"},"children":[{"tag":"span","props":{},"children":["19"]},"サンプル完成後は、まず量産チェックリストを確認してから着手すること"]},{"tag":"a","props":{"href":"/ja/tip/12-20"},"children":[{"tag":"span","props":{},"children":["20"]},"仕入れのたびに伝票と仕入れ元情報を保管すること。市場価格より明らかに低い仕入れ値のものは仕入れない：従業員が仕入れた偽物で、社長が判決を受けた事例"]},{"tag":"a","props":{"href":"/ja/tip/12-21"},"children":[{"tag":"span","props":{},"children":["21"]},"商品、パッケージ、タグ、宣伝画像に使用する図案は、自作するかライセンスを購入すること。色の変更やアイコンの追加は「改変」とはみなされない"]},{"tag":"a","props":{"href":"/ja/tip/12-22"},"children":[{"tag":"span","props":{},"children":["22"]},"職務においては規定に従って行動し、規定外の善意はまず責任の所在を明確にすること"]},{"tag":"a","props":{"href":"/ja/tip/12-23"},"children":[{"tag":"span","props":{},"children":["23"]},"損失が出たら手続きに従って退場を：簡便な注銷ができるなら注銷し、債務超過なら破産を。放置してはいけない"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/ja/tip/12-24","data-status":"active"},"children":[{"tag":"span","props":{},"children":["24"]},"ネットショップの運営代行、開店セミナー、 「無在庫販売」に手を出して費用を支払う前に、追加料金の有無と売上の出所を必ず確認すること"]},{"tag":"a","props":{"href":"/ja/tip/12-25"},"children":[{"tag":"span","props":{},"children":["25"]},"中国で会社や個人事業を営むなら、毎年1月1日〜6月30日に前年の年次報告をオンライン提出。営業がなくても必要で、無料"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"現在地"},"children":[{"tag":"a","props":{"href":"/ja/book"},"children":["本を読む"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/ja/book/12"},"children":["第12章"," ·"," ","起業とビジネス：全財産を失わないために"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"12-24"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["24"]},{"tag":"span","props":{"className":"life-evidence grade-b"},"children":["エビデンス"," ","B"]}]},{"tag":"h1","props":{"lang":"ja"},"children":["ネットショップの運営代行、開店セミナー、 「無在庫販売」に手を出して費用を支払う前に、追加料金の有無と売上の出所を必ず確認すること"]},{"tag":"p","props":{"lang":"ja","className":"life-entry-summary"},"children":["この種の詐欺は、まず少額を支払わせ、その後「プランのアップグレード」「仕入れ代金の立て替え」「凍結解除金」などの名目で、何度も追加送金を要求してきます。管理画面上の注文や収益は捏造されている可能性があり、出金しようとするとできなくなります。サクラ（刷単）による売上アップ自体が違法であり、発覚した場合、運営代行業者も罰せられます。"]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["費用・手間"]},{"tag":"p","props":{},"children":["費用はかけないこと。支払う前に、書面による契約書、相手企業の正式名称、返金条件の3点を確認してください。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["効果"]},{"tag":"p","props":{},"children":["広東省高級人民法院は、ある運営代行詐欺に対して判決を下しました。蒋氏、徐氏ら