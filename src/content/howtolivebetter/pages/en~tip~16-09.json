ad-rail","data-dock-active":"false","style":{"top":"94px"}},"children":[{"tag":"div","props":{"className":"life-ad-dock","hidden":true},"children":[{"tag":"aside","props":{"className":"life-ad-space life-ad-space-sponsored life-ad-space-compact","data-ad-placement":"ad_dock","data-ad-group":"reading","data-ad-creative":"read_product","data-ad-ready":"false","aria-label":"Advertisement · Community recommendation"},"children":[{"tag":"button","props":{"type":"button","className":"life-ad-dismiss","aria-label":"Close ad"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-x","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M18 6 6 18"},"children":[]},{"tag":"path","props":{"d":"m6 6 12 12"},"children":[]}]}]},{"tag":"div","props":{"className":"life-ad-space-brand"},"children":[{"tag":"img","props":{"src":"/sites/howtolivebetter/images/shengcai/logo.png","width":"565","height":"144","alt":"Official Shengcai Youshu logo","decoding":"async"},"children":[]}]},{"tag":"div","props":{"className":"life-ad-space-copy"},"children":[{"tag":"span","props":{"className":"life-ad-space-label"},"children":["Advertisement · Community recommendation"]},{"tag":"strong","props":{},"children":["Could what you know become a useful product?"]},{"tag":"p","props":{},"children":["From ebooks to small tools, explore how members spot needs and turn knowledge into something people can use."]}]},{"tag":"div","props":{"className":"life-ad-space-actions"},"children":[{"tag":"a","props":{"className":"life-ad-space-link","href":"/en/shengcaiyoushu?sc_group=reading&sc_creative=read_product&sc_placement=ad_dock"},"children":["Explore the community and examples",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"18","height":"18","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-up-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M7 7h10v10"},"children":[]},{"tag":"path","props":{"d":"M7 17 17 7"},"children":[]}]}]}]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/en/book/16"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"Back to index"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["How to live after being diagnosed with a chronic disease"]},{"tag":"div","props":{"data-ad-dock-host":"true"},"children":[]},{"tag":"nav","props":{"aria-label":"Chapter entries"},"children":[{"tag":"a","props":{"href":"/en/tip/16-01"},"children":[{"tag":"span","props":{},"children":["01"]},"Take medication exactly as prescribed — don’t stop just because you feel better"]},{"tag":"a","props":{"href":"/en/tip/16-02"},"children":[{"tag":"span","props":{},"children":["02"]},"First get outpatient chronic disease certification, then register for cross-regional medical care — hypertension, diabetes, cancer radiotherapy/chemotherapy, dialysis, and anti-rejection treatment can then be covered by yibao across regions"]},{"tag":"a","props":{"href":"/en/tip/16-03"},"children":[{"tag":"span","props":{},"children":["03"]},"Follow the intervals recommended by your doctor for follow‑up visits, and record every measurement in the same notebook"]},{"tag":"a","props":{"href":"/en/tip/16-04"},"children":[{"tag":"span","props":{},"children":["04"]},"Don’t stop proper treatment to try folk remedies or supplements"]},{"tag":"a","props":{"href":"/en/tip/16-05"},"children":[{"tag":"span","props":{},"children":["05"]},"For patients with stable chronic conditions, community clinics can issue up to 12 weeks’ worth of medication at one time"]},{"tag":"a","props":{"href":"/en/tip/16-06"},"children":[{"tag":"span","props":{},"children":["06"]},"Before signing up for a family doctor in your community, find out which services are covered by yibao and which you’ll have to pay for out of pocket"]},{"tag":"a","props":{"href":"/en/tip/16-07"},"children":[{"tag":"span","props":{},"children":["07"]},"Get a dilated eye exam right after a diabetes diagnosis, then follow your doctor’s recommended schedule; check your feet once a year"]},{"tag":"a","props":{"href":"/en/tip/16-08"},"children":[{"tag":"span","props":{},"children":["08"]},"People who have had kidney stones should drink 2.5–3 liters of water daily and keep salt intake under 6 grams"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/en/tip/16-09","data-status":"active"},"children":[{"tag":"span","props":{},"children":["09"]},"Long‑term use of uric‑acid‑lowering drugs after a gout diagnosis to keep levels below 360 µmol/L"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"Breadcrumb"},"children":[{"tag":"a","props":{"href":"/en/book"},"children":["Explore the book"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/en/book/16"},"children":["Chapter 16"," ·"," ","How to live after being diagnosed with a chronic disease"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"16-09"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["09"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["Evidence"," ","A"]}]},{"tag":"h1","props":{"lang":"en"},"children":["Long‑term use of uric‑acid‑lowering drugs after a gout diagnosis to keep levels below 360 µmol/L"]},{"tag":"p","props":{"lang":"en","className":"life-entry-summary"},"children":["Gout requires lifelong use of uric‑acid‑lowering drugs to keep levels under 360 µmol/L; painkillers alone are insufficient. In a study where nurses helped patients adjust their dose based on lab results, 95 % reached the target after two years, compared with only 30 % of patients seen by regular doctors. Even after reaching the target, medication must not be stopped. Diet changes alone cannot bring levels down to this point, and abstaining from alcohol lowers them by just 1.6 mg/dL."]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Cost"]},{"tag":"p","props":{},"children":["Allopurinol costs only a few to several tens of yuan per m…"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Benefit"]},{"tag":"p","props":{},"children":["In a randomized controlled trial of 517 adults who had experienced gout attacks within the previous 12 months,…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"Mark: Long‑term use of uric‑acid‑lowering drugs after a gout diagnosis to keep levels below 360 µmol/L"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"Done"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"Plan to do"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"Save"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Share this tip"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Hide details"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Cost"]},{"tag":"p","props":{},"children":["Allopurinol costs only a few to several tens of yuan per month. At first, blood uric‑acid levels must be checked every few weeks to adjust the dose; once stable, checks can be done every few months. For the first 3–6 months, a second medication to prevent flare‑ups is also required. The difficulty lies in the fact that patients must keep taking it even when they feel no pain."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Benefit"]},{"tag":"p","props":{},"children":["In a randomized controlled trial of 517 adults who had experienced gout attacks within the previous 12 months, one group received nurse‑led education and dose adjustments to achieve the target level, while the other continued routine care. After two years, 95 % of the intervention group versus 30 % of the control group had uric‑acid levels below 360 µmol/L (6 mg/dL). The odds of success were 3.18 times higher in the intervention group (RR 3.18, 95 % CI 2.42–4.18; P < 0.0001). Secondary outcomes — attack frequency, tophus formation, and quality of life — also improved. Each additional quality‑adjusted life year gained cost £5,066. Follow‑up data showed that 82 % of participants reported zero attacks in the previous year, versus a median of one attack for the control group (P < 0.001). The proportion still on therapy was 1.19 times higher in the intervention group (adjusted RR 1.19, 1.09–1.30). The 2020 American College of Rheumatology guidelines recommend uric‑acid‑lowering therapy for patients with tophi, bone erosion on imaging, or ≥2 attacks per year; the target is <6 mg/dL, achieved by regular monitoring and dose titration, with allopurinol as first‑line therapy, especially for those with stage 3 or higher chronic kidney disease. Anti‑inflammatory prophylaxis is advised for 3–6 months at initiation. Observational data indicate that after successful control, many patients can discontinue medication without relapse; however, only 13 % remained flare‑free over five years. Alcohol restriction lowers uric‑acid levels by 1.6 mg/dL, while a single beer raises them by 0.16 mg/dL; healthier diets have far smaller effects. Debate persists over optimal drug choice: allopurinol is favored for its efficacy, safety, and low cost, though patients with cardiovascular disease or recent events may be switched to other agents per FDA warnings. The CARES trial linked allopurinol to a 22 % higher risk of all‑cause mortality (HR 1.22) and a 34 % higher risk of cardiovascular death (HR 1.34) versus allopurinol; the European FAST trial found no such increase. Urine alkalinization is not recommended for uricosuric agents due to lack of evidence. Adequate hydration is essential, especially for patients with kidney stones or advanced CKD."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Original sources"]},{"tag":"p","props":{"className":"life-citations"},"children":["Doherty M, Jenkins W, Richardson H, et al. (2018). Efficacy and cost-effectiveness of nurse-led care involving education and engagement of patients and a treat-to-target urate-lowering strategy versus usual care for gout: a randomised controlled trial. Lancet, 392(10156), 1403-1412. ",{"tag":"a","props":{"href":"https://doi.org/10.1016/S0140-6736(18)32158-5","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1016/S0140-6736(18)32158-5"]},"；Abhishek A, Jenkins W, La-Crette J, Fernandes G, Doherty M (2020). Nurse-led care is preferred over GP-led care of gout and improves gout outcomes: results of Nottingham Gout Treatment Trial follow-up study. Rheumatology, 59(3), 575-579. ",{"tag":"a","props":{"href":"https://doi.org/10.1093/rheumatology/kez333","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1093/rheumatology/kez333"]},"；FitzGerald JD, Dalbeth N, Mikuls T, et al. (2020). 2020 American College of Rheumatology Guideline for the Management of Gout. Arthritis Care & Research, 72(6), 744-760. ",{"tag":"a","props":{"href":"https://doi.org/10.1002/acr.24180","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1002/acr.24180"]},"；White WB, Saag KG, Becker MA, et al.; CARES Investigators (2018). Cardiovascular Safety of Febuxostat or Allopurinol in Patients with Gout. New England Journal of Medicine, 378(13), 1200-1210. ",{"tag":"a","props":{"href":"https://doi.org/10.1056/NEJMoa1710895","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1056/NEJMoa1710895"]},"；Mackenzie IS, Ford I, Nuki G, et al.; FAST Study Group (2020). Long-term cardiovascular safety of febuxostat compared with allopurinol in patients with gout (FAST): a multicentre, prospective, randomised, open-label, non-inferiority trial. Lancet, 396(10264), 1745-1757. ",{"tag":"a","props":{"href":"https://doi.org/10.1016/S0140-6736(20)32234-0","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1016/S0140-6736(20)32234-0"]},"；中华医学会内分泌学分会 (2020). 中国高尿酸血症与痛风诊疗指南(2019). 中华内分泌代谢杂志, 36(1), 1-13. ",{"tag":"a","props":{"href":"https://doi.org/10.3760/cma.j.issn.1000-6699.2020.01.001","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.3760/cma.j.issn.1000-6699.2020.01.001"]}]},{"tag":"a","props":{"href":"https://doi.org/10.1016/S0140-6736(18)32158-5","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Open source link"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Book note"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["Controversy exists: different countries recommend different first‑line drugs. The U.S. guideline favors allopurinol and advises avoiding febuxostat in patients with cardiovascular disease, whereas the FAST trial found no increased risk with febuxostat. Probenecid, another uricosuric agent, is available in China. Chinese guidelines (2019 and 2024 updates) provide separate recommendations on drug selection and urine alkalinization; they suggest that sodium bicarbonate may be unnecessary, but hydration remains crucial. ",{"tag":"strong","props":{},"children":["Han Chinese individuals should be screened for HLA‑B*5801 before starting allopurinol"]},"; carriers account for 7.4 % of Han Chinese, 0.7 % of Caucasians and Hispanics, and have a three‑fold higher risk of allopurinol‑induced hypersensitivity syndrome, a potentially fatal condition involving extensive skin peeling. The 2020 ACR guidelines recommend screening for these groups. Initiation of therapy can temporarily increase flare‑ups, so anti‑inflammatory prophylaxis for 3–6 months is mandatory; discontinuing uric‑acid‑lowering drugs because of pain is a common cause of treatment failure. When an attack occurs, additional anti‑inflammatory medication should be added per medical advice, not the uric‑acid‑lowering drug. Target levels are expressed as <6 mg/dL (≈360 µmol/L); Chinese labs typically report µmol/L. Asymptomatic hyperuricemia is addressed separately in Section 6, Item 19. Sugar‑sweetened beverages and alcohol are discussed in Section 2, Items 7 and 19. 〔100〕 〔100〕 〔438〕 〔211〕 〔6190〕 〔1.01〕 〔1.47〕 〔1.03〕 〔1.03〕 〔1.73〕 〔6128〕 〔60〕 〔0.85〕 〔7.2〕 〔8.6〕"]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["My note"]},{"tag":"button","props":{"type":"button"},"children":["Write a reminder for yourself…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/en/tip/16-08"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Previous"]},"People who have had kidney stones should drink 2.5–3 liters of water daily and keep salt intake under 6 grams"]}]}]},{"tag":