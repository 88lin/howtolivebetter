,{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/28-07"},"children":[{"tag":"strong","props":{},"children":["性激素类药只在医生开方并定期复查的前提下用，不要网购、不要自己加量"]},{"tag":"span","props":{},"children":["这条不讨论该不该用，只讨论怎么用。用雌激素的跨性别女性，血管里长血块的比同龄人明显多，每一千人两年多出约 4 个，八年多出约 17 个。这…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/28-08"},"children":[{"tag":"strong","props":{},"children":["如果「觉得自己丑」已经到反复照镜子、反复想改的程度，先做一次体像评估再谈手术"]},{"tag":"span","props":{},"children":["去做整形手术的人里约 15% 有躯体变形障碍，就是把别人基本看不出的缺陷放大到影响生活。去皮肤科求美的人里约 13%，两边都是七成多为女性…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/28-09"},"children":[{"tag":"strong","props":{},"children":["矫正牙齿要找有正畸资质的医生当面检查、按时复诊，别网购牙套自己在家戴"]},{"tag":"span","props":{},"children":["透明牙套在国内是二类医疗器械，说明书要求在有正畸资质的医生指导下戴、定期复诊。美国药监部门说没批准过不经牙医开方就直接卖给个人的牙套。没人…"]}]}]}]},{"tag":"a","props":{"className":"life-text-link","href":"/book/28"},"children":["阅读整个主题：别为了外形把身体搞坏"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"15","height":"15","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]}]}]}]},{"tag":"aside","props":{"className":"life-ad-space life-ad-space-sponsored","data-ad-placement":"ad_footer","data-ad-group":"reading","data-ad-creative":"read_product","data-ad-ready":"false","aria-label":"广告 · 社区推荐"},"children":[{"tag":"div","props":{"className":"life-ad-space-brand"},"children":[{"tag":"img","props":{"src":"/sites/howtolivebetter/images/shengcai/logo.png","width":"565","height":"144","alt":"生财有术官方 Logo","decoding":"async"},"children":[]}]},{"tag":"div","props":{"className":"life-ad-space-copy"},"children":[{"tag":"span","props":{"className":"life-ad-space-label"},"children":["广告 · 社区推荐"]},{"tag":"strong","