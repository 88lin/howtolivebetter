9"},"children":[]}]},"分享这条建议"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"收起详情"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["成本"]},{"tag":"p","props":{"className":"life-citations"},"children":["不花钱。和老人对一次话，几分钟就行"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["收益"]},{"tag":"p","props":{"className":"life-citations"},"children":["推销和诈骗都靠现场施压。美国联邦贸易委员会的防骗指南写着，骗子要你在来得及想之前就行动。打电话时，他们会叫你别挂断，让你没法去核实。指南给的办法是，做任何事之前先告诉一个人，朋友、家人、邻居都行，说出来可能就看出是骗局。原银保监会 2021 年的风险提示，也建议老年人买理财前多和家人商量。一项实验找了 116 名 65 到 85 岁的老人和 115 名 30 到 40 岁的人。研究者先用一个输赢游戏，把一部分人的情绪调动起来，再让他们看夸大不实的广告。情绪真被调动起来的人，更想买广告里的东西。不管情绪激不激动，老人都比年轻人更想买。作者建议，等情绪平静下来再做花钱的决定。另一项实验找的是以前被邮寄诈骗骗过钱的人，多数上了年纪。没提前提醒的人，接到模拟的推销诈骗电话，近一半一口答应。提前两到四周打电话提醒过的，一口答应的明显少了。事先商量好一句「我要回去和家里人商量」，让老人有台阶可下，不用当场做决定"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["来源"]},{"tag":"p","props":{"className":"life-citations"},"children":["Federal Trade Commission (2023). How To Avoid a Scam. ",{"tag":"a","props":{"href":"https://consumer.ftc.gov/articles/how-avoid-scam","target":"_blank","rel":"noopener noreferrer"},"children":["https://consumer.ftc.gov/articles/how-avoid-scam"]},"；中国银保监会消费者权益保护局 (2021). 关于警惕「投资养老」「以房养老」金融诈骗的风险提示（2021 年第三期）. ",{"tag":"a","props":{"href":"https://dfjrjgj.hunan.gov.cn/dfjrjgj/yhlj/202106/t20210608_19450856.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://dfjrjgj.hunan.gov.cn/dfjrjgj/yhlj/202106/t20210608_19450856.html"]},"（湖南省地方金融监督管理局转载）；Kircanski K, Notthoff N, DeLiema M, et al. (2018). Emotional arousal may increase susceptibility to fraud in older and younger adults. Psychology and Aging, 33(2), 325-337. ",{"tag":"a","props":{"href":"https://doi.org/10.1037/pag0000228","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1037/pag0000228"]},"；Scheibe S, Notthoff N, Menkin J, et al. (2014). Forewarning reduces fraud susceptibility in vulnerable consumers. Basic and Applied Social Psychology, 36(3), 272-279. ",{"tag":"a","props":{"href":"https://doi.org/10.1080/01973533.2014.903844","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1080/01973533.2014.903844"]},""]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["原书备注"]},{"tag":"p","props":{"className":"life-citations"},"children":["给 B 的原因是两项实验测的都不是这句话本身。一项测的是情绪激动时想不想买，另一项测的是提前提醒管不管用，没有研究比过备了这句话的老人少被骗多少。和第 3 条（老人的钱单独放一个账户）一起用。家里的防跌倒改造也顺手做了，见第 1 节。这句话是给老人留个台阶，让他不用当场硬顶，不是用来防着他的。被推销围住的时候，最难的是当着一屋子人开口拒绝，比判断真假还难"]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["我的备注"]},{"tag":"button","props":{"type":"button"},"children":["写下对自己有用的提醒…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/tip/17-03"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["上一条"]},"老人的钱单独放一个账户，大额支出定一个双人确认的规矩"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/tip/17-05"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["下一条"]},"凡是让老人先交钱的「投资养老」都别碰：办卡、买床位、买养老公寓、旅居养老、买老年产品是同一套非法集资"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["本主题的其他建议"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/17-01"},"children":[{"tag":"strong","props":{},"children":["趁老人清醒，书面指定将来的监护人"]},{"tag":"span","props":{},"children":["趁老人头脑还清楚，花几百元去公证处办一份书面文件，写明将来谁当他的监护人。没有这份文件，等老人不能自己做决定了，谁替他签字、谁替他管钱，要由法院来指定。家里人意…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/17-02"},"children":[{"tag":"strong","props":{},"children":["把遗嘱立了，记住后立的推翻先立的，公证遗嘱不再优先"]},{"tag":"span","props":{},"children":["法律认六种遗嘱，但形式写错了整份作废，这是最常见的翻车点。自己手写的那种，要本人从头到尾手写，签上名，写清年月日。立了好几份、内容互相打架的，按最后立的那份算。…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/17-06"},"children":[{"tag":"strong","props":{},"children":["除了保险公司的住房反向抵押养老保险，其他「以房养老」都别碰，绝不抵押房子去买理财"]},{"tag":"span","props":{},"children":["正规的以房养老只有一种，就是保险公司的住房反向抵押养老保险，还在试点。上门推销的那种和它毫无关系，是骗老人抵押房子，再拿借来的钱买它推荐的理财。有人连房子被抵押…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/17-07"},"children":[{"tag":"strong","props":{},"children":["家里老人长期卧床或重度失能，去参保地医保部门申请长期护理保险；它不是只发给老人"]},{"tag":"span","props":{},"children":["长期护理保险帮你出请人照护的钱。家里有人重度失能、持续半年以上，就去参保地医保部门申请。护理费不用先自己垫，职工参保的报七成左右，城乡居民参保的报五成左右，床位…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/17-08"},"children":[{"tag":"strong","props":{},"children":["家里有人长期卧床，把压疮当头号敌人：上电动气垫床、定时翻身、每天看一遍骨头突出的地方"]},{"tag":"span","props":{},"children":["髋部骨折开刀前就有压疮的老人，30 天内去世的可能性高约两成。换电动气垫床，新长压疮的少约六成。按时翻身真正做到位，少约七成。别让人长时间趴着。每天看一遍骶尾、…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/17-09"},"children":[{"tag":"strong","props":{},"children":["老人的白内障已经影响看路，就去眼科评估做手术；两只眼都有的，第二只别拖太久"]},{"tag":"span","props":{},"children":["70 岁以上的女性尽快做第一只眼的白内障手术，一年里跌倒的次数少约三成四，骨折的人也少了。但摔过跤的人数没有少。第二只眼做不做，跌倒上没看出明显差别。做了手术的…"]}]}]}]},{"tag":"a","props":{"className":"life-text-link","href":"/book/17"},"children":["阅读整个主题：家里有老人 ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"15","height":"15","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]}]}]}]},{"tag":"aside","props":{"className":"life-ad-space life-ad-space-sponsored","data-ad-placement":"ad_footer","data-ad-group":"reading","data-ad-creative":"read_product","data-ad-ready":"false","aria-label":"广告 · 社区推荐"},"children":[{"tag":"div","props":{"className":"life-ad-space-brand"},"children":[{"tag":"img","props":{"src":"/sites/howtolivebetter/images/shengcai/logo.png","width":"565","height":"144","alt":"生财有术官方 Logo","decoding":"async"},"children":[]}]},{"tag":"div","props":{"className":"li