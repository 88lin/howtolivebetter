e-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Ẩn chi tiết"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Chi phí"]},{"tag":"p","props":{},"children":["Không tốn tiền. Việc phải làm chỉ là đừng tính 「đổi vận」「dưỡng người」 vào lý do mua nó. Chỗ khó là khi mọi người đều đeo, đều nói là linh, mà bạn không theo."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Lợi ích"]},{"tag":"p","props":{},"children":["Thí nghiệm lớp học kinh điển cho thấy ai nhận bản 「phân tích cá nhân」 chung chung giống nhau đều cho là rất chính xác, hiện tượng đó gọi là hiệu ứng Barnum. Nó giải thích cảm giác 「đeo vào thấy mọi việc thuận lợi」 đến từ đâu. Kết luận của tác giả đó là 「việc người được phân tích chấp nhận không chứng minh được lời giải thích là đúng」. Vụ việc chính thức: Cục Quản lý thị trường quốc gia công bố ngày 4 tháng 6 năm 2026 một loạt vụ điển hình 「đánh giả, làm sạch nguồn gốc」 trong các thị trường thủ công truyền thống. Trong đó có một cửa hàng trang sức ở Tứ Hội, Quảng Đông, bịa chất liệu sản phẩm trong phòng phát trực tiếp. Cửa hàng còn bịa công năng 「phòng trị thấp khớp, tăng cường miễn dịch, cải thiện chất lượng giấc ngủ, thông mạch máu」 cho sản phẩm. Cửa hàng dựng kịch bản để đánh lừa, lừa dối người tiêu dùng. Việc đó vi phạm Điều 9, khoản đầu của Luật Chống cạnh tranh không công (toàn quốc)"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Nguồn gốc"]},{"tag":"p","props":{"className":"life-citations"},"children":["Forer BR (1949). The fallacy of personal validation: A classroom demonstration of gullibility. Journal of Abnormal and Social Psychology. ",{"tag":"a","props":{"href":"https://doi.org/10.1037/h0059240","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1037/h0059240"]},"；国家市场监督管理总局 (2026). 市场监管总局公布一批传统工艺市场「打假清源」典型案例. ",{"tag":"a","props":{"href":"https://www.samr.gov.cn/xw/zj/art/2026/art_1529399cfe874b8780c4496eb0158020.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.samr.gov.cn/xw/zj/art/2026/art_1529399cfe874b8780c4496eb0158020.html"]}]},{"tag":"a","props":{"href":"https://doi.org/10.1037/h0059240","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Liên kết mở nguồn"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Ghi chú sách"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["Kết luận chỉ có một: công năng của nó không thể kiểm chứng, và không đo được khả năng dự báo nào. Không đánh giá tín ngưỡng hay phong tục nào, cũng không nhắm vào các mục đích tặng quà, lưu niệm, truyền lại. Cần tách hai việc: công năng mà người bán tuyên bố có quy định văn bản làm căn cứ, có thể đi khiếu nại; còn các lời như 「đổi vận」 vừa không có nghiên cứu, vừa không chứng minh được là giả, chỉ có thể tự kiềm chế bằng ngân sách. Trước khi mua, hãy coi nó là món trang sức thường, tự hỏi một câu 「nếu nó không thay đổi gì cả, giá này tôi có mua không」. Cách kiểm tra chất liệu và giấy chứng nhận, vì sao coi nó là đầu tư là không đáng, xem mục 33 và 34 ở phần 5 (chuỗi tay và đồng hồ đắt tiền tính theo số tiền đã tiêu, đá quý thì nhận báo cáo CMA). Bỏ tiền xem bói thì xem mục 15 của phần này (xem bói, tarot, chiêm tinh)."]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Ghi chú của tôi"]},{"tag":"button","props":{"type":"button"},"children":["Viết một lời nhắc cho chính bạn…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/vi/tip/06-21"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Trước"]},"Đừng bỏ canxi hoàn toàn để phòng sỏi thận"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/vi/tip/06-23"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Tiếp theo"]},"Đừng trông chờ mua sắm để cải thiện tâm trạng hay cảm giác về vị thế của mình"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"pa