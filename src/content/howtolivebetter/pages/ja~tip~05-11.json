y":"12","r":"10"},"children":[]}]},{"tag":"span","props":{},"children":["ログイン"]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/ja/book/05"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"目次に戻る"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["お金を無駄にしない"]},{"tag":"nav","props":{"aria-label":"この章のヒント"},"children":[{"tag":"a","props":{"href":"/ja/tip/05-01"},"children":[{"tag":"span","props":{},"children":["01"]},"すべての自動更新をオフにし、期限切れ後に手動更新へ切り替える"]},{"tag":"a","props":{"href":"/ja/tip/05-02"},"children":[{"tag":"span","props":{},"children":["02"]},"毎年3月から6月にかけて確定申告を行い、特別控除の項目は漏れなく記入する"]},{"tag":"a","props":{"href":"/ja/tip/05-03"},"children":[{"tag":"span","props":{},"children":["03"]},"積立金（公積金）は住宅購入のためだけではない：賃貸、リフォーム、管理費の引き出しも可能、2026 年 9 月 20 日より新条例に基づき実施"]},{"tag":"a","props":{"href":"/ja/tip/05-04"},"children":[{"tag":"span","props":{},"children":["04"]},"携帯電話とブロードバンドのプランを年に一度見直す。不要なものはダウングレードし、キャリアが転出を拒むなら苦情を。"]},{"tag":"a","props":{"href":"/ja/tip/05-05"},"children":[{"tag":"span","props":{},"children":["05"]},"宝くじは買わない"]},{"tag":"a","props":{"href":"/ja/tip/05-06"},"children":[{"tag":"span","props":{},"children":["06"]},"「高収益」「元本保証」「確実な利益」という言葉を見たら、すぐに立ち去る"]},{"tag":"a","props":{"href":"/ja/tip/05-07"},"children":[{"tag":"span","props":{},"children":["07"]},"クレジットカードの最小支払いを利用しない、分割払いや消費者ローンを利用しない。借りる必要がある場合は、まず利息を年利（年換算利率）に直して比較する"]},{"tag":"a","props":{"href":"/ja/tip/05-08"},"children":[{"tag":"span","props":{},"children":["08"]},"配信者への投げ銭をしない、ゲームへの課金をしない、衝動買いをしない"]},{"tag":"a","props":{"href":"/ja/tip/05-09"},"children":[{"tag":"span","props":{},"children":["09"]},"子供によるスマホでの課金・投げ銭：8歳以上の高額な支出は、親の追認がない場合、返還を請求できる可能性がある"]},{"tag":"a","props":{"href":"/ja/tip/05-10"},"children":[{"tag":"span","props":{},"children":["10"]},"子供に教えるべき一言：「誰かに親のスマホを操作させたり、認証コードを伝えさせようとしたら、それは詐欺師です」"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/ja/tip/05-11","data-status":"active"},"children":[{"tag":"span","props":{},"children":["11"]},"電子製品の延長保証（延保）を断る"]},{"tag":"a","props":{"href":"/ja/tip/05-12"},"children":[{"tag":"span","props":{},"children":["12"]},"一致性評価を通過したジェネリック医薬品や、集中調達（集采）の採用薬を優先的に選ぶ"]},{"tag":"a","props":{"href":"/ja/tip/05-13"},"children":[{"tag":"span","props":{},"children":["13"]},"医療保険Appで「家族共済」の紐付けを行えば、従業員医療保険の個人口座の資金を配偶者、父母、子供の通院や薬代に利用可能に"]},{"tag":"a","props":{"href":"/ja/tip/05-14"},"children":[{"tag":"span","props":{},"children":["14"]},"水道水は沸騰させて飲み、ウォーターサーバー用の大容量ボトルの水を定期注文したり、小瓶の水を常時買ったりしない"]},{"tag":"a","props":{"href":"/ja/tip/05-15"},"children":[{"tag":"span","props":{},"children":["15"]},"株式の頻繁な取引を避ける。相場が急騰・急落している時こそ、より動きを控えるべきである"]},{"tag":"a","props":{"href":"/ja/tip/05-16"},"children":[{"tag":"span","props":{},"children":["16"]},"借金による投資、レバレッジの使用、理解できない銘柄の購入は避ける"]},{"tag":"a","props":{"href":"/ja/tip/05-17"},"children":[{"tag":"span","props":{},"children":["17"]},"長期的なコア資産（長期保有し続ける資金）として、アクティブファンドの代わりに広範なインデックスファンドを活用する"]},{"tag":"a","props":{"href":"/ja/tip/05-18"},"children":[{"tag":"span","props":{},"children":["18"]},"同種のファンドなら、より低い信託報酬率のものを優先的に選ぶ"]},{"tag":"a","props":{"href":"/ja/tip/05-19"},"children":[{"tag":"span","props":{},"children":["19"]},"一つの銘柄、一つのプラットフォーム、一つの不動産に全財産を投じない"]},{"tag":"a","props":{"href":"/ja/tip/05-20"},"children":[{"tag":"span","props":{},"children":["20"]},"所得税を支払っており、税率が 10% 以上の人は個人年金口座を開設すれば、年間最大 12000 元を課税前控除できる。所得税を支払っていない、または税率が 3% の人は、開設しても割に合わない"]},{"tag":"a","props":{"href":"/ja/tip/05-21"},"children":[{"tag":"span","props":{},"children":["21"]},"ジムの都度払い、または短期契約は、1年以上の継続的な利用実績がない限り避けるべき"]},{"tag":"a","props":{"href":"/ja/tip/05-22"},"children":[{"tag":"span","props":{},"children":["22"]},"前払金の請求には書面契約を；事業者にリスクが生じた場合は支払いを停止、失踪に備え未消費残高の返金を求める権利があります"]},{"tag":"a","props":{"href":"/ja/tip/05-23"},"children":[{"tag":"span","props":{},"children":["23"]},"高額な非必需品の購入には 24 時間のクーリングオフ期間を、ネットショッピングでは「7日間の無理由返品」を賢く活用"]},{"tag":"a","props":{"href":"/ja/tip/05-24"},"children":[{"tag":"span","props":{},"children":["24"]},"「打ち消し線価格」やセール時の買い溜めに惑わされない"]},{"tag":"a","props":{"href":"/ja/tip/05-25"},"children":[{"tag":"span","props":{},"children":["25"]},"保険は掛け捨て型を優先し、「返戻金」「配当金」は不確実なものとして扱う"]},{"tag":"a","props":{"href":"/ja/tip/05-26"},"children":[{"tag":"span","props":{},"children":["26"]},"第三者賠償責任保険は十分な額を：交強保険の限度額は全国一律で低く、超過分は自己負担となる"]},{"tag":"a","props":{"href":"/ja/tip/05-27"},"children":[{"tag":"span","props":{},"children":["27"]},"まずは 3 から 6 ヶ月分の生活費を、いつでも引き出せる場所に緊急資金として貯める"]},{"tag":"a","props":{"href":"/ja/tip/05-28"},"children":[{"tag":"span","props":{},"children":["28"]},"住宅ローンを繰り上げ返済する前に、感覚ではなく比較検討を"]},{"tag":"a","props":{"href":"/ja/tip/05-29"},"children":[{"tag":"span","props":{},"children":["29"]},"ネットショッピングではプラットフォームのルールと法条を確認し、配信者や「高評価」を信じない"]},{"tag":"a","props":{"href":"/ja/tip/05-30"},"children":[{"tag":"span","props":{},"children":["30"]},"ライブコマースで購入した商品に問題が発生した場合、まずはプラットフォームに販売者と配信者の情報を請求してください。プラットフォームは提供する義務があります"]},{"tag":"a","props":{"href":"/ja/tip/05-31"},"children":[{"tag":"span","props":{},"children":["31"]},"不安全な食品を購入した場合、返金に加えて10倍の賠償を請求可能。賠償額が1,000元に満たない場合は1,000元として計算"]},{"tag":"a","props":{"href":"/ja/tip/05-32"},"children":[{"tag":"span","props":{},"children":["32"]},"大型家電を購入する前に、国の抜き取り検査通知、3C認証、および省エネラベルを確認しましょう"]},{"tag":"a","props":{"href":"/ja/tip/05-33"},"children":[{"tag":"span","props":{},"children":["33"]},"ブレスレット、宝石、高級時計、アートトイは「使ったお金」として計算し、「貯まったお金」として計算しないこと"]},{"tag":"a","props":{"href":"/ja/tip/05-34"},"children":[{"tag":"span","props":{},"children":["34"]},"宝石・貴金属はCMAマーク付きの検査報告書のみを信頼し、発行機関の公式サイトでその機関を必ず確認すること"]},{"tag":"a","props":{"href":"/ja/tip/05-35"},"children":[{"tag":"span","props":{},"children":["35"]},"ブラインドボックスやカードガチャなどのランダム販売は、「このお金は戻ってこない」と考えて扱うこと"]},{"tag":"a","props":{"href":"/ja/tip/05-36"},"children":[{"tag":"span","props":{},"children":["36"]},"食品の添加物が気になるなら、包装済み製品を買うこと：バラ売りカウンターは法律上、原材料表示が義務付けられていない"]},{"tag":"a","props":{"href":"/ja/tip/05-37"},"children":[{"tag":"span","props":{},"children":["37"]},"損失が出ている銘柄も事前に決めたルールに従って売却すべきであり、ナンピン買いで平均取得単価を下げることで挽回しようとしてはならない"]},{"tag":"a","props":{"href":"/ja/tip/05-38"},"children":[{"tag":"span","props":{},"children":["38"]},"米国株などの海外資産を購入したい場合は、QDII基金または香港株通を利用しましょう。海外証券会社での口座開設や、毎年の外貨両替枠の利用は避けてください"]},{"tag":"a","props":{"href":"/ja/tip/05-39"},"children":[{"tag":"span","props":{},"children":["39"]},"自分では耐えられない損失に対してのみ保険を購入し、耐えられる損失は予備費でカバーする"]},{"tag":"a","props":{"href":"/ja/tip/05-40"},"children":[{"tag":"span","props":{},"children":["40"]},"家族の生活をあなたの収入に依存している人がいるなら、子供より先に稼ぎ手に対して定期死亡保険を検討すべきです"]},{"tag":"a","props":{"href":"/ja/tip/05-41"},"children":[{"tag":"span","props":{},"children":["41"]},"1年以上契約の人身保険を後悔し、猶予期間内に解約した場合、保険料はほぼ全額返金される"]},{"tag":"a","props":{"href":"/ja/tip/05-42"},"children":[{"tag":"span","props":{},"children":["42"]},"銀行窓口で署名する前に、手元にあるのが預金か保険かを必ず確認すること"]},{"tag":"a","props":{"href":"/ja/tip/05-43"},"children":[{"tag":"span","props":{},"children":["43"]},"解約したいなら自分で保険会社に手続きしましょう。「代理解約」は利用せず、誤解を招いたと感じたら12378に苦情を申し立ててください"]},{"tag":"a","props":{"href":"/ja/tip/05-44"},"children":[{"tag":"span","props":{},"children":["44"]},"保険証券の受益者には具体的な個人名を記載しましょう。万が一の際は、期限内に請求を：生命保険は 5 年、その他の保険は 2 年以内"]},{"tag":"a","props":{"href":"/ja/tip/05-45"},"children":[{"tag":"span","props":{},"children":["45"]},"ビットコイン、テザーなどの暗号資産を買わず、誘われても投資しない。取引は法的保護を受けず、損失は訴えても取り戻せない"]},{"tag":"a","props":{"href":"/ja/tip/05-46"},"children":[{"tag":"span","props":{},"children":["46"]},"勤務先がない人が従業員基本年金保険を自分で納付するなら、最低水準で必要な年数を満たすのが最も有利。すぐに得をするわけではなく、最低水準でも払った分の回収に約 10 年の受給が必要"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"現在地"},"children":[{"tag":"a","props":{"href":"/ja/book"},"children":["本を読む"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/ja/book/05"},"children":["第5章"," ·"," ","お金を無駄にしない"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"05-11"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["11"]},{"tag":"span","props":{"className":"life-evidence grade-b"},"children":["エビデンス"," ","B"]}]},{"tag":"h1","props":{"lang":"ja"},"children":["電子製品の延長保証（延保）を断る"]},{"tag":"p","props":{"lang":"ja","className":"life-entry-summary"},"children":["延長保証の価格は、通常商品の元の価格の 10% から 50% です。延長保証の利益率は、通常商品の数十倍に達します。この差額こそが、あなたが余分に支払っている金額です。洗濯機や冷蔵庫のモーターなどの主要部品は、国の規定によりもともと3年間の保証がついています。非常に安価な延長保証を見つけた場合は、「延長保証の価格 ÷ 1回の修理費用」を計算してみてください。その数値よりも、保証期間中に少なくとも1回は故障する確率が高いと予想される場合にのみ、元が取れることになります。"]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["費用・手間"]},{"tag":"p","props":{},"children":["費用はかかりません。代償として、保証期間が過ぎた後に万が一修理が必要になった場合、自費で支払う必要があります。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["効果"]},{"tag":"p","props":{},"children":["延長保証の価格は、通常商品の元の価格の 10% から 50% です。研究で引用されている業界の推定では、延長保証の平均売上総利益率は 50% から 60% です。"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"記録する：電子製品の延長保証（延保）を断る"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"できている"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"やることに追加"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"お気に入り"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"このヒントを共有"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"詳細を閉じる"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["費用・手間"]},{"tag":"p","props":{},"children":["費用はかかりません。代償として、保証期間が過ぎた後に万が一修理が必要になった場合、自費で支払う必要があります。ただし、そのような事態が起こる確率は高くありません。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["効果"]},{"tag":"p","props":{},"children":["延長保証の価格は、通常商品の元の価格の 10% から 50% です。研究で引用されている業界の推定では、延長保証の平均売上総利益率は 50% から 60% です。つまり、100元の売上に対して、50から60元が利益となります。これは、一般的な商品の売上総利益率の約 18 倍に相当します。2003 年、延長保証はBest Buyの売上高のわずか 3% から 4% を占めるに過ぎませんでしたが、利益の 50% 以上を貢献しました（米国、2000 年代の小売データ）。価格がこの範囲を大幅に下回るような格安の延長保証を見つけた場合は、自分で計算してみましょう。「延長保証の価格 ÷ 1回の修理費用 = 元を取るために必要な故障確率」です。保証期間中に少なくとも1回は故障する確率が、この数値よりも高いと予想される場合にのみ、購入する価値があります。例えば、延長保証が25元で、修理費用が1回300元だと仮定した場合、元を取るには少なくとも約 8% 以上の確率で故障する必要があります。ここでの300元はあくまで例であり、統計的な数字ではありません。計算する前に、国の規定ですでに保証されている期間を差し引いてください。国の規定による三包（修理・交換・返品）期間は、領収書の発行日からカウントされます。洗濯機と冷蔵庫の本体は1年間、主要部品は3年間です。洗濯機の主要部品はモーター、タイマー、プログラムコントローラー、コンデンサーであり、冷蔵庫はコンプレッサー、サーモスタットなどです。延長保証が三包期間と重複している部分は、本来あるはずの保証に対して追加料金を支払っていることになります（中国全国、1995 年より）。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["出典"]},{"tag":"p","props":{"className":"life-citations"},"children":["Chen T, Kalra A, Sun B (2009). Why Do Consumers Buy Extended Service Contracts? Journal of Consumer Research 36(4):611-623. ",{"tag":"a","props":{"href":"https://doi.org/10.1086/605298","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1086/605298"]},"；国家经贸委等 (1995). 部分商品修理更换退货责任规定（国经贸〔1995〕458 号，第八条三包有效期自开具发票之日起计算；附件《实施三包的部分商品目录（第一批）》洗衣机、家用电冰箱整机 1 年、主要部件 3 年）. 国家市场监督管理总局行政规范性文件. ",{"tag":"a","props":{"href":"https://www.samr.gov.cn/zw/zfxxgk/zc/xzgfxwj/art/2019/art_f943e66de125437d92df701e1654c47c.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.samr.gov.cn/zw/zfxxgk/zc/xzgfxwj/art/2019/art_f943e66de125437d92df701e1654c47c.html"]}]},{"tag":"a","props":{"href":"https://doi.org/10.1086/605298","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["出典を開く"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["著者の注記"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["粗利率の数値は、論文が他者の業界推計を引用したものであり（Business Week 2004）、論文自体が測定したものではありません。上記の計算式は、一度の修理費用を自ら負担できる一般の人に適しています。一台のデバイスで生計を立てており、かつ予備機を持っていない人は、別途計算する必要があります。スマートフォンの画面割れ保険などの類についても、個別に計算すべきです。まず、自分がどのくらいの頻度で画面を割るかを予測し、その上で保険料が妥当かどうかを判断してください。非常に安価な延長保証であれば、購入しても数十元の損で済みます。購入前に以下の3点を確認してください：1. 保証がいつから開始されるか（購入日から開始され、最初の数年間は三包期間と重複します）、2. 保証を提供するのは販売店か、ブランドか、それとも第三者企業か、3. 出張費や部品代が別途請求されないか。また、取扱説明書や保証書も事前に確認してください。ブランド独自の保証期間は、国の三包規定よりも長い場合があります。"]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["自分のメモ"]},{"tag":"button","props":{"type":"button"},"children":["自分へのメモを書く…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/ja/tip/05-10"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["前へ"]},"子供に教えるべき一言：「誰かに親のスマホを操作させたり、認証コードを伝えさせようとしたら、それは詐欺師です」"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/ja/tip/05-12"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["次へ"]},"一致性評価を通過したジェネリック医薬品や、集中調達（集采）の採用薬を優先的に選ぶ"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}