/howtolivebetter/images/book-chapters/26-website-editorial-thumb.webp 600w, /sites/howtolivebetter/images/book-chapters/26-website-editorial-md.webp 900w, /sites/howtolivebetter/images/book-chapters/26-website-editorial.webp 1200w","sizes":"(max-width: 760px) 100vw, 450px","alt":"","width":"1200","height":"800","fetchPriority":"high"},"children":[]}]},{"tag":"div","props":{"className":"life-longread-layout"},"children":[{"tag":"aside","props":{"className":"life-longread-toc"},"children":[{"tag":"details","props":{"open":true},"children":[{"tag":"summary","props":{},"children":["On this page"]},{"tag":"nav","props":{"aria-label":"On this page"},"children":[{"tag":"a","props":{"href":"#1-first-work-out-which-kind-of-business-you-are-running"},"children":["1. First, work out which kind of business you are running"]},{"tag":"a","props":{"href":"#2-the-platforms-own-day-to-day-obligations"},"children":["2. The platform's own day-to-day obligations"]},{"tag":"a","props":{"href":"#3-choosing-a-server-how-to-pick-among-the-three-tiers"},"children":["3. Choosing a server: how to pick among the three tiers"]},{"tag":"a","props":{"href":"#4-the-limits-of-this-document"},"children":["4. The limits of this document"]}]}]}]},{"tag":"div","props":{"className":"life-longread-main"},"children":[{"tag":"article","props":{"className":"life-article-body","lang":"en"},"children":[{"tag":"blockquote","props":{},"children":["\n",{"tag":"p","props":{},"children":["Unofficial English translation of ",{"tag":"a","props":{"href":"/articles/platform-licenses"},"children":["docs/做平台要办哪些证.md"]},". In case of discrepancies the Chinese original takes precedence."]},"\n"]},"\n",{"tag":"p","props":{},"children":["This corresponds to ",{"tag":"a","props":{"href":"/en/book/26","title":"Building a website or platform: licensing, registration, and servers"},"children":["Section 26"]}," of the README. This page holds only two tables and a few notes on points that are easy to get wrong; the entry text and sources live in the README. How to register a company and how to file taxes is covered in ",{"tag":"a","props":{"href":"/en/book/12","title":"Starting a business: how to protect your personal assets"},"children":["Section 12"]},"; the red lines for employed tech workers are in ",{"tag":"a","props":{"href":"/en/book/11","title":"Common legal pitfalls for programmers and tech professionals"},"children":["Section 11"]},"."]},"\n",{"tag":"h2","props":{"id":"1-first-work-out-which-kind-of-business-you-are-running"},"children":["1. First, work out which kind of business you are running"]},"\n",{"tag":"p","props":{},"children":["A single site often falls into several of these categories at once. The licenses stack; it is not either/or."]},"\n",{"tag":"div","props":{"className":"article-table-scroll","tabIndex":"0"},"children":[{"tag":"table","props":{},"children":[{"tag":"thead","props":{},"children":["\n",{"tag":"tr","props":{},"children":["\n",{"tag":"th","props":{},"children":["What you are doing"]},"\n",{"tag":"th","props":{},"children":["Corresponding business category"]},"\n",{"tag":"th","props":{},"children":["What you need"]},"\n",{"tag":"th","props":{},"children":["Primary legal basis"]},"\n"]},"\n"]},"\n",{"tag":"tbody","props":{},"children":["\n",{"tag":"tr","props":{},"children":["\n",{"tag":"td","props":{},"children":["Free information sites, personal blogs, company official websites"]},"\n",{"tag":"td","props":{},"children":["非经营性互联网信息服务 — non-commercial internet information services"]},"\n",{"tag":"td","props":{},"children":["ICP 备案 — ICP filing with MIIT"]},"\n",{"tag":"td","props":{},"children":["互联网信息服务管理办法 — Internet Information Services Administrative Measures, Article 4"]},"\n"]},"\n",{"tag":"tr","props":{},"children":["\n",{"tag":"td","props":{},"children":["Paid memberships, value-added services, or paid content charged to users"]},"\n",{"tag":"td","props":{},"children":["经营性互联网信息服务 — commercial internet information services"]},"\n",{"tag":"td","props":{},"children":["增值电信业务经营许可 — value-added telecom business license (information services business)"]},"\n",{"tag":"td","props":{},"children":["Same measures, Articles 3, 4, and 7"]},"\n"]},"\n",{"tag":"tr","props":{},"children":["\n",{"tag":"td","props":{},"children":["Selling your own goods or services on your own website or app without third-party sellers; or using only a mini-program, official account, or online store"]},"\n",{"tag":"td","props":{},"children":["According to the Guangdong Communications Administration, these cases are not value-added telecom businesses under MIIT requirements"]},"\n",{"tag":"td","props":{},"children":["No value-added telecom license is needed. If other sellers can open shops on your platform, assess the licenses in the surrounding rows"]},"\n",{"tag":"td","props":{},"children":["Guangdong Communications Administration, 2025 FAQ, item 1"]},"\n"]},"\n",{"tag":"tr","props":{},"children":["\n",{"tag":"td","props":{},"children":["Matching buyers and sellers, handling transactions and orders"]},"\n",{"tag":"td","props":{},"children":["在线数据处理与交易处理业务 — online data processing and transaction processing business"]},"\n",{"tag":"td","props":{},"children":["增值电信业务经营许可 — value-added telecom business license (B21)"]},"\n",{"tag":"td","props":{},"children":["电信业务分类目录 — Telecommunications Business Classification Catalogue (2015 edition), B21"]},"\n"]},"\n",{"tag":"tr","props":{},"children":["\n",{"tag":"td","props":{},"children":["Livestreams with hosts on camera, game livestreams"]},"\n",{"tag":"td","props":{},"children":["网络表演 — online performance"]},"\n",{"tag":"td","props":{},"children":["网络文化经营许可证 — Network Culture Business License, with online performance included in the business scope"]},"\n",{"tag":"td","props":{},"children":["网络表演经营活动管理办法 — Measures for the Administration of Online Performance Business Activities, Article 4"]},"\n"]},"\n",{"tag":"tr","props":{},"children":["\n",{"tag":"td","props":{},"children":["Producing or aggregating video programs, or providing a service that lets others upload audio-visual programs"]},"\n",{"tag":"td","props":{},"children":["互联网视听节目服务 — internet audio-visual program services"]},"\n",{"tag":"td","props":{},"children":["信息网络传播视听节目许可证 — License for the Dissemination of Audio-Visual Programs through Information Networks"]},"\n",{"tag":"td","props":{},"children":["互联网视听节目服务管理规定 — Provisions on the Administration of Internet Audio-Visual Program Services, Articles 7 and 8"]},"\n"]},"\n",{"tag":"tr","props":{},"children":["\n",{"tag":"td","props":{},"children":["Selling goods during livestreams"]},"\n",{"tag":"td","props":{},"children":["网络直播营销 — livestream marketing"]},"\n",{"tag":"td","props":{},"children":["On top of the licenses above, fulfill the verification and retention obligations"]},"\n",{"tag":"td","props":{},"children":["网络直播营销管理办法（试行） — Measures for the Administration of Livestream Marketing (Trial), Article 8"]},"\n"]},"\n",{"tag":"tr","props":{},"children":["\n",{"tag":"td","props":{},"children":["Providing news and information"]},"\n",{"tag":"td","props":{},"children":["互联网新闻信息服务 — internet news information services"]},"\n",{"tag":"td","props":{},"children":["互联网新闻信息服务许可证 — Internet News Information Service License"]},"\n",{"tag":"td","props":{},"children":["互联网直播服务管理规定 — Provisions on the Administration of Internet Live-Streaming Services, Article 5"]},"\n"]},"\n",{"tag":"tr","props":{},"children":["\n",{"tag":"td","props":{},"children":["Building your own data center to sell hosting or bandwidth"]},"\n",{"tag":"td","props":{},"children":["互联网数据中心业务 — internet data center (IDC) business; 互联网接入服务业务 — internet access service (ISP) business"]},"\n",{"tag":"td","props":{},"children":["增值电信业务经营许可 — value-added telecom business license (B11, B14)"]},"\n",{"tag":"td","props":{},"children":["电信业务分类目录 — Telecommunications Business Classification Catalogue (2015 edition), B11, B14"]},"\n"]},"\n"]},"\n"]}]},{"tag":"p","props":{},"children":["The mapping of the three licenses is stated most plainly in the 2021 guidance opinion (指导意见) issued by seven departments: \"A livestream platform carrying out commercial online performance activities must hold the 《网络文化经营许可证》 — Network Culture Business License and complete ICP 备案 — ICP filing with MIIT; a livestream platform carrying out internet audio-visual program services must hold the 《信息网络传播视听节目许可证》 — License for the Dissemination of Audio-Visual Programs through Information Networks (or complete registration in the 全国网络视听平台信息登记管理系统 — National Network Audio-Visual Platform Information Registration Management System) and complete ICP 备案 — ICP filing with MIIT; a livestream platform carrying out internet news information services must hold the 《互联网新闻信息服务许可证》 — Internet News Information Service License.\""]},"\n",{"tag":"h3","props":{"id":"three-points-that-are-easy-to-get-wrong"},"children":["Three points that are easy to get wrong"]},"\n",{"tag":"p","props":{},"children":[{"tag":"strong","props":{},"children":["An individual cannot obtain a value-added telecom license."]}," The first eligibility condition is \"the operator is a company established in accordance with the law\"; registered capital must be no less than 1,000,000 yuan for operations within a single province and no less than 10,000,000 yuan for cross-province operations, the review period is 60 days, and the license is valid for 5 years. To run a paid business you need a company first; that step is in ",{"tag":"a","props":{"href":"/en/book/12","title":"Starting a business: how to protect your personal assets"},"children":["Section 12"]},"."]},"\n",{"tag":"p","props":{},"children":[{"tag":"strong","props":{},"children":["Private operators can essentially never get the audio-visual program license."]}," The application conditions state \"possesses legal-person status and is a wholly state-owned or state-controlled entity\". So the long-video and original-program route is closed to individual founders; livestreaming instead runs through the 网络文化经营许可证 — Network Culture Business License track."]},"\n",{"tag":"p","props":{},"children":[{"tag":"strong","props":{},"children":["No official document explicitly states that \"e-commerce platforms must obtain EDI\"."]}," MIIT's service guide only says \"apply for the corresponding telecommunications business license according to the business definition\", and has answered elsewhere that \"ride-hailing platforms only need a website filing\" and \"equity-type and bulk-commodity trading platforms only need a website filing\". So this book only quotes the original definition of B21 and leaves the judgment to you and your local 通信管理局 — communications administration; ask the communications administration with jurisdiction over your location once before applying."]},"\n",{"tag":"h2","props":{"id":"2-the-platforms-own-day-to-day-obligations"},"children":["2. The platform's own day-to-day obligations"]},"\n",{"tag":"p","props":{},"children":["Getting the license only opens the door. The items below are what you do every day; the fines are in the individual entries of ",{"tag":"a","props":{"href":"/en/book/26","title":"Building a website or platform: licensing, registration, and servers"},"children":["Section 26"]},"."]},"\n",{"tag":"div","props":{"className":"article-table-scroll","tabIndex":"0"},"children":[{"tag":"table","props":{},"children":[{"tag":"thead","props":{},"children":["\n",{"tag":"tr","props":{},"children":["\n",{"tag":"th","props":{},"children":["Obligation"]},"\n",{"tag":"th","props":{},"children":["Hard requirement"]},"\n",{"tag":"th","props":{},"children":["Source"]},"\n"]},"\n"]},"\n",{"tag":"tbody","props":{},"children":["\n",{"tag":"tr","props":{},"children":["\n",{"tag":"td","props":{},"children":["Verify and register on-platform merchants"]},"\n",{"tag":"td","props":{},"children":["Verify and update at least once every six months"]},"\n",{"tag":"td","props":{},"children":["网络交易监督管理办法 — Measures for the Supervision and Administration of Online Transactions, Article 24"]},"\n"]},"\n",{"tag":"tr","props":{},"children":["\n",{"tag":"td","props":{},"children":["Report identity information"]},"\n",{"tag":"td","props":{},"children":["Report to the market regulation authorities in January and July each year"]},"\n",{"tag":"td","props":{},"children":["Same measures, Article 25"]},"\n"]},"\n",{"tag":"tr","props":{},"children":["\n",{"tag":"td","props":{},"children":["Report tax-related information"]},"\n",{"tag":"td","props":{},"children":["Report to the tax authorities within the month after each quarter ends"]},"\n",{"tag":"td","props":{},"children":["互联网平台企业涉税信息报送规定 — Provisions on the Reporting of Tax-Related Information by Internet Platform Enterprises, Article 4"]},"\n"]},"\n",{"tag":"tr","props":{},"children":["\n",{"tag":"td","props":{},"children":["Retain transaction information"]},"\n",{"tag":"td","props":{},"children":["No less than three years from the date the transaction is completed"]},"\n",{"tag":"td","props":{},"children":["电子商务法 — E-Commerce Law, Article 31"]},"\n"]},"\n",{"tag":"tr","props":{},"children":["\n",{"tag":"td","props":{},"children":["Retain livestream content and logs"]},"\n",{"tag":"td","props":{},"children":["Sixty days"]},"\n",{"tag":"td","props":{},"children":["互联网直播服务管理规定 — Provisions on the Administration of Internet Live-Streaming Services, Article 16"]},"\n"]},"\n",{"tag":"tr","props":{},"children":["\n",{"tag":"td","props":{},"children":["Retain online performance videos"]},"\n",{"tag":"td","props":{},"children":["No less than sixty days"]},"\n",{"tag":"td","props":{},"children":["网络表演经营活动管理办法 — Measures for the Administration of Online Performance Business Activities, Article 13"]},"\n"]},"\n",{"tag":"tr","props":{},"children":["\n",{"tag":"td","props":{},"children":["Retain network logs"]},"\n",{"tag":"td","props":{},"children":["No less than six months"]},"\n",{"tag":"td","props":{},"children":["网络安全法 — Cybersecurity Law, Article 23, Item 3"]},"\n"]},"\n",{"tag":"tr","props":{},"children":["\n",{"tag":"td","props":{},"children":["Handle infringement notices"]},"\n",{"tag":"td","props":{},"children":["If nothing happens within fifteen days after the statement is forwarded, restore the listing"]},"\n",{"tag":"td","props":{},"children":["电子商务法 — E-Commerce Law, Article 43"]},"\n"]},"\n",{"tag":"tr","props":{},"children":["\n",{"tag":"td","props":{},"children":["Complaint and report channel"]},"\n",{"tag":"td","props":{},"children":["Conspicuous placement, convenient to use"]},"\n",{"tag":"td","props":{},"children":["网络信息内容生态治理规定 — Provisions on the Governance of the Online Information Content Ecosystem, Article 16"]},"\n"]},"\n"]},"\n"]}]},{"tag":"p","props":{},"children":["The retention periods are four different clocks: three years for transactions, sixty days for livestreams, six months for logs, and three years for the identity information of on-platform merchants, counted from when they leave the platform. Design your storage for the longest of these, not the shortest."]},"\n",{"tag":"h2","props":{"id":"3-choosing-a-server-how-to-pick-among-the-three-tiers"},"children":["3. Choosing a server: how to pick among the three tiers"]},"\n",{"tag":"p","props":{},"children":["Answer the questions first, then look at prices."]},"\n",{"tag":"div","props":{"className":"article-table-scroll","tabIndex":"0"},"children":[{"tag":"table","props":{},"children":[{"tag":"thead","props":{},"children":["\n",{"tag":"tr","props":{},"children":["\n",{"tag":"th","props":{},"children":["Question"]},"\n",{"tag":"th","props":{},"children":["If the answer is"]},"\n",{"tag":"th","props":{},"children":["Then"]},"\n"]},"\n"]},"\n",{"tag":"tbody","props":{},"children":["\n",{"tag":"tr","props":{},"children":["\n",{"tag":"td","props":{},"children":["Can you tolerate a day of downtime"]},"\n",{"tag":"td","props":{},"children":["Yes"]},"\n",{"tag":"td","props":{},"children":["The cheapest VPS is enough"]},"\n"]},"\n",{"tag":"tr","props":{},"children":["\n",{"tag":"td","props":{},"children":["Do you have user registration, transactions, or uploads"]},"\n",{"tag":"td","props":{},"children":["Yes"]},"\n",{"tag":"td","props":{},"children":["A cloud host from a mainstream cloud provider, with snapshots and elastic scaling"]},"\n"]},"\n",{"tag":"tr","props":{},"children":["\n",{"tag":"td","props":{},"children":["Do you have someone dedicated to operations"]},"\n",{"tag":"td","props":{},"children":["No"]},"\n",{"tag":"td","props":{},"children":["Stay away from dedicated server colocation"]},"\n"]},"\n",{"tag":"tr","props":{},"children":["\n",{"tag":"td","props":{},"children":["Are bandwidth or hardware costs your main expense"]},"\n",{"tag":"td","props":{},"children":["Yes, and you have someone for operations"]},"\n",{"tag":"td","props":{},"children":["Only then consider dedicated server colocation"]},"\n"]},"\n"]},"\n"]}]},{"tag":"p","props":{},"children":[{"tag":"strong","props":{},"children":["Small providers are not unusable; you have to verify them first."]}," Data-center colocation and access services are themselves value-added telecom businesses that require a license. Check the provider once by its full company name on MIIT's 电信业务市场综合管理信息系统 — Telecom Business Market Comprehensive Management Information System at ",{"tag":"a","props":{"href":"http://tsm.miit.gov.cn/","target":"_blank","rel":"noopener noreferrer"},"children":["tsm.miit.gov.cn"]},", and exclude anyone without a license outright. The ones that can be half the price usually carry risks in overselling, the operator disappearing, and their upstream being blocked. When any of these three happens, with a licensed provider you can still complain to the communications administration; with an unlicensed one you have no one to appeal to at all."]},"\n",{"tag":"p","props":{},"children":[{"tag":"strong","props":{},"children":["Inside China or outside."]}," If the servers are inside China you must complete a filing (备案), and access providers may not provide access to unfiled sites. Hosting abroad lets you bypass the filing, but your users are in China and your money is in China, so not one of the obligations in items 5 through 10 of ",{"tag":"a","props":{"href":"/en/book/26","title":"Building a website or platform: licensing, registration, and servers"},"children":["Section 26"]}," goes away, and you add a layer of cross-border data transfer compliance cost: transmitting the personal information of users inside China to a machine outside China is a cross-border transfer, which must satisfy one of the four conditions in Article 38 of the 个人信息保护法 — Personal Information Protection Law and obtain the individual's separate consent. The headcount thresholds are counted \"cumulatively from January 1 of the current year\": under 100,000 people, none of the three pathways applies; 100,000 to 1,000,000 people, a standard contract or certification is required; over 1,000,000 people, a security assessment must be filed."]},"\n",{"tag":"p","props":{},"children":[{"tag":"strong","props":{},"children":["Backups."]}," Keep backups in at least two places, and do not put them all in the same region of the same provider. This one has no legal basis behind it; it is experience."]},"\n",{"tag":"h2","props":{"id":"4-the-limits-of-this-document"},"children":["4. The limits of this document"]},"\n",{"tag":"ul","props":{},"children":["\n",{"tag":"li","props":{},"children":["For all provisions, the source column in ",{"tag":"a","props":{"href":"/en/book/26","title":"Building a website or platform: licensing, registration, and servers"},"children":["Section 26"]}," of the book's README is authoritative; it has the document numbers, article numbers, and links."]},"\n",{"tag":"li","props":{},"children":["Regulations are updated quickly; this section was verified in September 2026. Before quoting anything, open the original page yourself once more — especially the 网络安全法 — Cybersecurity Law (article numbers were adjusted starting January 1, 2026) and the rules on minors and livestream tipping (changed in April 2026 to age-based tiers)."]},"\n",{"tag":"li","props":{},"children":["The few points where the original text could not be obtained are listed in the ",{"tag":"a","props":{"href":"https://github.com/eternity4719/HowToLiveBetter/blob/33362aff50f97f413b22ddfcdb355d2a536a5700/%E6%A0%B8%E5%AE%9E%E8%AE%B0%E5%BD%95/%E8%BF%BD%E5%8A%A0-%E7%AC%AC26%E8%8A%82%E5%81%9A%E5%B9%B3%E5%8F%B0.md","target":"_blank","rel":"noopener noreferrer"},"children":["verification notes"]},", including any official wording on whether e-commerce platforms must obtain EDI, and a judicial interpretation that would directly make unlicensed operation of online-culture or audio-visual services the crime of illegal business operations (非法经营罪)."]},"\n"]},"\n"]},{"tag":"footer","props":{"className":"life-article-attribution"},"children":[{"tag":"p","props":{},"children":["This page includes a machine-assisted translation made by this site from the Chinese original; it has not been professionally reviewed. Verify the original and its sources, especially for medical, legal and financial details."]},{"tag":"a","props":{"href":"https://github.com/eternity4719/HowToLiveBetter/blob/33362aff50f97f413b22ddfcdb355d2a536a5700/docs/%E5%81%9A%E5%B9%B3%E5%8F%B0%E8%A6%81%E5%8A%9E%E5%93%AA%E4%BA%9B%E8%AF%81.md","target":"_blank","rel":"noopener noreferrer"},"children":["View source revision · 33362af",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"14","height":"14","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]},{"tag":"span","props":{},"children":["Imported: 2026-10-1