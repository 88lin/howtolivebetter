6","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Затраты"]},{"tag":"p","props":{},"children":["Ничего не стоит. Однако обучение отнимает много времени. Чтобы получить субсидии, нужно пройти весь курс и сдать экзамен на получение сертификата."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Польза"]},{"tag":"p","props":{},"children":["В нормативных актах Министерства финансов и управления по труду и соцстраху перечислен ряд программ, финансируемых за счёт специальных средств для поддержки занятости. За прохождение курсов и получение соответствующего сертификата полагается субсидия на профессиональное обучение; один и тот же человек может получить её максимум три раза. Лица, испытывающие трудности с трудоустройством и уплачивающие взносы в соцстрах самостоятельно (то есть работающие в качестве самозанятых), могут рассчитывать на субсидию в течение трёх лет; для тех, кому до пенсии осталось менее пяти лет, срок продлевается до выхода на пенсию. Выпускники вузов, уплачивающие взносы в соцстрах самостоятельно, получают субсидию в течение двух лет, а те, кого трудоустроили предприятия, — в течение года. Выпускники вузов, не нашедшие работу в течение двух лет после окончания учёбы, а также безработные молодые люди в возрасте от 16 до 24 лет могут пройти стажировку, получая при этом базовое денежное содержание."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Первоисточники"]},{"tag":"p","props":{"className":"life-citations"},"children":["财政部、人力资源社会保障部 (2023). 就业补助资金管理办法（第五条、第七条、第十条）. ",{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/202401/content_6926462.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/zhengce/zhengceku/202401/content_6926462.htm"]}]},{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/202401/content_6926462.htm","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Открыть источник"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Примечание автора"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["Конкретный перечень программ и размер субсидий определяются в каждом регионе; сначала изучите на официальном сайте местного управления по труду и соцстраху перечень программ, на которые полагаются субсидии. Для выпускников вузов из семей, получающих дибао, из семей безработных, а также для тех, кто имеет долги по образовательным кредитам или является инвалидом, предусмотрены единовременные субсидии на поиск работы и начало трудовой деятельности."]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Моя заметка"]},{"tag":"button","props":{"type":"button"},"children":["Запишите напоминание…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props