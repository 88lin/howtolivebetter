]},{"tag":"span","props":{},"children":["登录同步"]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/book/30"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"返回目录"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["上学以后的孩子"]},{"tag":"nav","props":{"aria-label":"章节条目"},"children":[{"tag":"a","props":{"href":"/tip/30-01","className":""},"children":[{"tag":"span","props":{},"children":["01"]},"孩子说突然剧痛、而且越来越重，立刻去医院，不要让他忍到放学"]},{"tag":"a","props":{"href":"/tip/30-02","className":""},"children":[{"tag":"span","props":{},"children":["02"]},"该做的治疗别为了「等考完」往后拖，有些窗口跟着骨龄走，不跟着考试安排走"]},{"tag":"a","props":{"href":"/tip/30-03","className":""},"children":[{"tag":"span","props":{},"children":["03"]},"孩子被欺凌，当天就报到学校并要求书面处理，涉及打人、抢钱、传谣的直接报警"]},{"tag":"a","props":{"href":"/tip/30-04","className":""},"children":[{"tag":"span","props":{},"children":["04"]},"让孩子每天在户外待够 2 小时，这是目前不花钱、不用药的办法里，唯一有随机试验支持的防近视办法"]},{"tag":"a","props":{"href":"/tip/30-05","className":""},"children":[{"tag":"span","props":{},"children":["05"]},"0 到 3 岁不给屏幕，3 到 6 岁尽量不给，中小学生非学习用途每天不超过 1 小时"]},{"tag":"a","props":{"href":"/tip/30-06","className":""},"children":[{"tag":"span","props":{},"children":["06"]},"把近视当成会留下的损伤：度数越深，将来视网膜脱离、黄斑病变、青光眼越多"]},{"tag":"a","props":{"href":"/tip/30-07","className":""},"children":[{"tag":"span","props":{},"children":["07"]},"每年那次学生体检的报告单要自己看一遍，异常项当年带去医院查"]},{"tag":"a","props":{"href":"/tip/30-08","className":""},"children":[{"tag":"span","props":{},"children":["08"]},"12 到 18 岁的孩子做一次抑郁筛查，别拿学校的心理测评当诊断"]},{"tag":"a","props":{"href":"/tip/30-09","className":""},"children":[{"tag":"span","props":{},"children":["09"]},"不买号称能「治愈近视」「降低度数」的产品和服务"]},{"tag":"a","props":{"href":"/tip/30-10","className":""},"children":[{"tag":"span","props":{},"children":["10"]},"睡眠、作业、体育和排名都有明文规定，学校做不到可以提"]},{"tag":"a","props":{"href":"/tip/30-11","className":""},"children":[{"tag":"span","props":{},"children":["11"]},"孩子撑不住了可以休学，学籍学校必须给他留着，最长 1 年"]},{"tag":"a","props":{"href":"/tip/30-12","className":""},"children":[{"tag":"span","props":{},"children":["12"]},"查出视力不良，去医院做散瞳验光，之后按医生给的间隔复查"]},{"tag":"a","props":{"href":"/tip/30-13","className":""},"children":[{"tag":"span","props":{},"children":["13"]},"恒磨牙长出来以后做窝沟封闭"]},{"tag":"a","props":{"href":"/tip/30-14","className":""},"children":[{"tag":"span","props":{},"children":["14"]},"孩子爱打游戏，先看睡觉、作业和出门活动有没有被挤掉，别光盯着玩了多久"]},{"tag":"a","props":{"href":"/tip/30-15","className":""},"children":[{"tag":"span","props":{},"children":["15"]},"孩子说自己喜欢同性，别骂、别赶出家门、别送去「矫正」：家里的态度和他会不会自杀有关"]},{"tag":"a","props":{"href":"/tip/30-16","className":""},"children":[{"tag":"span","props":{},"children":["16"]},"管孩子别动手打，也别吼骂、骂他笨：常挨打挨骂的孩子，行为和情绪问题都更多"]},{"tag":"a","props":{"href":"/tip/30-17","className":""},"children":[{"tag":"span","props":{},"children":["17"]},"孩子难管、自己总忍不住打骂，去上一期教具体做法的家长课"]},{"tag":"a","props":{"href":"/tip/30-18","className":""},"children":[{"tag":"span","props":{},"children":["18"]},"别把孩子送进封闭管理的「戒网瘾学校」「特训营」：法律禁止用伤害身心的办法戒网瘾，已经有孩子被关死"]},{"tag":"a","props":{"href":"/tip/30-19","className":""},"children":[{"tag":"span","props":{},"children":["19"]},"教孩子认识身体的隐私部位，被人碰了、被要求保密都要回家说；孩子说了先信、别骂，带去报警和就医"]},{"tag":"a","props":{"href":"/tip/30-20","className":"active"},"children":[{"tag":"span","props":{},"children":["20"]},"别让不满 12 周岁的孩子骑自行车上路、不满 16 周岁的骑电动自行车上路：撞了人父母赔，自己被撞也可能要担一部分"]},{"tag":"a","props":{"href":"/tip/30-21","className":""},"children":[{"tag":"span","props":{},"children":["21"]},"