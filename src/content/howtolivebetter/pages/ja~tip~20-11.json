消失します。生後 24 時間未満での黄疸、あるいは黄疸が強まっている場合、普段よ…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/20-14"},"children":[{"tag":"strong","props":{},"children":["妊娠中や授乳中に菜食をしているなら、ビタミンB12を毎日補給する。子供の離乳食には動物性食品を入れ、完全菜食にするなら、まず医師に相談する"]},{"tag":"span","props":{},"children":["ビタミンB12は、ほぼ肉、卵、乳製品にしか含まれていません。母親が完全菜食で補給もしていないと、母乳にも不足し、子供は生後4～8か月ごろに…"]}]}]}]},{"tag":"a","props":{"className":"life-text-link","href":"/ja/book/20"},"children":["テーマ全体を読む：生まれたばかりの赤ちゃんの育て方"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"15","height":"15","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]}]}]},{"tag":"nav","props":{"className":"life-tabbar","aria-label":"メインナビゲーション"},"children":[{"tag":"a","props":{"className":"","href":"/ja/book"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"21","height":"21","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-book-open","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M12 7v14"},"children":[]},{"tag":"path","props":{"d":"M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z"},"children":[]}]},{"tag":"span","props":{},"children":["本"]}]},{"tag":"a","props":{"className":"","href":"/ja/top-50"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"21","height":"21","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-star","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M11.525 2.295