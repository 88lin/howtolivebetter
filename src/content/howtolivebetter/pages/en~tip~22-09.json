y-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["09"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["Evidence"," ","A"]}]},{"tag":"h1","props":{"lang":"en"},"children":["Treat “regular social contact” as a health expense — don’t wait until you’re feeling down to reach out"]},{"tag":"p","props":{"lang":"en","className":"life-entry-summary"},"children":["This conclusion comes from a meta-analysis of 70 studies involving 3.4 million people, tracked for an average of 7 years. Those experiencing social isolation had a roughly 30% higher risk of dying during that period compared to non-isolated individuals. People reporting loneliness faced a 25% higher risk, while those living alone faced a 30% higher risk. These figures are similar in magnitude and are even more pronounced among people under 65. Keep in mind these are observational data; it’s also possible that people in poorer health are more likely to end up isolated."]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Cost"]},{"tag":"p","props":{},"children":["It requires some money and time to arrange meetups. The ha…"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Benefit"]},{"tag":"p","props":{},"children":["As noted, this is a meta-analysis of 70 studies with 3.4 million participants observed over 7 years. Social is…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"Mark: Treat “regular social contact” as a health expense — don’t wait until you’re feeling down to reach out"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round"