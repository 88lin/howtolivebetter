"lucide lucide-circle-user-round","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M18 20a6 6 0 0 0-12 0"},"children":[]},{"tag":"circle","props":{"cx":"12","cy":"10","r":"4"},"children":[]},{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},{"tag":"span","props":{},"children":["Iniciar sesión"]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/es/book/25"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"Volver al índice"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["Qué hay que gestionar cuando alguien fallece"]},{"tag":"nav","props":{"aria-label":"Consejos del capítulo"},"children":[{"tag":"a","props":{"href":"/es/tip/25-01"},"children":[{"tag":"span","props":{},"children":["01"]},"Si la persona fallece en casa o fuera, primero determina si es muerte natural o no natural: accidente, causa desconocida o cuerpo hallado tras vivir solo —avisar de inmediato a la policía, sin tocar el cuerpo ni la escena"]},{"tag":"a","props":{"href":"/es/tip/25-02"},"children":[{"tag":"span","props":{},"children":["02"]},"El certificado de defunción es la llave de todo lo que viene después: lo expide quien atendió al paciente; si la muerte natural ocurrió en casa, acude al centro de salud comunitario; se emite en el plazo de 1 día"]},{"tag":"a","props":{"href":"/es/tip/25-03"},"children":[{"tag":"span","props":{},"children":["03"]},"El traslado, la custodia y la cremación del cuerpo solo pueden hacerse en la funeraria; la morgue del hospital no presta servicios funerarios, y la custodia suele durar como máximo 3 días"]},{"tag":"a","props":{"href":"/es/tip/25-04"},"children":[{"tag":"span","props":{},"children":["04"]},"Si se discrepa sobre la causa de la muerte, solicita la autopsia dentro de las 48 horas y, a la vez, sella la historia clínica"]},{"tag":"a","props":{"href":"/es/tip/25-05"},"children":[{"tag":"span","props":{},"children":["05"]},"En China, dar de baja el registro de una persona fallecida tiene plazo legal: en ciudades, antes del entierro; en zonas rurales, dentro de un mes"]},{"tag":"a","props":{"href":"/es/tip/25-06"},"children":[{"tag":"span","props":{},"children":["06"]},"Los servicios funerarios se dividen en básicos y no básicos; los básicos tienen un listado oficial y sus tarifas se fijan conforme a la ley"]},{"tag":"a","props":{"href":"/es/tip/25-07"},"children":[{"tag":"span","props":{},"children":["07"]},"Si encuentras venta forzada en paquete, cobros por encima del precio anunciado o un solo servicio troceado en varios cobros, anótalo y denuncia"]},{"tag":"a","props":{"href":"/es/tip/25-08"},"children":[{"tag":"span","props":{},"children":["08"]},"Los intermediarios —agencias funerarias, compra de artículos por encargo, organización y conducción de ceremonias— deben registrarse ante los asuntos civiles de nivel de condado"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/es/tip/25-09","data-status":"active"},"children":[{"tag":"span","props":{},"children":["09"]},"Hay que retirar por separado el dinero que se encuentra en distintos lugares: el saldo del fondo de vivienda, las prestaciones del seguro social y las indemnizaciones por accidente laboral"]},{"tag":"a","props":{"href":"/es/tip/25-10"},"children":[{"tag":"span","props":{},"children":["10"]},"Las cuentas y los datos personales del fallecido: los parientes más cercanos pueden pedir consultarlos, copiarlos, corregirlos y borrarlos"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"Ruta de navegación"},"children":[{"tag":"a","props":{"href":"/es/book"},"children":["Libro"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/es/book/25"},"children":["Capítulo 25"," ·"," ","Qué hay que gestionar cuando alguien fallece"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"25-09"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["09"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["Evidencia"," ","A"]}]},{"tag":"h1","props":{"lang":"es"},"children":["Hay que retirar por separado el dinero que se encuentra en distintos lugares: el saldo del fondo de vivienda, las prestaciones del seguro social y las indemnizaciones por accidente laboral"]},{"tag":"p","props":{"lang":"es","className":"life-entry-summary"},"children":["Los herederos pueden retirar el saldo del fondo de previsión (Housing Provident Fund); este no se encuentra en la cuenta bancaria y es lo que más fácilmente se suele omitir. El dinero restante en la cuenta individual del seguro de pensiones también es heredable. En caso de fallecimiento por enfermedad, los familiares recibirán, además, una subvención por gastos funerarios y una indemnización de 3 a 24 meses. En caso de muerte por accidente laboral, existen otros tres pagos correspondientes a la compensación por accidente de trabajo."]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Coste"]},{"tag":"p","props":{},"children":["No cuesta dinero, pero hay que acudir a varias oficinas. A…"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Beneficio"]},{"tag":"p","props":{},"children":["El saldo de la cuenta de la Reserva para Vivienda (el dinero restante en la cuenta de fondo de vivienda) puede…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"Marcar: Hay que retirar por separado el dinero que se encuentra en distintos lugares: el saldo del fondo de vivienda, las prestaciones del seguro social y las indemnizaciones por accidente laboral"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"Hecho"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"Por hacer"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"Guardar"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Compartir consejo"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Ocultar detalles"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Coste"]},{"tag":"p","props":{},"children":["No cuesta dinero, pero hay que acudir a varias oficinas. Antes de ir, prepare el certificado de defunción y los documentos que acrediten la relación familiar."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Beneficio"]},{"tag":"p","props":{},"children":["El saldo de la cuenta de la Reserva para Vivienda (el dinero restante en la cuenta de fondo de vivienda) puede ser retirado por los herederos o legatarios. Un legatario es la persona designada en un testamento para recibir bienes. En caso de muerte por accidente laboral, existen otros tres pagos: subsidio funerario, pensión de supervivencia para dependientes y una indemnización única por muerte laboral. El dinero restante en la cuenta individual del seguro de pensiones es heredable, según lo estipulado en la Ley de Seguro Social. Para quienes participan en el seguro de pensiones para empleados, en caso de muerte por enfermedad o por causas no laborales, los familiares también pueden recibir un subsidio funerario y una pensión de supervivencia, conocidos conjuntamente como beneficios para los sobrevivientes. El estándar para los empleados de empresas es una fórmula unificada a nivel nacional. El subsidio funerario equivale a 2 veces el ingreso mensual per cápita disponible de los residentes urbanos de la provincia en el año anterior. La indemnización por fallecimiento se calcula tomando como base el ingreso de este mes, pagando entre 3 y 24 meses según los años de cotización: menos de 5 años y 3 meses, de 5 a 10 años y 6 meses, de 10 a 15 años y 9 meses, y para más de 15 años, se añaden 1 meses por cada 1 años adicionales, hasta un máximo de 24 meses. Para quienes ya están jubilados, se restarán 1 meses por cada 1 años de pensión percibida, con un mínimo de 9 meses."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Fuentes originales"]},{"tag":"p","props":{"className":"life-citations"},"children":["国务院 (2026). 住房公积金管理条例（国务院令第 844 号修改，2026 年 9 月 20 日起施行）第二十四条末款. ",{"tag":"a","props":{"href":"https://www.gov.cn/gongbao/2026/issue_12946/202608/content_7079363.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/gongbao/2026/issue_12946/202608/content_7079363.html"]},"：「职工死亡或者被宣告死亡的，职工的继承人、受遗赠人可以提取职工住房公积金账户内的存储余额；无继承人也无受遗赠人的，职工住房公积金账户内的存储余额纳入住房公积金的增值收益。」；工伤保险条例第三十九条的三笔待遇见第 19 节. ",{"tag":"a","props":{"href":"https://www.gov.cn/gongbao/content/2011/content_1778064.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/gongbao/content/2011/content_1778064.htm"]},"；全国人大常委会 (2018 修正). 社会保险法（第十四、十七条）：「个人死亡的，个人账户余额可以继承」「参加基本养老保险的个人，因病或者非因工死亡的，其遗属可以领取丧葬补助金和抚恤金」. ",{"tag":"a","props":{"href":"https://flk.npc.gov.cn/detail?id=ff8080816f135f46016f210989b9179a","target":"_blank","rel":"noopener noreferrer"},"children":["https://flk.npc.gov.cn/detail?id=ff8080816f135f46016f210989b9179a"]},"（国家法律法规数据库）；人力资源社会保障部、财政部 (2021). 企业职工基本养老保险遗属待遇暂行办法（人社部发〔2021〕18 号，2021 年 9 月 1 日起施行，第四、五条），原件未公开挂网，条文按广州市花都区人民政府行政复议决定书（花都府行复〔2022〕226 号）的逐字引用核对：「丧葬补助金的标准，按照参保人员死亡时本省……上一年度城镇居民月人均可支配收入的2倍计算」「缴费年限不满5年的，发放月数为3个月……缴费年限30年以上的，按照30年计算，发放月数最高为24个月」. ",{"tag":"a","props":{"href":"https://www.huadu.gov.cn/xxgk/xzfy/content/post_8672730.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.huadu.gov.cn/xxgk/xzfy/content/post_8672730.html"]},"；福建省人力资源和社会保障厅. 常见问题：「每领取1年基本养老金减少1个月，发放月数最低为9个月」「累计缴费年限不足5年的，其遗属待遇（含丧葬补助金和抚恤金）标准不得超过其个人缴费之和」. ",{"tag":"a","props":{"href":"http://rst.fujian.gov.cn/wz/cjwt/czzgly/202311/t20231113_6294929.htm","target":"_blank","rel":"noopener noreferrer"},"children":["http://rst.fujian.gov.cn/wz/cjwt/czzgly/202311/t20231113_6294929.htm"]}]},{"tag":"a","props":{"href":"https://www.gov.cn/gongbao/2026/issue_12946/202608/content_7079363.html","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Abrir fuente"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Nota del autor"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["Lo del fondo de previsión es lo que más se suele olvidar, ya que no está en la cuenta bancaria ni se incluye automáticamente en la distribución de la herencia. El dinero restante en la cuenta individual del seguro de pensiones y las prestaciones para los supervivientes se calculan y gestionan de forma separada; se debe acudir a la ventanilla de seguridad social de la zona de afiliación para tramitarlos conjuntamente. Los documentos requeridos varían según la región. Si las aportaciones son inferiores a 5 años, el total de las prestaciones para los supervivientes no superará la cantidad que el fallecido aportó. Esta fórmula proviene de las normativas del seguro de pensiones para empleados de empresas; para las prestaciones de los supervivientes en instituciones gubernamentales, unidades de servicios y el seguro de pensiones para residentes urbanos y rurales, consulte directamente en la ventanilla. Para los requisitos de forma sobre testamentos y sucesiones, consulte la sección 17."]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Mi nota"]},{"tag":"button","props":{"type":"button"},"children":["Escribe un recordatorio…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"