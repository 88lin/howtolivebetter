毎日歯間を掃除し、欠損した歯は早めに補う"]},{"tag":"a","props":{"href":"/ja/tip/02-11"},"children":[{"tag":"span","props":{},"children":["11"]},"毎日 7000–8000 歩歩く、または週に合計 150–300 分間の早歩きを行う"]},{"tag":"a","props":{"href":"/ja/tip/02-12"},"children":[{"tag":"span","props":{},"children":["12"]},"高血圧・高脂血症がある場合は医師の指示通りに服薬し、自己判断で中断しない"]},{"tag":"a","props":{"href":"/ja/tip/02-13"},"children":[{"tag":"span","props":{},"children":["13"]},"毎晩約7時間の睡眠、規則正しい生活リズム"]},{"tag":"a","props":{"href":"/ja/tip/02-14"},"children":[{"tag":"span","props":{},"children":["14"]},"テニス、バドミントン、卓球などのラケットスポーツを日常的に行う"]},{"tag":"a","props":{"href":"/ja/tip/02-15"},"children":[{"tag":"span","props":{},"children":["15"]},"階段的な強度の活動（階段を上る、早歩きなど）を、1日合計4〜5分間に集める"]},{"tag":"a","props":{"href":"/ja/tip/02-16"},"children":[{"tag":"span","props":{},"children":["16"]},"週に30–60分の筋力トレーニングを行う"]},{"tag":"a","props":{"href":"/ja/tip/02-17"},"children":[{"tag":"span","props":{},"children":["17"]},"長時間座りっぱなしを避け、定期的に立ち上がって動く"]},{"tag":"a","props":{"href":"/ja/tip/02-18"},"children":[{"tag":"span","props":{},"children":["18"]},"加工肉（ハム、ベーコン、ソーセージ、 luncheon meat）の摂取を控える"]},{"tag":"a","props":{"href":"/ja/tip/02-19"},"children":[{"tag":"span","props":{},"children":["19"]},"飲酒を控える、または断酒する"]},{"tag":"a","props":{"href":"/ja/tip/02-20"},"children":[{"tag":"span","props":{},"children":["20"]},"毎日飲酒しており、やめると手が震えたり動悸がしたりする人は、無理に断酒しないでください"]},{"tag":"a","props":{"href":"/ja/tip/02-21"},"children":[{"tag":"span","props":{},"children":["21"]},"飲酒量を減らしたいなら、まずは1週間にどれだけ飲んだかを数え、それから医師と数分間話しましょう"]},{"tag":"a","props":{"href":"/ja/tip/02-22"},"children":[{"tag":"span","props":{},"children":["22"]},"毎日ひとつかみのナッツを食べる"]},{"tag":"a","props":{"href":"/ja/tip/02-23"},"children":[{"tag":"span","props":{},"children":["23"]},"赤身肉の一部を魚や鶏肉に置き換える"]},{"tag":"a","props":{"href":"/ja/tip/02-24"},"children":[{"tag":"span","props":{},"children":["24"]},"精白米や白小麦粉の一部を全粒穀物に置き換える"]},{"tag":"a","props":{"href":"/ja/tip/02-25"},"children":[{"tag":"span","props":{},"children":["25"]},"週に3回以上、お茶を飲む"]},{"tag":"a","props":{"href":"/ja/tip/02-26"},"children":[{"tag":"span","props":{},"children":["26"]},"毎日3〜4杯のコーヒーを、砂糖やミルクなしで飲む"]},{"tag":"a","props":{"href":"/ja/tip/02-27"},"children":[{"tag":"span","props":{},"children":["27"]},"毎日、十分な量の 5 単位（約 400 g）の果物と野菜を食べる"]},{"tag":"a","props":{"href":"/ja/tip/02-28"},"children":[{"tag":"span","props":{},"children":["28"]},"超加工食品（ポテトチップス、インスタントラーメン、菓子類、ファストフード）の摂取を控える"]},{"tag":"a","props":{"href":"/ja/tip/02-29"},"children":[{"tag":"span","props":{},"children":["29"]},"料理や暖房に石炭や薪を使わず、電気やガスに切り替える"]},{"tag":"a","props":{"href":"/ja/tip/02-30"},"children":[{"tag":"span","props":{},"children":["30"]},"熱いものは少し冷ましてから飲む。熱すぎる茶、スープ、コーヒーは避ける"]},{"tag":"a","props":{"href":"/ja/tip/02-31"},"children":[{"tag":"span","props":{},"children":["31"]},"日中は外出して日光を浴びる。一日中光を避けない"]},{"tag":"a","props":{"href":"/ja/tip/02-32"},"children":[{"tag":"span","props":{},"children":["32"]},"BMIを20–25に保つ、過体重なら減量"]},{"tag":"a","props":{"href":"/ja/tip/02-33"},"children":[{"tag":"span","props":{},"children":["33"]},"週に4回以上の唐辛子の摂取"]},{"tag":"a","props":{"href":"/ja/tip/02-34"},"children":[{"tag":"span","props":{},"children":["34"]},"毎日1〜2サービングの乳製品またはヨーグルトを摂取"]},{"tag":"a","props":{"href":"/ja/tip/02-35"},"children":[{"tag":"span","props":{},"children":["35"]},"卵は禁止する必要はないが、毎日3〜4個も食べないこと"]},{"tag":"a","props":{"href":"/ja/tip/02-36"},"children":[{"tag":"span","props":{},"children":["36"]},"条件が許すなら入浴を、シャワーだけで済ませない"]},{"tag":"a","props":{"href":"/ja/tip/02-37"},"children":[{"tag":"span","props":{},"children":["37"]},"昼寝は30分以内に抑えること。1時間を超えないように。1〜2時間寝ないと持ちこたえられない場合は原因を調べること"]},{"tag":"a","props":{"href":"/ja/tip/02-38"},"children":[{"tag":"span","props":{},"children":["38"]},"徹夜明けの翌晩には睡眠を補うこと。週末まで溜め込まない"]},{"tag":"a","props":{"href":"/ja/tip/02-39"},"children":[{"tag":"span","props":{},"children":["39"]},"夜勤の期間が長いほど心血管リスクは高まる。配置転換ができるなら早めに検討を"]},{"tag":"a","props":{"href":"/ja/tip/02-40"},"children":[{"tag":"span","props":{},"children":["40"]},"包装済みでSC番号がある食用油を購入すること。小規模な手作り・バラ売りのピーナッツ油は避ける"]},{"tag":"a","props":{"href":"/ja/tip/02-41"},"children":[{"tag":"span","props":{},"children":["41"]},"料理にラードやバターの代わりに植物油を使用：健康のために油を使い分ける必要はなく、亜麻仁油に心臓保護を期待しても意味がない"]},{"tag":"a","props":{"href":"/ja/tip/02-42"},"children":[{"tag":"span","props":{},"children":["42"]},"炒め物や揚げ物の際は換気扇を回すこと。火をつけた瞬間から料理が終わるまで。"]},{"tag":"a","props":{"href":"/ja/tip/02-43"},"children":[{"tag":"span","props":{},"children":["43"]},"閉経前後のほてりや寝汗が生活に支障をきたすなら、婦人科でホルモン療法の評価を受ける。我慢せず、自己判断で薬を買わず、心臓病予防にも使わない"]},{"tag":"a","props":{"href":"/ja/tip/02-44"},"children":[{"tag":"span","props":{},"children":["44"]},"もともと犬を飼いたい人は毎日の散歩を歩行量に含める。長生きだけを目的に飼わない"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"現在地"},"children":[{"tag":"a","props":{"href":"/ja/book"},"children":["本を読む"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/ja/book/02"},"children":["第2章"," ·"," ","ゆっくり死なないために"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"02-04"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["04"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["エビデンス"," ","A"]}]},{"tag":"h1","props":{"lang":"ja"},"children":["禁煙日を決め、その日に一気にやめる。徐々に減らすのは避けること"]},{"tag":"p","props":{"lang":"ja","className":"life-entry-summary"},"children":["多くの人が、まずは1日の本数を少しずつ減らし、徐々にゼロにしようと考えます。しかし、6ヶ月後には、あらかじめ日を決めて一気にやめた人の22%が禁煙に成功していたのに対し、徐々に減らした人はわずか15.5%でした。したがって、特定の日を決め、その日に一気にやめるべきです。"]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["費用・手間"]},{"tag":"p","props":{},"children":["費用はかかりません。カレンダーから特定の日を選び、事前に家族や同僚に伝えておくだけです。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["効果"]},