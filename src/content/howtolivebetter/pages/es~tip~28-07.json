ewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-up-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M7 7h10v10"},"children":[]},{"tag":"path","props":{"d":"M7 17 17 7"},"children":[]}]}]}]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/es/book/28"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"Volver al índice"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["No arruines tu salud por la apariencia"]},{"tag":"div","props":{"data-ad-dock-host":"true"},"children":[]},{"tag":"nav","props":{"aria-label":"Consejos del capítulo"},"children":[{"tag":"a","props":{"href":"/es/tip/28-01"},"children":[{"tag":"span","props":{},"children":["01"]},"No recurran a dietas extremas, ayunos o vómitos forzados para controlar el peso; si quieren adelgazar, opten por el ejercicio"]},{"tag":"a","props":{"href":"/es/tip/28-02"},"children":[{"tag":"span","props":{},"children":["02"]},"Antes de inyecciones, hilos o cirugía, verifique dos cosas: si la licencia del establecimiento incluye «medicina estética» y si quien opera es médico tratante principal"]},{"tag":"a","props":{"href":"/es/tip/28-03"},"children":[{"tag":"span","props":{},"children":["03"]},"En el relleno facial, evite el dorso de la nariz, la glabela y la frente; y sobre todo, no busque inyecciones informales por ahorrar"]},{"tag":"a","props":{"href":"/es/tip/28-04"},"children":[{"tag":"span","props":{},"children":["04"]},"No compre medicamentos para adelgazar, cafés para adelgazar, caramelos quemagrasa ni ciruelas con enzimas (ciruelas que dicen estar maceradas en enzimas) que prometen «bajar rápido»"]},{"tag":"a","props":{"href":"/es/tip/28-05"},"children":[{"tag":"span","props":{},"children":["05"]},"No use esteroideos anabólicos («inyecciones para ganar músculo», «pastillas») para desarrollar la musculatura"]},{"tag":"a","props":{"href":"/es/tip/28-06"},"children":[{"tag":"span","props":{},"children":["06"]},"Si va a tomar medicación para adelgazar, consígala con receta en un hospital; no la compre en tiendas en línea que envían sin receta"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/es/tip/28-07","data-status":"active"},"children":[{"tag":"span","props":{},"children":["07"]},"Los fármacos hormonales sexuales úselos solo con receta médica y controles periódicos; no los compre por internet ni se suba la dosis por su cuenta"]},{"tag":"a","props":{"href":"/es/tip/28-08"},"children":[{"tag":"span","props":{},"children":["08"]},"Si «creerse feo» ya llega al punto de mirarse al espejo una y otra vez y dar vueltas a cambiar algo, hágase antes una evaluación de la imagen corporal antes de hablar de cirugía"]},{"tag":"a","props":{"href":"/es/tip/28-09"},"children":[{"tag":"span","props":{},"children":["09"]},"Para corregir los dientes, acude a un profesional habilitado en ortodoncia para una revisión presencial y controles periódicos; no compres alineadores por internet para usarlos solo en casa"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"Ruta de navegación"},"children":[{"tag":"a","props":{"href":"/es/book"},"children":["Libro"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/es/book/28"},"children":["Capítulo 28"," ·"," ","No arruines tu salud por la apariencia"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"28-07"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["07"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["Evidencia"," ","A"]}]},{"tag":"h1","props":{"lang":"es"},"children":["Los fármacos hormonales sexuales úselos solo con receta médica y controles periódicos; no los compre por internet ni se suba la dosis por su cuenta"]},{"tag":"p","props":{"lang":"es","className":"life-entry-summary"},"children":["Esta regla no discute si usarlos o no, sino cómo usarlos. En un estudio sobre personas transgénero con unos 4 años de seguimiento promedio, las mujeres transgénero (la gran mayoría bajo tratamiento con estrógenos) presentaron claramente más trombosis venosa que controles de su misma edad: 4,1 casos más por cada 1000 personas en 2 años, y 16,7 más en 8 años; entre quienes iniciaron el tratamiento durante el período de seguimiento, la diferencia en trombosis e ictus isquémico fue todavía más marcada; en el infarto de miocardio no se apreció diferencia en conjunto. La clave es que la trombosis se puede detectar y tratar a tiempo, siempre que alguien se la revise periódicamente —y en el camino de comprar por internet y ajustar la dosis por cuenta propia, precisamente no hay esa persona."]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Coste"]},{"tag":"p","props":{},"children":["Consultas y extracciones de sangre periódicas, unos ciento…"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Beneficio"]},{"tag":"p","props":{},"children":["Cohorte de historiales electrónicos de Kaiser Permanente (2 842 mujeres transgénero y 2 118 hombres transgéner…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"Marcar: Los fármacos hormonales sexuales úselos solo con receta médica y controles periódicos; no los compre por internet ni se suba la dosis por su cuenta"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"Hecho"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"Por hacer"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"Guardar"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Compartir consejo"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Ocultar detalles"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Coste"]},{"tag":"p","props":{},"children":["Consultas y extracciones de sangre periódicas, unos cientos de yuanes y varias media jornadas al año"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Beneficio"]},{"tag":"p","props":{},"children":["Cohorte de historiales electrónicos de Kaiser Permanente (2 842 mujeres transgénero y 2 118 hombres transgénero, seguimiento medio de 4,0 y 3,6 años, cada uno con alrededor de 10 veces más controles cisgénero apareados por año de nacimiento, etnia, centro y fecha de inclusión: 48 686 varones cisgénero y 48 775 mujeres cisgénero): la diferencia de riesgo de tromboembolismo venoso a 2 y 8 años en mujeres transgénero fue de 4,1 por 1000 (IC del 95%: 1,6–6,7) y 16,7 (6,4–27,5) respecto a los varones cisgénero, y de 3,4 (1,1–5,6) y 13,7 (4,1–22,7) respecto a las mujeres cisgénero; el ictus isquémico y el infarto de miocardio se mantuvieron en conjunto próximos en todos los grupos, aunque entre las mujeres transgénero que iniciaron la hormonoterapia durante el seguimiento las diferencias en trombosis venosa e ictus isquémico fueron más marcadas; la evidencia en hombres transgénero no permite sacar conclusiones. Conclusión de los autores: «estos resultados pueden indicar que se requiere vigilancia a largo plazo de los efectos vasculares de los estrógenos en la hormonoterapia transgénero»"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Fuentes originales"]},{"tag":"p","props":{"className":"life-citations"},"children":["Getahun D et al. (2018). Cross-sex Hormones and Acute Cardiovascular Events in Transgender Persons: A Cohort Study. Ann Intern Med. ",{"tag":"a","props":{"href":"https://doi.org/10.7326/M17-2785","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.7326/M17-2785"]},"；国家市场监督管理总局 (2022). 药品网络销售监督管理办法（总局令第 58 号，第九条）. ",{"tag":"a","props":{"href":"https://www.gov.cn/gongbao/content/2022/content_5717002.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/gongbao/content/2022/content_5717002.htm"]}]},{"tag":"a","props":{"href":"https://doi.org/10.7326/M17-2785","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Abrir fuente"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Nota del autor"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["El propio estudio señala sus límites: no se sabe cuánta gente conseguía los fármacos fuera del sistema, de modo que la división «tratado o no tratado» ya estaba sucia de partida —y esto precisamente explica por qué conviene integrar el tratamiento en un seguimiento regular. Lo que mide son eventos vasculares; no evalúa las indicaciones ni los beneficios de la hormonoterapia en sí, eso es otro cuerpo de evidencia. El mismo razonamiento vale para todos los usos de hormonas sexuales: anticonceptivos, hormonoterapia de la menopausia, testosterona; en todos los casos de compra por internet, ajuste de dosis siguiendo foros y ausencia de controles de trombosis y de función hepática y renal, el riesgo está en el tramo de «nadie hace seguimiento», no en el motivo por el que se usa. La vía correcta en China es acudir a la endocrinología o a la especialidad correspondiente de una institución médica regular para evaluación, receta y seguimiento. 〔17〕"]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Mi nota"]},{"tag":"button","props":{"type":"button"},"children":["Escribe un 