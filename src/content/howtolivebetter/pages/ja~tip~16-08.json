ag":"span","props":{},"children":["09"]},"痛風と診断されたら、尿酸値を 360 µmol/L 以下に抑え、それを維持するために長期的な降尿酸薬の服用が必要です"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"現在地"},"children":[{"tag":"a","props":{"href":"/ja/book"},"children":["本を読む"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/ja/book/16"},"children":["第16章"," ·"," ","慢性疾患と共にどう生きるか"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"16-08"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["08"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["エビデンス"," ","A"]}]},{"tag":"h1","props":{"lang":"ja"},"children":["腎結石を経験したなら、水分摂取を毎日 2.5–3 リットルに増やし、塩分は 6 グラム以内に抑える"]},{"tag":"p","props":{"lang":"ja","className":"life-entry-summary"},"children":["初めてカルシウム結石ができた人は、何も対策をしなければ、5年間のうちに約4分の1が再発します。毎日十分な水分を摂っている人の場合、5年間の再発率はわずか1割強にとどまり、半分以下に減少します。英国のガイドラインが推奨する量は、1日あたり 2.5 から 3 リットルの水分摂取、塩分は 6 グラム以内です。"]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["費用・手間"]},{"tag":"p","props":{},"children":["費用はかかりません。こまめに水を飲む習慣をつけるだけです。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["効果"]},{"tag":"p","props":{},"children":["5 年間にわたる、原因不明の初回カルシウム結石（特発性カルシウム結石とも呼ばれる）を発症した 199 名の患者を対象とした、2群にランダムに割り付けられた対照試験。"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"記録する：腎結石を経験したなら、水分摂取を毎日 2.5–3 リットルに増やし、塩分は 6 グラム以内に抑える"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"できている"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"やることに追加"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"お気に入り"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"このヒントを共有"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"詳細を閉じる"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["費用・手間"]},{"tag":"p","props":{},"children":["費用はかかりません。こまめに水を飲む習慣をつけるだけです。汗を多くかく日はさらに多めに飲む必要がありますが、難しいのは毎日継続して意識することです。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["効果"]},{"tag":"p","props":{},"children":["5 年間にわたる、原因不明の初回カルシウム結石（特発性カルシウム結石とも呼ばれる）を発症した 199 名の患者を対象とした、2群にランダムに割り付けられた対照試験。一方の群は1日少なくとも 2 リットルの水を摂取し、もう一方の群には何の介入も行わなかった。5 年間の再発率は、多飲群が 12/99（12.1%）、非介入群が 27/100（27.0%）であり、P=0.008。P値が小さいほど、2群間の差が偶然ではないことを示している。平均再発間隔：38.7±13.2 ヶ月 vs 25.1±16.4 ヶ月、P=0.016。最初に測定された 24 時間の尿量は、結石のある患者は結石のない人に比べて明らかに低かったです。男性は 1,057±238 mL 対 1,401±562 mL（P<0.0001）、女性は 990±230 mL 対 1,239±440 mL（P<0.001）でした。NICEガイドライン NG118 の第 1.8.1 条では、成人は1日あたり 2.5 から 3 リットルの水を、小児および青少年は年齢に応じて 1 から 2 リットルの水を飲むことを推奨しています。水に新鮮なレモン汁を加え、炭酸飲料は避け、成人の1日の塩分摂取量は 6 グラムを超えないようにしてください。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["出典"]},{"tag":"p","props":{"className":"life-citations"},"children":["Borghi L, Meschi T, Amato F, Briganti A, Novarini A, Giannini A (1996). Urinary volume, water and recurrences in idiopathic calcium nephrolithiasis: a 5-year randomized prospective study. The Journal of Urology, 155(3), 839-843. ",{"tag":"a","props":{"href":"https://doi.org/10.1016/s0022-5347(01)66321-3","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1016/s0022-5347(01)66321-3"]},"；National Institute for Health and Care Excellence (2019). Renal and ureteric stones: assessment and management. NICE guideline NG118，第 1.8.1 条. ",{"tag":"a","props":{"href":"https://www.nice.org.uk/guidance/ng118/chapter/Recommendations","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.nice.org.uk/guidance/ng118/chapter/Recommendations"]}]},{"tag":"a","props":{"href":"https://doi.org/10.1016/s0022-5347(01)66321-3","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["出典を開く"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["著者の注記"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["再発率が約 55% 低減し、かつ費用もかからないため、本書の重要度順に基づけば、この節で最もコストパフォーマンスの高い対策です。注目すべきは 24 時間の尿量であり、目標は 2 から 2.5 リットル以上を目指すことで、摂取量そのものを見ることではありません。汗を多くかく人や高温環境で働く人は、より多くの水分摂取が必要です。この試験は、初発の特発性カルシウム結石患者を対象に行われました。結石の成分は一つではなく、尿酸結石、感染性結石、シスチン結石にはそれぞれ異なる対策があります。再発経験がある人は、結石成分分析と 24 時間の尿検査を行い、投薬が必要かどうかを判断する価値があります。結石予防のためにカルシウムを断たないでください（第 6 節 第 21 条を参照）。発作時に激しい腰腹部の疝痛がある場合は、水を飲んで流し込もうとするのではなく、病院へ行く必要があります。痛みのない血尿については、他に調べるべき事項があります（第 1 節 第 27 条を参照）。"]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["自分のメモ"]},{"tag":"button","props":{"type":"button"},"children":["自分へのメモを書く…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/ja/tip/16-07"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["前へ"]},"糖尿病と診断されたら一度眼底検査を受け、その後は医師の指示に従って定期的に検査してください。足の検査は年に一度行います。"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/ja/tip/16-09"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["次へ"]},"痛風と診断されたら、尿酸値を 360 µmol/L 以下に抑え、それを維持するために長期的な降尿酸薬の服用が必要です"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"classNa