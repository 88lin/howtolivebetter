:"/ja/book/28"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"目次に戻る"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["見た目のために体を壊さないで"]},{"tag":"div","props":{"data-ad-dock-host":"true"},"children":[]},{"tag":"nav","props":{"aria-label":"この章のヒント"},"children":[{"tag":"a","props":{"href":"/ja/tip/28-01"},"children":[{"tag":"span","props":{},"children":["01"]},"極端な食事制限、断食、または催吐による体重管理は避けてください。減量したいなら、運動の側面からアプローチしましょう"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/ja/tip/28-02","data-status":"active"},"children":[{"tag":"span","props":{},"children":["02"]},"注射、糸リフト、手術の前に確認すべき2つのこと：施設の許可証に「医療美容」の記載があるか、施術者が主治医であるか"]},{"tag":"a","props":{"href":"/ja/tip/28-03"},"children":[{"tag":"span","props":{},"children":["03"]},"顔のフィラー注入は鼻背、眉間、額の部位を避け、節約のために非正規の注入を行わないこと"]},{"tag":"a","props":{"href":"/ja/tip/28-04"},"children":[{"tag":"span","props":{},"children":["04"]},"「急速に痩せる」と約束する減量薬、痩身コーヒー、キャンディー、酵素梅（酵素に漬けたと称する梅）を買わない"]},{"tag":"a","props":{"href":"/ja/tip/28-05"},"children":[{"tag":"span","props":{},"children":["05"]},"筋肉を増やすためにアナボリックステロイド（「筋肥大注射」「経口薬」）を使用しないでください"]},{"tag":"a","props":{"href":"/ja/tip/28-06"},"children":[{"tag":"span","props":{},"children":["06"]},"ダイエット薬を服用する場合は病院で処方箋を受け取ってください。処方箋なしで発送するネットショップで購入しないでください"]},{"tag":"a","props":{"href":"/ja/tip/28-07"},"children":[{"tag":"span","props":{},"children":["07"]},"性ホルモン剤は医師の処方と定期的な再検査を前提に使用すること。ネット通販での購入や自己判断による増量は避けること"]},{"tag":"a","props":{"href":"/ja/tip/28-08"},"children":[{"tag":"span","props":{},"children":["08"]},"もし「自分が醜い」と感じる程度が、何度も鏡を見たり、何度も修正したいと考えたりするレベルに達しているなら、手術を検討する前に、まずボディイメージの評価を受けること"]},{"tag":"a","props":{"href":"/ja/tip/28-09"},"children":[{"tag":"span","props":{},"children":["09"]},"歯列矯正は矯正の資格がある医師の対面診察を受け、定期受診する。ネットでマウスピースを買って自宅で使わない"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"現在地"},"children":[{"tag":"a","props":{"href":"/ja/book"},"children":["本を読む"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/ja/book/28"},"children":["第28章"," ·"," ","見た目のために体を壊さないで"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"28-02"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["02"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["エビデンス"," ","A"]}]},{"tag":"h1","props":{"lang":"ja"},"children":["注射、糸リフト、手術の前に確認すべき2つのこと：施設の許可証に「医療美容」の記載があるか、施術者が主治医であるか"]},{"tag":"p","props":{"lang":"ja","className":"life-entry-summary"},"children":["針やメスを使用し、医療機器を用い、皮膚を傷つけたり体内に入れたりする行為は、すべて診療にあたります。許可証に「医療美容」と記載されている施設でのみ行うことができ、施術者は登録済みの執例医師でなければなりません。美容院、スタジオ、ホテルの客室などで行われる行為は、無免許医業に該当します。施術者の行為が重大な場合は 3 年以下の懲役、負傷させた場合は 3 から 10 年の懲役、死亡に至らせた場合は 10 年以上の懲役が科されます。"]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["費用・手間"]},{"tag":"p","props":{},"children":["無料です。これら2つの証明書を確認するのに数分もかかりません。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["効果"]},{"tag":"p","props":{},"children":["『医療美容サービス管理方法』の第二条では、医療美容の定義が示されています。原文では「手術、薬剤、医療機器、およびその他の侵襲的または侵入的な医学的手法を用いて、人の容貌および人体各部位の形態に対して行う修復および再構築」…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"記録する：注射、糸リフト、手術の前に確認すべき2つのこと：施設の許可証に「医療美容」の記載があるか、施術者が主治医であるか"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"できている"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"やることに追加"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"お気に入り"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"このヒントを共有"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"詳細を閉じる"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["費用・手間"]},{"tag":"p","props":{},"children":["無料です。これら2つの証明書を確認するのに数分もかかりません。施設は「医療機関執業許可証」をロビーに掲示しているはずです。医師の資格は、衛生健康部門の執業医師照会システムで照合できます。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["効果"]},{"tag":"p","props":{},"children":["『医療美容サービス管理方法』の第二条では、医療美容の定義が示されています。原文では「手術、薬剤、医療機器、およびその他の侵襲的または侵入的な医学的手法を用いて、人の容貌および人体各部位の形態に対して行う修復および再構築」とされています。平たく言えば、皮膚を傷つける、針を刺す、体内に入れるといった行為があれば、診療とみなされます。第八条および第二十四条では、事前に『医療機関執業許可証』を取得し、かつ登録機関によって医療美容の診療科目が承認されていなければ、業務を行うことはできません。許可証に「医療美容」の項目が記載されていない場合は、実施できません。第十一条では、主治医（実際に処置を行う医師）が医師免許を保有し、かつ登録済みであることを求めています。美容外科を行うには、6年以上の関連専門分野における臨床経験が必要であり、美容歯科は5年以上、美容中医科および美容皮膚科はそれぞれ3年以上の経験が求められます。第二十条では、施術前に適応症、禁忌事項（どのような状況で適しており、どのような状況では行ってはいけないか）、医療リスク、および注意事項を文書で告知し、署名による同意を得ることを義務付けています。『刑法』第三百三十六条は、無免許医業（非法行医）を規定しています。無免許医業とは、医師の免許を持たない者が注射、手術、診察を行うことを指します。事態が重大な場合は、3年以下の有期懲役、拘役、または管制に処され、罰金が科せられるか、あるいは単独で罰金が科せられます。患者の健康に重大な損害を与えた場合は、3年以上の10年以下の有期懲役および罰金に処されます。患者を死亡させた場合は、10年以上の有期懲役および罰金に処されます"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["出典"]},{"tag":"p","props":{"className":"life-citations"},"children":["卫生部 (2002). 医疗美容服务管理办法（卫生部令第 19 号，第二条、第八条、第十一条、第十六条、第二十条、第二十四条）. ",{"tag":"a","props":{"href":"http://www.gov.cn/gongbao/content/2003/content_62198.htm","target":"_blank","rel":"noopener noreferrer"},"children":["http://www.gov.cn/gongbao/content/2003/content_62198.htm"]},"；全国人大 (1997). 刑法（第三百三十六条）. ",{"tag":"a","props":{"href":"https://www.spp.gov.cn/spp/fl/201802/t20180206_364975.shtml","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.spp.gov.cn/spp/fl/201802/t20180206_364975.shtml"]}]},{"tag":"a","props":{"href":"http://www.gov.cn/gongbao/content/2003/content_62198.htm","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["出典を開く"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["著者の注記"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["同規定の第16条では、美容医療プロジェクトは美容医療機関、または美容医療科を設置した病院やクリニックでのみ行うことができると定められています。したがって、出張注射やスタジオでの個人的な施術は、場所を見ただけで不適切であると判断できます。第20条には、未成年者など自己決定権のない者が美容医療を受ける場合は、必ず保護者の同意を得て、保護者の署名が必要であると明記されています。フェイシャル、マッサージ、ネイルは「生活美容」に分類され、この規定の対象外です。しかし、針やメスを用いる場合は、すべて医療美容とみなされます。"]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["自分のメモ"]},{"tag":"button","props":{"type":"button"},"children":["自分へのメモを書く…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/ja/tip/28-01"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["前へ"]},"極端な食事制限、断食、または催吐による体重管理は避けてください。減量したいなら、運動の側面からアプローチしましょう"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/ja/tip/28-03"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["次へ"]},"顔のフィラー注入は鼻背、眉間、額の部位を避け、節約のために非正規の注入を行わないこと"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["このテーマの他の提案"]},{"tag":