-round","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M18 20a6 6 0 0 0-12 0"},"children":[]},{"tag":"circle","props":{"cx":"12","cy":"10","r":"4"},"children":[]},{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},{"tag":"span","props":{},"children":["Đăng nhập để đồng bộ hóa"]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/vi/book/10"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"Quay lại mục lục"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["Yêu đương và kết hôn có đáng không"]},{"tag":"nav","props":{"aria-label":"Các mục trong chương"},"children":[{"tag":"a","props":{"href":"/vi/tip/10-01"},"children":[{"tag":"span","props":{},"children":["01"]},"Quen thêm nhiều người thay vì bám lấy một người: có hợp nhau hay không thì không đoán được trước khi gặp"]},{"tag":"a","props":{"href":"/vi/tip/10-02"},"children":[{"tag":"span","props":{},"children":["02"]},"Dừng lại sau khi đối phương từ chối rõ ràng: cứ bám theo tiếp là vi phạm trật tự an ninh, không phải「chân thành」"]},{"tag":"a","props":{"href":"/vi/tip/10-03"},"children":[{"tag":"span","props":{},"children":["03"]},"Muốn biết đối phương có hứng thú hay không thì xem hành vi, đừng xem「tín hiệu」: ai chủ động, ai sắp xếp, ai theo sau"]},{"tag":"a","props":{"href":"/vi/tip/10-04"},"children":[{"tag":"span","props":{},"children":["04"]},"Mối quan hệ có tốt hay không, chủ yếu xem cảm nhận của chính bạn, không phải xem điều kiện của đối phương"]},{"tag":"a","props":{"href":"/vi/tip/10-05"},"children":[{"tag":"span","props":{},"children":["05"]},"Muốn kéo gần khoảng cách thì thay nhau trả lời một loạt câu hỏi từ nông đến sâu, đừng học thoại"]},{"tag":"a","props":{"href":"/vi/tip/10-06"},"children":[{"tag":"span","props":{},"children":["06"]},"Yêu xa không kém yêu gần; cửa ải thật sự là ba tháng đầu sau khi dọn về sống cùng nhau"]},{"tag":"a","props":{"href":"/vi/tip/10-07"},"children":[{"tag":"span","props":{},"children":["07"]},"Xem số liệu đăng ký trước, nghe lời bố mẹ sau: tỷ lệ kết hôn, tỷ lệ ly hôn tính theo cách nào"]},{"tag":"a","props":{"href":"/vi/tip/10-08"},"children":[{"tag":"span","props":{},"children":["08"]},"Tính cả lợi ích sức khỏe của hôn nhân, nhưng giảm mức kỳ vọng vì đó là dữ liệu quan sát"]},{"tag":"a","props":{"href":"/vi/tip/10-09"},"children":[{"tag":"span","props":{},"children":["09"]},"Bảng tính thời gian thì tính theo「việc không được trả công」, nói rõ phân công rồi hãy đi đăng ký"]},{"tag":"a","props":{"href":"/vi/tip/10-10"},"children":[{"tag":"span","props":{},"children":["10"]},"Chuyện tiền bạc khi kết hôn: xem quy định mặc định của pháp luật trước, rồi quyết định có cần thỏa thuận bằng văn bản không"]},{"tag":"a","props":{"href":"/vi/tip/10-11"},"children":[{"tag":"span","props":{},"children":["11"]},"Bố mẹ góp tiền mua nhà, lúc chuyển khoản thì viết rõ là cho hay là vay"]},{"tag":"a","props":{"href":"/vi/tip/10-12"},"children":[{"tag":"span","props":{},"children":["12"]},"Khoản vay lớn của một bên vợ chồng, nếu bạn không ký và không xác nhận sau, không tự động thành nợ của bạn"]},{"tag":"a","props":{"href":"/vi/tip/10-13"},"children":[{"tag":"span","props":{},"children":["13"]},"Đi đăng ký chỉ cần thẻ căn cước cộng một bản cam kết có chữ ký, không cần sổ hộ khẩu, không thu tiền, cấp giấy ngay tại chỗ"]},{"tag":"a","props":{"href":"/vi/tip/10-14"},"children":[{"tag":"span","props":{},"children":["14"]},"Trước khi cưới nên làm một lần khám sức khoẻ tiền hôn nhân, mắc bệnh hiểm nghèo nặng thì phải nói thật với bên kia trước khi đăng ký"]},{"tag":"a","props":{"href":"/vi/tip/10-15"},"children":[{"tag":"span","props":{},"children":["15"]},"Tính chi phí thoát ra: ly hôn thuận lợi có 30 ngày suy nghĩ, ly hôn kiện tụng có điều kiện theo pháp luật"]},{"tag":"a","props":{"href":"/vi/tip/10-16"},"children":[{"tag":"span","props":{},"children":["16"]},"Ghi riêng một sổ cho việc「cưới vì bậc trưởng bối」, đừng trộn vào sổ của chính mình"]},{"tag":"a","props":{"href":"/vi/tip/10-17"},"children":[{"tag":"span","props":{},"children":["17"]},"Hãy coi chất lượng mối quan hệ là một khoản sức khoẻ: cãi nhau thì nói về việc chứ không công kích con người, đừng chửi, đừng đào lại"]},{"tag":"a","props":{"href":"/vi/tip/10-18"},"children":[{"tag":"span","props":{},"children":["18"]},"Đôi bạn cùng giới nên tranh thủ lúc cả hai còn minh mẫn, làm xong giấy uỷ quyền, giám hộ tự nguyện bằng văn bản và di chúc: về mặt pháp luật hai người không phải người thân, không làm thì không có quyền ký và không có quyền thừa kế"]},{"tag":"a","props":{"href":"/vi/tip/10-19"},"children":[{"tag":"span","props":{},"children":["19"]},"Đừng giấu xu hướng tính dục mà kết hôn, cũng đừng coi hôn nhân hình thức là cách cho tiện"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/vi/tip/10-20","data-status":"active"},"children":[{"tag":"span","props":{},"children":["20"]},"Mối quan hệ kẹt ở chỗ cãi nhau lặp đi lặp lại và im lặng, thì cả hai cùng đi làm trị liệu đôi: ngồi chờ thì gần như không tự khỏi"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"Breadcrumbs"},"children":[{"tag":"a","props":{"href":"/vi/book"},"children":["Khám phá cuốn sách"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/vi/book/10"},"children":["Chương 10"," ·"," ","Yêu đương và kết hôn có đáng không"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"10-20"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["20"]},{"tag":"span","props":{"className":"life-evidence grade-a（争议）"},"children":["Bằng chứng"," ","A（争议）"]}]},{"tag":"h1","props":{"lang":"vi"},"children":["Mối quan hệ kẹt ở chỗ cãi nhau lặp đi lặp lại và im lặng, thì cả hai cùng đi làm trị liệu đôi: ngồi chờ thì gần như không tự khỏi"]},{"tag":"p","props":{"lang":"vi","className":"life-entry-summary"},"children":["Cặp đôi kẹt ở mối quan hệ mà cùng làm trị liệu đôi thì hài lòng với mối quan hệ rõ ràng hơn, khoảng bảy phần mười có cải thiện. Cặp chỉ xếp hàng chờ thì gần như không thay đổi gì. Nhưng hiệu quả có mờ dần: đến năm thứ 5, khoảng một nửa vẫn còn tốt rõ rệt, khoảng một phần tư đã ly trú hoặc ly hôn."]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Chi phí"]},{"tag":"p","props":{},"children":["Phải tốn tiền. Tính theo buổi, mỗi bệnh viện một giá, mục…"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Lợi ích"]},{"tag":"p","props":{},"children":["Một phân tích tổng hợp năm 2020 gộp 58 nghiên cứu, 2092 cặp đôi. Sau khi làm trị liệu đôi, mức thay đổi của sự…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"Đánh dấu: Mối quan hệ kẹt ở chỗ cãi nhau lặp đi lặp lại và im lặng, thì cả hai cùng đi làm trị liệu đôi: ngồi chờ thì gần như không tự khỏi"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"Hoàn tất"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"Kế hoạch thực hiện"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"Lưu"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Chia sẻ mẹo này"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Ẩn chi tiết"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Chi phí"]},{"tag":"p","props":{},"children":["Phải tốn tiền. Tính theo buổi, mỗi bệnh viện một giá, mục này không viết con số. Trong nghiên cứu thường đi mỗi tuần một lần, một thử nghiệm kéo dài khoảng 8 tháng trước và sau. Khó ở chỗ cả hai người đều phải đi, mà còn phải kiên trì làm hết."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Lợi ích"]},{"tag":"p","props":{},"children":["Một phân tích tổng hợp năm 2020 gộp 58 nghiên cứu, 2092 cặp đôi. Sau khi làm trị liệu đôi, mức thay đổi của sự hài lòng mối quan hệ g = 1.12 (khoảng tin cậy 0.92–1.31), tác giả nói đây là hiệu ứng lớn. g là cỡ hiệu ứng, xem bảng thuật ngữ trong README. Cặp được xếp vào nhóm chờ trong cùng thời gian đó thì g = 0.12 (−0.04 đến 0.29), không cải thiện rõ rệt. Lúc bắt đầu quan hệ càng tệ thì càng cải thiện nhiều. Một tổng quan năm 2012 viết rằng trị liệu đôi giúp 70% các cặp được điều trị có cải thiện. Một thử nghiệm chia ngẫu nhiên khác tìm 134 cặp vợ chồng lâu năm, bất hòa nặng, thực hiện hai dạng trị liệu đôi theo hành vi trong khoảng 8 tháng. Lúc kết thúc mức thay đổi sự hài lòng là d = 0.90 và 0.71. Đến năm thứ 5, lần lượt 50.0% và 45.9% cặp vợ chồng vẫn còn cải thiện rõ rệt. Cải thiện rõ rệt ở đây tác giả gọi là「có cải thiện mang ý nghĩa lâm sàng」. Đồng thời 25.7% và 27.9% đã ly trú hoặc ly hôn"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Nguồn gốc"]},{"tag":"p","props":{"className":"life-citations"},"children":["Roddy MK, Walsh LM, Rothman K, Hatch SG, Doss BD (2020). Meta-analysis of couple therapy: effects across outcomes, designs, timeframes, and other moderators. Journal of Consulting and Clinical Psychology, 88(7), 583-596. ",{"tag":"a","props":{"href":"https://doi.org/10.1037/ccp0000514","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1037/ccp0000514"]},"；Lebow JL, Chambers AL, Christensen A, Johnson SM (2012). Research on the treatment of couple distress. Journal of Marital and Family Therapy, 38(1), 145-168. ",{"tag":"a","props":{"href":"https://doi.org/10.1111/j.1752-0606.2011.00249.x","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1111/j.1752-0606.2011.00249.x"]},"；Christensen A, Atkins DC, Baucom B, Yi J (2010). Marital status and satisfaction five years following a randomized clinical trial comparing traditional versus integrative behavioral couple therapy. Journal of Consulting and Clinical Psychology, 78(2), 225-235. ",{"tag":"a","props":{"href":"https://doi.org/10.1037/a0018132","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1037/a0018132"]},"；Rathgeber M, Bürkner PC, Schiller EM, Holling H (2019). The efficacy of emotionally focused couples therapy and behavioral couples therapy: a meta-analysis. Journal of Marital and Family Therapy, 45(3), 447-463. ",{"tag":"a","props":{"href":"https://doi.org/10.1111/jmft.12336","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1111/jmft.12336"]},"（争议方）；Shadish WR, Baldwin SA (2003). Meta-analysis of MFT interventions. Journal of Marital and Family Therapy, 29(4), 547-570. ",{"tag":"a","props":{"href":"https://doi.org/10.1111/j.1752-0606.2003.tb01694.x","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1111/j.1752-0606.2003.tb01694.x"]},"（争议方）；Karakurt G, Whiting K, van Esch C, Bolen SD, Calabrese JR (2016). Couples therapy for intimate partner violence: a systematic review and meta-analysis. Journal of Marital and Family Therapy, 42(4), 567-583. ",{"tag":"a","props":{"href":"https://doi.org/10.1111/jmft.12178","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1111/jmft.12178"]},"；全国人大常委会 (2018 修正). 精神卫生法（第二十三、五十一条）. ",{"tag":"a","props":{"href":"https://flk.npc.gov.cn/detail?id=2c909fdd678bf17901678bf7448a066d","target":"_blank","rel":"noopener noreferrer"},"children":["https://flk.npc.gov.cn/detail?id=2c909fdd678bf17901678bf7448a066d"]},"（国家法律法规数据库）"]},{"tag":"a","props":{"href":"https://doi.org/10.1037/ccp0000514","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Liên kết mở nguồn"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Ghi chú sách"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["Tranh cãi ở chỗ hiệu quả giữ được bao lâu. Trong một phân tích tổng hợp khác chỉ thu thập thử nghiệm chia ngẫu nhiên, lúc kết thúc g = 0.60, nửa năm sau là 0.44. Đến 12 tháng chỉ còn trị liệu đôi theo hành vi có số liệu, g = 0.06, gần như không giữ được. Một tổng quan khác gộp 20 phân tích tổng hợp nói hiệu ứng mang ý nghĩa lâm sàng xuất hiện ở 40% đến 50% số người. 「Bảy phần mười có cải thiện」và「bốn đến năm phần mười cải thiện rõ rệt」dùng tiêu chuẩn khác nhau, đừng so sánh lẫn nhau. Thử nghiệm năm năm đó không có nhóm đối chứng không điều trị, nên không nói được ly hôn là tăng hay giảm. Nghiên cứu gộp năm 2020 toàn bộ là cặp đôi khác giới tính, mục này cũng không tìm thấy thử nghiệm chia ngẫu nhiên trong nước, áp vào trường hợp của bạn thì phải trừ đi chút. Ở trong nước làm ở đâu: Luật vệ sinh tâm thần quy định trị liệu tâm lý phải làm trong cơ sở y tế, nhân viên tư vấn tâm lý không được làm trị liệu tâm lý. Có thể hỏi khoa tâm thần hoặc khoa tâm lý ở bệnh viện xem có trị liệu đôi không. Tìm cơ sở ngoài bệnh viện thì hỏi trước điều kiện hành nghề và kiến thức đào tạo của người đó. Có bạo lực gia đình thì đừng đi cùng nhau. Phân tích tổng hợp năm 2016 ghi rõ, kết luận chỉ áp dụng cho bạo lực mức nhẹ đến trung bình, do hai bên đụng đấm nhau vì xung đột. Bạo lực mang đặc trưng kiểm soát đối phương, gây tổn thương nặng thì không nằm trong đó. Người trong nghề cũng lo rằng nói chuyện xong về nhà lại bị trả đũa. Bị đánh thì xem mục 43 ở phần 8 (bị bạo lực gia đình). Khi cãi nhau nói cách gì, xem mục 17 của phần này (cãi nhau thì nói về việc chứ không công kích con người), cân nhắc kỹ có nên đi không, xem mục 15 của phần này (chi phí thoát ra). Người hưởng lợi là bạn và người phối ngẫu."]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Ghi chú của tôi"]},{"tag":"button","props":{"type":"button"},"children":["Viết một lời nhắc cho chính bạn…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/vi/tip/10-19"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Trước"]},"Đừng giấu xu hướng tính dục mà kết hôn, cũng đừng coi hôn nhân hình thức là cách cho tiện"]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["Thêm trong chủ đề này"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/10-13"},"children":[{"tag":"strong","props":{},"children":["Đi đăng ký chỉ cần thẻ căn cước cộng một bản cam kết có chữ ký, không cần sổ hộ khẩu, không thu tiền, cấp giấy ngay tại chỗ"]},{"tag":"span","props":{},"children":["Từ tháng 5 năm 2025, đi đăng ký chỉ cần hai thứ: thẻ căn cước của chí…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/10-14"},"children":[{"tag":"strong","props":{},"children":["Trước khi cưới nên làm một lần khám sức khoẻ tiền hôn nhân, mắc bệnh hiểm nghèo nặng thì phải nói thật với bên kia trước khi đăng ký"]},{"tag":"span","props":{},"children":["Mắc bệnh hiểm nghèo nặng mà không nói thật với bên kia trước khi đăng…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/10-15"},"children":[{"tag":"strong","props":{},"children":["Tính chi phí thoát ra: ly hôn thuận lợi có 30 ngày suy nghĩ, ly hôn kiện tụng có điều kiện theo pháp luật"]},{"tag":"span","props":{},"children":["Ly hôn thuận lợi không phải ký xong là xong. Sau khi nộp đơn trong 30…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/10-16"},"children":[{"tag":"strong","props":{},"children":["Ghi riêng một sổ cho việc「cưới vì bậc trưởng bối」, đừng trộn vào sổ của chính mình"]},{"tag":"span","props":{},"children":["Lợi ích cho bậc trưởng bối, tức là yên tâm, thể diện, không còn bị th…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/10-17"},"children":[{"tag":"strong","props":{},"children":["Hãy coi chất lượng mối quan hệ là một khoản sức khoẻ: cãi nhau thì nói về việc chứ không công kích con người, đừng chửi, đừng đào lại"]},{"tag":"span","props":{},"children":["Vợ chồng có quan hệ tốt thì sức khoẻ một chút, nguy cơ chết cũng thấp…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/10-18"},"children":[{"tag":"strong","props":{},"children":["Đôi bạn cùng giới nên tranh thủ lúc cả hai còn minh mẫn, làm xong giấy uỷ quyền, giám hộ tự nguyện bằng văn bản và di chúc: về mặt pháp luật hai người không phải người thân, không làm thì không có quyền ký và không có quyền thừa kế"]},{"tag":"span","props":{},"children":["Người thân theo pháp luật là vợ chồng, cha mẹ, con cái, anh chị em, b…"]}]}]}]},{"tag":"a","props":{"className":"life-text-link","href":"/vi/book/10"},"children":["Đọc toàn bộ chủ đề: Yêu đương và kết hôn có đáng không"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"15","height":"15","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]}]}]},{"tag":"nav","props":{"className":"life-tabbar","aria-label":"Điều hướng chính"},"children":[{"tag"