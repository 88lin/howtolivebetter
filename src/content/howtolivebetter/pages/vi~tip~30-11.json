ren":[{"tag":"path","props":{"d":"M18 20a6 6 0 0 0-12 0"},"children":[]},{"tag":"circle","props":{"cx":"12","cy":"10","r":"4"},"children":[]},{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},{"tag":"span","props":{},"children":["Đăng nhập để đồng bộ hóa"]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/vi/book/30"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"Quay lại mục lục"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["Trẻ đang đi học"]},{"tag":"nav","props":{"aria-label":"Các mục trong chương"},"children":[{"tag":"a","props":{"href":"/vi/tip/30-01"},"children":[{"tag":"span","props":{},"children":["01"]},"Trẻ bảo đau dữ dội bất ngờ và đau hơn nữa thì đưa đi bệnh viện ngay, đừng để cháu nhịn đến tan học"]},{"tag":"a","props":{"href":"/vi/tip/30-02"},"children":[{"tag":"span","props":{},"children":["02"]},"Không nên vì「chờ thi xong」mà trì hoãn việc chữa trị cần làm, có những cửa sổ thời gian đi theo tuổi xương chứ không theo lịch thi"]},{"tag":"a","props":{"href":"/vi/tip/30-03"},"children":[{"tag":"span","props":{},"children":["03"]},"Trẻ bị bắt nạt thì báo ngay trong ngày cho nhà trường và yêu cầu xử lý bằng văn bản, có đánh nhau, cướp tiền, tung tin thì báo công an"]},{"tag":"a","props":{"href":"/vi/tip/30-04"},"children":[{"tag":"span","props":{},"children":["04"]},"Cho trẻ ở ngoài trời đủ 2 giờ mỗi ngày, đây là cách phòng cận thị duy nhất hiện có thử nghiệm ngẫu nhiên đứng sau"]},{"tag":"a","props":{"href":"/vi/tip/30-05"},"children":[{"tag":"span","props":{},"children":["05"]},"Không cho màn hình ở tuổi 0 đến 3, hạn chế tối đa ở tuổi 3 đến 6, học sinh tiểu học và trung học dùng màn hình không phải để học thì mỗi ngày không quá 1 giờ"]},{"tag":"a","props":{"href":"/vi/tip/30-06"},"children":[{"tag":"span","props":{},"children":["06"]},"Hãy coi cận thị là một tổn thương còn lại: độ càng cao thì sau này càng nhiều bong võng mạc, thoái hoa điểm vàng và glôcôm"]},{"tag":"a","props":{"href":"/vi/tip/30-07"},"children":[{"tag":"span","props":{},"children":["07"]},"Báo cáo khám sức khoẻ học sinh hằng năm phải tự đọc một lượt, mục bất thường thì đưa đi khám trong năm đó"]},{"tag":"a","props":{"href":"/vi/tip/30-08"},"children":[{"tag":"span","props":{},"children":["08"]},"Cho trẻ 12 đến 18 tuổi làm một lần sàng lọc trầm cảm, đừng lấy bài tâm lý học đường làm chẩn đoán"]},{"tag":"a","props":{"href":"/vi/tip/30-09"},"children":[{"tag":"span","props":{},"children":["09"]},"Đừng mua sản phẩm và dịch vụ quảng cáo là có thể「chữa khỏi cận thị」「giảm độ」"]},{"tag":"a","props":{"href":"/vi/tip/30-10"},"children":[{"tag":"span","props":{},"children":["10"]},"Giấc ngủ, bài tập, thể dục và xếp hạng đều có quy định bằng văn bản, trường không làm được thì có thể kiến nghị"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/vi/tip/30-11","data-status":"active"},"children":[{"tag":"span","props":{},"children":["11"]},"Con không chịu nổi thì có thể xin nghỉ học, trường bắt buộc giữ học vị cho cháu, tối đa 1 năm"]},{"tag":"a","props":{"href":"/vi/tip/30-12"},"children":[{"tag":"span","props":{},"children":["12"]},"Khám ra nhìn kém thì ra bệnh viện khám khúc xạ sau khi nhỏ mắt, sau đó tái khám theo khoảng cách bác sĩ chỉ định"]},{"tag":"a","props":{"href":"/vi/tip/30-13"},"children":[{"tag":"span","props":{},"children":["13"]},"Sau khi răng cối chính mọc lên thì làm hàn khe răng"]},{"tag":"a","props":{"href":"/vi/tip/30-14"},"children":[{"tag":"span","props":{},"children":["14"]},"Con thích chơi game thì xem giấc ngủ, bài tập và ra ngoài vận động có bị chen mất không, đừng chỉ nhìn thời gian chơi"]},{"tag":"a","props":{"href":"/vi/tip/30-15"},"children":[{"tag":"span","props":{},"children":["15"]},"Trẻ nói mình thích người cùng giới, đừng mắng, đừng đuổi khỏi nhà, đừng đưa đi「cải tận」: thái độ của gia đình có liên quan đến chuyện trẻ có tự sát hay không"]},{"tag":"a","props":{"href":"/vi/tip/30-16"},"children":[{"tag":"span","props":{},"children":["16"]},"Quản trẻ thì đừng ra tay đánh, cũng đừng quát mắng hay chửi trẻ là ngu: trẻ hay bị đánh mắng thì vấn đề hành vi và vấn đề tâm lý đều nhiều hơn"]},{"tag":"a","props":{"href":"/vi/tip/30-17"},"children":[{"tag":"span","props":{},"children":["17"]},"Trẻ khó quản, bản thân lúc nào cũng không nhịn được mà đánh mắng, thì đi học một khoá dạy cha mẹ có cách làm cụ thể"]},{"tag":"a","props":{"href":"/vi/tip/30-18"},"children":[{"tag":"span","props":{},"children":["18"]},"Đừng đưa con vào «trường cai nghiện internet» hay «trại đặc huấn» quản lý khép kín: luật cấm cách cai gây tổn hại thể chất, tinh thần, và đã có trẻ bị nhốt đến chết"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"Breadcrumbs"},"children":[{"tag":"a","props":{"href":"/vi/book"},"children":["Khám phá cuốn sách"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/vi/book/30"},"children":["Chương 30"," ·"," ","Trẻ đang đi học"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"30-11"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["11"]},{"tag":"span","props":{"className":"life-evidence grade-b"},"children":["Bằng chứng"," ","B"]}]},{"tag":"h1","props":{"lang":"vi"},"children":["Con không chịu nổi thì có thể xin nghỉ học, trường bắt buộc giữ học vị cho cháu, tối đa 1 năm"]},{"tag":"p","props":{"lang":"vi","className":"life-entry-summary"},"children":["Nghỉ học có thủ tục chính thức. Cha mẹ hoặc người giám hộ khác nộp đơn, nhà trường xác nhận rồi báo lên cấp trên để phê duyệt. Một lần tối đa 1 năm, hết hạn còn nghỉ tiếp thì phải nộp đơn lại. Trong thời gian nghỉ học, nhà trường phải giữ học vị cho con, khi trở lại học thì nối tiếp. Cách làm cụ thể do từng tỉnh quy định, hỏi phòng giáo vụ của trường hoặc sở giáo dục địa phương."]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Chi phí"]},{"tag":"p","props":{},"children":["Không tốn tiền. Cha mẹ hoặc người giám hộ hợp pháp khác nộ…"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Lợi ích"]},{"tag":"p","props":{},"children":["Quy định quản lý học vị học sinh tiểu học và trung học《中小学生学籍管理办法》Điều mười sáu quy định học sinh nghỉ học thì…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"Đánh dấu: Con không chịu nổi thì có thể xin nghỉ học, trường bắt buộc giữ học vị cho cháu, tối đa 1 năm"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"Hoàn tất"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"Kế hoạch thực hiện"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"Lưu"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Chia sẻ mẹo này"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Ẩn chi tiết"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Chi phí"]},{"tag":"p","props":{},"children":["Không tốn tiền. Cha mẹ hoặc người giám hộ hợp pháp khác nộp đơn lên nhà trường. Chỗ khó là phải chấp nhận cho con dừng học một thời gian."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Lợi ích"]},{"tag":"p","props":{},"children":["Quy định quản lý học vị học sinh tiểu học và trung học《中小学生学籍管理办法》Điều mười sáu quy định học sinh nghỉ học thì làm thế nào. Việc học sinh nghỉ học do cha mẹ hoặc người giám hộ hợp pháp khác nộp đơn. Nhà trường xác nhận rồi báo lên cơ quan quản lý học vị cấp trên để phê duyệt. Khi trở lại học, nhà trường phải làm thủ tục liên quan kịp thời. Thời hạn một lần xin nghỉ học không quá 1 năm, hết hạn mà thật sự còn nghỉ tiếp thì phải nộp đơn xin lại. Trong thời gian học sinh nghỉ học, nhà trường phải giữ học vị cho học sinh (tư cách và chỗ đứng của học sinh được giữ lại). Cách làm cụ thể về nghỉ học và trở lại học do cơ quan quản lý giáo dục cấp tỉnh quy định (toàn quốc, ban hành tháng 1 năm 2025). Mười biện pháp tăng cường công tác sức khoẻ tâm lý cho học sinh tiểu học và trung học yêu cầu đẩy nhanh việc xây dựng cơ chế giới thiệu chuyển tuyến khám bệnh tâm thần và trở lại học sau khi hồi phục, hướng dẫn nhà trường xây dựng kế hoạch ứng phó với khủng hoảng tâm lý bất thường xảy ra trong trường"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Nguồn gốc"]},{"tag":"p","props":{"className":"life-citations"},"children":["教育部 (2025). 中小学生学籍管理办法（教基〔2025〕1 号，第十六条）. ",{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/202502/content_7002620.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/zhengce/zhengceku/202502/content_7002620.htm"]},"；教育部办公厅 (2025). 进一步加强中小学生心理健康工作十条措施（教基厅〔2025〕2 号）. ",{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/202510/content_7045528.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/zhengce/zhengceku/202510/content_7045528.htm"]}]},{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/202502/content_7002620.htm","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Liên kết mở nguồn"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Ghi chú sách"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["Trước khi đi làm thủ tục thì hỏi rõ ba việc: cần xin loại giấy tờ y tế nào, khoảng thời gian nghỉ học thì học vị được ghi thế nào trong hệ thống, khi trở lại học là về nguyên lớp hay xuống một lớp. Để mức B là vì điều kiện nghỉ học, hồ sơ phải nộp và cách nối lại khi trở lại học đều do cơ quan giáo dục cấp tỉnh tự quy định, phần cấp quốc gia chỉ dựng khung. Quy định về bảo vệ học sinh vị thành niên《未成年人学校保护规定》còn yêu cầu trường giáo dục bắt buộc lập hồ sơ báo cáo cho học sinh bỏ học, nghỉ học và nghỉ phép dài ngày, nên nghỉ học là việc trường đã làm qua, không phải mở ngoại lệ riêng cho bạn."]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Ghi chú của tôi"]},{"tag":"button","props":{"type":"button"},"children":["Viết một lời nhắc cho chính bạn…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/vi/tip/30-10"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Trước"]},"Giấc ngủ, bài tập, thể dục và xếp hạng đều có quy định bằng văn bản, trường không làm được thì có thể kiến nghị"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/vi/tip/30-12"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Tiếp theo"]},"Khám ra nhìn kém thì ra bệnh viện khám khúc xạ sau khi nhỏ mắt, sau đó tái khám theo khoảng cách bác sĩ chỉ định"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"ta