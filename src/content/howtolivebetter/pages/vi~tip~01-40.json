hildren":[{"tag":"span","props":{},"children":["05"]},"Không hái, không mua, không ăn nấm hoang, mọi cách nhận biết kiểu dân gian đều không có cơ sở"]},{"tag":"a","props":{"href":"/vi/tip/01-06"},"children":[{"tag":"span","props":{},"children":["06"]},"Không đẩy xe điện vào hành lang, không vào thang máy, không sạc trong nhà"]},{"tag":"a","props":{"href":"/vi/tip/01-07"},"children":[{"tag":"span","props":{},"children":["07"]},"Đo huyết áp, cao rồi thì uống thuốc hạ cho tới mức chuẩn"]},{"tag":"a","props":{"href":"/vi/tip/01-08"},"children":[{"tag":"span","props":{},"children":["08"]},"Từ 35 tuổi, cứ thừa cân là đi xét đường huyết lúc nhịn một lần, xét ra bình thường thì ba năm xét lại"]},{"tag":"a","props":{"href":"/vi/tip/01-09"},"children":[{"tag":"span","props":{},"children":["09"]},"Không chạy quá tốc độ, không lái xe sau khi uống rượu"]},{"tag":"a","props":{"href":"/vi/tip/01-10"},"children":[{"tag":"span","props":{},"children":["10"]},"Khi đi ô tô, dùng ghế an toàn cho trẻ dưới 4 tuổi, đừng ôm trong lòng"]},{"tag":"a","props":{"href":"/vi/tip/01-11"},"children":[{"tag":"span","props":{},"children":["11"]},"Nhà có trẻ nhỏ thì lắp chặn cửa sổ và ban công, lưới chống muỗi không tính là biện pháp bảo vệ"]},{"tag":"a","props":{"href":"/vi/tip/01-12"},"children":[{"tag":"span","props":{},"children":["12"]},"Trẻ em ở gần nước thì không được rời mắt, chèo thuyền hay bơi ngoài trời thì mặc áo phao"]},{"tag":"a","props":{"href":"/vi/tip/01-13"},"children":[{"tag":"span","props":{},"children":["13"]},"Trên 60 tuổi tập thăng bằng và sức chân, cải tạo phòng tắm và cầu thang trong nhà"]},{"tag":"a","props":{"href":"/vi/tip/01-14"},"children":[{"tag":"span","props":{},"children":["14"]},"Xét nghiệm 5 chỉ số viêm gan B, không có kháng thể thì tiêm vaccine"]},{"tag":"a","props":{"href":"/vi/tip/01-15"},"children":[{"tag":"span","props":{},"children":["15"]},"Bị đinh sắt, gai gỗ đâm vào hoặc vết thương dính đất thì xử lý ngay trong ngày, tiện thể hỏi có cần tiêm phòng uốn dương không"]},{"tag":"a","props":{"href":"/vi/tip/01-16"},"children":[{"tag":"span","props":{},"children":["16"]},"Phụ nữ tiêm vaccine HPV, càng sớm càng tốt"]},{"tag":"a","props":{"href":"/vi/tip/01-17"},"children":[{"tag":"span","props":{},"children":["17"]},"Phụ nữ từ 40 tuổi làm xét nghiệm sàng lọc ung thư vú, chụp mammogram mỗi hai năm một lần"]},{"tag":"a","props":{"href":"/vi/tip/01-18"},"children":[{"tag":"span","props":{},"children":["18"]},"Phụ nữ trên 30 tuổi làm xét nghiệm sàng lọc ung thư cổ tử cung, ưu tiên xét nghiệm HPV"]},{"tag":"a","props":{"href":"/vi/tip/01-19"},"children":[{"tag":"span","props":{},"children":["19"]},"Từ 45 đến 50 tuổi làm xét nghiệm sàng lọc ung thư trực tràng và ruột già, bằng xét nghiệm miễn dịch hoá học tìm máu ẩn trong phân hoặc nội soi đại tràng"]},{"tag":"a","props":{"href":"/vi/tip/01-20"},"children":[{"tag":"span","props":{},"children":["20"]},"Người bệnh tim mạch và người cao tuổi tiêm vaccine cúm mỗi năm"]},{"tag":"a","props":{"href":"/vi/tip/01-21"},"children":[{"tag":"span","props":{},"children":["21"]},"Từ 50 tuổi, tiêm vaccine thủy độc"]},{"tag":"a","props":{"href":"/vi/tip/01-22"},"children":[{"tag":"span","props":{},"children":["22"]},"Người từ 65 tuổi tiêm vaccine phế cầu khuẩu"]},{"tag":"a","props":{"href":"/vi/tip/01-23"},"children":[{"tag":"span","props":{},"children":["23"]},"Xét nghiệm vi khuẩn H. pylori, dương tính thì diệt trùng"]},{"tag":"a","props":{"href":"/vi/tip/01-24"},"children":[{"tag":"span","props":{},"children":["24"]},"Người hút thuốc nặng chụp CT ngực liều thấp mỗi năm một lần"]},{"tag":"a","props":{"href":"/vi/tip/01-25"},"children":[{"tag":"span","props":{},"children":["25"]},"Bị trầm cảm hoặc có ý nghĩ tự sát thì bấm 12356, trong nhà không tích trữ thuốc ngủ và thuốc trừ sâu"]},{"tag":"a","props":{"href":"/vi/tip/01-26"},"children":[{"tag":"span","props":{},"children":["26"]},"Chuẩn bị bình chữa cháy, chăn chữa cháy, mặt nạ thở để chạy thoát và túi sơ cứu, kiểm tra mỗi năm một lần"]},{"tag":"a","props":{"href":"/vi/tip/01-27"},"children":[{"tag":"span","props":{},"children":["27"]},"Trong nước tiểu có máu nhìn thấy bằng mắt, dù không đau, dù ngày mai đã sạch, vẫn phải khám một lần"]},{"tag":"a","props":{"href":"/vi/tip/01-28"},"children":[{"tag":"span","props":{},"children":["28"]},"Chức năng cương có vấn đề, đi khám tim mạch trước, đừng coi đó chỉ là chuyện ấy"]},{"tag":"a","props":{"href":"/vi/tip/01-29"},"children":[{"tag":"span","props":{},"children":["29"]},"Giảm cân, cai thuốc lá, kiểm soát huyết áp và đường huyết thì chức năng cương tốt lên theo"]},{"tag":"a","props":{"href":"/vi/tip/01-30"},"children":[{"tag":"span","props":{},"children":["30"]},"Dùng bao cao su suốt quá trình quan hệ tình dục, không dùng chung kim tiêm với người khác"]},{"tag":"a","props":{"href":"/vi/tip/01-31"},"children":[{"tag":"span","props":{},"children":["31"]},"Đã từng có hành vi nguy cơ cao thì đi xét HIV/AIDS một lần, trung tâm kiểm soát bệnh miễn phí, kết quả được giữ kín"]},{"tag":"a","props":{"href":"/vi/tip/01-32"},"children":[{"tag":"span","props":{},"children":["32"]},"Ý nghĩ tự sát vừa nảy lên thì kể ngay một người bên cạnh, giao mấy chút phút ấy ra"]},{"tag":"a","props":{"href":"/vi/tip/01-33"},"children":[{"tag":"span","props":{},"children":["33"]},"Đừng coi「cứu được」là chốt chặn cuối cùng: uống thuốc trừ sâu hay hít khí than, cấp cứu giữ được mạng nhưng không giữ được phổi và não"]},{"tag":"a","props":{"href":"/vi/tip/01-34"},"children":[{"tag":"span","props":{},"children":["34"]},"Đừng cược vào chuyện「nằm vài ngày là khỏe」khi ngã từ trên cao: phần lớn người vào ICU chấn thương vẫn sống, cái giá thì tính theo năm"]},{"tag":"a","props":{"href":"/vi/tip/01-35"},"children":[{"tag":"span","props":{},"children":["35"]},"Đừng đổi tiền lấy chuyện「thiếu một quả thận cũng không sao」: quả còn lại phải làm việc thay hai quả, người bán thận sau đó có 86% nói sức khoẻ xấu đi"]},{"tag":"a","props":{"href":"/vi/tip/01-36"},"children":[{"tag":"span","props":{},"children":["36"]},"Không nhặt, không tháo, không bán phần kim loại không rõ lai lịch, thấy ký hiệu cỏ ba lá thì tránh xa"]},{"tag":"a","props":{"href":"/vi/tip/01-37"},"children":[{"tag":"span","props":{},"children":["37"]},"Cờ bạc tới mức vay tiền còn cờ, tâm trạng lúc nào cũng tụt thì gọi 12356, rồi giao thẻ ngân hàng và mật khẩu thanh toán cho người nhà giữ"]},{"tag":"a","props":{"href":"/vi/tip/01-38"},"children":[{"tag":"span","props":{},"children":["38"]},"Nam giới có quan hệ tình dục với nam và có hành vi nguy cơ cao: đi bệnh viện AIDS được chỉ định hỏi thuốc phòng trước phơi nhiễm, uống đúng giờ thì giảm hơn bảy phần mười số ca nhiễm"]},{"tag":"a","props":{"href":"/vi/tip/01-39"},"children":[{"tag":"span","props":{},"children":["39"]},"Phụ nữ từ 65 tuổi nên làm một lần xét mật độ xương bằng X-quang năng lượng kép, phụ nữ sau mãn kinh có yếu tố nguy cơ loãng xương thì không cần đợi tới 65 tuổi"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/vi/tip/01-40","data-status":"active"},"children":[{"tag":"span","props":{},"children":["40"]},"Xét ra loãng xương, hoặc đã từng gãy xương chỉ vì ngã nhẹ, thì xin bác sĩ kê thuốc chống loãng xương và dùng đều, đừng thay bằng bổ sung canxi"]},{"tag":"a","props":{"href":"/vi/tip/01-41"},"children":[{"tag":"span","props":{},"children":["41"]},"Lên băng ngoài trời thì khoan lỗ đo độ dày trước, dưới 15 xentimét thì đừng lên, đừng tới chỗ băng trên sông và quanh hố đào giấu"]},{"tag":"a","props":{"href":"/vi/tip/01-42"},"children":[{"tag":"span","props":{},"children":["42"]},"Lắp chắn bảo vệ, đeo kính bảo hộ cùng tấm che mặt rồi mới dùng máy mài góc; giữ chắc bằng hai tay, đừng lắp lưỡi cưa gỗ để cắt gỗ"]},{"tag":"a","props":{"href":"/vi/tip/01-43"},"children":[{"tag":"span","props":{},"children":["43"]},"Hỏi thẳng người bên cạnh có tâm trạng bất thường: «Bạn có nghĩ đến tự sát không?». Hỏi không làm họ muốn tự sát hơn"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"Breadcrumbs"},"children":[{"tag":"a","props":{"href":"/vi/book"},"children":["Khám phá cuốn sách"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/vi/book/01"},"children":["Chương 1"," ·"," ","Đừng chết sớm"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"01-40"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["40"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["Bằng chứng"," ","A"]}]},{"tag":"h1","props":{"lang":"vi"},"children":["Xét ra loãng xương, hoặc đã từng gãy xương chỉ vì ngã nhẹ, thì xin bác sĩ kê thuốc chống loãng xương và dùng đều, đừng thay bằng bổ sung canxi"]},{"tag":"p","props":{"lang":"vi","className":"life-entry-summary"},"children":["Người đã xác định loãng xương, hoặc đã từng gãy xương chỉ vì ngã nhẹ, dùng thuốc theo phác đồ của bác sĩ thì gãy xương hông giảm được khoảng một nửa, gãy xương sống giảm hơn một nửa. Người cao tuổi sau khi mổ gãy xương hông mà bắt đầu tiêm thuốc mỗi năm một lần thì trong hai năm gãy xương lại giảm khoảng ba phần mười lăm. Chỉ bổ sung canxi không thay thế được mấy loại thuốc đó."]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Chi phí"]},{"tag":"p","props":{},"children":["Cần đơn thuốc, dùng liên tục mấy năm. Loại thường dùng có…"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Lợi ích"]},{"tag":"p","props":{},"children":["Gãy xương giòn là kiểu gãy xương xảy ra khi chỉ chịu chấn thương nhẹ hoặc trong sinh hoạt thường ngày. Hướng d…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"Đánh dấu: Xét ra loãng xương, hoặc đã từng gãy xương chỉ vì ngã nhẹ, thì xin bác sĩ kê thuốc chống loãng xương và dùng đều, đừng thay bằng bổ sung canxi"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"Hoàn tất"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"Kế hoạch thực hiện"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"Lưu"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Chia sẻ mẹo này"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Ẩn chi tiết"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Chi phí"]},{"tag":"p","props":{},"children":["Cần đơn thuốc, dùng liên tục mấy năm. Loại thường dùng có thuốc uống mỗi tuần một lần, cũng có thuốc tiêm truyền mỗi năm một lần. Mới bắt đầu dùng thuốc thì mỗi năm xét lại mật độ xương, ổn định rồi thì 1 đến 2 năm xét một lần. Chỗ khó là không có triệu chứng vẫn phải dùng đều."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Lợi ích"]},{"tag":"p","props":{},"children":["Gãy xương giòn là kiểu gãy xương xảy ra khi chỉ chịu chấn thương nhẹ hoặc trong sinh hoạt thường ngày. Hướng dẫn bản 2017 của Hiệp hội Y khoa Trung Quốc chia người phải dùng thuốc thành ba nhóm. Một là người từng gãy xương giòn ở cột sống hoặc hông. Hai là người có chỉ số T của mật độ xương từ -2.5 trở xuống, có gãy xương hay không cũng vậy. Ba là người khối lượng xương thấp mà từng gãy xương giòn ở cổ tay, xương cánh tay hoặc khung chậu, hoặc người tính ra nguy cơ gãy xương cao. Hướng dẫn còn viết「目前尚无充分证据表明单纯补钙可以替代其他抗骨质疏松药物治疗」— hiện chưa có đủ bằng chứng cho thấy chỉ bổ sung canxi có thể thay thế các thuốc chống loãng xương khác. Năm 2025 Cochrane cập nhật tổng quan về natri alendronat. Ở phụ nữ sau mãn kinh đã có loãng xương hoặc đã gãy xương, nhóm dùng thuốc gãy xương hông thấp hơn khoảng 51%. Giá trị gốc RR 0.49, khoảng tin cậy 95% CI 0.25 đến 0.96. Gãy xương sống có triệu chứng thấp hơn khoảng 55%（RR 0.45, 95% CI 0.28 đến 0.73）. Thử nghiệm HORIZON chọn 2127 người đã mổ gãy xương hông, tuổi trung bình 74.5. Bắt đầu truyền acid zoledronic mỗi năm một lần trong vòng 90 ngày sau mổ, thời gian theo dõi trung vị là 1.9 năm. Gãy xương mới giảm từ 13.9% xuống 8.6%, giảm khoảng 35%. Tử vong giảm từ 13.3% xuống 9.6%, giảm khoảng 28%. Hướng dẫn viết, khoảng 20% người chết vì các biến chứng khác nhau trong vòng một năm sau gãy xương hông. Trong khảo sát toàn quốc 2017 đến 2018, phụ nữ đã xác định loãng xương hoặc đã gãy xương chỉ có 1.4% dùng thuốc, nam giới chỉ có 0.3%（Trung Quốc）"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Nguồn gốc"]},{"tag":"p","props":{"className":"life-citations"},"children":["中华医学会骨质疏松和骨矿盐疾病分会 (2017). 原发性骨质疏松症诊疗指南(2017). 中华骨质疏松和骨矿盐疾病杂志, 10(5), 413-443（表 10 抗骨质疏松症药物治疗适应证；钙剂一节；疗效监测一节）. ",{"tag":"a","props":{"href":"https://html.rhhz.net/GUSS/html/cc825127-29a3-47c1-9a95-7a212fdcce55.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://html.rhhz.net/GUSS/html/cc825127-29a3-47c1-9a95-7a212fdcce55.htm"]}," ; Wells GA, Hsieh SC, Peterson J, et al. (2025). Alendronate for the primary and secondary prevention of osteoporotic fractures in postmenopausal women. Cochrane Database of Systematic Reviews. ",{"tag":"a","props":{"href":"https://doi.org/10.1002/14651858.CD001155.pub3","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1002/14651858.CD001155.pub3"]}," ; Lyles KW, Colón-Emeric CS, Magaziner JS, et al. (2007). Zoledronic acid and clinical fractures and mortality after hip fracture. New England Journal of Medicine. ",{"tag":"a","props":{"href":"https://doi.org/10.1056/NEJMoa074941","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1056/NEJMoa074941"]}," ; Cummings SR, Lui LY, Eastell R, Allen IE (2019). Association Between Drug Treatments for Patients With Osteoporosis and Overall Mortality Rates: A Meta-analysis. JAMA Internal Medicine. ",{"tag":"a","props":{"href":"https://doi.org/10.1001/jamainternmed.2019.2779","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1001/jamainternmed.2019.2779"]}," ; Kahwati LC, Kistler CE, Booth G, et al. (2025). Screening for Osteoporosis to Prevent Fractures: A Systematic Evidence Review for the US Preventive Services Task Force. JAMA. ",{"tag":"a","props":{"href":"https://doi.org/10.1001/jama.2024.21653","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1001/jama.2024.21653"]}," ; Wang L, Yu W, Yin X, et al. (2021). Prevalence of Osteoporosis and Fracture in China: The China Osteoporosis Prevalence Study. JAMA Network Open. ",{"tag":"a","props":{"href":"https://doi.org/10.1001/jamanetworkopen.2021.21106","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1001/jamanetworkopen.2021.21106"]}]},{"tag":"a","props":{"href":"https://html.rhhz.net/GUSS/html/cc825127-29a3-47c1-9a95-7a212fdcce55.htm","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Liên kết mở nguồn"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Ghi chú sách"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["Còn tranh luận: một phân tích gộp 38 thử nghiệm không thấy các thuốc này giảm tử vong do mọi nguyên nhân (RR 0.98, 95% CI từ 0.91 đến 1.05). Xét riêng axit zoledronic, kết quả cũng không có ý nghĩa thống kê (RR 0.88, 95% CI từ 0.68 đến 1.13). Các tác giả kết luận rằng chỉ nên dùng các thuốc này để giảm gãy xương. Độ chắc chắn của các số liệu Cochrane cũng được xếp từ thấp đến trung bình. Ở phụ nữ chưa từng gãy xương và có nguy cơ gãy xương thấp, natri alendronat không cho thấy tác dụng rõ rệt với gãy xương hông (RR 0.76, 95% CI từ 0.43 đến 1.32). Các thử nghiệm kéo dài vài năm không thể quan sát đầy đủ những tác dụng phụ hiếm như hoại tử xương hàm và gãy xương đùi không điển hình. Vì vậy phải tái khám đúng hẹn, không tự tăng hoặc ngừng thuốc. Có người phù hợp với thuốc tiêm, có người phù hợp với thuốc uống; bác sĩ quyết định chọn loại nào. Cách phát hiện loãng xương xem mục 39 (đo mật độ xương). Liệu pháp hormone mãn kinh cũng có thể giảm gãy xương, nhưng thường chỉ cân nhắc khi không phù hợp với các thuốc khác. Dùng hormone cho bốc hỏa và đổ mồ hôi đêm, xem mục 43, phần 2 (đánh giá liệu pháp hormone khi bốc hỏa quanh thời kỳ mãn kinh). Người hưởng lợi chủ yếu là chính bạn, và cả cha mẹ bạn."]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Ghi chú của tôi"]},{"tag":"button","props":{"type":"button"},"children":["Viết một lời nhắc cho chính bạn…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/vi/tip/01-39"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Trước"]},"Phụ nữ từ 65 tuổi nên làm một lần xét mật độ xương bằng X-quang năng lượng kép, phụ nữ sau mãn kinh có yếu tố nguy cơ loãng xương thì không cần đợi tới 65 tuổi"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/vi/tip/01-41"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Tiếp theo"]},"Lên băng ngoài trời thì khoan lỗ đo độ dày trước, dưới 15 xentimét thì đừng lên, đừng tới chỗ băng trên sông và quanh hố đào giấu"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["Thêm trong chủ đề này"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/01-35"},"children":[{"tag":"strong","props":{},"children":["Đừng đổi tiền lấy chuyện「thiếu một quả thận cũng không sao」: quả còn lại phải làm việc thay hai quả, người bán thận sau đó có 86% nói sức khoẻ xấu đi"]},{"tag":"span","props":{},"children":["Người hiến thận qua sàng lọc kỹ trước và được tái khám sau khi hiến, …"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/01-36"},"children":[{"tag":"strong","props":{},"children":["Không nhặt, không tháo, không bán phần kim loại không rõ lai lịch, thấy ký hiệu cỏ ba lá thì tránh xa"]},{"tag":"span","props":{},"children":["Bức xạ không có mùi, không có màu, không có nhiệt độ. Hầu hết nguồn p…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/01-37"},"children":[{"tag":"strong","props":{},"children":["Cờ bạc tới mức vay tiền còn cờ, tâm trạng lúc nào cũng tụt thì gọi 12356, rồi giao thẻ ngân hàng và mật khẩu thanh toán cho người nhà giữ"]},{"tag":"span","props":{},"children":["Ở những người đã đi khám vì vấn đề cờ bạc, tỷ lệ chết vì tự sát gấp 1…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/01-38"},"children":[{"tag":"strong","props":{},"children":["Nam giới có quan hệ tình dục với nam và có hành vi nguy cơ cao: đi bệnh viện AIDS được chỉ định hỏi thuốc phòng trước phơi nhiễm, uống đúng giờ thì giảm hơn bảy phần mười số ca nhiễm"]},{"tag":"span","props":{},"children":["Người chưa nhiễm uống thuốc kháng virus trước, tên gọi là phòng trước…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/01-42"},"children":[{"tag":"strong","props":{},"children":["Lắp chắn bảo vệ, đeo kính bảo hộ cùng tấm che mặt rồi mới dùng máy mài góc; giữ chắc bằng hai tay, đừng lắp lưỡi cưa gỗ để cắt gỗ"]},{"tag":"span","props":{},"children":["Máy mài góc quay rất nhanh; đĩa vỡ có thể văng ra gây thương tích, cò…"]}]}]},{"