eLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-up-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M7 7h10v10"},"children":[]},{"tag":"path","props":{"d":"M7 17 17 7"},"children":[]}]}]}]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/ru/book/07"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"К содержанию"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["Как выжить, когда денег нет"]},{"tag":"div","props":{"data-ad-dock-host":"true"},"children":[]},{"tag":"nav","props":{"aria-label":"Советы главы"},"children":[{"tag":"a","props":{"href":"/ru/tip/07-01"},"children":[{"tag":"span","props":{},"children":["01"]},"Как онлайн оформить выплаты по безработице после потери работы"]},{"tag":"a","props":{"href":"/ru/tip/07-02"},"children":[{"tag":"span","props":{},"children":["02"]},"Сначала подайте жалобу в управление по труду и соцстраху, затем обратитесь в арбитраж в одну инстанцию — оба пути бесплатны, и в большинстве случаев решение принимается в течение нескольких месяцев"]},{"tag":"a","props":{"href":"/ru/tip/07-03"},"children":[{"tag":"span","props":{},"children":["03"]},"Если не можете позволить себе оплатить услуги адвоката, обратитесь за бесплатной юридической помощью — дела о невыплате зарплаты, взыскании алиментов, компенсации за травмы на производстве как раз попадают под эту категорию"]},{"tag":"a","props":{"href":"/ru/tip/07-04"},"children":[{"tag":"span","props":{},"children":["04"]},"Когда совсем некуда идти — обращайтесь в центр помощи: там обеспечат питание, жильё и билет домой"]},{"tag":"a","props":{"href":"/ru/tip/07-05"},"children":[{"tag":"span","props":{},"children":["05"]},"Для поиска работы сначала пользуйтесь бесплатными государственными службами занятости и платформами для краткосрочных подработок, не обращаясь к платным посредникам"]},{"tag":"a","props":{"href":"/ru/tip/07-06"},"children":[{"tag":"span","props":{},"children":["06"]},"В случае внезапных бедствий сначала подайте заявление на временную помощь"]},{"tag":"a","props":{"href":"/ru/tip/07-07"},"children":[{"tag":"span","props":{},"children":["07"]},"Подача заявления на дибао при доходе ниже местного порога"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/ru/tip/07-08","data-status":"active"},"children":[{"tag":"span","props":{},"children":["08"]},"Как подать заявление на получение двух видов пособий для инвалидов по наличию удостоверения инвалида"]},{"tag":"a","props":{"href":"/ru/tip/07-09"},"children":[{"tag":"span","props":{},"children":["09"]},"Не прерывайте уплату взносов в медстраховку (ибао) — ежегодно требуется минимум 400 юаней; для малоимущих предусмотрены скидки"]},{"tag":"a","props":{"href":"/ru/tip/07-10"},"children":[{"tag":"span","props":{},"children":["10"]},"При тяжелых заболеваниях сначала пользуйтесь медстраховкой (ибао), программой «Тяжелые заболевания», помощью в медицинских расходах и регистрацией в другом регионе, а от кредитов лучше воздержаться"]},{"tag":"a","props":{"href":"/ru/tip/07-11"},"children":[{"tag":"span","props":{},"children":["11"]},"Если потеряли удостоверение личности, сразу оформляйте дубликат; при срочной необходимости получите временное удостоверение"]},{"tag":"a","props":{"href":"/ru/tip/07-12"},"children":[{"tag":"span","props":{},"children":["12"]},"Получение статуса лица, испытывающего трудности в трудоустройстве после регистрации в качестве безработного, а также получение субсидий на соцстрах или доступ к общественным рабочим местам"]},{"tag":"a","props":{"href":"/ru/tip/07-13"},"children":[{"tag":"span","props":{},"children":["13"]},"Получайте субсидии на профессиональное обучение, стажировки и соцстрахование во время безработицы — не тратьте деньги на платные курсы"]},{"tag":"a","props":{"href":"/ru/tip/07-14"},"children":[{"tag":"span","props":{},"children":["14"]},"Поиск работы: не ограничивайтесь отправкой резюме, используйте системный подход — изучайте навыки, ставьте цели и просите помощи у других"]},{"tag":"a","props":{"href":"/ru/tip/07-15"},"children":[{"tag":"span","props":{},"children":["15"]},"Без залога, без удержания документов, без «обучающих кредитов», без схем пирамид, без высокопроцентных займов"]},{"tag":"a","props":{"href":"/ru/tip/07-16"},"children":[{"tag":"span","props":{},"children":["16"]},"Очередь на социальное жилье для нуждающихся"]},{"tag":"a","props":{"href":"/ru/tip/07-17"},"children":[{"tag":"span","props":{},"children":["17"]},"Сведите расходы на еду и жильё к минимуму: снимайте квартиру на месяц вместо дневной аренды, готовьте сами и пользуйтесь столовыми вместо доставки еды"]},{"tag":"a","props":{"href":"/ru/tip/07-18"},"children":[{"tag":"span","props":{},"children":["18"]},"Не паникуйте из-за перерывов в соцстрахе: пенсия считается по накопленному стажу, а медстраховка — по правилам"]},{"tag":"a","props":{"href":"/ru/tip/07-19"},"children":[{"tag":"span","props":{},"children":["19"]},"Люди, отбывшие тюремное заключение, объявившие банкротство или попавшие в список недобросовестных должников, имеют законные возможности для начала новой жизни — для этого лишь нужно выполнить все необходимые процедуры"]},{"tag":"a","props":{"href":"/ru/tip/07-20"},"children":[{"tag":"span","props":{},"children":["20"]},"Перед серьезным заболеванием стоит оформить на годовой срок медицинскую страховку или страховку от тяжелых болезней помимо базовой медстраховки, но обязательно обратите внимание на фразу «гарантированное продление»"]},{"tag":"a","props":{"href":"/ru/tip/07-21"},"children":[{"tag":"span","props":{},"children":["21"]},"Если совсем негде ночевать, круглосуточные заведения подойдут лишь на одну ночь; лучше сразу идти в приют"]},{"tag":"a","props":{"href":"/ru/tip/07-22"},"children":[{"tag":"span","props":{},"children":["22"]},"Если вам не выплатили зарплату, сначала выясните, кто вас нанимал: нелицензированные мастерские и бригадиры — всё равно в трудовую инспекцию; в суд идут только при работе у семьи или частного лица"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"Навигация"},"children":[{"tag":"a","props":{"href":"/ru/book"},"children":["Книга"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/ru/book/07"},"children":["Глава 7"," ·"," ","Как выжить, когда денег нет"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"07-08"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["08"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["Доказательства"," ","A"]}]},{"tag":"h1","props":{"lang":"ru"},"children":["Как подать заявление на получение двух видов пособий для инвалидов по наличию удостоверения инвалида"]},{"tag":"p","props":{"lang":"ru","className":"life-entry-summary"},"children":["Инвалиды, проживающие в семьях, получающих дибао, могут рассчитывать на пособие на проживание. Инвалиды первой и второй группы, которым требуется постоянный уход, могут получать дополнительное пособие на уход. Оба вида пособий можно получать одновременно. Размер выплат устанавливается в каждом регионе самостоятельно и сильно различается; уточните детали в местной администрации. Для оформления достаточно предъявить удостоверение инвалида нового образца."]},{"tag":"div","props":{"cla