ww.w3.org/2000/svg","width":"18","height":"18","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-up-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M7 7h10v10"},"children":[]},{"tag":"path","props":{"d":"M7 17 17 7"},"children":[]}]}]}]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/en/book/06"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"Back to index"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["Items to avoid"]},{"tag":"div","props":{"data-ad-dock-host":"true"},"children":[]},{"tag":"nav","props":{"aria-label":"Chapter entries"},"children":[{"tag":"a","props":{"href":"/en/tip/06-01"},"children":[{"tag":"span","props":{},"children":["01"]},"Don’t take multivitamins for longevity or heart protection"]},{"tag":"a","props":{"href":"/en/tip/06-02"},"children":[{"tag":"span","props":{},"children":["02"]},"Don’t take regular fish oil capsules to prevent heart disease"]},{"tag":"a","props":{"href":"/en/tip/06-03"},"children":[{"tag":"span","props":{},"children":["03"]},"Don’t give vitamin D supplements to people who already have enough"]},{"tag":"a","props":{"href":"/en/tip/06-04"},"children":[{"tag":"span","props":{},"children":["04"]},"Don’t take antioxidant supplements to prevent cancer (beta-carotene, vitamin E, vitamin A)"]},{"tag":"a","props":{"href":"/en/tip/06-05"},"children":[{"tag":"span","props":{},"children":["05"]},"Don’t expect glucosamine/chondroitin to treat knee osteoarthritis"]},{"tag":"a","props":{"href":"/en/tip/06-06"},"children":[{"tag":"span","props":{},"children":["06"]},"Don’t rely on vitamin C to prevent colds"]},{"tag":"a","props":{"href":"/en/tip/06-07"},"children":[{"tag":"span","props":{},"children":["07"]},"Don’t get a whole-body PET-CT or tumor marker panel if you have no symptoms"]},{"tag":"a","props":{"href":"/en/tip/06-08"},"children":[{"tag":"span","props":{},"children":["08"]},"Don’t expect fitness trackers or smartwatches to help you lose weight"]},{"tag":"a","props":{"href":"/en/tip/06-09"},"children":[{"tag":"span","props":{},"children":["09"]},"Don’t pay a premium for organic food just to be “healthier”"]},{"tag":"a","props":{"href":"/en/tip/06-10"},"children":[{"tag":"span","props":{},"children":["10"]},"Don’t spend a lot of money on health supplements, herbal formulas, or tonics to “improve your health”"]},{"tag":"a","props":{"href":"/en/tip/06-11"},"children":[{"tag":"span","props":{},"children":["11"]},"Don’t take probiotics long-term if you have no gut problems"]},{"tag":"a","props":{"href":"/en/tip/06-12"},"children":[{"tag":"span","props":{},"children":["12"]},"Don’t force yourself to take cold showers just to “boost immunity”"]},{"tag":"a","props":{"href":"/en/tip/06-13"},"children":[{"tag":"span","props":{},"children":["13"]},"Don’t buy products marketed for detox, colon cleansing, enzymes, or alkaline water"]},{"tag":"a","props":{"href":"/en/tip/06-14"},"children":[{"tag":"span","props":{},"children":["14"]},"Don’t force yourself to drink water just to hit “8 glasses a day”"]},{"tag":"a","props":{"href":"/en/tip/06-15"},"children":[{"tag":"span","props":{},"children":["15"]},"Don’t spend money on fortune‑telling, tarot, or astrology to make decisions"]},{"tag":"a","props":{"href":"/en/tip/06-16"},"children":[{"tag":"span","props":{},"children":["16"]},"Don’t buy blue-light-blocking glasses to “protect your vision,” and don’t believe claims that staring at screens for months will ruin your eyes — but severe eye pain, redness, and swelling require immediate medical attention"]},{"tag":"a","props":{"href":"/en/tip/06-17"},"children":[{"tag":"span","props":{},"children":["17"]},"Don’t treat blood donation as a health habit: claims that it “detoxifies, lowers cholesterol, and prevents heart attacks” lack randomized trial support, while frequent donation truly causes iron deficiency"]},{"tag":"a","props":{"href":"/en/tip/06-18"},"children":[{"tag":"span","props":{},"children":["18"]},"Don’t rely on generic health check packages to prevent disease; instead, get the evidence‑based screenings appropriate for your age and gender"]},{"tag":"a","props":{"href":"/en/tip/06-19"},"children":[{"tag":"span","props":{},"children":["19"]},"Don’t start taking uric‑acid‑lowering drugs just because a checkup shows high uric acid but you’ve never had symptoms"]},{"tag":"a","props":{"href":"/en/tip/06-20"},"children":[{"tag":"span","props":{},"children":["20"]},"Don’t have a gallbladder removed prophylactically just because an ultrasound found gallstones but you’ve never felt any pain"]},{"tag":"a","props":{"href":"/en/tip/06-21"},"children":[{"tag":"span","props":{},"children":["21"]},"Don’t cut calcium out to prevent kidney stones"]},{"tag":"a","props":{"href":"/en/tip/06-22"},"children":[{"tag":"span","props":{},"children":["22"]},"Don’t buy crystals, bracelets, or Pixiu figurines for “good luck,” “wealth attraction,” or “health benefits”"]},{"tag":"a","props":{"href":"/en/tip/06-23"},"children":[{"tag":"span","props":{},"children":["23"]},"Don’t expect shopping to lift your mood or boost your sense of self-worth"]},{"tag":"a","props":{"href":"/en/tip/06-24"},"children":[{"tag":"span","props":{},"children":["24"]},"Don’t spend extra money to “move up a rung” among your peers by buying a new house, car, or social circle"]},{"tag":"a","props":{"href":"/en/tip/06-25"},"children":[{"tag":"span","props":{},"children":["25"]},"Don’t believe that “willpower is like a muscle that runs out after use”"]},{"tag":"a","props":{"href":"/en/tip/06-26"},"children":[{"tag":"span","props":{},"children":["26"]},"Don’t expect skipping breakfast or the 16:8 intermittent fasting method to help you control your weight; instead, pick a meal timing you can stick to long-term"]},{"tag":"a","props":{"href":"/en/tip/06-27"},"children":[{"tag":"span","props":{},"children":["27"]},"Do not believe that \"masturbation harms the body\" or that \"abstinence is the only way to improve\"; what truly matters is whether it interferes with your sleep, work, and relationships"]},{"tag":"a","props":{"href":"/en/tip/06-28"},"children":[{"tag":"span","props":{},"children":["28"]},"Do not spend money on \"conversion therapy\" or \"gay علاج,\" and do not send your family members to undergo it either"]},{"tag":"a","props":{"href":"/en/tip/06-29"},"children":[{"tag":"span","props":{},"children":["29"]},"Do not expect “correct lifting posture” or lifting training to prevent back pain; reduce the weight and number of lifts, and exercise regularly"]},{"tag":"a","props":{"href":"/en/tip/06-30"},"children":[{"tag":"span","props":{},"children":["30"]},"Do not expect extra calcium or bone broth to make a fracture heal faster"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/en/tip/06-31","data-status":"active"},"children":[{"tag":"span","props":{},"children":["31"]},"Don’t rely on an AI chatbot alone to judge a medical or legal problem; before seeing a doctor, going to court or spending big money, find the source it cites and check it against the original"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"Breadcrumb"},"children":[{"tag":"a","props":{"href":"/en/book"},"children":["Explore the book"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/en/book/06"},"children":["Chapter 6"," ·"," ","Items to avoid"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"06-31"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["31"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["Evidence"," ","A"]}]},{"tag":"h1","props":{"lang":"en"},"children":["Don’t rely on an AI chatbot alone to judge a medical or legal problem; before seeing a doctor, going to court or spending big money, find the source it cites and check it against the original"]},{"tag":"p","props":{"lang":"en","className":"life-entry-summary"},"children":["Hand a complete case to an AI and it names the right condition nine times out of ten or more. But ordinary people who ask it about symptoms identify the condition less often than people who just searched online, and are no better at judging whether to go to the emergency room. On legal questions, general-purpose AI makes things up in at least 58% of its answers, and will go along with a wrong premise in your question."]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Cost"]},{"tag":"p","props":{},"children":["Free. Each check costs a few minutes to half an hour. Ask…"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Benefit"]},{"tag":"p","props":{},"children":["Start with medicine. In 2026 Nature Medicine published a randomized, preregistered trial of 1298 ordinary peop…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"Mark: Don’t rely on an AI chatbot alone to judge a medical or legal problem; before seeing a doctor, going to court or spending big money, find the source it cites and check it against the original"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"Done"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"Plan to do"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"Save"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Share this tip"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Hide details"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Cost"]},{"tag":"p","props":{},"children":["Free. Each check costs a few minutes to half an hour. Ask the AI to write out the statute, guideline or paper it is relying on, then open the original yourself and find that sentence. The habit to change is acting on something just because it sounds sure."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Benefit"]},{"tag":"p","props":{},"children":["Start with medicine. In 2026 Nature Medicine published a randomized, preregistered trial of 1298 ordinary people in the UK. Each person got two made-up cases and had to decide what the condition was and whether to go to the emergency room or watch at home. Some used an AI chatbot (GPT-4o, Llama 3 or Command R+). The control group used their usual methods, mostly web searches or the UK National Health Service (NHS) website. When the complete case was fed straight to the AI, it identified a relevant condition in 94.9% of runs and judged the right place to go in 56.3%. Ordinary people using the same AIs identified a relevant condition in under 34.5% and chose the right place to go in under 44.2%. The control group was 1.76 times as likely to identify a relevant condition as the AI users (95% CI 1.45–2.13, the plausible range), and 1.57 times as likely to identify a dangerous, red-flag illness (1.28–1.92). On choosing where to go, the two sides were about equal. The authors read through the chat logs and found problems at both ends: users did not give the full symptoms, and sometimes the AI named the right condition but users did not act on it. Now the law. In 2024 a US research team asked ChatGPT 4 and other public models about US federal court cases. ChatGPT 4 fabricated content in 58% of its answers, and Llama 2 in as many as 88%. Fabrication means content that does not match legal fact; the paper calls it “hallucination”. The models cannot tell which of their own sentences are made up. When a question carries a wrong legal premise, they often accept it as it stands. The same team tested professional legal-AI tools sold to lawyers in 2025. The tools claim not to make things up, yet 17% to 33% of their answers contained fabrications. It looks worthwhile because AI is on call, costs nothing, and speaks as confidently as a doctor or lawyer."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Original sources"]},{"tag":"p","props":{"className":"life-citations"},"children":["Bean AM, Payne RE, Parsons G, et al. (2026). Reliability of LLMs as medical assistants for the general public: a randomized preregistered study. Nature Medicine, 32(2), 609–615. ",{"tag":"a","props":{"href":"https://doi.org/10.1038/s41591-025-04074-y","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1038/s41591-025-04074-y"]},"；Dahl M, Magesh V, Suzgun M, Ho DE (2024). Large Legal Fictions: Profiling Legal Hallucinations in Large Language Models. Journal of Legal Analysis, 16(1), 64–93. ",{"tag":"a","props":{"href":"https://doi.org/10.1093/jla/laae003","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1093/jla/laae003"]},"；Magesh V, Surani F, Dahl M, Suzgun M, Manning CD, Ho DE (2025). Hallucination-Free? Assessing the Reliability of Leading AI Legal Research Tools. Journal of Empirical Legal Studies, 22(2), 216–242. ",{"tag":"a","props":{"href":"https://doi.org/10.1111/jels.12413","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1111/jels.12413"]},"；Kalai AT, Nachum O, Vempala SS, Zhang E (2025). Why Language Models Hallucinate. arXiv:2509.04664（预印本，备注里那项）. ",{"tag":"a","props":{"href":"https://arxiv.org/abs/2509.04664","target":"_blank","rel":"noopener noreferrer"},"children":["https://arxiv.org/abs/2509.04664"]},"；反方：Ayers JW, Poliak A, Dredze M, et al. (2023). Comparing Physician and Artificial Intelligence Chatbot Responses to Patient Questions Posted to a Public Social Media Forum. JAMA Internal Medicine, 183(6), 589. ",{"tag":"a","props":{"href":"https://doi.org/10.1001/jamainternmed.2023.1838","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1001/jamainternmed.2023.1838"]}]},{"tag":"a","props":{"href":"https://doi.org/10.1038/s41591-025-04074-y","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Open source link"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Book note"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["Controversy. A 2023 study sampled 195 patient questions from a US forum, and healthcare professionals scored the answers without seeing who wrote them. In 78.6% of ratings, ChatGPT’s answer was judged better than the doctor’s. But that compared how well the answers were written; it did not check whether the person asking ended up judging correctly. The trial above used 2024-era models, and newer models may be stronger. Still, the same trial also found that an AI’s exam score on its own did not predict how well ordinary people did with it. As for why AI makes things up, OpenAI researchers explained in a 2025 paper that has not been peer reviewed: the way models are trained and scored rewards guessing an answer, and saying “I don’t know” earns no points, so they sound sure even when they are not. To check: ask it to write out the name and article number of the statute, or the title of the guideline or paper, open the original on an official website and find that sentence; if you cannot find it, treat it as never said. When you ask, don’t put your own conclusion into the question: ask “how does the law treat this situation”, not “am I sure to win in this situation”. If the signs are a sudden drooping mouth, weakness on one side or pressure in the chest, don’t ask the AI first; call 120 straight away, see Section 13, Item 3 (drooping mouth, weak arm on one side) and Section 13, Item 7 (pressure in the chest). If you cannot afford a lawyer for a lawsuit, see Section 7, Item 3 (applying for legal aid). The benefit is rated small, because there are only intermediate measures such as whether a condition was identified, and no figure for fewer deaths. The beneficiary is you and your family."]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["My note"]},{"tag":"button","props":{"type":"button"},"children":["Write a reminder for yourself…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/en/tip/06-30"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Previous"]},"Do not expect extra calcium or bone broth to make a fracture heal faster"]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["More in this topic"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/en/tip/06-24"},"children":[{"tag":"strong","props":{},"children":["Don’t spend extra money to “move up a rung” among your peers by buying a new house, car, or social circle"]},{"tag":"span","props":{},"children":["When comparing people with similar incomes, those whose neighbors ear…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/en/tip/06-25"},"children":[{"tag":"strong","p