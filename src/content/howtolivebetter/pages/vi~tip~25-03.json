,"props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Chia sẻ mẹo này"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Ẩn chi tiết"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Chi phí"]},{"tag":"p","props":{},"children":["Không tốn tiền."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Lợi ích"]},{"tag":"p","props":{},"children":["Điều hai mươi lăm của《Quy chế quản lý tang chế》ghi:「遗体接运、存放、防腐、整容、火化服务，由殡仪馆专门负责提供」. Mấy việc này nơi khác không làm được. Điều hai mươi tư:「医疗卫生机构的太平间不得外包，不得开展殡仪服务，可以为遗体暂时停放提供便利服务」. Kho lưu thi thể bệnh viện chỉ đặt tạm, không lo việc tang. Điều hai mươi bảy:「殡仪馆存放遗体一般不超过 3 日，需要延期存放的，丧属或者遗体移交方应当在殡仪馆办理延期存放手续」. Muốn giữ thêm vài ngày thì ra nhà tang lễ làm thủ tục gia hạn. Điều hai mươi tám:「殡仪馆应当凭死亡证明和火化确认书火化遗体，并出具火化证明」. Thiếu một trong hai giấy là không thiêu được, thiêu xong bạn được một tờ giấy chứng minh thiêu. Điều hai mươi chín:「在实行火葬的地区，遗体应当就地、就近在殡仪馆火化」, phải tìm nhà tang lễ gần nơi người đó mất để thiêu"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Nguồn gốc"]},{"tag":"p","props":{"className":"life-citations"},"children":["国务院 (2026). 殡葬管理条例（国务院令第 824 号，自 2026 年 3 月 30 日起施行，第八、九、二十四、二十五、二十七、二十八、二十九条）. ",{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/202601/content_7054169.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/zhengce/zhengceku/202601/content_7054169.htm"]}]},{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/202601/content_7054169.htm","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Liên kết mở nguồn"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Ghi chú sách"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["Bọn「trọn gói」Ghé tới sau khi người mất ở bệnh viện thì phần lớn không phải người của nhà tang lễ. Bản thân việc vận chuyển thuộc mục cơ sở, có giá niêm yết, xem mục 6 (bảng giá mục cơ sở). Giấy chứng minh thiêu cất giữ kỹ, làm thừa kế, bảo hiểm, di dời tro cốt đều cần. Ở địa phương thiêu hay chôn đất do chính quyền cấp tỉnh quy định. Phong tục tang chế của dân tộc thiểu số được bảo vệ theo Điều chín của quy chế. Ai đáng hoả thiêu lại chôn đất, hoặc chôn, đắp mộ ngoài nghĩa trang và khu vực an táng sinh thái, thì cơ quan dân vụ sẽ yêu cầu sửa lại trong thời hạn (sửa lại cho đúng trong hạn)."]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Ghi chú của tôi"]},{"tag":"button","props":{"type":"button"},"children":["Viết một lời nhắc cho chính bạn…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/vi/tip/25-02"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Trước"]},"Giấy chứng minh tử vong là chìa khoá cho mọi việc phía sau: ai cứu chữa thì người đó cấp, tử vong bình thường tại nhà thì tìm cơ sở y tế cộng đồng, ký trong một ngày"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/vi/tip/25-04"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Tiếp theo"]},"Bất đồng về nguyên nhân tử vong thì trong 48 giờ phải yêu cầu mổ xác, đồng thời niêm phong hồ sơ bệnh án"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["Thêm trong chủ đề này"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/25-01"},"children":[{"tag":"strong","props":{},"children":["Người mất ở nhà hay ngoài đời, trước hết phân biệt tử vong bình thường với tử vong bất thường: tai nạn, chết không rõ nguyên nhân, người sống một mình lâu ngày mới bị phát hiện thì báo công an ngay, thi thể và hiện trường đừng đụng vào"]},{"tag":"span","props":{},"children":["Chết do tai nạn, không rõ vì sao chết, sống một mình lâu ngày mới đượ…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/25-05"},"children":[{"tag":"strong","props":{},"children":["Ở Trung Quốc, xóa hộ khẩu cho người đã mất có thời hạn luật định: thành thị trước khi an táng, nông thôn trong một tháng"]},{"tag":"span","props":{},"children":["Ở thành phố phải huỷ hộ khẩu trước khi an táng, ở nông thôn thì trong…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/25-06"},"children":[{"tag":"strong","props":{},"children":["Dịch vụ tang chế chia thành mục cơ sở và mục ngoài cơ sở, mục cơ sở có bảng giá, mức thu do pháp luật quy định"]},{"tag":"span","props":{},"children":["Vận chuyển thi thể, lưu giữ, lễ khí chung, thiêu, gửi tro cốt, an tán…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/25-07"},"children":[{"tag":"strong","props":{},"children":["Gặp ép mua kèm, thêm tiền ngoài giá niêm yết, tách một dịch vụ thành mấy dịch vụ để thu tiền thì ghi lại và khiếu nại"]},{"tag":"span","props":{},"children":["Mấy việc sau đều là hành vi vi phạm giá mà quy chế nêu đích danh: khô…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/25-08"},"children":[{"tag":"strong","props":{},"children":["Môi giới tang chế, môi giới mua tang phẩm, tổ chức và dẫn dắt tang sự phải đăng ký với cơ quan dân vụ cấp huyện"]},{"tag":"span","props"