:"/ja/book/29"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"目次に戻る"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["重大な打撃を受けた後"]},{"tag":"div","props":{"data-ad-dock-host":"true"},"children":[]},{"tag":"nav","props":{"aria-label":"この章のヒント"},"children":[{"tag":"a","props":{"href":"/ja/tip/29-01"},"children":[{"tag":"span","props":{},"children":["01"]},"大切な人を亡くした直後の数日間は一人で過ごさないこと。心臓病、高血圧、糖尿病がある人は通常通り服薬を。胸に圧迫感や痛みを感じたら 120 に連絡してください"]},{"tag":"a","props":{"href":"/ja/tip/29-02"},"children":[{"tag":"span","props":{},"children":["02"]},"重大な病の診断を受けたその一週間は、一人で診断結果を受け取りに行かないこと。治療以外の決定は後回しにする"]},{"tag":"a","props":{"href":"/ja/tip/29-03"},"children":[{"tag":"span","props":{},"children":["03"]},"失業後は、まず生活リズム、医療保険、そして求職活動のペースを固定すること。一日中家に閉じこもらないこと"]},{"tag":"a","props":{"href":"/ja/tip/29-04"},"children":[{"tag":"span","props":{},"children":["04"]},"親族が自殺、事故、または事件で亡くなった場合、一人で耐えようとせず、積極的に専門的な助けを求めてください"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/ja/tip/29-05","data-status":"active"},"children":[{"tag":"span","props":{},"children":["05"]},"配偶者を亡くした後の最初の半年間は、三食、睡眠、持病の薬、そして再検査の管理を、特定の誰かに任せて見守ってもらう"]},{"tag":"a","props":{"href":"/ja/tip/29-06"},"children":[{"tag":"span","props":{},"children":["06"]},"親族も友人もいない場合は、「あなたを見守る存在」を3つのものに置き換えてください：自宅に入れる近隣住民、地域の訪問リスト、スマートフォンの緊急連絡先"]},{"tag":"a","props":{"href":"/ja/tip/29-07"},"children":[{"tag":"span","props":{},"children":["07"]},"親が亡くなった後、ありのままを伝え、お別れに立ち会わせ、環境を変えるために他の場所へ送らないこと"]},{"tag":"a","props":{"href":"/ja/tip/29-08"},"children":[{"tag":"span","props":{},"children":["08"]},"悲しみから半年経っても立ち直れず、日常生活が送れない場合は、精神科または臨床心理科を受診してください"]},{"tag":"a","props":{"href":"/ja/tip/29-09"},"children":[{"tag":"span","props":{},"children":["09"]},"いきなり悲嘆カウンセリングにお金を使う前に、自分の悲しみが本当に「停滞」しているかを確認しましょう（第 8 条の症状など）"]},{"tag":"a","props":{"href":"/ja/tip/29-10"},"children":[{"tag":"span","props":{},"children":["10"]},"別居・離婚後は健康保険を途切れさせない、お酒で紛らわさない"]},{"tag":"a","props":{"href":"/ja/tip/29-11"},"children":[{"tag":"span","props":{},"children":["11"]},"話し相手が必要な時は 12356 へ、未成年者・青少年は 12355 へ、医師を求めるなら心理外来へ"]},{"tag":"a","props":{"href":"/ja/tip/29-12"},"children":[{"tag":"span","props":{},"children":["12"]},"大きな変化の直後の3ヶ月間は、いかなる不可逆的な重大決定も、すべて後回しにする"]},{"tag":"a","props":{"href":"/ja/tip/29-13"},"children":[{"tag":"span","props":{},"children":["13"]},"死を借金返済の手段と考えてはいけない：2年以内の生命保険は不払い、労災も不認定、債務は変わらず遺産から差し押さえられる"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"現在地"},"children":[{"tag":"a","props":{"href":"/ja/book"},"children":["本を読む"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/ja/book/29"},"children":["第29章"," ·"," ","重大な打撃を受けた後"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"29-05"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["05"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["エビデンス"," ","A"]}]},{"tag":"h1","props":{"lang":"ja"},"children":["配偶者を亡くした後の最初の半年間は、三食、睡眠、持病の薬、そして再検査の管理を、特定の誰かに任せて見守ってもらう"]},{"tag":"p","props":{"lang":"ja","className":"life-entry-summary"},"children":["配偶者亡き後半年未満の時期は、同時期に死亡する確率が、配偶者を亡くしていない人よりも約4割高いです。半年を過ぎると、その差は約1.5割にまで下がります。男性は約2.3割高く、女性の数値は、単なる偶然と言えるほど低い場合があります。この差は「前向きに考えよう」といった精神論だけで乗り越えられるものではありません。すべきことは、薬、食事、再検査の管理を具体的な誰かに委ねることです。自分の記憶力に頼らないでください。"]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["費用・手間"]},{"tag":"p","props":{},"children":["費用はかかりません。子供、兄弟姉妹、あるいは友人など、具体的な誰か一人を見つけ、定期的に訪問してもらうか、電話をかけ…"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["効果"]},{"tag":"p","props":{},"children":["15件の前向きコホート研究、および2,263,888人を統合した結果。配偶者との死別後6ヶ月未満の死亡RRは1.41（95% CI 1.26–1.57）であり、同時期の死亡確率は未配偶者と比較して約4割高い。"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"記録する：配偶者を亡くした後の最初の半年間は、三食、睡眠、持病の薬、そして再検査の管理を、特定の誰かに任せて見守ってもらう"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"できている"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"やることに追加"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":