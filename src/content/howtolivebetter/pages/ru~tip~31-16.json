":{"d":"M2 12h2"},"children":[]},{"tag":"path","props":{"d":"M20 12h2"},"children":[]},{"tag":"path","props":{"d":"m6.34 17.66-1.41 1.41"},"children":[]},{"tag":"path","props":{"d":"m19.07 4.93-1.41 1.41"},"children":[]}]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"17","height":"17","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-moon life-theme-icon-dark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"},"children":[]}]}]},{"tag":"button","props":{"type":"button","className":"life-language-switch","aria-label":"Русский Выбрать язык","aria-haspopup":"menu","aria-expanded":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-globe","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]},{"tag":"path","props":{"d":"M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"},"children":[]},{"tag":"path","props":{"d":"M2 12h20"},"children":[]}]},{"tag":"span","props":{},"children":["Русский"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]}]},{"tag":"a","props":{"className":"life-account","href":"/ru/sign-in"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"17","height":"17","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle-user-round","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M18 20a6 6 0 0 0-12 0"},"children":[]},{"tag":"circle","props":{"cx":"12","cy":"10","r":"4"},"children":[]},{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},{"tag":"span","props":{},"children":["Войти"]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/ru/book/31"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"К содержанию"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["Какие пути открываются после 18 лет"]},{"tag":"nav","props":{"aria-label":"Советы главы"},"children":[{"tag":"a","props":{"href":"/ru/tip/31-01"},"children":[{"tag":"span","props":{},"children":["01"]},"Сначала сверьте требования: возрастные и образовательные критерии для двенадцати вариантов карьерного пути чётко прописаны в документах"]},{"tag":"a","props":{"href":"/ru/tip/31-02"},"children":[{"tag":"span","props":{},"children":["02"]},"Мужчины, которым исполнилось 18 лет, должны до 31 октября пройти регистрацию на военную службу; срочная служба длится два года"]},{"tag":"a","props":{"href":"/ru/tip/31-03"},"children":[{"tag":"span","props":{},"children":["03"]},"Отказ от военной службы после подачи заявления влечет серьезные ограничения на два года"]},{"tag":"a","props":{"href":"/ru/tip/31-04"},"children":[{"tag":"span","props":{},"children":["04"]},"Два главных преимущества для студентов, решивших пойти в армию: государство компенсирует до 20 000 юаней в год за обучение, сохраняет за ними право на учёбу на протяжении двух лет и предусматривает отдельную программу поступления в магистратуру"]},{"tag":"a","props":{"href":"/ru/tip/31-05"},"children":[{"tag":"span","props":{},"children":["05"]},"После увольнения с военной службы работу по распределению предоставляют лишь в шести случаях; при самостоятельном трудоустройстве необходимо явиться в органы гражданской администрации в течение 30 дней"]},{"tag":"a","props":{"href":"/ru/tip/31-06"},"children":[{"tag":"span","props":{},"children":["06"]},"Три важных показателя после увольнения: единовременная выплата, зачёт военного стажа и налоговая льгота в 20 000 юаней в год"]},{"tag":"a","props":{"href":"/ru/tip/31-07"},"children":[{"tag":"span","props":{},"children":["07"]},"Не только экзамен на госслужбу — есть и другие пути попасть в систему: после двух лет работы по программе «Три поддержки, один помощник» можно претендовать на 10% вакансий, выделенных специально для участников этой программы"]},{"tag":"a","props":{"href":"/ru/tip/31-08"},"children":[{"tag":"span","props":{},"children":["08"]},"По истечении трёхлетнего срока службы, при успешной аттестации и желании остаться работать, учителя из программы «Специальные рабочие места» должны быть незамедлительно зачислены в штат"]},{"tag":"a","props":{"href":"/ru/tip/31-09"},"children":[{"tag":"span","props":{},"children":["09"]},"Поступление на службу в пожарную охрану и в штат гражданских специалистов Вооружённых сил — ещё два пути открытого набора, причём порог входа здесь ниже, чем при сдаче государственного экзамена"]},{"tag":"a","props":{"href":"/ru/tip/31-10"},"children":[{"tag":"span","props":{},"children":["10"]},"Образование — это не разовое решение: для экзаменов по самообразованию нет ограничений по возрасту и уровню образования; поступить можно также через экзамены для взрослых или в Открытый университет"]},{"tag":"a","props":{"href":"/ru/tip/31-11"},"children":[{"tag":"span","props":{},"children":["11"]},"Отсутствие трудоустройства не означает отсутствие соцстраха: пенсионное и медицинское страхование придётся оформлять самостоятельно в месте работы, ограничения по прописке уже сняты"]},{"tag":"a","props":{"href":"/ru/tip/31-12"},"children":[{"tag":"span","props":{},"children":["12"]},"Для курьеров, водителей такси и грузоперевозчиков платформа сама оплачивает страховку от профессиональных травм за каждый выполненный заказ — вам платить не придётся"]},{"tag":"a","props":{"href":"/ru/tip/31-13"},"children":[{"tag":"span","props":{},"children":["13"]},"Два пути получения государственной должности в день подачи заявлений на поступление в вуз: бесплатное обучение для будущих учителей и для медиков, но за это придётся отработать 6 лет"]},{"tag":"a","props":{"href":"/ru/tip/31-14"},"children":[{"tag":"span","props":{},"children":["14"]},"Прежде чем ехать работать за границу, проверьте, имеет ли компания лицензию на международное трудоустройство: она не вправе требовать от вас залог"]},{"tag":"a","props":{"href":"/ru/tip/31-15"},"children":[{"tag":"span","props":{},"children":["15"]},"Работа на иностранную компанию из дома: такие доходы считаются внутренними по налоговому законодательству. Налог нужно декларировать самостоятельно, а перевод средств следует оформлять как «оплату труда сотрудника»"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/ru/tip/31-16","data-status":"active"},"children":[{"tag":"span","props":{},"children":["16"]},"Работа на себя без трудоустройства: для старта нужно сначала изучить кредиты под гарантию государства — личный лимит до 300 тысяч юаней, причём половину процентов оплачивает казна"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"Навигация"},"children":[{"tag":"a","props":{"href":"/ru/book"},"children":["Книга"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/ru/book/31"},"children":["Глава 31"," ·"," ","Какие пути открываются после 18 лет"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"31-16"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["16"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["Доказательства"," ","A"]}]},{"tag":"h1","props":{"lang":"ru"},"children":["Работа на себя без трудоустройства: для старта нужно сначала изучить кредиты под гарантию государства — личный лимит до 300 тысяч юаней, причём половину процентов оплачивает казна"]},{"tag":"p","props":{"lang":"ru","className":"life-entry-summary"},"children":["Если старт бизнеса неизбежно требует займа, стоит рассмотреть именно этот кредит с государственной субсидией. Лимит для физлиц — до 300 тысяч юаней на срок до трёх лет, причём половину процентов оплачивает государство. Однако есть важное условие, которое часто упускают из виду: на момент подачи заявки у заявителя и его супруга не должно быть других кредитов, за исключением образовательных займов, микрозаймов для вышедших из бедности граждан, ипотеки, автокредитов и потребительских займов до 50 тысяч юаней. Кроме того, важно помнить, что требуется наличие 150 человек из приоритетных групп трудоустройства, а также 250 человек из числа целевых категорий населения, соответствующих условиям программы."]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Затраты"]},{"tag":"p","props":{},"children":["Консультации бесплатны. Сначала нужно обратиться в органы…"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Польза"]},{"tag":"p","props":{},"children":["Требования к заявителям подробно описаны в статье 6 Правил управления специальными средствами для развития инк…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"Отметить: Работа на себя без трудоустройства: для старта нужно сначала изучить кредиты под гарантию государства — личный лимит до 300 тысяч юаней, причём половину процентов оплачивает казна"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"Сделано"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"В планах"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"В избранное"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Поделиться советом"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Скрыть подробности"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Затраты"]},{"tag":"p","props":{},"children":["Консультации бесплатны. Сначала нужно обратиться в органы гражданской администрации для проверки права на получение кредита, затем — в гарантийную организацию и банк-исполнитель, где и оформляется заём. Главная сложность в том, что заёмные средства всё равно придётся возвращать."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Польза"]},{"tag":"p","props":{},"children":["Требования к заявителям подробно описаны в статье 6 Правил управления специальными средствами для развития инклюзивного финансирования (финансовый документ № 75 от 2023 года). Первое условие — принадлежность к приоритетным группам трудоустройства. К ним относятся зарегистрированные безработные, люди с трудностями в трудоустройстве (включая инвалидов), ветераны, освобождённые из мест лишения свободы, выпускники вузов (включая студентов, вернувшихся из-за границы), работники предприятий, сокращающих производство, а также безработные. Кроме того, в эту группу входят возвращающиеся на родину фермеры-предприниматели, интернет-предприниматели, вышедшие из бедности граждане и сельские жители, решившие открыть бизнес. Второе условие — отсутствие других кредитов: «Кроме образовательных займов, микрозаймов для вышедших из бедности граждан, ипотеки, автокредитов и потребительских займов до 50 тысяч юаней (включая расходы по кредитным картам), на момент подачи заявки у заявителя и его супруга не должно быть других кредитов». Согласно статье 9, казна оплачивает 50% фактической процентной ставки по таким кредитам; при пролонгации или просрочке субсидия не предоставляется. Статья 10 предусматривает отмену требований по дополнительному обеспечению для займов до 100 тысяч юаней. Лимит для индивидуальных заявителей — до 300 тысяч юаней на срок до трёх лет; для партнёрских проектов он может быть увеличен до 110% от суммы лимитов каждого участника. Предельные процентные ставки зависят от региона: в восточных районах — LPR + 0,5%, в центральных и западных — LPR + 1,5%, в районах, вышедших из бедности — LPR + 2,5%. LPR — это рыночная ставка предложения банковских кредитов, а BPs — единица её измерения; чем выше этот показатель, тем выше проценты. При активном погашении займа, создании рабочих мест и успешном развитии проекта можно подавать заявку повторно, но не более трёх раз. Согласно статье 8, сначала нужно получить разрешение в местных органах гражданской администрации, затем — обратиться в гарантийную организацию и банк-исполнитель. Статья 12 позволяет регионам расширять круг получателей, повышать лимиты и увеличивать субсидии с разрешения правительства."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Первоисточники"]},{"tag":"p","props":{"className":"life-citations"},"children":["财政部 (2023). 关于印发《普惠金融发展专项资金管理办法》的通知（财金〔2023〕75 号，第六、八、九、十、十一、十二条）. ",{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/202309/content_6903691.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/zhengce/zhengceku/202309/content_6903691.htm"]}]},{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/202309/content_6903691.htm","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Открыть источник"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Примечание автора"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["Государственная субсидия на оплату половины процентов не меняет того факта, что заёмные средства всё равно нужно возвращать. В этом руководстве позиция, изложенная в пункте 1 раздела 12, остаётся неизменной: при открытии бизнеса следует использовать только те средства, которые можно позволить себе потерять, не трогая семейные накопления, не оформляя личные гарантии по корпоративным кредитам и не вовлекая в это супруга. Этот пункт лишь подчёркивает"]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Моя заметка"]},{"tag":"button","props":{"type":"button"},"children":["Запишите напоминание…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/ru/tip/31-15"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Предыдущий"]},"Работа на иностранную компанию из дома: такие доходы считаются внутренними по налоговому законодательству. Налог нужно декларировать самостоятельно, а перевод средств следует оформлять как «оплату труда сотрудника»"]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["Другие советы по этой теме"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/31-09"},"children":[{"tag":"strong","props":{},"children":["Поступление на службу в пожарную охрану и в штат гражданских специалистов Вооружённых сил — ещё два пути открытого набора, причём порог входа здесь ниже, чем при сдаче государственного экзамена"]},{"tag":"span","props":{},"children":["Для обоих направлений не требуется образование уровня не ниже среднег…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/31-10"},"children":[{"tag":"strong","props":{},"children":["Образование — это не разовое решение: для экзаменов по самообразованию нет ограничений по возрасту и уровню образования; поступить можно также через экзамены для взрослых или в Открытый университет"]},{"tag":"span","props":{},"children":["Если в восемнадцать лет вы не смогли поступить в вуз, позже остаются …"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/31-11"},"children":[{"tag":"strong","props":{},"children":["Отсутствие трудоустройства не означает отсутствие соцстраха: пенсионное и медицинское страхование придётся оформлять самостоятельно в месте работы, ограничения по прописке уже сняты"]},{"tag":"span","props":{},"children":["Отсутствие трудоустройства не означает, что соцстрахование вам не пол…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/31-12"},"children":[{"tag":"strong","props":{},"children":["Для курьеров, водителей такси и грузоперевозчиков платформа сама оплачивает страховку от профессиональных травм за каждый выполненный заказ — вам платить не придётся"]},{"tag":"span","props":{},"children":["Платформа обязана оплачивать страховку от профессиональных травм за к…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/31-13"},"children":[{"tag":"strong","props":{},"children":["Два пути получения государственной должности в день подачи заявлений на поступление в вуз: бесплатное обучение для будущих учителей и для медиков, но за это придётся отработать 6 лет"]},{"tag":"span","props":{},"children":["В обоих случаях государство сначала оплачивает обучение, а после его …"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/31-14"},"children":[{"tag":"strong","props":{},"children":["Прежде чем ехать работать за границу, проверьте, имеет ли компания л