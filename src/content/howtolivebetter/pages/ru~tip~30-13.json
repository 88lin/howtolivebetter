","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]}]},{"tag":"div","props":{"className":"life-header-tools"},"children":[{"tag":"button","props":{"type":"button","className":"life-sound-toggle","aria-label":"Выключить звуки","aria-pressed":"true","title":"Выключить звуки"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-volume2 lucide-volume-2","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M11 4.702a.705.705 0 0 0-1.203-.498L6.413 7.587A1.4 1.4 0 0 1 5.416 8H3a1 1 0 0 0-1 1v6a1 1 0 0 0 1 1h2.416a1.4 1.4 0 0 1 .997.413l3.383 3.384A.705.705 0 0 0 11 19.298z"},"children":[]},{"tag":"path","props":{"d":"M16 9a5 5 0 0 1 0 6"},"children":[]},{"tag":"path","props":{"d":"M19.364 18.364a9 9 0 0 0 0-12.728"},"children":[]}]}]},{"tag":"button","props":{"type":"button","className":"life-theme-trigger","aria-label":"Системная","aria-haspopup":"menu","aria-expanded":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"17","height":"17","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-sun life-theme-icon-light","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"4"},"children":[]},{"tag":"path","props":{"d":"M12 2v2"},"children":[]},{"tag":"path","props":{"d":"M12 20v2"},"children":[]},{"tag":"path","props":{"d":"m4.93 4.93 1.41 1.41"},"children":[]},{"tag":"path","props":{"d":"m17.66 17.66 1.41 1.41"},"children":[]},{"tag":"path","props":{"d":"M2 12h2"},"children":[]},{"tag":"path","props":{"d":"M20 12h2"},"children":[]},{"tag":"path","props":{"d":"m6.34 17.66-1.41 1.41"},"children":[]},{"tag":"path","props":{"d":"m19.07 4.93-1.41 1.41"},"children":[]}]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"17","height":"17","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-moon life-theme-icon-dark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"},"children":[]}]}]},{"tag":"button","props":{"type":"button","className":"life-language-switch","aria-label":"Русский Выбрать язык","aria-haspopup":"menu","aria-expanded":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-globe","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]},{"tag":"path","props":{"d":"M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"},"children":[]},{"tag":"path","props":{"d":"M2 12h20"},"children":[]}]},{"tag":"span","props":{},"children":["Русский"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]}]},{"tag":"a","props":{"className":"life-account","href":"/ru/sign-in"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"17","height":"17","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle-user-round","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M18 20a6 6 0 0 0-12 0"},"children":[]},{"tag":"circle","props":{"cx":"12","cy":"10","r":"4"},"children":[]},{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},{"tag":"span","props":{},"children":["Войти"]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/ru/book/30"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"К содержанию"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["Дети после поступления в школу"]},{"tag":"nav","props":{"aria-label":"Советы главы"},"children":[{"tag":"a","props":{"href":"/ru/tip/30-01"},"children":[{"tag":"span","props":{},"children":["01"]},"Внезапная сильная боль в мошонке у мальчика — повод немедленно ехать в больницу, не дожидаясь конца уроков"]},{"tag":"a","props":{"href":"/ru/tip/30-02"},"children":[{"tag":"span","props":{},"children":["02"]},"Не откладывайте необходимое лечение «до окончания экзаменов» — для некоторых состояний существует временное окно, зависящее от сроков роста костей, а не от расписания экзаменов"]},{"tag":"a","props":{"href":"/ru/tip/30-03"},"children":[{"tag":"span","props":{},"children":["03"]},"Ребёнок подвергся издевательствам: в тот же день следует сообщить об этом в школу и потребовать письменного рассмотрения дела; в случаях избиения, отъёма денег или распространения слухов необходимо сразу вызывать полицию"]},{"tag":"a","props":{"href":"/ru/tip/30-04"},"children":[{"tag":"span","props":{},"children":["04"]},"Чтобы предотвратить близорукость, детям необходимо проводить на улице не менее 2 часов в день — это единственный метод, подтвержденный рандомизированными исследованиями"]},{"tag":"a","props":{"href":"/ru/tip/30-05"},"children":[{"tag":"span","props":{},"children":["05"]},"Детям до 3 лет экраны не давать, детям от 3 до 6 лет — по возможности тоже не давать; школьникам использовать экраны в неучебных целях не более 1 часа в день"]},{"tag":"a","props":{"href":"/ru/tip/30-06"},"children":[{"tag":"span","props":{},"children":["06"]},"Восприятие близорукости как необратимого повреждения: чем выше степень близорукости, тем выше риск развития отслойки сетчатки, макулярной дегенерации и глаукомы в будущем"]},{"tag":"a","props":{"href":"/ru/tip/30-07"},"children":[{"tag":"span","props":{},"children":["07"]},"Каждый год нужно внимательно изучать выданный школьникам медицинский осмотр — при выявлении отклонений в тот же год следует обратиться к врачу"]},{"tag":"a","props":{"href":"/ru/tip/30-08"},"children":[{"tag":"span","props":{},"children":["08"]},"Проведение скрининга на депрессию для подростков 12–18 лет: не следует считать школьные психологические тесты диагнозом"]},{"tag":"a","props":{"href":"/ru/tip/30-09"},"children":[{"tag":"span","props":{},"children":["09"]},"Не покупайте товары и услуги, которые якобы «излечивают близорукость» или «снижают степень близорукости»"]},{"tag":"a","props":{"href":"/ru/tip/30-10"},"children":[{"tag":"span","props":{},"children":["10"]},"Для сна, учебного расписания, физических занятий и ранжирования учеников существуют чёткие правила; если школа их не соблюдает, можно об этом заявить"]},{"tag":"a","props":{"href":"/ru/tip/30-11"},"children":[{"tag":"span","props":{},"children":["11"]},"Ребенку можно взять академический отпуск, если он не справляется с учебой; при этом школа обязана сохранить его ученический статус на срок до 1 года"]},{"tag":"a","props":{"href":"/ru/tip/30-12"},"children":[{"tag":"span","props":{},"children":["12"]},"Обнаружена плохая острота зрения: в больнице проводят проверку с применением мидриатика, а затем по рекомендации врача делают повторные осмотры"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/ru/tip/30-13","data-status":"active"},"children":[{"tag":"span","props":{},"children":["13"]},"Герметизация фиссур на постоянных коренных зубах после их прорезывания"]},{"tag":"a","props":{"href":"/ru/tip/30-14"},"children":[{"tag":"span","props":{},"children":["14"]},"Ребенок любит играть в игры: сначала проверьте, не пострадали ли сон, уроки и прогулки, а не только время, проведенное за игрой"]},{"tag":"a","props":{"href":"/ru/tip/30-15"},"children":[{"tag":"span","props":{},"children":["15"]},"Ребенок говорит, что ему нравятся люди своего пола: не ругайте, не выгоняйте из дома и не отправляйте на «исправление»: отношение в семье напрямую связано с риском самоубийства"]},{"tag":"a","props":{"href":"/ru/tip/30-16"},"children":[{"tag":"span","props":{},"children":["16"]},"Не бейте ребёнка и не кричите, не называя его глупым или ленивым: у часто наказываемых телом или словами детей чаще проблемы с поведением и настроением"]},{"tag":"a","props":{"href":"/ru/tip/30-17"},"children":[{"tag":"span","props":{},"children":["17"]},"Если с ребёнком не справляетесь и снова бьёте или кричите, пройдите курс с конкретными родительскими навыками"]},{"tag":"a","props":{"href":"/ru/tip/30-18"},"children":[{"tag":"span","props":{},"children":["18"]},"Не отправляйте детей в закрытые «школы лечения интернет-зависимости» и «спецлагеря»: закон запрещает вредные методы, а дети уже погибали в заключении"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"Навигация"},"children":[{"tag":"a","props":{"href":"/ru/book"},"children":["Книга"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/ru/book/30"},"children":["Глава 30"," ·"," ","Дети после поступления в школу"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"30-13"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["13"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["Доказательства"," ","A"]}]},{"tag":"h1","props":{"lang":"ru"},"children":["Герметизация фиссур на постоянных коренных зубах после их прорезывания"]},{"tag":"p","props":{"lang":"ru","className":"life-entry-summary"},"children":["Герметизация фиссур заключается в заполнении специальным составом углублений на жевательной поверхности коренных зубов, благодаря чему туда не попадают остатки пищи. Спустя два года после процедуры вероятность развития кариеса снижается примерно в 8 раз по сравнению с зубами без герметизации: у незащищённых зубов кариес появляется на 16% поверхности, а после герметизации — лишь на 5%. Эффект сохраняется и спустя 4 года."]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Затраты"]},{"tag":"p","props":{},"children":["от нескольких десятков до 100–200 юаней за зуб. Процедура…"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Польза"]},{"tag":"p","props":{},"children":["Результаты 38 исследований, в которых приняли участие 7924 ребёнка в возрасте от 5 до 16 лет, были проанализир…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"Отметить: Герметизация фиссур на постоянных коренных зубах после их прорезывания"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"Сделано"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"В планах"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"В избранное"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Поделиться советом"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Скрыть подробности"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Затраты"]},{"tag":"p","props":{},"children":["от нескольких десятков до 100–200 юаней за зуб. Процедура длится всего несколько минут, при этом не требуется анестезия и обтачивание зуба. Во многих регионах для детей определённого возраста предусмотрены бесплатные программы."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Польза"]},{"tag":"p","props":{},"children":["Результаты 38 исследований, в которых приняли участие 7924 ребёнка в возрасте от 5 до 16 лет, были проанализированы по стандартам Cochrane. В них сравнивали эффективность герметизации смолами и отсутствие таковой. У детей 5–10 лет на первых постоянных коренных зубах через 24 месяца после процедуры отношение шансов развития кариеса составило 0,12 (95% ДИ 0,08–0,19), то есть вероятность кариеса снизилась примерно в 8 раз. Эти данные получены на основе 7 исследований, в которых 1548 детей были распределены на группы, а в итоге под наблюдением оказались 1322 ребёнка; качество доказательств оценивается как среднее. Если в контрольной группе за 24 месяца кариес появлялся на 16% поверхности зубов, то после герметизации этот показатель снизился до 5,2% (3,13%–7,37%). При 40% поражения в контрольной группе после герметизации кариес возник лишь на 6,25% поверхности (3,84%–9,63%). При 70% поражении в контрольной группе показатель после герметизации составил 19% (12,3%–27,2%). Через 48–54 месяца отношение шансов снизилось до 0,21 (0,16–0,28), то есть вероятность кариеса осталась примерно в 5 раз ниже. Авторы исследований пришли к выводу, что герметизация смолами в течение 24 месяцев снижает риск развития кариеса на 11–51% по сравнению с отсутствием такой процедуры. В 4 исследованиях, в которых отслеживались побочные эффекты, никаких негативных последствий не наблюдалось. Доказательств, позволяющих определить, какой из видов герметизирующих материалов (например, стеклоиономерные составы) эффективнее, недостаточно."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Первоисточники"]},{"tag":"p","props":{"className":"life-citations"},"children":["Ahovuo-Saloranta A, et al. (2017). Pit and fissure sealants for preventing dental decay in permanent teeth. Cochrane Database of Systematic Reviews. ",{"tag":"a","props":{"href":"https://doi.org/10.1002/14651858.CD001830.pub5","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1002/14651858.CD001830.pub5"]}]},{"tag":"a","props":{"href":"https://doi.org/10.1002/14651858.CD001830.pub5","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Открыть источник"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Примечание автора"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["Первый постоянный коренной зуб (который больше не сменится) обычно прорезывается в возрасте около 6 лет, а второй — в 12 лет. Процедуру следует проводить сразу после прорезывания зуба, пока он ещё не повреждён кариесом; если кариес уже появился, можно лишь провести пломбирование. Во многих регионах гермет"]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Моя заметка"]},{"tag":"button","props":{"type":"button"},"children":["Запишите напоминание…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/ru/tip/30-12"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Предыдущий"]},"Обнаружена плохая острота зрения: в больнице проводят проверку с применением мидриатика, а затем по рекомендации врача делают повторные осмотры"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/ru/tip/30-14"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Следующий"]},"Ребенок любит играть в игры: сначала проверьте, не пострадали ли сон, уроки и прогулки, а не только время, проведенное за игрой"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["Другие советы по этой теме"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/30-09"},"children":[{"tag":"strong","props":{},"children":["Не покупайте товары и услуги, которые якобы «излечивают близорукость» или «снижают степень близорукости»"]},{"tag":"span","props":{},"children":["В официальном заявлении Государственного управления по надзору за рын…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/30-10"},"children":[{"tag":"strong","props":{},"children":["Для сна, учебного расписания, физических занятий и ранжирования учеников существуют чёткие правила; если школа их не соблюдает, можно об этом заявить"]},{"tag":"span","props":{},"children":["Все эти требования прописаны чёрным по белому: младшеклассники должны…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/30-11"},"children":[{"tag":"strong","props":{},"children":["Ребенку можно взять академический отпуск, если он не справляется с учебой; при этом школа обязана сохранить его ученический статус на срок до 1 года"]},{"tag":"span","props":{},"children":["Академический отпуск предусмотрен официальной системой. После подачи …"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/30-15"},"children":[{"tag":"strong","props":{},"children":["Ребенок говорит, что ему нравятся люди своего пола: не ругайте, не выгоняйте из дома и не отправляйте на «исправление»: отношение в семье напрямую связано с риском самоубийства"]},{"tag":"span","props":{},"children":["Среди китайских школьников, которым нравятся люди своего пола или пре…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/30-16"},"children":[{"tag":"strong","props":{},"children":["Не бейте ребёнка и не кричите, не называя его глупым или ленивым: у часто наказываемых телом или словами детей чаще проблемы с поведением и настроением"]},{"tag":"span","props":{},"children":["У детей, которых часто бьют, чаще агрессия и психологические проблемы…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/30-17"},"children":[{"tag":"strong","props":{},"children":["Если с ребёнком не справляетесь и снова бьёте или кричите, пройдите курс с конкретными родительскими навыками"]},{"tag":"span","props":{},"children":["Программы, где учат конкретным приёмам, в рандомизированных испытания…"]}]}]}]},{"tag":"a","props":{"className":"life-text-link","href":"/ru/book/30"},"children":["Читать всю тему: Дети после поступления в школу"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"15","height":"15","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]}]}]},{"tag":"nav","props":{"className":"life-tabbar","aria-label":"Основная навигация"},"children":[{"tag":"a","props":{"className":"","href":"/ru/book"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"21","height":"21","viewBo