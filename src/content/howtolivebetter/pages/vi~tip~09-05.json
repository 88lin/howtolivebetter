00/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Ẩn chi tiết"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Chi phí"]},{"tag":"p","props":{},"children":["Không tốn tiền. Bỏ loại việc「trả tiền trong ngày, mang thẻ đi ngân hàng」."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Lợi ích"]},{"tag":"p","props":{},"children":["Biết tiền, tài sản do phạm tội mà có nhưng giúp chuyển, mua, bán hoặc che giấu theo cách khác, bị đến 3 năm tù, kèm hoặc chỉ phạt tiền. Vụ chính thức: Wang mang căn cước và 1 thẻ ngân hàng theo chỉ dẫn đến chỗ định sẵn, phối hợp chuyển và rút tiền, kiếm hơn 500 nhân dân tệ. Viện kiểm sát không truy tố, công an theo Luật Chống Lừa đảo Viễn thông và Mạng giam 10 ngày, phạt 1000. Man giao thẻ ngân hàng, SIM của mình và người khác cho nhóm thu, chuyển, rút tiền, bị 2 năm 3 tháng và phạt 22.000 (toàn quốc). Chuyển thành tiền mã hóa rồi gửi cũng vậy: An và hai người khác theo chỉ thị nhóm lừa đảo, dùng thẻ mình nhận tiền, mua tiền mã hóa trên sàn, chuyển đến tài khoản được chỉ định, nhận hoa hồng tỷ lệ. Xác minh có hơn 500.000 nhân dân tệ tiền nạn nhân bị lừa. Ba người bị từ 2 năm 8 tháng đến 3 năm 3 tháng vì che giấu, giấu nguồn thu phạm tội, mỗi người phạt 30.000–40.000 (Thông Châu, Bắc Kinh)."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Nguồn gốc"]},{"tag":"p","props":{"className":"life-citations"},"children":["全国人大 (2020). 刑法（根据刑法修正案（十一）修正，第三百一十二条）. ",{"tag":"a","props":{"href":"https://jtgl.beijing.gov.cn/jgj/jgxx/flfg/fl/11033925/index.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://jtgl.beijing.gov.cn/jgj/jgxx/flfg/fl/11033925/index.html"]},"；最高人民检察院 (2023). 检察机关依法惩治电信网络诈骗及其关联犯罪典型案例（案例九）. ",{"tag":"a","props":{"href":"https://www.spp.gov.cn/xwfbh/wsfbt/202311/t20231130_635188.shtml","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.spp.gov.cn/xwfbh/wsfbt/202311/t20231130_635188.shtml"]},"；最高人民法院、最高人民检察院 (2025). 依法惩治掩饰、隐瞒犯罪所得、犯罪所得收益犯罪典型案例（案例一、五）. ",{"tag":"a","props":{"href":"https://www.spp.gov.cn/xwfbh/wsfbt/202508/t20250825_704514.shtml","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.spp.gov.cn/xwfbh/wsfbt/202508/t20250825_704514.shtml"]}]},{"tag":"a","props":{"href":"https://jtgl.beijing.gov.cn/jgj/jgxx/flfg/fl/11033925/index.html","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Liên kết mở nguồn"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Ghi chú sách"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["Hậu quả cho mượn thẻ, giúp chuyển dòng tiền xem mục 8, điều 8. Điều này nói tự rút, chuyển tiền. Nhận tiền đổi Tether hay tiền mã hóa rồi gửi đi cũng là cùng việc. Vì sao tự mua tiền mã hóa bị lỗ không đòi lại được xem mục 5, điều 45. Nói «tôi không biết tiền từ đâu» không chắc được chấp nhận. Thù lao cao vô lý, yêu cầu phối hợp nhận diện mặt, giao dịch rõ ràng bất thường có thể đủ để xác định bạn thực ra biết. Kết quả nhẹ nhất cũng là giam 10 ngày và có hồ sơ vi phạm."]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Ghi chú của tôi"]},{"tag":"button","props":{"type":"button"},"children":["Viết một lời nhắc cho chính bạn…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/vi/tip/09-04"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Trước"]},"Video khiêu dâm thì tự xem ở nhà, đừng gửi vào nhóm, đừng bán「tư liệu」, đừng lập nhóm"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/vi/tip/09-06"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Tiếp theo"]},"Có người rủ bạn làm「bọc vật liệu」để vay tiền, chia hoa hồng theo khoản vay, thì không làm việc nào cả"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className