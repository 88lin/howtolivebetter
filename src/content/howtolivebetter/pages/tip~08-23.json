ref":"/tip/08-11","className":""},"children":[{"tag":"span","props":{},"children":["11"]},"躲不掉的侵害可以还手，但只打正在动手的那个人，他停你就停"]},{"tag":"a","props":{"href":"/tip/08-12","className":""},"children":[{"tag":"span","props":{},"children":["12"]},"跟谁结了怨——被欠薪、被开除、被坑了钱——走投诉、仲裁、起诉，别去找人算账"]},{"tag":"a","props":{"href":"/tip/08-13","className":""},"children":[{"tag":"span","props":{},"children":["13"]},"再恨也别对不相干的人下手：驾车冲撞人群、在公共场所行凶按以危险方法危害公共安全定罪，起刑三年，死了人十年起步、最高死刑"]},{"tag":"a","props":{"href":"/tip/08-14","className":""},"children":[{"tag":"span","props":{},"children":["14"]},"冒出「拉个垫背的」「同归于尽」这种念头，当急症处理：离开现场，把车钥匙和刀交给别人，打 12356"]},{"tag":"a","props":{"href":"/tip/08-15","className":""},"children":[{"tag":"span","props":{},"children":["15"]},"身边人说出「谁也别想好过」「带着孩子一起走」，别当气话：近亲属可以直接送诊，公安接到报警也必须管"]},{"tag":"a","props":{"href":"/tip/08-16","className":""},"children":[{"tag":"span","props":{},"children":["16"]},"网上不骂人、不造谣、不转发没核实的事；被网暴先留证再报警"]},{"tag":"a","props":{"href":"/tip/08-17","className":""},"children":[{"tag":"span","props":{},"children":["17"]},"签字前把纸看完，不替人签字，不在空白纸上签"]},{"tag":"a","props":{"href":"/tip/08-18","className":""},"children":[{"tag":"span","props":{},"children":["18"]},"借钱写清借条，替人担保前先想清楚自己愿不愿意替他还"]},{"tag":"a","props":{"href":"/tip/08-19","className":""},"children":[{"tag":"span","props":{},"children":["19"]},"维权有期限：民事诉讼时效 3 年，劳动仲裁 1 年，过了对方一句「超过时效」就够"]},{"tag":"a","props":{"href":"/tip/08-20","className":""},"children":[{"tag":"span","props":{},"children":["20"]},"被起诉、被执行了，如实报财产、能还多少还多少，别把房和钱转给亲友或公司"]},{"tag":"a","props":{"href":"/tip/08-21","className":""},"children":[{"tag":"span","props":{},"children":["21"]},"被限制消费或者被列入失信名单，先查清是按哪一条纳入的，能纠正的申请纠正"]},{"tag":"a","props":{"href":"/tip/08-22","className":""},"children":[{"tag":"span","props":{},"children":["22"]},"网购、二手交易被骗，先平台投诉，再报警，再算值不值得起诉"]},{"tag":"a","props":{"href":"/tip/08-23","className":"active"},"children":[{"tag":"span","props":{},"children":["23"]},"恋爱和婚内的大额赠与，交付之前想清楚，交付之后原则上要不回"]},{"tag":"a","props":{"href":"/tip/08-24","className":""},"children":[{"tag":"span","props":{},"children":["24"]},"彩礼走转账并备注，聊天记录留好；借婚姻要钱可以要回"]},{"tag":"a","props":{"href":"/tip/08-25","className":""},"children":[{"tag":"span","props":{},"children":["25"]},"婚前财产不用怕，房子加名和父母出资先写清楚"]},{"tag":"a","props":{"href":"/tip/08-26","className":""},"children":[{"tag":"span","props":{},"children":["26"]},"结婚前核对对方婚姻状况，以结婚为幌子骗钱的按诈骗罪追究"]},{"tag":"a","props":{"href":"/tip/08-27","className":""},"children":[{"tag":"span","props":{},"children":["27"]},"上门维修、验车、装修，先问价再动手，全程在旁边看着"]},{"tag":"a","props":{"href":"/tip/08-28","className":""},"children":[{"tag":"span","props":{},"children":["28"]},"别当「挂名法人」，别把身份证借给人注册公司"]},{"tag":"a","props":{"href":"/tip/08-29","className":""},"children":[{"tag":"span","props":{},"children":["29"]},"出入境不帮陌生人带东西，不代收来路不明的包裹"]},{"tag":"a","props":{"href":"/tip/08-30","className":""},"children":[{"tag":"span","props":{},"children":["30"]},"养狗必须牵绳：不牵绳出了事是无过错责任（你有没有错都要赔），赔到底。狗还要按时打狂犬病疫苗、办养犬登记"]},{"tag":"a","props":{"href":"/tip/08-31","className":""},"children":[{"tag":"span","props":{},"children":["31"]},"对方喝到意识不清、睡着，或者可能不满 14 岁，就不要发生关系"]},{"tag":"a","props":{"href":"/tip/08-32","className":""},"children":[{"tag":"span","props":{},"children":["32"]},"发生关系、裸聊之后对方拿报警、发照片、告诉你单位来要钱，一分钱不给，一条记录不删，直接报警"]},{"tag":"a","props":{"href":"/tip/08-33","className":""},"children":[{"tag":"span","props":{},"children":["33"]},"被人捏造事实举报，可以要求追究：够治安处罚的拘留 5 日起，够罪的判 3 年以下"]},{"tag":"a","props":{"href":"/tip/08-34","className":""},"children":[{"tag":"span","props":{},"children":["34"]},"证据不足本来就应当判无罪，逼出来的口供应当排除；判了还有申诉和再审"]},{"tag":"a","props":{"href":"/tip/08-35","className":""},"children":[{"tag":"span","props":{},"children":["35"]},"被羁押后撤案、不起诉或者判无罪的，去申请国家赔偿，按天算钱"]},{"tag":"a","props":{"href":"/tip/08-36","className":""},"children":[{"tag":"span","props":{},"children":["36"]},"自己是受害人去索赔，走 12315、起诉或者律师，别单独赴对方的约，别把「给钱」和「我不曝光」绑成一句话"]},{"tag":"a","props":{"href":"/tip/08-37","className":""},"children":[{"tag":"span","props":{},"children":["37"]},"被网暴了：先开防护、先固证，再在平台、禁令、报警三条路里挑"]},{"tag":"a","props":{"href":"/tip/08-38","className":""},"children":[{"tag":"span","props":{},"children":["38"]},"「先给人买保险再动手」这条路法律上从头堵死：钱一分拿不到，罪按故意杀人加保险诈骗数罪并罚"]},{"tag":"a","props":{"href":"/tip/08-39","className":""},"children":[{"tag":"span","props":{},"children":["39"]},"报警当场要受案回执，不立案要书面通知：7 日内可申请复议，再 7 日可申请复核，检察院能通知公安立案"]},{"tag":"a","props":{"href":"/tip/08-40","className":""},"children":[{"tag":"span","props":{},"children":["40"]},"别给办案、执法的人送钱送卡：行贿自己也判，对监察、执法、司法人员行贿还要从重"]},{"tag":"a","props":{"href":"/tip/08-41","className":""},"children":[{"tag":"span","props":{},"children":["41"]},"可能翻脸的电话和面谈，直接开录音：自己参加的谈话，不用先征得对方同意"]},{"tag":"a","props":{"href":"/tip/08-42","className":""},"children":[{"tag":"span","props":{},"children":["42"]},"现场出了事，先拍全景，再拍位置关系，最后拍损坏和伤情，原图原视频别删"]},{"tag":"a","props":{"href":"/tip/08-43","className":""},"children":[{"tag":"span","props":{},"children":["43"]},"被家暴了：先报警留下出警记录，再去法院申请人身安全保护令，不用先离婚，也不收费"]},{"tag":"a","props":{"href":"/tip/08-44","className":""},"children":[{"tag":"span","props":{},"children":["44"]},"家里人赌博欠了债，别急着替他还：赌债法律不保护，为赌借的钱也不算夫妻共同债务"]},{"tag":"a","props":{"href":"/tip/08-45","className":""},"children":[{"tag":"span","props":{},"children":["45"]},"熟人让你「帮忙刷个脸、做个见证」去办贷款，或者要你念验证码，别答应：这叫 AB 贷，借款人是你，不是担保人"]},{"tag":"a","props":{"href":"/tip/08-46","className":""},"children":[{"tag":"span","props":{},"children":["46"]},"给门窗装好锁、门外装一盏感应灯，出门真的锁上：防入室盗窃靠这几样，单装一个报警器看不出用"]}]}]},{"tag":"div","props":{"className":"life-tip-page","data-tip-locales":"zh,en,ru,es,ja,vi"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"当前位置"},"children":[{"tag":"a","props":{"href":"/book"},"children":["阅读全书"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/book/08"},"children":["第 8 章 · 别把自己搭进去：法律与财产安全"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"08-23"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["23"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["证据 A"]}]},{"tag":"h1","props":{"lang":"zh"},"children":["恋爱和婚内的大额赠与，交付之前想清楚，交付之后原则上要不回"]},{"tag":"p","props":{"lang":"zh","className":"life-entry-summary"},"children":["钱一交出去，原则上就要不回来了。送出去的东西，只有在过到对方名下之前才能随便撤销。过户完成之后，只有对方严重侵害你或者你的近亲属、该扶养你却不扶养、不履行约定义务这三种情形才撤得掉。所以大额转账之前先想清楚，这是借还是送。"]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["成本"]},{"tag":"p","props":{},"children":["不花钱。大额转账之前先想一下：这是借，还是送。是借就写借条，转账备注写「借款」。难在开口把这句话说出来。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["收益"]},{"tag":"p","props":{},"children":["送出去的东西，在过到对方名下之前可以撤销，法律把这个时点叫财产权利转移。一旦转账、过户完成，就只剩三种情形能撤销：收东西的一方严重侵害你或者你的近亲属；该扶养你却不扶养；不履行赠与合同里约定的义务。节日、生日这类有纪念意义的时点给的价值不大的礼物礼金，还有为了表达或者增进感情的日常消费支出，不属于彩…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"标记：恋爱和婚内的大额赠与，交付之前想清楚，交付之后原则上要不回"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"已做到"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"加入待做"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"收藏"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"分享这条建议"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"t