 lucide-circle-user-round","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M18 20a6 6 0 0 0-12 0"},"children":[]},{"tag":"circle","props":{"cx":"12","cy":"10","r":"4"},"children":[]},{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},{"tag":"span","props":{},"children":["Iniciar sesión"]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/es/book/07"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"Volver al índice"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["Cómo vivir cuando no hay dinero"]},{"tag":"nav","props":{"aria-label":"Consejos del capítulo"},"children":[{"tag":"a","props":{"href":"/es/tip/07-01"},"children":[{"tag":"span","props":{},"children":["01"]},"Cómo solicitar en línea el subsidio por desempleo si se queda sin trabajo"]},{"tag":"a","props":{"href":"/es/tip/07-02"},"children":[{"tag":"span","props":{},"children":["02"]},"Si te deben el salario, primero reclama ante la inspección laboral y luego solicita arbitraje laboral; ninguna de las dos vías cuesta dinero y la mayoría de los casos se resuelve en unos meses"]},{"tag":"a","props":{"href":"/es/tip/07-03"},"children":[{"tag":"span","props":{},"children":["03"]},"Si no puedes pagar un juicio, solicita asistencia jurídica gratuita; los casos de cobro de salarios, alimentos y accidentes laborales ya están dentro del alcance"]},{"tag":"a","props":{"href":"/es/tip/07-04"},"children":[{"tag":"span","props":{},"children":["04"]},"Cuando estás sin salida, acude a una estación de socorro: comida, alojamiento y billete de regreso"]},{"tag":"a","props":{"href":"/es/tip/07-05"},"children":[{"tag":"span","props":{},"children":["05"]},"Para buscar trabajo usa primero los servicios públicos de empleo gratuitos y los mercados de trabajos temporales, no las agencias que cobran"]},{"tag":"a","props":{"href":"/es/tip/07-06"},"children":[{"tag":"span","props":{},"children":["06"]},"Ante una desgracia repentina, solicita primero la asistencia temporal"]},{"tag":"a","props":{"href":"/es/tip/07-07"},"children":[{"tag":"span","props":{},"children":["07"]},"Si tus ingresos están por debajo de la línea local del dibao, solicita el dibao (salario mínimo de subsistencia garantizado)"]},{"tag":"a","props":{"href":"/es/tip/07-08"},"children":[{"tag":"span","props":{},"children":["08"]},"Quien tiene el certificado de discapacidad puede solicitar los dos subsidios para personas con discapacidad"]},{"tag":"a","props":{"href":"/es/tip/07-09"},"children":[{"tag":"span","props":{},"children":["09"]},"No dejen de pagar los 400 yuanes anuales por la medistraховка (ибао) para residentes; las familias en situación de pobreza pueden obtener exenciones"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/es/tip/07-10","data-status":"active"},"children":[{"tag":"span","props":{},"children":["10"]},"Ante una enfermedad grave, ve primero por el seguro médico básico, el seguro de enfermedades graves, la asistencia médica y el alta interprovincial; no toques los préstamos en línea"]},{"tag":"a","props":{"href":"/es/tip/07-11"},"children":[{"tag":"span","props":{},"children":["11"]},"Si pierdes la cédula de identidad, repónla de inmediato; si la necesitas con urgencia, pide primero la cédula temporal"]},{"tag":"a","props":{"href":"/es/tip/07-12"},"children":[{"tag":"span","props":{},"children":["12"]},"Tras el registro de desempleo, busca el reconocimiento como persona con dificultades para encontrar empleo, para obtener el subsidio de seguro social o un puesto de interés público"]},{"tag":"a","props":{"href":"/es/tip/07-13"},"children":[{"tag":"span","props":{},"children":["13"]},"En el desempleo, cobra el subsidio de formación profesional, el subsidio de pasantías de empleo y el subsidio de seguro social; no pagues de tu bolsillo un curso"]},{"tag":"a","props":{"href":"/es/tip/07-14"},"children":[{"tag":"span","props":{},"children":["14"]},"En la búsqueda de empleo no te limites a enviar currículos: usa un método de sistema: aprende técnicas, fija objetivos, busca ayuda"]},{"tag":"a","props":{"href":"/es/tip/07-15"},"children":[{"tag":"span","props":{},"children":["15"]},"No pagues depósitos, no entreges documentos en garantía, no firmes «préstamos para formación», no entres a esquemas piramidales ni pidas préstamos usurarios"]},{"tag":"a","props":{"href":"/es/tip/07-16"},"children":[{"tag":"span","props":{},"children":["16"]},"Ante dificultades de vivienda, ponte primero en la fila de la vivienda pública de alquiler"]},{"tag":"a","props":{"href":"/es/tip/07-17"},"children":[{"tag":"span","props":{},"children":["17"]},"Comprime alojamiento y comida al mínimo: alquiler compartido por mes en lugar de alquiler por día, y cocinar propio y comedores asistidos en lugar de comida a domicilio"]},{"tag":"a","props":{"href":"/es/tip/07-18"},"children":[{"tag":"span","props":{},"children":["18"]},"Si se interrumpe tu cotización al seguro social, no entres en pánico: la pensión cuenta por años acumulados y el seguro médico se repone según las reglas"]},{"tag":"a","props":{"href":"/es/tip/07-19"},"children":[{"tag":"span","props":{},"children":["19"]},"Haber estado preso, haber quebrado o haber entrado en la lista de deudores incumplidos: la ley da caminos de regreso; termina primero los trámites"]},{"tag":"a","props":{"href":"/es/tip/07-20"},"children":[{"tag":"span","props":{},"children":["20"]},"Antes de una enfermedad grave, además del seguro médico básico añade un seguro médico o de enfermedades graves anual, y mira bien las palabras «renovación garantizada»"]},{"tag":"a","props":{"href":"/es/tip/07-21"},"children":[{"tag":"span","props":{},"children":["21"]},"Si de verdad no tienes dónde dormir, los locales de atención 24 horas sirven solo para una noche de emergencia; ve primero a la estación de socorro"]},{"tag":"a","props":{"href":"/es/tip/07-22"},"children":[{"tag":"span","props":{},"children":["22"]},"Si le deben el salario, primero aclare quién lo contrató: talleres sin licencia y subcontratistas siguen yendo a inspección laboral; solo el trabajo para un hogar o persona privada va al juzgado"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"Ruta de navegación"},"children":[{"tag":"a","props":{"href":"/es/book"},"children":["Libro"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/es/book/07"},"children":["Capítulo 7"," ·"," ","Cómo vivir cuando no hay dinero"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"07-10"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["10"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["Evidencia"," ","A"]}]},{"tag":"h1","props":{"lang":"es"},"children":["Ante una enfermedad grave, ve primero por el seguro médico básico, el seguro de enfermedades graves, la asistencia médica y el alta interprovincial; no toques los préstamos en línea"]},{"tag":"p","props":{"lang":"es","className":"life-entry-summary"},"children":["El orden es fijo. Antes de ingresarte en otra provincia, registra el alta interprovincial en la cuenta de la Administración de Seguridad Sanitaria; con el registro, liquidas directamente al alta y no adelantas el total. Si tras el reembolso no puedes con tu parte, pide asistencia médica al municipio o subdistrito. Si estás empleado, tu periodo de tratamiento médico va de 3 a 24 meses según antigüedad, y la empresa no puede despedirte durante ese tiempo. No toques ni los préstamos en línea ni los préstamos privados a interés alto."]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Coste"]},{"tag":"p","props":{},"children":["Gratis. El orden de los pasos es fijo, uno a uno. Paso 1:…"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Beneficio"]},{"tag":"p","props":{},"children":["El Estado agrupa el seguro médico básico, el seguro de enfermedades graves y la asistencia médica en un «siste…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"Marcar: Ante una enfermedad grave, ve primero por el seguro médico básico, el seguro de enfermedades graves, la asistencia médica y el alta interprovincial; no toques los préstamos en línea"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"Hecho"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"Por hacer"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"Guardar"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Compartir consejo"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Ocultar detalles"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Coste"]},{"tag":"p","props":{},"children":["Gratis. El orden de los pasos es fijo, uno a uno. Paso 1: antes de un ingreso hospitalario en otra provincia, tramita el alta interprovincial en el miniprograma «Registro de atención médica interprovincial» de la cuenta oficial de la Administración Estatal de Seguridad Sanitaria. Paso 2: liquida directamente al alta. Paso 3: si tras el reembolso lo que te queda por pagar sigue siendo demasiado, pide asistencia médica al gobierno del municipio o a la oficina de subdistrito. Paso 4: si trabajas, pide baja por enfermedad conforme al periodo de tratamiento médico — el tiempo en que estás de baja por enfermedad y no pueden despedirte; si es accidente laboral, va por el seguro de accidentes. Paso 5: si no puedes pagar la tarjeta de crédito, negocia tú mismo un plan de cuotas con el banco. Paso 6: solo si aún no basta, recauda en una plataforma de peticiones personales designada por el Ministerio de Asuntos Civiles. Los papeles son, sobre todo, el diagnóstico detallado, la lista de gastos y el liquidado de cuenta: calcula de 2 a 4 viajes. Lo difícil es hacerlo estando enfermo."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Beneficio"]},{"tag":"p","props":{},"children":["El Estado agrupa el seguro médico básico, el seguro de enfermedades graves y la asistencia médica en un «sistema de tres niveles» que te recoge capa por capa. Los beneficiarios del subsidio de subsistencia y las personas en extrema pobre reciben asistencia de no menos del 70% de los gastos médicos elegibles. Un paciente grave que no era pobre pero lo fue por el tratamiento puede solicitar asistencia por sí mismo. Con el registro interprovincial hecho, liquidas al alta sin adelantar el total y reclamar después en tu plaza de asegurado. Si la enfermedad te deja de baja, el periodo de tratamiento médico es de 3 a 24 meses según antigüedad; durante ese tiempo la empresa no puede rescindir el contrato, y el sueldo de baja no baja del 80% del salario mínimo local. El trabajador con accidente laboral tiene un periodo de suspensión con sueldo — el tiempo de recuperación — con el salario y prestaciones originales pagados mes a mes por la empresa, en general no más de 12 meses. Si la deuda de tarjeta supera tu capacidad de pago y quieres pagar, puedes negociar con el banco un plan de cuotas personalizado: la deuda se reprograma hasta por 5 años y, firmado el acuerdo, el banco debe detener el cobro. Las plataformas de peticiones personales deben estar designadas por el Ministerio de Asuntos Civiles del Consejo de Estado; la plataforma debe verificar que las peticiones son reales, y el dinero donado solo puede ir al propio solicitante o a una cuenta que él provea."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Fuentes originales"]},{"tag":"p","props":{"className":"life-citations"},"children":["国务院办公厅 (2021). 关于健全重特大疾病医疗保险和救助制度的意见（国办发〔2021〕42 号）. ",{"tag":"a","props":{"href":"https://www.gov.cn/gongbao/content/2021/content_5659514.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/gongbao/content/2021/content_5659514.htm"]},"；国家医保局 (2025). 跨省异地就医如何直接报销？. ",{"tag":"a","props":{"href":"https://www.nhsa.gov.cn/art/2025/3/16/art_14_16010.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.nhsa.