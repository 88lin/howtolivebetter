ldren":["国家药监局 2010 年的药品不良反应信息通报说，维C银翘片含马来酸氯苯那敏，也叫扑尔敏。它的不良反应主要是困倦、虚弱感、嗜睡、口干。通报建议医生和药店提示患者：服药期间不得驾驶机、车、船，不得从事高空作业、机械作业及操作精密仪器。国家药监局 2020 年的公众用药提示说，复方感冒药里多含氯苯那敏、…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"标记：吃了含氯苯那敏（扑尔敏）、苯海拉明的感冒药或抗过敏药，吃药期间别开车，也别登高干活、别操作机器"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"已做到"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"加入待做"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"收藏"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"分享这条建议"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"收起详情"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["成本"]},{"tag":"p","props":{"className":"life-citations"},"children":["不花钱。买药时看一眼成分表。吃药那几天改坐车、打车，或者请医生、药师换一种不犯困的药。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["收益"]},{"tag":"p","props":{"className":"life-citations"},"children":["国家药监局 2010 年的药品不良反应信息通报说，维C银翘片含马来酸氯苯那敏，也叫扑尔敏。它的不良反应主要是困倦、虚弱感、嗜睡、口干。通报建议医生和药店提示患者：服药期间不得驾驶机、车、船，不得从事高空作业、机械作业及操作精密仪器。国家药监局 2020 年的公众用药提示说，复方感冒药里多含氯苯那敏、苯海拉明这类抗过敏成分，吃了会困倦。从事驾驶、机械操作、高空作业的人要慎用。美国一项开车模拟器试验找了 40 名有季节性过敏性鼻炎的司机，年龄 25 到 44 岁。每人隔一周换一种处理，各开 1 小时：苯海拉明 50 毫克，非索非那定 60 毫克，喝酒到血液酒精浓度约 0.1%，安慰剂。非索非那定是一种不犯困的抗过敏药。跟住前车车速的能力，吃苯海拉明后最差，喝酒和吃非索非那定后都明显好一些。保持车道的能力，喝酒和吃苯海拉明后都变差。前车突然挡道时，喝酒后反应最慢，平均 2.21 秒，吃非索非那定后是 1.95 秒。吃非索非那定和吃安慰剂开得差不多。作者的结论是，苯海拉明对开车的影响比酒精还大。司机自己报的困倦程度，看不出他开得好不好，所以不能靠「困不困」来决定能不能开。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["来源"]},{"tag":"p","props":{"className":"life-citations"},"children":["国家食品药品监督管理局 (2010). 药品不良反应信息通报（第32期）关注中西药复方制剂维C银翘片的安全性问题. ",{"tag":"a","props":{"href":"https://www.nmpa.gov.cn/xxgk/yjjsh/ypblfytb/20100919162601498.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.nmpa.gov.cn/xxgk/yjjsh/ypblfytb/20100919162601498.html"]},"；国家药品监督管理局 (2020). 2020年公众十大用药提示丨（三）感冒用药须谨慎，安全合理是关键. ",{"tag":"a","props":{"href":"https://www.nmpa.gov.cn/xxgk/kpzhsh/kpzhshyp/20201111095256170.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.nmpa.gov.cn/xxgk/kpzhsh/kpzhshyp/20201111095256170.html"]},"；Weiler JM, Bloomfield JR, Woodworth GG, et al. (2000). Effects of fexofenadine, diphenhydramine, and alcohol on driving performance. A randomized, placebo-controlled trial in the Iowa driving simulator. Annals of Internal Medicine, 132(5):354-363. ",{"tag":"a","props":{"href":"https://doi.org/10.7326/0003-4819-132-5-200003070-00004","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.7326/0003-4819-132-5-200003070-00004"]},"；中华人民共和国道路交通安全法（2021 年修正）第二十二条第二款. ",{"tag":"a","props":{"href":"https://flk.npc.gov.cn/detail?id=ff8081817ab231eb017abd617ef70519","target":"_blank","rel":"noopener noreferrer"},"children":["https://flk.npc.gov.cn/detail?id=ff8081817ab231eb017abd617ef70519"]},""]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["原书备注"]},{"tag":"p","props":{"className":"life-citations"},"children":["药监局点名的酚麻美敏、复方氨酚烷胺、氨咖黄敏都含氯苯那敏，买之前看成分表。道路交通安全法明文禁止的，是服用国家管制的精神药品或者麻醉药品后开车。普通感冒药、抗过敏药不在里面，开车的禁令写在说明书和药监局的提示里。非吃不可又要开车的，请医生或药师换一种不犯困的药。这些感冒药很多也含对乙酰氨基酚，见本节第 1 条（对乙酰氨基酚）。开车犯困的其他风险见第 1 节第 9 条（困了就停车歇）。定 B 是因为只有一项 40 人的模拟器试验，没有真实路上的事故数字。收益定「小」：终点是模拟器里的开车表现，不是事故和死亡。受益人除了你自己，还有同车的家人和路上的其他人。"]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["我的备注"]},{"tag":"button","props":{"type":"button"},"children":["写下对自己有用的提醒…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/tip/34-11"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["上一条"]},"用头孢、甲硝唑这类抗菌药期间和停药后 7 天内不喝酒，藿香正气水、止咳糖浆这类含酒精的药也不碰"]}]},{"tag":"span","props":{},"children":[]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["本主题的其他建议"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/34-03"},"children":[{"tag":"strong","props":{},"children":["60 岁以上、胃出过血、在吃抗凝药或激素的人，吃布洛芬这类止痛药之前先问医生"]},{"tag":"span","props":{},"children":["布洛芬、萘普生、阿司匹林这类止痛药会伤胃。在大剂量的试验里，吃布洛芬的人胃出血、穿孔的风险是不吃的约 4 倍。年纪大、胃出过血、同时吃抗凝药或激素、每天喝 3…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/34-04"},"children":[{"tag":"strong","props":{},"children":["2 岁以下的孩子感冒，别自己喂复方感冒药和止咳药"]},{"tag":"span","props":{},"children":["国家药监局要求 14 种儿童复方感冒药加上警示。警示说不建议家长自己给 2 岁以下孩子用，要在医生或药师指导下用。在孩子身上做的试验里，止咳药、抗过敏药效果都不…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/34-05"},"children":[{"tag":"strong","props":{},"children":["怀孕 20 周以后，别自己吃布洛芬这类止痛药"]},{"tag":"span","props":{},"children":["怀孕 20 周以后吃布洛芬这类药，可能伤到胎儿的肾、让羊水变少。美国收到的这类报告里，有新生儿死亡的病例。医生开的小剂量阿司匹林不在此列。"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/34-06"},"children":[{"tag":"strong","props":{},"children":["反酸烧心自己买奥美拉唑，最多吃 7 天；吞咽困难、呕血、黑便就直接去医院"]},{"tag":"span","props":{},"children":["奥美拉唑肠溶片从 2022 年起不用处方就能买，但说明书写明自己吃不超过 7 天，两个月内别再吃。吞咽困难或疼痛、呕血、便血或黑便时不要自己吃，这些可能是严重情…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/34-07"},"children":[{"tag":"strong","props":{},"children":["普通感冒别找医生要抗生素"]},{"tag":"span","props":{},"children":["感冒吃抗生素，好得不比不吃快。成年人吃了，副作用的风险是不吃的两倍多。流脓鼻涕不到 10 天的，吃抗生素也没有确定的好处。"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/34-08"},"children":[{"tag":"strong","props":{},"children":["拉肚子先喝口服补液盐补水，5 岁以下的孩子不给止泻药"]},{"tag":"span","props":{},"children":["拉肚子最要紧的是补水，不是止泻。按说明书兑水喝口服补液盐，别拿果汁饮料代替，太甜反而让人更缺水。5 岁以下的孩子不给洛哌丁胺这类止泻药，严重的会肠梗阻，可能致命…"]}]}]}]},{"tag":"a","props":{"className":"life-text-link","href":"/book/34"},"children":["阅读整个主题：家里的常备药别吃出事 ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"15","height":"15","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]}]}]},{"tag":"nav","props":{"className":"life-tabbar","aria-label":"主导航"},"children":[{"tag":"a","props":{"className":"","href":"/book"},"children":[{"tag":"svg","props":{"xml