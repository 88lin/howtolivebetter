e":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/tip/04-10"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["上一条"]},"把要用的东西摆到手边，把不想碰的挪远，别指望当场忍住"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/tip/04-12"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["下一条"]},"新习惯按月算，不要按「21 天」算"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["本主题的其他建议"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/04-07"},"children":[{"tag":"strong","props":{},"children":["把大任务拆成子任务再估时、再开工"]},{"tag":"span","props":{},"children":["人估工期的时候，不会自动把任务拆开一件件算。先把子任务列出来再估，就能少估短一截。拆开之后，每一小步都能马上动手，也就不那么容易拖。"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/04-08"},"children":[{"tag":"strong","props":{},"children":["给没有外部截止的事自己定一个日期"]},{"tag":"span","props":{},"children":["有别人定的截止日期时，80.6% 的学生能在那之前做完。按自己预计的时间做完的，只有 38.7%。什么时候做完，几乎跟着截止日期走，和自己估的关系不大。所以没有…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/04-09"},"children":[{"tag":"strong","props":{},"children":["把拖延当成在躲开难受，不要当成不够努力"]},{"tag":"span","props":{},"children":["这件事让人多难受、觉不觉得自己做得成、容不容易被眼前的东西带走、自控强不强，和拖延关系最强。神经质、爱寻求刺激这类性格，和拖延只有很弱的关联。所以可以先把任务改…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/04-13"},"children":[{"tag":"strong","props":{},"children":["拖延已经影响生活的，用有随机试验支持的自助材料，不用非找治疗师"]},{"tag":"span","props":{},"children":["拖延严重到让人痛苦，是能改善的。照着认知行为自助材料练十周，有人带着做和完全自己做，都明显比什么都不做好。有人带和没人带看不出差别，所以自己照着做也有效。"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/04-14"},"children":[{"tag":"strong","props":{},"children":["用自己的时薪决定哪些家务外包"]},{"tag":"span","props":{},"children":["中国人平均每天花 1 小时 17 分做家务。当天真动手做的那部分人，花 1 小时 59 分。花钱买时间的人，生活满意度更高。同样一笔钱，花在买时间上比买东西，当…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/04-15"},"children":[{"tag":"strong","props":{},"children":["给短视频和无目的刷屏设硬上限"]},{"tag":"span","props":{},"children":["2024 年中国人平均每天上网 5 小时 37 分，当天真上了网的人是 6 小时 3 分。2018 年按同样算法还只有 2 小时 42 分。这是本节里数字最大的…"]}]}]}]},{"tag":"a","props":{"className":"life-text-link","href":"/book/04"},"children":["阅读整个主题：不要浪费时间 ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"15","height":"15","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]}]}]},{"tag":"nav","props":{"className":"life-tabbar","aria-label":"主导航"},"children":[{"tag":"a","props":{"className":"","href":"/book"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"21","height":"21","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-book-open","aria-hidden":"true"},"children":[{"tag":"path","props":{"