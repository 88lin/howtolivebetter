lor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-up-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M7 7h10v10"},"children":[]},{"tag":"path","props":{"d":"M7 17 17 7"},"children":[]}]}]}]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/ru/book/33"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"К содержанию"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["Как жить после инвалидности"]},{"tag":"div","props":{"data-ad-dock-host":"true"},"children":[]},{"tag":"nav","props":{"aria-label":"Советы главы"},"children":[{"tag":"a","props":{"href":"/ru/tip/33-01"},"children":[{"tag":"span","props":{},"children":["01"]},"Внезапная сильная головная боль и потоотделение после травмы спинного мозга: сначала помогите пострадавшему сесть прямо, ослабьте одежду и вызовите скорую помощь"]},{"tag":"a","props":{"href":"/ru/tip/33-02"},"children":[{"tag":"span","props":{},"children":["02"]},"Первые десять лет после инвалидизации — период высокого риска суицида; это нельзя списывать на «просто нужно настроиться на позитивный лад»"]},{"tag":"a","props":{"href":"/ru/tip/33-03"},"children":[{"tag":"span","props":{},"children":["03"]},"Госпитализация при психических расстройствах основывается на добровольном согласии; существуют лишь два исключения, когда допускается госпитализация без согласия пациента"]},{"tag":"a","props":{"href":"/ru/tip/33-04"},"children":[{"tag":"span","props":{},"children":["04"]},"За тем, кто долгое время ухаживает за инвалидом в семье, нужно присматривать и за собственным здоровьем"]},{"tag":"a","props":{"href":"/ru/tip/33-05"},"children":[{"tag":"span","props":{},"children":["05"]},"Для людей, которые долгое время пользуются инвалидной коляской, стоит заменить сиденье на специальное противопролежневое и каждый день проверять состояние седалищной и копчиковой костей"]},{"tag":"a","props":{"href":"/ru/tip/33-06"},"children":[{"tag":"span","props":{},"children":["06"]},"Не покупайте методы лечения и приборы, которые «излечивают паралич, слепоту и глухоту»"]},{"tag":"a","props":{"href":"/ru/tip/33-07"},"children":[{"tag":"span","props":{},"children":["07"]},"После получения удостоверения инвалида сходите в органы гражданской администрации на уровне уезда и уточните сразу все доступные льготы"]},{"tag":"a","props":{"href":"/ru/tip/33-08"},"children":[{"tag":"span","props":{},"children":["08"]},"Для детей младше 7 лет с инвалидностью или аутизмом необходимо обратиться в органы гражданской администрации на уровне уезда для получения помощи по реабилитации"]},{"tag":"a","props":{"href":"/ru/tip/33-09"},"children":[{"tag":"span","props":{},"children":["09"]},"За модернизацию пандусов, поручней и ванных комнат в доме можно подать заявку на субсидию в органы гражданской администрации на уровне уезда и выше"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/ru/tip/33-10","data-status":"active"},"children":[{"tag":"span","props":{},"children":["10"]},"При трудоустройстве стоит самостоятельно упомянуть о наличии удостоверения инвалида — это позволит работодателю сэкономить деньги"]},{"tag":"a","props":{"href":"/ru/tip/33-11"},"children":[{"tag":"span","props":{},"children":["11"]},"Налог на доходы физических лиц для людей с инвалидностью может быть уменьшен; сколько именно — уточните по телефону в налоговой службе вашего региона"]},{"tag":"a","props":{"href":"/ru/tip/33-12"},"children":[{"tag":"span","props":{},"children":["12"]},"Собак-поводырей можно приводить в общественные места и на общественный транспорт; слепые люди могут бесплатно ездить на городском общественном транспорте"]},{"tag":"a","props":{"href":"/ru/tip/33-13"},"children":[{"tag":"span","props":{},"children":["13"]},"Лица с инвалидностью, сдающие вступительные экзамены, могут получить необходимые удобства; при использовании шрифта Брайля время экзамена увеличивается на 50%"]},{"tag":"a","props":{"href":"/ru/tip/33-14"},"children":[{"tag":"span","props":{},"children":["14"]},"Органы гражданской администрации не вправе отказывать в зачислении детям с инвалидностью; для тех, кто не может посещать школу, местные органы образования организуют обучение на дому"]},{"tag":"a","props":{"href":"/ru/tip/33-15"},"children":[{"tag":"span","props":{},"children":["15"]},"Люди без правой или обеих нижних конечностей тоже могут получить водительские права категории C5"]},{"tag":"a","props":{"href":"/ru/tip/33-16"},"children":[{"tag":"span","props":{},"children":["16"]},"Реабилитацию следует проходить в специализированных учреждениях, где есть отделение реабилитологии; интенсивность занятий определяет врач-реабилитолог, и она не обязательно должна быть максимальной"]},{"tag":"a","props":{"href":"/ru/tip/33-17"},"children":[{"tag":"span","props":{},"children":["17"]},"Снижение слуха — повод подобрать слуховой аппарат. Его назначают ради того, чтобы слышать, а не для профилактики слабоумия"]},{"tag":"a","props":{"href":"/ru/tip/33-18"},"children":[{"tag":"span","props":{},"children":["18"]},"Если говорят, что взрослый человек «не может самостоятельно распоряжаться своими делами», для этого нужно подать в суд заявление о признании его недееспособным или ограниченно дееспособным; мнение родственников здесь не имеет значения"]},{"tag":"a","props":{"href":"/ru/tip/33-19"},"children":[{"tag":"span","props":{},"children":["19"]},"Порядок назначения опекунов для совершеннолетних определяется законом; если подопечный причинил вред другим, ответственность несет опекун"]},{"tag":"a","props":{"href":"/ru/tip/33-20"},"children":[{"tag":"span","props":{},"children":["20"]},"Если вас не взяли на работу, не перевели на постоянную ставку или урезали зарплату из‑за инвалидности, вы можете подать в суд, но сначала рассчитайте все связанные расходы"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"Навигация"},"children":[{"tag":"a","props":{"href":"/ru/book"},"children":["Книга"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/ru/book/33"},"children":["Глава 33"," ·"," ","Как жить после инвалидности"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"33-10"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["10"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["Доказательства"," ","A"]}]},{"tag":"h1","props":{"lang":"ru"},"children":["При трудоустройстве стоит самостоятельно упомянуть о наличии удостоверения инвалида — это позволит работодателю сэкономить деньги"]},{"tag":"p","props":{"lang":"ru","className":"life-entry-summary"},"children":["Работодатели обязаны трудоустраивать инвалидов в количестве не менее 1,5 % от общего числа сотрудников; точный процент устанавливается властями каждого региона. Если этот показатель не достигается, компания вынуждена платить специальный сбор за трудоустройство инвалидов, рассчитываемый исходя из средней годовой зарплаты сотрудников за прошлый год. Следовательно, найм таких специалистов — это не только проявление социальной ответственности, но и реальная экономия средств. Упомянув о наличии удостоверения во время собеседования, вы поможете работодателю самостоятельно произвести такие расчёты."]},{"tag":"div","props":{"className":"life-en