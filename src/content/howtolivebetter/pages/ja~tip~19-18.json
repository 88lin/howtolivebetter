"children":[]},{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},{"tag":"span","props":{},"children":["ログイン"]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/ja/book/19"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"目次に戻る"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["在職、離職、および労災"]},{"tag":"nav","props":{"aria-label":"この章のヒント"},"children":[{"tag":"a","props":{"href":"/ja/tip/19-01"},"children":[{"tag":"span","props":{},"children":["01"]},"残業代は 1.5 倍、2 倍、3 倍の3段階で計算されます。支払われない場合は労働監督署へ通報を。期限内に支払わない場合は 50% から 100% の追加支払い義務が生じます"]},{"tag":"a","props":{"href":"/ja/tip/19-02"},"children":[{"tag":"span","props":{},"children":["02"]},"年次有給休暇は累計勤続年数に基づき 5、10、15 日付与され、消化できなかった場合は日給の 300% で手当が支払われます"]},{"tag":"a","props":{"href":"/ja/tip/19-03"},"children":[{"tag":"span","props":{},"children":["03"]},"試用期間には法定の上限があり、給与は 80% を下回ってはならず、かつ一度しか設定できません"]},{"tag":"a","props":{"href":"/ja/tip/19-04"},"children":[{"tag":"span","props":{},"children":["04"]},"解雇時のN（経済補償金）の計算方法：勤続1年につき1ヶ月分の給与、6ヶ月未満は半月分"]},{"tag":"a","props":{"href":"/ja/tip/19-05"},"children":[{"tag":"span","props":{},"children":["05"]},"会社が 30 日前に通知せず解雇する場合、さらに1ヶ月分の給与を支払う必要がある"]},{"tag":"a","props":{"href":"/ja/tip/19-06"},"children":[{"tag":"span","props":{},"children":["06"]},"不当解雇（違法解雇）の場合、賠償金は経済補償金基準の2倍となる"]},{"tag":"a","props":{"href":"/ja/tip/19-07"},"children":[{"tag":"span","props":{},"children":["07"]},"「自己都合による自主退職」にはサインしないでください。一度サインしてしまうと、解雇予告手当（N）がもらえなくなります"]},{"tag":"a","props":{"href":"/ja/tip/19-08"},"children":[{"tag":"span","props":{},"children":["08"]},"退職前に、給与明細、勤怠記録、労働契約書、社会保険の記録、およびチャットの履歴を保存しておきましょう"]},{"tag":"a","props":{"href":"/ja/tip/19-09"},"children":[{"tag":"span","props":{},"children":["09"]},"粉塵、騒音、化学物質を扱う業務に就く前に、契約書に危害に関する記載があるか確認しましょう。3回の職業健康診断は会社が手配し、費用を負担します"]},{"tag":"a","props":{"href":"/ja/tip/19-10"},"children":[{"tag":"span","props":{},"children":["10"]},"粉塵、騒音、化学毒物による損傷は不可逆：防護具は会社が提供しなければならず、防護措置のない作業は拒否できる"]},{"tag":"a","props":{"href":"/ja/tip/19-11"},"children":[{"tag":"span","props":{},"children":["11"]},"仕事中の負傷や通勤中の交通事故、まず最初に行うべきは労災認定。会社が申請しない場合は自分で申請できる"]},{"tag":"a","props":{"href":"/ja/tip/19-12"},"children":[{"tag":"span","props":{},"children":["12"]},"「出勤した時点で労災」を信じないで：急な体調不良時は、まず 120 へ。打刻のために急いで向かうのではなく。"]},{"tag":"a","props":{"href":"/ja/tip/19-13"},"children":[{"tag":"span","props":{},"children":["13"]},"会社が労災保険に加入していなくても、労災補償は受けられます。会社が同等の基準で全額負担します"]},{"tag":"a","props":{"href":"/ja/tip/19-14"},"children":[{"tag":"span","props":{},"children":["14"]},"症状が安定した後に労働能力鑑定を行い、障害等級を直接金額に換算する"]},{"tag":"a","props":{"href":"/ja/tip/19-15"},"children":[{"tag":"span","props":{},"children":["15"]},"労災死亡における3つの給付を明確に区別すること：葬儀補助金、扶養家族年金、一回限り労災死亡補助金"]},{"tag":"a","props":{"href":"/ja/tip/19-16"},"children":[{"tag":"span","props":{},"children":["16"]},"職場で長期にわたりいじめ、罵倒、嫌がらせを受けている場合、一人で耐え込まないこと：まずは証拠を残すために記録し、その性質に応じて、苦情申し立て、通報、または仲裁の手続きを進めること"]},{"tag":"a","props":{"href":"/ja/tip/19-17"},"children":[{"tag":"span","props":{},"children":["17"]},"退職時には会社に離職証明書を請求すること。契約期間、退職日、職種、勤続年数を明記させること"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/ja/tip/19-18","data-status":"active"},"children":[{"tag":"span","props":{},"children":["18"]},"退職補償金を受け取る際はまず所得税を確認：現地の前年度従業員平均賃金の3倍以内は非課税、超過分は別途計算され、当年の給与とは合算されない"]},{"tag":"a","props":{"href":"/ja/tip/19-19"},"children":[{"tag":"span","props":{},"children":["19"]},"別の都市で働くときは、年金保険と医療保険の加入関係を新しい加入地へ移す。納付年数は累計されるので、脱退しない"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"現在地"},"children":[{"tag":"a","props":{"href":"/ja/book"},"children":["本を読む"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/ja/book/19"},"children":["第19章"," ·"," ","在職、離職、および労災"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"19-18"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["18"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["エビデンス"," ","A"]}]},{"tag":"h1","props":{"lang":"ja"},"children":["退職補償金を受け取る際はまず所得税を確認：現地の前年度従業員平均賃金の3倍以内は非課税、超過分は別途計算され、当年の給与とは合算されない"]},{"tag":"p","props":{"lang":"ja","className":"life-entry-summary"},"children":["労働契約の解除に伴い受け取る一時的な補償金のうち、現地の前年度従業員平均賃金の3倍以内の部分には所得税がかかりません。超過した部分については、当年の給与と合算せずに別途税額を計算します。もし会社が全額を当月の給与に合算して税金を差し引いている場合は、まず会社に詳細を確認し、その上で12366に電話して税務局に問い合わせてください。"]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["費用・手間"]},{"tag":"p","props":{},"children":["費用はかかりません。現地の前年度従業員平均賃金を確認し、会社がどのように税金を控除しているかを数分かけて照合するだけ…"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["効果"]},{"tag":"p","props":{},"children":["財政部および国家税務総局の規定により、個人と雇用主との間の労働関係の解除に伴い受け取る一時的な補償収入（経済補償金、生活補助費、およびその他の補助費を含む）のうち、現地の前年度従業員平均賃金の3倍以内の部分については、個…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"記録する：退職補償金を受け取る際はまず所得税を確認：現地の前年度従業員平均賃金の3倍以内は非課税、超過分は別途計算され、当年の給与とは合算されない"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"できている"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"やることに追加"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"お気に入り"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"このヒントを共有"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"詳細を閉じる"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["費用・手間"]},{"tag":"p","props":{},"children":["費用はかかりません。現地の前年度従業員平均賃金を確認し、会社がどのように税金を控除しているかを数分かけて照合するだけです。個人所得税App（個人所得税App）にて、各収入の申告明細を確認できます。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["効果"]},{"tag":"p","props":{},"children":["財政部および国家税務総局の規定により、個人と雇用主との間の労働関係の解除に伴い受け取る一時的な補償収入（経済補償金、生活補助費、およびその他の補助費を含む）のうち、現地の前年度従業員平均賃金の3倍以内の部分については、個人所得税が免除されます。3倍を超えた部分については、当年の総合所得に合算せず、別途、総合所得税率表に基づいて計算されます。この税率表では、年間36000元以内の部分は税率3%、36000元から144000元の部分は10%、それ以上は段階的に45%まで加算されます。例を挙げると、現地の前年度従業員平均賃金が10万元の場合、3倍は30万元です。もし36万元の補償金を受け取った場合、超過した6万元に対してのみ課税され、税額は3480元となります。同様に、36万元の全額をこの表に基づいて計算した場合は、58080元となります。この規定は2019年1月1日から施行されており、終了日は明記されていません（全国適用）。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["出典"]},{"tag":"p","props":{"className":"life-citations"},"children":["财政部、税务总局 (2018). 关于个人所得税法修改后有关优惠政策衔接问题的通知（财税〔2018〕164 号，第五条第（一）项、第八条、第九条）. ",{"tag":"a","props":{"href":"https://fgk.chinatax.gov.cn/zcfgk/c102416/c5202364/content.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://fgk.chinatax.gov.cn/zcfgk/c102416/c5202364/content.html"]},"（国家税务总局政策法规库）；财政部、税务总局 (2023). 关于延续实施全年一次性奖金个人所得税政策的公告（2023 年第 30 号）. ",{"tag":"a","props":{"href":"https://fgk.chinatax.gov.cn/zcfgk/c102416/c5211524/content.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://fgk.chinatax.gov.cn/zcfgk/c102416/c5211524/content.html"]},"（国家税务总局政策法规库）；全国人大常委会 (2018 修正). 个人所得税法（第三、九条，个人所得税税率表一）. ",{"tag":"a","props":{"href":"https://flk.npc.gov.cn/detail?id=2c909fdd678bf17901678bf724bd0609","target":"_blank","rel":"noopener noreferrer"},"children":["https://flk.npc.gov.cn/detail?id=2c909fdd678bf17901678bf724bd0609"]}]},{"tag":"a","props":{"href":"https://fgk.chinatax.gov.cn/zcfgk/c102416/c5202364/content.html","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["出典を開く"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["著者の注記"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["同一の文書内において、「年一回限りの一時的なボーナス」の項目には終了日が記載されており、その後2027年12月31日まで延長されました。しかし、「労働関係解除に伴う補償」の項目には終了日が記載されておらず、ボーナスの項目とは扱いが異なります。規定では、経済補償金、生活補助費、およびその他の補助費については明記されていますが、解雇予告手当（代通知金）や不当解雇による賠償金については個別に明記されていません。これら2つの項目が対象に含まれるか判断に迷う場合は、12366に電話して現地の税務局に問い合わせてください。「現地の前年度従業員平均賃金」としてどの数値を用いるかも、現地の税務局の基準に従います。補償金自体の計算方法については、本節の第4条（解雇時はまずNを正確に計算）、第5条（30日前の通知がない場合）、および第6条（不当解雇の賠償金）を参照してください。早期退職や内部退職に伴う一時的な手当には別の計算方法があり、本条の規定は適用されません。"]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["自分のメモ"]},{"tag":"button","props":{"type":"button"},"children":["自分へのメモを書く…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/ja/tip/19-17"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["前へ"]},"退職時には会社に離職証明書を請求すること。契約期間、退職日、職種、勤続年数を明記させること"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/ja/tip/19-19"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["次へ"]},"別の都市で働くときは、年金保険と医療保険の加入関係を新しい加入地へ移す。納付年数は累計されるので、脱退しない"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section