 0"},"children":[]},{"tag":"circle","props":{"cx":"12","cy":"10","r":"4"},"children":[]},{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},{"tag":"span","props":{},"children":["Sign in to sync"]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/en/book/12"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"Back to index"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["Starting a business: how to protect your personal assets"]},{"tag":"nav","props":{"aria-label":"Chapter entries"},"children":[{"tag":"a","props":{"href":"/en/tip/12-01"},"children":[{"tag":"span","props":{},"children":["01"]},"Only invest money you can afford to lose — never use family savings or borrowed funds"]},{"tag":"a","props":{"href":"/en/tip/12-02"},"children":[{"tag":"span","props":{},"children":["02"]},"Never sign personal guarantees for corporate loans; spouses should definitely avoid signing too"]},{"tag":"a","props":{"href":"/en/tip/12-03"},"children":[{"tag":"span","props":{},"children":["03"]},"Choosing the right legal entity before launching: sole proprietors and general partners are fully liable, while limited liability companies offer “limited” liability"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/en/tip/12-04","data-status":"active"},"children":[{"tag":"span","props":{},"children":["04"]},"Improperly listed shareholders: never hold shares on someone else’s behalf"]},{"tag":"a","props":{"href":"/en/tip/12-05"},"children":[{"tag":"span","props":{},"children":["05"]},"Check the Ministry of Commerce records before signing; obtain written disclosures and include a “cooling-off period” in the contract"]},{"tag":"a","props":{"href":"/en/tip/12-06"},"children":[{"tag":"span","props":{},"children":["06"]},"Determine the business name, location, scope of operations, and registered capital before registration; with complete documents, you can obtain the business license on the spot"]},{"tag":"a","props":{"href":"/en/tip/12-07"},"children":[{"tag":"span","props":{},"children":["07"]},"Businesses requiring licenses must wait until they obtain one"]},{"tag":"a","props":{"href":"/en/tip/12-08"},"children":[{"tag":"span","props":{},"children":["08"]},"Figure out which category you fall into: producing or preparing food requires a permit, selling only pre-packaged goods needs a filing, while selling fresh meat and vegetables needs no permit at all"]},{"tag":"a","props":{"href":"/en/tip/12-09"},"children":[{"tag":"span","props":{},"children":["09"]},"Packaging food for sale makes it prepackaged food: labels must include production date, shelf life, and ingredient list without exception"]},{"tag":"a","props":{"href":"/en/tip/12-10"},"children":[{"tag":"span","props":{},"children":["10"]},"General foods must not claim therapeutic effects: this applies to labels, instructions, ads, and live-stream scripts alike"]},{"tag":"a","props":{"href":"/en/tip/12-11"},"children":[{"tag":"span","props":{},"children":["11"]},"The food industry faces criminal penalties: selling meat from diseased animals or products exceeding safety limits is already a crime; adding toxic or harmful non-food substances carries a minimum five-year sentence regardless of revenue"]},{"tag":"a","props":{"href":"/en/tip/12-12"},"children":[{"tag":"span","props":{},"children":["12"]},"Once you obtain a business license, you must file tax returns on schedule — even if you have no income, you still need to submit a return with all zeros"]},{"tag":"a","props":{"href":"/en/tip/12-13"},"children":[{"tag":"span","props":{},"children":["13"]},"Invoices must reflect actual transactions; small taxpayers can fully utilize tax exemptions"]},{"tag":"a","props":{"href":"/en/tip/12-14"},"children":[{"tag":"span","props":{},"children":["14"]},"Scammers pretending to be tax officials demanding payments are fraudsters; tax filings must be done via the e-Tax Service or by calling 12366"]},{"tag":"a","props":{"href":"/en/tip/12-15"},"children":[{"tag":"span","props":{},"children":["15"]},"Writing “deposit” instead of “advance payment” in contracts, specifying penalty amounts, and treating credit terms as loans"]},{"tag":"a","props":{"href":"/en/tip/12-16"},"children":[{"tag":"span","props":{},"children":["16"]},"Sign a written contract within the first month of employment; register for social insurance within 30 days"]},{"tag":"a","props":{"href":"/en/tip/12-17"},"children":[{"tag":"span","props":{},"children":["17"]},"Wages must be paid according to contracts and laws; raises, loans, and bonuses all require written documentation"]},{"tag":"a","props":{"href":"/en/tip/12-18"},"children":[{"tag":"span","props":{},"children":["18"]},"Sell first, then produce: use pre-orders and small orders to confirm demand before investing in manufacturing"]},{"tag":"a","props":{"href":"/en/tip/12-19"},"children":[{"tag":"span","props":{},"children":["19"]},"Run the prototype through the production checklist before starting full production"]},{"tag":"a","props":{"href":"/en/tip/12-20"},"children":[{"tag":"span","props":{},"children":["20"]},"Keep copies of invoices and supplier documentation for every shipment; avoid purchasing goods priced significantly below market rates: if an employee buys counterfeit products, the employer can still be held legally responsible"]},{"tag":"a","props":{"href":"/en/tip/12-21"},"children":[{"tag":"span","props":{},"children":["21"]},"Whether creating designs yourself or purchasing licensed artwork, simply changing colors or adding icons does not count as “modifications” for copyright purposes"]},{"tag":"a","props":{"href":"/en/tip/12-22"},"children":[{"tag":"span","props":{},"children":["22"]},"Follow procedures at work; think carefully about who bears responsibility before offering unsolicited help"]},{"tag":"a","props":{"href":"/en/tip/12-23"},"children":[{"tag":"span","props":{},"children":["23"]},"Exit the process as planned when losses occur: opt for simplified deregistration when possible, or file for bankruptcy if debts exceed assets — don’t leave things unattended"]},{"tag":"a","props":{"href":"/en/tip/12-24"},"children":[{"tag":"span","props":{},"children":["24"]},"Before paying for third‑party store management, e‑commerce training, or “dropshipping” services, be sure to ask whether extra fees will be required and where the sales figures actually come from"]},{"tag":"a","props":{"href":"/en/tip/12-25"},"children":[{"tag":"span","props":{},"children":["25"]},"Companies and individual businesses in China must report the previous year online from January 1 to June 30, even without business activity; annual reports are free"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"Breadcrumb"},"children":[{"tag":"a","props":{"href":"/en/book"},"children":["Explore the book"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/en/book/12"},"children":["Chapter 12"," ·"," ","Starting a business: how to protect your personal assets"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"12-04"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["04"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["Evidence"," ","A"]}]},{"tag":"h1","p