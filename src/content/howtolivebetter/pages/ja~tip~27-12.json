,{"tag":"a","props":{"href":"/ja/tip/27-10"},"children":[{"tag":"span","props":{},"children":["10"]},"医学的適応がない限り、積極的に帝王切開を求めないでください。また、日取りを選ぶために手術を行うことも避けてください"]},{"tag":"a","props":{"href":"/ja/tip/27-11"},"children":[{"tag":"span","props":{},"children":["11"]},"妊娠前に出産保険の加入状況を確認しておきましょう。未就業の配偶者も出産医療費の請求が可能です"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/ja/tip/27-12","data-status":"active"},"children":[{"tag":"span","props":{},"children":["12"]},"退院前に「出生医学証明書」を済ませましょう。名前は事前に考えておき、誤字がないようにしてください"]},{"tag":"a","props":{"href":"/ja/tip/27-13"},"children":[{"tag":"span","props":{},"children":["13"]},"新生児の踵（かかと）採血スクリーニングと聴覚スクリーニングは、どちらも拒否しないでください"]},{"tag":"a","props":{"href":"/ja/tip/27-14"},"children":[{"tag":"span","props":{},"children":["14"]},"出生医学証明書を受け取ったらすぐに子供の住民医療保険に加入しましょう。戸籍登録（落戸）を待たないでください"]},{"tag":"a","props":{"href":"/ja/tip/27-15"},"children":[{"tag":"span","props":{},"children":["15"]},"子供の出生後、一ヶ月以内に派出所へ出生届を提出してください"]},{"tag":"a","props":{"href":"/ja/tip/27-16"},"children":[{"tag":"span","props":{},"children":["16"]},"産後 42 日のこの検診を飛ばさないで。産後うつのスクリーニングでもあります"]},{"tag":"a","props":{"href":"/ja/tip/27-17"},"children":[{"tag":"span","props":{},"children":["17"]},"妊娠しても猫を手放す必要はない。猫砂は毎日ほかの人が掃除し、肉を十分加熱し、土には手袋を使う"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"現在地"},"children":[{"tag":"a","props":{"href":"/ja/book"},"children":["本を読む"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/ja/book/27"},"children":["第27章"," ·"," ","妊娠と出産：妊娠の判明から退院・手続きまで"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"27-12"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["12"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["エビデンス"," ","A"]}]},{"tag":"h1",