}]}]}]}]},{"tag":"div","props":{"className":"life-ad-layout life-ad-layout-toc"},"children":[{"tag":"div","props":{"className":"life-ad-rail","data-dock-active":"false","style":{"top":"94px"}},"children":[{"tag":"div","props":{"className":"life-ad-dock","hidden":true},"children":[{"tag":"aside","props":{"className":"life-ad-space life-ad-space-sponsored life-ad-space-compact","data-ad-placement":"ad_dock","data-ad-group":"reading","data-ad-creative":"read_product","data-ad-ready":"false","aria-label":"Publicidad · Comunidad recomendada"},"children":[{"tag":"button","props":{"type":"button","className":"life-ad-dismiss","aria-label":"Cerrar anuncio"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-x","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M18 6 6 18"},"children":[]},{"tag":"path","props":{"d":"m6 6 12 12"},"children":[]}]}]},{"tag":"div","props":{"className":"life-ad-space-brand"},"children":[{"tag":"img","props":{"src":"/sites/howtolivebetter/images/shengcai/logo.png","width":"565","height":"144","alt":"Logotipo oficial de Shengcai Youshu","decoding":"async"},"children":[]}]},{"tag":"div","props":{"className":"life-ad-space-copy"},"children":[{"tag":"span","props":{"className":"life-ad-space-label"},"children":["Publicidad · Comunidad recomendada"]},{"tag":"strong","props":{},"children":["¿Podría lo que sabes convertirse en un producto útil?"]},{"tag":"p","props":{},"children":["De libros digitales a herramientas: descubre cómo detectan necesidades y crean algo que otros pueden usar."]}]},{"tag":"div","props":{"className":"life-ad-space-actions"},"children":[{"tag":"a","props":{"className":"life-ad-space-link","href":"/es/shengcaiyoushu?sc_group=reading&sc_creative=read_product&sc_placement=ad_dock"},"children":["Ver la comunidad y ejemplos",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"18","height":"18","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-up-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M7 7h10v10"},"children":[]},{"tag":"path","props":{"d":"M7 17 17 7"},"children":[]}]}]}]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/es/book/19"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"Volver al índice"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["Empleo, salida del empleo y accidentes de trabajo"]},{"tag":"div","props":{"data-ad-dock-host":"true"},"children":[]},{"tag":"nav","props":{"aria-label":"Consejos del capítulo"},"children":[{"tag":"a","props":{"href":"/es/tip/19-01"},"children":[{"tag":"span","props":{},"children":["01"]},"Las horas extra se pagan en tres tramos (1,5, 2 y 3 veces); si no las pagan, denuncia ante la inspección de trabajo, y fuera de plazo deben añadir entre un 50% y un 100% más"]},{"tag":"a","props":{"href":"/es/tip/19-02"},"children":[{"tag":"span","props":{},"children":["02"]},"Las vacaciones anuales se calculan por antigüedad acumulada: 5, 10 o 15 días; las que no se toman se pagan al 300% del salario diario"]},{"tag":"a","props":{"href":"/es/tip/19-03"},"children":[{"tag":"span","props":{},"children":["03"]},"El período de prueba tiene un límite legal, el salario no puede bajar del 80% y solo puede pactarse una vez"]},{"tag":"a","props":{"href":"/es/tip/19-04"},"children":[{"tag":"span","props":{},"children":["04"]},"Ante un despido, calcula primero N: un mes de salario por cada año cumplido, y medio mes si es menos de seis meses"]},{"tag":"a","props":{"href":"/es/tip/19-05"},"children":[{"tag":"span","props":{},"children":["05"]},"Si la empresa no avisó con 30 días de antelación, debe pagar un mes de salario más"]},{"tag":"a","props":{"href":"/es/tip/19-06"},"children":[{"tag":"span","props":{},"children":["06"]},"Si la empresa rescinde el contrato ilegalmente, la indemnización es el doble de la compensación económica"]},{"tag":"a","props":{"href":"/es/tip/19-07"},"children":[{"tag":"span","props":{},"children":["07"]},"No firmes «renuncia voluntaria por motivos personales»: al firmar se pierde la N"]},{"tag":"a","props":{"href":"/es/tip/19-08"},"children":[{"tag":"span","props":{},"children":["08"]},"Antes de salir, guarda tus nóminas, tu control de asistencia, el contrato laboral, los registros de la seguridad social y los chats"]},{"tag":"a","props":{"href":"/es/tip/19-09"},"children":[{"tag":"span","props":{},"children":["09"]},"Antes de entrar en un puesto con polvo, ruido o productos químicos, mira si el contrato declara los riesgos; los tres exámenes de salud los organiza y paga la empresa"]},{"tag":"a","props":{"href":"/es/tip/19-10"},"children":[{"tag":"span","props":{},"children":["10"]},"Las lesiones causadas por el polvo, el ruido y las sustancias químicas son irreversibles: la empresa debe proporcionar equipos de protección y se puede rechazar trabajar sin medidas de protección"]},{"tag":"a","props":{"href":"/es/tip/19-11"},"children":[{"tag":"span","props":{},"children":["11"]},"Si te lesionas en el trabajo o te atropellan camino al trabajo, lo primero es el reconocimiento del accidente laboral; si la empresa no lo solicita, hazlo tú"]},{"tag":"a","props":{"href":"/es/tip/19-12"},"children":[{"tag":"span","props":{},"children":["12"]},"No creas «si aguanto hasta llegar a mi puesto cuenta como accidente»: ante un malestar súbito, llama primero al 120, no corras primero a fichar"]},{"tag":"a","props":{"href":"/es/tip/19-13"},"children":[{"tag":"span","props":{},"children":["13"]},"Si la empresa no te cotizó el seguro de accidentes laborales, las prestaciones existen igual, pagadas íntegras por la empresa con los mismos estándares"]},{"tag":"a","props":{"href":"/es/tip/19-14"},"children":[{"tag":"span","props":{},"children":["14"]},"Cuando la lesión se estabiliza, pide la valoración de la capacidad laboral: el grado de discapacidad se convierte directamente en dinero"]},{"tag":"a","props":{"href":"/es/tip/19-15"},"children":[{"tag":"span","props":{},"children":["15"]},"Hay que distinguir entre tres tipos de indemnizaciones por fallecimiento laboral: subsidio funerario, pensión para familiares a cargo y subsidio único por fallecimiento laboral"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/es/tip/19-16","data-status":"active"},"children":[{"tag":"span","props":{},"children":["16"]},"Si en el trabajo sufres acoso, insultos o maltrato continuo, no lo aguantes: primero anota todo como prueba y luego actúa según la naturaleza del caso, ya sea presentando una queja, llamando a la policía o acudiendo al tribunal laboral"]},{"tag":"a","props":{"href":"/es/tip/19-17"},"children":[{"tag":"span","props":{},"children":["17"]},"Al dejar el trabajo, pida al empleador un certificado de baja con plazo del contrato, fecha de salida, puesto y años de servicio"]},{"tag":"a","props":{"href":"/es/tip/19-18"},"children":[{"tag":"span","props":{},"children":["18"]},"Al recibir la indemnización por despido, revise el IRPF: lo que no supere el triple del salario medio de empleados del año anterior en la localidad está exento; el exceso se tributa aparte, no sumado al salario del año"]},{"tag":"a","props":{"href":"/es/tip/19-19"},"children":[{"tag":"span","props":{},"children":["19"]},"Al cambiar de ciudad por trabajo, traslada los seguros de pensiones y médico al nuevo lugar de afiliación: los años cotizados se acumulan; no canceles la afiliación para retirar el dinero"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"Ruta de navegación"},"children":[{"tag":"a","props":{"href":"/es/book"},"children":["Libro"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/es/book/19"},"children":["Capítulo 19"," ·"," ","Empleo, salida del empleo y accidentes de trabajo"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"19-16"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["16"]},{"tag":"span","props":{"className":"life-evidence grade-b"},"children":["Evidencia"," ","B"]}]},{"tag":"h1","props":{"lang":"es"},"children":["Si en el trabajo sufres acoso, insultos o maltrato continuo, no lo aguantes: primero anota todo como prueba y luego actúa según la naturaleza del caso, ya sea presentando una queja, llamando a la policía o acudiendo al tribunal laboral"]},{"tag":"p","props":{"lang":"es","className":"life-entry-summary"},"children":["Las personas que sufren acoso laboral tienen un riesgo aproximadamente un 60 % mayor de padecer enfermedades cardíacas o derrames cerebrales; cuanto más acoso reciben, mayor es ese riesgo. Además, a los pocos años, la probabilidad de que piensen en suicidarse es unas 2 veces la de otras personas. Los insultos y humillaciones no son meros inconvenientes que se puedan ignorar sin más."]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Coste"]},{"tag":"p","props":{},"children":["No cuesta dinero. Sí requiere tiempo para registrar: fecha…"]}]