-layout life-ad-layout-toc"},"children":[{"tag":"div","props":{"className":"life-ad-rail","data-dock-active":"false","style":{"top":"94px"}},"children":[{"tag":"div","props":{"className":"life-ad-dock","hidden":true},"children":[{"tag":"aside","props":{"className":"life-ad-space life-ad-space-sponsored life-ad-space-compact","data-ad-placement":"ad_dock","data-ad-group":"reading","data-ad-creative":"read_product","data-ad-ready":"false","aria-label":"Quảng cáo · Giới thiệu cộng đồng"},"children":[{"tag":"button","props":{"type":"button","className":"life-ad-dismiss","aria-label":"Đóng quảng cáo"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-x","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M18 6 6 18"},"children":[]},{"tag":"path","props":{"d":"m6 6 12 12"},"children":[]}]}]},{"tag":"div","props":{"className":"life-ad-space-brand"},"children":[{"tag":"img","props":{"src":"/sites/howtolivebetter/images/shengcai/logo.png","width":"565","height":"144","alt":"Logo chính thức của Shengcai Youshu","decoding":"async"},"children":[]}]},{"tag":"div","props":{"className":"life-ad-space-copy"},"children":[{"tag":"span","props":{"className":"life-ad-space-label"},"children":["Quảng cáo · Giới thiệu cộng đồng"]},{"tag":"strong","props":{},"children":["Kiến thức bạn có thể thành sản phẩm hữu ích không?"]},{"tag":"p","props":{},"children":["Từ sách điện tử đến công cụ nhỏ: xem cách thành viên tìm nhu cầu và biến kiến thức thành thứ dùng được."]}]},{"tag":"div","props":{"className":"life-ad-space-actions"},"children":[{"tag":"a","props":{"className":"life-ad-space-link","href":"/vi/shengcaiyoushu?sc_group=reading&sc_creative=read_product&sc_placement=ad_dock"},"children":["Xem cộng đồng và các ví dụ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"18","height":"18","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-up-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M7 7h10v10"},"children":[]},{"tag":"path","props":{"d":"M7 17 17 7"},"children":[]}]}]}]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/vi/book/09"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"Quay lại mục lục"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["Vạch đỏ pháp lý dân dân thường dễ vấp"]},{"tag":"div","props":{"data-ad-dock-host":"true"},"children":[]},{"tag":"nav","props":{"aria-label":"Các mục trong chương"},"children":[{"tag":"a","props":{"href":"/vi/tip/09-01"},"children":[{"tag":"span","props":{},"children":["01"]},"Không chuyển tiếp tin về thiên tai, dịch bệnh hay sự cố công an không rõ thật giả trong nhóm, không chỉnh sửa ảnh, không dùng AI dựng ảnh hiện trường giả"]},{"tag":"a","props":{"href":"/vi/tip/09-02"},"children":[{"tag":"span","props":{},"children":["02"]},"Không đăng, không chuyển tiếp ảnh, biểu tượng cảm xúc và bình luận xúc phạm liệt sĩ, không đùa cợt với cờ đỏ và quốc ca"]},{"tag":"a","props":{"href":"/vi/tip/09-03"},"children":[{"tag":"span","props":{},"children":["03"]},"Xem xong trên trang nước ngoài thì đóng lại, không chụp màn hình, không chuyển tiếp, không chuyển vào nhóm, cũng không nói theo ở phần bình luận"]},{"tag":"a","props":{"href":"/vi/tip/09-04"},"children":[{"tag":"span","props":{},"children":["04"]},"Video khiêu dâm thì tự xem ở nhà, đừng gửi vào nhóm, đừng bán「tư liệu」, đừng lập nhóm"]},{"tag":"a","props":{"href":"/vi/tip/09-05"},"children":[{"tag":"span","props":{},"children":["05"]},"Việc「làm thêm」bảo bạn dùng thẻ của mình để nhận tiền, rút tiền, chuyển khoản thì không làm, dù được trả bao nhiêu hoa hồng"]},{"tag":"a","props":{"href":"/vi/tip/09-06"},"children":[{"tag":"span","props":{},"children":["06"]},"Có người rủ bạn làm「bọc vật liệu」để vay tiền, chia hoa hồng theo khoản vay, thì không làm việc nào cả"]},{"tag":"a","props":{"href":"/vi/tip/09-07"},"children":[{"tag":"span","props":{},"children":["07"]},"Nhặt được thẻ ngân hàng thì không rút tiền; nhặt được điện thoại, ví thì liên lạc chủ nhân hoặc giao cho công an, không giữ lại"]},{"tag":"a","props":{"href":"/vi/tip/09-08"},"children":[{"tag":"span","props":{},"children":["08"]},"Ưu đãi thì lấy bằng chính danh tính thật của bạn; không mua số ảo để đăng ký hàng loạt tài khoản nhỏ, không dựa lỗ hổng để lấy lặp"]},{"tag":"a","props":{"href":"/vi/tip/09-09"},"children":[{"tag":"span","props":{},"children":["09"]},"Không ném bất cứ thứ gì ra ngoài từ ban công, cửa sổ; đầu thuốc lá, túi rác, chai rượu đều tính"]},{"tag":"a","props":{"href":"/vi/tip/09-10"},"children":[{"tag":"span","props":{},"children":["10"]},"Không mua súng nhựa, súng bi, súng hơi trên mạng; không mua「súng đồ chơi」không rõ nguồn gốc"]},{"tag":"a","props":{"href":"/vi/tip/09-11"},"children":[{"tag":"span","props":{},"children":["11"]},"Mua máy bay không cân thì đăng ký tên thật trước; không bay ở sân bay, khu quân sự và không gian bị kiểm soát của thành phố; không phá giới hạn chiều cao"]},{"tag":"a","props":{"href":"/vi/tip/09-12"},"children":[{"tag":"span","props":{},"children":["12"]},"Không chụp lén người khác, không lắp camera trong phòng thuê, nhà nghỉ, phòng khách sạn"]},{"tag":"a","props":{"href":"/vi/tip/09-13"},"children":[{"tag":"span","props":{},"children":["13"]},"Chơi mậu thẩu, bài poker thì được; không ăn phần trăm, không làm cái, không tổ chức bàn thu tiền, không chơi cờ bạc trên mạng"]},{"tag":"a","props":{"href":"/vi/tip/09-14"},"children":[{"tag":"span","props":{},"children":["14"]},"Không ăn thịt hoang dã, không mua bán, không nuôi động vật được bảo vệ làm thú cưng"]},{"tag":"a","props":{"href":"/vi/tip/09-15"},"children":[{"tag":"span","props":{},"children":["15"]},"Đòi nợ thì không giữ người, không giam người, không đuổi theo tới nhà ở"]},{"tag":"a","props":{"href":"/vi/tip/09-16"},"children":[{"tag":"span","props":{},"children":["16"]},"Không cho mượn thẻ căn cước, không dùng thẻ căn cước của người khác, cũng không lấy giấy tờ của người khác để đăng ký, mở thẻ, mua vé"]},{"tag":"a","props":{"href":"/vi/tip/09-17"},"children":[{"tag":"span","props":{},"children":["17"]},"Khi bị công an chặn hoặc đưa đi thì hợp tác, không đẩy, không đánh, không giật máy quay của người thi hành; đã uống rượu thì càng phải nhịn"]},{"tag":"a","props":{"href":"/vi/tip/09-18"},"children":[{"tag":"span","props":{},"children":["18"]},"Người kia chưa đủ 14 tuổi thì không được quan hệ tình dục; câu「cô ấy đồng ý」không phải là lý do"]},{"tag":"a","props":{"href":"/vi/tip/09-19"},"children":[{"tag":"span","props":{},"children":["19"]},"Trước khi ra tay, tính rõ cái giá: bị giữ, phải bồi, kết án"]},{"tag":"a","props":{"href":"/vi/tip/09-20"},"children":[{"tag":"span","props":{},"children":["20"]},"Sinh con ra không nuôi nổi thì lối thoát hợp pháp chỉ có một: đăng ký nhận nuôi ở cơ quan dân vụ; nhận tiền rồi đưa con cho người khác có thể bị kết án về tội bán trẻ em, bỏ trẻ không chăm thì là tội bỏ bê"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/vi/tip/09-21","data-status":"active"},"children":[{"tag":"span","props":{},"children":["21"]},"Không bịa tai nạn, không phóng đại thiệt hại để lừa bồi thường: đó là tội lừa đảo bảo hiểm, và người làm chứng, sửa xe, giám định giúp bạn cùng bị tính"]},{"tag":"a","props":{"href":"/vi/tip/09-22"},"children":[{"tag":"span","props":{},"children":["22"]},"Không bán cơ quan của mình, cũng đừng đi tìm người hiến cho người khác: thận bán được hơn 2 vạn tệ, cùng một quả bán cho bệnh nhân tới 20 vạn tệ, tiền bị tịch thu lại còn phạt theo giao dịch 10 đến 20 lần"]},{"tag":"a","props":{"href":"/vi/tip/09-23"},"children":[{"tag":"span","props":{},"children":["23"]},"Đừng đi mại dâm: mức mặc định là giam 10 đến 15 ngày, không phải phạt chút tiền là xong"]},{"tag":"a","props":{"href":"/vi/tip/09-24"},"children":[{"tag":"span","props":{},"children":["24"]},"Dịch truyện tranh, đăng lại phim, chia sẻ tệp trên đám mây hoặc ebook lậu vẫn xâm phạm bản quyền dù miễn phí; quảng cáo hay phí thành viên có thể dẫn đến án hình sự"]},{"tag":"a","props":{"href":"/vi/tip/09-25"},"children":[{"tag":"span","props":{},"children":["25"]},"Xuất bản hoặc bán fanfic và tác phẩm phái sinh: hãy xin phép chủ sở hữu tác phẩm gốc, hoặc tự tạo lại tên, tính cách và quan hệ nhân vật"]},{"tag":"a","props":{"href":"/vi/tip/09-26"},"children":[{"tag":"span","props":{},"children":["26"]},"Đừng mua gậy rút, dụng cụ điện giật, dao găm, bình xịt hơi cay để mang theo tự vệ; để trong xe cũng tính mang theo"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"Breadcrumbs"},"children":[{"tag":"a","props":{"href":"/vi/book"},"children":["Khám phá cuốn sách"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/vi/book/09"},"children":["Chương 9"," ·"," ","Vạch đỏ pháp lý dân dân thường dễ vấp"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"09-21"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["21"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["Bằng chứng"," ","A"]}]},{"tag":"h1","props":{"lang":"vi"},"children":["Không bịa tai nạn, không phóng đại thiệt hại để lừa bồi thường: đó là tội lừa đảo bảo hiểm, và người làm chứng, sửa xe, giám định giúp bạn cùng bị tính"]},{"tag":"p","props":{"lang":"vi","className":"life-entry-summary"},"children":["Bịa tai nạn, phóng đại thiệt hại để lừa bồi thường là tội lừa đảo bảo hiểm, số tiền lớn thì phạt tù dưới 5 năm, còn phạt tiền 1 vạn đến 10 vạn tệ. Người làm chứng, giám định, định giá tài sản giúp bạn mà cố ý đưa ra chứng từ giả thì bị quy kết là đồng phạm cùng bạn. Trong một vụ án ở Tuyên Thành, tỉnh An Huy, 8 người bị phạt tù từ 2 đến 4 năm, mỗi người phạt tiền 1 vạn tệ."]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Chi phí"]},{"tag":"p","props":{},"children":["Không tốn tiền, cũng không mất thời gian, không làm là xon…"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Lợi ích"]},{"tag":"p","props":{},"children":["Điều một trăm chín mươi tám của Bộ luật Hình sự liệt kê năm trường hợp. Một: bên mua bảo hiểm cố ý dựng nên đố…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"Đánh dấu: Không bịa tai nạn, không phóng đại thiệt hại để lừa bồi thường: đó là tội lừa đảo bảo hiểm, và người làm chứng, sửa xe, giám định giúp bạn cùng bị tính"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"Hoàn tất"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"Kế hoạch thực hiện"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"Lưu"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Chia sẻ mẹo này"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Ẩn chi tiết"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Chi phí"]},{"tag":"p","props":{},"children":["Không tốn tiền, cũng không mất thời gian, không làm là xong."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Lợi ích"]},{"tag":"p","props":{},"children":["Điều một trăm chín mươi tám của Bộ luật Hình sự liệt kê năm trường hợp. Một: bên mua bảo hiểm cố ý dựng nên đối tượng bảo hiểm, bịa ra một đối tượng tham gia bảo hiểm không hề tồn tại. Hai: bên mua bảo hiểm, bên được bảo hiểm hoặc người hưởng bồi thường bịa nguyên nhân của tai nạn bảo hiểm đã xảy ra, hoặc phóng đại mức độ thiệt hại. Ba: bịa ra một tai nạn bảo hiểm chưa từng xảy ra. Bốn: bên mua bảo hiểm, bên được bảo hiểm cố ý gây ra tai nạn bảo hiểm tổn thất tài sản. Năm: bên mua bảo hiểm, người hưởng bồi thường cố ý gây ra cái chết, thương tích hoặc bệnh tật cho bên được bảo hiểm. Số tiền lớn thì phạt tù dưới 5 năm hoặc giam giữ, kèm phạt tiền từ hơn 1 vạn tệ đến dưới 10 vạn tệ. Số tiền rất lớn hoặc có tình tiết nghiêm trọng khác thì phạt tù 5 đến 10 năm, kèm phạt tiền từ 2 vạn tệ đến 20 vạn tệ. Số tiền đặc biệt lớn hoặc có tình tiết đặc biệt nghiêm trọng khác thì phạt tù trên 10 năm, kèm phạt tiền từ 2 vạn tệ đến 20 vạn tệ hoặc tịch thu tài sản. Khoản cuối của điều này quy cho người giúp việc: người giám định, người làm chứng, người định giá tài sản trong vụ bảo hiểm. Họ cố ý lập chứng từ giả, tạo điều kiện cho người khác lừa bảo hiểm thì bị xử lý như đồng phạm của tội lừa đảo bảo hiểm, quy kết cùng người lừa. Điều hai mươi bảy của Luật Bảo hiểm: không xảy ra tai nạn bảo hiểm mà báo là có thì công ty bảo hiểm có quyền huỷ hợp đồng, và không hoàn tiền phí. Dùng chứng từ làm giả, sửa đổi, hoặc bịa nguyên nhân tai nạn, phóng đại mức thiệt hại thì công ty bảo hiểm không bồi phần khai báo thừa, phần đã bồi thì phải hoàn lại hoặc bồi thường. Vụ án: trong vụ Trương Nhậm Tùng ở Tuyên Thành, tỉnh An Huy, Vương Tín Hàm cùng 7 người nữa, tổng cộng 8 người, bị phạt tù từ 4 năm xuống 2 năm về tội lừa đảo bảo hiểm, đều bị phạt tiền 1 vạn tệ. Vụ kiện dân sự giả bịa ra trong vụ án đó có thiệt hại được công ty bảo hiểm xác định là 2 vạn tệ, các bên dựa vào hợp đồng chuyển nhượng xe làm giả để có tư cách khởi kiện, tòa án buộc bồi hơn 7 vạn tệ. Bản án dân sự đã có hiệu lực đó bị xét lại và hủy ngày 26 tháng 9 năm 2019. Biện pháp chống gian lận bảo hiểm yêu cầu: cả hai đầu bán hợp đồng và bồi thường (đầu ký kết bảo hiểm và đầu giải quyết bồi thường) đều phải kiểm tra thông tin rủi ro. Còn phải thăm dò xây dựng nền tảng chia sẻ thông tin chống gian lận đa ngành, trung tâm tình báo chống gian lận. Các nền tảng này tập trung rà soát dữ liệu nghi ngờ gian lận, chuyển dấu vết cho hiệp hội ngành, tổ chức chống gian lận và cơ quan bảo hiểm để kiểm chứng. Nghi ngờ phạm tội thì báo công an kịp thời. Cục Quản lý Tài chính ngân hàng và các cơ quan chi nhánh của nó phải cùng công an, viện kiểm sát nhân dân, tòa án nhân dân xây dựng cơ chế kết nối giữa quản lý hành chính và tư pháp hình sự (toàn quốc, ban hành ngày 31 tháng 7 năm 2024)"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Nguồn gốc"]},{"tag":"p","props":{"className":"life-citations"},"children":["全国人大常委会. 中华人民共和国刑法（经刑法修正案十一修正的整合文本）第一百九十八条. ",{"tag":"a","props":{"href":"https://flk.npc.gov.cn/detail?id=ff808181796a636a0179822a19640c92","target":"_blank","rel":"noopener noreferrer"},"children":["https://flk.npc.gov.cn/detail?id=ff808181796a636a0179822a19640c92"]},"；全国人大常委会 (2015 修正). 中华人民共和国保险法第二十七条. ",{"tag":"a","props":{"href":"https://flk.npc.gov.cn/detail?id=2c909fdd678bf17901678bf7c4060811","target":"_blank","rel":"noopener noreferrer"},"children":["https://flk.npc.gov.cn/detail?id=2c909fdd678bf17901678bf7c4060811"]},"；国家金融监督管理总局 (2024). 关于印发《反保险欺诈工作办法》的通知. ",{"tag":"a","props":{"href":"https://www.gov.cn/gongbao/2024/issue_11586/202409/content_6975080.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/gongbao/2024/issue_11586/202409/content_6975080.html"]},"；安徽省人民检察院转载《法制日报》(2020-01-13). 杀妻骗保牵出案中案. ",{"tag":"a","props":{"href":"http://www.ah.jcy.gov.cn/jczt/jjslhyqkjc/mtjj/202001/t20200113_2758841.shtml","target":"_blank","rel":"noopener noreferrer"},"children":["http://www.ah.jcy.gov.cn/jczt/jjslhyqkjc/mtjj/202001/t20200113_2758841.shtml"]}]},{"tag":"a","props":{"href":"https://flk.npc.gov.cn/detail?id=ff808181796a636a0179822a19640c92","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Liên kết mở nguồn"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Ghi chú sách"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["Mấy việc dưới đây tưởng vô hại đều nằm trong năm trường hợp đó. Xảy ra tai nạn nhỏ thì tìm tiệm sửa xe「báo hơn một chút」, tính luôn vết thương vết hư cũ vào lần này, đâm nhẹ vào nhau rồi mới báo, không có chuyện gì mà bịa ra một chuyện. Bảo hiểm xe mua thế nào, xem mục 26 ở phần 5 (mua đủ bảo hiểm trách nhiệm bên thứ ba). Sau khi mua bảo hiểm cho người nhà mà cố ý gây ra cái chết cho họ, điều luật ghi rõ phải gộp nhiều tội, xem mục 38 ở phần 8 (mua bảo hiểm cho người nhà). Bảo hiểm y tế là bộ quy tắc khác, quẹt thẻ bảo hiểm y tế trống hoặc rút tiền từ tài khoản cá nhân của bảo hiểm y tế thì xử lý như lừa đảo, xem ghi chú của mục 13 ở phần 5"]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Ghi chú của tôi"]},{"tag":"button","props":{"type":"button"},"children":["Viết một lời nhắc cho chính bạn…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/vi/tip/09-20"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Trước"]},"Sinh con ra không nuôi nổi thì lối thoát hợp pháp chỉ có một: đăng ký nhận nuôi ở cơ quan dân vụ; nhận tiền rồi đưa con cho người khác có thể bị kết án về tội bán trẻ em, bỏ trẻ không chăm thì là tội bỏ bê"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/vi/tip/09-22"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Tiếp theo"]},"Không bán cơ quan của mình, cũng đừng đi tìm người hiến cho người khác: thận bán được hơn 2 vạn tệ, cùng một quả bán cho bệnh nhân tới 20 vạn tệ, tiền bị tịch thu lại còn phạt theo giao dịch 10 đến 20 lần"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["Thêm trong chủ đề này"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/09-17"},"children":[{"tag":"strong","props":{},"children":["Khi bị công an chặn hoặc đưa đi thì hợp tác, không đẩy, không đánh, không giật máy quay của người thi hành; đã uống rượu thì càng phải nhịn"]},{"tag":"span","props":{},"children":["Cản trở việc thi hành công vụ tại hiện trường thì bị cảnh cáo hoặc ph…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/09-18"},"children":[{"tag":"strong","props":{},"children":["Người kia chưa đủ 14 tuổi thì không được quan hệ tình dục; câu「cô ấy đồng ý」không phải là lý do"]},{"tag":"span","props":{},"children":["Người kia chưa đủ 14 tuổi, dù cô ấy có đồng ý hay không, vẫn bị xử lý…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/09-19"},"children":[{"tag":"strong","props":{},"children":["Trước khi ra tay, tính rõ cái giá: bị giữ, phải bồi, kết án"]},{"tag":"span","props":{},"children":["Đánh một lần thì bị giữ 5 đến 10 ngày, cộng phạt tiền 500 đến 1000 tệ…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/09-23"},"children":[{"tag":"strong","props":{},"children":["Đừng đi mại dâm: mức mặc định là giam 10 đến 15 ngày, không phải phạt chút tiền là xong"]},{"tag":"span","props":{},"children":["Bị bắt không phải là phạt chút tiền là xong. Pháp luật đặt mức mặc đị…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/09-24"},"children":[{"tag":"strong","props":{},"children":["Dịch truyện tranh, đăng lại phim, chia sẻ tệp trên đám mây hoặc ebook lậu vẫn xâm phạm bản quyền dù miễn phí; quảng cáo hay phí thành viên có thể dẫn đến án hình sự"]},{"tag":"span","props":{},"children":["Dịch rồi đăng tác phẩm của người khác, hoặc đưa tác phẩm lên mạng khi…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/09-25"},"children":[{"tag":"strong","props":{},"children":["Xuất bản hoặc bán fanfic và tác phẩm phái sinh: hãy xin phép chủ sở hữu tác phẩm gốc, hoặc tự tạo lại tên, tính cách và quan hệ nhân vật"]},{"tag":"span","props":{},"children":["Fanfic chỉ mượn tên, tính cách và quan hệ nhân vật vẫn có thể bị coi …"]}]}]}]},{"tag":"a","props":{"className":"life-text-link","href":"/vi/book/09"},"children":["Đọc toàn bộ chủ đề: Vạch đỏ pháp lý dân dân thường dễ vấp"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"15","height":"15","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]}]}]}]},{"tag":"aside","props":{"className":"life-ad-space life-ad-space-sponsored","data-ad-placement":"ad_footer","data-ad-group":"reading","data-ad-creative":"read_product","data-ad-ready":"false","aria-label":"Quảng cáo · Giới thiệu cộng đồng"},"children":[{"tag":"div","props":{"className":"l