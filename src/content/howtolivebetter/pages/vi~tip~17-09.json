 done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"Hoàn tất"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"Kế hoạch thực hiện"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"Lưu"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Chia sẻ mẹo này"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Ẩn chi tiết"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Chi phí"]},{"tag":"p","props":{},"children":["Đưa người lớn tuổi đi khám mắt một lần trước, để bác sĩ quyết định có nên phẫu thuật không. Một mắt thì một lần phẫu thuật, nhiều bệnh viện làm theo kiểu ngoại trú, ngày đó về nhà được. Ai đụng thủy tinh thể cả hai mắt thì phải chia làm hai lần. Bạn tự bỏ ra bao nhiêu, tuỳ loại thủy tinh thể nhân tạo (kính mắt giả) được thay vào mắt và bảo hiểm y tế địa phương hoàn trả thế nào, hỏi rõ trước khi phẫu thuật."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Lợi ích"]},{"tag":"p","props":{},"children":["Một thử nghiệm ngẫu nhiên gồm 306 phụ nữ trên 70 tuổi bị đụng thủy tinh thể. Một nửa phẫu thuật mắt thứ nhất trong khoảng 4 tuần, nửa còn lại chờ theo lệ thường là 12 tháng. Trong một năm, nhóm phẫu thuật sớm ngã ít đi khoảng 34% số lần ngã. Giá trị gốc là tỷ lệ ngã 0.66, khoảng tin cậy 95% CI 0.45 đến 0.96. Người ngã ít nhất một lần: nhóm phẫu thuật 49%, nhóm chờ 45%, không ít hơn. Người ngã từ hai lần trở lên: nhóm phẫu thuật 18%, nhóm chờ 25%. Nhóm phẫu thuật có 4 người gãy xương (3%), nhóm chờ có 12 người (8%). Tổng quan Cochrane đã đưa thử nghiệm này vào, kết luận là phẫu thuật mắt thứ nhất ở phụ nữ làm giảm số lần ngã, còn phẫu thuật mắt thứ hai thì không. Thử nghiệm ngẫu nhiên cho mắt thứ hai gồm 239 phụ nữ trên 70 tuổi. Nhóm phẫu thuật có tỷ lệ ngã thấp hơn 32%, nhưng khác biệt có thể chỉ là trùng hợp (tỷ lệ ngã 0.68, 95% CI 0.39 đến 1.19). Trong mẫu 5% của bảo hiểm y tế Hoa Kỳ có 1113640 bệnh nhân đụng thủy tinh thể từ 65 tuổi trở lên (từ 2002 đến 2009). Nghiên cứu này chỉ ghi nhận và theo dõi, không chia nhóm đối chứng. Người được phẫu thuật có xác suất gãy xương hông trong một năm thấp hơn khoảng 16% (OR 0.84, 95% CI 0.81 đến 0.87). Chênh lệch tuyệt đối là 0.20 điểm phần trăm, tức khoảng 2 ca ít hơn trên mỗi 1000 người"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Nguồn gốc"]},{"tag":"p","props":{"className":"life-citations"},"children":["Harwood RH, Foss AJ, Osborn F, Gregson RM, Zaman A, Masud T (2005). Falls and health status in elderly women following first eye cataract surgery: a randomised controlled trial. British Journal of Ophthalmology, 89(1), 53-59. ",{"tag":"a","props":{"href":"https://doi.org/10.1136/bjo.2004.049478","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1136/bjo.2004.049478"]}," ; Foss AJ, Harwood RH, Osborn F, Gregson RM, Zaman A, Masud T (2006). Falls and health status in elderly women following second eye cataract surgery: a randomised controlled trial. Age and Ageing, 35(1), 66-71. ",{"tag":"a","props":{"href":"https://doi.org/10.1093/ageing/afj005","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1093/ageing/afj005"]}," ; Gillespie LD, Robertson MC, Gillespie WJ, et al. (2012). Interventions for preventing falls in older people living in the community. Cochrane Database of Systematic Reviews, 9, CD007146. ",{"tag":"a","props":{"href":"https://doi.org/10.1002/14651858.CD007146.pub3","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1002/14651858.CD007146.pub3"]}," ; Tseng VL, Yu F, Lum F, Coleman AL (2012). Risk of fractures following cataract surgery in Medicare beneficiaries. JAMA, 308(5), 493-501. ",{"tag":"a","props":{"href":"https://doi.org/10.1001/jama.2012.9014","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1001/jama.2012.9014"]}," ; Desapriya E, Subzwari S, Scime-Beltrano G, et al. (2010). Vision improvement and reduction in falls after expedited cataract surgery: systematic review and metaanalysis. Journal of Cataract and Refractive Surgery, 36(1), 13-19. ",{"tag":"a","props":{"href":"https://doi.org/10.1016/j.jcrs.2009.07.032","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1016/j.jcrs.2009.07.032"]}," ; Meuleners LB, Lee AH, Ng JQ, Morlet N, Fraser ML (2012). First eye cataract surgery and hospitalization from injuries due to a fall: a population-based study. Journal of the American Geriatrics Society, 60(9), 1730-1733. ",{"tag":"a","props":{"href":"https://doi.org/10.1111/j.1532-5415.2012.04098.x","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1111/j.1532-5415.2012.04098.x"]}," ; Meuleners LB, Fraser ML, Ng J, Morlet N (2014). The impact of first- and second-eye cataract surgery on injurious falls that require hospitalisation: a whole-population study. Age and Ageing, 43(3), 341-346. ",{"tag":"a","props":{"href":"https://doi.org/10.1093/ageing/aft177","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1093/ageing/aft177"]}," ; Keay L, Ho KC, Rogers K, et al. (2022). The incidence of falls after first and second eye cataract surgery: a longitudinal cohort study. Medical Journal of Australia, 217(2), 94-99. ",{"tag":"a","props":{"href":"https://doi.org/10.5694/mja2.51611","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.5694/mja2.51611"]}," ; 国家卫生健康委 (2022). 「十四五」全国眼健康规划（2021-2025年）. ",{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/2022-01/17/content_5668951.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/zhengce/zhengceku/2022-01/17/content_5668951.htm"]}]},{"tag":"a","props":{"href":"https://doi.org/10.1136/bjo.2004.049478","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Liên kết mở nguồn"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Ghi chú sách"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["Tranh cãi. Gộp cả hai thử nghiệm ngẫu nhiên lại, số người từng bị ngã không giảm rõ rệt (OR 0.81, 95% CI 0.55 đến 1.17). Trong hồ sơ nhập viện của toàn bộ dân số ở Tây Úc, trong năm sau khi làm xong mắt thứ nhất, số người phải nằm viện vì chấn thương do ngã lại tăng 27%. Trong khoảng giữa hai lần phẫu thuật, loại nhập viện đó gấp 2.14 lần so với trước phẫu thuật. Kiểu so sánh trước – sau này không tách được ảnh hưởng của phẫu thuật với ảnh hưởng của việc người ta già đi. Trong một nghiên cứu theo dõi khác ở Úc, sau khi làm xong mắt thứ hai thì số lần ngã giảm nhiều nhất. Nên với ai đụng thủy tinh thể cả hai mắt, đừng kéo dài mắt thứ hai. Trong khoảng giữa hai lần phẫu thuật, đi bộ và leo cầu thang phải càng cẩn thận càng tốt. Cochrane còn đưa vào một thử nghiệm xử lý vấn đề thị lực cho người lớn tuổi, số lần ngã lại tăng khoảng năm phần mười bảy. Phẫu thuật giải quyết chuyện nhìn có rõ không, còn muốn ít ngã thì còn phải dựa vào mục 13 ở phần 1 (giữ thăng bằng và sức chân). Xương có chịu nổi cú ngã không, xem mục 39 ở phần 1 (đo mật độ xương) và mục 40 ở phần 1 (phát hiện loãng xương thì dùng thuốc). Kế hoạch quốc gia về sức khoẻ mắt ghi rõ phẫu thuật đụng thủy tinh thể để phục hồi thị lực đã được triển khai rộng rãi ở cấp huyện, không nhất thiết phải tới bệnh viện ở thành phố lớn. Người hưởng lợi chủ yếu là cha mẹ và ông bà của bạn."]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Ghi chú của tôi"]},{"tag":"button","props":{"type":"button"},"children":["Viết một lời nhắc cho chính bạn…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/vi/tip/17-08"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Trước"]},"Khi trong nhà có người nằm liệt giường lâu ngày, hãy coi loét áp lực là kẻ thù số một: dùng nệm hơi điện, xoay người đúng giờ, mỗi ngày soi một lần chỗ xương nhô ra"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/vi/tip/17-10"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Tiếp theo"]},"Người cao tuổi dắt chó: nắm dây trong lòng bàn tay, đừng quấn quanh tay, thu ngắn dây và huấn luyện chó không lao mạnh khi dắt"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["Thêm trong chủ đề này"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/17-02"},"children":[{"tag":"strong","props":{},"children":["Hãy lập di chúc, nhớ bản lập sau gạt bản lập trước, di chúc công chứng không còn được ưu tiên"]},{"tag":"span","props":{},"children":["Pháp luật công nhận sáu loại di chúc, nhưng viết sai hình thức là cả …"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/17-03"},"children":[{"tag":"strong","props":{},"children":["Tiền của người già để riêng một tài khoản, chi tiêu lớn thì đặt quy tắc hai người xác nhận"]},{"tag":"span","props":{},"children":["Kẻ lừa người cao tuổi thường tặng quà nhỏ, hỏi han để tích lũy lòng t…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/17-04"},"children":[{"tag":"strong","props":{},"children":["Cho người già một câu để nói ra bất cứ lúc nào mà thoát khỏi việc"]},{"tag