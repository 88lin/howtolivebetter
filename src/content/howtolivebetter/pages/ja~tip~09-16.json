hevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["費用・手間"]},{"tag":"p","props":{},"children":["費用はかかりません。誰かに貸してほしいと言われたら、断るだけで済みます。コピーを求められた場合は、そのコピーがどの用途にのみ使用されるかを明記してください。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["効果"]},{"tag":"p","props":{},"children":["自身の住民身分証を他人にレンタル、貸与、譲渡した場合、警告および 200 元以下の罰金に処されます。他人の身分証を冒用した場合、または詐取した身分証を使用した場合は、200 から 1000 元の罰金、または 10 日以下の拘留に処されます。偽造・変造された身分証の購入、販売、使用についても、この区分が適用されます。国の規定により、特定の場面では身分証明書の提示が義務付けられています。これらの場面で偽造、変造、または他人の身分証を盗用した場合、事態が重大であれば刑に処されます。身分証には、身分証、パスポート、社会保障カード、運転免許証などが含まれます。刑罰は、拘役（短期の拘禁）または管制（拘禁はされないが行動が制限される）であり、罰金が併科または単独で科されます。刑罰と同時に罰金が科されることもあれば、罰金のみが科されることもあります（全国）。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["出典"]},{"tag":"p","props":{"className":"life-citations"},"children":["全国人大常委会 (2011). 居民身份证法（2011 年修正，第十六、十七条）. ",{"tag":"a","props":{"href":"https://jtgl.beijing.gov.cn/jgj/jgxx/flfg/fl/203777/index.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://jtgl.beijing.gov.cn/jgj/jgxx/flfg/fl/203777/index.html"]},"（北京市公安交通管理局转载）；全国人大 (2020). 刑法（根据刑法修正案（十一）修正，第二百八十条之一）. ",{"tag":"a","props":{"href":"https://jtgl.beijing.gov.cn/jgj/jgxx/flfg/fl/11033925/index.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://jtgl.beijing.gov.cn/jgj/jgxx/flfg/fl/11033925/index.html"]},"；国务院 (2002). 互联网上网服务营业场所管理条例（国令第 363 号，第二十三条）. ",{"tag":"a","props":{"href":"http://www.gov.cn/gongbao/content/2002/content_61788.htm","target":"_blank","rel":"noopener noreferrer"},"children":["http://www.gov.cn/gongbao/content/2002/content_61788.htm"]}]},{"tag":"a","props":{"href":"https://jtgl.beijing.gov.cn/jgj/jgxx/flfg/fl/203777