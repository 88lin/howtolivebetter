"tag":"path","props":{"d":"m19.07 4.93-1.41 1.41"},"children":[]}]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"17","height":"17","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-moon life-theme-icon-dark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"},"children":[]}]}]},{"tag":"button","props":{"type":"button","className":"life-language-switch","aria-label":"日本語 言語を選ぶ","aria-haspopup":"menu","aria-expanded":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-globe","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]},{"tag":"path","props":{"d":"M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"},"children":[]},{"tag":"path","props":{"d":"M2 12h20"},"children":[]}]},{"tag":"span","props":{},"children":["日本語"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]}]},{"tag":"a","props":{"className":"life-account","href":"/ja/sign-in"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"17","height":"17","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle-user-round","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M18 20a6 6 0 0 0-12 0"},"children":[]},{"tag":"circle","props":{"cx":"12","cy":"10","r":"4"},"children":[]},{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},{"tag":"span","props":{},"children":["ログイン"]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/ja/book/17"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"目次に戻る"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["家族に高齢者がいる場合"]},{"tag":"nav","props":{"aria-label":"この章のヒント"},"children":[{"tag":"a","props":{"href":"/ja/tip/17-01"},"children":[{"tag":"span","props":{},"children":["01"]},"高齢なうちに、将来の後見人を書面で指定しておく"]},{"tag":"a","props":{"href":"/ja/tip/17-02"},"children":[{"tag":"span","props":{},"children":["02"]},"遺言を作成しましょう。後から作成したものが前のものを覆すため、公証遺言が優先されるとは限りません"]},{"tag":"a","props":{"href":"/ja/tip/17-03"},"children":[{"tag":"span","props":{},"children":["03"]},"高齢者の資金は別口座で管理し、高額支出には二人確認のルールを設ける"]},{"tag":"a","props":{"href":"/ja/tip/17-04"},"children":[{"tag":"span","props":{},"children":["04"]},"高齢者がいつでも使える、断るためのフレーズ：「家族と相談させてください」"]},{"tag":"a","props":{"href":"/ja/tip/17-05"},"children":[{"tag":"span","props":{},"children":["05"]},"高齢者に先払いを求める「投資型老後プラン」には一切手を出さないこと：カード作成、ベッド確保、介護マンション、移住型老後生活、高齢者向け製品の購入は、すべて同一の違法集金の手口です"]},{"tag":"a","props":{"href":"/ja/tip/17-06"},"children":[{"tag":"span","props":{},"children":["06"]},"保険会社による住宅リバースモーゲージ型年金保険を除き、他の「自宅を活用した老後プラン」には一切手を出さないこと。絶対に住宅を担保に理財商品を買ってはいけない"]},{"tag":"a","props":{"href":"/ja/tip/17-07"},"children":[{"tag":"span","props":{},"children":["07"]},"家族内に長期臥床または重度の障害がある人がいる場合、加入先の医療保険部門へ長期介護保険を申請してください。これは高齢者だけに支給されるものではありません"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/ja/tip/17-08","data-status":"active"},"children":[{"tag":"span","props":{},"children":["08"]},"家族内に長期臥床の人がいる場合、褥瘡（床ずれ）を最大の敵と見なしましょう：電動エアマットレスの使用、定期的な体位変換、毎日、骨の突出部をチェックする"]},{"tag":"a","props":{"href":"/ja/tip/17-09"},"children":[{"tag":"span","props":{},"children":["09"]},"高齢者の白内障が視界に影響しているなら、眼科で手術の検討を。両目に症状がある場合は、二枚目の手術をあまり遅らせないこと"]},{"tag":"a","props":{"href":"/ja/tip/17-10"},"children":[{"tag":"span","props":{},"children":["10"]},"高齢者の犬の散歩ではリードを手に巻かず手のひらで握り、短く保つ。引っ張って飛び出さないよう犬を訓練する"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"現在地"},"children":[{"tag":"a","props":{"href":"/ja/book"},"children":["本を読む"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/ja/book/17"},"children":["第17章"," ·"," ","家族に高齢者がいる場合"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"17-08"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["08"]},{"tag":"span","props":{"className":"life-evidence grade-b"},"children":["エビデンス"," ","B"]}]},{"tag":"h1","props":{"lang":"ja"},"children":["家族内に長期臥床の人がいる場合、褥瘡（床ずれ）を最大の敵と見なしましょう：電動エアマットレスの使用、定期的な体位変換、毎日、骨の突出部をチェックする"]},{"tag":"p","props":{"lang":"ja","className":"life-entry-summary"},"children":["股関節骨折の手術前に褥瘡がある高齢者は、30 日以内に亡くなる可能性が約2割高まります。電動エアマットレスに交換することで、新しい褥瘡ができる割合を約6割減らせます。定期的な体な体位変換を徹底すれば、約7割減らせます。長時間、うつ伏せの状態にさせないでください。毎日、仙骨、踵、股関節、肩甲骨周辺をチェックし、圧迫されて色が引かない赤みを見つけた場合は、その日のうちに看護師または医師に伝えてください。"]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["費用・手間"]},{"tag":"p","props":{},"children":["家庭用の電動交互圧力エアマットレスは、数百元から利用可能です。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["効果"]},{"tag":"p","props":{},"children":["19520 例の股関節骨折手術患者（米国 NSQIP 2016 年から 2019 年）。"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"記録する：家族内に長期臥床の人がいる場合、褥瘡（床ずれ）を最大の敵と見なしましょう：電動エアマットレスの使用、定期的な体位変換、毎日、骨の突出部をチェックする"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"できている"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"やることに追加"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"お気に入り"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"このヒントを共有"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"詳細を閉じる"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["費用・手間"]},{"tag":"p","props":{},"children":["家庭用の電動交互圧力エアマットレスは、数百元から利用可能です。体位変換は一度につき数分で済みます。困難なのは、2〜3時間おきに、夜間も休まず行わなければならないことであり、一人で抱え込むのは困難です。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["効果"]},{"tag":"p","props":{},"children":["19520 例の股関節骨折手術患者（米国 NSQIP 2016 年から 2019 年）。術前に褥瘡（床ずれ）がある患者は、30 日以内の死亡率が高くなります。他の要因を調整した後でも、この関連性は依然として認められます（OR 1.2、リスク 21% 増、P=0.004）。また、これらの患者は、深部静脈血栓症（OR 1.59）、肺炎（OR 1.39）、予定外の再入院（OR 1.43）などの合併症を起こしやすく、平均入院日数も 0.4 日長くなります。324 名の入院高齢者（平均 86 歳）を、中央値 18 か月の追跡調査で検討しました。褥瘡は長期死亡の独立した予測因子となります（HR 1.500、95% CI 1.059 から 2.126、P=0.020）。単独予測とは、他の要因を除外した後に、それ自体で予測が可能であることを意味します。65件のランダム化比較試験を統合して解析（ネットワークメタ解析）しました。電動アクティブ・エア・サーフェスと標準的なマットレス（標準的なベッド・サーフェス）を比較しています。電動アクティブ・エア・サーフェスとは、電動エアマットレスの一種です。これを使用した場合、褥瘡の発生率がより低くなりました（RR 0.42、95% CI 0.29 ～ 0.63、中程度の確信度）。電動ハイブリッド・エア・サーフェスのRRは0.22（0.07 ～ 0.66）でした。11件の試験、4462人を対象としたCochraneレビュー（2026年更新）。2 時間ごとの体位変換と 4 時間ごとの体位変換の比較では、明確な差は認められませんでした（RR 1.05、95% CI 0.79 ～ 1.39、確実性は極めて低い）。その他の体位変換の間隔の比較についても、同様に極めて不確実です。1226 名のICU患者を対象とした試験では、ウェアラブルセンサーを用いてリアルタイムで通知および視覚的な警告を行うことで、2 時間ごとの体位変換を確実に実施しました。その結果、褥瘡の発生率は通常のケアよりも低い結果となりました（RR 0.28、95% CI 0.10 ～ 0.75、確実性は中程度）。116 人を対象とした試験では、腹臥位（うつ伏せ）群の褥瘡発生率は仰臥位（仰向け）群よりも高い結果でした（RR 4.55、95% CI 2.31 ～ 8.98）"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["出典"]},{"tag":"p","props":{"className":"life-citations"},"children":["Porter SB, Pla R, Chow JH, et al. (2022). Preoperative Pressure Ulcers, Mortality, and Complications in Older Hip Fracture Surgery Patients. JAAOS Global Research & Reviews, 6(11). ",{"tag":"a","props":{"href":"https://doi.org/10.5435/JAAOSGlobal-D-22-00117","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.5435/JAAOSGlobal-D-22-00117"]},"；Ottaviani S, Rondanina E, Longo E, 等 (2026). Impact of pressure ulcers and frailty on long-term mortality: a prospective cohort study of hospitalized older adults. European Geriatric Medicine, 17(2), 665-672. ",{"tag":"a","props":{"href":"https://doi.org/10.1007/s41999-025-01331-8","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1007/s41999-025-01331-8"]},"；Shi C, Dumville JC, Cullum N (2018). Support surfaces for pressure ulcer prevention: A network meta-analysis. PLoS ONE, 13(2), e0192707. ",{"tag":"a","props":{"href":"https://doi.org/10.1371/journal.pone.0192707","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1371/journal.pone.0192707"]},"；Latimer SL, Chaboyer WP, Probst S, 等 (2026). Repositioning for pressure injury prevention in adults. Cochrane Database of Systematic Reviews, 6, CD009958. ",{"tag":"a","props":{"href":"https://doi.org/10.1002/14651858.CD009958.pub4","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1002/14651858.CD009958.pub4"]}]},{"tag":"a","props":{"href":"https://doi.org/10.5435/JAAOSGlobal-D-22-00117","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["出典を開く"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["著者の注記"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["Bに伝えた理由は3つあります。第一に、死亡率に関する2つの研究では「褥瘡がある人のその後の状況が悪化している」ことが示されただけであり、「褥瘡を防げば死亡率を下げられる」ことと同義ではありません。第二に、体位変換の間隔に関するいくつかのランダム化比較試験の結論は、信頼性に欠けます。第三に、エアマットレスに関する証拠はより強力ですが、研究で比較されているのは病院のベッドのマットレスであり、家庭用マットレスにそのまま当てはめるには飛躍があります。毎日、仙骨、踵、股関節、肩甲骨周辺をチェックし、「圧迫しても色が引かない赤み」がないか確認することは、介護の常識的な手法であり、個別の文献があるわけではありません。長期介護保険で補填可能な介護サービスについては、本節第 7 条を参照してください。突然片足が腫れた場合は、深部静脈血栓として対処してください。第 13 節第 11 条を参照してください。転倒や重傷により長期臥床しているケースについては、第 1 節第 34 条を参照してください。"]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["自分のメモ"]},{"tag":"button","props":{"type":"button"},"children":["自分へのメモを書く…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/ja/tip/17-07"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["前へ"]},"家族内に長期臥床または重度の障害がある人がいる場合、加入先の医療保険部門へ長期介護保険を申請してください。これは高齢者だけに支給されるものではありません"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/ja/tip/17-09"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["次へ"]},"高齢者の白内障が視界に影響しているなら、眼科で手術の検討を。両目に症状がある場合は、二枚目の手術をあまり遅らせないこと"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["このテーマの他の提案"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/17-02"},"children":[{"tag":"strong","props":{},"children":["遺言を作成しましょう。後から作成したものが前のものを覆すため、公証遺言が優先されるとは限りません"]},{"tag":"span","props":{},"children":["法律は6種類の遺言を認めていますが、形式を間違えると書面全体が無効になります。これが最もよくある失敗です。自筆によるものは、本人が最初から…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/17-03"},"children":[{"tag":"strong","props":{},"children":["高齢者の資金は別口座で管理し、高額支出には二人確認のルールを設ける"]},{"tag":"span","props":{},"children":["高齢者を狙う詐欺では、贈り物や親身な言葉で信頼を積み上げてから大金を奪います。「誰にも言わないで」と口止めするのも典型です。一定額以上の支…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/17-04"},"children":[{"tag":"strong","props":{},"children":["高齢者がいつでも使える、断るためのフレーズ：「家族と相談させてください」"]},{"tag":"span","props":{},"children":["勧誘や詐欺は、その場の圧力で考える前に払わせようとします。感情が高ぶると誇張広告を信じやすく、高齢者は若い人より説得されやすい傾向がありま…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/17-05"},"children":[{"tag":"strong","props":{},"children":["高齢者に先払いを求める「投資型老後プラン」には一切手を出さないこと：カード作成、ベッド確保、介護マンション、移住型老後生活、高齢者向け製品の購入は、すべて同一の違法集金の手口です"]},{"tag":"span","props":{},"children":["高齢者に先払いを求め、かつリターンを約束する老後プランは、すべて同じ詐欺の手口です。カード作成、ベッド確保、介護マンション、移住型老後生活…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/17-06"},"children":[{"tag":"strong","props":{},"children":["保険会社による住宅リバースモーゲージ型年金保険を除き、他の「自宅を活用した老後プラン」には一切手を出さないこと。絶対に住宅を担保に理財商品を買ってはいけない"]},{"tag":"span","props":{},"children":["正規の住宅を活用した老後プランは、保険会社による住宅リバースモーゲージ型年金保険（現在、試験運用中）のただ一種のみです。訪問販売されるもの…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/17-10"},"children":[{"tag":"strong","props":{},"children":["高齢者の犬の散歩ではリードを手に巻かず手のひらで握り、短く保つ。引っ張って飛び出さないよう犬を訓練する"]},{"tag":"span","props":{},"children":["米国で65歳以上が犬の散歩中に骨折した推計は年約1700人から約4400人に増え、8割が女性でした。最も多い単一部位は股関節で、3割近くが…"]}]}]}]},{"tag":"a","props":{"className":"life-text-link","href":"/ja/book/17"},"children":["テーマ全体を読む：家族に高齢者がいる場合"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"15","height":"15","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strok