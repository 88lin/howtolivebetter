-layout-toc"},"children":[{"tag":"div","props":{"className":"life-ad-rail","data-dock-active":"false","style":{"top":"94px"}},"children":[{"tag":"div","props":{"className":"life-ad-dock","hidden":true},"children":[{"tag":"aside","props":{"className":"life-ad-space life-ad-space-sponsored life-ad-space-compact","data-ad-placement":"ad_dock","data-ad-group":"reading","data-ad-creative":"read_product","data-ad-ready":"false","aria-label":"Advertisement · Community recommendation"},"children":[{"tag":"button","props":{"type":"button","className":"life-ad-dismiss","aria-label":"Close ad"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-x","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M18 6 6 18"},"children":[]},{"tag":"path","props":{"d":"m6 6 12 12"},"children":[]}]}]},{"tag":"div","props":{"className":"life-ad-space-brand"},"children":[{"tag":"img","props":{"src":"/sites/howtolivebetter/images/shengcai/logo.png","width":"565","height":"144","alt":"Official Shengcai Youshu logo","decoding":"async"},"children":[]}]},{"tag":"div","props":{"className":"life-ad-space-copy"},"children":[{"tag":"span","props":{"className":"life-ad-space-label"},"children":["Advertisement · Community recommendation"]},{"tag":"strong","props":{},"children":["Could what you know become a useful product?"]},{"tag":"p","props":{},"children":["From ebooks to small tools, explore how members spot needs and turn knowledge into something people can use."]}]},{"tag":"div","props":{"className":"life-ad-space-actions"},"children":[{"tag":"a","props":{"className":"life-ad-space-link","href":"/en/shengcaiyoushu?sc_group=reading&sc_creative=read_product&sc_placement=ad_dock"},"children":["Explore the community and examples",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"18","height":"18","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-up-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M7 7h10v10"},"children":[]},{"tag":"path","props":{"d":"M7 17 17 7"},"children":[]}]}]}]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/en/book/17"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"Back to index"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["Having elderly family members at home"]},{"tag":"div","props":{"data-ad-dock-host":"true"},"children":[]},{"tag":"nav","props":{"aria-label":"Chapter entries"},"children":[{"tag":"a","props":{"href":"/en/tip/17-01"},"children":[{"tag":"span","props":{},"children":["01"]},"While the elderly are still lucid, designate a future guardian in writing"]},{"tag":"a","props":{"href":"/en/tip/17-02"},"children":[{"tag":"span","props":{},"children":["02"]},"Make a will — remember that later ones override earlier ones, and notarized wills no longer take priority"]},{"tag":"a","props":{"href":"/en/tip/17-03"},"children":[{"tag":"span","props":{},"children":["03"]},"Keep the elderly person’s money in a separate account and set a rule requiring two people to approve any large withdrawals"]},{"tag":"a","props":{"href":"/en/tip/17-04"},"children":[{"tag":"span","props":{},"children":["04"]},"A ready-made phrase for seniors to deflect unwanted offers"]},{"tag":"a","props":{"href":"/en/tip/17-05"},"children":[{"tag":"span","props":{},"children":["05"]},"Avoid any “investment-based senior care” schemes that require upfront payments: card enrollment, prepaid care fees, buying senior housing units, travel-based care programs, and sales of senior products all fall under the same category of illegal fundraising"]},{"tag":"a","props":{"href":"/en/tip/17-06"},"children":[{"tag":"span","props":{},"children":["06"]},"Apart from the housing reverse mortgage insurance offered by insurers, you should avoid all other “housing-for-pension” schemes — never mortgage your home to buy financial products"]},{"tag":"a","props":{"href":"/en/tip/17-07"},"children":[{"tag":"span","props":{},"children":["07"]},"For elderly individuals at home who are bedridden or severely disabled, apply to the local yibao (basic medical insurance) office for long-term care insurance; it is not limited to seniors only"]},{"tag":"a","props":{"href":"/en/tip/17-08"},"children":[{"tag":"span","props":{},"children":["08"]},"For families with someone bedridden at home, pressure ulcers are a top concern: use an electric alternating-pressure air mattress, turn the patient regularly, and check bony areas daily"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/en/tip/17-09","data-status":"active"},"children":[{"tag":"span","props":{},"children":["09"]},"If an older person’s cataracts already affect walking safely, have an eye doctor assess surgery; when both eyes are affected, do not delay the second eye too long"]},{"tag":"a","props":{"href":"/en/tip/17-10"},"children":[{"tag":"span","props":{},"children":["10"]},"When an older person walks a dog, hold the leash in the palm and never wrap it around the hand, keep the leash short, and train the dog first not to lunge forward on the leash"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"Breadcrumb"},"children":[{"tag":"a","props":{"href":"/en/book"},"children":["Explore the book"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/en/book/17"},"children":["Chapter 17"," ·"," ","Having elderly family members at home"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"17-09"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["09"]},{"tag":"span","props":{"className":"life-evidence grade-b"},"children":["Evidence"," ","B"]}]},{"tag":"h1","props":{"lang":"en"},"children":["If an older person’s cataracts already affect walking safely, have an eye doctor assess surgery; when both eyes are affected, do not delay the second eye too long"]},{"tag":"p","props":{"lang":"en","className":"life-entry-summary"},"children":["In women aged 70 and older, having the first-eye cataract surgery sooner cut falls over the next year by about one-third, and fewer people fractured bones. The number who fell at least once did not drop. For the second eye, surgery did not show a clear difference in falls. After surgery, hip fracture over one year was about 16% lower."]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Cost"]},{"tag":"p","props":{},"children":["Accompany the older person to ophthalmology once;"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Benefit"]},{"tag":"p","props":{},"children":["A randomized trial enrolled 306 women aged 70 or older with cataracts. Half had first-eye surgery within about…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"Mark: If an older person’s cataracts already affect walking safely, have an eye doctor assess surgery; when both eyes are affected, do not delay the second eye too long"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"Done"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"Plan to do"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"Save"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Share this tip"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Hide details"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Cost"]},{"tag":"p","props":{},"children":["Accompany the older person to ophthalmology once; the doctor decides whether surgery is appropriate. One eye is operated at a time; many hospitals do it as day surgery and send the patient home the same day. If both eyes have cataracts, operate in two separate procedures. Out-of-pocket cost depends on which intraocular lens (artificial lens) you choose and how local yibao reimburses — ask before surgery."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Benefit"]},{"tag":"p","props":{},"children":["A randomized trial enrolled 306 women aged 70 or older with cataracts. Half had first-eye surgery within about four weeks; half waited 12 months per usual care. Over one year, the early-surgery group had about 34% fewer falls (fall rate ratio 0.66, 95% CI 0.45 to 0.96). At least one fall occurred in 49% of the surgery group versus 45% in the wait group — no reduction. Two or more falls: 18% versus 25%. Fractures: 4 in the surgery group (3%) versus 12 (8%). A Cochrane review included this trial and concluded first-eye surgery in women reduced fall counts; second-eye surgery did not. A randomized trial of the second eye enrolled 239 women aged 70 or older. Fall rates were 32% lower in the surgery group, but the difference could be chance (fall rate ratio 0.68, 95% CI 0.39 to 1.19). In a 5% sample of US Medicare, 1,113,640 cataract patients aged 65 or older (2002–2009) were followed observationally without randomization. After surgery, one-year hip fracture odds were about 16% lower (OR 0.84, 95% CI 0.81 to 0.87). Absolute difference 0.20 percentage points — about 2 fewer cases per 1,000."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Original sources"]},{"tag":"p","props":{"className":"life-citations"},"children":["Harwood RH, Foss AJ, Osborn F, Gregson RM, Zaman A, Masud T (2005). Falls and health status in elderly women following first eye cataract surgery: a randomised controlled trial. British Journal of Ophthalmology, 89(1), 53-59. ",{"tag":"a","props":{"href":"https://doi.org/10.1136/bjo.2004.049478","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1136/bjo.2004.049478"]}," ; Foss AJ, Harwood RH, Osborn F, Gregson RM, Zaman A, Masud T (2006). Falls and health status in elderly women following second eye cataract surgery: a randomised controlled trial. Age and Ageing, 35(1), 66-71. ",{"tag":"a","props":{"href":"https://doi.org/10.1093/ageing/afj005","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1093/ageing/afj005"]}," ; Gillespie LD, Robertson MC, Gillespie WJ, et al. (2012). Interventions for preventing falls in older people living in the community. Cochrane Database of Systematic Reviews, 9, CD007146. ",{"tag":"a","props":{"href":"https://doi.org/10.1002/14651858.CD007146.pub3","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1002/14651858.CD007146.pub3"]}," ; Tseng VL, Yu F, Lum F, Coleman AL (2012). Risk of fractures following cataract surgery in Medicare beneficiaries. JAMA, 308(5), 493-501. ",{"tag":"a","props":{"href":"https://doi.org/10.1001/jama.2012.9014","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1001/jama.2012.9014"]}," ; Desapriya E, Subzwari S, Scime-Beltrano G, et al. (2010). Vision improvement and reduction in falls after expedited cataract surgery: systematic review and metaanalysis. Journal of Cataract and Refractive Surgery, 36(1), 13-19. ",{"tag":"a","props":{"href":"https://doi.org/10.1016/j.jcrs.2009.07.032","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1016/j.jcrs.2009.07.032"]}," ; Meuleners LB, Lee AH, Ng JQ, Morlet N, Fraser ML (2012). First eye cataract surgery and hospitalization from injuries due to a fall: a population-based study. Journal of the American Geriatrics Society, 60(9), 1730-1733. ",{"tag":"a","props":{"href":"https://doi.org/10.1111/j.1532-5415.2012.04098.x","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1111/j.1532-5415.2012.04098.x"]}," ; Meuleners LB, Fraser ML, Ng J, Morlet N (2014). The impact of first- and second-eye cataract surgery on injurious falls that require hospitalisation: a whole-population study. Age and Ageing, 43(3), 341-346. ",{"tag":"a","props":{"href":"https://doi.org/10.1093/ageing/aft177","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1093/ageing/aft177"]}," ; Keay L, Ho KC, Rogers K, et al. (2022). The incidence of falls after first and second eye cataract surgery: a longitudinal cohort study. Medical Journal of Australia, 217(2), 94-99. ",{"tag":"a","props":{"href":"https://doi.org/10.5694/mja2.51611","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.5694/mja2.51611"]}," ; 国家卫生健康委 (2022). 「十四五」全国眼健康规划（2021-2025年）. ",{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/2022-01/17/content_5668951.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/zhengce/zhengceku/2022-01/17/content_5668951.htm"]}]},{"tag":"a","props":{"href":"https://doi.org/10.1136/bjo.2004.049478","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Open source link"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Book note"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["Controversy: pooling the two randomized trials, the number who fell at least once did not fall significantly (OR 0.81, 95% CI 0.55 to 1.17). In Western Australian all-population hospital records, hospitalization for fall injury in the year after first-eye surgery rose 27%. Between the two surgeries, such hospitalizations were 2.14 times the pre-surgery rate. Before-after comparisons cannot separate surgery from aging. Another Australian follow-up found the largest drop in fall counts after the second eye. If both eyes have cataracts, do not delay the second too long. Between surgeries, take extra care on stairs and when getting up. A Cochrane-included trial that addressed vision problems in older people actually increased fall counts by about 57%. Surgery fixes vision; preventing falls still needs Section 1, item 13 (balance and leg strength). Whether bones can survive a fall: Section 1, item 39 (bone density screening) and item 40 (treat osteoporosis if found). National eye-health planning states cataract surgery is widely available at county level — not only at big-city hospitals. Main beneficiaries: your parents and grandparents."]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["My note"]},{"tag":"button","props":{"type":"button"},"children":["Write a reminder for yourself…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/en/tip/17-08"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Previous"]},"For families with someone bedridden at home, pressure ulcers are a top concern: use an electric alternating-pressure air mattress, turn the patient regularly, and check bony areas daily"]}]},{"tag":"a","props":{"className":"life-tip-pager-link n