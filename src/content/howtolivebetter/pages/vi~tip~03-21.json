-06"},"children":[{"tag":"span","props":{},"children":["06"]},"Khi làm việc cần suy nghĩ liên tục, chặn cả những lần gián đoạn chỉ vài giây"]},{"tag":"a","props":{"href":"/vi/tip/03-07"},"children":[{"tag":"span","props":{},"children":["07"]},"Mỗi lúc làm một việc, đừng vừa họp vừa trả lời tin nhắn"]},{"tag":"a","props":{"href":"/vi/tip/03-08"},"children":[{"tag":"span","props":{},"children":["08"]},"Một giờ trước khi ngủ không xem màn hình phát sáng, muốn đọc thì đọc sách giấy hoặc màn hình mực điện tử"]},{"tag":"a","props":{"href":"/vi/tip/03-09"},"children":[{"tag":"span","props":{},"children":["09"]},"Đến giờ là ngủ, không thức vì game, video ngắn hay nội dung khiêu dâm"]},{"tag":"a","props":{"href":"/vi/tip/03-10"},"children":[{"tag":"span","props":{},"children":["10"]},"Đêm khuya không ra quyết định lớn, không gửi tin gấp"]},{"tag":"a","props":{"href":"/vi/tip/03-11"},"children":[{"tag":"span","props":{},"children":["11"]},"Buổi chiều buồn ngủ thì ngủ 10 phút, đừng ngủ nửa giờ"]},{"tag":"a","props":{"href":"/vi/tip/03-12"},"children":[{"tag":"span","props":{},"children":["12"]},"Làm việc ở văn phòng mở thì dùng nút bịt tai hoặc tìm phòng yên tĩnh cho việc cần ghi nhớ"]},{"tag":"a","props":{"href":"/vi/tip/03-13"},"children":[{"tag":"span","props":{},"children":["13"]},"Đừng cứ tăng giờ làm mỗi tuần: vượt khoảng 49 giờ, mỗi giờ làm thêm cho ra lượng công việc tăng thêm ngày càng ít"]},{"tag":"a","props":{"href":"/vi/tip/03-14"},"children":[{"tag":"span","props":{},"children":["14"]},"Khi nhận ra mình đang nghĩ đi nghĩ lại một chuyện tồi tệ, đổi sang việc phải động tay"]},{"tag":"a","props":{"href":"/vi/tip/03-15"},"children":[{"tag":"span","props":{},"children":["15"]},"Xem câu「chắc chắn mọi chuyện sẽ tệ hơn」là triệu chứng, không phải sự thật"]},{"tag":"a","props":{"href":"/vi/tip/03-16"},"children":[{"tag":"span","props":{},"children":["16"]},"Giảm bớt các mối quan hệ làm bạn hao mòn, học cách từ chối yêu cầu không muốn nhận"]},{"tag":"a","props":{"href":"/vi/tip/03-17"},"children":[{"tag":"span","props":{},"children":["17"]},"Khi giận thì đi khỏi chỗ đó trước, coi đối phương như thời tiết chứ không như kẻ thù"]},{"tag":"a","props":{"href":"/vi/tip/03-18"},"children":[{"tag":"span","props":{},"children":["18"]},"Khi tâm trạng tụt, làm trước mấy việc hiệu quả chi phí nhất: vận động, phơi nắng, ngủ đúng giờ, nói với ai đó, gọi 12356"]},{"tag":"a","props":{"href":"/vi/tip/03-19"},"children":[{"tag":"span","props":{},"children":["19"]},"Xem cảnh sát, bác sĩ và nhân viên giao dịch là người đi làm theo quy định, đừng xem là một vai diễn: thứ đẩy việc tới đích là giấy tờ và thời hạn, không phải cảm xúc"]},{"tag":"a","props":{"href":"/vi/tip/03-20"},"children":[{"tag":"span","props":{},"children":["20"]},"Đừng coi việc「xem người khác sống thế nào」là phần bắt buộc phải đọc mỗi ngày: giới hạn hoặc tắt luôn các app lướt bảng tin của người cùng tuổi"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/vi/tip/03-21","data-status":"active"},"children":[{"tag":"span","props":{},"children":["21"]},"Khi thấy「ai cũng thấy mình mất mặt」thì chia đôi con số ước lượng đó"]},{"tag":"a","props":{"href":"/vi/tip/03-22"},"children":[{"tag":"span","props":{},"children":["22"]},"Xem câu「người khác đòi tôi hoàn hảo」là triệu chứng, không phải sự thật"]},{"tag":"a","props":{"href":"/vi/tip/03-23"},"children":[{"tag":"span","props":{},"children":["23"]},"Khi giận đừng trút bằng cách đập đồ, đấm bao cát, chạy một vòng; hãy làm cơ thể chậm lại trước"]},{"tag":"a","props":{"href":"/vi/tip/03-24"},"children":[{"tag":"span","props":{},"children":["24"]},"Có một chuyện đè nặng trong lòng, có thể viết suốt mấy ngày liền tư tưởng và cảm xúc của mình ra, nhưng đừng trông chờ nó chữa bệnh"]},{"tag":"a","props":{"href":"/vi/tip/03-25"},"children":[{"tag":"span","props":{},"children":["25"]},"Đau bụng kinh thì dùng thuốc giảm đau như ibuprofen, đừng cố chịu; đau đến mức ảnh hưởng đi làm, đi học hoặc dùng thuốc ba tháng vẫn không kiểm soát được thì đi khám phụ khoa"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"Breadcrumbs"},"children":[{"tag":"a","props":{"href":"/vi/book"},"children":["Khám phá cuốn sách"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/vi/book/03"},"children":["Chương 3"," ·"," ","Đừng phí sức"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"03-21"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["21"]},{"tag":"span","props":{"className":"life-evidence grade-b"},"children":["Bằng chứng"," ","B"]}]},{"tag":"h1","props":{"lang":"vi"},"children":["Khi thấy「ai cũng thấy mình mất mặt」thì chia đôi con số ước lượng đó"]},{"tag":"p","props":{"lang":"vi","className":"life-entry-summary"},"children":["Bước vào phòng có người mặc chiếc T-shirt đáng xấu hổ, người mặc nghĩ gần một nửa số người nhận ra ai được in trên áo, thực tế chưa đến một phần tư. Mặc chiếc T-shirt thấy tử tế thì con số ước lượng gấp sáu lần thực tế. Sau khi trò chuyện, người ta cũng đánh giá thấp mức đối phương thích mình. Vậy khi thấy「ai cũng nhớ mình mất mặt」, chia đôi vẫn còn cao."]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Chi phí"]},{"tag":"p","props":{},"children":["Không tốn tiền. Chỉ là tự hỏi thêm một câu lúc căng thẳng:…"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Lợi ích"]},{"tag":"p","props":{},"children":["Thí nghiệm một: cho người tham dự mặc T-shirt in hình Barry Manilow, bước vào phòng có người tham dự khác. Ngư…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"Đánh dấu: Khi thấy「ai cũng thấy mình mất mặt」thì chia đôi con số ước lượng đó"},"children":[{"tag":"button","props":