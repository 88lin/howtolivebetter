ssName":""},"children":[{"tag":"span","props":{},"children":["09"]},"确诊痛风后长了痛风石、影像上看到骨头被啃出缺损或每年发作 2 次以上的，就长期吃降尿酸药，把血尿酸压到 360 µmol/L 以下并一直维持"]},{"tag":"a","props":{"href":"/tip/16-10","className":""},"children":[{"tag":"span","props":{},"children":["10"]},"得过痛风的，吃烧烤、聚餐时别一顿吃下大量肉和海鲜，酒也要少喝"]},{"tag":"a","props":{"href":"/tip/16-11","className":""},"children":[{"tag":"span","props":{},"children":["11"]},"查出乙肝表面抗原阳性的，每半年做一次肝脏 B 超加甲胎蛋白，按医生评估决定吃不吃抗病毒药，吃上了别自己停"]},{"tag":"a","props":{"href":"/tip/16-12","className":""},"children":[{"tag":"span","props":{},"children":["12"]},"确诊慢阻肺的，复诊时让医生或药师看你当面用一遍吸入剂；因为急性加重住过院的，出院后去做肺康复"]},{"tag":"a","props":{"href":"/tip/16-13","className":""},"children":[{"tag":"span","props":{},"children":["13"]},"有糖尿病的每年查一次尿白蛋白肌酐比和血肌酐，有高血压的也要查，早点发现慢性肾病"]},{"tag":"a","props":{"href":"/tip/16-14","className":"active"},"children":[{"tag":"span","props":{},"children":["14"]},"结肠癌做完手术和化疗的，参加有人指导的运动方案，坚持练满三年"]}]}]},{"tag":"div","props":{"className":"life-tip-page","data-tip-locales":"zh"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"当前位置"},"children":[{"tag":"a","props":{"href":"/book"},"children":["阅读全书"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/book/16"},"children":["第 16 章 · 得了慢性病之后怎么活"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"16-14"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["14"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["证据 A"]}]},{"tag":"h1","props":{"lang":"zh"},"children":["结肠癌做完手术和化疗的，参加有人指导的运动方案，坚持练满三年"]},{"tag":"p","props":{"lang":"zh","className":"life-entry-summary"},"children":["结肠癌做完手术和化疗以后，参加三年有人指导的运动方案的人，复发、长新癌或死亡的可能低约 28%，死亡低约 37%。8 年后还活着的，练的人约九成，只拿宣传材料的约八成三。练的人肌肉、关节受伤的多一些。"]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["成本"]},{"tag":"p","props":{},"children":["走路这类运动不花钱。找医院的康复科或运动处方门诊做体能评估、开运动方案，要挂号费和检查费，请私人教练另算。每周要多花几个小时运动，还要坚持三年。练的人肌肉、关节受伤的多一些。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["收益"]},{"tag":"p","props":{},"children":["一项在 55 个中心做的随机分组试验（CHALLENGE），收了 889 名结肠癌病人。他们都做完了手术和辅助化疗，属于高危 II 期或 III 期，入组时没有转移。化疗结束后 2 到 6 个月入组，入组前每周运动不到 150 分钟。445 人参加三年的运动方案，444 人只拿健康宣传材料。运动方案…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"标记：结肠癌做完手术和化疗的，参加有人指导的运动方案，坚持练满三年"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"已做到"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"加入待做"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"收藏"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"分享这条建议"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"收起详情"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["成本"]},{"tag":"p","props":{"className":"life-citations"},"children":["走路这类运动不花钱。找医院的康复科或运动处方门诊做体能评估、开运动方案，要挂号费和检查费，请私人教练另算。每周要多花几个小时运动，还要坚持三年。练的人肌肉、关节受伤的多一些。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["收益"]},{"tag":"p","props":{"className":"life-citations"},"children":["一项在 55 个中心做的随机分组试验（CHALLENGE），收了 889 名结肠癌病人。他们都做完了手术和辅助化疗，属于高危 II 期或 III 期，入组时没有转移。化疗结束后 2 到 6 个月入组，入组前每周运动不到 150 分钟。445 人参加三年的运动方案，444 人只拿健康宣传材料。运动方案前 6 个月，每两周见一次运动指导员，谈怎么坚持，还要在指导员看着下练一次。6 到 12 个月改成面谈或电话，之后到第 3 年只留最少的支持。目标是比原来每周多出 10 个代谢当量小时（衡量运动量的单位）的运动，中等强度以上的运动都算，方案预计多数人会选走路。一年时，运动组每周的休闲运动量多了 15.6 个代谢当量小时，对照组多了 5.1。中位跟踪 7.9 年。复发、长新癌或死亡，运动组比对照组低约 28%，HR 0.72（95% CI 0.55–0.94）。5 年时没出这些事的，80.3% 对 73.9%。死亡低约 37%，HR 0.63（0.43–0.94）。8 年还活着的，90.3% 对 83.2%。肌肉骨骼方面的不良事件，18.5% 对 11.5%。同一试验的费用分析按加拿大公费医疗算，运动方案每人先花 2917 加元，但复发少了，5 年总费用反而每人少 1589 加元"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["来源"]},{"tag":"p","props":{"className":"life-citations"},"children":["Courneya KS, Vardy JL, O'Callaghan CJ, et al.; CHALLENGE Investigators (2025). Structured Exercise after Adjuvant Chemotherapy for Colon Cancer. New England Journal of Medicine, 393(1), 13-25. ",{"tag":"a","props":{"href":"https://doi.org/10.1056/NEJMoa2502760","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1056/NEJMoa2502760"]},"；ClinicalTrials.gov NCT00819208. Colon Health and Life-Long Exercise Change Trial（试验方案与入组条件）. ",{"tag":"a","props":{"href":"https://clinicaltrials.gov/study/NCT00819208","target":"_blank","rel":"noopener noreferrer"},"children":["https://clinicaltrials.gov/study/NCT00819208"]},"；Courneya KS, Vardy JL, O'Callaghan CJ, et al. (2016). Effects of a Structured Exercise Program on Physical Activity and Fitness in Colon Cancer Survivors: One Year Feasibility Results from the CHALLENGE Trial. Cancer Epidemiology, Biomarkers & Prevention, 25(6), 969-977. ",{"tag":"a","props":{"href":"https://doi.org/10.1158/1055-9965.EPI-15-1267","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1158/1055-9965.EPI-15-1267"]},"；Chan KKW, Chu RWK, Cheung MC, et al.; CHALLENGE Investigators (2026). Structured Exercise Program After Adjuvant Chemotherapy for Colon Cancer: A Cost-Utility Analysis of the CHALLENGE Trial. Journal of Clinical Oncology, 44(22), 2130-2139. ",{"tag":"a","props":{"href":"https://doi.org/10.1200/JCO-26-00765","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1200/JCO-26-00765"]},""]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["原书备注"]},{"tag":"p","props":{"className":"life-citations"},"children":["试验只收结肠癌，不收直肠癌，也只收手术切干净、做完化疗、没转移的人。所以不能直接套到别的癌症和晚期病人身上。主要结果是复发、长新癌或死亡。总死亡是次要结果，作者的说法是「和活得更长相符」，没有把它当成定论。国内没有现成的同款项目，可以请肿瘤科或康复医学科开运动处方。开练前先做体能评估，试验里每人入组前都做了运动测试。走路的量怎么算，见第 2 节第 11 条（每天走到 7000–8000 步）。力量训练见第 2 节第 16 条（力量训练）。受益人主要是你自己。"]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["我的备注"]},{"tag":"button","props":{"type":"button"},"children":["写下对自己有用的提醒…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/tip/16-13"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["上一条"]},"有糖尿病的每年查一次尿白蛋白肌酐比和血肌酐，有高血压的也要查，早点发现慢性肾病"]}]},{"tag":"span","props":{},"children":[]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["本主题的其他建议"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/16-03"},"children":[{"tag":"strong","props":{},"children":["复查按医生给的间隔做，把每次的指标记在同一个本子上"]},{"tag":"span","props":{},"children":["慢性病看的是一段时间里的变化，不是某一次的数值。光自己在家量血压，看不出血压因此降下来。把读数带给医生、让医生照着调药，血压才降得多一些。换医院时，标着互认标志…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/16-04"},"children":[{"tag":"strong","props":{},"children":["别为了试偏方、保健品停掉正规治疗"]},{"tag":"span","props":{},"children":["本来能治的癌症，只用替代疗法、不做正规治疗的人，死亡风险是正规治疗的 2.5 倍。边治边用补充疗法的人更常拒绝手术、化疗和放疗，多出来的死亡就出在这里。有的草药…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/16-05"},"children":[{"tag":"strong","props":{},"children":["病情稳定的慢性病，在社区医院一次可以开到 12 周的药"]},{"tag":"span","props":{},"children":["病情稳定、吃的药也没换的人，在社区卫生服务中心一次最多能开 12 周的药。省掉每月往返大医院排队挂号的半天。在同一个参保地里，住基层医院的报销比例原则上要比上一…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/16-06"},"children":[{"tag":"strong","props":{},"children":["在社区签家庭医生之前，问清楚哪些进医保、哪些自费"]},{"tag":"span","props":{},"children":["签约的基本服务包按规定走医保。个性化服务包的钱要全部自己出。有人推销「升级包」的时候，先问清楚这是基本包还是个性化包、备没备案、一年多少钱。"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/16-07"},"children":[{"tag":"strong","props":{},"children":["确诊糖尿病就去查一次眼底，之后按医生给的间隔查；每年查一次脚"]},{"tag":"span","props":{},"children":["糖尿病伤到眼底、伤到脚，在坏到看不见、烂起来之前几乎没有感觉。早查出来还有得治。2 型糖尿病确诊当时就查一次散瞳眼底，1 型在发病 5 年后开始查。查过一两次没…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/16-08"},"children":[{"tag":"strong","props":{},"children":["得过肾结石就把水喝到每天 2.5–3 升，盐降到 6 克以内"]},{"tag":"span","props":{},"children":["第一次长了钙结石、又查不出原因的人，什么都不做的话，五年里约四分之一会再长。每天把水喝够的人，五年里复发的只有一成多，少了一半多。英国指南给的量是每天喝 2.5…"]}]}]}]},{"tag":"a","props":{"className":"life-text-link","href":"/book/16"},"children":["阅读整个主题：得了慢性病之后怎么活 ",{"tag":"svg","props":{"xml