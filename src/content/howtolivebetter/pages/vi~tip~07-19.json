"18","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-up-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M7 7h10v10"},"children":[]},{"tag":"path","props":{"d":"M7 17 17 7"},"children":[]}]}]}]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/vi/book/07"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"Quay lại mục lục"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["Sống thế nào khi hết tiền"]},{"tag":"div","props":{"data-ad-dock-host":"true"},"children":[]},{"tag":"nav","props":{"aria-label":"Các mục trong chương"},"children":[{"tag":"a","props":{"href":"/vi/tip/07-01"},"children":[{"tag":"span","props":{},"children":["01"]},"Mất việc thì xin trợ cấp thất nghiệp trực tuyến trước"]},{"tag":"a","props":{"href":"/vi/tip/07-02"},"children":[{"tag":"span","props":{},"children":["02"]},"Bị nợ lương thì khiếu nại giám sát lao động trước, không được thì xin hoà giải lao động, cả hai đường đều miễn phí"]},{"tag":"a","props":{"href":"/vi/tip/07-03"},"children":[{"tag":"span","props":{},"children":["03"]},"Không đủ tiền kiện tụng thì xin trợ giúp pháp lý, các vụ đòi lương, cấp dưỡng, tai nạn lao động vốn đã nằm trong phạm vi"]},{"tag":"a","props":{"href":"/vi/tip/07-04"},"children":[{"tag":"span","props":{},"children":["04"]},"Không còn đường lui thì đến trạm cứu hộ, ở ăn ở và có vé về quê"]},{"tag":"a","props":{"href":"/vi/tip/07-05"},"children":[{"tag":"span","props":{},"children":["05"]},"Tìm việc thì dùng dịch vụ việc làm công cộng miễn phí và thị trường việc lẻ trước, đừng qua môi giới thu phí"]},{"tag":"a","props":{"href":"/vi/tip/07-06"},"children":[{"tag":"span","props":{},"children":["06"]},"Gặp biến cố đột ngột thì xin trợ cấp tạm thời trước"]},{"tag":"a","props":{"href":"/vi/tip/07-07"},"children":[{"tag":"span","props":{},"children":["07"]},"Thu nhập thấp hơn mức trợ cấp người có thu nhập thấp ở địa phương thì xin trợ cấp người có thu nhập thấp"]},{"tag":"a","props":{"href":"/vi/tip/07-08"},"children":[{"tag":"span","props":{},"children":["08"]},"Người có giấy chứng nhận người khuyết tật thì đi xin hai khoản trợ cấp cho người khuyết tật"]},{"tag":"a","props":{"href":"/vi/tip/07-09"},"children":[{"tag":"span","props":{},"children":["09"]},"Đừng để bảo hiểm y tế cư dân bị đứt quãng mỗi năm 400 tệ, hộ khó khăn được miễn giảm"]},{"tag":"a","props":{"href":"/vi/tip/07-10"},"children":[{"tag":"span","props":{},"children":["10"]},"Mắc bệnh nặng thì đi theo bảo hiểm y tế, bảo hiểm bệnh nan y, trợ cấp y tế và đăng ký khám ngoài tỉnh trước, đừng đụng vào vay tiền trên mạng"]},{"tag":"a","props":{"href":"/vi/tip/07-11"},"children":[{"tag":"span","props":{},"children":["11"]},"Mất thẻ căn cước thì đi làm lại ngay, gấp thì xin thẻ tạm trước"]},{"tag":"a","props":{"href":"/vi/tip/07-12"},"children":[{"tag":"span","props":{},"children":["12"]},"Làm xong đăng ký thất nghiệp thì hãy xin công nhận là người khó khăn việc làm, để nhận trợ cấp bảo hiểm xã hội hoặc làm công việc công ích"]},{"tag":"a","props":{"href":"/vi/tip/07-13"},"children":[{"tag":"span","props":{},"children":["13"]},"Trong thời gian thất nghiệp thì đi nhận trợ cấp đào tạo nghề, trợ cấp thực tập việc làm và trợ cấp bảo hiểm xã hội, đừng tự bỏ tiền học khóa"]},{"tag":"a","props":{"href":"/vi/tip/07-14"},"children":[{"tag":"span","props":{},"children":["14"]},"Tìm việc đừng chỉ nộp hồ sơ, hãy dùng cách có hệ thống: học kỹ thuật, đặt mục tiêu, nhờ người khác giúp"]},{"tag":"a","props":{"href":"/vi/tip/07-15"},"children":[{"tag":"span","props":{},"children":["15"]},"Không nộp tiền cọc, không giữ giấy tờ, không ký「培训贷」, không vào đa cấp, không vay lãi cao"]},{"tag":"a","props":{"href":"/vi/tip/07-16"},"children":[{"tag":"span","props":{},"children":["16"]},"Khó ở nhà thì xếp hàng chờ nhà ở công lập trước"]},{"tag":"a","props":{"href":"/vi/tip/07-17"},"children":[{"tag":"span","props":{},"children":["17"]},"Ép chi phí ở và ăn xuống mức thấp nhất: thuê chung theo tháng thay vì thuê theo ngày, tự nấu ăn và bếp ăn trợ giúp thay cho đồ ăn giao"]},{"tag":"a","props":{"href":"/vi/tip/07-18"},"children":[{"tag":"span","props":{},"children":["18"]},"Bảo hiểm xã hội đứt quãng thì đừng hoảng: lương hưu tính theo số năm tích luỹ, bảo hiểm y tế nộp bù theo quy định"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/vi/tip/07-19","data-status":"active"},"children":[{"tag":"span","props":{},"children":["19"]},"Từng vào tù, từng phá sản, từng bị đưa vào danh sách không thi hành án, pháp luật vẫn còn đường bắt đầu lại, trước hết làm hết thủ tục"]},{"tag":"a","props":{"href":"/vi/tip/07-20"},"children":[{"tag":"span","props":{},"children":["20"]},"Trước khi mắc bệnh nặng, ngoài bảo hiểm y tế cơ bản thì mua một bảo hiểm y tế hoặc bảo hiểm bệnh hiểm nặng hạn một năm, và đọc kỹ bốn chữ「保证续保」"]},{"tag":"a","props":{"href":"/vi/tip/07-21"},"children":[{"tag":"span","props":{},"children":["21"]},"Thật sự không có chỗ ngủ, nơi mở cửa 24 giờ chỉ cứu vãn được một đêm, ưu tiên đến trạm cứu hộ"]},{"tag":"a","props":{"href":"/vi/tip/07-22"},"children":[{"tag":"span","props":{},"children":["22"]},"Bị nợ lương công nhân, trước hết phân biệt ai là người thuê bạn"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"Breadcrumbs"},"children":[{"tag":"a","props":{"href":"/vi/book"},"children":["Khám phá cuốn sách"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/vi/book/07"},"children":["Chương 7"," ·"," ","Sống thế nào khi hết tiền"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"07-19"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["19"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["Bằng chứng"," ","A"]}]},{"tag":"h1","props":{"lang":"vi"},"children":["Từng vào tù, từng phá sản, từng bị đưa vào danh sách không thi hành án, pháp luật vẫn còn đường bắt đầu lại, trước hết làm hết thủ tục"]},{"tag":"p","props":{"lang":"vi","className":"life-entry-summary"},"children":["Người vừa hết án tù không bị phân biệt đối xử về việc làm, học tập, bảo hiểm xã hội, người khó khăn về sinh hoạt thì do chính quyền giúp sắp xếp. Người khi phạm tội chưa đầy 18 tuổi, bị phán không quá 5 năm thì lý lịch được niêm phong, khi nhập quân hay tìm việc không phải khai. Thời hạn trong danh sách không thi hành án là 2 năm, trả xong tiền thì tòa án phải xoá tên trong 3 ngày làm việc. Tiền án của người thành niên không niêm phong, khi nhập quân hay xin việc phải khai trung thực."]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Chi phí"]},{"tag":"p","props":{},"children":["Không thu phí. Người vừa hết án tù thì đến văn phòng tư ph…"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Lợi ích"]},{"tag":"p","props":{},"children":["Người vừa hết án tù theo pháp luật có quyền ngang bằng công dân khác, không bị phân biệt đối xử về việc làm, h…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"Đánh dấu: Từng vào tù, từng phá sản, từng bị đưa vào danh sách không thi hành án, pháp luật vẫn còn đường bắt đầu lại, trướ