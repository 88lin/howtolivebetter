d","className":"lucide lucide-circle-user-round","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M18 20a6 6 0 0 0-12 0"},"children":[]},{"tag":"circle","props":{"cx":"12","cy":"10","r":"4"},"children":[]},{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},{"tag":"span","props":{},"children":["Войти"]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/ru/book/12"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"К содержанию"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["Открытие бизнеса: как не потерять все сбережения"]},{"tag":"nav","props":{"aria-label":"Советы главы"},"children":[{"tag":"a","props":{"href":"/ru/tip/12-01"},"children":[{"tag":"span","props":{},"children":["01"]},"Инвестируйте только те средства, которые можете позволить себе потерять — не трогайте семейные сбережения и не берите кредиты"]},{"tag":"a","props":{"href":"/ru/tip/12-02"},"children":[{"tag":"span","props":{},"children":["02"]},"Не ставьте личную гарантию за компанию, а супругу тем более не вовлекайте"]},{"tag":"a","props":{"href":"/ru/tip/12-03"},"children":[{"tag":"span","props":{},"children":["03"]},"Правильный выбор формы бизнеса до открытия: при индивидуальном предпринимательстве и обычном партнерстве ответственность неограниченна, а в ООО она «ограничена»"]},{"tag":"a","props":{"href":"/ru/tip/12-04"},"children":[{"tag":"span","props":{},"children":["04"]},"Неправомерное включение в число акционеров — риск нести чужие долги"]},{"tag":"a","props":{"href":"/ru/tip/12-05"},"children":[{"tag":"span","props":{},"children":["05"]},"Перед подписанием договора проверьте наличие регистрации в Министерстве коммерции и получите письменную информацию; обязательно включите в договор условие о «периоде раздумий»"]},{"tag":"a","props":{"href":"/ru/tip/12-06"},"children":[{"tag":"span","props":{},"children":["06"]},"Перед регистрацией нужно определить название, место ведения бизнеса, сферу деятельности и размер уставного капитала — при наличии всех документов бизнес-лицензию выдадут сразу"]},{"tag":"a","props":{"href":"/ru/tip/12-07"},"children":[{"tag":"span","props":{},"children":["07"]},"Бизнес, требующий лицензии: начинать работу можно только после её получения"]},{"tag":"a","props":{"href":"/ru/tip/12-08"},"children":[{"tag":"span","props":{},"children":["08"]},"Определите, к какой категории вы относитесь: для производства продуктов питания и ресторанного бизнеса требуется разрешение, для продажи только готовой упакованной продукции достаточно регистрации, а для продажи свежих овощей и мяса разрешение не нужно"]},{"tag":"a","props":{"href":"/ru/tip/12-09"},"children":[{"tag":"span","props":{},"children":["09"]},"Упаковка продукта делает его предварительно упакованной пищевой продукцией: на этикетке обязательно указываются дата производства, срок годности и состав"]},{"tag":"a","props":{"href":"/ru/tip/12-10"},"children":[{"tag":"span","props":{},"children":["10"]},"На обычные продукты питания нельзя указывать, что они лечат болезни: это касается этикеток, инструкций, рекламы и текстов для прямых трансляций"]},{"tag":"a","props":{"href":"/ru/tip/12-11"},"children":[{"tag":"span","props":{},"children":["11"]},"В этой сфере действуют уголовные нормы: продажа мяса от больных животных или продукции с превышенным содержанием вредных веществ уже является преступлением; добавление в пищу токсичных и вредных веществ влечет наказание от 5 лет лишения свободы независимо от суммы оборота"]},{"tag":"a","props":{"href":"/ru/tip/12-12"},"children":[{"tag":"span","props":{},"children":["12"]},"После получения бизнес-лицензии возникает обязанность по подаче налоговой отчетности; даже при отсутствии дохода её нужно подавать с нуля (заполняя все поля нулями)"]},{"tag":"a","props":{"href":"/ru/tip/12-13"},"children":[{"tag":"span","props":{},"children":["13"]},"Счета-фактуры выписываются только по реальным сделкам; малые предприятия могут полностью освободиться от НДС"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/ru/tip/12-14","data-status":"active"},"children":[{"tag":"span","props":{},"children":["14"]},"Мошенники выдают себя за сотрудников налоговой службы и требуют оплаты и подачи деклараций; на самом деле это обман. Официальные каналы для налоговых дел — электронная налоговая система и горячая линия 12366"]},{"tag":"a","props":{"href":"/ru/tip/12-15"},"children":[{"tag":"span","props":{},"children":["15"]},"При написании «задаток» вместо «предоплата» соблюдайте правила двойного возврата, четко пропишите размер неустойки, а предоставление отсрочки платежа рассматривайте как выдачу займа"]},{"tag":"a","props":{"href":"/ru/tip/12-16"},"children":[{"tag":"span","props":{},"children":["16"]},"Заключение письменного трудового договора в первый месяц работы и регистрация в соцстрахе в течение 30 дней"]},{"tag":"a","props":{"href":"/ru/tip/12-17"},"children":[{"tag":"span","props":{},"children":["17"]},"Зарплата выплачивается согласно договору и закону; повышения, займы и премии оформляются письменно"]},{"tag":"a","props":{"href":"/ru/tip/12-18"},"children":[{"tag":"span","props":{},"children":["18"]},"Продавать сначала, а потом производить: проверить спрос через предзаказы и мелкие заказы, прежде чем вкладывать средства в производство"]},{"tag":"a","props":{"href":"/ru/tip/12-19"},"children":[{"tag":"span","props":{},"children":["19"]},"Сначала сверяем образец с перечнем требований для массового производства, а потом приступаем к запуску"]},{"tag":"a","props":{"href":"/ru/tip/12-20"},"children":[{"tag":"span","props":{},"children":["20"]},"Сохраняйте документы и эти поставщика; не закупайте товары по цене, значительно ниже рыночной: если сотрудник привез подделку, ответственность несет руководитель"]},{"tag":"a","props":{"href":"/ru/tip/12-21"},"children":[{"tag":"span","props":{},"children":["21"]},"Для товаров, упаковки, этикеток и рекламных изображений нужно либо создавать графику самостоятельно, либо покупать лицензию; изменение цвета или добавление своего значка не считается «изменением»"]},{"tag":"a","props":{"href":"/ru/tip/12-22"},"children":[{"tag":"span","props":{},"children":["22"]},"Соблюдение установленных правил на рабочем месте и чёткое понимание ответственности при проявлении доброй воли вне этих рамок"]},{"tag":"a","props":{"href":"/ru/tip/12-23"},"children":[{"tag":"span","props":{},"children":["23"]},"Если убытки — действуйте по процедуре: при возможности проводите упрощённую ликвидацию, а если активы не покрывают долги — подавайте на банкротство, не оставляйте дело без внимания"]},{"tag":"a","props":{"href":"/ru/tip/12-24"},"children":[{"tag":"span","props":{},"children":["24"]},"Прежде чем тратить деньги на аутсорсинг управления интернет-магазином, курсы по открытию магазина или схему «без собственного товара», выясните, потребуются ли дополнительные расходы и откуда возьмётся продажная статистика"]},{"tag":"a","props":{"href":"/ru/tip/12-25"},"children":[{"tag":"span","props":{},"children":["25"]},"Компании и индивидуальные предприниматели в Китае ежегодно с 1 января по 30 июня подают онлайн отчёт за прошлый год, даже без деятельности; отчёт бесплатен"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"Навигация"},"children":[{"tag":"a","props":{"href":"/ru/book"},"children":["Книга"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/ru/book/12"},"children":["Глава 12"," ·"," ","Открытие бизнеса: как не потерять все сбережения"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"12-14"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["14"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["Доказательства"," ","A"]}]},{"tag":"h1","props":{"lang":"ru"},"children":["Мошенники выдают себя за сотрудников налоговой службы и требуют оплаты и подачи деклараций; на самом деле это обман. Официальные каналы для налоговых дел — электронная налоговая система и горячая линия 12366"]},{"tag":"p","props":{"lang":"ru","className":"life-entry-summary"},"children":["Сотрудники налоговой службы никогда не запрашивают по телефону пароль от банковской карты, платежный пароль или код подтверждения из SMS, также не просят перевести налоги на какой-либо счет. Если действительно приезжают с проверкой, они обязаны предъявить уведомление о проверке и служебное удостоверение. При получении подобных звонков сразу кладите трубку и звоните на 12366 для проверки. Если вы уже перевели деньги, немедленно звоните 110 или 96110, чтобы заблокировать операцию."]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Затраты"]},{"tag":"p","props":{},"children":["Бесплатно. Если поступает звонок или сообщение о «налогово…"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Польза"]},{"tag":"p","props":{},"children":["Официальное предупреждение Государственной налоговой службы: «Сотрудники налоговой службы не запрашивают по We…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"Отметить: Мошенники выдают себя за сотрудников налоговой службы и требуют оплаты и подачи деклараций; на самом деле это обман. Официальные каналы для налоговых дел — электронная налоговая система и горячая линия 12366"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"Сделано"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"В планах"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"В избранное"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Поделиться советом"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Скрыть подробности"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Затраты"]},{"tag":"p","props":{},"children":["Бесплатно. Если поступает звонок или сообщение о «налоговой проверке», «подозрительном счете» или «штрафе за неподачу декларации», либо кто-то добавляет вас в друзья — сразу кладите трубку и не отвечайте. Затем позвоните на 12366 или на официальный телефон вашего налогового органа для проверки."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Польза"]},{"tag":"p","props":{},"children":["Официальное предупреждение Государственной налоговой службы: «Сотрудники налоговой службы не запрашивают по WeChat-минипрограммам, телефону, SMS и прочим каналам пароль от банковской карты, платежный пароль, остаток на счете или код подтверждения из SMS, связанный с оплатой по карте». «Некоторые злоумышленники выдают себя за налоговых работников, предлагая услуги по „помощи в подаче налоговой декларации“, „оформлении налоговых льгот“ и „консультации по налоговому законодательству“». Для проверки следует звонить на горячую линию 12366 или на официальный телефон налогового органа. При реальной выездной проверке («налоговой ревизии») инспекторы обязаны предъявить уведомление о проверке и служебное удостоверение. «Налоги можно уплачивать только через электронную налоговую систему или в налоговых центрах; налоговая служба не указывает какой-либо конкретный счет для оплаты». Для посреднических организаций, оказывающих услуги по налоговому учету, также действуют аналогичные правила. «Лица, вымогающие деньги у налогоплательщиков и налоговых агентов, выдавая себя за сотрудников налоговой службы, подлежат штрафу в зависимости от степени тяжести правонарушения». То есть мошенники используют имя налоговой службы и ее сотрудников для вымогательства у плательщиков и агентов. Лица, выдающие себя за госслужащих и совершающие мошеннические действия, подлежат административному аресту на срок от 10 до 15 суток и штрафу до 1000 юаней. Если деяние подпадает под признаки и мошенничества, и выдачи себя за госслужащего, применяется более строгая мера наказания (по всей стране)."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Первоисточники"]},{"tag":"p","props":{"className":"life-citations"},"children":["国家税务总局 (2025). 税务部门提醒广大纳税人——增强防范意识 警惕互联网涉税诈骗. ",{"tag":"a","props":{"href":"https://www.chinatax.gov.cn/chinatax/n810219/n810724/c5243181/content.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.chinatax.gov.cn/chinatax/n810219/n810724/c5243181/content.html"]}," ; 国家税务总局扬州市税务局 (2023). 扬州防范涉税诈骗宣传篇. ",{"tag":"a","props":{"href":"https://jiangsu.chinatax.gov.cn/art/2023/8/28/art_23038_432322.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://jiangsu.chinatax.gov.cn/art/2023/8/28/art_23038_432322.html"]}," ; 国家税务总局 (2025). 涉税专业服务管理办法（试行）（国家税务总局令第 58 号，第三十二条第七项、第三十三条）. ",{"tag":"a","props":{"href":"https://fgk.chinatax.gov.cn/zcfgk/c100011/c5239044/content.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://fgk.chinatax.gov.cn/zcfgk/c100011/c5239044/content.html"]}," ; 全国人大常委会 (2025). 治安管理处罚法（2025 年修订，2026 年 1 月 1 日施行，第六十二条）. ",{"tag":"a","props":{"href":"https://www.spp.gov.cn/spp/fl/202506/t20250627_699863.shtml","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.spp.gov.cn/spp/fl/202506/t20250627_699863.shtml"]}," ; 最高人民法院、最高人民检察院、公安部 (2016). 关于办理电信网络诈骗等刑事案件适用法律若干问题的意见（法发〔2016〕32 号）. ",{"tag":"a","props":{"href":"https://www.spp.gov.cn/zdgz/201612/t20161221_176278.shtml","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.spp.gov.cn/zdgz/201612/t20161221_176278.shtml"]}]},{"tag":"a","props":{"href":"https://www.chinatax.gov.cn/chinatax/n810219/n810724/c5243181/content.html","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Открыть источник"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Примечание автора"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["Такие мошеннические схемы чаще всего нацелены на только что зарегистрированных индивидуальных предпринимателей и малые компании. Сценарий обмана звучит так: «Система показывает, что вы не подали декларацию, и если не решите вопрос сегодня, будет штраф», после чего жертву направляют на их собственный публичный аккаунт или минипрограмму, где взимается плата в несколько сотен юаней. При этом подача декларации изначально бесплатна и занимает всего несколько минут. Обращение к коммерческим бухгалтерским фирмам не является нарушением закона, однако такие организации не являются госорганами и не имеют права требовать оплату от имени налоговой службы. Если вы уже оплатили услуги или перевели деньги, согласно пункту 2 раздела 8 (остановка мошеннической операции) немедленно звоните 110 или 96110 для блокировки транзакции. Представляться рыночным регулятором, говорить о пропущенном годовом отчёте и требовать оплату посредника — та же схема; см. пункт 25 (годовой отчёт бесплатен)."]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Моя заметка"]},{"tag":"button","props":{"type":"button"},"children":["Запишите напоминание…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/ru/tip/12-13"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 