in":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["成本"]},{"tag":"p","props":{"className":"life-citations"},"children":["不花钱，还省下一笔学费。难在孩子闹得最凶的时候，家长忍住不把他交给外人「封闭管教」。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["收益"]},{"tag":"p","props":{"className":"life-citations"},"children":["《未成年人保护法》第六十八条规定，任何组织和个人不得用侵害未成年人身心健康的方式，干预未成年人沉迷网络。下面两起案子都有法院判决。第一起在安徽合肥。2017 年 8 月，一名 18 岁男孩的父母和一家特训学校签了协议，要送他戒网瘾。学校的人把他强行带走，关进禁闭室，把他的双手铐在窗户栅栏上。他们限制他吃饭、喝水和休息，还打了他。约 44 个小时后，男孩死亡。鉴定结论是高温、限制体位、缺少饮食和外伤，引起水电解质紊乱死亡。2018 年 10 月 31 日，合肥市中级法院一审判决。学校负责人犯故意伤害罪和非法拘禁罪，判 16 年。四名教官判 1 年到 8 年 6 个月。2018 年 12 月 28 日，安徽省高级法院二审维持原判。二审裁定写明，这所学校没有经过有关部门批准，几名被告人也都没有教师资质。第二起在江西南昌。豫章书院 2013 年开办，2017 年 11 月注销停办。办学期间，学校把部分学生带进「烦闷解脱室」关禁闭，派专人看守，每次关三到十天。2023 年 4 月 28 日，萍乡市安源区法院重审一审宣判，五名被告人构成非法拘禁罪。四人判二年十个月到十一个月，并在一定期限内禁止从事和教育有关的职业，一人免予刑事处罚。家长要求赔学费和往返交通费，法院不支持（全国 / 安徽 / 江西）"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["来源"]},{"tag":"p","props":{"className":"life-citations"},"children":["全国人大常委会 (2024 年修正). 未成年人保护法（第六十八条）. ",{"tag":"a","props":{"href":"https://flk.npc.gov.cn/detail?id=ff8081818f197cf001905e567af635a0","target":"_blank","rel":"noopener noreferrer"},"children":["https://flk.npc.gov.cn/detail?id=ff8081818f197cf001905e567af635a0"]},"；红星新闻 (2019-02-20). 追热点·18岁少年被铐着关禁闭两天死亡，戒网瘾学校5人获刑. ",{"tag":"a","props":{"href":"https://static.cdsb.com/micropub/Articles/201902/5b98283216ea5d2e8eef7f8cb7d4dbbb.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://static.cdsb.com/micropub/Articles/201902/5b98283216ea5d2e8eef7f8cb7d4dbbb.html"]},"（网页存档 ",{"tag":"a","props":{"href":"https://web.archive.org/web/20261005013030/https://static.cdsb.com/micropub/Articles/201902/5b98283216ea5d2e8eef7f8cb7d4dbbb.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://web.archive.org/web/20261005013030/https://static.cdsb.com/micropub/Articles/201902/5b98283216ea5d2e8eef7f8cb7d4dbbb.html"]},"）；新华社 (2023-04-28). 江西“豫章书院案”宣判 5名被告均服判不上诉. ",{"tag":"a","props":{"href":"http://www.news.cn/2023-04/28/c_1129579126.htm","target":"_blank","rel":"noopener noreferrer"},"children":["http://www.news.cn/2023-04/28/c_1129579126.htm"]},"（网页存档 ",{"tag":"a","props":{"href":"http://web.archive.org/web/20230428212544/http://www.news.cn/2023-04/28/c_1129579126.htm","target":"_blank","rel":"noopener noreferrer"},"children":["http://web.archive.org/web/20230428212544/http://www.news.cn/2023-04/28/c_1129579126.htm"]},"）"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["原书备注"]},{"tag":"p","props":{"className":"life-citations"},"children":["给 C 是因为只有个案，没有这类学校出事多少的统计。合肥那起只有媒体报道，报道引用了一审判决书和二审裁定书，法院官网上没找到判决原文。豫章书院那起是新华社报道的法院宣判。孩子爱打游戏，先按本节第 14 条（孩子爱打游戏）看睡觉、作业和出门活动有没有被挤掉。成绩、睡觉、家里关系一起垮了，劝也停不下来，带孩子去精神科或儿童心理科，由医生诊断再治。已经送进去的，把孩子接回来。孩子说被关、被打，报警。受益人是孩子。"]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["我的备注"]},{"tag":"button","props":{"type":"button"},"children":["写下对自己有用的提醒…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/tip/30-17"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["上一条"]},"孩子难管、自己总忍不住打骂，去上一期教具体做法的家长课"]}]},{"tag":"span","props":{},"children":[]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["本主题的其他建议"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/30-11"},"children":[{"tag":"strong","props":{},"children":["孩子撑不住了可以休学，学籍学校必须给他留着，最长 1 年"]},{"tag":"span","props":{},"children":["休学有正式制度。父母或其他监护人提出申请，学校确认后报上级核准。一次最长 1 年，期满还要休就重新申请。休学期间学校要给孩子保留学籍，复学时回来接着上。具体办法…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/30-12"},"children":[{"tag":"strong","props":{},"children":["查出视力不良，去医院做散瞳验光，之后按医生给的间隔复查"]},{"tag":"span","props":{},"children":["散瞳验光是先滴一种眼药水，让眼睛里负责调焦的肌肉松下来，再验度数。这是在医院做的，诊断近视最准。卫健委写明这种药水对健康的眼睛不会造成损伤，停药后恢复正常。别拿…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/30-13"},"children":[{"tag":"strong","props":{},"children":["恒磨牙长出来以后做窝沟封闭"]},{"tag":"span","props":{},"children":["窝沟封闭是把大牙咬东西那一面的沟槽用树脂封住，食物残渣就塞不进去。做完两年，长蛀牙的机会约为不封的八分之一。不封时有 16% 的牙面会蛀，封了只有约 5%。四年…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/30-14"},"children":[{"tag":"strong","props":{},"children":["孩子爱打游戏，先看睡觉、作业和出门活动有没有被挤掉，别光盯着玩了多久"]},{"tag":"span","props":{},"children":["真正够得上「游戏障碍」的，大约每百人里两三个。问卷门槛定得低、专挑青少年查，比例就会虚高。拿游戏公司的真实记录看，玩多玩少和心情好坏几乎没关系。未成年人按规定只…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/30-15"},"children":[{"tag":"strong","props":{},"children":["孩子说自己喜欢同性，别骂、别赶出家门、别送去「矫正」：家里的态度和他会不会自杀有关"]},{"tag":"span","props":{},"children":["国内中学生里，喜欢同性或者两性都喜欢的孩子，一年里试过自杀的约是别人的 3 到 5.5 倍。国外研究看到，青春期被家里强烈排斥的孩子，后来试过自杀的多得多。被父…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/30-16"},"children":[{"tag":"strong","props":{},"children":["管孩子别动手打，也别吼骂、骂他笨：常挨打挨骂的孩子，行为和情绪问题都更多"]},{"tag":"span","props":{},"children":["常挨打的孩子，攻击性和心理问题都更多，和父母也更疏远，挨更重的打也更多。打能不能让孩子当场听话，证据说不清。13 岁时常被吼、被骂笨的孩子，之后闯祸和抑郁都更多…"]}]}]}]},{"tag":"a","props":{"className":"life-text-link","href":"/book/30"},"children":["阅读整个主题：上学以后的孩子 ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"15","height":"15","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]}]}]}]},{"tag":"aside","props":{"className":"life-ad-space life-ad-space-sponsored","data-ad-placement":"ad_footer","data-ad-group":"reading","data-ad-creative":"read_product","data-ad-ready":"false","aria-label":"广告 · 社区推荐"},"children":[{"tag":"div","props":{"className":"life-ad-space-brand"},"children":[{"tag":"img","props":{"src":"/sites/howtolivebetter/images/shengcai/logo.png","width":"565","height":"144","alt":"生财有术官方 Logo","decoding":"async"},"children":[]}]},{"tag":"div","props":{"className":"life-ad-space-copy"},"children":[{"tag":"span","props":{"className":"life-ad-space-label"},"children":["广告 · 社区推荐"]},{"tag":"strong","props":{},"children":["读过的知识，能不能做成有用的产品？"]},{"tag":"p","props":{},"children":["从电子书、资料到小工具，看看圈友怎样发现需求，把内容变成实际交付。"]}]},{"tag":"div","props":{"className":"life-ad-space-actions"},"children":[{"tag":"a","props":{"className":"life-ad-space-link","href":"/shengcaiyoushu?sc_group=reading&sc_creative=read_product&sc_placement=ad_footer"},"children":["看看社区与案例",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"18","height":"18","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-up-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M7 7h10v10"},"children":[]},{"tag":"path","props":{"d":"M7 17 17 7"},"children":[]}]}]},{"tag":"a","props":{"className":"life-ad-space-rent","href":"/advertise"},