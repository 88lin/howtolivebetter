":{},"children":["登录同步"]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/book/13"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"返回目录"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["紧急情况：先做什么"]},{"tag":"nav","props":{"aria-label":"章节条目"},"children":[{"tag":"a","props":{"href":"/tip/13-01","className":""},"children":[{"tag":"span","props":{},"children":["01"]},"有人倒地没呼吸，立刻用力按压胸口，让旁人打 120 并找 AED"]},{"tag":"a","props":{"href":"/tip/13-02","className":""},"children":[{"tag":"span","props":{},"children":["02"]},"老人摔倒、有人倒地，先蹲下喊他、打 120，别急着把人扶起来；陌生人这档走开在国内也合法，停下来就别上手搬"]},{"tag":"a","props":{"href":"/tip/13-03","className":""},"children":[{"tag":"span","props":{},"children":["03"]},"突然嘴歪、一侧胳膊没劲、说话说不清，立刻打 120，不要等、不要自己开车去"]},{"tag":"a","props":{"href":"/tip/13-04","className":""},"children":[{"tag":"span","props":{},"children":["04"]},"突然天旋地转站不稳、看东西成双、一只眼发黑，或者手指点不到自己鼻尖，也按卒中打 120"]},{"tag":"a","props":{"href":"/tip/13-05","className":""},"children":[{"tag":"span","props":{},"children":["05"]},"一只眼睛突然像拉下窗帘一样黑掉，哪怕几分钟就自己好了，也当天按卒中去急诊"]},{"tag":"a","props":{"href":"/tip/13-06","className":""},"children":[{"tag":"span","props":{},"children":["06"]},"一只眼又胀又痛、发红，看灯有一圈彩虹，还头痛恶心想吐，当天去眼科急诊"]},{"tag":"a","props":{"href":"/tip/13-07","className":""},"children":[{"tag":"span","props":{},"children":["07"]},"胸口压着疼、闷、发紧超过 15 分钟不缓解，打 120，不要自己扛也不要自己开车"]},{"tag":"a","props":{"href":"/tip/13-08","className":""},"children":[{"tag":"span","props":{},"children":["08"]},"突然像被撕开一样的剧痛，从胸口往后背、往腰一路挪，打 120 并说清「疼在移动」"]},{"tag":"a","props":{"href":"/tip/13-09","className":""},"children":[{"tag":"span","props":{},"children":["09"]},"突然一记「这辈子最疼的头痛」，一小时内就到最疼，立刻去急诊做头颅 CT"]},{"tag":"a","props":{"href":"/tip/13-10","className":""},"children":[{"tag":"span","props":{},"children":["10"]},"老人磕过头之后两三周到几个月变得走路不稳、迟钝、嗜睡或者一侧没劲，去做头颅 CT"]},{"tag":"a","props":{"href":"/tip/13-11","className":""},"children":[{"tag":"span","props":{},"children":["11"]},"一条腿突然肿起来、发紧、按着疼，尽快就医；再加上突然喘不上气或者胸痛，立刻打 120"]},{"tag":"a","props":{"href":"/tip/13-12","className":""},"children":[{"tag":"span","props":{},"children":["12"]},"大出血先用手死死压住伤口，四肢压不住就上止血带，同时打 120"]},{"tag":"a","props":{"href":"/tip/13-13","className":""},"children":[{"tag":"span","props":{},"children":["13"]},"被狗、猫咬伤或抓破皮，先用肥皂水和流水交替冲 15 分钟，当天去打疫苗"]},{"tag":"a","props":{"href":"/tip/13-14","className":""},"children":[{"tag":"span","props":{},"children":["14"]},"烫伤后立刻用凉的流动水冲 20 分钟，别抹牙膏酱油"]},{"tag":"a","props":{"href":"/tip/13-15","className":"active"},"children":[{"tag":"span","props":{},"children":["15"]},"突然全身起疹、喘不上气或者发晕，按过敏性休克处理，立刻叫 120 并说清楚"]},{"tag":"a","props":{"href":"/tip/13-16","className":""},"children":[{"tag":"span","props":{},"children":["16"]},"有人抽搐倒地，清开周围、让他侧躺、看表计时，什么都别往嘴里塞"]},{"tag":"a","props":{"href":"/tip/13-17","className":""},"children":[{"tag":"span","props":{},"children":["17"]},"糖尿病人突然发抖、出冷汗、说话不清，先给 15 克糖，15 分钟后复测"]},{"tag":"a","props":{"href":"/tip/13-18","className":""},"children":[{"tag":"span","props":{},"children":["18"]},"有人触电，先断电，再用干燥的木棍之类挑开电源，不要直接上手拉"]},{"tag":"a","props":{"href":"/tip/13-19","className":""},"children":[{"tag":"span","props":{},"children":["19"]},"一氧化碳报警器响了，或者一屋子人同时头痛恶心，先出门再打电话"]},{"tag":"a","props":{"href":"/tip/13-20","className":""},"children":[{"tag":"span","props":{},"children":["20"]},"误服清洁剂、农药、药物先别催吐，带上瓶子立刻就医；溅到眼睛或皮肤用大量清水至少冲 15 分钟"]},{"tag":"a","props":{"href":"/tip/13-21","className":""},"children":[{"tag":"span","props":{},"children":["21"]},"酸碱等化学品溅到身上，立刻脱掉污染的衣服、用大量流动清水冲，眼睛要掰开眼皮冲，冲够时间再走"]},{"tag":"a","props":{"href":"/tip/13-22","className":""},"children":[{"tag":"span","props":{},"children":["22"]},"高温下头晕、恶心、不出汗或意识不清，立刻挪到阴凉处脱衣泼水降温，意识不清的不喂水、打 120"]},{"tag":"a","props":{"href":"/tip/13-23","className":""},"children":[{"tag":"span","props":{},"children":["23"]},"中暑的人只要清醒，就少量多次喝凉的淡盐水或运动饮料，别猛灌、别喝酒和高糖饮料"]},{"tag":"a","props":{"href":"/tip/13-24","className":""},"children":[{"tag":"span","props":{},"children":["24"]},"火灾时贴地爬、摸门再开门、门烫就别开，走楼梯不坐电梯，出去了别回头"]},{"tag":"a","props":{"href":"/tip/13-25","className":""},"children":[{"tag":"span","props":{},"children":["25"]},"看到有人溺水，先叫人和打 110/120，伸竿、抛漂浮物，自己不下水"]},{"tag":"a","props":{"href":"/tip/13-26","className":""},"children":[{"tag":"span","props":{},"children":["26"]},"有人噎住说不出话，1 岁以上的站到背后做 5 次拍背加 5 次腹部冲击，倒下就做心肺复苏"]},{"tag":"a","props":{"href":"/tip/13-27","className":""},"children":[{"tag":"span","props":{},"children":["27"]},"在戈壁、沙漠、无人区迷路或车坏了，留在原地或车旁，先报位置，再遮阳保温，省水，不乱走"]},{"tag":"a","props":{"href":"/tip/13-28","className":""},"children":[{"tag":"span","props":{},"children":["28"]},"发抖、说话含糊、走路打晃是失温，换掉湿衣、包起来，先暖躯干，喝热甜饮不喝酒"]},{"tag":"a","props":{"href":"/tip/13-29","className":""},"children":[{"tag":"span","props":{},"children":["29"]},"被蛇咬，坐下别动、摘掉戒指手表、尽快送医院打抗蛇毒血清，不切、不吸、不绑死"]},{"tag":"a","props":{"href":"/tip/13-30","className":""},"children":[{"tag":"span","props":{},"children":["30"]},"地震时先看自己在什么房子里：符合抗震设防的楼里就地躲，会垮的老房子门在几步外就出去"]},{"tag":"a","props":{"href":"/tip/13-31","className":""},"children":[{"tag":"span","props":{},"children":["31"]},"遇到熊、野猪、成群野狗，别跑，侧身慢慢退开"]},{"tag":"a","props":{"href":"/tip/13-32","className":""},"children":[{"tag":"span","props":{},"children":["32"]},"野外遇上雷雨，钻进有硬顶的车或建筑，避开山脊、孤树、水面和金属"]},{"tag":"a","props":{"href":"/tip/13-33","className":""},"children":[{"tag":"span","props":{},"children":["33"]},"上高原按睡眠海拔（当晚睡在多高）慢慢升，症状加重就下撤，不要硬扛"]},{"tag":"a","props":{"href":"/tip/13-34","className":""},"children":[{"tag":"span","props":{},"children":["34"]},"被蜱虫叮住，用尖头镊子贴着皮肤稳稳拉出来，别涂油别用火烧"]},{"tag":"a","props":{"href":"/tip/13-35","className":""},"children":[{"tag":"span","props":{},"children":["35"]},"野外的水一律烧开再喝，滚开一分钟就够，不用因为海拔高多煮"]},{"tag":"a","props":{"href":"/tip/13-36","className":""},"children":[{"tag":"span","props":{},"children":["36"]},"荒郊野外被陌生人索财，钱给他，不动手，记特征，脱身后报警"]},{"tag":"a","props":{"href":"/tip/13-37","className":""},"children":[{"tag":"span","props":{},"children":["37"]},"撞见一群人打架，退开走人，别上去拉架、别围观、别捡地上的家伙；要报警就退到安全距离打 110"]},{"tag":"a","props":{"href":"/tip/13-38","className":""},"children":[{"tag":"span","props":{},"children":["38"]},"可能被 HIV 暴露了，72 小时内去拿阻断药，越早越好"]},{"tag":"a","props":{"href":"/tip/13-39","className":""},"children":[{"tag":"span","props":{},"children":["39"]},"救人受了伤、搭进了钱，先找加害人和医保，再去申报见义勇为确认"]},{"tag":"a","props":{"href":"/tip/13-40","className":""},"children":[{"tag":"span","props":{},"children":["40"]},"刀、钢筋、玻璃扎进身体，压住异物周围止血，不要把它拔出来"]},{"tag":"a","props":{"href":"/tip/13-41","className":""},"children":[{"tag":"span","props":{},"children":["41"]},"怀疑骨折就别再动那个部位，托着不动、冷敷 20 分钟以内，别自己掰正"]},{"tag":"a","props":{"href":"/tip/13-42","className":""},"children":[{"tag":"span","props":{},"children":["42"]},"被性侵之后，先到安全的地方打 110；验伤之前别洗澡、别洗衣服、别收拾房间，72 小时内去医院"]},{"tag":"a","props":{"href":"/tip/13-43","className":""},"children":[{"tag":"span","props":{},"children":["43"]},"不满 1 岁的婴儿噎住哭不出声，趴着拍背 5 下、翻过来按胸口 5 下，轮着做，别按肚子"]},{"tag":"a","props":{"href":"/tip/13-44","className":""},"children":[{"tag":"span","props":{},"children":["44"]},"不满 1 岁的婴儿没反应、没正常呼吸，开免提打 120，做婴儿心肺复苏：按 30 下吹 2 口气"]}]}]},{"tag":"div","props":{"className":"life-tip-page","data-tip-locales":"zh,en,ru,es,ja,vi"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"当前位置"},"children":[{"tag":"a","props":{"href":"/book"},"children":["阅读全书"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/book/13"},"children":["第 13 章 · 紧急情况：先做什么"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"13-15"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["15"]},{"tag":"span","props":{"className":"life-evidence grade-b"},"children":["证据 B（指南强推荐，但底层证据等级低）"]}]},{"tag":"h1","props":{"lang":"zh"},"children":["突然全身起疹、喘不上气或者发晕，按过敏性休克处理，立刻叫 120 并说清楚"]},{"tag":"p","props":{"lang":"zh","className":"life-entry-summary"},"children":["突然全身起疹，再加上喘不上气或者发晕，就按过敏性休克办。立刻打 120，直接说「怀疑过敏性休克」，让急救带着肾上腺素来。抗过敏药和激素起效慢，替不了肾上腺素。有过一次的人找医生开自动注射笔，打大腿中外侧，隔着裤子也能打。"]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["成本"]},{"tag":"p","props":{},"children":["不花钱。已知有严重过敏的人自备肾上腺素笔要花钱，而且它是处方药。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["收益"]},{"tag":"p","props":{},"children":["肾上腺素是二级及以上过敏性休克首选的药（一线药），指南把它列为强推荐。抗过敏药和激素起效慢，顶不了它的位置"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"标记：突然全身起疹、喘不上气或者发晕，按过敏性休克处理，立刻叫 120 并说清楚"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"已做到"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":