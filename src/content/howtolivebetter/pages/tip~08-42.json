-12"},"children":[{"tag":"span","props":{},"children":["12"]},"跟谁结了怨——被欠薪、被开除、被坑了钱——走投诉、仲裁、起诉，别去找人算账"]},{"tag":"a","props":{"href":"/tip/08-13"},"children":[{"tag":"span","props":{},"children":["13"]},"再恨也别对不相干的人下手：驾车冲撞人群、在公共场所行凶按以危险方法危害公共安全定罪，起刑三年，死了人十年起步、最高死刑"]},{"tag":"a","props":{"href":"/tip/08-14"},"children":[{"tag":"span","props":{},"children":["14"]},"冒出「拉个垫背的」「同归于尽」这种念头，当急症处理：离开现场，把车钥匙和刀交给别人，打 12356"]},{"tag":"a","props":{"href":"/tip/08-15"},"children":[{"tag":"span","props":{},"children":["15"]},"身边人说出「谁也别想好过」「带着孩子一起走」，别当气话：近亲属可以直接送诊，公安接到报警也必须管"]},{"tag":"a","props":{"href":"/tip/08-16"},"children":[{"tag":"span","props":{},"children":["16"]},"网上不骂人、不造谣、不转发没核实的事；被网暴先留证再报警"]},{"tag":"a","props":{"href":"/tip/08-17"},"children":[{"tag":"span","props":{},"children":["17"]},"签字前把纸看完，不替人签字，不在空白纸上签"]},{"tag":"a","props":{"href":"/tip/08-18"},"children":[{"tag":"span","props":{},"children":["18"]},"借钱写清借条，替人担保前先想清楚自己愿不愿意替他还"]},{"tag":"a","props":{"href":"/tip/08-19"},"children":[{"tag":"span","props":{},"children":["19"]},"维权有期限：民事诉讼时效 3 年，劳动仲裁 1 年，过了对方一句「超过时效」就够"]},{"tag":"a","props":{"href":"/tip/08-20"},"children":[{"tag":"span","props":{},"children":["20"]},"被起诉、被执行了，如实报财产、能还多少还多少，别把房和钱转给亲友或公司"]},{"tag":"a","props":{"href":"/tip/08-21"},"children":[{"tag":"span","props":{},"children":["21"]},"被限制消费或者被列入失信名单，先查清是按哪一条纳入的，能纠正的申请纠正"]},{"tag":"a","props":{"href":"/tip/08-22"},"children":[{"tag":"span","props":{},"children":["22"]},"网购、二手交易被骗，先平台投诉，再报警，再算值不值得起诉"]},{"tag":"a","props":{"href":"/tip/08-23"},"children":[{"tag":"span","props":{},"children":["23"]},"恋爱和婚内的大额赠与，交付之前想清楚，交付之后原则上要不回"]},{"tag":"a","props":{"href":"/tip/08-24"},"children":[{"tag":"span","props":{},"children":["24"]},"彩礼走转账并备注，聊天记录留好；借婚姻要钱可以要回"]},{"tag":"a","props":{"href":"/tip/08-25"},"children":[{"tag":"span","props":{},"children":["25"]},"婚前财产不用怕，房子加名和父母出资先写清楚"]},{"tag":"a","props":{"href":"/tip/08-26"},"children":[{"tag":"span","props":{},"children":["26"]},"结婚前核对对方婚姻状况，以结婚为幌子骗钱的按诈骗罪追究"]