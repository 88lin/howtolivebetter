none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["本主题的其他建议"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/15-01"},"children":[{"tag":"strong","props":{},"children":["租房时押金的数额、退还时间和扣减情形，必须写进合同"]},{"tag":"span","props":{},"children":["押金多少、什么时候退、什么情况下能扣，签字前就要写进合同。合同里没写的扣款理由，房东退租时不能拿来扣你的押金。"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/15-02"},"children":[{"tag":"strong","props":{},"children":["被断水断电、换锁、上门威胁赶人，先报警留证：法规禁止用这些方式逼你腾房"]},{"tag":"span","props":{},"children":["房东不能靠断水断电、换锁、上门威胁逼你解约或者搬走，法规明令禁止。遇上了先报警。出警记录是你以后要求赔损失的证据。不要自己动手和对方对抗。"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/15-06"},"children":[{"tag":"strong","props":{},"children":["租房签约前核对产权证和抵押情况，所有款项走转账并备注用途"]},{"tag":"span","props":{},"children":["签约前让房东拿出身份证和产权证。再带身份证去不动产登记机构，查房子有没有抵押、有没有被查封，没签合同也能查。出租前就抵押或者查封的房子，被拍卖换了主人，你没法要…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/15-07"},"children":[{"tag":"strong","props":{},"children":["二手房让中介代收房款的，必须走中介在银行开的交易资金专用存款账户"]},{"tag":"span","props":{},"children":["房款是几十万到几百万，是这本书里单笔金额最大的一件事。中介代收房款的，按规定必须走它在银行开的专用账户，不能微信转给经纪人个人。另外，两家中介合做一单只能收一份…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/15-08"},"children":[{"tag":"strong","props":{},"children":["别租隔断房：最小出租单位是原设计的房间，厨房、卫生间、阳台不得住人"]},{"tag":"span","props":{},"children":["按规定，最小的出租单位是原来设计好的那间房。厨房、卫生间、阳台和地下储藏室不能住人。这种房被查处之后，你可能要搬走。另外，租期内房东也不能自己说涨租就涨租。"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/15-09"},"children":[{"tag":"strong","props":{},"children":["城镇户口想搬去乡下住，只租农房，别买宅基地和