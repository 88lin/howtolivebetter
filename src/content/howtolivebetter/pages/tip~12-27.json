":"span","props":{},"children":["22"]},"在岗位上按规程办事，规程之外的好意先想清楚责任归谁"]},{"tag":"a","props":{"href":"/tip/12-23","className":""},"children":[{"tag":"span","props":{},"children":["23"]},"亏了就按程序退场：能简易注销就注销，资不抵债走破产，别放着不管"]},{"tag":"a","props":{"href":"/tip/12-24","className":""},"children":[{"tag":"span","props":{},"children":["24"]},"花钱请人代运营网店、上开店培训、做「无货源」之前，先问清后面还要不要加钱、销量从哪来"]},{"tag":"a","props":{"href":"/tip/12-25","className":""},"children":[{"tag":"span","props":{},"children":["25"]},"开公司、当个体户的，每年 1 月 1 日到 6 月 30 日上网报上一年的年报，没生意也要报，年报不收费"]},{"tag":"a","props":{"href":"/tip/12-26","className":""},"children":[{"tag":"span","props":{},"children":["26"]},"找人凑钱做生意，只找亲友和员工当面谈，不在朋友圈、群里公开招人投钱，也别让亲友替你再去拉人"]},{"tag":"a","props":{"href":"/tip/12-27","className":"active"},"children":[{"tag":"span","props":{},"children":["27"]},"租铺面开店，签约前先查这间房能不能开你的店：住宅改成店要同一栋楼的业主全都同意，住宅楼里不能新开有油烟的餐馆"]},{"tag":"a","props":{"href":"/tip/12-28","className":""},"children":[{"tag":"span","props":{},"children":["28"]},"几个人合伙开店，开张前把出资、分钱、谁说了算、谁拿工资、怎么退出写成书面协议"]}]}]},{"tag":"div","props":{"className":"life-tip-page","data-tip-locales":"zh"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"当前位置"},"children":[{"tag":"a","props":{"href":"/book"},"children":["阅读全书"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/book/12"},"children":["第 12 章 · 创业与做生意：别把家底赔进去"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"12-27"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["27"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["证据 A"]}]},{"tag":"h1","props":{"lang":"zh"},"children":["租铺面开店，签约前先查这间房能不能开你的店：住宅改成店要同一栋楼的业主全都同意，住宅楼里不能新开有油烟的餐馆"]},{"tag":"p","props":{"lang":"zh","className":"life-entry-summary"},"children":["把住宅改成店，要同一栋楼的其他业主全都同意，一户反对就不行。邻居告你恢复原状、赔钱，法院会支持。住宅楼和没专用烟道的商住楼，