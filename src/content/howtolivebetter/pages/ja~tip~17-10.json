ook/17"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"目次に戻る"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["家族に高齢者がいる場合"]},{"tag":"div","props":{"data-ad-dock-host":"true"},"children":[]},{"tag":"nav","props":{"aria-label":"この章のヒント"},"children":[{"tag":"a","props":{"href":"/ja/tip/17-01"},"children":[{"tag":"span","props":{},"children":["01"]},"高齢なうちに、将来の後見人を書面で指定しておく"]},{"tag":"a","props":{"href":"/ja/tip/17-02"},"children":[{"tag":"span","props":{},"children":["02"]},"遺言を作成しましょう。後から作成したものが前のものを覆すため、公証遺言が優先されるとは限りません"]},{"tag":"a","props":{"href":"/ja/tip/17-03"},"children":[{"tag":"span","props":{},"children":["03"]},"高齢者の資金は別口座で管理し、高額支出には二人確認のルールを設ける"]},{"tag":"a","props":{"href":"/ja/tip/17-04"},"children":[{"tag":"span","props":{},"children":["04"]},"高齢者がいつでも使える、断るためのフレーズ：「家族と相談させてください」"]},{"tag":"a","props":{"href":"/ja/tip/17-05"},"children":[{"tag":"span","props":{},"children":["05"]},"高齢者に先払いを求める「投資型老後プラン」には一切手を出さないこと：カード作成、ベッド確保、介護マンション、移住型老後生活、高齢者向け製品の購入は、すべて同一の違法集金の手口です"]},{"tag":"a","props":{"href":"/ja/tip/17-06"},"children":[{"tag":"span","props":{},"children":["06"]},"保険会社による住宅リバースモーゲージ型年金保険を除き、他の「自宅を活用した老後プラン」には一切手を出さないこと。絶対に住宅を担保に理財商品を買ってはいけない"]},{"tag":"a","props":{"href":"/ja/tip/17-07"},"children":[{"tag":"span","props":{},"children":["07"]},"家族内に長期臥床または重度の障害がある人がいる場合、加入先の医療保険部門へ長期介護保険を申請してください。これは高齢者だけに支給されるものではありません"]},{"tag":"a","props":{"href":"/ja/tip/17-08"},"children":[{"tag":"span","props":{},"children":["08"]},"家族内に長期臥床の人がいる場合、褥瘡（床ずれ）を最大の敵と見なしましょう：電動エアマットレスの使用、定期的な体位変換、毎日、骨の突出部をチェックする"]},{"tag":"a","props":{"href":"/ja/tip/17-09"},"children":[{"tag":"span","props":{},"children":["09"]},"高齢者の白内障が視界に影響しているなら、眼科で手術の検討を。両目に症状がある場合は、二枚目の手術をあまり遅らせないこと"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/ja/tip/17-10","data-status":"active"},"children":[{"tag":"span","props":{},"children":["10"]},"高齢者の犬の散歩ではリードを手に巻かず手のひらで握り、短く保つ。引っ張って飛び出さないよう犬を訓練する"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"現在地"},"children":[{"tag":"a","props":{"href":"/ja/book"},"children":["本を読む"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/ja/book/17"},"children":["第17章"," ·"," ","家族に高齢者がいる場合"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"17-10"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["10"]},{"tag":"span","props":{"className":"life-evidence grade-b"},"children":["エビデンス"," ","B"]}]},{"tag":"h1","props":{"lang":"ja"},"children":["高齢者の犬の散歩ではリードを手に巻かず手のひらで握り、短く保つ。引っ張って飛び出さないよう犬を訓練する"]},{"tag":"p","props":{"lang":"ja","className":"life-entry-summary"},"children":["米国で65歳以上が犬の散歩中に骨折した推計は年約1700人から約4400人に増え、8割が女性でした。最も多い単一部位は股関節で、3割近くが入院しました。リードで手を傷めた例の約4分の3は、手に巻いたリードを犬が引いたことが原因でした。手のひらで握り、短く保ち、犬が飛び出さないよう訓練しましょう。"]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["費用・手間"]},{"tag":"p","props":{},"children":["握り方とリードを短くするのに費用はかかりません。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["効果"]},{"tag":"p","props":{},"children":["米国の救急監視データから全国を推計すると、65歳以上がリードで犬を散歩させて骨折した人数は2004年約1671人から2017年約4396人へ有意に増加しました。"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"記録する：高齢者の犬の散歩ではリードを手に巻かず手のひらで握り、短く保つ。引っ張って飛び出さないよう犬を訓練する"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"できている"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"やることに追加"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"お気に入り"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"このヒントを共有"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"詳細を閉じる"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["費用・手間"]},{"tag":"p","props":{},"children":["握り方とリードを短くするのに費用はかかりません。一度一緒に歩いて教えればよいでしょう。引っ張らない訓練には時間がかかり、自分でも訓練士に頼んでも構いません。依頼は有料で料金は地域により大きく違います。伸縮リードや手首に巻く習慣を変えてもらうのが難点です。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["効果"]},{"tag":"p","props":{},"children":["米国の救急監視データから全国を推計すると、65歳以上がリードで犬を散歩させて骨折した人数は2004年約1671人から2017年約4396人へ有意に増加しました。78.6%が女性、28.7%が入院しました。単一部位では股関節が最多の17.3%、大分類では上肢が最多の52.1%でした。別の全国救急データ（2001〜2018年）ではリード関連傷害が約36万人回（正確には356746）と推計され、犬に引かれたものが193483、つまずきや絡まりが136767でした。人口100万人当たりの傷害は25.4から105.5へ増加しました。ある手外科外来では5年間でリード関連の手の傷害443人を診療しました。約4分の3は手や指がリードに絡まり犬に引かれたものでした（抄録では337人、75.9%）。約5分の1が手術を受けました（96人、21.6%）。米国CDCによると、2001〜2006年に猫や犬に関連する転倒傷害は毎年約86629人回で、88.0%が犬に関係していました。犬関連の転倒の26%は散歩中、21.2%は犬に押されたり引かれたりしたものでした。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["出典"]},{"tag":"p","props":{"className":"life-citations"},"children":["Pirruccio K, Yoon YM, Ahn J (2019). Fractures in Elderly Americans Associated With Walking Leashed Dogs. JAMA Surgery, 154(5), 458-459. ",{"tag":"a","props":{"href":"https://doi.org/10.1001/jamasurg.2019.0061","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1001/jamasurg.2019.0061"]},"；Forrester MB (2020). Dog leash-related injuries treated at emergency departments. American Journal of Emergency Medicine, 38(9), 1782-1786. ",{"tag":"a","props":{"href":"https://doi.org/10.1016/j.ajem.2020.05.082","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1016/j.ajem.2020.05.082"]},"；Plusch K, Givner D, Wiafe B, Lutsky K, Beredjiklian P (2026). Hand and Wrist Dog-Leash Injuries in the Outpatient Setting: A Review of 443 Cases. Hand, 21(4), 582-586. ",{"tag":"a","props":{"href":"https://doi.org/10.1177/15589447241299128","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1177/15589447241299128"]},"；CDC (2009). Nonfatal fall-related injuries associated with dogs and cats — United States, 2001-2006. MMWR, 58(11), 277-281. ",{"tag":"a","props":{"href":"https://www.cdc.gov/mmwr/preview/mmwrhtml/mm5811a1.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.cdc.gov/mmwr/preview/mmwrhtml/mm5811a1.htm"]},"；Rosa R, Buckley RE (2024). Leash-related injuries associated with dog walking: an understudied risk for dog owners? Journal of the American Veterinary Medical Association, 262(7), 973-978. ",{"tag":"a","props":{"href":"https://doi.org/10.2460/javma.23.11.0608","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.2460/javma.23.11.0608"]}]},{"tag":"a","props":{"href":"https://doi.org/10.1001/jamasurg.2019.0061","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["出典を開く"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["著者の注記"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["手に巻かず手のひらで握るのは手外科外来の医師の助言です。指や手首を守るもので、犬の急な飛び出しで引き倒されることまでは防げないと明記しています。短いリードでは犬が加速する余地が小さく、引く力が弱くなること、長いリードは物に絡んでつまずきやすいことから、短く保つよう勧めています。伸縮リードも長く出せば長いリードです。ただし伸縮型と通常型の転倒リスクを直接比べた研究はなく、2024年のレビューも受傷時のリードの種類のデータ不足を指摘しています。引っ張って飛び出さない訓練はCDCと骨折研究の著者も勧めています。骨折研究は、これから犬を飼おうとする高齢者に小さめの犬を選ぶことも勧めています。これらの行動で転倒がどれだけ減るかは未算出なので、利益は判断により「小」としました。骨の強さは第1節第39条（骨密度検査）と第40条（骨粗しょう症と分かったら治療）、バランス練習は第1節第13条、散歩を運動量に含められるかは第2節第44条を参照してください。主な受益者は両親と祖父母です。"]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["自分のメモ"]},{"tag":"button","props":{"type":"button"},"children":["自分へのメモを書く…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/ja/tip/17-09"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["前へ"]},"高齢者の白内障が視界に影響しているなら、眼科で手術の検討を。両目に症状がある場合は、二枚目の手術をあまり遅らせないこと"]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["このテーマの他の提案"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/17-03"},"children":[{"tag":"strong","props":{},"children":["高齢者の資金は別口座で管理し、高額支出には二人確認のルールを設ける"]},{"tag":"span","props":{},"children":["高齢者を狙う詐欺では、贈り物や親身な言葉で信頼を積み上げてから大金を奪います。「誰にも言わないで」と口止めするのも典型です。一定額以上の支…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/17-04"},"children":[{"tag":"strong","props":{},"children":["高齢者がいつでも使える、断るためのフレーズ：「家族と相談させてください」"]},{"tag":"span","props":{},"children":["勧誘や詐欺は、その場の圧力で考える前に払わせようとします。感情が高ぶると誇張広告を信じやすく、高齢者は若い人より説得されやすい傾向がありま…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/17-05"},"children":[{"tag":"strong","props":{},"children":["高齢者に先払いを求める「投資型老後プラン」には一切手を出さないこと：カード作成、ベッド確保、介護マンション、移住型老後生活、高齢者向け製品の購入は、すべて同一の違法集金の手口です"]},{"tag":"span","props":{},"children":["高齢者に先払いを求め、かつリターンを約束する老後プランは、すべて同じ詐欺の手口です。カード作成、ベッド確保、介護マンション、移住型老後生活…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/17-06"},"children":[{"tag":"strong","props":{},"children":["保険会社による住宅リバースモーゲージ型年金保険を除き、他の「自宅を活用した老後プラン」には一切手を出さないこと。絶対に住宅を担保に理財商品を買ってはいけない"]},{"tag":"span","props":{},"children":["正規の住宅を活用した老後プランは、保険会社による住宅リバースモーゲージ型年金保険（現在、試験運用中）のただ一種のみです。訪問販売されるもの…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/17-07"},"children":[{"tag":"strong","props":{},"children":["家族内に長期臥床または重度の障害がある人がいる場合、加入先の医療保険部門へ長期介護保険を申請してください。これは高齢者だけに支給されるものではありません"]},{"tag":"span","props":{},"children":["長期介護保険は、介護を依頼するための費用を補助してくれます。家族に重度の障害があり、半年以上継続している場合は、加入先の医療保険部門へ申請…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/17-08"},"children":[{"tag":"strong","props":{},"children":["家族内に長期臥床の人がいる場合、褥瘡（床ずれ）を最大の敵と見なしましょう：電動エアマットレスの使用、定期的な体位変換、毎日、骨の突出部をチェックする"]},{"tag":"span","props":{},"children":["股関節骨折の手術前に褥瘡がある高齢者は、30 日以内に亡くなる可能性が約2割高まります。電動エアマットレスに交換することで、新しい褥瘡がで…"]}]}]}]},{"tag":"a","props":{"className":"life-text-link","href":"/ja/book/17"},"children":["テーマ全体を読む：家族に高齢者がいる場合"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"15","height":"15","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]}]}]}]},{"tag":"aside","props":{"className":"life-ad-space life-ad-space-sponsored","data-ad-placement":"ad_footer","data-ad-group":"reading","data-ad-creative":"read_product","data-ad-ready":"false","aria-label":"広告 · コミュニティ紹介"},"children":[{"tag":"div","props":{"className":"life-ad-space-brand"},"children":[{"tag":"img","props":{"src":"/sites/howtolivebetter/images/shengcai/logo.png","width":"565","height":"144","alt":"生財有術の公式ロゴ","decoding":"async"},"children":[]}]},{"tag":"div","props":{"className":"life-ad-space-copy"},"children":[{"tag":"span","props":{"className":"life-ad-space-label"},"children":["広告 · コミュニティ紹介"]},{"tag":"strong","props":{},"children":["学んだ知識は、役立つ製品になる？"]},{"tag":"p","props":{},"children":["電子書籍や小さなツール。需要を見つけ、知識を使える形にする参加者の実践を紹介します。"]}]},{"tag":"div","props":{"className":"life-ad-space-actions"},"children":[{"tag":"a","props":{"className":"life-ad-space-link","href":"/ja/shengcaiyoushu?sc_group=reading&sc_creative=read_product&sc_placement=ad_footer"},"children":["コミュニティと事例を見る",{