o"},"children":["Pomodoro"]},{"tag":"a","props":{"href":"/vi/articles"},"children":["Bài viết dài"]},{"tag":"a","props":{"href":"/vi/value"},"children":["Lựa chọn thiết thực"]},{"tag":"a","props":{"href":"/vi/changelog"},"children":["Phiên bản cập nhật"]},{"tag":"a","props":{"href":"/vi/national-day"},"children":["Hướng dẫn du lịch Quốc khánh (lưu trữ)"]}]},{"tag":"div","props":{"className":"life-footer-connect"},"children":[{"tag":"span","props":{"className":"life-footer-heading"},"children":["Kết nối"]},{"tag":"button","props":{"type":"button","className":"life-community-join","aria-haspopup":"dialog"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-message-circle","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M7.9 20A9 9 0 1 0 4 16.1L2 22Z"},"children":[]}]},{"tag":"span","props":{},"children":["Tham gia cộng đồng"]}]},{"tag":"a","props":{"href":"mailto:support@howtolivebetter.net"},"children":[{"tag":"span","props":{},"children":["support@howtolivebetter.net"]}]},{"tag":"a","props":{"href":"https://vibecoding.hot/","target":"_blank","rel":"noopener noreferrer"},"children":["VibeCoding Hot"]}]}]},{"tag":"div","props":{"className":"life-footer-bottom"},"children":[{"tag":"div","props":{"className":"life-footer-sources"},"children":[{"tag":"span","props":{"className":"life-footer-heading"},"children":["Nguồn & ghi chú"]},{"tag":"p","props":{},"children":["Đây là bản biên soạn độc lập, không chính thức, có thêm danh sách hành động và tính năng chia sẻ."," ","Bài viết gốc bằng tiếng Trung của"," ",{"tag":"a","props":{"href":"https://github.com/eternity4719/HowToLiveBetter","target":"_blank","rel":"noopener noreferrer"},"children":["eternity4719"]}," ","·"," ",{"tag":"a","props":{"href":"https://github.com/eternity4719/HowToLiveBetter/blob/70cc838c8791