":"noopener noreferrer"},"children":["https://www.gov.cn/zhengce/zhengceku/2021-11/12/content_5650400.htm"]},""]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["原书备注"]},{"tag":"p","props":{"className":"life-citations"},"children":["给 B 是因为依据的是监管部门查处时的认定口径，不是拿产品做对照试验测出来的。但「近视不能治愈」这句话，卫生部门和监管部门说法一致：《防控儿童青少年近视核心知识十条》里写的是「近视可防可控不可逆」。真正有证据的两件事在第 4 条（户外）和第 12 条（规范验光配镜与复查）。防蓝光眼镜见第 6 节。"]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["我的备注"]},{"tag":"button","props":{"type":"button"},"children":["写下对自己有用的提醒…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/tip/30-08"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["上一条"]},"12 到 18 岁的孩子做一次抑郁筛查，别拿学校的心理测评当诊断"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/tip/30-10"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["下一条"]},"睡眠、作业、体育和排名都有明文规定，学校做不到可以提"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["本主题的其他建议"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/30-05"},"children":[{"tag":"strong","props":{},"children":["0 到 3 岁不给屏幕，3 到 6 岁尽量不给，中小学生非学习用途每天不超过 1 小时"]},{"tag":"span","props":{},"children":["国家卫健委要求 0 到 3 岁不给屏幕，3 到 6 岁尽量别碰。中小学生不为学习用的，一次不超过 15 分钟、一天不超过 1 小时。理由是长时间近距离用眼会让近…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/30-06"},"children":[{"tag":"strong","props":{},"children":["把近视当成会留下的损伤：度数越深，将来视网膜脱离、黄斑病变、青光眼越多"]},{"tag":"span","props":{},"children":["近视不会自己好，度数也降不回去。它也不只是「戴个眼镜」的事。和不近视的人比，得近视性黄斑病变的可能，轻度近视高十几倍，600 度以上高几百倍。视网膜脱离，轻度高…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/30-07"},"children":[{"tag":"strong","props":{},"children":["每年那次学生体检的报告单要自己看一遍，异常项当年带去医院查"]},{"tag":"span","props":{},"children":["中小学校每年组织一次学生体检。报告单上要重点看的是超重、肥胖、营养不良、脊柱弯曲异常、视力不良、龋齿。别只看一眼身高体重就收起单子。这几项有异常，当年就带孩子去…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/30-11"},"children":[{"tag":"strong","props":{},"children":["孩子撑不住了可以休学，学籍学校必须给他留着，最长 1 年"]},{"tag":"span","props":{},"children":["休学有正式制度。父母或其他监护人提出申请，学校确认后报上级核准。一次最长 1 年，期满还要休就重新申请。休学期间学校要给孩子保留学籍，复学时回来接着上。具体办法…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/30-12"},"children":[{"tag":"strong","props":{},"children":["查出视力不良，去医院做散瞳验光，之后按医生给的间隔复查"]},{"tag":"span","props":{},"children":["散瞳验光是先滴一种眼药水，让眼睛里负责调焦的肌肉松下来，再验度数。这是在医院做的，诊断近视最准。卫健委写明这种药水对健康的眼睛不会造成损伤，停药后恢复正常。别拿…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/30-13"},"children":[{"tag":"strong","props":{},"children":["恒磨牙长出来以后做窝沟封闭"]},{"tag":"span","props":{},"children":["窝沟封闭是把大牙咬东西那一面的沟槽用树脂封住，食物残渣就塞不进去。做完两年，长蛀牙的机会约为不封的八分之一。如果不封有 16% 的牙面会蛀，封了只有约 5%。四…"]}]}]}]},{"tag":"a","props":{"className":"life-text-link","href":"/book/30"},"children":["阅读整个主题：上学以后的孩子 ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","wid