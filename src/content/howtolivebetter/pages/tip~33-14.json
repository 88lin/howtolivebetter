s":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["成本"]},{"tag":"p","props":{"className":"life-citations"},"children":["不花钱。要交一次申请，可能要经过一次评估。学校推脱时得往上找教育局。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["收益"]},{"tag":"p","props":{"className":"life-citations"},"children":["《残疾人教育条例》第七条：「学前教育机构、各级各类学校及其他教育机构应当依照本条例以及国家有关法律、法规的规定，实施残疾人教育；对符合法律、法规规定条件的残疾人申请入学，不得拒绝招收。」第二十九条：「普通职业学校不得拒绝招收符合国家规定的录取标准的残疾人入学，普通职业培训机构应当积极招收残疾人入学。」条例还规定，适龄残疾儿童、少年需要专人护理、不能到学校就读的，由县级人民政府教育行政部门统筹安排，通过提供送教上门或者远程教育等方式实施义务教育，并纳入学籍管理。第二十条规定，县级人民政府教育行政部门应当会同卫生行政部门、民政部门、残疾人联合会，建立由教育、心理、康复、社会工作等方面专家组成的残疾人教育专家委员会，由它评估身体状况、接受教育的能力和适应学校学习生活的能力并提出入学、转学建议；评估结果属于孩子的隐私，有关单位和工作人员负有保密义务。第二十三条规定，在普通学校随班就读的残疾学生，可以适用普通义务教育的课程设置方案、课程标准和教材，但是对其学习要求可以有适度弹性。第五十二条规定，残疾人参加国家教育考试需要必要支持条件和合理便利的，可以提出申请（全国，2017 年 5 月 1 日起施行）"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["来源"]},{"tag":"p","props":{"className":"life-citations"},"children":["国务院 (2017). 残疾人教育条例（第七条、第二十条、第二十三条、第二十九条、第五十二条）. ",{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/2017-02/23/content_5170264.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/zhengce/zhengceku/2017-02/23/content_5170264.htm"]},""]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["原书备注"]},{"tag":"p","props":{"className":"life-citations"},"children":["学校口头说「我们这儿没条件」不算数。要它出书面答复，拿着书面答复去找县级教育局。评估是教育局委托专家委员会做的。第二十三条那句「学习要求可以有适度弹性」很有用，遇到学校拿成绩当理由劝退时可以引。孩子在校被欺凌怎么留证据、学校必须走哪道程序，见第 30 节第 3 条（校园欺凌）。高考的合理便利见本节第 13 条（合理便利）。这条的受益人是你的孩子。"]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["我的备注"]},{"tag":"button","props":{"type":"button"},"children":["写下对自己有用的提醒…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/tip/33-13"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["上一条"]},"残疾人参加高考可以申请合理便利，用盲文卷的考试时间加一半"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/tip/33-15"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["下一条"]},"右下肢或者双下肢没了也能考驾照，准驾车型叫 C5"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["本主题的其他建议"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/33-10"},"children":[{"tag":"strong","props":{},"children":["找工作时主动说明自己持残疾人证，企业招你能抵掉一笔钱"]},{"tag":"span","props":{},"children":["单位安排残疾人就业的比例不得低于在职职工总数的 1.5%，具体比例由省里定