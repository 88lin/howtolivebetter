{"path":"/vi/tip/09-21","title":"Không bịa tai nạn, không phóng đại thiệt hại để lừa bồi thường: đó là tội lừa đảo bảo hiểm, và người làm chứng, sửa xe, giám định giúp bạn cùng bị tính | HowToLiveBetter","description":"Bịa tai nạn, phóng đại thiệt hại để lừa bồi thường là tội lừa đảo bảo hiểm, số tiền lớn thì phạt tù dưới 5 năm, còn phạt tiền 1 vạn đến 10 vạn tệ. Ng…","lang":"vi","styles":["/sites/howtolivebetter/styles/bca54bebe9c1bd3b.css"],"bodyClass":"font-sans antialiased","nodes":[{"tag":"div","props":{"className":"life-site"},"children":[{"tag":"div","props":{"className":"life-header-slot","aria-hidden":"true"},"children":[]},{"tag":"header","props":{"className":"life-header"},"children":[{"tag":"div","props":{"className":"life-header-inner"},"children":[{"tag":"a","props":{"className":"life-brand","aria-label":"H ✳ HowToLiveBetter — trang chủ","href":"/vi"},"children":[{"tag":"span","props":{"className":"life-brand-mark","aria-hidden":"true"},"children":["H",{"tag":"span","props":{},"children":["✳"]}]},{"tag":"span","props":{},"children":["HowToLive",{"tag":"span","props":{},"children":["Better"]}]}]},{"tag":"nav","props":{"className":"life-nav","aria-label":"Điều hướng chính"},"children":[{"tag":"a","props":{"className":"life-nav-link","href":"/vi/book"},"children":[{"tag":"span","props":{},"children":["Khám phá cuốn sách"]}]},{"tag":"a","props":{"className":"life-nav-link","href":"/vi/top-50"},"children":[{"tag":"span","props":{},"children":["Top 50"]}]},{"tag":"a","props":{"className":"life-nav-link","href":"/vi/daily"},"children":[{"tag":"span","props":{},"children":["Nhiệm vụ hàng ngày"]}]},{"tag":"a","props":{"className":"life-nav-link","href":"/vi/dashboard"},"children":[{"tag":"span","props":{},"children":["Bảng kiểm tra của tôi"]}]},{"tag":"button","props":{"type":"button","className":"life-nav-link life-nav-more","aria-haspopup":"menu","aria-expanded":"false"},"children":[{"tag":"span","props":{},"children":["Nhiều hơn"]},{"tag":"svg","props":{"xml