-user-round","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M18 20a6 6 0 0 0-12 0"},"children":[]},{"tag":"circle","props":{"cx":"12","cy":"10","r":"4"},"children":[]},{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},{"tag":"span","props":{},"children":["Iniciar sesión"]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/es/book/07"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"Volver al índice"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["Cómo vivir cuando no hay dinero"]},{"tag":"nav","props":{"aria-label":"Consejos del capítulo"},"children":[{"tag":"a","props":{"href":"/es/tip/07-01"},"children":[{"tag":"span","props":{},"children":["01"]},"Cómo solicitar en línea el subsidio por desempleo si se queda sin trabajo"]},{"tag":"a","props":{"href":"/es/tip/07-02"},"children":[{"tag":"span","props":{},"children":["02"]},"Si te deben el salario, primero reclama ante la inspección laboral y luego solicita arbitraje laboral; ninguna de las dos vías cuesta dinero y la mayoría de los casos se resuelve en unos meses"]},{"tag":"a","props":{"href":"/es/tip/07-03"},"children":[{"tag":"span","props":{},"children":["03"]},"Si no puedes pagar un juicio, solicita asistencia jurídica gratuita; los casos de cobro de salarios, alimentos y accidentes laborales ya están dentro del alcance"]},{"tag":"a","props":{"href":"/es/tip/07-04"},"children":[{"tag":"span","props":{},"children":["04"]},"Cuando estás sin salida, acude a una estación de socorro: comida, alojamiento y billete de regreso"]},{"tag":"a","props":{"href":"/es/tip/07-05"},"children":[{"tag":"span","props":{},"children":["05"]},"Para buscar trabajo usa primero los servicios públicos de empleo gratuitos y los mercados de trabajos temporales, no las agencias que cobran"]},{"tag":"a","props":{"href":"/es/tip/07-06"},"children":[{"tag":"span","props":{},"children":["06"]},"Ante una desgracia repentina, solicita primero la asistencia temporal"]},{"tag":"a","props":{"href":"/es/tip/07-07"},"children":[{"tag":"span","props":{},"children":["07"]},"Si tus ingresos están por debajo de la línea local del dibao, solicita el dibao (salario mínimo de subsistencia garantizado)"]},{"tag":"a","props":{"href":"/es/tip/07-08"},"children":[{"tag":"span","props":{},"children":["08"]},"Quien tiene el certificado de discapacidad puede solicitar los dos subsidios para personas con discapacidad"]},{"tag":"a","props":{"href":"/es/tip/07-09"},"children":[{"tag":"span","props":{},"children":["09"]},"No dejen de pagar los 400 yuanes anuales por la medistraховка (ибао) para residentes; las familias en situación de pobreza pueden obtener exenciones"]},{"tag":"a","props":{"href":"/es/tip/07-10"},"children":[{"tag":"span","props":{},"children":["10"]},"Ante una enfermedad grave, ve primero por el seguro médico básico, el seguro de enfermedades graves, la asistencia médica y el alta interprovincial; no toques los préstamos en línea"]},{"tag":"a","props":{"href":"/es/tip/07-11"},"children":[{"tag":"span","props":{},"children":["11"]},"Si pierdes la cédula de identidad, repónla de inmediato; si la necesitas con urgencia, pide primero la cédula temporal"]},{"tag":"a","props":{"href":"/es/tip/07-12"},"children":[{"tag":"span","props":{},"children":["12"]},"Tras el registro de desempleo, busca el reconocimiento como persona con dificultades para encontrar empleo, para obtener el subsidio de seguro social o un puesto de interés público"]},{"tag":"a","props":{"href":"/es/tip/07-13"},"children":[{"tag":"span","props":{},"children":["13"]},"En el desempleo, cobra el subsidio de formación profesional, el subsidio de pasantías de empleo y el subsidio de seguro social; no pagues de tu bolsillo un curso"]},{"tag":"a","props":{"href":"/es/tip/07-14"},"children":[{"tag":"span","props":{},"children":["14"]},"En la búsqueda de empleo no te limites a enviar currículos: usa un método de sistema: aprende técnicas, fija objetivos, busca ayuda"]},{"tag":"a","props":{"href":"/es/tip/07-15"},"children":[{"tag":"span","props":{},"children":["15"]},"No pagues depósitos, no entreges documentos en garantía, no firmes «préstamos para formación», no entres a esquemas piramidales ni pidas préstamos usurarios"]},{"tag":"a","props":{"href":"/es/tip/07-16"},"children":[{"tag":"span","props":{},"children":["16"]},"Ante dificultades de vivienda, ponte primero en la fila de la vivienda pública de alquiler"]},{"tag":"a","props":{"href":"/es/tip/07-17"},"children":[{"tag":"span","props":{},"children":["17"]},"Comprime alojamiento y comida al mínimo: alquiler compartido por mes en lugar de alquiler por día, y cocinar propio y comedores asistidos en lugar de comida a domicilio"]},{"tag":"a","props":{"href":"/es/tip/07-18"},"children":[{"tag":"span","props":{},"children":["18"]},"Si se interrumpe tu cotización al seguro social, no entres en pánico: la pensión cuenta por años acumulados y el seguro médico se repone según las reglas"]},{"tag":"a","props":{"href":"/es/tip/07-19"},"children":[{"tag":"span","props":{},"children":["19"]},"Haber estado preso, haber quebrado o haber entrado en la lista de deudores incumplidos: la ley da caminos de regreso; termina primero los trámites"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/es/tip/07-20","data-status":"active"},"children":[{"tag":"span","props":{},"children":["20"]},"Antes de una enfermedad grave, además del seguro médico básico añade un seguro médico o de enfermedades graves anual, y mira bien las palabras «renovación garantizada»"]},{"tag":"a","props":{"href":"/es/tip/07-21"},"children":[{"tag":"span","props":{},"children":["21"]},"Si de verdad no tienes dónde dormir, los locales de atención 24 horas sirven solo para una noche de emergencia; ve primero a la estación de socorro"]},{"tag":"a","props":{"href":"/es/tip/07-22"},"children":[{"tag":"span","props":{},"children":["22"]},"Si le deben el salario, primero aclare quién lo contrató: talleres sin licencia y subcontratistas siguen yendo a inspección laboral; solo el trabajo para un hogar o persona privada va al juzgado"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"Ruta de navegación"},"children":[{"tag":"a","props":{"href":"/es/book"},"children":["Libro"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/es/book/07"},"children":["Capítulo 7"," ·"," ","Cómo vivir cuando no hay dinero"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"07-20"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["20"]},{"tag":"span","props":{"className":"life-evidence grade-b"},"children":["Evidencia"," ","B"]}]},{"tag":"h1","props":{"lang":"es"},"children":["Antes de una enfermedad grave, además del seguro médico básico añade un seguro médico o de enfermedades graves anual, y mira bien las palabras «renovación garantizada»"]},{"tag":"p","props":{"lang":"es","className":"life-entry-summary"},"children":["Estos seguros cubren la parte que tú tienes que pagar después de que el seguro médico reembolsa, y la pérdida por dejar de trabajar. Antes de comprar, fíjate en las palabras «renovación garantizada»: sin ellas, el año próximo el producto puede retirarse o encarecerse; con ellas, al vencer la compañía está obligada a seguir cubriéndote con las mismas cláusulas. Dos seguros médicos de reembolso de gastos no pueden reembolsar dos veces el mismo gasto: no los apiles. Declara tu estado de salud con veracidad: si ocultas algo, te pueden negar el pago. Primero paga el seguro médico básico y después considera esta unidad."]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Coste"]},{"tag":"p","props":{},"children":["Para jóvenes, un seguro médico anual de reembolso de gasto…"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Beneficio"]},{"tag":"p","props":{},"children":["En la clasificación oficial, el seguro de salud (seguro médico) reembolsa los gastos médicos reales y el segur…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"Marcar: Antes de una enfermedad grave, además del seguro médico básico añade un seguro médico o de enfermedades graves anual, y mira bien las palabras «renovación garantizada»"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"Hecho"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"Por hacer"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"Guardar"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Compartir consejo"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Ocultar detalles"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Coste"]},{"tag":"p","props":{},"children":["Para jóvenes, un seguro médico anual de reembolso de gastos cuesta unos cientos de yuanes al año, y un seguro de enfermedades graves desde unos miles de yuanes al año (estimación grosera del autor, sin cifras oficiales); antes de contratar, declarar tu estado de salud con veracidad, media hora de una sola vez."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Beneficio"]},{"tag":"p","props":{},"children":["En la clasificación oficial, el seguro de salud (seguro médico) reembolsa los gastos médicos reales y el seguro de enfermedad paga una suma fija al diagnosticarse una enfermedad pactada: ambos cubren el pago propio que queda tras el reembolso del seguro médico y la pérdida por dejar de trabajar; los seguros de salud de vigencia de un año o menos sin cláusula de renovación garantizada son seguros de salud de corto plazo, y solo los que superan un año o contienen dicha cláusula son de largo plazo; «renovación garantizada» significa que al vencer la compañía debe volver a cubrir con las cláusulas y tarifas pactadas; las aseguradoras no pueden inducir a comprar dos veces, para la misma persona asegurada, seguros médicos de reembolso de función igual o similar; las definiciones de enfermedades del seguro de enfermedades graves tienen norma sectorial unificada: 28 enfermedades graves y 3 leves, siendo el cáncer maligno, el infarto agudo de miocardio y las secuelas del accidente cerebrovascular las enfermedades centrales (nacional, desde 2019 y 2020)."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Fuentes originales"]},{"tag":"p","props":{"className":"life-citations"},"children":["银保监会 (2019). 健康保险管理办法（银保监会令 2019 年第 3 号，第二、四、四十一条）. ",{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/2019-12/04/content_5458542.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/zhengce/zhengceku/2019-12/04/content_5458542.htm"]},"；中国保险行业协会、中国医师协会 (2020). 重大疾病保险的疾病定义使用规范（2020 年修订版）答记者问. ",{"tag":"a","props":{"href":"https://www.iachina.cn/art/2020/11/5/art_8616_104705.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.iachina.cn/art/2020/11/5/art_8616_104705.html"]},"；银保监会 (2020). 关于使用《中国人身保险业重大疾病经验发生率表（2020）》有关事项的通知（银保监发〔2020〕51 号）. ",{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/2020-11/06/content_5557791.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/zhengce/zhengceku/2020-11/06/content_5557791.htm"]},"；全国人大常委会 (2015 修正). 中华人民共和国保险法第十六条（如实告知与合同成立二年后不得解除）. ",{"tag":"a","props":{"href":"https://flk.npc.gov.cn/detail?id=2c909fdd678bf17901678bf7c4060811","target":"_blank","rel":"noopener noreferrer"},"children":["https://flk.npc.gov.cn/detail?id=2c909fdd678bf17901678bf7c4060811"]}]},{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/2019-12/04/content_5458542.htm","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Abrir fuente"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Nota del autor"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["La razón del nivel B es que las autoridades solo dan definiciones y reglas, sin cifras de «cuánto ahorra al contratarlo». «Seguro médico del millón» es un nombre de mercado; la categoría legal es la de seguro de salud de corto plazo. Un producto sin renovación garantizada puede retirarse o encarecerse el año próximo: antes de comprar mira si las cláusulas dicen «renovación garantizada». Dos seguros médicos de reembolso no pueden reembolsar dos veces el mismo gasto, no los apiles. Contratar con una enfermedad sin declararla con veracidad puede terminar en negativa de pago. Existe un plazo de dos años para la declaración veraz: una vez transcurridos esos dos años desde la firma del contrato, la aseguradora no podrá rescindirlo ni negarse a pagar por no haber recibido información veraz. Si se detecta ocultación intencionada en ese periodo, la compañía no abonará la indemnización ni devolverá la prima por siniestros ocurridos antes de la rescisión. Existen 40 situaciones de pérdidas que merecen ser cubiertas por un seguro; primero paga el seguro médico básico (unidad 9) y después considera esta unidad. Las normas de definiciones de enfermedades fueron publicadas por la asociación sectorial bajo dirección del regulador bancario y de seguros, no son documentos gubernamentales. 〔39〕"]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Mi nota"]},{"tag":"button","props":{"type":"button"},"childre