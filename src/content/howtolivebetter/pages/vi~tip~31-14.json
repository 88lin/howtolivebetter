8","height":"18","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-up-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M7 7h10v10"},"children":[]},{"tag":"path","props":{"d":"M7 17 17 7"},"children":[]}]}]}]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/vi/book/31"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"Quay lại mục lục"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["Sau mười tám tuổi có những con đường nào"]},{"tag":"div","props":{"data-ad-dock-host":"true"},"children":[]},{"tag":"nav","props":{"aria-label":"Các mục trong chương"},"children":[{"tag":"a","props":{"href":"/vi/tip/31-01"},"children":[{"tag":"span","props":{},"children":["01"]},"Đối chiếu điều kiện trước đã: yêu cầu về tuổi và trình độ của mười hai con đường đều được viết thành văn bản"]},{"tag":"a","props":{"href":"/vi/tip/31-02"},"children":[{"tag":"span","props":{},"children":["02"]},"Năm thứ mười tám tuổi phải đăng ký nghĩa vụ quân sự trước ngày 31 tháng 10; quân nhân lính nghĩa vụ nhập ngũ đúng hai năm"]},{"tag":"a","props":{"href":"/vi/tip/31-03"},"children":[{"tag":"span","props":{},"children":["03"]},"Sau khi được truy xuất mà từ chối nghĩa vụ quân sự thì trong hai năm không được xuất cảnh, không được học tiếp, và không vào được cơ quan công chức hay doanh nghiệp nhà nước"]},{"tag":"a","props":{"href":"/vi/tip/31-04"},"children":[{"tag":"span","props":{},"children":["04"]},"Hai điều thật nhất khi sinh viên đại học đi nghĩa vụ quân sự: học phí mỗi năm bù tối đa 20000 tệ, giữ học vị hai năm, và có một kế hoạch riêng cho tuyển sinh cao học"]},{"tag":"a","props":{"href":"/vi/tip/31-05"},"children":[{"tag":"span","props":{},"children":["05"]},"Sau khi giải ngũ chỉ có sáu trường hợp được chính quyền bố trí việc làm; người tự tìm việc phải đến đăng ký trong vòng 30 ngày"]},{"tag":"a","props":{"href":"/vi/tip/31-06"},"children":[{"tag":"span","props":{},"children":["06"]},"Ba khoản sau khi giải ngũ: tiền trở cấp một lần, thời gian phục vụ tính vào thâm niên công, và tự làm ăn thì mỗi năm giảm 20000 tệ thuế"]},{"tag":"a","props":{"href":"/vi/tip/31-07"},"children":[{"tag":"span","props":{},"children":["07"]},"Muốn vào hệ thống cơ quan công chức không chỉ có thi cao công chức: làm đủ hai năm ở chương trình phục vụ cơ sở thì dự được kế hoạch tuyển định hướng dành riêng cho 10% mỗi năm"]},{"tag":"a","props":{"href":"/vi/tip/31-08"},"children":[{"tag":"span","props":{},"children":["08"]},"Giáo viên vị trí đặc biệt hết hạn ba năm, đạt kết quả đánh giá và còn muốn ở lại thì phải được chuyển thành biên chế đúng thời hạn"]},{"tag":"a","props":{"href":"/vi/tip/31-09"},"children":[{"tag":"span","props":{},"children":["09"]},"Lính cứu hộ và nhân sự văn chứng quân đội là hai cửa tuyển công khai khác, ngưỡng thấp hơn thi công chức"]},{"tag":"a","props":{"href":"/vi/tip/31-10"},"children":[{"tag":"span","props":{},"children":["10"]},"Bằng cấp không phải việc mua một lần là xong: thi tự học không giới hạn tuổi cũng không xem trình độ đã học, thi lớn và đại học mở đều bổ sung được"]},{"tag":"a","props":{"href":"/vi/tip/31-11"},"children":[{"tag":"span","props":{},"children":["11"]},"Không vào cơ quan công chức thì làm việc linh hoạt: hưu trí và y tế phải tự tham gia bảo hiểm ở nơi làm việc, hạn chế về hộ khẩu đã được nới"]},{"tag":"a","props":{"href":"/vi/tip/31-12"},"children":[{"tag":"span","props":{},"children":["12"]},"Giao đồ ăn, chạy xe ô tô công nghệ, chở hàng trong thành phố: sàn trả phí bảo hiểm tai nạn lao động theo từng đơn, bạn không phải đóng"]},{"tag":"a","props":{"href":"/vi/tip/31-13"},"children":[{"tag":"span","props":{},"children":["13"]},"Hai con đường chốt được chỗ làm việc có biên chế ngay từ ngày điền nguyện vọng kỳ thi gaokao: sinh viên sư phạm có học phí và sinh viên y khoa định hướng, cái giá là thực hiện cam kết 6 năm"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/vi/tip/31-14","data-status":"active"},"children":[{"tag":"span","props":{},"children":["14"]},"Muốn đi làm công ăn nước ngoài, trước hết tra công ty này có giấy phép hợp tác lao động ngoài biên giới không: công ty không được đòi bạn đặt tiền"]},{"tag":"a","props":{"href":"/vi/tip/31-15"},"children":[{"tag":"span","props":{},"children":["15"]},"Làm việc từ xa cho công ty nước ngoài ngay tại nhà, khoản tiền này theo luật thuế tính là thu nhập trong nước: thuế thu nhập cá nhân tự kê khai, tiền về nước đi theo khoản「thù lao lao động」"]},{"tag":"a","props":{"href":"/vi/tip/31-16"},"children":[{"tag":"span","props":{},"children":["16"]},"Không vào cơ quan mà tự làm ăn, tiền khởi đầu hãy xem khoản vay bảo đảm khởi nghiệp: cá nhân tối đa 30 vạn, Nhà nước trợ một nửa lãi suất"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"Breadcrumbs"},"children":[{"tag":"a","props":{"href":"/vi/book"},"children":["Khám phá cuốn sách"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/vi/book/31"},"children":["Chương 31"," ·"," ","Sau mười tám tuổi có những con đường nào"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"31-14"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["14"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["Bằng chứng"," ","A"]}]},{"tag":"h1","props":{"lang":"vi"},"children":["Muốn đi làm công ăn nước ngoài, trước hết tra công ty này có giấy phép hợp tác lao động ngoài biên giới không: công ty không được đòi bạn đặt tiền"]},{"tag":"p","props":{"lang":"vi","className":"life-entry-summary"},"children":["Chuyện đi làm công ăn nước ngoài, pháp luật không quản lý bạn mà quản lý công ty tổ chức cho bạn đi. Chỉ doanh nghiệp đã có giấy chứng nhận tư cách kinh doanh hợp tác lao động ngoài biên giới và đã đăng ký mới làm được việc này. Nghe câu「trước tiên ký visa du lịch qua rồi đổi sang visa lao động」thì bản thân câu đó đã chứng minh phía bên kia đang vi phạm pháp. Công ty cũng không được đòi bạn đặt tiền dưới bất kỳ danh nghĩa nào, hay bắt bạn dùng tài sản làm bảo đảm."]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Chi phí"]},{"tag":"p","props":{},"children":["Không tốn tiền. Trước khi xuất hành dành mười mấy phút để…"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Lợi ích"]},{"tag":"p","props":{},"children":["Điều năm của《Quy chế quản lý hợp tác lao động ngoài biên giới》: muốn làm hợp tác lao động ngoài biên giới thì…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"Đánh dấu: Muốn đi làm công ăn nước ngoài, trước hết tra công ty này có giấy phép hợp tác lao động ngoài biên giới không: công ty không được đòi bạn đặt tiền"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"Hoàn tất"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"Kế hoạch thực hiện"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"Lưu"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Chia sẻ mẹo này"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Ẩn chi tiết"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Chi phí"]},{"tag":"p","props":{},"children":["Không tốn tiền. Trước khi xuất hành dành mười mấy phút để kiểm tra tư cách của công ty, rồi đọc kỹ cả hai bản hợp đồng."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Lợi ích"]},{"tag":"p","props":{},"children":["Điều năm của《Quy chế quản lý hợp tác lao động ngoài biên giới》: muốn làm hợp tác lao động ngoài biên giới thì phải được cơ quan quản lý thương mại cấp tỉnh hoặc thành phố trực thuộc phường phê duyệt và có tư cách kinh doanh. Tư cách kinh doanh chính là giấy chứng nhận tư cách kinh doanh hợp tác lao động ngoài biên giới đó, không có nó thì không được tổ chức người đi làm công ăn ở nước ngoài. Điều bảy: danh sách giấy phép phải báo cơ quan quản lý thương mại của Hội đồng Nhà nước và thông báo cho đại sứ quán và lãnh sự quán Trung Quốc ở nước ngoài. Điều này còn viết「未依法取得对外劳务合作经营资格证书并办理登记，不得从事对外劳务合作」. Điều tám:「任何单位和个人不得以商务、旅游、留学等名义组织劳务人员赴国外工作」. Điều chín: doanh nghiệp phải trong 5 ngày làm việc kể từ ngày đăng ký nộp tại ngân hàng chỉ định khoản「不低于 300 万元人民币的对外劳务合作风险处置备用金」, tức khoản dự phòng xử lý rủi ro hợp tác lao động ngoài biên giới không dưới 300 vạn tệ nhân dân tệ, danh sách nộp tiền được công bố xã hội. Điều mười: khoản dự phòng dùng để chi trả các khoản phí dịch vụ phải hoàn trả, tiền công và tổn thương phải bồi thường theo luật mà doanh nghiệp từ chối hoặc không có khả năng chi trả. Nó còn dùng cho「因发生突发事件，劳务人员回国或者接受紧急救助所需费用」, tức khoản chi phí để người lao động về nước hoặc được cứu hộ khẩn cấp khi xảy ra sự cố. Điều mười một: không được tổ chức người lao động sang nước ngoài làm công việc liên quan đến cờ bạc và tình dục. Điều mười hai: không tổ chức đào tạo thì không được tổ chức đi nước ngoài. Điều mười ba: phải mua bảo hiểm tai nạn cá nhân cho người lao động trong thời gian làm việc ở nước ngoài. Điều hai mươi mốt và hai mươi ba: phải ký hợp đồng bằng văn bản với nhà tuyển dụng nước ngoài và với người lao động, không ký thì không được tổ chức đi nước ngoài. Điều hai mươi lăm:「不得以任何名目向劳务人员收取押金或者要求劳务人员提供财产担保」. Điều hai mươi sáu: trong 10 ngày làm việc kể từ ngày ký hợp đồng thì báo cơ quan quản lý thương mại để đăng ký. Điều hai mươi chín: quyền lợi thực tế của người lao động không khớp với hợp đồng thì doanh nghiệp phải hỗ trợ khiếu nại; không được bồi thường đúng phải thì có quyền yêu cầu doanh nghiệp chịu trách nhiệm bồi thường. Điều ba mươi mốt: nếu tình hình an ninh của nước hoặc vùng đó không bảo đảm được an toàn cho con người thì doanh nghiệp không được tổ chức người lao động đi. Điều ba mươi bảy: cơ quan quản lý thương mại lập hệ thống hồ sơ và công bố uy tín xấu. Hình phạt nằm ở các điều sau. Điều ba mươi chín: không có tư cách làm hợp tác lao động ngoài biên giới thì bị kiểm tra, đình chỉ; nếu cấu thành tội phạm thì truy trách nhiệm hình sự. Điều bốn mươi: tổ chức đi nước ngoài mang danh nghĩa thương mại, du lịch, du học, cho vay tư cách, hoặc tổ chức làm công việc liên quan đến cờ bạc tình dục thì thu hồi giấy chứng nhận tư cách kinh doanh. Điều bốn mươi ba: không ký hợp đồng, hoặc che giấu thông tin, cung cấp thông tin giả để tổ chức đi nước ngoài thì phạt từ 10 vạn tệ đến 20 vạn tệ, đồng thời phạt người chịu trách nhiệm chính từ 2 vạn tệ đến 5 vạn tệ (toàn quốc)"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Nguồn gốc"]},{"tag":"p","props":{"className":"life-citations"},"children":["国务院 (2012). 对外劳务合作管理条例（国务院令第 620 号，第五、七、八、九、十、十一、十二、十三、二十一、二十三、二十五、二十六、二十九、三十一、三十七、三十九、四十、四十三条）. ",{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/2012-06/11/content_1091.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/zhengce/zhengceku/2012-06/11/content_1091.htm"]}]},{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/2012-06/11/content_1091.htm","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Liên kết mở nguồn"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Ghi chú sách"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["Trình tự làm đúng phải thế này: công ty trước hết ký hợp đồng hợp tác lao động bằng văn bản với nhà tuyển dụng nước ngoài, rồi ký hợp đồng dịch vụ bằng văn bản hoặc hợp đồng lao động với bạn. Hợp đồng phải ghi rõ nội dung công việc, thời hạn, mức thù lao, thời giờ làm việc, ngày nghỉ, bảo hiểm xã hội và rủi ro an toàn cá nhân. Sau khi ký, trong 10 ngày làm việc công ty phải báo cơ quan quản lý thương mại để đăng ký. Công ty còn bắt buộc phải sắp xếp cho bạn học kỹ năng, phòng chống xâm hại, ngoại ngữ và pháp luật tập quán địa phương, đồng thời mua cho bạn bảo hiểm tai nạn cá nhân trong thời gian làm việc ở nước ngoài. Bên kia không cho bạn xem hợp đồng, đòi tiền đặt, hay thúc bạn đi trước rồi bổ sung thủ tục sau thì chính là loại công ty phải tránh. Bảng lừa đảo tuyển dụng lương cao ở nước ngoài và khu công nghiệp lừa đảo xem mục 5 ở phần 21; nhắc nhở an toàn cần tra trước khi xuất hành và mã 12308 nằm ở phần 21, không lặp lại. Quy chế không đặt ngưỡng trình độ hay tuổi cho người đi làm công ăn, ngưỡng nằm ở tư cách của công ty và ở việc nước đi có cấp phép hay không. Công ty chỉ được ký hợp đồng với doanh nghiệp hoặc tổ chức được nước đó cho phép, không được ký với cá nhân ở nước ngoài. Khoản dự phòng do cơ quan chủ quản dùng vào khi công ty không trả nợ, bạn không tự rút được. Nên khi thật sự có sự cố vẫn phải khiếu nại với cơ quan quản lý thương mại trước, Điều hai mươi trao cho bạn quyền khiếu nại đó. Dự án cử trên 100 người sang cùng một nước hoặc vùng thì phải cử quản lý đi kèm và báo đại sứ quán, lãnh sự quán để đăng ký. Dự án ít người không có lớp bảo đảm đó, càng phải tự giữ hợp đồng và chứng tử chuyển khoản cho kỹ."]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Ghi chú của tôi"]},{"tag":"button","props":{"type":"button"},"children":["Viết một lời nhắc cho chính bạn…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/vi/tip/31-13"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Trước"]},"Hai con đường chốt được chỗ làm việc có biên chế ngay từ ngày điền nguyện vọng kỳ thi gaokao: sinh viên sư phạm có học phí và sinh viên y khoa định hướng, cái giá là thực hiện cam kết 6 năm"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/vi/tip/31-15"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Tiếp theo"]},"Làm việc từ xa cho công ty nước ngoài ngay tại nhà, khoản tiền này theo luật thuế tính là thu nhập trong nước: thuế thu nhập cá nhân tự kê khai, tiền về nước đi theo khoản「thù lao lao động」"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["Thêm trong chủ đề này"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/31-08"},"children":[{"tag":"strong","props":{},"children":["Giáo viên vị trí đặc biệt hết hạn ba năm, đạt kết quả đánh giá và còn muốn ở lại thì phải được chuyển thành biên chế đúng thời hạn"]},{"tag":"span","props":{},"children":["Kế hoạch vị trí đặc biệt là một trong số ít con đường mà văn bản ghi …"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/31-09"},"children":[{"tag":"strong","props":{},"children":["Lính cứu hộ và nhân sự văn chứng quân đội là hai cửa tuyển công khai khác, ngưỡng thấp hơn thi công chức"]},{"tag":"span","props":{},"children":["Cả hai con đường này đều không chặn ở ngưỡng「trình độ cao đẳng trở lê…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/31-10"},"children":[{"tag":"strong","props":{},"children":["Bằng cấp không phải việc mua một lần là xong: thi tự học không giới hạn tuổi cũng không xem trình độ đã học, thi lớn và đại học mở đều bổ sung được"]},{"tag":"span","props":{},"children":["Năm mười tám tuổi không học được thì phía sau vẫn còn ba cửa chính th…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/31-11"},"children":[{"tag":"strong","props":{},"children":["Không vào cơ quan công chức thì làm việc linh hoạt: hưu trí và y tế phải tự tham gia bảo hiểm ở nơi làm việc, hạn chế về hộ khẩu đã được nới"]},{"tag":"span","props":{},"children":["Không vào cơ quan không có nghĩa không còn chuyện bảo hiểm xã hội, ch…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/31-12"},"children":[{"tag":"strong","props":{},"children":["Giao đồ ăn, chạy xe ô tô công nghệ, chở hàng trong thành phố: sàn trả phí bảo hiểm tai nạn lao động theo từng đơn, bạn không phải đóng"]},{"tag":"span","props":{},"children":["Người giao đồ ăn, chạy xe ô tô công nghệ, chở hàng trong thành phố th…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/31-16"},"children":[{"tag":"strong","props":{},"children":["Không vào cơ quan mà tự làm ăn, tiền khởi đầu hãy xem khoản vay bảo đảm khởi nghiệp: cá nhân tối đa 30 vạn, Nhà nước trợ một nửa lãi suất"]},{"tag":"span","props":{},"children":["Nếu nhất định phải vay tiền để khởi đầu, hãy xem khoản có lãi suất đư…"]}]}]}]},{"tag":"a","props":{"className":"life-text-link","href":"/vi/book/31"},"children":["Đọc toàn bộ chủ đề: Sau mười tám tuổi có