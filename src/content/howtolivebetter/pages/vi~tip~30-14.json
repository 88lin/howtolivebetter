a-hidden":"true"},"children":[{"tag":"path","props":{"d":"M18 20a6 6 0 0 0-12 0"},"children":[]},{"tag":"circle","props":{"cx":"12","cy":"10","r":"4"},"children":[]},{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},{"tag":"span","props":{},"children":["Đăng nhập để đồng bộ hóa"]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/vi/book/30"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"Quay lại mục lục"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["Trẻ đang đi học"]},{"tag":"nav","props":{"aria-label":"Các mục trong chương"},"children":[{"tag":"a","props":{"href":"/vi/tip/30-01"},"children":[{"tag":"span","props":{},"children":["01"]},"Trẻ bảo đau dữ dội bất ngờ và đau hơn nữa thì đưa đi bệnh viện ngay, đừng để cháu nhịn đến tan học"]},{"tag":"a","props":{"href":"/vi/tip/30-02"},"children":[{"tag":"span","props":{},"children":["02"]},"Không nên vì「chờ thi xong」mà trì hoãn việc chữa trị cần làm, có những cửa sổ thời gian đi theo tuổi xương chứ không theo lịch thi"]},{"tag":"a","props":{"href":"/vi/tip/30-03"},"children":[{"tag":"span","props":{},"children":["03"]},"Trẻ bị bắt nạt thì báo ngay trong ngày cho nhà trường và yêu cầu xử lý bằng văn bản, có đánh nhau, cướp tiền, tung tin thì báo công an"]},{"tag":"a","props":{"href":"/vi/tip/30-04"},"children":[{"tag":"span","props":{},"children":["04"]},"Cho trẻ ở ngoài trời đủ 2 giờ mỗi ngày, đây là cách phòng cận thị duy nhất hiện có thử nghiệm ngẫu nhiên đứng sau"]},{"tag":"a","props":{"href":"/vi/tip/30-05"},"children":[{"tag":"span","props":{},"children":["05"]},"Không cho màn hình ở tuổi 0 đến 3, hạn chế tối đa ở tuổi 3 đến 6, học sinh tiểu học và trung học dùng màn hình không phải để học thì mỗi ngày không quá 1 giờ"]},{"tag":"a","props":{"href":"/vi/tip/30-06"},"children":[{"tag":"span","props":{},"children":["06"]},"Hãy coi cận thị là một tổn thương còn lại: độ càng cao thì sau này càng nhiều bong võng mạc, thoái hoa điểm vàng và glôcôm"]},{"tag":"a","props":{"href":"/vi/tip/30-07"},"children":[{"tag":"span","props":{},"children":["07"]},"Báo cáo khám sức khoẻ học sinh hằng năm phải tự đọc một lượt, mục bất thường thì đưa đi khám trong năm đó"]},{"tag":"a","props":{"href":"/vi/tip/30-08"},"children":[{"tag":"span","props":{},"children":["08"]},"Cho trẻ 12 đến 18 tuổi làm một lần sàng lọc trầm cảm, đừng lấy bài tâm lý học đường làm chẩn đoán"]},{"tag":"a","props":{"href":"/vi/tip/30-09"},"children":[{"tag":"span","props":{},"children":["09"]},"Đừng mua sản phẩm và dịch vụ quảng cáo là có thể「chữa khỏi cận thị」「giảm độ」"]},{"tag":"a","props":{"href":"/vi/tip/30-10"},"children":[{"tag":"span","props":{},"children":["10"]},"Giấc ngủ, bài tập, thể dục và xếp hạng đều có quy định bằng văn bản, trường không làm được thì có thể kiến nghị"]},{"tag":"a","props":{"href":"/vi/tip/30-11"},"children":[{"tag":"span","props":{},"children":["11"]},"Con không chịu nổi thì có thể xin nghỉ học, trường bắt buộc giữ học vị cho cháu, tối đa 1 năm"]},{"tag":"a","props":{"href":"/vi/tip/30-12"},"children":[{"tag":"span","props":{},"children":["12"]},"Khám ra nhìn kém thì ra bệnh viện khám khúc xạ sau khi nhỏ mắt, sau đó tái khám theo khoảng cách bác sĩ chỉ định"]},{"tag":"a","props":{"href":"/vi/tip/30-13"},"children":[{"tag":"span","props":{},"children":["13"]},"Sau khi răng cối chính mọc lên thì làm hàn khe răng"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/vi/tip/30-14","data-status":"active"},"children":[{"tag":"span","props":{},"children":["14"]},"Con thích chơi game thì xem giấc ngủ, bài tập và ra ngoài vận động có bị chen mất không, đừng chỉ nhìn thời gian chơi"]},{"tag":"a","props":{"href":"/vi/tip/30-15"},"children":[{"tag":"span","props":{},"children":["15"]},"Trẻ nói mình thích người cùng giới, đừng mắng, đừng đuổi khỏi nhà, đừng đưa đi「cải tận」: thái độ của gia đình có liên quan đến chuyện trẻ có tự sát hay không"]},{"tag":"a","props":{"href":"/vi/tip/30-16"},"children":[{"tag":"span","props":{},"children":["16"]},"Quản trẻ thì đừng ra tay đánh, cũng đừng quát mắng hay chửi trẻ là ngu: trẻ hay bị đánh mắng thì vấn đề hành vi và vấn đề tâm lý đều nhiều hơn"]},{"tag":"a","props":{"href":"/vi/tip/30-17"},"children":[{"tag":"span","props":{},"children":["17"]},"Trẻ khó quản, bản thân lúc nào cũng không nhịn được mà đánh mắng, thì đi học một khoá dạy cha mẹ có cách làm cụ thể"]},{"tag":"a","props":{"href":"/vi/tip/30-18"},"children":[{"tag":"span","props":{},"children":["18"]},"Đừng đưa con vào «trường cai nghiện internet» hay «trại đặc huấn» quản lý khép kín: luật cấm cách cai gây tổn hại thể chất, tinh thần, và đã có trẻ bị nhốt đến chết"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"Breadcrumbs"},"children":[{"tag":"a","props":{"href":"/vi/book"},"children":["Khám phá cuốn sách"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/vi/book/30"},"children":["Chương 30"," ·"," ","Trẻ đang đi học"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"30-14"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["14"]},{"tag":"span","props":{"className":"life-evidence grade-b"},"children":["Bằng chứng"," ","B"]}]},{"tag":"h1","props":{"lang":"vi"},"children":["Con thích chơi game thì xem giấc ngủ, bài tập và ra ngoài vận động có bị chen mất không, đừng chỉ nhìn thời gian chơi"]},{"tag":"p","props":{"lang":"vi","className":"life-entry-summary"},"children":["Số thật sự đủ chuẩn để gọi là「rối loạn vì game」xấp xỉ hai ba người trong mỗi trăm người. Ngưỡng trong bảng hỏi đặt thấp, lại chỉ khảo sát thiếu niên thì tỷ lệ sẽ thổi lên cao. Xem số liệu thật của các công ty game thì chơi nhiều hay ít gần như không liên quan tới tâm trạng tốt xấu. Người chưa thành niên theo quy định chỉ chơi được từ 8 giờ đến 9 giờ tối vào thứ Sáu, thứ Bảy, chủ nhật và ngày lễ."]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Chi phí"]},{"tag":"p","props":{},"children":["Không tốn tiền. Mỗi tuần nên biết một lần con đi ngủ lúc m…"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Lợi ích"]},{"tag":"p","props":{},"children":["Một phân tích tổng hợp gom 53 nghiên cứu từ 17 nước, 226247 người. Tỷ lệ mắc rối loạn vì game là 3.05% (95% CI…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"Đánh dấu: Con thích chơi game thì xem giấc ngủ, bài tập và ra ngoài vận động có bị chen mất không, đừng chỉ nhìn thời gian chơi"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"Hoàn tất"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"Kế hoạch thực hiện"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"Lưu"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Chia sẻ mẹo này"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Ẩn chi tiết"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Chi phí"]},{"tag":"p","props":{},"children":["Không tốn tiền. Mỗi tuần nên biết một lần con đi ngủ lúc mấy giờ, bài tập có nộp không, có ra ngoài vận động không."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Lợi ích"]},{"tag":"p","props":{},"children":["Một phân tích tổng hợp gom 53 nghiên cứu từ 17 nước, 226247 người. Tỷ lệ mắc rối loạn vì game là 3.05% (95% CI 2.38–3.91, đây là khoảng tin cậy). Chỉ tính những nghiên cứu lấy mẫu nghiêm hơn thì là 1.96%. Kết quả giữa các nghiên cứu chênh nhau rất xa, 77% phần chênh lệch là do dùng bảng hỏi nào. Mẫu là thiếu niên, điểm ngưỡng thấp, mẫu nhỏ, đều làm tỷ lệ lệch lên cao. Một nghiên cứu khác lấy được dữ liệu của 7 công ty game, nối thời lượng chơi thật trong sáu tuần của 38935 người chơi với mức hạnh phúc tự điền của họ. Gần như không tìm được bằng chứng cho thấy thời lượng chơi ảnh hưởng tới hạnh phúc. Cục Quản lý Báo chín và Xuất bản quy định doanh nghiệp game chỉ được cung cấp 1 giờ dịch vụ cho người chưa thành niên vào thứ Sáu, thứ Bảy, chủ nhật và ngày lễ hợp pháp, mỗi ngày từ 20 giờ đến 21 giờ (toàn quốc / quốc tế, từ năm 2021)"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Nguồn gốc"]},{"tag":"p","props":{"className":"life-citations"},"children":["Stevens MW, Dorstyn D, Delfabbro PH, King DL. (2021). Global prevalence of gaming disorder: A systematic review and meta-analysis. Australian and New Zealand Journal of Psychiatry, 55(6), 553–568. ",{"tag":"a","props":{"href":"https://doi.org/10.1177/0004867420962851","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1177/0004867420962851"]},"；Vuorre M, Johannes N, Magnusson K, Przybylski AK. (2022). Time spent playing video games is unlikely to impact well-being. Royal Society Open Science, 9(7), 220411. ",{"tag":"a","props":{"href":"https://doi.org/10.1098/rsos.220411","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1098/rsos.220411"]},"；国家新闻出版署 (2021). 关于进一步严格管理切实防止未成年人沉迷网络游戏的通知（国新出发〔2021〕14 号）. ",{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/2021-09/01/content_5634661.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/zhengce/zhengceku/2021-09/01/content_5634661.htm"]}]},{"tag":"a","props":{"href":"https://doi.org/10.1177/0004867420962851","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Liên kết mở nguồn"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Ghi chú sách"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["Xếp B vì tỷ lệ mắc thay đổi quá nhiều theo bảng hỏi, nghiên cứu về cảm nhận hạnh phúc cũng chỉ theo dõi sáu tuần. Cái giá thường gặp nhất của chơi game là chiếm thời gian ngủ và ngoài trời. Quy định cụ thể về ngủ xem điều 10 trong mục này (ngủ, bài tập, thể thao); ngoài trời xem điều 4 (2 giờ ngoài trời mỗi ngày); thời gian màn hình xem điều 5 (không quá 1 giờ/ngày cho mục đích ngoài học tập). Nạp tiền và hoàn tiền xem mục 5, điều 9 (con dùng điện thoại nạp tiền, tặng tiền). Nếu điểm số, giấc ngủ và quan hệ gia đình cùng xuống dốc, khuyên vẫn không dừng được, đưa con đến khoa tâm thần hoặc tâm lý trẻ em. Đừng đưa đến trường cai nghiện internet quản lý khép kín, xem điều 18 trong mục này. Người hưởng lợi là con."]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Ghi chú của tôi"]},{"tag":"button","props":{"type":"button"},"children":["Viết một lời nhắc cho chính bạn…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/vi/tip/30-13"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Trước"]},"Sau khi răng cối chính mọc lên thì làm hàn khe răng"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/vi/tip/30-15"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Tiếp theo"]},"Trẻ nói mình thích người cùng giới, đừng mắng, đừng đuổi khỏi nhà, đừng đưa đi「cải tận」: thái độ của gia đình có liên quan đến chuyện trẻ có tự sát hay không"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["Thêm trong chủ đề này"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/30-10"},"children":[{"tag":"strong","props":{},"children":["Giấc ngủ, bài tập, thể dục và xếp hạng đều có quy định bằng văn bản, trường không làm được thì có thể kiến nghị"]},{"tag":"span","props":{},"children":["Văn bản ghi rõ học sinh tiểu học ngủ 10 giờ mỗi ngày, học sinh trung …"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/30-11"},"children":[{"tag":"strong","props":{},"children":["Con không chịu nổi thì có thể xin nghỉ học, trường bắt buộc giữ học vị cho cháu, tối đa 1 năm"]},{"tag":"span","props":{},"children":["Nghỉ học có thủ tục chính thức. Cha mẹ hoặc người giám hộ khác nộp đơ…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/30-12"},"children":[{"tag":"strong","props":{},"children":["Khám ra nhìn kém thì ra bệnh viện khám khúc xạ sau khi nhỏ mắt, sau đó tái khám theo khoảng cách bác sĩ chỉ định"]},{"tag":"span","props":{},"children":["Khám khúc xạ sau khi nhỏ mắt là nhỏ một loại thuốc nhỏ mắt trước, làm…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/30-16"},"children":[{"tag":"strong","props":{},"children":["Quản trẻ thì đừng ra tay đánh, cũng đừng quát mắng hay chửi trẻ là ngu: trẻ hay bị đánh mắng thì vấn đề hành vi và vấn đề tâm lý đều nhiều hơn"]},{"tag":"span","props":{},"children":["Trẻ hay bị đánh thì hành vi gây hại và vấn đề tâm lý nhiều hơn, xa bố…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/30-17"},"children":[{"tag":"strong","props":{},"children":["Trẻ khó quản, bản thân lúc nào cũng không nhịn được mà đánh mắng, thì đi học một khoá dạy cha mẹ có cách làm cụ thể"]},{"tag":"span","props":{},"children":["Lớp dạy cha mẹ cách quản trẻ cụ thể, trong thử nghiệm chia nhóm ngẫu …"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/30-18"},"children":[{"tag":"strong","props":{},"children":["Đừng đưa con vào «trường cai nghiện internet» hay «trại đặc huấn» quản lý khép kín: luật cấm cách cai gây tổn hại thể chất, tinh thần, và đã có trẻ bị nhốt đến chết"]},{"tag":"span","props":{},"children":["Luật cấm rõ ràng cai nghiện internet bằng cách làm hại thể chất, tinh…"]}]}]}]},{"tag":"a","props":{"className":"life-text-link","href":"/vi/book/30"},"children":["Đọc toàn bộ chủ đề: Trẻ đang đi học"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"15","height":"15","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]}]}]},{"tag":"nav","props":{"className":"life-tabbar","aria-label":"Điều hướng chính"},"children":[{"tag":"a","props":{"className":"","href":"/vi/book"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"21","height":"21","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-book-open","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M12 7v14"},"child