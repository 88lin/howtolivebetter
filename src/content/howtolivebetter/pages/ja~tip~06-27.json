ink","href":"/ja/book/06"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"目次に戻る"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["アンチ・リスト"]},{"tag":"div","props":{"data-ad-dock-host":"true"},"children":[]},{"tag":"nav","props":{"aria-label":"この章のヒント"},"children":[{"tag":"a","props":{"href":"/ja/tip/06-01"},"children":[{"tag":"span","props":{},"children":["01"]},"長寿や心血管疾患の予防のためにマルチビタミンを摂取しないでください"]},{"tag":"a","props":{"href":"/ja/tip/06-02"},"children":[{"tag":"span","props":{},"children":["02"]},"心血管疾患の予防のために一般的なフィッシュオイルを摂取しないでください"]},{"tag":"a","props":{"href":"/ja/tip/06-03"},"children":[{"tag":"span","props":{},"children":["03"]},"ビタミンDが不足していない人に、長寿目的でビタミンDを補給しないでください"]},{"tag":"a","props":{"href":"/ja/tip/06-04"},"children":[{"tag":"span","props":{},"children":["04"]},"がん予防のために抗酸化サプリメント（β-カロテン、ビタミンE、ビタミンA）を摂取しないでください"]},{"tag":"a","props":{"href":"/ja/tip/06-05"},"children":[{"tag":"span","props":{},"children":["05"]},"グルコサミン/コンドロイチンで膝関節炎を治せると期待しないでください"]},{"tag":"a","props":{"href":"/ja/tip/06-06"},"children":[{"tag":"span","props":{},"children":["06"]},"ビタミンCに風邪の予防を期待しないでください"]},{"tag":"a","props":{"href":"/ja/tip/06-07"},"children":[{"tag":"span","props":{},"children":["07"]},"症状のない自分に対して「全身PET-CT」や「腫瘍マーカーセット」の検査を受けないでください"]},{"tag":"a","props":{"href":"/ja/tip/06-08"},"children":[{"tag":"span","props":{},"children":["08"]},"リストバンドやスマートウォッチによる運動量の数値化で減量できると期待しないでください"]},{"tag":"a","props":{"href":"/ja/tip/06-09"},"children":[{"tag":"span","props":{},"children":["09"]},"「より健康に」なるために、割高なオーガニック食品を買わないでください"]},{"tag":"a","props":{"href":"/ja/tip/06-10"},"children":[{"tag":"span","props":{},"children":["10"]},"「体調を整える」ために、サプリメントや膏方、滋養食品に大金を投じない"]},{"tag":"a","props":{"href":"/ja/tip/06-11"},"children":[{"tag":"span","props":{},"children":["11"]},"腸の問題がない限り、プロバイオティクスを長期的に摂取しない"]},{"tag":"a","props":{"href":"/ja/tip/06-12"},"children":[{"tag":"span","props":{},"children":["12"]},"「免疫力を高める」ために、無理に冷水シャワーを浴びない"]},{"tag":"a","props":{"href":"/ja/tip/06-13"},"children":[{"tag":"span","props":{},"children":["13"]},"デトックス、腸洗浄、酵素、アルカリ水などの製品を買わないでください"]},{"tag":"a","props":{"href":"/ja/tip/06-14"},"children":[{"tag":"span","props":{},"children":["14"]},"「毎日 8 杯の水を飲む」という目標を満たすために、無理に水を飲まないでください"]},{"tag":"a","props":{"href":"/ja/tip/06-15"},"children":[{"tag":"span","props":{},"children":["15"]},"占いやタロット、星座占いで決断を下すために、お金を使わないでください"]},{"tag":"a","props":{"href":"/ja/tip/06-16"},"children":[{"tag":"span","props":{},"children":["16"]},"「視力を守る」ためにブルーライトカット眼鏡を買わないでください。また「数ヶ月画面を見続けると目がダメになる」という言葉も信じないでください。ただし、目の張り、痛み、充血は緊急事態として扱うべきです"]},{"tag":"a","props":{"href":"/ja/tip/06-17"},"children":[{"tag":"span","props":{},"children":["17"]},"献血を健康法と考えないでください：「デトックス、血中脂質低下、心筋梗塞予防」を裏付けるランダム化比較試験はありません。頻繁な献血は、本当に鉄欠乏を引き起こします"]},{"tag":"a","props":{"href":"/ja/tip/06-18"},"children":[{"tag":"span","props":{},"children":["18"]},"一般的な健康診断パッケージに頼って病気を防ごうとせず、年齢と性別に基づいた、エビデンスのある検査項目を受けましょう"]},{"tag":"a","props":{"href":"/ja/tip/06-19"},"children":[{"tag":"span","props":{},"children":["19"]},"尿酸値が高いと診断されても、痛風の発作が一度もない場合は、安易に降尿酸薬の服用を始めないでください"]},{"tag":"a","props":{"href":"/ja/tip/06-20"},"children":[{"tag":"span","props":{},"children":["20"]},"検診で胆石が見つかったからといって、痛みがないのに予防的に胆嚢を切除しないでください"]},{"tag":"a","props":{"href":"/ja/tip/06-21"},"children":[{"tag":"span","props":{},"children":["21"]},"腎結石予防のためにカルシウムを控えないでください"]},{"tag":"a","props":{"href":"/ja/tip/06-22"},"children":[{"tag":"span","props":{},"children":["22"]},"「運気転換」「金運アップ」「開運（養人）」のために、水晶、ブレスレット、貔貅（ピーシュ）などの品物を買わないでください"]},{"tag":"a","props":{"href":"/ja/tip/06-23"},"children":[{"tag":"span","props":{},"children":["23"]},"買い物で気分やステータスを改善しようと期待しないでください"]},{"tag":"a","props":{"href":"/ja/tip/06-24"},"children":[{"tag":"span","props":{},"children":["24"]},"「周囲のレベルに合わせる」ために、家や車、コミュニティを変えるために余計な出費をしないでください"]},{"tag":"a","props":{"href":"/ja/tip/06-25"},"children":[{"tag":"span","props":{},"children":["25"]},"「意志力は筋肉のように、使えばなくなる」という説を信じないでください"]},{"tag":"a","props":{"href":"/ja/tip/06-26"},"children":[{"tag":"span","props":{},"children":["26"]},"朝食を抜くことや 16:8 の間欠的断食で体重をコントロールしようと思わないでください。食事の時間は、長期的に継続できるものを選びましょう"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/ja/tip/06-27","data-status":"active"},"children":[{"tag":"span","props":{},"children":["27"]},"「自慰は体に悪い」「禁欲すれば良くなる」を信じないでください。本当に見るべきは、睡眠、仕事、そして人間関係に支障が出ているかどうかです"]},{"tag":"a","props":{"href":"/ja/tip/06-28"},"children":[{"tag":"span","props":{},"children":["28"]},"「性的指向の矯正」や「同性愛治療」に金を使わないで。家族を送り込むのもやめてください"]},{"tag":"a","props":{"href":"/ja/tip/06-29"},"children":[{"tag":"span","props":{},"children":["29"]},"「正しい持ち上げ方」や運搬研修だけで腰痛を防げると思わず、重さと回数を減らし、普段から運動する"]},{"tag":"a","props":{"href":"/ja/tip/06-30"},"children":[{"tag":"span","props":{},"children":["30"]},"骨折後にカルシウムを大量に補ったり骨スープを飲んだりすれば、骨が早くつながるとは期待しない"]},{"tag":"a","props":{"href":"/ja/tip/06-31"},"children":[{"tag":"span","props":{},"children":["31"]},"AIチャットボットだけで病状や法律問題を判断しない。受診・裁判・大きな支出の前に、根拠の原文を確認する"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"現在地"},"children":[{"tag":"a","props":{"href":"/ja/book"},"children":["本を読む"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/ja/book/06"},"children":["第6章"," ·"," ","アンチ・リスト"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"06-27"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["27"]},{"tag":"span","props":{"className":"life-evidence grade-b"},"children":["エビデンス"," ","B"]}]},{"tag":"h1","props":{"lang":"ja"},"children":["「自慰は体に悪い」「禁欲すれば良くなる」を信じないでください。本当に見るべきは、睡眠、仕事、そして人間関係に支障が出ているかどうかです"]},{"tag":"p","props":{"lang":"ja","className":"life-entry-summary"},"children":["自慰が体を傷めると示した研究はありません。射精回数の多い男性は前立腺がんが約2割少ない一方、若い頃に回数の多い人でリスクが高い研究もあります。少数ですが毎回射精後に脱力や風邪のような症状が数日続く人がおり、これはまれな病気なので泌尿器科や男性医学の専門外来に相談できます。「ポルノ依存だ」と感じる背景には、自分の道徳観との葛藤がより強く関わることがあります。"]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["費用・手間"]},{"tag":"p","props":{},"children":["費用はかかりません。節約できるのは、「腎機能を補う」といった民間療法や「禁欲」講座に払うお金、そして長期的な自責によ…"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["効果"]},{"tag":"p","props":{},"children":["まず身体面です。米国で31925人の男性を2010年まで追跡した研究では、月の射精回数を自己申告して群分けしました。"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"記録する：「自慰は体に悪い」「禁欲すれば良くなる」を信じないでください。本当に見るべきは、睡眠、仕事、そして人間関係に支障が出ているかどうかです"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"できている"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"やることに追加"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"お気に入り"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"このヒントを共有"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"詳細を閉じる"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["費用・手間"]},{"tag":"p","props":{},"children":["費用はかかりません。節約できるのは、「腎機能を補う」といった民間療法や「禁欲」講座に払うお金、そして長期的な自責による不安です。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["効果"]},{"tag":"p","props":{},"children":["まず身体面です。米国で31925人の男性を2010年まで追跡した研究では、月の射精回数を自己申告して群分けしました。月4〜7回の人と比べ、月21回以上の人の前立腺がんは、20〜29歳の回数に基づくとHR 0.81（95% CI 0.72–0.92、約19%低下）、40〜49歳の回数ではHR 0.78（0.69–0.89、約22%低下）でした。減っていたのは主に低リスクの前立腺がんです。一方、英国の症例対照研究では60歳未満で診断された431人と対照409人を比較し、20〜30代の自慰頻度が高い人ではリスクが高く、50代で頻度が高い人では低くなっていました。ポルノについての系統的レビューとメタ解析では、「依存した」と感じる背景には、単なる視聴量よりも行動と信念の不一致が強く関わるとされています。少数の人には射精後の不調が実際にありますが、これは「体を傷めた」のではなく、射精後疾患症候群（POIS）というまれな病気です。禁欲に頼るより受診すべきです。オランダの患者45人では87%が射精後30分以内に発症し、80%が疲労・脱力、78%が風邪のような症状を訴えました。フランスの病院の37人では回復まで平均4.7日かかりました。原因は未解明です。オランダの研究では皮膚検査を受けた33人中29人（88%）に自分の精液へのアレルギー反応がありました。一方、中国の24人の研究では精液に対するアレルギー抗体は検出されず、不安・抑うつの点数が高くなっていました。2025年のレビューで見つかった治療研究は14件だけで、そのうち12件は症例報告でした。世界の性医学専門家211人のうち、患者の3割超が改善すると答えたのは18%だけでした（米国／英国／オランダ／フランス／中国）。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["出典"]},{"tag":"p","props":{"className":"life-citations"},"children":["Rider JR, Wilson KM, Sinnott JA, et al. (2016). Ejaculation Frequency and Risk of Prostate Cancer: Updated Results with an Additional Decade of Follow-up. European Urology, 70(6), 974–982. ",{"tag":"a","props":{"href":"https://doi.org/10.1016/j.eururo.2016.03.027","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1016/j.eururo.2016.03.027"]},"；Dimitropoulou P, Lophatananon A, Easton D, et al. (2009). Sexual activity and prostate cancer risk in men diagnosed at a younger age. BJU International, 103(2), 178–185. ",{"tag":"a","props":{"href":"https://doi.org/10.1111/j.1464-410x.2008.08030.x","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1111/j.1464-410x.2008.08030.x"]},"；Grubbs JB, Perry SL, Wilt JA, Reid RC. (2019). Pornography Problems Due to Moral Incongruence: An Integrative Model with a Systematic Review and Meta-Analysis. Archives of Sexual Behavior, 48(2), 397–415. ",{"tag":"a","props":{"href":"https://doi.org/10.1007/s10508-018-1248-x","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1007/s10508-018-1248-x"]},"；Waldinger MD, Meinardi MM, Zwinderman AH, Schweitzer DH. (2011). Postorgasmic Illness Syndrome (POIS) in 45 Dutch caucasian males: clinical characteristics and evidence for an immunogenic pathogenesis (Part 1). The Journal of Sexual Medicine, 8(4), 1164–1170. ",{"tag":"a","props":{"href":"https://doi.org/10.1111/j.1743-6109.2010.02166.x","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1111/j.1743-6109.2010.02166.x"]},"；Chea M, Teng M, Chesnel C, et al. (2023). Postorgasmic illness syndrome: one or several entities? A retrospective cohort study. The Journal of Sexual Medicine, 20(12), 1407–1413. ",{"tag":"a","props":{"href":"https://doi.org/10.1093/jsxmed/qdad139","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1093/jsxmed/qdad139"]},"；Xi GP, Yang RX, Zhang J, et al. (2023). Clinical characteristics, allergic response to autologous semen, and desensitization in patients with postorgasmic illness syndrome. Sexual Medicine, 11(6), qfad068. ",{"tag":"a","props":{"href":"https://doi.org/10.1093/sexmed/qfad068","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1093/sexmed/qfad068"]},"；Ponce S, Chapalamadugu M, Levine S, et al. (2025). Treatments for postorgasmic illness syndrome: a systematic review. The Journal of Sexual Medicine, 22(7), 1236–1243. ",{"tag":"a","props":{"href":"https://doi.org/10.1093/jsxmed/qdaf112","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1093/jsxmed/qdaf112"]},"；Duran MB, Rubin RS, Reisman Y, Serefoglu EC, et al. (2025). Recognition and practice patterns of sexual medicine experts towards postorgasmic illness syndrome. International Journal of Impotence Research, 37(6), 454–457. ",{"tag":"a","props":{"href":"https://doi.org/10.1038/s41443-023-00753-x","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1038/s41443-023-00753-x"]}]},{"tag":"a","props":{"href":"https://doi.org/10.1016/j.eururo.2016.03.027","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["出典を開く"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["著者の注記"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["議論があります。前立腺がんの2研究は観察記録であり無作為比較ではなく、回数も本人の回想です。結論は「体を傷める証拠は見られない」までで、逆に回数を増やすよう勧めることはできません。英国の著者も、50代では先に病気になったため回数が減った可能性を述べています。ポルノの論文の抄録には効果量がないため、ここでは方向だけを記載します。利益を「小」としたのは、減ったのが主に低リスクの前立腺がんであり、死亡ではないためです。射精後の不調の研究はどれも数十人規模です。文献ではまれな病気とされていますが、一般人口で有病率を数えた研究はありません。ほぼ毎回射精後に脱力し、風邪のような症状が数日続くなら、泌尿器科や男性医学の専門外来でPOISという病名を伝えてください。精神科や心理専門外来への相談の目安は、このために夜更かしし、仕事や伴侶との関係に支障が出て、やめたくてもやめられないことです。夜更かしは第3節第9条（ゲーム・短い動画・ポルノのために夜更かししない）、勃起の問題が心配ならまず第1節第28条（勃起機能の問題では心血管を調べる）を参照してください。グループへの投稿や素材販売に関する中国の法的な結果は第9節第4条を参照してください。受益者はあなた自身です。"]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["自分のメモ"]},{"tag":"button","props":{"type":"button"},"children":["自分へのメモを書く…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/ja/tip/06-26"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["前へ"]},"朝食を抜くことや 16:8 の間欠的断食で体重をコントロールしようと思わないでください。食事の時間は、長期的に継続できるものを選びましょう"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/ja/tip/06-28"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["次へ"]},"「性的指向の矯正」や「同性愛治療」に金を使わないで。家族を送り込むのもやめてください"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["このテーマの他の提案"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"childre