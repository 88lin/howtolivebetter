— раздел 8, п. 19. Ни один путь не гарантирует получение денег: нет имущества — выиграли, но не получили."]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Моя заметка"]},{"tag":"button","props":{"type":"button"},"children":["Запишите напоминание…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/ru/tip/07-21"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Предыдущий"]},"Если совсем негде ночевать, круглосуточные заведения подойдут лишь на одну ночь; лучше сразу идти в приют"]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["Другие советы по этой теме"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/07-15"},"children":[{"tag":"strong","props":{},"children":["Без залога, без удержания документов, без «обучающих кредитов», без схем пирамид, без высокопроцентных займов"]},{"tag":"span","props":{},"children":["Работодатель не имеет права удерживать ваш паспорт, требовать залог и…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/07-16"},"children":[{"tag":"strong","props":{},"children":["Очередь на социальное жилье для нуждающихся"]},{"tag":"span","props":{},"children":["Чтобы попасть в очередь, нужно одновременно выполнить три условия: не…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/