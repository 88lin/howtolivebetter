":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},{"tag":"span","props":{},"children":["ログイン"]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/ja/book/26"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"目次に戻る"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["ウェブサイトやプラットフォームの構築：資格、届出、サーバー"]},{"tag":"nav","props":{"aria-label":"この章のヒント"},"children":[{"tag":"a","props":{"href":"/ja/tip/26-01"},"children":[{"tag":"span","props":{},"children":["01"]},"プラットフォームが自ら代金を受け取ってから販売者に送金するのではなく、ライセンスを持つ決済機関を通じて直接決済される仕組みにすること"]},{"tag":"a","props":{"href":"/ja/tip/26-02"},"children":[{"tag":"span","props":{},"children":["02"]},"有料サイトの多くは許可証が必要。自社販売のみ（他者の出店不可）なら不要。仲介取引は別の許可が必要。無料なら届出のみでOK"]},{"tag":"a","props":{"href":"/ja/tip/26-03"},"children":[{"tag":"span","props":{},"children":["03"]},"ライブ配信にはネットワーク文化経営許可証が必要。視聴覚番組用の許可証は民間企業ではほぼ取得不可能"]},{"tag":"a","props":{"href":"/ja/tip/26-04"},"children":[{"tag":"span","props":{},"children":["04"]},"サーバーを国内に置く場合は备案（届出）が必要であり、接続事業者は自ら付加価値通信許可を保有していなければならない"]},{"tag":"a","props":{"href":"/ja/tip/26-05"},"children":[{"tag":"span","props":{},"children":["05"]},"ユーザーに販売を許可する場合、プラットフォームは登録情報の照合、情報の報告、および3年間の保存を行う義務がある"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/ja/tip/26-06","data-status":"active"},"children":[{"tag":"span","props":{},"children":["06"]},"ユーザーが投稿したコンテンツの管理義務：審査メカニズム、通報窓口、違法発見時の即時停止および報告"]},{"tag":"a","props":{"href":"/ja/tip/26-07"},"children":[{"tag":"span","props":{},"children":["07"]},"情報提供・即時通信サービスを提供する場合、ユーザーに真実の身元情報の提供を義務付けなければならない"]},{"tag":"a","props":{"href":"/ja/tip/26-08"},"children":[{"tag":"span","props":{},"children":["08"]},"16歳未満の者へのライブ配信許可禁止、投げ銭（ギフティング）は年齢に応じて段階的に処理"]},{"tag":"a","props":{"href":"/ja/tip/26-09"},"children":[{"tag":"span","props":{},"children":["09"]},"権利侵害の通知を受けた際は速やかに処理すること。異議申し立ての転送後、15日以内に進展がなければ復旧させる"]},{"tag":"a","props":{"href":"/ja/tip/26-10"},"children":[{"tag":"span","props":{},"children":["10"]},"ユーザー情報は安易に国外へ持ち出さないでください。国外への持ち出しには法的な条件と人数制限があります"]},{"tag":"a","props":{"href":"/ja/tip/26-11"},"children":[{"tag":"span","props":{},"children":["11"]},"サーバー選びは、まずダウンタイムに耐えられるか、次に運用担当者がいるかを確認し、最後に価格を比較すること"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"現在地"},"children":[{"tag":"a","props":{"href":"/ja/book"},"children":["本を読む"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/ja/book/26"},"children":["第26章"," ·"," ","ウェブサイトやプラットフォームの構築：資格、届出、サーバー"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"26-06"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["06"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["エビデンス"," ","A"]}]},{"tag":"h1","props":{"lang":"ja"},"children":["ユーザーが投稿したコンテンツの管理義務：審査メカニズム、通報窓口、違法発見時の即時停止および報告"]},{"tag":"p","props":{"lang":"ja","className":"life-entry-summary"},"children":["ユーザーが投稿した内容に関して、問題が発生した場合はプラットフォームが責任を負います。以下の制度を構築する必要があります：登録、投稿審査、コメント審査、毎日の巡回、およびトラブル発生時の対応策です。ページ内の目立つ場所に通報窓口を設置してください。違法な情報を見つけた場合は、直ちに拡散を停止し、記録を保存した上で、主管部門に報告してください。これを行わない場合、5 万から 50 万元の罰金、重大な場合はさらに高額な罰金が科せられます。"]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["費用・手間"]},{"tag":"p","props":{},"children":["審査のための人員を雇う必要があり、これはプラットフォームにおける最大の継続的な支出となります。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["効果"]},{"tag":"p","props":{},"children":["法規では、プラットフォームは「情報内容管理の主体としての責任を果たすべき」とされており、ユーザーが投稿した内容はプラットフォーム自身が管理責任を負うことになっています。"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"記録する：ユーザーが投稿したコンテンツの管理義務：審査メカニズム、通報窓口、違法発見時の即時停止および報告"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"できている"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"やることに追加"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"お気に入り"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"このヒントを共有"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"詳細を閉じる"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["費用・手間"]},{"tag":"p","props":{},"children":["審査のための人員を雇う必要があり、これはプラットフォームにおける最大の継続的な支出となります。通報窓口と、すべての対応記録には証跡を残す必要があります。困難な点は、毎日誰かが監視していなければならず、一日でも停止するとトラブルに発展する可能性があることです。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["効果"]},{"tag":"p","props":{},"children":["法規では、プラットフォームは「情報内容管理の主体としての責任を果たすべき」とされており、ユーザーが投稿した内容はプラットフォーム自身が管理責任を負うことになっています。具体的には、「ユーザー登録、アカウント管理、情報公開の審査、返信・コメントの審査、掲示板・ページの運営エコシステム管理、リアルタイム巡回、緊急対応、およびネット上のデマや闇産業に関する情報の処理などの制度を整備しなければならない」とされています。登録、投稿、コメントから、日常的な巡回やトラブル発生時の対応に至るまで、あらゆるプロセスにおいて明文化されたルールが必要です。また、「目立つ場所に、分かりやすい通報・報告窓口を設置しなければならない」とされており、通報ボタンはユーザーがひと目で確認でき、操作しやすい場所に配置する必要があります。違法な情報が発見された場合は、「法律に基づき直ちに適切な措置を講じ、関連する記録を保存した上で、関係当局に報告しなければならない」とされています。サイバーセキュリティ法では、より具体的に規定されています。原文では「法律、行政法規により公開または伝達が禁止されている情報が発見された場合、直ちに当該情報の伝達を停止し、拡散を防ぐために削除などの措置を講じ、関連する記録を保存した上で、関係当局に報告しなければならない」とされています。これに従わなかった場合は、是正命令、警告、および通報の対象となり、さらに 5 万から 50 万元の罰金が科される可能性があります。是正を拒否した場合、または事態が深刻な場合には、50 万から 200 万元の罰金に加え、営業停止、ウェブサイトまたはアプリケーションの閉鎖、許可証または営業ライセンスの取り消しを命じられる可能性があります。直接責任者には、別途 5 万から 20 万元の罰金が科されます（全国規模）。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["出典"]},{"tag":"p","props":{"className":"life-citations"},"children":["国家互联网信息办公室 (2019). 网络信息内容生态治理规定（网信办令第 5 号，第八、九、十、十六、三十七条）. ",{"tag":"a","props":{"href":"http://www.cac.gov.cn/2019-12/20/c_1578375159509309.htm","target":"_blank","rel":"noopener noreferrer"},"children":["http://www.cac.gov.cn/2019-12/20/c_1578375159509309.htm"]}," ; 全国人大常委会 (2025). 网络安全法（2025 年修正，2026 年 1 月 1 日施行，第四十九、六十九条）. ",{"tag":"a","props":{"href":"https://www.cac.gov.cn/2025-12/29/c_1768735112911946.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.cac.gov.cn/2025-12/29/c_1768735112911946.htm"]}," ; 国务院 (2000). 互联网信息服务管理办法（第十五、十六、二十三条）. ",{"tag":"a","props":{"href":"https://www.gov.cn/gongbao/content/2011/content_1860864.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/gongbao/content/2011/content_1860864.htm"]}]},{"tag":"a","props":{"href":"http://www.cac.gov.cn/2019-12/20/c_1578375159509309.htm","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["出典を開く"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["著者の注記"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["審査ルールを自ら考える必要はなく、既存のものをそのまま適用すればよいでしょう。どの9種類のコンテンツが禁止されているかは、インターネット情報サービス管理弁法第15条に明確に記載されています。ライブ配信を行う場合は、さらに3つの事項があります。「ライブ配信コンテンツ審査プラットフォームを構築すること」、「配信中のライブをいつでも遮断できること（法条ではこれを『即時遮断』と呼びます）」、そして「ライブ配信の内容とログを 60 日間保存すること」です。ネットワークパフォーマンス（ネット配信）のビデオ資料についても、同様に 60 日以上保存する必要があります。"]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["自分のメモ"]},{"tag":"button","props":{"type":"button"},"children":["自分へのメモを書く…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/ja/tip/26-05"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["前へ"]},"ユーザーに販売を許可する場合、プラットフォームは登録情報の照合、情報の報告、および3年間の保存を行う義務がある"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/ja/tip/26-07"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["次へ"]},"情報提供・即時通信サービスを提供する場合、ユーザーに真実の身元情報の提供を義務付けなければならない"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["このテーマの他の提案"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/26-02"},"children":[{"tag":"strong","props":{},"children":["有料サイトの多くは許可証が必要。自社販売のみ（他者の出店不可）なら不要。仲介取引は別の許可が必要。無料なら届出のみでOK"]},{"tag":"span","props":{},"children":["ユーザーから料金を徴収するサイトは、多くの場合、事前に「増値電信業務経営許可証」を取得する必要があります。この許可証は個人では取得できませ…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/26-03"},"children":[{"tag":"strong","props":{},"children":["ライブ配信にはネットワーク文化経営許可証が必要。視聴覚番組用の許可証は民間企業ではほぼ取得不可能"]},{"tag":"span","props":{},"children":["ライブ配信やゲーム実況を行うには、省級文化部門が発行するネットワーク文化経営許可証が必要です。許可証の経営範囲に「ネットワークパフォーマン…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/26-04"},"children":[{"tag":"strong","props":{},"children":["サーバーを国内に置く場合は备案（届出）が必要であり、接続事業者は自ら付加価値通信許可を保有していなければならない"]},{"tag":"span","props":{},"children":["サーバーを国内に置く場合、サイト開設前に备案（届出）を行う必要があります。备案に費用はかからず、サーバーと一緒にサービスプロバイダーを通じ…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/26-08"},"children":[{"tag":"strong","props":{},"children":["16歳未満の者へのライブ配信許可禁止、投げ銭（ギフティング）は年齢に応じて段階的に処理"]},{"tag":"span","props":{},"children":["16歳未満の者は、あなたのサイトで配信アカウントを登録することはできません。16歳以上の場合は、身元認証に加え、親またはその他の保護者の同…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/26-09"},"children":[{"tag":"strong","props":{},"children":["権利侵害の通知を受けた際は速やかに処理すること。異議申し立ての転送後、15日以内に進展がなければ復旧させる"]},{"tag":"span","props":{},"children":["権利侵害の通知が届き、初歩的な証拠が添付されている場合は、速やかにコンテンツを削除、ブロック、またはリンクを遮断し、同時にその通知を販売者…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/26-10"},"children":[{"tag":"strong","props":{},"children":["ユーザー情報は安易に国外へ持ち出さないでください。国外への持ち出しには法的な条件と人数制限があります"]},{"tag":"span","props":{},"children":["国内ユーザーの情報を国外のサーバーへ転送することを「国外移転」と呼びます。サーバーが国外にあるからといって、データが国外へ移転していないこ…"]}]}]}]},{"tag":"a","props":{"className":"life-text-link","href":"/ja/book/26"},"children":["テーマ全体を読む：ウェブサイトやプラットフォームの構築：資格、届出、サーバー"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"15","height":"15","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]}]}]},{"tag":"nav","props":{"className":"life-tabbar","aria-label":"メインナビゲーション"},"children":[{"tag":"a","props":{"className":"","href":"/ja/book"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"21","height":"21","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-book-open","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M12 7v14"},"children":[]},{"tag":"path","props":{"d":"M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0