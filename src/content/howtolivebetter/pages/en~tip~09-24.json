s":{"xmlns":"http://www.w3.org/2000/svg","width":"18","height":"18","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-up-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M7 7h10v10"},"children":[]},{"tag":"path","props":{"d":"M7 17 17 7"},"children":[]}]}]}]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/en/book/09"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"Back to index"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["Legal pitfalls that ordinary people often overlook"]},{"tag":"div","props":{"data-ad-dock-host":"true"},"children":[]},{"tag":"nav","props":{"aria-label":"Chapter entries"},"children":[{"tag":"a","props":{"href":"/en/tip/09-01"},"children":[{"tag":"span","props":{},"children":["01"]},"Do not share unverified messages about disasters, epidemics, or police incidents in groups; do not photoshop images or use AI to generate fake scene pictures"]},{"tag":"a","props":{"href":"/en/tip/09-02"},"children":[{"tag":"span","props":{},"children":["02"]},"Do not post, share, or comment images, memes, or remarks that insult heroes and martyrs, nor make jokes about the national flag or anthem"]},{"tag":"a","props":{"href":"/en/tip/09-03"},"children":[{"tag":"span","props":{},"children":["03"]},"After viewing content on foreign websites, simply close the page — do not screenshot, share, repost, or discuss it in any groups or comment sections"]},{"tag":"a","props":{"href":"/en/tip/09-04"},"children":[{"tag":"span","props":{},"children":["04"]},"Watching porn alone is fine, but don’t post it in groups, sell “resources,” or create groups"]},{"tag":"a","props":{"href":"/en/tip/09-05"},"children":[{"tag":"span","props":{},"children":["05"]},"Part-time jobs that ask you to use your own card to receive payments, withdraw cash, or transfer money — no matter how much extra pay they offer, avoid them"]},{"tag":"a","props":{"href":"/en/tip/09-06"},"children":[{"tag":"span","props":{},"children":["06"]},"Some people try to get you to “package loan applicants” for them and offer a commission based on the loan amount — don’t fall for it"]},{"tag":"a","props":{"href":"/en/tip/09-07"},"children":[{"tag":"span","props":{},"children":["07"]},"Keeping found items and not using them for personal gain; returning lost phones, wallets, or cash to owners or police"]},{"tag":"a","props":{"href":"/en/tip/09-08"},"children":[{"tag":"span","props":{},"children":["08"]},"Use your real identity to claim discounts — don’t register fake accounts or exploit loopholes to get more"]},{"tag":"a","props":{"href":"/en/tip/09-09"},"children":[{"tag":"span","props":{},"children":["09"]},"Never throw anything from balconies or windows — cigarette butts, trash bags, and bottles all count"]},{"tag":"a","props":{"href":"/en/tip/09-10"},"children":[{"tag":"span","props":{},"children":["10"]},"Do not buy imitation guns, BB guns, or air rifles online; avoid “toy guns” of unknown origin"]},{"tag":"a","props":{"href":"/en/tip/09-11"},"children":[{"tag":"span","props":{},"children":["11"]},"Register drones with your real name first; never fly near airports, military zones, or restricted urban airspace, and don’t tamper with altitude limits"]},{"tag":"a","props":{"href":"/en/tip/09-12"},"children":[{"tag":"span","props":{},"children":["12"]},"Do not secretly film others, nor install cameras in rented apartments, homestays, or hotel rooms"]},{"tag":"a","props":{"href":"/en/tip/09-13"},"children":[{"tag":"span","props":{},"children":["13"]},"Mahjong and poker can be played — no rake, no banker role, no organizing paid games, no online gambling"]},{"tag":"a","props":{"href":"/en/tip/09-14"},"children":[{"tag":"span","props":{},"children":["14"]},"Do not eat wild animals; do not buy, sell, or keep protected species as pets"]},{"tag":"a","props":{"href":"/en/tip/09-15"},"children":[{"tag":"span","props":{},"children":["15"]},"You cannot detain or confine someone to collect a debt, nor follow them home and refuse to leave"]},{"tag":"a","props":{"href":"/en/tip/09-16"},"children":[{"tag":"span","props":{},"children":["16"]},"Do not lend your ID card, do not use someone else’s ID card, and do not register, open accounts, or buy tickets using another person’s documents"]},{"tag":"a","props":{"href":"/en/tip/09-17"},"children":[{"tag":"span","props":{},"children":["17"]},"Cooperate when stopped or taken away by police — don’t push, hit, or grab their body cameras; especially if you’ve been drinking, stay calm"]},{"tag":"a","props":{"href":"/en/tip/09-18"},"children":[{"tag":"span","props":{},"children":["18"]},"Sexual relations with anyone under 14 are illegal; “she consented” is not a defense"]},{"tag":"a","props":{"href":"/en/tip/09-19"},"children":[{"tag":"span","props":{},"children":["19"]},"Do the math before you hit someone: detention, fines, and prison time"]},{"tag":"a","props":{"href":"/en/tip/09-20"},"children":[{"tag":"span","props":{},"children":["20"]},"If parents cannot care for their newborn, the only legal option is to register the adoption with the civil affairs bureau: paying someone to hand over the child may be prosecuted as child trafficking, while abandoning the child constitutes abandonment"]},{"tag":"a","props":{"href":"/en/tip/09-21"},"children":[{"tag":"span","props":{},"children":["21"]},"Don’t fabricate accidents or exaggerate damages to defraud insurance payouts: this is insurance fraud, and anyone helping you testify, assess damage, or repair your vehicle is equally liable"]},{"tag":"a","props":{"href":"/en/tip/09-22"},"children":[{"tag":"span","props":{},"children":["22"]},"Don’t sell your own organs, and don’t help others find donors: a kidney brings in just over $20,000, but the same kidney can be sold to a patient for $200,000. All proceeds are seized, plus a fine of 10–20 times the transaction amount"]},{"tag":"a","props":{"href":"/en/tip/09-23"},"children":[{"tag":"span","props":{},"children":["23"]},"Don’t engage in prostitution: the default penalty is 10–15 days in detention, not just a fine"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/en/tip/09-24","data-status":"active"},"children":[{"tag":"span","props":{},"children":["24"]},"Distributing unauthorized Chinese-dubbed comics, pirated movies/TV shows, cloud storage links, and pirated e-books — even for free — is illegal; adding ads or charging membership fees can lead to criminal charges"]},{"tag":"a","props":{"href":"/en/tip/09-25"},"children":[{"tag":"span","props":{},"children":["25"]},"To publish or monetize fan works, first obtain permission from the original copyright holder, or replace the borrowed characters’ names and relationships with your own"]},{"tag":"a","props":{"href":"/en/tip/09-26"},"children":[{"tag":"span","props":{},"children":["26"]},"Do not buy and carry batons, stun devices, daggers, or pepper spray for self-defense; keeping them in your car also counts as carrying"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"Breadcrumb"},"children":[{"tag":"a","props":{"href":"/en/book"},"children":["Explore the book"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/en/book/09"},"children":["Chapter 9"," ·"," ","Legal pitfalls that ordinary people often overlook"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"09-24"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["24"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["Evidence"," ","A"]}]},{"tag":"h1","props":{"lang":"en"},"children":["Distributing unauthorized Chinese-dubbed comics, pirated movies/TV shows, cloud storage links, and pirated e-books — even for free — is illegal; adding ads or charging membership fees can lead to criminal charges"]},{"tag":"p","props":{"lang":"en","className":"life-entry-summary"},"children":["Translating and posting someone else’s work online without permission — even if you don’t charge anything — still counts as copyright infringement, requiring removal and compensation payments. Once ads or membership fees enter the picture, it’s considered a profit-seeking act. Earning over 30,000 yuan, distributing 500 works, or amassing 1,000 paying members can be enough to trigger criminal penalties, with maximum sentences reaching 10 years. The founder of the YYYS subtitle group was sentenced to 3 years and 6 months."]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Cost"]},{"tag":"p","props":{},"children":["There’s virtually no cost involved. You can buy or downloa…"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Benefit"]},{"tag":"p","props":{},"children":["Legally, copyright law grants creators translation rights — the ability to convert a work from one language to…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"Mark: Distributing unauthorized Chinese-dubbed comics, pirated movies/TV shows, cloud storage links, and pirated e-books — even for free — is illegal; adding ads or charging membership fees can lead to criminal charges"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"Done"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"Plan to do"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"Save"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Share this tip"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Hide details"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Cost"]},{"tag":"p","props":{},"children":["There’s virtually no cost involved. You can buy or download content for personal viewing or translation practice, as long as you don’t post it online for others to access. Avoid creating resource websites or groups that display ads or charge membership fees, and never sell cloud storage links. The real challenge is resisting the urge to become a “reposter” when everyone else seems to be doing it."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Benefit"]},{"tag":"p","props":{},"children":["Legally, copyright law grants creators translation rights — the ability to convert a work from one language to another — and the right to distribute it online so the public can access it at any time. Unauthorized translation or online posting constitutes infringement. Only uses strictly for personal study, research, or enjoyment are exempt from permission or payment requirements. Compensation is calculated based on the copyright holder’s actual losses or your profits; if those can’t be determined, courts may set it between 500 yuan and 5 million yuan. In cases of intentional and severe infringement, penalties can be increased by 1 to 5 times. Reasonable costs incurred by rights holders to stop the infringement must also be paid. Criminally, Article 217 of the Criminal Law requires “profit-seeking intent” to apply. Uploading works online for public access without permission qualifies as copyright infringement, punishable by up to 3 years in prison plus fines; larger-scale or more serious cases incur sentences of 3 to 10 years plus fines. Profit-seeking includes placing paid ads on websites and charging membership or registration fees — all such earnings are deemed illegal income. Thresholds include earning over 30,000 yuan, generating over 50,000 yuan in illegal business volume (as seen in the YYYS case involving membership fees, ads, and hard drive sales), sharing 500+ works online, receiving over 10,000 downloads or 100,000 views, or amassing 1,000+ paying members. If two of these thresholds are each met by more than half, the same penalties apply; exceeding these figures by 10 times moves cases into the 3–10 year bracket. Fines typically equal 1–10 times the illegal earnings. Official cases: Liang Yongping and others downloaded unauthorized films, organized translation/subtitling, and made them available via the YYYS website and app, amassing over 32,800 works and 6.8 million members; from 2018–2021 they earned over 1.15 million yuan from ads and membership fees, plus another 1 million yuan from selling pirated hard drives, resulting in a 3-year-and-6-month sentence plus 1.5 million yuan in fines. Another case involved Ke, who used web crawlers to gather over 50,000 films, displayed ads on his site/app, and earned 350,000 yuan before receiving a 3-year suspended sentence and 400,000 yuan in fines. Huang operated an illegal music download forum from home, amassing over 100,000 songs and 500,000 yuan in membership fees; he was sentenced to 3 years suspended and 550,000 yuan in fines."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Original sources"]},{"tag":"p","props":{"className":"life-citations"},"children":["全国人大常委会 (2020). 著作权法（2020 年修正，第十条第一款第十二、十五项，第二十四条第一项，第五十二条第六项，第五十三条第一项，第五十四条）. ",{"tag":"a","props":{"href":"http://www.npc.gov.cn/npc/c2/c30834/202011/t20201119_308796.html","target":"_blank","rel":"noopener noreferrer"},"children":["http://www.npc.gov.cn/npc/c2/c30834/202011/t20201119_308796.html"]},"；全国人大常委会 (2020). 刑法修正案（十一）（第二十项，即刑法第二百一十七条）. ",{"tag":"a","props":{"href":"https://www.spp.gov.cn/zdgz/202012/t20201227_503682.shtml","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.spp.gov.cn/zdgz/202012/t20201227_503682.shtml"]},"；最高人民法院、最高人民检察院 (2025). 关于办理侵犯知识产权刑事案件适用法律若干问题的解释（法释〔2025〕5 号，第十二、十三、二十五、二十八、三十一条）. ",{"tag":"a","props":{"href":"https://www.spp.gov.cn/xwfbh/wsfbt/202504/t20250424_693977.shtml","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.spp.gov.cn/xwfbh/wsfbt/202504/t20250424_693977.shtml"]},"；最高人民法院、最高人民检察院、公安部 (2011). 关于办理侵犯知识产权刑事案件适用法律若干问题的意见（法发〔2011〕3 号，第十条）. ",{"tag":"a","props":{"href":"https://www.dongguandesq.jcy.gov.cn/tzgg/201103/t20110321_3344314.shtml","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.dongguandesq.jcy.gov.cn/tzgg/201103/t20110321_3344314.shtml"]},"（东莞市第二市区人民检察院转载）；最高人民检察院 (2023). 第四十八批指导性案例（检例第 193 号，梁永平、王正航等十五人侵犯著作权案）. ",{"tag":"a","props":{"href":"https://www.spp.gov.cn/spp/jczdal/202309/t20230915_628229.shtml","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.spp.gov.cn/spp/jczdal/202309/t20230915_628229.shtml"]},"；最高人民检察院 (2024). 检察机关依法惩治侵犯著作权犯罪典型案例（案例一、案例三）. ",{"tag":"a","props":{"href":"https://www.spp.gov.cn/spp/xwfbh/wsfbt/202401/t20240105_639347.shtml","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.spp.gov.cn/spp/xwfbh/wsfbt/202401/t20240105_639347.shtml"]},"；中国驻长崎总领事馆 (2018). 中国驻长崎总领事馆提醒在日中国公民遵守著作权法. ",{"tag":"a","props":{"href":"http://nagasaki.china-consulate.gov.cn/chn/tzgg/201802/t20180208_4564322.htm","target":"_blank","rel":"noopener noreferrer"},"children":["http://nagasaki.china-consulate.gov.cn/chn/tzgg/201802/t20180208_4564322.htm"]}]},{"tag":"a","props":{"href":"http://www.npc.gov.cn/npc/c2/c30834/202011/t20201119_308796.html","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Open source link"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Book note"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["The beneficiary is you. Buying something to watch yourself or translating it for your own reading is within the scope permitted by the statutory provisions. The line is putting it online for everyone to view. Unpaid subtitle or localization groups do not meet the profit requirement for criminal copyright infringement, but civil infringement still applies: rights holders may demand removal and compensation. In Japan, unpaid activity may also be illegal. In February 2018, several Chinese citizens in Japan were arrested on suspicion of violating Japanese copyright law. China’s Consulate General in Nagasaki then warned that translating, publishing, or distributing works without authorization may be unlawful even without profit. Running ads, selling memberships, or exchanging “donations” for membership benefits brings the activity into the profit category. In the Renren Yingshi case, people who only translated or proofread had limited involvement and police obtained evidence from them as witnesses. The Supreme People’s Procuratorate said organizers, those sharing proceeds, and platform managers should face strict accountability. Hired accomplices may receive leniency, while temporarily recruited people with minor involvement may avoid criminal liability. The three old criminal IP judicial interpretations from 2004, 2007, and 2020 were repealed on April 26, 2025. The 2011 opinion from three authorities was not expressly repealed; where inconsistent with the new interpretation, the new one prevails. For example, the view-count threshold changed from 50000 to 100000. For other risks in publishing fan fiction or derivative works, see Item 25 in this section (writing fan fiction). For printing others’ images on goods for sale, see Section 12, Item 21 (buy a license for designs). For what a platform operator should do after receiving a rights holder’s infringement notice, see Section 26, Item 9 (receiving an infringement notice)."]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["My note"]},{"tag":"button","props":{"type":"button"},"children":["Write a reminder for yourself…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/en/tip/09-23"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Previous"]},"Don’t engage in prostitution: the default penalty is 10–15 days in detention, not just a fine"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/en/tip/09-25"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Next"]},"To publish or monetize fan works, first obtain permission from the original copyright holder, or replace the borrowed characters’ names and relationships with your own"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["More in this topic"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/en/tip/09-18"},"children":[{"tag":"strong","props":{},"children":["Sexual relations with anyone under 14 are illegal; “she consented” is not a defense"]},{"tag":"s