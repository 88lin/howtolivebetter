mở nguồn"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Ghi chú sách"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["Lương chính thức chia theo nghề chỉ chia tới năm nhóm vị trí lớn, không có nghề cụ thể. Số liệu năm 2025 của Cục Thống kê Quốc gia là doanh nghiệp quy mô trở lên có lương năm trung bình khoảng 10.6 vạn tệ (con số chính xác 106080 tệ). Quản lý cấp trung trở lên khoảng 21 vạn tệ (con số chính xác 210016 tệ), nhân viên kỹ thuật chuyên môn khoảng 15.5 vạn tệ (con số chính xác 155491 tệ), nhân viên văn phòng 94936 tệ, người sản xuất 80739 tệ, người dịch vụ sản xuất và sinh hoạt 79857 tệ. Bảng「100 nghề thiếu người nhất」của Bộ Nhân sự và Xã hội tra được trên Cổng việc làm Trung Quốc, kỳ mới nhất dừng ở quý bốn năm 2022, lập từ số liệu tuyển dụng và xin việc của các cơ quan dịch vụ việc làm công cộng ở 102 thành phố cả nước. Câu「nghề này kiếm được bao nhiêu một tháng」lan truyền trên mạng gần như đến từ giá niêm yết của nền tảng tuyển dụng hoặc lời tự kể của cá nhân. Phần bạn nhìn thấy phần lớn là nhóm đã kiếm được tiền, và không ai tính giờ làm, đường đi, bệnh nghề nghiệp, mùa cao mùa thấp cả. Muốn xem nhu cầu thật thì vào trang cơ quan nhân sự địa phương tra danh mục trợ cấp, rồi tra bảng xếp hạng nhu cầu vị trí của cơ quan dịch vụ việc làm công cộng. Cuối cùng hãy ra công trường, nhà máy, cửa hàng hỏi người đang làm việc."]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Ghi chú của tôi"]},{"tag":"button","props":{"type":"button"},"children":["Viết một lời nhắc cho chính bạn…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/vi/tip/23-11"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Trước"]},"Trước khi học, xác nhận kỹ năng này có đánh giá theo cấp bậc không, cấp bậc có đổi ra tiền được không"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/vi/tip/23-13"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Tiếp theo"]},"Với cùng số tiền và thời gian, ưu tiên chương trình ngắn hạn học xong là vào việc được ngay"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["Thêm trong chủ đề này"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/23-08"},"children":[{"tag":"strong","props":{},"chil