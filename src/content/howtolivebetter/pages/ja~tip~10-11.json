ag":"span","props":{},"children":["08"]},"結婚の健康上の利益も計算に入れる。ただし観察データとして割り引いて考える"]},{"tag":"a","props":{"href":"/ja/tip/10-09"},"children":[{"tag":"span","props":{},"children":["09"]},"時間の計算は「無償労働」として算出し、役割分担を明確にしてから婚姻届を出す"]},{"tag":"a","props":{"href":"/ja/tip/10-10"},"children":[{"tag":"span","props":{},"children":["10"]},"結婚のお金の問題は、まず法律の標準ルールを確認し、書面での合意が必要かを決める"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/ja/tip/10-11","data-status":"active"},"children":[{"tag":"span","props":{},"children":["11"]},"親が住宅購入資金を出す場合、送金時に「借入」か「贈与」かを明確に記載しておく"]},{"tag":"a","props":{"href":"/ja/tip/10-12"},"children":[{"tag":"span","props":{},"children":["12"]},"配偶者が一方的に多額の借金をした場合、あなたが署名せず、かつ追認もしていなければ、自動的にあなたの債務にはなりません"]},{"tag":"a","props":{"href":"/ja/tip/10-13"},"children":[{"tag":"span","props":{},"children":["13"]},"婚姻届出は身分証と署名済みの申告書だけで可能。戸籍簿不要、費用無料、その場で交付"]},{"tag":"a","props":{"href":"/ja/tip/10-14"},"children":[{"tag":"span","props":{},"children":["14"]},"結婚前に一度結婚前検査を受け、重大な疾患がある場合は必ず登録前に相手に真実を伝えなければならない"]},{"tag":"a","props":{"href":"/ja/tip/10-15"},"children":[{"tag":"span","props":{},"children":["15"]},"離脱コストを計算する：協議離婚には 30 日の冷静期があり、裁判離婚には法定条件がある"]},{"tag":"a","props":{"href":"/ja/tip/10-16"},"children":[{"tag":"span","props":{},"children":["16"]},"「親世代のための結婚」には別途勘定を立て、自分の勘定と混ぜないこと"]},{"tag":"a","props":{"href":"/ja/tip/10-17"},"children":[{"tag":"span","props":{},"children":["17"]},"人間関係の良し悪しを健康の計算に入れておく：喧嘩は事柄に対して行い、人格を否定しない。罵倒や皮肉は避けること"]},{"tag":"a","props":{"href":"/ja/tip/10-18"},"children":[{"tag":"span","props":{},"children":["18"]},"同性パートナーは、二人が意識がはっきりしているうちに、委任状、任意後見、および遺言を作成しておくべき：法律上、あなたたちは近親者ではないため、作成しなければ署名権も相続権もありません"]},{"tag":"a","props":{"href":"/ja/tip/10-19"},"children":[{"tag":"span","props":{},"children":["19"]},"性的指向を隠して結婚しないで、偽装結婚を「手間の省ける方法」とも思わないこと：法律上、それは真の婚姻であり、解消したい場合は離婚の手続きを踏むしかない"]},{"tag":"a","props":{"href":"/ja/tip/10-20"},"children":[{"tag":"span","props":{},"children":["20"]},"関係が繰り返される喧嘩や冷戦で停滞しているなら、二人でカップルセラピーを受けるべきです：ただ待っているだけでは、自然に良くなることは基本的にはありません"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"現在地"},"children":[{"tag":"a","props":{"href":"/ja/book"},"children":["本を読む"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/ja/book/10"},"children":["第10章"," ·"," ","恋愛と結婚は損か得か"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"10-11"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["11"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["エビデンス"," ","A"]}]},{"tag":"h1","props":{"lang":"ja"},"children":["親が住宅購入資金を出す場合、送金時に「借入」か「贈与」かを明確に記載しておく"]},{"tag":"p","props":{"lang":"ja","className":"life-entry-summary"},"children":["婚姻前に親が住宅購入資金を出した場合、デフォルトではその子の個人財産とみなされます。婚姻後に出した資金について合意がない場合は、夫婦の共有財産として扱われます。2025 年 2 月以降、婚姻後に一方の親が全額を出資し、かつその子が受け取るものと明記されていない場合、離婚時に裁判所は、出資した側の子供に物件を割り当て、その上で相手方への補償の有無を決定することがあります。借入として扱う場合は、その当日に内容を明確にし、双方の署名を得ておく必要があります。"]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["費用・手間"]},{"tag":"p","props":{},"children":["費用はかかりません。出資当日に説明書を1枚作成し、その資金が誰への贈与か、あるいは誰への貸付かを明記し、出資する親と…"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["効果"]},{"tag":"p","props":{},"children":["婚姻前に親が夫婦の住宅購入のために出資した場合、その子の個人への贈与とみなされます。"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"記録する：親が住宅購入資金を出す場合、送金時に「借入」か「贈与」かを明確に記載しておく"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"できている"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"やることに追加"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"お気に入り"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"このヒントを共有"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"詳細を閉じる"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["費用・手間"]},{"tag":"p","props":{},"children":["費用はかかりません。出資当日に説明書を1枚作成し、その資金が誰への贈与か、あるいは誰への貸付かを明記し、出資する親と子の双方が署名します。もし貸付とする場合は、夫婦の双方に署名させ、振込の摘要欄にも同じ文言を記載してください。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["効果"]},{"tag":"p","props":{},"children":["婚姻前に親が夫婦の住宅購入のために出資した場合、その子の個人への贈与とみなされます。ただし、親が夫婦双方への贈与であることを明示している場合は除きます。婚姻後の出資については、合意があればその合意に従います。合意がない、あるいは合意が不明確な場合は、夫婦共有財産の原則に従って処理されます.2025 年 2 月 1 日以降には、もう一つのルールがあります。婚姻中に一方の親が全額を出資し、かつ贈与契約においてその子のための贈与である旨が明記されていない場合、離婚時の分割において、裁判所は物件を出資者の子に帰属させることができます。帰属の決定後、いくつかの状況を総合的に判断して、相手方への補償の要否およびその額を決定します。判断材料となるのは、共同生活および共同の子の養育状況、離婚に至った過失、家庭への貢献度、離婚時の物件の市場価格です。一方の親のみが出資した場合、または双方の親が出資した場合は、出資の出所と割合に基づき、一方の側に帰属させ、合理的な補償を行います（全国）"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["出典"]},{"tag":"p","props":{"className":"life-citations"},"children":["最高人民法院 (2020). 关于适用《民法典》婚姻家庭编的解释（一）（法释〔2020〕22 号，第二十九条）. ",{"tag":"a","props":{"href":"https://www.court.gov.cn/fabu/xiangqing/282071.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.court.gov.cn/fabu/xiangqing/282071.html"]},"；最高人民法院 (2025). 关于适用《民法典》婚姻家庭编的解释（二）（法释〔2025〕1 号，第八条）. ",{"tag":"a","props":{"href":"https://www.court.gov.cn/zixun/xiangqing/452771.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.court.gov.cn/zixun/xiangqing/452771.html"]},"；全国人大 (2020). 民法典（第一千零六十二条第一款第四项）. ",{"tag":"a","props":{"href":"https://www.spp.gov.cn/spp/fl/202006/t20200602_463888.shtml","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.spp.gov.cn/spp/fl/202006/t20200602_463888.shtml"]}]},{"tag":"a","props":{"href":"https://www.court.gov.cn/fabu/xiangqing/282071.html","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["出典を開く"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["著者の注記"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["明確に記載しておくことは双方にとって有益です。出資する親は、離婚時に借用書を後から作って出資分を守ろうと期待してはいけません。解釈（二）の施行後は、資金が誰から出されたか自体が物件分割の根拠となり、不動産登記簿の氏名は帰属を決定するものではなくなりました。出資を受ける側も、離婚時までその資金がどのような性質を持つかを知らないままではいられません。貸付として扱うなら、真に貸付として扱う必要があります。双方が貸付であると合意し、返済方法を定め、振込時に明記し、必要に応じて返済記録を残してください。どれか一つでも欠けると、裁判になった際に説明を求められることになります。"]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["自分のメモ"]},{"tag":"button","props":{"type":"button"},"children":["自分へのメモを書く…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/ja/tip/10-10"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["前へ"]},"結婚のお金の問題は、まず法律の標準ルールを確認し、書面での合意が必要かを決める"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/ja/tip/10-12"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["次へ"]},"配偶者が一方的に多額の借金をした場合、あなたが署名せず、かつ追認もしていなければ、自動的にあなたの債務にはなりません"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["このテーマの他の提案"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/10-07"},"children":[{"tag":"strong","props":{},"children":["まずは登録データを確認してから年長者の話を聞