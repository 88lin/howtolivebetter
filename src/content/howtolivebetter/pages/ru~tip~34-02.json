 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-up-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M7 7h10v10"},"children":[]},{"tag":"path","props":{"d":"M7 17 17 7"},"children":[]}]}]}]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/ru/book/34"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"К содержанию"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["Домашние лекарства: как не навредить себе"]},{"tag":"div","props":{"data-ad-dock-host":"true"},"children":[]},{"tag":"nav","props":{"aria-label":"Советы главы"},"children":[{"tag":"a","props":{"href":"/ru/tip/34-01"},"children":[{"tag":"span","props":{},"children":["01"]},"Перед тем, как принимать два противопростудных или обезболивающих препарата одновременно, обязательно проверьте их состав: парацетамол должен входить только в один из них"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/ru/tip/34-02","data-status":"active"},"children":[{"tag":"span","props":{},"children":["02"]},"Для детей при лихорадке не следует использовать аспирин, нимесулид и анальгин; противопростудные препараты, содержащие анальгин, также запрещены для несовершеннолетних"]},{"tag":"a","props":{"href":"/ru/tip/34-03"},"children":[{"tag":"span","props":{},"children":["03"]},"Людям старше 60 лет, у кого ранее были кровотечения в желудке и которые принимают антикоагулянты или гормоны, перед приёмом обезболивающих вроде ибупрофена следует проконсультироваться с врачом"]},{"tag":"a","props":{"href":"/ru/tip/34-04"},"children":[{"tag":"span","props":{},"children":["04"]},"Не давайте детям младше 2 лет комплексные противопростудные и отхаркивающие препараты без назначения врача"]},{"tag":"a","props":{"href":"/ru/tip/34-05"},"children":[{"tag":"span","props":{},"children":["05"]},"Беременность после 20-й недели: не принимайте ибупрофен и подобные обезболивающие самостоятельно"]},{"tag":"a","props":{"href":"/ru/tip/34-06"},"children":[{"tag":"span","props":{},"children":["06"]},"Самостоятельный прием омепразола при изжоге и отрыжке — не более 7 дней; при затрудненном глотании, рвоте с кровью или черном стуле — сразу к врачу"]},{"tag":"a","props":{"href":"/ru/tip/34-07"},"children":[{"tag":"span","props":{},"children":["07"]},"При обычной простуде не стоит требовать от врача антибиотики"]},{"tag":"a","props":{"href":"/ru/tip/34-08"},"children":[{"tag":"span","props":{},"children":["08"]},"При диарее в первую очередь пейте раствор для пероральной регидратации; детям до 5 лет не давайте противодиарейные препараты"]},{"tag":"a","props":{"href":"/ru/tip/34-09"},"children":[{"tag":"span","props":{},"children":["09"]},"Не стоит принимать обезболивающие более 15 дней в месяц, а комбинированные препараты — более 10 дней; иначе головная боль может возникнуть именно из-за чрезмерного употребления лекарств"]},{"tag":"a","props":{"href":"/ru/tip/34-10"},"children":[{"tag":"span","props":{},"children":["10"]},"Регулярно убирайте просроченные и неиспользуемые лекарства; выбрасывайте их с упаковкой в контейнер для опасных отходов, а не дома «как попало»"]},{"tag":"a","props":{"href":"/ru/tip/34-11"},"children":[{"tag":"span","props":{},"children":["11"]},"На время приёма цефалоспоринов, метronidazola и похожих антибактериальных препаратов и ещё 7 дней после отмены не употребляйте алкоголь — в том числе этанол в пероральном растворе Huoxiang Zhengqi (藿香正气口服液) и в сиропах от кашля"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"Навигация"},"children":[{"tag":"a","props":{"href":"/ru/book"},"children":["Книга"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/ru/book/34"},"children":["Глава 34"," ·"," ","Домашние лекарства: как не навредить себе"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"34-02"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["02"]},{"tag":"span","props":{"className":"life-evidence grade-b"},"children":["Доказательства"," ","B"]}]},{"tag":"h1","props":{"lang":"ru"},"children":["Для детей при лихорадке не следует использовать аспирин, нимесулид и анальгин; противопростудные препараты, содержащие анальгин, также запрещены для несовершеннолетних"]},{"tag":"p","props":{"lang":"ru","className":"life-entry-summary"},"children":["При лихорадке у детей не рекомендуется применять ни аспирин, ни нимесулид, ни анальгин. Аспирин связывают с синдромом Рейе — тяжелым заболеванием, поражающим мозг и печень; по статистике США, около 30% детей с этим диагнозом умирали. После появления предупреждений число таких случаев снизилось более чем на 90%. Нимесулид запрещен к применению у детей младше 12 лет, а анальгин — у детей младше 18 лет."]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Затраты"]},{"tag":"p","props":{},"children":["Бесплатно. При покупке жаропонижающих средств достаточно л…"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Польза"]},{"tag":"p","props":{},"children":["Синдром Рейе вызывает поражение мозга и жировую дегенерацию печени;"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"Отметить: Для детей при лихорадке не следует использовать аспирин, нимесулид и анальгин; противопростудные препараты, содержащие анальгин, также запрещены для несовершеннолетних"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"Сделано"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"В планах"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"В избранное"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Поделиться советом"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Скрыть подробности"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Затраты"]},{"tag":"p","props":{},"children":["Бесплатно. При покупке жаропонижающих средств достаточно лишь посмотреть их общее название и состав."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Польза"]},{"tag":"p","props":{},"children":["Синдром Рейе вызывает поражение мозга и жировую дегенерацию печени; обычно он развивается после гриппа или ветряной оспы. В период с 1981 по 1997 год в США в рамках национального мониторинга было зарегистрировано 1207 случаев у лиц младше 18 лет. У 82% этих детей в крови обнаруживалась салициловая кислота — компонент препаратов типа аспирина. Общая смертность от этого заболевания составляет 31%. Предупреждения об опасности препаратов на основе салициловой кислоты начали публиковаться с 1980 года; в том году было зафиксировано 555 случаев — пик заболеваемости, после чего с 1987 года их число не превышало 36 в год. В 2011 году регулирующие органы запретили применение пероральных форм нимесулида у детей младше 12 лет, а в 2020 году — применение таблеток анальгина у детей младше 18 лет. Аналогичный запрет распространяется и на комбинированные препараты, содержащие анальгин: «Фуфанцинганьаньцзыпянь», «Чжунганьлин» и «Чжунганьлин капсулы»."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Первоисточники"]},{"tag":"p","props":{"className":"life-citations"},"children":["Belay ED, Bresee JS, Holman RC, Khan AS, Shahriari A, Schonberger LB (1999). Reye's syndrome in the United States from 1981 through 1997. New England Journal of Medicine, 340(18):1377-1382. ",{"tag":"a","props":{"href":"https://doi.org/10.1056/NEJM199905063401801","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1056/NEJM199905063401801"]},"；关于加强尼美舒利口服制剂使用管理的通知（国食药监安〔2011〕209号）. ",{"tag":"a","props":{"href":"https://www.nmpa.gov.cn/xxgk/fgwj/gzwj/gzwjyp/20110515145101552.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.nmpa.gov.cn/xxgk/fgwj/gzwj/gzwjyp/20110515145101552.html"]},"；国家药监局关于修订安乃近相关品种说明书的公告（2020年第34号）及附件1至3. ",{"tag":"a","props":{"href":"https://www.nmpa.gov.cn/directory/web/nmpa/xxgk/ggtg/ypggtg/ypshmshxdgg/20200317171201660.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.nmpa.gov.cn/directory/web/nmpa/xxgk/ggtg/ypggtg/ypshmshxdgg/20200317171201660.html"]}]},{"tag":"a","props":{"href":"https://doi.org/10.1056/NEJM199905063401801","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Открыть источник"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Примечание автора"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["Анальгин также не является препаратом первого выбора и для взрослых. В инструкции указано, что он может вызывать агранулоцитоз, апластическую анемию и анафилактический шок, поэтому его назначают лишь в экстренных случаях, когда нет других эффективных средств, и на короткий срок. Препарат «Чжунганьлин» по названию напоминает обычное средство от простуды, однако содержит в себе анальгин. При лихорадке у детей следует проконсультироваться с педиатром или фармацевтом относительно подходящего жаропонижающего и его дозировки в зависимости от веса ребенка. Детям младше 3 месяцев при повышении темперары следует немедленно обратиться в больницу — см. пункт 8 раздела 20: при температуре 38 °C нужно сразу идти к врачу. Уровень доказательности B присвоен, так как данные о синдроме Рейе взяты из отчетов мониторинга, а снижение числа случаев после публикации предупреждений носит временный характер, а не подтверждено контролируемыми исследованиями. Эффект от применения данных мер считается значительным, поскольку после предупреждений количество случаев снизилось с 555 в год до менее чем 36."]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Моя заметка"]},{"tag":"button","props":{"type":"button"},"children":["Запишите напоминание…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/ru/tip/34-01"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Предыдущий"]},"Перед тем, как принимать два противопростудных или обезболивающих препарата одновременно, обязательно проверьте их состав: парацетамол должен входить только в один из них"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/ru/tip/34-03"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Следующий"]},"Людям старше 60 лет, у кого ранее были кровотечения в желудке и которые принимают антикоагулянты или гормоны, перед приёмом обезболивающих вроде ибупрофена следует проконсультироваться с врачом"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"pat