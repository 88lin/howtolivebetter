4","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"分享这条建议"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"收起详情"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["成本"]},{"tag":"p","props":{},"children":["不花钱。不买币，不进「带单」「稳赚」的币圈群。代价是币价上涨的时候赚不到。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["收益"]},{"tag":"p","props":{},"children":["2026 年 2 月，人民银行等八个部门发了银发〔2026〕42 号通知。通知写明，比特币、以太币、泰达币这类虚拟货币「不具有法偿性，不应且不能作为货币在市场上流通使用」。人民币换币、币换币、发币融资，都属于非法金融活动，「一律严格禁止」。境外机构也不许给境内的人提供这类服务。个人投资这一头，通知原话是：「任何单位和个人投资虚拟货币、现实世界资产代币及相关金融产品，违背公序良俗的，相关民事法律行为无效，由此引发的损失由其自行承担」。2021 年的银发〔2021〕237 号通知同时废止，这句话在新通知里保留了。法院案例：汤某 2018 年 2 月到 2019 年 7 月，向两个自称平台商户的人买泰达币，付了约 44.8 万元（精确值 448000 元）。后来平台提不了现，也登不上。他起诉要回这笔钱。法院认为用人民币换虚拟货币，这个投资行为无效，损失由他自己承担，驳回了起诉，二审维持（江苏宜兴，2025 年 3 月发布）。被偷是另一回事：有人账户里价值 400 余万元的虚拟币被「黑客」盗走，其中一名盗窃者被以盗窃罪判 7 年，罚 2 万元（河南郑州）"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["原始出处"]},{"tag":"p","props":{"className":"life-citations"},"children":["中国人民银行、国家发展改革委、工业和信息化部、公安部、市场监管总局、金融监管总局、中国证监会、国家外汇局 (2026). 关于进一步防范和处置虚拟货币等相关风险的通知（银发〔2026〕42 号，第一、十九条）. ",{"tag":"a","props":{"href":"https://www.csrc.gov.cn/csrc/c100028/c7614318/content.shtml","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.csrc.gov.cn/csrc/c100028/c7614318/content.shtml"]},"（中国证监会发布）；宜兴市人民法院 (2025). 投资虚拟货币受损 风险责任自行承担. ",{"tag":"a","props":{"href":"https://yx.wxfy.gov.cn/article/detail/2025/09/id/8970543.shtml","target":"_blank","rel":"noopener noreferrer"},"children":["https://yx.wxfy.gov.cn/article/detail/2025/09/id/8970543.shtml"]},"；【新时代检察好故事】偷了虚拟币 被判盗窃罪 (2024). ",{"tag":"a","props":{"href":"https://www.yw.gov.cn/art/2024/2/2/art_1229143073_59471301.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.yw.gov.cn/art/2024/2/2/art_1229143073_59471301.html"]},"（义乌市人民政府网转载）；人民法院报 (2024). 非法窃取虚拟货币行为的刑法定性. ",{"tag":"a","props":{"href":"http://www.sdcourt.gov.cn/jningzcfy/386500/386502/31441533/index.html","target":"_blank","rel":"noopener noreferrer"},"children":["http://www.sdcourt.gov.cn/jningzcfy/386500/386502/31441533/index.html"]},"（邹城市人民法院网转载）；Federal Bureau of Investigation (2022). Scammers Target and Exploit Owners of Cryptocurrencies in Liquidity Mining Scam (Alert Number I-072122-PSA). ",{"tag":"a","props":{"href":"https://www.ic3.gov/PSA/2022/PSA220721","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.ic3.gov/PSA/2022/PSA220721"]}]},{"tag":"a","props":{"href":"https://www.csrc.gov.cn/csrc/c100028/c7614318/content.shtml","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["打开来源链接"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["原书备注"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["「损失自己承担」管的是你和卖币、带单的人之间的钱款纠纷，法院不帮你把投资款要回来，所以别指望事后起诉。被人偷走、骗走属于刑事案子，照样报警。已经有币的人还要防扫码盗币。江苏涟水有人和对方见面扫了一个码，钱包里约 5.7 万个泰达币被转走。这些币价值约 39.4 万元（精确值 393665.461434 元），人民法院报刊文认为应按盗窃罪处理。美国联邦调查局 2022 年警示过一种类似手法：钱包里弹出一串权限，你点了同意，对方就能不限数额地转走你的币。它给的防法是：拿不准的网站不连钱包，定期用第三方的授权查询工具，看看钱包给过哪些网站转币权限。用自己的银行卡替别人收钱、买币、转币，是另一件事，可能被判刑，见第 9 节第 5 条（「兼职」要你用自己的卡收钱）。承诺高回报的「理财」怎么认，见第 6 条（看到「高收益」「保本」「稳赚」直接走开）。想买海外资产的合法渠道，见第 38 条（买美股走 QDII 基金或港股通）。不构成投资建议。"]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["我的备注"]},{"tag":"button","props":{"type":"button"},"children":["写下对自己有用的提醒…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/tip/05-44"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidd