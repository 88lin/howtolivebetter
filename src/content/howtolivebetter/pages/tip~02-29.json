keLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["成本"]},{"tag":"p","props":{"className":"life-citations"},"children":["农村家庭要换灶具，加上燃料费，一年几百到上千元。换一次就完事，不长期占时间。城里人基本已经是电或燃气了。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["收益"]},{"tag":"p","props":{"className":"life-citations"},"children":["中国有一项慢性病往后跟踪的研究，只记录、不分组，27.1 万名没有心血管病的成人。做饭用煤柴这类固体燃料的人，死亡风险比用电或燃气的人高约 11%（HR 1.11）。取暖用固体燃料的人高约 14%（HR 1.14）。已经从固体燃料换成清洁燃料的人，和还在烧的人比，做饭这项低约 13%（HR 0.87）。取暖这项低约 33%（HR 0.67）。室外的 PM2.5 另有一笔账。把 104 项跟踪研究合起来算，长期吸到的浓度每高 10 µg/m³，自然原因死亡风险高约 8%（RR 1.08）。自然原因就是非意外的病死。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["来源"]},{"tag":"p","props":{"className":"life-citations"},"children":["Yu K 等 (2018). Association of Solid Fuel Use With Risk of Cardiovascular and All-Cause Mortality in Rural China. JAMA. ",{"tag":"a","props":{"href":"https://doi.org/10.1001/jama.2018.2151","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1001/jama.2018.2151"]},"；Chen J, Hoek G (2020). Long-term exposure to PM and all-cause and cause-specific mortality: A systematic review and meta-analysis. Environment International. ",{"tag":"a","props":{"href":"https://doi.org/10.1016/j.envint.2020.105974","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1016/j.envint.2020.105974"]},""]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["原书备注"]},{"tag":"p","props":{"className":"life-citations"},"children":["这类研究只是跟踪记录。换了燃料的家庭往往也更富裕，「风险降到 0.67 倍」这个数里混着家境的影响。至于室外的 PM2.5，个人能做的有限，无非是搬家、戴口罩、用净化器。空气净化器没有以死亡率为终点的研究，所以本节不给数字。"]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["我的备注"]},{"tag":"button","props":{"type":"button"},"children":["写下对自己有用的提醒…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/tip/02-28"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["上一条"]},"少吃超加工食品（薯片、方便面、糕点、速食）"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/tip/02-30"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["下一条"]},"热的东西放一放再喝，不喝滚烫的茶、汤和咖啡"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["本主题的其他建议"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/02-25"},"children":[{"tag":"strong","props":{},"children":["每周喝三次以上茶"]},{"tag":"span","props":{},"children":["有喝茶习惯的人，同期死亡的概率低约 15%。从 50 岁算起，平均多活 1.26 年，多出 1.41 年不得心血管病的时间。"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/02-26"},"children":[{"tag":"strong","props":{},"children":["每天喝三到四杯咖啡，咖啡因总量不超过 400 mg，不加糖不加奶盖"]},{"tag":"span","props":{},"children":["每天喝三到四杯咖啡的人，同期死亡的概率比不喝的人低约 17%。另一项研究里，咖啡集中在上午喝的人低约 12%，全天都喝的人看不出差别。一杯咖啡的咖啡因含量差得很…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/02-27"},"children":[{"tag":"strong","props":{},"children":["每天吃够 5 份（约 400 g）水果蔬菜"]},{"tag":"span","props":{},"children":["每天多吃 200 g 蔬菜水果，同期死亡的概率低约一成。每天吃够 5 份的人，比只吃 2 份的人低约 13%。再往上吃，不会更低。"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/02-31"},"children":[{"tag":"strong","props":{},"children":["白天出门晒晒太阳，别整天不见光"]},{"tag":"span","props":{},"children":["刻意躲太阳的女性，预期寿命比晒得最多的人少 0.6 到 2.1 年。不吸烟但躲太阳的人，寿命和晒得最多的吸烟者差不多。"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/02-32"},"children":[{"tag":"strong","props":{},"children":["把 BMI 控制在 20–25，超重就减"]},{"tag":"span","props":{},"children":["死亡的概率在 BMI 20–25 这一段最低。BMI 到 27.5–30 高约两成，30–35 高约四成半，35–40 接近翻倍。东亚人对超重更敏感，BMI 每…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/02-33"},"children":[{"tag":"strong","props":{},"children":["每周吃四次以上辣椒"]},{"tag":"span","props":{},"children":["每周吃四次以上辣椒的人，同期死亡的概率比很少吃的人低约 23%，心血管死亡低约三分之一。"]}]}]}]},{"tag":"a","props":{"className":"life-text-link","href":"/book/02"},"children":["阅读整个主题：不要慢慢死 ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"15","height":"15","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]}]}]},{"tag":"nav","props":{"className":"life-tabbar","aria-label":"主导航"},"children":[{"tag":"a","props":{"className":"","href":"/book"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"21","height":"21","viewBox":"0 0