{"path":"/en/tip/03-25","title":"Use painkillers such as ibuprofen for period pain instead of just enduring it; if pain disrupts work or school or remains uncontrolled after three months of medication, see a gynecologist | HowToLiveBetter","description":"For period pain, drugs such as ibuprofen increase the proportion with substantial pain relief from less than one fifth to about half. They work bette…","lang":"en","styles":["/sites/howtolivebetter/styles/bca54bebe9c1bd3b.css"],"bodyClass":"font-sans antialiased","nodes":[{"tag":"div","props":{"className":"life-site"},"children":[{"tag":"div","props":{"className":"life-header-slot","aria-hidden":"true"},"children":[]},{"tag":"header","props":{"className":"life-header"},"children":[{"tag":"div","props":{"className":"life-header-inner"},"children":[{"tag":"a","props":{"className":"life-brand","aria-label":"H ✳ HowToLiveBetter home","href":"/en"},"children":[{"tag":"span","props":{"className":"life-brand-mark","aria-hidden":"true"},"children":["H",{"tag":"span","props":{},"children":["✳"]}]},{"tag":"span","props":{},"children":["HowToLive",{"tag":"span","props":{},"children":["Better"]}]}]},{"tag":"nav","props":{"className":"life-nav","aria-label":"Main navigation"},"children":[{"tag":"a","props":{"className":"life-nav-link","href":"/en/book"},"children":[{"tag":"span","props":{},"children":["Explore the book"]}]},{"tag":"a","props":{"className":"life-nav-link","href":"/en/top-50"},"children":[{"tag":"span","props":{},"children":["Top 50"]}]},{"tag":"a","props":{"className":"life-nav-link","href":"/en/daily"},"children":[{"tag":"span","props":{},"children":["Daily task"]}]},{"tag":"a","props":{"className":"life-nav-link","href":"/en/dashboard"},"children":[{"tag":"span","props":{},"children":["My checklist"]}]},{"tag":"button","props":{"type":"button","className":"life-nav-link life-nav-more","aria-haspopup":"menu","aria-expanded":"false"},"children":[{"tag":"span","props":{},"children":["More"]},{"tag":"svg","props":{