9"},"children":[]}]},"分享这条建议"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"收起详情"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["成本"]},{"tag":"p","props":{"className":"life-citations"},"children":["不花钱，花的是一次认真的谈话。难在要把生孩子和工作、买房这些安排放在一起排，不能只是往后推"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["收益"]},{"tag":"p","props":{"className":"life-citations"},"children":["自然怀孕看美国一项跟踪研究，找的是 30 到 44 岁、没有不孕病史、刚开始备孕的女性。和 30、31 岁相比，40、41 岁每个月怀上的几率低约 53%（比值 0.47，95% CI 0.28–0.78），42 到 44 岁低约 59%（0.39，0.16–0.93）。38、39 岁低约 30%（0.70，0.48–1.01），可信范围刚好碰到「没差别」。32、33 岁和 30、31 岁没有差别。从没怀过孕的女性，每个年龄怀上的几率都更低。丹麦一项同类研究里，35 到 40 岁女性的几率是 20 到 24 岁的 0.77。男方年龄的影响小得多，35 到 39 岁男性是 0.95。流产看挪威 2009 到 2013 年约 42 万次怀孕的登记数据：流产比例 25 到 29 岁最低，为 9.8%。30 到 34 岁 10.8%，35 到 39 岁 16.7%，40 到 44 岁 32.2%，45 岁以上 53.6%。胚胎的染色体看美国一家生殖中心对 15169 个试管胚胎做的检测。染色体异常从 26 岁以后随年龄稳定上升。26 到 37 岁做试管的人里，培养出的胚胎全都染色体异常的占 2% 到 6%，42 岁是 33%，44 岁是 53%。试管婴儿的成功率看英国生殖管理机构 2022 年的初步统计。用自己卵子、新鲜胚胎移植的，每移植一个胚胎生下孩子的比例：18 到 34 岁 35%，35 到 37 岁 26%，38、39 岁 18%，40 到 42 岁 10%，43、44 岁 5%。国内的规矩：卫生部 2003 年的《人类辅助生殖技术规范》写明「禁止给不符合国家人口和计划生育法规和条例规定的夫妇和单身妇女实施人类辅助生殖技术」。国务院办公厅 2024 年要求各地把适宜的辅助生殖技术项目纳入医保报销范围。国家医保局 2025 年 7 月说，全国 31 个省份和新疆兵团已经全面把辅助生殖技术纳入报销，2024 年有超过 100 万人次享受了待遇"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["来源"]},{"tag":"p","props":{"className":"life-citations"},"children":["Steiner AZ, Jukic AM (2016). Impact of female age and nulligravidity on fecundity in an older reproductive age cohort. Fertility and Sterility 105(6):1584-1588. ",{"tag":"a","props":{"href":"https://doi.org/10.1016/j.fertnstert.2016.02.028","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1016/j.fertnstert.2016.02.028"]},"；Rothman KJ 等 (2013). Volitional determinants and age-related decline in fecundability: a general population prospective cohort study in Denmark. Fertility and Sterility 99(7):1958-1964. ",{"tag":"a","props":{"href":"https://doi.org/10.1016/j.fertnstert.2013.02.040","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1016/j.fertnstert.2013.02.040"]},"；Magnus MC 等 (2019). Role of maternal age and pregnancy history in risk of miscarriage: prospective register based study. BMJ 364:l869（表 1）. ",{"tag":"a","props":{"href":"https://doi.org/10.1136/bmj.l869","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1136/bmj.l869"]},"；Franasiak JM 等 (2014). The nature of aneuploidy with increasing age of the female partner: a review of 15,169 consecutive trophectoderm biopsies evaluated with comprehensive chromosomal screening. Fertility and Sterility 101(3):656-663. ",{"tag":"a","props":{"href":"https://doi.org/10.1016/j.fertnstert.2013.11.004","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1016/j.fertnstert.2013.11.004"]},"；Human Fertilisation and Embryology Authority (2024). Fertility treatment 2022: preliminary trends and figures. ",{"tag":"a","props":{"href":"https://www.hfea.gov.uk/about-us/publications/research-and-data/fertility-treatment-2022-preliminary-trends-and-figures/","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.hfea.gov.uk/about-us/publications/research-and-data/fertility-treatment-2022-preliminary-trends-and-figures/"]},"；卫生部 (2003). 人类辅助生殖技术规范（卫科教发〔2003〕176号附件，三、实施技术人员的行为准则第十三项）. ",{"tag":"a","props":{"href":"https://www.nhc.gov.cn/wjw/gfxwj/200309/8da11b0f3edb49cbbe5dea1dc18794a9/files/1733388793099_97897.doc","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.nhc.gov.cn/wjw/gfxwj/200309/8da11b0f3edb49cbbe5dea1dc18794a9/files/1733388793099_97897.doc"]},"；国务院办公厅 (2024). 关于加快完善生育支持政策体系推动建设生育友好型社会的若干措施（国办发〔2024〕48号）. ",{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/202410/content_6983486.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/zhengce/zhengceku/202410/content_6983486.htm"]},"；国务院新闻办公室 (2025). 国务院新闻办就育儿补贴制度及生育支持措施有关情况举行发布会（国家医保局待遇保障司负责人答问）. ",{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/202507/content_7034595.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/zhengce/202507/content_7034595.htm"]},""]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["原书备注"]},{"tag":"p","props":{"className":"life-citations"},"children":["不主张谁该早生或晚生，只把年龄这一项摆出来，和第 5 条的钱账、第 4 条的时间账放在一起看。这些都是一大群人的平均数，落到具体一个人身上差别很大，想知道自己的情况去医院生殖科问。单身女性在国内正规医院做不了辅助生殖技术。试管婴儿医保报哪些项目、报多少，各省不一样，去当地医保局问。决定要孩子之后该做什么，从第 27 节第 1 条（补叶酸）开始看"]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["我的备注"]},{"tag":"button","props":{"type":"button"},"children":["写下对自己有用的提醒…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/tip/18-06"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["上一条"]},"为长辈生、为婚姻生、为养老生，各记一笔账"]}]},{"tag":"span","props":{},"children":[]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["本主题的其他建议"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/18-03"},"children":[{"tag":"strong","props":{},"children":["知道这条：不得因怀孕、生育、哺乳降工资或者辞退"]},{"tag":"span","props":{},"children":["单位因为你怀孕、生孩子、喂奶，给你降工资或者把你辞了，都是违法的。孩子不满一周岁的，你每天有 1 小时喂奶时间，单位也不能安排你加班和上夜班，违反的按每人 10…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/18-04"},"children":[{"tag":"strong","props":{},"children":["养孩子的时间账按「谁的时间被占掉」算，不按「辛不辛苦」算"]},{"tag":"span","props":{},"children":["把每天看孩子的小时数、夜里被吵醒的次数，都折算成时间。再乘上干这些活的那个人的时薪。算出来的数，一般远远大于奶粉尿布钱。所以分工最好在生之前就谈好。"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/18-05"},"children":[{"tag":"strong","props":{},"children":["钱账分三段算：0 到 3 岁、义务教育、义务教育之后"]},{"tag":"span","props":{},"children":["0 到 3 岁的钱，主要花在怎么带上：自己带、老人带，还是请人带。小学到初中这段，主要花在住房和课外。再往后，主要花在升学这条路上。三段的花法完全不同，混在一起…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/18-06"},"children":[{"tag":"strong","props":{},"children":["为长辈生、为婚姻生、为养老生，各记一笔账"]},{"tag":"span","props":{},"children":["别人希望你生，这可以算你的一个考虑因素。但时间和钱是记在你自己账上的。「养儿防老」要单独算一笔，因为它赌的是二十年后另一个人的经济能力和意愿。把不生的后果也写下…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/18-02"},"children":[{"tag":"strong","props":{},"children":["产假 98 天，生育津贴由生育保险基金按单位上年度职工月平均工资发；男方的陪产假和夫妻俩的育儿假按本省条例休"]},{"tag":"span","props":{},"children":["生孩子至少有 98 天产假，难产、多胞胎再加，期间由生育保险基金发生育津贴。单位没给你上生育保险的，由单位自己发。男方的陪产假和夫妻俩的育儿假看本省条例。北京是…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/18-01"},"children":[{"tag":"strong","props":{},"children":["先把能领的算进来：国家育儿补贴每孩每年 3600 元，发到 3 岁；个税专项附加扣除每孩每月 2000 元"]},{"tag":"span","props":{},"children":["不满 3 岁的孩子每年能领 3600 元育儿补贴，不用交税。2025 年以前出生的按剩下的月数折算。另外从孩子出生到全日制上学结束，每个孩子每月能从父母的应税收…"]}]}]}]},{"tag":"a","props":{"className":"life-text-link","href":"/book/18"},"children":["阅读整个主题：养孩子划不划算 ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"15","height":"15","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]}]}]},{"tag":"nav","props":{"className":"life-tabbar","aria-label":"主导航"},"children":[{"tag":"a","props":{"className":"","href":"/book"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"21","height":"21","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-book-open","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M12 7v14"},"children":[]},{"tag":"path","props":{"d":"M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z"},"children":[]}]},{"tag":"span","props":{},"children":["全书"]}]},{"tag":"a","props":{"className":"","href":"/top-50"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"21","height":"21","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-star","aria-hidden":"true"},"children":[{"tag":"path","props":{"d"