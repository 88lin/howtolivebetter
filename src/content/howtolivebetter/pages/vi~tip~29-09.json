iv","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Lợi ích"]},{"tag":"p","props":{},"children":["61 nghiên cứu đối chứng gộp lại. Can thiệp tâm lý dành cho mọi người mất người thân thì lợi ích rất nhỏ ngay khi kết thúc điều trị, đợi thêm một thời gian thì không còn thấy lợi ích. Chỉ nhận người mất người thân «đã rõ ràng không hợp thích nổi» thì can thiệp có hiệu quả tốt ngang tâm lý trị liệu cho các vấn đề tâm lý khác. Nghiên cứu không sàng lọc trước cho kết quả kém, vì nhóm không được can thiệp vốn cũng dần tự khỏi theo thời gian. Ngoài ra có 14 thử nghiệm chia nhóm ngẫu nhiên gộp lại: điều trị cho người đã có vấn đề thì rõ ràng tốt hơn nhóm đối chứng ngay sau điều trị và cả ở lần theo dõi sau đó, để thêm thời gian thì hiệu quả còn tăng. Can thiệp phòng ngừa làm đại trà cho người chưa có vấn đề thì không có tác dụng. Một nghiên cứu khác theo dõi 205 người từ trước khi mất bạn đời cho tới 6 và 18 tháng sau. Nghiên cứu này chia ra năm đường đi. Lần lượt là đau buồn thường, đau buồn kéo dài, trầm cảm kéo dài, ngược lại là khỏe lên trong thời gian mất người thân, và sức bền (chịu được). Trong đó nhóm sức bền phổ biến nhất, nhóm đau buồn thường tương đối ít"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Nguồn gốc"]},{"tag":"p","props":{"className":"life-citations"},"children":["Currier JM, et al. (2008). The effectiveness of psychotherapeutic interventions for bereaved persons: a comprehensive quantitative review. Psychological Bulletin. ",{"tag":"a","props":{"href":"https://doi.org/10.1037/0033-2909.134.5.648","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1037/0033-2909.134.5.648"]},"；Wittouck C, et al. (2011). The prevention and treatment of complicated grief: a meta-analysis. Clinical Psychology Review. ",{"tag":"a","props":{"href":"https://doi.org/10.1016/j.cpr.2010.09.005","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1016/j.cpr.2010.09.005"]},"；Bonanno GA, et al. (2002). Resilience to loss and chronic grief: a prospective study from preloss to 18-months postloss. Journal of Personality and Social Psychology. ",{"tag":"a","props":{"href":"https://doi.org/10.1037/0022-3514.83.5.1150","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1037/0022-3514.83.5.1150"]},"；Stroebe M 等 (2007). Health outcomes of bereavement. Lancet. ",{"tag":"a","props":{"href":"https://doi.org/10.1016/S0140-6736(07)61816-9","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1016/S0140-6736(07)61816-9"]},"（备注里那份综述）"]},{"tag":"a","props":{"href":"https://doi.org/10.1037/0033-2909.134.5.648","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Liên kết mở nguồn"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Ghi chú sách"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["Ý là «không phải ai cũng cần», không phải «ai cũng đừng làm». Nhóm mất người thân nguy cơ cao như mục 4 (người thân chết vì tự tử, tai nạn hoặc bị giết) và nhóm đã bị kẹt như mục 8 (đau buồn bị kẹt thì đi khoa tâm thần), chính là nhóm có bằng chứng ủng hộ việc nên làm. Kết luận của một bài tổng quan trên Lancet cũng vậy: đau buồn không phải bệnh, phần lớn không cần can thiệp chuyên môn. Sức lực nên dồn vào nhóm nguy cơ cao. Cũng nên dồn vào người đã có đau buồn phức tạp, trầm cảm và rối loạn sau chấn thương tâm lý sau khi mất người thân"]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Ghi chú của tôi"]},{"tag":"button","props":{"type":"button"},"children":["Viết một lời nhắc cho chính bạn…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/vi/tip/29-08"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Trước"]},"Nỗi buồn kéo dài quá nửa năm vẫn đứng yên, ngày nào cũng không nổi, thì đi đăng ký khoa tâm thần hoặc tâm lý lâm sàng"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/vi/tip/29-10"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Tiếp theo"]},"Sau khi sống xa nhau hoặc ly hôn, đừng để bảo hiểm y tế bị gián đoạn, đừng dựa vào rượu để chịu đựng"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["Thêm trong chủ đề này"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/29-05"},"children":[{"tag":"strong","props":{},"children":["Trong nửa năm đầu sau khi mất bạn đời, giao việc canh bữa cơm, việc ngủ, thuốc bệnh mạn tính và lịch tái khám cho một người cố định"]},{"tag":"span","props":{},"children":["Trong nửa năm đầu sau khi mất bạn đời, xác suất tử vong cùng kỳ cao h…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/29-06"},"children":[{"tag":"strong","props":{},"children":["Không có người thân cũng không có bạn bè thì thay「người canh giữ bạn」bằng ba thứ: hàng xóm có vào được nhà bạn, danh sách thăm viếng của cộng đồng, và người liên hệ khẩn cấp trong điện thoại"]},{"tag":"span","props":{},"children":["Khi không có người thân cũng không có bạn bè, có hai việc phải lo: có…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/29-07"},"children":[{"tag":"strong","props":{},"children":["Sau khi cha mẹ qua đời, nói thật với con, để con dự lễ tang, đừng đưa con đi nơi khác để «đổi không khí»"]},{"tag":"span","props":{},"children":["Trẻ mất cha hoặc mẹ trước 18 tuổi, khi bước vào đầu tuổi trưởng thành…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/29-11"},"children":[{"tag":"strong","props":{},"children":["Muốn có người để nói chuyện thì gọi 12356, người chưa thành niên và thanh niên gọi 12355, muốn khám bác sĩ thì đăng ký khám tâm lý ngoại trú"]},{"tag":"span","props":{},"children":["Muốn tìm người để nói chuyện thì gọi 12356, đây là đường dây nóng hỗ …"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/29-12"},"children":[{"tag":"strong","props":{},"children":["Trong ba tháng đầu sau biến cố, mọi quyết định lớn không thể đảo ngược đều đẩy lùi"]},{"tag":"span","props":{},"children":["Khoảng thời gian này khả năng phán đoán của bạn với mọi thứ được gọi …"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/29-13"},"children":[{"tag":"strong","props":{},"children":["Đừng dùng cái chết làm cách trả nợ: bảo hiểm nhân thọ trong hai năm đầu không bồi, tai nạn lao động không công nhận, và nợ vẫn bị lấy từ tài sản thừa kế trước"]},{"tag":"span","props":{},"children":["Hợp đồng bảo hiểm nhân thọ không bồi cho trường hợp tự sát trong hai …"]}]}]}]},{"tag":"a","props":{"className":"life-text-link","href":"/vi/book/29"},"children":["Đọc toàn bộ chủ đề: Sau một cú đánh nặng"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"15","height":"15","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]}]}]}]},{"tag":"aside","props":{"className":"life-ad-space life-ad-space-sponsored","data-ad-placement":"ad_footer","data-ad-group":"reading","data-ad-creative":"read_product","data-ad-ready":"false","aria-label":"Quảng cáo · Giới thiệu cộng đồng"},"children":[{"tag":"div","props":{"className":"life-ad-space-brand"},"children":[{"tag":"img","props":{"src":"/sites/howtolivebetter/images/shengcai/logo.png","width":"565","height":"144","alt":"Logo chính thức của Shengcai Youshu","decoding":"async"},"children":[]}]},{"tag":"div","props":{"className":"life-ad-space-copy"},"children":[{"tag":"span","props":{"className":"life-ad-space-label"},"children":["Quảng cáo · Giới thiệu cộng đồng"]},{"tag":"strong","props":{},"children":["Kiến thức bạn có thể thành sản phẩm hữu ích không?"]},{"tag":"p","props":{},"children":["Từ sách điện tử đến công cụ nhỏ: xem cách thành viên tìm nhu cầu và biến kiến thức thành thứ dùng được."]}]},{"tag":"div","props":{"className":"life-ad-space-actions"},"children":[{"tag":"a","props":{"className":"life-ad-space-link","href":"/vi/shengcaiyoushu?sc_group=reading&sc_creat