ed":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"收起详情"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["成本"]},{"tag":"p","props":{"className":"life-citations"},"children":["多数地区对适龄人群免费或者减免。自费也就几百元。要花半天时间。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["收益"]},{"tag":"p","props":{"className":"life-citations"},"children":["隐瞒的法律后果是明确的。新婚姻登记条例规定「一方当事人患有重大疾病的，应当在结婚登记前如实告知另一方当事人；不如实告知的，另一方当事人可以依据民法典第一千零五十三条的规定向人民法院请求撤销婚姻」。国家把婚检当作出生缺陷防治的第一道关口。现行目标是「婚前医学检查率、孕前优生健康检查目标人群覆盖率分别保持在 70% 和 80% 以上」。文件还要求「推进婚前医学检查机构与婚姻登记场所就近设置方便群众」，并推广「婚姻登记、婚前医学检查、生育指导『一站式』服务」。民法典规定，一方患有重大疾病的应当在结婚登记前如实告知，不如实告知的，另一方可以向人民法院请求撤销婚姻。请求撤销婚姻的，应当自知道或者应当知道撤销事由之日起一年内提出"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["来源"]},{"tag":"p","props":{"className":"life-citations"},"children":["全国人大 (2020). 民法典（第一千零五十三条）. ",{"tag":"a","props":{"href":"https://www.spp.gov.cn/spp/fl/202006/t20200602_463888.shtml","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.spp.gov.cn/spp/fl/202006/t20200602_463888.shtml"]},"；国务院 (2025). 婚姻登记条例（国令第 804 号，第十二条）. ",{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/202504/content_7017752.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/zhengce/zhengceku/202504/content_7017752.htm"]},"；国家卫生健康委办公厅 (2023). 出生缺陷防治能力提升计划（2023—2027 年）（国卫办妇幼发〔2023〕9 号）. ",{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/202308/content_6900320.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/zhengce/zhengceku/202308/content_6900320.htm"]},"；国家卫生健康委等五部门 (2020). 关于加强婚前保健工作的通知（国卫妇幼函〔2020〕205 号）：「积极倡导各地结合实际推行免费婚前检查」. ",{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/2020-05/22/content_5513902.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/zhengce/zhengceku/2020-05/22/content_5513902.htm"]},""]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["原书备注"]},{"tag":"p","props":{"className":"life-citations"},"children":["婚检自 2003 年起就不是领证必须先做的一步，去不去自愿。但「有重大疾病不如实说」这一条，确实给了对方去法院撤销这段婚姻的权利，要在知道之日起一年内提。全国没有统一规定婚检免费。国家卫健委等五部门 2020 年的通知只写了「积极倡导各地结合实际推行免费婚前检查」。所以是否免费、查哪些项目由各地自己定，去当地妇幼保健机构或婚姻登记处的一站式窗口问。"]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["我的备注"]},{"tag":"button","props":{"type":"button"},"children":["写下对自己有用的提醒…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/tip/10-13"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"childr