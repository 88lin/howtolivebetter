ps":{"cx":"12","cy":"12","r":"10"},"children":[]}]},{"tag":"span","props":{},"children":["ログイン"]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/ja/book/27"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"目次に戻る"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["妊娠と出産：妊娠の判明から退院・手続きまで"]},{"tag":"nav","props":{"aria-label":"この章のヒント"},"children":[{"tag":"a","props":{"href":"/ja/tip/27-01"},"children":[{"tag":"span","props":{},"children":["01"]},"妊娠の準備から毎日 0.4 mgの葉酸を摂取し、妊娠初期の 3 ヶ月まで継続しましょう"]},{"tag":"a","props":{"href":"/ja/tip/27-02"},"children":[{"tag":"span","props":{},"children":["02"]},"妊娠 13 週までに地域保健センターで『母子健康手帳』を作成し、無料妊婦健診の枠を活用しましょう"]},{"tag":"a","props":{"href":"/ja/tip/27-03"},"children":[{"tag":"span","props":{},"children":["03"]},"初回産前検診でHIV、梅毒、B型肝炎の3項目を検査しましょう。陽性であっても無料の予防措置があります"]},{"tag":"a","props":{"href":"/ja/tip/27-04"},"children":[{"tag":"span","props":{},"children":["04"]},"妊娠期間中はタバコもアルコールも一切控え、家族も室内での喫煙は避けてください"]},{"tag":"a","props":{"href":"/ja/tip/27-05"},"children":[{"tag":"span","props":{},"children":["05"]},"子癇前症の高リスク因子がある場合、妊娠 12 週から毎日低用量のアスピリンを服用開始"]},{"tag":"a","props":{"href":"/ja/tip/27-06"},"children":[{"tag":"span","props":{},"children":["06"]},"妊娠 24 週以降に妊娠糖尿病のスクリーニングを一度受けましょう。糖水が面倒だと思わないで"]},{"tag":"a","props":{"href":"/ja/tip/27-07"},"children":[{"tag":"span","props":{},"children":["07"]},"「すぐに病院へ」のチェックリストを保存してください。妊娠中および産後1年間に有効です"]},{"tag":"a","props":{"href":"/ja/tip/27-08"},"children":[{"tag":"span","props":{},"children":["08"]},"破水した場合はその場で仰向けに寝て、臀部を高くし、120 に電話してください。歩き回ったり入浴したりしないでください"]},{"tag":"a","props":{"href":"/ja/tip/27-09"},"children":[{"tag":"span","props":{},"children":["09"]},"無痛分娩を希望する場合ははっきりと伝えましょう。帝王切開のリスクは高まりません"]},{"tag":"a","props":{"href":"/ja/tip/27-10"},"children":[{"tag":"span","props":{},"children":["10"]},"医学的適応がない限り、積極的に帝王切開を求めないでください。また、日取りを選ぶために手術を行うことも避けてください"]},{"tag":"a","props":{"href":"/ja/tip/27-11"},"children":[{"tag":"span","props":{},"children":["11"]},"妊娠前に出産保険の加入状況を確認しておきましょう。未就業の配偶者も出産医療費の請求が可能です"]},{"tag":"a","props":{"href":"/ja/tip/27-12"},"children":[{"tag":"span","props":{},"children":["12"]},"退院前に「出生医学証明書」を済ませましょう。名前は事前に考えておき、誤字がないようにしてください"]},{"tag":"a","props":{"href":"/ja/tip/27-13"},"children":[{"tag":"span","props":{},"children":["13"]},"新生児の踵（かかと）採血スクリーニングと聴覚スクリーニングは、どちらも拒否しないでください"]},{"tag":"a","props":{"href":"/ja/tip/27-14"},"children":[{"tag":"span","props":{},"children":["14"]},"出生医学証明書を受け取ったらすぐに子供の住民医療保険に加入しましょう。戸籍登録（落戸）を待たないでください"]},{"tag":"a","props":{"href":"/ja/tip/27-15"},"children":[{"tag":"span","props":{},"children":["15"]},"子供の出生後、一ヶ月以内に派出所へ出生届を提出してください"]},{"tag":"a","props":{"href":"/ja/tip/27-16"},"children":[{"tag":"span","props":{},"children":["16"]},"産後 42 日のこの検診を飛ばさないで。産後うつのスクリーニングでもあります"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/ja/tip/27-17","data-status":"active"},"children":[{"tag":"span","props":{},"children":["17"]},"妊娠しても猫を手放す必要はない。猫砂は毎日ほかの人が掃除し、肉を十分加熱し、土には手袋を使う"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"現在地"},"children":[{"tag":"a","props":{"href":"/ja/book"},"children":["本を読む"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/ja/book/27"},"children":["第27章"," ·"," ","妊娠と出産：妊娠の判明から退院・手続きまで"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"27-17"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["17"]},{"tag":"span","props":{"className":"life-evidence grade-b"},"children":["エビデンス"," ","B"]}]},{"tag":"h1","props":{"lang":"ja"},"children":["妊娠しても猫を手放す必要はない。猫砂は毎日ほかの人が掃除し、肉を十分加熱し、土には手袋を使う"]},{"tag":"p","props":{"lang":"ja","className":"life-entry-summary"},"children":["トキソプラズマは寄生虫です。妊娠中の初感染は流産や子どもの目・脳の損傷につながることがあります。猫の飼育自体で感染しやすくなるわけではなく、手放す必要はありません。特に避けたいのは加熱不十分な肉と、土に触れた後に手を洗わないこと。猫砂は毎日ほかの人に掃除してもらいましょう。"]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["費用・手間"]},{"tag":"p","props":{},"children":["お金はかかりません。猫砂を毎日家族に掃除してもらいます。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["効果"]},{"tag":"p","props":{},"children":["米国CDCによると、妊娠直前または妊娠中に初めてトキソプラズマに感染すると胎児に伝わることがあります。"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"記録する：妊娠しても猫を手放す必要はない。猫砂は毎日ほかの人が掃除し、肉を十分加熱し、土には手袋を使う"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"できている"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"やることに追加"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"お気に入り"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"このヒントを共有"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"詳細を閉じる"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["費用・手間"]},{"tag":"p","props":{},"children":["お金はかかりません。猫砂を毎日家族に掃除してもらいます。自分しかできなければ使い捨て手袋を購入します。肉は中まで火を通し、半生のステーキや羊肉を避ける習慣が必要です。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["効果"]},{"tag":"p","props":{},"children":["米国CDCによると、妊娠直前または妊娠中に初めてトキソプラズマに感染すると胎児に伝わることがあります。感染児の多くは出生時に無症状でも、後に失明や知的障害が生じる場合があります。少数は出生時から重い目や脳の損傷があります。英国NHSは妊娠中の感染が流産につながる場合があると説明しています。フランス・リヨンの検査施設で妊娠中に感染確認された603人、多くは抗寄生虫薬を使用した集計では、母子感染率は全体29%（95% CI 25〜33）。妊娠13週で感染した場合は約6%、36週では約72%が胎児へ伝わりました。早い時期の感染ほど子どもに症状が出やすく、24〜30週の感染で早期症状のある子どもを持つリスクが最も高く、約10%でした。欧州6都市の症例対照研究では、妊娠中に新規感染した人としなかった人を比較し、猫の飼育はOR 1.0（95% CI 0.7〜1.5）で差がありませんでした。猫砂の清掃はOR 1.3（95% CI 0.8〜2.1）で差は偶然の可能性があります。加熱不十分な羊肉はOR 3.13（95% CI 1.4〜7.2）で、食べない人の約3倍のオッズでした。土との接触はOR 1.81（95% CI 1.2〜2.7）で、約8割高い値でした。各都市の感染の30%〜63%は加熱不十分な肉や塩漬け肉、6%〜17%は土との接触に帰属すると推計されました。CDCは妊婦に、可能ならほかの人に猫砂を換えてもらい、無理なら使い捨て手袋を使い、その後せっけんと水で手洗いするよう勧めます。糞中の寄生虫が感染性を持つまで1〜5日かかるため毎日掃除します。妊娠中は新しく猫を飼わず、野良猫、特に子猫を引き取ったり触ったりしません。室内飼育とし、キャットフードや加熱済みの食事を与え、生肉は与えません。中国CDCも、できるだけ父親になる人が猫砂を掃除し、予防すれば妊娠中も猫と暮らせるとしています。NHSは、猫をなでたり飼ったりすること自体では感染しないと明記しています。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["出典"]},{"tag":"p","props":{"className":"life-citations"},"children":["Centers for Disease Control and Prevention. Toxoplasmosis: Risk Factors. ",{"tag":"a","props":{"href":"https://www.cdc.gov/toxoplasmosis/risk-factors/index.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.cdc.gov/toxoplasmosis/risk-factors/index.html"]},"；Centers for Disease Control and Prevention. Preventing Toxoplasmosis. ",{"tag":"a","props":{"href":"https://www.cdc.gov/toxoplasmosis/prevention/index.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.cdc.gov/toxoplasmosis/prevention/index.html"]},"；NHS. Toxoplasmosis. ",{"tag":"a","props":{"href":"https://www.nhs.uk/conditions/toxoplasmosis/","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.nhs.uk/conditions/toxoplasmosis/"]},"；中国疾病预防控制中心 (2025). 孕期弓形虫感染，都是「吸猫」惹的祸吗？ ",{"tag":"a","props":{"href":"https://www.chinacdc.cn/jkkp/crb/qtcr/202501/t20250103_303681.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.chinacdc.cn/jkkp/crb/qtcr/202501/t20250103_303681.html"]},"；Cook AJ, Gilbert RE, Buffolano W, et al. (2000). Sources of toxoplasma infection in pregnant women: European multicentre case-control study. BMJ, 321(7254), 142-147. ",{"tag":"a","props":{"href":"https://doi.org/10.1136/bmj.321.7254.142","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1136/bmj.321.7254.142"]},"；Dunn D, Wallon M, Peyron F, Petersen E, Peckham C, Gilbert R (1999). Mother-to-child transmission of toxoplasmosis: risk estimates for clinical counselling. Lancet, 353(9167), 1829-1833. ",{"tag":"a","props":{"href":"https://doi.org/10.1016/s0140-6736(98)08220-8","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1016/s0140-6736(98)08220-8"]}]},{"tag":"a","props":{"href":"https://www.cdc.gov/toxoplasmosis/risk-factors/index.html","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["出典を開く"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["著者の注記"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["猫が糞とともに寄生虫を排出するのは、一般に初感染後の数週間だけです。以前感染した成猫は再排出の可能性が低くなります。室内で生肉を食べなければ感染の機会も小さくなります。猫がいなくても、加熱不十分な肉、洗い足りない野菜・果物、猫の糞で汚染された土や未処理の水から感染します。肉は十分加熱し、生肉を扱った包丁・まな板・手を洗い、野菜・果物を流水で洗い、園芸や土いじりでは手袋を着けて後で手を洗ってください。NHSはサラミやパルマハムなどの非加熱の加工肉、未殺菌のヤギ乳も避けるよう勧めています。欧州研究は生の葉菜や洗っていない野菜を詳しく尋ねておらず、感染の14%〜49%は原因不明でした。抗体検査の必要性は妊婦健診の医師へ相談してください。猫と肉のリスクの数値は1件の回想による研究だけなのでBです。対策は公式機関に由来しますが、実行で感染がどれだけ減るかの研究はありません。利益「中」は判断によるもので、理由は検証記録にあります。受益者はあなたと子どもです。"]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["自分のメモ"]},{"tag":"button","props":{"type":"button"},"children":["自分へのメモを書く…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/ja/tip/27-16"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["前へ"]},"産後 42 日のこの検診を飛ばさないで。産後うつのスクリーニングでもあります"]}]}]},{"tag":"section","props":{"class