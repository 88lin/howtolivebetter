d":"M20 12h2"},"children":[]},{"tag":"path","props":{"d":"m6.34 17.66-1.41 1.41"},"children":[]},{"tag":"path","props":{"d":"m19.07 4.93-1.41 1.41"},"children":[]}]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"17","height":"17","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-moon life-theme-icon-dark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"},"children":[]}]}]},{"tag":"button","props":{"type":"button","className":"life-language-switch","aria-label":"Русский Выбрать язык","aria-haspopup":"menu","aria-expanded":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-globe","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]},{"tag":"path","props":{"d":"M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"},"children":[]},{"tag":"path","props":{"d":"M2 12h20"},"children":[]}]},{"tag":"span","props":{},"children":["Русский"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]}]},{"tag":"a","props":{"className":"life-account","href":"/ru/sign-in"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"17","height":"17","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle-user-round","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M18 20a6 6 0 0 0-12 0"},"children":[]},{"tag":"circle","props":{"cx":"12","cy":"10","r":"4"},"children":[]},{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},{"tag":"span","props":{},"children":["Войти"]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/ru/book/23"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"К содержанию"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["Какие навыки выгодно осваивать"]},{"tag":"nav","props":{"aria-label":"Советы главы"},"children":[{"tag":"a","props":{"href":"/ru/tip/23-01"},"children":[{"tag":"span","props":{},"children":["01"]},"Лицам младше 16 лет не разрешено «устраиваться на работу»: за найм таких подростков работодателя штрафуют на 5000 юаней в месяц, поэтому берут их только нелегальные предприятия"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/ru/tip/23-02","data-status":"active"},"children":[{"tag":"span","props":{},"children":["02"]},"Учёт влияния образования на смертность: каждый дополнительный год обучения снижает риск смерти у взрослых примерно на 1,9%"]},{"tag":"a","props":{"href":"/ru/tip/23-03"},"children":[{"tag":"span","props":{},"children":["03"]},"Прежде чем судить об обесценивании образования, посмотрите на структуру образования в Китае: лишь 15467 из 100000 имеют образование уровня колледжа или выше (перепись 2020 года; по выборочной оценке 2025 года — около 19%)"]},{"tag":"a","props":{"href":"/ru/tip/23-04"},"children":[{"tag":"span","props":{},"children":["04"]},"«Не хватает денег на учёбу»: сначала посчитаем по правилам: в большинстве случаев обучение в средних профессиональных учебных заведениях бесплатно, стипендия составляет 2300 юаней в год, а максимальная сумма образовательного кредита — 20 000 юаней в год"]},{"tag":"a","props":{"href":"/ru/tip/23-05"},"children":[{"tag":"span","props":{},"children":["05"]},"Неудача на вступительных в обычную старшую школу не означает тупик: в системе профессионального образования существуют программы непрерывного обучения и отдельные вступительные экзамены, а работодатели могут снижать требования к уровню образования для соискателей из профессиональных училищ"]},{"tag":"a","props":{"href":"/ru/tip/23-06"},"children":[{"tag":"span","props":{},"children":["06"]},"«Учиться или идти работать» как одна задача: зарплата за три года, если сразу пойти работать, против разницы в годовом доходе на десятилетия вперёд, которую даёт продолжение учёбы"]},{"tag":"a","props":{"href":"/ru/tip/23-07"},"children":[{"tag":"span","props":{},"children":["07"]},"Запомните базовый показатель: в среднем по миру дополнительный год обучения повышает личный доход примерно на 9% в год"]},{"tag":"a","props":{"href":"/ru/tip/23-08"},"children":[{"tag":"span","props":{},"children":["08"]},"Прежде чем тратить деньги на получение сертификата, проверьте, входит ли он в Государственный реестр профессиональных квалификаций или перечень аккредитованных организаций Министерства труда и социальной защиты"]},{"tag":"a","props":{"href":"/ru/tip/23-09"},"children":[{"tag":"span","props":{},"children":["09"]},"Сначала ищите государственные субсидии на обучение, а не сразу оплачивайте коммерческие курсы из собственного кармана"]},{"tag":"a","props":{"href":"/ru/tip/23-10"},"children":[{"tag":"span","props":{},"children":["10"]},"При выборе навыка отдавайте предпочтение тем, где требуется работать руками и принимать решения на месте — такие профессии сложнее всего автоматизировать"]},{"tag":"a","props":{"href":"/ru/tip/23-11"},"children":[{"tag":"span","props":{},"children":["11"]},"Перед обучением проверьте, есть ли у данной профессии официальная система уровней и можно ли их обменять на деньги"]},{"tag":"a","props":{"href":"/ru/tip/23-12"},"children":[{"tag":"span","props":{},"children":["12"]},"Не стоит воспринимать утверждения в интернете о высокой зарплате как признак дефицита рабочих кадров — лучше изучите местные списки востребованных профессий и программы субсидий"]},{"tag":"a","props":{"href":"/ru/tip/23-13"},"children":[{"tag":"span","props":{},"children":["13"]},"За те же деньги и время лучше выбирать краткосрочные программы, позволяющие сразу приступить к работе"]},{"tag":"a","props":{"href":"/ru/tip/23-14"},"children":[{"tag":"span","props":{},"children":["14"]},"После изучения раздела закройте книгу и проверьте себя — не перечитывайте его заново"]},{"tag":"a","props":{"href":"/ru/tip/23-15"},"children":[{"tag":"span","props":{},"children":["15"]},"Распределите то же время на несколько дней, а не учитесь за один раз"]},{"tag":"a","props":{"href":"/ru/tip/23-16"},"children":[{"tag":"span","props":{},"children":["16"]},"Не стоит считать выделение важных моментов, повторное чтение и составление кратких выводов основными методами обучения"]},{"tag":"a","props":{"href":"/ru/tip/23-17"},"children":[{"tag":"span","props":{},"children":["17"]},"Смешанная практика разных типов заданий, а не по 20 одинаковых подряд"]},{"tag":"a","props":{"href":"/ru/tip/23-18"},"children":[{"tag":"span","props":{},"children":["18"]},"Не стоит выбирать методы обучения, исходя из того, что «я — визуал, а он — аудиал»"]},{"tag":"a","props":{"href":"/ru/tip/23-19"},"children":[{"tag":"span","props":{},"children":["19"]},"Проверяйте себя, составляя вопросы на основе будущего применения материала, а не просто заучивая его дословно"]},{"tag":"a","props":{"href":"/ru/tip/23-20"},"children":[{"tag":"span","props":{},"children":["20"]},"Сначала определите, к какой серии и уровню относится ваша профессия, а затем выберите подходящий способ подачи заявки в зависимости от типа вашей организации"]},{"tag":"a","props":{"href":"/ru/tip/23-21"},"children":[{"tag":"span","props":{},"children":["21"]},"Получение начальных и средних профессиональных званий, например в сфере бухгалтерского учета, происходит посредством единого общенационального экзамена. Для регистрации необходимо сопоставить свое образование и стаж работы с требованиями"]},{"tag":"a","props":{"href":"/ru/tip/23-22"},"children":[{"tag":"span","props":{},"children":["22"]},"Не обращайтесь к посредникам для прохождения аттестации, не заказывайте написание статей у сторонних лиц и не подделывайте документы: при выявлении нарушений звание будет аннулировано, а в карточку добросовестности внесут запись на 3 года"]},{"tag":"a","props":{"href":"/ru/tip/23-23"},"children":[{"tag":"span","props":{},"children":["23"]},"Наличие профессионального звания не гарантирует повышение зарплаты: сначала уточните, проводится ли оно в рамках установленного соотношения вакансий, или же получение звания не подразумевает автоматическое назначение на должность"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"Навигация"},"children":[{"tag":"a","props":{"href":"/ru/book"},"children":["Книга"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/ru/book/23"},"children":["Глава 23"," ·"," ","Какие навыки выгодно осваивать"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"23-02"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["02"]},{"tag":"span","props":{"className":"life-evidence grade-a（争议）"},"children":["Доказательства"," ","A（争议）"]}]},{"tag":"h1","props":{"lang":"ru"},"children":["Учёт влияния образования на смертность: каждый дополнительный год обучения снижает риск смерти у взрослых примерно на 1,9%"]},{"tag":"p","props":{"lang":"ru","className":"life-entry-summary"},"children":["Каждый дополнительный год обучения в среднем снижает риск смерти во взрослом возрасте примерно на 1,9%. Для людей в возрасте от 18 до 49 лет этот показатель выше — около 2,9% за год; у людей старше 70 лет он составляет лишь 0,8%. Однако те, кто способен продолжать учёбу, как правило, уже обладают благоприятными стартовыми условиями, поэтому трудно отделить реальное влияние самого образования от других факторов."]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Затраты"]},{"tag":"p","props":{},"children":["Никаких прямых затрат нет. Тратится лишь время и усилия на…"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Польза"]},{"tag":"p","props":{},"children":["Для расчёта использовались данные из метаанализа, охватившего 603 исследования, проведённых в 70 регионах 59 с…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"Отметить: Учёт влияния образования на смертность: каждый дополнительный год обучения снижает риск смерти у взрослых примерно на 1,9%"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"Сделано"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"В планах"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"В избранное"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Поделиться советом"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Скрыть подробности"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Затраты"]},{"tag":"p","props":{},"children":["Никаких прямых затрат нет. Тратится лишь время и усилия на дополнительные годы учёбы; вопрос оплаты обучения рассматривается в пункте 4 этого раздела (о плате за среднее профессиональное образование и стипендиях). Главная сложность — не бросить учёбу на полпути."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Польза"]},{"tag":"p","props":{},"children":["Для расчёта использовались данные из метаанализа, охватившего 603 исследования, проведённых в 70 регионах 59 стран в период с января 1980 года по май 2023 года; в анализе участвовало 10 355 наблюдений. Между уровнем образования и смертностью взрослых (по всем причинам) наблюдается дозозависимая связь: чем больше лет человек учился, тем ниже риск смерти. В среднем каждый дополнительный год обучения снижает риск смерти на 1,9% (95% доверительный интервал: 1,8–2,0). Для возрастной группы 18–49 лет этот показатель равен 2,9% (2,8–3,0), а для лиц старше 70 лет — 0,8% (0,6–1,0). Различий между мужчинами и женщинами не выявлено; также не наблюдается зависимости от уровня развития страны (по индексу социально-демографических условий)."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Первоисточники"]},{"tag":"p","props":{"className":"life-citations"},"children":["IHME-CHAIN Collaborators (2024). Effects of education on adult mortality: a global systematic review and meta-analysis. The Lancet Public Health, 9(3), e155-e165. ",{"tag":"a","props":{"href":"https://doi.org/10.1016/S2468-2667(23)00306-7","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1016/S2468-2667(23)00306-7"]}]},{"tag":"a","props":{"href":"https://doi.org/10.1016/S2468-2667(23)00306-7","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Открыть источник"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Примечание автора"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["Данные результаты вызывают споры. Авторы исследования отметили наличие публикационной погрешности (p<0,0001) — исследования с более «благоприятными» результатами публикуются чаще. Кроме того, наблюдается значительная вариативность результатов между отдельными исследованиями. Все данные получены в ходе наблюдательных исследований, а не рандомизированных клинических испытаний. Поскольку уровень образования тесно связан с социально-экономическим положением семьи, регионом проживания и профессией, трудно точно определить, какая часть снижения риска смерти на 1,9% обусловлена именно образованием, а какая — благоприятными стартовыми условиями. Аналогично сложно установить обратную зависимость: люди с хроническими заболеваниями или психическими расстройствами в детстве чаще бросают учёбу и имеют более высокую смертность, что может завышать оценку эффекта образования. Таким образом, данные убедительно подтверждают связь между более высоким уровнем образования и большей продолжительностью жизни, однако не позволяют утверждать, что каждый год учёбы гарантирует снижение смертности ровно на 1,9%. Величина пользы оценивается как небольшая: при увеличении обучения всего на 3–4 года совокупный эффект составит менее 10%, что соответствует категории «малая польза» по классификации книги. Прямым бенефициаром является сам человек."]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Моя заметка"]},{"tag":"button","props":{"type":"button"},"children":["Запишите напоминание…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/ru/tip/23-01"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Предыдущий"]},"Лицам младше 16 лет не разрешено «устраиваться на работу»: за найм таких подростков работодателя штрафуют на 5000 юаней в месяц, поэтому берут их только нелегальные предприятия"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/ru/tip/23-03"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Следующий"]},"Прежде чем судить об обесценивании образования, посмотрите на структуру образования в Китае: лишь 15467 из 100000 имеют образование уровня колледжа или выше (перепись 2020 года; по выборочной оценке 2025 года — около 19%)"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["Другие советы по этой теме"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/23-04"},"children":[{"tag":"strong","props":{},"children":["«Не хватает денег на учёбу»: сначала посчитаем по правилам: в большинстве случаев обучение в средних профессиональных учебных заведениях бесплатно, стипендия составляет 2300 юаней в год, а максимальная сумма образовательного кредита — 20 000 юаней в год"]},{"tag":"span","props":{},"children":["В государственных средних профессиональных учебных заведениях обучени…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/23-05"},"children":[{"tag":"strong","props":{},"children":["Неудача на вступительных в обычную старшую школу не означает тупик: в системе профессионального образования существуют программы непрерывного обучения и отдельные вступительные экзамены, а работодатели могут снижать требования к уровню образования для соискателей из профессиональных училищ"]},{"tag":"span","props":{},"children":["В Законе о профессиональном образовании 2022 года четко указано: проф…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/23-06"},"children":[{"tag":"strong","props":{},"children":["«Учиться или идти работать» как одна задача: зарплата за три года, если сразу пойти работать, против разницы в годовом доходе на десятилетия вперёд, которую даёт продолжение учёбы"]},{"tag":"span","props":{},"children":["Если сразу пойти работать, можно на несколько лет раньше начать получ…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/23-07"},"children":[{"tag":"strong","props":{},"children":["Запомните базовый показатель: в среднем по миру дополнительный год обучения повышает личный доход примерно на 9% в год"]},{"tag":"span","props":{},"children":["В среднем по миру дополнительный год в школе увеличивает личный доход…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/23-08"},"children":[{"tag":"strong","props":{},"children":["Прежде чем тратить деньги на получение сертификата, проверьте, входит ли он в Государственный реестр профессиональных квалификаций или перечень аккредитованных организаций Министерства труда и социальной защиты"]},{"tag":"span","props":{},"children":["Некоторые организации под видом новых профессий или уровней квалифика…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/23-09"},"children":[{"tag":"strong","props":{},"children":["Сначала ищите государственные субсидии на обучение, а не сразу оплачивайте коммерческие курсы из собственного кармана"]},{"tag":"span","props":{},"children":["С 2025 по конец 2027 года государство планирует организовать обучение…"]}]}]}]},{"tag":"a","props":{"className":"life-text-link","href":"/ru/book/23"},"children":["Читать всю тему: Какие навыки выгодно осваивать"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"15","height":"15","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":