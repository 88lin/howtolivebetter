ill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-up-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M7 7h10v10"},"children":[]},{"tag":"path","props":{"d":"M7 17 17 7"},"children":[]}]}]}]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/en/book/30"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"Back to index"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["Children after starting school"]},{"tag":"div","props":{"data-ad-dock-host":"true"},"children":[]},{"tag":"nav","props":{"aria-label":"Chapter entries"},"children":[{"tag":"a","props":{"href":"/en/tip/30-01"},"children":[{"tag":"span","props":{},"children":["01"]},"Child reports sudden, worsening pain — rush to the hospital right away; don’t let him wait until after school"]},{"tag":"a","props":{"href":"/en/tip/30-02"},"children":[{"tag":"span","props":{},"children":["02"]},"Don’t delay necessary treatment just to “wait until exams are over”; certain treatment windows depend on bone growth, not exam schedules"]},{"tag":"a","props":{"href":"/en/tip/30-03"},"children":[{"tag":"span","props":{},"children":["03"]},"When a child is bullied, report it to school the same day and request a written response; for physical assault, theft, or rumor spreading, call the police immediately"]},{"tag":"a","props":{"href":"/en/tip/30-04"},"children":[{"tag":"span","props":{},"children":["04"]},"Ensuring that children spend at least 2 hours outdoors each day is currently the only myopia‑prevention method backed by randomized trials"]},{"tag":"a","props":{"href":"/en/tip/30-05"},"children":[{"tag":"span","props":{},"children":["05"]},"No screen time for children aged 0–3; limit it as much as possible for ages 3–6; for school‑age kids, non‑educational screen use should not exceed one hour per day"]},{"tag":"a","props":{"href":"/en/tip/30-06"},"children":[{"tag":"span","props":{},"children":["06"]},"Treating myopia as a lasting injury: the higher the prescription, the greater the future risk of retinal detachment, macular degeneration, and glaucoma"]},{"tag":"a","props":{"href":"/en/tip/30-07"},"children":[{"tag":"span","props":{},"children":["07"]},"Take a close look at your child’s annual school health report and follow up on any abnormalities right away"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/en/tip/30-08","data-status":"active"},"children":[{"tag":"span","props":{},"children":["08"]},"Conducting a depression screening for kids aged 12 to 18 — don’t rely on school mental health assessments as a diagnosis"]},{"tag":"a","props":{"href":"/en/tip/30-09"},"children":[{"tag":"span","props":{},"children":["09"]},"Do not buy products or services claiming to “cure myopia” or “reduce refractive error”"]},{"tag":"a","props":{"href":"/en/tip/30-10"},"children":[{"tag":"span","props":{},"children":["10"]},"Clear rules exist for sleep, homework, sports, and rankings; if schools fail to comply, parents can raise the issue"]},{"tag":"a","props":{"href":"/en/tip/30-11"},"children":[{"tag":"span","props":{},"children":["11"]},"Parents can request a temporary leave of absence for their child; the school must retain the child’s enrollment status for up to one year"]},{"tag":"a","props":{"href":"/en/tip/30-12"},"children":[{"tag":"span","props":{},"children":["12"]},"If poor vision is detected, go to the hospital for cycloplegic refraction and follow up at the recommended intervals as advised by the doctor"]},{"tag":"a","props":{"href":"/en/tip/30-13"},"children":[{"tag":"span","props":{},"children":["13"]},"Pit and fissure sealants applied after permanent molars emerge"]},{"tag":"a","props":{"href":"/en/tip/30-14"},"children":[{"tag":"span","props":{},"children":["14"]},"If your child loves playing games, first check if sleep, homework, and outdoor activities have been displaced, rather than just focusing on how long they have played"]},{"tag":"a","props":{"href":"/en/tip/30-15"},"children":[{"tag":"span","props":{},"children":["15"]},"When a child says they are attracted to the same sex: Do not scold, do not kick them out, and do not send them to \"conversion therapy\": The attitude at home is related to whether they will attempt suicide"]},{"tag":"a","props":{"href":"/en/tip/30-16"},"children":[{"tag":"span","props":{},"children":["16"]},"Do not hit your child, and do not yell or call them stupid: children who are often hit or verbally abused show more behavior and emotional problems"]},{"tag":"a","props":{"href":"/en/tip/30-17"},"children":[{"tag":"span","props":{},"children":["17"]},"If parenting feels out of control and you keep hitting or yelling, take a class that teaches concrete parenting skills"]},{"tag":"a","props":{"href":"/en/tip/30-18"},"children":[{"tag":"span","props":{},"children":["18"]},"Do not send children to closed “internet addiction schools” or “special training camps”: harmful methods are prohibited by law, and children have died in confinement"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"Breadcrumb"},"children":[{"tag":"a","props":{"href":"/en/book"},"children":["Explore the book"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/en/book/30"},"children":["Chapter 30"," ·"," ","Children after starting school"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"30-08"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["08"]},{"tag":"span","props":{"className":"life-evidence grade-b"},"children":["Evidence"," ","B"]}]},{"tag":"h1","props":{"lang":"en"},"children":["Conducting a depression screening for kids aged 12 to 18 — don’t rely on school mental health assessments as a diagnosis"]},{"tag":"p","props":{"lang":"en","className":"life-entry-summary"},"children":["The U.S. Preventive Services Task Force recommends screening adolescents aged 12 to 18 for major depressive disorder, noting that the overall benefits are moderate and justify the effort. There is insufficient evidence to support screening for kids under 11. Suicide is the second leading cause of death among people aged 10 to 19. School mental health assessments conducted each academic year are population-wide screenings, not diagnostic tools. If a child reports feeling distressed, or shows sudden changes in eating, sleeping, interests, or academic performance, they should be referred to a psychiatrist or clinical psychologist right away."]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Cost"]},{"tag":"p","props":{},"children":["Costs range from zero to just a few dozen yuan;"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Benefit"]},{"tag":"p","props":{},"children":["In 2022, the U.S. Preventive Services Task Force issued a recommendation statement advising that adolescents a…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"Mark: Conducting a depression screening for kids aged 12 to 18 — don’t rely on school mental health assessments as a diagnosis"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"Done"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"Plan to do"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"Save"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Share this tip"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Hide details"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Cost"]},{"tag":"p","props":{},"children":["Costs range from zero to just a few dozen yuan; this covers filling out a screening questionnaire at a community clinic or hospital outpatient department. Calling the 12355 and 12356 hotlines is completely free."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Benefit"]},{"tag":"p","props":{},"children":["In 2022, the U.S. Preventive Services Task Force issued a recommendation statement advising that adolescents aged 12 to 18 be screened for major depressive disorder; this recommendation falls under Category B, meaning the evidence supporting it is moderate and the benefits are also moderate, making it worthwhile. For children under 11, there is insufficient evidence to support depression screening (an I statement, which indicates a lack of evidence and no formal recommendation). Likewise, evidence regarding both the benefits and risks of screening children and adolescents specifically for suicide risk is also limited (another I statement). The document emphasizes that suicide is the second leading cause of death among 10- to 19-year-olds, and that major depression in youth is closely linked to numerous later issues, including recurrent depressive episodes and other mental disorders, as well as a heightened risk of suicidal thoughts, suicide attempts, and death. China’s “Ten Measures to Further Improve Mental Health Care for Primary and Secondary School Students” calls for establishing a three-tier support system: homeroom teachers, full- and part-time school counselors, and psychiatrists. Each student should undergo a mental health assessment no more than once per academic year. The measures also stress the need to improve referral pathways to mental health specialists and reintegration processes after recovery. Additionally, they highlight the importance of leveraging the 12355 Youth Service Hotline and the 12356 Psychological Assistance Hotline (issued nationwide in October 2025)."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Original sources"]},{"tag":"p","props":{"className":"life-citations"},"children":["US Preventive Services Task Force (2022). Screening for Depression and Suicide Risk in Children and Adolescents: US Preventive Services Task Force Recommendation Statement. JAMA. ",{"tag":"a","props":{"href":"https://doi.org/10.1001/jama.2022.16946","target":"_blank","rel":"noopener noreferrer"},"children":[