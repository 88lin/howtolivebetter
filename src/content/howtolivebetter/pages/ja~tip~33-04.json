 1.41"},"children":[]}]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"17","height":"17","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-moon life-theme-icon-dark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"},"children":[]}]}]},{"tag":"button","props":{"type":"button","className":"life-language-switch","aria-label":"日本語 言語を選ぶ","aria-haspopup":"menu","aria-expanded":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-globe","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]},{"tag":"path","props":{"d":"M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"},"children":[]},{"tag":"path","props":{"d":"M2 12h20"},"children":[]}]},{"tag":"span","props":{},"children":["日本語"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]}]},{"tag":"a","props":{"className":"life-account","href":"/ja/sign-in"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"17","height":"17","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle-user-round","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M18 20a6 6 0 0 0-12 0"},"children":[]},{"tag":"circle","props":{"cx":"12","cy":"10","r":"4"},"children":[]},{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},{"tag":"span","props":{},"children":["ログイン"]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/ja/book/33"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"目次に戻る"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["障害を負った後の生き方"]},{"tag":"nav","props":{"aria-label":"この章のヒント"},"children":[{"tag":"a","props":{"href":"/ja/tip/33-01"},"children":[{"tag":"span","props":{},"children":["01"]},"脊髄損傷の後に突然の激しい頭痛や発汗が見られたら、まずは体を起こして座らせ、衣服を緩め、同時に 120 を呼ぶ"]},{"tag":"a","props":{"href":"/ja/tip/33-02"},"children":[{"tag":"span","props":{},"children":["02"]},"障害を負った後の最初の10年間は自殺のハイリスク期です。「前向きに考えれば大丈夫」で済ませないでください"]},{"tag":"a","props":{"href":"/ja/tip/33-03"},"children":[{"tag":"span","props":{},"children":["03"]},"精神障害の入院は自発的な意思を原則とし、本人の同意なしで行えるのは以下の2つのケースのみである"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/ja/tip/33-04","data-status":"active"},"children":[{"tag":"span","props":{},"children":["04"]},"在自宅で障害者を介護している人は、自身の健康管理を怠らないこと"]},{"tag":"a","props":{"href":"/ja/tip/33-05"},"children":[{"tag":"span","props":{},"children":["05"]},"車椅子を長時間使用する場合は、クッションを減圧型に交換し、毎日坐骨と尾骨の状態を確認すること"]},{"tag":"a","props":{"href":"/ja/tip/33-06"},"children":[{"tag":"span","props":{},"children":["06"]},"「麻痺、失明、難聴を治せる」といった療法や器具を買わないこと"]},{"tag":"a","props":{"href":"/ja/tip/33-07"},"children":[{"tag":"span","props":{},"children":["07"]},"障害者手帳の交付後、県級の残聯（障害者連合会）へ行き、申請可能な事項を一度にすべて確認する"]},{"tag":"a","props":{"href":"/ja/tip/33-08"},"children":[{"tag":"span","props":{},"children":["08"]},"7 歳未満で、新たに障害や自閉症（孤独症）が判明した子供については、県級の残聯へリハビリ救済を申請する"]},{"tag":"a","props":{"href":"/ja/tip/33-09"},"children":[{"tag":"span","props":{},"children":["09"]},"自宅のスロープ、手すり、浴室のリフォームについては、県級以上の政府に補助金を申請できる"]},{"tag":"a","props":{"href":"/ja/tip/33-10"},"children":[{"tag":"span","props":{},"children":["10"]},"中国で仕事を探すときは障害者証の所持を伝える。採用で企業の負担金を減らせる"]},{"tag":"a","props":{"href":"/ja/tip/33-11"},"children":[{"tag":"span","props":{},"children":["11"]},"障害者の個人所得税は軽減される可能性があります。軽減額については、各省の税務局へ電話でご確認ください。"]},{"tag":"a","props":{"href":"/ja/tip/33-12"},"children":[{"tag":"span","props":{},"children":["12"]},"盲導犬は公共施設や公共交通機関への同伴が可能で、視覚障害者は市内のバスに無料で乗車できます"]},{"tag":"a","props":{"href":"/ja/tip/33-13"},"children":[{"tag":"span","props":{},"children":["13"]},"障害のある受験生は大学入試（高考）において合理的配慮を申請でき、点字答案を使用する場合、試験時間は1.5倍に延長される"]},{"tag":"a","props":{"href":"/ja/tip/33-14"},"children":[{"tag":"span","props":{},"children":["14"]},"障害のある子供の入学申請に対し、学校は拒否してはならない。登校が困難な場合は、教育局が訪問指導の手配を行う"]},{"tag":"a","props":{"href":"/ja/tip/33-15"},"children":[{"tag":"span","props":{},"children":["15"]},"右下肢または両下肢を欠損していても運転免許の取得は可能。準拠車種は C5 と呼ばれる"]},{"tag":"a","props":{"href":"/ja/tip/33-16"},"children":[{"tag":"span","props":{},"children":["16"]},"リハビリはリハビリテーション科のある正規の機関で行うこと。強度は療法士の指示に従う。激しければ良いというものではない"]},{"tag":"a","props":{"href":"/ja/tip/33-17"},"children":[{"tag":"span","props":{},"children":["17"]},"難聴を感じたら補聴器を検討すること。補聴器を使用する理由は「聞こえるようにするため」であり、「認知症予防のため」ではない"]},{"tag":"a","props":{"href":"/ja/tip/33-18"},"children":[{"tag":"span","props":{},"children":["18"]},"成人が「自身の事柄を管理できない」と判断するには、裁判所に申し立てて認定を受ける必要があり、家族の判断だけでは不十分である"]},{"tag":"a","props":{"href":"/ja/tip/33-19"},"children":[{"tag":"span","props":{},"children":["19"]},"成人の後見人は法定順序に従って定められます。被後見人が他人に損害を与えた場合、後見人が賠償します"]},{"tag":"a","props":{"href":"/ja/tip/33-20"},"children":[{"tag":"span","props":{},"children":["20"]},"障害を理由とした採用拒否、正社員登用拒否、給与の過少支払いは訴えることが可能ですが、まずはプロセスに伴うコストを計算してください"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"現在地"},"children":[{"tag":"a","props":{"href":"/ja/book"},"children":["本を読む"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/ja/book/33"},"children":["第33章"," ·"," ","障害を負った後の生き方"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"33-04"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["04"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["エビデンス"," ","A"]}]},{"tag":"h1","props":{"lang":"ja"},"children":["在自宅で障害者を介護している人は、自身の健康管理を怠らないこと"]},{"tag":"p","props":{"lang":"ja","className":"life-entry-summary"},"children":["介護者が疲れ果ててしまうのは、単なるわがままではありません。米国の研究で800人以上の高齢者を4年間追跡したところ、要介護の配偶者を介護しながら、自身が精神的な負担を感じていると報告したグループは、介護していないグループに比べて死亡リスクが約6割高くなっていました。一方で、介護はしているが負担を感じていないグループには、このようなリスクの上昇は見られませんでした。つまり、注視すべきは介護そのものではなく、長期にわたる緊張状態なのです。"]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["費用・手間"]},{"tag":"p","props":{},"children":["費用はかかりません。介護業務の一部を外部に任せ、自分自身の健康診断を受ける時間を作ってください。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["効果"]},{"tag":"p","props":{},"children":["本研究は、米国の4つのコミュニティを対象とした前向きコホート研究であり、期間は1993年から1998年、平均追跡期間は4.5年である。"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"記録する：在自宅で障害者を介護している人は、自身の健康管理を怠らないこと"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"できている"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"やることに追加"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"お気に入り"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"このヒントを共有"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"詳細を閉じる"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["費用・手間"]},{"tag":"p","props":{},"children":["費用はかかりません。介護業務の一部を外部に任せ、自分自身の健康診断を受ける時間を作ってください。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["効果"]},{"tag":"p","props":{},"children":["本研究は、米国の4つのコミュニティを対象とした前向きコホート研究であり、期間は1993年から1998年、平均追跡期間は4.5年である。配偶者と同居している、66歳から96歳の介護者392名および非介護者427名を対象とした。4年間に103人（12.6%）が死亡した。社会人口統計学的要因、既往症、および亜臨床的心血管疾患を調整した後、介護を行いながら精神的または感情的なストレスを報告した人の死亡リスクは、非介護の対照群と比較して63%高かった（RR 1.63、95% CI 1.00–2.65、信頼区間）。緊張を報告していないが介護を行っている人（RR 1.08、95% CI 0.61–1.90）および、配偶者が障害を抱えているが本人は介護を行っていない人（RR 1.37、95% CI 0.73–2.58）のいずれにおいても、調整後の死亡率は上昇していなかった"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["出典"]},{"tag":"p","props":{"className":"life-citations"},"children":["Schulz R, Beach SR (1999). Caregiving as a risk factor for mortality: the Caregiver Health Effects Study. JAMA, 282(23):2215-2219. ",{"tag":"a","props":{"href":"https://doi.org/10.1001/jama.282.23.2215","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1001/jama.282.23.2215"]}]},{"tag":"a","props":{"href":"https://doi.org/10.1001/jama.282.23.2215","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["出典を開く"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["著者の注記"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["論争点：この研究の信頼性の下限はちょうど 1.00 に位置しており、「差がない」可能性を完全に排除できてはいません。対象は配偶者と同居している米国の高齢者であり、介護対象が要介護の高齢配偶者であるため、若い障害者の家族を介護する場合にそのまま当てはめるには、やや外挿（推論）が含まれます。言えることは、方向性として「負担を感じている層のリスクが高い」ということです。可能な限り介護の負担を分散させましょう。デイケアや訪問介護サービスについては、現地の障害者連合会や民政部門に問い合わせてください。介護者自身の持病の薬は中断しないでください。第 16 節 第 1 条（薬は医師の指示通りに服用すること）を参照してください。この項目の受益者は、あなた自身です。"]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["自分のメモ"]},{"tag":"button","props":{"type":"button"},"children":["自分へのメモを書く…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/ja/tip/33-03"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["前へ"]},"精神障害の入院は自発的な意思を原則とし、本人の同意なしで行えるのは以下の2つのケースのみである"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/ja/tip/33-05"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["次へ"]},"車椅子を長時間使用する場合は、クッションを減圧型に交換し、毎日坐骨と尾骨の状態を確認すること"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["このテーマの他の提案"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/33-01"},"children":[{"tag":"strong","props":{},"children":["脊髄損傷の後に突然の激しい頭痛や発汗が見られたら、まずは体を起こして座らせ、衣服を緩め、同時に 120 を呼ぶ"]},{"tag":"span","props":{},"children":["脊髄損傷を負った人は、身体の警報回路が一部断たれています。膀胱に尿が溜まっていたり、衣服が締め付けられていたりしても、本人は気づかないこと…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/33-02"},"children":[{"tag":"strong","props":{},"children":["障害を負った後の最初の10年間は自殺のハイリスク期です。「前向きに考えれば大丈夫」で済ませないでください"]},{"tag":"span","props":{},"children":["障害を負った直後の数年間、本人や家族の精神状態が崩れてしまうことはよくあることであり、それは意志の強さの問題ではありません。英国の2つの脊…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/33-06"},"children