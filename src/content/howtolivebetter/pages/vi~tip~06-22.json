/06-27"},"children":[{"tag":"span","props":{},"children":["27"]},"Đừng tin 「thủ dâm tổn hại sức khoẻ」「nhịn thái dâm mới được cải thiện」, điều cần xem thật sự là có làm lỡ giấc ngủ, công việc và quan hệ hay không"]},{"tag":"a","props":{"href":"/vi/tip/06-28"},"children":[{"tag":"span","props":{},"children":["28"]},"Đừng bỏ tiền làm 「điều chỉnh xu hướng tính dục」「chữa chứng đồng tính」, cũng đừng đưa người nhà đi"]},{"tag":"a","props":{"href":"/vi/tip/06-29"},"children":[{"tag":"span","props":{},"children":["29"]},"Đừng mong «tư thế nâng đúng» hay lớp huấn luyện bốc vác ngăn được đau lưng; hãy giảm trọng lượng và số lần nâng, tập thể dục đều đặn"]},{"tag":"a","props":{"href":"/vi/tip/06-30"},"children":[{"tag":"span","props":{},"children":["30"]},"Đừng mong bổ sung thật nhiều canxi hay uống nước hầm xương sau khi gãy xương sẽ giúp xương liền nhanh hơn"]},{"tag":"a","props":{"href":"/vi/tip/06-31"},"children":[{"tag":"span","props":{},"children":["31"]},"Đừng dựa vào chatbot AI để tự chẩn đoán hay phán đoán pháp lý; trước khi chữa bệnh, kiện tụng hoặc chi nhiều tiền, tìm văn bản gốc kiểm tra căn cứ nó nêu"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"Breadcrumbs"},"children":[{"tag":"a","props":{"href":"/vi/book"},"children":["Khám phá cuốn sách"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/vi/book/06"},"children":["Chương 6"," ·"," ","Danh sách phản tác dụng"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"06-22"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["22"]},{"tag":"span","props":{"className":"life-evidence grade-b"},"children":["Bằng chứng"," ","B"]}]},{"tag":"h1","props":{"lang":"vi"},"children":["Đừng mua tinh thể, chuỗi tay, tượng Pixiu chỉ để 「đổi vận」「kéo tài」「dưỡng người」"]},{"tag":"p","props":{"lang":"vi","className":"life-entry-summary"},"children":["Nói đeo vào thì đổi được vận, kéo được tài, dưỡng được người thì không có bằng chứng nào để kiểm chứng. Nó cùng một lý với chuyện xem bói trông chính xác: lời nói đủ chung chung, bạn tự điền vào. Khi người bán nói tới công năng chữa bệnh thì đó là quảng cáo sai sự thật, năm 2026 có phòng phát trực tiếp bị xử lý vì việc này. Mua làm đồ trang trí thì không sao."]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Chi phí"]},{"tag":"p","props":{},"children":["Không tốn tiền. Việc phải làm chỉ là đừng tính 「đổi vận」「d…"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Lợi ích"]},{"tag":"p","props":{},"children":["Thí nghiệm lớp học kinh điển cho thấy ai nhận bản 「phân tích cá nhân」 chung chung giống nhau đều cho là rất ch…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"Đánh dấu: Đừng mua tinh thể, chuỗi tay, tượng Pixiu chỉ để 「đổi vận」「kéo tài」「dưỡng người」"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"Hoàn tất"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"