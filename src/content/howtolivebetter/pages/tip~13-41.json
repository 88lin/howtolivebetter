,"props":{},"children":["登录同步"]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/book/13"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"返回目录"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["紧急情况：先做什么"]},{"tag":"nav","props":{"aria-label":"章节条目"},"children":[{"tag":"a","props":{"href":"/tip/13-01","className":""},"children":[{"tag":"span","props":{},"children":["01"]},"有人倒地没呼吸，立刻用力按压胸口，让旁人打 120 并找 AED"]},{"tag":"a","props":{"href":"/tip/13-02","className":""},"children":[{"tag":"span","props":{},"children":["02"]},"老人摔倒、有人倒地，先蹲下喊他、打 120，别急着把人扶起来；陌生人这档走开在国内也合法，停下来就别上手搬"]},{"tag":"a","props":{"href":"/tip/13-03","className":""},"children":[{"tag":"span","props":{},"children":["03"]},"突然嘴歪、一侧胳膊没劲、说话说不清，立刻打 120，不要等、不要自己开车去"]},{"tag":"a","props":{"href":"/tip/13-04","className":""},"children":[{"tag":"span","props":{},"children":["04"]},"突然天旋地转站不稳、看东西成双、一只眼发黑，或者手指点不到自己鼻尖，也按卒中打 120"]},{"tag":"a","props":{"href":"/tip/13-05","className":""},"children":[{"tag":"span","props":{},"children":["05"]},"一只眼睛突然像拉下窗帘一样黑掉，哪怕几分钟就自己好了，也当天按卒中去急诊"]},{"tag":"a","props":{"href":"/tip/13-06","className":""},"children":[{"tag":"span","props":{},"children":["06"]},"一只眼又胀又痛、发红，看灯有一圈彩虹，还头痛恶心想吐，当天去眼科急诊"]},{"tag":"a","props":{"href":"/tip/13-07","className":""},"children":[{"tag":"span","props":{},"children":["07"]},"胸口压着疼、闷、发紧超过 15 分钟不缓解，或者疼时出冷汗、恶心、喘不上气，打 120，不要自己扛也不要自己开车"]},{"tag":"a","props":{"href":"/tip/13-08","className":""},"children":[{"tag":"span","props":{},"children":["08"]},"突然像被撕开一样的剧痛，从胸口往后背、往腰一路挪，打 120 并说清「像撕开一样」"]},{"tag":"a","props":{"href":"/tip/13-09","className":""},"children":[{"tag":"span","props":{},"children":["09"]},"突然一记「这辈子最疼的头痛」，一小时内就到最疼，立刻去急诊做头颅 CT"]},{"tag":"a","props":{"href":"/tip/13-10","className":""},"children":[{"tag":"span","props":{},"children":["10"]},"老人磕过头之后两三周到几个月变得走路不稳、迟钝、嗜睡或者一侧没劲，去做头颅 CT"]},{"tag":"a","props":{"href":"/tip/13-11","className":""},"children":[{"tag":"span","props":{},"children":["11"]},"一条腿突然肿起来、发紧、按着疼，尽快就医；再加上突然喘不上气或者胸痛，立刻打 120"]},{"tag":"a","props":{"href":"/tip/13-12","className":""},"children":[{"tag":"span","props":{},"children":["12"]},"大出血先用手死死压住伤口，四肢压不住就上止血带，同时打 120"]},{"tag":"a","props":{"href":"/tip/13-13","className":""},"children":[{"tag":"span","props":{},"children":["13"]},"被狗、猫咬伤或抓破皮，先用肥皂水和流水交替冲 15 分钟，当天去打疫苗"]},{"tag":"a","props":{"href":"/tip/13-14","className":""},"children":[{"tag":"span","props":{},"children":["14"]},"烫伤后立刻用凉的流动水冲 20 分钟，别抹牙膏酱油"]},{"tag":"a","props":{"href":"/tip/13-15","className":""},"children":[{"tag":"span","props":{},"children":["15"]},"突然全身起疹、喘不上气或者发晕，按过敏性休克处理，立刻叫 120 并说清楚"]},{"tag":"a","props":{"href":"/tip/13-16","className":""},"children":[{"tag":"span","props":{},"children":["16"]},"有人抽搐倒地，清开周围、让他侧躺、看表计时，什么都别往嘴里塞；孩子发烧时抽搐也一样"]},{"tag":"a","props":{"href":"/tip/13-17","className":""},"children":[{"tag":"span","props":{},"children":["17"]},"糖尿病人突然发抖、出冷汗、说话不清，先给 15 克糖，15 分钟后复测"]},{"tag":"a","props":{"href":"/tip/13-18","className":""},"children":[{"tag":"span","props":{},"children":["18"]},"有人触电，先断电，再用干燥的木棍之类挑开电源，不要直接上手拉"]},{"tag":"a","props":{"href":"/tip/13-19","className":""},"children":[{"tag":"span","props":{},"children":["19"]},"一氧化碳报警器响了，或者一屋子人同时头痛恶心，先出门再打电话"]},{"tag":"a","props":{"href":"/tip/13-20","className":""},"children":[{"tag":"span","props":{},"children":["20"]},"误服清洁剂、农药、药物先别催吐，带上瓶子立刻就医；溅到眼睛或皮肤用大量清水至少冲 15 分钟"]},{"tag":"a","props":{"href":"/tip/13-21","className":""},"children":[{"tag":"span","props":{},"children":["21"]},"酸碱等化学品溅到身上，立刻脱掉污染的衣服、用大量流动清水冲，眼睛要掰开眼皮冲，冲够时间再走"]},{"tag":"a","props":{"href":"/tip/13-22","className":""},"children":[{"tag":"span","props":{},"children":["22"]},"高温下头晕、恶心、不出汗或意识不清，立刻挪到阴凉处脱衣泼水降温，意识不清的不喂水、打 120"]},{"tag":"a","props":{"href":"/tip/13-23","className":""},"children":[{"tag":"span","props":{},"children":["23"]},"中暑的人只要清醒，就少量多次喝凉的淡盐水或运动饮料，别猛灌、别喝酒和高糖饮料"]},{"tag":"a","props":{"href":"/tip/13-24","className":""},"children":[{"tag":"span","props":{},"children":["24"]},"火灾时贴地爬、摸门再开门、门烫就别开，走楼梯不坐电梯，出去了别回头"]},{"tag":"a","props":{"href":"/tip/13-25","className":""},"children":[{"tag":"span","props":{},"children":["25"]},"看到有人溺水，先叫人和打 110/120，伸竿、抛漂浮物，自己不下水"]},{"tag":"a","props":{"href":"/tip/13-26","className":""},"children":[{"tag":"span","props":{},"children":["26"]},"有人噎住说不出话，1 岁以上的站到背后做 5 次拍背加 5 次腹部冲击，倒下就做心肺复苏"]},{"tag":"a","props":{"href":"/tip/13-27","className":""},"children":[{"tag":"span","props":{},"children":["27"]},"在戈壁、沙漠、无人区迷路或车坏了，留在原地或车旁，先报位置，再遮阳保温，省水，不乱走"]},{"tag":"a","props":{"href":"/tip/13-28","className":""},"children":[{"tag":"span","props":{},"children":["28"]},"发抖、说话含糊、走路打晃是失温，换掉湿衣、包起来，先暖躯干，喝热甜饮不喝酒"]},{"tag":"a","props":{"href":"/tip/13-29","className":""},"children":[{"tag":"span","props":{},"children":["29"]},"被蛇咬，坐下别动、摘掉戒指手表、尽快送医院打抗蛇毒血清，不切、不吸、不绑死"]},{"tag":"a","props":{"href":"/tip/13-30","className":""},"children":[{"tag":"span","props":{},"children":["30"]},"地震时先看自己在什么房子里：符合抗震设防的楼里就地躲，会垮的老房子门在几步外就出去"]},{"tag":"a","props":{"href":"/tip/13-31","className":""},"children":[{"tag":"span","props":{},"children":["31"]},"遇到熊、野猪、成群野狗，别跑，侧身慢慢退开"]},{"tag":"a","props":{"href":"/tip/13-32","className":""},"children":[{"tag":"span","props":{},"children":["32"]},"野外遇上雷雨，钻进有硬顶的车或建筑，避开山脊、孤树、水面和金属"]},{"tag":"a","props":{"href":"/tip/13-33","className":""},"children":[{"tag":"span","props":{},"children":["33"]},"上高原按睡眠海拔（当晚睡在多高）慢慢升，症状加重就下撤，不要硬扛"]},{"tag":"a","props":{"href":"/tip/13-34","className":""},"children":[{"tag":"span","props":{},"children":["34"]},"被蜱虫叮住，用尖头镊子贴着皮肤稳稳拉出来，别涂油别用火烧"]},{"tag":"a","props":{"href":"/tip/13-35","className":""},"children":[{"tag":"span","props":{},"children":["35"]},"野外的水一律烧开再喝，滚开一分钟就够，常见的旅行海拔上不用因为海拔高多煮"]},{"tag":"a","props":{"href":"/tip/13-36","className":""},"children":[{"tag":"span","props":{},"children":["36"]},"荒郊野外被陌生人索财，钱给他，不动手，记特征，脱身后报警"]},{"tag":"a","props":{"href":"/tip/13-37","className":""},"children":[{"tag":"span","props":{},"children":["37"]},"撞见一群人打架，退开走人，别上去拉架、别围观、别捡地上的家伙；要报警就退到安全距离打 110"]},{"tag":"a","props":{"href":"/tip/13-38","className":""},"children":[{"tag":"span","props":{},"children":["38"]},"可能被 HIV 暴露了，72 小时内去拿阻断药，越早越好"]},{"tag":"a","props":{"href":"/tip/13-39","className":""},"children":[{"tag":"span","props":{},"children":["39"]},"救人受了伤、搭进了钱，先找加害人和医保，再去申报见义勇为确认"]},{"tag":"a","props":{"href":"/tip/13-40","className":""},"children":[{"tag":"span","props":{},"children":["40"]},"刀、钢筋、玻璃扎进身体，压住异物周围止血，不要把它拔出来"]},{"tag":"a","props":{"href":"/tip/13-41","className":"active"},"children":[{"tag":"span","props":{},"children":["41"]},"怀疑骨折就别再动那个部位，托着不动、冷敷 20 分钟以内，别自己掰正"]},{"tag":"a","props":{"href":"/tip/13-42","className":""},"children":[{"tag":"span","props":{},"children":["42"]},"被性侵之后，先到安全的地方打 110；验伤之前别洗澡、别洗衣服、别收拾房间，72 小时内去医院"]},{"tag":"a","props":{"href":"/tip/13-43","className":""},"children":[{"tag":"span","props":{},"children":["43"]},"不满 1 岁的婴儿噎住哭不出声，趴着拍背 5 下、翻过来按胸口 5 下，轮着做，别按肚子"]},{"tag":"a","props":{"href":"/tip/13-44","className":""},"children":[{"tag":"span","props":{},"children":["44"]},"不满 1 岁的婴儿没反应、没正常呼吸，开免提打 120，做婴儿心肺复苏：按 30 下吹 2 口气"]},{"tag":"a","props":{"href":"/tip/13-45","className":""},"children":[{"tag":"span","props":{},"children":["45"]},"孩子吞了纽扣电池，或者吞了两颗以上的强磁珠，立刻去有胃镜的医院急诊，别等它自己拉出来、别催吐"]},{"tag":"a","props":{"href":"/tip/13-46","className":""},"children":[{"tag":"span","props":{},"children":["46"]},"有人喝醉了，让他侧躺、有人一直守着，别让他一个人睡；叫不醒、呼吸慢或不规律、抽搐、身上发凉就打 120"]},{"tag":"a","props":{"href":"/tip/13-47","className":""},"children":[{"tag":"span","props":{},"children":["47"]},"手指、脚趾被切断，先压住伤口止血，断下来的部分用湿纱布包好装进密封袋，袋子放进冰水里，去有手外科的医院"]},{"tag":"a","props":{"href":"/tip/13-48","className":""},"children":[{"tag":"span","props":{},"children":["48"]},"恒牙（换牙之后长出来的牙）整颗撞掉，捏住牙冠冲一下，能放回去就放回去，放不回就泡在牛奶里，马上去看牙；乳牙别放回去"]}]}]},{"tag":"div","props":{"className":"life-tip-page","data-tip-locales":"zh,en,ru,es,ja,vi"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"当前位置"},"children":[{"tag":"a","props":{"href":"/book"},"children":["阅读全书"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/book/13"},"children":["第 13 章 · 紧急情况：先做什么"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"13-41"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["41"]},{"tag":"span","props":{"className":"life-evidence grade-b"},"children":["证据 B"]}]},{"tag":"h1","props":{"lang":"zh"},"children":["怀疑骨折就别再动那个部位，托着不动、冷敷 20 分钟以内，别自己掰正"]},{"tag":"p","props":{"lang":"zh","className":"life-entry-summary"},"children":["手脚受了伤先当骨折处理，能站能动也排除不了。伤处保持不动，用手托住或用硬板在原位撑住，冷敷一次不超过 20 分钟。别自己掰正，骨头戳出皮肤的先止血，别按回去。X 光可能漏看骨折，片子正常但医生仍怀疑骨折或者韧带伤的，按医生说的复查或做核磁。"]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["成本"]},{"tag":"p","props":{},"children":["不花钱。找块硬板、卷起的杂志或者衣物当支撑。冷的东西隔层布敷。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["收益"]},{"tag":"p","props":{},"children":["国际红十字与红新月会联合会发布了 2025 年国际急救指南。里面写着「手脚上的任何一处伤，都应当先按可能的骨折来处理」。还写着「确诊骨折唯一准确的办法是拍 X 光。拿不准就当骨折办」。固定的目的是「尽量减少活动和疼痛」。冷敷「一次最多连续 20 分钟，这样可以减轻疼痛；冷得比这更久可能损伤皮肤」。「…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"标记：怀疑骨折就别再动那个部位，托着不动、冷敷 20 分钟以内，别自己掰正"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"已做到"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"加入待做"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"收藏"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"分享这条建议"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"收起详情"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["成本"]},{"tag":"p","props":{"className":"life-citations"},"children":["不花钱。找块硬板、卷起的杂志或者衣物当支撑。冷的东西隔层布敷。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["收益"]},{"tag":"p","props":{"className":"life-citations"},"children":["国际红十字与红新月会联合会发布了 2025 年国际急救指南。里面写着「手脚上的任何一处伤，都应当先按可能的骨折来处理」。还写着「确诊骨折唯一准确的办法是拍 X 光。拿不准就当骨折办」。固定的目的是「尽量减少活动和疼痛」。冷敷「一次最多连续 20 分钟，这样可以减轻疼痛；冷得比这更久可能损伤皮肤」。「伤到股骨这类长骨时，光是骨头本身出的血就可能致命」。疼痛或者肿胀明显、有休克表现、股骨（大腿骨）骨折或者肢体位置明显不对时，应呼叫急救。折弯成角的骨折，要两个条件同时成立，才考虑在现场掰回原位（复位）。一是「地处偏远（或者条件有限），而且成角处下方的肢体发凉、发白，或者急救的人没法固定好以便搬动」。二是施救者受过训练。开放性骨折（断骨戳破皮肤）要先止血、防感染。但第一次 X 光没看出来，不等于没骨折。英国国家卫生与临床优化研究所（NICE）有一份髋部骨折指南。它写：X 光正常但仍怀疑髋部骨折的，「做磁共振（核磁）」。24 小时内做不了，就考虑做 CT。NICE 的骨折指南写：怀疑手腕舟骨骨折的，「经过仔细的体格检查后，考虑首先做磁共振」。舟骨是手腕里的一块小骨头。考克兰（Cochrane）的一篇文献汇总说：「最初的 X 光片不能排除骨折」。它收的研究里，X 光正常、医生仍怀疑舟骨骨折的人，真有骨折的比例中位数是 20%。美国放射学会有一份膝关节外伤的检查标准。它写：X 光没看到骨折，但仍怀疑有隐藏骨折或关节内部损伤的，下一步「通常适合」做磁共振。它还写，磁共振查隐藏骨折、半月板和韧带损伤都很准"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["来源"]},{"tag":"p","props":{"className":"life-citations"},"children":["International Federation of Red Cross and Red Crescent Societies (2025). International First Aid, Resuscitation and Education Guidelines 2025，第 301–302 页. ",{"tag":"a","props":{"href":"https://www.ifrc.org/sites/default/files/2026-03/IFRC%20International%20First%20Aid,%20Resuscitation%20and%20Education%20Guidelines%202025.pdf","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.ifrc.org/sites/default/files/2026-03/IFRC%20International%20First%20Aid,%20Resuscitation%20and%20Education%20Guidelines%202025.pdf"]},"；National Institute for Health and Care Excellence (2011). Hip fracture: management. NICE guideline CG124，第 1.1.1 条. ",{"tag":"a","props":{"href":"https://www.nice.org.uk/guidance/cg124/chapter/Recommendations","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.nice.org.uk/guidance/cg124/chapter/Recommendations"]},"；National Institute for Health and Care Excellence (2016). Fractures (non-complex): assessment and management. NICE guideline NG38，第 1.2.3 条. ",{"tag":"a","props":{"href":"https://www.nice.org.uk/guidance/ng38/chapter/Recommendations","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.nice.org.uk/guidance/ng38/chapter/Recommendations"]},"；Mallee WH 等 (2015). Computed tomography versus magnetic resonance imaging versus bone scintigraphy for clinically suspected scaphoid fractures in patients with negative plain radiographs. Cochrane Database of Systematic Reviews. ",{"tag":"a","props":{"href":"https://doi.org/10.1002/14651858.CD010023.pub2","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1002/14651858.CD010023.pub2"]},"；Taljanovic MS 等, Expert Panel on Musculoskeletal Imaging (2019). ACR Appropriateness Criteria: Acute Trauma to the Knee，Variant 3. American College of Radiology. ",{"tag":"a","props":{"href":"https://acsearch.acr.org/docs/69419/Narrative/","target":"_blank","rel":"noopener noreferrer"},"children":["https://acsearch.acr.org/docs/69419/Narrative/"]},""]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["原书备注"]},{"tag":"p","props":{"className":"life-citations"},"children":["定 B 是因为这些都是公认做法。送医院之前给股骨（大腿骨）骨折做牵引固定，只有一项翻旧病历的研究撑着，证据可信度很低。结果是 24 小时内输血量更少、住院更短，死亡和并发症的差别小到说不清。至于先复位（把骨头对回原位）还是原样固定，根本没找到证据。常见的误解有三个。能站能走不等于没骨折。只用冷敷不用热敷，也不要冷热交替。扭伤不会「活动开就好了」，要先歇着。骨头没长好之前别抽烟，见第 2 节第 1 条（戒烟）。别指望猛补钙、喝骨头汤让骨头长得快，见第 6 节第 30 条（骨折之后猛补钙）。老人跌倒后怀疑骨折的搬动禁忌见第 2 条。打了石膏或者卧床之后一条腿肿起来要警惕血栓，见第 11 条。治完之后要不要做伤残鉴定、要不要办残疾人证，见第 24 节第 9、10 条。"]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["我的备注"]},{"tag":"button","props":{"type":"button"},"children":["写下对自己有用的提醒…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/tip/13-40"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["上一条"]},"刀、钢筋、玻璃扎进身体，压住异物周围止血，不要把它拔出来"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/tip/13-42"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["下一条"]},"被性侵之后，先到安全的地方打 110；验伤之前别洗澡、别洗衣服、别收拾房间，72 小时内去医院"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["本主题的其他建议"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/13-36"},"children":[{"tag":"strong","props":{},"children":["荒郊野外被陌生人索财，钱给他，不动手，记特征，脱身后报警"]},{"tag":"span","props":{},"children":["钱给他，不动手，不还嘴。对方为几百块冒的是抢劫罪：三年以上十年以下起步，入户、持枪、致人重伤死亡的十年以上，直到死刑。他拿了钱转身走，你追上去打就不再算正当防卫…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/13-37"},"children":[{"tag":"strong","props":{},"children":["撞见一群人打架，退开走人，别上去拉架、别围观、别捡地上的家伙；要报警就退到安全距离打 110"]},{"tag":"span","props":{},"children":["你一动手，劝架就成了参加打架，该做的是退开走人。积极参加聚众斗殴的判 3 年以下。人多规模大、在马路上闹到秩序严重混乱、拿了家伙的，判 3 到 10 年。愿意报…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/13-38"},"children":[{"tag":"strong","props":{},"children":["可能被 HIV 暴露了，72 小时内去拿阻断药，越早越好"]},{"tag":"span","props":{},"children":["怀疑自己可能接触了艾滋病病毒，72 小时是硬线，最好 2 小时内就吃上药。药要连吃 28 天。超过 72 小时这条路就没了，所以别等到第二天再决定。"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/13-39"},"children":[{"tag":"strong","props":{},"children":["救人受了伤、搭进了钱，先找加害人和医保，再去申报见义勇为确认"]},{"tag":"span","props":{},"children":["救人把自己搭进去，不用自认倒霉。见义勇为负伤的先救治、后收费，医疗费由加害人出，人跑了或者赔不起的走基本医保。没有加害人的，你提出来，被你救下的人依法应当给适当…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/13-43"},"children":[{"tag":"strong","props":{},"children":["不满 1 岁的婴儿噎住哭不出声，趴着拍背 5 下、翻过来按胸口 5 下，轮着做，别按肚子"]},{"tag":"span","props":{},"children":["孩子还能咳、能哭出声，就让他自己咳，你在旁边盯着。哭不出声、脸发紫，就让人打 120。你把孩子脸朝下趴在前臂上，用掌根在两块肩胛骨中间拍 5 下，没出来就翻过来…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/13-44"},"children":[{"tag":"strong","props":{},"children":["不满 1 岁的婴儿没反应、没正常呼吸，开免提打 120，做婴儿心肺复苏：按 30 下吹 2 口气"]},{"tag":"span","props":{},"children":["拍脚底没反应、没正常呼吸，就开免提打 120，手不停。双手环抱胸口、两个拇指按，抱不住就用一只手的掌根，按约 4 厘米深，每秒约 2 下。每按 30 下，嘴包住…"]}]}]}]},{"tag":"a","props":{"className":"life-text-link","href":"/book/13"},"children":["阅读整个主题：紧急情况：先做什么 ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"15","height":"15","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]}]}]},{"tag":"nav","props":{"className":"life-tabbar","aria-label":"主导航"},"children":[{"tag":"a","props":{"className":"","href":"/book"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"21","height":"21","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-book-open","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M12 7v14"},"children":[]},{"tag":"path","props":{"d":"M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z"},"children":[]}]},{"tag":"span","props":{},"children":["全书"]}]},{"tag":"a","props":{"className":"","href":"/top-50"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"21","height":"21","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round