w.w3.org/2000/svg","width":"18","height":"18","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-up-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M7 7h10v10"},"children":[]},{"tag":"path","props":{"d":"M7 17 17 7"},"children":[]}]}]}]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/en/book/09"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"Back to index"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["Legal pitfalls that ordinary people often overlook"]},{"tag":"div","props":{"data-ad-dock-host":"true"},"children":[]},{"tag":"nav","props":{"aria-label":"Chapter entries"},"children":[{"tag":"a","props":{"href":"/en/tip/09-01"},"children":[{"tag":"span","props":{},"children":["01"]},"Do not share unverified messages about disasters, epidemics, or police incidents in groups; do not photoshop images or use AI to generate fake scene pictures"]},{"tag":"a","props":{"href":"/en/tip/09-02"},"children":[{"tag":"span","props":{},"children":["02"]},"Do not post, share, or comment images, memes, or remarks that insult heroes and martyrs, nor make jokes about the national flag or anthem"]},{"tag":"a","props":{"href":"/en/tip/09-03"},"children":[{"tag":"span","props":{},"children":["03"]},"After viewing content on foreign websites, simply close the page — do not screenshot, share, repost, or discuss it in any groups or comment sections"]},{"tag":"a","props":{"href":"/en/tip/09-04"},"children":[{"tag":"span","props":{},"children":["04"]},"Watching porn alone is fine, but don’t post it in groups, sell “resources,” or create groups"]},{"tag":"a","props":{"href":"/en/tip/09-05"},"children":[{"tag":"span","props":{},"children":["05"]},"Part-time jobs that ask you to use your own card to receive payments, withdraw cash, or transfer money — no matter how much extra pay they offer, avoid them"]},{"tag":"a","props":{"href":"/en/tip/09-06"},"children":[{"tag":"span","props":{},"children":["06"]},"Some people try to get you to “package loan applicants” for them and offer a commission based on the loan amount — don’t fall for it"]},{"tag":"a","props":{"href":"/en/tip/09-07"},"children":[{"tag":"span","props":{},"children":["07"]},"Keeping found items and not using them for personal gain; returning lost phones, wallets, or cash to owners or police"]},{"tag":"a","props":{"href":"/en/tip/09-08"},"children":[{"tag":"span","props":{},"children":["08"]},"Use your real identity to claim discounts — don’t register fake accounts or exploit loopholes to get more"]},{"tag":"a","props":{"href":"/en/tip/09-09"},"children":[{"tag":"span","props":{},"children":["09"]},"Never throw anything from balconies or windows — cigarette butts, trash bags, and bottles all count"]},{"tag":"a","props":{"href":"/en/tip/09-10"},"children":[{"tag":"span","props":{},"children":["10"]},"Do not buy imitation guns, BB guns, or air rifles online; avoid “toy guns” of unknown origin"]},{"tag":"a","props":{"href":"/en/tip/09-11"},"children":[{"tag":"span","props":{},"children":["11"]},"Register drones with your real name first; never fly near airports, military zones, or restricted urban airspace, and don’t tamper with altitude limits"]},{"tag":"a","props":{"href":"/en/tip/09-12"},"children":[{"tag":"span","props":{},"children":["12"]},"Do not secretly film others, nor install cameras in rented apartments, homestays, or hotel rooms"]},{"tag":"a","props":{"href":"/en/tip/09-13"},"children":[{"tag":"span","props":{},"children":["13"]},"Mahjong and poker can be played — no rake, no banker role, no organizing paid games, no online gambling"]},{"tag":"a","props":{"href":"/en/tip/09-14"},"children":[{"tag":"span","props":{},"children":["14"]},"Do not eat wild animals; do not buy, sell, or keep protected species as pets"]},{"tag":"a","props":{"href":"/en/tip/09-15"},"children":[{"tag":"span","props":{},"children":["15"]},"You cannot detain or confine someone to collect a debt, nor follow them home and refuse to leave"]},{"tag":"a","props":{"href":"/en/tip/09-16"},"children":[{"tag":"span","props":{},"children":["16"]},"Do not lend your ID card, do not use someone else’s ID card, and do not register, open accounts, or buy tickets using another person’s documents"]},{"tag":"a","props":{"href":"/en/tip/09-17"},"children":[{"tag":"span","props":{},"children":["17"]},"Cooperate when stopped or taken away by police — don’t push, hit, or grab their body cameras; especially if you’ve been drinking, stay calm"]},{"tag":"a","props":{"href":"/en/tip/09-18"},"children":[{"tag":"span","props":{},"children":["18"]},"Sexual relations with anyone under 14 are illegal; “she consented” is not a defense"]},{"tag":"a","props":{"href":"/en/tip/09-19"},"children":[{"tag":"span","props":{},"children":["19"]},"Do the math before you hit someone: detention, fines, and prison time"]},{"tag":"a","props":{"href":"/en/tip/09-20"},"children":[{"tag":"span","props":{},"children":["20"]},"If parents cannot care for their newborn, the only legal option is to register the adoption with the civil affairs bureau: paying someone to hand over the child may be prosecuted as child trafficking, while abandoning the child constitutes abandonment"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/en/tip/09-21","data-status":"active"},"children":[{"tag":"span","props":{},"children":["21"]},"Don’t fabricate accidents or exaggerate damages to defraud insurance payouts: this is insurance fraud, and anyone helping you testify, assess damage, or repair your vehicle is equally liable"]},{"tag":"a","props":{"href":"/en/tip/09-22"},"children":[{"tag":"span","props":{},"children":["22"]},"Don’t sell your own organs, and don’t help others find donors: a kidney brings in just over $20,000, but the same kidney can be sold to a patient for $200,000. All proceeds are seized, plus a fine of 10–20 times the transaction amount"]},{"tag":"a","props":{"href":"/en/tip/09-23"},"children":[{"tag":"span","props":{},"children":["23"]},"Don’t engage in prostitution: the default penalty is 10–15 days in detention, not just a fine"]},{"tag":"a","props":{"href":"/en/tip/09-24"},"children":[{"tag":"span","props":{},"children":["24"]},"Distributing unauthorized Chinese-dubbed comics, pirated movies/TV shows, cloud storage links, and pirated e-books — even for free — is illegal; adding ads or charging membership fees can lead to criminal charges"]},{"tag":"a","props":{"href":"/en/tip/09-25"},"children":[{"tag":"span","props":{},"children":["25"]},"To publish or monetize fan works, first obtain permission from the original copyright holder, or replace the borrowed characters’ names and relationships with your own"]},{"tag":"a","props":{"href":"/en/tip/09-26"},"children":[{"tag":"span","props":{},"children":["26"]},"Do not buy and carry batons, stun devices, daggers, or pepper spray for self-defense; keeping them in your car also counts as carrying"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"Breadcrumb"},"children":[{"tag":"a","props":{"href":"/en/book"},"children":["Explore the book"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/en/book/09"},"children":["Chapter 9"," ·"," ","Legal pitfalls that ordinary people often overlook"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"09-21"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["21"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["Evidence"," ","A"]}]},{"tag":"h1","props":{"lang":"en"},"children":["Don’t fabricate accidents or exaggerate damages to defraud insurance payouts: this is insurance fraud, and anyone helping you testify, assess damage, or repair your vehicle is equally liable"]},{"tag":"p","props":{"lang":"en","className":"life-entry-summary"},"children":["Deliberately fabricating an accident or inflating the extent of damage to obtain insurance money is a criminal act of insurance fraud. If the amount involved is relatively large, the offender faces up to five years in prison and a fine ranging from 10,000 to 100,000 yuan. Even seeking outside help does not exempt you from liability: anyone who provides false testimony, damage assessments, or property evaluations to assist in the fraud is treated as an accomplice and prosecuted alongside you. In a case from Xuancheng, Anhui, eight individuals including Wang were sentenced to between two and four years in prison and fined 10,000 yuan each. The judgment in this case was issued on September 26, 2019."]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Cost"]},{"tag":"p","props":{},"children":["There is no cost and no time required. All you have to do…"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Benefit"]},{"tag":"p","props":{},"children":["Article 198 of the Criminal Law outlines five specific scenarios constituting insurance fraud. (1) The policyh…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"Mark: Don’t fabricate accidents or exaggerate damages to defraud insurance payouts: this is insurance fraud, and anyone helping you testify, assess damage, or repair your vehicle is equally liable"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"Done"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"Plan to do"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"Save"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Share this tip"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Hide details"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Cost"]},{"tag":"p","props":{},"children":["There is no cost and no time required. All you have to do is simply refrain from committing this act."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Benefit"]},{"tag":"p","props":{},"children":["Article 198 of the Criminal Law outlines five specific scenarios constituting insurance fraud. (1) The policyholder invents a completely nonexistent insured object. (2) The policyholder, insured, or beneficiary fabricates false causes for an actual accident or exaggerates its impact. (3) An accident that never occurred is falsely reported. (4) The policyholder or insured deliberately causes property damage to trigger a claim. (5) The policyholder or beneficiary intentionally causes the death, injury, or illness of the insured. For relatively large sums, offenders receive up to five years in prison and a fine of 10,000–100,000 yuan; for significantly larger sums or severe circumstances, the sentence rises to 5–10 years with a 20,000–200,000 yuan fine; for especially massive sums or grave consequences, the penalty exceeds ten years, with fines up to 200,000 yuan or confiscation of assets. This same article also holds any third parties who knowingly issue false documentation to facilitate fraud accountable as accomplices. Article 27 of the Insurance Law stipulates that insurers may void contracts and withhold premiums if false claims are filed without any actual incident. Should fraudulent documentation or exaggerated damage claims be submitted, insurers are not obligated to pay for the inflated portion and may demand repayment of any prior payouts. In a notable case, eight individuals were convicted of insurance fraud and fined 10,000 yuan each after a court overturned an earlier ruling that awarded over 70,000 yuan in compensation; the original judgment had been secured through forged vehicle transfer documents. The Anti-Insurance Fraud Measures, issued on July 31, 2024, mandate that both underwriting and claims departments actively monitor risk indicators while developing industry-wide fraud detection platforms and intelligence hubs. These systems are designed to flag suspicious patterns, which are then investigated by professional associations, anti-fraud agencies, and insurers. Cases suspected of criminal intent must be reported to law enforcement, while regulatory authorities are required to strengthen coordination between administrative enforcement and criminal prosecution."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Original sources"]},{"tag":"p","props":{"className":"life-citations"},"children":["全国人大常委会. 中华人民共和国刑法（经刑法修正案十一修正的整合文本）第一百九十八条. ",{"tag":"a","props":{"href":"https://flk.npc.gov.cn/detail?id=ff808181796a636a0179822a19640c92","target":"_blank","rel":"noopener noreferrer"},"children":["https://flk.npc.gov.cn/detail?id=ff808181796a636a0179822a19640c92"]},"；全国人大常委会 (2015 修正). 中华人民共和国保险法第二十七条. ",{"tag":"a","props":{"href":"https://flk.npc.gov.cn/detail?id=2c909fdd678bf17901678bf7c4060811","target":"_blank","rel":"noopener noreferrer"},"children":["https://flk.npc.gov.cn/detail?id=2c909fdd678bf17901678bf7c4060811"]},"；国家金融监督管理总局 (2024). 关于印发《反保险欺诈工作办法》的通知. ",{"tag":"a","props":{"href":"https://www.gov.cn/gongbao/2024/issue_11586/202409/content_6975080.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/gongbao/2024/issue_11586/202409/content_6975080.html"]},"；安徽省人民检察院转载《法制日报》(2020-01-13). 杀妻骗保牵出案中案. ",{"tag":"a","props":{"href":"http://www.ah.jcy.gov.cn/jczt/jjslhyqkjc/mtjj/202001/t20200113_2758841.shtml","target":"_blank","rel":"noopener noreferrer"},"children":["http://www.ah.jcy.gov.cn/jczt/jjslhyqkjc/mtjj/202001/t20200113_2758841.shtml"]}]},{"tag":"a","props":{"href":"https://flk.npc.gov.cn/detail?id=ff808181796a636a0179822a19640c92","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Open source link"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Book note"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["Several seemingly harmless practices actually fall under these five categories. For instance, asking a repair shop to overstate repair costs after a minor accident, attributing pre-existing damage to the incident, staging a collision with a friend, or fabricating an accident entirely. Regarding auto insurance, refer to Section 5, Article 26 for optimal coverage levels. In cases involving intentional harm to insured family members, multiple charges apply, as detailed in Section 8, Article 38. Separate regulations govern medical insurance fraud: unauthorized use of yibao (basic medical insurance) cards or illicitly withdrawing funds from personal medical accounts is also classified as fraud, as noted in Section 5, Article 13."]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["My note"]},{"tag":"button","props":{"type":"button"},"children":["Write a reminder for yourself…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/en/tip/09-20"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Previous"]},"If parents cannot care for their newborn, the only legal option is to register the adoption with the civil affairs bureau: paying someone to hand over the child may be prosecuted as child trafficking, while abandoning the child constitutes abandonment"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/en/tip/09-22"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Next"]},"Don’t sell your own organs, and don’t help others find donors: a kidney brings in just over $20,000, but the same kidney can be sold to a patient for $200,000. All proceeds are seized, plus a fine of 10–20 times the transaction amount"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["More in this topic"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/en/tip/09-17"},"children":[{"tag":"strong","props":{},"children":["Cooperate when stopped or taken away by police — don’t push, hit, or grab their body cameras; especially if you’ve been drinking, stay calm"]},{"tag":"span","props":{},"children":["Simply refusing to comply with police orders can result in a warning …"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/en/tip/09-18"},"children":[{"tag":"strong","props":{},"children":["Sexual relations with anyone under 14 are illegal; “she consented” is not a defense"]},{"tag":"span","props":{},"children":["Any sexual conta