ype":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"加入待做"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"收藏"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"分享这条建议"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"收起详情"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["成本"]},{"tag":"p","props":{},"children":["一副护目镜加一个面屏，几十元。每次开机前看一眼护罩和片子，换片前拔掉插头，多花一两分钟。难在嫌麻烦时也不拆护罩、不单手干活。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["收益"]},{"tag":"p","props":{},"children":["加拿大职业健康与安全中心和澳大利亚昆士兰州的安全机构列的做法如下。开机前检查护罩和片子，有裂纹、缺口、变形的不用。片子上标的最高转速，不能低于机器上标的转速。片子的直径和中间的孔要和机器配套。换片前断开电源。要磨要切的东西先固定住。戴防护眼镜或护目镜，外面再加面屏。双手握住两个手柄，脚下站稳。切割片不能拿来打磨，那样片子更容易碎。片子完全停转之前不把机器放下。火花和碎屑朝向没人的地方，周围不放易燃的东西。昆士兰的通报说，切割片边缘的设计速度约为每秒 70 米。把 356 毫米的大片装到 230 毫米的机器上，边缘速度至少到每秒 120 米，片子容易碎。2016 年 2 月，当地一名工人用 230 毫米的角磨机时被碎片击中胸部，内伤死亡。国内有两份事故调查报告。2019 年哈尔滨一名工人把切割片换成带齿锯片，没装护罩就去切木板。锯片卷住裤子，割断大腿动脉，失血死亡。2024 年深圳福田一名工人用装着木工锯片、没装护罩和辅助手柄的角磨机切木门框。机器反弹，割破颈动脉死亡。报告引用的国家标准写着「不要附装上锯链、木雕刀片或带齿锯片」。韩国 2011 到 2018 年的急诊伤害监测里，被高速旋转的切割工具弄伤的有 8697 人次，其中 4603 人次在用砂轮机这一类工具。他们伤在手上的占 46.4%，伤在头部的占 23.0%。和其他同类工具比，砂轮机伤成重伤的可能高约一倍（OR 2.07，95% CI 1.88–2.29）。四川绵阳一家医院两年收治 36 名角磨机伤眼的住院病人。手术后戴上眼镜的最好视力仍低于 0.05 的有 10 人。土耳其一家医院一年的 742 例手和前臂急性外伤里，角磨机造成 82 例。除 8 例外都不是上班时伤的，44% 是退休的人。日本一家创伤中心 2017 到 2018 年的 15 名角磨机伤者里，9 人是装上锯片切木头这类错用。其中 2 人整根手指断掉，1 人断了一截（加拿大、澳大利亚 / 中国 / 韩国、土耳其、日本）"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["原始出处"]},{"tag":"p","props":{"className":"life-citations"},"children":["Canadian Centre for Occupational Health and Safety (2025). Abrasive Wheels - Use of Portable Grinders. ",{"tag":"a","props":{"href":"https://www.ccohs.ca/oshanswers/safety_haz/abrasive_wheels/safeuse1.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.ccohs.ca/oshanswers/safety_haz/abrasive_wheels/safeuse1.html"]},"；Canadian Centre for Occupational Health and Safety (2025). Powered Hand Tools - Use of Grinder Attachments. ",{"tag":"a","props":{"href":"https://www.ccohs.ca/oshanswers/safety_haz/power_tools/powered-hand-tools-use-of-grinder-attachments.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.ccohs.ca/oshanswers/safety_haz/power_tools/powered-hand-tools-use-of-grinder-attachments.html"]},"；Workplace Health and Safety Queensland (2017). Guards and discs on angle grinders. ",{"tag":"a","props":{"href":"https://www.worksafe.qld.gov.au/news-and-events/alerts/workplace-health-and-safety-alerts/2017/guards-and-discs-on-angle-grinders","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.worksafe.qld.gov.au/news-and-events/alerts/workplace-health-and-safety-alerts/2017/guards-and-discs-on-angle-grinders"]},"；哈尔滨市松北区人民政府 (2019). 哈尔滨三发装卸运输有限公司「8.28」机械伤害事故调查报告. ",{"tag":"a","props":{"href":"https://www.songbei.gov.cn/hebsbq/tzgg/201910/c01_797872.shtml","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.songbei.gov.cn/hebsbq/tzgg/201910/c01_797872.shtml"]},"；福田区人民政府沙头新洲南村房屋装修工程「3·14」一般机械伤害事故调查组 (2024). 沙头新洲南村房屋装修工程「3·14」一般机械伤害事故调查报告（引 GB 3883.3-2007 第 8.12.1.102 条 a、e 项）. ",{"tag":"a","props":{"href":"https://www.szft.gov.cn/attachment/1/1507/1507749/11317197.pdf","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.szft.gov.cn/attachment/1/1507/1507749/11317197.pdf"]},"；Song J, Jeon YB, Jang JH, Cho JS, Choi JY, Choi WS. (2023). Severity of grinder injuries and related factors compared with other high-rotation cutting tool injuries: a multicenter retrospective study from 2011 to 2018. Journal of Trauma and Injury, 36(1), 32-38. ",{"tag":"a","props":{"href":"https://doi.org/10.20408/jti.2021.0057","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.20408/jti.2021.0057"]},"；Ke W, Gu K, Zhu S, Wu J, Dai Y. (2025). Prognostics Factors to Avoid Eye Injuries in Angle Grinders. Journal of Craniofacial Surgery, 36(6), e629-e631. ",{"tag":"a","props":{"href":"https://doi.org/10.1097/scs.0000000000011108","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1097/scs.0000000000011108"]},"；Sozbilen MC, Dastan AE, Gunay H, Kucuk L. (2018). A prospective study of angle grinder injuries in the hands and forearms during a one-year period. Hand Surgery and Rehabilitation, 37(5), 300-304. ",{"tag":"a","props":{"href":"https://doi.org/10.1016/j.hansur.2018.07.002","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1016/j.hansur.2018.07.002"]},"；Tsumura T, Matsumoto T, Matsushita M, Kishimoto K, Shiode H. (2021). Do Not Cut Wood with an Angle Grinder, or You Might Lose a Finger: A Retrospective Study. Journal of Hand Surgery Asian-Pacific Volume. ",{"tag":"a","props":{"href":"https://doi.org/10.1142/s2424835521500053","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1142/s2424835521500053"]}]},{"tag":"a","props":{"href":"https://www.ccohs.ca/oshanswers/safety_haz/abrasive_wheels/safeuse1.html","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["打开来源链接"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["原书备注"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["给 C 是因为这些做法来自安全机构的指南和事故调查，没有研究算过照做能少伤多少人。伤情数据只说明伤得多重，而且都是一家医院或一个国家的病例。收益量级定为中，凭的是判断：后果可以是死亡、失明、断指，但只落在用角磨机的人身上。哈尔滨那台机器的说明书本来就写着不要装带齿锯片、必须装护罩。那名工人手边就有手锯，切木头该用它这类木工工具。宽松衣服、垂下来的首饰和长头发都要收好，会被卷进去。磨的时候粉尘和噪声都大，口罩和耳塞的讲究见第 19 节第 10 条（防护用品单位必须给）。真割破了大血管，先死死压住伤口，见第 13 节第 12 条（大出血先用手死死压住伤口）。受益人主要是你自己，也护住站在旁边帮忙的家人。"]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["我的备注"]},{"tag":"button","props":{"type":"button"},"children":["写下对自己有用的提醒…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/tip/01-41"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["上一条"]},"上野外冰面前先打孔量厚度，不到 15 厘米别上，河上的冰和冰钓洞边别去"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/tip/01-43"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["下一条"]},