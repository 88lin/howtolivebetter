ight":"18","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-up-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M7 7h10v10"},"children":[]},{"tag":"path","props":{"d":"M7 17 17 7"},"children":[]}]}]}]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/en/book/05"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"Back to index"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["Don’t waste money"]},{"tag":"div","props":{"data-ad-dock-host":"true"},"children":[]},{"tag":"nav","props":{"aria-label":"Chapter entries"},"children":[{"tag":"a","props":{"href":"/en/tip/05-01"},"children":[{"tag":"span","props":{},"children":["01"]},"Turn off all automatic renewals and switch to manual renewal upon expiry"]},{"tag":"a","props":{"href":"/en/tip/05-02"},"children":[{"tag":"span","props":{},"children":["02"]},"Conduct the annual tax reconciliation from March to June; be sure to include all eligible special deductions"]},{"tag":"a","props":{"href":"/en/tip/05-03"},"children":[{"tag":"span","props":{},"children":["03"]},"Housing provident fund isn’t just for buying a home: it can be used for renting, home renovations, and paying property taxes, effective from September 20, 2026 under new regulations"]},{"tag":"a","props":{"href":"/en/tip/05-04"},"children":[{"tag":"span","props":{},"children":["04"]},"Recalculate your mobile and broadband plans annually: downgrade unused services, and file a complaint if the carrier refuses to comply"]},{"tag":"a","props":{"href":"/en/tip/05-05"},"children":[{"tag":"span","props":{},"children":["05"]},"Not buying lottery tickets"]},{"tag":"a","props":{"href":"/en/tip/05-06"},"children":[{"tag":"span","props":{},"children":["06"]},"Walk away the moment you see “high returns,” “guaranteed returns,” or “sure profits”"]},{"tag":"a","props":{"href":"/en/tip/05-07"},"children":[{"tag":"span","props":{},"children":["07"]},"Avoid making minimum payments on credit cards, and never sign up for installment plans or consumer loans for purchases; if borrowing is unavoidable, first convert the interest rate to an annual percentage rate before comparing options"]},{"tag":"a","props":{"href":"/en/tip/05-08"},"children":[{"tag":"span","props":{},"children":["08"]},"Don’t give streamers tips, don’t make in‑game purchases, and don’t make impulsive buys"]},{"tag":"a","props":{"href":"/en/tip/05-09"},"children":[{"tag":"span","props":{},"children":["09"]},"When kids make in-app purchases or send gifts, parents can demand refunds for large sums spent by kids over eight if they never gave consent"]},{"tag":"a","props":{"href":"/en/tip/05-10"},"children":[{"tag":"span","props":{},"children":["10"]},"Teaching kids one key phrase: anyone who asks them to use a parent’s phone to enter verification codes is a scammer"]},{"tag":"a","props":{"href":"/en/tip/05-11"},"children":[{"tag":"span","props":{},"children":["11"]},"Skipping extended warranties for electronics"]},{"tag":"a","props":{"href":"/en/tip/05-12"},"children":[{"tag":"span","props":{},"children":["12"]},"Prefer generic drugs that have passed consistency evaluation and those selected in centralized procurement"]},{"tag":"a","props":{"href":"/en/tip/05-13"},"children":[{"tag":"span","props":{},"children":["13"]},"Once you set up family medical expense sharing in the yibao app, funds from your individual medical insurance account can be used to pay for your spouse, parents, and children’s medical care and medication"]},{"tag":"a","props":{"href":"/en/tip/05-14"},"children":[{"tag":"span","props":{},"children":["14"]},"Drink boiled tap water instead of routinely ordering large water-dispenser bottles or buying small bottled water"]},{"tag":"a","props":{"href":"/en/tip/05-15"},"children":[{"tag":"span","props":{},"children":["15"]},"Infrequent stock trading"]},{"tag":"a","props":{"href":"/en/tip/05-16"},"children":[{"tag":"span","props":{},"children":["16"]},"Don’t borrow money to invest, avoid leverage, and never buy assets you don’t understand"]},{"tag":"a","props":{"href":"/en/tip/05-17"},"children":[{"tag":"span","props":{},"children":["17"]},"Using broad-market index funds instead of actively managed funds as a long-term core holding (the portion of money you keep invested for years)"]},{"tag":"a","props":{"href":"/en/tip/05-18"},"children":[{"tag":"span","props":{},"children":["18"]},"When picking similar funds, go for those with lower fees"]},{"tag":"a","props":{"href":"/en/tip/05-19"},"children":[{"tag":"span","props":{},"children":["19"]},"Don’t put all your money into one stock, one platform, or one property"]},{"tag":"a","props":{"href":"/en/tip/05-20"},"children":[{"tag":"span","props":{},"children":["20"]},"Individuals paying income tax at a rate of 10% or higher can open a private pension account; up to 12,000 yuan per year can be deducted from taxable income. For those paying no tax or only a 3% rate, opening such an account is not worthwhile"]},{"tag":"a","props":{"href":"/en/tip/05-21"},"children":[{"tag":"span","props":{},"children":["21"]},"Paying for gym visits individually or on short-term plans is only worthwhile if you have a consistent attendance record spanning over a year"]},{"tag":"a","props":{"href":"/en/tip/05-22"},"children":[{"tag":"span","props":{},"children":["22"]},"Sign a written contract before paying a deposit; if a business faces risks, it must stop taking payments, and you have the right to get back any unused balance if it shuts down"]},{"tag":"a","props":{"href":"/en/tip/05-23"},"children":[{"tag":"span","props":{},"children":["23"]},"Implementing a 24-hour cooling-off period for non-essential big-ticket purchases; making full use of the seven-day no-questions-asked return policy for online shopping"]},{"tag":"a","props":{"href":"/en/tip/05-24"},"children":[{"tag":"span","props":{},"children":["24"]},"Don’t fall for “strikethrough prices” or impulse buying during sales"]},{"tag":"a","props":{"href":"/en/tip/05-25"},"children":[{"tag":"span","props":{},"children":["25"]},"It’s better to choose a non‑return insurance plan and treat any “refunds” or dividends as non‑guaranteed benefits"]},{"tag":"a","props":{"href":"/en/tip/05-26"},"children":[{"tag":"span","props":{},"children":["26"]},"Get sufficient third‑party liability coverage: the mandatory insurance limits are uniform nationwide and relatively low, so any excess must be paid out of your own pocket"]},{"tag":"a","props":{"href":"/en/tip/05-27"},"children":[{"tag":"span","props":{},"children":["27"]},"Set aside an emergency fund equal to 3–6 months of living expenses in a readily accessible account"]},{"tag":"a","props":{"href":"/en/tip/05-28"},"children":[{"tag":"span","props":{},"children":["28"]},"Run a quick comparison before paying off your mortgage — don’t rely on gut feeling"]},{"tag":"a","props":{"href":"/en/tip/05-29"},"children":[{"tag":"span","props":{},"children":["29"]},"When shopping online, follow platform rules and laws — not influencers or “positive reviews”"]},{"tag":"a","props":{"href":"/en/tip/05-30"},"children":[{"tag":"span","props":{},"children":["30"]},"If something goes wrong after buying from a livestream, first ask the platform for the seller’s and influencer’s details — they’re required to provide them"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/en/tip/05-31","data-status":"active"},"children":[{"tag":"span","props":{},"children":["31"]},"If you buy unsafe food, you can demand ten times the purchase price as compensation; if the amount is under 1,000 yuan, you’re still entitled to 1,000 yuan"]},{"tag":"a","props":{"href":"/en/tip/05-32"},"children":[{"tag":"span","props":{},"children":["32"]},"Check national inspection reports, 3C certification, and energy labels before buying big-ticket items"]},{"tag":"a","props":{"href":"/en/tip/05-33"},"children":[{"tag":"span","props":{},"children":["33"]},"Bracelets, jade, luxury watches, and collectibles should be judged by “how much you spend” rather than “how much you save”"]},{"tag":"a","props":{"href":"/en/tip/05-34"},"children":[{"tag":"span","props":{},"children":["34"]},"For jewelry and gemstones, only test reports bearing the CMA mark are acceptable; you must also verify the issuing agency on the regulator’s official website"]},{"tag":"a","props":{"href":"/en/tip/05-35"},"children":[{"tag":"span","props":{},"children":["35"]},"Random sales such as blind boxes and gacha games are treated as “money that won’t come back”"]},{"tag":"a","props":{"href":"/en/tip/05-36"},"children":[{"tag":"span","props":{},"children":["36"]},"If you care about what’s in your food, buy pre-packaged products: loose goods at retail counters aren’t legally required to list ingredients"]},{"tag":"a","props":{"href":"/en/tip/05-37"},"children":[{"tag":"span","props":{},"children":["37"]},"Stocks that have lost value should also be sold according to pre‑set rules — don’t try to even out costs by buying more"]},{"tag":"a","props":{"href":"/en/tip/05-38"},"children":[{"tag":"span","props":{},"children":["38"]},"Planning to invest in overseas assets such as U.S. stocks? Use QDII funds or the Hong Kong Stock Connect program — don’t open accounts with foreign brokers, and don’t use your annual foreign exchange quota for buying foreign stocks"]},{"tag":"a","props":{"href":"/en/tip/05-39"},"children":[{"tag":"span","props":{},"children":["39"]},"Only buy insurance for losses your savings can’t cover; use an emergency fund for losses you can afford"]},{"tag":"a","props":{"href":"/en/tip/05-40"},"children":[{"tag":"span","props":{},"children":["40"]},"If someone at home depends on your income, buy term life insurance for the breadwinner first — not for your kids"]},{"tag":"a","props":{"href":"/en/tip/05-41"},"children":[{"tag":"span","props":{},"children":["41"]},"Regretting a personal insurance policy signed for over a year? You can cancel it during the cooling-off period and get most of your premium back"]},{"tag":"a","props":{"href":"/en/tip/05-42"},"children":[{"tag":"span","props":{},"children":["42"]},"Before signing at the bank counter, check whether it’s a deposit or insurance"]},{"tag":"a","props":{"href":"/en/tip/05-43"},"children":[{"tag":"span","props":{},"children":["43"]},"To cancel your insurance policy, contact the insurer directly — don’t use “policy cancellation agents.” If you feel misled, call 12378 for free assistance"]},{"tag":"a","props":{"href":"/en/tip/05-44"},"children":[{"tag":"span","props":{},"children":["44"]},"Writing a specific beneficiary on the policy lets family claim the payout: 5 years for life insurance, 2 years for other policies"]},{"tag":"a","props":{"href":"/en/tip/05-45"},"children":[{"tag":"span","props":{},"children":["45"]},"Do not buy cryptocurrencies such as Bitcoin or Tether, or join others’ investment schemes: trades lack legal protection, and suing will not recover investment losses"]},{"tag":"a","props":{"href":"/en/tip/05-46"},"children":[{"tag":"span","props":{},"children":["46"]},"If you have no employer, pay into China’s employee pension scheme yourself at the lowest contribution tier and first meet the minimum contribution period; even at the lowest tier, it takes about 10 years of pension payments to recover the cost"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"Breadcrumb"},"children":[{"tag":"a","props":{"href":"/en/book"},"children":["Explore the book"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/en/book/05"},"children":["Chapter 5"," ·"," ","Don’t waste money"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"05-31"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["31"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["Evidence"," ","A"]}]},{"tag":"h1","props":{"lang":"en"},"children":["If you buy unsafe food, you can demand ten times the purchase price as compensation; if the amount is under 1,000 yuan, you’re still entitled to 1,000 yuan"]},{"tag":"p","props":{"lang":"en","className":"life-entry-summary"},"children":["If you buy expired or spoiled food, the food itself, its packaging, and the receipt serve as evidence — so don’t toss them out. You’re entitled to compensation equal to ten times the purchase price or three times your actual loss; if that amount is less than 1,000 yuan, you still get 1,000 yuan. You may choose either the seller or the manufacturer to compensate you; the party you approach must pay first and cannot shift the responsibility to the other side."]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Cost"]},{"tag":"p","props":{},"children":["There’s no cost involved. Keep the food, its packaging, an…"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Benefit"]},{"tag":"p","props":{},"children":["If you suffer harm due to food that fails to meet safety standards, you may seek compensation from either the…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"Mark: If you buy unsafe food, you can demand ten times the purchase price as compensation; if the amount is under 1,000 yuan, you’re still entitled to 1,000 yuan"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"Done"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"Plan to do"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"Save"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Share this tip"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Hide details"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Cost"]},{"tag":"p","props":{},"children":["There’s no cost involved. Keep the food, its packaging, and the receipt — don’t throw them away or wash them, and take photos right away. First try to negotiate with the seller or platform; if that fails, call 12315. Filing a lawsuit can take several months. The hard part is resisting the urge to discard the items first."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Benefit"]},{"tag":"p","props":{},"children":["If you suffer harm due to food that fails to meet safety standards, you may seek compensation from either the seller or the producer. The party receiving your compensation request must assume primary responsibility and pay out immediately, without shifting liability. In addition to basic compensation, you can demand ten times the purchase price or three times your loss as punitive damages, with any amount below 1,000 yuan rounded up to 1,000 yuan. One exception applies: this does not cover cases where labeling or instructions contain minor flaws that do not affect safety or mislead consumers. Judicial interpretations set three key conditions: the purchase must be for personal or household use; the food must violate safety standards; and there must be no proof the buyer knew of those violations at the time of purchase. Only then can ten times the purchase price be claimed as punitive damages. Conversely, if a buyer knowingly purchases substandard food and then seeks compensation, courts will only support claims within reasonable household consumption limits. Repeated purchases or multiple lawsuits are evaluated as a single total amount. Certain labeling issues — such as irregular font sizes, typos, or non‑standard net‑weight indications — generally do not qualify for punitive damages provided they do not mislead consumers about safety."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Original sources"]},{"tag":"p","props":{"className":"life-citations"},"children":["全国人大常委会 (2025 年第三次修正). 食品安全法（第一百四十八条）. ",{"tag":"a","props":{"href":"https://flk.npc.gov.cn/detail?id=7b5a76d0461745a08d3f964916b87ef3","target":"_blank","rel":"noopener noreferrer"},"children":["https://flk.npc.gov.cn/detail?id=7b5a76d0461745a08d3f964916b87ef3"]},"（国家法律法规数据库，2025 年 12 月 1 日起施行）；最高人民法院 (2024). 关于审理食品药品惩罚性赔偿纠纷案件适用法律若干问题的解释（法释〔2024〕9 号，第一、六、七、八、十二、十三、十四、十五、十六条，2024 年 8 月 22 日起施行）. ",{"tag":"a","props":{"href":"http://gongbao.court.gov.cn/Details/bf531a70471f10d377788f28d3d8f8.html","target":"_blank","rel":"noopener noreferrer"},"children":["http://gongbao.court.gov.cn/Details/bf531a70471f10d377788f28d3d8f8.html"]},"（最高人民法院公报）"]},{"tag":"a","props":{"href":"https://flk.npc.gov.cn/detail?id=7b5a76d0461745a08d3f964916b87ef3","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Open source link"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Book note"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["The order of evidence matters more than the amount of compensation. Take photos and videos showing the packaging, production date, any foreign objects, and the purchase record before contacting the seller or platform; do not discard or wash the items beforehand. 12315 provides mediation, not binding rulings. If the seller refuses to cooperate, litigation becomes the only option — see Section 8, Article 22 for rules on small‑claims litigation involving online or second‑hand purchases. Whether foreign objects like hair or insects qualify as violations of food safety standards must be determined by regulatory authorities or through testing; simply finding hair in food does not automatically guarantee 1,000 yuan in compensation. For ordinary consumer fraud, triple compensation applies, with amounts under 500 yuan rounded up to 500 yuan — see Section 8, Article 29. Those producing and selling food must comply with licensing, labeling, and legal restrictions on health claims; details appear in Section 12, Articles 8–11. Finally, abusing compensation claims is prohibited: fabricating evidence of illegal production to extort payments constitutes extortion and may lead to criminal referral; similarly, filing lawsuits based on false premises may result in fines, detention, or counterclaims for defamation. This section applies specifically to individuals seeking protection for themselves and their families."]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["My note"]},{"tag":"button","props":{"type":"button"},"children":["Write a reminder for yourself…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/en/tip/05-30"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Previous"]},"If something goes wrong after buying from a livestream, first ask the platform for the seller’s and influencer’s details — they’re required to provide them"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/en/tip/05-32"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children