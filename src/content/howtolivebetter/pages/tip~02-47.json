盐（钾盐）"]},{"tag":"a","props":{"href":"/tip/02-10","className":""},"children":[{"tag":"span","props":{},"children":["10"]},"认真刷牙，每天清一次牙缝，缺了牙去看牙医"]},{"tag":"a","props":{"href":"/tip/02-11","className":""},"children":[{"tag":"span","props":{},"children":["11"]},"每天走到 7000–8000 步，或者每周累计快走 150–300 分钟"]},{"tag":"a","props":{"href":"/tip/02-12","className":""},"children":[{"tag":"span","props":{},"children":["12"]},"成年后定期查血脂，40 岁前每 2 到 5 年一次、40 岁起每年一次；有高血压、高血脂就按医嘱规律吃药，别自行停"]},{"tag":"a","props":{"href":"/tip/02-13","className":""},"children":[{"tag":"span","props":{},"children":["13"]},"每晚睡 7 小时左右，作息固定"]},{"tag":"a","props":{"href":"/tip/02-14","className":""},"children":[{"tag":"span","props":{},"children":["14"]},"常打网球、羽毛球、乒乓球这类球拍类运动"]},{"tag":"a","props":{"href":"/tip/02-15","className":""},"children":[{"tag":"span","props":{},"children":["15"]},"把爬楼梯、快走赶路这类零碎的用力活动攒到每天四五分钟"]},{"tag":"a","props":{"href":"/tip/02-16","className":""},"children":[{"tag":"span","props":{},"children":["16"]},"每周做 30–60 分钟力量训练"]},{"tag":"a","props":{"href":"/tip/02-17","className":""},"children":[{"tag":"span","props":{},"children":["17"]},"别连着坐太久，隔一阵起身动一动"]},{"tag":"a","props":{"href":"/tip/02-18","className":""},"children":[{"tag":"span","props":{},"children":["18"]},"少吃加工肉（火腿、培根、香肠、午餐肉）"]},{"tag":"a","props":{"href":"/tip/02-19","className":""},"children":[{"tag":"span","props":{},"children":["19"]},"少喝或不喝酒"]},{"tag":"a","props":{"href":"/tip/02-20","className":""},"children":[{"tag":"span","props":{},"children":["20"]},"每天都喝酒、一停就手抖心慌的人，别自己硬戒"]},{"tag":"a","props":{"href":"/tip/02-21","className":""},"children":[{"tag":"span","props":{},"children":["21"]},"想少喝酒，先把一周喝了多少数出来，再找医生聊几分钟"]},{"tag":"a","props":{"href":"/tip/02-22","className":""},"children":[{"tag":"span","props":{},"children":["22"]},"每天吃一小把坚果"]},{"tag":"a","props":{"href":"/tip/02-23","className":""},"children":[{"tag":"span","props":{},"children":["23"]},"把一部分红肉换成鱼和禽肉"]},{"tag":"a","props":{"href":"/tip/02-24","className":""},"children":[{"tag":"span","props":{},"children":["24"]},"把一部分精米白面换成全谷物"]},{"tag":"a","props":{"href":"/tip/02-25","className":""},"children":[{"tag":"span","props":{},"children":["25"]},"每周喝三次以上茶"]},{"tag":"a","props":{"href":"/tip/02-26","className":""},"children":[{"tag":"span","props":{},"children":["26"]},"每天喝三到四杯咖啡，咖啡因总量不超过 400 mg，不加糖不加奶盖"]},{"tag":"a","props":{"href":"/tip/02-27","className":""},"children":[{"tag":"span","props":{},"children":["27"]},"每天吃够 5 份（约 400 g）水果蔬菜"]},{"tag":"a","props":{"href":"/tip/02-28","className":""},"children":[{"tag":"span","props":{},"children":["28"]},"少吃超加工食品（薯片、方便面、糕点、速食）"]},{"tag":"a","props":{"href":"/tip/02-29","className":""},"children":[{"tag":"span","props":{},"children":["29"]},"做饭、取暖不烧煤和柴，换成电或燃气"]},{"tag":"a","props":{"href":"/tip/02-30","className":""},"children":[{"tag":"span","props":{},"children":["30"]},"热的东西放一放再喝，不喝滚烫的茶、汤和咖啡"]},{"tag":"a","props":{"href":"/tip/02-31","className":""},"children":[{"tag":"span","props":{},"children":["31"]},"白天出门晒晒太阳，别整天不见光"]},{"tag":"a","props":{"href":"/tip/02-32","className":""},"children":[{"tag":"span","props":{},"children":["32"]},"把 BMI 控制在 20–25，超重就减"]},{"tag":"a","props":{"href":"/tip/02-33","className":""},"children":[{"tag":"span","props":{},"children":["33"]},"每周吃四次以上辣椒"]},{"tag":"a","props":{"href":"/tip/02-34","className":""},"children":[{"tag":"span","props":{},"children":["34"]},"每天喝一两份奶或酸奶"]},{"tag":"a","props":{"href":"/tip/02-35","className":""},"children":[{"tag":"span","props":{},"children":["35"]},"鸡蛋不用戒，一天一个以内就行"]},{"tag":"a","props":{"href":"/tip/02-36","className":""},"children":[{"tag":"span","props":{},"children":["36"]},"有条件就泡澡，别只冲淋浴"]},{"tag":"a","props":{"href":"/tip/02-37","className":""},"children":[{"tag":"span","props":{},"children":["37"]},"把午睡控制在半小时内，别超过一小时，非得睡一两小时才撑得住就去查原因"]},{"tag":"a","props":{"href":"/tip/02-38","className":""},"children":[{"tag":"span","props":{},"children":["38"]},"熬夜之后第二天晚上就补觉，别攒到周末"]},{"tag":"a","props":{"href":"/tip/02-39","className":""},"children":[{"tag":"span","props":{},"children":["39"]},"上夜班干得越久心血管风险越高，能转岗就趁早转"]},{"tag":"a","props":{"href":"/tip/02-40","className":""},"children":[{"tag":"span","props":{},"children":["40"]},"买预包装、有 SC 编号的食用油，不买小作坊散装自榨花生油"]},{"tag":"a","props":{"href":"/tip/02-41","className":""},"children":[{"tag":"span","props":{},"children":["41"]},"做饭用植物油代替猪油和黄油，不必为了健康换着买油，也别指望亚麻籽油护心"]},{"tag":"a","props":{"href":"/tip/02-42","className":""},"children":[{"tag":"span","props":{},"children":["42"]},"炒菜、煎炸时打开抽油烟机，从开火一直开到做完"]},{"tag":"a","props":{"href":"/tip/02-43","className":""},"children":[{"tag":"span","props":{},"children":["43"]},"绝经前后潮热盗汗影响到生活，就去妇科评估激素治疗，别硬扛也别自己买药，更别拿它防心脏病"]},{"tag":"a","props":{"href":"/tip/02-44","className":""},"children":[{"tag":"span","props":{},"children":["44"]},"本来就想养狗的，把每天遛狗算进走路量，别为了长寿专门去养狗"]},{"tag":"a","props":{"href":"/tip/02-45","className":""},"children":[{"tag":"span","props":{},"children":["45"]},"查出糖尿病前期（血糖偏高、还没到糖尿病），就靠少吃、减重、多动把糖尿病往后推，每半年复查一次血糖"]},{"tag":"a","props":{"href":"/tip/02-46","className":""},"children":[{"tag":"span","props":{},"children":["46"]},"家里的花生、玉米、坚果和米面发了霉，整包扔掉，别挑掉霉的吃剩下的；嚼到发苦的坚果马上吐掉"]},{"tag":"a","props":{"href":"/tip/02-47","className":"active"},"children":[{"tag":"span","props":{},"children":["47"]},"别吃淡水鱼虾做的鱼生、生鱼片、鱼生粥和醉虾，常吃过的去医院查一次肝吸虫，查出来按医嘱吃吡喹酮"]}]}]},{"tag":"div","props":{"className":"life-tip-page","data-tip-locales":"zh"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"当前位置"},"children":[{"tag":"a","props":{"href":"/book"},"children":["阅读全书"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/book/02"},"children":["第 2 章 · 不要慢慢死"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"02-47"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["47"]},{"tag":"span","props":{"className":"life-evidence grade-b"},"children":["证据 B"]}]},{"tag":"h1","props":{"lang":"zh"},"children":["别吃淡水鱼虾做的鱼生、生鱼片、鱼生粥和醉虾，常吃过的去医院查一次肝吸虫，查出来按医嘱吃吡喹酮"]},{"tag":"p","props":{"lang":"zh","className":"life-entry-summary"},"children":["生吃淡水鱼虾会染上肝吸虫。它是确定能致癌的寄生虫，染上的人得胆管癌的机会约是没染上的四到五倍。醋、酒、芥末都没法有效杀死它。染上了吃两天药，九成以上能治好。"]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["成本"]},{"tag":"p","props":{},"children":["不吃鱼生不花钱，难在改掉多年的口味，聚餐时还得推掉。常吃过的去医院验一次大便查虫卵，费用各地不同。查出来按医生开的剂量吃吡喹酮，一般吃 1 到 2 天。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["收益"]},{"tag":"p","props":{},"children":["华支睾吸虫俗称肝吸虫。世界卫生组织下属的国际癌症研究机构 2009 年开会评定，长期感染它对人致癌。它会导致胆管癌，列为 1 类。1994 年那次评定只给了 2A 类（很可能致癌）。把已发表的研究合起来算，感染肝吸虫的人得胆管癌的风险约为 4.8 倍。原文是相对风险 4.8（95% CI 2.8–8…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"标记：别吃淡水鱼虾做的鱼生、生鱼片、鱼生粥和醉虾，常吃过的去医院查一次肝吸虫，查出来按医嘱吃吡喹酮"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"已做到"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"加入待做"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"收藏"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"分享这条建议"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"收起详情"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["成本"]},{"tag":"p","props":{"className":"life-citations"},"children":["不吃鱼生不花钱，难在改掉多年的口味，聚餐时还得推掉。常吃过的去医院验一次大便查虫卵，费用各地不同。查出来按医生开的剂量吃吡喹酮，一般吃 1 到 2 天。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["收益"]},{"tag":"p","props":{"className":"life-citations"},"children":["华支睾吸虫俗称肝吸虫。世界卫生组织下属的国际癌症研究机构 2009 年开会评定，长期感染它对人致癌。它会导致胆管癌，列为 1 类。1994 年那次评定只给了 2A 类（很可能致癌）。把已发表的研究合起来算，感染肝吸虫的人得胆管癌的风险约为 4.8 倍。原文是相对风险 4.8（95% CI 2.8–8.4，可信范围）。这个数把东南亚的另一种肝吸虫也算在内。同一篇里，乙肝是 2.6 倍，丙肝是 1.8 倍，肝吸虫是最强的一项。另一篇汇总了 36 项研究。病例对照研究里，胆管癌约为 4.37 倍（OR 4.37，2.84–6.72）。跟踪研究里约为 10.43 倍（RR 10.43，2.90–37.47）。胆管炎、胆囊炎约为 7.80 倍（RR 7.80）。胆结石约为 2.42 倍（RR 2.42）。肝细胞癌约为 4.69 倍（OR 4.69）。肝硬化没看出显著关联。感染越重，这些病越多。2014 到 2015 年全国调查，感染率 0.47%，约 600 万人。感染率超过 1% 的是广东、广西、黑龙江、吉林四省。用 2016 到 2021 年的监测数据推算，2020 年全国约 0.67%，约 946 万人。其中广西约 8.92%，广东约 2.99%。国家疾控局等 15 个部门 2024 年出了防治方案。方案以 2018 到 2022 年监测点平均感染率为基线。广西 8.75%，吉林 4.38%，黑龙江 3.16%，广东 2.95%。国家食品安全风险评估中心 2026 年提示：酒、醋、芥末等调味料无法有效杀灭肝吸虫。冷冻要在零下 20℃ 以下连续冻至少 7 天。加热要让食物中心到 70℃ 以上，持续 10 分钟以上。国际癌症研究机构也写明，腌过、熏过的淡水鱼一样会传染。治疗看 2022 年一篇汇总，共 26 项试验、3340 人。世界卫生组织推荐的吡喹酮用法是按体重每次 25 毫克每公斤，一天 3 次，吃 2 天。对华支睾吸虫的预测治愈率 98.5%（85.4%–99.9%）。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["来源"]},{"tag":"p","props":{"className":"life-citations"},"children":["IARC Working Group on the Evaluation of Carcinogenic Risks to Humans (2012). Opisthorchis viverrini and Clonorchis sinensis. In: Biological Agents. IARC Monographs on the Evaluation of Carcinogenic Risks to Humans, Vol. 100B, 341-370. ",{"tag":"a","props":{"href":"https://publications.iarc.who.int/119","target":"_blank","rel":"noopener noreferrer"},"children":["https://publications.iarc.who.int/119"]},"；Shin HR, Oh JK, Masuyer E, 等 (2010). Epidemiology of cholangiocarcinoma: an update focusing on risk factors. Cancer Science, 101(3), 579-585. ",{"tag":"a","props":{"href":"https://doi.org/10.1111/j.1349-7006.2009.01458.x","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1111/j.1349-7006.2009.01458.x"]},"；Xia J, Jiang SC, Peng HJ (2015). Association between liver fluke infection and hepatobiliary pathological changes: a systematic review and meta-analysis. PLoS ONE, 10(7), e0132673. ",{"tag":"a","props":{"href":"https://doi.org/10.1371/journal.pone.0132673","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1371/journal.pone.0132673"]},"；Qian MB, Chen J, Bergquist R, 等 (2019). Neglected tropical diseases in the People's Republic of China: progress towards elimination. Infectious Diseases of Poverty, 8, 86. ",{"tag":"a","props":{"href":"https://doi.org/10.1186/s40249-019-0599-4","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1186/s40249-019-0599-4"]},"；Qian MB, Huang JL, Wang L, 等 (2025). Clonorchiasis in China: geospatial modeling of the population infected and at risk, based on national surveillance. Journal of Infection, 91(1), 106528. ",{"tag":"a","props":{"href":"https://doi.org/10.1016/j.jinf.2025.106528","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1016/j.jinf.2025.106528"]},"；国家疾控局等 15 部门 (2024). 关于印发全国包虫病等重点寄生虫病综合防治实施方案（2024—2030 年）的通知，附表 7. ",{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/202405/content_6950309.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/zhengce/zhengceku/202405/content_6950309.htm"]},"；国家食品安全风险评估中心 (2026). 关于慎食淡水生鲜食品预防肝吸虫病的风险提示（重庆市疾病预防控制中心转载）. ",{"tag":"a","props":{"href":"https://www.cqcdc.org/index.php?a=shows&catid=179&id=3861","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.cqcdc.org/index.php?a=shows&catid=179&id=3861"]},"；Qian MB, Patel C, Palmeirim MS, 等 (2022). Efficacy of drugs against clonorchiasis and opisthorchiasis: a systematic review and network meta-analysis. The Lancet Microbe, 3(8), e616-e624. ",{"tag":"a","props":{"href":"https://doi.org/10.1016/S2666-5247(22)00026-X","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1016/S2666-5247(22)00026-X"]},"；中国疾病预防控制中心寄生虫病预防控制所 (2020). 华支睾吸虫病（肝吸虫病）防治知识（广东省疾病预防控制中心转载）. ",{"tag":"a","props":{"href":"https://cdcp.gd.gov.cn/jkjy/jkzt/jscbfz/content/post_3439516.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://cdcp.gd.gov.cn/jkjy/jkzt/jscbfz/content/post_3439516.html"]},"；广东省疾病预防控制中心 (2023). 吃鱼生没余生？警惕潜伏在鱼生中的“凶手”肝吸虫！ ",{"tag":"a","props":{"href":"https://cdcp.gd.gov.cn/jkjy/jkts/content/post_4274108.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://cdcp.gd.gov.cn/jkjy/jkts/content/post_4274108.html"]},"；香港食物安全中心. 淡水鱼刺身的食物安全. ",{"tag":"a","props":{"href":"https://www.cfs.gov.hk/sc_chi/multimedia/multimedia_pub/multimedia_pub_fsf_148_01.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.cfs.gov.hk/sc_chi/multimedia/multimedia_pub/multimedia_pub_fsf_148_01.html"]},""]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["原书备注"]},{"tag":"p","props":{"className":"life-citations"},"children":["上面的风险数字都来自病例对照和跟踪记录，没有分组对照。也没有研究直接比较过「查了再治」能不能少得胆管癌。胆管癌本来少见，所以倍数虽高，落到每个人头上多出的风险不大。证据等级因此给 B。约 4.8 倍比的是染上和没染上的人，不是这条做法能少多少病，所以收益量级凭判断定为中，和本节第 46 条（发了霉整包扔掉）的定法一样。广东疾控说，肝吸虫在人体里能活 20 到 30 年。轻的常常没有症状，所以常吃鱼生的人别等不舒服才查。验大便找虫卵是确诊办法，B 超、CT、抽血只能辅助。吡喹酮要由医生按体重和感染轻重定剂量。寄生虫病所写明，在有囊虫病的地方用大剂量之前要先问清病史。治好了接着吃鱼生，还会再染上。切生鱼的刀和砧板要和熟食分开。海鱼刺身里常见的是异尖线虫这类别的寄生虫。香港食物安全中心建议买持牌店的，老人、孩子、孕妇别吃生鱼。孩子染上会影响长身体。乙肝、丙肝同样会伤肝致癌，见第 1 节第 14 条（查乙肝两对半）和第 1 节第 45 条（查一次丙肝抗体）。本条受益人主要是你自己和一起吃饭的家人。"]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["我的备注"]},{"tag":"button","props":{"type":"button"},"children":["写下对自己有用的提醒…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/tip/02-46"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["上一条"]},"家里的花生、玉米、坚果和米面发了霉，整包扔掉，别挑掉霉的吃剩下的；嚼到发苦的坚果马上吐掉"]}]},{"tag":"span","props":{},"children":[]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["本主题的其他建议"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/02-03"},"children":[{"tag":"strong","props":{},"children":["戒烟别光靠忍，先去拿药：吃伐尼克兰的成功率能翻一倍多"]},{"tag":"span","props":{},"children":["吃伐尼克兰的人戒成的比例，是吃安慰剂的两倍多。用尼古丁贴片、咀嚼胶这类替代品的，比不用药的高五成左右。贴片和咀嚼胶一起用，还能再高两成多。"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/02-04"},"children":[{"tag":"strong","props":{},"children":["定一个戒烟日，到那天一次停掉，别先慢慢减"]},{"tag":"span","props":{},"children":["很多人打算先每天少抽几根，慢慢减到零。可到了第六个月，定好日子一次停掉的人里 22% 没再抽，慢慢减的只有 15.5%。所以定一个日子，到那天一次停掉。"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/02-05"},"children":[{"tag":"strong","props":{},"children":["去戒烟门诊，或者打 12320 问当地有没有戒烟服务"]},{"tag":"span","props":{},"children":["药和「有人定期问你」是两件事，合起来更管用。一边吃药一边有专人跟进的人，戒成的比例接近只听一句简短建议的人的两倍。电话也算：戒烟热线多次主动回访，成功率高两成半…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/02-06"},"children":[{"tag":"strong","props":{},"children":["已经戒不掉再考虑电子烟，本来不吸烟的人别碰"]},{"tag":"span","props":{},"children":["把烟换成含尼古丁的电子烟，戒成的人比用尼古丁替代品多约六成，这个结论很可靠。但长期吸的安全数据还不够，不能当成无害。这些试验比的都是想戒烟的人，本来不吸烟的人别…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/02-07"},"children":[{"tag":"strong","props":{},"children":["不喝含糖饮料，换成无糖的也不算解决"]},{"tag":"span","props":{},"children":["美国的研究里，每天喝两份以上甜饮料的人，同期死亡的概率比几乎不喝的人高约两成。每天一到两份的，也高一成多。换成无糖的也没见着好处：每天喝两杯以上代糖饮料的人，反…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/02-08"},"children":[{"tag":"strong","props":{},"children":["不嚼槟榔"]},{"tag":"span","props":{},"children":["嚼槟榔的人，同期死亡的概率比不嚼的人高约两成。糖尿病和代谢综合征的风险高约五成。口腔癌和食管癌的风险还要另算。"]}]}]}]},{"tag":"a","props":{"className":"life-text-link","href":"/book/02"},"children":["阅读整个主题：不要慢慢死 ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"15","height":"15","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]}]}]},{"tag":"nav","props":{"className":"life-tabbar","aria-label":"主导航"},"children":[{"tag":"a","props":{"className":"","href":"/book"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"21","height":"21","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-book-open","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M12 7v14"},"children":[]},{"tag":"path","props":{"d":"M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z"},"children":[]}]},{"tag":"span"