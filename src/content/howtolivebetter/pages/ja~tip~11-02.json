ine","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"このヒントを共有"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"詳細を閉じる"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["費用・手間"]},{"tag":"p","props":{},"children":["費用はかかりません。代償は、この種の案件受注や「小規模ツール」による収入を諦めることです。難しいのは、このお金は手っ取り早く入ってくる一方で、誰が追及してくるのかが見えにくい点です。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["効果"]},{"tag":"p","props":{},"children":["コンピュータ情報システムへの侵入・不法制御専用のプログラムやツールの提供は、重大な場合 3 年以下の刑と罰金の併科または罰金だけとなります。併科は刑と罰金の両方、罰金だけは収監されず罰金を払う意味です。特に重大なら 3～7 年と罰金です。「重大」の基準は提供先が延べ 20 人以上、または違法所得 5000 元以上です。違法所得はこの行為で稼いだお金です。権利者の技術的保護措置を故意に回避・破壊すると、著作権侵害罪にもなり、3 年以下、重大なら 3～10 年の刑です。公式事例では王某らがゲームのメモリを読み書きして透視・自動照準を行うチートを製造販売し、3 か月で売上 8 万元超、利益 3 万元超を得て、1 年・執行猶予 1 年、罰金 5000 元となりました。執行猶予 1 年は、刑は 1 年でも直ちに収監せず、その 1 年間再犯しなければ収監されない意味です。項某らの「TZ」シリーズは売上 20 万元超で、項某は 3 年・執行猶予 3 年、罰金 2 万元でした。劉某某らはゲームのサーバープログラムを入手し、設定を変更して私設サーバーを開き、課金 2000 万元超を受け取りました。刑は 4 年～2 年 6 か月、罰金は 1000 万～130 万元でした。ゲームだけではありません。上海の会社は微信に自動転送、いいね、一斉送信など数十の機能を追加するファームウェアを作り、「マーケティング用スマホ」として 2381 台販売しました。2019 年、上海徐匯法院は著作権侵害罪で会社に罰金 50 万元、責任者に 1 年 6 か月・執行猶予 1 年 6 か月を言い渡しました（全国）。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["出典"]},{"tag":"p","props":{"className":"life-citations"},"children":["全国人大 (2020). 刑法（根据刑法修正案（十一）修正，第二百八十五条第三款、第二百一十七条第六项）. ",{"tag":"a","props":{"href":"https://jtgl.beijing.gov.cn/jgj/jgxx/flfg/fl/11033925/index.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://jtgl.beijing.gov.cn/jgj/jgxx/flfg/fl/11033925/index.html"]},"；最高人民法院、最高人民检察院 (2011). 关于办理危害计算机信息系统安全刑事案件应用法律若干问题的解释（第三条）. ",{"tag":"a","props":{"href":"https://ga.sz.gov.cn/ZWGK/ZCFG/ZCJD/content/post_1304363.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://ga.sz.gov.cn/ZWGK/ZCFG/ZCJD/content/post_1304363.html"]},"（深圳市公安局转载）；最高人民检察院 (2026). 上海静安：严惩制售游戏外挂黑灰产共护清朗网络空间. ",{"tag":"a","props":{"href":"https://www.spp.gov.cn/spp/zdgz/202608/t20260825_735480.shtml","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.spp.gov.cn/spp/zdgz/202608/t20260825_735480.shtml"]},"；最高人民检察院 (2021). 2020 年度检察机关保护知识产权典型案例（案例五）. ",{"tag":"a","props":{"href":"https://www.spp.gov.cn/spp/xwfbh/wsfbt/202104/t20210425_516525.shtml","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.spp.gov.cn/spp/xwfbh/wsfbt/202104/t20210425_516525.shtml"]},"；国家版权局 (2020). 2019 年度上海十大版权典型案件发布（上海市版权局发布，案例八：上海昱宫网络科技有限公司等侵犯著作权案）. ",{"tag":"a","props":{"href":"https://www.ncac.gov.cn/xxfb/ywxx/202004/t20200430_47269.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.ncac.gov.cn/xxfb/ywxx/202004/t20200430_47269.html"]}]},{"tag":"a","props":{"href":"https://jtgl.beijing.gov.cn/jgj/jgxx/flfg/fl/11033925/index.html","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["出典を開く"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["著者の注記"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["すでに公開されているチートツールの判例は、すべてゲームメモリの読み書きやアンチチートの回避を行うタイプです。「スクリーンショットを撮るだけ、キー入力をシミュレートするだけ」の補助については、まだ公式な判例は見当たりません。しかし、第 3 条のチケット争奪事件が示す通り、メモリに触れずリクエストを送るだけでも、不正データ取得罪に問われる可能性があります。最終的に犯罪となるか、どの罪に該当するかは、捜査機関がメーカーから提出された資料に基づいて決定するものであり、著者が決めることではありません。20 人に販売しただけで「情状が重大」とみなされるには十分であり、その量は非常にわずかです。"]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["自分のメモ"]},{"tag":"button","props":{"type":"button"},"children":["自分へのメモを書く…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/ja/tip/11-01"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["前へ"]},"行動に移る前にまず確認する：メーカー、プラットフォーム、会社が警察に届け出るか。刑事責任を追及されたら、すぐ刑事事件の弁護士を探す"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/ja/tip/11-03"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["次へ"]},"チケット争奪、タイムセール、注文操作、ポイ活（羊毛剥ぎ）のためのスクリプトを書かない・販売しない。たとえそれが単なる「ボタンの自動クリック」であっても"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["このテーマの他の提案"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/11-04"},"children":[{"tag":"strong","props":{},"children":["クローラーはログイン不要の公開ページのみを巡回する。回避策や個人情報には触れず、取得したデータは販売しない"]},{"tag":"span","props":{},"children":["ログイン、token、署名（signature）の解析が必要なデータへのアクセスは、防御回避とみなされ、3 年以下の判決、重大な場合は 3…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/11-05"},"children":[{"tag":"strong","props":{},"children":["ギャンブル、詐欺、アダルトAppの開発案件は受けない。「クライアント」のために決済チャネルの構築やアカウントの凍結解除を行わない"]},{"tag":"span","props":{},"children":["このような高額な報酬を提示し、かつ要求内容が曖昧な案件を引き受けることは、賭博グループの共犯になるも同然です。賭博開設罪に問われた場合、5…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/11-06"},"children":[{"tag":"strong","props":{},"children":["退職時にはアカウント権限をすべて返却する。データベースの削除、バックドアの設置、パスワード変更によるシステムのロックは行わない。たとえ会社から未払い賃金があったとしても"]},{"tag":"span","props":{},"children":["アカウントとパスワードは会社から与えられたものであり、退職後も使用できることを意味しません。ログインした時点で「不法な制御」とみなされ、3…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/11-07"},"children":[{"tag":"strong","props":{},"children":["退職時にソースコード、顧客リスト、技術文書を持ち出さない、個人のクラウドストレージにアップロードしない、転職先で再利用しない"]},{"tag":"span","props":{},"children":["自分で書いた