 2 0 0 1 2 2v16z"},"children":[]}]},"В избранное"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Поделиться советом"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Скрыть подробности"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Затраты"]},{"tag":"p","props":{},"children":["Совершенно бесплатно. В исследованиях обычно предлагают писать 3–4 раза, по 15–20 минут за раз. Нужно описывать то, что вызывает у вас дискомфорт, а также самые глубокие мысли и чувства."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Польза"]},{"tag":"p","props":{},"children":["Один метаанализ объединил эти 146 рандомизированных исследований. Участники описывали или озвучивали важные для себя события. В среднем эффект оказался положительным и статистически значимым, однако величина эффекта была минимальной — r = 0,075. Другой метаанализ, включавший только рандомизированные контролируемые исследования, охватил 30 работ; в нем не было выявлено никакого заметного влияния ни на физическое, ни на психическое здоровье. Еще один анализ, объединивший 16 исследований с участием онкологических больных и реабилитантов, также не выявил значимых изменений в психологическом состоянии, физическом самочувствии или качестве жизни; для психологической сферы показатель g составил 0,04, а 95% доверительный интервал — от –0,06 до 0,14."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Первоисточники"]},{"tag":"p","props":{"className":"life-citations"},"children":["Frattaroli J (2006). Experimental disclosure and its moderators: a meta-analysis. Psychological Bulletin. ",{"tag":"a","props":{"href":"https://doi.org/10.1037/0033-2909.132.6.823","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1037/0033-2909.132.6.823"]},"；Mogk C, Otte S, Reinhold-Hurley B, Kröner-Herwig B (2006). Health effects of expressive writing on stressful or traumatic experiences - a meta-analysis. Psycho-Social Medicine. ",{"tag":"a","props":{"href":"https://www.ncbi.nlm.nih.gov/pmc/articles/PMC2736499/","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.ncbi.nlm.nih.gov/pmc/articles/PMC2736499/"]},"；Zachariae R, O'Toole MS (2015). The effect of expressive writing intervention on psychological and physical health outcomes in cancer patients--a systematic review and meta-analysis. Psycho-Oncology. ",{"tag":"a","props":{"href":"https://doi.org/10.1002/pon.3802","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1002/pon.3802"]}]},{"tag":"a","props":{"href":"https://doi.org/10.1037/0033-2909.132.6.823","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Открыть источник"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Примечание автора"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["Существуют разные мнения по этому поводу. Сторонники этого метода опираются на метаанализ 146 исследований, показавший положительный, хотя и небольшой эффект. Противники же ссылаются на два метаанализа, включавших только рандомизированные контролируемые исследования, в которых значимого эффекта не обнаружилось. Указанная в блоке «Стоимость» частота и длительность записей взяты из первоначальных протоколов экспериментов; эти сведения приводятся в резюме метаанализа Mogk. Этот метод включен в список рекомендаций, поскольку он практически бесплатен и не требует много времени; им может воспользоваться любой желающий. Если человеку не с кем поделиться своими переживаниями, этот способ может оказаться полезным. Под «временем» здесь подразумевается лишь объем затраченных усилий; авторы классифицируют его именно так. Если во время записи вы почувствуете усиление эмоционального дискомфорта, прекратите процедуру и наберите последовательность цифр 12356 — см. пункт 25 в разделе 1 (12356)."]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Моя заметка"]},{"tag":"button","props":{"type":"button"},"children":["Запишите напоминание…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/ru/tip/03-23"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Предыдущий"]},"В гневе не стоит вымещать эмоции, разбивая вещи, бью по боксерской груше или пробегаясь — сначала нужно успокоить тело"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/ru/tip/03-25"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Следующий"]},"При менструальной боли принимайте обезболивающие, например ибупрофен, не терпите; если боль мешает работе или учёбе либо не проходит после трёх месяцев лечения, обратитесь к гинекологу"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 