 nhân hoặc giao cho công an, không giữ lại"]},{"tag":"span","props":{},"children":["Nhặt được đồ giữ lại dùng, số tiền đến mức「số tiền lớn」mà vẫn không c…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/09-08"},"children":[{"tag":"strong","props":{},"children":["Ưu đãi thì lấy bằng chính danh tính thật của bạn; không mua số ảo để đăng ký hàng loạt tài khoản nhỏ, không dựa lỗ hổng để lấy lặp"]},{"tag":"span","props":{},"children":["Lấy ưu đãi bằng chính danh tính thật của bạn, một tài khoản một lần t…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/09-09"},"children":[{"tag":"strong","props":{},"children":["Không ném bất cứ thứ gì ra ngoài từ ban công, cửa sổ; đầu thuốc lá, túi rác, chai rượu đều tính"]},{"tag":"span","props":{},"children":["Ném đồ xuống dưới, dù không trúng người vẫn bị giữ 5 ngày, phạt tiền …"]}]}]}]},{"tag":"a","props":{"className":"life-text-link","href":"/vi/book/09"},"children":["Đọc toàn bộ chủ đề: Vạch đỏ pháp lý dân dân thường dễ vấp"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"15","height":"15","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]}]}]},{"tag":"nav","props":{"className":"life-tabbar","aria-label":"Điều hướng chính"},"children":[{"tag":"a","props":{"className":"","href":"/vi/book"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"21","height":"21","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-book-open","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M12 7v14"},"children":[]},{"tag":"path","props":{"d":"M3 18a1 1 0 0 1-1-1V4a1 1 