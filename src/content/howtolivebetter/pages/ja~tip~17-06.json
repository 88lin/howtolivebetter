,"children":[{"tag":"span","props":{},"children":["07"]},"家族内に長期臥床または重度の障害がある人がいる場合、加入先の医療保険部門へ長期介護保険を申請してください。これは高齢者だけに支給されるものではありません"]},{"tag":"a","props":{"href":"/ja/tip/17-08"},"children":[{"tag":"span","props":{},"children":["08"]},"家族内に長期臥床の人がいる場合、褥瘡（床ずれ）を最大の敵と見なしましょう：電動エアマットレスの使用、定期的な体位変換、毎日、骨の突出部をチェックする"]},{"tag":"a","props":{"href":"/ja/tip/17-09"},"children":[{"tag":"span","props":{},"children":["09"]},"高齢者の白内障が視界に影響しているなら、眼科で手術の検討を。両目に症状がある場合は、二枚目の手術をあまり遅らせないこと"]},{"tag":"a","props":{"href":"/ja/tip/17-10"},"children":[{"tag":"span","props":{},"children":["10"]},"高齢者の犬の散歩ではリードを手に巻かず手のひらで握り、短く保つ。引っ張って飛び出さないよう犬を訓練する"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"現在地"},"children":[{"tag":"a","props":{"href":"/ja/book"},"children":["本を読む"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/ja/book/17"},"children":["第17章"," ·"," ","家族に高齢者がいる場合"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"17-06"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["06"]},{"tag":"span","props":{"className":"life-evidence grade-b"},"children":["エビデンス"," ","B"]}]},{"tag":"h1","props":{"lang":"ja"},"children":["保険会社による住宅リバースモーゲージ型年金保険を除き、他の「自宅を活用した老後プラン」には一切手を出さないこと。絶対に住宅を担保に理財商品を買ってはいけない"]},{"tag":"p","props":{"lang":"ja","className":"life-entry-summary"},"children":["正規の住宅を活用した老後プランは、保険会社による住宅リバースモーゲージ型年金保険（現在、試験運用中）のただ一種のみです。訪問販売されるものはそれとは全く無関係であり、高齢者に住宅を担保に入れさせ、借りたお金で彼らが勧める理財商品を買わせる詐欺です。住宅が担保に入れられたことすら気づかず、最終的に家を失い、さらにローンを背負うことになったケースもあります。"]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["費用・手間"]},{"tag":"p","props":{},"children":["費用はかかりません。自宅の権利証（不動産証）は、「住宅を活用した老後プラン」を名目に訪問してくる人物には決して渡さな…"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["効果"]},{"tag":"p","props":{},"children":["銀保監会（中国銀行保険監督管理委員会）の消費者保護局は、真偽の2つの違いを明確にしました。"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"記録する：保険会社による住宅リバースモーゲージ型年金保険を除き、他の「自宅を活用した老後プラン」には一切手を出さないこと。絶対に住宅を担保に理財商品を買ってはいけない"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"できている"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"やることに追加"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"お気に入り"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"このヒントを共有"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"詳細を閉じる"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["費用・手間"]},{"tag":"p","props":{},"children":["費用はかかりません。自宅の権利証（不動産証）は、「住宅を活用した老後プラン」を名目に訪問してくる人物には決して渡さないでください。抵当権の設定、保証、貸付に関する契約書は、署名する前に必ず子供たちに見せてください。難しいのは、訪問者が非常に熱心で、何度も足を運んでくることが多いため、高齢者が断りにくくなってしまうことです"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["効果"]},{"tag":"p","props":{},"children":["銀保監会（中国銀行保険監督管理委員会）の消費者保護局は、真偽の2つの違いを明確にしました。正規の「リバースモーゲージ型年金」は、 「高齢者向け住宅リバースモーゲージ養老保険」という一種のみです。住宅の完全な法的所有権を持つ高齢者が、不動産を保険会社に抵欠（担保）に提供します。住宅は引き続き自分自身で居住し、使用し、賃料を受け取ることができます。売却や処分を行う場合は、抵当権者（保険会社）の同意を得る必要があります。高齢者は、合意された条件に従って、亡くなるまで年金を受け取ることができます。この業務は現在まだ試験段階にあり、利用者は比較的少ないです。不法な者が言う「以房养老（不動産を活用した養老）」は、国が試験運用している住宅リバースモーゲージ養老保険とは「全く無関係」であり、「国の政策を借りて、違法な資金集め活動を宣伝するための手段」です。その手口は、高齢者を欺いて不動産を担保に入れさせ、借りた金で推奨する金融商品を購入させるというもので、「多くの場合、古い債務を新しい債務で返済するポンジ・スキーム」です。原文の結末には「参加者の中には、自分の不動産が担保に入れられたことすら知らず、最終的に家を失い、さらにローンを背負うことになった者もいる」と記されています。また、ヒントとして収益率を確認する基準も示されています。原文の通りには「金融商品の収益率が 6% を超える場合は疑いを持つべきであり、8% を超える場合は非常に危険、10% を超える場合は元本全額を失う覚悟が必要である。『元本保証で高利回り』は金融詐欺である」としています。同じ通知では「契約締結の段階には慎重になり、白紙の契約書には署名しないこと」とも求めています」（全国、2021 年 6 月）"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["出典"]},{"tag":"p","props":{"className":"life-citations"},"children":["中国银保监会消费者权益保护局 (2021). 关于警惕「投资养老」「以房养老」金融诈骗的风险提示（2021 年第三期）. ",{"tag":"a","props":{"href":"https://dfjrjgj.hunan.gov.cn/dfjrjgj/yhlj/202106/t20210608_19450856.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://dfjrjgj.hunan.gov.cn/dfjrjgj/yhlj/202106/t20210608_19450856.html"]},"（湖南省地方金融监督管理局转载）；民政部、中国银保监会 (2021). 关于养老领域非法集资的风险提示（第四种表现形式：以宣称「以房养老」为名非法集资）. ",{"tag":"a","props":{"href":"https://www.mca.gov.cn/n152/n164/c36171/content.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.mca.gov.cn/n152/n164/c36171/content.html"]}]},{"tag":"a","props":{"href":"https://dfjrjgj.hunan.gov.cn/dfjrjgj/yhlj/202106/t20210608_19450856.html","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["出典を開く"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["著者の注記"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["Bランクとしている理由は、これらの言説が規制当局の注意喚起や経験的な判断に基づくものであり、研究データではないためです。6%、8%、10% の3つのラインは、規制当局が消費者への参考として示しているものであり、法律で定められた基準ではありません。銀保監会（中国銀行保険監督管理委員会）はすでに国家金融監督管理総局に統合されており、元の公開ページは開けません。ここでは、各省の金融規制局が転載したページを引用しています。理財商品の損失は二次的な問題であり、住宅が担保に入れられた後、高齢者がローンを抱え続けることによる損失は、元本をはるかに上回ります。署名や白紙契約に関する一般的なルールについては、第 8 節第 17 条を参照してください。詐欺に遭った後の支払停止については、第 8 節第 2 条を参照してください。"]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["自分のメモ"]},{"tag":"button","props":{"type":"button"},"children":["自分へのメモを書く…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/ja/tip/17-05"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["前へ"]},"高齢者に先払いを求める「投資型老後プラン」には一切手を出さないこと：カード作成、ベッド確保、介護マンション、移住型老後生活、高齢者向け製品の購入は、すべて同一の違法集金の手口です"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/ja/tip/17-07"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["次へ"]},"家族内に長期臥床または重度の障害がある人がいる場合、加入先の医療保険部門へ長期介護保険を申請してください。これは高齢者だけに支給されるものではありません"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["このテーマの他の提案"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/17-02"},"children":[{"tag":"strong","props":{},"children":["遺言を作成しましょう。後から作成したものが前のものを覆すため、公証遺言が優先されるとは限りません"]},{"tag":"span","props":{},"children":["法律は6種類の遺言を認めていますが、形式を間違えると書面全体が無効になります。これが最もよくある失敗です。自筆によるものは、本人が最初から…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/17-03"},"children":[{"tag":"strong","props":{},"children":["高齢者の資金は別口座で管理し、高額支出には二人確認のルールを設ける"]},{"tag":"span","props":{},"children":["高齢者を狙う詐欺では、贈り物や親身な言葉で信頼を積み上げてから大金を奪います。「誰にも言わないで」と口止めするのも典型です。一定額以上の支…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/17-04"},"children":[{"tag":"strong","props":{},"children":["高齢者がいつでも使える、断るためのフレーズ：「家族と相談させてください」"]},{"tag":"span","props":{},"children":["勧誘や詐欺は、その場の圧力で考える前に払わせようとします。感情が高ぶると誇張広告を信じやすく、高齢者は若い人より説得されやすい傾向がありま…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/17-08"},"children":[{"tag":"strong","props":{},"children":["家族内に長期臥床の人がいる場合、褥瘡（床ずれ）を最大の敵と見なしましょう：電動エアマットレスの使用、定期的な体位変換、毎日、骨の突出部をチェックする"]},{"tag":"span","props":{},"children":["股関節骨折の手術前に褥瘡がある高齢者は、30 日以内に亡くなる可能性が約2割高まります。電動エアマットレスに交換することで、新しい褥瘡がで…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/17-09"},"children":[{"tag":"strong","props":{},"children":["高齢者の白内障が視界に影響しているなら、眼科で手術の検討を。両目に症状がある場合は、二枚目の手術をあまり遅らせないこと"]},{"tag":"span","props":{},"children":["70 歳以上の女性が、できるだけ早く片目の白内障手術を受けると、一年間の転倒回数が約3割4減少し、骨折する人も減少します。ただし、転倒した…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/17-10"},"children":[{"tag":"strong","props":{},"children":["高齢者の犬の散歩ではリードを手に巻かず手のひらで握り、短く保つ。引っ張って飛び出さないよう犬を訓練する"]},{"tag":"span","props":{},"children":["米国で65歳以上が犬の散歩中に骨折した推計は年約1700人から約4400人に増え、8割が女性でした。最も多い単一部位は股関節で、3割近くが…"]}]}]}]},{"tag":"a","props":{"className":"life-text-link","href":"/ja/book/17"},"children":["テーマ全体を読む：家族に高齢者がいる場合"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"15","height":"15","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]}]}]},{"tag":"nav","props":{"className":"life-tabbar","aria-label":"メインナビゲーション"},"children":[{"tag":"a","props":{"className":"","href":"/ja/book"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"21","height":"21","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-book-open","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M12 7v14"},"children":[]},{"tag":"path","props":{"d":"M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z"},"children":[]}]},{"tag":"span","props":{},"children":["本"]}]},{"tag":"a","props":{"className":"","href":"/ja/top-50"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"21","height":"2