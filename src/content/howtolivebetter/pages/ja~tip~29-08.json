":"m19.07 4.93-1.41 1.41"},"children":[]}]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"17","height":"17","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-moon life-theme-icon-dark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"},"children":[]}]}]},{"tag":"button","props":{"type":"button","className":"life-language-switch","aria-label":"日本語 言語を選ぶ","aria-haspopup":"menu","aria-expanded":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-globe","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]},{"tag":"path","props":{"d":"M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"},"children":[]},{"tag":"path","props":{"d":"M2 12h20"},"children":[]}]},{"tag":"span","props":{},"children":["日本語"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]}]},{"tag":"a","props":{"className":"life-account","href":"/ja/sign-in"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"17","height":"17","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle-user-round","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M18 20a6 6 0 0 0-12 0"},"children":[]},{"tag":"circle","props":{"cx":"12","cy":"10","r":"4"},"children":[]},{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},{"tag":"span","props":{},"children":["ログイン"]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/ja/book/29"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"目次に戻る"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["重大な打撃を受けた後"]},{"tag":"nav","props":{"aria-label":"この章のヒント"},"children":[{"tag":"a","props":{"href":"/ja/tip/29-01"},"children":[{"tag":"span","props":{},"children":["01"]},"大切な人を亡くした直後の数日間は一人で過ごさないこと。心臓病、高血圧、糖尿病がある人は通常通り服薬を。胸に圧迫感や痛みを感じたら 120 に連絡してください"]},{"tag":"a","props":{"href":"/ja/tip/29-02"},"children":[{"tag":"span","props":{},"children":["02"]},"重大な病の診断を受けたその一週間は、一人で診断結果を受け取りに行かないこと。治療以外の決定は後回しにする"]},{"tag":"a","props":{"href":"/ja/tip/29-03"},"children":[{"tag":"span","props":{},"children":["03"]},"失業後は、まず生活リズム、医療保険、そして求職活動のペースを固定すること。一日中家に閉じこもらないこと"]},{"tag":"a","props":{"href":"/ja/tip/29-04"},"children":[{"tag":"span","props":{},"children":["04"]},"親族が自殺、事故、または事件で亡くなった場合、一人で耐えようとせず、積極的に専門的な助けを求めてください"]},{"tag":"a","props":{"href":"/ja/tip/29-05"},"children":[{"tag":"span","props":{},"children":["05"]},"配偶者を亡くした後の最初の半年間は、三食、睡眠、持病の薬、そして再検査の管理を、特定の誰かに任せて見守ってもらう"]},{"tag":"a","props":{"href":"/ja/tip/29-06"},"children":[{"tag":"span","props":{},"children":["06"]},"親族も友人もいない場合は、「あなたを見守る存在」を3つのものに置き換えてください：自宅に入れる近隣住民、地域の訪問リスト、スマートフォンの緊急連絡先"]},{"tag":"a","props":{"href":"/ja/tip/29-07"},"children":[{"tag":"span","props":{},"children":["07"]},"親が亡くなった後、ありのままを伝え、お別れに立ち会わせ、環境を変えるために他の場所へ送らないこと"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/ja/tip/29-08","data-status":"active"},"children":[{"tag":"span","props":{},"children":["08"]},"悲しみから半年経っても立ち直れず、日常生活が送れない場合は、精神科または臨床心理科を受診してください"]},{"tag":"a","props":{"href":"/ja/tip/29-09"},"children":[{"tag":"span","props":{},"children":["09"]},"いきなり悲嘆カウンセリングにお金を使う前に、自分の悲しみが本当に「停滞」しているかを確認しましょう（第 8 条の症状など）"]},{"tag":"a","props":{"href":"/ja/tip/29-10"},"children":[{"tag":"span","props":{},"children":["10"]},"別居・離婚後は健康保険を途切れさせない、お酒で紛らわさない"]},{"tag":"a","props":{"href":"/ja/tip/29-11"},"children":[{"tag":"span","props":{},"children":["11"]},"話し相手が必要な時は 12356 へ、未成年者・青少年は 12355 へ、医師を求めるなら心理外来へ"]},{"tag":"a","props":{"href":"/ja/tip/29-12"},"children":[{"tag":"span","props":{},"children":["12"]},"大きな変化の直後の3ヶ月間は、いかなる不可逆的な重大決定も、すべて後回しにする"]},{"tag":"a","props":{"href":"/ja/tip/29-13"},"children":[{"tag":"span","props":{},"children":["13"]},"死を借金返済の手段と考えてはいけない：2年以内の生命保険は不払い、労災も不認定、債務は変わらず遺産から差し押さえられる"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"現在地"},"children":[{"tag":"a","props":{"href":"/ja/book"},"children":["本を読む"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/ja/book/29"},"children":["第29章"," ·"," ","重大な打撃を受けた後"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"29-08"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["08"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["エビデンス"," ","A"]}]},{"tag":"h1","props":{"lang":"ja"},"children":["悲しみから半年経っても立ち直れず、日常生活が送れない場合は、精神科または臨床心理科を受診してください"]},{"tag":"p","props":{"lang":"ja","className":"life-entry-summary"},"children":["大切な人を亡くした成人の約10人に1人が、停滞状態に陥ることがあります。半年以上経っても、食事が喉を通らない、仕事に行けない、育児ができないといった状態が続き、感覚が麻痺し、人生に意味を見出せなくなります。これは強さが足りないせいではなく、診断基準が存在し、専門的な治療法もあります。特化した治療の有効率は 51% であり、一般的な心理療法は 28% です。また、効果が現れるのもより早いです。"]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["費用・手間"]},{"tag":"p","props":{},"children":["診察料および治療費。この種の治療は継続的なプログラムとして行われ、試験では平均して 19 週に 16 回実施されてい…"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["効果"]},{"tag":"p","props":{},"children":["14 件の研究を合わせると、対象は暴力による死を遂げた親族ではなく、かつ本人も精神科に通院していない成人である。"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"記録する：悲しみから半年経っても立ち直れず、日常生活が送れない場合は、精神科または臨床心理科を受診してください"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"できている"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"やることに追加"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"お気に入り"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"このヒントを共有"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"詳細を閉じる"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["費用・手間"]},{"tag":"p","props":{},"children":["診察料および治療費。この種の治療は継続的なプログラムとして行われ、試験では平均して 19 週に 16 回実施されています。難しいのは、自ら一歩踏み出して受診を決意することです。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["効果"]},{"tag":"p","props":{},"children":["14 件の研究を合わせると、対象は暴力による死を遂げた親族ではなく、かつ本人も精神科に通院していない成人である。遷延性悲嘆障害の有病率は 9.8%（95% CI 6.8–14.0）、つまり、大切な人を亡くした成人の 100 人につき約 10 人である。年齢が上がるにつれてその割合は高くなる。また、別の研究ではこの診断基準の妥当性を検証しており、291 名の遺族を対象に、死別後 0–6、6–12、12–24 ヶ月の3回にわたってインタビューを行った。診断の核心となる症状は、故人への強い思慕である。これに加え、以下の9項目のうち少なくとも5項目を満たす必要がある。最初の5項目は、感情の麻痺、ショック、人生の無意味さ、他者への不信感、この喪失による苦痛である。残りの4項目は、受け入れがたい、自己のアイデンティティの喪失、現実逃避、生活の継続が困難である、である。これらの症状が毎日現れるか、あるいは日常生活に支障をきたすほど深刻である必要があります。また、大切な人を亡くしてから少なくとも 6 ヶ月が経過しても症状が続いており、日常生活に影響を及ぼしていることが条件です。95 人を2つのグループに分けて、16 回の治療を平均 19 週間行う試験があります。複雑性悲嘆に対する治療の有効率は 51% でした。一般的な対人心理療法は 28%（P=0.02、この差が偶然である可能性は低い）でした。前者のほうが効果の発現も早いです。治療が必要な人数は 4.3 人、つまり平均して 4.3 人治療するごとに1人の改善が見られる計算です"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["出典"]},{"tag":"p","props":{"className":"life-citations"},"children":["Lundorff M, et al. (2017). Prevalence of prolonged grief disorder in adult bereavement: A systematic review and meta-analysis. Journal of Affective Disorders. ",{"tag":"a","props":{"href":"https://doi.org/10.1016/j.jad.2017.01.030","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1016/j.jad.2017.01.030"]},"；Prigerson HG, et al. (2009). Prolonged grief disorder: Psychometric validation of criteria proposed for DSM-V and ICD-11. PLoS Medicine. ",{"tag":"a","props":{"href":"https://doi.org/10.1371/journal.pmed.1000121","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1371/journal.pmed.1000121"]},"；Shear MK, et al. (2005). Treatment of complicated grief: a randomized controlled trial. JAMA. ",{"tag":"a","props":{"href":"https://doi.org/10.1001/jama.293.21.2601","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1001/jama.293.21.2601"]}]},{"tag":"a","props":{"href":"https://doi.org/10.1016/j.jad.2017.01.030","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["出典を開く"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["著者の注記"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["「○ヶ月」と自分で決めつけないでください。真の判断基準は「食事、睡眠、仕事、育児に支障が出ているか」であり、これに当てはまるなら受診すべきです。診療科は精神科、心理科、または臨床心理科と呼ばれ、公立の精神科専門病院にはいずれも存在します。この診断は、資料によって「複雑性悲嘆」や「持続性悲嘆障害」と呼ばれます。基準となる期間も資料によって異なり、6 ヶ月とするものもあれば、12 ヶ月とするものもあります。9.8% という数値は、結果に大きな差がある 14 項の研究に基づいたものであり、著者も、この数値を他の集団にそのまま当てはめることはできない可能性があると注意を促しています。"]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["自分のメモ"]},{"tag":"button","props":{"type":"button"},"children":["自分へのメモを書く…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/ja/tip/29-07"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBo