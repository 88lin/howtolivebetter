,{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},{"tag":"span","props":{},"children":["ログイン"]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/ja/book/05"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"目次に戻る"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["お金を無駄にしない"]},{"tag":"nav","props":{"aria-label":"この章のヒント"},"children":[{"tag":"a","props":{"href":"/ja/tip/05-01"},"children":[{"tag":"span","props":{},"children":["01"]},"すべての自動更新をオフにし、期限切れ後に手動更新へ切り替える"]},{"tag":"a","props":{"href":"/ja/tip/05-02"},"children":[{"tag":"span","props":{},"children":["02"]},"毎年3月から6月にかけて確定申告を行い、特別控除の項目は漏れなく記入する"]},{"tag":"a","props":{"href":"/ja/tip/05-03"},"children":[{"tag":"span","props":{},"children":["03"]},"積立金（公積金）は住宅購入のためだけではない：賃貸、リフォーム、管理費の引き出しも可能、2026 年 9 月 20 日より新条例に基づき実施"]},{"tag":"a","props":{"href":"/ja/tip/05-04"},"children":[{"tag":"span","props":{},"children":["04"]},"携帯電話とブロードバンドのプランを年に一度見直す。不要なものはダウングレードし、キャリアが転出を拒むなら苦情を。"]},{"tag":"a","props":{"href":"/ja/tip/05-05"},"children":[{"tag":"span","props":{},"children":["05"]},"宝くじは買わない"]},{"tag":"a","props":{"href":"/ja/tip/05-06"},"children":[{"tag":"span","props":{},"children":["06"]},"「高収益」「元本保証」「確実な利益」という言葉を見たら、すぐに立ち去る"]},{"tag":"a","props":{"href":"/ja/tip/05-07"},"children":[{"tag":"span","props":{},"children":["07"]},"クレジットカードの最小支払いを利用しない、分割払いや消費者ローンを利用しない。借りる必要がある場合は、まず利息を年利（年換算利率）に直して比較する"]},{"tag":"a","props":{"href":"/ja/tip/05-08"},"children":[{"tag":"span","props":{},"children":["08"]},"配信者への投げ銭をしない、ゲームへの課金をしない、衝動買いをしない"]},{"tag":"a","props":{"href":"/ja/tip/05-09"},"children":[{"tag":"span","props":{},"children":["09"]},"子供によるスマホでの課金・投げ銭：8歳以上の高額な支出は、親の追認がない場合、返還を請求できる可能性がある"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/ja/tip/05-10","data-status":"active"},"children":[{"tag":"span","props":{},"children":["10"]},"子供に教えるべき一言：「誰かに親のスマホを操作させたり、認証コードを伝えさせようとしたら、それは詐欺師です」"]},{"tag":"a","props":{"href":"/ja/tip/05-11"},"children":[{"tag":"span","props":{},"children":["11"]},"電子製品の延長保証（延保）を断る"]},{"tag":"a","props":{"href":"/ja/tip/05-12"},"children":[{"tag":"span","props":{},"children":["12"]},"一致性評価を通過したジェネリック医薬品や、集中調達（集采）の採用薬を優先的に選ぶ"]},{"tag":"a","props":{"href":"/ja/tip/05-13"},"children":[{"tag":"span","props":{},"children":["13"]},"医療保険Appで「家族共済」の紐付けを行えば、従業員医療保険の個人口座の資金を配偶者、父母、子供の通院や薬代に利用可能に"]},{"tag":"a","props":{"href":"/ja/tip/05-14"},"children":[{"tag":"span","props":{},"children":["14"]},"水道水は沸騰させて飲み、ウォーターサーバー用の大容量ボトルの水を定期注文したり、小瓶の水を常時買ったりしない"]},{"tag":"a","props":{"href":"/ja/tip/05-15"},"children":[{"tag":"span","props":{},"children":["15"]},"株式の頻繁な取引を避ける。相場が急騰・急落している時こそ、より動きを控えるべきである"]},{"tag":"a","props":{"href":"/ja/tip/05-16"},"children":[{"tag":"span","props":{},"children":["16"]},"借金による投資、レバレッジの使用、理解できない銘柄の購入は避ける"]},{"tag":"a","props":{"href":"/ja/tip/05-17"},"children":[{"tag":"span","props":{},"children":["17"]},"長期的なコア資産（長期保有し続ける資金）として、アクティブファンドの代わりに広範なインデックスファンドを活用する"]},{"tag":"a","props":{"href":"/ja/tip/05-18"},"children":[{"tag":"span","props":{},"children":["18"]},"同種のファンドなら、より低い信託報酬率のものを優先的に選ぶ"]},{"tag":"a","props":{"href":"/ja/tip/05-19"},"children":[{"tag":"span","props":{},"children":["19"]},"一つの銘柄、一つのプラットフォーム、一つの不動産に全財産を投じない"]},{"tag":"a","props":{"href":"/ja/tip/05-20"},"children":[{"tag":"span","props":{},"children":["20"]},"所得税を支払っており、税率が 10% 以上の人は個人年金口座を開設すれば、年間最大 12000 元を課税前控除できる。所得税を支払っていない、または税率が 3% の人は、開設しても割に合わない"]},{"tag":"a","props":{"href":"/ja/tip/05-21"},"children":[{"tag":"span","props":{},"children":["21"]},"ジムの都度払い、または短期契約は、1年以上の継続的な利用実績がない限り避けるべき"]},{"tag":"a","props":{"href":"/ja/tip/05-22"},"children":[{"tag":"span","props":{},"children":["22"]},"前払金の請求には書面契約を；事業者にリスクが生じた場合は支払いを停止、失踪に備え未消費残高の返金を求める権利があります"]},{"tag":"a","props":{"href":"/ja/tip/05-23"},"children":[{"tag":"span","props":{},"children":["23"]},"高額な非必需品の購入には 24 時間のクーリングオフ期間を、ネットショッピングでは「7日間の無理由返品」を賢く活用"]},{"tag":"a","props":{"href":"/ja/tip/05-24"},"children":[{"tag":"span","props":{},"children":["24"]},"「打ち消し線価格」やセール時の買い溜めに惑わされない"]},{"tag":"a","props":{"href":"/ja/tip/05-25"},"children":[{"tag":"span","props":{},"children":["25"]},"保険は掛け捨て型を優先し、「返戻金」「配当金」は不確実なものとして扱う"]},{"tag":"a","props":{"href":"/ja/tip/05-26"},"children":[{"tag":"span","props":{},"children":["26"]},"第三者賠償責任保険は十分な額を：交強保険の限度額は全国一律で低く、超過分は自己負担となる"]},{"tag":"a","props":{"href":"/ja/tip/05-27"},"children":[{"tag":"span","props":{},"children":["27"]},"まずは 3 から 6 ヶ月分の生活費を、いつでも引き出せる場所に緊急資金として貯める"]},{"tag":"a","props":{"href":"/ja/tip/05-28"},"children":[{"tag":"span","props":{},"children":["28"]},"住宅ローンを繰り上げ返済する前に、感覚ではなく比較検討を"]},{"tag":"a","props":{"href":"/ja/tip/05-29"},"children":[{"tag":"span","props":{},"children":["29"]},"ネットショッピングではプラットフォームのルールと法条を確認し、配信者や「高評価」を信じない"]},{"tag":"a","props":{"href":"/ja/tip/05-30"},"children":[{"tag":"span","props":{},"children":["30"]},"ライブコマースで購入した商品に問題が発生した場合、まずはプラットフォームに販売者と配信者の情報を請求してください。プラットフォームは提供する義務があります"]},{"tag":"a","props":{"href":"/ja/tip/05-31"},"children":[{"tag":"span","props":{},"children":["31"]},"不安全な食品を購入した場合、返金に加えて10倍の賠償を請求可能。賠償額が1,000元に満たない場合は1,000元として計算"]},{"tag":"a","props":{"href":"/ja/tip/05-32"},"children":[{"tag":"span","props":{},"children":["32"]},"大型家電を購入する前に、国の抜き取り検査通知、3C認証、および省エネラベルを確認しましょう"]},{"tag":"a","props":{"href":"/ja/tip/05-33"},"children":[{"tag":"span","props":{},"children":["33"]},"ブレスレット、宝石、高級時計、アートトイは「使ったお金」として計算し、「貯まったお金」として計算しないこと"]},{"tag":"a","props":{"href":"/ja/tip/05-34"},"children":[{"tag":"span","props":{},"children":["34"]},"宝石・貴金属はCMAマーク付きの検査報告書のみを信頼し、発行機関の公式サイトでその機関を必ず確認すること"]},{"tag":"a","props":{"href":"/ja/tip/05-35"},"children":[{"tag":"span","props":{},"children":["35"]},"ブラインドボックスやカードガチャなどのランダム販売は、「このお金は戻ってこない」と考えて扱うこと"]},{"tag":"a","props":{"href":"/ja/tip/05-36"},"children":[{"tag":"span","props":{},"children":["36"]},"食品の添加物が気になるなら、包装済み製品を買うこと：バラ売りカウンターは法律上、原材料表示が義務付けられていない"]},{"tag":"a","props":{"href":"/ja/tip/05-37"},"children":[{"tag":"span","props":{},"children":["37"]},"損失が出ている銘柄も事前に決めたルールに従って売却すべきであり、ナンピン買いで平均取得単価を下げることで挽回しようとしてはならない"]},{"tag":"a","props":{"href":"/ja/tip/05-38"},"children":[{"tag":"span","props":{},"children":["38"]},"米国株などの海外資産を購入したい場合は、QDII基金または香港株通を利用しましょう。海外証券会社での口座開設や、毎年の外貨両替枠の利用は避けてください"]},{"tag":"a","props":{"href":"/ja/tip/05-39"},"children":[{"tag":"span","props":{},"children":["39"]},"自分では耐えられない損失に対してのみ保険を購入し、耐えられる損失は予備費でカバーする"]},{"tag":"a","props":{"href":"/ja/tip/05-40"},"children":[{"tag":"span","props":{},"children":["40"]},"家族の生活をあなたの収入に依存している人がいるなら、子供より先に稼ぎ手に対して定期死亡保険を検討すべきです"]},{"tag":"a","props":{"href":"/ja/tip/05-41"},"children":[{"tag":"span","props":{},"children":["41"]},"1年以上契約の人身保険を後悔し、猶予期間内に解約した場合、保険料はほぼ全額返金される"]},{"tag":"a","props":{"href":"/ja/tip/05-42"},"children":[{"tag":"span","props":{},"children":["42"]},"銀行窓口で署名する前に、手元にあるのが預金か保険かを必ず確認すること"]},{"tag":"a","props":{"href":"/ja/tip/05-43"},"children":[{"tag":"span","props":{},"children":["43"]},"解約したいなら自分で保険会社に手続きしましょう。「代理解約」は利用せず、誤解を招いたと感じたら12378に苦情を申し立ててください"]},{"tag":"a","props":{"href":"/ja/tip/05-44"},"children":[{"tag":"span","props":{},"children":["44"]},"保険証券の受益者には具体的な個人名を記載しましょう。万が一の際は、期限内に請求を：生命保険は 5 年、その他の保険は 2 年以内"]},{"tag":"a","props":{"href":"/ja/tip/05-45"},"children":[{"tag":"span","props":{},"children":["45"]},"ビットコイン、テザーなどの暗号資産を買わず、誘われても投資しない。取引は法的保護を受けず、損失は訴えても取り戻せない"]},{"tag":"a","props":{"href":"/ja/tip/05-46"},"children":[{"tag":"span","props":{},"children":["46"]},"勤務先がない人が従業員基本年金保険を自分で納付するなら、最低水準で必要な年数を満たすのが最も有利。すぐに得をするわけではなく、最低水準でも払った分の回収に約 10 年の受給が必要"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"現在地"},"children":[{"tag":"a","props":{"href":"/ja/book"},"children":["本を読む"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/ja/book/05"},"children":["第5章"," ·"," ","お金を無駄にしない"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"05-10"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["10"]},{"tag":"span","props":{"className":"life-evidence grade-b"},"children":["エビデンス"," ","B"]}]},{"tag":"h1","props":{"lang":"ja"},"children":["子供に教えるべき一言：「誰かに親のスマホを操作させたり、認証コードを伝えさせようとしたら、それは詐欺師です」"]},{"tag":"p","props":{"lang":"ja","className":"life-entry-summary"},"children":["これら6種類の詐欺の手口はそれぞれ異なりますが、最後のステップは常に同じ動作です。それは、子供に親のスマホを使って送金させたり、認証コードを読み上げさせたりすることです。ですから、一言教えるだけで十分です。「誰かに親のスマホを触らせようとしたり、認証コードを教えるように言われたら、その人は詐欺師です」。あわせて「騙されても、まずは私に話して。怒らないから」と伝えておきましょう。子供がその日のうちに話してくれることで、初めてお金を取り戻せる可能性があります。"]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["費用・手間"]},{"tag":"p","props":{},"children":["費用はかかりません。子供に以下の6つの種類について一度説明し、あわせて「騙されても、まずは私に話して。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["効果"]},{"tag":"p","props":{},"children":["泉州市反詐欺センターは泉州市教育局と連携し、青少年を標的とした6種類の詐欺手口を解明しました。"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"記録する：子供に教えるべき一言：「誰かに親のスマホを操作させたり、認証コードを伝えさせようとしたら、それは詐欺師です」"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"できている"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"やることに追加"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"お気に入り"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"このヒントを共有"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"詳細を閉じる"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["費用・手間"]},{"tag":"p","props":{},"children":["費用はかかりません。子供に以下の6つの種類について一度説明し、あわせて「騙されても、まずは私に話して。怒らないから」と約束しておきましょう。同時に、決済の生体認証・パスワードなし決済の上限を設定し、青少年モードを有効にし、決済パスワードは子供には教えないようにします。難しいのは、実際に騙されてしまった時に、怒りを抑えて冷静でいることです。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["効果"]},{"tag":"p","props":{},"children":["泉州市反詐欺センターは泉州市教育局と連携し、青少年を標的とした6種類の詐欺手口を解明しました。手口はそれぞれ異なりますが、最終的なステップは共通しています。それは、子供に親の携帯電話を使って送金させることです。第一のケースは、ゲームのアカウントや装備を個人間で安価に取引する詐欺です。小王さんは個人間で 260 元を支払いましたが、相手から「未成年者の送金は規約違反であり、アカウントが凍結される」と言われ、父親の携帯電話で「確認用リンク」をクリックしてしまった結果、口座から 3 万元以上の資金が流出しました。第二のケースは、「依存防止機能（防沈迷）の解除」を謳う詐欺です。相手から「送金しなければ解除せず、親を投獄させる」と脅され、子供が母親の携帯電話を使って 7000 元を送金してしまいました。原文には、依存防止機能は公式に設定されたものであり、「『個人による解除』の手段は存在しない」と明記されています。第三のケースは、投げ銭の返金詐欺です。詐欺師が「公式カスタマーサービス」を装い、未成年者の投げ銭は返金可能だと告げ、「指定のライブ配信ルームに保護者のAlipayでギフトを贈れば返金できる」と要求するケースがあります。母親の口座から 7.3 万元が投げ銭として支払われ、その後ブロックされてしまいました。原文には「『ギフトを贈れば返金する』と連絡してくる人がいたら、100% は詐欺である」と記されています。第四のケースは、クラスメートや教師を装う手口です。詐欺師がアカウントを乗っ取り、名前を名乗る音声メッセージを送って借金を要求します。新学期にはクラスのグループチャットに紛れ込んで教師を装い、「学費・雑費 500 元を支払うこと」と連絡してくることもあります。アイコンやニックネームも本物の教師と全く同じで、さらにグループ内に「サクラ」を配置して「支払済み」と言わせる手口もあります。第五のケースは、推し活（アイドルファン）を狙ったものです。詐欺師が子供を「スターのファングループに入れば 888 元の紅包（お年玉）がもらえる」というグループに誘い込み、まずは「本人確認」として 48.88 元を振り込ませるという手口です。「未成年人が規約違反に関与した場合、プラットフォームは8万元の凍結を受け、保護者は投獄される」と再び脅し、合計で1.6万元を騙し取った。原文には「本物の警察や弁護士が、調査のためにネットを通じて未成年者に連絡したり、保護者に携帯電話の操作を求めたりすることは絶対にない」と記されている。第六のケースは、中古プラットフォーム上で低価格の商品を使い、ユーザーをプラットフォーム外へ誘い出し、個人間で送金させる手口。同じ資料には、子供自身が踏んではいけない3つのレッドラインも記載されている。第一に、銀行カードや電話カードを貸したり、売ったり、レンタルしたりしないこと。カードが犯罪収益の移動に利用された場合、「情報ネットワーク犯罪幇助罪」に問われる可能性があり、前科がつくと大学院入試や公務員試験に影響する。第二に、「スマホ操作」のアルバイトは違法・犯罪行為であること。第三に、海外の「高額求人」には注意。海外に到着した途端、拘束される恐れがある（全国、2025年10月）"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["出典"]},{"tag":"p","props":{"className":"life-citations"},"children":["泉州市反诈骗中心 (2025). 开学第一课｜反诈是青少年的必修课，这 6 大陷阱一定要避开！",{"tag":"a","props":{"href":"http://gat.fujian.gov.cn/ztzl/fjjffpzxrx/spjq/202510/t20251028_7026836.htm","target":"_blank","rel":"noopener noreferrer"},"children":["http://gat.fujian.gov.cn/ztzl/fjjffpzxrx/spjq/202510/t20251028_7026836.htm"]},"（福建省公安厅转载）"]},{"tag":"a","props":{"href":"http://gat.fujian.gov.cn/ztzl/fjjffpzxrx/spjq/202510/t20251028_7026836.htm","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["出典を開く"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["著者の注記"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["B級の定成は、公式が詐欺の手口の解説と個別の事例を提供しており、発生率や防止効果の統計データが提示されていないためです。第9条（子どもがスマートフォンでチャージや配信をし、お金を使い果たした場合）とは区別して理解する必要があります。子ども自身がチャージや配信で使ったお金は、民法典に基づき返還が可能です。しかし、詐欺師にだまされて奪われたお金については、その条文は適用されず、第8節第2条に従って通報して即時凍結する必要があります。お金がまだ口座に残っているかどうかによって、戻ってくるかどうかが決まります。詐欺師が子どもに恐喝する主な手口は「あなたがルール違反をした、あなたの親が逮捕される」というものです。事前に子どもにこの言葉が詐欺の特徴であることを明確に伝えましょう。これは、事後で問うよりも効果的です。「詐欺に遭った場合はまず言って、私はあなたを責めない」という言葉を本当に実行してください。子どもが叱られることを恐れて話さないのは、これらのケースで損失がどんどん大きくなる共通の原因です。熟人を装った成人向けの詐欺やAIによる顔の変更（偽装）については、第8節第3、4条（反詐欺の硬質ルール、振り込め詐欺の際はまず通話を切る）を参照してください。大人も同様に、認証コードや顔認証は誰の代わりにも行いません。第8節第45条（認証コードを読み上げる）を参照してください。"]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["自分のメモ"]},{"tag":"button","props":{"type":"button"},"children":["自分へのメモを書く…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/ja/tip/05-09"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["前へ"]},"子供によるスマホでの課金・投げ銭：8歳以上の高額な支出は、親の追認がない場合、返還を請求できる可能性がある"]}]},{"tag":"a","props":{"c