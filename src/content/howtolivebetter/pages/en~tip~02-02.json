:"false","style":{"top":"94px"}},"children":[{"tag":"div","props":{"className":"life-ad-dock","hidden":true},"children":[{"tag":"aside","props":{"className":"life-ad-space life-ad-space-sponsored life-ad-space-compact","data-ad-placement":"ad_dock","data-ad-group":"reading","data-ad-creative":"read_product","data-ad-ready":"false","aria-label":"Advertisement · Community recommendation"},"children":[{"tag":"button","props":{"type":"button","className":"life-ad-dismiss","aria-label":"Close ad"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-x","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M18 6 6 18"},"children":[]},{"tag":"path","props":{"d":"m6 6 12 12"},"children":[]}]}]},{"tag":"div","props":{"className":"life-ad-space-brand"},"children":[{"tag":"img","props":{"src":"/sites/howtolivebetter/images/shengcai/logo.png","width":"565","height":"144","alt":"Official Shengcai Youshu logo","decoding":"async"},"children":[]}]},{"tag":"div","props":{"className":"life-ad-space-copy"},"children":[{"tag":"span","props":{"className":"life-ad-space-label"},"children":["Advertisement · Community recommendation"]},{"tag":"strong","props":{},"children":["Could what you know become a useful product?"]},{"tag":"p","props":{},"children":["From ebooks to small tools, explore how members spot needs and turn knowledge into something people can use."]}]},{"tag":"div","props":{"className":"life-ad-space-actions"},"children":[{"tag":"a","props":{"className":"life-ad-space-link","href":"/en/shengcaiyoushu?sc_group=reading&sc_creative=read_product&sc_placement=ad_dock"},"children":["Explore the community and examples",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"18","height":"18","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-up-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M7 7h10v10"},"children":[]},{"tag":"path","props":{"d":"M7 17 17 7"},"children":[]}]}]}]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/en/book/02"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"Back to index"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["Don’t die slowly"]},{"tag":"div","props":{"data-ad-dock-host":"true"},"children":[]},{"tag":"nav","props":{"aria-label":"Chapter entries"},"children":[{"tag":"a","props":{"href":"/en/tip/02-01"},"children":[{"tag":"span","props":{},"children":["01"]},"Quit smoking—the earlier, the better"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/en/tip/02-02","data-status":"active"},"children":[{"tag":"span","props":{},"children":["02"]},"Don’t smoke at home or in the car, and don’t let guests smoke indoors"]},{"tag":"a","props":{"href":"/en/tip/02-03"},"children":[{"tag":"span","props":{},"children":["03"]},"Don’t rely solely on willpower to quit smoking — get medication first: success rates more than double"]},{"tag":"a","props":{"href":"/en/tip/02-04"},"children":[{"tag":"span","props":{},"children":["04"]},"Pick a quit date and stop smoking on that day — don’t taper gradually"]},{"tag":"a","props":{"href":"/en/tip/02-05"},"children":[{"tag":"span","props":{},"children":["05"]},"Visit a smoking cessation clinic or call 12320 to find local services"]},{"tag":"a","props":{"href":"/en/tip/02-06"},"children":[{"tag":"span","props":{},"children":["06"]},"Only consider e‑cigarettes if you’ve already tried quitting; non‑smokers should avoid them"]},{"tag":"a","props":{"href":"/en/tip/02-07"},"children":[{"tag":"span","props":{},"children":["07"]},"Not drinking sugary drinks — even switching to sugar-free ones doesn’t help"]},{"tag":"a","props":{"href":"/en/tip/02-08"},"children":[{"tag":"span","props":{},"children":["08"]},"Not chewing betel nut"]},{"tag":"a","props":{"href":"/en/tip/02-09"},"children":[{"tag":"span","props":{},"children":["09"]},"Switch household salt to low‑sodium (potassium‑rich) salt"]},{"tag":"a","props":{"href":"/en/tip/02-10"},"children":[{"tag":"span","props":{},"children":["10"]},"Brush teeth thoroughly and floss daily; replace missing teeth promptly"]},{"tag":"a","props":{"href":"/en/tip/02-11"},"children":[{"tag":"span","props":{},"children":["11"]},"Walking 7,000–8,000 steps per day, or accumulating 150–300 minutes of brisk walking each week"]},{"tag":"a","props":{"href":"/en/tip/02-12"},"children":[{"tag":"span","props":{},"children":["12"]},"People with hypertension and high cholesterol should take their medication regularly as prescribed; never stop on their own"]},{"tag":"a","props":{"href":"/en/tip/02-13"},"children":[{"tag":"span","props":{},"children":["13"]},"Getting about 7 hours of sleep each night with a consistent schedule"]},{"tag":"a","props":{"href":"/en/tip/02-14"},"children":[{"tag":"span","props":{},"children":["14"]},"Regularly play racket sports such as tennis, badminton or table tennis"]},{"tag":"a","props":{"href":"/en/tip/02-15"},"children":[{"tag":"span","props":{},"children":["15"]},"Accumulating brief bouts of strenuous activity like stair climbing or brisk walking to total 4–5 minutes per day"]},{"tag":"a","props":{"href":"/en/tip/02-16"},"children":[{"tag":"span","props":{},"children":["16"]},"30–60 minutes of strength training per week"]},{"tag":"a","props":{"href":"/en/tip/02-17"},"children":[{"tag":"span","props":{},"children":["17"]},"Don’t sit for too long at a time — get up and move every now and then"]},{"tag":"a","props":{"href":"/en/tip/02-18"},"children":[{"tag":"span","props":{},"children":["18"]},"Eat less processed meat (ham, bacon, sausages, luncheon meat)"]},{"tag":"a","props":{"href":"/en/tip/02-19"},"children":[{"tag":"span","props":{},"children":["19"]},"Drink less or no alcohol"]},{"tag":"a","props":{"href":"/en/tip/02-20"},"children":[{"tag":"span","props":{},"children":["20"]},"People who drink daily and experience tremors and palpitations when they stop should not try to quit on their own"]},{"tag":"a","props":{"href":"/en/tip/02-21"},"children":[{"tag":"span","props":{},"children":["21"]},"To drink less, first tally how much you drink each week, then chat briefly with a doctor"]},{"tag":"a","props":{"href":"/en/tip/02-22"},"children":[{"tag":"span","props":{},"children":["22"]},"Eating a small handful of nuts daily"]},{"tag":"a","props":{"href":"/en/tip/02-23"},"children":[{"tag":"span","props":{},"children":["23"]},"Swapping some red meat for fish or poultry"]},{"tag":"a","props":{"href":"/en/tip/02-24"},"children":[{"tag":"span","props":{},"children":["24"]},"Swap some refined rice and flour for whole grains"]},{"tag":"a","props":{"href":"/en/tip/02-25"},"children":[{"tag":"span","props":{},"children":["25"]},"Drinking tea more than three times a week"]},{"tag":"a","props":{"href":"/en/tip/02-26"},"children":[{"tag":"span","props":{},"children":["26"]},"Drinking three to four cups of coffee daily, without sugar or cream"]},{"tag":"a","props":{"href":"/en/tip/02-27"},"children":[{"tag":"span","props":{},"children":["27"]},"Eating 5 servings (about 400 g) of fruits and vegetables daily"]},{"tag":"a","props":{"href":"/en/tip/02-28"},"children":[{"tag":"span","props":{},"children":["28"]},"Eat fewer ultra-processed foods (chips, instant noodles, pastries, ready meals)"]},{"tag":"a","props":{"href":"/en/tip/02-29"},"children":[{"tag":"span","props":{},"children":["29"]},"Switching from coal and wood to electricity or gas for cooking and heating"]},{"tag":"a","props":{"href":"/en/tip/02-30"},"children":[{"tag":"span","props":{},"children":["30"]},"Let hot drinks cool down before drinking; avoid tea, soup, and coffee that are piping hot"]},{"tag":"a","props":{"href":"/en/tip/02-31"},"children":[{"tag":"span","props":{},"children":["31"]},"Getting some sun during the day — don’t stay out of the light all the time"]},{"tag":"a","props":{"href":"/en/tip/02-32"},"children":[{"tag":"span","props":{},"children":["32"]},"Keeping BMI between 20–25; losing weight if overweight"]},{"tag":"a","props":{"href":"/en/tip/02-33"},"children":[{"tag":"span","props":{},"children":["33"]},"Eating chili peppers four or more times per week"]},{"tag":"a","props":{"href":"/en/tip/02-34"},"children":[{"tag":"span","props":{},"children":["34"]},"Drinking one or two servings of milk or yogurt daily"]},{"tag":"a","props":{"href":"/en/tip/02-35"},"children":[{"tag":"span","props":{},"children":["35"]},"Eggs need not be avoided, but don’t eat three or four daily"]},{"tag":"a","props":{"href":"/en/tip/02-36"},"children":[{"tag":"span","props":{},"children":["36"]},"Take baths whenever you can — don’t limit yourself to showers"]},{"tag":"a","props":{"href":"/en/tip/02-37"},"children":[{"tag":"span","props":{},"children":["37"]},"Keep naps under 30 minutes—no longer than an hour. If you regularly need a one- or two-hour nap to get through the day, it’s time to see a doctor"]},{"tag":"a","props":{"href":"/en/tip/02-38"},"children":[{"tag":"span","props":{},"children":["38"]},"Catch up on sleep the night after a sleepless night — don’t wait until the weekend"]},{"tag":"a","props":{"href":"/en/tip/02-39"},"children":[{"tag":"span","props":{},"children":["39"]},"The longer you work night shifts, the higher your cardiovascular risk — switch if you can"]},{"tag":"a","props":{"href":"/en/tip/02-40"},"children":[{"tag":"span","props":{},"children":["40"]},"Buy pre-packaged cooking oil with an SC code; avoid bulk, unregulated homemade peanut oil"]},{"tag":"a","props":{"href":"/en/tip/02-41"},"children":[{"tag":"span","props":{},"children":["41"]},"Replacing lard and butter with vegetable oils for cooking: you don’t need to switch oils for health reasons, nor should you expect flaxseed oil to protect your heart"]},{"tag":"a","props":{"href":"/en/tip/02-42"},"children":[{"tag":"span","props":{},"children":["42"]},"Turn on the range hood while stir-frying and deep-frying, from the moment you light the stove until the cooking is done"]},{"tag":"a","props":{"href":"/en/tip/02-43"},"children":[{"tag":"span","props":{},"children":["43"]},"If hot flashes and night sweats around menopause disrupt your life, see a gynecologist to assess hormone therapy; do not just endure them or buy medication yourself, and do not use it to prevent heart disease"]},{"tag":"a","props":{"href":"/en/tip/02-44"},"children":[{"tag":"span","props":{},"children":["44"]},"If you already wanted a dog, count the daily walk toward your steps — don’t get a dog just for longevity"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"Breadcrumb"},"children":[{"tag":"a","props":{"href":"/en/book"},"children":["Explore the book"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/en/book/02"},"children":["Chapter 2"," ·"," ","Don’t die slowly"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"02-02"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["02"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["Evidence"," ","A"]}]},{"tag":"h1","props":{"lang":"en"},"children":["Don’t smoke at home or in the car, and don’t let guests smoke indoors"]},{"tag":"p","props":{"lang":"en","className":"life-entry-summary"},"children":["Around 600,000 people worldwide die each year from secondhand smoke exposure; nearly 30% of those are children. Long‑term exposure to secondhand smoke raises the risk of hypertension, heart disease, and stroke by roughly 30% compared to non‑exposed individuals. Smoke inhaled at home is even more harmful than smoke encountered outside."]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Cost"]},{"tag":"p","props":{},"children":["There is no monetary cost and it takes little time. The ch…"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Benefit"]},{"tag":"p","props":{},"children":["In 2004, secondhand smoke caused 603,000 deaths globally — about 1.0% of all deaths worldwide, with children a…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"Mark: Don’t smoke at home or in the car, and don’t let guests smoke indoors"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"Done"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"Plan to do"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"Save"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Share this tip"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Hide details"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Cost"]},{"tag":"p","props":{},"children":["There is no monetary cost and it takes little time. The challenge is simply having the conversation with family members and guests to keep them from smoking indoors."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Benefit"]},{"tag":"p","props":{},"children":["In 2004, secondhand smoke caused 603,000 deaths globally — about 1.0% of all deaths worldwide, with children accounting for 28% of those fatalities. Pooled data from 57 studies show that people exposed to secondhand smoke have a 1.28‑fold higher chance of developing hypertension, a 1.39‑fold higher risk of heart disease, a 1.50‑fold higher risk of myocardial infarction, and a 1.36‑fold higher risk of stroke compared to non‑exposed individuals. The risk is greater when exposure occurs at home rather than outside."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Original sources"]},{"tag":"p","props":{"className":"life-citations"},"children":["Öberg M, Jaakkola MS, Woodward A, Peruga A, Prüss-Ustün A (2011). Worldwide burden of disease from exposure to second-hand smoke: a retrospective analysis of data from 192 countries. Lancet：「603,000 deaths were attributable to second-hand smoke in 2004, which was about 1·0% of worldwide mortality. 47% of deaths from second-hand smoke occurred in women, 28% in children, and 26% in men」，「61% of DALYs were in children」. ",{"tag":"a","props":{"href":"https://doi.org/10.1016/S0140-6736(10)61388-8","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1016/S0140-6736(10)61388-8"]},"；(2026). The Associations Between Secondhand Smoke Exposure and Various Cardiovascular Diseases: A Meta-Analysis. Nicotine & Tobacco Research：57 项研究，「hypertension (OR: 1.28, 95% CI: 1.15 to 1.40), heart disease (OR: 1.39, 95% CI: 1.28 to 1.50), myocardial infarction (OR: 1.50, 95% CI: 1.17 to 1.84), stroke (OR: 1.36, 95% CI: 1.18 to 1.54)」「Home exposure has a higher risk of CVD than non-home exposure」. ",{"tag":"a","props":{"href":"https://doi.org/10.1093/ntr/ntaf111","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1093/ntr/ntaf111"]}]},{"tag":"a","props":{"href":"https://doi.org/10.1016/S0140-6736(10)61388-8","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Open source link"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Book note"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["Focus on home environments first, since people spend more time there and pooled researc