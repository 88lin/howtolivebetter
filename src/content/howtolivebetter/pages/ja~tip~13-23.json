12","cy":"10","r":"4"},"children":[]},{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},{"tag":"span","props":{},"children":["ログイン"]}]}]}]},{"tag":"aside","props":{"className":"life-ad-space life-ad-space-sponsored life-ad-space-compact","data-ad-placement":"ad_header","data-ad-group":"reading","data-ad-creative":"read_product","data-ad-ready":"false","aria-label":"広告 · コミュニティ紹介"},"children":[{"tag":"div","props":{"className":"life-ad-space-brand"},"children":[{"tag":"img","props":{"src":"/sites/howtolivebetter/images/shengcai/logo.png","width":"565","height":"144","alt":"生財有術の公式ロゴ","decoding":"async"},"children":[]}]},{"tag":"div","props":{"className":"life-ad-space-copy"},"children":[{"tag":"span","props":{"className":"life-ad-space-label"},"children":["広告 · コミュニティ紹介"]},{"tag":"strong","props":{},"children":["学んだ知識は、役立つ製品になる？"]},{"tag":"p","props":{},"children":["電子書籍や小さなツール。需要を見つけ、知識を使える形にする参加者の実践を紹介します。"]}]},{"tag":"div","props":{"className":"life-ad-space-actions"},"children":[{"tag":"a","props":{"className":"life-ad-space-link","href":"/ja/shengcaiyoushu?sc_group=reading&sc_creative=read_product&sc_placement=ad_header"},"children":["コミュニティと事例を見る",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"18","height":"18","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-up-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M7 7h10v10"},"children":[]},{"tag":"path","props":{"d":"M7 17 17 7"},"children":[]}]}]}]}]},{"tag":"div","props":{"className":"life-ad-layout life-ad-layout-toc"},"children":[{"tag":"div","props":{"className":"life-ad-rail","data-dock-active":"false","style":{"top":"94px"}},"children":[{"tag":"div","props":{"className":"life-ad-dock","hidden":true},"children":[{"tag":"aside","props":{"className":"life-ad-space life-ad-space-sponsored life-ad-space-compact","data-ad-placement":"ad_dock","data-ad-group":"reading","data-ad-creative":"read_product","data-ad-ready":"false","aria-label":"広告 · コミュニティ紹介"},"children":[{"tag":"button","props":{"type":"button","className":"life-ad-dismiss","aria-label":"広告を閉じる"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-x","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M18 6 6 18"},"children":[]},{"tag":"path","props":{"d":"m6 6 12 12"},"children":[]}]}]},{"tag":"div","props":{"className":"life-ad-space-brand"},"children":[{"tag":"img","props":{"src":"/sites/howtolivebetter/images/shengcai/logo.png","width":"565","height":"144","alt":"生財有術の公式ロゴ","decoding":"async"},"children":[]}]},{"tag":"div","props":{"className":"life-ad-space-copy"},"children":[{"tag":"span","props":{"className":"life-ad-space-label"},"children":["広告 · コミュニティ紹介"]},{"tag":"strong","props":{},"children":["学んだ知識は、役立つ製品になる？"]},{"tag":"p","props":{},"children":["電子書籍や小さなツール。需要を見つけ、知識を使える形にする参加者の実践を紹介します。"]}]},{"tag":"div","props":{"className":"life-ad-space-actions"},"children":[{"tag":"a","props":{"className":"life-ad-space-link","href":"/ja/shengcaiyoushu?sc_group=reading&sc_creative=read_product&sc_placement=ad_dock"},"children":["コミュニティと事例を見る",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"18","height":"18","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-up-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M7 7h10v10"},"children":[]},{"tag":"path","props":{"d":"M7 17 17 7"},"children":[]}]}]}]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/ja/book/13"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"目次に戻る"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["緊急事態：まず何をすべきか"]},{"tag":"div","props":{"data-ad-dock-host":"true"},"children":[]},{"tag":"nav","props":{"aria-label":"この章のヒント"},"children":[{"tag":"a","props":{"href":"/ja/tip/13-01"},"children":[{"tag":"span","props":{},"children":["01"]},"人が倒れて呼吸をしていない場合は、すぐに胸を強く圧迫し、周囲の人に 120 を呼び、AEDを探すよう指示してください"]},{"tag":"a","props":{"href":"/ja/tip/13-02"},"children":[{"tag":"span","props":{},"children":["02"]},"高齢者や人が倒れたら、まずしゃがんで呼びかけ120へ。急いで起こさない。中国では見知らぬ人から立ち去るのも合法だが、立ち止まってもむやみに動かさない"]},{"tag":"a","props":{"href":"/ja/tip/13-03"},"children":[{"tag":"span","props":{},"children":["03"]},"突然口角がゆがむ、片腕に力が入らない、言葉が不明瞭になったら、すぐに 120 へ電話してください。待ってはいけません。自分で運転して行ってはいけません。"]},{"tag":"a","props":{"href":"/ja/tip/13-04"},"children":[{"tag":"span","props":{},"children":["04"]},"突然のめまい、複視、片目の暗転、あるいは指で自分の鼻先を指せない。これらも脳卒中として 120 を呼び、記録すべき症状です"]},{"tag":"a","props":{"href":"/ja/tip/13-05"},"children":[{"tag":"span","props":{},"children":["05"]},"片方の目が突然、カーテンを下ろしたかのように暗くなった場合、たとえ数分で自然に回復したとしても、その日のうちに脳卒中を疑って救急外来を受診してください"]},{"tag":"a","props":{"href":"/ja/tip/13-06"},"children":[{"tag":"span","props":{},"children":["06"]},"片方の目が腫れぼったく痛み、充血しており、光を見ると虹色の輪が見える。さらに頭痛や吐き気も伴い、その日のうちに眼科救急を受診した"]},{"tag":"a","props":{"href":"/ja/tip/13-07"},"children":[{"tag":"span","props":{},"children":["07"]},"胸が圧迫されるような痛み、圧迫感、締め付け感が 15 分以上続き、和らがない場合は、120 に電話してください。自分で我慢したり、自分で運転したりしないでください。"]},{"tag":"a","props":{"href":"/ja/tip/13-08"},"children":[{"tag":"span","props":{},"children":["08"]},"突然、引き裂かれるような激痛が胸から背中、腰へと移動する場合、120 に電話し、「痛みが移動している」とはっきり伝えてください。"]},{"tag":"a","props":{"href":"/ja/tip/13-09"},"children":[{"tag":"span","props":{},"children":["09"]},"突然「人生で最も激しい頭痛」が起こり、1時間以内にピークに達する場合、直ちに救急外来で頭部CTを受けてください。"]},{"tag":"a","props":{"href":"/ja/tip/13-10"},"children":[{"tag":"span","props":{},"children":["10"]},"高齢者が頭を打った後、2〜3週間から数ヶ月して歩行が不安定、鈍化、嗜睡、または片側に力が入らなくなった場合は、頭部CT検査を受けてください"]},{"tag":"a","props":{"href":"/ja/tip/13-11"},"children":[{"tag":"span","props":{},"children":["11"]},"片方の足が突然腫れたり、張ったり、押すと痛みを感じたりする場合は、早急に受診してください。さらに突然の息切れや胸痛が伴う場合は、直ちに 120 に電話してください。"]},{"tag":"a","props":{"href":"/ja/tip/13-12"},"children":[{"tag":"span","props":{},"children":["12"]},"大量出血時はまず手で傷口を強く圧迫し、四肢で抑えきれない場合は止血帯を使用、同時に 120 を呼ぶ"]},{"tag":"a","props":{"href":"/ja/tip/13-13"},"children":[{"tag":"span","props":{},"children":["13"]},"犬や猫に噛まれたり、ひっかかれて皮膚が傷ついたりした場合は、まず石鹸水と流水を交互に 15 分間洗い流し、当日にワクチンを接種してください"]},{"tag":"a","props":{"href":"/ja/tip/13-14"},"children":[{"tag":"span","props":{},"children":["14"]},"火傷の後はすぐに冷たい流水で 20 分間流してください。歯磨き粉や醤油は塗らないこと"]},{"tag":"a","props":{"href":"/ja/tip/13-15"},"children":[{"tag":"span","props":{},"children":["15"]},"突然、全身に発疹が出たり、息苦しさやめまいを感じたりした場合は、アナフィラキシー・ショックとして対処し、直ちに 120 を呼び、状況を明確に伝えてください"]},{"tag":"a","props":{"href":"/ja/tip/13-16"},"children":[{"tag":"span","props":{},"children":["16"]},"けいれんして倒れた人がいたら、周囲を片付け、横向きに寝かせ、時計で時間を計る。口の中に何も入れないこと"]},{"tag":"a","props":{"href":"/ja/tip/13-17"},"children":[{"tag":"span","props":{},"children":["17"]},"糖尿病患者が突然の震え、冷や汗、ろれつが回らない状態になったら、まず 15 グラムの糖分を摂取させ、15 分後に再測定してください"]},{"tag":"a","props":{"href":"/ja/tip/13-18"},"children":[{"tag":"span","props":{},"children":["18"]},"感電事故が発生した際は、まず電源を遮断し、次に乾いた棒などを使って電源から引き離してください。直接手で引っ張ってはいけません"]},{"tag":"a","props":{"href":"/ja/tip/13-19"},"children":[{"tag":"span","props":{},"children":["19"]},"一酸化炭警報器が鳴った、あるいは部屋にいる全員が同時に頭痛や吐き気を感じたら、まずは外に出てから電話をしてください"]},{"tag":"a","props":{"href":"/ja/tip/13-20"},"children":[{"tag":"span","props":{},"children":["20"]},"洗剤、農薬、医薬品の誤飲時は無理に吐かせず、容器を持って直ちに受診してください。目や皮膚に付着した場合は、大量の流水で少なくとも 15 分間洗浄してください"]},{"tag":"a","props":{"href":"/ja/tip/13-21"},"children":[{"tag":"span","props":{},"children":["21"]},"酸・アルカリ等の化学薬品が体に付着した場合は、直ちに汚染された衣類を脱ぎ、大量の流水で洗い流してください。目はまぶたを広げて洗浄し、十分な時間をかけてから移動してください。"]},{"tag":"a","props":{"href":"/ja/tip/13-22"},"children":[{"tag":"span","props":{},"children":["22"]},"高温下でめまい、吐き気、発汗停止、または意識混濁がある場合は、直ちに涼しい場所に移動し、衣服を脱がせて水を浴びせて体温を下げてください。意識が混濁している場合は水を飲ませず、 120 を呼んでください。"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/ja/tip/13-23","data-status":"active"},"children":[{"tag":"span","props":{},"children":["23"]},"熱中症の人が意識がはっきりしている場合は、冷たい薄い塩水またはスポーツ飲料を、少量ずつ頻回に飲ませてください。一気に飲ませたり、アルコールや高糖度の飲料を飲ませたりしないでください。"]},{"tag":"a","props":{"href":"/ja/tip/13-24"},"children":[{"tag":"span","props":{},"children":["24"]},"火災時は地面に這いつくばり、ドアに触れて確認してから開ける。ドアが熱い場合は開けない。階段を使い、エレベーターは使わない。外に出たら、振り返らない。"]},{"tag":"a","props":{"href":"/ja/tip/13-25"},"children":[{"tag":"span","props":{},"children":["25"]},"溺水者を見かけたら、まずは周囲に助けを求め 110/120 に電話し、棒を伸ばしたり浮遊物を投げたりする。自分は水に入らない"]},{"tag":"a","props":{"href":"/ja/tip/13-26"},"children":[{"tag":"span","props":{},"children":["26"]},"窒息して声が出ない1歳以上の人には、背後から背部叩打5回と腹部突き上げ5回。倒れたら心肺蘇生"]},{"tag":"a","props":{"href":"/ja/tip/13-27"},"children":[{"tag":"span","props":{},"children":["27"]},"ゴビ砂漠、砂漠、無人地帯で道に迷った、または車が故障した場合は、その場または車のそばに留まり、まず現在地を報告し、次に日よけと保温を行い、水を節約し、むやみに動かないこと"]},{"tag":"a","props":{"href":"/ja/tip/13-28"},"children":[{"tag":"span","props":{},"children":["28"]},"震え、ろれつが回らない、ふらつきは低体温症の兆候。濡れた服を脱がせ、包み込み、まずは体幹を温める。温かい甘い飲み物を与える（アルコールは避ける）"]},{"tag":"a","props":{"href":"/ja/tip/13-29"},"children":[{"tag":"span","props":{},"children":["29"]},"蛇に噛まれたら、座って動かない。指輪や時計を外し、早急に抗蛇毒血清のある病院へ搬送する。切らない、吸わない、強く縛らない"]},{"tag":"a","props":{"href":"/ja/tip/13-30"},"children":[{"tag":"span","props":{},"children":["30"]},"地震の際はまず自分がどのような建物にいるかを確認：耐震設計された建物ならその場で待避、倒壊の恐れがある古い建物なら、出口が数歩先なら外へ出る"]},{"tag":"a","props":{"href":"/ja/tip/13-31"},"children":[{"tag":"span","props":{},"children":["31"]},"クマ、イノシシ、野犬の群れに遭遇したら、走らず、横を向いてゆっくり後退する"]},{"tag":"a","props":{"href":"/ja/tip/13-32"},"children":[{"tag":"span","props":{},"children":["32"]},"野外で雷雨に遭遇したら、硬い屋根のある車や建物の中に避難し、尾根、孤立した木、水面、金属から離れる"]},{"tag":"a","props":{"href":"/ja/tip/13-33"},"children":[{"tag":"span","props":{},"children":["33"]},"高地へ行く際は、睡眠高度（その夜眠る高さ）に合わせてゆっくりと高度を上げ、症状が悪化したら無理をせず下山する"]},{"tag":"a","props":{"href":"/ja/tip/13-34"},"children":[{"tag":"span","props":{},"children":["34"]},"マダニに噛まれたら、先の細いピンセットで皮膚に沿わせながら、ゆっくりと垂直に引き抜く。油を塗ったり火で炙ったりしてはいけない"]},{"tag":"a","props":{"href":"/ja/tip/13-35"},"children":[{"tag":"span","props":{},"children":["35"]},"野外の水は必ず沸騰させてから飲むこと。1分間の沸騰で十分であり、標高が高いからといって長く煮る必要はない"]},{"tag":"a","props":{"href":"/ja/tip/13-36"},"children":[{"tag":"span","props":{},"children":["36"]},"人里離れた場所で知らない人に財物を要求されたら、お金を渡し、抵抗せず、特徴を覚え、逃げた後に通報する"]},{"tag":"a","props":{"href":"/ja/tip/13-37"},"children":[{"tag":"span","props":{},"children":["37"]},"喧嘩の場面に遭遇したら、離れて立ち去ること。仲裁に入ったり、野次馬になったり、地面に落ちている武器を拾ったりしてはいけない。通報する場合は、安全な距離まで退いてから 110 する必要がある。"]},{"tag":"a","props":{"href":"/ja/tip/13-38"},"children":[{"tag":"span","props":{},"children":["38"]},"HIVに曝露した可能性があります。72時間以内に予防薬（PEP）を受け取ってください。早ければ早いほど良いです。"]},{"tag":"a","props":{"href":"/ja/tip/13-39"},"children":[{"tag":"span","props":{},"children":["39"]},"人を救って怪我をし、金銭的負担を負った場合は、まず加害者と医療保険に請求し、その後に義勇行為の認定申請を行う"]},{"tag":"a","props":{"href":"/ja/tip/13-40"},"children":[{"tag":"span","props":{},"children":["40"]},"ナイフ、鉄筋、ガラスなどが体に刺さった場合、異物の周囲を圧迫して止血し、決して引き抜かないこと"]},{"tag":"a","props":{"href":"/ja/tip/13-41"},"children":[{"tag":"span","props":{},"children":["41"]},"骨折が疑われる場合はその部位を動かさない。動かさずに固定し、20 分以内を目安に冷やしてください。自分で無理に整復しないでください。"]},{"tag":"a","props":{"href":"/ja/tip/13-42"},"children":[{"tag":"span","props":{},"children":["42"]},"性被害に遭った後は、まず安全な場所に移動して 110番に通報してください。診察・証拠採取の前は、入浴、洗濯、部屋の片付けはしないでください。72 時間以内に病院へ行ってください。"]},{"tag":"a","props":{"href":"/ja/tip/13-43"},"children":[{"tag":"span","props":{},"children":["43"]},"1歳未満の乳児が詰まって声が出せない時：背中を5回叩き、仰向けにして胸を5回圧迫、これを繰り返す。お腹は押さないこと"]},{"tag":"a","props":{"href":"/ja/tip/13-44"},"children":[{"tag":"span","props":{},"children":["44"]},"1歳未満の乳児に反応がなく、正常な呼吸が見られない場合は、スピーカーフォンで120番（救急）に電話し、乳児心肺蘇生法を行う：30回の圧迫に対して2回の人工呼吸"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"現在地"},"children":[{"tag":"a","props":{"href":"/ja/book"},"children":["本を読む"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/ja/book/13"},"children":["第13章"," ·"," ","緊急事態：まず何をすべきか"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"13-23"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["23"]},{"tag":"span","props":{"className":"life-evidence grade-b"},"children":["エビデンス"," ","B"]}]},{"tag":"h1","props":{"lang":"ja"},"children":["熱中症の人が意識がはっきりしている場合は、冷たい薄い塩水またはスポーツ飲料を、少量ずつ頻回に飲ませてください。一気に飲ませたり、アルコールや高糖度の飲料を飲ませたりしないでください。"]},{"tag":"p","props":{"lang":"ja","className":"life-entry-summary"},"children":["意識がはっきりしている人にのみ飲ませてください。冷たい薄い塩水またはスポーツ飲料を、少量ずつ頻回に、1時間あたり 500 〜 1000 ml飲ませます。一気に飲ませないでください、吐き出して気管に入ると命に関わります。アルコールや高糖度の飲料は、さらなる脱水を招くため避けてください。まずは冷水で体を拭き、氷嚢を首、脇の下、太ももの付け根に当てて体温を下げてから、水分補給を行います。意識が混濁している、またはろれつが回らない場合は、一口も飲ませないでください。"]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["費用・手間"]},{"tag":"p","props":{},"children":["費用はかかりません。スポーツ飲料1本につき数元程度です。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["効果"]},{"tag":"p","props":{},"children":["中国疾控中心（CDC）は『公衆熱中症予防および緊急処置ガイドライン（2014 版）』を発行しています。"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"記録する：熱中症の人が意識がはっきりしている場合は、冷たい薄い塩水またはスポーツ飲料を、少量ずつ頻回に飲ませてください。一気に飲ませたり、アルコールや高糖度の飲料を飲ませたりしないでください。"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"できている"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"やることに追加"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"お気に入り"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"このヒントを共有"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"詳細を閉じる"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["費用・手間"]},{"tag":"p","props":{},"children":["費用はかかりません。スポーツ飲料1本につき数元程度です。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["効果"]},{"tag":"p","props":{},"children":["中国疾控中心（CDC）は『公衆熱中症予防および緊急処置ガイドライン（2014 版）』を発行しています。そこには「少なくとも1時間につき 2 〜 4 杯の冷たい水（500 〜 1000 ml）を、水温が高すぎないように、少量ずつ頻回に飲むこと」と記されています。また、「アルコールや大量の糖分を含む飲料は飲まないこと。これらの飲料はさらなる体液の喪失を招く。同時に、冷たすぎる氷飲料も避けるべきである」とも記されています。熱射病については「患者に水を飲ませないこと」と明記されています。米国NIOSHによれば、熱疲労（熱失脱）の場合は「冷たい水を小口で頻繁に飲むことを推奨」し、熱痙攣の場合は、糖分と電解質を含むスポーツ飲料を、15 〜 20 分ごとに補給し、「塩錠は使用しない」としています。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["出典"]},{"tag":"p","props":{"className":"life-citations"},"children":["中国疾病预防控制中心职业卫生与中毒控制所 (2014). 公众高温中暑预防与紧急处理指南（2014 版）. ",{"tag":"a","props":{"href":"https://niohp.chinacdc.cn/sndt/201405/t20140530_97623.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://niohp.chinacdc.cn/sndt/201405/t20140530_97623.htm"]}," ; US CDC/NIOSH. Heat-Related Illnesses. ",{"tag":"a","props":{"href":"https://www.cdc.gov/niosh/heat-stress/about/illnesses.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.cdc.gov/niosh/heat-stress/about/illnesses.html"]}]},{"tag":"a","props":{"href":"https://niohp.chinacdc.cn/sndt/201405/t20140530_97623.htm","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["出典を開く"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["著者の注記"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["大量の発汗後に水（白湯）だけを飲むと、血液中の塩分が薄まってしまいます（低ナトリウム血症）。そのため、水には少量の塩分を含める必要があります。一度に大量に飲むと嘔吐しやすく、吐いたものが気管に入ると、熱中症そのものよりも早く命を落とす危険があります。「キンキンに冷えたものは飲まない」というのは、中国疾控の 2014 年版ガイドラインの推奨ですが、その理由は胃痙攣を恐れてのことであり、定量的な証拠はありません。これを「冷たいものは使ってはいけない」と誤解しないでください。第 22 条（高温下でのめまい・吐き気時の衣服脱衣・水浴冷却法）では、いくつかの冷却法が挙げられています。具体的には、冷水での拭い、冷水への浸漬、首・脇の下・太る付け根（鼠径部）への氷嚢の適用です。これらはまさに、公式が推奨する第一段階の冷却法であり、口に飲ませるのではなく、体に使うものです。冷却は常に水分補給よりも優先されます。意識が混濁している、またはろれつが回らない場合は、一口も飲ませないでください。"]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["自分のメモ"]},{"tag":"button","props":{"type":"button"},"children":["自分へのメモを書く…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/ja/tip/13-22"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["前へ"]},"高温下でめまい、吐き気、発汗停止、または意識混濁がある場合は、直ちに涼しい場所に移動し、衣服を脱がせて水を浴びせて体温を下げてください。意識が混濁している場合は水を飲ませず、 120 を呼んでください。"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/ja/tip/13-24"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["次へ"]},"火災時は地面に這いつくばり、ドアに触れて確認してから開ける。ドアが熱い場合は開けない。階段を使い、エレベーターは使わない。外に出たら、振り返らない。"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["このテーマの他の提案"]},{"tag":"ul","props":{},"children":[{"tag