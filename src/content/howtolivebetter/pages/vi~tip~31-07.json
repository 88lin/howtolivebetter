"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Chia sẻ mẹo này"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Ẩn chi tiết"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Chi phí"]},{"tag":"p","props":{},"children":["Không tốn tiền. Cái giá là hai năm phục vụ ở cơ sở cấp xã. Hai năm đó bạn nhận trợ cấp ngân sách, không phải lương thị trường, chỗ khó là chịu được hai năm ấy."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Lợi ích"]},{"tag":"p","props":{},"children":["Thông báo của kế hoạch「三支一扶」đợt thứ tư viết「服务期为两年」, tức thời gian phục vụ là hai năm. Nó còn viết:「各省（区、市）每年应拿出公务员考录计划的 10％左右，面向『三支一扶』计划等服务基层项目人员定向考录。各省（区、市）县乡基层事业单位公开招聘时，应根据本地区实际拿出一定数量或比例的岗位，对『三支一扶』服务期满考核合格的人员进行专项招聘……聘用后可以不再约定试用期」, tức mỗi năm mỗi tỉnh (khu vực, thành phố) phải dành khoảng 10％ chỉ tiêu tuyển công chức để tuyển định hướng người tham gia chương trình phục vụ cơ sở kiểu「三支一扶」; khi các tỉnh (khu vực, thành phố) tuyển công chức công lập ở cấp huyện, xã, thôn, thì phải dành ra một số lượng hoặc tỷ lệ vị trí thực tế của địa phương để tuyển đặc biệt những người tham gia「三支一扶」đủ hạn và đạt kết quả đánh giá; sau khi bổ nhiệm thì có thể không còn quy định thử việc. Tuyển định hướng và tuyển đặc biệt nghĩa là phần chỉ tiêu đó chỉ thi cho người từng làm chương trình phục vụ cơ sở, người khác không thi được. Cùng thông báo đó còn viết:「期满考核合格的『三支一扶』人员，三年内参加全国硕士研究生招生考试的，初试总分加 10 分，同等条件下优先录取……高职（高专）毕业生期满且考核合格的，可免试入读成人高等学历教育专科起点本科」, tức người tham gia「三支一扶」đủ hạn và đạt kết quả đánh giá thì trong ba năm dự thi tuyển sinh cao học toàn quốc được cộng 10 điểm tổng điểm kỳ thi đầu và cùng điều kiện thì được tuyển trước; tốt nghiệp cao đẳng (cao đẳng nghề) đủ hạn và đạt kết quả đánh giá thì được miễn thi vào học chương trình chính quy bậc đại học của giáo dục tiếp tục sau đại học. Miễn thi vào học nghĩa là không phải thi lại, vào học thẳng bậc đại học. Thông báo còn viết:「参加『三支一扶』计划前无工作经历的人员期满且考核合格的，两年内在参加机关和企事业单位考录（招聘）、自主创业、落户、升学等方面可同等享受应届毕业生相关政策。『三支一扶』人员在基层服务年限计算为工龄，其参加工作时间按其到基层报到之日起算」, tức người trước khi tham gia「三支一扶」chưa có kinh nghiệm làm việc, sau khi đủ hạn và đạt kết quả đánh giá thì trong hai năm được hưởng ngang nhau chính sách dành cho người mới tốt nghiệp trong các việc dự tuyển công chức của cơ quan và đơn vị, tự lập nghiệp, lập hộ khẩu, học tiếp; thời gian phục vụ ở cơ sở được tính vào thâm niên công, thời gian làm việc tính từ ngày đến cơ sở báo cáo. Mức trợ cấp của ngân sách trung ương là khu vực phía Tây mỗi người mỗi năm 3 vạn tệ, khu vực trung 2.4 vạn tệ, khu vực phía Đông 1.2 vạn tệ. Ý kiến của Văn phòng Trung ương Đảng và Văn phòng Hội đồng Nhà nước viết:「参加基层服务项目前无工作经历的人员服务期满且考核合格后 2 年内，在参加机关事业单位考录（招聘）、各类企业吸纳就业、自主创业、落户、升学等方面可同等享受应届高校毕业生的相关政策」, tức người trước khi tham gia chương trình phục vụ cơ sở chưa có kinh nghiệm làm việc, sau khi đủ hạn và đạt kết quả đánh giá thì trong 2 năm được hưởng ngang nhau chính sách dành cho người mới tốt nghiệp đại học trong các việc dự tuyển của cơ quan công chức, các loại doanh nghiệp tiếp nhận người lao động, tự lập nghiệp, lập hộ khẩu, học tiếp. Ý kiến đó còn viết:「省级以上机关录用公务员，除特殊职位外，按照有关规定一律从具有 2 年以上基层工作经历的人员中考录」, tức cơ quan cấp tỉnh trở lên tuyển công chức, trừ các chức vụ đặc biệt, phải tuyển từ người có từ 2 năm kinh nghiệm làm việc ở cơ sở. Một con đường khác là Kế hoạch phía Tây. Nó do「共青团中央、教育部、财政部、人力资源社会保障部共同组织实施」, tức Ban Thanh đoàn Trung ương Đảng, Bộ Giáo dục, Bộ Tài chính và Bộ Nhân sự và Xã hội cùng tổ chức thực hiện. Nó tuyển sinh viên đại học mới tốt nghiệp hoặc học sau đại học đang học, để「到西部基层从事为期 1—3 年」tình nguyện ở cơ sở phía Tây trong thời hạn từ 1 đến 3 năm (toàn quốc)"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Nguồn gốc"]},{"tag":"p","props":{"className":"life-citations"},"children":["中共中央组织部、人力资源社会保障部等十部门 (2021). 关于实施第四轮高校毕业生「三支一扶」计划的通知（人社部发〔2021〕32 号，第七、八、九、十一、十二、十三条）. ",{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/2021-06/04/content_5615404.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/zhengce/zhengceku/2021-06/04/content_5615404.htm"]},"；中共中央办公厅、国务院办公厅 (2017). 关于进一步引导和鼓励高校毕业生到基层工作的意见（第五、十六、十八条）. ",{"tag":"a","props":{"href":"http://www.gov.cn/gongbao/content/2017/content_5171278.htm","target":"_blank","rel":"noopener noreferrer"},"children":["http://www.gov.cn/gongbao/content/2017/content_5171278.htm"]},"；全国大学生志愿服务西部计划项目管理办公室 (2026). 2026—2027 年度大学生志愿服务西部计划招募协议书. ",{"tag":"a","props":{"href":"http://xibu.youth.cn/tzgg/202604/t20260423_16623558.htm","target":"_blank","rel":"noopener noreferrer"},"children":["http://xibu.youth.cn/tzgg/202604/t20260423_16623558.htm"]}]},{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/2021-06/04/content_5615404.htm","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Liên kết mở nguồn"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Ghi chú sách"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["Kế hoạch「三支一扶」đợt thứ tư áp dụng cho giai đoạn 2021 đến 2025. Lần này không tìm được văn bản của đợt thứ năm và thông báo năm 2026, trước khi đăng ký hãy tra thông báo tuyển sinh của năm đó. Năm 2025 ngân sách trung ương hỗ trợ tuyển 34430 người. Nguyên văn phương án thực hiện của Kế hoạch phía Tây không tra được trên mạng, trang chính thức mở mục chính sách không ra nội dung. Các ưu đãi sau khi đủ hạn thì theo văn bản của Văn phòng Trung ương Đảng và Văn phòng Hội đồng Nhà nước, vốn quản lý mọi chương trình phục vụ cơ sở. Hai năm đó chỉ nhận trợ cấp ngân sách chứ không phải lương thị trường, cái giá này phải tính cùng với kế hoạch tuyển định hướng sau hai năm."]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Ghi chú của tôi"]},{"tag":"button","props":{"type":"button"},"children":["Viết một lời nhắc cho chính bạn…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/vi/tip/31-06"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Trước"]},"Ba khoản sau khi giải ngũ: tiền trở cấp một lần, thời gian phục vụ tính vào thâm niên công, và tự làm ăn thì mỗi năm giảm 20000 tệ thuế"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/vi/tip/31-08"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Tiếp theo"]},"Giáo viên vị trí đặc biệt hết hạn ba năm, đạt kết quả đánh giá và còn muốn ở lại thì phải được chuyển thành biên chế đúng thời hạn"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["Thêm trong chủ đề này"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/31-03"},"children":[{"tag":"strong","props":{},"children":["Sau khi được truy xuất mà từ chối nghĩa vụ quân sự thì trong hai năm không được xuất cảnh, không được học tiếp, và không vào được cơ quan công chức hay doanh nghiệp nhà nước"]},{"tag":"span","props":{},"children":["Đã đăng ký rồi lại từ chối đi nhập ngũ thì hậu quả là một loạt. Không…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/31-04"},"children":[{"tag":"strong","props":{},"children":["Hai điều thật nhất khi sinh viên đại học đi nghĩa vụ quân sự: học phí mỗi năm bù tối đa 20000 tệ, giữ học vị hai năm, và có một kế hoạch riêng ch