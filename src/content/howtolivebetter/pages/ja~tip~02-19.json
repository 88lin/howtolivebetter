"children":[{"tag":"span","props":{},"children":["11"]},"毎日 7000–8000 歩歩く、または週に合計 150–300 分間の早歩きを行う"]},{"tag":"a","props":{"href":"/ja/tip/02-12"},"children":[{"tag":"span","props":{},"children":["12"]},"高血圧・高脂血症がある場合は医師の指示通りに服薬し、自己判断で中断しない"]},{"tag":"a","props":{"href":"/ja/tip/02-13"},"children":[{"tag":"span","props":{},"children":["13"]},"毎晩約7時間の睡眠、規則正しい生活リズム"]},{"tag":"a","props":{"href":"/ja/tip/02-14"},"children":[{"tag":"span","props":{},"children":["14"]},"テニス、バドミントン、卓球などのラケットスポーツを日常的に行う"]},{"tag":"a","props":{"href":"/ja/tip/02-15"},"children":[{"tag":"span","props":{},"children":["15"]},"階段的な強度の活動（階段を上る、早歩きなど）を、1日合計4〜5分間に集める"]},{"tag":"a","props":{"href":"/ja/tip/02-16"},"children":[{"tag":"span","props":{},"children":["16"]},"週に30–60分の筋力トレーニングを行う"]},{"tag":"a","props":{"href":"/ja/tip/02-17"},"children":[{"tag":"span","props":{},"children":["17"]},"長時間座りっぱなしを避け、定期的に立ち上がって動く"]},{"tag":"a","props":{"href":"/ja/tip/02-18"},"children":[{"tag":"span","props":{},"children":["18"]},"加工肉（ハム、ベーコン、ソーセージ、 luncheon meat）の摂取を控える"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/ja/tip/02-19","data-status":"active"},"children":[{"tag":"span","props":{},"children":["19"]},"飲酒を控える、または断酒する"]},{"tag":"a","props":{"href":"/ja/tip/02-20"},"children":[{"tag":"span","props":{},"children":["20"]},"毎日飲酒しており、やめると手が震えたり動悸がしたりする人は、無理に断酒しないでください"]},{"tag":"a","props":{"href":"/ja/tip/02-21"},"children":[{"tag":"span","props":{},"children":["21"]},"飲酒量を減らしたいなら、まずは1週間にどれだけ飲んだかを数え、それから医師と数分間話しましょう"]},{"tag":"a","props":{"href":"/ja/tip/02-22"},"children":[{"tag":"span","props":{},"children":["22"]},"毎日ひとつかみのナッツを食べる"]},{"tag":"a","props":{"href":"/ja/tip/02-23"},"children":[{"tag":"span","props":{},"children":["23"]},"赤身肉の一部を魚や鶏肉に置き換える"]},{"tag":"a","props":{"href":"/ja/tip/02-24"},"children":[{"tag":"span","props":{},"children":["24"]},"精白米や白小麦粉の一部を全粒穀物に置き換える"]},{"tag":"a","props":{"href":"/ja/tip/02-25"},"children":[{"tag":"span","props":{},"children":["25"]},"週に3回以上、お茶を飲む"]},{"tag":"a","props":{"href":"/ja/tip/02-26"},"children":[{"tag":"span","props":{},"children":["26"]},"毎日3〜4杯のコーヒーを、砂糖やミルクなしで飲む"]},{"tag":"a","props":{"href":"/ja/tip/02-27"},"children":[{"tag":"span","props":{},"children":["27"]},"毎日、十分な量の 5 単位（約 400 g）の果物と野菜を食べる"]},{"tag":"a","props":{"href":"/ja/tip/02-28"},"children":[{"tag":"span","props":{},"children":["28"]},"超加工食品（ポテトチップス、インスタントラーメン、菓子類、ファストフード）の摂取を控える"]},{"tag":"a","props":{"href":"/ja/tip/02-29"},"children":[{"tag":"span","props":{},"children":["29"]},"料理や暖房に石炭や薪を使わず、電気やガスに切り替える"]},{"tag":"a","props":{"href":"/ja/tip/02-30"},"children":[{"tag":"span","props":{},"children":["30"]},"熱いものは少し冷ましてから飲む。熱すぎる茶、スープ、コーヒーは避ける"]},{"tag":"a","props":{"href":"/ja/tip/02-31"},"children":[{"tag":"span","props":{},"children":["31"]},"日中は外出して日光を浴びる。一日中光を避けない"]},{"tag":"a","props":{"href":"/ja/tip/02-32"},"children":[{"tag":"span","props":{},"children":["32"]},"BMIを20–25に保つ、過体重なら減量"]},{"tag":"a","props":{"href":"/ja/tip/02-33"},"children":[{"tag":"span","props":{},"children":["33"]},"週に4回以上の唐辛子の摂取"]},{"tag":"a","props":{"href":"/ja/tip/02-34"},"children":[{"tag":"span","props":{},"children":["34"]},"毎日1〜2サービングの乳製品またはヨーグルトを摂取"]},{"tag":"a","props":{"href":"/ja/tip/02-35"},"children":[{"tag":"span","props":{},"children":["35"]},"卵は禁止する必要はないが、毎日3〜4個も食べないこと"]},{"tag":"a","props":{"href":"/ja/tip/02-36"},"children":[{"tag":"span","props":{},"children":["36"]},"条件が許すなら入浴を、シャワーだけで済ませない"]},{"tag":"a","props":{"href":"/ja/tip/02-37"},"children":[{"tag":"span","props":{},"children":["37"]},"昼寝は30分以内に抑えること。1時間を超えないように。1〜2時間寝ないと持ちこたえられない場合は原因を調べること"]},{"tag":"a","props":{"href":"/ja/tip/02-38"},"children":[{"tag":"span","props":{},"children":["38"]},"徹夜明けの翌晩には睡眠を補うこと。週末まで溜め込まない"]},{"tag":"a","props":{"href":"/ja/tip/02-39"},"children":[{"tag":"span","props":{},"children":["39"]},"夜勤の期間が長いほど心血管リスクは高まる。配置転換ができるなら早めに検討を"]},{"tag":"a","props":{"href":"/ja/tip/02-40"},"children":[{"tag":"span","props":{},"children":["40"]},"包装済みでSC番号がある食用油を購入すること。小規模な手作り・バラ売りのピーナッツ油は避ける"]},{"tag":"a","props":{"href":"/ja/tip/02-41"},"children":[{"tag":"span","props":{},"children":["41"]},"料理にラードやバターの代わりに植物油を使用：健康のために油を使い分ける必要はなく、亜麻仁油に心臓保護を期待しても意味がない"]},{"tag":"a","props":{"href":"/ja/tip/02-42"},"children":[{"tag":"span","props":{},"children":["42"]},"炒め物や揚げ物の際は換気扇を回すこと。火をつけた瞬間から料理が終わるまで。"]},{"tag":"a","props":{"href":"/ja/tip/02-43"},"children":[{"tag":"span","props":{},"children":["43"]},"閉経前後のほてりや寝汗が生活に支障をきたすなら、婦人科でホルモン療法の評価を受ける。我慢せず、自己判断で薬を買わず、心臓病予防にも使わない"]},{"tag":"a","props":{"href":"/ja/tip/02-44"},"children":[{"tag":"span","props":{},"children":["44"]},"もともと犬を飼いたい人は毎日の散歩を歩行量に含める。長生きだけを目的に飼わない"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"現在地"},"children":[{"tag":"a","props":{"href":"/ja/book"},"children":["本を読む"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/ja/book/02"},"children":["第2章"," ·"," ","ゆっくり死なないために"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"02-19"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["19"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["エビデンス"," ","A"]}]},{"tag":"h1","props":{"lang":"ja"},"children":["飲酒を控える、または断酒する"]},{"tag":"p","props":{"lang":"ja","className":"life-entry-summary"},"children":["週に100 gの純アルコールを摂取した後、飲酒量が増えるほど死亡時期は早まる。100 gの純アルコールは、ビール約2.5 Lに相当する。40歳時点で週に100–200 g飲む人は、寿命が半年ほど短くなり、200–350 g飲む人は1–2年短くなり、350 gを超える人は4–5年短くなる。全体的な健康を考慮すると、最もコストパフォーマンスが良いのは飲まないことである。"]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["費用・手間"]},{"tag":"p","props":{},"children":["費用はかからず、むしろ節約になり、時間も取らない。難しいのは、社交の場で断る際のわずかな気まずさである。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["効果"]},{"tag":"p","props":{},"children":["83件の追跡研究を統合した解析（記録のみ、グループ分けなし、飲酒者60万人を対象）によると、死亡リスクが最も低いのは、週の純アルコール摂取量が100 gを超えない場合であった。"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"記録する：飲酒を控える、または断酒する"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"できている"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"やることに追加"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"お気に入り"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"このヒントを共有"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"詳細を閉じる"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["費用・手間"]},{"tag":"p","props":{},"children":["費用はかからず、むしろ節約になり、時間も取らない。難しいのは、社交の場で断る際のわずかな気まずさである。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["効果"]},{"tag":"p","props":{},"children":["83件の追跡研究を統合した解析（記録のみ、グループ分けなし、飲酒者60万人を対象）によると、死亡リスクが最も低いのは、週の純アルコール摂取量が100 gを超えない場合であった。この量は、ビール2.5 Lの5%相当、あるいは度数40度の白酒300 mLに相当する。40歳時点で週に100–200 g飲む人は、期待寿命が約6ヶ月短くなる。週に200–350 g飲む人は1–2年短くなる。350 gを超える場合は4–5年短くなる。上記3項目は、原文では寿命の年数として報告されている。世界疾病負荷研究（GBD 2016）では、あらゆる健康損失を統合して算出しており、リスクが最も低い飲酒量は週0杯である。また、研究デザインのバイアスを補正した別の統合研究では、毎日1.3–24 g飲む人は、生涯飲酒しない人と比べて死亡リスクが約7%低い（RR 0.93）とされているが、この項目については統計的な有意差は見られなかった。毎日45–64 g飲む人は約19%高く（RR 1.19）、毎日65 g以上の人は約35%高い（RR 1.35）。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["出典"]},{"tag":"p","props":{"className":"life-citations"},"children":["Wood AM 等 (2018). Risk thresholds for alcohol consumption: combined analysis of individual-participant data for 599 912 current drinkers in 83 prospective studies. Lancet. ",{"tag":"a","props":{"href":"https://doi.org/10.1016/S0140-6736(18)30134-X","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1016/S0140-6736(18)30134-X"]},"；GBD 2016 Alcohol Collaborators (2018). Alcohol use and burden for 195 countries and territories, 1990–2016: a systematic analysis for the Global Burden of Disease Study 2016. Lancet. ",{"tag":"a","props":{"href":"https://doi.org/10.1016/S0140-6736(18)31310-2","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1016/S0140-6736(18)31310-2"]},"；Zhao J 等 (2023). Association Between Daily Alcohol Intake and Risk of All-Cause Mortality: A Systematic Review and Meta-analyses. JAMA Network Open. ",{"tag":"a","props":{"href":"https://doi.org/10.1001/jamanetworkopen.2023.6185","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1001/jamanetworkopen.2023.6185"]},"；Di Castelnuovo A 等 (2006). Alcohol dosing and total mortality in men and women: an updated meta-analysis of 34 prospective studies. Archives of Internal Medicine. ",{"tag":"a","props":{"href":"https://doi.org/10.1001/archinte.166.22.2437","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1001/archinte.166.22.2437"]},"（争议方）"]},{"tag":"a","props":{"href":"https://doi.org/10.1016/S0140-6736(18)30134-X","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["出典を開く"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["著者の注記"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["論争あり。「少量飲酒にはメリットがある」と主張する側は、34件の長期追跡研究の統合結果を根拠としている。それによれば、少量飲酒者の全死亡率は最大で17%–18%低いと報告されている。推奨される量は、男性は1日4杯以内、女性は2杯以内である。この範囲内では、むしろ多く飲む人の方が死亡率が低いとされる。対する反対側は、「飲酒しない」グループには、病気のために断酒した人や、もともと健康状態が悪かった人が混入していると主張している。これらの交絡因子を特別に排除して解析した統合研究では、保護的な効果は見られなくなった。GBD研究も、0杯が最も安全であるという結果を出している。最も妥当な解釈は、「控えることは寿命を明らかに縮めることはないが、飲みすぎることは確実に寿命を縮める」である。「健康のために飲酒を始める」ことに根拠はない。飲酒量を減らしたい場合は、本節の第21条（まず杯数を数えてから医師に相談する）を参照のこと。毎日飲酒する人が自分自身の力だけで無理に断酒してはいけない。本節の第20条（無理に断酒しない）を参照のこと。"]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["自分のメモ"]},{"tag":"button","props":{"type":"button"},"children":["自分へのメモを書く…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/ja/tip/02-18"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["前へ"]},"加工肉（ハム、ベーコン、ソーセージ、 luncheon meat）の摂取を控える"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/ja/tip/02-20"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["次へ"]},"毎日飲酒しており、やめると手が震えたり動悸がしたりする人は、無理に断酒しないでください"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["このテーマの他の提案"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/02-15"},"children":[{"tag":"strong","props":{},"children":["階段的な強度の活動（階段を上る、早歩きなど）を、1日合計4〜5分間に集める"]},{"tag":"span","props":{},"children":["普段全く運動をしない人でも、1日3回、各1〜2分程度の強度の高い活動を行うだけで、同時期の死亡確率は全くしない人と比べて約4割低く、心血管…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/02-16"},"children":[{"tag":"strong","props":{},"children":["週に30–60分の筋力トレーニングを行う"]},{"tag":"span","props":{},"children":["週に30〜60分筋力トレーニングを行う人は、行わない人に比べて同時期の死亡確率が1〜2割低くなります。それ以上行ってもさらなる効果は見込め…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/02-17"},"children":[{"tag":"strong","props":{},"children":["長時間座りっぱなしを避け、定期的に立ち上がって動く"]},{"tag":"span","props":{},"children":["最も長く座っている人の同時期の死亡確率は、最