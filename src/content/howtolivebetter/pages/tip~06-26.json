":[{"tag":"span","props":{},"children":["09"]},"不要为了「更健康」花溢价买有机食品"]},{"tag":"a","props":{"href":"/tip/06-10","className":""},"children":[{"tag":"span","props":{},"children":["10"]},"不要花大钱买保健品、膏方、滋补品来「调理身体」"]},{"tag":"a","props":{"href":"/tip/06-11","className":""},"children":[{"tag":"span","props":{},"children":["11"]},"不要在没有肠道问题时长期吃益生菌"]},{"tag":"a","props":{"href":"/tip/06-12","className":""},"children":[{"tag":"span","props":{},"children":["12"]},"不要为了「增强免疫力」逼自己洗冷水澡"]},{"tag":"a","props":{"href":"/tip/06-13","className":""},"children":[{"tag":"span","props":{},"children":["13"]},"不要买排毒、清肠、酵素、碱性水这类产品"]},{"tag":"a","props":{"href":"/tip/06-14","className":""},"children":[{"tag":"span","props":{},"children":["14"]},"不要为了凑够「每天 8 杯水」强迫自己喝水"]},{"tag":"a","props":{"href":"/tip/06-15","className":""},"children":[{"tag":"span","props":{},"children":["15"]},"不要花钱算命、看塔罗、看星座来做决定"]},{"tag":"a","props":{"href":"/tip/06-16","className":""},"children":[{"tag":"span","props":{},"children":["16"]},"不要买防蓝光眼镜来「保护视力」，也不要相信「对着屏幕干几个月眼睛就废了」，但眼睛胀痛发红要当急症"]},{"tag":"a","props":{"href":"/tip/06-17","className":""},"children":[{"tag":"span","props":{},"children":["17"]},"不要把献血当保健：「排毒、降血脂、防心梗」没有随机试验支持，频繁献倒是真会缺铁"]},{"tag":"a","props":{"href":"/tip/06-18","className":""},"children":[{"tag":"span","props":{},"children":["18"]},"不要靠通用体检套餐防病，按年龄性别做那几项有证据的筛查"]},{"tag":"a","props":{"href":"/tip/06-19","className":""},"children":[{"tag":"span","props":{},"children":["19"]},"不要因为体检查出尿酸高、但从没痛过，就开始吃降尿酸药"]},{"tag":"a","props":{"href":"/tip/06-20","className":""},"children":[{"tag":"span","props":{},"children":["20"]},"不要因为体检查出胆囊结石、但从没疼过，就去预防性切胆囊"]},{"tag":"a","props":{"href":"/tip/06-21","className":""},"children":[{"tag":"span","props":{},"children":["21"]},"不要为了防肾结石把钙戒掉"]},{"tag":"a","props":{"href":"/tip/06-22","className":""},"children":[{"tag":"span","props":{},"children":["22"]},"不要为了「转运」「招财」「养人」买水晶、手串、貔貅这类物件"]},{"tag":"a","props":{"href":"/tip/06-23","className":""},"children":[{"tag":"span","props":{},"children":["23"]},"不要指望买东西改善心情或身份感"]},{"tag":"a","props":{"href":"/tip/06-24","className":""},"children":[{"tag":"span","props":{},"children":["24"]},"不要为了「在周围人里往上挪一档」多花钱换房、换车、换圈子"]},{"tag":"a","props":{"href":"/tip/06-25","className":""},"children":[{"tag":"span","props":{},"children":["25"]},"不要相信「意志力像肌肉，用一会儿就没了」"]},{"tag":"a","props":{"href":"/tip/06-26","className":"active"},"children":[{"tag":"span","props":{},"children":["26"]},"不要指望吃早餐或 16:8 轻断食帮你控制体重，吃饭时间挑你能长期坚持的"]},{"tag":"a","props":{"href":"/tip/06-27","className":""},"children":[{"tag":"span","props":{},"children":["27"]},"不要相信「手淫伤身」「戒色才能变好」，真正要看的是有没有耽误睡觉、工作和关系"]},{"tag":"a","props":{"href":"/tip/06-28","className":""},"children":[{"tag":"span","props":{},"children":["28"]},"不要花钱做「性取向矫正」「同性恋治疗」，也不要把家里人送去"]},{"tag":"a","props":{"href":"/tip/06-29","className":""},"children":[{"tag":"span","props":{},"children":["29"]},"不要指望学会「正确搬运姿势」、上搬运培训就能防腰痛，要减的是搬的重量和次数，平时多锻炼"]},{"tag":"a","props":{"href":"/tip/06-30","className":""},"children":[{"tag":"span","props":{},"children":["30"]},"不要指望骨折之后猛补钙、喝骨头汤能让骨头长得更快"]},{"tag":"a","props":{"href":"/tip/06-31","className":""},"children":[{"tag":"span","props":{},"children":["31"]},"不要指望靠 AI 聊天机器人自己判断病情和法律问题，看病、打官司、花大钱之前，把它说的依据找到原文核一遍"]},{"tag":"a","props":{"href":"/tip/06-32","className":""},"children":[{"tag":"span","props":{},"children":["32"]},"不要因为「人随时会死，早点把钱花完才快乐」就不存钱，三十岁的人约九成能活到六十岁"]}]}]},{"tag":"div","props":{"className":"life-tip-page","data-tip-locales":"zh,en,ru,es,ja,vi"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"当前位置"},"children":[{"tag":"a","props":{"href":"/book"},"children":["阅读全书"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/book/06"},"children":["第 6 章 · 反面清单"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"06-26"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["26"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["证据 A"]}]},{"tag":"h1","props":{"lang":"zh"},"children":["不要指望吃早餐或 16:8 轻断食帮你控制体重，吃饭时间挑你能长期坚持的"]},{"tag":"p","props":{"lang":"zh","className":"life-entry-summary"},"children":["流行说法是不吃早餐会让人午饭晚饭暴食，一天总量反而更多。试验里不是这样：不吃早餐的人一天少吃了两百多千卡，体重还略轻一点。16:8 和单纯少吃比，一年下来体重也没差别。长期不吃早餐的人心血管病确实多约一成七，总死亡率则看不出差别。"]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["成本"]},{"tag":"p","props":{},"children":["不花钱。省下的是每天跟吃饭时间较劲的那点心力。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["收益"]},{"tag":"p","props":{},"children":["先看「不吃早餐会让人后面吃更多」这个说法。一篇荟萃分析把 13 项随机试验合起来算。被分到吃早餐那组的人，每天摄入比不吃早餐那组多 259.79 kcal（95% CI 78.87–440.71，这是可信范围）。体重高 0.44 kg（0.07–0.82）。不吃早餐的人并没有在午饭晚饭补回来。这些试…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"标记：不要指望吃早餐或 16:8 轻断食帮你控制体重，吃饭时间挑你能长期坚持的"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"已做到"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"加入待做"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"收藏"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"分享这条建议"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"收起详情"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["成本"]},{"tag":"p","props":{"className":"life-citations"},"children":["不花钱。省下的是每天跟吃饭时间较劲的那点心力。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["收益"]},{"tag":"p","props":{"className":"life-citations"},"children":["先看「不吃早餐会让人后面吃更多」这个说法。一篇荟萃分析把 13 项随机试验合起来算。被分到吃早餐那组的人，每天摄入比不吃早餐那组多 259.79 kcal（95% CI 78.87–440.71，这是可信范围）。体重高 0.44 kg（0.07–0.82）。不吃早餐的人并没有在午饭晚饭补回来。这些试验跟踪时间都很短，看体重的平均 7 周，看摄入的平均 2 周。再看 16:8 这类只在固定几小时内吃饭的做法。一项让 116 名超重成人做 12 周。只在中午 12 点到晚上 8 点吃饭的那组，和每天规律吃三顿的那组，体重差 −0.26 kg（−1.30 到 0.78），不显著。另一项在广州做，139 名肥胖患者，跟踪 12 个月。限时进食加控制热量，比单纯控制热量多减 1.8 kg（−4.0 到 0.4），也不显著。最后看长期不吃早餐有没有害。238 万人的汇总里，不吃早餐的人心血管病风险高约 17%（OR 1.17，1.09–1.26），心血管死亡高约 49%（OR 1.49，1.20–1.84）。但这些是只记录、不分组的研究。跟踪 17 到 23 年的那项原始研究里，全因死亡的风险比是 1.19，可信范围 0.99 到 1.42，跨过了 1，算不上有差别。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["来源"]},{"tag":"p","props":{"className":"life-citations"},"children":["Sievert K, Hussain SM, Page MJ, 等 (2019). Effect of breakfast on weight and energy intake: systematic review and meta-analysis of randomised controlled trials. BMJ. ",{"tag":"a","props":{"href":"https://doi.org/10.1136/bmj.l42","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1136/bmj.l42"]},"；Lowe DA, Wu N, Rohdin-Bibby L, 等 (2020). Effects of Time-Restricted Eating on Weight Loss and Other Metabolic Parameters in Women and Men With Overweight and Obesity. JAMA Internal Medicine. ",{"tag":"a","props":{"href":"https://doi.org/10.1001/jamainternmed.2020.4153","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1001/jamainternmed.2020.4153"]},"；Liu D, Huang Y, Huang C, 等 (2022). Calorie Restriction with or without Time-Restricted Eating in Weight Loss. New England Journal of Medicine. ",{"tag":"a","props":{"href":"https://doi.org/10.1056/NEJMoa2114833","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1056/NEJMoa2114833"]},"；Zhang H, Zhang S, Liu Y, 等 (2025). The association between skipping breakfast and cardiovascular disease: a meta analysis. Frontiers in Cardiovascular Medicine. ",{"tag":"a","props":{"href":"https://doi.org/10.3389/fcvm.2025.1565806","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.3389/fcvm.2025.1565806"]},"；Rong S, Snetselaar LG, Xu G, 等 (2019). Association of Skipping Breakfast With Cardiovascular and All-Cause Mortality. Journal of the American College of Cardiology. ",{"tag":"a","props":{"href":"https://doi.org/10.1016/j.jacc.2019.01.065","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1016/j.jacc.2019.01.065"]},"；Fernandes-Alves D, Teixeira GP, Guimarães KC, Crispim CA (2026). Systematic Review and Meta-analysis of Randomized Clinical Trials Comparing Time-Restricted Eating With and Without Caloric Restriction for Weight Loss. Nutrition Reviews. ",{"tag":"a","props":{"href":"https://doi.org/10.1093/nutrit/nuaf053","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1093/nutrit/nuaf053"]},"；Sun T, Zhang L, Lu Y, 等 (2024). Non-linear relationship between the first meal time of the day and gallstone incidence in American adults. Frontiers in Nutrition. ",{"tag":"a","props":{"href":"https://doi.org/10.3389/fnut.2024.1521707","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.3389/fnut.2024.1521707"]},"；Liu T, Wang Y, Wang X, 等 (2023). Habitually Skipping Breakfast Is Associated with the Risk of Gastrointestinal Cancers: Evidence from the Kailuan Cohort Study. Journal of General Internal Medicine. ",{"tag":"a","props":{"href":"https://doi.org/10.1007/s11606-023-08094-7","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1007/s11606-023-08094-7"]},""]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["原书备注"]},{"tag":"p","props":{"className":"life-citations"},"children":["争议。心血管那 17% 来自只记录、不分组的研究。不吃早餐的人本来就更可能吸烟、喝酒、久坐、收入低，这些因素校正不干净。所以那 17% 里有多少是早餐本身造成的，说不清。全因死亡那一项本来就跨过了 1。16:8 也有争议：汇总 30 项试验、1341 人，在两组吃一样多的前提下，限时进食那组多减 1.46 kg（−2.65 到 −0.26），代价是多掉 0.41 kg 瘦体重。但这些试验多数很短，最长最严的那项十二个月试验说没差别。长时间空腹还和胆囊有关。一项 6,547 人的横断面调查里，一天中第一餐每晚一小时，查出胆结石的比例高约 5%（OR 1.05，1.02–1.08）；第一餐拖到 9 点至 14 点的人比更早吃的高约 49%（OR 1.49，1.24–1.77）。机制是胆汁在胆囊里存得越久越容易析出结石。但这是同一时点的调查，也可能是先有了胆囊问题才改的吃饭习惯。中国开滦队列跟踪 5.6 年、369 例消化道癌：不吃早餐的人结直肠癌风险 2.32 倍（1.34–4.01），胆囊和肝外胆管癌 5.43 倍（1.34–21.93）。后一个数的可信范围宽到 21.93，说明事件太少，只能当线索看。合起来看，就控制体重而言，吃饭时间的影响很小，别为它花心力。至于长期完全不吃早餐好不好，现有证据全是关联、不能证明因果，但方向一致偏不利，想稳妥就正常吃，只是别指望它帮你减重。胃炎和胃溃疡的主因不是空腹，是幽门螺杆菌和长期吃止痛药，该查的见第 1 节第 23 条（查幽门螺杆菌，阳性就根除）。体检查出胆囊结石但从没疼过该怎么办，见本节第 20 条（体检查出胆囊结石但从没疼过，不要预防性切胆囊）。想控制体重，真正有证据的是吃什么和吃多少，见第 2 节第 27 条（每天吃够 5 份水果蔬菜）、第 2 节第 28 条（少吃超加工食品）和第 2 节第 32 条（把 BMI 控制在 20–25）。糖尿病人、正在吃降糖药或者怀孕的人不适用，漏一顿可能低血糖，按医嘱来。极端断食和催吐是另一回事，见第 28 节第 1 条（不要用极端节食、断食或催吐来控制体重）。"]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["我的备注"]},{"tag":"button","props":{"type":"button"},"children":["写下对自己有用的提醒…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/tip/06-25"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["上一条"]},"不要相信「意志力像肌肉，用一会儿就没了」"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/tip/06-27"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["下一条"]},"不要相信「手淫伤身」「戒色才能变好」，真正要看的是有没有耽误睡觉、工作和关系"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["本主题的其他建议"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/06-22"},"children":[{"tag":"strong","props":{},"children":["不要为了「转运」「招财」「养人」买水晶、手串、貔貅这类物件"]},{"tag":"span","props":{},"children":["说戴了能改运、能招财、能养人，没有可以核查的证据。它和算命显得准是一个道理，话说得足够笼统，你会自己往身上套。商家把话说到治病的功效上就是虚假宣传，2026 年…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/06-23"},"children":[{"tag":"strong","props":{},"children":["不要指望买东西改善心情或身份感"]},{"tag":"span","props":{},"children":["把钱和物质看得越重的人，自己觉得越不幸福，但关联很弱，也分不出谁导致谁。还有研究发现，花钱买一段经历比买东西更让人快乐。所以心情差的时候，把钱花在一次出门、一顿…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/06-24"},"children":[{"tag":"strong","props":{},"children":["不要为了「在周围人里往上挪一档」多花钱换房、换车、换圈子"]},{"tag":"span","props":{},"children":["拿收入一样的人来比，邻居挣得越多，这个人报告的幸福感越低。这只发生在学历和自己相同、又常来往的邻居之间。所以为了搬进一个人人都比你宽裕的地方而多花的钱，买到的是…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/06-28"},"children":[{"tag":"strong","props":{},"children":["不要花钱做「性取向矫正」「同性恋治疗」，也不要把家里人送去"]},{"tag":"span","props":{},"children":["美国心理学会的专家组看完研究后说，这类矫正改不了性取向，还可能伤人。美国一项调查里，做过矫正的人有过自杀念头的多了近九成。国内有精神病院以「性偏好障碍」为名强制…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/06-29"},"children":[{"tag":"strong","props":{},"children":["不要指望学会「正确搬运姿势」、上搬运培训就能防腰痛，要减的是搬的重量和次数，平时多锻炼"]},{"tag":"span","props":{},"children":["上过搬运姿势培训的工人，后来腰痛的并不比没上过的少。搬东西时腰弯得多的人，也没看出更容易腰痛。和腰痛有关的是搬得重、搬得多，每次多搬 10 公斤或每天多搬 10…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/06-30"},"children":[{"tag":"strong","props":{},"children":["不要指望骨折之后猛补钙、喝骨头汤能让骨头长得更快"]},{"tag":"span","props":{},"children":["骨折后补维生素 D 的试验，没有一项看出骨头长得更好。钙和维 D 一起补的研究很少，说不清有没有用。一大碗骨头汤里的钙，只有每天该吃的几十分之一。本来就缺维 D…"]}]}]}]},{"tag":"a","props":{"className":"life-text-link","href":"/book/06"},"children":["阅读整个主题：反面清单 ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"15","height":"15","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]}]}]},{"tag":"nav","props":{"className":"life-tabbar","aria-label":"主导航"},"children":[{"tag":"a","props":{"className":"","href":"/book"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"21","height":"21","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-book-open","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M12 7v14"},"children":[]},{"tag":"path","props":{"d":"M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z"},"children":[]}]},{"tag"