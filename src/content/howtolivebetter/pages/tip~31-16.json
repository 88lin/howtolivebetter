mpact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["成本"]},{"tag":"p","props":{},"children":["咨询不花钱。先跑一次人社部门做资格审核，再到担保机构和经办银行（放贷款的银行）各办一次手续。难在借来的钱终究要还。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["收益"]},{"tag":"p","props":{},"children":["个人申请条件写在《普惠金融发展专项资金管理办法》（财金〔2023〕75 号）第六条。第一个条件是要属于重点就业群体。文件列的是城镇登记失业人员、就业困难人员（含残疾人）、退役军人、刑满释放人员。还有高校毕业生（含大学生村官和留学回国学生）、化解过剩产能企业职工和失业人员。还有返乡创业农民工、网络商户…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"标记：不进单位自己干，起步钱先看创业担保贷款：个人最高 30 万、财政贴一半利息"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"已做到"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"加入待做"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"non