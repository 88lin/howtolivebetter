ound","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M18 20a6 6 0 0 0-12 0"},"children":[]},{"tag":"circle","props":{"cx":"12","cy":"10","r":"4"},"children":[]},{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},{"tag":"span","props":{},"children":["Đăng nhập để đồng bộ hóa"]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/vi/book/34"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"Quay lại mục lục"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["Đừng dùng thuốc trong nhà sai cách"]},{"tag":"nav","props":{"aria-label":"Các mục trong chương"},"children":[{"tag":"a","props":{"href":"/vi/tip/34-01"},"children":[{"tag":"span","props":{},"children":["01"]},"Trước khi uống hai loại thuốc cảm cúm hoặc giảm đau cùng lúc, hãy xem bảng thành phần, paracetamol chỉ được chiếm một chỗ"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/vi/tip/34-02","data-status":"active"},"children":[{"tag":"span","props":{},"children":["02"]},"Trẻ bị sốt đừng dùng aspirin, nimesulide và metamizole, thuốc cảm cúm chứa metamizole cũng không cho người chưa thành niên uống"]},{"tag":"a","props":{"href":"/vi/tip/34-03"},"children":[{"tag":"span","props":{},"children":["03"]},"Người trên 60 tuổi, đã từng xuất huyết dạ dày, đang uống thuốc chống đông hoặc hormone, trước khi uống thuốc giảm đau như ibuprofen hãy hỏi bác sĩ"]},{"tag":"a","props":{"href":"/vi/tip/34-04"},"children":[{"tag":"span","props":{},"children":["04"]},"Trẻ dưới 2 tuổi bị cảm cúm, đừng tự cho uống thuốc cảm cúm phối hợp và thuốc ho"]},{"tag":"a","props":{"href":"/vi/tip/34-05"},"children":[{"tag":"span","props":{},"children":["05"]},"Sau tuần thứ 20 của thai kỳ, đừng tự uống thuốc giảm đau như ibuprofen"]},{"tag":"a","props":{"href":"/vi/tip/34-06"},"children":[{"tag":"span","props":{},"children":["06"]},"Trào ngược và ợ nóng thì tự mua omeprazole, uống tối đa 7 ngày; khó nuốt, nôn ra máu, phân đen thì đi thẳng bệnh viện"]},{"tag":"a","props":{"href":"/vi/tip/34-07"},"children":[{"tag":"span","props":{},"children":["07"]},"Cảm cúm thường đừng xin bác sĩ kê kháng sinh"]},{"tag":"a","props":{"href":"/vi/tip/34-08"},"children":[{"tag":"span","props":{},"children":["08"]},"Tiêu chảy thì uống dung dịch bù nước đường uống trước, trẻ dưới 5 tuổi không cho thuốc cầm tiêu chảy"]},{"tag":"a","props":{"href":"/vi/tip/34-09"},"children":[{"tag":"span","props":{},"children":["09"]},"Thuốc giảm đau trong một tháng đừng uống quá 15 ngày, thuốc giảm đau phối hợp đừng quá 10 ngày, nếu không đau đầu có thể do thuốc"]},{"tag":"a","props":{"href":"/vi/tip/34-10"},"children":[{"tag":"span","props":{},"children":["10"]},"Định kỳ dọn thuốc hết hạn và thuốc thừa không dùng tới, bỏ cả vỏ vào thùng rác chất độc, đừng để trong nhà"]},{"tag":"a","props":{"href":"/vi/tip/34-11"},"children":[{"tag":"span","props":{},"children":["11"]},"Khi uống kháng sinh nhóm cephalosporin, metronidazole, trong lúc uống và 7 ngày sau khi ngừng thì không uống rượu; thuốc có cồn như nước Hoa Hương Chính Khí, siro ho vẫn cũng không uống"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"Breadcrumbs"},"children":[{"tag":"a","props":{"href":"/vi/book"},"children":["Khám phá cuốn sách"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/vi/book/34"},"children":["Chương 34"," ·"," ","Đừng dùng thuốc trong nhà sai cách"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"34-02"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["02"]},{"tag":"span","props":{"className":"life-evidence grade-b"},"children":["Bằng chứng"," ","B"]}]},{"tag":"h1","props":{"lang":"vi"},"children":["Trẻ bị sốt đừng dùng aspirin, nimesulide và metamizole, thuốc cảm cúm chứa metamizole cũng không cho người chưa thành niên uống"]},{"tag":"p","props":{"lang":"vi","className":"life-entry-summary"},"children":["Trẻ bị sốt thì cả ba loại thuốc này đều đừng dùng. Aspirin có liên quan đến hội chứng Reye, căn bệnh này tổn thương não và gan; theo thống kê Mỹ khoảng ba phần mười trẻ mắc bệnh chết, sau khi cảnh báo phát ra số ca giảm hơn chín phần mười. Nimesulide cấm dưới 12 tuổi, metamizole cấm dưới 18 tuổi."]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Chi phí"]},{"tag":"p","props":{},"children":["Không tốn tiền. Khi mua thuốc hạ sốt thì nhìn tên thông th…"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Lợi ích"]},{"tag":"p","props":{},"children":["Hội chứng Reye gây bệnh não và thoái hoá mỡ gan, thường xuất hiện sau khi bị cúm hoặc thủy đậu. Trong hệ thống…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"Đánh dấu: Trẻ bị sốt đừng dùng aspirin, nimesulide và metamizole, thuốc cảm cúm chứa metamizole cũng không cho người chưa thành niên uống"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"Hoàn tất"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"Kế hoạch thực hiện"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"Lưu"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Chia sẻ mẹo này"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Ẩn chi tiết"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Chi phí"]},{"tag":"p","props":{},"children":["Không tốn tiền. Khi mua thuốc hạ sốt thì nhìn tên thông thường và bảng thành phần."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Lợi ích"]},{"tag":"p","props":{},"children":["Hội chứng Reye gây bệnh não và thoái hoá mỡ gan, thường xuất hiện sau khi bị cúm hoặc thủy đậu. Trong hệ thống giám sát toàn quốc Mỹ từ năm 1981 đến 1997 có 1207 ca ở người dưới 18 tuổi. 82% trẻ bệnh đo được acid salicylic trong máu, đây là thành phần của aspirin và nhóm thuốc cùng loại. Tỷ lệ tử vong toàn phần 31%. Từ năm 1980 bắt đầu phát cảnh báo cho nhóm thuốc chứa acid salicylic. Năm đó có 555 ca, là đỉnh; từ năm 1987 mỗi năm không quá 36 ca. Năm 2011 Cục Quản lý Dược phẩm và Thực phẩm Quốc gia quy định cấm dùng dạng uống của nimesulide cho trẻ dưới 12 tuổi. Năm 2020 Cục Quản lý Dược phẩm Quốc gia quy định cấm viên nén metamizole cho trẻ em và thanh thiếu niên dưới 18 tuổi. Các viên phối hợp chứa metamizole như 青蒿安乃近片, 重感灵片 và 重感灵胶囊 cũng bị cấm cho người dưới 18 tuổi."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Nguồn gốc"]},{"tag":"p","props":{"className":"life-citations"},"children":["Belay ED, Bresee JS, Holman RC, Khan AS, Shahriari A, Schonberger LB (1999). Reye's syndrome in the United States from 1981 through 1997. New England Journal of Medicine, 340(18):1377-1382. ",{"tag":"a","props":{"href":"https://doi.org/10.1056/NEJM199905063401801","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1056/NEJM199905063401801"]},"；关于加强尼美舒利口服制剂使用管理的通知（国食药监安〔2011〕209号）. ",{"tag":"a","props":{"href":"https://www.nmpa.gov.cn/xxgk/fgwj/gzwj/gzwjyp/20110515145101552.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.nmpa.gov.cn/xxgk/fgwj/gzwj/gzwjyp/20110515145101552.html"]},"；国家药监局关于修订安乃近相关品种说明书的公告（2020年第34号）及附件1至3. ",{"tag":"a","props":{"href":"https://www.nmpa.gov.cn/directory/web/nmpa/xxgk/ggtg/ypggtg/ypshmshxdgg/20200317171201660.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.nmpa.gov.cn/directory/web/nmpa/xxgk/ggtg/ypggtg/ypshmshxdgg/20200317171201660.html"]}]},{"tag":"a","props":{"href":"https://doi.org/10.1056/NEJM199905063401801","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Liên kết mở nguồn"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Ghi chú sách"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["Metamizole với người lớn cũng không phải lựa chọn hàng đầu. Hướng dẫn ghi rõ nó có thể gây mất bạch cầu hạt, thiếu máu bất tái sinh và sốc dị ứng, chỉ dùng ngắn hạn khi bệnh nặng cấp tính mà không có thuốc hiệu quả khác. 重感灵 nghe tên như thuốc cảm cúm thường, bên trong có metamizole. Trẻ nên dùng thuốc hạ sốt nào, liều bao nhiêu theo cân nặng thì hỏi bác sĩ nhi khoa hoặc dược sĩ. Trẻ dưới 3 tháng bị sốt thì đi thẳng bệnh viện, xem mục 8 ở phần 20 (38 ℃ thì đi thẳng bệnh viện). Để ở mức B là vì số liệu hội chứng Reye đến từ báo cáo giám sát, việc số ca giảm và việc phát cảnh báo chỉ là quan hệ trước sau, không phải thử nghiệm đối chứng. Cỡ lợi ích đặt là「lớn」, vì sau khi có cảnh báo số ca rơi từ 555 ca mỗi năm xuống dưới 36 ca."]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Ghi chú của tôi"]},{"tag":"button","props":{"type":"button"},"children":["Viết một lời nhắc cho chính bạn…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/vi/tip/34-01"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"ch