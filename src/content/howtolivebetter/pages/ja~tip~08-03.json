":"reading","data-ad-creative":"read_product","data-ad-ready":"false","aria-label":"広告 · コミュニティ紹介"},"children":[{"tag":"button","props":{"type":"button","className":"life-ad-dismiss","aria-label":"広告を閉じる"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-x","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M18 6 6 18"},"children":[]},{"tag":"path","props":{"d":"m6 6 12 12"},"children":[]}]}]},{"tag":"div","props":{"className":"life-ad-space-brand"},"children":[{"tag":"img","props":{"src":"/sites/howtolivebetter/images/shengcai/logo.png","width":"565","height":"144","alt":"生財有術の公式ロゴ","decoding":"async"},"children":[]}]},{"tag":"div","props":{"className":"life-ad-space-copy"},"children":[{"tag":"span","props":{"className":"life-ad-space-label"},"children":["広告 · コミュニティ紹介"]},{"tag":"strong","props":{},"children":["学んだ知識は、役立つ製品になる？"]},{"tag":"p","props":{},"children":["電子書籍や小さなツール。需要を見つけ、知識を使える形にする参加者の実践を紹介します。"]}]},{"tag":"div","props":{"className":"life-ad-space-actions"},"children":[{"tag":"a","props":{"className":"life-ad-space-link","href":"/ja/shengcaiyoushu?sc_group=reading&sc_creative=read_product&sc_placement=ad_dock"},"children":["コミュニティと事例を見る",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"18","height":"18","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-up-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M7 7h10v10"},"children":[]},{"tag":"path","props":{"d":"M7 17 17 7"},"children":[]}]}]}]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/ja/book/08"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"目次に戻る"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["自分を犠牲にしないために：法律と財産の安全を守る"]},{"tag":"div","props":{"data-ad-dock-host":"true"},"children":[]},{"tag":"nav","props":{"aria-label":"この章のヒント"},"children":[{"tag":"a","props":{"href":"/ja/tip/08-01"},"children":[{"tag":"span","props":{},"children":["01"]},"交通事故に遭ったら、まずは停車、救護、通報。逃走してはいけない"]},{"tag":"a","props":{"href":"/ja/tip/08-02"},"children":[{"tag":"span","props":{},"children":["02"]},"詐欺に気づいたら、すぐに 110 または 96110 に電話して支払停止を依頼すること。自分で調べるのは後回しに"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/ja/tip/08-03","data-status":"active"},"children":[{"tag":"span","props":{},"children":["03"]},"詐欺防止の鉄則を覚えよう：電話を鵜呑みにしない、情報を明かさない、リンクをクリックしない、送金は必ず確認する。最も一般的な7つの詐欺はこのパターンです"]},{"tag":"a","props":{"href":"/ja/tip/08-04"},"children":[{"tag":"span","props":{},"children":["04"]},"ビデオで顔を見ること、電話で声を聞くことは「本人確認」とはみなさない。送金が絡む場合は一旦電話を切り、自分の連絡先に登録されている古い番号にかけ直すこと"]},{"tag":"a","props":{"href":"/ja/tip/08-05"},"children":[{"tag":"span","props":{},"children":["05"]},"容疑をかけられた、または召喚された場合は、まず弁護士を依頼すること。示談はせず、記録を削除しないこと"]},{"tag":"a","props":{"href":"/ja/tip/08-06"},"children":[{"tag":"span","props":{},"children":["06"]},"問題が起きたら自ら説明しに行く：自首すれば刑期を最大4割減刑できる可能性があり、軽い犯罪ならさらに減刑や免罰もあり得る。「公訴時効を逃れる」という道は閉ざされている"]},{"tag":"a","props":{"href":"/ja/tip/08-07"},"children":[{"tag":"span","props":{},"children":["07"]},"飲酒した後はハンドルに触れない。電気自動車や「少しだけ動かす」場合も含む"]},{"tag":"a","props":{"href":"/ja/tip/08-08"},"children":[{"tag":"span","props":{},"children":["08"]},"銀行カード、SIMカード、決済アカウントを他人に貸さない。「資金洗浄（跑分）」は副業ではない"]},{"tag":"a","props":{"href":"/ja/tip/08-09"},"children":[{"tag":"span","props":{},"children":["09"]},"年に2回、無料で自分の信用報告書をチェックし、身に覚えのないローンやカードがないか確認する"]},{"tag":"a","props":{"href":"/ja/tip/08-10"},"children":[{"tag":"span","props":{},"children":["10"]},"衝突が起きたら、手を出さずにまず通報すること。先に手を出した側が、ほぼ確実に損をする"]},{"tag":"a","props":{"href":"/ja/tip/08-11"},"children":[{"tag":"span","props":{},"children":["11"]},"避けられない侵害に対しては反撃可能だが、現在手を出し続けている人物に対してのみ行うこと。相手が止まれば、あなたも止めること"]},{"tag":"a","props":{"href":"/ja/tip/08-12"},"children":[{"tag":"span","props":{},"children":["12"]},"誰と恨みができたとしても（賃金未払い、解雇、金銭トラブルなど）―― 復讐ではなく、苦情申し立て、仲裁、訴訟の手続きを踏むこと"]},{"tag":"a","props":{"href":"/ja/tip/08-13"},"children":[{"tag":"span","props":{},"children":["13"]},"どれほど恨みがあっても無関係な人には手を出さない：車で群衆に突っ込む行為や公共の場での凶行は「危険な方法による公共の安全への危害罪」となり、刑期は3年から。死者が出れば10年以上、最高で死刑"]},{"tag":"a","props":{"href":"/ja/tip/08-14"},"children":[{"tag":"span","props":{},"children":["14"]},"「道連れにしてやる」「共倒れになってやる」といった考えが浮かんだら、緊急事態として対処：その場を離れ、車の鍵や刃物を他人に預け、12356 に電話する"]},{"tag":"a","props":{"href":"/ja/tip/08-15"},"children":[{"tag":"span","props":{},"children":["15"]},"周囲の人が「誰も幸せになれないようにしてやる」「子供を連れて逃げる」と言い出した時、感情的な言葉だと思わないで：近親者は直接受診させることができ、警察は通報を受けたら必ず対応しなければなりません"]},{"tag":"a","props":{"href":"/ja/tip/08-16"},"children":[{"tag":"span","props":{},"children":["16"]},"ネット上では誹謗中傷やデマ、未確認情報の拡散をしないこと。ネットリンチを受けた際は、まず証拠を残してから警察へ通報すること"]},{"tag":"a","props":{"href":"/ja/tip/08-17"},"children":[{"tag":"span","props":{},"children":["17"]},"署名前に書類を最後まで読み、代理署名はせず、白紙には署名しない"]},{"tag":"a","props":{"href":"/ja/tip/08-18"},"children":[{"tag":"span","props":{},"children":["18"]},"借金の際は借用書を明記すること。他人への保証人になる前には、代わりに返済する意思があるかよく考えること"]},{"tag":"a","props":{"href":"/ja/tip/08-19"},"children":[{"tag":"span","props":{},"children":["19"]},"権利保護には期限があります：民事訴訟時効は 3 年、労働仲裁は 1 年、期限を過ぎると相手の「時効超過」の一言で十分です"]},{"tag":"a","props":{"href":"/ja/tip/08-20"},"children":[{"tag":"span","props":{},"children":["20"]},"提訴された、強制執行された場合は、財産を正直に報告し、支払える分だけ支払うこと。不動産や現金を親族や会社に移してはいけません"]},{"tag":"a","props":{"href":"/ja/tip/08-21"},"children":[{"tag":"span","props":{},"children":["21"]},"消費制限または失信リストへの掲載を受けた場合は、まずどの条項に基づいて掲載されたのかを確認し、訂正可能な場合は訂正を申請すること"]},{"tag":"a","props":{"href":"/ja/tip/08-22"},"children":[{"tag":"span","props":{},"children":["22"]},"ネットショッピングや中古取引で詐欺に遭ったら、まずはプラットフォームへ通報、次に警察へ通報、その上で訴訟を起こす価値があるかを検討"]},{"tag":"a","props":{"href":"/ja/tip/08-23"},"children":[{"tag":"span","props":{},"children":["23"]},"恋愛および婚姻における高額な贈与は、交付する前に慎重に検討を。交付後は原則として取り消せません"]},{"tag":"a","props":{"href":"/ja/tip/08-24"},"children":[{"tag":"span","props":{},"children":["24"]},"結納金は振込で行い、用途を明記し、チャット履歴を保存すること。結婚を口実とした金銭要求は返還請求が可能"]},{"tag":"a","props":{"href":"/ja/tip/08-25"},"children":[{"tag":"span","props":{},"children":["25"]},"婚前財産を恐れる必要はありません。不動産の名義追加や親の出資は事前に明確に書き留めておくこと"]},{"tag":"a","props":{"href":"/ja/tip/08-26"},"children":[{"tag":"span","props":{},"children":["26"]},"結婚前に相手の婚姻状況を確認すること。結婚を口実にお金を騙し取る行為は詐欺罪として追及されます"]},{"tag":"a","props":{"href":"/ja/tip/08-27"},"children":[{"tag":"span","props":{},"children":["27"]},"出張修理、車両点検、リフォームなどは、作業前に必ず価格を確認し、全工程を傍らで見守ること"]},{"tag":"a","props":{"href":"/ja/tip/08-28"},"children":[{"tag":"span","props":{},"children":["28"]},"「名義上の代表者」にならないこと。会社設立のために身分証を他人に貸さないこと"]},{"tag":"a","props":{"href":"/ja/tip/08-29"},"children":[{"tag":"span","props":{},"children":["29"]},"出入国時に見知らぬ人の荷物を預からないこと。出所不明の小包を代理受領しないこと"]},{"tag":"a","props":{"href":"/ja/tip/08-30"},"children":[{"tag":"span","props":{},"children":["30"]},"中国で犬を飼うなら必ずリードを使う。未装着の事故は無過失責任で賠償する。狂犬病ワクチンと飼育登録も忘れない"]},{"tag":"a","props":{"href":"/ja/tip/08-31"},"children":[{"tag":"span","props":{},"children":["31"]},"相手が意識不明、睡眠中、または 14 歳未満である可能性がある場合は、性交渉を行わないこと"]},{"tag":"a","props":{"href":"/ja/tip/08-32"},"children":[{"tag":"span","props":{},"children":["32"]},"性交渉やビデオチャットの後、相手が通報、写真の拡散、勤務先への連絡を盾に金銭を要求してきた場合、一銭も払わず、記録も削除せず、直ちに警察へ通報すること"]},{"tag":"a","props":{"href":"/ja/tip/08-33"},"children":[{"tag":"span","props":{},"children":["33"]},"事実を捏造して通報された場合、以下の追及が可能です：治安行政処分に該当する場合は 5 日からの拘留、犯罪に該当する場合は 3 年以下の懲役"]},{"tag":"a","props":{"href":"/ja/tip/08-34"},"children":[{"tag":"span","props":{},"children":["34"]},"証拠不十分であれば本来無罪とされるべきであり、強要された自白は排除されるべきである。判決後には上訴や再審の道がある"]},{"tag":"a","props":{"href":"/ja/tip/08-35"},"children":[{"tag":"span","props":{},"children":["35"]},"勾留後に不起訴、不起訴処分または無罪判決を受けた場合、国家賠償を申請できます。賠償額は日割り計算されます"]},{"tag":"a","props":{"href":"/ja/tip/08-36"},"children":[{"tag":"span","props":{},"children":["36"]},"被害者として賠償を請求する場合、12315、訴訟、または弁護士を通じて行い、相手と二人きりで会う約束をしないこと。「金を払えば、公表しない」という言い方をセットにしないこと"]},{"tag":"a","props":{"href":"/ja/tip/08-37"},"children":[{"tag":"span","props":{},"children":["37"]},"ネット炎上（ネットいじめ）に遭ったら：まずは防御設定、証拠保全、そしてプラットフォームへの通報・禁止命令・警察への通報の3つの道から選択"]},{"tag":"a","props":{"href":"/ja/tip/08-38"},"children":[{"tag":"span","props":{},"children":["38"]},"「保険をかけてから手を下す」という道は、法律上最初から完全に塞がれています：金銭は一切受け取れず、罪は殺人罪と保険詐欺罪の併合罪として処罰されます"]},{"tag":"a","props":{"href":"/ja/tip/08-39"},"children":[{"tag":"span","props":{},"children":["39"]},"警察への通報時はその場で受理票を受け取ること、不立案（事件化しない）の場合は書面での通知が必要：7 日以内に再審査を申請でき、さらに 7 日以内に再審査請求が可能。検察庁は警察に立案を通知できます"]},{"tag":"a","props":{"href":"/ja/tip/08-40"},"children":[{"tag":"span","props":{},"children":["40"]},"捜査・執行官への金銭やカードの贈賄は避けること：贈賄側も処罰の対象となり、監察・執行・司法関係者への贈賄はより重い刑が科される"]},{"tag":"a","props":{"href":"/ja/tip/08-41"},"children":[{"tag":"span","props":{},"children":["41"]},"トラブルに発展しそうな電話や面談は、直接録音する：自分が参加している会話なら、相手の事前の同意は不要"]},{"tag":"a","props":{"href":"/ja/tip/08-42"},"children":[{"tag":"span","props":{},"children":["42"]},"現場で事故が起きたら、まず全景、次に位置関係、最後に損傷と怪我の状況を撮影すること。元の写真や動画は削除しないでください"]},{"tag":"a","props":{"href":"/ja/tip/08-43"},"children":[{"tag":"span","props":{},"children":["43"]},"ドメスティック・バイオレンス（DV）を受けた時：まずは警察に通報して出動記録を残し、その後に裁判所へ人身安全保護命令を申請しましょう。離婚を先に済ませる必要はなく、費用もかかりません"]},{"tag":"a","props":{"href":"/ja/tip/08-44"},"children":[{"tag":"span","props":{},"children":["44"]},"家族がギャンブルで借金を作った場合、すぐに肩代わりして返済しないでください：ギャンブルの借金は法律で保護されず、ギャンブルのために借りたお金も夫婦の共同債務とはみなされません"]},{"tag":"a","props":{"href":"/ja/tip/08-45"},"children":[{"tag":"span","props":{},"children":["45"]},"知人から「顔認証の協力や証人になってほしい」と融資の手伝いを頼まれたら、決して応じてはいけない：これは「ABローン」と呼ばれ、借り手はあなたであり、保証人ではありません"]},{"tag":"a","props":{"href":"/ja/tip/08-46"},"children":[{"tag":"span","props":{},"children":["46"]},"ドアと窓に錠を付け、玄関外にセンサーライトを設置し、外出時は必ず施錠する。侵入窃盗の予防はこの組み合わせで、警報器だけの効果は認められない"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"現在地"},"children":[{"tag":"a","props":{"href":"/ja/book"},"children":["本を読む"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/ja/book/08"},"children":["第8章"," ·"," ","自分を犠牲にしないために：法律と財産の安全を守る"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"08-03"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["03"]},{"tag":"span","props":{"className":"life-evidence grade-b"},"children":["エビデンス"," ","B"]}]},{"tag":"h1","props":{"lang":"ja"},"children":["詐欺防止の鉄則を覚えよう：電話を鵜呑みにしない、情報を明かさない、リンクをクリックしない、送金は必ず確認する。最も一般的な7つの詐欺はこのパターンです"]},{"tag":"p","props":{"lang":"ja","className":"life-entry-summary"},"children":["送金、画面共有、見知らぬアプリのダウンロード、リンクのクリック、認証コードの伝達を要求されたら、まずは電話を切り、その後、公式の番号にかけ直して確認してください。「タスク完了による報酬（刷単返利）」、「虚偽の投資・資産運用」、「オンラインローン」、「カスタマーサポートを装う」、「警察・検察・裁判所を装う」、「ロマンス詐欺（殺猪盤）」、「アダルトサイトを利用したタスク詐欺」の7つの最も一般的な手口は、すべて先に送金を要求してきます。事前の察知は、事後の回収よりもはるかに安上がりです。"]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["費用・手間"]},{"tag":"p","props":{},"children":["費用はかかりなません。「三不一多（3つのしないこと、1つのすること）」を覚え、以下の7つの手口を読み返し、さらに「国…"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["効果"]},{"tag":"p","props":{},"children":["法律は、政府および関係機関に対し、あらゆる種類の通信ネットワーク詐欺の手口を国民に周知することを義務付けています。"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"記録する：詐欺防止の鉄則を覚えよう：電話を鵜呑みにしない、情報を明かさない、リンクをクリックしない、送金は必ず確認する。最も一般的な7つの詐欺はこのパターンです"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"できている"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"やることに追加"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"お気に入り"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"このヒントを共有"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"詳細を閉じる"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["費用・手間"]},{"tag":"p","props":{},"children":["費用はかかりなません。「三不一多（3つのしないこと、1つのすること）」を覚え、以下の7つの手口を読み返し、さらに「国家反詐中心」アプリをインストールしてください。96110 の電話には必ず出てください。送金、画面共有、見知らぬアプリのダウンロード、リンクのクリック、認証コードの伝達を要求されたら、まずは電話を切り、公式の電話番号にかけ直して確認してください。難しいのは、相手が非常に急かしてくることですが、その催促に屈せず、まずは電話を切ることが重要です。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["効果"]},{"tag":"p","props":{},"children":["法律は、政府および関係機関に対し、あらゆる種類の通信ネットワーク詐欺の手口を国民に周知することを義務付けています。公安機関は、金融、通信、インターネット情報部門と連携して警告・阻止システムを構築し、詐欺に遭う可能性のある人物を発見した際には、速やかに警告・阻止を行います。96110 は、この全国統一の警告・阻止ホットラインであり、着信には対応する必要があります。公安部による 2026 年 6 月の通知によると、最も発生頻度の高い 10 種類の詐欺が、すべての通信詐欺案件の 85% を占めています。タスク完了による報酬（刷単返利）詐欺が最も多く、25% を占めています。虚偽のオンライン投資・資産運用詐欺は損失が最も大きく、全損失の約 40% を占めています。福建省公安庁が類型別に分析した識別特徴は以下の通りです。タスク完了による報酬詐欺：「一緒に稼ごうと誘ってくる人は、十中八九、あなたの金を狙っています」。タスクが完了しない限り、元本は返金されません。虚偽の投資詐欺：グループ内の「サクラ」が利益を公開し、最初は少額の配当を支払って信用させた後、さらなる投資を促し、出金時には「税金」を要求する。ネットローン：「ローンに保証金や銀行の入出金明細は不要です。もし要求されたら、それは間違いなく詐欺です」。カスタマーサポートを装う詐欺：会員登録により自動的に料金が引き落とされる、あるいは信用情報に影響が出ると称し、解約のために送金を強要する。警察・検察・司法機関を装う詐欺：「警察・検察・司法機関にいわゆる『安全口座』は存在しません。電話、QQ、WeChat、インターネットなどを通じて事件の捜査や供述録取を行う『警察・検察・司法機関』は、すべて詐欺です」。ロマンス詐欺（殺猪盤）：「一度も会ったことがなく、写真や動画でしか確認していない『恋人』を信じてはいけません」。ビデオ通話もせず、直接会うこともないのに、頻繁に急な用事として送金を要求してくる。報酬目的の注文代行詐欺（刷単）：待ち合わせの前に「タスク」をこなすよう求められ、支払う金額がどんどん膨らんでいく。事後に支払いを止めるよりも、事前に見抜く方がはるかに安上がりである。支払停止の請求でいくら取り戻せるかは、通報時に口座に資金が残っているかによります。支払停止の手続きについては、第 2 条をご参照ください（110 または 96110 に電話して支払停止を依頼）（全国、2022 年 12 月より）"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["出典"]},{"tag":"p","props":{"className":"life-citations"},"children":["全国人大常委会 (2022). 反电信网络诈骗法（第八、二十、三十四条）. ",{"tag":"a","props":{"href":"https://www.spp.gov.cn/spp/fl/202209/t20220902_575631.shtml","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.spp.gov.cn/spp/fl/202209/t20220902_575631.shtml"]},"；公安部 (2026). 公安部发布会：通报当前电信网络诈骗犯罪的最新形势、特点提示防范电信网络诈骗要点（2026 年 6 月 12 日）：「以上这10类案件就占了全部电诈案件的85%。其中，刷单返利诈骗发案最高，占所有电诈案件的25%；虚假网络投资理财诈骗损失最高，约占全部电诈案件损失的40%」. ",{"tag":"a","props":{"href":"https://www.mps.gov.cn/n2254536/n2254544/n2254552/n10491781/index.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.mps.gov.cn/n2254536/n2254544/n2254552/n10491781/index.html"]},"；福建省公安厅 (2023). 96110 来电，请务必接听. ",{"tag":"a","props":{"href":"http://gat.fujian.gov.cn/ztzl/fjjffpzxrx/spjq/202303/t20230306_6126156.htm","target":"_blank","rel":"noopener noreferrer"},"children":["http://gat.fujian.gov.cn/ztzl/fjjffpzxrx/spjq/202303/t20230306_6126156.htm"]},"（省级公安机关页面，含「来电不轻信，信息不透露，链接不点击，转账多核实」口诀及「警惕 192 开头的诈骗电话」提示）；福建省公安厅 (2023 到 2024). 识骗技巧专栏：刷单 ",{"tag":"a","props":{"href":"http://gat.fujian.gov.cn/ztzl/fjjffpzxrx/spjq/202307/t20230703_6196881.htm","target":"_blank","rel":"noopener noreferrer"},"children":["http://gat.fujian.gov.cn/ztzl/fjjffpzxrx/spjq/202307/t20230703_6196881.htm"]},"；投资理财 ",{"tag":"a","props":{"href":"http://gat.fujian.gov.cn/ztzl/fjjffpzxrx/spjq/202312/t20231220_6362145.htm","target":"_blank","rel":"noopener noreferrer"},"children":["http://gat.fujian.gov.cn/ztzl/fjjffpzxrx/spjq/202312/t20231220_6362145.htm"]},"；贷款 ",{"tag":"a","props":{"href":"http://gat.fujian.gov.cn/ztzl/fjjffpzxrx/spjq/202312/t20231207_6326741.htm","target":"_blank","rel":"noopener noreferrer"},"children":["http://gat.fujian.gov.cn/ztzl/fjjffpzxrx/spjq/202312/t20231207_6326741.htm"]},"；冒充客服 ",{"tag":"a","props":{"href":"http://gat.fujian.gov.cn/ztzl/fjjffpzxrx/spjq/202310/t20231020_6279505.htm","target":"_blank","rel":"noopener noreferrer"},"children":["http://gat.fujian.gov.cn/ztzl/fjjffpzxrx/spjq/202310/t20231020_6279505.htm"]},"；冒充公检法 ",{"tag":"a","props":{"href":"http://gat.fujian.gov.cn/ztzl/fjjffpzxrx/spjq/202309/t20230913_6255863.htm","target":"_blank","rel":"noopener noreferrer"},"children":["http://gat.fujian.gov.cn/ztzl/fjjffpzxrx/spjq/202309/t20230913_6255863.htm"]},"；杀猪盘 ",{"tag":"a","props":{"href":"http://gat.fujian.gov.cn/ztzl/fjjffpzxrx/spjq/202308/t20230818_6232030.htm","target":"_blank","rel":"noopener noreferrer"},"children":["http://gat.fujian.gov.cn/ztzl/fjjffpzxrx/spjq/202308/t20230818_6232030.htm"]},"；色诱刷单 ",{"tag":"a","props":{"href":"http://gat.fujian.gov.cn/ztzl/fjjffpzxrx/spjq/202403/t20240307_6410612.htm","target":"_blank","rel":"noopener noreferrer"},"children":["http://gat.fujian.gov.cn/ztzl/fjjffpzxrx/spjq/202403/t20240307_6410612.htm"]}]},{"tag":"a","props":{"href":"https://www.spp.gov.cn/spp/fl/202209/t20220902_575631.shtml","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["出典を開く"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["著者の注記"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["警察・検察・裁判所、カスタマーサポート、上司、プラットフォームの風控（リスク管理）などを名乗り、「調査への協力」「会員資格のキャンセル」「タスク報酬」「投資の内部情報」などを求めてくるものは、すべて同じ手口です。「融資に保証金は不要」「警察・検察・裁判所に『安全口座』は存在しない」という2点を覚えておくだけで、詐欺の大部分を防げます。B級に設定している理由は、このスローガンが公式の宣伝用であり、「覚えることでどれだけ詐欺被害を減らせるか」という具体的な数値がないためです。スローガンと7つの分類は、省級公安庁のページから引用しています。公安部が 2026 年に発表した 10 種類の高発生詐欺には、EC物流カスタマーサポートを装うもの、ローン信用調査、オンラインゲームの虚偽取引、オンライン婚活、上司や知人を装うもの、航空券の変更手続きなどを装うものも含まれますが、すべて手口は同じで、最終的には送金を要求してきます。知人が目の前で「顔認証の協力（本人確認）」を求めてローンを組もうとする場合、送金はさせずとも借金を背負わせることになります。第 45 条（顔認証の協力）を参照してください。ビジネス中に遭遇する代行運営詐欺については、第 12 節 第 24 条（ネットショップ代行運営）を参照してください。"]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["自分のメモ"]},{"tag":"button","props":{"type":"button"},"children":["自分へのメモを書く…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/ja/tip/08-02"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["前へ"]},"詐欺に気づいたら、すぐに 110 または 96110 に電話して支払停止を依頼すること。自分で調べるのは後回しに"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/ja/tip/08-04"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["次へ"]},"ビデオで顔を見ること、電話で声を聞くことは「本人確認」とはみなさない。送金が絡む場合は一旦電話を切り、自分の連絡先に登録されている古い番号にかけ直すこと"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["このテーマの他の提案"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/08-01"},"children":[{"tag":"strong","props":{},"children":["交通事故に遭ったら、まずは停車、救護、通報。逃走してはいけない"]},{"tag":"span","props":{},"children":["逃走した場合、その事故の責任はすべてあなたにあるとみなされます。運転免許は取り消され、生涯再取得ができなくなります。さらに現実的な問題とし…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/08-05"},"children":[{"tag":"strong","props":{},"children":["容疑をかけられた、または召喚された場合は、まず弁護士を依頼すること。示談はせず、記録を削除しないこと"]},{"tag":"span","props":{},"children":["事情聴取に呼ばれた最初の段階から、弁護士を依頼することができます。弁護士の面会要求があれば、留置所は遅くとも 48 時間以内に手配しなけれ…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/08-06"},"