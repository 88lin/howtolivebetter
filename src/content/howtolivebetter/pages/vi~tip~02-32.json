,"stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"Lưu"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Chia sẻ mẹo này"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Ẩn chi tiết"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Chi phí"]},{"tag":"p","props":{},"children":["Không tốn tiền. Ăn uống cộng vận động thì ngày nào cũng phải tốn thời gian. Đây là mục tốn ý chí nhất của cả phần: phải kiềm chế ăn uống lâu dài, và giữ nguyên sau khi giảm còn khó hơn lúc giảm."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Lợi ích"]},{"tag":"p","props":{},"children":["Gộp dữ liệu cá nhân của 239 nghiên cứu theo dõi về sau lại với nhau (chỉ ghi nhận, không chia nhóm đối chứng). Phân tích này chỉ giữ lại ba nhóm người: không bao giờ hút thuốc, không mắc bệnh mạn tính lúc bắt đầu nghiên cứu, và còn sống thêm được trên 5 năm sau khi bắt đầu. Kết quả: rủi ro tử vong thấp nhất ở BMI 20–25. BMI 25–27.5 cao hơn khoảng 7% (HR 1.07). 27.5–30 cao hơn khoảng 20% (HR 1.20). 30–35 cao hơn khoảng 45% (HR 1.45). 35–40 cao hơn khoảng 94% (HR 1.94). 40–60 là 2.76 lần (HR 2.76). Ở người có BMI trên 25, mỗi 5 kg/m² tăng thì ở dân Đông Á rủi ro cao hơn khoảng 39% (HR 1.39)."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Nguồn gốc"]},{"tag":"p","props":{"className":"life-citations"},"children":["Global BMI Mortality Collaboration (2016). Body-mass index and all-cause mortality: individual-participant-data meta-analysis of 239 prospective studies in four continents. Lancet. ",{"tag":"a","props":{"href":"https://doi.org/10.1016/S0140-6736(16)30175-1","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1016/S0140-6736(16)30175-1"]},"；Flegal KM 等 (2013). Association of all-cause mortality with overweight and obesity using standard body mass index categories: a systematic review and meta-analysis. JAMA. ",{"tag":"a","props":{"href":"https://doi.org/10.1001/jama.2012.113905","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1001/jama.2012.113905"]},"（争议方）"]},{"tag":"a","props":{"href":"https://doi.org/10.1016/S0140-6736(16)30175-1","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Liên kết mở nguồn"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Ghi chú sách"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["Tranh cãi. Có phe cho rằng「béo một chút lại sống lâu hơn」. Tổng hợp của phe đó cho ra: người thừa cân có rủi ro tử vong thấp hơn khoảng 6%, người béo phì nhẹ thấp hơn khoảng 5%. Hai phe chủ yếu khác nhau ở chỗ có nên loại bỏ ba nhóm dữ liệu: người hút thuốc, người đã mắc bệnh, và dữ liệu trong vài năm đầu sau khi bắt đầu nghiên cứu. Loại bỏ là vì người bệnh nặng sẽ sụt cân trước. Phân tích gộp 239 nghiên cứu nói trên, sau khi loại bỏ ba nhóm đó, rủi ro do thừa cân lại xuất hiện. Cần thêm một điểm nữa: không có thử nghiệm chia nhóm ngẫu nhiên nào chứng minh việc giảm cân bản thân nó làm giảm tỷ lệ tử vong toàn nguyên. Lợi ích ở trên là do so sánh ngang giữa những người béo khác nhau, không có nghĩa giảm đi sẽ giảm được tới mức đó. Người muốn giảm cân không cần bỏ công sắp xếp bữa ăn, bữa sáng và chế độ nhịn ăn 16:8 đều không có lợi ích thêm, xem mục 26 ở phần 6 (đừng trông chờ bữa sáng hoặc 16:8 giúp kiểm soát cân nặng)"]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Ghi chú của tôi"]},{"tag":"button","props":{"type":"button"},"children":["Viết một lời nhắc cho chính bạn…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/vi/tip/02-31"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Trước"]},"Ban ngày ra ngoài hẵn nắng, đừng cả ngày không thấy ánh sáng"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/vi/tip/02-33"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Tiếp theo"]},"Mỗi tuần ăn ớt từ bốn lần trở lên"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["Thêm trong chủ đề này"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/02-28"},"children":[{"tag":"strong","props":{},"children":["Ăn ít thực phẩm siêu chế biến (khoai tây chiên, mì gói, bánh ngọt, đồ ăn nhanh)"]},{"tag":"span","props":{},"children":["Người ăn nhiều thực phẩm siêu chế biến nhất có xác suất tử vong tron