ad-layout-toc"},"children":[{"tag":"div","props":{"className":"life-ad-rail","data-dock-active":"false","style":{"top":"94px"}},"children":[{"tag":"div","props":{"className":"life-ad-dock","hidden":true},"children":[{"tag":"aside","props":{"className":"life-ad-space life-ad-space-sponsored life-ad-space-compact","data-ad-placement":"ad_dock","data-ad-group":"reading","data-ad-creative":"read_product","data-ad-ready":"false","aria-label":"Advertisement · Community recommendation"},"children":[{"tag":"button","props":{"type":"button","className":"life-ad-dismiss","aria-label":"Close ad"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-x","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M18 6 6 18"},"children":[]},{"tag":"path","props":{"d":"m6 6 12 12"},"children":[]}]}]},{"tag":"div","props":{"className":"life-ad-space-brand"},"children":[{"tag":"img","props":{"src":"/sites/howtolivebetter/images/shengcai/logo.png","width":"565","height":"144","alt":"Official Shengcai Youshu logo","decoding":"async"},"children":[]}]},{"tag":"div","props":{"className":"life-ad-space-copy"},"children":[{"tag":"span","props":{"className":"life-ad-space-label"},"children":["Advertisement · Community recommendation"]},{"tag":"strong","props":{},"children":["Could what you know become a useful product?"]},{"tag":"p","props":{},"children":["From ebooks to small tools, explore how members spot needs and turn knowledge into something people can use."]}]},{"tag":"div","props":{"className":"life-ad-space-actions"},"children":[{"tag":"a","props":{"className":"life-ad-space-link","href":"/en/shengcaiyoushu?sc_group=reading&sc_creative=read_product&sc_placement=ad_dock"},"children":["Explore the community and examples",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"18","height":"18","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-up-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M7 7h10v10"},"children":[]},{"tag":"path","props":{"d":"M7 17 17 7"},"children":[]}]}]}]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/en/book/12"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"Back to index"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["Starting a business: how to protect your personal assets"]},{"tag":"div","props":{"data-ad-dock-host":"true"},"children":[]},{"tag":"nav","props":{"aria-label":"Chapter entries"},"children":[{"tag":"a","props":{"href":"/en/tip/12-01"},"children":[{"tag":"span","props":{},"children":["01"]},"Only invest money you can afford to lose — never use family savings or borrowed funds"]},{"tag":"a","props":{"href":"/en/tip/12-02"},"children":[{"tag":"span","props":{},"children":["02"]},"Never sign personal guarantees for corporate loans; spouses should definitely avoid signing too"]},{"tag":"a","props":{"href":"/en/tip/12-03"},"children":[{"tag":"span","props":{},"children":["03"]},"Choosing the right legal entity before launching: sole proprietors and general partners are fully liable, while limited liability companies offer “limited” liability"]},{"tag":"a","props":{"href":"/en/tip/12-04"},"children":[{"tag":"span","props":{},"children":["04"]},"Improperly listed shareholders: never hold shares on someone else’s behalf"]},{"tag":"a","props":{"href":"/en/tip/12-05"},"children":[{"tag":"span","props":{},"children":["05"]},"Check the Ministry of Commerce records before signing; obtain written disclosures and include a “cooling-off period” in the contract"]},{"tag":"a","props":{"href":"/en/tip/12-06"},"children":[{"tag":"span","props":{},"children":["06"]},"Determine the business name, location, scope of operations, and registered capital before registration; with complete documents, you can obtain the business license on the spot"]},{"tag":"a","props":{"href":"/en/tip/12-07"},"children":[{"tag":"span","props":{},"children":["07"]},"Businesses requiring licenses must wait until they obtain one"]},{"tag":"a","props":{"href":"/en/tip/12-08"},"children":[{"tag":"span","props":{},"children":["08"]},"Figure out which category you fall into: producing or preparing food requires a permit, selling only pre-packaged goods needs a filing, while selling fresh meat and vegetables needs no permit at all"]},{"tag":"a","props":{"href":"/en/tip/12-09"},"children":[{"tag":"span","props":{},"children":["09"]},"Packaging food for sale makes it prepackaged food: labels must include production date, shelf life, and ingredient list without exception"]},{"tag":"a","props":{"href":"/en/tip/12-10"},"children":[{"tag":"span","props":{},"children":["10"]},"General foods must not claim therapeutic effects: this applies to labels, instructions, ads, and live-stream scripts alike"]},{"tag":"a","props":{"href":"/en/tip/12-11"},"children":[{"tag":"span","props":{},"children":["11"]},"The food industry faces criminal penalties: selling meat from diseased animals or products exceeding safety limits is already a crime; adding toxic or harmful non-food substances carries a minimum five-year sentence regardless of revenue"]},{"tag":"a","props":{"href":"/en/tip/12-12"},"children":[{"tag":"span","props":{},"children":["12"]},"Once you obtain a business license, you must file tax returns on schedule — even if you have no income, you still need to submit a return with all zeros"]},{"tag":"a","props":{"href":"/en/tip/12-13"},"children":[{"tag":"span","props":{},"children":["13"]},"Invoices must reflect actual transactions; small taxpayers can fully utilize tax exemptions"]},{"tag":"a","props":{"href":"/en/tip/12-14"},"children":[{"tag":"span","props":{},"children":["14"]},"Scammers pretending to be tax officials demanding payments are fraudsters; tax filings must be done via the e-Tax Service or by calling 12366"]},{"tag":"a","props":{"href":"/en/tip/12-15"},"children":[{"tag":"span","props":{},"children":["15"]},"Writing “deposit” instead of “advance payment” in contracts, specifying penalty amounts, and treating credit terms as loans"]},{"tag":"a","props":{"href":"/en/tip/12-16"},"children":[{"tag":"span","props":{},"children":["16"]},"Sign a written contract within the first month of employment; register for social insurance within 30 days"]},{"tag":"a","props":{"href":"/en/tip/12-17"},"children":[{"tag":"span","props":{},"children":["17"]},"Wages must be paid according to contracts and laws; raises, loans, and bonuses all require written documentation"]},{"tag":"a","props":{"href":"/en/tip/12-18"},"children":[{"tag":"span","props":{},"children":["18"]},"Sell first, then produce: use pre-orders and small orders to confirm demand before investing in manufacturing"]},{"tag":"a","props":{"href":"/en/tip/12-19"},"children":[{"tag":"span","props":{},"children":["19"]},"Run the prototype through the production checklist before starting full production"]},{"tag":"a","props":{"href":"/en/tip/12-20"},"children":[{"tag":"span","props":{},"children":["20"]},"Keep copies of invoices and supplier documentation for every shipment; avoid purchasing goods priced significantly below market rates: if an employee buys counterfeit products, the employer can still be held legally responsible"]},{"tag":"a","props":{"href":"/en/tip/12-21"},"children":[{"tag":"span","props":{},"children":["21"]},"Whether creating designs yourself or purchasing licensed artwork, simply changing colors or adding icons does not count as “modifications” for copyright purposes"]},{"tag":"a","props":{"href":"/en/tip/12-22"},"children":[{"tag":"span","props":{},"children":["22"]},"Follow procedures at work; think carefully about who bears responsibility before offering unsolicited help"]},{"tag":"a","props":{"href":"/en/tip/12-23"},"children":[{"tag":"span","props":{},"children":["23"]},"Exit the process as planned when losses occur: opt for simplified deregistration when possible, or file for bankruptcy if debts exceed assets — don’t leave things unattended"]},{"tag":"a","props":{"href":"/en/tip/12-24"},"children":[{"tag":"span","props":{},"children":["24"]},"Before paying for third‑party store management, e‑commerce training, or “dropshipping” services, be sure to ask whether extra fees will be required and where the sales figures actually come from"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/en/tip/12-25","data-status":"active"},"children":[{"tag":"span","props":{},"children":["25"]},"Companies and individual businesses in China must report the previous year online from January 1 to June 30, even without business activity; annual reports are free"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"Breadcrumb"},"children":[{"tag":"a","props":{"href":"/en/book"},"children":["Explore the book"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/en/book/12"},"children":["Chapter 12"," ·"," ","Starting a business: how to protect your personal assets"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"12-25"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["25"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["Evidence"," ","A"]}]},{"tag":"h1","props":{"lang":"en"},"children":["Companies and individual businesses in China must report the previous year online from January 1 to June 30, even without business activity; annual reports are free"]},{"tag":"p","props":{"lang":"en","className":"life-entry-summary"},"children":["Companies and individual businesses must submit the previous year's annual report online in the first half of each year. Failure puts you on the abnormal-operations list; after making up the report you can apply for removal. Reporting is free. Callers who claim you missed it and ask you to pay through a mini-program or public account are scammers; people have received prison sentences exceeding 10 years for this. Check the official disclosure system yourself first."]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Cost"]},{"tag":"p","props":{},"children":["Free. Log in to China's National Enterprise Credit Informa…"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Benefit"]},{"tag":"p","props":{},"children":["Companies in China must submit and publicly disclose the previous year's annual report through the National En…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"Mark: Companies and individual businesses in China must report the previous year online from January 1 to June 30, even without business activity; annual reports are free"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"Done"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"Plan to do"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"Save"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Share this tip"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Hide details"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Cost"]},{"tag":"p","props":{},"children":["Free. Log in to China's National Enterprise Credit Information Publicity System and submit once a year. Individual businesses can also report on paper. This annual report goes to market regulators and is separate from monthly or quarterly tax returns to the tax authority. Filing taxes does not count as filing the annual report. The difficulty is remembering something due only once a year."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Benefit"]},{"tag":"p","props":{},"children":["Companies in China must submit and publicly disclose the previous year's annual report through the National Enterprise Credit Information Publicity System to market regulators between January 1 and June 30 each year. Missing the deadline brings listing for abnormal operations and administrative penalties as provided by law. Anyone can view this list in the system. Listed businesses face restrictions or exclusion in government procurement and project tenders. Individual businesses have the same January 1 to June 30 deadline, with online or paper reporting. Those starting business during the current year begin reporting the following year. They can choose whether to publish the report's contents, but failure to report still puts them on the abnormal-operations list. Those listed for missing reports can submit the missing years and apply to the market regulator where registered for removal. A company that fails to report for 2 consecutive years, remains noncompliant after listing, and cannot be contacted at its registered address has its business license revoked. Companies' annual reports must be public. For an individual business choosing not to publish its contents, the system still shows that the report was submitted. You can therefore check both filing status and listing yourself. The State Administration for Market Regulation warns about callers impersonating regulators, saying a report is overdue and the business already listed, then steering owners to a supposed mini-program or public account to hire a filing agent and pay. Its message is that annual reports are free, and filing or removal from the list must go through official channels such as the national disclosure system. Courts have convicted people of fraud for this. In a case concluded by Jingde County Court in Anhui, a business-registration agency instructed callers to hide their identity so individual businesses would believe they were market regulators. Callers directed them to a third-party mini-program charging 98 to 398 yuan in ‘manual filing material fees’. They defrauded 10099 individual businesses nationwide of over 3.19 million yuan. The 3 principal offenders were convicted of fraud and sentenced to 10 years 6 months to 10 years 8 months. In a case concluded by Jiaxing's Nanhu District Court, a mini-program even said in small print that filing was free. The court still convicted the defendants of fraud because callers deliberately concealed the option of online self-filing and invented large fines. In that case 9 people received sentences from 8 months to 4 years (China nationwide)."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Original sources"]},{"tag":"p","props":{"className":"life-citations"},"children":["国务院 (2024 修订). 企业信息公示暂行条例（国务院令第 777 号修订，第八、十八、十九条）. ",{"tag":"a","props":{"href":"https://flk.npc.gov.cn/detail?id=ff8081819c46fcc5019cd18fc6e9557d","target":"_blank","rel":"noopener noreferrer"},"children":["https://flk.npc.gov.cn/detail?id=ff8081819c46fcc5019cd18fc6e9557d"]},"（国家法律法规数据库）；市场监管总局 (2025). 关于修改《个体工商户年度报告办法》等四部规章的决定（市场监管总局令第 108 号，附重新公布的个体工商户年度报告办法第三、五、八、十、十三、十六条，企业经营异常名录管理办法第六、十一条）. ",{"tag":"a","props":{"href":"https://www.gov.cn/gongbao/2026/issue_12546/202602/content_7057451.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/gongbao/2026/issue_12546/202602/content_7057451.html"]},"；市场监管总局 (2023). @所有经营主体，这些都是假的（中国政府网部门动态转载，原发市场监管总局「市说新语」微信公众号）. ",{"tag":"a","props":{"href":"https://www.gov.cn/lianbo/bumen/202311/content_6917465.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/lianbo/bumen/202311/content_6917465.htm"]},"；市场监管总局 (2024). 市场监管总局发布提示：年报不收费，切勿受骗上当（滨州市市场监督管理局转载）. ",{"tag":"a","props":{"href":"http://amr.binzhou.gov.cn/art/2024/12/16/art_164869_10306521.html","target":"_blank","rel":"noopener noreferrer"},"children":["http://amr.binzhou.gov.cn/art/2024/12/16/art_164869_10306521.html"]},"；安徽省旌德县人民法院 (2025). 冒充市场监管人员以年审申报收费诈骗个体工商户案（无锡市市场监督管理局转载）. ",{"tag":"a","props":{"href":"https://scjgj.wuxi.gov.cn/doc/2025/03/20/4524579.shtml","target":"_blank","rel":"noopener noreferrer"},"children":["https://scjgj.wuxi.gov.cn/doc/2025/03/20/4524579.shtml"]},"；嘉兴市南湖区人民法院 (2024). 企业年报要费用？莫入「年报诈骗」陷阱. ",{"tag":"a","props":{"href":"http://nhcourt.gov.cn/art/2024/7/23/art_1217290_58718476.html","target":"_blank","rel":"noopener noreferrer"},"children":["http://nhcourt.gov.cn/art/2024/7/23/art_1217290_58718476.html"]}]},{"tag":"a","props":{"href":"https://flk.npc.gov.cn/detail?id=ff8081819c46fcc5019cd18fc6e9557d","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Open source link"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Book note"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["If a caller says you missed an annual report, hang up first and check the disclosure system yourself, or call the market regulator where you registered. Do not click text-message links or pay through a mini-program or public account they provide. It is the same pattern as tax-authority impersonation; see item 14 (people demanding tax-filing money in the tax authority's name are scammers). If you have transferred money, immediately call 110 or 96110 to request a payment stop. China's measures for annual reports by individual businesses and management of the abnormal-operations list were amended twice in 2025; the current versions took effect on December 25, 2025. Annual reports and tax returns are separate duties; see item 12 (file zero tax returns on time even without income). Both must be timely. After license revocation, a legally responsible representative cannot act as a legal representative again for 3 years; see item 23 (exit through the proper procedure when the business loses money). If you no longer intend to operate, follow that item's deregistration procedure instead of neglecting annual reports. The main beneficiary is you."]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["My note"]},{"tag":"button","props":{"type":"button"},"children":["Write a reminder for yourself…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/en/tip/12-24"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Previous"]},"Before paying for third‑party store management, e‑commerce training, or “dropshipping” services, be sure to ask whether extra fees will be required and where the sales figures actually come from"]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["More in this topic"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/en/tip/12-18"},"children":[{"tag":"strong","props":{},"children":["Sell first, then produce: use pre-orders and small orders to confirm demand before investing in manufacturing"]},{"tag":"span","props":{},"children":["A s