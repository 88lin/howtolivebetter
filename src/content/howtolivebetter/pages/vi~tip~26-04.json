er-round","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M18 20a6 6 0 0 0-12 0"},"children":[]},{"tag":"circle","props":{"cx":"12","cy":"10","r":"4"},"children":[]},{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},{"tag":"span","props":{},"children":["Đăng nhập để đồng bộ hóa"]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/vi/book/26"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"Quay lại mục lục"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["Làm một trang web hoặc nền tảng: giấy phép, đăng ký, máy chủ"]},{"tag":"nav","props":{"aria-label":"Các mục trong chương"},"children":[{"tag":"a","props":{"href":"/vi/tip/26-01"},"children":[{"tag":"span","props":{},"children":["01"]},"Để tiền không đi vào tài khoản của nền tảng rồi mới chuyển cho người bán, hãy cho tiền đi thẳng qua tổ chức thanh toán được cấp phép"]},{"tag":"a","props":{"href":"/vi/tip/26-02"},"children":[{"tag":"span","props":{},"children":["02"]},"Trang web thu phí thì cần giấy phép, bên tự bán hàng không cho người khác tham gia thì không cần, bên trung gian kết nối giao dịch là loại giấy phép khác, trang web miễn phí chỉ cần đăng ký khai báo"]},{"tag":"a","props":{"href":"/vi/tip/26-03"},"children":[{"tag":"span","props":{},"children":["03"]},"Phát trực tiếp thì cần giấy phép kinh doanh văn hóa trên mạng, còn giấy phép chương trình nghe nhìn thì công ty tư nhân gần như không xin được"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/vi/tip/26-04","data-status":"active"},"children":[{"tag":"span","props":{},"children":["04"]},"Máy chủ đặt trong nước thì phải đăng ký khai báo, và nhà cung cấp dịch vụ truy cập phải tự có giấy phép viễn thông giá trị gia tăng"]},{"tag":"a","props":{"href":"/vi/tip/26-05"},"children":[{"tag":"span","props":{},"children":["05"]},"Cho người dùng lên bán hàng thì nền tảng phải kiểm tra đăng ký, báo thông tin và lưu giữ ba năm"]},{"tag":"a","props":{"href":"/vi/tip/26-06"},"children":[{"tag":"span","props":{},"children":["06"]},"Nội dung người dùng đăng lên là bạn phải quản: có cơ chế duyệt, có cửa sổ báo việc, thấy nội dung vi phạm thì dừng truyền ngay và báo cáo"]},{"tag":"a","props":{"href":"/vi/tip/26-07"},"children":[{"tag":"span","props":{},"children":["07"]},"Cung cấp dịch vụ đăng thông tin và nhắn tin tức thì phải yêu cầu người dùng cung cấp thông tin danh tính thật"]},{"tag":"a","props":{"href":"/vi/tip/26-08"},"children":[{"tag":"span","props":{},"children":["08"]},"Không mở phát trực tiếp cho người chưa đủ 16 tuổi, tiền thưởng xử lý theo bậc tuổi"]},{"tag":"a","props":{"href":"/vi/tip/26-09"},"children":[{"tag":"span","props":{},"children":["09"]},"Nhận được thông báo vi phạm thì phải xử lý kịp thời, chuyển bản giải trình mà sau 15 ngày không có động tĩnh thì khôi phục lại"]},{"tag":"a","props":{"href":"/vi/tip/26-10"},"children":[{"tag":"span","props":{},"children":["10"]},"Đừng tùy tiện đặt thông tin người dùng ra nước ngoài, việc chuyển dữ liệu ra nước ngoài có điều kiện luật định và có ngưỡng số người"]},{"tag":"a","props":{"href":"/vi/tip/26-11"},"children":[{"tag":"span","props":{},"children":["11"]},"Chọn máy chủ thì xem sập có chịu được không, xem có ai trực vận hành không, cuối cùng mới so giá"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"Breadcrumbs"},"children":[{"tag":"a","props":{"href":"/vi/book"},"children":["Khám phá cuốn sách"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/vi/book/26"},"children":["Chương 26"," ·"," ","Làm một trang web hoặc nền tảng: giấy phép, đăng ký, máy chủ"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"26-04"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["04"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["Bằng chứng"," ","A"]}]},{"tag":"h1","props":{"lang":"vi"},"children":["Máy chủ đặt trong nước thì phải đăng ký khai báo, và nhà cung cấp dịch vụ truy cập phải tự có giấy phép viễn thông giá trị gia tăng"]},{"tag":"p","props":{"lang":"vi","className":"life-entry-summary"},"children":["Máy chủ đặt trong nước thì trước khi mở trang web phải đăng ký khai báo. Đăng ký khai báo không tốn tiền, hồ sơ nộp cùng máy chủ tại nhà cung cấp, thường mấy ngày đến mấy tuần. Không đăng ký khai báo thì bị buộc sửa trong thời hạn rồi phạt tiền 1 vạn tệ, không sửa thì đóng cửa trang web. Không đặt số đăng ký trên trang chủ thì còn phạt thêm 5000 tệ đến 5 vạn tệ."]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Chi phí"]},{"tag":"p","props":{},"children":["Đăng ký khai báo không tốn tiền. Hồ sơ nộp cùng máy chủ tạ…"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Lợi ích"]},{"tag":"p","props":{},"children":["Nguyên văn quy chế là「未经备案，不得在中华人民共和国境内从事非经营性互联网信息服务」— chưa đăng ký khai báo thì không được làm dịch vụ thông…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"Đánh dấu: Máy chủ đặt trong nước thì phải đăng ký khai báo, và nhà cung cấp dịch vụ truy cập phải tự có giấy phép viễn thông giá trị gia tăng"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"Hoàn tất"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"Kế hoạch thực hiện"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"Lưu"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Chia sẻ mẹo này"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Ẩn chi tiết"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Chi phí"]},{"tag":"p","props":{},"children":["Đăng ký khai báo không tốn tiền. Hồ sơ nộp cùng máy chủ tại nhà cung cấp, thường phải chờ mấy ngày đến mấy tuần. Kiểm tra một lần nhà cung cấp đã đủ điều kiện hay chưa thì mười phút là đủ"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Lợi ích"]},{"tag":"p","props":{},"children":["Nguyên văn quy chế là「未经备案，不得在中华人民共和国境内从事非经营性互联网信息服务」— chưa đăng ký khai báo thì không được làm dịch vụ thông tin Internet không tính thương mại bên trong lãnh thổ nước Cộng hòa Nhân dân Trung Quốc. Trang web không thu tiền người dùng, chỉ cần đặt ở trong nước, vẫn phải đăng ký khai báo trước. Không đăng ký khai báo thì bị buộc sửa trong thời hạn rồi phạt tiền 1 vạn tệ. Không chịu sửa thì đóng cửa trang web. Nhà cung cấp giúp bạn đưa máy chủ lên mạng cũng nằm trong phạm vi này: nó「不得为未经备案的组织或者个人从事非经营性互联网信息服务提供互联网接入服务」— không được cung cấp dịch vụ truy cập Internet cho tổ chức hoặc cá nhân chưa đăng ký khai báo mà làm dịch vụ thông tin Internet không tính thương mại. Nhà cung cấp thu tiền hộ bạn cũng vậy. Quy chế nói nhà cung cấp loại này「不得为未依法取得经营许可证或者履行非经营性互联网信息服务备案手续的单位或者个人提供接入或者代收费等服务」— nghĩa là nhà cung cấp đàng hoàng không được nhận trang web vừa không có giấy phép vừa chưa đăng ký khai báo. Ngoài ra, hosting máy chủ và máy chủ ảo trong quy chế gọi là ngành trung tâm dữ liệu Internet, còn truy cập băng rộng gọi là ngành dịch vụ truy cập Internet, bản thân hai ngành này cũng phải có giấy phép, nên nhà cung cấp phải có giấy phép trước. Trang web không đặt số đăng ký trên trang chủ thì bị buộc sửa rồi phạt tiền 5000 tệ đến 5 vạn tệ (toàn quốc)"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Nguồn gốc"]},{"tag":"p","props":{"className":"life-citations"},"children":["信息产业部 (2005). 非经营性互联网信息服务备案管理办法（信产部令第 33 号，2024 年经工信部令第 68 号修订，第五、十三、十八、二十二条）. ",{"tag":"a","props":{"href":"https://www.miit.gov.cn/gyhxxhb/jgsj/cyzcyfgs/bmgz/xxtxl/art/2024/art_84a0cfa0ebd049bbbe751dca9a008e56.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.miit.gov.cn/gyhxxhb/jgsj/cyzcyfgs/bmgz/xxtxl/art/2024/art_84a0cfa0ebd049bbbe751dca9a008e56.html"]}," ; 工业和信息化部 (2017). 电信业务经营许可管理办法（工信部令第 42 号，第二十、二十四条）. ",{"tag":"a","props":{"href":"https://www.gov.cn/gongbao/content/2017/content_5240090.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/gongbao/content/2017/content_5240090.htm"]}," ; 工业和信息化部 (2015). 电信业务分类目录（2015 年版，B11、B14、B21、B25）. ",{"tag":"a","props":{"href":"https://www.miit.gov.cn/zwgk/zcwj/wjfb/tg/art/2020/art_e98406cd89844f7e92ea1bcf3b5301e0.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.miit.gov.cn/zwgk/zcwj/wjfb/tg/art/2020/art_e98406cd89844f7e92ea1bcf3b5301e0.html"]}]},{"tag":"a","props":{"href":"https://www.miit.gov.cn/gyhxxhb/jgsj/cyzcyfgs/bmgz/xxtxl/art/2024/art_84a0cfa0ebd049bbbe751dca9a008e56.html","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Liên kết mở nguồn"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Ghi chú sách"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["Trước khi bàn giá, kiểm tra xem nhà cung cấp đã có giấy phép chưa. Tra giấy phép thì dùng Hệ thống thông tin quản lý tổng hợp thị trường kinh doanh viễn thông của Bộ Công nghiệp và Thông tin, ",{"tag":"a","props":{"href":"http://tsm.miit.gov.cn/","target":"_blank","rel":"noopener noreferrer"},"children":["tsm.miit.gov.cn"]},", tìm theo tên đầy đủ của công ty hoặc theo số giấy phép. Tra đăng ký khai báo trang web thì dùng ",{"tag":"a","props":{"href":"http://beian.miit.gov.cn/","target":"_blank","rel":"noopener noreferrer"},"children":["beian.miit.gov.cn"]},". Một「机房」không có giấy phép tương ứng thì đến ngày xảy ra sự cố bạn cũng không biết kêu ai. Đặt máy ở nước ngoài thì đúng là tránh được đăng ký khai báo. Nhưng khi người dùng ở trong nước và tiền ở trong nước thì nghĩa vụ nào ghi ở mục 5 đến 10 của phần này cũng không bớt, lại cộng thêm một tầng chi phí chuyển dữ liệu ra nước ngoài"]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Ghi chú của tôi"]},{"tag":"button","props":{"type":"button"},"children":["Viết một lời nhắc cho chính bạn…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/vi/tip/26-03"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Trước"]},"Phát trực tiếp thì cần giấy phép kinh doanh văn hóa trên mạng, còn giấy phép chương trình nghe nhìn thì công ty tư nhân gần như không xin được"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/vi/tip/26-05"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Tiếp theo"]},"Cho người dùng lên bán hàng thì nền tảng phải kiểm tra đăng ký, báo thông tin và lưu giữ ba năm"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","pro