assName":""},"children":[{"tag":"span","props":{},"children":["09"]},"装袋卖就是预包装食品：标签上生产日期、保质期、配料表一样都不能少"]},{"tag":"a","props":{"href":"/tip/12-10","className":""},"children":[{"tag":"span","props":{},"children":["10"]},"普通食品不许说能治病：标签、说明书、广告和直播话术都算"]},{"tag":"a","props":{"href":"/tip/12-11","className":""},"children":[{"tag":"span","props":{},"children":["11"]},"食品这一行有刑事线：卖病死肉、超标货就够罪，掺了有毒有害的不看金额、起刑五年"]},{"tag":"a","props":{"href":"/tip/12-12","className":""},"children":[{"tag":"span","props":{},"children":["12"]},"领了执照就开始有申报义务，没有收入也要按期零申报（照报一张全是零的表）"]},{"tag":"a","props":{"href":"/tip/12-13","className":""},"children":[{"tag":"span","props":{},"children":["13"]},"发票只按真实交易开，小规模纳税人用足免税额"]},{"tag":"a","props":{"href":"/tip/12-14","className":""},"children":[{"tag":"span","props":{},"children":["14"]},"自称税务局催你交钱报税的都是骗子，办税只走电子税务局和 12366"]},{"tag":"a","props":{"href":"/tip/12-15","className":""},"children":[{"tag":"span","props":{},"children":["15"]},"收钱写「定金」不写「订金」，违约金写明数，账期当放贷来审"]},{"tag":"a","props":{"href":"/tip/12-16","className":""},"children":[{"tag":"span","props":{},"children":["16"]},"用人第一个月内签书面合同，30 日内办社保登记"]},{"tag":"a","props":{"href":"/tip/12-17","className":""},"children":[{"tag":"span","props":{},"children":["17"]},"工资按合同和法律给，加薪、借款、奖金都走书面"]},{"tag":"a","props":{"href":"/tip/12-18","className":""},"children":[{"tag":"span","props":{},"children":["18"]},"先卖再造：用预售和小订单验证有人买，再投钱生产"]},{"tag":"a","props":{"href":"/tip/12-19","className":""},"children":[{"tag":"span","props":{},"children":["19"]},"样品做出来先过一遍量产清单，再谈开工"]},{"tag":"a","props":{"href":"/tip/12-20","className":""},"children":[{"tag":"span","props":{},"children":["20"]},"进货一批留一批票据和上家信息，进货价明显低于市场价的不进：员工进的假货，老板是被判的那个"]},{"tag":"a","props":{"href":"/tip/12-21","className":""},"children":[{"tag":"span","props":{},"children":["21"]},"商品、包装、吊牌和宣传图上的图案要么自己做要么买授权，改个颜色、加个图标不算「改过了」"]},{"tag":"a","props":{"href":"/tip/12-22","className":"active"},"children":[{"tag":"span","props":{},"children":["22"]},"在岗位上按规程办事，规程之外的好意先想清楚责任归谁"]},{"tag":"a","props":{"href":"/tip/12-23","className":""},"children":[{"tag":"span","props":{},"children":["23"]},"亏了就按程序退场：能简易注销就注销，资不抵债走破产，别放着不管"]},{"tag":"a","props":{"href":"/tip/12-24","className":""},"children":[{"tag":"span","props":{},"children":["24"]},"花钱请人代运营网店、上开店培训、做「无货源」之前，先问清后面还要不要加钱、销量从哪来"]},{"tag":"a","props":{"href":"/tip/12-25","className":""},"children":[{"tag":"span","props":{},"children":["25"]},"开公司、当个体户的，每年 1 月 1 日到 6 月 30 日上网报上一年的年报，没生意也要报，年报不收费"]}]}]},{"tag":"div","props":{"className":"life-tip-page","data-tip-locales":"zh,en,ru,es,ja,vi"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"当前位置"},"children":[{"tag":"a","props":{"href":"/book"},"children":["阅读全书"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/book/12"},"children":["第 12 章 · 创业与做生意：别把家底赔进去"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"12-22"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["22"]},{"tag":"span","props":{"className":"life-evidence grade-b"},"children":["证据 B"]}]},{"tag":"h1","props":{"lang":"zh"},"children":["在岗位上按规程办事，规程之外的好意先想清楚责任归谁"]},{"tag":"p","props":{"lang":"zh","className":"life-entry-summary"},"children":["以护士为例：条例写明，发现病人病情危急，要立即通知医师；发现医嘱违反规定，要向开医嘱的医师提出。别的岗位也一样，先看清自己这份规程把「必须上报」划在哪儿。法律也没让人见死不救：自愿出手紧急救助，把人弄伤了，不用赔钱。"]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["成本"]},{"tag":"p","props":{},"children":["不花钱。上班做事按制度、按医嘱、按流程走。不在自己的权限之外替人做决定。想帮忙之前，先问自己一句：出了事谁负责。难的是当场顶住「通融一下」的请求。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["收益"]},{"tag":"p","props":{},"children":["以护士为例，法规写明的职务边界是这样的。发现病情危急，立即通知医师。紧急情况下为抢救垂危患者，可以先行实施必要的紧急救护。发现医嘱违法违规，或者违反诊疗技术规范的，要向医师提出，必要时向科室负责人报告。民法典另有规定：自愿出手做紧急救助，结果把被救的人弄伤了的，救人的一方不用赔钱（不承担民事责任）（…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"标记：在岗位上按规程办事，规程之外的好意先想清楚责任归谁"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"已做到"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"加入待做"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"收藏"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 