dth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-up-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M7 7h10v10"},"children":[]},{"tag":"path","props":{"d":"M7 17 17 7"},"children":[]}]}]}]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/en/book/06"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"Back to index"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["Items to avoid"]},{"tag":"div","props":{"data-ad-dock-host":"true"},"children":[]},{"tag":"nav","props":{"aria-label":"Chapter entries"},"children":[{"tag":"a","props":{"href":"/en/tip/06-01"},"children":[{"tag":"span","props":{},"children":["01"]},"Don’t take multivitamins for longevity or heart protection"]},{"tag":"a","props":{"href":"/en/tip/06-02"},"children":[{"tag":"span","props":{},"children":["02"]},"Don’t take regular fish oil capsules to prevent heart disease"]},{"tag":"a","props":{"href":"/en/tip/06-03"},"children":[{"tag":"span","props":{},"children":["03"]},"Don’t give vitamin D supplements to people who already have enough"]},{"tag":"a","props":{"href":"/en/tip/06-04"},"children":[{"tag":"span","props":{},"children":["04"]},"Don’t take antioxidant supplements to prevent cancer (beta-carotene, vitamin E, vitamin A)"]},{"tag":"a","props":{"href":"/en/tip/06-05"},"children":[{"tag":"span","props":{},"children":["05"]},"Don’t expect glucosamine/chondroitin to treat knee osteoarthritis"]},{"tag":"a","props":{"href":"/en/tip/06-06"},"children":[{"tag":"span","props":{},"children":["06"]},"Don’t rely on vitamin C to prevent colds"]},{"tag":"a","props":{"href":"/en/tip/06-07"},"children":[{"tag":"span","props":{},"children":["07"]},"Don’t get a whole-body PET-CT or tumor marker panel if you have no symptoms"]},{"tag":"a","props":{"href":"/en/tip/06-08"},"children":[{"tag":"span","props":{},"children":["08"]},"Don’t expect fitness trackers or smartwatches to help you lose weight"]},{"tag":"a","props":{"href":"/en/tip/06-09"},"children":[{"tag":"span","props":{},"children":["09"]},"Don’t pay a premium for organic food just to be “healthier”"]},{"tag":"a","props":{"href":"/en/tip/06-10"},"children":[{"tag":"span","props":{},"children":["10"]},"Don’t spend a lot of money on health supplements, herbal formulas, or tonics to “improve your health”"]},{"tag":"a","props":{"href":"/en/tip/06-11"},"children":[{"tag":"span","props":{},"children":["11"]},"Don’t take probiotics long-term if you have no gut problems"]},{"tag":"a","props":{"href":"/en/tip/06-12"},"children":[{"tag":"span","props":{},"children":["12"]},"Don’t force yourself to take cold showers just to “boost immunity”"]},{"tag":"a","props":{"href":"/en/tip/06-13"},"children":[{"tag":"span","props":{},"children":["13"]},"Don’t buy products marketed for detox, colon cleansing, enzymes, or alkaline water"]},{"tag":"a","props":{"href":"/en/tip/06-14"},"children":[{"tag":"span","props":{},"children":["14"]},"Don’t force yourself to drink water just to hit “8 glasses a day”"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/en/tip/06-15","data-status":"active"},"children":[{"tag":"span","props":{},"children":["15"]},"Don’t spend money on fortune‑telling, tarot, or astrology to make decisions"]},{"tag":"a","props":{"href":"/en/tip/06-16"},"children":[{"tag":"span","props":{},"children":["16"]},"Don’t buy blue-light-blocking glasses to “protect your vision,” and don’t believe claims that staring at screens for months will ruin your eyes — but severe eye pain, redness, and swelling require immediate medical attention"]},{"tag":"a","props":{"href":"/en/tip/06-17"},"children":[{"tag":"span","props":{},"children":["17"]},"Don’t treat blood donation as a health habit: claims that it “detoxifies, lowers cholesterol, and prevents heart attacks” lack randomized trial support, while frequent donation truly causes iron deficiency"]},{"tag":"a","props":{"href":"/en/tip/06-18"},"children":[{"tag":"span","props":{},"children":["18"]},"Don’t rely on generic health check packages to prevent disease; instead, get the evidence‑based screenings appropriate for your age and gender"]},{"tag":"a","props":{"href":"/en/tip/06-19"},"children":[{"tag":"span","props":{},"children":["19"]},"Don’t start taking uric‑acid‑lowering drugs just because a checkup shows high uric acid but you’ve never had symptoms"]},{"tag":"a","props":{"href":"/en/tip/06-20"},"children":[{"tag":"span","props":{},"children":["20"]},"Don’t have a gallbladder removed prophylactically just because an ultrasound found gallstones but you’ve never felt any pain"]},{"tag":"a","props":{"href":"/en/tip/06-21"},"children":[{"tag":"span","props":{},"children":["21"]},"Don’t cut calcium out to prevent kidney stones"]},{"tag":"a","props":{"href":"/en/tip/06-22"},"children":[{"tag":"span","props":{},"children":["22"]},"Don’t buy crystals, bracelets, or Pixiu figurines for “good luck,” “wealth attraction,” or “health benefits”"]},{"tag":"a","props":{"href":"/en/tip/06-23"},"children":[{"tag":"span","props":{},"children":["23"]},"Don’t expect shopping to lift your mood or boost your sense of self-worth"]},{"tag":"a","props":{"href":"/en/tip/06-24"},"children":[{"tag":"span","props":{},"children":["24"]},"Don’t spend extra money to “move up a rung” among your peers by buying a new house, car, or social circle"]},{"tag":"a","props":{"href":"/en/tip/06-25"},"children":[{"tag":"span","props":{},"children":["25"]},"Don’t believe that “willpower is like a muscle that runs out after use”"]},{"tag":"a","props":{"href":"/en/tip/06-26"},"children":[{"tag":"span","props":{},"children":["26"]},"Don’t expect skipping breakfast or the 16:8 intermittent fasting method to help you control your weight; instead, pick a meal timing you can stick to long-term"]},{"tag":"a","props":{"href":"/en/tip/06-27"},"children":[{"tag":"span","props":{},"children":["27"]},"Do not believe that \"masturbation harms the body\" or that \"abstinence is the only way to improve\"; what truly matters is whether it interferes with your sleep, work, and relationships"]},{"tag":"a","props":{"href":"/en/tip/06-28"},"children":[{"tag":"span","props":{},"children":["28"]},"Do not spend money on \"conversion therapy\" or \"gay علاج,\" and do not send your family members to undergo it either"]},{"tag":"a","props":{"href":"/en/tip/06-29"},"children":[{"tag":"span","props":{},"children":["29"]},"Do not expect “correct lifting posture” or lifting training to prevent back pain; reduce the weight and number of lifts, and exercise regularly"]},{"tag":"a","props":{"href":"/en/tip/06-30"},"children":[{"tag":"span","props":{},"children":["30"]},"Do not expect extra calcium or bone broth to make a fracture heal faster"]},{"tag":"a","props":{"href":"/en/tip/06-31"},"children":[{"tag":"span","props":{},"children":["31"]},"Don’t rely on an AI chatbot alone to judge a medical or legal problem; before seeing a doctor, going to court or spending big money, find the source it cites and check it against the original"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"Breadcrumb"},"children":[{"tag":"a","props":{"href":"/en/book"},"children":["Explore the book"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/en/book/06"},"children":["Chapter 6"," ·"," ","Items to avoid"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"06-15"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["15"]},{"tag":"span","props":{"className":"life-evidence grade-b"},"children":["Evidence"," ","B"]}]},{"tag":"h1","props":{"lang":"en"},"children":["Don’t spend money on fortune‑telling, tarot, or astrology to make decisions"]},{"tag":"p","props":{"lang":"en","className":"life-entry-summary"},"children":["There is a classic classroom experiment: students are given 'personality analyses' that are actually identical for everyone, yet most people find them remarkably accurate. This is precisely why fortune-telling seems accurate. An astrologer's success rate in picking correctly is about the same as random guessing. The cost is more than just a few dozen yuan: a fortune-telling gang in Xixian, Henan, collected 'incense money' and 'offering packages' of up to 3888 yuan, and the ringleader was sentenced to eleven years in prison."]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Cost"]},{"tag":"p","props":{},"children":["It costs nothing. The hard part is giving up a quick short…"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Benefit"]},{"tag":"p","props":{},"children":["A classic classroom experiment: the \"personal analysis\" students received after completing a personality test…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"Mark: Don’t spend money on fortune‑telling, tarot, or astrology to make decisions"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"Done"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"Plan to do"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"Save"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Share this tip"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Hide details"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Cost"]},{"tag":"p","props":{},"children":["It costs nothing. The hard part is giving up a quick shortcut for making choices and having to think for yourself afterward."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Benefit"]},{"tag":"p","props":{},"children":["A classic classroom experiment: the \"personal analysis\" students received after completing a personality test was actually identical for everyone, yet most believed it to be highly accurate. The author's conclusion is that \"being accepted by the subject or the analyst does not prove the interpretation is correct.\" 39 students rated the accuracy of this analysis on a scale from 0 to 5, with 34 people giving it a score of 4 or 5, resulting in an average of approximately 4.26 based on the distribution in the table. This explains why fortune-telling always seems accurate; this phenomenon is known as the Barnum Effect. Astrology has also undergone double-blind testing, the results of which were published in Nature. Astrologers were required to pick the one personality test result out of three that matched the birth chart. They correctly identified 40 out of 116 cases, whereas they could have identified 38.5 cases by pure guesswork, and the astrologers had previously predicted they would correctly identify 58.5 cases. Official case: The Xixian Procuratorate in Henan reported a network fortune-telling fraud group that first lured people in with free palm readings, then charged \"incense money\" and \"offering packages\" of up to 3888 yuan. There were more than 50 victims, and more than 200 ten thousand yuan in stolen funds were recovered; the ringleader was sentenced to eleven years in prison and fined 10 ten thousand yuan."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Original sources"]},{"tag":"p","props":{"className":"life-citations"},"children":["Forer BR (1949). The fallacy of personal validation: A classroom demonstration of gullibility. Journal of Abnormal and Social Psychology 44(1):118-123（表 1 评分分布：2 分 1 人、3 分 4 人、4 分 18 人、5 分 16 人，N=39）. ",{"tag":"a","props":{"href":"https://doi.org/10.1037/h0059240","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1037/h0059240"]},"；Carlson S (1985). A double-blind test of astrology. Nature 318:419-425（表 2：首选 116 份，挑中 40 份，随机期望 38.5，占星师预计 58.5；「The data are consistent with chance, inconsistent with astrological hypothesis」）. ",{"tag":"a","props":{"href":"https://doi.org/10.1038/318419a0","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1038/318419a0"]},"，第二作者主页全文 ",{"tag":"a","props":{"href":"https://muller.lbl.gov/papers/Astrology-Carlson.pdf","target":"_blank","rel":"noopener noreferrer"},"children":["https://muller.lbl.gov/papers/Astrology-Carlson.pdf"]},"；最高人民检察院 (2026). 河南息县：历经三年持续追踪打掉一批网络算命诈骗团伙. ",{"tag":"a","props":{"href":"https://www.spp.gov.cn/zdgz/202607/t20260728_732935.shtml","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.spp.gov.cn/zdgz/202607/t20260728_732935.shtml"]}]},{"tag":"a","props":{"href":"https://doi.org/10.1037/h0059240","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Open source link"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Book note"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["Both of these are just individual studies. The original paper by Forer does not directly state the average score; 4.26 was calculated based on the distribution of 1 as presented in the original text. This only states that 'it is inaccurate at prediction' and does not evaluate any belief. While spending a few dozen yuan for entertainment is fine, using it to decide on resignation, marriage, or investment is where the real financial loss lies."]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["My note"]},{"tag":"button","props":{"type":"button"},"children":["Write