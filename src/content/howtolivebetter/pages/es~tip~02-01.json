ildren":[]},{"tag":"path","props":{"d":"m19.07 4.93-1.41 1.41"},"children":[]}]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"17","height":"17","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-moon life-theme-icon-dark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"},"children":[]}]}]},{"tag":"button","props":{"type":"button","className":"life-language-switch","aria-label":"Español Elegir idioma","aria-haspopup":"menu","aria-expanded":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-globe","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]},{"tag":"path","props":{"d":"M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"},"children":[]},{"tag":"path","props":{"d":"M2 12h20"},"children":[]}]},{"tag":"span","props":{},"children":["Español"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]}]},{"tag":"a","props":{"className":"life-account","href":"/es/sign-in"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"17","height":"17","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle-user-round","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M18 20a6 6 0 0 0-12 0"},"children":[]},{"tag":"circle","props":{"cx":"12","cy":"10","r":"4"},"children":[]},{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},{"tag":"span","props":{},"children":["Iniciar sesión"]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/es/book/02"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"Volver al índice"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["No morir lentamente"]},{"tag":"nav","props":{"aria-label":"Consejos del capítulo"},"children":[{"tag":"a","props":{"aria-current":"page","className":"active","href":"/es/tip/02-01","data-status":"active"},"children":[{"tag":"span","props":{},"children":["01"]},"Dejar de fumar, cuanto antes mejor"]},{"tag":"a","props":{"href":"/es/tip/02-02"},"children":[{"tag":"span","props":{},"children":["02"]},"No fume en casa ni en el coche, y no permita que sus invitados fumen en su hogar"]},{"tag":"a","props":{"href":"/es/tip/02-03"},"children":[{"tag":"span","props":{},"children":["03"]},"Dejar de fumar no se logra solo con resistencia: primero hay que tomar medicación; la tasa de éxito se duplica"]},{"tag":"a","props":{"href":"/es/tip/02-04"},"children":[{"tag":"span","props":{},"children":["04"]},"Elija una fecha para dejar de fumar y no reduzca la cantidad gradualmente"]},{"tag":"a","props":{"href":"/es/tip/02-05"},"children":[{"tag":"span","props":{},"children":["05"]},"Acuda a una clínica para dejar de fumar o llame al 12320 para preguntar si hay servicios disponibles en su zona"]},{"tag":"a","props":{"href":"/es/tip/02-06"},"children":[{"tag":"span","props":{},"children":["06"]},"Quienes ya son fumadores no deben pensar en usar cigarrillos electrónicos; quienes nunca han fumado, mejor ni los prueben"]},{"tag":"a","props":{"href":"/es/tip/02-07"},"children":[{"tag":"span","props":{},"children":["07"]},"No beber bebidas azucaradas; cambiar a versiones sin azúcar tampoco soluciona el problema"]},{"tag":"a","props":{"href":"/es/tip/02-08"},"children":[{"tag":"span","props":{},"children":["08"]},"No masticar betel"]},{"tag":"a","props":{"href":"/es/tip/02-09"},"children":[{"tag":"span","props":{},"children":["09"]},"Cambie la sal de cocina por sal baja en sodio (sal de potasio)"]},{"tag":"a","props":{"href":"/es/tip/02-10"},"children":[{"tag":"span","props":{},"children":["10"]},"Cepíllese los dientes a fondo y limpie los espacios interdentales a diario; reponga los dientes que falten sin demora"]},{"tag":"a","props":{"href":"/es/tip/02-11"},"children":[{"tag":"span","props":{},"children":["11"]},"Caminar entre 7000 y 8000 pasos al día, o hacer ejercicio rápido durante 150–300 minutos a la semana"]},{"tag":"a","props":{"href":"/es/tip/02-12"},"children":[{"tag":"span","props":{},"children":["12"]},"Quienes padecen hipertensión o hipercolesterolemia deben tomar los medicamentos según las indicaciones médicas; no deben interrumpirlos por su cuenta"]},{"tag":"a","props":{"href":"/es/tip/02-13"},"children":[{"tag":"span","props":{},"children":["13"]},"Dormir unas 7 horas cada noche y mantener una rutina regular"]},{"tag":"a","props":{"href":"/es/tip/02-14"},"children":[{"tag":"span","props":{},"children":["14"]},"Practica regularmente deportes de raqueta como tenis, bádminton o tenis de mesa"]},{"tag":"a","props":{"href":"/es/tip/02-15"},"children":[{"tag":"span","props":{},"children":["15"]},"Acumular actividades de esfuerzo breves, como subir escaleras o caminar rápido, hasta sumar unos cuatro o cinco minutos al día"]},{"tag":"a","props":{"href":"/es/tip/02-16"},"children":[{"tag":"span","props":{},"children":["16"]},"Hacer entrenamiento de fuerza 30–60 minutos por semana"]},{"tag":"a","props":{"href":"/es/tip/02-17"},"children":[{"tag":"span","props":{},"children":["17"]},"No se quede sentado durante mucho tiempo seguido; levántese de vez en cuando"]},{"tag":"a","props":{"href":"/es/tip/02-18"},"children":[{"tag":"span","props":{},"children":["18"]},"Consumir menos carne procesada (jamón, tocino, salchichas, carne enlatada)"]},{"tag":"a","props":{"href":"/es/tip/02-19"},"children":[{"tag":"span","props":{},"children":["19"]},"Beber menos o no beber alcohol"]},{"tag":"a","props":{"href":"/es/tip/02-20"},"children":[{"tag":"span","props":{},"children":["20"]},"Personas que beben a diario y sufren temblores y palpitaciones al dejarlo: no intenten dejarlo solos"]},{"tag":"a","props":{"href":"/es/tip/02-21"},"children":[{"tag":"span","props":{},"children":["21"]},"Si quieres beber menos, primero cuenta cuánto bebes a la semana y luego habla unos minutos con el médico"]},{"tag":"a","props":{"href":"/es/tip/02-22"},"children":[{"tag":"span","props":{},"children":["22"]},"Consumir un puñado pequeño de frutos secos cada día"]},{"tag":"a","props":{"href":"/es/tip/02-23"},"children":[{"tag":"span","props":{},"children":["23"]},"Cambiar parte de la carne roja por pescado y carne de ave"]},{"tag":"a","props":{"href":"/es/tip/02-24"},"children":[{"tag":"span","props":{},"children":["24"]},"Cambie parte del arroz blanco y la harina refinada por cereales integrales"]},{"tag":"a","props":{"href":"/es/tip/02-25"},"children":[{"tag":"span","props":{},"children":["25"]},"Beber té más de tres veces por semana"]},{"tag":"a","props":{"href":"/es/tip/02-26"},"children":[{"tag":"span","props":{},"children":["26"]},"Beber de tres a cuatro tazas de café al día, sin azúcar ni nata"]},{"tag":"a","props":{"href":"/es/tip/02-27"},"children":[{"tag":"span","props":{},"children":["27"]},"Consumir 5 porciones diarias (unos 400 g) de frutas y verduras"]},{"tag":"a","props":{"href":"/es/tip/02-28"},"children":[{"tag":"span","props":{},"children":["28"]},"Consumir menos alimentos ultraprocesados (patatas fritas, fideos instantáneos, pasteles, comidas rápidas)"]},{"tag":"a","props":{"href":"/es/tip/02-29"},"children":[{"tag":"span","props":{},"children":["29"]},"Cambiar de carbón y leña a electricidad o gas para cocinar y calentarse"]},{"tag":"a","props":{"href":"/es/tip/02-30"},"children":[{"tag":"span","props":{},"children":["30"]},"Deje enfriar las bebidas calientes antes de beberlas; evite el té, la sopa y el café muy calientes"]},{"tag":"a","props":{"href":"/es/tip/02-31"},"children":[{"tag":"span","props":{},"children":["31"]},"Salir al sol durante el día, no evites la luz natural"]},{"tag":"a","props":{"href":"/es/tip/02-32"},"children":[{"tag":"span","props":{},"children":["32"]},"Mantener el IMC entre 20 y 25; si se tiene sobrepeso, hay que adelgazar"]},{"tag":"a","props":{"href":"/es/tip/02-33"},"children":[{"tag":"span","props":{},"children":["33"]},"Consumir chile más de cuatro veces por semana"]},{"tag":"a","props":{"href":"/es/tip/02-34"},"children":[{"tag":"span","props":{},"children":["34"]},"Beber una o dos porciones de leche o yogur al día"]},{"tag":"a","props":{"href":"/es/tip/02-35"},"children":[{"tag":"span","props":{},"children":["35"]},"No es necesario evitar los huevos, pero no los consumas tres o cuatro al día"]},{"tag":"a","props":{"href":"/es/tip/02-36"},"children":[{"tag":"span","props":{},"children":["36"]},"Si es posible, tome un baño de inmersión; no se limite a una ducha"]},{"tag":"a","props":{"href":"/es/tip/02-37"},"children":[{"tag":"span","props":{},"children":["37"]},"Limite la siesta a media hora, no más de una hora; si necesita dormir una o dos horas para aguantar, debería investigar el motivo"]},{"tag":"a","props":{"href":"/es/tip/02-38"},"children":[{"tag":"span","props":{},"children":["38"]},"Dormir más la noche siguiente a una noche de desvelo, sin esperar al fin de semana"]},{"tag":"a","props":{"href":"/es/tip/02-39"},"children":[{"tag":"span","props":{},"children":["39"]},"Cuanto más tiempo trabaje de noche, mayor es el riesgo cardiovascular; si puede, cámbiese de puesto cuanto antes"]},{"tag":"a","props":{"href":"/es/tip/02-40"},"children":[{"tag":"span","props":{},"children":["40"]},"Compre aceite de cacahuete envasado con un número de autorización SC; evite el aceite casero de pequeños productores"]},{"tag":"a","props":{"href":"/es/tip/02-41"},"children":[{"tag":"span","props":{},"children":["41"]},"Cambiar el aceite vegetal por manteca de cerdo o mantequilla al cocinar no requiere cambiar de aceite por motivos de salud, ni tampoco hay que esperar que el aceite de linaza proteja el corazón"]},{"tag":"a","props":{"href":"/es/tip/02-42"},"children":[{"tag":"span","props":{},"children":["42"]},"Encender el extractor de humos al cocinar y mantenerlo encendido hasta terminar"]},{"tag":"a","props":{"href":"/es/tip/02-43"},"children":[{"tag":"span","props":{},"children":["43"]},"Si los sofocos y los sudores nocturnos alrededor de la menopausia afectan a tu vida, acude a ginecología para valorar la terapia hormonal; no los aguantes ni compres medicamentos por tu cuenta, y no la uses para prevenir enfermedades cardíacas"]},{"tag":"a","props":{"href":"/es/tip/02-44"},"children":[{"tag":"span","props":{},"children":["44"]},"Si ya quería un perro, cuente el paseo diario como parte de sus pasos, pero no tenga un perro solo por longevidad"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"Ruta de navegación"},"children":[{"tag":"a","props":{"href":"/es/book"},"children":["Libro"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/es/book/02"},"children":["Capítulo 2"," ·"," ","No morir lentamente"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"02-01"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["01"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["Evidencia"," ","A"]}]},{"tag":"h1","props":{"lang":"es"},"children":["Dejar de fumar, cuanto antes mejor"]},{"tag":"p","props":{"lang":"es","className":"life-entry-summary"},"children":["En promedio, los fumadores viven más de diez años menos que quienes no fuman. Dejarlo antes de los 40 años elimina cerca del 90 % del riesgo de muerte asociado a seguir fumando. Cuanto antes se deje, más años se recuperan. Seguir fumando tras una fractura se asocia con unas 2,3 veces más probabilidades de que el hueso no consolide que no fumar; por eso, no fume mientras el hueso esté sanando."]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Coste"]},{"tag":"p","props":{},"children":["No cuesta nada;"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Beneficio"]},{"tag":"p","props":{},"children":["Un estudio estadounidense que siguió a un grupo de personas (solo observó, sin asignarlas a grupos) encontró q…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"Marcar: Dejar de fumar, cuanto antes mejor"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"Hecho"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"Por hacer"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"Guardar"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Compartir consejo"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Ocultar detalles"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Coste"]},{"tag":"p","props":{},"children":["No cuesta nada; al contrario, ahorra dinero. Un paquete diario de cigarrillos cuesta unos 20–30 yuanes; al dejar de fumar, ese dinero se queda en el bolsillo. Lo difícil es superar la fase de abstinencia, que suele durar unas semanas o meses."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Beneficio"]},{"tag":"p","props":{},"children":["Un estudio estadounidense que siguió a un grupo de personas (solo observó, sin asignarlas a grupos) encontró que quienes siguen fumando tienen una esperanza de vida más de 10 años inferior a la de quienes nunca fumaron. Dejarlo antes de los 40 años elimina aproximadamente el 90 % del riesgo de muerte asociado a seguir fumando. Dejarlo entre los 25 y 34 años se asocia con unos 10 años más de vida; entre los 35 y 44, unos 9 años; y entre los 45 y 54, unos 6 años (el artículo original presenta los resultados en años de vida). Estudios similares en China: en la década de 2010, el riesgo de muerte de los hombres fumadores de zonas urbanas fue 1,65 veces el de quienes no fumaban (RR 1,65), y en zonas rurales, 1,22 veces. Tras 10 años de haber dejado de fumar por decisión propia, ese exceso de riesgo casi desaparece. También importa después de una fractura. Al combinar 19 estudios observacionales, sin asignación a grupos, las probabilidades de que una fractura no consolidara fueron unas 2,3 veces las de los no fumadores (OR 2,32; IC del 95 %: 1,76–3,06; ajustado por otros factores). También fueron mayores en las fracturas de tibia y las fracturas abiertas. En un ensayo aleatorizado de Suecia, de las 50 personas que participaron en un programa de abandono del tabaco durante 6 semanas después de una operación urgente por fractura, el 20 % tuvo al menos una complicación posoperatoria. Entre las 55 que no participaron, fue el 38 %. Para una operación programada, se puede empezar a dejar de fumar entre 4 y 8 semanas antes, con asesoramiento semanal y productos de sustitución de nicotina. Esta intervención se asoció con aproximadamente un 58 % menos de complicaciones posoperatorias (RR 0,42; IC del 95 %: 0,27–0,65; 2 ensayos, 210 personas)."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Fuentes originales"]},{"tag":"p","props":{"className":"life-citations"},"children":["Jha P 等 (2013). 21st-century hazards of smoking and benefits of cessation in the United States. NEJM. ",{"tag":"a","props":{"href":"https://doi.org/10.1056/NEJMsa1211128","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1056/NEJMsa1211128"]},"；Chen Z 等 (2015). Contrasting male and female trends in tobacco-attributed mortality in China: evidence from successive nationwide prospective cohort studies. Lancet. ",{"tag":"a","props":{"href":"https://doi.org/10.1016/S0140-6736(15)00340-2","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1016/S0140-6736(15)00340-2"]},"；Oberg M 等 (2011). Worldwide burden of disease from exposure to second-hand smoke: a retrospective analysis of data from 192 countries. Lancet. ",{"tag":"a","props":{"href":"https://doi.org/10.1016/S0140-6736(10)61388-8","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1016/S0140-6736(10)61388-8"]},"（二手烟那两个数字）；Scolaro JA 等 (2014). Cigarette smoking increases complications following fracture: a systematic review. J Bone Joint Surg Am. ",{"tag":"a","props":{"href":"https://doi.org/10.2106/JBJS.M.00081","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.2106/JBJS.M.00081"]},"；Nåsell H 等 (2010). Effect of smoking cessation intervention on results of acute fracture surgery: a randomized controlled trial. J Bone Joint Surg Am. ",{"tag":"a","props":{"href":"https://doi.org/10.2106/JBJS.I.00627","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.2106/JBJS.I.00627"]},"；Thomsen T 等 (2014). Interventions for preoperative smoking cessation. Cochrane Database Syst Rev. ",{"tag":"a","props":{"href":"https://doi.org/10.1002/14651858.CD002294.pub4","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1002/14651858.CD002294.pub4"]},"（骨折和手术那几个数字）"]},{"tag":"a","props":{"href":"https://doi.org/10.1056/NEJMsa1211128","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Abrir fuente"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Nota del autor"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["El humo de otros también mata: en 2004, unas 603 000 personas murieron en todo el mundo por el humo de segunda mano, cerca del 1 % de todas las muertes de ese año. Aunque no fume, evite el humo ajeno, especialmente para que los niños no lo respiren. Las estrategias concretas para dejar de fumar están en los cuatro puntos siguientes: punto 3 (medicamentos para dejar de fumar), punto 4 (fijar una fecha para dejarlo), punto 5 (acudir a una consulta para dejar de fumar) y punto 6 (cigarrillos electrónicos). La cifra sobre la falta de consolidación ósea procede de estudios observacionales, sin asignación a grupos. Los fumadores pueden diferir de los no fumadores en otros aspectos, y no es posible ajustar por todas esas diferencias. El ensayo sobre abandono del tabaco después de una fractura solo incluyó a 105 personas; con otro método de cálculo, la diferencia deja de ser estadísticamente significativa."]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Mi nota"]},{"tag":"button","props":{"type":"button"},"children":["Escribe un recordatorio…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"span","props":{},"children":[]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/es/tip/02-02"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Siguiente"]},"No fume en casa ni en el coche, y no permita que sus invitados fumen en su hogar"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":