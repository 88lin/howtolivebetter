":{"href":"/tip/15-07"},"children":[{"tag":"strong","props":{},"children":["二手房让中介代收房款的，必须走中介在银行开的交易资金专用存款账户"]},{"tag":"span","props":{},"children":["中介代收房款的，按规定必须走它在银行开的专用账户。这个账户受监管，钱不能打进中介自己的账户，也不能转给经纪人个人。"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/15-08"},"children":[{"tag":"strong","props":{},"children":["别租隔断房：最小出租单位是原设计的房间，厨房、卫生间、阳台不得住人"]},{"tag":"span","props":{},"children":["按规定，最小的出租单位是原来设计好的那间房。厨房、卫生间、阳台和地下储藏室不能住人。另外，租期内房东也不能自己说涨租就涨租。"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/15-09"},"children":[{"tag":"strong","props":{},"children":["城镇户口想搬去乡下住，只租农房，别买宅基地和宅基地上的房子"]},{"tag":"span","props":{},"children":["城镇户口的人不能到农村买宅基地、农民的房子或者「小产权房」，国家文件明令禁止。村里人说「写个合同就行」，也一样不行。想在乡下长住，就签租赁合同，一次最长签 20…"]}]}]}]},{"tag":"a","props":{"className":"life-text-link","href":"/book/15"},"children":["阅读整个主题：租房与买房 ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"15","height":"15","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]}]}]},{"tag":"nav","props":{"className":"life-tabbar","aria-label":"主导航"},"children":[{"tag":"a","props":{"className":"","href":"/book"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"21","height":"21","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-book-open","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M12 7v14"},"children":[]},{"tag":"path","props":{"d":"M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z"},"children":[]}]},{"tag":"span","props":{},"children":["全书"]}]},{"tag":"a"