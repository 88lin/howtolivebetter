n":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Chia sẻ mẹo này"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Ẩn chi tiết"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Chi phí"]},{"tag":"p","props":{},"children":["Không tốn tiền. Gia hạn bảo hiểm y tế, bỏ rượu. Khó ở chỗ khoảng thời gian này dễ dựa vào rượu để chịu đựng"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Lợi ích"]},{"tag":"p","props":{},"children":["32 nghiên cứu ghi sẵn rồi theo dõi tiếp gộp lại, bao phủ hơn 6.500.000 người, 160.000 ca tử vong, hơn 755.000 ca ly hôn, 11 quốc gia. So với người còn hôn nhân, người trưởng thành sống xa nhau hoặc ly hôn có nguy cơ chết sớm tăng rõ rệt. Nam và người trẻ hơn tăng rõ hơn nữ và người lớn tuổi. Tác giả bàn bốn đường có thể. Một là lựa chọn xã hội, người vốn đã khác nhau về sức khoẻ hay điều kiện thì dễ đi đến ly hôn hơn. Hai là gián đoạn nguồn lực, thu nhập và sự bảo đảm bị đứt. Ba là thay đổi hành vi sức khoẻ, thuốc lá, rượu, giờ ngủ xấu đi. Bốn là áp lực tâm lý mạn tính (căng thẳng kéo dài)"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Nguồn gốc"]},{"tag":"p","props":{"className":"life-citations"},"children":["Sbarra DA, et al. (2011). Divorce and Death: A Meta-Analysis and Research Agenda for Clinical, Social, and Health Psychology. Perspectives on Psychological Science. ",{"tag":"a","props":{"href":"https://doi.org/10.1177/1745691611414724","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1177/1745691611414724"]}]},{"tag":"a","props":{"href":"https://doi.org/10.1177/1745691611414724","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Liên kết mở nguồn"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Ghi chú sách"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["Bài gốc chỉ nói «tăng rõ rệt» và so sánh giữa các nhóm, không đưa ra hệ số có thể trích dẫn, nên ở đây không viết con số cụ thể. Cỡ lợi ích đặt là vừa, theo cách «biết hướng, không có mức giảm nào để áp». Tài sản, nợ và tiền cưới lúc ly hôn xem phần 8 và phần 10. Cách sắp xếp nuôi con xem phần 18"]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Ghi chú của tôi"]},{"tag":"button","props":{"type":"button"},"children":["Viết một lời nhắc cho chính bạn…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/vi/tip/29-09"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Trước"]},"Đừng vội trả tiền làm tư vấn đau buồn, xem trước nỗi buồn của mình có thật sự bị kẹt không (các triệu chứng ở mục 8)"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/vi/tip/29-11"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Tiếp theo"]},"Muốn có người để nói chuyện thì gọi 12356, người chưa thành niên và thanh niên gọi 12355, muốn khám bác sĩ thì đăng ký khám tâm lý ngoại trú"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLin