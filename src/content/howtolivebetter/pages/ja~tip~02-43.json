":"/ja/book/02"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"目次に戻る"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["ゆっくり死なないために"]},{"tag":"div","props":{"data-ad-dock-host":"true"},"children":[]},{"tag":"nav","props":{"aria-label":"この章のヒント"},"children":[{"tag":"a","props":{"href":"/ja/tip/02-01"},"children":[{"tag":"span","props":{},"children":["01"]},"禁煙、早ければ早いほど良い"]},{"tag":"a","props":{"href":"/ja/tip/02-02"},"children":[{"tag":"span","props":{},"children":["02"]},"自宅や車内での喫煙は避け、客人に自宅での喫煙もさせない"]},{"tag":"a","props":{"href":"/ja/tip/02-03"},"children":[{"tag":"span","props":{},"children":["03"]},"禁煙は我慢するだけでなく、まずは薬を：成功率は2倍以上に向上"]},{"tag":"a","props":{"href":"/ja/tip/02-04"},"children":[{"tag":"span","props":{},"children":["04"]},"禁煙日を決め、その日に一気にやめる。徐々に減らすのは避けること"]},{"tag":"a","props":{"href":"/ja/tip/02-05"},"children":[{"tag":"span","props":{},"children":["05"]},"禁煙外来を受診するか、12320 に電話して、お住まいの地域に禁煙サービスがあるか確認する"]},{"tag":"a","props":{"href":"/ja/tip/02-06"},"children":[{"tag":"span","props":{},"children":["06"]},"禁煙できないなら電子タバコを検討すべきだが、もともと非喫煙者は手を出さないこと"]},{"tag":"a","props":{"href":"/ja/tip/02-07"},"children":[{"tag":"span","props":{},"children":["07"]},"糖分入口的飲料を控えるだけでは不十分、糖類ゼロへの置き換えも解決策にはならない"]},{"tag":"a","props":{"href":"/ja/tip/02-08"},"children":[{"tag":"span","props":{},"children":["08"]},"ビンロウ（アレカナッツ）を噛まない"]},{"tag":"a","props":{"href":"/ja/tip/02-09"},"children":[{"tag":"span","props":{},"children":["09"]},"家庭で使用する食塩を低ナトリウム塩（カリウム塩）に切り替える"]},{"tag":"a","props":{"href":"/ja/tip/02-10"},"children":[{"tag":"span","props":{},"children":["10"]},"丁寧に歯を磨き、毎日歯間を掃除し、欠損した歯は早めに補う"]},{"tag":"a","props":{"href":"/ja/tip/02-11"},"children":[{"tag":"span","props":{},"children":["11"]},"毎日 7000–8000 歩歩く、または週に合計 150–300 分間の早歩きを行う"]},{"tag":"a","props":{"href":"/ja/tip/02-12"},"children":[{"tag":"span","props":{},"children":["12"]},"高血圧・高脂血症がある場合は医師の指示通りに服薬し、自己判断で中断しない"]},{"tag":"a","props":{"href":"/ja/tip/02-13"},"children":[{"tag":"span","props":{},"children":["13"]},"毎晩約7時間の睡眠、規則正しい生活リズム"]},{"tag":"a","props":{"href":"/ja/tip/02-14"},"children":[{"tag":"span","props":{},"children":["14"]},"テニス、バドミントン、卓球などのラケットスポーツを日常的に行う"]},{"tag":"a","props":{"href":"/ja/tip/02-15"},"children":[{"tag":"span","props":{},"children":["15"]},"階段的な強度の活動（階段を上る、早歩きなど）を、1日合計4〜5分間に集める"]},{"tag":"a","props":{"href":"/ja/tip/02-16"},"children":[{"tag":"span","props":{},"children":["16"]},"週に30–60分の筋力トレーニングを行う"]},{"tag":"a","props":{"href":"/ja/tip/02-17"},"children":[{"tag":"span","props":{},"children":["17"]},"長時間座りっぱなしを避け、定期的に立ち上がって動く"]},{"tag":"a","props":{"href":"/ja/tip/02-18"},"children":[{"tag":"span","props":{},"children":["18"]},"加工肉（ハム、ベーコン、ソーセージ、 luncheon meat）の摂取を控える"]},{"tag":"a","props":{"href":"/ja/tip/02-19"},"children":[{"tag":"span","props":{},"children":["19"]},"飲酒を控える、または断酒する"]},{"tag":"a","props":{"href":"/ja/tip/02-20"},"children":[{"tag":"span","props":{},"children":["20"]},"毎日飲酒しており、やめると手が震えたり動悸がしたりする人は、無理に断酒しないでください"]},{"tag":"a","props":{"href":"/ja/tip/02-21"},"children":[{"tag":"span","props":{},"children":["21"]},"飲酒量を減らしたいなら、まずは1週間にどれだけ飲んだかを数え、それから医師と数分間話しましょう"]},{"tag":"a","props":{"href":"/ja/tip/02-22"},"children":[{"tag":"span","props":{},"children":["22"]},"毎日ひとつかみのナッツを食べる"]},{"tag":"a","props":{"href":"/ja/tip/02-23"},"children":[{"tag":"span","props":{},"children":["23"]},"赤身肉の一部を魚や鶏肉に置き換える"]},{"tag":"a","props":{"href":"/ja/tip/02-24"},"children":[{"tag":"span","props":{},"children":["24"]},"精白米や白小麦粉の一部を全粒穀物に置き換える"]},{"tag":"a","props":{"href":"/ja/tip/02-25"},"children":[{"tag":"span","props":{},"children":["25"]},"週に3回以上、お茶を飲む"]},{"tag":"a","props":{"href":"/ja/tip/02-26"},"children":[{"tag":"span","props":{},"children":["26"]},"毎日3〜4杯のコーヒーを、砂糖やミルクなしで飲む"]},{"tag":"a","props":{"href":"/ja/tip/02-27"},"children":[{"tag":"span","props":{},"children":["27"]},"毎日、十分な量の 5 単位（約 400 g）の果物と野菜を食べる"]},{"tag":"a","props":{"href":"/ja/tip/02-28"},"children":[{"tag":"span","props":{},"children":["28"]},"超加工食品（ポテトチップス、インスタントラーメン、菓子類、ファストフード）の摂取を控える"]},{"tag":"a","props":{"href":"/ja/tip/02-29"},"children":[{"tag":"span","props":{},"children":["29"]},"料理や暖房に石炭や薪を使わず、電気やガスに切り替える"]},{"tag":"a","props":{"href":"/ja/tip/02-30"},"children":[{"tag":"span","props":{},"children":["30"]},"熱いものは少し冷ましてから飲む。熱すぎる茶、スープ、コーヒーは避ける"]},{"tag":"a","props":{"href":"/ja/tip/02-31"},"children":[{"tag":"span","props":{},"children":["31"]},"日中は外出して日光を浴びる。一日中光を避けない"]},{"tag":"a","props":{"href":"/ja/tip/02-32"},"children":[{"tag":"span","props":{},"children":["32"]},"BMIを20–25に保つ、過体重なら減量"]},{"tag":"a","props":{"href":"/ja/tip/02-33"},"children":[{"tag":"span","props":{},"children":["33"]},"週に4回以上の唐辛子の摂取"]},{"tag":"a","props":{"href":"/ja/tip/02-34"},"children":[{"tag":"span","props":{},"children":["34"]},"毎日1〜2サービングの乳製品またはヨーグルトを摂取"]},{"tag":"a","props":{"href":"/ja/tip/02-35"},"children":[{"tag":"span","props":{},"children":["35"]},"卵は禁止する必要はないが、毎日3〜4個も食べないこと"]},{"tag":"a","props":{"href":"/ja/tip/02-36"},"children":[{"tag":"span","props":{},"children":["36"]},"条件が許すなら入浴を、シャワーだけで済ませない"]},{"tag":"a","props":{"href":"/ja/tip/02-37"},"children":[{"tag":"span","props":{},"children":["37"]},"昼寝は30分以内に抑えること。1時間を超えないように。1〜2時間寝ないと持ちこたえられない場合は原因を調べること"]},{"tag":"a","props":{"href":"/ja/tip/02-38"},"children":[{"tag":"span","props":{},"children":["38"]},"徹夜明けの翌晩には睡眠を補うこと。週末まで溜め込まない"]},{"tag":"a","props":{"href":"/ja/tip/02-39"},"children":[{"tag":"span","props":{},"children":["39"]},"夜勤の期間が長いほど心血管リスクは高まる。配置転換ができるなら早めに検討を"]},{"tag":"a","props":{"href":"/ja/tip/02-40"},"children":[{"tag":"span","props":{},"children":["40"]},"包装済みでSC番号がある食用油を購入すること。小規模な手作り・バラ売りのピーナッツ油は避ける"]},{"tag":"a","props":{"href":"/ja/tip/02-41"},"children":[{"tag":"span","props":{},"children":["41"]},"料理にラードやバターの代わりに植物油を使用：健康のために油を使い分ける必要はなく、亜麻仁油に心臓保護を期待しても意味がない"]},{"tag":"a","props":{"href":"/ja/tip/02-42"},"children":[{"tag":"span","props":{},"children":["42"]},"炒め物や揚げ物の際は換気扇を回すこと。火をつけた瞬間から料理が終わるまで。"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/ja/tip/02-43","data-status":"active"},"children":[{"tag":"span","props":{},"children":["43"]},"閉経前後のほてりや寝汗が生活に支障をきたすなら、婦人科でホルモン療法の評価を受ける。我慢せず、自己判断で薬を買わず、心臓病予防にも使わない"]},{"tag":"a","props":{"href":"/ja/tip/02-44"},"children":[{"tag":"span","props":{},"children":["44"]},"もともと犬を飼いたい人は毎日の散歩を歩行量に含める。長生きだけを目的に飼わない"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"現在地"},"children":[{"tag":"a","props":{"href":"/ja/book"},"children":["本を読む"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/ja/book/02"},"children":["第2章"," ·"," ","ゆっくり死なないために"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"02-43"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["43"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["エビデンス"," ","A"]}]},{"tag":"h1","props":{"lang":"ja"},"children":["閉経前後のほてりや寝汗が生活に支障をきたすなら、婦人科でホルモン療法の評価を受ける。我慢せず、自己判断で薬を買わず、心臓病予防にも使わない"]},{"tag":"p","props":{"lang":"ja","className":"life-entry-summary"},"children":["閉経前後のほてりや寝汗にホルモン療法を使うと、ほてりの回数はプラセボより約75%少なくなります。一方で、乳がん、血栓、脳卒中は少し増え、それぞれ女性1万人あたり年間約8人増えます。50～59歳で使い始めた人では、全死亡率は上昇していません。心臓病や認知症の予防には使えません。"]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["費用・手間"]},{"tag":"p","props":{},"children":["婦人科または更年期外来を一度受診します。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["効果"]},{"tag":"p","props":{},"children":["Cochraneは24件のランダム化試験、3329人をまとめ、経口ホルモン療法とプラセボを比較しました。"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"記録する：閉経前後のほてりや寝汗が生活に支障をきたすなら、婦人科でホルモン療法の評価を受ける。我慢せず、自己判断で薬を買わず、心臓病予防にも使わない"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"できている"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"やることに追加"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"お気に入り"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"このヒントを共有"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"詳細を閉じる"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["費用・手間"]},{"tag":"p","props":{},"children":["婦人科または更年期外来を一度受診します。医師が病歴を確認し、ホルモン療法が適さない状態がないかを調べ、適していれば処方します。開始後は医師の指示どおりに再診してください。難しいのは、「ホルモンを使ったら必ずがんになる」という恐れを手放すことです。老化を防げると聞いて自分で買うこともしないでください。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["効果"]},{"tag":"p","props":{},"children":["Cochraneは24件のランダム化試験、3329人をまとめ、経口ホルモン療法とプラセボを比較しました。ホルモンを使った人の1週間あたりのほてりの回数は、プラセボより約75%少なくなりました（95% CI 64.3–82.3、信頼区間）。ほてりの重症度も明らかに軽くなりました（OR 0.13、0.07–0.23）。プラセボを飲んだ人も、ほてりが約57.7%減りました。そのため、ほてりを治すとされるものは、プラセボと比較して初めて効果を判断できます。リスクについては米国のWHIランダム化試験を見ます。子宮のある50～79歳の女性16608人がエストロゲンとプロゲスチンを併用し、平均5.2年間追跡されました。冠動脈疾患は約29%増えました（HR 1.29、1.02–1.63）。浸潤性乳がんは約26%増えました（HR 1.26、1.00–1.59）。脳卒中は約41%増えました（HR 1.41、1.07–1.85）。肺塞栓症は約2.13倍でした（HR 2.13、1.39–3.25）。絶対数に換算すると、女性1万人あたり年間、冠動脈疾患が7例、脳卒中が8例、肺塞栓症が8例、浸潤性乳がんが8例増えました。同時に、大腸がんは6例、股関節部骨折は5例減りました。子宮を摘出し、エストロゲンだけを使用した女性では、累計13年間の追跡で、乳がんは逆に約21%少なくなりました（HR 0.79、0.65–0.97）。2件の試験を合わせて18年間追跡した結果、全死亡率に変化はありませんでした（HR 0.99、0.94–1.03）。使用開始時の年齢別に見ると、50～59歳群では使用期間中の全死亡率が約31%低くなりました（HR 0.69、0.51–0.94）。60～69歳群は1.04（0.87–1.25）、70～79歳群は1.13（0.94–1.36）で、いずれも有意ではありませんでした。18年間追跡すると、50～59歳群も0.89（0.79–1.01）となり、有意ではなくなりました。Cochraneの2017年のレビューでは、50～59歳の女性だけを見ると、明らかに増えたのはエストロゲンとプロゲスチンを併用した場合の血栓だけで、絶対リスクは1/500未満でした。65歳以上でエストロゲンとプロゲスチンを併用した女性では、4年間で認知症が1000人あたり9例から11～30例に増えました。米国予防医学専門委員会は2022年、慢性疾患予防のためのホルモン使用に反対し（推奨グレードD）、正味の利益はないと結論づけました。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["出典"]},{"tag":"p","props":{"className":"life-citations"},"children":["MacLennan AH, Broadbent JL, Lester S, Moore V (2004). Oral oestrogen and combined oestrogen/progestogen therapy versus placebo for hot flushes. Cochrane Database of Systematic Reviews, (4), CD002978. ",{"tag":"a","props":{"href":"https://doi.org/10.1002/14651858.CD002978.pub2","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1002/14651858.CD002978.pub2"]},"；Writing Group for the Women's Health Initiative Investigators, Rossouw JE, Anderson GL, Prentice RL, 等 (2002). Risks and benefits of estrogen plus progestin in healthy postmenopausal women: principal results from the Women's Health Initiative randomized controlled trial. JAMA, 288(3), 321-333. ",{"tag":"a","props":{"href":"https://doi.org/10.1001/jama.288.3.321","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1001/jama.288.3.321"]},"；Manson JE, Chlebowski RT, Stefanick ML, 等 (2013). Menopausal hormone therapy and health outcomes during the intervention and extended poststopping phases of the Women's Health Initiative randomized trials. JAMA, 310(13), 1353-1368. ",{"tag":"a","props":{"href":"https://doi.org/10.1001/jama.2013.278040","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1001/jama.2013.278040"]},"；Manson JE, Aragaki AK, Rossouw JE, 等 (2017). Menopausal hormone therapy and long-term all-cause and cause-specific mortality: the Women's Health Initiative randomized trials. JAMA, 318(10), 927-938. ",{"tag":"a","props":{"href":"https://doi.org/10.1001/jama.2017.11217","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1001/jama.2017.11217"]},"；Marjoribanks J, Farquhar C, Roberts H, 等 (2017). Long-term hormone therapy for perimenopausal and postmenopausal women. Cochrane Database of Systematic Reviews, (1), CD004143. ",{"tag":"a","props":{"href":"https://doi.org/10.1002/14651858.CD004143.pub5","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1002/14651858.CD004143.pub5"]},"；US Preventive Services Task Force, Mangione CM, Barry MJ, 等 (2022). Hormone therapy for the primary prevention of chronic conditions in postmenopausal persons: US Preventive Services Task Force recommendation statement. JAMA, 328(17), 1740-1746. ",{"tag":"a","props":{"href":"https://doi.org/10.1001/jama.2022.18625","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1001/jama.2022.18625"]}]},{"tag":"a","props":{"href":"https://doi.org/10.1002/14651858.CD002978.pub2","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["出典を開く"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["著者の注記"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["議論あり。WHIの女性は平均63歳で、固定された一つの経口投与法を使っていました。現在は多くの人が50代で、閉経直後に症状を和らげるために使用しており、試験の参加者とは完全には同じではありません。50～59歳群の死亡率低下は年齢別の解析で認められたもので、18年まで追跡すると有意ではなくなりました。そのため、ホルモンが寿命を延ばすとは言えません。Cochraneも、閉経から10年以内の女性のリスクを明確に把握するには試験規模が不十分だと明記しています。乳がんの既往がある人、血栓の既往がある人、心血管疾患のリスクが高い人、肥満が強い人には、通常は適しません。具体的には医師が判断します。子宮のある人がエストロゲンだけを使うと子宮内膜がんが増えるため、プロゲスチンを併用する必要があります。エストロゲンだけを使えるのは、子宮を摘出した人です。ホルモンは骨折も減らしますが、通常は他の骨粗鬆症治療薬が適さない場合にのみ検討します。骨粗鬆症については、まず第1節第39条（骨密度検査）と第1節第40条（骨粗鬆症が見つかったら薬で治療する）を参照してください。利益の大きさは、ほてりの回数が約75%減ることに基づき「大」とします。評価しているのは症状であり、全死亡率ではありません。この項目で主に利益を受けるのはあなた自身で、あなたの母親と配偶者も含まれます。"]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["自分のメモ"]},{"tag":"button","props":{"type":"button"},"children":["自分へのメモを書く…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/ja/tip/02-42"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["前へ"]},"炒め物や揚げ物の際は換気扇を回すこと。火をつけた瞬間から料理が終わるまで。"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/ja/tip/02-44"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["次へ"]},"もともと犬を飼いたい人は毎日の散歩を歩行量に含める。長生きだけを目的に飼わない"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["このテーマの他の提案"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/02-36"},"children":[{"tag":"strong","props":{},"children":["条件が許すなら入浴を、シャワーだけで済ませない"]},{"tag":"span","props":{},"children":["ほぼ毎日入浴する人は、週に2回未満の人に比べて、心血管イベントのリスクが約 28% 低く、脳出血のリスクが約 46% 低くなります。"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/02-37"},"children":[{"tag":"strong","props":{},"children":["昼寝は30分以内に抑えること。1時間を超えないように。1〜2時間寝ないと持ちこたえられない場合は原因を調べること"]},{"tag":"span","props":{},"children":["昼寝が1時間を超えない人は、死亡および慢性疾患のリスクは上昇せず、脳の覚醒度もより高まります。1時間を超える睡眠をとる人は、冠動脈疾患のリ…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/02-38"},"children":[{"tag":"strong","props":{},"children":["徹夜明けの翌晩には睡眠を補うこと。週末まで溜め込まない"]},{"tag":"span","props":{},"children":["睡眠不足の翌晩に睡眠を補えなかった人は、規則正しい生活の人に比べて死亡リスクが約 15% 高く、大幅に睡眠不足な上、補えなかった人のリスク…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/02-39"},"chi