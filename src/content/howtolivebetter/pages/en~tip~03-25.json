","props":{"d":"M2 12h2"},"children":[]},{"tag":"path","props":{"d":"M20 12h2"},"children":[]},{"tag":"path","props":{"d":"m6.34 17.66-1.41 1.41"},"children":[]},{"tag":"path","props":{"d":"m19.07 4.93-1.41 1.41"},"children":[]}]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"17","height":"17","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-moon life-theme-icon-dark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"},"children":[]}]}]},{"tag":"button","props":{"type":"button","className":"life-language-switch","aria-label":"English Choose language","aria-haspopup":"menu","aria-expanded":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-globe","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]},{"tag":"path","props":{"d":"M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"},"children":[]},{"tag":"path","props":{"d":"M2 12h20"},"children":[]}]},{"tag":"span","props":{},"children":["English"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]}]},{"tag":"a","props":{"className":"life-account","href":"/en/sign-in"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"17","height":"17","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle-user-round","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M18 20a6 6 0 0 0-12 0"},"children":[]},{"tag":"circle","props":{"cx":"12","cy":"10","r":"4"},"children":[]},{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},{"tag":"span","props":{},"children":["Sign in to sync"]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/en/book/03"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"Back to index"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["Don’t waste your energy"]},{"tag":"nav","props":{"aria-label":"Chapter entries"},"children":[{"tag":"a","props":{"href":"/en/tip/03-01"},"children":[{"tag":"span","props":{},"children":["01"]},"Turn off non‑essential notifications and keep your phone out of sight while working"]},{"tag":"a","props":{"href":"/en/tip/03-02"},"children":[{"tag":"span","props":{},"children":["02"]},"Keep a fixed wake-up time, even on weekends"]},{"tag":"a","props":{"href":"/en/tip/03-03"},"children":[{"tag":"span","props":{},"children":["03"]},"Getting 7 to 8 hours of sleep each night — don’t settle for just 6 hours"]},{"tag":"a","props":{"href":"/en/tip/03-04"},"children":[{"tag":"span","props":{},"children":["04"]},"Avoid caffeine after 2 p.m"]},{"tag":"a","props":{"href":"/en/tip/03-05"},"children":[{"tag":"span","props":{},"children":["05"]},"Batch-process emails and messages a few times per day"]},{"tag":"a","props":{"href":"/en/tip/03-06"},"children":[{"tag":"span","props":{},"children":["06"]},"When doing tasks that require continuous thinking, keep out even brief interruptions"]},{"tag":"a","props":{"href":"/en/tip/03-07"},"children":[{"tag":"span","props":{},"children":["07"]},"Do one thing at a time — don’t reply to messages while in a meeting"]},{"tag":"a","props":{"href":"/en/tip/03-08"},"children":[{"tag":"span","props":{},"children":["08"]},"Avoid glowing screens one hour before bed; if you must, read paper books or e-ink devices instead"]},{"tag":"a","props":{"href":"/en/tip/03-09"},"children":[{"tag":"span","props":{},"children":["09"]},"Go to bed at a set time — avoid staying up late for games, short videos, or porn"]},{"tag":"a","props":{"href":"/en/tip/03-10"},"children":[{"tag":"span","props":{},"children":["10"]},"Don’t make major decisions or send important messages late at night"]},{"tag":"a","props":{"href":"/en/tip/03-11"},"children":[{"tag":"span","props":{},"children":["11"]},"Take a 10‑minute nap in the afternoon — don’t sleep half an hour"]},{"tag":"a","props":{"href":"/en/tip/03-12"},"children":[{"tag":"span","props":{},"children":["12"]},"Using earplugs or finding a quiet room for memory-heavy tasks in open offices"]},{"tag":"a","props":{"href":"/en/tip/03-13"},"children":[{"tag":"span","props":{},"children":["13"]},"Do not keep adding weekly work hours: beyond roughly 49 hours, each extra hour produces less additional output"]},{"tag":"a","props":{"href":"/en/tip/03-14"},"children":[{"tag":"span","props":{},"children":["14"]},"When you notice yourself endlessly replaying a distressing memory, do something hands‑on instead"]},{"tag":"a","props":{"href":"/en/tip/03-15"},"children":[{"tag":"span","props":{},"children":["15"]},"Treat thoughts like “things will definitely get worse” as symptoms, not as facts"]},{"tag":"a","props":{"href":"/en/tip/03-16"},"children":[{"tag":"span","props":{},"children":["16"]},"Cut back on draining relationships and learn to say no to unwanted requests"]},{"tag":"a","props":{"href":"/en/tip/03-17"},"children":[{"tag":"span","props":{},"children":["17"]},"Walk away when angry; treat the other person as weather, not an enemy"]},{"tag":"a","props":{"href":"/en/tip/03-18"},"children":[{"tag":"span","props":{},"children":["18"]},"Best low-cost actions when you’re feeling down: move, get sunlight, stick to a schedule, talk to someone, call 12356"]},{"tag":"a","props":{"href":"/en/tip/03-19"},"children":[{"tag":"span","props":{},"children":["19"]},"Treat police officers, doctors, and bank tellers as rule‑following workers, not as archetypes: paperwork and deadlines — not emotions — drive results"]},{"tag":"a","props":{"href":"/en/tip/03-20"},"children":[{"tag":"span","props":{},"children":["20"]},"Don’t make “how others are doing” a daily habit: set limits on apps that show peers’ updates or turn them off"]},{"tag":"a","props":{"href":"/en/tip/03-21"},"children":[{"tag":"span","props":{},"children":["21"]},"When you feel like “everyone saw me make a fool of myself,” cut that estimate in half"]},{"tag":"a","props":{"href":"/en/tip/03-22"},"children":[{"tag":"span","props":{},"children":["22"]},"Treat “others expect me to be perfect” as a symptom, not a fact"]},{"tag":"a","props":{"href":"/en/tip/03-23"},"children":[{"tag":"span","props":{},"children":["23"]},"When angry, don’t try to vent by smashing things, punching a bag, or going for a run — first calm your body down"]},{"tag":"a","props":{"href":"/en/tip/03-24"},"children":[{"tag":"span","props":{},"children":["24"]},"Writing down thoughts and feelings about a troubling issue over several days can be helpful, but don’t expect it to cure anything"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/en/tip/03-25","data-status":"active"},"children":[{"tag":"span","props":{},"children":["25"]},"Use painkillers such as ibuprofen for period pain instead of just enduring it; if pain disrupts work or school or remains uncontrolled after three months of medication, see a gynecologist"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"Breadcrumb"},"children":[{"tag":"a","props":{"href":"/en/book"},"children":["Explore the book"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/en/book/03"},"children":["Chapter 3"," ·"," ","Don’t waste your energy"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"03-25"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["25"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["Evidence"," ","A"]}]},{"tag":"h1","props":{"lang":"en"},"children":["Use painkillers such as ibuprofen for period pain instead of just enduring it; if pain disrupts work or school or remains uncontrolled after three months of medication, see a gynecologist"]},{"tag":"p","props":{"lang":"en","className":"life-entry-summary"},"children":["For period pain, drugs such as ibuprofen increase the proportion with substantial pain relief from less than one fifth to about half. They work better than acetaminophen, with slightly more side effects. If pain disrupts work or school, there is deep pain during sex, or medication has not controlled it after three months, see a gynecologist to investigate endometriosis. Diagnosis of this disease is delayed by an average of 6.7 years."]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Cost"]},{"tag":"p","props":{},"children":["A box of ibuprofen costs a little over ten yuan;"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Benefit"]},{"tag":"p","props":{},"children":["A Cochrane systematic review combined 80 randomized controlled trials involving 5820 women with primary dysmen…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"Mark: Use painkillers such as ibuprofen for period pain instead of just enduring it; if pain disrupts work or school or remains uncontrolled after three months of medication, see a gynecologist"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"Done"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"Plan to do"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"Save"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Share this tip"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Hide details"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Cost"]},{"tag":"p","props":{},"children":["A box of ibuprofen costs a little over ten yuan; take it only during the painful days. If you need to see a gynecologist, registration and an ultrasound cost some money and take about half a day."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Benefit"]},{"tag":"p","props":{},"children":["A Cochrane systematic review combined 80 randomized controlled trials involving 5820 women with primary dysmenorrhea. Primary dysmenorrhea means period pain without another identifiable disease. Compared with placebo, nonsteroidal anti-inflammatory drugs were more effective for pain relief (OR 4.37, 95% CI 3.76–5.09, the confidence interval). In absolute terms, 18% of those taking placebo had at least moderate relief, compared with 45% to 53% taking these drugs. The trade-off was more side effects (OR 1.29, 1.11–1.51). Side effects occurred in 10% taking placebo and 11% to 14% taking these drugs. The increases were mainly gastrointestinal symptoms (OR 1.58) and nervous system effects (OR 2.74). These drugs were also more effective than acetaminophen for pain relief (OR 1.89, 1.05–3.43), although this comparison involved only 3 trials. No difference was established in which drug in this class works best. The UK NICE guideline (updated in 2024) lists circumstances in which endometriosis should be suspected: chronic pelvic pain, period pain affecting daily activities and quality of life, and deep pain during or after sex. Other symptoms are painful bowel movements during menstruation, blood in the urine or painful urination during menstruation, and infertility accompanied by these symptoms. Girls aged 17 and under are included. The guideline recommends first trying acetaminophen or these drugs, for example for 3 months. If pain relief is inadequate, refer for further investigation. Normal gynecological examination and ultrasound findings do not rule out this disease. One study surveyed 1418 women undergoing laparoscopy at 16 hospitals in 10 countries. From symptom onset to surgical confirmation of endometriosis, the average delay was 6.7 years, mainly during care in primary settings. Women with a confirmed diagnosis lost an average of 10.8 hours of work per week, mostly through reduced productivity while at work. An online survey in the Netherlands asked 32748 women aged 15 to 45. Of them, 13.8% had taken leave because of menstruation, averaging 1.3 days per year. During menstruation, 80.7% were at work but less productive, equivalent to 8.9 days of lost work per year."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Original sources"]},{"tag":"p","props":{"className":"life-citations"},"children":["Marjoribanks J, Ayeleke RO, Farquhar C, Proctor M (2015). Nonsteroidal anti-inflammatory drugs for dysmenorrhoea. Cochrane Database of Systematic Reviews, (7):CD001751. ",{"tag":"a","props":{"href":"https://doi.org/10.1002/14651858.CD001751.pub3","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1002/14651858.CD001751.pub3"]},"；National Institute for Health and Care Excellence (2017, updated 2024). Endometriosis: diagnosis and management (NG73), recommendations 1.3.1, 1.4.2, 1.4.3, 1.5.4. ",{"tag":"a","props":{"href":"https://www.nice.org.uk/guidance/ng73/chapter/Recommendations","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.nice.org.uk/guidance/ng73/chapter/Recommendations"]},"；Nnoaham KE, Hummelshoj L, Webster P, et al.; World Endometriosis Research Foundation Global Study of Women's Health consortium (2011). Impact of endometriosis on quality of life and work productivity: a multicenter study across ten countries. Fertility and Sterility, 96(2):366-373.e8. ",{"tag":"a","props":{"href":"https://doi.org/10.1016/j.fertnstert.2011.05.090","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1016/j.fertnstert.2011.05.090"]},"；Schoep ME, Adang EMM, Maas JWM, De Bie B, Aarts JWM, Nieboer TE (2019). Productivity loss due to menstruation-related symptoms: a nationwide cross-sectional survey among 32 748 women. BMJ Open, 9(6):e026186. ",{"tag":"a","props":{"href":"https://doi.org/10.1136/bmjopen-2018-026186","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1136/bmjopen-2018-026186"]},"；Haleon (2026). Advil (ibuprofen capsule, liquid filled), OTC drug label: Warnings. DailyMed. ",{"tag":"a","props":{"href":"https://dailymed.nlm.nih.gov/dailymed/drugInfo.cfm?setid=1f01c10a-9434-91a4-2ee4-352315a6b610","target":"_blank","rel":"noopener noreferrer"},"children":["https://dailymed.nlm.nih.gov/dailymed/drugInfo.cfm?setid=1f01c10a-9434-91a4-2ee4-352315a6b610"]}]},{"tag":"a","props":{"href":"https://doi.org/10.1002/14651858.CD001751.pub3","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Open source link"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Book note"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["If you are over 60, have had stomach bleeding, or take anticoagulants or steroids, ask a doctor before using these drugs. For details, see Section 34, item 3 (painkillers such as ibuprofen). The US ibuprofen label states that it can cause a severe allergic reaction, which is more likely in people allergic to aspirin; symptoms include asthma attacks. People with asthma should also ask a doctor before use. If pregnancy is possible, ask a doctor first; after 20 weeks of pregnancy, do not take it on your own. See Section 34, item 5 (after 20 weeks of pregnancy). If you cannot take these drugs, acetaminophen is an alternative; for the daily limit, see Section 34, item 1 (acetaminophen). For period pain, take medication only during the days of menstruation. The threshold in Section 34, item 9 (do not take painkillers on more than 15 days a month) concerns headaches; the number of days of medication for period pain is far below that. The evidence is rated A because pain relief is supported by many randomized trials. The authors rated the quality of evidence for most comparisons as low, mainly because trial methods were poorly described; 59% of trials were funded by drug companies. Rating the benefit “medium” is a judgment: the review measured pain, not the reduction in days off work. In the Dutch survey, menstrual losses were equivalent to about 10 days per year, or hours per week when averaged out. The endometriosis study involved people already undergoing laparoscopy; it does not mean most people with period pain have this disease. The main beneficiary is you."]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["My note"]},{"tag":"button","props":{"type":"button"},"children":["Write a reminder for yourself…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/en/tip/03-24"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{