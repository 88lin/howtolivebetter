":"path","props":{"d":"m19.07 4.93-1.41 1.41"},"children":[]}]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"17","height":"17","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-moon life-theme-icon-dark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"},"children":[]}]}]},{"tag":"button","props":{"type":"button","className":"life-language-switch","aria-label":"English Choose language","aria-haspopup":"menu","aria-expanded":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-globe","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]},{"tag":"path","props":{"d":"M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"},"children":[]},{"tag":"path","props":{"d":"M2 12h20"},"children":[]}]},{"tag":"span","props":{},"children":["English"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]}]},{"tag":"a","props":{"className":"life-account","href":"/en/sign-in"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"17","height":"17","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle-user-round","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M18 20a6 6 0 0 0-12 0"},"children":[]},{"tag":"circle","props":{"cx":"12","cy":"10","r":"4"},"children":[]},{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},{"tag":"span","props":{},"children":["Sign in to sync"]}]}]}]},{"tag":"main","props":{"className":"life-longread"},"children":[{"tag":"a","props":{"className":"life-back-link active","href":"/en/articles","data-status":"active","aria-current":"page"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"All long reads"]},{"tag":"header","props":{"className":"life-longread-header"},"children":[{"tag":"div","props":{},"children":[{"tag":"div","props":{"className":"life-eyebrow"},"children":["Long reads"]},{"tag":"h1","props":{"lang":"en"},"children":["A stranger has an accident on the street: walk away or stop"]},{"tag":"p","props":{"lang":"en"},"children":["Understand the costs and boundaries of walking away, calling for help and intervening."]},{"tag":"a","props":{"className":"life-longread-chapter","href":"/en/book/13"},"children":["Related chapter"," · ","Emergency situations: what to do first",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"img","props":{"src":"/sites/howtolivebetter/images/book-chapters/13-emergency-editorial.webp","srcSet":"/sites/howtolivebetter/images/book-chapters/13-emergency-editorial-thumb.webp 600w, /sites/howtolivebetter/images/book-chapters/13-emergency-editorial-md.webp 900w, /sites/howtolivebetter/images/book-chapters/13-emergency-editorial.webp 1200w","sizes":"(max-width: 760px) 100vw, 450px","alt":"","width":"1200","height":"800","fetchPriority":"high"},"children":[]}]},{"tag":"div","props":{"className":"life-longread-layout"},"children":[{"tag":"aside","props":{"className":"life-longread-toc"},"children":[{"tag":"details","props":{"open":true},"children":[{"tag":"summary","props":{},"children":["On this page"]},{"tag":"nav","props":{"aria-label":"On this page"},"children":[{"tag":"a","props":{"href":"#the-three-paths"},"children":["The three paths"]},{"tag":"a","props":{"href":"#costs-that-can-appear-after-you-stop-from-lighter-to-heavier"},"children":["Costs that can appear after you stop, from lighter to heavier"]},{"tag":"a","props":{"href":"#three-situations-in-which-walking-away-stops-being-free"},"children":["Three situations in which walking away stops being free"]},{"tag":"a","props":{"href":"#if-you-decide-to-stop-the-lowest-hassle-way-to-do-it"},"children":["If you decide to stop, the lowest-hassle way to do it"]},{"tag":"a","props":{"href":"#sources"},"children":["Sources"]}]}]}]},{"tag":"div","props":{"className":"life-longread-main"},"children":[{"tag":"article","props":{"className":"life-article-body","lang":"en"},"children":[{"tag":"blockquote","props":{},"children":["\n",{"tag":"p","props":{},"children":["Unofficial English translation of ",{"tag":"a","props":{"href":"/articles/helping-a-stranger"},"children":["docs/遇到陌生人出事该不该停.md"]},". In case of discrepancies the Chinese original takes precedence."]},"\n"]},"\n",{"tag":"p","props":{},"children":["This is the long-form version of ",{"tag":"a","props":{"href":"/en/book/13#13-02","title":"If an older person falls or someone collapses, crouch down, call to them and dial 120 before lifting them; walking away from a stranger is also legal in China, but if you stop, do not move them"},"children":["Section 13, item 2"]},". Under the book's beneficiary yardstick, a stranger is the lowest of the four tiers: the prospect of return is small, and you don't know the person's character. So this article does not urge you to do anything; it lays out the full bill each of the three paths carries, and you choose."]},"\n",{"tag":"p","props":{},"children":[{"tag":"strong","props":{},"children":["This article gives no probabilities."]}," Every layer of cost below is real and traceable to specific legal provisions, but there is no published statistic for things like \"what share of rescuers have actually been hit with one of these,\" and the book's rule is that uncertain numbers are better left unwritten. Do not read \"seven layers are listed\" as \"all seven will happen.\""]},"\n",{"tag":"h2","props":{"id":"the-three-paths"},"children":["The three paths"]},"\n",{"tag":"div","props":{"className":"article-table-scroll","tabIndex":"0"},"children":[{"tag":"table","props":{},"children":[{"tag":"thead","props":{},"children":["\n",{"tag":"tr","props":{},"children":["\n",{"tag":"th","props":{},"children":[]},"\n",{"tag":"th","props":{},"children":["Walk away"]},"\n",{"tag":"th","props":{},"children":["Stop but don't touch"]},"\n",{"tag":"th","props":{},"children":["Stop and see it through"]},"\n"]},"\n"]},"\n",{"tag":"tbody","props":{},"children":["\n",{"tag":"tr","props":{},"children":["\n",{"tag":"td","props":{},"children":["Legality"]},"\n",{"tag":"td","props":{},"children":["Legal. An ordinary person owes a stranger no duty of rescue, and criminal law has no offense of \"knowing and not rescuing\". This refers to China; countries such as Germany differ, as explained below"]},"\n",{"tag":"td","props":{},"children":["Legal"]},"\n",{"tag":"td","props":{},"children":["Legal"]},"\n"]},"\n",{"tag":"tr","props":{},"children":["\n",{"tag":"td","props":{},"children":["Time"]},"\n",{"tag":"td","props":{},"children":["0"]},"\n",{"tag":"td","props":{},"children":["A few minutes; calling 120 (China's emergency medical number) leaves your number"]},"\n",{"tag":"td","props":{},"children":["Half a day at minimum, possibly up to accompanying them to the hospital"]},"\n"]},"\n",{"tag":"tr","props":{},"children":["\n",{"tag":"td","props":{},"children":["Likelihood of being tracked down later"]},"\n",{"tag":"td","props":{},"children":["Lowest"]},"\n",{"tag":"td","props":{},"children":["You are the one who left a number"]},"\n",{"tag":"td","props":{},"children":["Highest"]},"\n"]},"\n",{"tag":"tr","props":{},"children":["\n",{"tag":"td","props":{},"children":["Benefit to the other person"]},"\n",{"tag":"td","props":{},"children":["0"]},"\n",{"tag":"td","props":{},"children":["The ambulance arrives sooner"]},"\n",{"tag":"td","props":{},"children":["Greatest"]},"\n"]},"\n"]},"\n"]}]},{"tag":"h2","props":{"id":"costs-that-can-appear-after-you-stop-from-lighter-to-heavier"},"children":["Costs that can appear after you stop, from lighter to heavier"]},"\n",{"tag":"p","props":{},"children":[{"tag":"strong","props":{},"children":["1. Callbacks and questioning."]}," Calling 120 or 110 (China's police emergency number) leaves your number. You may get a callback to confirm the location, and you may be questioned once afterwards. Where a criminal-case informant is unwilling to disclose their name, the case-handling organ must keep it secret for them (刑事诉讼法第一百一十一条 — Criminal Procedure Law, Art. 111); 120 has no corresponding provision."]},"\n",{"tag":"p","props":{},"children":[{"tag":"strong","props":{},"children":["2. Being tracked down by the family."]}," When surveillance footage turns up no trace of the vehicle that caused the accident, the person who left a number and was on the scene is the easiest one for the family to find. Phone pressure and showing up at your door can both happen."]},"\n",{"tag":"p","props":{},"children":[{"tag":"strong","props":{},"children":["3. Being named as a defendant."]}," The side claiming you hit them bears the burden of proof itself; if it cannot produce evidence, it bears the adverse consequences (民诉法解释第九十条 — Interpretation on the Application of the Civil Procedure Law, Art. 90) — ",{"tag":"strong","props":{},"children":["but this rule guarantees only the outcome of the judgment, not that you stay out of the case"]},". The time limit for concluding a first-instance case under the ordinary procedure is 6 months, extendable by another 6 months in special circumstances; the simplified procedure is 3 months (民事诉讼法第一百五十二、一百六十四条 — Civil Procedure Law, Arts. 152 and 164). Even if you win outright, only three items can be shifted onto the other side: the case acceptance fee, application fees, and the travel and lost-earnings costs of witnesses, expert examiners and the like appearing in court (诉讼费用交纳办法第六、二十九条 — Measures on the Payment of Litigation Costs, Arts. 6 and 29). ",{"tag":"strong","props":{},"children":["Attorney's fees are not among them."]}]},"\n",{"tag":"p","props":{},"children":[{"tag":"strong","props":{},"children":["4. It reaching your employer."]}," Disturbing the order of an enterprise or public institution so that work cannot proceed normally: a warning or a fine of up to 500 yuan; where circumstances are relatively serious, detention of 5 to 10 days plus a fine of up to 1000 yuan; where it is done by a crowd, detention of 10 to 15 days for the ringleaders (治安管理处罚法第二十六条第一项 — Public Security Administration Punishments Law, Art. 26, item 1). Harassment, pestering, or stalking that interferes with normal life is punished under Art. 50, item 5, and with the approval of the head of the public security organ an order can be issued barring contact for a set period. A company firing you over this generally counts as an unlawful termination, with compensation computed at 2N (",{"tag":"a","props":{"href":"/en/book/19#19-06","title":"When a company unlawfully terminates employment, the compensation equals twice the standard severance amount"},"children":["Section 19, item 6"]},") — but reporting to the police and filing for arbitration are errands you run yourself, and the loss of the stretch when the job is already gone is not made whole later by eventually collecting 2N."]},"\n",{"tag":"p","props":{},"children":[{"tag":"strong","props":{},"children":["5. Being filmed and posted online."]}," The most important thing to know at this layer: ",{"tag":"strong","props":{},"children":["you may not be able to stop the filming"]},". Making, using, or publicizing another person's likeness without consent is prohibited (民法典第一千零一十九条 — Civil Code, Art. 1019), but \"making, using, or publicizing the likeness of the right holder where unavoidable for the purpose of news reporting\" counts as reasonable use (第一千零二十条第二项 — Civil Code, Art. 1020, item 2). What you can control: no interviews, no appearing on camera, no speaking in front of the lens — whether to consent is your decision; no one can consent for you."]},"\n",{"tag":"p","props":{},"children":[{"tag":"strong","props":{},"children":["6. Re-sharing and cyber-harassment."]}," Once a video spreads, the comment section is out of your control. The self-help measures available are written into 《网络暴力信息治理规定》 (Provisions on the Governance of Cyberbullying Information, effective August 1, 2024): platforms must provide protective settings such as blocking unknown or specific users, limiting the visibility of your own information, banning reposts or comments, and receiving private messages only from friends or rejecting all private messages (Art. 23); must provide a one-click evidence-preservation function for cyberbullying information (Art. 25); must set up a dedicated quick complaint-and-report entrance in a prominent position (Art. 26); and where suspected unlawful or criminal conduct is found, must promptly report to the public security organs and provide leads (Art. 15). For how to preserve evidence and report to the police, see ",{"tag":"a","props":{"href":"/en/book/08#08-16","title":"Don’t curse, spread rumors, or share unverified content online; if you’re a victim of online abuse, document evidence first then report it to police"},"children":["Section 8, item 14"]},"."]},"\n",{"tag":"p","props":{},"children":[{"tag":"strong","props":{},"children":["7. When it gets to be too much."]}," The six layers above can all be met with legal provisions; the seventh cannot. There is no reliable Chinese data to cite on the emotional impact of sustained online attacks, and the book gives no numbers — only an exit: the psychological-assistance hotline 12356 (China's psychological support hotline), see ",{"tag":"a","props":{"href":"/en/book/01#01-25","title":"Call 12356 if you’re depressed or having suicidal thoughts; don’t keep sleeping pills or pesticides at home"},"children":["Section 1, item 25"]},"."]},"\n",{"tag":"h2","props":{"id":"three-situations-in-which-walking-away-stops-being-free"},"children":["Three situations in which walking away stops being free"]},"\n",{"tag":"ul","props":{},"children":["\n",{"tag":"li","props":{},"children":["\n",{"tag":"p","props":{},"children":[{"tag":"strong","props":{},"children":["You are abroad."]}," The statement above that walking away is legal refers to Chinese law. Some countries make failure to assist a person in danger a crime. Section 323c of the German Criminal Code provides that, in accidents, common danger or distress, if help is necessary and can reasonably be expected in the circumstances—especially without substantial danger to yourself or breach of other important duties—failure to assist is punishable by up to 1 year in prison or a fine. Rules differ by country; follow the law where you are."]},"\n"]},"\n",{"tag":"li","props":{},"children":["\n",{"tag":"p","props":{},"children":[{"tag":"strong","props":{},"children":["You are the operator or manager of the premises, or the organizer of a mass activity"]}," (hotels, shopping malls, banks, stations, airports, stadiums, entertainment venues and the like): you bear a duty of safety protection; failing to fulfill it makes you bear tort liability, and where a third party caused the harm and you failed your duty, you bear corresponding supplementary liability (民法典第一千一百九十八条 — Civil Code, Art. 1198). For an on-duty employee or the venue operator, walking away is not the same thing as a passerby walking away."]},"\n"]},"\n",{"tag":"li","props":{},"children":["\n",{"tag":"p","props":{},"children":[{"tag":"strong","props":{},"children":["The matter involves you"]},": you hit them, it is your car, or the danger was created by your own prior conduct. Then the question is no longer \"whether to get involved with someone else\" — it is the traffic-accident handling and hit-and-run question of ",{"tag":"a","props":{"href":"/en/book/08#08-01","title":"After a traffic accident, stop, help the injured, and call the police — don’t flee"},"children":["Section 8, item 1"]},"."]},"\n"]},"\n"]},"\n",{"tag":"h2","props":{"id":"if-you-decide-to-stop-the-lowest-hassle-way-to-do-it"},"children":["If you decide to stop, the lowest-hassle way to do it"]},"\n",{"tag":"ol","props":{},"children":["\n",{"tag":"li","props":{},"children":[{"tag":"strong","props":{},"children":["Don't move them with your hands."]}," This is the only action with no second answer, and the reason is medical, not legal — forcing someone upright can worsen brain hemorrhage or spinal injury. On the legal side, harm caused in the course of rescue is exempted by 民法典第一百八十四条 (Civil Code, Art. 184 — voluntary emergency rescue exemption)."]},"\n",{"tag":"li","props":{},"children":["Call out from a distance and check whether they are breathing; if not, start chest compressions (",{"tag":"a","props":{"href":"/en/book/13#13-01","title":"Immediate chest compressions can save lives when someone collapses and stops breathing — call 120 and fetch an AED too"},"children":["Section 13, item 1"]},"); if yes, call 120 from where you are and report the location."]},"\n",{"tag":"li","props":{},"children":["Pull in another passerby and start recording on your phone. Witness testimony and physical evidence beat arguing after the fact."]},"\n",{"tag":"li","props":{},"children":["Don't lift them into a car on your own, and don't pay out of pocket to get them to a hospital. This is the highest-cost, lowest-return stretch of the whole road."]},"\n",{"tag":"li","props":{},"children":["If you were injured rescuing them or spent your own money, how to get the money back is covered in ",{"tag":"a","props":{"href":"/en/book/13#13-39","title":"After saving someone and getting injured or incurring expenses, first seek compensation from the perpetrator and yibao; then apply for recognition as a person acting in the public interest"},"children":["Section 13, item 40"]},"."]},"\n"]},"\n",{"tag":"h2","props":{"id":"sources"},"children":["Sources"]},"\n",{"tag":"ul","props":{},"children":["\n",{"tag":"li","props":{},"children":["National People's Congress (2020). 民法典 (Civil Code) (Arts. 184, 1019, 1020, 1198). Full text republished by the Supreme People's Procuratorate. ",{"tag":"a","props":{"href":"https://www.spp.gov.cn/spp/fl/202006/t20200602_463888.shtml","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.spp.gov.cn/spp/fl/202006/t20200602_463888.shtml"]}]},"\n",{"tag":"li","props":{},"children":["Supreme People's Court (second revision 2022, effective April 10, 2022). 关于适用《中华人民共和国民事诉讼法》的解释 (Interpretation on the Application of the Civil Procedure Law of the People's Republic of China) (Art. 90). ",{"tag":"a","props":{"href":"https://www.court.gov.cn/zixun/xiangqing/353651.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.court.gov.cn/zixun/xiangqing/353651.html"]}]},"\n",{"tag":"li","props":{},"children":["NPC Standing Committee (revised 2023, effective January 1, 2024). 民事诉讼法 (Civil Procedure Law) (Arts. 152 and 164). Full text republished by the Shanghai Municipal Development and Reform Commission. ",{"tag":"a","props":{"href":"https://fgw.sh.gov.cn/ys-syjf-zc-2.4.1-h5/20240408/073febdb2b04464390546232d4089f51.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://fgw.sh.gov.cn/ys-syjf-zc-2.4.1-h5/20240408/073febdb2b04464390546232d4089f51.html"]}]},"\n",{"tag":"li","props":{},"children":["State Council (2006). 诉讼费用交纳办法 (Measures on the Payment of Litigation Costs) (State Council Decree No. 481, Arts. 6 and 29). ",{"tag":"a","props":{"href":"https://www.gov.cn/ziliao/flfg/2006-12/29/content_483682.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/ziliao/flfg/2006-12/29/content_483682.htm"]}]},"\n",{"tag":"li","props":{},"children":["NPC Standing Committee (2025). 治安管理处罚法 (Public Security Administration Punishments Law) (2025 revision, effective January 1, 2026; Art. 26 item 1, Art. 50 item 5). ",{"tag":"a","props":{"href":"https://www.spp.gov.cn/spp/fl/202506/t20250627_699863.shtml","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.spp.gov.cn/spp/fl/202506/t20250627_699863.shtml"]}]},"\n",{"tag":"li","props":{},"children":["NPC Standing Committee (revised 2018). 刑事诉讼法 (Criminal Procedure Law) (Art. 111). Full text republished by the People's Procuratorate of the Ningxia Hui Autonomous Region. ",{"tag":"a","props":{"href":"https://www.nx.jcy.gov.cn/zwsy/qwfb/202011/t20201119_608817.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.nx.jcy.gov.cn/zwsy/qwfb/202011/t20201119_608817.html"]}]},"\n",{"tag":"li","props":{},"children":["Cyberspace Administration of China, Ministry of Public Security, Ministry of Culture and Tourism, National Radio and Television Administration (2024). 网络暴力信息治理规定 (Provisions on the Governance of Cyberbullying Information) (Arts. 15, 23, 25, 26; effective August 1, 2024). Gazette of the State Council. ",{"tag":"a","props":{"href":"https://www.gov.cn/gongbao/2024/issue_11526/202408/content_6969181.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/gongbao/2024/issue_1152