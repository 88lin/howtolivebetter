-ad-layout-toc"},"children":[{"tag":"div","props":{"className":"life-ad-rail","data-dock-active":"false","style":{"top":"94px"}},"children":[{"tag":"div","props":{"className":"life-ad-dock","hidden":true},"children":[{"tag":"aside","props":{"className":"life-ad-space life-ad-space-sponsored life-ad-space-compact","data-ad-placement":"ad_dock","data-ad-group":"reading","data-ad-creative":"read_product","data-ad-ready":"false","aria-label":"Advertisement · Community recommendation"},"children":[{"tag":"button","props":{"type":"button","className":"life-ad-dismiss","aria-label":"Close ad"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-x","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M18 6 6 18"},"children":[]},{"tag":"path","props":{"d":"m6 6 12 12"},"children":[]}]}]},{"tag":"div","props":{"className":"life-ad-space-brand"},"children":[{"tag":"img","props":{"src":"/sites/howtolivebetter/images/shengcai/logo.png","width":"565","height":"144","alt":"Official Shengcai Youshu logo","decoding":"async"},"children":[]}]},{"tag":"div","props":{"className":"life-ad-space-copy"},"children":[{"tag":"span","props":{"className":"life-ad-space-label"},"children":["Advertisement · Community recommendation"]},{"tag":"strong","props":{},"children":["Could what you know become a useful product?"]},{"tag":"p","props":{},"children":["From ebooks to small tools, explore how members spot needs and turn knowledge into something people can use."]}]},{"tag":"div","props":{"className":"life-ad-space-actions"},"children":[{"tag":"a","props":{"className":"life-ad-space-link","href":"/en/shengcaiyoushu?sc_group=reading&sc_creative=read_product&sc_placement=ad_dock"},"children":["Explore the community and examples",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"18","height":"18","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-up-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M7 7h10v10"},"children":[]},{"tag":"path","props":{"d":"M7 17 17 7"},"children":[]}]}]}]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/en/book/30"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"Back to index"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["Children after starting school"]},{"tag":"div","props":{"data-ad-dock-host":"true"},"children":[]},{"tag":"nav","props":{"aria-label":"Chapter entries"},"children":[{"tag":"a","props":{"href":"/en/tip/30-01"},"children":[{"tag":"span","props":{},"children":["01"]},"Child reports sudden, worsening pain — rush to the hospital right away; don’t let him wait until after school"]},{"tag":"a","props":{"href":"/en/tip/30-02"},"children":[{"tag":"span","props":{},"children":["02"]},"Don’t delay necessary treatment just to “wait until exams are over”; certain treatment windows depend on bone growth, not exam schedules"]},{"tag":"a","props":{"href":"/en/tip/30-03"},"children":[{"tag":"span","props":{},"children":["03"]},"When a child is bullied, report it to school the same day and request a written response; for physical assault, theft, or rumor spreading, call the police immediately"]},{"tag":"a","props":{"href":"/en/tip/30-04"},"children":[{"tag":"span","props":{},"children":["04"]},"Ensuring that children spend at least 2 hours outdoors each day is currently the only myopia‑prevention method backed by randomized trials"]},{"tag":"a","props":{"href":"/en/tip/30-05"},"children":[{"tag":"span","props":{},"children":["05"]},"No screen time for children aged 0–3; limit it as much as possible for ages 3–6; for school‑age kids, non‑educational screen use should not exceed one hour per day"]},{"tag":"a","props":{"href":"/en/tip/30-06"},"children":[{"tag":"span","props":{},"children":["06"]},"Treating myopia as a lasting injury: the higher the prescription, the greater the future risk of retinal detachment, macular degeneration, and glaucoma"]},{"tag":"a","props":{"href":"/en/tip/30-07"},"children":[{"tag":"span","props":{},"children":["07"]},"Take a close look at your child’s annual school health report and follow up on any abnormalities right away"]},{"tag":"a","props":{"href":"/en/tip/30-08"},"children":[{"tag":"span","props":{},"children":["08"]},"Conducting a depression screening for kids aged 12 to 18 — don’t rely on school mental health assessments as a diagnosis"]},{"tag":"a","props":{"href":"/en/tip/30-09"},"children":[{"tag":"span","props":{},"children":["09"]},"Do not buy products or services claiming to “cure myopia” or “reduce refractive error”"]},{"tag":"a","props":{"href":"/en/tip/30-10"},"children":[{"tag":"span","props":{},"children":["10"]},"Clear rules exist for sleep, homework, sports, and rankings; if schools fail to comply, parents can raise the issue"]},{"tag":"a","props":{"href":"/en/tip/30-11"},"children":[{"tag":"span","props":{},"children":["11"]},"Parents can request a temporary leave of absence for their child; the school must retain the child’s enrollment status for up to one year"]},{"tag":"a","props":{"href":"/en/tip/30-12"},"children":[{"tag":"span","props":{},"children":["12"]},"If poor vision is detected, go to the hospital for cycloplegic refraction and follow up at the recommended intervals as advised by the doctor"]},{"tag":"a","props":{"href":"/en/tip/30-13"},"children":[{"tag":"span","props":{},"children":["13"]},"Pit and fissure sealants applied after permanent molars emerge"]},{"tag":"a","props":{"href":"/en/tip/30-14"},"children":[{"tag":"span","props":{},"children":["14"]},"If your child loves playing games, first check if sleep, homework, and outdoor activities have been displaced, rather than just focusing on how long they have played"]},{"tag":"a","props":{"href":"/en/tip/30-15"},"children":[{"tag":"span","props":{},"children":["15"]},"When a child says they are attracted to the same sex: Do not scold, do not kick them out, and do not send them to \"conversion therapy\": The attitude at home is related to whether they will attempt suicide"]},{"tag":"a","props":{"href":"/en/tip/30-16"},"children":[{"tag":"span","props":{},"children":["16"]},"Do not hit your child, and do not yell or call them stupid: children who are often hit or verbally abused show more behavior and emotional problems"]},{"tag":"a","props":{"href":"/en/tip/30-17"},"children":[{"tag":"span","props":{},"children":["17"]},"If parenting feels out of control and you keep hitting or yelling, take a class that teaches concrete parenting skills"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/en/tip/30-18","data-status":"active"},"children":[{"tag":"span","props":{},"children":["18"]},"Do not send children to closed “internet addiction schools” or “special training camps”: harmful methods are prohibited by law, and children have died in confinement"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"Breadcrumb"},"children":[{"tag":"a","props":{"href":"/en/book"},"children":["Explore the book"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/en/book/30"},"children":["Chapter 30"," ·"," ","Children after starting school"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"30-18"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["18"]},{"tag":"span","props":{"className":"life-evidence grade-c"},"children":["Evidence"," ","C"]}]},{"tag":"h1","props":{"lang":"en"},"children":["Do not send children to closed “internet addiction schools” or “special training camps”: harmful methods are prohibited by law, and children have died in confinement"]},{"tag":"p","props":{"lang":"en","className":"life-entry-summary"},"children":["The law explicitly prohibits methods of treating internet addiction that harm children physically or psychologically. A special training school in Hefei handcuffed a newly admitted boy in an isolation room; he died about 44 hours later. Yuzhang Academy in Nanchang confined students in isolation, and several people in charge received criminal sentences. The court did not support parents’ requests for tuition compensation."]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Cost"]},{"tag":"p","props":{},"children":["No expense, and you save the tuition. The hard part is res…"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Benefit"]},{"tag":"p","props":{},"children":["Article 68 of the Law on the Protection of Minors prohibits any organization or individual from intervening in…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"Mark: Do not send children to closed “internet addiction schools” or “special training camps”: harmful methods are prohibited by law, and children have died in confinement"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"Done"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"Plan to do"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"Save"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Share this tip"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Hide details"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Cost"]},{"tag":"p","props":{},"children":["No expense, and you save the tuition. The hard part is resisting the urge to hand your child over to outsiders for “closed discipline” when their behavior is at its worst."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Benefit"]},{"tag":"p","props":{},"children":["Article 68 of the Law on the Protection of Minors prohibits any organization or individual from intervening in a minor’s internet addiction in a way that harms their physical or mental health. Both cases below have court decisions. The first was in Hefei, Anhui. In August 2017, an 18-year-old boy’s parents signed an agreement with a special training school to treat his internet addiction. School staff forcibly took him away, put him in an isolation room, and handcuffed both hands to the window bars. They restricted food, water, and rest and also beat him. About 44 hours later, he died. The forensic conclusion was death from fluid and electrolyte imbalance caused by heat, constrained posture, inadequate food and drink, and injuries. On October 31, 2018, the Hefei Intermediate People’s Court issued its first-instance judgment. The school head received 16 years for intentional injury and unlawful detention. Four instructors received 1 year to 8 years and 6 months. On December 28, 2018, the Anhui High People’s Court upheld the judgment on appeal. The appellate ruling stated that the school had no approval from the relevant authorities and none of the defendants had teaching qualifications. The second case was in Nanchang, Jiangxi. Yuzhang Academy opened in 2013 and deregistered and closed in November 2017. While operating, it placed some students in a “distress relief room” under guard for three to ten days at a time. On April 28, 2023, the Anyuan District People’s Court in Pingxiang announced a first-instance judgment after retrial: five defendants committed unlawful detention. Four received sentences from two years and ten months to eleven months and were barred from education-related occupations for specified periods; one was exempted from criminal punishment. The court did not support parents’ requests for tuition and round-trip travel compensation (nationwide / Anhui / Jiangxi)."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Original sources"]},{"tag":"p","props":{"className":"life-citations"},"children":["全国人大常委会 (2024 年修正). 未成年人保护法（第六十八条）. ",{"tag":"a","props":{"href":"https://flk.npc.gov.cn/detail?id=ff8081818f197cf001905e567af635a0","target":"_blank","rel":"noopener noreferrer"},"children":["https://flk.npc.gov.cn/detail?id=ff8081818f197cf001905e567af635a0"]},"；红星新闻 (2019-02-20). 追热点·18岁少年被铐着关禁闭两天死亡，戒网瘾学校5人获刑. ",{"tag":"a","props":{"href":"https://static.cdsb.com/micropub/Articles/201902/5b98283216ea5d2e8eef7f8cb7d4dbbb.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://static.cdsb.com/micropub/Articles/201902/5b98283216ea5d2e8eef7f8cb7d4dbbb.html"]},"（网页存档 ",{"tag":"a","props":{"href":"https://web.archive.org/web/20261005013030/https://static.cdsb.com/micropub/Articles/201902/5b98283216ea5d2e8eef7f8cb7d4dbbb.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://web.archive.org/web/20261005013030/https://static.cdsb.com/micropub/Articles/201902/5b98283216ea5d2e8eef7f8cb7d4dbbb.html"]},"）；新华社 (2023-04-28). 江西“豫章书院案”宣判 5名被告均服判不上诉. ",{"tag":"a","props":{"href":"http://www.news.cn/2023-04/28/c_1129579126.htm","target":"_blank","rel":"noopener noreferrer"},"children":["http://www.news.cn/2023-04/28/c_1129579126.htm"]},"（网页存档 ",{"tag":"a","props":{"href":"http://web.archive.org/web/20230428212544/http://www.news.cn/2023-04/28/c_1129579126.htm","target":"_blank","rel":"noopener noreferrer"},"children":["http://web.archive.org/web/20230428212544/http://www.news.cn/2023-04/28/c_1129579126.htm"]},"）"]},{"tag":"a","props":{"href":"https://flk.npc.gov.cn/detail?id=ff8081818f197cf001905e567af635a0","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Open source link"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H