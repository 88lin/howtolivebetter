ag":"span","props":{},"children":["04"]},"Trẻ dưới 2 tuổi bị cảm cúm, đừng tự cho uống thuốc cảm cúm phối hợp và thuốc ho"]},{"tag":"a","props":{"href":"/vi/tip/34-05"},"children":[{"tag":"span","props":{},"children":["05"]},"Sau tuần thứ 20 của thai kỳ, đừng tự uống thuốc giảm đau như ibuprofen"]},{"tag":"a","props":{"href":"/vi/tip/34-06"},"children":[{"tag":"span","props":{},"children":["06"]},"Trào ngược và ợ nóng thì tự mua omeprazole, uống tối đa 7 ngày; khó nuốt, nôn ra máu, phân đen thì đi thẳng bệnh viện"]},{"tag":"a","props":{"href":"/vi/tip/34-07"},"children":[{"tag":"span","props":{},"children":["07"]},"Cảm cúm thường đừng xin bác sĩ kê kháng sinh"]},{"tag":"a","props":{"href":"/vi/tip/34-08"},"children":[{"tag":"span","props":{},"children":["08"]},"Tiêu chảy thì uống dung dịch bù nước đường uống trước, trẻ dưới 5 tuổi không cho thuốc cầm tiêu chảy"]},{"tag":"a","props":{"href":"/vi/tip/34-09"},"children":[{"tag":"span","props":{},"children":["09"]},"Thuốc giảm đau trong một tháng đừng uống quá 15 ngày, thuốc giảm đau phối hợp đừng quá 10 ngày, nếu không đau đầu có thể do thuốc"]},{"tag":"a","props":{"href":"/vi/tip/34-10"},"children":[{"tag":"span","props":{},"children":["10"]},"Định kỳ dọn thuốc hết hạn và thuốc thừa không dùng tới, bỏ cả vỏ vào thùng rác chất độc, đừng để trong nhà"]},{"tag":"a","props":{"href":"/vi/tip/34-11"},"children":[{"tag":"span","props":{},"children":["11"]},"Khi uống kháng sinh nhóm cephalosporin, metronidazole, trong lúc uống và 7 ngày sau khi ngừng thì không uống rượu; thuốc có cồn như nước Hoa Hương Chính Khí, siro ho vẫn cũng không uống"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"Breadcrumbs"},"children":[{"tag":"a","props":{"href":"/vi/book"},"children":["Khám phá cuốn sách"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/vi/book/34"},"children":["Chương 34"," ·"," ","Đừng dùng thuốc trong nhà sai cách"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"34-01"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["01"]},{"tag":"span","props":{"className":"life-evidence grade-b"},"children":["Bằng chứng"," ","B"]}]},{"tag":"h1","props":{"lang":"vi"},"children":["Trước khi uống hai loại thuốc cảm cúm hoặc giảm đau cùng lúc, hãy xem bảng thành phần, paracetamol chỉ được chiếm một chỗ"]},{"tag":"p","props":{"lang":"vi","className":"life-entry-summary"},"children":["Nhiều thuốc cảm cúm có trộn paracetamol. Uống hai hộp cùng lúc tức là uống gấp đôi, quá liều thì hỏng gan. Ở Hoa Kỳ, trong số người bị suy gan cấp do paracetamol, gần ba phần mười chết trước khi kịp ghép gan. Hướng dẫn trong nước khuyên mỗi ngày tối đa 2 g, và trong lúc uống thuốc đừng uống rượu."]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Chi phí"]},{"tag":"p","props":{},"children":["Không tốn tiền. Nhìn bảng thành phần của từng hộp thuốc mộ…"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Lợi ích"]},{"tag":"p","props":{},"children":["Mỹ có 22 bệnh viện ghi nhận liên tục trong 6 năm 662 ca suy gan cấp. Trong đó 275 ca (42%) do paracetamol, liề…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"Đánh dấu: Trước khi uống hai loại thuốc cảm cúm hoặc giảm đau cùng lúc, hãy xem bảng thành phần, paracetamol chỉ được chiếm một chỗ"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"Hoàn tất"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"Kế hoạch thực hiện"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"Lưu"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Chia sẻ mẹo này"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Ẩn chi tiết"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Chi phí"]},{"tag":"p","props":{},"children":["Không tốn tiền. Nhìn bảng thành phần của từng hộp thuốc một lượt, một hai phút."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Lợi ích"]},{"tag":"p","props":{},"children":["Mỹ có 22 bệnh viện ghi nhận liên tục trong 6 năm 662 ca suy gan cấp. Trong đó 275 ca (42%) do paracetamol, liều đã nuốt có trung vị 24 g. Trong 275 người đó, 131 người (48%) uống quá liều do không cẩn thận, không phải cố ý. Trong nhóm uống quá liều do không cẩn thận, 38% uống đồng thời hai loại thuốc trở lên có chứa thành phần này. Trong 275 người đó, 27% chết trước khi kịp ghép gan, 8% được ghép gan. Năm 2020 Cục Quản lý Dược phẩm Quốc gia yêu cầu hướng dẫn thuốc không kê đơn phải ghi rõ: dùng quá liều gây tổn thương gan nặng, liều tối đa mỗi ngày không nên vượt quá 2 g. Hướng dẫn còn phải ghi, nên tránh dùng chung với thuốc có paracetamol hoặc thuốc giảm đau hạ nhiệt khác. Quy định Mỹ yêu cầu loại thuốc không kê đơn này ghi ở cảnh báo thứ nhất ba tình huống gây hại gan: vượt quá liều tối đa trong một ngày, uống chung với thuốc khác có paracetamol, và uống từ 3 ly rượu trở lên mỗi ngày trong lúc dùng thuốc."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Nguồn gốc"]},{"tag":"p","props":{"className":"life-citations"},"children":["Larson AM, Polson J, Fontana RJ, et al.; Acute Liver Failure Study Group (2005). Acetaminophen-induced acute liver failure: results of a United States multicenter, prospective study. Hepatology, 42(6):1364-1372. ",{"tag":"a","props":{"href":"https://doi.org/10.1002/hep.20948","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1002/hep.20948"]},"；国家药监局关于修订对乙酰氨基酚常释及缓释制剂说明书的公告（2020年第15号）及附件2《对乙酰氨基酚常释制剂非处方药说明书修订要求》（湖南省药品监督管理局转载）. ",{"tag":"a","props":{"href":"http://mpa.hunan.gov.cn/mpa/xxgk/tzgg/wjtz/202003/t20200311_11809335.html","target":"_blank","rel":"noopener noreferrer"},"children":["http://mpa.hunan.gov.cn/mpa/xxgk/tzgg/wjtz/202003/t20200311_11809335.html"]},"；21 CFR 201.326(a)(1)(iii)(A) Liver warning. ",{"tag":"a","props":{"href":"https://www.ecfr.gov/current/title-21/chapter-I/subchapter-C/part-201/subpart-G/section-201.326","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.ecfr.gov/current/title-21/chapter-I/subchapter-C/part-201/subpart-G/section-201.326"]}]},{"tag":"a","props":{"href":"https://doi.org/10.1002/hep.20948","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Liên kết mở nguồn"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","cla