/ja/book/07"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"目次に戻る"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["お金がない時をどう生き抜くか"]},{"tag":"div","props":{"data-ad-dock-host":"true"},"children":[]},{"tag":"nav","props":{"aria-label":"この章のヒント"},"children":[{"tag":"a","props":{"href":"/ja/tip/07-01"},"children":[{"tag":"span","props":{},"children":["01"]},"失業した際は、まずオンラインで失業保険金の申請を"]},{"tag":"a","props":{"href":"/ja/tip/07-02"},"children":[{"tag":"span","props":{},"children":["02"]},"賃金未払いの場合は、まず労働監察へ通報、次に労働仲裁を申請。どちらのルートも費用は無料で、多くの案件は数ヶ月以内に結果が出ます"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/ja/tip/07-03","data-status":"active"},"children":[{"tag":"span","props":{},"children":["03"]},"訴訟費用が払えない場合は法律扶助を申請。賃金請求、扶養料、労災などの案件は、もともと対象範囲に含まれています"]},{"tag":"a","props":{"href":"/ja/tip/07-04"},"children":[{"tag":"span","props":{},"children":["04"]},"行き場を失った時は救助施設へ。食事・宿泊・帰路のチケットを支給"]},{"tag":"a","props":{"href":"/ja/tip/07-05"},"children":[{"tag":"span","props":{},"children":["05"]},"仕事探しはまず無料の公共雇用サービスやギグワーク市場を利用。有料の仲介業者は避ける"]},{"tag":"a","props":{"href":"/ja/tip/07-06"},"children":[{"tag":"span","props":{},"children":["06"]},"不測の事態には、まず臨時救助を申請"]},{"tag":"a","props":{"href":"/ja/tip/07-07"},"children":[{"tag":"span","props":{},"children":["07"]},"収入が地域の最低生活保障基準を下回る場合は、低保（最低生活保障）を申請する"]},{"tag":"a","props":{"href":"/ja/tip/07-08"},"children":[{"tag":"span","props":{},"children":["08"]},"障害者手帳を所持している方は、障害者向け2つの補助金を申請する"]},{"tag":"a","props":{"href":"/ja/tip/07-09"},"children":[{"tag":"span","props":{},"children":["09"]},"住民医療保険の年間 400 元の支払いを中断させないこと。困難世帯は免除・減額が可能"]},{"tag":"a","props":{"href":"/ja/tip/07-10"},"children":[{"tag":"span","props":{},"children":["10"]},"重病になったら、まず医療保険、大病保険、医療扶助、そして他地域での受診登録を行い、ネットローンには手を出さないこと"]},{"tag":"a","props":{"href":"/ja/tip/07-11"},"children":[{"tag":"span","props":{},"children":["11"]},"身分証を紛失したらすぐに再発行手続きを、急ぎの場合は臨時身分証を先に受け取る"]},{"tag":"a","props":{"href":"/ja/tip/07-12"},"children":[{"tag":"span","props":{},"children":["12"]},"失業登録後、就労困難者認定を目指し、社会保険補助金または公益的雇用枠を獲得する"]},{"tag":"a","props":{"href":"/ja/tip/07-13"},"children":[{"tag":"span","props":{},"children":["13"]},"失業期間に職業訓練手当、就業インターン手当、社会保険補助を申請しましょう。自費で講習に通わないでください"]},{"tag":"a","props":{"href":"/ja/tip/07-14"},"children":[{"tag":"span","props":{},"children":["14"]},"就職活動は履歴書を送るだけでは不十分です。システム的な方法を使いましょう：スキルを学び、目標を定め、周囲の助けを借りる"]},{"tag":"a","props":{"href":"/ja/tip/07-15"},"children":[{"tag":"span","props":{},"children":["15"]},"保証金を取られない、身分証を預けない、「訓練ローン」に手を出さない、マルチ商法に入らない、高利貸しから借りない"]},{"tag":"a","props":{"href":"/ja/tip/07-16"},"children":[{"tag":"span","props":{},"children":["16"]},"住居に困っているなら、公営賃貸住宅（公租房）の優先枠を"]},{"tag":"a","props":{"href":"/ja/tip/07-17"},"children":[{"tag":"span","props":{},"children":["17"]},"住居費と食費を最小限に抑える：シェアハウスの月極利用で日極利用を代替、自炊と食堂利用でデリバリーを代替"]},{"tag":"a","props":{"href":"/ja/tip/07-18"},"children":[{"tag":"span","props":{},"children":["18"]},"社会保険の未加入（断缴）に慌てない：年金は累計で計算、医療保険はルールに従って追加入金"]},{"tag":"a","props":{"href":"/ja/tip/07-19"},"children":[{"tag":"span","props":{},"children":["19"]},"服役、破産、信用ブラックリストへの登録など、法律上はやり直す道があります。まずは手続きを完了させましょう"]},{"tag":"a","props":{"href":"/ja/tip/07-20"},"children":[{"tag":"span","props":{},"children":["20"]},"重病に備え、基本医療保険に加えて1年更新の医療保険または重大疾病保険を検討する際は、「継続保証」の4文字を必ず確認すること"]},{"tag":"a","props":{"href":"/ja/tip/07-21"},"children":[{"tag":"span","props":{},"children":["21"]},"本当に寝る場所がない場合、24 時間だけ利用できる場所はあくまで緊急避難用です。まずは救助所を優先してください"]},{"tag":"a","props":{"href":"/ja/tip/07-22"},"children":[{"tag":"span","props":{},"children":["22"]},"賃金未払いの際は、まず雇い主が誰かを確認すること：無免許の作業場や請負業者（工頭）に対しても労働監察を請求可能、家庭や個人向けの私的な仕事の場合のみ裁判所へ"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"現在地"},"children":[{"tag":"a","props":{"href":"/ja/book"},"children":["本を読む"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/ja/book/07"},"children":["第7章"," ·"," ","お金がない時をどう生き抜くか"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"07-03"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["03"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["エビデンス"," ","A"]}]},{"tag":"h1","props":{"lang":"ja"},"children":["訴訟費用が払えない場合は法律扶助を申請。賃金請求、扶養料、労災などの案件は、もともと対象範囲に含まれています"]},{"tag":"p","props":{"lang":"ja","className":"life-entry-summary"},"children":["賃金請求、扶養料請求、社会保険や低保（最低生活保障）の受給、正義感による行動（見義勇為）に伴う損失など、すべて無料で法律扶助を申請できます。12348 に連絡するか、現地の法律扶助センターへ行ってください。現在は、旧住所に戻って経済的困難の証明書を取得する必要はなく、本人が事実を説明するだけで済みます。死刑判決の可能性がある場合、および盲、聾、唖、および未成年の被告人については、一律に弁護人が指名されます。"]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["費用・手間"]},{"tag":"p","props":{},"children":["費用はかかりません。法律扶助は、援助を受ける人から一銭も徴収しません。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["効果"]},{"tag":"p","props":{},"children":["国務院の条例には、民事法律扶助が対象とする6つの類が明記されています。条例の原文は以下の通りです：「法律に基づき国家賠償を請求するもの、社会保険または最低生活保障の待遇を請求するもの、弔慰金、救済金の支給を請求するもの、…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"記録する：訴訟費用が払えない場合は法律扶助を申請。賃金請求、扶養料、労災などの案件は、もともと対象範囲に含まれています"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strok