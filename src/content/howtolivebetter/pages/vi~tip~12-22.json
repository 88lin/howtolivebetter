":"div","props":{"className":"life-ad-rail","data-dock-active":"false","style":{"top":"94px"}},"children":[{"tag":"div","props":{"className":"life-ad-dock","hidden":true},"children":[{"tag":"aside","props":{"className":"life-ad-space life-ad-space-sponsored life-ad-space-compact","data-ad-placement":"ad_dock","data-ad-group":"reading","data-ad-creative":"read_product","data-ad-ready":"false","aria-label":"Quảng cáo · Giới thiệu cộng đồng"},"children":[{"tag":"button","props":{"type":"button","className":"life-ad-dismiss","aria-label":"Đóng quảng cáo"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-x","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M18 6 6 18"},"children":[]},{"tag":"path","props":{"d":"m6 6 12 12"},"children":[]}]}]},{"tag":"div","props":{"className":"life-ad-space-brand"},"children":[{"tag":"img","props":{"src":"/sites/howtolivebetter/images/shengcai/logo.png","width":"565","height":"144","alt":"Logo chính thức của Shengcai Youshu","decoding":"async"},"children":[]}]},{"tag":"div","props":{"className":"life-ad-space-copy"},"children":[{"tag":"span","props":{"className":"life-ad-space-label"},"children":["Quảng cáo · Giới thiệu cộng đồng"]},{"tag":"strong","props":{},"children":["Kiến thức bạn có thể thành sản phẩm hữu ích không?"]},{"tag":"p","props":{},"children":["Từ sách điện tử đến công cụ nhỏ: xem cách thành viên tìm nhu cầu và biến kiến thức thành thứ dùng được."]}]},{"tag":"div","props":{"className":"life-ad-space-actions"},"children":[{"tag":"a","props":{"className":"life-ad-space-link","href":"/vi/shengcaiyoushu?sc_group=reading&sc_creative=read_product&sc_placement=ad_dock"},"children":["Xem cộng đồng và các ví dụ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"18","height":"18","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-up-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M7 7h10v10"},"children":[]},{"tag":"path","props":{"d":"M7 17 17 7"},"children":[]}]}]}]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/vi/book/12"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"Quay lại mục lục"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["Khởi nghiệp: đừng làm mất khoản tiết kiệm của gia đình"]},{"tag":"div","props":{"data-ad-dock-host":"true"},"children":[]},{"tag":"nav","props":{"aria-label":"Các mục trong chương"},"children":[{"tag":"a","props":{"href":"/vi/tip/12-01"},"children":[{"tag":"span","props":{},"children":["01"]},"Chỉ dùng số tiền mà lỡ mất trắng vẫn chịu được để khởi nghiệp, không đụng vốn của cả nhà, không vay tiền để mở hàng"]},{"tag":"a","props":{"href":"/vi/tip/12-02"},"children":[{"tag":"span","props":{},"children":["02"]},"Đừng ký bảo đảm cá nhân cho khoản vay của công ty, người phối ngẫu càng đừng ký theo"]},{"tag":"a","props":{"href":"/vi/tip/12-03"},"children":[{"tag":"span","props":{},"children":["03"]},"Chọn đúng loại hình kinh doanh trước khi mở hàng: hộ cá thể và cổ phần công chung phải trả đến cùng, chỉ công ty hữu hạn mới「hữu hạn」"]},{"tag":"a","props":{"href":"/vi/tip/12-04"},"children":[{"tag":"span","props":{},"children":["04"]},"Đừng làm cổ phân danh nghĩa, đừng giữ cổ phần thay người khác"]},{"tag":"a","props":{"href":"/vi/tip/12-05"},"children":[{"tag":"span","props":{},"children":["05"]},"Trước khi nhượng quyền, kiểm tra hồ sơ đăng ký ở Bộ Thương mại, lấy bản công bố bằng văn bản, ghi「thời gian cân nhắc」vào hợp đồng"]},{"tag":"a","props":{"href":"/vi/tip/12-06"},"children":[{"tag":"span","props":{},"children":["06"]},"Trước khi đăng ký, chốt tên, địa điểm kinh doanh, phạm vi kinh doanh và vốn đăng ký, đủ hồ sơ thì lấy được giấy phép ngay tại chỗ"]},{"tag":"a","props":{"href":"/vi/tip/12-07"},"children":[{"tag":"span","props":{},"children":["07"]},"Ngành cần giấy phép thì chưa có giấy thì không khai trương"]},{"tag":"a","props":{"href":"/vi/tip/12-08"},"children":[{"tag":"span","props":{},"children":["08"]},"Làm thực phẩm thì xem trước mình ở bậc nào: sản xuất và ăn uống phải có giấy phép, chỉ bán đóng gói sẵn thì kê khai, bán thịt rau tươi không cần giấy"]},{"tag":"a","props":{"href":"/vi/tip/12-09"},"children":[{"tag":"span","props":{},"children":["09"]},"Đóng túi để bán thì là thực phẩm đóng gói sẵn: trên nhãn, ngày sản xuất, hạn sử dụng, bảng thành phần thiếu mục nào cũng không được"]},{"tag":"a","props":{"href":"/vi/tip/12-10"},"children":[{"tag":"span","props":{},"children":["10"]},"Thực phẩm thường không được nói là chữa bệnh: nhãn, hướng dẫn, quảng cáo và lời livestream đều tính"]},{"tag":"a","props":{"href":"/vi/tip/12-11"},"children":[{"tag":"span","props":{},"children":["11"]},"Ngành thực phẩm có đường ranh giới hình sự: bán thịt chết bệnh, hàng vượt tiêu chuẩn là đủ thành tội, trộn thêm nguyên liệu độc hại thì không tính tiền, khởi tội năm năm"]},{"tag":"a","props":{"href":"/vi/tip/12-12"},"children":[{"tag":"span","props":{},"children":["12"]},"Có giấy phép là bắt đầu có nghĩa vụ kê khai, không có doanh thu vẫn phải kê khai đúng hạn (nộp một tờ toàn số không)"]},{"tag":"a","props":{"href":"/vi/tip/12-13"},"children":[{"tag":"span","props":{},"children":["13"]},"Hoá đơn chỉ xuất theo giao dịch thật, người nộp thuế quy mô nhỏ hãy dùng hết ngưỡng miễn thuế"]},{"tag":"a","props":{"href":"/vi/tip/12-14"},"children":[{"tag":"span","props":{},"children":["14"]},"Ai tự xưng cơ quan thuế đòi bạn nộp tiền khai thuế đều là lừa đảo, làm thủ tục thuế chỉ đi qua cổng thuế điện tử và 12366"]},{"tag":"a","props":{"href":"/vi/tip/12-15"},"children":[{"tag":"span","props":{},"children":["15"]},"Nhận tiền thì viết「定金」chứ đừng viết「订金」, tiền phạt vi phạm phải ghi rõ con số, hạn thanh toán thì soi như cho vay"]},{"tag":"a","props":{"href":"/vi/tip/12-16"},"children":[{"tag":"span","props":{},"children":["16"]},"Người lao động tháng đầu phải ký hợp đồng bằng văn bản, 30 ngày đăng ký bảo hiểm xã hội"]},{"tag":"a","props":{"href":"/vi/tip/12-17"},"children":[{"tag":"span","props":{},"children":["17"]},"Lương trả theo hợp đồng và theo pháp luật, tăng lương, cho vay, thưởng đều phải qua văn bản"]},{"tag":"a","props":{"href":"/vi/tip/12-18"},"children":[{"tag":"span","props":{},"children":["18"]},"Bán trước rồi mới sản xuất: dùng bán trước và đơn nhỏ để kiểm chứng có người mua, rồi mới bỏ tiền vào sản xuất"]},{"tag":"a","props":{"href":"/vi/tip/12-19"},"children":[{"tag":"span","props":{},"children":["19"]},"Làm xong mẫu thì so qua danh sách sản xuất hàng loạt, rồi hãy nói chuyện khoảng sản xuất"]},{"tag":"a","props":{"href":"/vi/tip/12-20"},"children":[{"tag":"span","props":{},"children":["20"]},"Mỗi lô hàng nhập về để lại một bộ hoá đơn và thông tin nhà cung cấp, giá nhập thấp hơn hẳn giá thị trường thì không nhập: hàng giả do nhân viên mua, người bị kết án là chủ"]},{"tag":"a","props":{"href":"/vi/tip/12-21"},"children":[{"tag":"span","props":{},"children":["21"]},"Hình ảnh trên hàng, bao bì, treo thẻ và ảnh quảng cáo thì tự làm hoặc mua giấy uỷ quyền, đổi màu, thêm biểu tượng không tính là「đã sửa」"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/vi/tip/12-22","data-status":"active"},"children":[{"tag":"span","props":{},"children":["22"]},"Ở đúng vị trí thì làm theo quy trình, còn cái thiện ý ngoài quy trình thì nghĩ kỹ trách nhiệm thuộc về ai"]},{"tag":"a","props":{"href":"/vi/tip/12-23"},"children":[{"tag":"span","props":{},"children":["23"]},"Lỗ thì rút lui theo thủ tục: huỷ được kiểu rút gọn thì huỷ, vỡ nợ thì đi phá sản, đừng để yên"]},{"tag":"a","props":{"href":"/vi/tip/12-24"},"children":[{"tag":"span","props":{},"children":["24"]},"Trước khi chi tiền thuê người khác quản lý cửa hàng trực tuyến, tham gia khóa đào tạo mở cửa hàng, hoặc thực hiện mô hình 'không nguồn hàng', hãy hỏi rõ liệu sau này có phải trả thêm tiền hay không, và nguồn doanh số sẽ đến từ đâu"]},{"tag":"a","props":{"href":"/vi/tip/12-25"},"children":[{"tag":"span","props":{},"children":["25"]},"Mở công ty hoặc hộ cá thể ở Trung Quốc: từ 1 tháng 1 đến 30 tháng 6 nộp báo cáo năm trước qua mạng, không kinh doanh cũng phải nộp, không mất phí"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"Breadcrumbs"},"children":[{"tag":"a","props":{"href":"/vi/book"},"children":["Khám phá cuốn sách"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/vi/book/12"},"children":["Chương 12"," ·"," ","Khởi nghiệp: đừng làm mất khoản tiết kiệm của gia đình"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"12-22"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["22"]},{"tag":"span","props":{"className":"life-evidence grade-b"},"children":["Bằng chứng"," ","B"]}]},{"tag":"h1","props":{"lang":"vi"},"children":["Ở đúng vị trí thì làm theo quy trình, còn cái thiện ý ngoài quy trình thì nghĩ kỹ trách nhiệm thuộc về ai"]},{"tag":"p","props":{"lang":"vi","className":"life-entry-summary"},"children":["Lấy y tá làm ví dụ: quy định ghi rõ, phát hiện bệnh nhân lâm nguy thì phải báo bác sĩ ngay; phát hiện chỉ định điều trị vi phạm quy định thì phải nêu với bác sĩ đã kê đơn. Các vị trí khác cũng vậy, trước hết phải xem quy trình của mình đánh dấu「phải báo cáo」ở đâu. Pháp luật cũng không bắt phải nhìn người sắp chết mà không cứu: tự nguyện ra cứu gấp mà làm người được cứu bị thương thì không phải bồi thường tiền."]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Chi phí"]},{"tag":"p","props":{},"children":["Không tốn tiền. Khi làm việc thì theo quy định, theo chỉ đ…"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Lợi ích"]},{"tag":"p","props":{},"children":["Lấy y tá làm ví dụ, quy định ghi rõ ranh giới công vụ như sau. Phát hiện tình hình bệnh lâm nguy thì báo bác s…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"Đánh dấu: Ở đúng vị trí thì làm theo quy trình, còn cái thiện ý ngoài quy trình thì nghĩ kỹ trách nhiệm thuộc về ai"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"Hoàn tất"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"Kế hoạch thực hiện"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"Lưu"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Chia sẻ mẹo này"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Ẩn chi tiết"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Chi phí"]},{"tag":"p","props":{},"children":["Không tốn tiền. Khi làm việc thì theo quy định, theo chỉ định của bác sĩ, theo quy trình. Không thay người khác quyết định việc vượt ngoài thẩm quyền của mình. Trước khi giúp, tự hỏi một câu: có chuyện thì ai chịu trách nhiệm. Khó ở chỗ phải từ chối tận thời lời「linh động một chút»."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Lợi ích"]},{"tag":"p","props":{},"children":["Lấy y tá làm ví dụ, quy định ghi rõ ranh giới công vụ như sau. Phát hiện tình hình bệnh lâm nguy thì báo bác sĩ ngay. Trong tình huống khẩn cấp để cứu bệnh nhân nguy kịch, có thể thực hiện trước các biện pháp cấp cứu cần thiết. Phát hiện chỉ định điều trị vi phạm pháp luật, hoặc vi phạm quy chuẩn kỹ thuật khám chữa bệnh thì phải nêu với bác sĩ, cần thì báo trưởng khoa. Bộ luật Dân sự có quy định khác: tự nguyện ra cứu gấp mà làm người được cứu bị thương thì bên cứu không phải bồi thường tiền (không chịu trách nhiệm dân sự) (toàn quốc)"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Nguồn gốc"]},{"tag":"p","props":{"className":"life-citations"},"children":["国务院 (2008). 护士条例（国务院令第 517 号，第十七条）. ",{"tag":"a","props":{"href":"http://www.gov.cn/zhengce/zhengceku/2008-03/28/content_6169.htm","target":"_blank","rel":"noopener noreferrer"},"children":["http://www.gov.cn/zhengce/zhengceku/2008-03/28/content_6169.htm"]},"；国务院 (2020). 护士条例（2020 年修订，第十七条）. ",{"tag":"a","props":{"href":"https://flk.npc.gov.cn/detail?id=ff808081777d07c50177b8ed29bf3950","target":"_blank","rel":"noopener noreferrer"},"children":["https://flk.npc.gov.cn/detail?id=ff808081777d07c50177b8ed29bf3950"]},"（国家法律法规数据库）；全国人大 (2020). 民法典（第一百八十四条）. ",{"tag":"a","props":{"href":"https://www.spp.gov.cn/spp/fl/202006/t20200602_463888.shtml","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.spp.gov.cn/spp/fl/202006/t20200602_463888.shtml"]}]},{"tag":"a","props":{"href":"http://www.gov.cn/zhengce/zhengceku/2008-03/28/content_6169.htm","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Liên kết mở nguồn"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Ghi chú sách"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["Trong phạm vi công vụ thì làm theo quy trình, cứu người trong tình huống khẩn cấp được pháp luật bảo vệ. Còn những việc khác, trước hết phải phân định đó là quyền của ai, trách nhiệm của ai, đừng dùng thiện ý riêng của mình thay cho quyết định mang tính quy trình. Quy định về y tá năm 2020 được sửa đổi bằng Quy định của Quốc vụ viện số 726, chỉ sửa mấy điều về đăng ký, Điều 17 không đổi một chữ. Các điều về việc hành nghề theo quy chuẩn khám chữa bệnh trong Luật Y khoa, lần này không mở được nguyên văn chính thức nên không dẫn."]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Ghi chú của tôi"]},{"tag":"button","props":{"type":"button"},"children":["Viết một lời nhắc cho chính bạn…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/vi/tip/12-21"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Trước"]},"Hình ảnh trên hàng, bao bì, treo thẻ và ảnh quảng cáo thì tự làm hoặc mua giấy uỷ quyền, đổi màu, thêm biểu tượng không tính là「đã sửa」"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/vi/tip/12-23"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Tiếp theo"]},"Lỗ thì rút lui theo thủ tục: huỷ được kiểu rút gọn thì huỷ, vỡ nợ thì đi phá sản, đừng để yên"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["Thêm trong chủ đề này"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a",