"props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},{"tag":"span","props":{},"children":["ログイン"]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/ja/book/23"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"目次に戻る"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["何のスキルを学ぶのが最も効率的か"]},{"tag":"nav","props":{"aria-label":"この章のヒント"},"children":[{"tag":"a","props":{"href":"/ja/tip/23-01"},"children":[{"tag":"span","props":{},"children":["01"]},"16歳未満には「働く」という選択肢はない：採用した企業は毎月5000元の罰金、採用してくれるのはすべて闇労働"]},{"tag":"a","props":{"href":"/ja/tip/23-02"},"children":[{"tag":"span","props":{},"children":["02"]},"「読書に意味があるか」も死亡率の計算に含める：教育年数が1年増えるごとに、成人の死亡リスクは約 1.9% 低下する"]},{"tag":"a","props":{"href":"/ja/tip/23-03"},"children":[{"tag":"span","props":{},"children":["03"]},"「学歴の価値が下がったのか」を判断する前に、まず全国の学歴構成を見る：10万人につき短大・大学以上の学歴を持つ人は15467人（2020年国勢調査。2025年の標本調査による推計では約19%）"]},{"tag":"a","props":{"href":"/ja/tip/23-04"},"children":[{"tag":"span","props":{},"children":["04"]},"「学費が払えない」はまず政策に照らして計算してみる：中等職業学校の学費は多くが免除済み、助学金は 2300 元、奨学金は年間最大 2 万"]},{"tag":"a","props":{"href":"/ja/tip/23-05"},"children":[{"tag":"span","props":{},"children":["05"]},"普通高校に入学できなかったからといって道が断たれたわけではない：中等職業教育には接続型入試や単独試験があり、技能職の採用では学歴要件が緩和されることもある"]},{"tag":"a","props":{"href":"/ja/tip/23-06"},"children":[{"tag":"span","props":{},"children":["06"]},"「進学か就職か」を一つの計算問題として考える：先に働いて早めに得る3年分の給与と、進学によって得られるその後数十年にわたる年収差の比較"]},{"tag":"a","props":{"href":"/ja/tip/23-07"},"children":[{"tag":"span","props":{},"children":["07"]},"まずは基準となる数値（ベースライン）を覚えておきましょう：教育期間が1年増えることによる、世界平均の私的収益（個人の所得に反映される部分）は、年間約 9% です"]},{"tag":"a","props":{"href":"/ja/tip/23-08"},"children":[{"tag":"span","props":{},"children":["08"]},"資格取得にお金を使う前に、その資格が国家職業資格目録または人社部（人材資源社会保障部）の備案済み評価機関リストに含まれているか確認しましょう"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/ja/tip/23-09","data-status":"active"},"children":[{"tag":"span","props":{},"children":["09"]},"研修はまず政府の補助金制度を優先。いきなり自費で民間講座に申し込まないこと"]},{"tag":"a","props":{"href":"/ja/tip/23-10"},"children":[{"tag":"span","props":{},"children":["10"]},"スキルを選ぶ際は「現場での作業や判断が必要か」を優先的に見る。こうした仕事は自動化に置き換えられにくい"]},{"tag":"a","props":{"href":"/ja/tip/23-11"},"children":[{"tag":"span","props":{},"children":["11"]},"学ぶ前に、このスキルに等級評価があるか、等級が給与に反映されるかを確認してください"]},{"tag":"a","props":{"href":"/ja/tip/23-12"},"children":[{"tag":"span","props":{},"children":["12"]},"「ネットで給料が高いと言われている」を人手不足の証拠にしないで。現地の不足職種リストと補助金リストを確認しましょう"]},{"tag":"a","props":{"href":"/ja/tip/23-13"},"children":[{"tag":"span","props":{},"children":["13"]},"同じ費用と時間なら、即戦力になれる短期プロジェクトを優先する"]},{"tag":"a","props":{"href":"/ja/tip/23-14"},"children":[{"tag":"span","props":{},"children":["14"]},"学んだらまず本を閉じ、自力でテストする。読み直してはいけない"]},{"tag":"a","props":{"href":"/ja/tip/23-15"},"children":[{"tag":"span","props":{},"children":["15"]},"同じ時間を数日に分散させる。一度に終わらせようとしない"]},{"tag":"a","props":{"href":"/ja/tip/23-16"},"children":[{"tag":"span","props":{},"children":["16"]},"「重要箇所への線引き」「反復読解」「要約作成」を主要な学習法と勘違いしないこと"]},{"tag":"a","props":{"href":"/ja/tip/23-17"},"children":[{"tag":"span","props":{},"children":["17"]},"数種類の問題形式を混ぜて練習しよう。一種を20問連続で解くのは避けること"]},{"tag":"a","props":{"href":"/ja/tip/23-18"},"children":[{"tag":"span","props":{},"children":["18"]},"「自分は視覚型、彼は聴覚型」という学習スタイルの選び方はやめましょう"]},{"tag":"a","props":{"href":"/ja/tip/23-19"},"children":[{"tag":"span","props":{},"children":["19"]},"暗記すべき内容は、将来の使い方を想定して自分に問題を出してテストすること。単に丸暗記して終わりにしてはいけない"]},{"tag":"a","props":{"href":"/ja/tip/23-20"},"children":[{"tag":"span","props":{},"children":["20"]},"职称（職能資格）の申請は、まず自分がどのシリーズ、どの級に属しているかを確認し、その上で勤務先の性質に応じて申請ルートを探すこと"]},{"tag":"a","props":{"href":"/ja/tip/23-21"},"children":[{"tag":"span","props":{},"children":["21"]},"会計などの初級・中級职称は全国統一試験によって取得する。まずは学歴と勤続年数を確認して申し込むこと"]},{"tag":"a","props":{"href":"/ja/tip/23-22"},"children":[{"tag":"span","props":{},"children":["22"]},"仲介による代行審査、論文の代筆代行、書類の偽造は避けてください：発覚した場合は称号（职称）を取消し、信用記録に 3 年間記録されます"]},{"tag":"a","props":{"href":"/ja/tip/23-23"},"children":[{"tag":"span","props":{},"children":["23"]},"职称の取得は昇給を意味しない：まずは、所属組織が職務割合に基づいた任用を行っているか、それとも審査と任用が別であるかを確認すること"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"現在地"},"children":[{"tag":"a","props":{"href":"/ja/book"},"children":["本を読む"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/ja/book/23"},"children":["第23章"," ·"," ","何のスキルを学ぶのが最も効率的か"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"23-09"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["09"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["エビデンス"," ","A"]}]},{"tag":"h1","props":{"lang":"ja"},"children":["研修はまず政府の補助金制度を優先。いきなり自費で民間講座に申し込まないこと"]},{"tag":"p","props":{"lang":"ja","className":"life-entry-summary"},"children":["2025 年から 2027 年末にかけて、国家計画弁公室は 3000 万人次以上の補助金対象研修を計画しています。財源は、就業補助金、失業保険基金、企業の従業員教育費など、複数の窓口から拠出されます。どの職種がより深刻な人手不足であり、研修コストが高いほど、補助額も高くなります。在職中の方はまず自社に確認し、それ以外の方は、まず現地の労働社会保障局の補助金リストを確認してから、何を学ぶか決定しましょう。"]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["費用・手間"]},{"tag":"p","props":{},"children":["無料、あるいは大幅な減免が可能です。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","pro