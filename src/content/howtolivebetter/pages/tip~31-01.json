:"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"加入待做"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"收藏"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"分享这条建议"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"收起详情"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["成本"]},{"tag":"p","props":{"className":"life-citations"},"children":["不花钱。花十分钟对一遍，看自己够不够得着。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["收益"]},{"tag":"p","props":{"className":"life-citations"},"children":["当兵看兵役法：「年满十八周岁的男性公民，应当被征集服现役；当年未被征集的，在二十二周岁以前仍可以被征集服现役。普通高等学校毕业生的征集年龄可以放宽至二十四周岁，研究生的征集年龄可以放宽至二十六周岁」。考公务员看《公务员录用规定》第十八条。报考条件含「年龄为十八周岁以上，三十五周岁以下」「具有大学专科以上文化程度」。这两项经省级以上公务员主管部门批准可适当调整。该规定第十九条列了五类不得报考的人。比如因犯罪受过刑事处罚的、被开除公职的、被列为失信联合惩戒对象的。消防员看《国家综合性消防救援队伍消防员招录办法》。第五条「年龄为 18 周岁以上、22 周岁以下」「具有高中以上文化程度」。第六条「大学专科以上学历人员、解放军和武警部队退役士兵……年龄可以放宽至 24 周岁」。军队文职看《中国人民解放军文职人员条例》第九条，基本条件含「年满 18 周岁」。该条例第十九条写明，较低职级岗位首次招录聘用最高年龄 35 周岁。较低职级岗位就是入门层级的岗位。事业单位看《事业单位人事管理条例》第八条「事业单位新聘用工作人员，应当面向社会公开招聘」。个体户看《促进个体工商户发展条例》「有经营能力的公民……依法登记为个体工商户的，适用本条例」。自考看《高等教育自学考试暂行条例》。第三条「中华人民共和国公民，不受性别、年龄、民族、种族和已受教育程度的限制，均可依照本条例的规定参加高等教育自学考试」。第二十条「各级各类全日制学校的在校生不得报考」。公费师范生看《教育部直属师范大学本研衔接师范生公费教育实施办法》第二条。它只在六所部属师范大学招。分别是北京师范大学、华东师范大学、东北师范大学、华中师范大学、陕西师范大学和西南大学。本科和研究生阶段一体设计、分段考核，本科读完接着读研究生。在校期间的学费和住宿费由中央财政承担，另外还给生活费补助。该办法第五条「招收公费师范生实行提前批次录取」，就是在普通批次之前先录。定向医学生看《关于做好农村订单定向免费培养医学生就业安置和履约管理工作的通知》。它写着：「在录取后、获得入学通知书前，须与培养学校和定向就业所在地的县级卫生健康行政部门……人力资源社会保障部门签署协议」。出国打工看《对外劳务合作管理条例》。第五条：从事对外劳务合作应当经商务主管部门批准取得经营资格。第七条第四款：「未依法取得对外劳务合作经营资格证书并办理登记，不得从事对外劳务合作」。没有这张资格证的公司组织人出国打工，本身就违法。第八条第二款：「任何单位和个人不得以商务、旅游、留学等名义组织劳务人员赴国外工作」。平台接单和灵活就业没有法定学历门槛，自己参保和职业伤害保障的依据见本节第 11、12 条。打工看义务教育法：「禁止用人单位招用应当接受义务教育的适龄儿童、少年」。《禁止使用童工规定》第二条写明不得招用不满 16 周岁的人，罚则见第 23 节第 1 条（不满 16 周岁）。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["来源"]},{"tag":"p","props":{"className":"life-citations"},"children":["全国人大常委会 (2021). 兵役法（第二十条）. ",{"tag":"a","props":{"href":"http://www.mod.gov.cn/regulatory/2021-08/20/content_4892491.htm","target":"_blank","rel":"noopener noreferrer"},"children":["http://www.mod.gov.cn/regulatory/2021-08/20/content_4892491.htm"]},"（国防部刊登）；中共中央组织部 (2019). 公务员录用规定（第十八、十九条）. ",{"tag":"a","props":{"href":"https://www.12371.cn/2020/01/08/ARTI1578447606460158.shtml","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.12371.cn/2020/01/08/ARTI1578447606460158.shtml"]},"（共产党员网刊登）；人力资源社会保障部、应急管理部 (2021). 国家综合性消防救援队伍消防员招录办法（人社部发〔2021〕58 号，第五、六条）. ",{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/2021-08/27/content_5633684.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/zhengce/zhengceku/2021-08/27/content_5633684.htm"]},"；国务院、中央军委 (2022). 中国人民解放军文职人员条例（第二次修订，令第 757 号，第九、十九条）. ",{"tag":"a","props":{"href":"https://flk.npc.gov.cn/detail?id=ff808181857bca5e01859ee5a6c06d62","target":"_blank","rel":"noopener noreferrer"},"children":["https://flk.npc.gov.cn/detail?id=ff808181857bca5e01859ee5a6c06d62"]},"（国家法律法规数据库）；国务院 (2014). 事业单位人事管理条例（国务院令第 652 号，第八条）. ",{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/2014-05/15/content_8810.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/zhengce/zhengceku/2014-05/15/content_8810.htm"]},"；国务院 (2022). 促进个体工商户发展条例（国务院令第 755 号，第二条）. ",{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/2022-10/25/content_5721592.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/zhengce/zhengceku/2022-10/25/content_5721592.htm"]},"；国务院 (1988, 2014 修订). 高等教育自学考试暂行条例（第三、二十条）. ",{"tag":"a","props":{"href":"https://flk.npc.gov.cn/detail?id=ff8080816f3cbb3c016f415d64e5236d","target":"_blank","rel":"noopener noreferrer"},"children":["https://flk.npc.gov.cn/detail?id=ff8080816f3cbb3c016f415d64e5236d"]},"（国家法律法规数据库）；全国人大常委会 (2018). 义务教育法（第十四条）. ",{"tag":"a","props":{"href":"http://www.moe.gov.cn/jyb_sjzl/sjzl_zcfg/zcfg_jyfl/202110/t20211029_575949.html","target":"_blank","rel":"noopener noreferrer"},"children":["http://www.moe.gov.cn/jyb_sjzl/sjzl_zcfg/zcfg_jyfl/202110/t20211029_575949.html"]},"（教育部刊登）；国务院 (2002). 禁止使用童工规定（国务院令第 364 号，第二条）. ",{"tag":"a","props":{"href":"http://www.gov.cn/gongbao/content/2002/content_61798.htm","target":"_blank","rel":"noopener noreferrer"},"children":["http://www.gov.cn/gongbao/content/2002/content_61798.htm"]},"；国务院办公厅 (2024). 关于转发教育部等部门《教育部直属师范大学本研衔接师范生公费教育实施办法》的通知（国办发〔2024〕27 号，第二、五条）. ",{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/202406/content_6957261.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/zhengce/zhengceku/202406/content_6957261.htm"]},"；国家卫生健康委等 7 部门 (2019). 关于做好农村订单定向免费培养医学生就业安置和履约管理工作的通知. ",{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/2019-11/13/content_5451684.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/zhengce/zhengceku/2019-11/13/content_5451684.htm"]},"；国务院 (2012). 对外劳务合作管理条例（国务院令第 620 号，第五、七、八条）. ",{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/2012-06/11/content_1091.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/zhengce/zhengceku/2012-06/11/content_1091.htm"]},""]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["原书备注"]},{"tag":"p","props":{"className":"life-citations"},"children":["也有几条路的门槛没写死。事业单位条例只要求公开招聘，年龄学历看每次的招聘公告。平台接单没有法定学历门槛。考公务员的年龄和学历，经省级以上主管部门批准可以调整。够得着门槛之后，还要过政治条件、体检和政治考核这几关。这几关没有公开的打分标准，条文里查不到。中职、技工院校和职教贯通招生的入口见第 23 节第 5 条，家里供不起时的资助见第 23 节第 4 条。个体户不看学历，不等于开店容易。本钱、个人担保和关门退场的成本见第 12 节。个人担保的意思是公司还不上，就得你自己还。起步钱能不能借到国家替你出一部分利息的贷款，见本节第 16 条。公费师范生和定向医学生这两条，在高考填志愿那天就定下了，代价写在第 13 条。出国打工的门槛不在你身上，在公司有没有资质上，怎么认见第 14 条。哪条路更划算，这里不作比较。"]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["我的备注"]},{"tag":"button","props":{"type":"button"},"children":["写下对自己有用的提醒…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"span","props":{},"children":[]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/tip/31-02"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["下一条"]},"十八岁那年 10 月 31 日前要做兵役登记；义务兵服现役就是两年"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["本主题的其他建议"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/31-03"},"children":[{"tag":"strong","props":{},"children":["应征之后拒服兵役，两年内不准出境或升学复学，还进不了公务员和国企"]},{"tag":"span","props":{},"children":["报了名又拒绝去当兵、责令改正后还不改的，后果是一串。公务员不能录用你，国有企业和事业单位也不能招你。两年内不准出境，不准升学和复学，还会被列进履行国防义务严重失…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/31-04"},"children":[{"tag":"strong","props":{},"children":["大学生当兵最实的两块：学费每年补最高 20000 元，学籍保留到退役后两年、考研有专项计划"]},{"tag":"span","props":{},"children":["在校生、应届毕业生和新生去当兵，国家替你出读书那几年的学费。本专科生每年最高 20000 元，研究生最高 25000 元，学费本来就低的只补实际交的那么多。服役…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/31-05"},"children":[{"tag":"strong","props":{},"children":["退役后只有六种情况由政府安排工作；自主就业的 30 日内必须报到"]},{"tag":"span","props":{},"children":["「当兵包分配」早就不是普遍情况。现在只有六种情况由政府安排工作，义务兵服两年退役，绝大多数不在这六种里面。不由政府安排工作的那一档叫自主就业，它有个硬期限：退出…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/31-06"},"children":[{"tag":"strong","props":{},"children":["退役后的三笔账：一次性退役金、军龄算工龄、自己干每年扣减 20000 元税"]},{"tag":"span","props":{},"children":["退役之后有三笔账。第一笔是自主就业的一次性退役金，按服现役年限发，立过功的还增发。第二笔是军龄算工龄，缴费年限跟入伍前和退役后合着算。第三笔是税：自己开店做生意…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/31-07"},"children":[{"tag":"strong","props":{},"children":["想进体制内不止考公一条：基层服务项目干满两年，能报每年 10% 的定向考录计划"]},{"tag":"span","props":{},"children":["想进体制内，不是只有考公一条路。「三支一扶」这类基层服务项目干满两年、考核合格，就能报只面向这些人的定向考录计划。各省每年要拿出公务员考录计划的 10% 左右招…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/31-08"},"children":[{"tag":"strong","props":{},"children":["特岗教师三年服务期满、考核合格又愿意留下的，应当及时入编"]},{"tag":"span","props":{},"children":["特岗计划是少数几条写明「期满入编」的路。条件是本科及以上学历、以师范类专业为主，年龄不超过 30 周岁，还要有相应的教师资格证。服务期三年，这三年同等条件下的待…"]}]}]}]},{"tag":"a","props":{"className":"life-text-link","href":"/book/31"},"children":["阅读整个主题：十八岁之后有哪几条路 ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"15","height":"15","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]}]}]},{"tag":"nav","props":{"className":"life-tabbar","aria-label":"主导航"},"children":[{"tag":"a","props":{"className":"","href":"/book"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"21","height":"21","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-book-open","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M12 7v14"},"children":[]},{"tag":"path","props":{