{"d":"M2 12h2"},"children":[]},{"tag":"path","props":{"d":"M20 12h2"},"children":[]},{"tag":"path","props":{"d":"m6.34 17.66-1.41 1.41"},"children":[]},{"tag":"path","props":{"d":"m19.07 4.93-1.41 1.41"},"children":[]}]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"17","height":"17","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-moon life-theme-icon-dark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"},"children":[]}]}]},{"tag":"button","props":{"type":"button","className":"life-language-switch","aria-label":"Русский Выбрать язык","aria-haspopup":"menu","aria-expanded":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-globe","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]},{"tag":"path","props":{"d":"M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"},"children":[]},{"tag":"path","props":{"d":"M2 12h20"},"children":[]}]},{"tag":"span","props":{},"children":["Русский"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]}]},{"tag":"a","props":{"className":"life-account","href":"/ru/sign-in"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"17","height":"17","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle-user-round","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M18 20a6 6 0 0 0-12 0"},"children":[]},{"tag":"circle","props":{"cx":"12","cy":"10","r":"4"},"children":[]},{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},{"tag":"span","props":{},"children":["Войти"]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/ru/book/11"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"К содержанию"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["Основные риски, с которыми сталкиваются программисты и IT‑специалисты"]},{"tag":"nav","props":{"aria-label":"Советы главы"},"children":[{"tag":"a","props":{"href":"/ru/tip/11-01"},"children":[{"tag":"span","props":{},"children":["01"]},"Прежде чем действовать, спросите: заявит ли производитель, платформа или компания в полицию; если вас привлекли к ответственности, сразу найдите адвоката по уголовным делам"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/ru/tip/11-02","data-status":"active"},"children":[{"tag":"span","props":{},"children":["02"]},"Не создавайте и не продавайте игровые читы и помощники, включая ИИ, который «только читает экран, не трогая память», и модификации, добавляющие функции в приложения вроде WeChat"]},{"tag":"a","props":{"href":"/ru/tip/11-03"},"children":[{"tag":"span","props":{},"children":["03"]},"Нельзя создавать и продавать скрипты для автоматической покупки билетов, участия в акциях, накрутки заказов или получения бонусов — даже если они лишь «автоматически нажимают кнопки»"]},{"tag":"a","props":{"href":"/ru/tip/11-04"},"children":[{"tag":"span","props":{},"children":["04"]},"Программа-скрейпер собирает только открытые страницы, доступ к которым не требует авторизации; она не обходит механизмы защиты и не получает персональные данные. Собранные данные запрещено продавать"]},{"tag":"a","props":{"href":"/ru/tip/11-05"},"children":[{"tag":"span","props":{},"children":["05"]},"Не принимать заказы на разработку приложений для азартных игр, мошенничества и порнографии, не создавать платежные шлюзы и не разблокировать аккаунты для «клиентов»"]},{"tag":"a","props":{"href":"/ru/tip/11-06"},"children":[{"tag":"span","props":{},"children":["06"]},"При увольнении необходимо вернуть все учетные данные: не удалять базы данных, не оставлять «черных ходов» и не менять систему защиты паролями, даже если компания задолжала вам деньги"]},{"tag":"a","props":{"href":"/ru/tip/11-07"},"children":[{"tag":"span","props":{},"children":["07"]},"Не забирать с собой исходный код, списки клиентов и техническую документацию при увольнении, не загружать их в личные облачные хранилища и не использовать в новой работе"]},{"tag":"a","props":{"href":"/ru/tip/11-08"},"children":[{"tag":"span","props":{},"children":["08"]},"Запрет на запуск собственных программ на чужих компьютерах, серверах и камерах; использование корпоративной техники для майнинга также запрещено"]},{"tag":"a","props":{"href":"/ru/tip/11-09"},"children":[{"tag":"span","props":{},"children":["09"]},"Тестировать чужие системы без письменного разрешения запрещено; «добрые намерения» и «последующее уведомление» не освобождают от ответственности"]},{"tag":"a","props":{"href":"/ru/tip/11-10"},"children":[{"tag":"span","props":{},"children":["10"]},"Сведения о уязвимостях подаются в установленном порядке; до их исправления не раскрываются детали, не выпускаются инструменты для эксплуатации и не передаются за рубеж"]},{"tag":"a","props":{"href":"/ru/tip/11-11"},"children":[{"tag":"span","props":{},"children":["11"]},"Продажа и настройка инструментов для обхода блокировок, а также аккаунтов VPN запрещены"]},{"tag":"a","props":{"href":"/ru/tip/11-12"},"children":[{"tag":"span","props":{},"children":["12"]},"Подписан договор о неконкуренции: если после увольнения компания не выплачивает компенсацию ежемесячно, следует направить письменное требование; при отсутствии выплат в течение 3 месяцев договор можно расторгнуть. Для сотрудников, не имевших доступа к коммерческой тайне, можно запросить признание этого пункта недействительным"]},{"tag":"a","props":{"href":"/ru/tip/11-13"},"children":[{"tag":"span","props":{},"children":["13"]},"Время работы, код, созданный с использованием корпоративных ресурсов, принадлежит компании; собственные открытые проекты следует разрабатывать в свободное время и на личном оборудовании, не смешивая их с корпоративным кодом"]},{"tag":"a","props":{"href":"/ru/tip/11-14"},"children":[{"tag":"span","props":{},"children":["14"]},"Использование открытого кода (в т.ч. под GPL) в коммерческих продуктах: необходимость соблюдения лицензионных требований, а не отговорка «никто не проверяет»"]},{"tag":"a","props":{"href":"/ru/tip/11-15"},"children":[{"tag":"span","props":{},"children":["15"]},"При разработке приложения следует запрашивать только те персональные данные, которые действительно необходимы для работы сервиса; для лиц младше 14 лет требуется согласие законного представителя, а политика конфиденциальности должна быть составлена предельно понятно"]},{"tag":"a","props":{"href":"/ru/tip/11-16"},"children":[{"tag":"span","props":{},"children":["16"]},"Перед запуском сайта или приложения необходимо оформить регистрацию ICP и хранить логи не менее 6 месяцев в соответствии с требованиями классификации безопасности"]},{"tag":"a","props":{"href":"/ru/tip/11-17"},"children":[{"tag":"span","props":{},"children":["17"]},"Перед предоставлением общественности сервисов генеративного ИИ необходимо провести обязательную оценку безопасности и зарегистрировать алгоритм; созданный контент требует маркировки"]},{"tag":"a","props":{"href":"/ru/tip/11-18"},"children":[{"tag":"span","props":{},"children":["18"]},"Не создавайте и не распространяйте средства автоматического пропуска или блокировки рекламы чужих приложений: даже бесплатное офлайн-средство может быть признано недобросовестной конкуренцией"]},{"tag":"a","props":{"href":"/ru/tip/11-19"},"children":[{"tag":"span","props":{},"children":["19"]},"Не создавайте «ИИ-прокси» для дешевой перепродажи доступа к зарубежным большим моделям: в Шанхае оператора уже подвергли уголовному задержанию"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"Навигация"},"children":[{"tag":"a","props":{"href":"/ru/book"},"children":["Книга"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/ru/book/11"},"children":["Глава 11"," ·"," ","Основные риски, с которыми сталкиваются программисты и IT‑специалисты"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"11-02"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["02"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["Доказательства"," ","A"]}]},{"tag":"h1","props":{"lang":"ru"},"children":["Не создавайте и не продавайте игровые читы и помощники, включая ИИ, который «только читает экран, не трогая память», и модификации, добавляющие функции в приложения вроде WeChat"]},{"tag":"p","props":{"lang":"ru","className":"life-entry-summary"},"children":["По законодательству Китая продажа читов 20 пользователям или незаконный доход от 5000 юаней достаточны для наказания до 3 лет; в особо серьёзных случаях — от 3 до 7 лет. Один разработчик читов с видением сквозь стены и автоматическим прицеливанием за 3 месяца продал их более чем на 80000 юаней: 1 год лишения свободы условно с испытательным сроком 1 год и штраф 5000 юаней. Другие запустили частный сервер по серверной программе игры и получили более 20 млн юаней пополнений; максимальное наказание — 4 года, максимальный штраф — 10 млн юаней."]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Затраты"]},{"tag":"p","props":{},"children":["Никаких прямых затрат нет. Однако придётся отказаться от д…"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Польза"]},{"tag":"p","props":{},"children":["Предоставление программ и средств, специально предназначенных для проникновения в компьютерные информационные…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"Отметить: Не создавайте и не продавайте игровые читы и помощники, включая ИИ, который «только читает экран, не трогая память», и модификации, добавляющие функции в приложения вроде WeChat"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"Сделано"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"В планах"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"В избранное"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Поделиться советом"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Скрыть подробности"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Затраты"]},{"tag":"p","props":{},"children":["Никаких прямых затрат нет. Однако придётся отказаться от доходов от таких заказов и «мелких инструментов». Проблема в том, что эти деньги поступают быстро, а кто придёт привлекать к ответственности — непонятно."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Польза"]},{"tag":"p","props":{},"children":["Предоставление программ и средств, специально предназначенных для проникновения в компьютерные информационные системы или незаконного управления ими, при серьезных обстоятельствах наказывается сроком до 3 лет со штрафом либо только штрафом. Штраф вместе со сроком означает и лишение свободы, и денежное взыскание; отдельный штраф — только денежное взыскание. При особо серьезных обстоятельствах срок составляет 3–7 лет со штрафом. Порог «серьезных обстоятельств» — предоставление средств не менее чем в 20 человеко-случаях или незаконный доход от 5000 юаней. Незаконный доход — деньги, заработанные этим способом. Умышленный обход или разрушение технической защиты правообладателя может также образовать преступное нарушение авторских прав: до 3 лет, а в серьезных случаях — 3–10 лет. Официальные дела: Ван и другие создавали и продавали читы, читавшие и меняющие память игры для видения сквозь стены и автоматического прицеливания. За 3 месяца продали более чем на 80000 юаней, заработав свыше 30000 юаней прибыли. Приговор — 1 год с отсрочкой исполнения на 1 год и штраф 5000 юаней. Отсрочка на год означает, что назначенный год пока не отбывается: если за этот год человек не совершит нового нарушения, в тюрьму идти не потребуется. Сян и другие продавали читы серии «TZ» на сумму свыше 200000 юаней; Сян получил 3 года с отсрочкой на 3 года и штраф 20000 юаней. Лю и другие получили серверную программу игры, изменили параметры и открыли частные серверы, собрав более 20000000 юаней пополнений. Сроки — от 4 лет до 2 лет и 6 месяцев, штрафы — от 10000000 до 1300000 юаней. Это касается не только игр. Компания из Шанхая создала прошивку, добавляющую в WeChat десятки функций, включая автопересылку, лайки и массовую отправку, и продала 2381 устройство как «маркетинговые телефоны». В 2019 году суд района Сюйхуэй в Шанхае за нарушение авторских прав назначил компании штраф 500000 юаней, а руководителю — 1 год и 6 месяцев с отсрочкой на 1 год и 6 месяцев (вся страна)."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Первоисточники"]},{"tag":"p","props":{"className":"life-citations"},"children":["全国人大 (2020). 刑法（根据刑法修正案（十一）修正，第二百八十五条第三款、第二百一十七条第六项）. ",{"tag":"a","props":{"href":"https://jtgl.beijing.gov.cn/jgj/jgxx/flfg/fl/11033925/index.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://jtgl.beijing.gov.cn/jgj/jgxx/flfg/fl/11033925/index.html"]},"；最高人民法院、最高人民检察院 (2011). 关于办理危害计算机信息系统安全刑事案件应用法律若干问题的解释（第三条）. ",{"tag":"a","props":{"href":"https://ga.sz.gov.cn/ZWGK/ZCFG/ZCJD/content/post_1304363.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://ga.sz.gov.cn/ZWGK/ZCFG/ZCJD/content/post_1304363.html"]},"（深圳市公安局转载）；最高人民检察院 (2026). 上海静安：严惩制售游戏外挂黑灰产共护清朗网络空间. ",{"tag":"a","props":{"href":"https://www.spp.gov.cn/spp/zdgz/202608/t20260825_735480.shtml","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.spp.gov.cn/spp/zdgz/202608/t20260825_735480.shtml"]},"；最高人民检察院 (2021). 2020 年度检察机关保护知识产权典型案例（案例五）. ",{"tag":"a","props":{"href":"https://www.spp.gov.cn/spp/xwfbh/wsfbt/202104/t20210425_516525.shtml","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.spp.gov.cn/spp/xwfbh/wsfbt/202104/t20210425_516525.shtml"]},"；国家版权局 (2020). 2019 年度上海十大版权典型案件发布（上海市版权局发布，案例八：上海昱宫网络科技有限公司等侵犯著作权案）. ",{"tag":"a","props":{"href":"https://www.ncac.gov.cn/xxfb/ywxx/202004/t20200430_47269.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.ncac.gov.cn/xxfb/ywxx/202004/t20200430_47269.html"]}]},{"tag":"a","props":{"href":"https://jtgl.beijing.gov.cn/jgj/jgxx/flfg/fl/11033925/index.html","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Открыть источник"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Примечание автора"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["Все известные судебные прецеденты касаются читов, которые читают и изменяют память игры, обходя системы защиты. Пока не встречалось примеров наказания за вспомогательные программы, которые лишь делают скриншоты или имитируют нажатия клавиш. Однако дело о незаконном получении данных через билетные сервисы показывает, что даже без вмешательства в память, но при отправке запросов можно привлечь к ответственности. Окончательное решение о виновности и квалификации преступления принимает следственный орган на основе материалов, предоставленных разработчиком игры; автор этих строк не вправе определять это самостоятельно. Для признания действий «серьёзным нарушением» достаточно всего 20 продаж инструмента — это очень небольшое количество."]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Моя заметка"]},{"tag":"button","props":{"type":"button"},"children":["Запишите напоминание…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/ru/tip/11-01"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Предыдущий"]},"Прежде чем действовать, спросите: заявит ли производитель, платформа или компания в полицию; если вас привлекли к ответственности, сразу найдите адвоката по уголовным делам"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/ru/tip/11-03"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Следующий"]},"Нельзя создавать и продавать скрипты для автоматической покупки билетов, участия в акциях, накрутки заказов или получения бонусов — даже если они лишь «автоматически нажимают кнопки»"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["Другие советы по этой теме"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/11-04"},"children":[{"tag":"strong","props":{},"children":["Программа-скрейпер собирает только открытые страницы, доступ к которым не требует авторизации; она не обходит механизмы защиты и не получает персональные данные. Собранные данные запрещено продавать"]},{"tag":"span","props":{},"children":["Попытка собрать данные, доступ к которым требует авторизации, токена …"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/11-05"},"children":[{"tag":"strong","props":{},"children":["Не принимать заказы на разработку приложений для азартных игр, мошенничества и порнографии, не создавать платежные шлюзы и не разблокировать аккаунты для «клиентов»"]},{"tag":"span","props":{},"children":["Принимая такие заказы с высокой оплатой и нечеткими требованиями, вы …"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/11-06"},"children":[{"tag":"strong","props":{},"children":["При увольнении необходимо вернуть все учетные данные: не удалять базы данных, не оставлять «черных ходов» и не менять систему защиты паролями, даже если компания задолжала вам деньги"]},{"tag":"span","props":{},"children":["Учетные данные и пароли предоставляет компания, но это не означает, ч…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/11-07"},"children":[{"tag":"strong","props":{},"children":["Не забирать с собой исходный код, списки клиентов и техническую документацию при увольнении, не загружать их в личные облачные хранилища и не использовать в новой работе"]},{"tag":"span","props":{},"children":["Исходный код, написанный вами, также принадлежит компании, поэтому ег…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/11-08"},"children":[{"tag":"strong","props":{},"children":["Запрет на запуск собственных программ на чужих компьютерах, серверах и камерах; использование корпоративной техники для майнинга также запрещено"]},{"tag":"span","props":{},"children":["Незаконное управление чужими компьютерами, серверами или камерами без…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/11-09"},"children":[{"tag":"strong","props":{},"children":["Тестировать чужие системы без письменного разрешения запрещено; «добрые намерения» и «последующее уведомление» не освобождают от ответственности"]},{"tag":"span","props":{},"children":["По законодательству Китая важны наличие разрешения и объём полученног…"]}]}]}]},{"tag":"a","props":{"className":"life-text-link","href":"/ru/book/11"},"children":["Читать всю тему: Основные риски, с которыми сталкиваются программисты и IT‑специалисты"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"15","height":"15","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]}]}]},{"tag":"nav","props":{"className":"life-tabbar","aria-label":"Основная навигация"},"children":[{"tag":"a","props":{"className":"","href":"/ru/book"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"21","height":"21","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-book-open","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M12 7v14"},"children":[]},{"tag":"path","props":{"d":"M3 18a1 1 0 0 1-1-1V4