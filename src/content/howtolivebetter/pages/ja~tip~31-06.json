"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},{"tag":"span","props":{},"children":["ログイン"]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/ja/book/31"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"目次に戻る"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["18歳以降、どのような道があるか"]},{"tag":"nav","props":{"aria-label":"この章のヒント"},"children":[{"tag":"a","props":{"href":"/ja/tip/31-01"},"children":[{"tag":"span","props":{},"children":["01"]},"まずは基準を確認：12のルートの年齢と学歴要件は明文化されています"]},{"tag":"a","props":{"href":"/ja/tip/31-02"},"children":[{"tag":"span","props":{},"children":["02"]},"18歳の 10 月 31 日までに兵役登録を行う必要があります。義務兵の現役期間は2年間です"]},{"tag":"a","props":{"href":"/ja/tip/31-03"},"children":[{"tag":"span","props":{},"children":["03"]},"徴兵に応じた後に兵役を拒否した場合、2年間は出国や進学・復学が禁止され、公務員や国営企業への採用も不可となります"]},{"tag":"a","props":{"href":"/ja/tip/31-04"},"children":[{"tag":"span","props":{},"children":["04"]},"大学生の兵役で最も実利的な2点：授業料が毎年最大 20000 元補助、学籍は2年間保持、大学院入試の特別枠あり"]},{"tag":"a","props":{"href":"/ja/tip/31-05"},"children":[{"tag":"span","props":{},"children":["05"]},"退役後、政府による就業配置が行われるのは6つのケースのみ；自主就業の場合は 30 日以内に届け出が必要"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/ja/tip/31-06","data-status":"active"},"children":[{"tag":"span","props":{},"children":["06"]},"退役後の3つの勘定：一時金としての退役金、軍歴の勤続年数算入、自主事業の場合は毎年 20000 元の減税"]},{"tag":"a","props":{"href":"/ja/tip/31-07"},"children":[{"tag":"span","props":{},"children":["07"]},"公務員試験以外にも公務員への道はある：基礎サービスプロジェクトで2年間勤務すれば、毎年 10% の定向採用計画に応募可能"]},{"tag":"a","props":{"href":"/ja/tip/31-08"},"children":[{"tag":"span","props":{},"children":["08"]},"特崗教師（特別採用教員）は、3年間の服務期間終了後、評価に合格し、かつ継続を希望する場合は、速やかに正規採用（入編）されるべきである"]},{"tag":"a","props":{"href":"/ja/tip/31-09"},"children":[{"tag":"span","props":{},"children":["09"]},"消防士と軍事文職は、公務員試験とは別の公開採用枠であり、門戸は公務員試験よりも低い"]},{"tag":"a","props":{"href":"/ja/tip/31-10"},"children":[{"tag":"span","props":{},"children":["10"]},"学歴は一度きりの取引ではない：自考（社会自学試験）は年齢や既修学歴を問わず、成人高考や開放大学でも補完が可能"]},{"tag":"a","props":{"href":"/ja/tip/31-11"},"children":[{"tag":"span","props":{},"children":["11"]},"組織に属さなければ「フリーランス」：年金と医療保険は就業地での加入が必要、戸籍による制限は緩和済み"]},{"tag":"a","props":{"href":"/ja/tip/31-12"},"children":[{"tag":"span","props":{},"children":["12"]},"出前置配送、配网約車、市内貨物輸送などの業務において、プラットフォームが注文ごとに職業傷害保障費を負担し、自身での支払いは不要"]},{"tag":"a","props":{"href":"/ja/tip/31-13"},"children":[{"tag":"span","props":{},"children":["13"]},"大学入試の志望校記入日に公務員枠を確定できる2つの道：公費師範生と定向医学生、代償は 6 年間の義務履行"]},{"tag":"a","props":{"href":"/ja/tip/31-14"},"children":[{"tag":"span","props":{},"children":["14"]},"海外での就労を希望するなら、まずこの会社に「対外労務合作経営資格」があるか確認すること：預かり金を請求することは禁止されています"]},{"tag":"a","props":{"href":"/ja/tip/31-15"},"children":[{"tag":"span","props":{},"children":["15"]},"海外企業のリモートワーク、この収入は税法上「国内所得」とみなされます：個人所得税は自身で申告し、送金は「給与所得」として処理すること"]},{"tag":"a","props":{"href":"/ja/tip/31-16"},"children":[{"tag":"span","props":{},"children":["16"]},"会社に属さず自力で起業するなら、まずは創業保証ローンをチェック：個人向け最高 30 万円、利息の半分を財政が補助"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"現在地"},"children":[{"tag":"a","props":{"href":"/ja/book"},"children":["本を読む"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/ja/book/31"},"children":["第31章"," ·"," ","18歳以降、どのような道があるか"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"31-06"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["06"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["エビデンス"," ","A"]}]},{"tag":"h1","props":{"lang":"ja"},"children":["退役後の3つの勘定：一時金としての退役金、軍歴の勤続年数算入、自主事業の場合は毎年 20000 元の減税"]},{"tag":"p","props":{"lang":"ja","className":"life-entry-summary"},"children":["退役後には3つの勘定があります。1つ目は自主就業の一時金としての退役金で、現役の服役年数に応じて支給され、功績がある場合は増額されます。2つ目は、兵役期間中の社会保険の空白期間はカウントされず、軍歴が勤続年数として計算され、保険料の納付期間は入隊前と退役後を合算して計算されます。3つ目は税金です。自分で店を開いて商売をする場合、3 年間は毎年最大で 20000 元の減税が受けられます。"]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["費用・手間"]},{"tag":"p","props":{},"children":["費用はかかりません。退役時に軍から社会保険の資格と資金が移管されます。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["効果"]},{"tag":"p","props":{},"children":["最初の項目は『退役軍人安置条例』を参照してください。そこには、「自主雇用を選択した退役軍士および義務兵に対し、現役年数に基づき一回限りの退役手当を支給する」と記されています。"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"記録する：退役後の3つの勘定：一時金としての退役金、軍歴の勤続年数算入、自主事業の場合は毎年 20000 元の減税"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"できている"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"やることに追加"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"お気に入り"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"このヒントを共有"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"詳細を閉じる"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["費用・手間"]},{"tag":"p","props":{},"children":["費用はかかりません。退役時に軍から社会保険の資格と資金が移管されます。その後、配置先の社会保険窓口（社会保険の担当機関）にて継続手続きを行います。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["効果"]},{"tag":"p","props":{},"children":["最初の項目は『退役軍人安置条例』を参照してください。そこには、「自主雇用を選択した退役軍士および義務兵に対し、現役年数に基づき一回限りの退役手当を支給する」と記されています。資金の出所については、「中央財政による特別予算から充当され、具体的な基準は、国務院の退役軍人業務主管部門、中央軍事委員会政治工作部門が国務院財政部門と連携して……決定し、適宜調整を行う」とされています。増額率は5段階に分かれています。勲章や名誉称号の授与を受けた場合は 25% 増、一等戦功または一級表彰の場合は 20% 増、二等戦功、一等功または二級表彰の場合は 15% 増、三等戦功または二等功の場合は 10% 増、四等戦功または三等功の場合は 5% 増となります。この条例には、「退役軍人が適時に就業できなかった場合、戸籍地の社会保障部門に対して法律に基づき失業保険給付を申請することができる。現役期間は社会保険の保険料納付期間とみなされるものとする。ただし、退職または扶養方式で配置された退役軍人はこの限りではない」と記されています。「納付期間とみなす」とは、この数年間に保険料を支払っていなくても、支払ったものとして計算されるという意味です。次に、『退役軍人保障法』を見ると、「退役軍人の現役期間は勤続年数として計算され、退役後は所属組織での勤務年数と合算して計算される」とあります。勤続年数とは、働いている年数のことで、現役時代の年数と退役後の年数を続けて加算していきます。また、同法には、現役期間と入隊前および退役後の年金、医療、失業保険の保険料納付期間を「法律に基づき合算して計算する」こと、および「退役した下士官および兵卒の現役経験は、基层（基層）での勤務経験とみなす」ことが記されています。《軍人保険法》：「軍人の現役期間は、従業員基本医療保険の保険料納付期間とみなされ、入隊前および退役後の従業員基本医療保険の納付期間と合算して計算される」。第3の項目については、財政部、税務総局、退役軍人事務部による 2023 年第 14 号公告を参照。「自主雇用形態で個人事業を行う退役軍人の場合：3 年（36 ヶ月、以下同様）の間、1世帯あたり年間 20000 元を上限として、その年の実際の納税額から、増値税、都市維持建設税、教育費付加金、地方教育付加金、および個人所得税を順次控除する。控除額の上限は最大 20% まで引き上げることが可能である」。控除とは、その年に支払うべきこれらの税金から上限に達するまで順番に差し引くことであり、直接支給される現金ではない。企業による採用の「基準額は1人あたり年間 6000 元、最大で 50% の引き上げが可能」です。適用期間は 2023 年 1 月 1 日から 2027 年 12 月 31 日までです。期間満了時に残り 3 年未満の場合は、満了時まで継続して受給可能です（全国対象）"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["出典"]},{"tag":"p","props":{"className":"life-citations"},"children":["国务院、中央军委 (2024). 退役军人安置条例（国务院、中央军委令第 787 号，第二十一、二十二、七十四、八十一、八十五条）. ",{"tag":"a","props":{"href":"https://www.gov.cn/gongbao/2024/issue_11526/202408/content_6969192.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/gongbao/2024/issue_11526/202408/content_6969192.html"]},"；退役军人事务部 (2020). 关于一次性退役金的十个问题（转载《中国退役军人》2020 年第 10 期）：「基本标准。士兵服现役每满一年，发给4500元」「退役金标准适时调整」. ",{"tag":"a","props":{"href":"https://www.mva.gov.cn/sy/zzxc/202011/t20201113_43153.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.mva.gov.cn/sy/zzxc/202011/t20201113_43153.html"]},"；贵州省退役军人事务厅 (2024). 一次性退役金增发，重要变化！：「现在执行的标准是：士兵服现役每满一年，发给4500元」. ",{"tag":"a","props":{"href":"http://tyjrswt.guizhou.gov.cn/zfxxgk/fdzdgknr/zdlyxx_5621158/tyaz_5621161/202408/t20240809_85367194.html","target":"_blank","rel":"noopener noreferrer"},"children":["http://tyjrswt.guizhou.gov.cn/zfxxgk/fdzdgknr/zdlyxx_5621158/tyaz_5621161/202408/t20240809_85367194.html"]},"；烟台市牟平区人民政府 (2025). 答复中引《烟台市退役军人事务局、烟台市财政局关于调整自主就业退役士兵一次性经济补助标准的通知》：「2024年退出现役的每服役一年补助6000元」. ",{"tag":"a","props":{"href":"https://www.muping.gov.cn/art/2025/11/10/art_105032_2960250.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.muping.gov.cn/art/2025/11/10/art_105032_2960250.html"]},"；全国人大常委会 (2020). 退役军人保障法（第四十二、四十四、五十条）. ",{"tag":"a","props":{"href":"http://www.mod.gov.cn/gfbw/fgwx/flfg/16048597.html","target":"_blank","rel":"noopener noreferrer"},"children":["http://www.mod.gov.cn/gfbw/fgwx/flfg/16048597.html"]},"（国防部刊登）；全国人大常委会 (2012). 军人保险法（第十六、二十三条）. ",{"tag":"a","props":{"href":"https://flk.npc.gov.cn/detail?id=2c909fdd678bf17901678bf73e160645","target":"_blank","rel":"noopener noreferrer"},"children":["https://flk.npc.gov.cn/detail?id=2c909fdd678bf17901678bf73e160645"]},"（国家法律法规数据库）；财政部、税务总局、退役军人事务部 (2023). 关于进一步扶持自主就业退役士兵创业就业有关税收政策的公告（2023 年第 14 号）. ",{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/202308/content_6896456.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/zhengce/zhengceku/202308/content_6896456.htm"]}]},{"tag":"a","props":{"href":"https://www.gov.cn/gongbao/2024/issue_11526/202408/content_6969192.html","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["出典を開く"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["著者の注記"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["条例には金額は主管部門が別途定める旨のみ記載されています。確認できる公式な数字は、退役軍人事務部公式サイトの 2020 年年報にある「現役勤務1年ごとに4500元を支給する」というものですが、同記事には「適宜調整する」とも記載されています。その記事内の増額率は現行の条例と一致しなくなっているため、条例を基準とする必要があります。貴州省退役軍人事務庁の 2024 年 8 月の記事では、新条例の下でも依然として「現在適用されている基準は、兵士の現役勤務1年ごとに4500元を支給する」と記載されています。TODO（要確認：正式な基準文書は見つかっておらず、2024 年 8 月時点で省級部門がこのように記載していることまでしか確認できていません）。また、地方の「一時金（一次性経済補助）」とこれらを混同しないようにしてください。それは各自治体が独自に定め、支給している別の手当です。例えば、煙台では 2024 年に退役した際、服役1年につき 6000 元の補助金が支給されます。攻略サイトにある新しい数字の多くは根拠がなく、これら2つの手当を混同しているものもあります。義務兵の服役期間中には、別途「家庭優待金」を受け取ることも可能です。兵役法には「基準は地方人民政府が策定し、中央財政が定額の補助を支給する」としか記載されていないため、具体的な金額については、入隊を許可した当該の県級人民政府に確認してください。税金に関する項目は、年間で最大いくら減税できるかを示しています。事業が軌道に乗らなければ使い切れないため、全体の収益規模は「中」と設定されています。2026 年 8 月 1 日から施行された『退役軍人就業創業促進条例』には、もう一点追加事項があります。服役中に取得した技能者職業資格認定は、退役後も全国で通用します。"]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["自分のメモ"]},{"tag":"button","props":{"type":"button"},"children":["自分へのメモを書く…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/ja/tip/31-05"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["前へ"]},"退役後、政府による就業配置が行われるのは6つのケースのみ；自主就業の場合は 30 日以内に届け出が必要"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/ja/tip/31-07"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["次へ"]},"公務員試験以外にも公務員への道はある：基礎サービスプロジェクトで2年間勤務すれば、毎年 10% の定向採用計画に応募可能"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["このテーマの他の提案"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/31-02"},"children":[{"tag":"strong","props":{},"children":["18歳の 10 月 31 日までに兵役登録を行う必要があります。義務兵の現役期間は2年間です"]},{"tag":"span","props":{},"children":["兵役登録は法的義務であり、入隊の申し込みではありません。登録したからといって必ず入隊しなければならないわけでもありません。満 18 歳に達…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/31-03"},"children":[{"tag":"strong","props":{},"children":["徴兵に応じた後に兵役を拒否した場合、2年間は出国や進学・復学が禁止され、公務員や国営企業への採用も不可となります"]},{"tag":"span","props":{},"children":["登録した後に兵役を拒否すると、一連の不利益が生じます。公務員への採用は拒否され、国営企業や事業単位（事业单位）への採用もできません。2年間…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/31-04"},"children":[{"tag":"strong","props":{},"children":["大学生の兵役で最も実利的な2点：授業料が毎年最大 20000 元補助、学籍は2年間保持、大学院入試の特別枠あり"]},{"tag":"span","props":{},"children":["在校生、卒業予定者、および新入生が兵役に就く場合、国がその在学期間中の授業料を負担します。実際に支払った金額に基づいて補填され、専門・短大…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/31-08"},"children":[{"tag":"strong","props":{},"children":["特崗教師（特別採用教員）は、3年間の服務期間終了後、評価に合格し、かつ継続を希望する場合は、速やかに正規採用（入編）されるべきである"]},{"tag":"span","props":{},"children":["特崗計画は、数少ない「任期終了後の正規採用」が明記されているルートの一つです。条件は、学士以上の学位（主に師範系専攻）、 30 歳以下、か…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/31-09"},"children":[{"tag":"strong","props":{},"children":["消防士と軍事文職は、公務員試験とは別の公開採用枠であり、門戸は公務員試験よりも低い"]},{"tag":"span","props":{},"children":["これら2つのルートはいずれも「専門学校（大専）以上」というハードルに縛られません。消防士は 18 から 22 歳、高校卒業以上の学歴の人を…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/31-10"},"children":[{"tag":"strong","props":{},"children":["学歴は一度きりの取引ではない：自考（社会自学試験）は年齢や既修学歴を問わず、成人高考や開放大学でも補完が可能"]},{"tag":"span","props":{},"children":["18歳の時に学業を断念したとしても、その後には自考、成人高考、開放大学という3つの正規のルートがあります。自考は年齢やこれまでの学歴を問い…"]}]}]}]},{"tag":"a","props":{"className":"life-text-link","href":"/ja/book/31"},"children":["テーマ全体を読む：18歳以降、どのような道があるか"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"15","height":"15","viewBox":"0