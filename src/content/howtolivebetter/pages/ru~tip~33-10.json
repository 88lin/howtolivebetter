ath","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Затраты"]},{"tag":"p","props":{},"children":["Никаких расходов. Всего лишь нужно добавить одну фразу во время собеседования; сложность заключается лишь в том, чтобы её произнести."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Польза"]},{"tag":"p","props":{},"children":["Согласно статье 8 «Положения о трудоустройстве инвалидов», работодатели обязаны нанимать инвалидов в количестве не менее 1,5 % от общего числа сотрудников; конкретный процент определяется правительствами провинций, автономных районов и городов центрального подчинения. Статья 9 гласит, что при невыполнении этого требования компания обязана уплачивать сбор за трудоустройство инвалидов. В статье 8 «Правил взимания, использования и управления сбором за трудоустройство инвалидов» приведена формула расчёта: годовая сумма сбора = (число сотрудников за прошлый год × установленный региональный процент трудоустройства инвалидов − фактическое число трудоустроенных инвалидов) × средняя годовая зарплата сотрудников за прошлый год. Согласно статье 16, в течение трёх лет после регистрации малые предприятия, в которых численность сотрудников не превышает 20 человек и которые не достигли требуемого процента трудоустройства инвалидов, освобождаются от уплаты этого сбора. Статья 36 «Закона о защите прав инвалидов» предусматривает предоставление налоговых льгот компаниям, трудоустраивающим инвалидов в объёме, равном или превышающем установленный норматив, а также предприятиям, специализирующимся на их трудоустройстве (действует на всей территории страны с 1 мая 2007 года)."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Первоисточники"]},{"tag":"p","props":{"className":"life-citations"},"children":["国务院 (2007). 残疾人就业条例（第八条、第九条）. ",{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/2008-03/28/content_6646.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/zhengce/zhengceku/2008-03/28/content_6646.htm"]},"；财政部、国家税务总局、中国残联 (2015). 残疾人就业保障金征收使用管理办法（财税〔2015〕72 号，第六条、第八条、第十六条）. ",{"tag":"a","props":{"href":"http://www.gov.cn/zhengce/zhengceku/2015-09/15/content_5650063.htm","target":"_blank","rel":"noopener noreferrer"},"children":["http://www.gov.cn/zhengce/zhengceku/2015-09/15/content_5650063.htm"]},"；中华人民共和国残疾人保障法（第三十六条）. ",{"tag":"a","props":{"href":"https://flk.npc.gov.cn/detail?id=ff8080816f135f46016f1d134c88132b","target":"_blank","rel":"noopener noreferrer"},"children":["https://flk.npc.gov.cn/detail?id=ff8080816f135f46016f1d134c88132b"]}]},{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/2008-03/28/content_6646.htm","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Открыть источник"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Примечание автора"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["Для малых предприятий, зарегистрированных менее трёх лет и имеющих не более 20 сотрудников, этот аргумент не применим, поэтому на него рассчитывать не стоит. Порядок предоставления льгот по уплате сбора постоянно корректируется; актуальные условия следует уточнять в официальных уведомлениях Министерства финансов. Кроме того, требование по трудоустройстве инвалидов подразумевает реальную занятость; формальное оформление без фактической работы, с целью лишь снижения суммы сбора, является мошенничеством, и вы также окажетесь вовлечёнными в эту ситуацию. Вопросы признания лица нуждающимся в трудоустройстве и получения субсидий по соцстраху рассматриваются в разделе 7, пункт 12 («Лица, испытывающие трудности с трудоустройством»). Информация о субсидиях на профессиональное обучение приведена в разделе 7, пункт 13 («Субсидии на профессиональное обучение»). Данная мера выгодна прежде всего вам как соискателю."]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Моя заметка"]},{"tag":"button","props":{"type":"button"},"children":["Запишите напоминание…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/ru/tip/33-09"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Предыдущий"]},"За модернизацию пандусов, поручней и ванных комнат в доме можно подать заявку на субсидию в органы гражданской администрации на уровне уезда и выше"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/ru/tip/33-11"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Следующий"]},"Налог на доходы физических лиц для людей с инв