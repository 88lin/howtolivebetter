currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"記事一覧へ"]},{"tag":"header","props":{"className":"life-longread-header"},"children":[{"tag":"div","props":{},"children":[{"tag":"div","props":{"className":"life-eyebrow"},"children":["詳しく読む"]},{"tag":"h1","props":{"lang":"ja"},"children":["結婚は得か損か：不透明な一塊の勘定を、5つの明確な勘定へと分解する"]},{"tag":"p","props":{"lang":"ja"},"children":["健康、時間、お金、撤退コスト、そして人間関係の質を個別に算出し、その上で穴埋め式のチェックリストを用いて自身の選択を整理しましょう。"]},{"tag":"a","props":{"className":"life-longread-chapter","href":"/ja/book/10"},"children":["関連する章"," · ","恋愛と結婚は損か得か",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"img","props":{"src":"/sites/howtolivebetter/images/book-chapters/10-relationships-editorial.webp","srcSet":"/sites/howtolivebetter/images/book-chapters/10-relationships-editorial-thumb.webp 600w, /sites/howtolivebetter/images/book-chapters/10-relationships-editorial-md.webp 900w, /sites/howtolivebetter/images/book-chapters/10-relationships-editorial.webp 1200w","sizes":"(max-width: 760px) 100vw, 450px","alt":"","width":"1200","height":"800","fetchPriority":"high"},"children":[]}]},{"tag":"div","props":{"className":"life-longread-layout"},"children":[{"tag":"aside","props":{"className":"life-longread-toc"},"children":[{"tag":"details","props":{"open":true},"children":[{"tag":"summary","props":{},"children":["この記事の目次"]},{"tag":"nav","props":{"aria-label":"この記事の目次"},"children":[{"tag":"a","props":{"href":"#一まずは問題を分解する"},"children":["一、まずは問題を分解する"]},{"tag":"a","props":{"href":"#二各勘定のデータと出典"},"children":["二、各勘定のデータと出典"]},{"tag":"a","props":{"href":"#三自分自身で計算する方法穴埋めリスト"},"children":["三、自分自身で計算する方法：穴埋めリスト"]},{"tag":"a","props":{"href":"#四よくある誤解"},"children":["四、よくある誤解"]},{"tag":"a","props":{"href":"#出典"},"children":["出典"]}]}]}]},{"tag":"div","props":{"className":"life-longread-main"},"children":[{"tag":"article","props":{"className":"life-article-body","lang":"ja"},"children":[{"tag":"p","props":{},"children":["多くの人が抱く問いは、非常に漠然としたものです。それは「結婚は結局、損なのか得なのか」という問いです。この問いには、いくつかの要素が混在しています。相手が精神的な支えになってくれるか、家事を分担してくれるか、稼いでくれるか、そして親への対応のために結婚すべきかどうか、といったことです。これらは単位が異なるため、そのまま合算して回答することはできません。そのため、本稿ではこれらを分解して計算していきます。各項目については、公的な統計またはメタ分析（複数の研究を統合して算出する方法）の数値のみを使用し、算出できない箇所については、算出不能である旨を明記します。最後に、ご自身で記入できるチェックリストを提示しますが、全文を通して「結婚すべきか否か」という結論は出しません。"]},"\n",{"tag":"h2","props":{"id":"一まずは問題を分解する"},"children":["一、まずは問題を分解する"]},"\n",{"tag":"p","props":{},"children":["「結婚のコスパ（割に合うか）」には、少なくとも5つの計算項目が含まれています。これら5つの項目の単位は異なり、計算方法も異なるため、単純に合算することはできません。"]},"\n",{"tag":"ol","props":{},"children":["\n",{"tag":"li","props":{},"children":["金銭：一つは、実際に支払う必要がある結納金、結婚式、新居の費用。もう一つは、法律で定められた財産の帰属について。前者の項目については公的な統計はなく、後者の項目については明文規定が存在します。"]},"\n",{"tag":"li","props":{},"children":["時間：家事、家族のケア、相手の仕事に合わせた譲歩など、これらは報酬の支払われない労働であり、単位は「1日あたり何分か」となります。"]},"\n",{"tag":"li","props":{},"children":["健康：既婚者と未婚者の間で、死亡率にどれほどの差があるか。この項目は、二つの事象が同時に存在することを示すに過ぎず、その差が結婚によってもたらされたものであることまでは証明できません。"]},"\n",{"tag":"li","props":{},"children":["法的リスク：財産をどのように分けるか、離脱を希望する場合にどれほどの期間を要するか、どのような貢献に対して事後的な補償を請求できるか。重い病気のとき誰が代わりに判断できるか。この項目は、法律の条文がどのように規定されているかによって決まります。"]},"\n",{"tag":"li","props":{},"children":["関係の質：相手があなたに情緒的なサポートを与えてくれるか、二人がどれほど激しく喧嘩するか。この勘定は、研究によって算出された相関の強さでしか測ることができず、お金にも時間にも換算できない。"]},"\n"]},"\n",{"tag":"p","props":{},"children":["5番目の勘定は、数値化するのが最も困難だが、多くの人が問いかけたい内容に最も近いものである。"]},"\n",{"tag":"h2","props":{"id":"二各勘定のデータと出典"},"children":["二、各勘定のデータと出典"]},"\n",{"tag":"h3","props":{"id":"登録データ婚姻率と離婚率は二つの粗率である"},"children":["登録データ：婚姻率と離婚率は二つの粗率である"]},"\n",{"tag":"p","props":{},"children":["数値は民政部による《2024 年民政事業発展統計公報》に基づいている。2024 年、全国で法に基づき婚姻届が受理されたのは 610.6 万組で、前年比で 20.5% 減少、婚姻率は 4.3‰であった。法に基づき離婚手続きが行われたのは 351.3 万組で、離婚率は 2.5‰であった。この 351.3 万組のうち、262.2 万組は民政部門で離婚を登録したものであり、89.1 万組は裁判所の判決または調停による離婚である。公報の注釈には、これら二つの率の算出方法が明記されている。すなわち、その年の婚姻（離婚）件数を、その年の平均総人口数で割り、さらに 1000‰ を乗じるものである。"]},"\n",{"tag":"p","props":{},"children":["これら二つの率の分母はいずれも全人口であるため、「粗率（粗い率）」と呼ばれる。「粗い」とは、いかなる細分化も行っていないことを指す。これは、今年の1,000人あたり何組が婚姻または離婚の登録を行ったかに答えるものであり、ある婚姻が最終的に破綻するかどうかには答えていない。後者の問いに答えるには、同一の集団を長期間追跡したデータが必要である。本稿では、公式の原文からそのようなデータを見つけることはできなかった。"]},"\n",{"tag":"h3","props":{"id":"健康の勘定既婚者は死亡率が低いがこれは相関関係であり因果関係ではない"},"children":["健康の勘定：既婚者は死亡率が低いが、これは相関関係であり因果関係ではない"]},"\n",{"tag":"p","props":{},"children":["3つのメタ分析が複数の研究を統合しており、示された規模感は一致しています。以下で述べる「全死因死亡」とは、死因を問わず、すべての死亡を合わせたものを指します。"]},"\n",{"tag":"ul","props":{},"children":["\n",{"tag":"li","props":{},"children":["Manzoliら (2007) は、53 組の比較、25 万人以上の高齢者を統合しました。ここでの「婚姻関係にない」には、3つのグループが含まれます：死別、離婚または別居、未婚。既婚者をこれら3つのグループと比較した場合、全死因死亡のRRは 0.88 であり、約12%低くなっています。RRは2つのグループの死亡リスクの比であり、1 未満であれば既婚者側のリスクが低いことを示します。95% CI 0.85–0.91 は、この数値の信頼区間です。3つのグループを個別に見た場合、死別は 1.11、離婚または別居は 1.16、未婚は 1.11 であり、それぞれ約10%、16%、10%高くなっています。男女別、研究の質別、欧州と米州別で計算しても、結果は変わりません。最も保守的なアルゴリズムで再計算すると、RRは 0.94 となり、低くなるのは約6%にとどまります。"]},"\n",{"tag":"li","props":{},"children":["Roelfsら (2011) は、95 報の文献、5 億人余りを統合しました。未婚者を既婚者と比較した場合、全死因死亡のHRは 1.24 であり、約24%高くなっています。HRもRRと同様に倍率を示すもので、1 を超えるとリスクが高いことを示します。1.19–1.30 は、この数値の信頼区間です。年齢が上がるにつれて、この差は小さくなります。研究がより厳密であるほど、算出される差も小さくなります。"]},"\n",{"tag":"li","props":{},"children":["Wangら (2020) は、21 項の研究、789 万人余りを統合しました。婚姻関係にないことは、全死因死亡、がん死亡、心血管疾患死亡のすべてに関連しており、男女ともに同様です。その中でも、男性は心血管疾患死亡および全死因死亡における関連がより強いです。未婚の男性を未婚の女性と比較すると、脳卒中による死亡リスクは 31% 高く、全死因死亡は 9% 高くなります。"]},"\n"]},"\n",{"tag":"p","props":{},"children":["これら3つの研究はいずれも集団を追跡記録したものであり、対照群を用いた比較試験ではありません。健康状態が良く、収入が高く、社交的な人は、もともと結婚しやすく、かつ長生きしやすい傾向があります。これは「選択バイアス」と呼ばれます。Manzoliらの論文では、出版バイアスの兆候も見られました。出版バイアスとは、結果が良い研究ほど出版されやすいため、統合した際に楽観的な方向に偏ることを意味します。したがって、これらの数値は「既婚者集団において死亡率がやや低い」と解釈すべきであり、「結婚すれば死亡率が 12% 低くなる」と解釈すべきではありません。これらの研究のサンプルは欧米の集団が中心であるため、中国国内に適用する場合は、あくまで規模感の参考として扱うべきです。"]},"\n",{"tag":"h3","props":{"id":"時間の勘定無償労働のジェンダー格差は上限の参考値である"},"children":["時間の勘定：無償労働のジェンダー格差は、上限の参考値である"]},"\n",{"tag":"p","props":{},"children":["数値は国家統計局の第3次全国時間利用調査によるもので、調査期間は 2024 年 5 月です。まず3つの用語について説明します。「無報酬労働」とは、労働はしたが報酬が得られない部分を指します。「参加者」とは、その日に実際にその活動を行った人を指します。「参加率」とは、その日にその活動を行った人の割合を指します。結果は以下の通りです。無報酬労働の参加者は、1日平均 2 時間 45 分を費やしており、その内訳は男性が 1 時間 52 分、女性が 3 時間 29 分です。参加率は 75.6% で、その内訳は男性が 67.5%、女性が 83.9% です。家事労働のみを取り出すと、全住民の平均では1日あたり 1 時間 17 分です。実際にその日に家事を行った人のみに限定すると、1 時間 59 分であり、2018 年と比較して 28 分減少しており、参加率は 64.9% です。家族の付き添い・介護のみを取り出すと、全住民の平均では 30 分です。実際にその日にそれを行った人のみに限定すると、1 時間 46 分であり、参加率は 28.4% です。"]},"\n",{"tag":"p","props":{},"children":["2018 年の第2次調査では以下の通りでした。家事労働は全住民の平均で 1 時間 26 分であり、その内訳は男性が 45 分、女性が 2 時間 6 分です。参加率は男性が 40.4%、女性が 75.6% です。育児の付き添い・世話は全住民の平均で 36 分であり、その内訳は男性が 17 分、女性が 53 分です。参加率は男性が 12.3%、女性が 25.1% です。"]},"\n",{"tag":"p","props":{},"children":["これら2回の調査はいずれも、性別、都市・農村、年齢層ごとに分類されており、既婚・未婚による分類は行われていません。したがって、「結婚後に毎日どれだけ家事が増えるか」という問いに対する公式な数値は存在しません。活用できるのは男女間の格差です。2024 年における無報酬労働の男女差は 1 時間 37 分です。もし家事分担が明確に話し合われていない場合、二人の間に生じうる格差の最大値は、少なくともこれほどまでのものになります。"]},"\n",{"tag":"h3","props":{"id":"金銭と家事デフォルトのルール書面による合意および家事への補償"},"children":["金銭と家事：デフォルトのルール、書面による合意、および家事への補償"]},"\n",{"tag":"p","props":{},"children":["結納金、結婚式、新居に関する項目については公式な統計がないため、本稿では数値を記載しません。明確に記述できるのは、民法典（婚姻家庭編）によって定められたルールです。民法典は 2021 年 1 月 1 日より施行されています。"]},"\n",{"tag":"ul","props":{},"children":["\n",{"tag":"li","props":{},"children":["第1062条：結婚の日から離婚の日までの期間に取得した以下の4つのものは、すべて二人の共有財産とみなされる。1. 給与、ボーナス、労務の報酬。2. 事業や投資による収益。3. 知的財産権による収益。4. 相続または第三者から贈与された財産。4つ目には例外がある：遺言または贈与契約において、一方のみに与える旨が明記されている場合は、共有財産には含まれない。共有財産については、二人が平等な処分権を有する。"]},"\n",{"tag":"li","props":{},"children":["第1063条：以下の4つは個人財産とみなされ、離婚の際にも共有財産には含まれない。1. 結婚前から所有していた財産。2. 身体の負傷に対して受け取った賠償金または補償金。3. 遺言または贈与契約において、一方のみに与える旨が明記されている財産。4. 一方が専用で使用する生活用品。"]},"\n",{"tag":"li","props":{},"children":["第1065条：婚前および婚後の財産が誰に帰属するかについては、二人が自ら合意することができる。各自の所有とする合意、すべてを共有とする合意、あるいは一部を各自の所有とし、一部を共有とする合意などが可能である。この合意は書面で行わなければならず、書面化されたものは二人に対して法的拘束力を持つ。合意がない場合、または合意の内容が不明確な場合は、上記の二つの条項に従うものとする。"]},"\n",{"tag":"li","props":{},"children":["第1088条：一方が育児、高齢者の介護、または相手方の仕事の補助などの理由により、相手方よりも多くの貢献をした場合、離婚の際に相手方に対して補償を請求することができる。補償額については、まず二人の協議によって決定し、協議が整わない場合は裁判所が判決を下す。"]},"\n"]},"\n",{"tag":"p","props":{},"children":["これらの規則は双方に適用される。稼ぎが多い方の当事者は、第1062条と第1065条を重点的に確認すべきである。家事負担が多い方の当事者は、第1088条を重点的に確認すべきである。財産の合意については、書面化されていることのみが求められ、法律上、公証役場での公証は必要とされない。"]},"\n",{"tag":"h3","props":{"id":"離脱コスト冷静期間と訴訟条件"},"children":["離脱コスト：冷静期間と訴訟条件"]},"\n",{"tag":"ul","props":{},"children":["\n",{"tag":"li","props":{},"children":["第1076条：夫婦双方が離婚に合意している場合は、まず書面による離婚協議書を作成し、その後、本人が婚姻届出機関へ申請を行うものとする。協議書には、子の監護権、財産および債務の処理方法を明記しなければならない。これらの内容は、双方の合意に基づいた意見でなければならない。"]},"\n",{"tag":"li","props":{},"children":["第1077条：届出機関が申請を受理した日から30日以内であれば、いずれの当事者も撤回することができる。この30日間が、いわゆる「冷静期間」である。冷静期間終了後の30日以内に、双方が本人として離婚届の受理を申請しなければならず、申請しなかった場合は、申請を撤回したものとみなす。"]},"\n",{"tag":"li","props":{},"children":["第1079条：一方の当事者が離婚を希望し、他方が同意しない場合は、まず調停を申し立てるか、直接裁判所に訴えを提起することができる。裁判所においても、まずは調停が行われる。裁判所が婚姻関係の破綻を認め、かつ調停が不成立であると判断した場合には、離婚を判決しなければならない。以下の事由に該当し、調停が不成立となった場合は、離婚を判決するものとする：重婚または他者との同居、家庭内暴力または虐待・遺棄、ギャンブルや薬物依存などの悪習が改善されない場合、不和による2年以上の別居。また、一度離婚の訴えが棄却された後、再び1年以上の別居期間を経て訴えを提起した場合には、離婚を判決するものとする。"]},"\n"]},"\n",{"tag":"p","props":{},"children":["2024 年の離婚件数のうち、351.3 万組のうち、89.1 万組は裁判所の判決または調停によるものである。冷静期間は協議離婚にのみ適用され、裁判による訴訟には適用されない。"]},"\n",{"tag":"h3","props":{"id":"法的な身分配偶者は近親者であり重い病気のとき代わりに判断できる"},"children":["法的な身分：配偶者は近親者であり、重い病気のとき代わりに判断できる"]},"\n",{"tag":"p","props":{},"children":["結婚すると、相手は法律上の近親者になります。民法典第1045条の近親者の一覧では、配偶者が最初に挙げられています。この身分が役立つのは、次のような場面です。"]},"\n",{"tag":"ul","props":{},"children":["\n",{"tag":"li","props":{},"children":["手術：第1219条では、手術、特殊な検査、特殊な治療について、まず患者本人にリスクを説明し、本人の明確な同意を得るよう定めています。本人が意識を失っていて説明できない場合や、本人への説明が適切でない場合は、医師が近親者に説明し、その同意を得ます。患者が意識のあるときは本人が署名するので、配偶者が代わることはできません。"]},"\n",{"tag":"li","props":{},"children":["救命：第1220条では、患者の命が危険な状態にあり、本人や近親者の意見を得られない場合、病院の責任者の承認を得て直ちに救命処置を行えると定めています。家族がその場にいなくても、法律は病院が先に救命することを認めています。"]},"\n",{"tag":"li","props":{},"children":["長期間、自分で判断できない場合：成人が民事行為能力を失った場合、第28条に定める後見人の順序は、配偶者が第1位、父母と子が第2位です。事前に書面で後見人を指定している場合は、第33条により指定された人が務めます。"]},"\n",{"tag":"li","props":{},"children":["相続：第1127条に定める第1順位の相続人は、配偶者、子、父母です。遺言がなければ、配偶者はあなたの子や父母とともに遺産を相続します。"]},"\n"]},"\n",{"tag":"p","props":{},"children":["この利点には二つの留保があります。第一に、第1219条は「近親者」としか書いておらず、その優先順位を定めていません。父母や成人した子も近親者なので、意見が食い違ったとき誰に従うかは法律に書かれていません。第二に、未婚のパートナーでも大部分を補えます。二人とも判断できるうちに、書面による授権委任、任意後見の合意、遺言を用意する方法です。",{"tag":"a","props":{"href":"/ja/book/10#10-18","title":"同性パートナーは、二人が意識がはっきりしているうちに、委任状、任意後見、および遺言を作成しておくべき：法律上、あなたたちは近親者ではないため、作成しなければ署名権も相続権もありません"},"children":["第10節第18項"]},"（授権委任、任意後見、遺言）を参照してください。その項目は同性のパートナーを扱っていますが、婚姻届を出していない異性のパートナーも三つの書類を用意できます。ただし、任意後見人が直接手術同意書に署名できるかは、病院によって扱いが異なります。結婚すれば、婚姻登録と同時にこれらの身分が一度に得られます。一つずつ手続きする必要がなく、病院や家族に書類を問題にされる手間も減ります。"]},"\n",{"tag":"h3","props":{"id":"関係の質-結婚しているか否かよりも計算に値する指標"},"children":["関係の質： 「結婚しているか否か」よりも計算に値する指標"]},"\n",{"tag":"p","props":{},"children":["Roblesら (2014) は、126 報の研究、7.2 万人以上のデータを集約した。結論は、婚姻の質が高いほど、健康状態が良いということである。ここでは、2つの事象の関連性の強さを、効果量 r という数値を用いて測定している。r が 0 に近いほど、2つの事象にはほとんど相関がないことを示す。r の絶対値が大きいほど、関連性が強いことを示す。r にマイナス符号がついている場合は、一方が高ければもう一方が低いことを意味する。これらの相関を示す r は、0.07 から 0.21 の間にある。そのうち、死亡リスクとの r = 0.11。対人葛藤時における心血管反応との r = −0.13。これらの数値は決して大きくはない。しかし、食生活の質といった健康行動と健康状態の関連性も、同程度の規模である。一部の結果には出版バイアス（好ましい結果ほど出版されやすい傾向）が存在する。男女差を専門に検証した研究もあるが、基本的には男女差は見られなかった。これらの研究の多くは単なる追跡調査であり、対照群を用いた比較ではないため、因果関係を導き出すことはできない。Dhindsaら (2020) による心血管に関するレビューでも、婚姻への満足度や婚姻の質が、心血管リスクに顕著な影響を与えることが指摘されている。"]},"\n",{"tag":"p","props":{},"children":["本文では、「質の低い結婚」と「未婚」の死亡率を直接比較したメタ分析は見つかりませんでした。したがって、「悪い結婚なら結婚しないほうがマシ」という主張は、現時点ではあくまで提唱されている説に過ぎず、それを裏付ける数値は存在しません。成立しているのは、「結婚しているか否か」という差異には選択バイアス（選択効果）が混在しており、「結婚の質が良いか悪いか」はそれとは別の独立した問題である、という点です。結婚の有無のみに注目し、その質を見落としてしまうと、結婚の質という要素を計算から完全に漏らしてしまうことになります。"]},"\n",{"tag":"h2","props":{"id":"三自分自身で計算する方法穴埋めリスト"},"children":["三、自分自身で計算する方法：穴埋めリスト"]},"\n",{"tag":"p","props":{},"children":["項目ごとに分けて記入してください。異なる項目の数値を合算しないでください。記入できない欄は「わからない」と記入してください。「わからない」ということも、それ自体が有用な情報です。"]},"\n",{"tag":"p","props":{},"children":["相手が提供できるもの（項目ごとに記入）"]},"\n",{"tag":"ul","props":{},"children":["\n",{"tag":"li","props":{},"children":["お金：相手の収入はいくらか、負債はいくらあるか、婚前財産は何か。婚後の財産については、法律のデフォルトのルールに従うのか、それとも書面による合意を作成するのか。合意を作成する場合、その内容に何を書くか。"]},"\n",{"tag":"li","props":{},"children":["時間：相手が現在、無償で行っている家事やケアに毎日どれくらいの時間を費やしているか。全国平均を比較対象にできます：実際に家事を行っている人のうち、男性は 1 時間 52 分、女性は 3 時間 29 分。結婚後、これらの役割をどのように分担するか。子供ができたり、介護が必要な高齢の親がいたりする場合、どのように分担するか。二人のうち、どちらの仕事の優先順位を下げることができるか。"]},"\n",{"tag":"li","props":{},"children":["関係の質：過去半年間で二人の間に何度衝突があったか、毎回最終的にどのように収束したか。あなたが病気、失業、あるいは気分の落ち込みに直面したとき、相手は何をしたか。逆に、相手がこれらの事態に直面したとき、あなたは何をしたか。"]},"\n",{"tag":"li","props":{},"children":["感情的価値：相手と一緒にいることで、エネルギーが増したと感じるか、それとも消耗したと感じるか。これは数ヶ月間一緒に過ごしてみないと分かりません。条件リストを見るだけでは判断できません。"]},"\n"]},"\n",{"tag":"p","props":{},"children":["自分が支払うべきもの（項目ごとに記入）"]},"\n",{"tag":"ul","props":{},"children":["\n",{"tag":"li","props":{},"children":["お金：結婚そのもののためにいくら支払う必要があるか（結納金、挙式、新居などを含む）。このお金を結婚に使わなかった場合、何に充てられるか。"]},"\n",{"tag":"li","props":{},"children":["時間：毎日、家事やケアにどれくらいの追加の時間を費やすことになるか。また、毎週、付き合いや社交にどれくらいの追加の時間を費やすことになるか、見積もってください。\n。"]},"\n",{"tag":"li","props":{},"children":["健康：自身の生活リズム、食事、運動が、結婚によって良くなるか、あるいは悪化するか。これはメタ分析から算出される数値よりも、あなた自身により密接に関わることです。"]},"\n",{"tag":"li","props":{},"children":["離脱コスト：協議離婚の手続きを進める場合、まず 30 日間の冷静期間を待ち、その後の 30 日以内に離婚届を提出しなければなりません。裁判所を通す場合は、第1079条に規定された事由を満たす必要があります。この期間、自分一人で耐え抜くことができるか。"]},"\n"]},"\n",{"tag":"p","props":{},"children":["法律による自己防衛（両方に適用）"]},"\n",{"tag":"ul","props":{},"children":["\n",{"tag":"li","props":{},"children":["結婚前の財産に、不動産売買契約書、銀行の取引明細、贈与契約書、遺言書などの証拠があるか。これらの証拠が「結婚前から存在していたこと」、あるいは「一方の固有財産であると明記されていること」を証明できるか。"]},"\n",{"tag":"li","props":{},"children":["書面による財産分与の合意を交わすべきか。この合意が、結婚前の財産のみを対象とするのか、結婚後の稼ぎのみを対象とするのか、あるいはその両方を対象とするのか。"]},"\n",{"tag":"li","props":{},"children":["結婚後、家事や介護をどちらがより多く担っているか。より多く担っている側が、第1088条に基づき補償を請求できることを知っているか。二人が事前に補償の方法について合意しておく意思があるか。"]},"\n",{"tag":"li","props":{},"children":["債務：結婚後に個人名義で借り入れたお金のうち、どれが二人の共同債務とみなされるか。もう一方がその借入について知っていたか。"]},"\n",{"tag":"li","props":{},"children":["重い病気や意識を失ったとき、誰に代わりに署名し、判断してほしいか。結婚すれば配偶者は近親者ですが、父母も近親者であり、意見が食い違うこともあります。一人を指定したい場合は、事前に書面で任意後見を取り決められます。結婚しない場合は、これらの手続きを自分で行う必要があります。"]},"\n"]},"\n",{"tag":"p","props":{},"children":["年長者の結婚に関する欄には、別途記入すること"]},"\n",{"tag":"ul","props":{},"children":["\n",{"tag":"li","props":{},"children":["年長者が得られるもの：精神的な安心感、面目の維持、結婚の催促からの解放、将来の介護の確保。"]},"\n",{"tag":"li","props":{},"children":["これらの中で、どれが真に年長者の利益であり、どれが実は自分自身の利益であるか。"]},"\n",{"tag":"li","props":{},"children":["上記3つの欄にかかるコストは、すべて自分自身が負担する。年長者が得る利益は、自動的に自分の健康になるわけでも、自動的に自分の人間関係の質になるわけでもない。"]},"\n",{"tag":"li","props":{},"children":["このように分けて書き終えた後、この計算が重いか軽いかは、記入者自身が判断すること。"]},"\n"]},"\n",{"tag":"h2","props":{"id":"四よくある誤解"},"children":["四、よくある誤解"]},"\n",{"tag":"p","props":{},"children":["二種類の離婚率を混同すること。一つは粗離婚率で、千人あたり何組の離婚が発生したかを計算したもので、2024 年は 2.5‰ である。もう一つは「離婚結婚比」で、その年の離婚件数をその年の婚姻件数で割ったもので、351.3 / 610.6 ≈ 57.5% である。離婚結婚比の分子と分母は同一の集団ではない。今年離婚した人たちの多くは、数年前に結婚した人たちである。婚姻数が減少すると、この比率は自然と上昇するため、「結婚の半分が離婚に至る」ということを示すものではない。民政部の公報にも、この指標は存在しない。"]},"\n",{"tag":"p","props":{},"children":["「同時発生」を「因果関係」と見なすこと。既婚者の死亡率は 12% ほど低いが、これは複数の研究を統合して算出された結果である。しかし、健康状態が良い、収入が高い、社交的であるといった条件は、もともと二つの事柄に同時に影響を与えるものである。すなわち、「人が結婚できるかどうか」と「人が長生きできるかどうか」である。この計算は可能だが、割り引いて見る必要があり、目の前の具体的な関係に対する判断の代わりにするべきではない。"]},"\n",{"tag":"p","props":{},"children":["結婚を「完了すべきタスク」と見なすこと。タスクと見なすと、「結婚したか否か」という状態のみに目が向き、「どのように過ごしているか」が見えなくなる。しかし、人間関係の質が健康に与える影響は、結婚の有無とは独立している。タスクとしての決定は、通常、この計算を完全に見落としてしまう。"]},"\n",{"tag":"p","props":{},"children":["全国平均を自分自身の数値と見なすこと。時間利用調査における男女差は、全国平均である。財産に関するルールは法律によるデフォルトの設定であり、書面による合意によって変更することができる。全国的な数字は、あくまで規模感や交渉の起点を示すものであり、結論を与えるものではない。"]},"\n",{"tag":"p","props":{},"children":["公式な統計データが存在しない箇所については、民間（非公式）の数値で埋めないでください。結納金、結婚式、子育てのコストについては公式な統計が存在しないため、本文では空欄としています。引用されたいかなる機関の推計値よりも、ご自身で入力される真実の数値の方が正確です。"]},"\n",{"tag":"h2","props":{"id":"出典"},"children":["出典"]},"\n",{"tag":"ul","props":{},"children":["\n",{"tag":"li","props":{},"children":["\n",{"tag":"p","props":{},"children":["民政部 (2025). 2024 年民政事業発展統計公報（五（二）1 婚姻登録サービス、注釈 5）. ",{"tag":"a","props":{"href":"https://www.mca.gov.cn/n1288/n1294/n1554/c1662004999980006190/content.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.mca.gov.cn/n1288/n1294/n1554/c1662004999980006190/content.html"]},"（PDF：",{"tag":"a","props":{"href":"https://www.mca.gov.cn/gdnps/n2445/n2451/n2458/n2681/c1662004999980006189/attr/400985.pdf","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.mca.gov.cn/gdnps/n2445/n2451/n2458/n2681/c1662004999980006189/attr/400985.pdf"]},"）"]},"\n"]},"\n",{"tag":"li","props":{},"children":["\n",{"tag":"p","props":{},"children":["国家統計局 (2024). 第三次全国時間利用調査公報（第一号、第二号、第三号）. ",{"tag":"a","props":{"href":"https://www.stats.gov.cn/sj/zxfb/202410/t20241031_1957217.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.stats.gov.cn/sj/zxfb/202410/t20241031_1957217.html"]},"、",{"tag":"a","props":{"href":"https://www.stats.gov.cn/sj/zxfb/202410/t20241031_1957216.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.stats.gov.cn/sj/zxfb/202410/t20241031_1957216.html"]},"、",{"tag":"a","props":{"href":"https://www.stats.gov.cn/sj/zxfb/202410/t20241031_1957215.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.stats.gov.cn/sj/zxfb/202410/t20241031_1957215.html"]},"；国家統計局社会科学司責任者記者会見. ",{"tag":"a","props":{"href":"https://www.stats.gov.cn/sj/sjjd/202410/t20241031_1957218.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.stats.gov.cn/sj/sjjd/202410/t20241031_19572