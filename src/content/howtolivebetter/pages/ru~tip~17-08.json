.org/2000/svg","width":"18","height":"18","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-up-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M7 7h10v10"},"children":[]},{"tag":"path","props":{"d":"M7 17 17 7"},"children":[]}]}]}]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/ru/book/17"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"К содержанию"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["Пожилые люди в семье"]},{"tag":"div","props":{"data-ad-dock-host":"true"},"children":[]},{"tag":"nav","props":{"aria-label":"Советы главы"},"children":[{"tag":"a","props":{"href":"/ru/tip/17-01"},"children":[{"tag":"span","props":{},"children":["01"]},"Возьмите согласие у пожилого человека, пока он в здравом уме, и оформите письменное назначение опекуна"]},{"tag":"a","props":{"href":"/ru/tip/17-02"},"children":[{"tag":"span","props":{},"children":["02"]},"Составление завещания: важно помнить, что более позднее завещание отменяет предыдущее, а нотариально заверенное больше не имеет приоритета"]},{"tag":"a","props":{"href":"/ru/tip/17-03"},"children":[{"tag":"span","props":{},"children":["03"]},"Деньги пожилых людей следует хранить отдельно на специальном счёте, а для крупных трат ввести правило двойного подтверждения"]},{"tag":"a","props":{"href":"/ru/tip/17-04"},"children":[{"tag":"span","props":{},"children":["04"]},"Фраза, которую пожилой человек может произнести в любой момент, чтобы отговориться от нежелательных предложений"]},{"tag":"a","props":{"href":"/ru/tip/17-05"},"children":[{"tag":"span","props":{},"children":["05"]},"Не стоит связываться ни с какими схемами «инвестиций в пенсионное обеспечение», где от пожилых людей требуют предоплаты: оформление карт, покупка мест в домах престарелых, приобретение жилья для пенсионеров, организация путешествий для пожилых и продажа товаров для них — всё это одна и та же схема незаконного привлечения средств"]},{"tag":"a","props":{"href":"/ru/tip/17-06"},"children":[{"tag":"span","props":{},"children":["06"]},"Не стоит связываться ни с какими другими программами «пенсия на основе недвижимости», кроме официальной программы страховых компаний. Ни в коем случае не давайте в залог свой дом ради покупки финансовых продуктов"]},{"tag":"a","props":{"href":"/ru/tip/17-07"},"children":[{"tag":"span","props":{},"children":["07"]},"Пожилые люди, которые длительное время лежат в постели или имеют тяжелую утрату функций, могут обратиться в органы медстраховки по месту регистрации за оформлением страховки на длительный уход; она предназначена не только для пожилых"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/ru/tip/17-08","data-status":"active"},"children":[{"tag":"span","props":{},"children":["08"]},"Если в семье кто-то длительное время прикован к постели, пролежни становятся главной угрозой: нужно купить электрическую воздушную подушку, регулярно переворачивать больного и каждый день проверять места с выступающими костями"]},{"tag":"a","props":{"href":"/ru/tip/17-09"},"children":[{"tag":"span","props":{},"children":["09"]},"Если катаракта у пожилого человека уже мешает безопасно ходить, идите к офтальмологу за оценкой операции; при двух глазах второй не откладывайте надолго"]},{"tag":"a","props":{"href":"/ru/tip/17-10"},"children":[{"tag":"span","props":{},"children":["10"]},"Если пожилой человек выгуливает собаку, держите поводок в ладони, а не наматывайте на руку, делайте его короче и сначала приучите собаку не рваться вперёд на поводке"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"Навигация"},"children":[{"tag":"a","props":{"href":"/ru/book"},"children":["Книга"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/ru/book/17"},"children":["Глава 17"," ·"," ","Пожилые люди в семье"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"17-08"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["08"]},{"tag":"span","props":{"className":"life-evidence grade-b"},"children":["Доказательства"," ","B"]}]},{"tag":"h1","props":{"lang":"ru"},"children":["Если в семье кто-то длительное время прикован к постели, пролежни становятся главной угрозой: нужно купить электрическую воздушную подушку, регулярно переворачивать больного и каждый день проверять места с выступающими костями"]},{"tag":"p","props":{"lang":"ru","className":"life-entry-summary"},"children":["Пролежни — это не просто поверхностная кожная травма. Среди 19 520 пациентов, перенесших операцию по вправлению перелома бедра, те, у кого пролежни были до операции, имели на 20 % более высокий риск умереть в течение 30 дней. Есть три проверенных способа снизить этот риск: использование электрической воздушной подушки уменьшает появление новых пролежней примерно на 60 % по сравнению с обычными матрасами; регулярное переворачивание снижает этот риск примерно на 70 %; также важно не оставлять человека долго в одном положении. Каждый день нужно осматривать копчик, пятки, бедра и область плеч — если появляется краснота, которая не исчезает при нажатии, следует немедленно вызвать медперсонал."]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Затраты"]},{"tag":"p","props":{},"children":["Электрические воздушные подушки для домашнего использовани…"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Польза"]},{"tag":"p","props":{},"children":["Исследования проводились среди 19 520 пациентов после операций по вправлению перелома бедра в США (база данных…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"Отметить: Если в семье кто-то длительное время прикован к постели, пролежни становятся главной угрозой: нужно купить электрическую воздушную подушку, регулярно переворачивать больного и каждый день проверять места с выступающими костями"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"Сделано"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"В планах"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"В избранное"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Поделиться советом"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Скрыть подробности"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Затраты"]},{"tag":"p","props":{},"children":["Электрические воздушные подушки для домашнего использования стоят от нескольких сотен юаней. Перевернуть человека занимает всего несколько минут. Однако проблема в том, что это нужно делать каждые два–три часа, даже ночью, а в одиночку справиться сложно."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Польза"]},{"tag":"p","props":{},"children":["Исследования проводились среди 19 520 пациентов после операций по вправлению перелома бедра в США (база данных NSQIP за 2016–2019 гг.). У тех, у кого пролежни были до операции, уровень смертности в течение 30 дней оказался выше. Даже после учета других факторов эта связь сохранялась (отношение шансов 1,2; риск возрастает на 21 %, p=0,004). Такие пациенты также чаще сталкивались с тромбозом глубоких вен (отношение шансов 1,59), пневмонией (1,39) и незапланированной повторной госпитализацией (1,43); средняя продолжительность пребывания в стационаре у них была на 0,4 дня больше. В другом исследовании за 18 месяцев наблюдали 324 пожилых пациента (в среднем 86 лет): наличие пролежней само по себе служило предиктором долгосрочной смертности (отношение рисков 1,500; 95 % доверительный интервал 1,059–2,126, p=0,020). В сетевом метаанализе 65 рандомизированных исследований сравнивали электрические воздушные подушки с обычными матрасами: использование подушек снижало частоту пролежней (отношение рисков 0,42; 95 % доверительный интервал 0,29–0,63, уровень доказательности — средний). Для гибридных систем этот показатель составил 0,22 (0,07–0,66). Обзор Cochrane, включавший 11 исследований с 4 462 участниками (обновлен в 2026 г.), показал, что разница между переворачиванием каждые 2 и 4 часа статистически незначима (отношение рисков 1,05; 95 % доверительный интервал 0,79–1,39, уровень доказательности — крайне низкий). В исследовании с применением носимых датчиков и визуальных оповещений у 1 226 пациентов отделения интенсивной терапии частота пролежней снизилась по сравнению с обычным уходом (отношение рисков 0,28; 95 % доверительный интервал 0,10–0,75, уровень доказательности — средний). Наконец, в исследовании с 116 участниками у пациентов, находившихся в положении лежа на животе, частота пролежней оказалась в 4,55 раза выше, чем у тех, кто лежал на спине (отношение рисков 4,55; 95 % доверительный интервал 2,31–8,98)."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Первоисточники"]},{"tag":"p","props":{"className":"life-citations"},"children":["Porter SB, Pla R, Chow JH, et al. (2022). Preoperative Pressure Ulcers, Mortality, and Complications in Older Hip Fracture Surgery Patients. JAAOS Global Research & Reviews, 6(11). ",{"tag":"a","props":{"href":"https://doi.org/10.5435/JAAOSGlobal-D-22-00117","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.5435/JAAOSGlobal-D-22-00117"]},"；Ottaviani S, Rondanina E, Longo E, 等 (2026). Impact of pressure ulcers and frailty on long-term mortality: a prospective cohort study of hospitalized older adults. European Geriatric Medicine, 17(2), 665-672. ",{"tag":"a","props":{"href":"https://doi.org/10.1007/s41999-025-01331-8","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1007/s41999-025-01331-8"]},"；Shi C, Dumville JC, Cullum N (2018). Support surfaces for pressure ulcer prevention: A network meta-analysis. PLoS ONE, 13(2), e0192707. ",{"tag":"a","props":{"href":"https://doi.org/10.1371/journal.pone.0192707","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1371/journal.pone.0192707"]},"；Latimer SL, Chaboyer WP, Probst S, 等 (2026). Repositioning for pressure injury prevention in adults. Cochrane Database of Systematic Reviews, 6, CD009958. ",{"tag":"a","props":{"href":"https://doi.org/10.1002/14651858.CD009958.pub4","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1002/14651858.CD009958.pub4"]}]},{"tag":"a","props":{"href":"https://doi.org/10.5435/JAAOSGlobal-D-22-00117","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Открыть источник"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Примечание автора"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["Оценка B обусловлена тремя причинами. Во-первых, в исследованиях по смертности лишь констатировалось, что у пациентов с пролежнями исход хуже; это не доказывает, что их предотвращение напрямую снижает смертность. Во-вторых, выводы по интервалам переворачивания в рандомизированных исследованиях крайне нестабильны. В-третьих, доказательства в пользу электрических воздушных подушек более убедительны, однако в исследованиях сравнивали их с больничными матрасами, а не с обычными домашними; поэтому перенос этих данных на бытовые условия требует осторожности. Ежедневный осмотр копчика, пяток, бедер и плеч на предмет красноты, не исчезающей при нажатии, является стандартной практикой сестринского ухода, но отдельных научных работ по этому вопросу нет. При расчете экономической эффективности учитывается именно смертность, а не прямые затраты на материалы. Информацию о том, какие услуги по уходу покрываются страховкой по долгосрочному уходу, см. в пункте 7 этого раздела. В случае внезапного отека ноги следует действовать по протоколу тромбоза глубоких вен (пункт 11 раздела 13). Ситуации, когда длительное пребывание в постели вызвано падением или тяжелой травмой, рассмотрены в пункте 34 раздела 1."]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Моя заметка"]},{"tag":"button","props":{"type":"button"},"children":["Запишите напоминание…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/ru/tip/17-07"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Предыдущий"]},"Пожилые люди, которые длительное время лежат в постели или имеют тяжелую утрату функций, могут обратиться в органы медстраховки по месту регистрации за оформлением страховки на длительный уход; она предназначена не только для пожилых"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/ru/tip/17-09"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Следующий"]},"Если катаракта у пожилого человека уже мешает безопасно ходить, идите к офтальмологу за оценкой операции; при двух глазах второй не откладывайте надолго"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["Другие советы по этой теме"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/17-02"},"children":[{"tag":"strong","props":{},"children":["Составление завещания: важно помнить, что более позднее завещание отменяет предыдущее, а нотариально заверенное больше не имеет приоритета"]},{"tag":"span","props":{},"children":["Закон признает шесть видов завещаний, но при несоблюдении формальных …"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/17-03"},"children":[{"tag":"strong","props":{},"children":["Деньги пожилых людей следует хранить отдельно на специальном счёте, а для крупных трат ввести правило двойного подтверждения"]},{"tag":"span","props":{},"children":["Мошенники сначала дарят пожилым мелочи и окружают заботой, накапливаю…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/17-04"},"children":[{"tag":"strong","props":{},"children":["Фраза, которую пожилой человек может произнести в любой момент, чтобы отговориться от нежелательных предложений"]},{"tag":"span","props":{},"children":["Продавцы и мошенники давят на месте, чтобы вы заплатили без размышлен…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/17-05"},"children":[{"tag":"strong","props":{},"children":["Не стоит связываться ни с какими схемами «инвестиций в пенсионное обеспечение», где от пожилых людей требуют предоплаты: оформление карт, покупка мест в домах престарелых, приобретение жилья для пенсионеров, организация путешествий для пожилых и продажа товаров для них — всё это одна и та же схема незаконного привлечения средств"]},{"tag":"span","props":{},"children":["Любая схема пенсионного обеспечения, где от пожилых людей требуют пре…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/17-06"},"children":[{"tag":"strong","props":{},"children":["Не стоит связываться ни с какими другими программами «пенсия на основе недвижимости», кроме официальной программы страховых компаний. Ни в коем случае не давайте в залог свой дом ради покупки финансовых продуктов"]},{"tag":"span","props":{},"children":["Существует лишь один официальный вариант такой пенсии — это программа…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/17-10"},"children":[{"tag":"strong","props":{},"children":["Если пожилой человек выгуливает собаку, держите поводок в ладони, а не наматывайте на руку, делайте его короче и сначала приучите собаку не рваться вперёд на поводке"]},{"tag":"span","props":{},"children":["В США число переломов у людей от 65 лет при прогулке с собакой на пов…"]}]}]}]},{"tag":"a","props":{"className":"life-text-link","href":"/ru/book/17"},"children":["Читать всю тему: Пожилые люди в семье"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"15","height":"15","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]}]}]}]},{"tag":"aside","props":{"className":"life-ad-space life-ad-space-sponsored","data-ad-placement":"ad_footer","data-ad-group":"reading","data-ad-creative":"read_product","data-ad-ready":"false","aria-label":"Реклама · Рекомендация сообщества"},"children":[{"tag":"div","props":{"className":"life-ad-space-brand"},