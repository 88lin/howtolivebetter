trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"このヒントを共有"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"詳細を閉じる"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["費用・手間"]},{"tag":"p","props":{},"children":["費用はかかりません。カレンダーから特定の日を選び、事前に家族や同僚に伝えておくだけです。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["効果"]},{"tag":"p","props":{},"children":["英国の喫煙者697名を2つのグループにランダムに分けました。一方のグループは禁煙当日に一気にやめ、もう一方のグループは禁煙日の2週間前から喫煙量を75%減らしました。両グループとも看護師による行動支援を受け、禁煙日前後にはニコチン代替療法を使用しました。4週目時点では、一気にやめたグループの49.0%（95% CI 43.8–54.2）が再喫煙に至らなかったのに対し、徐々に減らしたグループは39.2%（34.0–44.4）で、相対リスク比は0.80（0.66–0.93）でした。6ヶ月後には、一気にやめたグループが22.0%（18.0–26.6）、徐々に減らしたグループが15.5%（12.0–19.7）となり、相対リスク比は0.71（0.46–0.91）でした。もともと徐々に減らすことを好んでいた人の4週目の成功率も、一気にやめることを好む人より低い結果となりました（38.3% 対 52.2%）。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["出典"]},{"tag":"p","props":{"className":"life-citations"},"children":["Lindson-Hawley N, Banting M, West R, Michie S, Shinkins B, Aveyard P (2016). Gradual Versus Abrupt Smoking Cessation: A Randomized, Controlled Noninferiority Trial. Annals of Internal Medicine, 164(9), 585–592. ",{"tag":"a","props":{"href":"https://doi.org/10.7326/M14-2805","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.7326/M14-2805"]},"；Theodoulou A, Chepkin SC, Ye W, et al. (2023). Different doses, durations and modes of delivery of nicotine replacement therapy for smoking cessation. Cochrane Database of Systematic Reviews, 6, CD013308（提前用尼古丁替代品那一段）. ",{"tag":"a","props":{"href":"https://doi.org/10.1002/14651858.CD013308.pub2","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1002/14651858.CD013308.pub2"]}]},{"tag":"a","props":{"href":"https://doi.org/10.7326/M14-2805","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["出典を開く"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["著者の注記"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["論争。Cochraneには以前、これら2つの方法を比較した専用のレビューがあり、結論は両者に大きな差はない（RR 0.94, 95% CI 0.79–1.13, 10試験、3760人）というものでしたが、そのレビューは2019年に撤回され、更新もされていません。したがって、現時点で最も有力なエビデンスは上記のランダム化比較試験であり、その方向性は「一気にやめる」ことを支持しています。また、その試験では両グループとも禁煙日の前からニコチン代替療法を開始していました。この手法自体にもエビデンスがあります。禁煙当日に開始するよりも、事前に開始する方が成功率が約25%高いことが示されています（RR 1.25, 95% CI 1.08–1.44, 9試験、4395人、中程度の確実性エビデンス）。したがって、合理的な計画は、まず日を決めて、2週間前から準備（代替療法など）を開始し、その日に一気にやめることです。"]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["自分のメモ"]},{"tag":"button","props":{"type":"button"},"children":["自分へのメモを書く…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/ja/tip/02-03"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["前へ"]},"禁煙は我慢するだけでなく、まずは薬を：成功率は2倍以上に向上"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/ja/tip/02-05"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["次へ"]},"禁煙外来を受診するか、12320 に電話して、お住まいの地域に禁煙サービスがあるか確認する"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["このテーマの他の提案"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/02-01"},"children":[{"tag":"strong","props":{},"children":["禁煙、早ければ早いほど良い"]},{"tag":"span","props":{},"children":["喫煙者は非喫煙者に比べ、平均して10年以上寿命が短い。40歳までに禁煙すれば、喫煙を続けることによる死亡リスクを約9割取り除くことができる…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/02-02"},"children":[{"tag":"strong","props":{},"children":["自宅や車内での喫煙は避け、客人に自宅での喫煙もさせない"]},{"tag":"span","props":{},"children":["世界では毎年約60万人が受動喫煙により死亡しており、そのうちの約3割は子供である。長期的な受動喫煙は、高血圧、心臓病、脳卒中のリスクを約3…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/02-06"},"children":[{"tag":"strong","props":{},"children":["禁煙できないなら電子タバコを検討すべきだが、もともと非喫煙者は手を出さないこと"]},{"tag":"span","props":{},"children":["タバコをニコチン含有の電子タバコに替えることで、ニコチンパッチを使用する人よりも約6割多く禁煙に成功するという結論は非常に信頼性が高い。し…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/02-07"},"children":[{"tag":"strong","props":{},"children":["糖分入口的飲料を控えるだけでは不十分、糖類ゼロへの置き換えも解決策にはならない"]},{"tag":"span","props":{},"children":["毎日2本以上の甘い飲料を飲む人は、ほとんど飲まない人に比べて、同時期の死亡率が約2割高い。毎日1〜2本飲む人も、1割以上高い。糖類ゼロのも…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/02-08"},"children":[{"tag":"strong","props":{},"children":["ビンロウ（アレカナッツ）を噛まない"]},{"tag":"span","props":{},"children":["ビンロウを噛む人は、噛まない人に比べて死亡率が約2割高い。糖尿病や代謝症候群のリスクも5割近く高い。口腔がんや食道がんのリスクは別途考慮す…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/02-09"},"children":[{"tag":"strong","props":{},"children":["家庭で使用する食塩を低ナトリウム塩（カリウム塩）に切り替える"]},{"tag":"span","props":{},"children":["脳卒中の既往歴がある方