ve":"false","style":{"top":"94px"}},"children":[{"tag":"div","props":{"className":"life-ad-dock","hidden":true},"children":[{"tag":"aside","props":{"className":"life-ad-space life-ad-space-sponsored life-ad-space-compact","data-ad-placement":"ad_dock","data-ad-group":"reading","data-ad-creative":"read_product","data-ad-ready":"false","aria-label":"Advertisement · Community recommendation"},"children":[{"tag":"button","props":{"type":"button","className":"life-ad-dismiss","aria-label":"Close ad"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-x","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M18 6 6 18"},"children":[]},{"tag":"path","props":{"d":"m6 6 12 12"},"children":[]}]}]},{"tag":"div","props":{"className":"life-ad-space-brand"},"children":[{"tag":"img","props":{"src":"/sites/howtolivebetter/images/shengcai/logo.png","width":"565","height":"144","alt":"Official Shengcai Youshu logo","decoding":"async"},"children":[]}]},{"tag":"div","props":{"className":"life-ad-space-copy"},"children":[{"tag":"span","props":{"className":"life-ad-space-label"},"children":["Advertisement · Community recommendation"]},{"tag":"strong","props":{},"children":["Could what you know become a useful product?"]},{"tag":"p","props":{},"children":["From ebooks to small tools, explore how members spot needs and turn knowledge into something people can use."]}]},{"tag":"div","props":{"className":"life-ad-space-actions"},"children":[{"tag":"a","props":{"className":"life-ad-space-link","href":"/en/shengcaiyoushu?sc_group=reading&sc_creative=read_product&sc_placement=ad_dock"},"children":["Explore the community and examples",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"18","height":"18","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-up-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M7 7h10v10"},"children":[]},{"tag":"path","props":{"d":"M7 17 17 7"},"children":[]}]}]}]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/en/book/06"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"Back to index"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["Items to avoid"]},{"tag":"div","props":{"data-ad-dock-host":"true"},"children":[]},{"tag":"nav","props":{"aria-label":"Chapter entries"},"children":[{"tag":"a","props":{"href":"/en/tip/06-01"},"children":[{"tag":"span","props":{},"children":["01"]},"Don’t take multivitamins for longevity or heart protection"]},{"tag":"a","props":{"href":"/en/tip/06-02"},"children":[{"tag":"span","props":{},"children":["02"]},"Don’t take regular fish oil capsules to prevent heart disease"]},{"tag":"a","props":{"href":"/en/tip/06-03"},"children":[{"tag":"span","props":{},"children":["03"]},"Don’t give vitamin D supplements to people who already have enough"]},{"tag":"a","props":{"href":"/en/tip/06-04"},"children":[{"tag":"span","props":{},"children":["04"]},"Don’t take antioxidant supplements to prevent cancer (beta-carotene, vitamin E, vitamin A)"]},{"tag":"a","props":{"href":"/en/tip/06-05"},"children":[{"tag":"span","props":{},"children":["05"]},"Don’t expect glucosamine/chondroitin to treat knee osteoarthritis"]},{"tag":"a","props":{"href":"/en/tip/06-06"},"children":[{"tag":"span","props":{},"children":["06"]},"Don’t rely on vitamin C to prevent colds"]},{"tag":"a","props":{"href":"/en/tip/06-07"},"children":[{"tag":"span","props":{},"children":["07"]},"Don’t get a whole-body PET-CT or tumor marker panel if you have no symptoms"]},{"tag":"a","props":{"href":"/en/tip/06-08"},"children":[{"tag":"span","props":{},"children":["08"]},"Don’t expect fitness trackers or smartwatches to help you lose weight"]},{"tag":"a","props":{"href":"/en/tip/06-09"},"children":[{"tag":"span","props":{},"children":["09"]},"Don’t pay a premium for organic food just to be “healthier”"]},{"tag":"a","props":{"href":"/en/tip/06-10"},"children":[{"tag":"span","props":{},"children":["10"]},"Don’t spend a lot of money on health supplements, herbal formulas, or tonics to “improve your health”"]},{"tag":"a","props":{"href":"/en/tip/06-11"},"children":[{"tag":"span","props":{},"children":["11"]},"Don’t take probiotics long-term if you have no gut problems"]},{"tag":"a","props":{"href":"/en/tip/06-12"},"children":[{"tag":"span","props":{},"children":["12"]},"Don’t force yourself to take cold showers just to “boost immunity”"]},{"tag":"a","props":{"href":"/en/tip/06-13"},"children":[{"tag":"span","props":{},"children":["13"]},"Don’t buy products marketed for detox, colon cleansing, enzymes, or alkaline water"]},{"tag":"a","props":{"href":"/en/tip/06-14"},"children":[{"tag":"span","props":{},"children":["14"]},"Don’t force yourself to drink water just to hit “8 glasses a day”"]},{"tag":"a","props":{"href":"/en/tip/06-15"},"children":[{"tag":"span","props":{},"children":["15"]},"Don’t spend money on fortune‑telling, tarot, or astrology to make decisions"]},{"tag":"a","props":{"href":"/en/tip/06-16"},"children":[{"tag":"span","props":{},"children":["16"]},"Don’t buy blue-light-blocking glasses to “protect your vision,” and don’t believe claims that staring at screens for months will ruin your eyes — but severe eye pain, redness, and swelling require immediate medical attention"]},{"tag":"a","props":{"href":"/en/tip/06-17"},"children":[{"tag":"span","props":{},"children":["17"]},"Don’t treat blood donation as a health habit: claims that it “detoxifies, lowers cholesterol, and prevents heart attacks” lack randomized trial support, while frequent donation truly causes iron deficiency"]},{"tag":"a","props":{"href":"/en/tip/06-18"},"children":[{"tag":"span","props":{},"children":["18"]},"Don’t rely on generic health check packages to prevent disease; instead, get the evidence‑based screenings appropriate for your age and gender"]},{"tag":"a","props":{"href":"/en/tip/06-19"},"children":[{"tag":"span","props":{},"children":["19"]},"Don’t start taking uric‑acid‑lowering drugs just because a checkup shows high uric acid but you’ve never had symptoms"]},{"tag":"a","props":{"href":"/en/tip/06-20"},"children":[{"tag":"span","props":{},"children":["20"]},"Don’t have a gallbladder removed prophylactically just because an ultrasound found gallstones but you’ve never felt any pain"]},{"tag":"a","props":{"href":"/en/tip/06-21"},"children":[{"tag":"span","props":{},"children":["21"]},"Don’t cut calcium out to prevent kidney stones"]},{"tag":"a","props":{"href":"/en/tip/06-22"},"children":[{"tag":"span","props":{},"children":["22"]},"Don’t buy crystals, bracelets, or Pixiu figurines for “good luck,” “wealth attraction,” or “health benefits”"]},{"tag":"a","props":{"href":"/en/tip/06-23"},"children":[{"tag":"span","props":{},"children":["23"]},"Don’t expect shopping to lift your mood or boost your sense of self-worth"]},{"tag":"a","props":{"href":"/en/tip/06-24"},"children":[{"tag":"span","props":{},"children":["24"]},"Don’t spend extra money to “move up a rung” among your peers by buying a new house, car, or social circle"]},{"tag":"a","props":{"href":"/en/tip/06-25"},"children":[{"tag":"span","props":{},"children":["25"]},"Don’t believe that “willpower is like a muscle that runs out after use”"]},{"tag":"a","props":{"href":"/en/tip/06-26"},"children":[{"tag":"span","props":{},"children":["26"]},"Don’t expect skipping breakfast or the 16:8 intermittent fasting method to help you control your weight; instead, pick a meal timing you can stick to long-term"]},{"tag":"a","props":{"href":"/en/tip/06-27"},"children":[{"tag":"span","props":{},"children":["27"]},"Do not believe that \"masturbation harms the body\" or that \"abstinence is the only way to improve\"; what truly matters is whether it interferes with your sleep, work, and relationships"]},{"tag":"a","props":{"href":"/en/tip/06-28"},"children":[{"tag":"span","props":{},"children":["28"]},"Do not spend money on \"conversion therapy\" or \"gay علاج,\" and do not send your family members to undergo it either"]},{"tag":"a","props":{"href":"/en/tip/06-29"},"children":[{"tag":"span","props":{},"children":["29"]},"Do not expect “correct lifting posture” or lifting training to prevent back pain; reduce the weight and number of lifts, and exercise regularly"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/en/tip/06-30","data-status":"active"},"children":[{"tag":"span","props":{},"children":["30"]},"Do not expect extra calcium or bone broth to make a fracture heal faster"]},{"tag":"a","props":{"href":"/en/tip/06-31"},"children":[{"tag":"span","props":{},"children":["31"]},"Don’t rely on an AI chatbot alone to judge a medical or legal problem; before seeing a doctor, going to court or spending big money, find the source it cites and check it against the original"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"Breadcrumb"},"children":[{"tag":"a","props":{"href":"/en/book"},"children":["Explore the book"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/en/book/06"},"children":["Chapter 6"," ·"," ","Items to avoid"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"06-30"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["30"]},{"tag":"span","props":{"className":"life-evidence grade-b"},"children":["Evidence"," ","B"]}]},{"tag":"h1","props":{"lang":"en"},"children":["Do not expect extra calcium or bone broth to make a fracture heal faster"]},{"tag":"p","props":{"lang":"en","className":"life-entry-summary"},"children":["None of the randomized trials of vitamin D supplementation after a fracture found better bone healing. Studies combining calcium and vitamin D are scarce, so their benefit is uncertain. A large bowl of bone broth contains only a small fraction of the calcium you need each day. People with an existing vitamin D deficiency or osteoporosis are a separate case."]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Cost"]},{"tag":"p","props":{},"children":["It costs nothing and saves the money and effort spent on c…"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Benefit"]},{"tag":"p","props":{},"children":["Start with vitamin D. A 2023 systematic review included 14 studies involving 2,734 fracture patients. The auth…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"Mark: Do not expect extra calcium or bone broth to make a fracture heal faster"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"Done"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"Plan to do"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"Save"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Share this tip"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Hide details"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Cost"]},{"tag":"p","props":{},"children":["It costs nothing and saves the money and effort spent on calcium tablets, vitamin D, and making broth every day. Supplement a deficiency if testing identifies one; otherwise, do not take extra supplements."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Benefit"]},{"tag":"p","props":{},"children":["Start with vitamin D. A 2023 systematic review included 14 studies involving 2,734 fracture patients. The authors concluded that vitamin D alone had little effect on bone healing, whether the fracture united, or function after recovery. Studies reporting benefits generally had lower quality. The authors stated that when only randomized trials were considered, none showed a benefit from supplementation. One trial enrolled 100 people with long-bone fractures and low vitamin D. Half received a single dose of 100,000 IU within two weeks of injury; half received a placebo. Two people in each group had nonunion, or 4% overall. Another trial enrolled 102 people aged 18 to 50 with femoral or tibial fractures, assigning them to four groups receiving different doses or placebo. Healing scores showed no differences at 3 or 12 months. Another study enrolled 32 postmenopausal women with wrist fractures. Compared with no supplementation, the high-dose group receiving the equivalent of 1,800 IU daily had lower bone resistance to compression. Now consider calcium. A 2014 systematic review found few clinical studies on how vitamin D deficiency or supplementation affects fracture healing, with inconclusive results. The two studies it found combined calcium and vitamin D; they measured increased bone density or callus—newly formed bone—at the fracture site, rather than how quickly the fracture healed. Finally, bone broth: a study in Kaohsiung, Taiwan, tested three kinds of noodle dishes with bone broth, each containing 450 to 550 grams of broth. Average calcium content was 14 to 39 milligrams per serving, or 1.4% to 3.9% of the recommended daily 1,000 milligrams. The authors concluded that one serving provided less than 5% of the daily recommendation. China recommends 800 milligrams daily for ages 18 to 49 and 1,000 milligrams for people aged 50 and older, with an upper limit of 2,000 milligrams daily. That standard states that long-term excessive calcium intake increases kidney stone risk. A U.S. trial enrolled 36,282 postmenopausal women, giving them 1,000 milligrams of calcium plus 400 IU of vitamin D daily and following them for an average of 7 years. Kidney stone risk was about 17% higher (HR 1.17, 95% CI 1.02–1.34, the confidence interval). Hip fractures were about 12% less frequent, but the difference was not statistically significant (HR 0.88, 0.72–1.08). The approach seems good value because of the intuition that bones are made of calcium, so eating more calcium should make them heal faster."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Original sources"]},{"tag":"p","props":{"className":"life-citations"},"children":["Gatt T, Grech A, Arshad H (2023). The Effect of Vitamin D Supplementation for Bone Healing in Fracture Patients: A Systematic Review. Advances in Orthopedics, 2023, 6236045. ",{"tag":"a","props":{"href":"https://doi.org/10.1155/2023/6236045","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1155/2023/6236045"]},"；Haines N, Kempton LB, Seymour RB, et al. (2017). The effect of a single early high-dose vitamin D supplement on fracture union in patients with hypovitaminosis D: a prospective randomised trial. Bone & Joint Journal, 99-B(11), 1520-1525. ",{"tag":"a","props":{"href":"https://doi.org/10.1302/0301-620X.99B11.BJJ-2017-0271.R1","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1302/0301-620X.99B11.BJJ-2017-0271.R1"]},"；Slobogean GP, Bzovsky S, O'Hara NN, et al. (2023). Effect of Vitamin D3 Supplementation on Acute Fracture Healing: A Phase II Screening Randomized Double-Blind Controlled Trial. JBMR Plus, 7, e10705. ",{"tag":"a","props":{"href":"https://doi.org/10.1002/jbm4.10705","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1002/jbm4.10705"]},"；Heyer FL, de Jong JJ, Willems PC, et al. (2021). The Effect of Bolus Vitamin D3 Supplementation on Distal Radius Fracture Healing: A Randomized Controlled Trial Using HR-pQCT. Journal of Bone and Mineral Research, 36, 1492-1501. ",{"tag":"a","props":{"href":"https://doi.org/10.1002/jbmr.4311","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1002/jbmr.4311"]},"；Gorter EA, Hamdy NA, Appelman-Dijkstra NM, Schipper IB (2014). The role of vitamin D in human fracture healing: a systematic review of the literature. Bone, 64, 288-297. ",{"tag":"a","props":{"href":"https://doi.org/10.1016/j.bone.2014.04.026","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1016/j.bone.2014.04.026"]},"；Hsu DJ, Lee CW, Tsai WC, Chien YC (2017). Essential and toxic metals in animal bone broths. Food & Nutrition Research, 61, 1347478（表 2、表 3）. ",{"tag":"a","props":{"href":"https://doi.org/10.1080/16546628.2017.1347478","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1080/16546628.2017.1347478"]},"；国家卫生和计划生育委员会 (2018). WS/T 578.2—2018 中国居民膳食营养素参考摄入量 第 2 部分：常量元素（表 1；定义 3.7）. ",{"tag":"a","props":{"href":"https://www.nhc.gov.cn/wjw/yingyang/201805/f2c614be95fe41dba8123c23a6e6fb55/files/1739783539207_73894.pdf","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.nhc.gov.cn/wjw/yingyang/201805/f2c614be95fe41dba8123c23a6e6fb55/files/1739783539207_73894.pdf"]},"；Jackson RD, LaCroix AZ, Gass M, et al. (2006). Calcium plus vitamin D supplementation and the risk of fractures. New England Journal of Medicine, 354(7), 669-683. ",{"tag":"a","props":{"href":"https://doi.org/10.1056/NEJMoa055218","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1056/NEJMoa055218"]},"；Doetsch AM, Faber J, Lynnerup N, et al. (2004). The effect of calcium and vitamin D3 supplementation on the healing of the proximal humerus fracture: a randomized placebo-controlled study. Calcified Tissue International, 75, 183-188. ",{"tag":"a","props":{"href":"https://doi.org/10.1007/s00223-004-0167-0","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1007/s00223-004-0167-0"]},"（备注里那项）；Gorter EA, Krijnen P, Schipper IB (2017). Vitamin D status and adult fracture healing. Journal of Clinical Orthopaedics and Trauma, 8(1), 34-37. ",{"tag":"a","props":{"href":"https://doi.org/10.1016/j.jcot.2016.09.003","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1016/j.jcot.2016.09.003"]},"（备注里那项）"]},{"tag":"a","props":{"href":"https://doi.org/10.1155/2023/6236045","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Open source link"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Book note"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["Points of uncertainty: there are two small signals of possible benefit. A Danish trial enrolled 30 older women with fractures of the upper arm near the shoulder who had osteoporosis or low bone mass. Those receiving 800 IU of vitamin D plus 1 gram of calcium daily had higher bone density at the fracture site at week 6 (0.623 versus 0.570 g/cm²). But it measured only bone density, not whether the bone had healed, and had too few participants. A post hoc analysis of the 102-person trial found slightly better functional scores with high-dose vitamin D; the authors said further trials were needed to confirm this. Existing vitamin D deficiency is a separate case. A Dutch observational study found delayed healing in 9.7% of people who remained deficient after supplementation, compared with 0.3% of those who were not deficient initially and 1.7% of those whose deficiency was corrected. This was observational and cannot establish causation. If testing finds a deficiency, follow your doctor’s advice to restore normal levels. People with diagnosed osteoporosis or a fracture after a minor fall need osteoporosis medication; see section 1, item 40 (osteoporosis medication). Calcium tablets cannot replace it. Long-term supplementation offers no benefit for people without vitamin D deficiency; see item 3 in this section (vitamin D supplements). The point is to avoid excessive extra supplementation, not to eat less calcium. Keep getting enough calcium in your meals; see item 21 in this section (cutting out calcium to prevent kidney stones). For what to do after a fall when a fracture is suspected, see section 13, item 41 (suspected fracture). The benefit rating is medium, based on a year’s spending on calcium tablets and vitamin D. You are the person who benefits."]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["My note"]},{"tag":"button","props":{"type":"button"},"children":["Write a reminder for yourself…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/en/tip/06-29"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Previous"]},"Do not expect “correct lifting posture” or lifting training to prevent back pain; reduce the weight and number of lifts, and exercise regularly"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/en/tip/06-31"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Next"]},"Don’t rely on an AI chatbot alone to judge a medical or legal problem; before seeing a doctor, going to court or spending big money, find the source it cites and check it against the original"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["More in this topic"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/en/tip/06-23"},"children":[{"tag":"strong","props":{},"children":["Don’t expect shopping to lift your mood or boost your sense of self-worth"]},{"tag":"span","props":{},"children":["On average, people who place a higher value on money and material pos…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/en/tip/06-24"},"children":[{"tag":"strong","props":{},"children":["Don’t spend extra money to “move up a rung” among your peers by buying a new house, car, or social circle"]},{"tag":"span","props":{},"children":["When comparing people with similar incomes, those whose neighbors ear…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/en/tip/06-25"},"children":[{"tag":"strong","props":{},"children":["Don’t believe that “willpower is like a muscle that runs out after use”"]},{"tag":"span","props":{},"children":["The popular idea is that after doing something that requires self‑con…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/en/tip/06-26"},"children":[{"tag":"strong","props":{},"children":["Don’t expect skipping breakfast or the 16:8 intermittent fasting method to help you control your weight; instead, pick a meal timing you can stick to long-term"]},{"tag":"span","props":{},"children":["Popular belief holds that skipping breakfast leads