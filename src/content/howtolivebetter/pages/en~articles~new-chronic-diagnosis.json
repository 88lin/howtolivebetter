24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-up-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M7 7h10v10"},"children":[]},{"tag":"path","props":{"d":"M7 17 17 7"},"children":[]}]}]}]}]}]}]},{"tag":"main","props":{"className":"life-longread"},"children":[{"tag":"a","props":{"className":"life-back-link active","href":"/en/articles","data-status":"active","aria-current":"page"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"All long reads"]},{"tag":"header","props":{"className":"life-longread-header"},"children":[{"tag":"div","props":{},"children":[{"tag":"div","props":{"className":"life-eyebrow"},"children":["Long reads"]},{"tag":"h1","props":{"lang":"en"},"children":["Right After a Chronic Disease Diagnosis: The First Week, First Three Months, and After"]},{"tag":"p","props":{"lang":"en"},"children":["This checklist is for people newly diagnosed with chronic conditions such as hypertension, diabetes, high blood lipids, or gout. Related entries in the book are spread across sever…"]},{"tag":"a","props":{"className":"life-longread-chapter","href":"/en/book/16"},"children":["Related chapter"," · ","How to live after being diagnosed with a chronic disease",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"img","props":{"src":"/sites/howtolivebetter/images/book-chapters/16-chronic-care-editorial.webp","srcSet":"/sites/howtolivebetter/images/book-chapters/16-chronic-care-editorial-thumb.webp 600w, /sites/howtolivebetter/images/book-chapters/16-chronic-care-editorial-md.webp 900w, /sites/howtolivebetter/images/book-chapters/16-chronic-care-editorial.webp 1200w","sizes":"(max-width: 760px) 100vw, 450px","alt":"","width":"1200","height":"800","fetchPriority":"high"},"children":[]}]},{"tag":"div","props":{"className":"life-longread-layout"},"children":[{"tag":"aside","props":{"className":"life-longread-toc"},"children":[{"tag":"details","props":{"open":true},"children":[{"tag":"summary","props":{},"children":["On this page"]},{"tag":"nav","props":{"aria-label":"On this page"},"children":[{"tag":"a","props":{"href":"#the-week-of-diagnosis"},"children":["The week of diagnosis"]},{"tag":"a","props":{"href":"#the-first-three-months"},"children":["The first three months"]},{"tag":"a","props":{"href":"#after-the-condition-is-stable"},"children":["After the condition is stable"]}]}]}]},{"tag":"div","props":{"className":"life-longread-main"},"children":[{"tag":"article","props":{"className":"life-article-body","lang":"en"},"children":[{"tag":"blockquote","props":{},"children":["\n",{"tag":"p","props":{},"children":["Unofficial English translation of ",{"tag":"a","props":{"href":"/articles/new-chronic-diagnosis"},"children":["docs/刚确诊慢性病之后.md"]},". In case of discrepancies the Chinese original takes precedence."]},"\n"]},"\n",{"tag":"p","props":{},"children":["This checklist is for people newly diagnosed with chronic conditions such as hypertension, diabetes, high blood lipids, or gout. Related entries in the book are spread across several sections; here they are ordered by time. Each line states only the action; reasons, numbers, and sources are in the entry cited. Skip items that do not apply to your condition."]},"\n",{"tag":"h2","props":{"id":"the-week-of-diagnosis"},"children":["The week of diagnosis"]},"\n",{"tag":"ol","props":{},"children":["\n",{"tag":"li","props":{},"children":["If the illness is serious, have someone go with you when you get the report; do not stay alone at home that day. Put off resigning, selling a home, and similar steps. See ",{"tag":"a","props":{"href":"/en/book/29"},"children":["Section 29, item 2"]}," (the week after a serious diagnosis)."]},"\n",{"tag":"li","props":{},"children":["If the doctor prescribed medication, start today and follow the prescription; do not stop because you feel better. See ",{"tag":"a","props":{"href":"/en/book/16"},"children":["Section 16, item 1"]}," (take medication as prescribed)."]},"\n",{"tag":"li","props":{},"children":["For hypertension and high blood lipids, take medicine regularly; do not stop on your own. See ",{"tag":"a","props":{"href":"/en/book/02"},"children":["Section 2, item 12"]}," (hypertension and high blood lipids: take medicine as prescribed)."]},"\n",{"tag":"li","props":{},"children":["If you have hypertension, buy a home blood-pressure monitor and measure at home until readings reach target. See ",{"tag":"a","props":{"href":"/en/book/01"},"children":["Section 1, item 7"]}," (measure blood pressure and treat to target)."]},"\n",{"tag":"li","props":{},"children":["When getting prescriptions, ask whether centralized-procurement or generic drugs are available. See ",{"tag":"a","props":{"href":"/en/book/05"},"children":["Section 5, item 12"]}," (generics and centralized procurement)."]},"\n",{"tag":"li","props":{},"children":["At diagnosis of type 2 diabetes, have a dilated eye exam once; for type 1, start five years after onset. See ",{"tag":"a","props":{"href":"/en/book/16"},"children":["Section 16, item 7"]}," (eye exam at diabetes diagnosis)."]},"\n",{"tag":"li","props":{},"children":["At diagnosis of gout, start long-term urate-lowering therapy and keep serum uric acid below 360 µmol/L. See ",{"tag":"a","props":{"href":"/en/book/16"},"children":["Section 16, item 9"]}," (long-term urate-lowering for gout)."]},"\n",{"tag":"li","props":{},"children":["Before allopurinol in people of Han ethnicity, ask whether to test HLA-B*5801 genotype. See ",{"tag":"a","props":{"href":"/en/book/16"},"children":["Section 16, item 9"]}," (long-term urate-lowering for gout)."]},"\n",{"tag":"li","props":{},"children":["High uric acid on a check-up alone, with no gout attacks ever, is not gout; do not start urate-lowering drugs yet. See ",{"tag":"a","props":{"href":"/en/book/06"},"children":["Section 6, item 19"]}," (high uric acid without gout pain)."]},"\n",{"tag":"li","props":{},"children":["If you smoke, set a quit date and stop completely that day. See ",{"tag":"a","props":{"href":"/en/book/02"},"children":["Section 2, item 4"]}," (set a quit date)."]},"\n",{"tag":"li","props":{},"children":["Do not rely on willpower alone for quitting; go to a smoking-cessation clinic or respiratory medicine for medication. See ",{"tag":"a","props":{"href":"/en/book/02"},"children":["Section 2, item 3"]}," (get medication to quit)."]},"\n"]},"\n",{"tag":"h2","props":{"id":"the-first-three-months"},"children":["The first three months"]},"\n",{"tag":"ol","props":{},"children":["\n",{"tag":"li","props":{},"children":["Keep a notebook: at each follow-up, record date, test results, drugs, and doses. See ",{"tag":"a","props":{"href":"/en/book/16"},"children":["Section 16, item 3"]}," (one notebook for all readings)."]},"\n",{"tag":"li","props":{},"children":["After each visit, keep your own copy of records, lab reports, and imaging. See ",{"tag":"a","props":{"href":"/en/book/24"},"children":["Section 24, item 5"]}," (keep your own medical records)."]},"\n",{"tag":"li","props":{},"children":["In your insurance locality, apply for outpatient chronic/special-disease designation; if you often seek care elsewhere, also file for cross-region treatment. See ",{"tag":"a","props":{"href":"/en/book/16"},"children":["Section 16, item 2"]}," (chronic outpatient designation and cross-region filing)."]},"\n",{"tag":"li","props":{},"children":["If a family member has employee medical insurance, ask them to link family pooling so their account can pay for your care and medicine. See ",{"tag":"a","props":{"href":"/en/book/05"},"children":["Section 5, item 13"]}," (family pooling)."]},"\n",{"tag":"li","props":{},"children":["Before signing with a community family doctor, ask what is covered by insurance and what is self-pay. See ",{"tag":"a","props":{"href":"/en/book/16"},"children":["Section 16, item 6"]}," (ask before signing with a family doctor)."]},"\n",{"tag":"li","props":{},"children":["Switch household salt to low-sodium salt. If you have kidney impairment or take potassium-sparing drugs, ask the doctor first. See ",{"tag":"a","props":{"href":"/en/book/02"},"children":["Section 2, item 9"]}," (low-sodium salt)."]},"\n",{"tag":"li","props":{},"children":["Start walking daily; aim for 7,000–8,000 steps or 150–300 minutes of brisk walking per week. See ",{"tag":"a","props":{"href":"/en/book/02"},"children":["Section 2, item 11"]}," (7,000–8,000 steps a day)."]},"\n",{"tag":"li","props":{},"children":["Drink less alcohol; best is none. See ",{"tag":"a","props":{"href":"/en/book/02"},"children":["Section 2, item 19"]}," (less or no alcohol)."]},"\n",{"tag":"li","props":{},"children":["If you drink daily and get shakes or palpitations when you stop, do not quit alone; go to the hospital first. See ",{"tag":"a","props":{"href":"/en/book/02"},"children":["Section 2, item 20"]}," (do not quit alcohol cold turkey alone)."]},"\n",{"tag":"li","props":{},"children":["If someone urges you to stop meds for folk remedies, do not stop; tell your treating doctor before any supplement. See ",{"tag":"a","props":{"href":"/en/book/16"},"children":["Section 16, item 4"]}," (do not stop treatment for folk remedies or supplements)."]},"\n",{"tag":"li","props":{},"children":["Do not spend heavily on health products or tonic formulas to “condition” the body. See ",{"tag":"a","props":{"href":"/en/book/06"},"children":["Section 6, item 10"]}," (expensive health products and tonics)."]},"\n",{"tag":"li","props":{},"children":["When starting urate-lowering therapy for gout, attacks are more common in the first 3–6 months. If pain flares, add anti-inflammatory medicine as directed; do not stop urate-lowering drugs. See ",{"tag":"a","props":{"href":"/en/book/16"},"children":["Section 16, item 9"]}," (long-term urate-lowering for gout)."]},"\n",{"tag":"li","props":{},"children":["Before buying cold or pain medicines yourself, read ingredients; acetaminophen should appear in only one product. See ",{"tag":"a","props":{"href":"/en/book/34"},"children":["Section 34, item 1"]}," (acetaminophen in only one product)."]},"\n",{"tag":"li","props":{},"children":["If you take anticoagulants or steroids, ask the doctor before ibuprofen-type pain relievers. See ",{"tag":"a","props":{"href":"/en/book/34"},"children":["Section 34, item 3"]}," (ibuprofen with anticoagulants or steroids)."]},"\n"]},"\n",{"tag":"h2","props":{"id":"after-the-condition-is-stable"},"children":["After the condition is stable"]},"\n",{"tag":"ol","props":{},"children":["\n",{"tag":"li","props":{},"children":["When stable and medications unchanged, get up to 12 weeks of medication in one community visit. See ",{"tag":"a","props":{"href":"/en/book/16"},"children":["Section 16, item 5"]}," (12-week prescriptions at community clinics)."]},"\n",{"tag":"li","props":{},"children":["Follow the follow-up interval your doctor set; record every visit in the same notebook. See ",{"tag":"a","props":{"href":"/en/book/16"},"children":["Section 16, item 3"]}," (follow-up on schedule)."]},"\n",{"tag":"li","props":{},"children":["After switching to centralized-procurement drugs, watch the notebook metrics; if they truly worsen, see the doctor—do not stop on your own. See ",{"tag":"a","props":{"href":"/en/book/05"},"children":["Section 5, item 12"]}," (generics and centralized procurement)."]},"\n",{"tag":"li","props":{},"children":["With diabetes, have a foot exam yearly and eye exams at the interval your doctor gives. See ",{"tag":"a","props":{"href":"/en/book/16"},"children":["Section 16, item 7"]}," (eye exam at diabetes diagnosis; annual foot exam)."]},"\n",{"tag":"li","props":{},"children":["With gout, keep taking urate-lowering medicine even after uric acid reaches target. See ",{"tag":"a","props":{"href":"/en/book/16"},"children":["Section 16, item 9"]}," (long-term urate-lowering for gout)."]},"\n",{"tag":"li","props":{},"children":["After kidney stones, drink 2.5–3 liters of water daily and keep salt under 6 g. See ",{"tag":"a","props":{"href":"/en/book/16"},"children":["Section 16, item 8"]}," (water after kidney stones)."]},"\n",{"tag":"li","props":{},"children":["With cardiovascular disease, get one flu shot each autumn. See ",{"tag":"a","props":{"href":"/en/book/01"},"children":["Section 1, item 20"]}," (annual flu vaccine)."]},"\n",{"tag":"li","props":{},"children":["For common illnesses, start at community level; for hospitalization, go up through referral so the inpatient deductible continues. See ",{"tag":"a","props":{"href":"/en/book/24"},"children":["Section 24, item 1"]}," (community first, tiered referral)."]},"\n",{"tag":"li","props":{},"children":["Within the same insurance pool, each higher hospital tier lowers reimbursement by about ten percentage points—do not climb tiers without need. See ",{"tag":"a","props":{"href":"/en/book/24"},"children":["Section 24, item 2"]}," (lower tier, higher reimbursement)."]},"\n",{"tag":"li","props":{},"children":["For specialist care at a major hospital, use community referral or the hospital referral center; do not use scalpers. See ",{"tag":"a","props":{"href":"/en/book/24"},"children":["Section 24, item 3"]}," (referral center)."]},"\n",{"tag":"li","props":{},"children":["Before cross-province care, ask locally how much will be reimbursed back home—it may be less than treating locally. See ",{"tag":"a","props":{"href":"/en/book/24"},"children":["Section 24, item 4"]}," (ask before cross-province care)."]},"\n"]},"\n"]},{"tag":"footer","props":{"className":"life-article-attribution"},"children":[{"tag":"p","props":{},"children":["This essay is reproduced from the open-source HowToLiveBetter project, preserving the original wording and verification notes. Refer to the original repository for updates."]},{"tag":"a","props":{"href":"https://github.com/dlgrv/HowToLiveBetter/blob/5a8aac6e715851066661ab6524c3a4e650f7e9d7/docs/research/en/Right-After-A-Chronic-Disease-Diagnosis.md","target":"_blank","rel":"noopener noreferrer"},"children":["View source revision · 5a8aac6",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"14","height":"14","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]},{"tag":"span","props":{},"children":["Imported: 2026-10-11"]},{"tag":"p","props":{},"children":["Entry links point to the matching topic in this site’s imported edition; source numbering may differ from the current entry number."]}]},{"tag":"div","props":{"className":"life-quick-share"},"children":[{"tag":"button","props":{"type":"button"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-copy","aria-hidden":"true"},"children":[{"tag":"rect","props":{"width":"14","height":"14","x":"8","y":"8","rx":"2","ry":"2"},"ch