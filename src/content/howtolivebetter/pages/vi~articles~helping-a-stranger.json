]},{"tag":"img","props":{"src":"/sites/howtolivebetter/images/book-chapters/13-emergency-editorial.webp","srcSet":"/sites/howtolivebetter/images/book-chapters/13-emergency-editorial-thumb.webp 600w, /sites/howtolivebetter/images/book-chapters/13-emergency-editorial-md.webp 900w, /sites/howtolivebetter/images/book-chapters/13-emergency-editorial.webp 1200w","sizes":"(max-width: 760px) 100vw, 450px","alt":"","width":"1200","height":"800","fetchPriority":"high"},"children":[]}]},{"tag":"div","props":{"className":"life-longread-layout"},"children":[{"tag":"aside","props":{"className":"life-longread-toc"},"children":[{"tag":"details","props":{"open":true},"children":[{"tag":"summary","props":{},"children":["Trên trang này"]},{"tag":"nav","props":{"aria-label":"Trên trang này"},"children":[{"tag":"a","props":{"href":"#ba-con-đường"},"children":["Ba con đường"]},{"tag":"a","props":{"href":"#các-chi-phí-có-thể-phát-sinh-sau-khi-dừng-lại-từ-nhẹ-đến-nặng"},"children":["Các chi phí có thể phát sinh sau khi dừng lại, từ nhẹ đến nặng"]},{"tag":"a","props":{"href":"#ba-tình-huống-mà-bỏ-đi-không-còn-miễn-phí"},"children":["Ba tình huống mà bỏ đi không còn miễn phí"]},{"tag":"a","props":{"href":"#khi-đã-quyết-định-dừng-lại-cách-làm-tốn-ít-công-sức-nhất"},"children":["Khi đã quyết định dừng lại, cách làm tốn ít công sức nhất"]},{"tag":"a","props":{"href":"#nguồn"},"children":["Nguồn"]}]}]}]},{"tag":"div","props":{"className":"life-longread-main"},"children":[{"tag":"article","props":{"className":"life-article-body","lang":"vi"},"children":[{"tag":"p","props":{},"children":["Đây là bản viết dài của ",{"tag":"a","props":{"href":"/vi/book/13#13-02","title":"Người cao tuổi ngã hoặc ai đó nằm gục: ngồi xuống gọi họ, gọi 120 ở Trung Quốc, đừng vội đỡ dậy; với người lạ, bỏ đi ở Trung Quốc cũng hợp pháp, đã dừng thì đừng tự di chuyển họ"},"children":["mục 2 ở phần 13"]}," (người lớn tuổi ngã, có người nằm bất tình, đừng vội dỡ ngay lên). Cả cuốn sách xếp người hưởng lợi thành bốn bậc, tiêu chuẩn xếp là mức độ lợi ích đó sau này quay lại người bạn bao nhiêu. Người lạ nằm ở bậc thấp nhất. Khả năng đối phương đền đáp lại cho bạn thì nhỏ, bạn cũng không biết người đó là người thế nào. Vì vậy bài này không khuyên bạn nên làm gì. Nó chỉ liệt kê đầy đủ cái giá của từng trong ba con đường, đi đường nào thì bạn tự quyết."]},"\n",{"tag":"p","props":{},"children":[{"tag":"strong","props":{},"children":["Bài này không đưa xác suất nào."]}," Mỗi tầng chi phí dưới đây đều có thật, và đều tra được điều luật. Nhưng \"trong một trăm người được cứu thật sự có mấy người dính chuyện\" thì không có thống kê công khai. Quy tắc của cả cuốn sách là số không chắc thì thôi không viết. Vậy nên đừng đọc \"ở đây liệt kê bảy tầng\" thành \"bảy tầng này sẽ rơi hết lên bạn\"."]},"\n",{"tag":"h2","props":{"id":"ba-con-đường"},"children":["Ba con đường"]},"\n",{"tag":"div","props":{"className":"article-table-scroll","tabIndex":"0"},"children":[{"tag":"table","props":{},"children":[{"tag":"thead","props":{},"children":["\n",{"tag":"tr","props":{},"children":["\n",{"tag":"th","props":{},"children":[]},"\n",{"tag":"th","props":{},"children":["Bỏ đi"]},"\n",{"tag":"th","props":{},"children":["Dừng lại nhưng không chạm vào"]},"\n",{"tag":"th","props":{},"children":["Dừng lại và giúp đến cùng"]},"\n"]},"\n"]},"\n",{"tag":"tbody","props":{},"children":["\n",{"tag":"tr","props":{},"children":["\n",{"tag":"td","props":{},"children":["Hợp pháp"]},"\n",{"tag":"td","props":{},"children":["Hợp pháp. Người bình thường không có nghĩa vụ cứu người lạ, và trong Bộ luật Hình sự cũng không có tội \"thấy mà không cứu\". Đây là ở Trung Quốc; các nước như Đức khác, xem dưới đây"]},"\n",{"tag":"td","props":{},"children":["Hợp pháp"]},"\n",{"tag":"td","props":{},"children":["Hợp pháp"]},"\n"]},"\n",{"tag":"tr","props":{},"children":["\n",{"tag":"td","props":{},"children":["Thời gian"]},"\n",{"tag":"td","props":{},"children":["0"]},"\n",{"tag":"td","props":{},"children":["Vài phút. Gọi 120 thì số của bạn được lưu lại"]},"\n",{"tag":"td","props":{},"children":["Nửa ngày trở lên, có thể phải đi theo tới bệnh viện"]},"\n"]},"\n",{"tag":"tr","props":{},"children":["\n",{"tag":"td","props":{},"children":["Khả năng sau đó bị người ta tìm đến"]},"\n",{"tag":"td","props":{},"children":["Thấp nhất"]},"\n",{"tag":"td","props":{},"children":["Bạn là người đã để lại số điện thoại"]},"\n",{"tag":"td","props":{},"children":["Cao nhất"]},"\n"]},"\n",{"tag":"tr","props":{},"children":["\n",{"tag":"td","props":{},"children":["Đối phương được lợi gì"]},"\n",{"tag":"td","props":{},"children":["0"]},"\n",{"tag":"td","props":{},"children":["Xe cứu thương tới sớm hơn"]},"\n",{"tag":"td","props":{},"children":["Nhiều nhất"]},"\n"]},"\n"]},"\n"]}]},{"tag":"h2","props":{"id":"các-chi-phí-có-thể-phát-sinh-sau-khi-dừng-lại-từ-nhẹ-đến-nặng"},"children":["Các chi phí có thể phát sinh sau khi dừng lại, từ nhẹ đến nặng"]},"\n",{"tag":"p","props":{},"children":[{"tag":"strong","props":{},"children":["Một, bị gọi lại điện thoại và bị hỏi lời."]}," Bạn gọi 120 hoặc 110 thì số của bạn đều được lưu lại. Người kia có thể gọi lại, hỏi rõ vị trí ở đâu. Sau đó cũng có thể bảo bạn tới làm lời khai một lần. Nếu là vụ án hình sự thì người báo án không bắt buộc phải nêu tên trước công chúng, và cơ quan giải quyết vụ việc phải giữ kín danh tính cho họ (Điều 111 của Bộ luật Tố tụng Hình sự). Gọi 120 thì không có quy định giữ bí mật như vậy."]},"\n",{"tag":"p","props":{},"children":[{"tag":"strong","props":{},"children":["Hai, bị người nhà của người bị thương tìm đến."]}," Nếu trong hình ảnh giám sát không tìm ra chiếc xe gây ra chuyện, người mà gia đình dễ tìm nhất chính là bạn. Vì bạn đã để lại số điện thoại, lúc đó lại đang ở hiện trường. Họ có thể gọi đi giục, cũng có thể tìm tận nhà."]},"\n",{"tag":"p","props":{},"children":[{"tag":"strong","props":{},"children":["Ba, bị kiện ra tòa."]}," Ai nói bạn đâm người thì người đó phải đưa ra chứng cứ. Người đó không đưa được chứng cứ thì hậu quả do người đó tự gánh chịu (Điều 90 của Giải thích về việc áp dụng Bộ luật Tố tụng Dân sự). ",{"tag":"strong","props":{},"children":["Nhưng điều khoản này chỉ quy định cách tuyên cuối cùng, không quy định bạn có bị kéo vào hay không."]}," Vụ án xét xử theo thủ tục thông thường, bản nhất phải kết thúc trong 6 tháng, có trường hợp đặc biệt thì kéo dài thêm 6 tháng. Theo thủ tục rút gọn thì là 3 tháng (Điều 152 và 164 của Bộ luật Tố tụng Dân sự). Ngay cả khi bạn thắng hoàn toàn, bên kia cũng chỉ bị bắt trả ba khoản: lệ phí tiếp nhận vụ án, lệ phí nộp đơn, và chi phí đi lại cùng thu nhập bị mất của người làm chứng và người giám định khi ra tòa (Điều 6 và 29 của Quy chế thu phí kiện tụng). ",{"tag":"strong","props":{},"children":["Tiền bạc bạn tự bỏ ra thuê luật sư không nằm trong ba khoản đó, bạn phải tự trả."]}]},"\n",{"tag":"p","props":{},"children":[{"tag":"strong","props":{},"children":["Bốn, làm rối tới chỗ làm."]}," Có người tới nơi làm của bạn gây rối thì bạn có thể báo cảnh sát. Người làm mất trật tự doanh nghiệp, đơn vị sự nghiệp, làm cho công việc không thể tiến hành bình thường thì cảnh sát phạt cảnh cáo, hoặc phạt tiền dưới 500 tệ. Tình tiết nặng hơn thì bị giữ 5 đến 10 ngày, cộng thêm phạt tiền dưới 1000 tệ. Một nhóm người cùng đi gây rối thì người cầm đầu bị giữ 10 đến 15 ngày (Điều 26, khoản 1 của Luật Xử phạt vi phạm hành chính về trật tự công cộng). Người cứ gây phiền, quấy rầm, theo dõi, làm cho bạn không sống bình thường nổi thì xử phạt theo Điều 50, khoản 5. Với sự đồng ý của người phụ trách cơ quan công an, còn có thể yêu cầu người đó không được tiếp xúc với bạn trong một khoảng thời gian nhất định. Nếu công ty vì chuyện này mà bị sa thải bạn thì đại đa số là chấm dứt hợp đồng lao động trái pháp luật, tiền bồi thường tính theo 2N (",{"tag":"a","props":{"href":"/vi/book/19#19-06","title":"Công ty chấm dứt hợp đồng sai luật thì tiền bồi thường bằng hai lần mức bồi thường kinh tế"},"children":["mục 6 ở phần 19"]},"). Nhưng dù báo cảnh sát hay đi hoà giải lao động thì bạn vẫn phải tự đi từng chuyến. Còn khoảng thời gian mất việc trước đó, sau này có nhận được 2N thì cũng không bù lại được."]},"\n",{"tag":"p","props":{},"children":[{"tag":"strong","props":{},"children":["Năm, bị người ta quay phim rồi đăng lên mạng."]}," ",{"tag":"strong","props":{},"children":["Bạn không chắc ngăn được người ta quay."]}," Không có sự đồng ý của chủ thể thì không được tạo ra, sử dụng, công khai hình ảnh của người khác (Điều 1019 của Bộ luật Dân sự). Nhưng có một ngoại lệ. 「为实施新闻报道，不可避免地制作、使用、公开肖像权人的肖像」 được tính là sử dụng hợp lý, không phải xâm phạm (Điều 1020, khoản 2). Nhà báo quay phim để làm tin thì thuộc loại ngoại lệ đó. Việc bạn làm được là không trả lời phỏng vấn, không lộ diện, không nói trước ống kính. Đồng ý hay không thì bạn tự quyết, không ai có thể đồng ý thay bạn được."]},"\n",{"tag":"p","props":{},"children":[{"tag":"strong","props":{},"children":["Sáu, video bị đưa đi rích rắc, rồi bị chửi."]}," Video một khi lan ra thì phần bình luận không còn do bạn kiểm soát. Những cách bạn tự làm được thì đã viết trong Quy chế quản lý thông tin quấy rầy trên mạng (có hiệu lực từ ngày 1 tháng 8 năm 2024). Nền tảng phải đưa cho bạn mấy thiết lập bảo vệ sau: chặn người lạ hoặc một người cụ thể do bạn chỉ định, giới hạn ai nhìn thấy thông tin của chính bạn. Bạn còn có thể cấm người khác đăng lại hoặc bình luận, chỉ nhận tin nhắn riêng từ bạn bè, hoặc không nhận tin nhắn riêng của ai (Điều 23). Nền tảng phải có chức năng lấy bằng chứng bằng một cú bấm, để cố định lại nội dung chửi bạn (Điều 25). Nền tảng phải đặt một lối vào tố cáo và báo việc riêng ở vị trí dễ thấy (Điều 26). Nền tảng phát hiện nội dung nghi ngờ vi phạm pháp hoặc tội phạm thì phải báo kịp thời với cơ quan công an và cung cấp đầu mối (Điều 15). Tự lưu bằng chứng thế nào, báo cảnh sát thế nào, xem ",{"tag":"a","props":{"href":"/vi/book/08#08-15","title":"Người thân cận nói 「không ai muốn sống yên」, 「tao đưa con đi cùng」 thì đừng coi là lời giận: người thân gần có thể đưa họ đi khám, công an đã nhận báo cáo cũng phải xử lý"},"children":["mục 15 ở phần 8"]},"."]},"\n",{"tag":"p","props":{},"children":[{"tag":"strong","props":{},"children":["Bảy, lúc không chịu nổi."]}," Sáu tầng trên đều lấy điều luật ra đối phó được, tầng thứ bảy thì không. Bị đám đông vây khốn một thời gian dài thì ảnh hưởng tới tâm trạng đến mức nào, trong nước không có dữ liệu đáng tin để dẫn. Cuốn sách này không đưa số, chỉ đưa một lối ra: đường dây nóng hỗ trợ tâm lý 12356, xem ",{"tag":"a","props":{"href":"/vi/book/01#01-25","title":"Bị trầm cảm hoặc có ý nghĩ tự sát thì bấm 12356, trong nhà không tích trữ thuốc ngủ và thuốc trừ sâu"},"children":["mục 25 ở phần 1"]},"."]},"\n",{"tag":"h2","props":{"id":"ba-tình-huống-mà-bỏ-đi-không-còn-miễn-phí"},"children":["Ba tình huống mà bỏ đi không còn miễn phí"]},"\n",{"tag":"ul","props":{},"children":["\n",{"tag":"li","props":{},"children":["\n",{"tag":"p","props":{},"children":[{"tag":"strong","props":{},"children":["Bạn đang ở nước ngoài."]}," «Bỏ đi hợp pháp» ở trên nói về luật Trung Quốc. Một số nước coi không cứu người gặp nguy là tội. Điều 323c Bộ luật Hình sự Đức quy định: gặp tai nạn, nguy hiểm chung hoặc tình thế nguy cấp, nếu cứu giúp là cần thiết và có thể trông đợi ở bạn xét hoàn cảnh, đặc biệt là không khiến bản thân gặp nguy hiểm lớn và không vi phạm nghĩa vụ quan trọng khác, mà bạn không giúp thì bị phạt tối đa 1 năm tù hoặc phạt tiền. Mỗi nước quy định khác nhau; ở đâu theo luật nước ấy."]},"\n"]},"\n",{"tag":"li","props":{},"children":["\n",{"tag":"p","props":{},"children":[{"tag":"strong","props":{},"children":["Bạn là người kinh doanh hay quản lý nơi chuyện này xảy ra, hoặc là người tổ chức hoạt động tập thể."]}," Nơi chỗ ở đây là khách sạn, trung tâm thương mại, ngân hàng, nhà ga, sân bay, nhà thi đấu thể thao, nơi giải trí và những chỗ cùng loại. Bạn có nghĩa vụ bảo đảm an toàn đối với người ở trong đó. Không làm tròn nghĩa vụ này thì bạn phải chịu trách nhiệm tố tùng, tức là phải bồi tiền. Nếu hậu quả do người khác gây ra mà bạn vẫn không làm tròn nghĩa vụ thì bạn phải bồi trong phần thuộc trách nhiệm của mình, đó gọi là trách nhiệm bổ sung (Điều 1198 của Bộ luật Dân sự). Nên nhân viên trực ca, hay chính nơi chỗ, khi bỏ đi thì gánh trách nhiệm khác với một người đi đường bỏ đi."]},"\n"]},"\n",{"tag":"li","props":{},"children":["\n",{"tag":"p","props":{},"children":[{"tag":"strong","props":{},"children":["Chuyện này vốn đã liên quan tới bạn."]}," Người đó bị bạn đâm, chiếc xe là của bạn, hoặc nguy hiểm do hành vi trước đó của bạn gây ra. Lúc này đáng nhìn vào không phải là có nên lo cho người khác hay không, mà là xử lý tai nạn giao thông và bỏ trốn tại nơi gây tai nạn thế nào, xem ",{"tag":"a","props":{"href":"/vi/book/08#08-01","title":"Tai nạn giao thông: dừng xe, cứu người, báo công an, đừng bỏ chạy"},"children":["mục 1 ở phần 8"]},"."]},"\n"]},"\n"]},"\n",{"tag":"h2","props":{"id":"khi-đã-quyết-định-dừng-lại-cách-làm-tốn-ít-công-sức-nhất"},"children":["Khi đã quyết định dừng lại, cách làm tốn ít công sức nhất"]},"\n",{"tag":"ol","props":{},"children":["\n",{"tag":"li","props":{},"children":[{"tag":"strong","props":{},"children":["Đừng bỏ tay vào bêng hay dỡ người."]}," Chuyện này không có câu trả lời thứ hai. Lý do nằm ở y tế: dỡ mạnh tay có thể làm xuất huyết não nặng hơn, cũng có thể làm chấn thương cột sống nặng hơn. Về pháp lý thì không phải lo: thiệt hại phát sinh trong lúc cứu người đã được miễn trừ bởi Điều 184 của Bộ luật Dân sự."]},"\n",{"tag":"li","props":{},"children":["Đứng cách ra một chút rồi gọi anh ta, xem anh ta còn thở không. Không thở thì ấn mạnh vào ngực anh ta, xem ",{"tag":"a","props":{"href":"/vi/book/13#13-01","title":"Người ngã xuống đất không thở: ấn thật mạnh vào giữa ngực ngay, bảo người bên cạnh gọi 120 và tìm máy AED"},"children":["mục 1 ở phần 13"]},". Còn thở thì đứng tại chỗ gọi 120, báo rõ vị trí."]},"\n",{"tag":"li","props":{},"children":["Kéo một người đi đường cùng làm, đồng thời mở điện thoại quay video. Có người chứng kiến, lại có video, hữu dụng hơn là cãi lại với người ta về sau."]},"\n",{"tag":"li","props":{},"children":["Đừng một mình bêng anh ta lên xe, cũng đừng tự bỏ tiền đưa anh ta đi bệnh viện. Bước này tốn tiền nhất, và sau đó cũng khéo tàn nhất."]},"\n",{"tag":"li","props":{},"children":["Bạn bị thương khi đi cứu người, hoặc bạn đã bỏ tiền vào. Muốn đòi số tiền đó lại thì xem ",{"tag":"a","props":{"href":"/vi/book/13#13-39","title":"Cứu người mà bị thương, mất tiền: tìm người gây hại và bảo hiểm y tế trước, rồi đi khai báo hành động dũng cảm để được xác nhận"},"children":["mục 39 ở phần 13"]}," (bị thương khi cứu người, bỏ tiền vào, phải làm gì)."]},"\n"]},"\n",{"tag":"h2","props":{"id":"nguồn"},"children":["Nguồn"]},"\n",{"tag":"ul","props":{},"children":["\n",{"tag":"li","props":{},"children":["全国人大 (2020). 民法典（第一百八十四、一千零一十九、一千零二十、一千一百九十八条）. 最高人民检察院转载全文. ",{"tag":"a","props":{"href":"https://www.spp.gov.cn/spp/fl/202006/t20200602_463888.shtml","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.spp.gov.cn/spp/fl/202006/t20200602_463888.shtml"]}]},"\n",{"tag":"li","props":{},"children":["最高人民法院 (2022 年第二次修正，2022 年 4 月 10 日施行). 关于适用《中华人民共和国民事诉讼法》的解释（第九十条）. ",{"tag":"a","props":{"href":"https://www.court.gov.cn/zixun/xiangqing/353651.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.court.gov.cn/zixun/xiangqing/353651.html"]}]},"\n",{"tag":"li","props":{},"children":["全国人大常委会 (2023 年修正，2024 年 1 月 1 日施行). 民事诉讼法（第一百五十二、一百六十四条）. 上海市发展和改革委员会转载全文. ",{"tag":"a","props":{"href":"https://fgw.sh.gov.cn/ys-syjf-zc-2.4.1-h5/20240408/073febdb2b04464390546232d4089f51.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://fgw.sh.gov.cn/ys-syjf-zc-2.4.1-h5/20240408/073febdb2b04464390546232d4089f51.html"]}]},"\n",{"tag":"li","props":{},"children":["国务院 (2006). 诉讼费用交纳办法（国务院令第 481 号，第六、二十九条）. ",{"tag":"a","props":{"href":"https://www.gov.cn/ziliao/flfg/2006-12/29/content_483682.htm","target":"_blank","rel":"noopener noreferrer"},"children