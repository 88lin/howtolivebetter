"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["原书备注"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["争议。这些都是跟着人群观察出来的关联，不是分组对照试验，谁因谁果分不开。身体本来就差的人，更容易独居、更少社交。作者把社会关系看作和吸烟、肥胖同一量级的健康因素，但没有随机试验证明「增加社交能降低死亡率」。这条与第 3 节「减少让你消耗的人际关系」不冲突：那条砍掉消耗你的关系，这里要保住让你恢复精力的那几段"]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["我的备注"]},{"tag":"button","props":{"type":"button"},"children":["写下对自己有用的提醒…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/tip/22-08"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["上一条"]},"当场想缓过来，用 5 分钟「循环叹息」：吸气两段，呼气拉长"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/tip/22-10"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["下一条"]},"选住处时把周边绿地算进去，但别指望「多去公园」就延寿"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["本主题的其他建议"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/22-02"},"children":[{"tag":"strong","props":{},"children":["点单前要价目表，娱乐场所必须明码标价，不接受「先玩后算」"]},{"tag":"span","props":{},"children":["按规定，娱乐场所卖服务、卖东西都必须明码标价，还要主动把价目表拿给你看。所谓「天价酒水」，几乎都出在没看过价目表、事后按口头报价结账的场合…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/22-03"},"children":[{"tag":"strong","props":{},"children":["场子里有人递「东西」就立刻走，容留和提供都不是「帮朋友」"]},{"tag":"span","props":{},"children":["娱乐场所不许贩毒、不许提供毒品，也不许留人在里面吸，违反的要停业整顿 3 到 6 个月，重的吊销许可证。你自己吸要受治安处罚。在你订的包厢…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/22-04"},"children":[{"tag":"strong","props":{},"children":["不吃陌生人给的糖和零食，不喝离开过视线的饮料，不接别人递的烟弹"]},{"tag":"span","props":{},"children":["现在的毒品不长毒品的样子。掺了合成大麻素的「上头」电子烟，看着和普通电子烟差不多，有人专在酒吧、KTV、宾馆里递给人试。骗人吸的拘留 10…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/22-05"},"children":[{"tag":"strong","props":{},"children":["剧本杀、密室别去开在居民楼里或者地下二层以下的"]},{"tag":"span","props":{},"children":["五部门 2022 年的通知写明，剧本娱乐场所不得开在居民楼内，也不得开在地下一层以下。这类场地黑、隔断多、道具易燃，门还常常要解谜才打得开…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/22-06"},"children":[{"tag":"strong","props":{},"children":["心情差就去走或者跑，抗抑郁的效应量（效果大小）跟强度成正比"]},{"tag":"span","props":{},"children":["心情差的时候，快走或慢跑改善最明显。其次是瑜伽、力量训练、太极气功，几种差距不大。强度开得越高效果越好，力量训练和瑜伽最容易坚持。这方面的…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/22-07"},"children":[{"tag":"strong","props":{},"children":["焦虑到影响生活时，正念减压课的效果不劣于常用的抗焦虑药"]},{"tag":"span","props":{},"children":["确诊焦虑障碍的人上 8 周正念减压课，症状改善和吃抗焦虑药艾司西酞普兰几乎一样。吃药的人近八成出过不良反应，有人因此退出。上课的人约一成半…"]}]}]}]},{"tag":"a","props":{"className":"life-text-link","href":"/book/22"},"children":["阅读整个主题：怎么放松：娱乐场所和减压"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"15","height":"15","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]}]}]}]},{"tag":"aside","props":{"className":"life-ad-space life-ad-space-sponsored","data-ad-placement":"ad_footer","data-ad-group":"reading","data-ad-creative":"read_product","data-ad-ready":"false","aria-label":"广告 · 社区推荐"},"children":[{"tag":"div","props":{"className":"life-ad-space-brand"},"children":[{"tag":"img","props":{"src":"/sites/howtolivebetter/images/shengcai/logo.png","width":"565","height":"144","alt":"生财有术官方 Logo","decoding":"async"},"children":[]}]},{"tag":"div","props":{"className":"life-ad-space-copy"},"children":[{"tag":"span","props":{"className":"life-ad-space-label"},"children":["广告 · 社区推荐"]},{"tag":"strong","props":{},"children":["读过的知识，能不能做成有用的产品？"]},{"tag":"p","props":{},"children":["从电子书、资料到小工具，看看圈友怎样发现需求，把内容变成实际交付。"]}]},{"tag":"div","props":{"className":"life-ad-space-actions"},"children":[{"tag":"a","props":{"className":"life-ad-space-link","href":"/shengcaiyoushu?sc_group=reading&sc_creative=read_product&sc_placement=ad_footer"},"children":["看看社区与案例",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"18","height":"18","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-up-right","aria-hidden":"true"},"children":[{