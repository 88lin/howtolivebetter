roke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"返回目录"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["做一个网站或平台：资质、备案和服务器"]},{"tag":"div","props":{"data-ad-dock-host":"true"},"children":[]},{"tag":"nav","props":{"aria-label":"章节条目"},"children":[{"tag":"a","props":{"href":"/tip/26-01","className":"active"},"children":[{"tag":"span","props":{},"children":["01"]},"平台不要自己收钱再转给卖家，让钱走持牌支付机构直接结算"]},{"tag":"a","props":{"href":"/tip/26-02","className":""},"children":[{"tag":"span","props":{},"children":["02"]},"收费的网站多数要许可证，自己卖货不让别人入驻的不用，撮合交易的是另一类许可，免费的只要备案"]},{"tag":"a","props":{"href":"/tip/26-03","className":""},"children":[{"tag":"span","props":{},"children":["03"]},"做直播要网络文化经营许可证，做视听节目的那张证民营基本拿不到"]},{"tag":"a","props":{"href":"/tip/26-04","className":""},"children":[{"tag":"span","props":{},"children":["04"]},"服务器放境内就要备案，接入商必须自己持有增值电信许可"]},{"tag":"a","props":{"href":"/tip/26-05","className":""},"children":[{"tag":"span","props":{},"children":["05"]},"让用户上来卖东西，平台就要核验登记、报送信息、留存三年"]},{"tag":"a","props":{"href":"/tip/26-06","className":""},"children":[{"tag":"span","props":{},"children":["06"]},"用户发的内容你要管：审核机制、举报入口、发现违法立即停传并报告"]},{"tag":"a","props":{"href":"/tip/26-07","className":""},"children":[{"tag":"span","props":{},"children":["07"]},"提供信息发布、即时通讯服务，必须要求用户提供真实身份信息"]},{"tag":"a","props":{"href":"/tip/26-08","className":""},"children":[{"tag":"span","props":{},"children":["08"]},"不给未满 16 周岁的人开直播，打赏按年龄分档处理"]},{"tag":"a","props":{"href":"/tip/26-09","className":""},"children":[{"tag":"span","props":{},"children":["09"]},"接到侵权通知要及时处理，转送声明后 15 日没有下文就恢复"]},{"tag":"a","props":{"href":"/tip/26-10","className":""},"children":[{"tag":"span","props":{},"children":["10"]},"用户信息不要随手放到境外，出境有法定条件和人数门槛"]},{"tag":"a","props":{"href":"/tip/26-11","className":""},"children":[{"tag":"span","props":{},"children":["11"]},"选服务器先看停机能不能忍，再看有没有人运维，最后才比价"]}]}]},{"tag":"div","props":{"className":"life-tip-page","data-tip-locales":"zh,en,ru,es,ja,vi"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"当前位置"},"children":[{"tag":"a","props":{"href":"/book"},"children":["阅读全书"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/book/26"},"children":["第 26 章 · 做一个网站或平台：资质、备案和服务器"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"26-01"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["01"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["证据 A"]}]},{"tag":"h1","props":{"lang":"zh"},"children":["平台不要自己收钱再转给卖家，让钱走持牌支付机构直接结算"]},{"tag":"p","props":{"lang":"zh","className":"life-entry-summary"},"children":["买家的钱先进你的账户，你再转给卖家，这就是在做支付业务。做这门生意要中国人民银行批准，还要真拿出一亿元本钱。没批准就干，会被关停，挣的钱收走，还要罚款，老板和经办人另外罚。严重的还要判刑。稳妥做法只有一条：钱不进你的账户。"]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["成本"]},{"tag":"p","props":{},"children":["不花钱。要花点时间接一家持牌支付机构的产品。持牌支付机构就是拿到了央行支付牌照的公司。用它的分账或者担保交易功能，买家的钱直接结给卖家，不进平台自己的账户"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["收益"]},{"tag":"p","props":{},"children":["法规说的支付业务，是「根据收款人或者付款人提交的电子支付指令转移货币资金」。说白了就是按别人的指令替人转钱。要做这门生意，「应当经中国人民银行批准，取得支付业务许可」。注册资本最低 1 亿元，而且是实缴货币资本，这 1 亿元要真金白银打进公司账户。「未经依法批准，擅自设立非银行支付机构、从事或者变相…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"标记：平台不要自己收钱再转给卖家，让钱走持牌支付机构直接结算"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none"