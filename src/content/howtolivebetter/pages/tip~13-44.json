ewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"返回目录"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["紧急情况：先做什么"]},{"tag":"div","props":{"data-ad-dock-host":"true"},"children":[]},{"tag":"nav","props":{"aria-label":"章节条目"},"children":[{"tag":"a","props":{"href":"/tip/13-01","className":""},"children":[{"tag":"span","props":{},"children":["01"]},"有人倒地没呼吸，立刻用力按压胸口，让旁人打 120 并找 AED"]},{"tag":"a","props":{"href":"/tip/13-02","className":""},"children":[{"tag":"span","props":{},"children":["02"]},"老人摔倒、有人倒地，先蹲下喊他、打 120，别急着把人扶起来；陌生人这档走开在国内也合法，停下来就别上手搬"]},{"tag":"a","props":{"href":"/tip/13-03","className":""},"children":[{"tag":"span","props":{},"children":["03"]},"突然嘴歪、一侧胳膊没劲、说话说不清，立刻打 120，不要等、不要自己开车去"]},{"tag":"a","props":{"href":"/tip/13-04","className":""},"children":[{"tag":"span","props":{},"children":["04"]},"突然天旋地转站不稳、看东西成双、一只眼发黑，或者手指点不到自己鼻尖，也按卒中打 120"]},{"tag":"a","props":{"href":"/tip/13-05","className":""},"children":[{"tag":"span","props":{},"children":["05"]},"一只眼睛突然像拉下窗帘一样黑掉，哪怕几分钟就自己好了，也当天按卒中去急诊"]},{"tag":"a","props":{"href":"/tip/13-06","className":""},"children":[{"tag":"span","props":{},"children":["06"]},"一只眼又胀又痛、发红，看灯有一圈彩虹，还头痛恶心想吐，当天去眼科急诊"]},{"tag":"a","props":{"href":"/tip/13-07","className":""},"children":[{"tag":"span","props":{},"children":["07"]},"胸口压着疼、闷、发紧超过 15 分钟不缓解，打 120，不要自己扛也不要自己开车"]},{"tag":"a","props":{"href":"/tip/13-08","className":""},"children":[{"tag":"span","props":{},"children":["08"]},"突然像被撕开一样的剧痛，从胸口往后背、往腰一路挪，打 120 并说清「疼在移动」"]},{"tag":"a","props":{"href":"/tip/13-09","className":""},"children":[{"tag":"span","props":{},"children":["09"]},"突然一记「这辈子最疼的头痛」，一小时内就到最疼，立刻去急诊做头颅 CT"]},{"tag":"a","props":{"href":"/tip/13-10","className":""},"children":[{"tag":"span","props":{},"children":["10"]},"老人磕过头之后两三周到几个月变得走路不稳、迟钝、嗜睡或者一侧没劲，去做头颅 CT"]},{"tag":"a","props":{"href":"/tip/13-11","className":""},"children":[{"tag":"span","props":{},"children":["11"]},"一条腿突然肿起来、发紧、按着疼，尽快就医；再加上突然喘不上气或者胸痛，立刻打 120"]},{"tag":"a","props":{"href":"/tip/13-12","className":""},"children":[{"tag":"span","props":{},"children":["12"]},"大出血先用手死死压住伤口，四肢压不住就上止血带，同时打 120"]},{"tag":"a","props":{"href":"/tip/13-13","className":""},"children":[{"tag":"span","props":{},"children":["13"]},"被狗、猫咬伤或抓破皮，先用肥皂水和流水交替冲 15 分钟，当天去打疫苗"]},{"tag":"a","props":{"href":"/tip/13-14","className":""},"children":[{"tag":"span","props":{},"children":["14"]},"烫伤后立刻用凉的流动水冲 20 分钟，别抹牙膏酱油"]},{"tag":"a","props":{"href":"/tip/13-15","className":""},"children":[{"tag":"span","props":{},"children":["15"]},"突然全身起疹、喘不上气或者发晕，按过敏性休克处理，立刻叫 120 并说清楚"]},{"tag":"a","props":{"href":"/tip/13-16","className":""},"children":[{"tag":"span","props":{},"children":["16"]},"有人抽搐倒地，清开周围、让他侧躺、看表计时，什么都别往嘴里塞"]},{"tag":"a","props":{"href":"/tip/13-17","className":""},"children":[{"tag":"span","props":{},"children":["17"]},"糖尿病人突然发抖、出冷汗、说话不清，先给 15 克糖，15 分钟后复测"]},{"tag":"a","props":{"href":"/tip/13-18","className":""},"children":[{"tag":"span","props":{},"children":["18"]},"有人触电，先断电，再用干燥的木棍之类挑开电源，不要直接上手拉"]},{"tag":"a","props":{"href":"/tip/13-19","className":""},"children":[{"tag":"span","props":{},"children":["19"]},"一氧化碳报警器响了，或者一屋子人同时头痛恶心，先出门再打电话"]},{"tag":"a","props":{"href":"/tip/13-20","className":""},"children":[{"tag":"span","props":{},"children":["20"]},"误服清洁剂、农药、药物先别催吐，带上瓶子立刻就医；溅到眼睛或皮肤用大量清水至少冲 15 分钟"]},{"tag":"a","props":{"href":"/tip/13-21","className":""},"children":[{"tag":"span","props":{},"children":["21"]},"酸碱等化学品溅到身上，立刻脱掉污染的衣服、用大量流动清水冲，眼睛要掰开眼皮冲，冲够时间再走"]},{"tag":"a","props":{"href":"/tip/13-22","className":""},"children":[{"tag":"span","props":{},"children":["22"]},"高温下头晕、恶心、不出汗或意识不清，立刻挪到阴凉处脱衣泼水降温，意识不清的不喂水、打 120"]},{"tag":"a","props":{"href":"/tip/13-23","className":""},"children":[{"tag":"span","props":{},"children":["23"]},"中暑的人只要清醒，就少量多次喝凉的淡盐水或运动饮料，别猛灌、别喝酒和高糖饮料"]},{"tag":"a","props":{"href":"/tip/13-24","className":""},"children":[{"tag":"span","props":{},"children":["24"]},"火灾时贴地爬、摸门再开门、门烫就别开，走楼梯不坐电梯，出去了别回头"]},{"tag":"a","props":{"href":"/tip/13-25","className":""},"children":[{"tag":"span","props":{},"children":["25"]},"看到有人溺水，先叫人和打 110/120，伸竿、抛漂浮物，自己不下水"]},{"tag":"a","props":{"href":"/tip/13-26","className":""},"children":[{"tag":"span","props":{},"children":["26"]},"有人噎住说不出话，1 岁以上的站到背后做 5 次拍背加 5 次腹部冲击，倒下就做心肺复苏"]},{"tag":"a","props":{"href":"/tip/13-27","className":""},"children":[{"tag":"span","props":{},"children":["27"]},"在戈壁、沙漠、无人区迷路或车坏了，留在原地或车旁，先报位置，再遮阳保温，省水，不乱走"]},{"tag":"a","props":{"href":"/tip/13-28","className":""},"children":[{"tag":"span","props":{},"children":["28"]},"发抖、说话含糊、走路打晃是失温，换掉湿衣、包起来，先暖躯干，喝热甜饮不喝酒"]},{"tag":"a","props":{"href":"/tip/13-29","className":""},"children":[{"tag":"span","props":{},"children":["29"]},"被蛇咬，坐下别动、摘掉戒指手表、尽快送医院打抗蛇毒血清，不切、不吸、不绑死"]},{"tag":"a","props":{"href":"/tip/13-30","className":""},"children":[{"tag":"span","props":{},"children":["30"]},"地震时先看自己在什么房子里：符合抗震设防的楼里就地躲，会垮的老房子门在几步外就出去"]},{"tag":"a","props":{"href":"/tip/13-31","className":""},"children":[{"tag":"span","props":{},"children":["31"]},"遇到熊、野猪、成群野狗，别跑，侧身慢慢退开"]},{"tag":"a","props":{"href":"/tip/13-32","className":""},"children":[{"tag":"span","props":{},"children":["32"]},"野外遇上雷雨，钻进有硬顶的车或建筑，避开山脊、孤树、水面和金属"]},{"tag":"a","props":{"href":"/tip/13-33","className":""},"children":[{"tag":"span","props":{},"children":["33"]},"上高原按睡眠海拔（当晚睡在多高）慢慢升，症状加重就下撤，不要硬扛"]},{"tag":"a","props":{"href":"/tip/13-34","className":""},"children":[{"tag":"span","props":{},"children":["34"]},"被蜱虫叮住，用尖头镊子贴着皮肤稳稳拉出来，别涂油别用火烧"]},{"tag":"a","props":{"href":"/tip/13-35","className":""},"children":[{"tag":"span","props":{},"children":["35"]},"野外的水一律烧开再喝，滚开一分钟就够，不用因为海拔高多煮"]},{"tag":"a","props":{"href":"/tip/13-36","className":""},"children":[{"tag":"span","props":{},"children":["36"]},"荒郊野外被陌生人索财，钱给他，不动手，记特征，脱身后报警"]},{"tag":"a","props":{"href":"/tip/13-37","className":""},"children":[{"tag":"span","props":{},"children":["37"]},"撞见一群人打架，退开走人，别上去拉架、别围观、别捡地上的家伙；要报警就退到安全距离打 110"]},{"tag":"a","props":{"href":"/tip/13-38","className":""},"children":[{"tag":"span","props":{},"children":["38"]},"可能被 HIV 暴露了，72 小时内去拿阻断药，越早越好"]},{"tag":"a","props":{"href":"/tip/13-39","className":""},"children":[{"tag":"span","props":{},"children":["39"]},"救人受了伤、搭进了钱，先找加害人和医保，再去申报见义勇为确认"]},{"tag":"a","props":{"href":"/tip/13-40","className":""},"children":[{"tag":"span","props":{},"children":["40"]},"刀、钢筋、玻璃扎进身体，压住异物周围止血，不要把它拔出来"]},{"tag":"a","props":{"href":"/tip/13-41","className":""},"children":[{"tag":"span","props":{},"children":["41"]},"怀疑骨折就别再动那个部位，托着不动、冷敷 20 分钟以内，别自己掰正"]},{"tag":"a","props":{"href":"/tip/13-42","className":""},"children":[{"tag":"span","props":{},"children":["42"]},"被性侵之后，先到安全的地方打 110；验伤之前别洗澡、别洗衣服、别收拾房间，72 小时内去医院"]},{"tag":"a","props":{"href":"/tip/13-43","className":""},"children":[{"tag":"span","props":{},"children":["43"]},"不满 1 岁的婴儿噎住哭不出声，趴着拍背 5 下、翻过来按胸口 5 下，轮着做，别按肚子"]},{"tag":"a","props":{"href":"/tip/13-44","className":"active"},"children":[{"tag":"span","props":{},"children":["44"]},"不满 1 岁的婴儿没反应、没正常呼吸，开免提打 120，做婴儿心肺复苏：按 30 下吹 2 口气"]}]}]},{"tag":"div","props":{"className":"life-tip-page","data-tip-locales":"zh,en,ru,es,ja,vi"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"当前位置"},"children":[{"tag":"a","props":{"href":"/book"},"children":["阅读全书"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/book/13"},"children":["第 13 章 · 紧急情况：先做什么"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"13-44"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["44"]},{"tag":"span","props":{"className":"life-evidence grade-b"},"children":["证据 B"]}]},{"tag":"h1","props":{"lang":"zh"},"children":["不满 1 岁的婴儿没反应、没正常呼吸，开免提打 120，做婴儿心肺复苏：按 30 下吹 2 口气"]},{"tag":"p","props":{"lang":"zh","className":"life-entry-summary"},"children":["拍脚底没反应、没正常呼吸，就开免提打 120，手不停。双手环抱胸口用两个拇指按，抱不住就用一只手的掌根，按下去约 4 厘米，每秒约 2 下。每按 30 下，嘴包住孩子口鼻吹 2 口气。婴儿心跳停多半是喘不上气引起的，做了带吹气的心肺复苏，活下来的更多。"]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["成本"]},{"tag":"p","props":{},"children":["不花钱。婴儿心肺复苏要上课练一次，半天到一天。难的是对着孩子口鼻吹气，还有不敢用力按。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["收益"]},{"tag":"p","props":{},"children":["美国心脏协会和美国儿科学会出了 2025 年的儿童基础生命支持指南。指南写：婴儿和儿童心跳骤停，主要原因仍是呼吸出了问题。在医院外心跳骤停的婴儿，活着出院的只有 6.6%。普通人遇到没反应、没正常呼吸、没有生命迹象的婴儿或儿童，「应当立即开始心肺复苏」，不要去摸脉搏。按压深度至少是胸廓前后径的三分之…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"标记：不满 1 岁的婴儿没反应、没正常呼吸，开免提打 120，做婴儿心肺复苏：按 30 下吹 2 口气"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"已做到"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"加入待做"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"收藏"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"分享这条建议"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"收起详情"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["成本"]},{"tag":"p","props":{"className":"life-citations"},"children":["不花钱。婴儿心肺复苏要上课练一次，半天到一天。难的是对着孩子口鼻吹气，还有不敢用力按。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["收益"]},{"tag":"p","props":{"className":"life-citations"},"children":["美国心脏协会和美国儿科学会出了 2025 年的儿童基础生命支持指南。指南写：婴儿和儿童心跳骤停，主要原因仍是呼吸出了问题。在医院外心跳骤停的婴儿，活着出院的只有 6.6%。普通人遇到没反应、没正常呼吸、没有生命迹象的婴儿或儿童，「应当立即开始心肺复苏」，不要去摸脉搏。按压深度至少是胸廓前后径的三分之一，婴儿「约 1.5 英寸（4 厘米）」。频率每分钟 100 到 120 次。一个人做时，按 30 下吹 2 口气。两个人做时，按 15 下吹 2 口气。婴儿用一只手的掌根按，或者双手环抱、两个拇指按。环抱不住就用掌根。两根手指按的做法已经取消，因为按不够深。指南还写，院外心脏骤停的婴儿和儿童，按压之外再加吹气能提高存活。美国一个登记库统计了 3900 名 18 岁以下院外心脏骤停的孩子，59.4% 是婴儿。在场的人做了心肺复苏的，调整后活着出院的比例是 13.2%，没做的是 9.5%。调整后 OR 1.57（活下来的几率高约 57%），95% CI 1.25–1.96（可信范围）。在婴儿里，带吹气的心肺复苏和更高的存活有关，活下来的孩子脑子也恢复得更好。只按不吹的，结果和没人做差不多。国际红十字与红新月会联合会的 2025 年国际急救指南写：看婴儿有没有反应，要把孩子抱起来或者拍他的脚底。只有你一个人，就开免提自己打急救电话。手边没有能边按边打的电话，就先做 1 分钟心肺复苏再去打。首都儿科研究所有一篇科普，北京市卫健委转载了。它写：「如果只有1个人在场，先进行2分钟的心肺复苏后呼叫120救护车」。按压幅度「婴儿4cm」。1 岁以内吹气要「口对口鼻」"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["来源"]},{"tag":"p","props":{"className":"life-citations"},"children":["Joyner BL 等 (2025). Part 6: Pediatric Basic Life Support: 2025 American Heart Association and American Academy of Pediatrics Guidelines for Cardiopulmonary Resuscitation and Emergency Cardiovascular Care. Circulation 152(suppl 2):S424–S447. ",{"tag":"a","props":{"href":"https://doi.org/10.1161/CIR.0000000000001370","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1161/CIR.0000000000001370"]},"，全文见 ",{"tag":"a","props":{"href":"https://cpr.heart.org/en/resuscitation-science/cpr-and-ecc-guidelines/pediatric-basic-life-support","target":"_blank","rel":"noopener noreferrer"},"children":["https://cpr.heart.org/en/resuscitation-science/cpr-and-ecc-guidelines/pediatric-basic-life-support"]},"；Naim MY 等 (2017). Association of Bystander Cardiopulmonary Resuscitation With Overall and Neurologically Favorable Survival After Pediatric Out-of-Hospital Cardiac Arrest in the United States: A Report From the Cardiac Arrest Registry to Enhance Survival Surveillance Registry. JAMA Pediatrics 171(2):133–141. ",{"tag":"a","props":{"href":"https://doi.org/10.1001/jamapediatrics.2016.3643","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1001/jamapediatrics.2016.3643"]},"；International Federation of Red Cross and Red Crescent Societies (2025). International First Aid, Resuscitation and Education Guidelines 2025，第 186–188 页. ",{"tag":"a","props":{"href":"https://www.ifrc.org/sites/default/files/2026-03/IFRC%20International%20First%20Aid,%20Resuscitation%20and%20Education%20Guidelines%202025.pdf","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.ifrc.org/sites/default/files/2026-03/IFRC%20International%20First%20Aid,%20Resuscitation%20and%20Education%20Guidelines%202025.pdf"]},"；首都儿科研究所 (2022). 【儿研所儿医说】心肺复苏：爸妈必备的急救知识（北京市卫生健康委员会转载）. ",{"tag":"a","props":{"href":"https://wjw.beijing.gov.cn/bmfw_20143/jkzs/jksh/202210/t20221017_2837684.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://wjw.beijing.gov.cn/bmfw_20143/jkzs/jksh/202210/t20221017_2837684.html"]},"；European Resuscitation Council (2025). ERC Guidelines 2025 for the lay public（Paediatric Basic Life Support 一章）. ",{"tag":"a","props":{"href":"https://www.erc.edu/media/p5ymaeej/gl2025_layperson_book_ipdf-v11-e.pdf","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.erc.edu/media/p5ymaeej/gl2025_layperson_book_ipdf-v11-e.pdf"]},""]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["原书备注"]},{"tag":"p","props":{"className":"life-citations"},"children":["定 B 是因为存活的数字来自只跟踪记录的登记研究，而且算的是全体孩子，婴儿单独的数字摘要里没给。收益定「大」是按全体孩子的数字算的：活着出院从 9.5% 到 13.2%，相对多了约四成。受益的几乎都是自家孩子。和本节第 1 条（用力按压胸口）的区别有三点。一是婴儿要吹气，只按不吹对婴儿效果差。二是用两个拇指或一只掌根，按约 4 厘米，不用双手叠着压。三是一个人又没法边按边打电话时，先按再去打。先按多久各家不一：首都儿科研究所和美国指南的单人流程是 2 分钟，国际红十字是 1 分钟。手机开免提就没有这个问题。欧洲复苏委员会教的是先吹 5 口气再按，美国指南是先按后吹，两种都比不做强。国内老教程教两指按压，2025 年美国指南已经去掉了这种手法。噎住引起的，吹气前看一眼嘴里，看得见的异物才取，见本节第 43 条（婴儿噎住）。"]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["我的备注"]},{"tag":"button","props":{"type":"button"},"children":["写下对自己有用的提醒…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/tip/13-43"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["上一条"]},"不满 1 岁的婴儿噎住哭不出声，趴着拍背 5 下、翻过来按胸口 5 下，轮着做，别按肚子"]}]},{"tag":"span","props":{},"children":[]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["本主题的其他建议"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/13-37"},"children":[{"tag":"strong","props":{},"children":["撞见一群人打架，退开走人，别上去拉架、别围观、别捡地上的家伙；要报警就退到安全距离打 110"]},{"tag":"span","props":{},"children":["你一动手，劝架就成了参加打架。参加聚众斗殴判 3 年以下，人多、在马路上、拿了家伙的判 3 到 10 年。围观也容易被误伤。该做的是退开走人。愿意报警就退到安全…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/13-38"},"children":[{"tag":"strong","props":{},"children":["可能被 HIV 暴露了，72 小时内去拿阻断药，越早越好"]},{"tag":"span","props":{},"children":["怀疑自己被传染上艾滋病，72 小时是硬线，最好 2 小时内就吃上药。药要连吃 28 天。超过 72 小时这条路就没了，所以别等到第二天再决定。"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/13-39"},"children":[{"tag":"strong","props":{},"children":["救人受了伤、搭进了钱，先找加害人和医保，再去申报见义勇为确认"]},{"tag":"span","props":{},"children":["救人把自己搭进去，不用自认倒霉。见义勇为负伤的先救治、后收费。医疗费由加害人出，人跑了或者赔不起的走基本医保。没有加害人的，被你救下的人依法应当给适当补偿。同时…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/13-40"},"children":[{"tag":"strong","props":{},"children":["刀、钢筋、玻璃扎进身体，压住异物周围止血，不要把它拔出来"]},{"tag":"span","props":{},"children":["拔出来可能造成大出血，也会让医生更难判断伤了多深。做法是：打 120，用手或者敷料压住异物周围止血，把异物垫稳别让它晃。肚子上的伤口有内脏露出来，不要往回塞，盖…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/13-41"},"children":[{"tag":"strong","props":{},"children":["怀疑骨折就别再动那个部位，托着不动、冷敷 20 分钟以内，别自己掰正"]},{"tag":"span","props":{},"children":["手脚受了伤先当骨折处理，能站能动也排除不了。伤处保持不动，用手托住或用硬板在原位撑住，冷敷一次不超过 20 分钟。别自己掰正，骨头戳出皮肤的先止血，别按回去。X…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/13-42"},"children":[{"tag":"strong","props":{},"children":["被性侵之后，先到安全的地方打 110；验伤之前别洗澡、别洗衣服、别收拾房间，72 小时内去医院"]},{"tag":"span","props":{},"children":["身上、衣服上和屋里留下的痕迹，是指认对方最要紧的证据。所以验伤前尽量别洗澡，也别洗衣服、收拾房间，尽早打 110。紧急避孕药药店就有，越早吃越有效。72 小时内…"]}]}]}]},{"tag":"a","props":{"className":"life-text-link","href":"/book/13"},"children":["阅读整个主题：紧急情况：先做什么 ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"15","height":"15","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]}]}]}]},{"tag":"aside","props":{"c