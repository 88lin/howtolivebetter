path","props":{"d":"M18 20a6 6 0 0 0-12 0"},"children":[]},{"tag":"circle","props":{"cx":"12","cy":"10","r":"4"},"children":[]},{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},{"tag":"span","props":{},"children":["Sign in to sync"]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/en/book/01"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"Back to index"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["Do not die early"]},{"tag":"nav","props":{"aria-label":"Chapter entries"},"children":[{"tag":"a","props":{"href":"/en/tip/01-01"},"children":[{"tag":"span","props":{},"children":["01"]},"Always wear seat belts, both front and back"]},{"tag":"a","props":{"href":"/en/tip/01-02"},"children":[{"tag":"span","props":{},"children":["02"]},"Wearing a helmet and fastening the strap while riding motorcycles or e-bikes"]},{"tag":"a","props":{"href":"/en/tip/01-03"},"children":[{"tag":"span","props":{},"children":["03"]},"Install smoke alarms; those heating with coal or gas in winter should also add a carbon monoxide alarm"]},{"tag":"a","props":{"href":"/en/tip/01-04"},"children":[{"tag":"span","props":{},"children":["04"]},"Replace gas hoses and stoves when they reach their expiration date; never modify the piping yourself, and you may decline any unsolicited sales pitches from gas companies"]},{"tag":"a","props":{"href":"/en/tip/01-05"},"children":[{"tag":"span","props":{},"children":["05"]},"Do not pick, buy, or eat wild mushrooms; any “folk tricks” for identification are useless"]},{"tag":"a","props":{"href":"/en/tip/01-06"},"children":[{"tag":"span","props":{},"children":["06"]},"Electric bicycles must not be pushed into stairwells, elevators, or charged indoors"]},{"tag":"a","props":{"href":"/en/tip/01-07"},"children":[{"tag":"span","props":{},"children":["07"]},"Measuring blood pressure and taking meds to reach target levels"]},{"tag":"a","props":{"href":"/en/tip/01-08"},"children":[{"tag":"span","props":{},"children":["08"]},"After age 35, anyone who is overweight should get a fasting blood glucose test; if the result is normal, repeat it every three years"]},{"tag":"a","props":{"href":"/en/tip/01-09"},"children":[{"tag":"span","props":{},"children":["09"]},"Don’t speed or drive after drinking"]},{"tag":"a","props":{"href":"/en/tip/01-10"},"children":[{"tag":"span","props":{},"children":["10"]},"When riding in a car, use a car seat for children under 4, don’t hold them in your arms"]},{"tag":"a","props":{"href":"/en/tip/01-11"},"children":[{"tag":"span","props":{},"children":["11"]},"Install window guards and balcony barriers if you have kids at home; screen windows do not count as protection"]},{"tag":"a","props":{"href":"/en/tip/01-12"},"children":[{"tag":"span","props":{},"children":["12"]},"Keep young children in sight near water; wear life jackets when boating or swimming"]},{"tag":"a","props":{"href":"/en/tip/01-13"},"children":[{"tag":"span","props":{},"children":["13"]},"Exercising balance and leg strength for people over 60, plus home modifications"]},{"tag":"a","props":{"href":"/en/tip/01-14"},"children":[{"tag":"span","props":{},"children":["14"]},"Get tested for hepatitis B markers; if no antibodies, get vaccinated"]},{"tag":"a","props":{"href":"/en/tip/01-15"},"children":[{"tag":"span","props":{},"children":["15"]},"If you get pricked by a nail or splinter, or if a wound gets dirty with soil, seek treatment the same day and ask whether a tetanus shot is needed"]},{"tag":"a","props":{"href":"/en/tip/01-16"},"children":[{"tag":"span","props":{},"children":["16"]},"The earlier women get the HPV vaccine, the better"]},{"tag":"a","props":{"href":"/en/tip/01-17"},"children":[{"tag":"span","props":{},"children":["17"]},"Breast cancer screening for women: mammograms every two years starting at age 40"]},{"tag":"a","props":{"href":"/en/tip/01-18"},"children":[{"tag":"span","props":{},"children":["18"]},"For women over 30, HPV testing should be the first choice for cervical cancer screening"]},{"tag":"a","props":{"href":"/en/tip/01-19"},"children":[{"tag":"span","props":{},"children":["19"]},"Starting colorectal cancer screening at ages 45–50: use fecal immunochemical tests or colonoscopies"]},{"tag":"a","props":{"href":"/en/tip/01-20"},"children":[{"tag":"span","props":{},"children":["20"]},"People with cardiovascular disease and older adults should get a flu shot each year"]},{"tag":"a","props":{"href":"/en/tip/01-21"},"children":[{"tag":"span","props":{},"children":["21"]},"Getting the shingles vaccine after age 50"]},{"tag":"a","props":{"href":"/en/tip/01-22"},"children":[{"tag":"span","props":{},"children":["22"]},"Pneumococcal vaccine for people over 65"]},{"tag":"a","props":{"href":"/en/tip/01-23"},"children":[{"tag":"span","props":{},"children":["23"]},"Testing for Helicobacter pylori and eradicating it if positive"]},{"tag":"a","props":{"href":"/en/tip/01-24"},"children":[{"tag":"span","props":{},"children":["24"]},"Heavy smokers should get a low-dose chest CT once a year"]},{"tag":"a","props":{"href":"/en/tip/01-25"},"children":[{"tag":"span","props":{},"children":["25"]},"Call 12356 if you’re depressed or having suicidal thoughts; don’t keep sleeping pills or pesticides at home"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/en/tip/01-26","data-status":"active"},"children":[{"tag":"span","props":{},"children":["26"]},"Purchase fire extinguishers, fire blankets, escape respirators, and first-aid kits, then inspect them once a year"]},{"tag":"a","props":{"href":"/en/tip/01-27"},"children":[{"tag":"span","props":{},"children":["27"]},"Visible blood in urine — even if painless and gone by the next day — still warrants a check-up"]},{"tag":"a","props":{"href":"/en/tip/01-28"},"children":[{"tag":"span","props":{},"children":["28"]},"If erectile dysfunction appears, check cardiovascular health first — don’t treat it as a purely sexual issue"]},{"tag":"a","props":{"href":"/en/tip/01-29"},"children":[{"tag":"span","props":{},"children":["29"]},"Weight loss, quitting smoking, and controlling blood pressure and blood sugar can improve erectile function"]},{"tag":"a","props":{"href":"/en/tip/01-30"},"children":[{"tag":"span","props":{},"children":["30"]},"Always use condoms during sex and never share needles"]},{"tag":"a","props":{"href":"/en/tip/01-31"},"children":[{"tag":"span","props":{},"children":["31"]},"If you’ve engaged in high‑risk behavior, get tested for HIV — the Chinese CDC offers free testing with full confidentiality"]},{"tag":"a","props":{"href":"/en/tip/01-32"},"children":[{"tag":"span","props":{},"children":["32"]},"As soon as suicidal thoughts arise, tell someone nearby and hand over those first few minutes"]},{"tag":"a","props":{"href":"/en/tip/01-33"},"children":[{"tag":"span","props":{},"children":["33"]},"Don’t treat “survival” as a safety net: after ingesting paraquat or inhaling carbon monoxide, emergency care can save lives, but it rarely preserves lung or brain function"]},{"tag":"a","props":{"href":"/en/tip/01-34"},"children":[{"tag":"span","props":{},"children":["34"]},"Don’t bet on “a few days of rest” after a fall from height: most patients admitted to a trauma ICU survive, though at a cost measured in years"]},{"tag":"a","props":{"href":"/en/tip/01-35"},"children":[{"tag":"span","props":{},"children":["35"]},"Don’t trade “losing one kidney is no big deal” for cash: the remaining kidney has to do the work of two, and 86% of kidney sellers later say their health got worse"]},{"tag":"a","props":{"href":"/en/tip/01-36"},"children":[{"tag":"span","props":{},"children":["36"]},"Don’t pick up, disassemble, or sell unidentified metal parts; stay clear of areas marked with the clover symbol"]},{"tag":"a","props":{"href":"/en/tip/01-37"},"children":[{"tag":"span","props":{},"children":["37"]},"When gambling leads to borrowing money to gamble and your mood is constantly low, first call 12356, then hand your bank cards and payment passwords over to your family to manage"]},{"tag":"a","props":{"href":"/en/tip/01-38"},"children":[{"tag":"span","props":{},"children":["38"]},"For men who have sex with men (MSM) engaging in high-risk sexual behavior, asking for Pre-Exposure Prophylaxis (PrEP) at designated HIV hospitals and taking it on schedule can reduce infection risk by over 70%"]},{"tag":"a","props":{"href":"/en/tip/01-39"},"children":[{"tag":"span","props":{},"children":["39"]},"Women aged 65 and older should have a dual-energy X-ray absorptiometry (DXA) bone density test; postmenopausal women with osteoporosis risk factors need not wait until 65"]},{"tag":"a","props":{"href":"/en/tip/01-40"},"children":[{"tag":"span","props":{},"children":["40"]},"If you are diagnosed with osteoporosis, or have fractured from a minor fall, ask a doctor for osteoporosis medication and keep taking it—do not treat calcium supplements as a substitute"]},{"tag":"a","props":{"href":"/en/tip/01-41"},"children":[{"tag":"span","props":{},"children":["41"]},"Drill holes to measure ice thickness before stepping onto it; don’t go out if it’s under 15 cm thick. Avoid ice over rivers and near ice-fishing holes"]},{"tag":"a","props":{"href":"/en/tip/01-42"},"children":[{"tag":"span","props":{},"children":["42"]},"Fit the guard and wear goggles plus a face shield before using an angle grinder; hold it with both hands, and never fit a woodworking saw blade to cut wood"]},{"tag":"a","props":{"href":"/en/tip/01-43"},"children":[{"tag":"span","props":{},"children":["43"]},"Ask someone whose mood seems wrong directly, “Have you thought about suicide?” Asking does not make them want it more"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"Breadcrumb"},"children":[{"tag":"a","props":{"href":"/en/book"},"children":["Explore the book"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/en/book/01"},"children":["Chapter 1"," ·"," ","Do not die early"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"01-26"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["26"]},{"tag":"span","props":{"className":"life-evidence grade-b"},"children":["Evidence"," ","B"]}]},{"tag":"h1","props":{"lang":"en"},"children":["Purchase fire extinguishers, fire blankets, escape respirators, and first-aid kits, then inspect them once a year"]},{"tag":"p","props":{"lang":"en","className":"life-entry-summary"},"children":["Fire extinguishers, fire blankets, escape respirators, and first-aid kits are all included in the Emergency Management Department’s list of 11 essential items for household emergency preparedness. The whole set costs a few hundred yuan, and you only need to buy it once. Studies of home safety programs that included on-site guidance found these measures cut injury rates by roughly 25%."]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Cost"]},{"tag":"p","props":{},"children":["A set of fire extinguishers, fire blankets, one respirator…"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Benefit"]},{"tag":"p","props":{},"children":["The Emergency Management Department’s “National Recommended List of Basic Household Emergency Supplies” contai…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"Mark: Purchase fire extinguishers, fire blankets, escape respirators, and first-aid kits, then inspect them once a year"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"Done"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"Plan to do"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"Save"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Share this tip"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Hide details"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Cost"]},{"tag":"p","props":{},"children":["A set of fire extinguishers, fire blankets, one respirator per person, and a first-aid kit costs a few hundred yuan. You only need to buy it once; after that, it takes just 10 minutes each year to inspect the items."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Benefit"]},{"tag":"p","props":{},"children":["The Emergency Management Department’s “National Recommended List of Basic Household Emergency Supplies” contains 11 items in total. Among them, “fire extinguishers and fire blankets” are recommended for “putting out small fires at the initial stage”, and the list also notes that “fire blankets can be draped over the body to aid escape”. The “escape respirators” listed are “firefighting filtering self-rescue respirators designed for use during fire escapes”. “External medical supplies” refer to “hemostatic powder, adhesive bandages, gauze bandages, and other items used to treat wounds”. Cochrane analyzed 98 studies involving 2,605,044 participants in total. Home safety interventions lowered injury rates to an IRR of 0.89; the 95% confidence interval for this figure is 0.78 to 1.01. For interventions that included on-site guidance, injury rates dropped by around 25% (IRR 0.75, 95% CI 0.62 to 0.91)."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Original sources"]},{"tag":"p","props":{"className":"life-citations"},"children":["应急管理部 (2020). 全国基础版家庭应急物资储备建议清单. ",{"tag":"a","props":{"href":"https://www.mem.gov.cn/kp/shaq/202011/t20201129_372149.shtml","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.mem.gov.cn/kp/shaq/202011/t20201129_372149.shtml"]}," ; Kendrick D 等 (2012). Home safety education and provision of safety equipment for injury prevention. Cochrane Database of Systematic Reviews. ",{"tag":"a","props":{"href":"https://doi.org/10.1002/14651858.CD005014.pub3","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1002/14651858.CD005014.pub3"]}," ; 武胜县市场监督管理局 (2025). 手提式灭火器、防火门（窗）、点型感温（烟）火灾探测器消费提示. ",{"tag":"a","props":{"href":"https://www.wusheng.gov.cn/gasylbzj/c109568/zzzq/content/content_1988424970198126592.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.wusheng.gov.cn/gasylbzj/c109568/zzzq/content/content_1988424970198126592.html"]}," ; 贵州省消防救援总队 (2025). 居家必备灭火毯 功能用法全攻略（转载北京消防）. ",{"tag":"a","props":{"href":"https://gz.119.gov.cn/xfkp/xfcs/202503/t20250313_87157898.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://gz.119.gov.cn/xfkp/xfcs/202503/t20250313_87157898.html"]}," ; NVWA (2014). Blusdekens oktober 2014（荷兰食品与消费品安全局检查报告，原页面已下线，链接为 2021 年 10 月 20 日的网页存档）. ",{"tag":"a","props":{"href":"https://web.archive.org/web/20211020154732/https://www.nvwa.nl/binaries/nvwa/documenten/consument/consumentenartikelen/non-food/overige-non-food/blusdekens-oktober-2014/Factsheet+Blusdekens+Oktober+2014.pdf","target":"_blank","rel":"noopener noreferrer"},"children":["https://web.archive.org/web/20211020154732/https://www.nvwa.nl/binaries/nvwa/documenten/consument/consumentenartikelen/non-food/overige-non-food/blusdekens-oktober-2014/Factsheet+Blusdekens+Oktober+2014.pdf"]}]},{"tag":"a","props":{"href":"https://www.mem.gov.cn/kp/shaq/202011/t20201129_372149.shtml","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Open source link"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Book note"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["Controversy. In the same Cochrane review, interventions that did not provide equipment had an injury rate about 20% lower. The original figure was IRR 0.78, with a 95% CI of 0.66 to 0.92. The group that received equipment did not do better. Home visits for education and modifications were the main factors reducing injuries, so the benefit of equipment is rated “medium,” not “large.” Look for the CCC mark when buying a fire extinguisher; on stored-pressure models, the needle must be in the green zone. Most fire blankets are made of fiberglass: hold only the two pull straps, and do not touch the blanket surface with bare hands. Using one to cover a burning oil pan is also disputed: in 2014, the Dutch regulator tested 22 brands, and none reliably extinguished the fire when used as an ordinary person would use it. If an oil pan catches fire, turn off the heat first and put the lid on. For smoke and carbon monoxide alarms, see item 3 of this section. For tourniquet use, see Section 13, item 12. For how to choose each item, where to keep it, and how often to replace it, see ",{"tag":"a","props":{"href":"/en/articles/home-emergency-kit"},"children":["docs/家庭应急装备清单.md"]},"."]}]}]},{"tag":"section","props":{"className":"jd-entry-products"},"children":[{"tag":"div","props":{"className":"jd-section-heading"},"children":[{"tag":"h2","props":{},"children":["Related products"]},{"tag":"a","props":{"href":"/en/products"},"children":["All products"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"14","height":"14","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-up-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M7 7h10v10"},"children":[]},{"tag":"path","props":{"d":"M7 17 17 7"},"children":[]}]}]}]},{"tag":"p","props":{},"children":["A few useful picks for this situation."]},{"tag"