ht":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["成本"]},{"tag":"p","props":{"className":"life-citations"},"children":["不花钱。被拦下来时要开口引法条，可能要僵持一会儿。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["收益"]},{"tag":"p","props":{"className":"life-citations"},"children":["《无障碍环境建设法》第四十六条：「公共场所经营管理单位、交通运输设施和公共交通运输工具的运营单位应当为残疾人携带导盲犬、导听犬、辅助犬等服务犬提供便利。」第三十五条规定，政务服务便民热线和报警求助、消防应急、交通事故、医疗急救等紧急呼叫系统，应当逐步具备语音、大字、盲文、一键呼叫等无障碍功能。第六十二条规定，任何组织和个人有权对违反本法规定的行为投诉、举报，主管部门应当及时处理并予以答复。《残疾人保障法》第五十条：「盲人持有效证件免费乘坐市内公共汽车、电车、地铁、渡船等公共交通工具。盲人读物邮件免费寄递。」同条还规定，县级以上人民政府对残疾人搭乘公共交通工具应当给予便利和优惠，残疾人可以免费携带随身必备的辅助器具（全国，无障碍环境建设法 2023 年 9 月 1 日起施行）"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["来源"]},{"tag":"p","props":{"className":"life-citations"},"children":["中华人民共和国无障碍环境建设法（第三十五条、第四十六条、第六十二条）. ",{"tag":"a","props":{"href":"https://flk.npc.gov.cn/detail?id=ff80818188d7430b0189018493370940","target":"_blank","rel":"noopener noreferrer"},"children":["https://flk.npc.gov.cn/detail?id=ff80818188d7430b0189018493370940"]},"；中华人民共和国残疾人保障法（第五十条）. ",{"tag":"a","props":{"href":"https://flk.npc.gov.cn/detail?id=ff8080816f135f46016f1d134c88132b","target":"_blank","rel":"noopener noreferrer"},"children":["https://flk.npc.gov.cn/detail?id=ff8080816f135f46016f1d134c88132b"]},""]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["原书备注"]},{"tag":"p","props":{"className":"life-citations"},"children":["法律写的是「提供便利」，没有配罚则，所以现场僵持时对方不一定立刻让步。手机里存一张法条截图，比背条号管用。当场解决不了就按第六十二条投诉，主管部门要答复。铁路和民航另有自己的规定，出行前先打客服确认。免费乘车的「有效证件」各地认的不完全一样，去当地残联问清楚认哪一种。"]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["我的备注"]},{"tag":"button","props":{"type":"button"},"children":["写下对自己有用的提醒…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/tip/33-11"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["上一条"]},"残疾人的个人所得税可以减征，减多少打电话问省税务局"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/tip/33-13"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["下一条"]},"残疾人参加高考可以申请合理便利，用盲文卷的考试时间加一半"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["本主题的其他建议"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/33-08"},"children":[{"tag":"strong","props":{},"children":["孩子不满 7 岁又有残疾或者孤独症的，去县级残联申请康复救助"]},{"tag":"span","props":{},"children":["国家给 0 到 6 岁的残疾儿童和孤独症儿童建了一套康复救助制度，管手术、辅助器具和康复训练。救助对象先保困难家庭，地方财