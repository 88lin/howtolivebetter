.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"收藏"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"分享这条建议"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"收起详情"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["成本"]},{"tag":"p","props":{"className":"life-citations"},"children":["挂号费加治疗费，一般做 8 到 12 次。难在治疗要回头去碰最怕想起的那段经历。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["收益"]},{"tag":"p","props":{"className":"life-citations"},"children":["国家卫生健康委《精神障碍诊疗规范（2020 年版）》写明，经历精神创伤的人平均约 8% 会发展成创伤后应激障碍。核心表现有三类。一是噩梦、闪回，出事的情景反复冒出来。二是躲着不碰和这件事有关的话题、地方和人。三是一直警觉，容易受惊、失眠。症状持续超过 1 个月，并且严重影响家庭、学习或工作，才下这个诊断。规范在急性应激障碍一节写，大多数人经过自我调整或急性期危机干预就恢复正常。治疗效果看一篇 2020 年的汇总，共 114 项抽签分组的试验、8171 人。创伤聚焦的认知行为治疗和等候治疗或常规处理比，SMD −1.32（95% CI −1.57 到 −1.08，可信范围），证据质量中等。眼动脱敏与再加工（EMDR）是 −1.23（−1.69 到 −0.76），证据质量低。SMD 和 d 是同一把尺子，0.8 以上算大，两种都超过这条线。普通的支持性咨询和等候比，没看出差别（−0.43，−0.90 到 0.04）。同一组作者 2013 年的 Cochrane 综述有 70 项试验、4761 人，方向一致。创伤聚焦的认知行为治疗是 −1.62（−2.03 到 −1.21），EMDR 是 −1.17（−2.04 到 −0.30）。但那次评的证据质量很低。英国 NICE 2018 年指南是这样安排的。出事一个月内症状就很重的成人，提供个体的创伤聚焦认知行为治疗。一个月后确诊或症状明显的，同样提供，一般做 8 到 12 次。不是战争造成的创伤，满 3 个月还没好的，也提供 EMDR。症状轻、够不上诊断的，头一个月先观察，一个月内约好复查。国内规范列的心理治疗也是这几种：延长暴露、认知加工治疗和 EMDR。出事后马上做的一次性晤谈，看三份材料。Cochrane 2002 年汇总 11 项试验，单次的个别晤谈没减轻痛苦，也没防住创伤后应激障碍。3 到 5 个月时 OR 1.22（0.60–2.46），没有差别。其中一项试验跟到 1 年，做过晤谈的人得这个病的风险反而更高。OR 2.88（1.11–7.53），约 2.9 倍。作者的结论是，别再强制给受创的人做晤谈。另一项试验找的是车祸后住院的病人，抽签分组。3 年后，晤谈组的精神症状、坐车时的焦虑、疼痛、身体问题、整体生活能力和经济问题都明显更差。一开始闪回和回避就重的人，做过晤谈的 3 年后还有症状，没做的恢复了。NICE 指南明确写，不要为预防或治疗创伤后应激障碍提供以心理为主的晤谈。理由是个别做、集体做都没看出好处，还有比不做更差的迹象"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["来源"]},{"tag":"p","props":{"className":"life-citations"},"children":["Lewis C, et al. (2020). Psychological therapies for post-traumatic stress disorder in adults: systematic review and meta-analysis. European Journal of Psychotraumatology. ",{"tag":"a","props":{"href":"https://doi.org/10.1080/20008198.2020.1729633","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1080/20008198.2020.1729633"]},"；Bisson JI, et al. (2013). Psychological therapies for chronic post-traumatic stress disorder (PTSD) in adults. Cochrane Database of Systematic Reviews, CD003388. ",{"tag":"a","props":{"href":"https://doi.org/10.1002/14651858.CD003388.pub4","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1002/14651858.CD003388.pub4"]},"；Rose S, et al. (2002). Psychological debriefing for preventing post traumatic stress disorder (PTSD). Cochrane Database of Systematic Reviews, CD000560. ",{"tag":"a","props":{"href":"https://doi.org/10.1002/14651858.CD000560","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1002/14651858.CD000560"]},"；Mayou RA, Ehlers A, Hobbs M (2000). Psychological debriefing for road traffic accident victims. Three-year follow-up of a randomised controlled trial. British Journal of Psychiatry. ",{"tag":"a","props":{"href":"https://doi.org/10.1192/bjp.176.6.589","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1192/bjp.176.6.589"]},"；National Institute for Health and Care Excellence (2018). Post-traumatic stress disorder (NG116), recommendations 1.6.4, 1.6.5, 1.6.15–1.6.19. ",{"tag":"a","props":{"href":"https://www.nice.org.uk/guidance/ng116/chapter/Recommendations","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.nice.org.uk/guidance/ng116/chapter/Recommendations"]},"；国家卫生健康委办公厅 (2020). 关于印发精神障碍诊疗规范（2020 年版）的通知（国卫办医函〔2020〕945 号），第八章创伤及应激相关障碍. ",{"tag":"a","props":{"href":"https://www.nhc.gov.cn/yzygj/c100068/202012/b4305ace9e14440792eb76d29602c88a.shtml","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.nhc.gov.cn/yzygj/c100068/202012/b4305ace9e14440792eb76d29602c88a.shtml"]},""]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["原书备注"]},{"tag":"p","props":{"className":"life-citations"},"children":["一次性晤谈，是在出事后几天内，把人叫到一起或单独谈一次，让他把经过和当时的感受从头讲一遍。国内规范在急性应激障碍的心理治疗表里还列着集体晤谈，和 NICE 不一致，本条按试验结果写。单位、学校出事后组织这种会，你不想讲可以不讲，也别逼别人讲。头几周先保证安全、吃饭睡觉、身边有人。挂精神科、心理科或临床心理科，直接问能不能做创伤聚焦的心理治疗。道理和本节第 9 条（别一上来就花钱做哀伤咨询）相同。不是人人都要专业干预，力气要用在过了一个月还卡着的人身上。亲人死于意外或凶案的，也常有这些症状，见本节第 4 条（亲人死于意外或凶案）。被性侵之后先做什么，见第 13 节第 42 条（被性侵之后）。警察、医护、消防这类应急救援人员因工作得的，已列进职业病目录。详见第 19 节第 10 条（粉尘、噪声、化学毒物那条的备注）。"]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["我的备注"]},{"tag":"button","props":{"type":"button"},"children":["写下对自己有用的提醒…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/tip/29-13"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["上一条"]},"别拿死当还债的办法：两年内的寿险不赔，工伤不认，债照样先从遗产里扣"]}]},{"tag":"span","props":{},"children":[]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["本主题的其他建议"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/29-03"},"children":[{"tag":"strong","props":{},"children":["失业之后先把作息、医保和找工作的节奏固定下来，别整天待在家里"]},{"tag":"span","props":{},"children":["失业的人之后死亡的概率比在职的人高约六成，男性和年纪不大的人更明显，头十年最高。把抽烟喝酒的影响扣掉，升幅少了约四分之一，这部分自己能管住。先去办失业登记、领失…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/29-04"},"children":[{"tag":"strong","props":{},"children":["亲人死于自杀、意外或凶案的，别指望硬扛，主动去找专业帮助"]},{"tag":"span","props":{},"children":["配偶死于自杀的人，五年内被查出精神障碍的概率比一般人高约八成（男性）、七成（女性）。和配偶死于其他原因的人比，也高七成到一倍。这类丧亲的人更容易觉得被人疏远、觉…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/29-05"},"children":[{"tag":"strong","props":{},"children":["丧偶后的头半年，把三餐、睡觉、慢性病的药和复查交给一个固定的人盯着"]},{"tag":"span","props":{},"children":["丧偶后不到半年，同期死亡的概率比没丧偶的人高约四成。半年以后降到高约一成半。男性高约两成三，女性那一档小到可能只是巧合。该做的是把药、饭和复查落到一个具体的人身…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/29-06"},"children":[{"tag":"strong","props":{},"children":["没有亲人也没有朋友的，把「盯着你的那个人」换成三样东西：能进你家门的邻居、社区的探访名单、手机里的紧急联络"]},{"tag":"span","props":{},"children":["没有亲人也没有朋友时，要顾的是两件事：出了事有人发现你，平时按时吃药吃饭。吃药吃饭靠自己，写成清单、上闹钟，别靠记性。有人发现靠三样：给邻居留一把备用钥匙，去居…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/29-07"},"children":[{"tag":"strong","props":{},"children":["家长去世后，如实告诉孩子、让他参加告别"]},{"tag":"span","props":{},"children":["18 岁前失去父亲或母亲的孩子，之后死亡的概率比没经历过的孩子高约五成。父母死于意外、自杀的高约八成，死于疾病的高约三成。美国儿科学会建议把发生了什么如实讲给孩…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/29-08"},"children":[{"tag":"strong","props":{},"children":["哀伤过了半年还在原地、日子过不下去，去精神科或临床心理科挂号"]},{"tag":"span","props":{},"children":["大约每十个丧亲的成年人里有一个会卡住。半年以上还在持续想念到吃不下饭、上不了班、带不了孩子，人麻木，觉得生活没有意义。这不是不够坚强，它有诊断标准，也有专门的治…"]}]}]}]},{"tag":"a","props":{"className":"life-text-link","href":"/book/29"},"children":["阅读整个主题：遭遇重大打击之后 ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"15","height":"15","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]}]}]},{"tag":"nav","props":{"className":"life-tabbar","aria-label":"主导航"},"children":[{"tag":"a","props":{"className":"","href":"/book"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"21","height":"21","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","s