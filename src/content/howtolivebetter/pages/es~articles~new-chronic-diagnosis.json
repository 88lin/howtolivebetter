24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-up-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M7 7h10v10"},"children":[]},{"tag":"path","props":{"d":"M7 17 17 7"},"children":[]}]}]}]}]}]}]},{"tag":"main","props":{"className":"life-longread"},"children":[{"tag":"a","props":{"className":"life-back-link active","href":"/es/articles","data-status":"active","aria-current":"page"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"Todos los artículos"]},{"tag":"header","props":{"className":"life-longread-header"},"children":[{"tag":"div","props":{},"children":[{"tag":"div","props":{"className":"life-eyebrow"},"children":["Artículos"]},{"tag":"h1","props":{"lang":"es"},"children":["Tras un diagnóstico de enfermedad crónica: la primera semana, los tres primeros meses y después"]},{"tag":"p","props":{"lang":"es"},"children":["Lista para quien acaba de recibir diagnóstico de afecciones crónicas como hipertensión, diabetes, lípidos altos o gota. Los puntos relacionados del libro están repartidos; aquí van…"]},{"tag":"a","props":{"className":"life-longread-chapter","href":"/es/book/16"},"children":["Capítulo relacionado"," · ","Cómo vivir después de un diagnóstico de enfermedad crónica",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"img","props":{"src":"/sites/howtolivebetter/images/book-chapters/16-chronic-care-editorial.webp","srcSet":"/sites/howtolivebetter/images/book-chapters/16-chronic-care-editorial-thumb.webp 600w, /sites/howtolivebetter/images/book-chapters/16-chronic-care-editorial-md.webp 900w, /sites/howtolivebetter/images/book-chapters/16-chronic-care-editorial.webp 1200w","sizes":"(max-width: 760px) 100vw, 450px","alt":"","width":"1200","height":"800","fetchPriority":"high"},"children":[]}]},{"tag":"div","props":{"className":"life-longread-layout"},"children":[{"tag":"aside","props":{"className":"life-longread-toc"},"children":[{"tag":"details","props":{"open":true},"children":[{"tag":"summary","props":{},"children":["En esta página"]},{"tag":"nav","props":{"aria-label":"En esta página"},"children":[{"tag":"a","props":{"href":"#la-semana-del-diagnóstico"},"children":["La semana del diagnóstico"]},{"tag":"a","props":{"href":"#los-tres-primeros-meses"},"children":["Los tres primeros meses"]},{"tag":"a","props":{"href":"#cuando-la-enfermedad-esté-estable"},"children":["Cuando la enfermedad esté estable"]}]}]}]},{"tag":"div","props":{"className":"life-longread-main"},"children":[{"tag":"article","props":{"className":"life-article-body","lang":"es"},"children":[{"tag":"blockquote","props":{},"children":["\n",{"tag":"p","props":{},"children":["Traducción no oficial de ",{"tag":"a","props":{"href":"/articles/new-chronic-diagnosis"},"children":["docs/刚确诊慢性病之后.md"]},". En caso de discrepancias, prevalece el original en chino."]},"\n"]},"\n",{"tag":"p","props":{},"children":[{"tag":"a","props":{"href":"https://github.com/dlgrv/HowToLiveBetter/blob/5a8aac6e715851066661ab6524c3a4e650f7e9d7/README.es.md","target":"_blank","rel":"noopener noreferrer"},"children":["← Volver al índice"]}]},"\n",{"tag":"p","props":{},"children":["Lista para quien acaba de recibir diagnóstico de afecciones crónicas como hipertensión, diabetes, lípidos altos o gota. Los puntos relacionados del libro están repartidos; aquí van por tiempo. Cada línea es solo la acción; motivos, cifras y fuentes están en el punto citado. Omita lo que no aplique a su caso."]},"\n",{"tag":"h2","props":{"id":"la-semana-del-diagnóstico"},"children":["La semana del diagnóstico"]},"\n",{"tag":"ol","props":{},"children":["\n",{"tag":"li","props":{},"children":["Si la enfermedad es grave, que alguien le acompañe al recoger el informe; no se quede solo en casa ese día. Posponer la baja, vender la vivienda y pasos similares. Véase ",{"tag":"a","props":{"href":"/es/book/29"},"children":["sección 29, punto 2"]}," (la semana tras un diagnóstico grave)."]},"\n",{"tag":"li","props":{},"children":["Si el médico recetó medicación, empiece hoy según la receta; no deje de tomarla porque se sienta mejor. Véase ",{"tag":"a","props":{"href":"/es/book/16"},"children":["sección 16, punto 1"]}," (tomar la medicación según lo recetado)."]},"\n",{"tag":"li","props":{},"children":["Con hipertensión y lípidos altos, tome la medicación con regularidad; no la suspenda por su cuenta. Véase ",{"tag":"a","props":{"href":"/es/book/02"},"children":["sección 2, punto 12"]}," (hipertensión y lípidos altos: medicación según lo recetado)."]},"\n",{"tag":"li","props":{},"children":["Con hipertensión, compre un tensiómetro doméstico y mida en casa hasta alcanzar el objetivo. Véase ",{"tag":"a","props":{"href":"/es/book/01"},"children":["sección 1, punto 7"]}," (medir la presión y tratar hasta el objetivo)."]},"\n",{"tag":"li","props":{},"children":["Al recoger recetas, pregunte si hay medicamentos de compra centralizada o genéricos. Véase ",{"tag":"a","props":{"href":"/es/book/05"},"children":["sección 5, punto 12"]}," (genéricos y compra centralizada)."]},"\n",{"tag":"li","props":{},"children":["Al diagnosticar diabetes tipo 2, un examen ocular con dilatación una vez; en tipo 1, a partir del quinto año. Véase ",{"tag":"a","props":{"href":"/es/book/16"},"children":["sección 16, punto 7"]}," (examen ocular al diagnosticar diabetes)."]},"\n",{"tag":"li","props":{},"children":["Al diagnosticar gota, inicie terapia prolongada para bajar el ácido úrico y mantenga el ácido úrico sérico por debajo de 360 µmol/L. Véase ",{"tag":"a","props":{"href":"/es/book/16"},"children":["sección 16, punto 9"]}," (bajar el ácido úrico a largo plazo en la gota)."]},"\n",{"tag":"li","props":{},"children":["Antes de alopurinol en personas de etnia han, pregunte si conviene analizar el genotipo HLA-B*5801. Véase ",{"tag":"a","props":{"href":"/es/book/16"},"children":["sección 16, punto 9"]}," (bajar el ácido úrico a largo plazo en la gota)."]},"\n",{"tag":"li","props":{},"children":["Ácido úrico alto solo en un chequeo, sin crisis de gota nunca, no es gota; aún no inicie fármacos para bajar el ácido úrico. Véase ",{"tag":"a","props":{"href":"/es/book/06"},"children":["sección 6, punto 19"]}," (ácido úrico alto sin dolor de gota)."]},"\n",{"tag":"li","props":{},"children":["Si fuma, fije una fecha para dejarlo y deje por completo ese día. Véase ",{"tag":"a","props":{"href":"/es/book/02"},"children":["sección 2, punto 4"]}," (fijar fecha para dejar de fumar)."]},"\n",{"tag":"li","props":{},"children":["No confíe solo en la fuerza de voluntad para dejar de fumar; acuda a una clínica de deshabituación tabáquica o neumología para medicación. Véase ",{"tag":"a","props":{"href":"/es/book/02"},"children":["sección 2, punto 3"]}," (medicación para dejar de fumar)."]},"\n"]},"\n",{"tag":"h2","props":{"id":"los-tres-primeros-meses"},"children":["Los tres primeros meses"]},"\n",{"tag":"ol","props":{},"children":["\n",{"tag":"li","props":{},"children":["Lleve un cuaderno: en cada revisión anote fecha, analíticas, fármacos y dosis. Véase ",{"tag":"a","props":{"href":"/es/book/16"},"children":["sección 16, punto 3"]}," (un cuaderno para todas las mediciones)."]},"\n",{"tag":"li","props":{},"children":["Tras cada visita, guarde su copia de historiales, analíticas e imágenes. Véase ",{"tag":"a","props":{"href":"/es/book/24"},"children":["sección 24, punto 5"]}," (conservar su propia documentación médica)."]},"\n",{"tag":"li","props":{},"children":["En su localidad de seguro, solicite la designación ambulatoria de enfermedad crónica/especial; si suele tratarse fuera, también el registro interregional. Véase ",{"tag":"a","props":{"href":"/es/book/16"},"children":["sección 16, punto 2"]}," (designación crónica ambulatoria y registro interregional)."]},"\n",{"tag":"li","props":{},"children":["Si un familiar tiene seguro médico de empleado, pida vincular el uso familiar de la cuenta para pagar su atención y medicamentos. Véase ",{"tag":"a","props":{"href":"/es/book/05"},"children":["sección 5, punto 13"]}," (uso familiar de la cuenta)."]},"\n",{"tag":"li","props":{},"children":["Antes de firmar con un médico de familia comunitario, pregunte qué cubre el seguro y qué es de pago propio. Véase ",{"tag":"a","props":{"href":"/es/book/16"},"children":["sección 16, punto 6"]}," (preguntar antes de firmar con el médico de familia)."]},"\n",{"tag":"li","props":{},"children":["Pase la sal de la casa a sal baja en sodio. Con insuficiencia renal o fármacos que ahorran potasio, pregunte al médico primero. Véase ",{"tag":"a","props":{"href":"/es/book/02"},"children":["sección 2, punto 9"]}," (sal baja en sodio)."]},"\n",{"tag":"li","props":{},"children":["Empiece a caminar a diario; objetivo 7000–8000 pasos o 150–300 minutos de caminata rápida a la semana. Véase ",{"tag":"a","props":{"href":"/es/book/02"},"children":["sección 2, punto 11"]}," (7000–8000 pasos al día)."]},"\n",{"tag":"li","props":{},"children":["Beba menos alcohol; lo mejor es ninguno. Véase ",{"tag":"a","props":{"href":"/es/book/02"},"children":["sección 2, punto 19"]}," (menos alcohol o ninguno)."]},"\n",{"tag":"li","props":{},"children":["Si bebe a diario y al parar tiene temblores o palpitaciones, no deje solo; vaya al hospital primero. Véase ",{"tag":"a","props":{"href":"/es/book/02"},"children":["sección 2, punto 20"]}," (no dejar el alcohol de golpe solo)."]},"\n",{"tag":"li","props":{},"children":["Si le instan a dejar la medicación por remedios populares, no la deje; avise a su médico antes de cualquier suplemento. Véase ",{"tag":"a","props":{"href":"/es/book/16"},"children":["sección 16, punto 4"]}," (no suspender el tratamiento por remedios populares o suplementos)."]},"\n",{"tag":"li","props":{},"children":["No gaste mucho en productos de salud o fórmulas tonificantes para «reponer» el cuerpo. Véase ",{"tag":"a","props":{"href":"/es/book/06"},"children":["sección 6, punto 10"]}," (productos de salud y tónicos caros)."]},"\n",{"tag":"li","props":{},"children":["Al iniciar terapia para bajar el ácido úrico en gota, las crisis son más frecuentes en los 3–6 primeros meses. Si duele más, añada antiinflamatorio según indicación; no suspenda los fármacos para bajar el ácido úrico. Véase ",{"tag":"a","props":{"href":"/es/book/16"},"children":["sección 16, punto 9"]}," (bajar el ácido úrico a largo plazo en la gota)."]},"\n",{"tag":"li","props":{},"children":["Antes de comprar medicamentos para el resfriado o el dolor, lea ingredientes; el paracetamol debe figurar en un solo producto. Véase ",{"tag":"a","props":{"href":"/es/book/34"},"children":["sección 34, punto 1"]}," (paracetamol en un solo producto)."]},"\n",{"tag":"li","props":{},"children":["Si toma anticoagulantes o esteroides, pregunte al médico antes de analgésicos tipo ibuprofeno. Véase ",{"tag":"a","props":{"href":"/es/book/34"},"children":["sección 34, punto 3"]}," (ibuprofeno con anticoagulantes o esteroides)."]},"\n"]},"\n",{"tag":"h2","props":{"id":"cuando-la-enfermedad-esté-estable"},"children":["Cuando la enfermedad esté estable"]},"\n",{"tag":"ol","props":{},"children":["\n",{"tag":"li","props":{},"children":["Con estabilidad y sin cambio de medicación, puede obtener hasta 12 semanas de medicación en una visita comunitaria. Véase ",{"tag":"a","props":{"href":"/es/book/16"},"children":["sección 16, punto 5"]}," (recetas de 12 semanas en clínica comunitaria)."]},"\n",{"tag":"li","props":{},"children":["Respete el intervalo de seguimiento que fijó el médico; anote cada visita en el mismo cuaderno. Véase ",{"tag":"a","props":{"href":"/es/book/16"},"children":["sección 16, punto 3"]}," (seguimiento según calendario)."]},"\n",{"tag":"li","props":{},"children":["Tras cambiar a medicamentos de compra centralizada, vigile las cifras del cuaderno; si empeoran de verdad, consulte al médico — no suspenda por su cuenta. Véase ",{"tag":"a","props":{"href":"/es/book/05"},"children":["sección 5, punto 12"]}," (genéricos y compra centralizada)."]},"\n",{"tag":"li","props":{},"children":["Con diabetes, examen de pies anual y ojos según el intervalo que indique el médico. Véase ",{"tag":"a","props":{"href":"/es/book/16"},"children":["sección 16, punto 7"]}," (examen ocular al diagnosticar diabetes; examen anual de pies)."]},"\n",{"tag":"li","props":{},"children":["Con gota, siga tomando medicación para bajar el ácido úrico aunque el nivel esté en objetivo. Véase ",{"tag":"a","props":{"href":"/es/book/16"},"children":["sección 16, punto 9"]}," (bajar el ácido úrico a largo plazo en la gota)."]},"\n",{"tag":"li","props":{},"children":["Tras cálculos renales, beba 2,5–3 litros de agua al día y mantenga la sal por debajo de 6 g. Véase ",{"tag":"a","props":{"href":"/es/book/16"},"children":["sección 16, punto 8"]}," (agua tras cálculos renales)."]},"\n",{"tag":"li","props":{},"children":["Con enfermedad cardiovascular, una vacuna de gripe cada otoño. Véase ",{"tag":"a","props":{"href":"/es/book/01"},"children":["sección 1, punto 20"]}," (vacuna anual de gripe)."]},"\n",{"tag":"li","props":{},"children":["Para enfermedades habituales, empiece a nivel comunitario; para hospitalización, suba por derivación para que continúe el deducible hospitalario. Véase ",{"tag":"a","props":{"href":"/es/book/24"},"children":["sección 24, punto 1"]}," (comunidad primero, derivación por niveles)."]},"\n",{"tag":"li","props":{},"children":["En el mismo pool de seguro, cada nivel hospitalario superior reduce el reembolso unos diez puntos porcentuales — no suba de nivel sin necesidad. Véase ",{"tag":"a","props":{"href":"/es/book/24"},"children":["sección 24, punto 2"]}," (nivel más bajo, más reembolso)."]},"\n",{"tag":"li","props":{},"children":["Para especialista en hospital grande, use derivación comunitaria o centro de derivaciones; no use revendedores. Véase ",{"tag":"a","props":{"href":"/es/book/24"},"children":["sección 24, punto 3"]}," (centro de derivaciones)."]},"\n",{"tag":"li","props":{},"children":["Antes de atención en otra provincia, pregunte en su localidad cuánto reembolsarán — puede ser menos que tratarse allí. Véase ",{"tag":"a","props":{"href":"/es/book/24"},"children":["sección 24, punto 4"]}," (preguntar antes de atención interprovincial)."]},"\n"]},"\n"]},{"tag":"footer","props":{"className":"life-article-attribution"},"children":[{"tag":"p","props":{},"children":["Artículo reproducido del proyecto abierto HowToLiveBetter, conservando el texto y las notas. Consulta las actualizaciones en el repositorio original."]},{"tag":"a","props":{"href":"https://github.com/dlgrv/HowToLiveBetter/blob/5a8aac6e715851066661ab6524c3a4e650f7e9d7/docs/research/es/Right-After-A-Chronic-Disease-Diagnosis.md","target":"_blank","rel":"noopener noreferrer"},"children":["Ver versión original · 5a8aac6",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"14","height":"14","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]},{"tag":"span","props