rokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"分享这条建议"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"收起详情"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["成本"]},{"tag":"p","props":{"className":"life-citations"},"children":["不花钱。找个人陪你去拿报告。把治疗以外的大决定推后几天。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["收益"]},{"tag":"p","props":{"className":"life-citations"},"children":["瑞典全国档案跟踪 607 万多人（6,073,240 人），时间是 1991 至 2006 年。和没确诊癌症的人相比，确诊后第一周自杀相对风险 12.6（95% CI 8.6–17.8），即约 12.6 倍。真实倍数大致在 8.6 到 17.8 之间。这一周的发病率是 2.50/1000 人年，也就是 1000 人跟一年出 2.5 例。到第一年降到 3.1（2.7–3.5，0.60/1000 人年），约 3.1 倍。心血管死亡第一周 5.6（5.2–5.9，116.80/1000 人年），约 5.6 倍。前 4 周 3.3（3.1–3.4，65.81/1000 人年）。风险升高在确诊后第一年内迅速回落。越是治起来难、活下来概率低的癌种，升得越明显。把同一批患者不同时间段自己跟自己比，结论一致"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["来源"]},{"tag":"p","props":{"className":"life-citations"},"children":["Fang F, et al. (2012). Suicide and cardiovascular death after a cancer diagnosis. New England Journal of Medicine. ",{"tag":"a","props":{"href":"https://doi.org/10.1056/NEJMoa1110307","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1056/NEJMoa1110307"]},""]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["原书备注"]},{"tag":"p","props":{"className":"life-citations"},"children":["这是癌症病人的数据。换到别的重大诊断，没有同等分量的原文。出事的人其实很少：第一周自杀率 2.50/1000 人年，即 1000 人跟一年出 2.5 例。写出来不是吓人，是说明「刚知道的那几天」要有人在旁边。确诊后的长期管理、报销和复查见第 16 节和第 24 节。找不到人陪着去的见本节第 6 条（把「那个人」换成邻居和社区名单）。"]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["我的备注"]},{"tag":"button","props":{"type":"button"},"children":["写下对自己有用的提醒…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/tip/29-01"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["上一条"]},"亲人刚走的那几天别一个人待着，有心脏病、高血压、糖尿病的照常吃药，胸口压着疼就叫 120"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/tip/29-03"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["下一条"]},"失业之后先把作息、医保和找工作的节奏固定下来，别整天待在家里"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["本主题的其他建议"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/29-04"},"children":[{"tag":"strong","props":{},"children":["亲人死于自杀、意外或凶案的，别指望硬扛，主动去找专业帮助"]},{"tag":"span","props":{},"children":["配偶死于自杀的人，五年内被查出精神障碍的概率比一般人高约八成（男性）、七成（女性）。和配偶死于其他原因的人比，也高七成到一倍。这类丧亲的人更容易觉得被人疏远、觉…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/29-05"},"children":[{"tag":"strong","props":{},"children":["丧偶后的头半年，把三餐、睡觉、慢性病的药和复查交给一个固定的人盯着"]},{"tag":"span","props":{},"children":["丧偶后不到半年，同期死亡的概率比没丧偶的人高约四成。半年以后降到高约一成半。男性高约两成三，女性那一档小到可能只是巧合。这个差不是靠想开点能扛过去的。该做的是把…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/29-06"},"children":[{"tag":"strong","props":{},"children":["没有亲人也没有朋友的，把「盯着你的那个人」换成三样东西：能进你家门的邻居、社区的探访名单、手机里的紧急联络"]},{"tag":"span","props":{},"children":["没有亲人也没有朋友时，要顾的是两件事：出了事有人发现你，平时按时吃药吃饭。吃药吃饭靠自己，写成清单、上闹钟，别靠记性。有人发现靠三样：给邻居留一把备用钥匙，去居…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/29-07"},"children":[{"tag":"strong","props":{},"children":["家长去世后，如实告诉孩子、让他参加告别、别送去别处「换个环境」"]},{"tag":"span","props":{},"children":["18 岁前失去父亲或母亲的孩子，到成年早期死亡的概率比没经历过的孩子高约五成。父母死于意外、自杀的高约八成，死于疾病的高约三成。家里能做的是如实告诉他，让他参加…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/29-08"},"children":[{"tag":"strong","props":{},"children":["哀伤过了半年还在原地、日子过不下去，去精神科或临床心理科挂号"]},{"tag":"span","props":{},"children":["大约每十个丧亲的成年人里有一个会卡住：半年以上还在持续想念到吃不下饭、上不了班、带不了孩子，人麻木，觉得生活没有意义。这不是不够坚强，它有诊断标准，也有专门的治…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/29-09"},"children":[{"tag":"strong","props":{},"children":["别一上来就花钱做哀伤咨询，先看自己的哀伤是不是真的卡住了（第 8 条那几条症状）"]},{"tag":"span","props":{},"children":["给所有丧亲的人都安排心理咨询，好处很小，过一阵就看不出来了，因为多数人本来会自己缓过来。但对已经明显适应不了的人，治疗和治别的心理问题一样有效。所以先对照第 8…"]}]}]}]},{"tag":"a","props":{"className":"life-text-link","href":"/book/29"},"children":["阅读整个主题：遭遇重大打击之后 ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"15","height":"15","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]}]}]}]},{"tag":"aside","props":{"className":"life-ad-space life-ad-space-sponsored","data-ad-placement":"ad_footer","data-ad-group":"reading","data-ad-creative":"read_product","data-ad-ready":"false","aria-label":"广告 · 社区推荐"},"children":[{"tag":"div","props":{"className":"life-ad-space-brand"},"children":[{"tag":"img","props":{"src":"/sites/howtolivebetter/images/shengcai/logo.png","width":"565","height":"144","alt":"生财有术官方 Logo","decoding":"async"},"children":[]}]},{"tag":"div","props":{"className":"life-ad-space-copy"},"children":[{"tag":"span","props":{"className":"life-ad-space-label"},"children":["广告 · 社区推荐"]},{"tag":"strong","props":{},"children":["读过的知识，能不能做成有用的产品？"]},{"tag":"p","props":{},"children":["从电子书、资料到小工具，看看圈友怎样发现需求，把内容变成实际交付。"]}]},{"tag":"div","props":{"className":"life-ad-space-actions"},"children":[{"tag":"a","props":{"className":"life-ad-space-link","href":"/shengcaiyoushu?sc_group=reading&sc_creative=read_product&sc_placement=ad_footer"},"children":["看看社区与案例",{"tag":"svg","props":{"xmlns