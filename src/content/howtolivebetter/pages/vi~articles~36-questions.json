ips-editorial.webp","srcSet":"/sites/howtolivebetter/images/book-chapters/10-relationships-editorial-thumb.webp 600w, /sites/howtolivebetter/images/book-chapters/10-relationships-editorial-md.webp 900w, /sites/howtolivebetter/images/book-chapters/10-relationships-editorial.webp 1200w","sizes":"(max-width: 760px) 100vw, 450px","alt":"","width":"1200","height":"800","fetchPriority":"high"},"children":[]}]},{"tag":"a","props":{"className":"life-longread-chapter","href":"/vi/book/10#10-05"},"children":["Mục liên quan"," · ","10-05"]},{"tag":"section","props":{"className":"connection-question"},"children":[{"tag":"h2","props":{},"children":["Cùng trả lời 36 câu hỏi"]},{"tag":"p","props":{},"children":["Trả lời một câu trước, rồi mời mọi người cùng trả lời. Sau khi gửi từng câu, các bạn sẽ thấy câu trả lời của nhau rồi từ từ trò chuyện qua câu tiếp theo."]},{"tag":"a","props":{"className":"life-longread-chapter","href":"/vi/together"},"children":["Bắt đầu trả lời"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"div","props":{"className":"life-longread-layout"},"children":[{"tag":"aside","props":{"className":"life-longread-toc"},"children":[{"tag":"details","props":{"open":true},"children":[{"tag":"summary","props":{},"children":["Trên trang này"]},{"tag":"nav","props":{"aria-label":"Trên trang này"},"children":[{"tag":"a","props":{"href":"#danh-sách-đầy-đủ-và-phần-giới-thiệu"},"children":["Danh sách đầy đủ và phần giới thiệu"]},{"tag":"a","props":{"href":"#36-câu-hỏi-giúp-hai-người-xa-lạ-nhanh-chóng-trở-nên-gần-gũi"},"children":["36 câu hỏi giúp hai người xa lạ nhanh chóng trở nên gần gũi"]},{"tag":"a","props":{"href":"#nghiên-cứu-cho-thấy-điều-gì"},"children":["Nghiên cứu cho thấy điều gì"]},{"tag":"a","props":{"href":"#trước-khi-bắt-đầu-nói-rõ-ý-định-bằng-một-câu"},"children":["Trước khi bắt đầu, nói rõ ý định bằng một câu"]},{"tag":"a","props":{"href":"#luân-phiên-trả-lời-đừng-biến-thành-phỏng-vấn"},"children":["Luân phiên trả lời, đừng biến thành phỏng vấn"]},{"tag":"a","props":{"href":"#nếu-cảm-thấy-quá-riêng-tư-hãy-lùi-lại-một-chút"},"children":["Nếu cảm thấy quá riêng tư, hãy lùi lại một chút"]},{"tag":"a","props":{"href":"#trò-chuyện-xong-đừng-vội-kết-luận"},"children":["Trò chuyện xong, đừng vội kết luận"]},{"tag":"a","props":{"href":"#trở-lại-lời-khuyên-tương-ứng-trong-sách"},"children":["Trở lại lời khuyên tương ứng trong sách"]}]}]}]},{"tag":"div","props":{"className":"life-longread-main"},"children":[{"tag":"article","props":{"className":"life-article-body","lang":"vi"},"children":[{"tag":"p","props":{},"children":["Khi cả hai đều muốn dành thời gian trò chuyện nghiêm túc, một danh sách câu hỏi có thứ tự có thể giúp mở đầu. Giá trị của nó là tạo cơ hội để cả hai bày tỏ, chứ không phải cung cấp một bộ lời thoại khiến người khác thích mình."]},"\n",{"tag":"h2","props":{"id":"danh-sách-đầy-đủ-và-phần-giới-thiệu"},"children":["Danh sách đầy đủ và phần giới thiệu"]},"\n",{"tag":"p","props":{},"children":["Dưới đây là toàn văn bài viết của Daniel Jones từ ",{"tag":"a","props":{"href":"https://cn.nytimes.com/culture/20150123/t23questions/","target":"_blank","rel":"noopener noreferrer"},"children":["ấn bản tiếng Trung của The New York Times"]},", được dịch tại đây với sự hỗ trợ của máy. Bạn cũng có thể xem ",{"tag":"a","props":{"href":"https://ggia.berkeley.edu/practice/36_questions_for_increasing_closeness/","target":"_blank","rel":"noopener noreferrer"},"children":["câu hỏi và hướng dẫn bằng tiếng Anh"]},". Hai người có thể luân phiên đọc và trả lời ngay trên trang này; bài thực hành gốc thường cần khoảng 45 phút. Sau bài viết là những gợi ý thực hành do trang web biên soạn."]},"\n",{"tag":"h2","props":{"id":"36-câu-hỏi-giúp-hai-người-xa-lạ-nhanh-chóng-trở-nên-gần-gũi"},"children":["36 câu hỏi giúp hai người xa lạ nhanh chóng trở nên gần gũi"]},"\n",{"tag":"p","props":{},"children":["Daniel Jones"]},"\n",{"tag":"p","props":{},"children":[{"tag":"img","props":{"src":"/sites/howtolivebetter/external/static01.nyt.com/images/2014/02/11/science/11WELL/11WELL-master1050.jpg","alt":"Minh họa của Stuart Bradford"},"children":[]}]},"\n",{"tag":"p","props":{},"children":["Minh họa: Stuart Bradford"]},"\n",{"tag":"p","props":{},"children":["Trong bài viết cho chuyên mục Modern Love, «Cách nhanh chóng yêu một người xa lạ», Mandy Len Catron nhắc đến nghiên cứu của nhà tâm lý học Arthur Aron và các đồng nghiệp: sự thân mật giữa hai người xa lạ có thể tăng nhanh khi họ hỏi nhau những câu hỏi cá nhân nhất định. 36 câu hỏi này được chia thành ba nhóm, mỗi nhóm đi sâu hơn nhóm trước."]},"\n",{"tag":"p","props":{},"children":["Ý tưởng cốt lõi là cùng bộc lộ sự dễ tổn thương có thể thúc đẩy cảm giác gần gũi. Các tác giả nghiên cứu mô tả một khuôn mẫu quan trọng để phát triển sự thân mật là việc chia sẻ về bản thân một cách liên tục, sâu dần, có qua có lại và mang tính cá nhân. Cho phép mình bộc lộ sự dễ tổn thương với người khác có thể rất khó; bài thực hành dưới đây thúc đẩy bạn làm điều đó."]},"\n",{"tag":"p","props":{},"children":["Điều cuối cùng Catron và người bạn thử trong bài viết là nhìn vào mắt nhau trong bốn phút. Quá trình này không được ghi lại chi tiết; thực ra có thể kéo dài từ hai đến bốn phút. Tuy vậy, Catron vẫn khuyên thử mà không do dự. «Hai phút đã rất đáng kinh ngạc», cô nói với tôi. «Bốn phút thực sự có hiệu quả»."]},"\n",{"tag":"h3","props":{"id":"nhóm-thứ-nhất"},"children":["Nhóm thứ nhất"]},"\n",{"tag":"ol","props":{},"children":["\n",{"tag":"li","props":{},"children":["Nếu có thể chọn bất kỳ ai trên thế giới, bạn muốn mời ai ăn tối cùng mình?"]},"\n",{"tag":"li","props":{},"children":["Bạn có muốn nổi tiếng không? Bạn muốn nổi tiếng theo cách nào?"]},"\n",{"tag":"li","props":{},"children":["Trước khi gọi điện, bạn có tập trước những điều sẽ nói không? Vì sao?"]},"\n",{"tag":"li","props":{},"children":["Với bạn, một ngày «hoàn hảo» sẽ như thế nào?"]},"\n",{"tag":"li","props":{},"children":["Lần cuối bạn tự hát cho mình nghe là khi nào? Còn hát cho người khác nghe?"]},"\n",{"tag":"li","props":{},"children":["Nếu có thể sống đến 90 tuổi và giữ được trí óc hoặc cơ thể của mình ở tuổi 30, bạn sẽ chọn giữ điều nào?"]},"\n",{"tag":"li","props":{},"children":["Bạn đã bao giờ âm thầm có linh cảm về cách mình sẽ chết chưa?"]},"\n",{"tag":"li","props":{},"children":["Hãy nêu ba đặc điểm mà bạn và người cùng trò chuyện có vẻ giống nhau."]},"\n",{"tag":"li","props":{},"children":["Trong cuộc đời, điều gì khiến bạn biết ơn nhất?"]},"\n",{"tag":"li","props":{},"children":["Nếu có thể thay đổi một điều trong cách mình được nuôi dạy, bạn sẽ thay đổi điều gì?"]},"\n",{"tag":"li","props":{},"children":["Dành bốn phút kể cho người kia câu chuyện cuộc đời mình, càng chi tiết càng tốt."]},"\n",{"tag":"li","props":{},"children":["Nếu sáng mai thức dậy và có thêm một tài năng hoặc khả năng, bạn muốn đó là gì?"]},"\n"]},"\n",{"tag":"h3","props":{"id":"nhóm-thứ-hai"},"children":["Nhóm thứ hai"]},"\n",{"tag":"ol","props":{"start":"13"},"children":["\n",{"tag":"li","props":{},"children":["Nếu một quả cầu pha lê có thể cho bạn biết sự thật về bản thân, cuộc đời, tương lai hay bất cứ điều gì, bạn có muốn biết không?"]},"\n",{"tag":"li","props":{},"children":["Có việc gì bạn luôn mơ ước làm nhưng chưa làm không? Vì sao bạn chưa làm?"]},"\n",{"tag":"li","props":{},"children":["Thành tựu lớn nhất trong cuộc đời bạn là gì?"]},"\n",{"tag":"li","props":{},"children":["Bạn trân trọng điều gì nhất trong một tình bạn?"]},"\n",{"tag":"li","props":{},"children":["Kỷ niệm quý giá nhất của bạn là gì?"]},"\n",{"tag":"li","props":{},"children":["Kỷ niệm tồi tệ nhất của bạn là gì?"]},"\n",{"tag":"li","props":{},"children":["Nếu biết mình sẽ đột ngột qua đời trong vòng một năm, bạn có thay đổi cách sống hiện tại không? Vì sao?"]},"\n",{"tag":"li","props":{},"children":["Tình bạn có ý nghĩa gì với bạn?"]},"\n",{"tag":"li","props":{},"children":["Tình yêu và sự trìu mến đóng vai trò gì trong cuộc sống của bạn?"]},"\n",{"tag":"li","props":{},"children":["Luân phiên nêu một phẩm chất tốt mà bạn thấy ở người kia. Mỗi người nêu năm phẩm chất."]},"\n",{"tag":"li","props":{},"children":["Quan hệ trong gia đình bạn có gần gũi và ấm áp không? Bạn có nghĩ tuổi thơ của mình hạnh phúc hơn của những người khác không?"]},"\n",{"tag":"li","props":{},"children":["Quan hệ giữa bạn và mẹ như thế nào?"]},"\n"]},"\n",{"tag":"h3","props":{"id":"nhóm-thứ-ba"},"children":["Nhóm thứ ba"]},"\n",{"tag":"ol","props":{"start":"25"},"children":["\n",{"tag":"li","props":{},"children":["Mỗi người đặt ba câu có từ «chúng ta» và phản ánh tình huống thực tế, chẳng hạn «Hai chúng ta đang ở trong căn phòng này và cảm thấy…»."]},"\n",{"tag":"li","props":{},"children":["Hoàn thành câu: «Tôi ước có ai đó bên cạnh để cùng chia sẻ…»."]},"\n",{"tag":"li","props":{},"children":["Nếu muốn trở thành bạn thân của người kia, hãy cho họ biết những điều quan trọng họ cần biết về bạn."]},"\n",{"tag":"li","props":{},"children":["Nói với người kia điều bạn thích ở họ. Hãy thật thành thật và nói những điều bạn sẽ không nói với một người mới gặp thoáng qua."]},"\n",{"tag":"li","props":{},"children":["Chia sẻ với người kia những khoảnh khắc khiến bạn ngượng ngùng trong đời."]},"\n",{"tag":"li","props":{},"children":["Lần cuối bạn khóc trước mặt người khác là khi nào? Còn khi ở một mình?"]},"\n",{"tag":"li","props":{},"children":["Nói với người kia những phẩm chất của họ mà bạn đã thấy thích."]},"\n",{"tag":"li","props":{},"children":["Có điều gì bạn cho là quá nghiêm túc để đem ra đùa không? Nếu có, đó là gì?"]},"\n",{"tag":"li","props":{},"children":["Nếu tối nay bạn sẽ qua đời và không có cơ hội liên lạc với bất kỳ ai, bạn sẽ tiếc vì chưa nói điều gì với ai đó? Vì sao đến giờ bạn vẫn chưa nói với họ?"]},"\n",{"tag":"li","props":{},"children":["Tất cả đồ đạc của bạn đều ở trong nhà, và nhà đang cháy. Sau khi cứu gia đình và thú cưng, bạn còn có thể quay vào an toàn một lần cuối để lấy một món đồ. Bạn sẽ lấy gì, và vì sao?"]},"\n",{"tag":"li","props":{},"children":["Trong gia đình, ai qua đời sẽ khiến bạn buồn nhất? Vì sao?"]},"\n",{"tag":"li","props":{},"children":["Nêu một vấn đề cá nhân và hỏi người kia sẽ giải quyết thế nào nếu gặp tình huống đó. Đồng thời, hãy nhờ họ nói thật rằng, theo họ, bạn đang cảm thấy thế nào về vấn đề này."]},"\n"]},"\n",{"tag":"h2","props":{"id":"nghiên-cứu-cho-thấy-điều-gì"},"children":["Nghiên cứu cho thấy điều gì"]},"\n",{"tag":"p","props":{},"children":[{"tag":"a","props":{"href":"https://doi.org/10.1177/0146167297234003","target":"_blank","rel":"noopener noreferrer"},"children":["Nghiên cứu gốc năm 1997 của Aron và cộng sự"]}," so sánh các hoạt động trò chuyện đi sâu dần với trò chuyện xã giao. Nhóm thứ nhất tạo ra cảm giác gần gũi ngay sau cuộc trò chuyện cao hơn. Kết quả này không chứng minh rằng hai người chắc chắn sẽ yêu nhau, cũng không dự đoán được một mối quan hệ sẽ kéo dài bao lâu."]},"\n",{"tag":"p","props":{},"children":["Chỉ cần xem đây là một cơ hội tìm hiểu nhau. Nếu cảm thấy gần gũi hơn sau khi trò chuyện, hai người có thể tiếp tục gặp gỡ; nếu thấy không phù hợp, đó cũng là thông tin hữu ích. Đừng xem việc hoàn thành danh sách là lý do để đòi hỏi người kia phải thích mình, tiếp tục hẹn hò hay trả lời thêm câu hỏi."]},"\n",{"tag":"h2","props":{"id":"trước-khi-bắt-đầu-nói-rõ-ý-định-bằng-một-câu"},"children":["Trước khi bắt đầu, nói rõ ý định bằng một câu"]},"\n",{"tag":"p","props":{},"children":["Bạn có thể mời như sau: “Mình tìm một chỗ yên tĩnh rồi lần lượt trả lời vài câu hỏi nhé? Câu nào không muốn trả lời thì cứ bỏ qua, và có thể dừng bất cứ lúc nào.”"]},"\n",{"tag":"p","props":{},"children":["Cùng chọn một khoảng thời gian ít bị làm phiền. Chỉ dùng điện thoại để xem câu hỏi, đừng vừa trả lời vừa đọc tin nhắn. Lần đầu thử không cần đặt nhà hàng đắt tiền hay lên kế hoạch hoạt động cả ngày; chọn một nơi cả hai đều thoải mái là đủ."]},"\n",{"tag":"p","props":{},"children":["Thống nhất trước rằng không ghi âm, không chụp màn hình rồi chuyển tiếp câu trả lời của nhau. Khi nhắc đến người thứ ba, hạn chế nêu tên và những chi tiết có thể nhận diện họ. Nếu người kia không muốn nói thêm về một chủ đề, hãy dừng ở đó."]},"\n",{"tag":"h2","props":{"id":"luân-phiên-trả-lời-đừng-biến-thành-phỏng-vấn"},"children":["Luân phiên trả lời, đừng biến thành phỏng vấn"]},"\n",{"tag":"p","props":{},"children":["Đọc một câu hỏi, để cả hai lần lượt trả lời rồi mới chuyển sang câu tiếp theo. Đừng để một người nói hết còn người kia chỉ đặt câu hỏi. Sau khi nghe câu trả lời, bạn có thể hỏi: “Bạn muốn mình chỉ lắng nghe, hay cũng chia sẻ suy nghĩ của mình?”"]},"\n",{"tag":"p","props":{},"children":["Nếu chưa nghĩ ra câu trả lời hay, kể một việc nhỏ cụ thể thường dễ hơn tìm một đáp án hoàn hảo. Chẳng hạn, bạn có thể mở đầu bằng những câu hỏi do trang web tự viết sau đây:"]},"\n",{"tag":"ul","props":{},"children":["\n",{"tag":"li","props":{},"children":["Gần đây, việc nhỏ bình thường nào khiến bạn cảm thấy có người đang thật sự lắng nghe mình?"]},"\n",{"tag":"li","props":{},"children":["Nếu cùng lên kế hoạch cho một cuối tuần không tốn tiền, bạn muốn chúng ta dành thời gian cho điều gì?"]},"\n",{"tag":"li","props":{},"children":["Khi bất đồng ý kiến, bạn muốn mình hỏi điều gì trước, thay vì vội giải thích?"]},"\n"]},"\n",{"tag":"p","props":{},"children":["Những ví dụ này không được trích từ danh sách câu hỏi quen thuộc và cũng không dùng để chấm điểm. Trả lời khác nhau là bình thường. Có thể hỏi tiếp “Vì sao điều này quan trọng với bạn?” mà không cần vội đánh giá suy nghĩ của ai tốt hơn."]},"\n",{"tag":"h2","props":{"id":"nếu-cảm-thấy-quá-riêng-tư-hãy-lùi-lại-một-chút"},"children":["Nếu cảm thấy quá riêng tư, hãy lùi lại một chút"]},"\n",{"tag":"p","props":{},"children":["Càng về cuối, các câu hỏi càng có thể chạm đến những trải nghiệm buồn, chuyện gia đình hoặc các mối quan hệ. Bạn có thể nói “Mình bỏ qua câu này nhé”, “Mình chỉ muốn kể đến đây”, hoặc quay lại một chủ đề nhẹ nhàng hơn. Bỏ qua không có nghĩa là thiếu chân thành, cũng không có nghĩa là mối quan hệ đang có vấn đề."]},"\n",{"tag":"p","props":{},"children":["Nếu một người rõ ràng không thoải mái, hãy dừng bài thực hành và hỏi họ lúc này cần gì. Đừng dùng thời gian, tỷ lệ hoàn thành hay câu “Đã làm đến đây rồi” để thúc ép tiếp tục. Một cuộc trò chuyện dễ chịu quan trọng hơn việc trả lời hết mọi câu hỏi."]},"\n",{"tag":"h2","props":{"id":"trò-chuyện-xong-đừng-vội-kết-luận"},"children":["Trò chuyện xong, đừng vội kết luận"]},"\n",{"tag":"p","props":{},"children":["Mỗi người chia sẻ một điều mới vừa biết về người kia, rồi hỏi “Sau này bạn có muốn dành thời gian trò chuyện tiếp không?”. Hai người có thể hẹn một buổi đi dạo đơn giản, hoặc dừng ở đây. Cảm giác gắn kết trong ngày hôm đó khác với sự tôn trọng, đáng tin cậy và phù hợp khi ở bên nhau lâu dài."]},"\n",{"tag":"p","props":{},"children":["Nếu chuyển sang điền câu trả lời trên web trước rồi mới xem câu trả lời của nhau, hãy coi đó là bước chuẩn bị cho cuộc trò chuyện tiếp theo. Văn bản dễ thiếu giọng điệu và bối cảnh. Khi chưa hiểu một câu trả lời, hãy hỏi lại, đừng gán nhãn cho người kia chỉ từ một câu viết. Không thể áp dụng trực tiếp kết quả nghiên cứu trò chuyện mặt đối mặt cho việc điền câu trả lời vào những thời điểm khác nhau."]},"\n",{"tag":"h2","props":{"id":"trở-lại-lời-khuyên-tương-ứng-trong-sách"},"children":["Trở lại lời khuyên tương ứng trong sách"]},"\n",{"tag":"p","props":{},"children":[{"tag":"a","props":{"href":"/vi/book/10#10-05"},"children":["Đọc mục 10-05: luân phiên trả lời những câu hỏi đi sâu dần"]},". Nếu muốn suy nghĩ thêm về chi phí và lựa chọn trong một mối quan hệ, bạn có thể đọc tiếp ",{"tag":"a","props":{"href":"/vi/articles/marriage"},"children":["Kết hôn có đáng không?"]},"."]},"\n"]},{"tag":"footer","props":{"className":"life-article-attribution"},"children":[{"tag":"p","props":{},"children":["Bài viết gốc và danh sách đầy đủ do Daniel Jones viết, minh họa của Stuart Bradford. Liên kết nguồn nằm bên dưới. Các bản dịch có sự hỗ trợ của máy; gợi ý thực hành do trang web biên soạn."]},{"tag":"a","props":{"href":"https://cn.nytimes.com/culture/20150123/t23questions/","target":"_blank","rel":"noopener noreferrer"},"children":["Đọc danh sách câu hỏi đầy đủ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"14","height":"14","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]},{"tag":"span","props":{},"children":["Đã nhập: 2026-10-07"]}]},{"tag":"div","props":{"className":"life-quick-share"},"children":[{"tag":"button","props":{"type":"button"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-copy","aria-hidden":"true"},"children":[{"tag":"rect","props":{"width":"14","height":"14","x":"8","y":"8","rx":"2","ry":"2"},"children":[]},{"tag":"path","props":{"d":"M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"},"children":[]}]},"Sao chép liên kết"]},{"tag":"span","props":{"role":"status"},"children":[]}]}," ",{"tag":"section","props":{"className":"social-share-strip","aria-label":"Chia sẻ một ý tưởng hữu ích"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"social-share-kicker"},"children":["CHIA SẺ TỐT HƠN"