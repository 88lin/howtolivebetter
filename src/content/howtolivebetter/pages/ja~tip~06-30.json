06"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"目次に戻る"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["アンチ・リスト"]},{"tag":"div","props":{"data-ad-dock-host":"true"},"children":[]},{"tag":"nav","props":{"aria-label":"この章のヒント"},"children":[{"tag":"a","props":{"href":"/ja/tip/06-01"},"children":[{"tag":"span","props":{},"children":["01"]},"長寿や心血管疾患の予防のためにマルチビタミンを摂取しないでください"]},{"tag":"a","props":{"href":"/ja/tip/06-02"},"children":[{"tag":"span","props":{},"children":["02"]},"心血管疾患の予防のために一般的なフィッシュオイルを摂取しないでください"]},{"tag":"a","props":{"href":"/ja/tip/06-03"},"children":[{"tag":"span","props":{},"children":["03"]},"ビタミンDが不足していない人に、長寿目的でビタミンDを補給しないでください"]},{"tag":"a","props":{"href":"/ja/tip/06-04"},"children":[{"tag":"span","props":{},"children":["04"]},"がん予防のために抗酸化サプリメント（β-カロテン、ビタミンE、ビタミンA）を摂取しないでください"]},{"tag":"a","props":{"href":"/ja/tip/06-05"},"children":[{"tag":"span","props":{},"children":["05"]},"グルコサミン/コンドロイチンで膝関節炎を治せると期待しないでください"]},{"tag":"a","props":{"href":"/ja/tip/06-06"},"children":[{"tag":"span","props":{},"children":["06"]},"ビタミンCに風邪の予防を期待しないでください"]},{"tag":"a","props":{"href":"/ja/tip/06-07"},"children":[{"tag":"span","props":{},"children":["07"]},"症状のない自分に対して「全身PET-CT」や「腫瘍マーカーセット」の検査を受けないでください"]},{"tag":"a","props":{"href":"/ja/tip/06-08"},"children":[{"tag":"span","props":{},"children":["08"]},"リストバンドやスマートウォッチによる運動量の数値化で減量できると期待しないでください"]},{"tag":"a","props":{"href":"/ja/tip/06-09"},"children":[{"tag":"span","props":{},"children":["09"]},"「より健康に」なるために、割高なオーガニック食品を買わないでください"]},{"tag":"a","props":{"href":"/ja/tip/06-10"},"children":[{"tag":"span","props":{},"children":["10"]},"「体調を整える」ために、サプリメントや膏方、滋養食品に大金を投じない"]},{"tag":"a","props":{"href":"/ja/tip/06-11"},"children":[{"tag":"span","props":{},"children":["11"]},"腸の問題がない限り、プロバイオティクスを長期的に摂取しない"]},{"tag":"a","props":{"href":"/ja/tip/06-12"},"children":[{"tag":"span","props":{},"children":["12"]},"「免疫力を高める」ために、無理に冷水シャワーを浴びない"]},{"tag":"a","props":{"href":"/ja/tip/06-13"},"children":[{"tag":"span","props":{},"children":["13"]},"デトックス、腸洗浄、酵素、アルカリ水などの製品を買わないでください"]},{"tag":"a","props":{"href":"/ja/tip/06-14"},"children":[{"tag":"span","props":{},"children":["14"]},"「毎日 8 杯の水を飲む」という目標を満たすために、無理に水を飲まないでください"]},{"tag":"a","props":{"href":"/ja/tip/06-15"},"children":[{"tag":"span","props":{},"children":["15"]},"占いやタロット、星座占いで決断を下すために、お金を使わないでください"]},{"tag":"a","props":{"href":"/ja/tip/06-16"},"children":[{"tag":"span","props":{},"children":["16"]},"「視力を守る」ためにブルーライトカット眼鏡を買わないでください。また「数ヶ月画面を見続けると目がダメになる」という言葉も信じないでください。ただし、目の張り、痛み、充血は緊急事態として扱うべきです"]},{"tag":"a","props":{"href":"/ja/tip/06-17"},"children":[{"tag":"span","props":{},"children":["17"]},"献血を健康法と考えないでください：「デトックス、血中脂質低下、心筋梗塞予防」を裏付けるランダム化比較試験はありません。頻繁な献血は、本当に鉄欠乏を引き起こします"]},{"tag":"a","props":{"href":"/ja/tip/06-18"},"children":[{"tag":"span","props":{},"children":["18"]},"一般的な健康診断パッケージに頼って病気を防ごうとせず、年齢と性別に基づいた、エビデンスのある検査項目を受けましょう"]},{"tag":"a","props":{"href":"/ja/tip/06-19"},"children":[{"tag":"span","props":{},"children":["19"]},"尿酸値が高いと診断されても、痛風の発作が一度もない場合は、安易に降尿酸薬の服用を始めないでください"]},{"tag":"a","props":{"href":"/ja/tip/06-20"},"children":[{"tag":"span","props":{},"children":["20"]},"検診で胆石が見つかったからといって、痛みがないのに予防的に胆嚢を切除しないでください"]},{"tag":"a","props":{"href":"/ja/tip/06-21"},"children":[{"tag":"span","props":{},"children":["21"]},"腎結石予防のためにカルシウムを控えないでください"]},{"tag":"a","props":{"href":"/ja/tip/06-22"},"children":[{"tag":"span","props":{},"children":["22"]},"「運気転換」「金運アップ」「開運（養人）」のために、水晶、ブレスレット、貔貅（ピーシュ）などの品物を買わないでください"]},{"tag":"a","props":{"href":"/ja/tip/06-23"},"children":[{"tag":"span","props":{},"children":["23"]},"買い物で気分やステータスを改善しようと期待しないでください"]},{"tag":"a","props":{"href":"/ja/tip/06-24"},"children":[{"tag":"span","props":{},"children":["24"]},"「周囲のレベルに合わせる」ために、家や車、コミュニティを変えるために余計な出費をしないでください"]},{"tag":"a","props":{"href":"/ja/tip/06-25"},"children":[{"tag":"span","props":{},"children":["25"]},"「意志力は筋肉のように、使えばなくなる」という説を信じないでください"]},{"tag":"a","props":{"href":"/ja/tip/06-26"},"children":[{"tag":"span","props":{},"children":["26"]},"朝食を抜くことや 16:8 の間欠的断食で体重をコントロールしようと思わないでください。食事の時間は、長期的に継続できるものを選びましょう"]},{"tag":"a","props":{"href":"/ja/tip/06-27"},"children":[{"tag":"span","props":{},"children":["27"]},"「自慰は体に悪い」「禁欲すれば良くなる」を信じないでください。本当に見るべきは、睡眠、仕事、そして人間関係に支障が出ているかどうかです"]},{"tag":"a","props":{"href":"/ja/tip/06-28"},"children":[{"tag":"span","props":{},"children":["28"]},"「性的指向の矯正」や「同性愛治療」に金を使わないで。家族を送り込むのもやめてください"]},{"tag":"a","props":{"href":"/ja/tip/06-29"},"children":[{"tag":"span","props":{},"children":["29"]},"「正しい持ち上げ方」や運搬研修だけで腰痛を防げると思わず、重さと回数を減らし、普段から運動する"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/ja/tip/06-30","data-status":"active"},"children":[{"tag":"span","props":{},"children":["30"]},"骨折後にカルシウムを大量に補ったり骨スープを飲んだりすれば、骨が早くつながるとは期待しない"]},{"tag":"a","props":{"href":"/ja/tip/06-31"},"children":[{"tag":"span","props":{},"children":["31"]},"AIチャットボットだけで病状や法律問題を判断しない。受診・裁判・大きな支出の前に、根拠の原文を確認する"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"現在地"},"children":[{"tag":"a","props":{"href":"/ja/book"},"children":["本を読む"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/ja/book/06"},"children":["第6章"," ·"," ","アンチ・リスト"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"06-30"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["30"]},{"tag":"span","props":{"className":"life-evidence grade-b"},"children":["エビデンス"," ","B"]}]},{"tag":"h1","props":{"lang":"ja"},"children":["骨折後にカルシウムを大量に補ったり骨スープを飲んだりすれば、骨が早くつながるとは期待しない"]},{"tag":"p","props":{"lang":"ja","className":"life-entry-summary"},"children":["骨折後にビタミンDを補う試験では、骨の癒合が良くなったと示したものはありません。カルシウムとビタミンDを一緒に補う研究は少なく、効果ははっきりしていません。大きな一杯の骨スープに含まれるカルシウムは、1日に必要な量の数十分の一にすぎません。もともとビタミンDが不足している人や、骨粗鬆症がある人は別です。"]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["費用・手間"]},{"tag":"p","props":{},"children":["費用はかからず、カルシウム錠剤やビタミンD、毎日スープを煮込むためのお金と手間も節約できます。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["効果"]},{"tag":"p","props":{},"children":["まずビタミンDです。2023年のシステマティックレビューは、14件の研究、骨折患者2734人を対象にしました。"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"記録する：骨折後にカルシウムを大量に補ったり骨スープを飲んだりすれば、骨が早くつながるとは期待しない"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"できている"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"やることに追加"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"お気に入り"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"このヒントを共有"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"詳細を閉じる"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["費用・手間"]},{"tag":"p","props":{},"children":["費用はかからず、カルシウム錠剤やビタミンD、毎日スープを煮込むためのお金と手間も節約できます。必要なのは、不足が確認された場合に補い、不足していなければ追加で補わないことだけです。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["効果"]},{"tag":"p","props":{},"children":["まずビタミンDです。2023年のシステマティックレビューは、14件の研究、骨折患者2734人を対象にしました。著者の結論は、ビタミンDだけを補っても、骨の癒合、骨がつながったかどうか、回復後の機能への影響は小さいというものでした。効果が見られた少数の研究は、全般に質が低いものでした。ランダムにグループを分けた試験だけに限ると、効果が示されたものは一つもないと著者は明記しています。そのうち一つの試験は、ビタミンDが低い長管骨骨折患者100人を対象にしました。半数は受傷後2週間以内に10万IUを一度服用し、半数はプラセボ（偽薬）を服用しました。両群とも骨が癒合しなかった人は2人で、全体では4%でした。別の試験は、大腿骨または脛骨を骨折した18～50歳の102人を、異なる用量またはプラセボを服用する4群に分けました。3か月時点と12か月時点の癒合スコアには、いずれも差が見られませんでした。さらに別の試験は、手首を骨折した閉経後女性32人を対象にしました。補わない人と比べ、1日あたり1800 IUに相当する高用量群では、骨の圧縮に対する強さがむしろ低くなりました。次にカルシウムです。2014年のシステマティックレビューによると、ビタミンD不足やビタミンD補充が骨折の癒合に与える影響を調べた臨床研究は少なく、結論ははっきりしていません。見つかった2件の研究ではカルシウムとビタミンDを一緒に補い、骨折部位の骨密度や仮骨（新しくできた骨）が増えたことを確認しましたが、癒合の速さは調べていません。最後に骨スープです。台湾の高雄で行われた測定では、骨スープを使った麺料理を3種類購入しました。1食分のスープは450～550グラムでした。1食分のスープに含まれるカルシウムは平均14～39ミリグラムで、1日の推奨量1000ミリグラムの1.4%～3.9%でした。著者の結論は、1食分のスープに含まれるカルシウムは1日の推奨量の5%未満というものでした。中国の推奨量は18～49歳では1日800ミリグラム、50歳以上では1000ミリグラムで、1日の上限は2000ミリグラムです。この基準には、長期にわたるカルシウムの過剰摂取は腎結石のリスクを高めると明記されています。米国の試験は閉経後女性36282人を対象とし、毎日カルシウム1000ミリグラムとビタミンD 400 IUを服用してもらい、平均7年間追跡しました。腎結石のリスクは約17%高くなりました（HR 1.17、95% CI 1.02–1.34、推定値の範囲）。股関節骨折は約12%少なくなりましたが、統計的に有意ではありませんでした（HR 0.88、0.72–1.08）。この方法が割に合うように思えるのは、「骨はカルシウムでできているのだから、多く摂れば早くつながる」という直感があるためです。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["出典"]},{"tag":"p","props":{"className":"life-citations"},"children":["Gatt T, Grech A, Arshad H (2023). The Effect of Vitamin D Supplementation for Bone Healing in Fracture Patients: A Systematic Review. Advances in Orthopedics, 2023, 6236045. ",{"tag":"a","props":{"href":"https://doi.org/10.1155/2023/6236045","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1155/2023/6236045"]},"；Haines N, Kempton LB, Seymour RB, et al. (2017). The effect of a single early high-dose vitamin D supplement on fracture union in patients with hypovitaminosis D: a prospective randomised trial. Bone & Joint Journal, 99-B(11), 1520-1525. ",{"tag":"a","props":{"href":"https://doi.org/10.1302/0301-620X.99B11.BJJ-2017-0271.R1","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1302/0301-620X.99B11.BJJ-2017-0271.R1"]},"；Slobogean GP, Bzovsky S, O'Hara NN, et al. (2023). Effect of Vitamin D3 Supplementation on Acute Fracture Healing: A Phase II Screening Randomized Double-Blind Controlled Trial. JBMR Plus, 7, e10705. ",{"tag":"a","props":{"href":"https://doi.org/10.1002/jbm4.10705","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1002/jbm4.10705"]},"；Heyer FL, de Jong JJ, Willems PC, et al. (2021). The Effect of Bolus Vitamin D3 Supplementation on Distal Radius Fracture Healing: A Randomized Controlled Trial Using HR-pQCT. Journal of Bone and Mineral Research, 36, 1492-1501. ",{"tag":"a","props":{"href":"https://doi.org/10.1002/jbmr.4311","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1002/jbmr.4311"]},"；Gorter EA, Hamdy NA, Appelman-Dijkstra NM, Schipper IB (2014). The role of vitamin D in human fracture healing: a systematic review of the literature. Bone, 64, 288-297. ",{"tag":"a","props":{"href":"https://doi.org/10.1016/j.bone.2014.04.026","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1016/j.bone.2014.04.026"]},"；Hsu DJ, Lee CW, Tsai WC, Chien YC (2017). Essential and toxic metals in animal bone broths. Food & Nutrition Research, 61, 1347478（表 2、表 3）. ",{"tag":"a","props":{"href":"https://doi.org/10.1080/16546628.2017.1347478","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1080/16546628.2017.1347478"]},"；国家卫生和计划生育委员会 (2018). WS/T 578.2—2018 中国居民膳食营养素参考摄入量 第 2 部分：常量元素（表 1；定义 3.7）. ",{"tag":"a","props":{"href":"https://www.nhc.gov.cn/wjw/yingyang/201805/f2c614be95fe41dba8123c23a6e6fb55/files/1739783539207_73894.pdf","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.nhc.gov.cn/wjw/yingyang/201805/f2c614be95fe41dba8123c23a6e6fb55/files/1739783539207_73894.pdf"]},"；Jackson RD, LaCroix AZ, Gass M, et al. (2006). Calcium plus vitamin D supplementation and the risk of fractures. New England Journal of Medicine, 354(7), 669-683. ",{"tag":"a","props":{"href":"https://doi.org/10.1056/NEJMoa055218","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1056/NEJMoa055218"]},"；Doetsch AM, Faber J, Lynnerup N, et al. (2004). The effect of calcium and vitamin D3 supplementation on the healing of the proximal humerus fracture: a randomized placebo-controlled study. Calcified Tissue International, 75, 183-188. ",{"tag":"a","props":{"href":"https://doi.org/10.1007/s00223-004-0167-0","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1007/s00223-004-0167-0"]},"（备注里那项）；Gorter EA, Krijnen P, Schipper IB (2017). Vitamin D status and adult fracture healing. Journal of Clinical Orthopaedics and Trauma, 8(1), 34-37. ",{"tag":"a","props":{"href":"https://doi.org/10.1016/j.jcot.2016.09.003","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1016/j.jcot.2016.09.003"]},"（备注里那项）"]},{"tag":"a","props":{"href":"https://doi.org/10.1155/2023/6236045","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["出典を開く"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["著者の注記"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["議論の余地：小さな兆候が二つあります。デンマークの試験は、肩に近い上腕骨を骨折した高齢女性30人を対象にしました。全員に骨粗鬆症または骨量の低下がありました。毎日ビタミンD 800 IUとカルシウム1グラムを服用した人では、6週目の骨折部位の骨密度が高くなりました（0.623対0.570 g/cm²）。ただし、測定したのは骨密度だけで、骨がきちんと癒合したかは調べておらず、人数も少なすぎます。102人を対象にした試験を後から分けて分析すると、高用量ビタミンD群の機能スコアは少し良くなりましたが、著者は確認のためにさらに試験が必要だとしています。もともとビタミンDが不足している人は別です。オランダの追跡記録では、補充後も不足していた人の9.7%で癒合が遅れました。もともと不足していない人では0.3%、補充で正常になった人では1.7%でした。これは追跡記録にすぎず、因果関係は証明できません。不足が確認された場合は、医師の指示に従って正常な範囲まで補ってください。骨粗鬆症と診断されている人や、軽く転んだだけで骨折した人に必要なのは骨粗鬆症の治療薬です。第1節第40条（骨粗鬆症の治療薬）を参照してください。カルシウム錠剤では代用できません。ビタミンDが不足していない人が長期間補っても効果はありません。本節第3条（ビタミンDの補充）を参照してください。否定しているのは「追加で大量に補うこと」であって、カルシウムの摂取を減らすことではありません。普段の食事から必要な量を摂ってください。本節第21条（腎結石を防ごうとカルシウムを断つ）を参照してください。転んだ直後に骨折が疑われる場合の対処は、第13節第41条（骨折が疑われる場合）を参照してください。利益を「中」としたのは、1年分のカルシウム錠剤とビタミンDの費用に基づいています。利益を受けるのは自分自身です。"]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["自分のメモ"]},{"tag":"button","props":{"type":"button"},"children":["自分へのメモを書く…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/ja/tip/06-29"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["前へ"]},"「正しい持ち上げ方」や運搬研修だけで腰痛を防げると思わず、重さと回数を減らし、普段から運動する"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/ja/tip/06-31"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["次へ"]},"AIチャットボットだけで病状や法律問題を判断しない。受診・裁判・大きな支出の前に、根拠の原文を確認する"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["このテーマの他の提案"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/06-23"},"children":[{"tag":"strong","props":{},"children":["買い物で気分やステータスを改善しようと期待しないでください"]},{"tag":"span","props":{},"children":["お金や物質的なものに重きを置く人ほど、自分は不幸だと感じやすくなります。ただし、両者の相関は弱く、どちらが原因であるかを特定することはでき…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/06-24"},"children":[{"tag":"strong","props":{},"children":["「周囲のレベルに合わせる」ために、家や車、コミュニティを変えるために余計な出費をしないでください"]},{"tag":"span","props":{},"children":["収入が同じ人々を比較した場合、隣人が稼げば稼ぐほど、その人の幸福感は低くなるという報告があります。これは、学歴が同じで、かつ頻繁に交流があ…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/06-25"},"children":[{"tag":"strong","props":{},"children":["「意志力は筋肉のように、使えばなくなる」という説を信じないでください"]},{"tag":"span","props":{},"children":["「