org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Compartir consejo"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Ocultar detalles"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Coste"]},{"tag":"p","props":{},"children":["0 yuanes; cada año se hace una liquidación anual, del 1 de marzo al 30 de junio del año siguiente. Si el dinero que recibes del exterior pasa el límite anual, prepara además un contrato de trabajo y un justificante de ingresos. Lo difícil es acordarte de que este impuesto lo declaras tú."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Beneficio"]},{"tag":"p","props":{},"children":["Que ese dinero sea renta de origen nacional se rige por el artículo 3 del Reglamento de Implementación de la Ley del Impuesto sobre la Renta Personal (Decreto del Consejo de Estado n.º 707, vigente desde el 1 de enero de 2019). Dice: «salvo disposición en contrario de las autoridades de hacienda y fiscalía del Consejo de Estado, las rentas siguientes son rentas de origen en China, con independencia de dónde se paguen: (1) las rentas obtenidas por prestar servicios en China por relación de empleo, contratación o cumplimiento de compromisos». El artículo 6 del mismo reglamento define dos categorías de renta gravable. Una es sueldos y salarios: «por rentas de sueldos y salarios se entienden los sueldos, salarios, primas, pagos extraordinarios de fin de año, dividendos laborales, subsidios y complementos que la persona obtiene por empleo o contratación, así como las demás rentas vinculadas al empleo o la contratación». La otra es remuneración por servicios: «por rentas de remuneración por servicios se entiende las que la persona obtiene por prestar servicios, incluidas las de diseño, decoración, instalación, dibujo técnico, ensayos, pruebas, medicina, derecho, contabilidad, consultoría, docencia, traducción, revisión de textos, caligrafía y pintura, escultura, cine y televisión, grabación de sonido, grabación de imagen, espectáculos, actuación, publicidad, exposiciones, servicios tecnológicos, servicios de intermediación, servicios de agenciamiento, servicios de gestión por encargo y demás servicios». El artículo 6 de la Ley del Impuesto sobre la Renta Personal fija cómo se calcula la base imponible: «en la renta integral del residente fiscal, la base imponible es lo que queda de los ingresos de cada año fiscal tras deducir 60 000 yuanes de gastos, las deducciones especiales, las deducciones especiales adicionales y las demás deducciones determinadas conforme a la ley». El mismo artículo añade que «de las rentas por servicios, por derechos de autor y por licencia de derechos se toma como importe de ingresos lo que queda tras deducir el 20 % de gastos». Esa deducción del 20 % solo se lista para esas tres categorías: los sueldos y salarios no están entre ellas. Es decir, los sueldos y salarios entran por su importe íntegro, y el impuesto sale distinto según la categoría. Artículo 9: «el contribuyente del impuesto sobre la renta personal es quien obtiene la renta, y el agente retenedor es la unidad o la persona que paga la renta». Artículo 10: «en los casos siguientes el contribuyente debe declarar el impuesto conforme a la ley: ... (2) obtiene renta gravable sin agente retenedor; ... (4) obtiene renta del exterior». Artículo 11: «el residente fiscal que obtiene renta integral liquida el impuesto por año... cuando haya que hacer la liquidación anual, debe hacerla entre el 1 de marzo y el 30 de junio del año siguiente al de la renta». Para la entrada de dinero vale el Método de Gestión de Divisas Personales (Orden n.º 3 del Banco Popular de China de 2006, vigente desde el 1 de febrero de 2007). Artículo 9: «la conversión de divisas de particulares y la compra de divisas por residentes nacionales se gestionan por cuota anual. Dentro de la cuota anual se tramita en el banco con un documento de identidad válido propio; por encima de la cuota, en el rubro de cuenta corriente se tramita en el banco con el documento de identidad válido y los justificantes y demás materiales relativos al importe de la transacción». Artículo 7: «al tramitar operaciones de divisas personales, bancos y particulares deben cumplir las reglas de este método: no eludir la supervisión de los límites mediante fraccionamiento ni otras formas, ni usar documentos o justificantes comerciales falsos para eludir el control de autenticidad». Las Reglas de Implementación del Método de Gestión de Divisas Personales (Huifa〔2007〕1). Artículo 2: «la conversión de divisas de particulares y la compra de divisas por residentes nacionales se gestionan por cuota anual: la cuota anual es, para cada persona, el equivalente de 50 000 dólares de EE. UU. al año». Artículo 10: «el residente nacional que convierta divisas por cuenta corriente no empresarial por encima de la cuota anual lo tramita en el banco con su documento de identidad válido y los justificantes siguientes: ... (7) remuneración de trabajadores: contrato de trabajo y justificante de ingresos» (nacional)"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Fuentes originales"]},{"tag":"p","props":{"className":"life-citations"},"children":["国务院 (2018). 中华人民共和国个人所得税法实施条例（国务院令第 707 号，第三、六条）. ",{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/2018-12/22/content_5351177.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/zhengce/zhengceku/2018-12/22/content_5351177.htm"]},"；全国人民代表大会常务委员会 (2018). 中华人民共和国个人所得税法（2018 年第七次修正，第六、九、十、十一条）. ",{"tag":"a","props":{"href":"http://www.npc.gov.cn/zgrdw/npc/xinwen/2018-09/05/content_2060671.htm","target":"_blank","rel":"noopener noreferrer"},"children":["http://www.npc.gov.cn/zgrdw/npc/xinwen/2018-09/05/content_2060671.htm"]},"；国家税务总局政策法规库. 中华人民共和国个人所得税法（第六条）. ",{"tag":"a","props":{"href":"https://fgk.chinatax.gov.cn/zcfgk/c100009/c5193028/content.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://fgk.chinatax.gov.cn/zcfgk/c100009/c5193028/content.html"]},"；中国人民银行 (2006). 个人外汇管理办法（中国人民银行令〔2006〕第 3 号，第七、九条）. ",{"tag":"a","props":{"href":"https://www.gov.cn/gongbao/content/2007/content_786257.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/gongbao/content/2007/content_786257.htm"]},"；国家外汇管理局 (2007). 个人外汇管理办法实施细则（汇发〔2007〕1 号，第二、十条）. ",{"tag":"a","props":{"href":"https://www.safe.gov.cn/safe/2007/0105/22509.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.safe.gov.cn/safe/2007/0105/22509.html"]}]},{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/2018-12/22/content_5351177.htm","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Abrir fuente"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Nota del autor"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["La categoría que te corresponde depende de tu relación con la otra parte. Si firmas contrato de trabajo y el trabajo se hace como lo ordena la otra parte, es sueldos y salarios. Si tú tomas encargos por proyecto y entregas resultados, es remuneración por servicios. El impuesto sale distinto según la categoría: antes de declarar, aclara cuál es la tuya. Al recibir el dinero, hasta el equivalente de 50 000 dólares al año basta presentarte en el banco con el documento de identidad para convertirlo; por encima, entrega al banco el contrato de trabajo y el justificante de ingresos. Y no busques a nadie que reciba por ti para burlar el límite: eso es fraccionamiento, y la norma lo prohíbe. Esta entrada cubre el caso de quien está en China y no sale del país. Salir de verdad al exterior a trabajar para un empleador extranjero es otro régimen: véase la entrada 14 de esta sección. Cuatro puntos que este libro aún no escribe. Todos pueden tener costes reales, pero no se ha encontrado base que se pueda cotejar palabra por palabra. Uno: si esta renta paga el impuesto sobre el valor añadido y hay que emitir factura por mediación. Dos: si hacerlo a largo plazo exige licencia comercial o inscribirse como trabajador autónomo. Tres: si puedes exigir derechos al empleador extranjero por la ley laboral, como vacaciones anuales, pago de horas extra o indemnización por terminación. Cuatro: la salida de datos y la confidencialidad."]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Mi nota"]},{"tag":"button","props":{"type":"button"},"children":["Escribe un recordatorio…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/es/tip/31-14"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Anterior"]},"Quieres trabajar en el extranjero: comprueba primero si la empresa tiene la licencia de cooperación laboral con el exterior; no puede cobrarte depósito"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/es/tip/31-16"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Siguiente"]},"Sin entrar en una unidad, tú a lo tuyo: para el dinero de arranque mira primero el préstamo con garantía de emprendimiento — hasta 300 000 yuanes por persona y el Tesoro paga la mitad del interés"]},{"tag":"svg","prop