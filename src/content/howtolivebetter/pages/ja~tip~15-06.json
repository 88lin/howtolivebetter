":["09"]},"都市部の戸籍で田舎への移住を希望する場合、農家住宅を借りるにとどめ、宅基地（宅地使用権）や宅基地上の物件は購入しないこと"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"現在地"},"children":[{"tag":"a","props":{"href":"/ja/book"},"children":["本を読む"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/ja/book/15"},"children":["第15章"," ·"," ","賃貸と購入"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"15-06"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["06"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["エビデンス"," ","A"]}]},{"tag":"h1","props":{"lang":"ja"},"children":["中国で賃貸契約する前に権利証と抵当権を確認。支払いは振込にして用途を記録する"]},{"tag":"p","props":{"lang":"ja","className":"life-entry-summary"},"children":["契約前に家主の身分証と不動産権利証を見せてもらいます。自分の身分証を持って不動産登記機関へ行けば、契約前でも抵当権や差押えを確認できます。賃貸前に抵当・差押えのある家が競売で所有者変更された場合、そのまま住むよう要求できません。支払いは用途を付記した振込にして証拠を残しましょう。"]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["費用・手間"]},{"tag":"p","props":{},"children":["無料です。身分証を持って不動産登記機関へ行き、30分ほど調べます。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["効果"]},{"tag":"p","props":{},"children":["中国の貸主は契約前に身分証明と不動産権利証を提示し、権利証がなければ貸す権利を示す別の資料を出します。"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"記録する：中国で賃貸契約する前に権利証と抵当権を確認。支払いは振込にして用途を記録する"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"childre