":{"d":"M20 12h2"},"children":[]},{"tag":"path","props":{"d":"m6.34 17.66-1.41 1.41"},"children":[]},{"tag":"path","props":{"d":"m19.07 4.93-1.41 1.41"},"children":[]}]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"17","height":"17","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-moon life-theme-icon-dark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"},"children":[]}]}]},{"tag":"button","props":{"type":"button","className":"life-language-switch","aria-label":"Русский Выбрать язык","aria-haspopup":"menu","aria-expanded":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-globe","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]},{"tag":"path","props":{"d":"M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"},"children":[]},{"tag":"path","props":{"d":"M2 12h20"},"children":[]}]},{"tag":"span","props":{},"children":["Русский"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]}]},{"tag":"a","props":{"className":"life-account","href":"/ru/sign-in"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"17","height":"17","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle-user-round","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M18 20a6 6 0 0 0-12 0"},"children":[]},{"tag":"circle","props":{"cx":"12","cy":"10","r":"4"},"children":[]},{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},{"tag":"span","props":{},"children":["Войти"]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/ru/book/07"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"К содержанию"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["Как выжить, когда денег нет"]},{"tag":"nav","props":{"aria-label":"Советы главы"},"children":[{"tag":"a","props":{"href":"/ru/tip/07-01"},"children":[{"tag":"span","props":{},"children":["01"]},"Как онлайн оформить выплаты по безработице после потери работы"]},{"tag":"a","props":{"href":"/ru/tip/07-02"},"children":[{"tag":"span","props":{},"children":["02"]},"Сначала подайте жалобу в управление по труду и соцстраху, затем обратитесь в арбитраж в одну инстанцию — оба пути бесплатны, и в большинстве случаев решение принимается в течение нескольких месяцев"]},{"tag":"a","props":{"href":"/ru/tip/07-03"},"children":[{"tag":"span","props":{},"children":["03"]},"Если не можете позволить себе оплатить услуги адвоката, обратитесь за бесплатной юридической помощью — дела о невыплате зарплаты, взыскании алиментов, компенсации за травмы на производстве как раз попадают под эту категорию"]},{"tag":"a","props":{"href":"/ru/tip/07-04"},"children":[{"tag":"span","props":{},"children":["04"]},"Когда совсем некуда идти — обращайтесь в центр помощи: там обеспечат питание, жильё и билет домой"]},{"tag":"a","props":{"href":"/ru/tip/07-05"},"children":[{"tag":"span","props":{},"children":["05"]},"Для поиска работы сначала пользуйтесь бесплатными государственными службами занятости и платформами для краткосрочных подработок, не обращаясь к платным посредникам"]},{"tag":"a","props":{"href":"/ru/tip/07-06"},"children":[{"tag":"span","props":{},"children":["06"]},"В случае внезапных бедствий сначала подайте заявление на временную помощь"]},{"tag":"a","props":{"href":"/ru/tip/07-07"},"children":[{"tag":"span","props":{},"children":["07"]},"Подача заявления на дибао при доходе ниже местного порога"]},{"tag":"a","props":{"href":"/ru/tip/07-08"},"children":[{"tag":"span","props":{},"children":["08"]},"Как подать заявление на получение двух видов пособий для инвалидов по наличию удостоверения инвалида"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/ru/tip/07-09","data-status":"active"},"children":[{"tag":"span","props":{},"children":["09"]},"Не прерывайте уплату взносов в медстраховку (ибао) — ежегодно требуется минимум 400 юаней; для малоимущих предусмотрены скидки"]},{"tag":"a","props":{"href":"/ru/tip/07-10"},"children":[{"tag":"span","props":{},"children":["10"]},"При тяжелых заболеваниях сначала пользуйтесь медстраховкой (ибао), программой «Тяжелые заболевания», помощью в медицинских расходах и регистрацией в другом регионе, а от кредитов лучше воздержаться"]},{"tag":"a","props":{"href":"/ru/tip/07-11"},"children":[{"tag":"span","props":{},"children":["11"]},"Если потеряли удостоверение личности, сразу оформляйте дубликат; при срочной необходимости получите временное удостоверение"]},{"tag":"a","props":{"href":"/ru/tip/07-12"},"children":[{"tag":"span","props":{},"children":["12"]},"Получение статуса лица, испытывающего трудности в трудоустройстве после регистрации в качестве безработного, а также получение субсидий на соцстрах или доступ к общественным рабочим местам"]},{"tag":"a","props":{"href":"/ru/tip/07-13"},"children":[{"tag":"span","props":{},"children":["13"]},"Получайте субсидии на профессиональное обучение, стажировки и соцстрахование во время безработицы — не тратьте деньги на платные курсы"]},{"tag":"a","props":{"href":"/ru/tip/07-14"},"children":[{"tag":"span","props":{},"children":["14"]},"Поиск работы: не ограничивайтесь отправкой резюме, используйте системный подход — изучайте навыки, ставьте цели и просите помощи у других"]},{"tag":"a","props":{"href":"/ru/tip/07-15"},"children":[{"tag":"span","props":{},"children":["15"]},"Без залога, без удержания документов, без «обучающих кредитов», без схем пирамид, без высокопроцентных займов"]},{"tag":"a","props":{"href":"/ru/tip/07-16"},"children":[{"tag":"span","props":{},"children":["16"]},"Очередь на социальное жилье для нуждающихся"]},{"tag":"a","props":{"href":"/ru/tip/07-17"},"children":[{"tag":"span","props":{},"children":["17"]},"Сведите расходы на еду и жильё к минимуму: снимайте квартиру на месяц вместо дневной аренды, готовьте сами и пользуйтесь столовыми вместо доставки еды"]},{"tag":"a","props":{"href":"/ru/tip/07-18"},"children":[{"tag":"span","props":{},"children":["18"]},"Не паникуйте из-за перерывов в соцстрахе: пенсия считается по накопленному стажу, а медстраховка — по правилам"]},{"tag":"a","props":{"href":"/ru/tip/07-19"},"children":[{"tag":"span","props":{},"children":["19"]},"Люди, отбывшие тюремное заключение, объявившие банкротство или попавшие в список недобросовестных должников, имеют законные возможности для начала новой жизни — для этого лишь нужно выполнить все необходимые процедуры"]},{"tag":"a","props":{"href":"/ru/tip/07-20"},"children":[{"tag":"span","props":{},"children":["20"]},"Перед серьезным заболеванием стоит оформить на годовой срок медицинскую страховку или страховку от тяжелых болезней помимо базовой медстраховки, но обязательно обратите внимание на фразу «гарантированное продление»"]},{"tag":"a","props":{"href":"/ru/tip/07-21"},"children":[{"tag":"span","props":{},"children":["21"]},"Если совсем негде ночевать, круглосуточные заведения подойдут лишь на одну ночь; лучше сразу идти в приют"]},{"tag":"a","props":{"href":"/ru/tip/07-22"},"children":[{"tag":"span","props":{},"children":["22"]},"Если вам не выплатили зарплату, сначала выясните, кто вас нанимал: нелицензированные мастерские и бригадиры — всё равно в трудовую инспекцию; в суд идут только при работе у семьи или частного лица"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"Навигация"},"children":[{"tag":"a","props":{"href":"/ru/book"},"children":["Книга"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/ru/book/07"},"children":["Глава 7"," ·"," ","Как выжить, когда денег нет"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"07-09"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["09"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["Доказательства"," ","A"]}]},{"tag":"h1","props":{"lang":"ru"},"children":["Не прерывайте уплату взносов в медстраховку (ибао) — ежегодно требуется минимум 400 юаней; для малоимущих предусмотрены скидки"]},{"tag":"p","props":{"lang":"ru","className":"life-entry-summary"},"children":["Каждый человек вносит минимум 400 юаней в год, а государство дополнительно выделяет примерно 700 юаней на каждого застрахованного. Для особо нуждающихся граждан взносы полностью оплачиваются государством, а для получателей дибао — предусмотрена фиксированная субсидия. Прерывание уплаты имеет последствия: если вы не застраховались в установленный период или прервали подписку, после оплаты в течение 3 месяцев лечение не будет оплачиваться по программе; за каждый дополнительный прерванный год этот срок, как правило, увеличивается ещё на месяц."]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Затраты"]},{"tag":"p","props":{},"children":["Каждый человек должен вносить минимум 400 юаней в год. Это…"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Польза"]},{"tag":"p","props":{},"children":["Помимо вашей собственной доли, бюджет также вносит выплату на каждого человека. В течение 2024 лет сумма не ме…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"Отметить: Не прерывайте уплату взносов в медстраховку (ибао) — ежегодно требуется минимум 400 юаней; для малоимущих предусмотрены скидки"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"Сделано"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"В планах"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"В избранное"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Поделиться советом"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Скрыть подробности"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Затраты"]},{"tag":"p","props":{},"children":["Каждый человек должен вносить минимум 400 юаней в год. Это государственный стандарт на 2024 и 2025 годы; в отдельных регионах сумма может быть выше. Оплату следует производить в установленный период ежегодной подписки. Для особо нуждающихся граждан взносы полностью оплачивает государство; для получателей дибао предусмотрена фиксированная субсидия от властей."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Польза"]},{"tag":"p","props":{},"children":["Помимо вашей собственной доли, бюджет также вносит выплату на каждого человека. В течение 2024 лет сумма не менее 670 юаней; в течение 2025 лет она увеличивается на 30 юаня по сравнению с предыдущим годом, но не менее 700 юаней; индивидуальный взнос по-прежнему составляет не менее 400 юаней (согласно документу медицинского страхования [医保发〔2025〕22], пересказ на основе документов провинциального уровня). В докладе о работе правительства за 2026 год было сказано о дальнейшем увеличении на 24 юаня. Для лиц, получающих минимальное пособие, и лиц, находящихся в трудной жизненной ситуации, после выплаты медицинского страхования оставшаяся часть установленных медицинских расходов может быть повторно возмещена в рамках медицинской помощи в размере не менее 70%. Ценой неуплаты взносов является период ожидания. Для тех, кто не застраховался в период централизованных выплат или не осуществлял непрерывные платежи, после завершения выплат устанавливается фиксированный период ожидания в 3 месяцев, в течение которого медицинские расходы не возмещаются. За каждый дополнительный 1 лет перерыва, в принципе, добавляется еще 1 месяцев (на всей территории страны, начиная с 2025 года)"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Первоисточники"]},{"tag":"p","props":{"className":"life-citations"},"children":["国家医保局 (2024). 《关于做好 2024 年城乡居民基本医疗保障有关工作的通知》政策解读（医保发〔2024〕19 号）. ",{"tag":"a","props":{"href":"https://www.nhsa.gov.cn/art/2024/8/26/art_105_13634.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.nhsa.gov.cn/art/2024/8/26/art_105_13634.html"]},"；河北省医疗保障局等 (2025). 关于做好 2025 年城乡居民基本医疗保障有关工作的通知（冀医保发〔2025〕6 号，地方文件）. ",{"tag":"a","props":{"href":"https://www.renqiu.gov.cn/renqiu/ybjbmwj/202510/6d90754638a248cba655e94ea518a3bb.shtml","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.renqiu.gov.cn/renqiu/ybjbmwj/202510/6d90754638a248cba655e94ea518a3bb.shtml"]},"；安徽省医疗保障局等 (2025). 关于做好 2025 年城乡居民基本医疗保障有关工作的通知（淮北市医保局转载）：「按照国家医保局、财政部、国家税务总局《关于做好2025年城乡居民基本医疗保障有关工作的通知》（医保发〔2025〕22号）要求」「居民医保人均财政补助标准较上年提高30元，达到每人每年不低于700元」. ",{"tag":"a","props":{"href":"https://ybj.huaibei.gov.cn/zcwj/zcwj/58004084.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://ybj.huaibei.gov.cn/zcwj/zcwj/58004084.html"]},"；国务院办公厅 (2021). 关于健全重特大疾病医疗保险和救助制度的意见（国办发〔2021〕42 号）. ",{"tag":"a","props":{"href":"https://www.gov.cn/gongbao/content/2021/content_5659514.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/gongbao/content/2021/content_5659514.htm"]},"；国务院办公厅 (2024). 关于健全基本医疗保险参保长效机制的指导意见（国办发〔2024〕38 号）. ",{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/content/202408/content_6965741.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/zhengce/content/202408/content_6965741.htm"]},"；国家医保局 (2026). 2026 年政府工作报告提到这些医保工作. ",{"tag":"a","props":{"href":"https://www.nhsa.gov.cn/art/2026/3/5/art_14_19809.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.nhsa.gov.cn/art/2026/3/5/art_14_19809.html"]}]},{