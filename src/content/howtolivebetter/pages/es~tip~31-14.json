,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-up-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M7 7h10v10"},"children":[]},{"tag":"path","props":{"d":"M7 17 17 7"},"children":[]}]}]}]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/es/book/31"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"Volver al índice"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["Qué caminos hay después de los 18 años"]},{"tag":"div","props":{"data-ad-dock-host":"true"},"children":[]},{"tag":"nav","props":{"aria-label":"Consejos del capítulo"},"children":[{"tag":"a","props":{"href":"/es/tip/31-01"},"children":[{"tag":"span","props":{},"children":["01"]},"Primero repasa los umbrales: los requisitos de edad y de estudios de las doce rutas están fijados por escrito"]},{"tag":"a","props":{"href":"/es/tip/31-02"},"children":[{"tag":"span","props":{},"children":["02"]},"El año en que cumples 18, antes del 31 de octubre hay que hacer el registro de servicio militar; el servicio activo del conscripto son dos años"]},{"tag":"a","props":{"href":"/es/tip/31-03"},"children":[{"tag":"span","props":{},"children":["03"]},"Tras aceptar el reclutamiento, negarse al servicio militar impide salir del país o retomar los estudios durante dos años, y cierra la puerta al funcionariado y a las empresas estatales"]},{"tag":"a","props":{"href":"/es/tip/31-04"},"children":[{"tag":"span","props":{},"children":["04"]},"Dos beneficios prácticos para estudiantes universitarios que se alistan: compensación anual de matrícula de hasta 20 000 yuanes, conservación de la matrícula por dos años y un plan especial para el acceso a posgrados"]},{"tag":"a","props":{"href":"/es/tip/31-05"},"children":[{"tag":"span","props":{},"children":["05"]},"Tras la baja, solo en seis casos el gobierno asigna un puesto de trabajo; quien queda en empleo por cuenta propia debe presentarse dentro de los 30 días"]},{"tag":"a","props":{"href":"/es/tip/31-06"},"children":[{"tag":"span","props":{},"children":["06"]},"Tres cuentas tras la baja: prima única por baja, los años de servicio militar cuentan como antigüedad laboral y deducción fiscal de 20 000 yuanes al año para quienes trabajan por cuenta propia"]},{"tag":"a","props":{"href":"/es/tip/31-07"},"children":[{"tag":"span","props":{},"children":["07"]},"El sector público no se entra solo por el examen de funcionario: dos años en un programa de servicio de base dan acceso al plan anual de admisión dirigida del 10 %"]},{"tag":"a","props":{"href":"/es/tip/31-08"},"children":[{"tag":"span","props":{},"children":["08"]},"El maestro de Puesto Especial que termina tres años de servicio, aprueba la evaluación y quiere quedarse debe ser incorporado a la plantilla sin demora"]},{"tag":"a","props":{"href":"/es/tip/31-09"},"children":[{"tag":"span","props":{},"children":["09"]},"Bombero y personal civil del ejército son otras dos puertas de contratación pública, con umbrales más bajos que el funcionariado"]},{"tag":"a","props":{"href":"/es/tip/31-10"},"children":[{"tag":"span","props":{},"children":["10"]},"La formación académica no es una decisión única: el examen de autoestudio no impone límites de edad ni de nivel educativo previo; el examen de ingreso para adultos y la Universidad Abierta también permiten completar estudios"]},{"tag":"a","props":{"href":"/es/tip/31-11"},"children":[{"tag":"span","props":{},"children":["11"]},"Si no entras en una unidad de trabajo, eres empleo flexible: pensión y salud se afilian por tu cuenta en el lugar de empleo, y la restricción de registro de hogar ya se levantó"]},{"tag":"a","props":{"href":"/es/tip/31-12"},"children":[{"tag":"span","props":{},"children":["12"]},"Reparto de comida, auto de pasajeros, transporte urbano de carga: la plataforma paga la prima de protección contra daños profesionales por pedido, y tú no pagas"]},{"tag":"a","props":{"href":"/es/tip/31-13"},"children":[{"tag":"span","props":{},"children":["13"]},"Dos rutas que te aseguran la plantilla el mismo día en que rellenas las preferencias de la admisión a la universidad: normalistas a cuenta del Estado y estudiantes de medicina con destino asignado, al precio de 6 años de compromiso"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/es/tip/31-14","data-status":"active"},"children":[{"tag":"span","props":{},"children":["14"]},"Quieres trabajar en el extranjero: comprueba primero si la empresa tiene la licencia de cooperación laboral con el exterior; no puede cobrarte depósito"]},{"tag":"a","props":{"href":"/es/tip/31-15"},"children":[{"tag":"span","props":{},"children":["15"]},"Trabajo remoto desde casa para una empresa extranjera: para la ley fiscal es renta de origen nacional; el impuesto sobre la renta lo declaras tú y el dinero entra por la vía de «remuneración de trabajadores»"]},{"tag":"a","props":{"href":"/es/tip/31-16"},"children":[{"tag":"span","props":{},"children":["16"]},"Sin entrar en una unidad, tú a lo tuyo: para el dinero de arranque mira primero el préstamo con garantía de emprendimiento — hasta 300 000 yuanes por persona y el Tesoro paga la mitad del interés"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"Ruta de navegación"},"children":[{"tag":"a","props":{"href":"/es/book"},"children":["Libro"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/es/book/31"},"children":["Capítulo 31"," ·"," ","Qué caminos hay después de los 18 años"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"31-14"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["14"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["Evidencia"," ","A"]}]},{"tag":"h1","props":{"lang":"es"},"children":["Quieres trabajar en el extranjero: comprueba primero si la empresa tiene la licencia de cooperación laboral con el exterior; no puede cobrarte depósito"]},{"tag":"p","props":{"lang":"es","className":"life-entry-summary"},"children":["En el trabajo en el extranjero la ley no te regula a ti, regula a la empresa que te organiza. Solo pueden dedicarse a esto las empresas que tienen el certificado de habilitación para la cooperación laboral con el exterior y, además, completaron la inscripción. Si oyes «primero un visado de turista, y allí se cambia al de trabajo», esa frase por sí sola delata que la otra parte está actuando fuera de la ley. La empresa tampoco puede cobrarte un depósito bajo ningún concepto ni pedirte que pongas bienes como garantía."]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Coste"]},{"tag":"p","props":{},"children":["0 yuanes; antes de partir, un cuarto de hora para comproba…"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Beneficio"]},{"tag":"p","props":{},"children":["El Reglamento de Gestión de la Cooperación Laboral con el Extranjero. Artículo 5: para dedicarse a la cooperac…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"Marcar: Quieres trabajar en el extranjero: comprueba primero si la empresa tiene la licencia de cooperación laboral con el exterior; no puede cobrarte depósito"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"Hecho"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"Por hacer"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"Guardar"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Compartir consejo"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Ocultar detalles"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Coste"]},{"tag":"p","props":{},"children":["0 yuanes; antes de partir, un cuarto de hora para comprobar la licencia de la empresa y leer las dos cartas completas."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Beneficio"]},{"tag":"p","props":{},"children":["El Reglamento de Gestión de la Cooperación Laboral con el Extranjero. Artículo 5: para dedicarse a la cooperación laboral con el exterior hay que obtener la habilitación de gestión, aprobada por la autoridad de comercio del nivel provincial o del nivel ciudad con distritos. Esa habilitación es el certificado de habilitación para la cooperación laboral con el exterior: sin él no se puede organizar gente para ir a trabajar fuera. Artículo 7: la lista de empresas con certificado se remite a la autoridad de comercio del Consejo de Estado y se comunica a las embajadas y consulados de China en el exterior; añade que «quien no haya obtenido legalmente el certificado de habilitación para la cooperación laboral con el exterior y completado la inscripción no puede dedicarse a la cooperación laboral con el exterior». Artículo 8: «ninguna unidad ni persona puede organizar a trabajadores para ir a trabajar al extranjero bajo nombres de negocios, turismo o estudios». Artículo 9: dentro de los 5 días hábiles desde la inscripción, la empresa debe depositar en un banco designado «un fondo de reserva para el manejo de riesgos de la cooperación laboral con el exterior de no menos de 3 000 000 de yuanes», y la lista de depósitos se hace pública. Artículo 10: ese fondo sirve para pagar las tarifas de servicio que la empresa deba devolver y no asuma o no pueda asumir, los salarios y las pérdidas que haya que indemnizar conforme a la ley; también para «los gastos de regreso de los trabajadores al país o de auxilio urgente cuando ocurre un suceso repentino». Artículo 11: no se puede organizar a trabajadores para ir al extranjero a trabajos relacionados con juegos de azar o actividades de prostitución. Artículo 12: quien no haya organizado la formación no puede mandar gente fuera. Artículo 13: hay que contratar para los trabajadores un seguro de accidentes personales por el período de trabajo en el exterior. Artículos 21 y 23: hay que firmar contratos escritos, por separado, con el empleador extranjero y con los trabajadores; sin contrato no se puede organizar la salida. Artículo 25: «no se puede cobrar a los trabajadores depósito alguno bajo ningún concepto ni exigirles que presten garantía con bienes». Artículo 26: dentro de los 10 días hábiles desde la firma de los contratos se presentan a registro ante la autoridad de comercio. Artículo 29: si los derechos reales del trabajador no coinciden con el contrato, la empresa debe ayudar a reclamar la indemnización; si no obtiene la indemnización debida, tiene derecho a exigir que la empresa responda con indemnización. Artículo 31: si la situación de seguridad del país o región de que se trate no garantiza la seguridad personal, la empresa no puede mandar trabajadores allí. Artículo 37: la autoridad de comercio lleva un registro y una publicación de mal historial crediticio. Las sanciones están en los artículos siguientes. Artículo 39: a quien se dedique a la cooperación laboral con el exterior sin la habilitación se le investiga, sanciona y clausura, y si el caso constituye delito se persigue penalmente. Artículo 40: organizar salidas con nombres de negocios, turismo o estudios, prestar el certificado a otros u organizar trabajos vinculados a juegos de azar o prostitución conlleva la retirada del certificado de habilitación. Artículo 43: organizar salidas sin contrato, ocultando información o con información falsa se sanciona con multas de entre 100 000 yuanes y 200 000 yuanes; a los principales responsables se les multa además con entre 20 000 yuanes y 50 000 yuanes (nacional)"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Fuentes originales"]},{"tag":"p","props":{"className":"life-citations"},"children":["国务院 (2012). 对外劳务合作管理条例（国务院令第 620 号，第五、七、八、九、十、十一、十二、十三、二十一、二十三、二十五、二十六、二十九、三十一、三十七、三十九、四十、四十三条）. ",{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/2012-06/11/content_1091.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/zhengce/zhengceku/2012-06/11/content_1091.htm"]}]},{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/2012-06/11/content_1091.htm","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Abrir fuente"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Nota del autor"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["Esta entrada describe el camino legal y su procedimiento conforme. La empresa firma primero un contrato escrito de cooperación laboral con el empleador extranjero y luego firma contigo un contrato escrito de servicios o de trabajo. El contrato debe decir el contenido del trabajo, el plazo, la remuneración, las horas, las vacaciones, el seguro social y los riesgos para la seguridad personal. Firmados, la empresa tiene 10 días hábiles para presentarlos a registro ante la autoridad de comercio. También debe organizar tu formación en habilidades, prevención de riesgos, idioma y leyes y costumbres del lugar, y contratarte el seguro de accidentes personales por el período de trabajo en el exterior. Si la otra parte no te deja ver el contrato, pide depósito o te apura a salir primero y completar trámites después, es justo el tipo de empresa que esta entrada quiere frenar. Las estafas de reclutamiento con salarios altos en el exterior y la cara de los campus de fraude telefónico están en la entrada 5 de la sección 21; las alertas de seguridad que conviene consultar antes de partir y el 12308 también están en la sección 21, no se repiten aquí. El reglamento no pone barrera de estudios ni de edad a quien va a trabajar: la barrera está en la licencia de la empresa y en que el país de trabajo conceda o no el permiso. La empresa solo puede firmar contratos con empresas o instituciones aprobadas por ese país, no con particulares extranjeros. El fondo de reserva no es dinero que tú puedas retirar: es el colchón que mueve la autoridad cuando la empresa no responde. Por eso, si algo va mal de verdad, lo primero es reclamar ante la autoridad de comercio: el artículo 20 te da ese derecho de reclamación. Si a un mismo país o región se envían más de 100 personas, hay que designar personal de gestión de acompañamiento e inscribirlo ante la embajada o el consulado. Los proyectos con poca gente no tienen esa capa, así que con más razón guarda tú el contrato y los comprobantes de las transferencias."]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Mi nota"]},{"tag":"button","props":{"type":"button"},"children":["Escribe un recordatorio…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/es/tip/31-13"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Anterior"]},"Dos rutas que te aseguran la plantilla el mismo día en que rellenas las preferencias de la admi