e-user-round","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M18 20a6 6 0 0 0-12 0"},"children":[]},{"tag":"circle","props":{"cx":"12","cy":"10","r":"4"},"children":[]},{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},{"tag":"span","props":{},"children":["Đăng nhập để đồng bộ hóa"]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/vi/book/31"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"Quay lại mục lục"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["Sau mười tám tuổi có những con đường nào"]},{"tag":"nav","props":{"aria-label":"Các mục trong chương"},"children":[{"tag":"a","props":{"href":"/vi/tip/31-01"},"children":[{"tag":"span","props":{},"children":["01"]},"Đối chiếu điều kiện trước đã: yêu cầu về tuổi và trình độ của mười hai con đường đều được viết thành văn bản"]},{"tag":"a","props":{"href":"/vi/tip/31-02"},"children":[{"tag":"span","props":{},"children":["02"]},"Năm thứ mười tám tuổi phải đăng ký nghĩa vụ quân sự trước ngày 31 tháng 10; quân nhân lính nghĩa vụ nhập ngũ đúng hai năm"]},{"tag":"a","props":{"href":"/vi/tip/31-03"},"children":[{"tag":"span","props":{},"children":["03"]},"Sau khi được truy xuất mà từ chối nghĩa vụ quân sự thì trong hai năm không được xuất cảnh, không được học tiếp, và không vào được cơ quan công chức hay doanh nghiệp nhà nước"]},{"tag":"a","props":{"href":"/vi/tip/31-04"},"children":[{"tag":"span","props":{},"children":["04"]},"Hai điều thật nhất khi sinh viên đại học đi nghĩa vụ quân sự: học phí mỗi năm bù tối đa 20000 tệ, giữ học vị hai năm, và có một kế hoạch riêng cho tuyển sinh cao học"]},{"tag":"a","props":{"href":"/vi/tip/31-05"},"children":[{"tag":"span","props":{},"children":["05"]},"Sau khi giải ngũ chỉ có sáu trường hợp được chính quyền bố trí việc làm; người tự tìm việc phải đến đăng ký trong vòng 30 ngày"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/vi/tip/31-06","data-status":"active"},"children":[{"tag":"span","props":{},"children":["06"]},"Ba khoản sau khi giải ngũ: tiền trở cấp một lần, thời gian phục vụ tính vào thâm niên công, và tự làm ăn thì mỗi năm giảm 20000 tệ thuế"]},{"tag":"a","props":{"href":"/vi/tip/31-07"},"children":[{"tag":"span","props":{},"children":["07"]},"Muốn vào hệ thống cơ quan công chức không chỉ có thi cao công chức: làm đủ hai năm ở chương trình phục vụ cơ sở thì dự được kế hoạch tuyển định hướng dành riêng cho 10% mỗi năm"]},{"tag":"a","props":{"href":"/vi/tip/31-08"},"children":[{"tag":"span","props":{},"children":["08"]},"Giáo viên vị trí đặc biệt hết hạn ba năm, đạt kết quả đánh giá và còn muốn ở lại thì phải được chuyển thành biên chế đúng thời hạn"]},{"tag":"a","props":{"href":"/vi/tip/31-09"},"children":[{"tag":"span","props":{},"children":["09"]},"Lính cứu hộ và nhân sự văn chứng quân đội là hai cửa tuyển công khai khác, ngưỡng thấp hơn thi công chức"]},{"tag":"a","props":{"href":"/vi/tip/31-10"},"children":[{"tag":"span","props":{},"children":["10"]},"Bằng cấp không phải việc mua một lần là xong: thi tự học không giới hạn tuổi cũng không xem trình độ đã học, thi lớn và đại học mở đều bổ sung được"]},{"tag":"a","props":{"href":"/vi/tip/31-11"},"children":[{"tag":"span","props":{},"children":["11"]},"Không vào cơ quan công chức thì làm việc linh hoạt: hưu trí và y tế phải tự tham gia bảo hiểm ở nơi làm việc, hạn chế về hộ khẩu đã được nới"]},{"tag":"a","props":{"href":"/vi/tip/31-12"},"children":[{"tag":"span","props":{},"children":["12"]},"Giao đồ ăn, chạy xe ô tô công nghệ, chở hàng trong thành phố: sàn trả phí bảo hiểm tai nạn lao động theo từng đơn, bạn không phải đóng"]},{"tag":"a","props":{"href":"/vi/tip/31-13"},"children":[{"tag":"span","props":{},"children":["13"]},"Hai con đường chốt được chỗ làm việc có biên chế ngay từ ngày điền nguyện vọng kỳ thi gaokao: sinh viên sư phạm có học phí và sinh viên y khoa định hướng, cái giá là thực hiện cam kết 6 năm"]},{"tag":"a","props":{"href":"/vi/tip/31-14"},"children":[{"tag":"span","props":{},"children":["14"]},"Muốn đi làm công ăn nước ngoài, trước hết tra công ty này có giấy phép hợp tác lao động ngoài biên giới không: công ty không được đòi bạn đặt tiền"]},{"tag":"a","props":{"href":"/vi/tip/31-15"},"children":[{"tag":"span","props":{},"children":["15"]},"Làm việc từ xa cho công ty nước ngoài ngay tại nhà, khoản tiền này theo luật thuế tính là thu nhập trong nước: thuế thu nhập cá nhân tự kê khai, tiền về nước đi theo khoản「thù lao lao động」"]},{"tag":"a","props":{"href":"/vi/tip/31-16"},"children":[{"tag":"span","props":{},"children":["16"]},"Không vào cơ quan mà tự làm ăn, tiền khởi đầu hãy xem khoản vay bảo đảm khởi nghiệp: cá nhân tối đa 30 vạn, Nhà nước trợ một nửa lãi suất"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"Breadcrumbs"},"children":[{"tag":"a","props":{"href":"/vi/book"},"children":["Khám phá cuốn sách"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/vi/book/31"},"children":["Chương 31"," ·"," ","Sau mười tám tuổi có những con đường nào"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"31-06"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["06"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["Bằng chứng"," ","A"]}]},{"tag":"h1","props":{"lang":"vi"},"children":["Ba khoản sau khi giải ngũ: tiền trở cấp một lần, thời gian phục vụ tính vào thâm niên công, và tự làm ăn thì mỗi năm giảm 20000 tệ thuế"]},{"tag":"p","props":{"lang":"vi","className":"life-entry-summary"},"children":["Sau khi giải ngũ có ba khoản. Một là tiền trở cấp một lần cho người tự tìm việc, trả theo thời gian phục vụ, người có công còn được tăng thêm. Hai là mấy năm đi quân không phải khoảng trống của bảo hiểm xã hội, thời gian phục vụ được tính vào thâm niên công, thời gian đóng bảo hiểm cộng với trước nhập ngũ và sau giải ngũ. Ba là thuế: người tự mở cửa hàng kinh doanh thì trong 3 năm, mỗi năm giảm được tối đa 20000 tệ thuế."]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Chi phí"]},{"tag":"p","props":{},"children":["Không tốn tiền. Khi giải ngũ, quân đội chuyển quan hệ bảo…"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Lợi ích"]},{"tag":"p","props":{},"children":["Khoản thứ nhất xem《Quy chế sắp xếp cựu chiến binh》. Nó viết:「对自主就业的退役军士和义务兵，根据其服现役年限发放一次性退役金」, tức quân nhân c…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"Đánh dấu: Ba khoản sau khi giải ngũ: tiền trở cấp một lần, thời gian phục vụ tính vào thâm niên công, và tự làm ăn thì mỗi năm giảm 20000 tệ thuế"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"Hoàn tất"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"Kế hoạch thực hiện"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"Lưu"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Chia sẻ mẹo này"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Ẩn chi tiết"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Chi phí"]},{"tag":"p","props":{},"children":["Không tốn tiền. Khi giải ngũ, quân đội chuyển quan hệ bảo hiểm xã hội và tiền của bạn ra. Bạn đến cơ quan bảo hiểm xã hội ở nơi sắp xếp (cửa sổ làm bảo hiểm xã hội) để nối tiếp."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Lợi ích"]},{"tag":"p","props":{},"children":["Khoản thứ nhất xem《Quy chế sắp xếp cựu chiến binh》. Nó viết:「对自主就业的退役军士和义务兵，根据其服现役年限发放一次性退役金」, tức quân nhân cấp bậc và quân nhân lính nghĩa vụ giải ngũ tự tìm việc thì được trả tiền trở cấp một lần tuỳ thời gian phục vụ. Tiền do ai chi trả:「由中央财政专项安排，具体标准由国务院退役军人工作主管部门、中央军事委员会政治工作部门会同国务院财政部门……确定，并适时调整」, tức do ngân sách trung ương sắp xếp riêng, mức cụ thể do cơ quan quản lý cựu chiến binh của Hội đồng Nhà nước và cơ quan chính trị quân sự Trung ương cùng Bộ Tài chính xác định, và điều chỉnh theo thời. Tỷ lệ tăng chia thành năm bậc. Được tặng huân chương hoặc danh hiệu tôn vinh thì tăng 25%, chiến công cấp một hoặc tuyên dương cấp một thì 20%. Chiến công cấp hai, huân chương cấp một hoặc tuyên dương cấp hai thì 15%. Chiến công cấp ba hoặc chiến công cấp hai thì 10%, chiến công cấp bốn hoặc chiến công cấp ba thì 5%. Quy chế đó còn viết:「退役军人未及时就业的，可以依法向户口所在地人力资源社会保障部门申领失业保险待遇，服现役年限视同参保缴费年限，但是以退休、供养方式安置的退役军人除外」, tức cựu chiến binh chưa có việc làm kịp thì có thể theo luật xin trợ cấp bảo hiểm thất nghiệp ở cơ quan bảo hiểm xã hội nơi có hộ khẩu, thời gian phục vụ được tính như thời gian đóng bảo hiểm, trừ cựu chiến binh được sắp xếp theo chế độ nghỉ hưu hoặc nuôi dưỡng. Tính như thời gian đóng bảo hiểm nghĩa là mấy năm đó bạn chưa đóng tiền thì vẫn tính như đã đóng. Khoản thứ hai xem《Luật bảo đảm cho cựu chiến binh》:「退役军人服现役年限计算为工龄，退役后与所在单位工作年限累计计算」, tức thời gian phục vụ được tính vào thâm niên công, sau khi giải ngũ thì cộng dồn với số năm làm việc ở đơn vị đó. Thâm niên công là số năm đã tham gia làm việc, mấy năm phục vụ cộng với các năm sau giải ngũ sẽ cộng tiếp vào. Luật đó còn viết rằng thời gian phục vụ cộng với thời gian đóng bảo hiểm hưu trí, y tế, thất nghiệp trước nhập ngũ và sau giải ngũ thì「依法合并计算」, và「退役的军士和义务兵服现役经历视为基层工作经历」, tức thời gian đóng trước nhập ngũ và sau giải ngũ được cộng hợp pháp, kinh nghiệm phục vụ của quân nhân cấp bậc và quân nhân lính nghĩa vụ giải ngũ được coi là kinh nghiệm làm việc ở cơ sở. 《Luật bảo hiểm quân nhân》:「军人服现役年限视同职工基本医疗保险缴费年限，与入伍前和退出现役后参加职工基本医疗保险的缴费年限合并计算」, tức thời gian phục vụ được tính như thời gian đóng bảo hiểm y tế cơ bản của người lao động, cộng với thời gian đóng trước nhập ngũ và sau khi rời khỏi quân đội. Khoản thứ ba xem thông báo số 14 năm 2023 của Bộ Tài chính, Cục Thuế và Bộ Công tác cựu chiến binh. Thông báo viết về trường hợp quân nhân giải ngũ tự tìm việc làm kinh doanh cá thể:「在 3 年（36 个月，下同）内按每户每年 20000 元为限额依次扣减其当年实际应缴纳的增值税、城市维护建设税、教育费附加、地方教育附加和个人所得税。限额标准最高可上浮 20%」, tức trong 3 năm (36 tháng, các mục sau cũng vậy), theo mức mỗi hộ mỗi năm 20000 tệ, trừ dần vào các khoản thuế mà trong năm đó phải nộp theo thứ tự: thuế giá trị gia tăng, thuế xây dựng và bảo trì đô thị, phụ thu giáo dục, phụ thu giáo dục địa phương và thuế thu nhập cá nhân; mức tối đa có thể nâng lên tới 20%. Trừ dần nghĩa là trừ từ các khoản thuế phải nộp trong năm đó xuống theo thứ tự cho tới hết mức, không phải tiền được phát cho bạn. Đơn vị sử dụng lao động thì「定额标准为每人每年 6000 元，最高可上浮 50%」, tức mức cố định mỗi người mỗi năm 6000 tệ, có thể nâng lên tối đa 50%. Thời hạn áp dụng là từ ngày 1 tháng 1 năm 2023 đến ngày 31 tháng 12 năm 2027. Đến hạn mà chưa đủ 3 năm thì vẫn được hưởng tiếp cho tới khi đủ (toàn quốc)"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Nguồn gốc"]},{"tag":"p","props":{"className":"life-citations"},"children":["国务院、中央军委 (2024). 退役军人安置条例（国务院、中央军委令第 787 号，第二十一、二十二、七十四、八十一、八十五条）. ",{"tag":"a","props":{"href":"https://www.gov.cn/gongbao/2024/issue_11526/202408/content_6969192.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/gongbao/2024/issue_11526/202408/content_6969192.html"]},"；退役军人事务部 (2020). 关于一次性退役金的十个问题（转载《中国退役军人》2020 年第 10 期）：「基本标准。士兵服现役每满一年，发给4500元」「退役金标准适时调整」. ",{"tag":"a","props":{"href":"https://www.mva.gov.cn/sy/zzxc/202011/t20201113_43153.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.mva.gov.cn/sy/zzxc/202011/t20201113_43153.html"]},"；贵州省退役军人事务厅 (2024). 一次性退役金增发，重要变化！：「现在执行的标准是：士兵服现役每满一年，发给4500元」. ",{"tag":"a","props":{"href":"http://tyjrswt.guizhou.gov.cn/zfxxgk/fdzdgknr/zdlyxx_5621158/tyaz_5621161/202408/t20240809_85367194.html","target":"_blank","rel":"noopener noreferrer"},"children":["http://tyjrswt.guizhou.gov.cn/zfxxgk/fdzdgknr/zdlyxx_5621158/tyaz_5621161/202408/t20240809_85367194.html"]},"；烟台市牟平区人民政府 (2025). 答复中引《烟台市退役军人事务局、烟台市财政局关于调整自主就业退役士兵一次性经济补助标准的通知》：「2024年退出现役的每服役一年补助6000元」. ",{"tag":"a","props":{"href":"https://www.muping.gov.cn/art/2025/11/10/art_105032_2960250.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.muping.gov.cn/art/2025/11/10/art_105032_2960250.html"]},"；全国人大常委会 (2020). 退役军人保障法（第四十二、四十四、五十条）. ",{"tag":"a","props":{"href":"http://www.mod.gov.cn/gfbw/fgwx/flfg/16048597.html","target":"_blank","rel":"noopener noreferrer"},"children":["http://www.mod.gov.cn/gfbw/fgwx/flfg/16048597.html"]},"（国防部刊登）；全国人大常委会 (2012). 军人保险法（第十六、二十三条）. ",{"tag":"a","props":{"href":"https://flk.npc.gov.cn/detail?id=2c909fdd678bf17901678bf73e160645","target":"_blank","rel":"noopener noreferrer"},"children":["https://flk.npc.gov.cn/detail?id=2c909fdd678bf17901678bf73e160645"]},"（国家法律法规数据库）；财政部、税务总局、退役军人事务部 (2023). 关于进一步扶持自主就业退役士兵创业就业有关税收政策的公告（2023 年第 14 号）. ",{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/202308/content_6896456.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/zhengce/zhengceku/202308/content_6896456.htm"]}]},{"tag":"a","props":{"href":"https://www.gov.cn/gongbao/2024/issue_11526/202408/content_6969192.html","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Liên kết mở nguồn"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Ghi chú sách"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["Quy chế chỉ viết rằng số tiền do cơ quan chủ quản quyết định riêng. Con số chính thức tra được là câu trong bài đăng năm 2020 trên trang Bộ Công tác cựu chiến binh「服现役每满一年，发给4500元」, cùng bài đó còn viết「适时调整」. Tỷ lệ tăng trong bài đó đã không khớp với quy chế đang có hiệu lực, phải theo quy chế. Bài đăng tháng 8 năm 2024 của Sở Công tác cựu chiến binh tỉnh Quý Châu, dưới quy chế mới, vẫn viết「现在执行的标准是：士兵服现役每满一年，发给4500元」. TODO（cần đối chiếu：không tìm được văn bản tiêu chuẩn chính thức, chỉ xác nhận được tới tháng 8 năm 2024 cơ quan cấp tỉnh vẫn ghi như vậy）. Ngoài ra đừng lẫn「trợ cấp kinh tế một lần」của địa phương với khoản này. Đó là một khoản tiền khác do các nơi tự quy định và tự chi trả, ví dụ Yên Đài năm 2024 trợ cấp mỗi năm phục vụ 6000 tệ. Số mới trong các hướng dẫn trên mạng phần lớn không có nguồn, có cái lại là gộp hai khoản đó vào nhau. Trong thời gian quân nhân lính nghĩa vụ phục vụ, gia đình còn có thể nhận một khoản ưu đãi gia đình riêng. Luật nghĩa vụ quân sự chỉ viết「标准由地方人民政府制定，中央财政给予定额补助」, cụ thể bao nhiêu thì hỏi chính quyền huyện nơi chấp thuận cho bạn nhập ngũ. Khoản thuế là mỗi năm giảm được tối đa bao nhiêu tệ thuế. Nếu việc kinh doanh không lên thì không dùng hết, nên cả mục này chỉ để mức lợi ích「vừa」. 《Quy chế thúc đẩy việc làm và khởi nghiệp cho cựu chiến binh》áp dụng từ ngày 1 tháng 8 năm 2026 bổ sung một điều: chứng chỉ nghề nghiệp của người lao động có tay nghề thi đỗ trong thời gian phục vụ thì sau khi giải ngũ có giá trị trên toàn quốc."]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Ghi chú của tôi"]},{"tag":"button","props":{"type":"button"},"children":["Viết một lời nhắc cho chính bạn…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/vi/tip/31-05"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Trước"]},"Sau khi giải ngũ chỉ có sáu trường hợp được chính quyền bố trí việc làm; người tự tìm việc phải đến đăng ký trong vòng 30 ngày"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/vi/tip/31-07"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Tiếp theo"]},"Muốn vào hệ thống cơ quan công chức không chỉ có thi cao công chức: làm đủ hai năm ở chương trình phục vụ cơ sở thì dự được kế hoạch tuyển định hướng dành riêng cho 10% mỗi năm"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["Thêm trong chủ đề này"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/31-02"},"children":[{"tag":"strong","props":{},"children":["Năm thứ mười tám tuổi phải đăng ký nghĩa vụ quân sự trước ngày 31 tháng 10; quân nhân lính nghĩa vụ nhập ngũ đúng hai năm"]},{"tag":"span","props":{},"children":["Đăng ký nghĩa vụ quân sự là nghĩa vụ theo luật, không phải đăng ký th…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/31-03"},"children":[{"tag":"strong","props":{},"children":["Sau khi được truy xuất mà từ chối nghĩa vụ quân sự thì trong hai năm không được xuất cảnh, không được học tiếp, và không vào được cơ quan công chức hay doanh nghiệp nhà nước"]},{"tag":"span","props":{},"children":["Đã đăng ký rồi lại từ chối đi nhập ngũ thì hậu quả là một loạt. Không…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/31-04"},"children":[{"tag":"strong","props":{},"children":["Hai điều thật nhất khi sinh viên đại học đi nghĩa vụ quân sự: học phí mỗi năm bù tối đa 20000 tệ, giữ học vị hai năm, và có một kế hoạch riêng cho tuyển sinh cao học"]},{"tag":"span","props":{},"children":["Sinh viên đang học, sinh viên năm cuối và sinh viên mới nhập trường đ…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/31-08"},"children":[{"tag":"strong","props":{},"children":["Giáo viên vị trí đặc biệt hết hạn ba năm, đạt kết quả đánh giá và còn muốn ở lại thì phải được chuyển thành biên chế đúng thời hạn"]},{"tag":"span","props":{},"children":["Kế hoạch vị trí đặc biệt là một trong số ít con đường mà văn bản ghi …"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/31-09"},"children":[{"tag":"strong","props":{},"children":["Lính cứu hộ và nhân sự văn chứng quân đội là hai cửa tuyển công khai khác, ngưỡng thấp hơn thi công chức"]},{"tag":"span","props":{},"children":["Cả hai con đường này đều không chặn ở ngưỡng「trình độ cao đẳng trở lê…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/31-10"},"children":[{"tag":"strong","props":{},"children":["Bằng cấp không phải việc mua một lần là xong: thi tự học không giới hạn tuổi cũng không xem trình độ đã học, thi lớn và đại học mở đều bổ sung được"]},{"tag":"span","props":{},"children":["Năm mười tám tuổi không học được thì phía sau vẫn còn ba cửa chính th…"]}]}]}]},{"tag":"a","props":{"className":"life-text-link","href":"/vi/book/31"},"children":["Đọc toàn bộ chủ đề: Sau mười tám tuổi có những con đường nào"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"15","height":"15","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeL