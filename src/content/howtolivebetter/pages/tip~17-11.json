:"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"收藏"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"分享这条建议"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"收起详情"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["成本"]},{"tag":"p","props":{"className":"life-citations"},"children":["不花钱。签约前打电话问当地县级民政部门，或者让养老院拿出备案回执。再把协议、收费单和收款账户对一遍，半天就够。难在床位紧的养老院，家属不好意思挑合同的毛病。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["收益"]},{"tag":"p","props":{"className":"life-citations"},"children":["民政部的养老机构管理办法规定，养老机构收住老人后 10 个工作日内要去民政部门备案。材料齐全的，民政部门出具备案回执。养老机构要和老人或者代理人签服务协议，写明护理等级、收费标准、退费和违约责任。不签协议的，民政部门责令改正、给予警告，情节严重的罚 3 万元以下。民政部等七部门 2024 年的文件给预收费定了上限。养老服务费最长预收 12 个月。押金最多是这位老人月床位费的 12 倍。押金只能用来退费、垫付老人突发就医的费用、抵扣欠费和赔偿。公办和公建民营的养老院不得收会员费。还没建成、或者还不能收住老人的养老院，也不得收会员费。押金和会员费要全部存进银行第三方存管的专用存款账户，不得用个人账户收款。收了钱要开发票，不得拿收据代替。老人还没入住就解约的，养老院要及时退还预收的钱。已经入住的，扣掉已经消费的部分，原则上按原渠道一次退清剩下的。这份文件从 2024 年 10 月 1 日起施行，各省可以定得更严。2025 年的存管指引要求，养老院提出退费申请后，存管银行当天、最晚第二天按原渠道一次退清"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["来源"]},{"tag":"p","props":{"className":"life-citations"},"children":["民政部 (2020). 养老机构管理办法（民政部令第 66 号，第十、十二、十六、四十六条）. ",{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/2020-09/19/content_5544761.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/zhengce/zhengceku/2020-09/19/content_5544761.htm"]},"；民政部、国家发展改革委、公安部等七部门 (2024). 关于加强养老机构预收费监管的指导意见（民发〔2024〕19 号，第四、五、六、八、九条）. ",{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/202405/content_6950308.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/zhengce/zhengceku/202405/content_6950308.htm"]},"；民政部办公厅、金融监管总局办公厅 (2025). 关于印发《养老机构预收费存管工作指引》的通知（民办发〔2025〕9 号）. ",{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/202511/content_7049045.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/zhengce/zhengceku/202511/content_7049045.htm"]},"；国家市场监督管理总局. 合同示范文本库（各省养老机构服务合同示范文本，如甘肃省 2024 版）. ",{"tag":"a","props":{"href":"https://htsfwb.samr.gov.cn/View?id=8377c6f9-b7f8-4cb4-a218-0e5b65de5cce","target":"_blank","rel":"noopener noreferrer"},"children":["https://htsfwb.samr.gov.cn/View?id=8377c6f9-b7f8-4cb4-a218-0e5b65de5cce"]},""]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["原书备注"]},{"tag":"p","props":{"className":"life-citations"},"children":["各省可以把押金上限和服务费预收期限定得更短，签约前查本省的规定。协议可以照本省民政和市场监管部门发的养老机构服务合同示范文本签，市场监管总局的合同示范文本库能查到。备案是收住老人以后才办的，刚开业的养老院可能还在办，可以问它什么时候备案。退费谈不拢，文件给的路是协商、调解、投诉、仲裁、诉讼。投诉找负责监管的民政部门，不收费。上法院的，一审普通程序 6 个月起，律师费自己出。收钱时承诺返本付息、给回报的，已经不是正常预收费，见第 5 条（投资养老）。受益人主要是你的父母和祖父母。预收费上限按截至 2026 年 10 月的文件写。"]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["我的备注"]},{"tag":"button","props":{"type":"button"},"children":["写下对自己有用的提醒…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/tip/17-10"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["上一条"]},"家里老人遛狗，把牵绳握在手心、别缠在手上，绳子收短，狗先训练到牵着不往前猛冲"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/tip/17-12"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["下一条"]},"独生子女的父母住院，查本省条例有没有给子女的护理假，有就带着住院证明向单位书面申请"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["本主题的其他建议"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/17-03"},"children":[{"tag":"strong","props":{},"children":["老人的钱单独放一个账户，大额支出定一个双人确认的规矩"]},{"tag":"span","props":{},"children":["骗老人的人常先送小礼物、嘘寒问暖，把信任攒足，再骗走大钱。骗子还常叮嘱「不要告诉任何人」。事先约好一条规矩：超过多少钱的支出，要先跟某个人说一声。这样掏钱之前家…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/17-04"},"children":[{"tag":"strong","props":{},"children":["给老人备好一句随时能说出口的推辞：「我要回去和家里人商量」"]},{"tag":"span","props":{},"children":["推销和诈骗靠的是现场压力，要你来不及想就掏钱。人情绪一被调动起来，就更想买夸大广告里的东西，老人比年轻人更想买。事先和老人商量好一句「我要回去和家里人商量」。他…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/17-05"},"children":[{"tag":"strong","props":{},"children":["凡是让老人先交钱的「投资养老」都别碰：办卡、买床位、买养老公寓、旅居养老、买老年产品是同一套非法集资"]},{"tag":"span","props":{},"children":["让老人先交钱、又许诺回报的养老名目，都是同一套骗局。常见的有办卡、买床位、买养老公寓、旅居养老、开会卖老年产品。按规定，这种钱亏了只能自己认。有人借预定养老公寓…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/17-06"},"children":[{"tag":"strong","props":{},"children":["除了保险公司的住房反向抵押养老保险，其他「以房养老」都别碰，绝不抵押房子去买理财"]},{"tag":"span","props":{},"children":["正规的以房养老只有一种，就是保险公司的住房反向抵押养老保险，还在试点。骗子说的「以房养老」和它完全无关，是骗老人抵押房子，再拿借来的钱买它推荐的理财。有人连房子…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/17-07"},"children":[{"tag":"strong","props":{},"children":["家里老人长期卧床或重度失能，去参保地医保部门申请长期护理保险；它不是只发给老人"]},{"tag":"span","props":{},"children":["长期护理保险付的是护理服务费，一般不直接发现金。家里有人重度失能、持续半年以上，就去参保地医保部门申请。护理费没有起付线，职工参保的报七成左右，城乡居民参保的报…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/17-08"},"children":[{"tag":"strong","props":{},"children":["家里有人长期卧床，把压疮当头号敌人：上电动气垫床、定时翻身、每天看一遍骨头突出的地方"]},{"tag":"span","props":{},"children":["髋部骨折开刀前就有压疮的老人，30 天内去世的可能性高约两成。换电动气垫床，新长压疮的少约六成。ICU 里靠传感器提醒把按时翻身做到位，少约七成，让人趴着的压疮…"]}]}]}]},{"tag":"a","props":{"className":"life-text-link","href":"/book/17"},"children":["阅读整个主题：家里有老人 ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"15","height":"15","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]}]}]},{"tag":"nav","props":{"className":"life-tabbar","aria-label":"主导航"},"children":[{"tag":"a","props":{"className":"","href":"/book"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"21","height":"21","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-book-open","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M12 7v14"},"children":[]},{"tag":"path","props":{"d":"M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z"},"children":[]}]},{"tag":"span","props":{},"children":["全书"]}]},{"tag":"a","props":{"className":"","href":"/top-50"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"21","height":"21","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-star","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 2.122 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.122 2.122 0 0 0 1.597-