/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"收起详情"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["成本"]},{"tag":"p","props":{},"children":["报课要花一点钱。课程 8 周，每周上一次课，还要每天在家练。难在连着 8 周每天都练。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["收益"]},{"tag":"p","props":{},"children":["这是美国 3 家城市学术医疗中心做的试验，目的是看上课会不会比吃药差（非劣效随机对照试验）。276 名确诊焦虑障碍的成年人按 1:1 随机对半分组。一组上 8 周正念减压课程。一组吃艾司西酞普兰（10 至 20 mg 弹性剂量）。208 人做完全程。结束时按医生打的焦虑严重程度分（临床总体印象严重度量表）算，正念组下降 1.35，药物组下降 1.43。两组差 −0.07（95% CI −0.38 至 0.23，即真实差距大致落在这一段里；P=0.65，即这点差距和没差别看不出区别）。这一段的下限没有越过事先划好的「算不上更差」的线（非劣效界值 −0.495）。副作用差别很大：药物组 78.6% 至少出现一次和试验有关的不良反应，10 人因此退出。正念组 15.4%，无人因此退出"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["原始出处"]},{"tag":"p","props":{"className":"life-citations"},"children":["Hoge EA, Bui E, Mete M, Dutton MA, Baker AW, Simon NM (2023). Mindfulness-based stress reduction vs escitalopram for the treatment of adults with anxiety disorders: a randomized clinical trial. JAMA Psychiatry, 80(1), 13-21. ",{"tag":"a","props":{"href":"https://doi.org/10.1001/jamapsychiatry.2022.3679","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1001/jamapsychiatry.2022.3679"]}]},{"tag":"a","props":{"href":"https://doi.org/10.1001/jamapsychiatry.2022.3679","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["打开来源链接"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["原书备注"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["试验用的是标准化的 8 周正念减压课程（MBSR），随便一个冥想 App 不能和它划等号。它适用于已经达到焦虑障碍诊断标准的人，该看医生还是要看。如果你因为顾虑药物副作用一直拖着不治疗，这是一个证据强度相当的选项"]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["我的备注"]},{"tag":"button","props":{"type":"button"},"children":["写下对自己有用的提醒…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/tip/22-06"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["上一条"]},"心情差就去走或者跑，抗抑郁的效应量（效果大小）跟强度成正比"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/tip/22-08"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["下一条"]},"当场想缓过来，用 5 分钟「循环叹息」：吸气两段，呼气拉长"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["本主题的其他建议"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/22-02"},"children":[{"tag":"strong","props":{},"children":["点单前要价目表，娱乐场所必须明码标价，不接受「先玩后算」"]},{"tag":"span","props":{},"children":["按规定，娱乐场所卖服务、卖东西都必须明码标价，还要主动把价目表拿给你看。所谓「天价酒水」，几乎都出在没看过价目表、事后按口头报价结账的场合…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/22-03"},"children":[{"tag":"strong","props":{},"children":["场子里有人递「东西」就立刻走，容留和提供都不是「帮朋友」"]},{"tag":"span","props":{},"children":["娱乐场所不许贩毒、不许提供毒品，也不许留人在里面吸，违反的要停业整顿 3 到 6 个月，重的吊销许可证。你自己吸要受治安处罚。在你订的包厢…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/22-04"},"children":[{"tag":"strong","props":{},"children":["不吃陌生人给的糖和零食，不喝离开过视线的饮料，不接别人递的烟弹"]},{"tag":"span","props":{},"children":["现在的毒品不长毒品的样子。掺了合成大麻素的「上头」电子烟，看着和普通电子烟差不多，有人专在酒吧、KTV、宾馆里递给人试。骗人吸的拘留 10…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/22-05"},"children":[{"tag":"strong","props":{},"children":["剧本杀、密室别去开在居民楼里或者地下二层以下的"]},{"tag":"span","props":{},"children":["五部门 2022 年的通知写明，剧本娱乐场所不得开在居民楼内，也不得开在地下一层以下。这类场地黑、隔断多、道具易燃，门还常常要解谜才打得开…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/22-09"},"children":[{"tag":"strong","props":{},"children":["把「定期和人见面」当成健康支出，别只在心情差时才找人"]},{"tag":"span","props":{},"children":["平时很少和人来往的人，同期死亡的概率高约三成。感到孤独的人高约四分之一，独居的人高约三成，65 岁以下的人更明显。这些都是跟踪观察出来的，…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/22-10"},"children":[{"tag":"strong","props":{},"children":["选住处时把周边绿地算进去，但别指望「多去公园」就延寿"]},{"tag":"span","props":{},"children":["住处周边 500 米内的绿化越好，同期死亡的概率越低，按植被指数每提高 0.1 算，低约 4%。量的是住处周边的绿化，不是你去公园的次数。…"]}]}]}]},{"tag":"a","props":{"className":"life-text-link","href":"/book/22"},"children":["阅读整个主题：怎么放松：娱乐场所和减压"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"15","height":"15","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]}]}]}]},{"tag":"aside","props":{"className":"life-ad-space life-ad-space-sponsored","data-ad-placement":"ad_footer","data-ad-group":"reading","data-ad-creative":"read_product","data-ad-ready":"false","aria-label":"广告 · 社区推荐"},"children":[{"tag":"div","props":{"className":"life-ad-space-brand"},"children":[{"tag":"img","props":{"src":"/sites/howtolivebetter/images/shengcai/logo.png","width":"565","height":"144","alt":"生财有术官方 Logo","decoding":"async"},"children":[]}]},{"tag":"div","props":{"className":"life-ad-space-copy"},"children":[{"tag":"span","props":{"className":"life-ad-space-label"},"children":["广告 · 社区推荐"]},{"tag":"strong","props":{},"children":["读过的知识，能不能做成有用的产品？"]},{"tag":"p","props":{},"children":["从电子书、资料到小工具，看看圈友怎样发现需求，把内容变成实际交付。"]}]},{"tag":"div","props":{"className":"life-ad-space-actions"},"children":[{"tag":"a","props":{"className":"life-ad-space-link","href":"/shengcaiyoushu?sc_group=reading&sc_creative=read_product&sc_placement=ad_footer"},"children":["看看社区与案例",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"18","height":"18","viewBox":"0 0