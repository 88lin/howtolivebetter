s":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Chi phí"]},{"tag":"p","props":{},"children":["Máy và viên thuốc điện tử tính ra vài chục tệ đến vài trăm tệ mỗi tháng. Ở Trung Quốc chỉ mua được vị thuốc lá, và chỉ ở cửa hàng có giấy phép bán lẻ độc quyền thuốc lá."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Lợi ích"]},{"tag":"p","props":{},"children":["Một bài tổng quan được cập nhật liên tục gồm 80 thử nghiệm chia nhóm ngẫu nhiên, 29861 người. Thuốc điện tử có nicotin so với liệu pháp thay thế nicotin cho tỷ lệ cai được cao hơn khoảng 61% (RR 1.61, 95% CI 1.23–2.12, đây là khoảng tin cậy; bằng chứng chắc chắn, 11 thử nghiệm, 4114 người). Đổi ra con số tuyệt đối thì xấp xỉ mỗi 100 người có thêm khoảng 4 người cai được (thêm từ 1 đến 7 người). Tỷ lệ biến chứng không mong muốn nghiêm trọng ở hai nhóm gần bằng nhau (chênh lệch rủi ro 0.01, 95% CI −0.01 đến 0.02, bằng chứng chắc chắn vừa). So với chỉ hỗ trợ hành vi hoặc không hỗ trợ gì thì cao hơn khoảng 75% (RR 1.75, 95% CI 1.39–2.20, bằng chứng chắc chắn thấp)."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Nguồn gốc"]},{"tag":"p","props":{"className":"life-citations"},"children":["Lindson N, Livingstone-Banks J, Butler AR, et al. (2026). Electronic cigarettes for smoking cessation. Cochrane Database of Systematic Reviews, 8, CD010216. ",{"tag":"a","props":{"href":"https://doi.org/10.1002/14651858.CD010216.pub11","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1002/14651858.CD010216.pub11"]},"；国家烟草专卖局 (2022). 电子烟管理办法（国家烟草专卖局公告 2022 年第 1 号，2022 年 5 月 1 日施行）第十八条：从事电子烟零售业务，要向烟草专卖行政主管部门申领烟草专卖零售许可证。第二十二条：「禁止向未成年人出售电子烟产品。」第二十三条第二款：「任何个人、法人或者其他组织不得通过本办法规定的电子烟交易管理平台以外的信息网络销售电子烟产品、雾化物和电子烟用烟碱等。」第二十六条：「禁止销售除烟草口味外的调味电子烟和可自行添加雾化物的电子烟。」. ",{"tag":"a","props":{"href":"http://www.gov.cn/gongbao/content/2022/content_5697988.htm","target":"_blank","rel":"noopener noreferrer"},"children":["http://www.gov.cn/gongbao/content/2022/content_5697988.htm"]}]},{"tag":"a","props":{"href":"https://doi.org/10.1002/14651858.CD010216.pub11","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Liên kết mở nguồn"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Ghi chú sách"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["Tranh cãi. Tổ chức Y tế Thế giới không đề xuất thuốc điện tử làm cách cai thuốc lá. Lý do là dữ liệu an toàn dài hạn chưa đủ, và nó kéo người trẻ bắt đầu tiếp xúc với nicotin. Anh thì đưa nó vào dịch vụ cai thuốc lá. Ở Trung Quốc không cấm bán thuốc điện tử toàn diện, nhưng quản lý rất chặt, quy định nằm trong Biện pháp quản lý thuốc điện tử. Chỉ được bán vị thuốc lá, vị trái cây và loại tự thêm dầu vào thì không được bán. Chỉ mua được ở cửa hàng thật đã có giấy phép bán lẻ độc quyền thuốc lá. Bán ở bất kỳ trang web, cửa hàng trực tuyến hay ứng dụng mạng xã hội nào khác, ngoài nền tảng giao dịch thuốc điện tử thống nhất của nhà nước, là bất hợp pháp. Bán cho người chưa thành niên cũng bị cấm. Vì vậy thuốc điện tử vị trái cây còn mua được đi là qua kênh bất hợp pháp, nằm ngoài tầm kiểm soát. Thuốc điện tử \" gây nghiện\" trộn chất tổng hợp cần sa lan lọt ra ngoài theo cách đó, xem mục 4 ở phần 22 (đừng nhận viên thuốc điện tử người khác đưa). Sản phẩm được đo trong bài tổng quan đều là sản phẩm có nicotin chịu sự quản lý, dầu thuốc điện tử không rõ nguồn gốc không nằm trong đó. Theo thứ tự thì nên thử mục 3 của phần này (thuốc cai thuốc lá) trước, bằng chứng ở đó chắc hơn và cũng rẻ hơn."]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Ghi chú của tôi"]},{"tag":"button","props":{"type":"button"},"children":["Viết một lời nhắc cho chính bạn…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/vi/tip/02-05"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Trước"]},"Đến phòng khám cai thuốc lá, hoặc gọi 12320 hỏi địa phương có dịch vụ cai thuốc lá không"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/vi/tip/02-07"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Tiếp theo"]},"Bỏ nước giải ngọt, chuyển sang loại không đường cũng không phải là cách giải quyết"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"c