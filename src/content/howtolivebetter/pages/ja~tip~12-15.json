":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"このヒントを共有"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"詳細を閉じる"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["費用・手間"]},{"tag":"p","props":{},"children":["費用はかかりません。契約書に「定金」という二文字を記載し、金額は契約総額の 20% を超えないようにします。まず代金を受け取ってから商品を発送します。相手に対して「後払い（支払猶予期間の設定）」を承諾する前に、まずは相手の調査を行ってください。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["効果"]},{"tag":"p","props":{},"children":["定金は、実際に相手の手元に資金が届いた時点で成立します（実際の交付時）。支払う側が契約に違反した場合、このお金は戻ってきません。受け取る側が契約に違反した場合、受け取った金額と同額をあわせて返還しなければなりません（倍返し）。契約総額（主契約の目的物額）の 20% を超える部分は、定金としては扱われません。約定された違約金が実際の損失と著しく乖離している場合、裁判所は一方の請求に基づき、金額を減額または増額することができます。違約金と定金の両方が契約書に記載されている場合、実際に違反が発生した際は、どちらか一方のみを選択して請求でき、両方を同時に受け取ることはできません（中国全土、2021 年より）。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["出典"]},{"tag":"p","props":{"className":"life-citations"},"children":["全国人大 (2020). 民法典（第五百八十五、五百八十六、五百八十七、五百八十八条）. ",{"tag":"a","props":{"href":"https://www.spp.gov.cn/spp/fl/202006/t20200602_463888.shtml","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.spp.gov.cn/spp/fl/202006/t20200602_463888.shtml"]}]},{"tag":"a","props":{"href":"https://www.spp.gov.cn/spp/fl/202006/t20200602_463888.shtml","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["出典を開く"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["著者の注記"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["「订金（予約金）」は民法典における定金のルールには該当せず、一般的には前払金として扱われます。これは実務上の通説であり、本節では判例の検証は行っていません。支払猶予期間を与えることは、自らの資金を相手に無利子で貸し出すことと同じであり、相手が倒産すれば貸倒れとなります。支払猶予期間を設定する前に、まずは国家企業信用信息公示システムで相手の記録を照会し、訴訟歴がないか確認してください。"]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["自分のメモ"]},{"tag":"button","props":{"type":"button"},"children":["自分へのメモを書く…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/ja/tip/12-14"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["前へ"]},"税務局を名乗り納税を催促してくるのはすべて詐欺です。納税手続きは電子税務局と 12366 を通じてのみ行ってください"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/ja/tip/12-16"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["次へ"]},"雇用後の最初の1ヶ月以内に書面契約を締結し、30 日以内に社会保険登録を行う"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["このテーマの他の提案"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/12-11"},"children":[{"tag":"strong","props":{},"children":["食品業界には刑事罰のラインがある：病死した肉や基準超過品を売れば罪に問われ、有害物質の混入は金額に関わらず、刑期は5年起算"]},{"tag":"span","props":{},"children":["前述の数条は金銭的な罰則ですが、本条は身柄の拘束に関するものです。病死した肉や検査不合格の肉、あるいは残留農薬・残留動物薬・重金属が著しく…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/12-12"},"children":[{"tag":"strong","props":{},"children":["営業許可取得後から申告義務が発生。収入がなくても期限内に「ゼロ申告」を行うこと（すべてゼロの書類を提出する）"]},{"tag":"span","props":{},"children":["営業許可を取得したら、期限内に納税申告を行う必要があります。1円も稼いでいなくても申告は必要ですが、その場合は書類の数字をすべてゼロと記入…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/12-13"},"children":[{"tag":"strong","props":{},"children":["請求書は実際の取引に基づいてのみ発行し、小規模納税者は免税枠を最大限活用する"]},{"tag":"span","props":{},"children":["簡易課税制度を適用する小規模納税者で、月間の売上高が 10 万未満、かつ四半期の売上高が 30 万未満であれば、増値税（付加価値税）は免除…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/12-17"},"children":[{"tag":"strong","props":{},"children":["賃金は契約と法律に従って支払い、昇給、貸付、ボーナスはすべて書面で行う"]},{"tag":"span","props":{},"children":["賃金は契約および法律に基づき、期日通りに全額支払わなければなりません。未払いの場合、従業員は直接裁判所に支払督促を申し立てることができます…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/12-18"},"children":[{"tag":"strong","props":{},"children":["販売してから製造：予約販売と小規模注文で需要を検証してから、製造に投資する"]},{"tag":"span","props":{},"children":["ある起業家が、イタリアの新規企業 116 社を約1年間追跡しました。「まず仮説を立て、市場のフィードバックを用いて検証する」という手法をと…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/12-19"},"children":[{"tag":"strong","props":{},"children":["サンプル完成後は、まず量産チェックリストを確認してから着手すること"]},{"tag":"span","props":{},"children":["サンプル1個と1,000個の差は、どこに資金が拘束されるかにあります。歩留まりが真のコストを決定します。最小注文数量（MOQ）と支払い条件…"]}]}]}]},{"tag":"a","props":{"className":"life-text-link","href":"/ja/book/12"},"children":["テーマ全体を読む：起業とビジネス：全財産を失わないために"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"15","height":"15","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]}]}]}]},{"tag":"aside","props":{"classNam