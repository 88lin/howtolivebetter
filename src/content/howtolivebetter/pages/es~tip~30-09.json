"M18 20a6 6 0 0 0-12 0"},"children":[]},{"tag":"circle","props":{"cx":"12","cy":"10","r":"4"},"children":[]},{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},{"tag":"span","props":{},"children":["Iniciar sesión"]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/es/book/30"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"Volver al índice"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["Los niños en edad escolar"]},{"tag":"nav","props":{"aria-label":"Consejos del capítulo"},"children":[{"tag":"a","props":{"href":"/es/tip/30-01"},"children":[{"tag":"span","props":{},"children":["01"]},"Si el niño dice que le empezó un dolor fuerte y repentino y que va en aumento, al hospital de inmediato; no lo dejes aguantar hasta la salida de clases"]},{"tag":"a","props":{"href":"/es/tip/30-02"},"children":[{"tag":"span","props":{},"children":["02"]},"No retrases «hasta después de los exámenes» un tratamiento que toca hacer: algunas ventanas siguen la edad ósea, no el calendario de exámenes"]},{"tag":"a","props":{"href":"/es/tip/30-03"},"children":[{"tag":"span","props":{},"children":["03"]},"Si el niño sufre acoso escolar, repórtalo a la escuela ese mismo día y exige respuesta por escrito; si hay golpes, extorsión de dinero o difusión de rumores, llama directamente a la policía"]},{"tag":"a","props":{"href":"/es/tip/30-04"},"children":[{"tag":"span","props":{},"children":["04"]},"Que el niño pase al menos 2 horas al día al aire libre: es la única medida contra la miopía que hoy cuenta con un ensayo aleatorizado"]},{"tag":"a","props":{"href":"/es/tip/30-05"},"children":[{"tag":"span","props":{},"children":["05"]},"De 0 a 3 años, ninguna pantalla; de 3 a 6, cuantas menos mejor; escolares, sin fines de estudio, no más de 1 hora al día"]},{"tag":"a","props":{"href":"/es/tip/30-06"},"children":[{"tag":"span","props":{},"children":["06"]},"Toma la miopía como un daño que se queda: a más graduación, más desprendimiento de retina, degeneración macular y glaucoma más adelante"]},{"tag":"a","props":{"href":"/es/tip/30-07"},"children":[{"tag":"span","props":{},"children":["07"]},"El informe del chequeo médico escolar de cada año revísalo tú mismo; los datos anormales, al hospital ese mismo año"]},{"tag":"a","props":{"href":"/es/tip/30-08"},"children":[{"tag":"span","props":{},"children":["08"]},"Haz a los hijos de 12 a 18 años una criba de depresión, y no tomes la evaluación psicológica de la escuela por un diagnóstico"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/es/tip/30-09","data-status":"active"},"children":[{"tag":"span","props":{},"children":["09"]},"No compres productos ni servicios que prometan «curar la miopía» o «reducir las graduaciones»"]},{"tag":"a","props":{"href":"/es/tip/30-10"},"children":[{"tag":"span","props":{},"children":["10"]},"Sueño, deberes, educación física y clasificaciones por notas tienen norma escrita, y a la escuela se le puede reclamar"]},{"tag":"a","props":{"href":"/es/tip/30-11"},"children":[{"tag":"span","props":{},"children":["11"]},"Si el niño no da más, puede suspender los estudios: la escuela está obligada a conservarle la matrícula, hasta 1 año"]},{"tag":"a","props":{"href":"/es/tip/30-12"},"children":[{"tag":"span","props":{},"children":["12"]},"Si el chequeo revela mala visión, ve al hospital para una refracción con dilatación de la pupila y después vuelve a los controles en el intervalo que indique el médico"]},{"tag":"a","props":{"href":"/es/tip/30-13"},"children":[{"tag":"span","props":{},"children":["13"]},"Sellado de fosas y fisuras en los primeros molares permanentes"]},{"tag":"a","props":{"href":"/es/tip/30-14"},"children":[{"tag":"span","props":{},"children":["14"]},"Si su hijo es adicto a los videojuegos, primero observe si se han visto desplazados el sueño, las tareas y las actividades al aire libre; no se limite solo a vigilar cuánto tiempo juega"]},{"tag":"a","props":{"href":"/es/tip/30-15"},"children":[{"tag":"span","props":{},"children":["15"]},"Si tu hijo dice que le gusta el mismo sexo, no lo regañes, no lo eches de casa, no lo envíes a «reeducación»: la actitud de la familia está relacionada con su riesgo de suicidio"]},{"tag":"a","props":{"href":"/es/tip/30-16"},"children":[{"tag":"span","props":{},"children":["16"]},"No golpee a su hijo ni grite llamándolo estúpido: los niños a menudo golpeados o insultados muestran más problemas de conducta y emocionales"]},{"tag":"a","props":{"href":"/es/tip/30-17"},"children":[{"tag":"span","props":{},"children":["17"]},"Si la crianza se le va de las manos y sigue golpeando o gritando, haga un curso que enseñe habilidades parentales concretas"]},{"tag":"a","props":{"href":"/es/tip/30-18"},"children":[{"tag":"span","props":{},"children":["18"]},"No envíes a tu hijo a «escuelas para curar la adicción a internet» ni a «campamentos especiales» cerrados: la ley prohíbe métodos que dañen cuerpo y mente, y ya han muerto niños encerrados"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"Ruta de navegación"},"children":[{"tag":"a","props":{"href":"/es/book"},"children":["Libro"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/es/book/30"},"children":["Capítulo 30"," ·"," ","Los niños en edad escolar"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"30-09"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["09"]},{"tag":"span","props":{"className":"life-evidence grade-b"},"children":["Evidencia"," ","B"]}]},{"tag":"h1","props":{"lang":"es"},"children":["No compres productos ni servicios que prometan «curar la miopía» o «reducir las graduaciones»"]},{"tag":"p","props":{"lang":"es","className":"life-entry-summary"},"children":["La frase textual de la Administración de Regulación del Mercado es: «con la tecnología médica actual, la miopía no se puede curar». «Rehabilitación», «recuperación», «reducción de graduación», «cura de la miopía», «verdugo de la miopía», «reparación de la graduación»: estas fórmulas están listadas directamente como expresiones de marketing ilícitas que hay que sancionar con rigor. Con ver una de estas palabras ya puedes descartar el producto, sin más comparaciones de precio. Los aparatos de protección visual son de la categoría de productos médicos, y las plataformas de comercio electrónico tienen la responsabilidad de revisar si el vendedor reúne las condiciones para venderlos."]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Coste"]},{"tag":"p","props":{},"children":["No cuesta dinero; al contrario, ese dinero se ahorra."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Beneficio"]},{"tag":"p","props":{},"children":["El aviso de la Oficina General de la Administración de Regulación del Mercado sobre la campaña especial de nov…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"Marcar: No compres productos ni servicios que prometan «curar la miopía» o «reducir las graduaciones»"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"Hecho"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"Por hacer"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"Guardar"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Compartir consejo"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Ocultar detalles"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Coste"]},{"tag":"p","props":{},"children":["No cuesta dinero; al contrario, ese dinero se ahorra."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Beneficio"]},{"tag":"p","props":{},"children":["El aviso de la Oficina General de la Administración de Regulación del Mercado sobre la campaña especial de noviembre de 2021 a marzo de 2022 deja claro: «con la tecnología médica actual, la miopía no se puede curar». El aviso ordena sancionar conforme a la ley con máximo rigor el uso de expresiones engañosas como «rehabilitación», «recuperación», «reducción de graduación», «cura de la miopía», «verdugo de la miopía» o «reparación de la graduación» en el marketing de productos para prevenir y controlar la miopía de niños y adolescentes. Ordena redoblar el golpe contra el marketing que, usurpando el nombre de la medicina tradicional china o amparándose en sus teorías y técnicas, engaña al consumidor. Pide también castigar con dureza dos tipos de publicidad falsa e ilícita: la que usa el nombre o la imagen de pacientes para comparar el antes y el después de un tratamiento, y la que hace promesas de garantía sobre la seguridad y la eficacia del tratamiento. Y exige a las plataformas de comercio electrónico cumplir con rigor su responsabilidad de revisar la licencia para vender aparatos de protección visual y demás productos médicos y artículos especiales; es decir, la plataforma responde de averiguar si el vendedor está en condiciones de vender estas cosas (nacional)."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Fuentes originales"]},{"tag":"p","props":{"className":"life-citations"},"children":["市场监管总局办公厅 (2021). 关于开展儿童青少年近视防控产品违法违规商业营销宣传专项整治行动的通知. ",{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/2021-11/12/content_5650400.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/zhengce/zhengceku/2021-11/12/content_5650400.htm"]}]},{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/2021-11/12/content_5650400.htm","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Abrir fuente"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d