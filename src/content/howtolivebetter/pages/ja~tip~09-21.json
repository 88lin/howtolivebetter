en":[]},{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},{"tag":"span","props":{},"children":["ログイン"]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/ja/book/09"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"目次に戻る"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["一般人が陥りやすい法律のレッドライン"]},{"tag":"nav","props":{"aria-label":"この章のヒント"},"children":[{"tag":"a","props":{"href":"/ja/tip/09-01"},"children":[{"tag":"span","props":{},"children":["01"]},"グループ内で、真偽不明の災害、疫病、事件に関する情報を転送しないこと。画像の加工や、AIによる現場画像の捏造を行わないこと"]},{"tag":"a","props":{"href":"/ja/tip/09-02"},"children":[{"tag":"span","props":{},"children":["02"]},"英烈を侮辱する画像、絵文字、コメントを投稿・転送しないこと。国旗や国歌をネタにしないこと。"]},{"tag":"a","props":{"href":"/ja/tip/09-03"},"children":[{"tag":"span","props":{},"children":["03"]},"海外サイトの内容は見た後に閉じるだけ。スクリーンショットも、転送も、グループへの持ち込みも、コメント欄での追随もせず。"]},{"tag":"a","props":{"href":"/ja/tip/09-04"},"children":[{"tag":"span","props":{},"children":["04"]},"アダルト動画は個人で楽しむ分には自由ですが、グループ内に投稿したり、「素材」を販売したり、グループを作成したりしないでください。"]},{"tag":"a","props":{"href":"/ja/tip/09-05"},"children":[{"tag":"span","props":{},"children":["05"]},"「副業」として自分のカードで入金、出金、送金を行うよう指示される案件、どんなに報酬が高くても断ること"]},{"tag":"a","props":{"href":"/ja/tip/09-06"},"children":[{"tag":"span","props":{},"children":["06"]},"「融資書類の偽造」を勧誘し、融資額に応じたキックバックを提示する者がいても、一切応じないこと"]},{"tag":"a","props":{"href":"/ja/tip/09-07"},"children":[{"tag":"span","props":{},"children":["07"]},"拾得銀行カードをそのままにせず、携帯電話や財布を拾った際は持ち去らず、持ち主に連絡するか警察に届ける"]},{"tag":"a","props":{"href":"/ja/tip/09-08"},"children":[{"tag":"span","props":{},"children":["08"]},"特典は自身の真の身分で受け取る。仮想番号による大量のサブアカウント登録や、脆弱性を利用した繰り返し取得は行わない"]},{"tag":"a","props":{"href":"/ja/tip/09-09"},"children":[{"tag":"span","props":{},"children":["09"]},"バルコニーや窓からいかなる物も投げ出さない。吸い殻、ゴミ袋、酒瓶もすべて対象"]},{"tag":"a","props":{"href":"/ja/tip/09-10"},"children":[{"tag":"span","props":{},"children":["10"]},"模造銃、鋼鉄玉銃、エアガンをネットで購入しない、出所不明の「おもちゃの銃」を買わない"]},{"tag":"a","props":{"href":"/ja/tip/09-11"},"children":[{"tag":"span","props":{},"children":["11"]},"ドローンを購入したらまず実名登録を行う。空港、軍事区域、および都市の規制空域では飛行させない。高度制限の解除（ハッキング）は行わない"]},{"tag":"a","props":{"href":"/ja/tip/09-12"},"children":[{"tag":"span","props":{},"children":["12"]},"他人の盗撮をしない。賃貸物件、民泊、ホテルの客室にカメラを設置しない"]},{"tag":"a","props":{"href":"/ja/tip/09-13"},"children":[{"tag":"span","props":{},"children":["13"]},"麻雀やポーカーは可能ですが、手数料を取らない、胴元にならない、場を設けて集金しない、オンラインギャンブルは行わないこと"]},{"tag":"a","props":{"href":"/ja/tip/09-14"},"children":[{"tag":"span","props":{},"children":["14"]},"野生動物を食べない、売買しない、保護動物をペットとして飼育しない"]},{"tag":"a","props":{"href":"/ja/tip/09-15"},"children":[{"tag":"span","props":{},"children":["15"]},"債権回収において、人を拘束したり、監禁したり、相手の自宅まで押しかけて居座ったりしてはいけない"]},{"tag":"a","props":{"href":"/ja/tip/09-16"},"children":[{"tag":"span","props":{},"children":["16"]},"身分証は貸さない、他人の身分証を使わない、他人の身分証で登録・カード作成・チケット購入を行わない"]},{"tag":"a","props":{"href":"/ja/tip/09-17"},"children":[{"tag":"span","props":{},"children":["17"]},"警察に止められたり連行されたりした際は協力すること。押し返さない、殴らない、执法記録カメラを奪わない。飲酒している時はなおさら自制が必要。"]},{"tag":"a","props":{"href":"/ja/tip/09-18"},"children":[{"tag":"span","props":{},"children":["18"]},"相手が 14 歳未満の場合、性交渉は成立しません。「本人の同意」は理由になりません"]},{"tag":"a","props":{"href":"/ja/tip/09-19"},"children":[{"tag":"span","props":{},"children":["19"]},"手を出して人を殴る前に、この代償を計算しておくこと：拘留、賠償、刑罰"]},{"tag":"a","props":{"href":"/ja/tip/09-20"},"children":[{"tag":"span","props":{},"children":["20"]},"子供を育てられない場合、民政局への登録という唯一の合法的な道があります：金銭を受け取って子供を渡すと人身売買罪に問われる可能性があり、放置すれば遺棄罪になります"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/ja/tip/09-21","data-status":"active"},"children":[{"tag":"span","props":{},"children":["21"]},"事故を捏造せず、損失を誇張して保険金を騙し取らないこと：これは保険詐欺罪です。証言、修理、鑑定を手伝った人も共犯となります"]},{"tag":"a","props":{"href":"/ja/tip/09-22"},"children":[{"tag":"span","props":{},"children":["22"]},"自分の臓器を売らない、他人のドナー探しを手伝わない：腎臓が手元に残るのは 2 万強、同じものが転売されると 20 万、売得金は没収され、さらに取引額の 10 倍から 20 倍の罰金が科される"]},{"tag":"a","props":{"href":"/ja/tip/09-23"},"children":[{"tag":"span","props":{},"children":["23"]},"売春をしない：標準的な罰則は 10 日から 15 日の拘留であり、単なる罰金では済みません"]},{"tag":"a","props":{"href":"/ja/tip/09-24"},"children":[{"tag":"span","props":{},"children":["24"]},"漫画の中国語化、映画・ドラマの無断転載、クラウドストレージ資源の共有、海賊版電子書籍の配布は、無償であっても著作権侵害。広告掲載や会員費の徴収があれば、刑事罰の対象となる可能性あり"]},{"tag":"a","props":{"href":"/ja/tip/09-25"},"children":[{"tag":"span","props":{},"children":["25"]},"二次創作を出版・販売する場合は、まず原作者の許諾を得るか、借りたキャラクター名や関係性を自分のものに書き換える"]},{"tag":"a","props":{"href":"/ja/tip/09-26"},"children":[{"tag":"span","props":{},"children":["26"]},"護身のため伸縮警棒、電撃器、短剣、催涙スプレーを買って携帯しない。車内に置くのも携帯に当たる"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"現在地"},"children":[{"tag":"a","props":{"href":"/ja/book"},"children":["本を読む"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/ja/book/09"},"children":["第9章"," ·"," ","一般人が陥りやすい法律のレッドライン"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"09-21"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["21"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["エビデンス"," ","A"]}]},{"tag":"h1","props":{"lang":"ja"},"children":["事故を捏造せず、損失を誇張して保険金を騙し取らないこと：これは保険詐欺罪です。証言、修理、鑑定を手伝った人も共犯となります"]},{"tag":"p","props":{"lang":"ja","className":"life-entry-summary"},"children":["事故を捏造し、損失を誇張して保険金を騙し取る行為は保険詐欺罪にあたります。金額が大きい場合は 5 年以下の懲役、および 1 万から 10 万元の罰金が科されます。証言、鑑定、財産評価を手伝った者が故意に虚偽の証明を行った場合、あなたと共に共犯として処罰されます。安徽省宣城市の事例では、8 人が 2 から 4 年の懲役、およびそれぞれ 1 万元の罰金に処されました。"]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["費用・手間"]},{"tag":"p","props":{},"children":["費用も時間もかかりません。ただ、行わないことです。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["効果"]},{"tag":"p","props":{},"children":["刑法第198条は、5つの状況を列挙している。（1）保険契約者が故意に保険の目的を捏造し、根本的に存在しない被保険対象をでっち上げること。"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"記録する：事故を捏造せず、損失を誇張して保険金を騙し取らないこと：これは保険詐欺罪です。証言、修理、鑑定を手伝った人も共犯となります"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"できている"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"やることに追加"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"お気に入り"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"このヒントを共有"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"詳細を閉じる"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["費用・手間"]},{"tag":"p","props":{},"children":["費用も時間もかかりません。ただ、行わないことです。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["効果"]},{"tag":"p","props":{},"children":["刑法第198条は、5つの状況を列挙している。（1）保険契約者が故意に保険の目的を捏造し、根本的に存在しない被保険対象をでっち上げること。（2）保険契約者、被保険者、または受益者が、発生した保険事故について虚偽の原因を捏造、あるいは損失の程度を誇張すること。（3）発生していない保険事故を捏造すること。（4）保険契約者または被保険者が、故意に財産損失を伴う保険事故を引き起こすこと。（5）保険契約者または受益者が、故意に被保険者の死亡、障害、または疾病を引き起こすこと。金額が多額な場合は、5年以下の有期懲役または拘留に処し、あわせて1万元以上10万元以下の罰金を科す。金額が巨額であるか、その他重大な情状がある場合は、5年から10年の懲役、および2万元から20万元の罰金を科す。金額が極めて多額であるか、その他特別に重大な情状がある場合は、10 年以上の懲役、および2 万から20 万元の罰金、または財産の没収に処す。本条の末尾は、幇助者（保険事故の鑑定人、証人、財産評価人）を対象としている。彼らが故意に虚偽の証明書類を作成し、他者の保険金詐欺の条件を整えた場合は、保険詐欺の共犯として取り扱われ、詐欺を行った者と共に罪に問われる。保険法第27条：保険事故が発生していないにもかかわらず、発生したと虚偽の申告をした場合、保険会社は契約を解除する権利を有し、かつ保険料は返還されない。偽造・変造された証明資料を用いた場合、または虚偽の事故原因を捏造し、損失の程度を誇張した場合には、保険会社は過剰に申告された部分については支払わず、既に支払済みのものについては返還または賠償を求めるものとする。事例：安徽省宣城市の張某松事件において、王某信ら 8 人は保険詐欺罪により、それぞれ 4 年から 2 年の有期懲役、および 1 万元の罰金に処せられた。この事件から発覚した虚偽訴訟では、保険会社が算定した損失額は 2 万元であった。当事者は車両譲渡契約書の偽造によって訴訟提起の資格を得て裁判を行ったが、裁判所は 7 万余元の賠償を命じた。既に確定していたこの民事判決は、2019 年 9 月 26 日に再審により取り消された。「保険詐欺防止工作方法」は、保険の販売と保険金の支払い（引き受け側と支払い側の両面）において、リスク情報を検証することを求めている。また、多種多様な保険種別に対応した業界の不正防止情報プラットフォームや、不正防止インテリジェンスセンターの構築を模索することも求めている。これらのプラットフォームは、詐欺の疑いがあるデータを集中してスクリーニングし、その手がかりを業界団体、不正防止組織、および保険機関に提供して調査を行います。犯罪の疑いがある場合は、速やかに公安機関に通報します。国家金融監督管理総局およびその派出機関は、公安機関、人民検察院、人民法院との間で、行政執行と刑事司法の連携メカニズムを確立・整備しなければなりません（全国、2024 年 7 月 31 日発行）"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["出典"]},{"tag":"p","props":{"className":"life-citations"},"children":["全国人大常委会. 中华人民共和国刑法（经刑法修正案十一修正的整合文本）第一百九十八条. ",{"tag":"a","props":{"href":"https://flk.npc.gov.cn/detail?id=ff808181796a636a0179822a19640c92","target":"_blank","rel":"noopener noreferrer"},"children":["https://flk.npc.gov.cn/detail?id=ff808181796a636a0179822a19640c92"]},"；全国人大常委会 (2015 修正). 中华人民共和国保险法第二十七条. ",{"tag":"a","props":{"href":"https://flk.npc.gov.cn/detail?id=2c909fdd678bf17901678bf7c4060811","target":"_blank","rel":"noopener noreferrer"},"children":["https://flk.npc.gov.cn/detail?id=2c909fdd678bf17901678bf7c4060811"]},"；国家金融监督管理总局 (2024). 关于印发《反保险欺诈工作办法》的通知. ",{"tag":"a","props":{"href":"https://www.gov.cn/gongbao/2024/issue_11586/202409/content_6975080.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/gongbao/2024/issue_11586/202409/content_6975080.html"]},"；安徽省人民检察院转载《法制日报》(2020-01-13). 杀妻骗保牵出案中案. ",{"tag":"a","props":{"href":"http://www.ah.jcy.gov.cn/jczt/jjslhyqkjc/mtjj/202001/t20200113_2758841.shtml","target":"_blank","rel":"noopener noreferrer"},"children":["http://www.ah.jcy.gov.cn/jczt/jjslhyqkjc/mtjj/202001/t20200113_2758841.shtml"]}]},{"tag":"a","props":{"href":"https://flk.npc.gov.cn/detail?id=ff808181796a636a0179822a19640c92","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["出典を開く"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["著者の注記"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["以下に挙げる「無害だと思い込んでいる行為」は、すべてこれら5つの項目に含まれます。軽微な事故の際、修理工場に「少し多めに請求」させる、過去の傷や損傷を今回の事故に含める、友人と故意に衝突させてから事故報告をする、事故が起きていないのに捏造する、など。自動車保険の適切な買い方は、第 5 節第 26 条（対人・対物賠償保険を十分に確保）を参照してください。家族に保険をかけた後、故意にその家族を死亡させた場合は、法律により併合罪として処罰されることが明記されています。第 8 節第 38 条（家族への保険加入）を参照してください。医療保険は別のルールが適用されます。医療保険カードの不正利用や、医療保険の個人口座の現金化は詐欺として扱われます。第 5 節第 13 条の注釈を参照してください。"]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["自分のメモ"]},{"tag":"button","props":{"type":"button"},"children":["自分へのメモを書く…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/ja/tip/09-20"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["前へ"]},"子供を育てられない場合、民政局への登録という唯一の合法的な道があります：金銭を受け取って子供を渡すと人身売買罪に問われる可能性があり、放置すれば遺棄罪になります"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/ja/tip/09-22"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["次へ"]},"自分の臓器を売らない、他人のドナー探しを手伝わない：腎臓が手元に残るのは 2 万強、同じものが転売されると 20 万、売得金は没収され、さらに取引額の 10 倍から 20 倍の罰金が科される"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"