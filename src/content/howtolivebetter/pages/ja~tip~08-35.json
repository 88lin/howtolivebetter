"d":"m19.07 4.93-1.41 1.41"},"children":[]}]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"17","height":"17","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-moon life-theme-icon-dark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"},"children":[]}]}]},{"tag":"button","props":{"type":"button","className":"life-language-switch","aria-label":"日本語 言語を選ぶ","aria-haspopup":"menu","aria-expanded":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-globe","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]},{"tag":"path","props":{"d":"M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"},"children":[]},{"tag":"path","props":{"d":"M2 12h20"},"children":[]}]},{"tag":"span","props":{},"children":["日本語"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]}]},{"tag":"a","props":{"className":"life-account","href":"/ja/sign-in"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"17","height":"17","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle-user-round","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M18 20a6 6 0 0 0-12 0"},"children":[]},{"tag":"circle","props":{"cx":"12","cy":"10","r":"4"},"children":[]},{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},{"tag":"span","props":{},"children":["ログイン"]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/ja/book/08"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"目次に戻る"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["自分を犠牲にしないために：法律と財産の安全を守る"]},{"tag":"nav","props":{"aria-label":"この章のヒント"},"children":[{"tag":"a","props":{"href":"/ja/tip/08-01"},"children":[{"tag":"span","props":{},"children":["01"]},"交通事故に遭ったら、まずは停車、救護、通報。逃走してはいけない"]},{"tag":"a","props":{"href":"/ja/tip/08-02"},"children":[{"tag":"span","props":{},"children":["02"]},"詐欺に気づいたら、すぐに 110 または 96110 に電話して支払停止を依頼すること。自分で調べるのは後回しに"]},{"tag":"a","props":{"href":"/ja/tip/08-03"},"children":[{"tag":"span","props":{},"children":["03"]},"詐欺防止の鉄則を覚えよう：電話を鵜呑みにしない、情報を明かさない、リンクをクリックしない、送金は必ず確認する。最も一般的な7つの詐欺はこのパターンです"]},{"tag":"a","props":{"href":"/ja/tip/08-04"},"children":[{"tag":"span","props":{},"children":["04"]},"ビデオで顔を見ること、電話で声を聞くことは「本人確認」とはみなさない。送金が絡む場合は一旦電話を切り、自分の連絡先に登録されている古い番号にかけ直すこと"]},{"tag":"a","props":{"href":"/ja/tip/08-05"},"children":[{"tag":"span","props":{},"children":["05"]},"容疑をかけられた、または召喚された場合は、まず弁護士を依頼すること。示談はせず、記録を削除しないこと"]},{"tag":"a","props":{"href":"/ja/tip/08-06"},"children":[{"tag":"span","props":{},"children":["06"]},"問題が起きたら自ら説明しに行く：自首すれば刑期を最大4割減刑できる可能性があり、軽い犯罪ならさらに減刑や免罰もあり得る。「公訴時効を逃れる」という道は閉ざされている"]},{"tag":"a","props":{"href":"/ja/tip/08-07"},"children":[{"tag":"span","props":{},"children":["07"]},"飲酒した後はハンドルに触れない。電気自動車や「少しだけ動かす」場合も含む"]},{"tag":"a","props":{"href":"/ja/tip/08-08"},"children":[{"tag":"span","props":{},"children":["08"]},"銀行カード、SIMカード、決済アカウントを他人に貸さない。「資金洗浄（跑分）」は副業ではない"]},{"tag":"a","props":{"href":"/ja/tip/08-09"},"children":[{"tag":"span","props":{},"children":["09"]},"年に2回、無料で自分の信用報告書をチェックし、身に覚えのないローンやカードがないか確認する"]},{"tag":"a","props":{"href":"/ja/tip/08-10"},"children":[{"tag":"span","props":{},"children":["10"]},"衝突が起きたら、手を出さずにまず通報すること。先に手を出した側が、ほぼ確実に損をする"]},{"tag":"a","props":{"href":"/ja/tip/08-11"},"children":[{"tag":"span","props":{},"children":["11"]},"避けられない侵害に対しては反撃可能だが、現在手を出し続けている人物に対してのみ行うこと。相手が止まれば、あなたも止めること"]},{"tag":"a","props":{"href":"/ja/tip/08-12"},"children":[{"tag":"span","props":{},"children":["12"]},"誰と恨みができたとしても（賃金未払い、解雇、金銭トラブルなど）―― 復讐ではなく、苦情申し立て、仲裁、訴訟の手続きを踏むこと"]},{"tag":"a","props":{"href":"/ja/tip/08-13"},"children":[{"tag":"span","props":{},"children":["13"]},"どれほど恨みがあっても無関係な人には手を出さない：車で群衆に突っ込む行為や公共の場での凶行は「危険な方法による公共の安全への危害罪」となり、刑期は3年から。死者が出れば10年以上、最高で死刑"]},{"tag":"a","props":{"href":"/ja/tip/08-14"},"children":[{"tag":"span","props":{},"children":["14"]},"「道連れにしてやる」「共倒れになってやる」といった考えが浮かんだら、緊急事態として対処：その場を離れ、車の鍵や刃物を他人に預け、12356 に電話する"]},{"tag":"a","props":{"href":"/ja/tip/08-15"},"children":[{"tag":"span","props":{},"children":["15"]},"周囲の人が「誰も幸せになれないようにしてやる」「子供を連れて逃げる」と言い出した時、感情的な言葉だと思わないで：近親者は直接受診させることができ、警察は通報を受けたら必ず対応しなければなりません"]},{"tag":"a","props":{"href":"/ja/tip/08-16"},"children":[{"tag":"span","props":{},"children":["16"]},"ネット上では誹謗中傷やデマ、未確認情報の拡散をしないこと。ネットリンチを受けた際は、まず証拠を残してから警察へ通報すること"]},{"tag":"a","props":{"href":"/ja/tip/08-17"},"children":[{"tag":"span","props":{},"children":["17"]},"署名前に書類を最後まで読み、代理署名はせず、白紙には署名しない"]},{"tag":"a","props":{"href":"/ja/tip/08-18"},"children":[{"tag":"span","props":{},"children":["18"]},"借金の際は借用書を明記すること。他人への保証人になる前には、代わりに返済する意思があるかよく考えること"]},{"tag":"a","props":{"href":"/ja/tip/08-19"},"children":[{"tag":"span","props":{},"children":["19"]},"権利保護には期限があります：民事訴訟時効は 3 年、労働仲裁は 1 年、期限を過ぎると相手の「時効超過」の一言で十分です"]},{"tag":"a","props":{"href":"/ja/tip/08-20"},"children":[{"tag":"span","props":{},"children":["20"]},"提訴された、強制執行された場合は、財産を正直に報告し、支払える分だけ支払うこと。不動産や現金を親族や会社に移してはいけません"]},{"tag":"a","props":{"href":"/ja/tip/08-21"},"children":[{"tag":"span","props":{},"children":["21"]},"消費制限または失信リストへの掲載を受けた場合は、まずどの条項に基づいて掲載されたのかを確認し、訂正可能な場合は訂正を申請すること"]},{"tag":"a","props":{"href":"/ja/tip/08-22"},"children":[{"tag":"span","props":{},"children":["22"]},"ネットショッピングや中古取引で詐欺に遭ったら、まずはプラットフォームへ通報、次に警察へ通報、その上で訴訟を起こす価値があるかを検討"]},{"tag":"a","props":{"href":"/ja/tip/08-23"},"children":[{"tag":"span","props":{},"children":["23"]},"恋愛および婚姻における高額な贈与は、交付する前に慎重に検討を。交付後は原則として取り消せません"]},{"tag":"a","props":{"href":"/ja/tip/08-24"},"children":[{"tag":"span","props":{},"children":["24"]},"結納金は振込で行い、用途を明記し、チャット履歴を保存すること。結婚を口実とした金銭要求は返還請求が可能"]},{"tag":"a","props":{"href":"/ja/tip/08-25"},"children":[{"tag":"span","props":{},"children":["25"]},"婚前財産を恐れる必要はありません。不動産の名義追加や親の出資は事前に明確に書き留めておくこと"]},{"tag":"a","props":{"href":"/ja/tip/08-26"},"children":[{"tag":"span","props":{},"children":["26"]},"結婚前に相手の婚姻状況を確認すること。結婚を口実にお金を騙し取る行為は詐欺罪として追及されます"]},{"tag":"a","props":{"href":"/ja/tip/08-27"},"children":[{"tag":"span","props":{},"children":["27"]},"出張修理、車両点検、リフォームなどは、作業前に必ず価格を確認し、全工程を傍らで見守ること"]},{"tag":"a","props":{"href":"/ja/tip/08-28"},"children":[{"tag":"span","props":{},"children":["28"]},"「名義上の代表者」にならないこと。会社設立のために身分証を他人に貸さないこと"]},{"tag":"a","props":{"href":"/ja/tip/08-29"},"children":[{"tag":"span","props":{},"children":["29"]},"出入国時に見知らぬ人の荷物を預からないこと。出所不明の小包を代理受領しないこと"]},{"tag":"a","props":{"href":"/ja/tip/08-30"},"children":[{"tag":"span","props":{},"children":["30"]},"中国で犬を飼うなら必ずリードを使う。未装着の事故は無過失責任で賠償する。狂犬病ワクチンと飼育登録も忘れない"]},{"tag":"a","props":{"href":"/ja/tip/08-31"},"children":[{"tag":"span","props":{},"children":["31"]},"相手が意識不明、睡眠中、または 14 歳未満である可能性がある場合は、性交渉を行わないこと"]},{"tag":"a","props":{"href":"/ja/tip/08-32"},"children":[{"tag":"span","props":{},"children":["32"]},"性交渉やビデオチャットの後、相手が通報、写真の拡散、勤務先への連絡を盾に金銭を要求してきた場合、一銭も払わず、記録も削除せず、直ちに警察へ通報すること"]},{"tag":"a","props":{"href":"/ja/tip/08-33"},"children":[{"tag":"span","props":{},"children":["33"]},"事実を捏造して通報された場合、以下の追及が可能です：治安行政処分に該当する場合は 5 日からの拘留、犯罪に該当する場合は 3 年以下の懲役"]},{"tag":"a","props":{"href":"/ja/tip/08-34"},"children":[{"tag":"span","props":{},"children":["34"]},"証拠不十分であれば本来無罪とされるべきであり、強要された自白は排除されるべきである。判決後には上訴や再審の道がある"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/ja/tip/08-35","data-status":"active"},"children":[{"tag":"span","props":{},"children":["35"]},"勾留後に不起訴、不起訴処分または無罪判決を受けた場合、国家賠償を申請できます。賠償額は日割り計算されます"]},{"tag":"a","props":{"href":"/ja/tip/08-36"},"children":[{"tag":"span","props":{},"children":["36"]},"被害者として賠償を請求する場合、12315、訴訟、または弁護士を通じて行い、相手と二人きりで会う約束をしないこと。「金を払えば、公表しない」という言い方をセットにしないこと"]},{"tag":"a","props":{"href":"/ja/tip/08-37"},"children":[{"tag":"span","props":{},"children":["37"]},"ネット炎上（ネットいじめ）に遭ったら：まずは防御設定、証拠保全、そしてプラットフォームへの通報・禁止命令・警察への通報の3つの道から選択"]},{"tag":"a","props":{"href":"/ja/tip/08-38"},"children":[{"tag":"span","props":{},"children":["38"]},"「保険をかけてから手を下す」という道は、法律上最初から完全に塞がれています：金銭は一切受け取れず、罪は殺人罪と保険詐欺罪の併合罪として処罰されます"]},{"tag":"a","props":{"href":"/ja/tip/08-39"},"children":[{"tag":"span","props":{},"children":["39"]},"警察への通報時はその場で受理票を受け取ること、不立案（事件化しない）の場合は書面での通知が必要：7 日以内に再審査を申請でき、さらに 7 日以内に再審査請求が可能。検察庁は警察に立案を通知できます"]},{"tag":"a","props":{"href":"/ja/tip/08-40"},"children":[{"tag":"span","props":{},"children":["40"]},"捜査・執行官への金銭やカードの贈賄は避けること：贈賄側も処罰の対象となり、監察・執行・司法関係者への贈賄はより重い刑が科される"]},{"tag":"a","props":{"href":"/ja/tip/08-41"},"children":[{"tag":"span","props":{},"children":["41"]},"トラブルに発展しそうな電話や面談は、直接録音する：自分が参加している会話なら、相手の事前の同意は不要"]},{"tag":"a","props":{"href":"/ja/tip/08-42"},"children":[{"tag":"span","props":{},"children":["42"]},"現場で事故が起きたら、まず全景、次に位置関係、最後に損傷と怪我の状況を撮影すること。元の写真や動画は削除しないでください"]},{"tag":"a","props":{"href":"/ja/tip/08-43"},"children":[{"tag":"span","props":{},"children":["43"]},"ドメスティック・バイオレンス（DV）を受けた時：まずは警察に通報して出動記録を残し、その後に裁判所へ人身安全保護命令を申請しましょう。離婚を先に済ませる必要はなく、費用もかかりません"]},{"tag":"a","props":{"href":"/ja/tip/08-44"},"children":[{"tag":"span","props":{},"children":["44"]},"家族がギャンブルで借金を作った場合、すぐに肩代わりして返済しないでください：ギャンブルの借金は法律で保護されず、ギャンブルのために借りたお金も夫婦の共同債務とはみなされません"]},{"tag":"a","props":{"href":"/ja/tip/08-45"},"children":[{"tag":"span","props":{},"children":["45"]},"知人から「顔認証の協力や証人になってほしい」と融資の手伝いを頼まれたら、決して応じてはいけない：これは「ABローン」と呼ばれ、借り手はあなたであり、保証人ではありません"]},{"tag":"a","props":{"href":"/ja/tip/08-46"},"children":[{"tag":"span","props":{},"children":["46"]},"ドアと窓に錠を付け、玄関外にセンサーライトを設置し、外出時は必ず施錠する。侵入窃盗の予防はこの組み合わせで、警報器だけの効果は認められない"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"現在地"},"children":[{"tag":"a","props":{"href":"/ja/book"},"children":["本を読む"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/ja/book/08"},"children":["第8章"," ·"," ","自分を犠牲にしないために：法律と財産の安全を守る"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"08-35"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["35"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["エビデンス"," ","A"]}]},{"tag":"h1","props":{"lang":"ja"},"children":["勾留後に不起訴、不起訴処分または無罪判決を受けた場合、国家賠償を申請できます。賠償額は日割り計算されます"]},{"tag":"p","props":{"lang":"ja","className":"life-entry-summary"},"children":["拘留または逮捕された後、不起訴、不起訴処分、あるいは無罪判決を受けた場合、国家賠償を申請することが可能です。拘束された日数は日割りで賠償され、2026 年 5 月 18 日から毎日 495.94 元、1年間で約 18 万元となります。重大な結果が生じた場合は、別途、精神的苦痛に対する慰謝料が支払われます。事案が軽微であるために不起訴となった場合は、賠償の対象外です。時効が経過している場合、年齢に達していない場合、または虚偽の供述を行った場合も賠償は受けられません。"]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["費用・手間"]},{"tag":"p","props":{},"children":["費用はかかりません。当初の拘留、逮捕、起訴、または判決を下した機関に対して賠償申請を行います。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["効果"]},{"tag":"p","props":{},"children":["《国家賠償法》第17条には、被害者が賠償を受ける権利を有するいくつかの状況が列挙されています。"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"記録する：勾留後に不起訴、不起訴処分または無罪判決を受けた場合、国家賠償を申請できます。賠償額は日割り計算されます"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"できている"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"やることに追加"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"お気に入り"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"このヒントを共有"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"詳細を閉じる"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["費用・手間"]},{"tag":"p","props":{},"children":["費用はかかりません。当初の拘留、逮捕、起訴、または判決を下した機関に対して賠償申請を行います。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["効果"]},{"tag":"p","props":{},"children":["《国家賠償法》第17条には、被害者が賠償を受ける権利を有するいくつかの状況が列挙されています。第一は拘留です。刑事訴訟法の規定に違反して市民に対して拘留措置をとった場合、または法的な期限を超えて拘留した場合です。その後、案件の取り消し、不起訴、または無罪判決によって刑事責任の追及が終了する場合を指します。第二は逮捕です。市民に対して逮捕措置をとった後、案件の取り消し、不起訴、または無罪判決によって刑事責任の追及が終了する場合を指します。第三は再審です。審判監督手続に基づき再審によって無罪へと判決が変更され、かつ元の刑が既に執行されている場合です。審判監督手続とは、既に効力が確定した判決を改めて審理する手続のことです。第三十三条：市民の身体の自由を侵害した場合、1日あたりの賠償金は、前年度の国家の従業員日平均賃金に基づいて計算されます。第三十五条：他人の精神的苦痛を招いた場合、不法行為の影響の範囲内で、被害者の影響を排除し、名誉を回復し、謝罪しなければならない。重大な結果が生じた場合には、相応の慰謝料を支払わなければならない。第十九条には、国が賠償を行わない6つの事例が列挙されている。第一に、自ら故意に虚偽の供述を行ったり、その他の有罪証拠を捏造したりしたことにより、拘禁または刑に処せられた場合。第二に、刑法第十七条および第 عشر条に基づき刑事責任を負わない者が拘禁された場合。例えば、刑事責任を負う年齢に達していない場合や、精神障害者が自身の行為を認識または制御できない状態で危害を加えた場合などである。第三に、刑事訴訟法の規定に基づき刑事責任を追及されない者が拘禁された場合。これには、情状が著しく軽微で危害が大きくなく、犯罪とはみなされない場合、公訴時効が経過した場合、および被疑者が死亡した場合が含まれる。犯罪情状が軽微で、検察庁が不起訴処分を下したケース、いわゆる相対的不起訴（裁量不起訴とも呼ばれる）も含まれます。未成年者の条件付き不起訴の試用期間が終了して不起訴となった場合や、被害者との示談成立により不起訴となった場合も同様に含まれます。四、捜査担当者の職務とは無関係な個人的行為。五、自傷、自傷行為などの故意による損害。六、法律に定められたその他の状況。最高人民法院および最高人民検察院による 2015 年の刑事賠償に関する司法解釈第七条では、刑事責任を負わない者および相対的不起訴となった者が拘禁された場合、国は賠償しないことが改めて確認されています。ただし、起訴後に裁判所によって誤って拘役、有期懲役、または無期懲役に判決され、既に執行された場合、判決確定後に継続して拘禁された期間については、引き続き賠償の対象となります。この解釈の第八条：捜査機関が「虚偽の供述をした」「自傷・自残した」という理由で賠償を拒否する場合、捜査機関がその証拠を提示しなければならない。最高人民検察院は 2026 年 5 月に通知を発した。国家統計局は 2026 年 5 月 15 日、2025 年の全国の非私営都市単位の雇用者の年平均賃金は約 12.9 万元（129441 元）であると発表した。これに基づき算出された日平均賃金は 495.94 元である。各級検察院は 2026 年 5 月 18 日以降、公民の身体の自由を侵害したことに対する賠償金を、1日あたり 495.94 元として計算する。前回の基準は1日あたり 475.52 元であり、2025 年 5 月から（全国で）適用されている。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["出典"]},{"tag":"p","props":{"className":"life-citations"},"children":["全国人大常委会 (2012 年修正). 国家赔偿法（第十七、十九、三十三、三十五条）. ",{"tag":"a","props":{"href":"https://www.stats.gov.cn/gk/tjfg/xgfxfg/202503/t20250306_1958899.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.stats.gov.cn/gk/tjfg/xgfxfg/202503/t20250306_1958899.html"]},"（国家统计局转载）；最高人民检察院 (2026). 最高人民检察院公布最新侵犯公民人身自由的赔偿金标准. ",{"tag":"a","props":{"href":"https://www.spp.gov.cn/xwfbh/wsfbh/202605/t20260519_727675.shtml","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.spp.gov.cn/xwfbh/wsfbh/202605/t20260519_727675.shtml"]},"；最高人民法院、最高人民检察院 (2015). 关于办理刑事赔偿案件适用法律若干问题的解释（法释〔2015〕24 号，第七、八条）. ",{"tag":"a","props":{"href":"https://www.court.gov.cn/zixun/xiangqing/16409.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.court.gov.cn/zixun/xiangqing/16409.html"]},"；全国人大 (2018). 刑事诉讼法（2018 年修正，第十六、一百七十七、一百八十一、二百八十四、二百九十条）. ",{"tag":"a","props":{"href":"https://www.spp.gov.cn/zdgz/201810/t20181027_396818.shtml","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.spp.gov.cn/zdgz/201810/t20181027_396818.shtml"]},"。国家赔偿法第十九条和该解释引的是 2012 年刑事诉讼法条号（第十五条、第一百七十三条第二款、第二百七十三条第二款、第二百七十九条），2018 年修正后依次对应第十六条、第一百七十七条第二款、第二百八十四条第二款、第二百九十条"]},{"tag":"a","props":{"href":"https://www.stats.gov.cn/gk/tjfg/xgfxfg/202503/t20250306_1958899.html","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["出典を開く"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["著者の注記"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["この日割り計算の基準は、毎年 5 月に国家統計局が発表する前年度の非私営都市単位の年平均賃金に基づいて更新されます。使用する際は、直接この条項を当てはめるのではなく、その年の数字を確認してください。不起訴決定書を受け取ったら、まずそこに記載されている根拠を確認してください。「犯罪事実なし」または「証拠不十分」と記載されている場合は、賠償を申請できます。「犯罪情节が軽微」と記載されている場合、または公訴時効が経過している場合は、原則として拘禁期間に対する賠償は受けられません。不起訴決定に対して不服がある場合は、決定書を受け取った後 7 日以内に検察院に異議申し立てを行うことができます。精神的苦痛に対する慰謝料は、事案の結末に基づき捜査機関が決定するため、統一された計算式はありません。賠償義務を負うのは、当初の拘禁を決定した機関（公安、検察院、または裁判所）であり、まずはその機関に対して請求を行ってください。その処分に不服がある場合は、国家賠償法の定めに従って上級機関へ申請してください。実際の計算方法については、本節の第 36 条（自身が被害者として賠償を請求する場合）における郭利氏の事件の決定書を参照してください。郭利氏は 1826 日間拘束されました。賠償額は、決定が下された年の基準に基づいて計算され、拘束された年の基準ではありません。2016 年度の全国従業員日平均賃金 258.89 元が適用されました。身体の自由の制限に関する部分は約 47.3 万元（472733.14 元）が支払われ、別途、精神的苦痛に対する慰謝料として約 16.5 万元（165450 元）が支払われました。本人が申請した10年分の精神的慰謝料は 8888 万元でしたが、超過分については認められませんでした。どのような項目が賠償対象外となるかも知っておく必要があります。その決定書では、休業損害、身体的健康に関する賠償、財産的損失、弁護士費用、留置所での生活費補助は、いずれも国家賠償の範囲に含まれないと認定されています。"]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["自分のメモ"]},{"tag":"button","props":{"type":"button"},"children":["自分へのメモを書く…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/ja/tip/08-34"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["前へ"]},"証拠不十分であれば本来無罪とされるべきであり、強要された自白は排除されるべきである。判決後には上訴や再審の道がある"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/ja/tip/08-36"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["次へ"]},"被害者として賠償を請求する場合、12315、訴訟、または弁護士を通じて行い、相手と二人きりで会う約束をしないこと。「金を払えば、公表しない」という言い方をセットにしないこと"]},{"tag":"svg","props":