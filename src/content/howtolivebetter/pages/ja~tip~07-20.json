en":[]},{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},{"tag":"span","props":{},"children":["ログイン"]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/ja/book/07"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"目次に戻る"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["お金がない時をどう生き抜くか"]},{"tag":"nav","props":{"aria-label":"この章のヒント"},"children":[{"tag":"a","props":{"href":"/ja/tip/07-01"},"children":[{"tag":"span","props":{},"children":["01"]},"失業した際は、まずオンラインで失業保険金の申請を"]},{"tag":"a","props":{"href":"/ja/tip/07-02"},"children":[{"tag":"span","props":{},"children":["02"]},"賃金未払いの場合は、まず労働監察へ通報、次に労働仲裁を申請。どちらのルートも費用は無料で、多くの案件は数ヶ月以内に結果が出ます"]},{"tag":"a","props":{"href":"/ja/tip/07-03"},"children":[{"tag":"span","props":{},"children":["03"]},"訴訟費用が払えない場合は法律扶助を申請。賃金請求、扶養料、労災などの案件は、もともと対象範囲に含まれています"]},{"tag":"a","props":{"href":"/ja/tip/07-04"},"children":[{"tag":"span","props":{},"children":["04"]},"行き場を失った時は救助施設へ。食事・宿泊・帰路のチケットを支給"]},{"tag":"a","props":{"href":"/ja/tip/07-05"},"children":[{"tag":"span","props":{},"children":["05"]},"仕事探しはまず無料の公共雇用サービスやギグワーク市場を利用。有料の仲介業者は避ける"]},{"tag":"a","props":{"href":"/ja/tip/07-06"},"children":[{"tag":"span","props":{},"children":["06"]},"不測の事態には、まず臨時救助を申請"]},{"tag":"a","props":{"href":"/ja/tip/07-07"},"children":[{"tag":"span","props":{},"children":["07"]},"収入が地域の最低生活保障基準を下回る場合は、低保（最低生活保障）を申請する"]},{"tag":"a","props":{"href":"/ja/tip/07-08"},"children":[{"tag":"span","props":{},"children":["08"]},"障害者手帳を所持している方は、障害者向け2つの補助金を申請する"]},{"tag":"a","props":{"href":"/ja/tip/07-09"},"children":[{"tag":"span","props":{},"children":["09"]},"住民医療保険の年間 400 元の支払いを中断させないこと。困難世帯は免除・減額が可能"]},{"tag":"a","props":{"href":"/ja/tip/07-10"},"children":[{"tag":"span","props":{},"children":["10"]},"重病になったら、まず医療保険、大病保険、医療扶助、そして他地域での受診登録を行い、ネットローンには手を出さないこと"]},{"tag":"a","props":{"href":"/ja/tip/07-11"},"children":[{"tag":"span","props":{},"children":["11"]},"身分証を紛失したらすぐに再発行手続きを、急ぎの場合は臨時身分証を先に受け取る"]},{"tag":"a","props":{"href":"/ja/tip/07-12"},"children":[{"tag":"span","props":{},"children":["12"]},"失業登録後、就労困難者認定を目指し、社会保険補助金または公益的雇用枠を獲得する"]},{"tag":"a","props":{"href":"/ja/tip/07-13"},"children":[{"tag":"span","props":{},"children":["13"]},"失業期間に職業訓練手当、就業インターン手当、社会保険補助を申請しましょう。自費で講習に通わないでください"]},{"tag":"a","props":{"href":"/ja/tip/07-14"},"children":[{"tag":"span","props":{},"children":["14"]},"就職活動は履歴書を送るだけでは不十分です。システム的な方法を使いましょう：スキルを学び、目標を定め、周囲の助けを借りる"]},{"tag":"a","props":{"href":"/ja/tip/07-15"},"children":[{"tag":"span","props":{},"children":["15"]},"保証金を取られない、身分証を預けない、「訓練ローン」に手を出さない、マルチ商法に入らない、高利貸しから借りない"]},{"tag":"a","props":{"href":"/ja/tip/07-16"},"children":[{"tag":"span","props":{},"children":["16"]},"住居に困っているなら、公営賃貸住宅（公租房）の優先枠を"]},{"tag":"a","props":{"href":"/ja/tip/07-17"},"children":[{"tag":"span","props":{},"children":["17"]},"住居費と食費を最小限に抑える：シェアハウスの月極利用で日極利用を代替、自炊と食堂利用でデリバリーを代替"]},{"tag":"a","props":{"href":"/ja/tip/07-18"},"children":[{"tag":"span","props":{},"children":["18"]},"社会保険の未加入（断缴）に慌てない：年金は累計で計算、医療保険はルールに従って追加入金"]},{"tag":"a","props":{"href":"/ja/tip/07-19"},"children":[{"tag":"span","props":{},"children":["19"]},"服役、破産、信用ブラックリストへの登録など、法律上はやり直す道があります。まずは手続きを完了させましょう"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/ja/tip/07-20","data-status":"active"},"children":[{"tag":"span","props":{},"children":["20"]},"重病に備え、基本医療保険に加えて1年更新の医療保険または重大疾病保険を検討する際は、「継続保証」の4文字を必ず確認すること"]},{"tag":"a","props":{"href":"/ja/tip/07-21"},"children":[{"tag":"span","props":{},"children":["21"]},"本当に寝る場所がない場合、24 時間だけ利用できる場所はあくまで緊急避難用です。まずは救助所を優先してください"]},{"tag":"a","props":{"href":"/ja/tip/07-22"},"children":[{"tag":"span","props":{},"children":["22"]},"賃金未払いの際は、まず雇い主が誰かを確認すること：無免許の作業場や請負業者（工頭）に対しても労働監察を請求可能、家庭や個人向けの私的な仕事の場合のみ裁判所へ"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"現在地"},"children":[{"tag":"a","props":{"href":"/ja/book"},"children":["本を読む"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/ja/book/07"},"children":["第7章"," ·"," ","お金がない時をどう生き抜くか"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"07-20"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["20"]},{"tag":"span","props":{"className":"life-evidence grade-b"},"children":["エビデンス"," ","B"]}]},{"tag":"h1","props":{"lang":"ja"},"children":["重病に備え、基本医療保険に加えて1年更新の医療保険または重大疾病保険を検討する際は、「継続保証」の4文字を必ず確認すること"]},{"tag":"p","props":{"lang":"ja","className":"life-entry-summary"},"children":["この種の保険は、基本医療保険の自己負担分や、療養中の休業損失を補填するものです。購入前には必ず「継続保証（保证续保）」の4文字を確認してください。この表記がない場合、来年には販売終了や値上げになる可能性があります。健康状態はありのままに告知する必要があり、隠蔽すると支払いが拒否される原因となります。まずは基本医療保険に加入した上で、次にこの保険を検討しましょう。"]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["費用・手間"]},{"tag":"p","props":{},"children":["若年層が1年更新の費用補填型医療保険に加入する場合、年間数百元程度です。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["効果"]},{"tag":"p","props":{},"children":["当局はこれらの製品を2つの種類に分類しています。医療保険は、実際に支払った医療費に基づいて払い戻されます。"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"記録する：重病に備え、基本医療保険に加えて1年更新の医療保険または重大疾病保険を検討する際は、「継続保証」の4文字を必ず確認すること"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"できている"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"やることに追加"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"お気に入り"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"このヒントを共有"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"詳細を閉じる"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["費用・手間"]},{"tag":"p","props":{},"children":["若年層が1年更新の費用補填型医療保険に加入する場合、年間数百元程度です。費用補填型とは、実際に支払った費用に基づいて払い戻されるタイプを指します。重大疾病保険は年間数千元から（著者の概算であり、公式な数字ではありません）。加入前に、自身の健康状態をありのままに告知するため、30分ほど時間を確保しましょう。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["効果"]},{"tag":"p","props":{},"children":["当局はこれらの製品を2つの種類に分類しています。医療保険は、実際に支払った医療費に基づいて払い戻されます。疾病保険は、診断が下りた時点で契約に定められた疾患に該当する場合、あらかじめ定められた金額が直接支払われます。どちらも、公的医療保険の適用後に自己負担となる部分や、休業による損失を補填するものです。保険期間が1年以下で、かつ条項に継続保証の記載がないものは、短期健康保険に分類されます。期間が1年を超えるもの、または継続保証の記載があるものが、長期健康保険となります。「継続保証」とは、契約満了時の更新において、保険会社が元の条項と定められた料率に従って継続して保障しなければならないことを意味します。保険会社は、同一人物に対して、保障機能が同一または類似する費用補填型の医療保険を重複して購入するよう誘導してはなりません。2つの保険に加入していても、同一の費用については一度しか請求できません。重大疾病保険の疾病定義には業界共通の規範があり、28 種類の重度疾病と 3 種類の軽度疾病が含まれます。悪性腫瘍、急性心筋梗塞、脳卒中後遺症が主要な疾患です（全国、2019、2020 年より）"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["出典"]},{"tag":"p","props":{"className":"life-citations"},"children":["银保监会 (2019). 健康保险管理办法（银保监会令 2019 年第 3 号，第二、四、四十一条）. ",{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/2019-12/04/content_5458542.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/zhengce/zhengceku/2019-12/04/content_5458542.htm"]},"；中国保险行业协会、中国医师协会 (2020). 重大疾病保险的疾病定义使用规范（2020 年修订版）答记者问. ",{"tag":"a","props":{"href":"https://www.iachina.cn/art/2020/11/5/art_8616_104705.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.iachina.cn/art/2020/11/5/art_8616_104705.html"]},"；银保监会 (2020). 关于使用《中国人身保险业重大疾病经验发生率表（2020）》有关事项的通知（银保监发〔2020〕51 号）. ",{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/2020-11/06/content_5557791.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/zhengce/zhengceku/2020-11/06/content_5557791.htm"]},"；全国人大常委会 (2015 修正). 中华人民共和国保险法第十六条（如实告知与合同成立二年后不得解除）. ",{"tag":"a","props":{"href":"https://flk.npc.gov.cn/detail?id=2c909fdd678bf17901678bf7c4060811","target":"_blank","rel":"noopener noreferrer"},"children":["https://flk.npc.gov.cn/detail?id=2c909fdd678bf17901678bf7c4060811"]}]},{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/2019-12/04/content_5458542.htm","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["出典を開く"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["著者の注記"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["B級に分類される理由は、公式から定義とルールのみが提示されており、「購入することでいくら節約できるか」という具体的な数字が示されていないためです。「百万医療保険」は販売時の呼称であり、法的には短期健康保険に該当します。約款に「継続保証」の記載がない場合、来年には販売終了や値上げの可能性があるため、購入前に必ず約款内でこの4文字を確認してください。実費精算型の医療保険を2つ契約していても、同一の費用を二重に請求することはできません。重複して購入しないよう注意してください。既往症がある状態での加入や、告知義務違反があった場合は、事故の際に支払いが拒否されます。告知義務には2年間の期限があります。契約成立から2年が経過すれば、保険会社は告知義務違反を理由に契約を解除することはできず、事故の際には保険金が支払われます。ただし、2年以内に故意の不告知が判明した場合、契約解除前に発生した事故については、保険金は支払われず、保険料も返還されません。どの損失を保険でカバーすべきかについては、第 5 節第 39 条（負担しきれない損失）を参照してください。まずは住民基本医療保険（第 9 条）への加入を検討した上で、この条項を検討してください。疾病の定義規範は業界団体が発行し、銀保監会が指導するものであり、政府文書ではありません。"]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["自分のメモ"]},{"tag":"button","props":{"type":"button"},"children":["自分へのメモを書く…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/ja/tip/07-19"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"s