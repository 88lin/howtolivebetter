":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["費用・手間"]},{"tag":"p","props":{},"children":["費用はかかりません。英烈、国旗、国章、国歌に関わる内容については、コメントせず、画像を改変せず、転送もしないことです。難しいのは、グループ内で誰かが冗談に乗っている時に、自分は耐えて一言も発しないことです。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["効果"]},{"tag":"p","props":{},"children":["侮辱、事実の捏造などの方法により、英雄烈士の姓名、肖像、名誉、栄誉を侵害し、公共の利益を損なった場合は、以下の罰則が適用されます。5日から10日の拘留、または1000元から3000元の罰金。英烈の事績や精神を冒涜・否定し、侵略戦争を美化する言論、画像、音声・動画を制作・拡散して公共の秩序を乱した場合も、この区分に該当します。より重大な事案（情节较重）の場合は、10日から15日の拘留に加え、5000元以下の罰金が科されることがあります。「重大な事案（情节严重）」に該当する場合は犯罪となり、3年以下の懲役となります。公共の場で国旗や国章を侮辱した、あるいは国歌の歌詞や曲を改変し、歪曲・誹謗する形で国歌を歌唱したなどの行為で、重大な事案とみなされた場合も、3年以下の懲役となります。公的な事例：肖氏は 499 人が参加する村のWeChatグループに、袁隆平氏を誹謗中傷するメッセージを 2 件投稿したため、6 か月の禁錮刑（禁錮は刑務所への収監は伴わないが、行動が制限される刑罰）を言い渡された。仇氏は、250 万人以上のフォロワーを持つWeiboアカウントで、国境を守る兵士たちの功績を歪曲する内容を 2 件投稿したため、8 か月の禁錮刑と、全国規模のメディアでの公開謝罪を言い渡された（全国規模）"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["出典"]},{"tag":"p","props":{"className":"life-citations"},"children":["全国人大常委会 (2025). 治安管理处罚法（2025 年修订，第三十五条）. ",{"tag":"a","props":{"href":"https://www.spp.gov.cn/spp/fl/202506/t20250627_699863.shtml","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.spp.gov.cn/spp/fl/202506/t20250627_699863.shtml"]},"；全国人大常委会 (2018). 英雄烈士保护法（第二十二、二十六条）. ",{"tag":"a","props":{"href":"https://www.spp.gov.cn/spp/gyssshmhsh/201912/t20191202_440079.shtml","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.spp.gov.cn/spp/gyssshmhsh/201912/t20191202_440079.shtml"]},"；全国人大常委会 (2020). 刑法修正案（十一）（第三十五条，即刑法第二百九十九条之一）. ",{"tag":"a","props":{"href":"https://www.spp.gov.cn/zdgz/202012/t20201227_503682.shtml","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.spp.gov.cn/zdgz/202012/t20201227_503682.shtml"]},"；全国人大 (2020). 刑法（根据刑法修正案（十一）修正，第二百九十九条、第二百九十九条之一）. ",{"tag":"a","props":{"href":"https://jtgl.beijing.gov.cn/jgj/jgxx/flfg/fl/11033925/index.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://jtgl.beijing.gov.cn/jgj/jgxx/flfg/fl/11033925/index.html"]},"；最高人民法院 (2022). 涉英烈权益保护十大典型案例（案例二、案例三）. ",{"tag":"a","props":{"href":"https://www.court.gov.cn/zixun/xiangqing/382301.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.court.gov.cn/zixun/xiangqing/382301.html"]}]},{"tag":"a","props":{"href":"https://www.spp.gov.cn/spp/fl/202506/t20250627_699863.shtml","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["出典を開く"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["著者の注記"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["治安管理処罰法のこの条項は、2025 年の改正時に追加されたものです。それ以前は、このような事案は刑法を適用するか、あるいは検察院が民事公益訴訟を提起するしかありませんでした。数百人が参加するWeChatグループは、裁判所の判断では公開の場とみなされます。"]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["自分のメモ"]},{"tag":"button","props":{"type":"button"},"children":["自分へのメモを書く…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/ja/tip/09-01"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["前へ"]},"グループ内で、真偽不明の災害、疫病、事件に関する情報を転送しないこと。画像の加工や、AIによる現場画像の捏造を行わないこと"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/ja/tip/09-03"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["次へ"]},"海外サイトの内容は見た後に閉じるだけ。スクリーンショットも、転送も、グループへの持ち込みも、コメント欄での追随もせず。"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["このテーマの他の提案"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/09-04"},"children":[{"tag":"strong","props":{},"children":["アダルト動画は個人で楽しむ分には自由ですが、グループ内に投稿したり、「素材」を販売したり、グループを作成したりしないでください。"]},{"tag":"span","props":{},"children":["個人で視聴すること自体は罰則の対象に含まれません。グループ内に一度でも投稿すれば、グループ全体への拡散とみなされ、10日から15日の拘留、…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/09-05"},"children":[{"tag":"strong","props":{},"children":["「副業」として自分のカードで入金、出金、送金を行うよう指示される案件、どんなに報酬が高くても断ること"]},{"tag":"span","props":{},"children":["この種の副業で稼げるのは数百元程度ですが、その代償は前科がつくことです。ある人物は、身分証と 1 枚の銀行カードを持って指定の場所へ行き、…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/09-06"},"children":[{"tag":"strong","props":{},"children":["「融資書類の偽造」を勧誘し、融資額に応じたキックバックを提示する者がいても、一切応じないこと"]},{"tag":"span","props":{},"children":["他人の「融資書類の偽造」を手伝い、手数料を受け取る行為は詐欺罪として扱われます。126人からなるグループが、無職の人を「優良顧客」に仕立て…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/09-07"},"children":[{"tag":"strong","props":{},"children":["拾得銀行カードをそのままにせず、携帯電話や財布を拾った際は持ち去らず、持ち主に連絡するか警察に届ける"]},{"tag":"span","props":{},"children":["拾った物を自分のものとして使い、金額が「相当な額」に達しても返還しない場合、2 年以下の懲役、金額が多額な場合は 2 から 5 年の懲役と…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/09-08"},"children":[{"tag":"strong","props":{},"children":["特典は自身の真の身分で受け取る。仮想番号による大量のサブアカウント登録や、脆弱性を利用した繰り返し取得は行わない"]},{"tag":"span","props":{},"children":["自身の真の身分を用い、一つのアカウントで一度だけクーポンを受け取ることは、処罰の範囲には含まれません。偽ユーザーを大量に登録し、自分で注文…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/09-09"},"children":[{"tag":"strong","props":{},"children":["バルコニーや窓からいかなる物も投げ出さない。吸い殻、ゴミ袋、酒瓶もすべて対象"]},{"tag":"span","props":{},"children":["階下へ物を投げ捨てる行為は、人に当たらない場合でも 5 日の拘留および 1000 元の罰金が科せられ、悪質な場合は 10 日から 15 日…"]}]}]}]},{"tag":"a","props":{"className":"life-text-link","href":"/ja/book/09"},"children":["テーマ全体を読む：一般人が陥りやすい法律のレッドライン"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"15","height":"15","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]}]}]},{"tag":"nav","props":{"className":"life-tabbar","aria-label":"メインナビゲーション"},"children":[{"tag":"a","props":{"className":"","href":"/ja/book"},"children":[{"tag":"s