n":"round","className":"lucide lucide-circle-user-round","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M18 20a6 6 0 0 0-12 0"},"children":[]},{"tag":"circle","props":{"cx":"12","cy":"10","r":"4"},"children":[]},{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},{"tag":"span","props":{},"children":["Đăng nhập để đồng bộ hóa"]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/vi/book/11"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"Quay lại mục lục"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["Vạch đỏ lập trình viên và người làm kỹ thuật dễ vấp"]},{"tag":"nav","props":{"aria-label":"Các mục trong chương"},"children":[{"tag":"a","props":{"href":"/vi/tip/11-01"},"children":[{"tag":"span","props":{},"children":["01"]},"Trước khi làm, hỏi một câu: nhà sản xuất, nền tảng, công ty có báo công an không; bị truy cứu thì tìm luật sư hình sự ngay"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/vi/tip/11-02","data-status":"active"},"children":[{"tag":"span","props":{},"children":["02"]},"Không làm, bán phần mềm gian lận và hỗ trợ game, kể cả hỗ trợ AI «chỉ đọc màn hình, không đụng bộ nhớ»; cũng không bán bản sửa đổi thêm tính năng cho WeChat hay phần mềm tương tự"]},{"tag":"a","props":{"href":"/vi/tip/11-03"},"children":[{"tag":"span","props":{},"children":["03"]},"Không viết và không bán script giành vé, đua đặt hàng, tạo đơn ảo, mò hàng miễn phí, kể cả loại chỉ「tự động bấm nút」"]},{"tag":"a","props":{"href":"/vi/tip/11-04"},"children":[{"tag":"span","props":{},"children":["04"]},"Crawler chỉ lấy trang công khai không cần đăng nhập, không vòng cơ chế chống thu thập, không đụng thông tin cá nhân, dữ liệu đã lấy thì không bán"]},{"tag":"a","props":{"href":"/vi/tip/11-05"},"children":[{"tag":"span","props":{},"children":["05"]},"Không nhận đơn phát triển ứng dụng cờ bạc, lừa đảo, khiêu dâm, không dựng cổng thanh toán cho「khách hàng», không mở khoá tài khoản bị khoá"]},{"tag":"a","props":{"href":"/vi/tip/11-06"},"children":[{"tag":"span","props":{},"children":["06"]},"Rời công ty thì bàn giao xong quyền truy cập tài khoản, không xoá cơ sở dữ liệu, không để lại backdoor, không đổi mật khẩu để khoá hệ thống, dù công ty còn nợ bạn"]},{"tag":"a","props":{"href":"/vi/tip/11-07"},"children":[{"tag":"span","props":{},"children":["07"]},"Rời công ty không mang mã nguồn, danh sách khách hàng, tài liệu kỹ thuật đi, không đăng lên ổ đĩa mạng cá nhân, không dùng lại ở công ty sau"]},{"tag":"a","props":{"href":"/vi/tip/11-08"},"children":[{"tag":"span","props":{},"children":["08"]},"Không chạy chương trình của bạn trên máy tính, máy chủ, camera của người khác, không dùng máy của công ty để đào mỏ"]},{"tag":"a","props":{"href":"/vi/tip/11-09"},"children":[{"tag":"span","props":{},"children":["09"]},"Không có văn bản cho phép thì không thử hệ thống của người khác,「vì thiện ý」và「báo cáo sau đó」đều không phải lý do để thôi tội"]},{"tag":"a","props":{"href":"/vi/tip/11-10"},"children":[{"tag":"span","props":{},"children":["10"]},"Báo lỗ hổng theo quy định, trước khi vá không công bố chi tiết, không đưa công cụ khai thác, không đưa ra nước ngoài"]},{"tag":"a","props":{"href":"/vi/tip/11-11"},"children":[{"tag":"span","props":{},"children":["11"]},"Không bán công cụ vượt tường, không bán tài khoản VPN, không dựng loại nút mạng đó cho người khác"]},{"tag":"a","props":{"href":"/vi/tip/11-12"},"children":[{"tag":"span","props":{},"children":["12"]},"Đã ký thỏa thuận không cạnh tranh, sau khi nghỉ việc công ty không trả bồi thường hằng tháng thì gửi văn bản yêu cầu, đủ 3 tháng không trả thì có thể chấm dứt; vị trí chưa từng tiếp cận bí mật thương mại thì có thể yêu cầu xác nhận điều khoản không có hiệu lực"]},{"tag":"a","props":{"href":"/vi/tip/11-13"},"children":[{"tag":"span","props":{},"children":["13"]},"Mã nguồn viết trong giờ làm việc hoặc bằng nguồn lực công ty thì thuộc công ty, dự án mã nguồn mở của bạn thì tự làm bằng thời gian và thiết bị của bạn, không trộn mã công ty"]},{"tag":"a","props":{"href":"/vi/tip/11-14"},"children":[{"tag":"span","props":{},"children":["14"]},"Làm sản phẩm bằng mã nguồn mở như GPL, thì mở theo yêu cầu của giấy phép hoặc đổi giấy phép, đừng coi là「không ai quản」"]},{"tag":"a","props":{"href":"/vi/tip/11-15"},"children":[{"tag":"span","props":{},"children":["15"]},"Ứng dụng chỉ thu thập thông tin cá nhân cần thiết cho nghiệp vụ, dưới 14 tuổi phải có sự đồng ý của người giám hộ, chính sách bảo mật phải viết rõ"]},{"tag":"a","props":{"href":"/vi/tip/11-16"},"children":[{"tag":"span","props":{},"children":["16"]},"Trước khi website, ứng dụng lên mạng thì làm đăng ký ICP, giữ nhật ký trên 6 tháng theo yêu cầu phân cấp bảo vệ"]},{"tag":"a","props":{"href":"/vi/tip/11-17"},"children":[{"tag":"span","props":{},"children":["17"]},"Trước khi cung cấp dịch vụ AI tạo sinh cho công chúng, phải đánh giá an toàn và đăng ký thuật toán theo quy định, nội dung tạo ra phải gắn nhãn"]},{"tag":"a","props":{"href":"/vi/tip/11-18"},"children":[{"tag":"span","props":{},"children":["18"]},"Không làm, phát hành công cụ tự bỏ qua hoặc chặn quảng cáo của ứng dụng khác; miễn phí, không nối mạng vẫn có thể bị phán cạnh tranh không lành mạnh"]},{"tag":"a","props":{"href":"/vi/tip/11-19"},"children":[{"tag":"span","props":{},"children":["19"]},"Không mở «trạm trung chuyển AI» bán lại giao diện mô hình nước ngoài giá thấp: đã có chủ trạm ở Thượng Hải bị tạm giữ hình sự"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"Breadcrumbs"},"children":[{"tag":"a","props":{"href":"/vi/book"},"children":["Khám phá cuốn sách"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/vi/book/11"},"children":["Chương 11"," ·"," ","Vạch đỏ lập trình viên và người làm kỹ thuật dễ vấp"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"11-02"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["02"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["Bằng chứng"," ","A"]}]},{"tag":"h1","props":{"lang":"vi"},"children":["Không làm, bán phần mềm gian lận và hỗ trợ game, kể cả hỗ trợ AI «chỉ đọc màn hình, không đụng bộ nhớ»; cũng không bán bản sửa đổi thêm tính năng cho WeChat hay phần mềm tương tự"]},{"tag":"p","props":{"lang":"vi","className":"life-entry-summary"},"children":["Bán hack đủ 20 lượt người dùng, hoặc kiếm được 5000 tệ, là đủ phạt tù dưới 3 năm, đặc biệt nghiêm trọng thì phạt tù 3 đến 7 năm. Có người làm hack nhìn xuyên tường và ngắm bắn, 3 tháng bán hơn 8 vạn, bị phạt tù 1 năm hoãn 1 năm, phạt tiền 5000 tệ. Có người dùng chương trình phía máy chủ để mở server riêng, thu hơn 2000 vạn tệ tiền nạp, nặng nhất phạt tù 4 năm, tiền phạt tối đa 1000 vạn tệ."]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Chi phí"]},{"tag":"p","props":{},"children":["Không tốn tiền. Cái giá phải trả là bỏ các đơn thuộc loại…"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Lợi ích"]},{"tag":"p","props":{},"children":["Cung cấp chương trình, công cụ chuyên dùng xâm nhập hoặc kiểm soát trái phép hệ thống thông tin máy tính, trườ…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"Đánh dấu: Không làm, bán phần mềm gian lận và hỗ trợ game, kể cả hỗ trợ AI «chỉ đọc màn hình, không đụng bộ nhớ»; cũng không bán bản sửa đổi thêm tính năng cho WeChat hay phần mềm tương tự"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"Hoàn tất"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"Kế hoạch thực hiện"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"Lưu"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Chia sẻ mẹo này"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Ẩn chi tiết"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Chi phí"]},{"tag":"p","props":{},"children":["Không tốn tiền. Cái giá phải trả là bỏ các đơn thuộc loại đó cùng thu nhập từ「tiện ích nhỏ」. Chỗ khó là số tiền đó đến nhanh, lại không thấy ai sẽ truy cứu"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Lợi ích"]},{"tag":"p","props":{},"children":["Cung cấp chương trình, công cụ chuyên dùng xâm nhập hoặc kiểm soát trái phép hệ thống thông tin máy tính, trường hợp nghiêm trọng bị đến 3 năm tù, kèm phạt tiền hoặc chỉ phạt tiền. Kèm nghĩa là vừa tù vừa tiền; chỉ phạt là chỉ tiền. Đặc biệt nghiêm trọng bị 3 đến 7 năm và phạt tiền. Ngưỡng «nghiêm trọng» là cung cấp công cụ từ 20 lượt người hoặc thu lợi bất hợp pháp từ 5000 nhân dân tệ. Thu lợi bất hợp pháp là tiền kiếm từ việc ấy. Cố ý vượt hoặc phá biện pháp bảo vệ kỹ thuật của chủ quyền còn có thể phạm tội xâm phạm quyền tác giả: đến 3 năm, nghiêm trọng 3 đến 10 năm. Vụ chính thức: Wang và đồng phạm làm, bán phần mềm gian lận đọc và sửa bộ nhớ game để nhìn xuyên, tự ngắm. Trong 3 tháng bán hơn 80.000 nhân dân tệ, lãi hơn 30.000. Bị 1 năm tù, hoãn thi hành 1 năm, phạt 5000. Hoãn 1 năm nghĩa là chưa vào tù ngay, trong năm đó không phạm lại thì không phải chấp hành tù. Xiang và đồng phạm bán phần mềm «TZ», doanh số hơn 200.000 nhân dân tệ; Xiang bị 3 năm, hoãn 3 năm, phạt 20.000. Liu và đồng phạm lấy chương trình máy chủ game, sửa tham số mở máy chủ riêng, thu nạp tiền hơn 20 triệu nhân dân tệ. Bị từ 4 năm đến 2 năm 6 tháng, phạt từ 10 triệu đến 1.3 triệu. Không chỉ game. Một công ty Thượng Hải làm gói firmware thêm cho WeChat hàng chục chức năng như tự chuyển tiếp, thích và gửi hàng loạt, bán 2381 máy dưới tên «điện thoại marketing». Năm 2019, Tòa Từ Hối, Thượng Hải, xử công ty tội xâm phạm quyền tác giả, phạt 500.000 nhân dân tệ; người phụ trách nhận 1 năm 6 tháng, hoãn 1 năm 6 tháng (toàn quốc)."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Nguồn gốc"]},{"tag":"p","props":{"className":"life-citations"},"children":["全国人大 (2020). 刑法（根据刑法修正案（十一）修正，第二百八十五条第三款、第二百一十七条第六项）. ",{"tag":"a","props":{"href":"https://jtgl.beijing.gov.cn/jgj/jgxx/flfg/fl/11033925/index.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://jtgl.beijing.gov.cn/jgj/jgxx/flfg/fl/11033925/index.html"]},"；最高人民法院、最高人民检察院 (2011). 关于办理危害计算机信息系统安全刑事案件应用法律若干问题的解释（第三条）. ",{"tag":"a","props":{"href":"https://ga.sz.gov.cn/ZWGK/ZCFG/ZCJD/content/post_1304363.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://ga.sz.gov.cn/ZWGK/ZCFG/ZCJD/content/post_1304363.html"]},"（深圳市公安局转载）；最高人民检察院 (2026). 上海静安：严惩制售游戏外挂黑灰产共护清朗网络空间. ",{"tag":"a","props":{"href":"https://www.spp.gov.cn/spp/zdgz/202608/t20260825_735480.shtml","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.spp.gov.cn/spp/zdgz/202608/t20260825_735480.shtml"]},"；最高人民检察院 (2021). 2020 年度检察机关保护知识产权典型案例（案例五）. ",{"tag":"a","props":{"href":"https://www.spp.gov.cn/spp/xwfbh/wsfbt/202104/t20210425_516525.shtml","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.spp.gov.cn/spp/xwfbh/wsfbt/202104/t20210425_516525.shtml"]},"；国家版权局 (2020). 2019 年度上海十大版权典型案件发布（上海市版权局发布，案例八：上海昱宫网络科技有限公司等侵犯著作权案）. ",{"tag":"a","props":{"href":"https://www.ncac.gov.cn/xxfb/ywxx/202004/t20200430_47269.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.ncac.gov.cn/xxfb/ywxx/202004/t20200430_47269.html"]}]},{"tag":"a","props":{"href":"https://jtgl.beijing.gov.cn/jgj/jgxx/flfg/fl/11033925/index.html","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Liên kết mở nguồn"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Ghi chú sách"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["Các vụ án hack đã công bố đều là loại đọc ghi bộ nhớ trò chơi, vượt cơ chế chống gian lận. Chưa thấy vụ án chính thức nào về công cụ「chỉ chụp màn hình, chỉ mô phỏng phím」. Nhưng vụ giành vé ở mục 3 cho thấy không đụng bộ nhớ, chỉ gửi yêu cầu, vẫn đủ để kết tội lấy dữ liệu trái phép. Cuối cùng có thành tội phạm hay không, tính theo tội nào, do cơ quan điều tra quyết định theo hồ sơ nhà sản xuất nộp lúc báo việc, không phải do tác giả quyết. Bán đủ 20 lượt người dùng đã là「情节严重」, mức đó rất nhỏ."]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Ghi chú của tôi"]},{"tag":"button","props":{"type":"button"},"children":["Viết một lời nhắc cho chính bạn…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/vi/tip/11-01"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Trước"]},"Trước khi làm, hỏi một câu: nhà sản xuất, nền tảng, công ty có báo công an không; bị truy cứu thì tìm luật sư hình sự ngay"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/vi/tip/11-03"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Tiếp theo"]},"Không viết và không bán script giành vé, đua đặt hàng, tạo đơn ảo, mò hàng miễn phí, kể cả loại chỉ「tự động bấm nút」"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["Thêm trong chủ đề này"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/11-04"},"children":[{"tag":"strong","props":{},"children":["Crawler chỉ lấy trang công khai không cần đăng nhập, không vòng cơ chế chống thu thập, không đụng thông tin cá nhân, dữ liệu đã lấy thì không bán"]},{"tag":"span","props":{},"children":["Dữ liệu phải đăng nhập, phải có token, phải bẻ chữ ký mới có được thu…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/11-05"},"children":[{"tag":"strong","props":{},"children":["Không nhận đơn phát triển ứng dụng cờ bạc, lừa đảo, khiêu dâm, không dựng cổng thanh toán cho「khách hàng», không mở khoá tài khoản bị khoá"]},{"tag":"span","props":{},"children":["Đơn giá cao, yêu cầu mơ hồ như thế mà nhận vào thì coi như đồng phạm …"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/11-06"},"children":[{"tag":"strong","props":{},"children":["Rời công ty thì bàn giao xong quyền truy cập tài khoản, không xoá cơ sở dữ liệu, không để lại backdoor, không đổi mật khẩu để khoá hệ thống, dù công ty còn nợ bạn"]},{"tag":"span","props":{},"children":["Mật khẩu tài khoản do công ty cấp không có nghĩa sau khi nghỉ việc vẫ…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/11-07"},"children":[{"tag":"strong","props":{},"children":["Rời công ty không mang mã nguồn, danh sách khá