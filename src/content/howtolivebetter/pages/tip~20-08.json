ops":{"href":"/tip/20-05"},"children":[{"tag":"strong","props":{},"children":["冲奶粉用 70 ℃ 以上的水，冲好放凉再喂，喝剩的倒掉"]},{"tag":"span","props":{},"children":["奶粉不是无菌的，可能带一种细菌，新生儿感染后四成到八成会死。先倒热水，等降到约 73.8 ℃ 再放奶粉，多数情况下能把这种菌杀到原来的十万分之一以下。热水会让维…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/20-06"},"children":[{"tag":"strong","props":{},"children":["不满 1 岁不喂蜂蜜"]},{"tag":"span","props":{},"children":["孩子不满 1 岁，不要喂蜂蜜。蜂蜜水、拌进辅食里的蜂蜜、含蜂蜜的糕点，都算。蜂蜜里可能带有引起肉毒中毒的细菌。大人肚子里的菌群能压住它，婴儿压不住。"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/20-10"},"children":[{"tag":"strong","props":{},"children":["尿布不看牌子看三件事：合不合身、换得勤不勤、有没有被抽检通报过"]},{"tag":"span","props":{},"children":["没有哪个官方机构排过「哪个牌子最好」。能查的只有两样：市场监管总局的产品质量抽检通报，和监管部门对具体事件的调查。贵的不等于安全，进口的不等于合格。先买小包装试…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/20-11"},"children":[{"tag":"strong","props":{},"children":["大件按「借、买二手、买新」的顺序考虑，别一次性配齐"]},{"tag":"span","props":{},"children":["婴儿车、抱被、玩具用得短，先借，借不到买二手，最后才买新的。二手安全座椅要确认没出过较重的车祸、没被召回、零件齐全，确认不了就别用。苏格兰一项研究里，平时睡别的…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/20-12"},"children":[{"tag":"strong","props":{},"children":["孩子有严重湿疹或鸡蛋过敏，别躲着花生，按医生指导早点加上，但绝不能喂整粒"]},{"tag":"span","props":{},"children":["有重度湿疹或鸡蛋过敏的婴儿，从 4 到 11 个月起定期吃花生。皮试原本没反应的，到 5 岁时吃的只有 1.9% 花生过敏，完全躲开的是 13.7%。皮试已经有…"]}]}]}]},{"tag":"a","props":{"className":"life-text-link","href":"/book/20"},"children":["阅读整个主题：刚出生的孩子怎么带 ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"15","height":"15","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]}]}]},{"tag":"nav","props":{"className":"life-tabbar","aria-label":"主导航"},"children":[{"tag":"a","props":{"className":"","href