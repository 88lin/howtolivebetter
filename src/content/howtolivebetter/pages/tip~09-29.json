Linecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["成本"]},{"tag":"p","props":{"className":"life-citations"},"children":["不花钱。别信「包过班」「VIP 通道」和卖答案的群。手机、耳机这类能收发信息的东西不带进考场。没考过就多准备一次。难在差几分就能上岸时，有人开价说能保过。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["收益"]},{"tag":"p","props":{"className":"life-citations"},"children":["刑法第二百八十四条之一管四种行为，前提是「法律规定的国家考试」。组织作弊的，判 3 年以下或者拘役，并处或者单处罚金。情节严重的，判 3 到 7 年。给组织者提供作弊器材或者别的帮助，按同一档判。为了作弊卖答案、给答案，也按同一档判。替别人考、找别人替自己考，是代替考试罪，处拘役或者管制，并处或者单处罚金。哪些考试算，看两高 2019 年的司法解释。高考、考研、自考、成人高考算，中央和地方的公务员考试算。法律职业资格、教师资格、注册会计师、医师资格、建造师这类资格考试也算。最高法 2024 年写明，驾照考试也属于这类考试。在高考、考研、考公里组织作弊，直接算「情节严重」。组织 30 人次以上，或者违法所得 30 万元以上，也算。考试开始前被查获，但已经拿到试题答案的，照样算犯罪既遂。卖的答案不完整、不全对，不影响定罪。替考情节较轻的可以缓刑，情节轻微的可以不起诉。最高法统计，2015 年 11 月到 2024 年 4 月，这三个罪判了 11146 人。没到犯罪的，按各类考试的规矩处理。国家教育考试里用设备接收答案、找人替考的，成绩无效，还可以停考 1 到 3 年。公务员考试里替考、参与有组织作弊的，取消考试资格，记入诚信档案、长期记录。已经入职的，查出来就辞退或者开除。驾照考试舞弊的，取消考试资格，已经考过的科目作废，罚 2000 元以下，一年内不能再申领驾照。替别人考驾照的，自己的驾照被注销，3 年内不能再申请。官方案例一：张某洁团伙用合成照片和假身份证，让「枪手」替考生考公务员等国家考试 89 次。三个主犯判 5 年到 5 年 6 个月。找枪手的 18 名考生按代替考试罪判拘役 2 到 4 个月，罚 3 万到 10 万元。靠替考当上公务员的人被开除公职。官方案例二：一家驾校的老板在 2017 到 2023 年组织学员在驾考里作弊。办法有改考试系统数据、让教练替考、给学员戴耳机远程提示。老板连同行贿罪被判 6 年 6 个月，其余 23 人判 6 个月到 1 年 10 个月（全国）"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["来源"]},{"tag":"p","props":{"className":"life-citations"},"children":["全国人大常委会 (2015). 刑法修正案（九）（第二十五条，即刑法第二百八十四条之一）. ",{"tag":"a","props":{"href":"https://www.spp.gov.cn/spp/fl/201802/t20180205_364562.shtml","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.spp.gov.cn/spp/fl/201802/t20180205_364562.shtml"]},"；最高人民法院、最高人民检察院 (2019). 关于办理组织考试作弊等刑事案件适用法律若干问题的解释（法释〔2019〕13 号，第一、二、四、五、六、七、十、十一条）. ",{"tag":"a","props":{"href":"https://www.spp.gov.cn/spp/xwfbh/wsfbh/201909/t20190903_430901.shtml","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.spp.gov.cn/spp/xwfbh/wsfbh/201909/t20190903_430901.shtml"]},"；最高人民法院 (2024). 最高人民法院发布依法惩治组织考试作弊犯罪典型案例（案例三、四、五）. ",{"tag":"a","props":{"href":"https://www.court.gov.cn/zixun/xiangqing/434401.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.court.gov.cn/zixun/xiangqing/434401.html"]},"；教育部 (2012). 关于修改《国家教育考试违规处理办法》的决定（教育部令第 33 号，第九、十二条）. ",{"tag":"a","props":{"href":"https://www.gov.cn/gongbao/content/2012/content_2169156.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/gongbao/content/2012/content_2169156.htm"]},"；人力资源和社会保障部 (2016). 公务员考试录用违纪违规行为处理办法（人社部令第 30 号，第七、八、十五条）. ",{"tag":"a","props":{"href":"https://www.gov.cn/gongbao/content/2017/content_5208205.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/gongbao/content/2017/content_5208205.htm"]},"；公安部 (2025). 机动车驾驶证申领和使用规定（公安部令第 172 号修改后重新公布，第十五、七十九、九十三条）. ",{"tag":"a","props":{"href":"https://www.gov.cn/gongbao/2025/issue_11866/202502/content_7004031.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/gongbao/2025/issue_11866/202502/content_7004031.html"]},""]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["原书备注"]},{"tag":"p","props":{"className":"life-citations"},"children":["受益人是你自己。单纯自己偷看、戴耳机接答案，法条没有列为犯罪，按上面的考试规矩处理。但买来的答案转给同学，就成了非法提供试题、答案。二级建造师泄题案里，答案被考生层层转卖，有人发进 1700 多人的 QQ 群。在校学生替考或者找人替考，考试机构会通报学校，学校可以开除学籍。单位招聘、学校期末考试这类不在「国家考试」里，但用窃听窃照器材、建群发作弊信息，照样可能按别的罪判。官方案例一里给枪手做假身份证的人，按伪造身份证件罪判了 3 年。证件的事见本节第 16 条（身份证不借人）。花钱找中介代评职称，见第 23 节第 22 条（别找中介代评）。"]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["我的备注"]},{"tag":"button","props":{"type":"button"},"children":["写下对自己有用的提醒…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/tip/09-28"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["上一条"]},"上坟、烧荒、野炊时不在林区和草原点火，看到山火打 12119 或 119"]}]},{"tag":"span","props":{},"children":[]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["本主题的其他建议"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/09-03"},"children":[{"tag":"strong","props":{},"children":["境外网站上的东西看完就关，不截图、不转发、不搬进群里，也不在评论区跟着说"]},{"tag":"span","props":{},"children":["这些法条罚的是往外传，不罚看。你转发、搬进群、在评论区跟着说，办案时都算传播。传到煽动颠覆、煽动分裂这一档，判 5 年以下，带头的 5 年以上。恐怖主义、极端主…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/09-04"},"children":[{"tag":"strong","props":{},"children":["黄色视频自己看归自己，别往群里发、别卖「资源」、别建群"]},{"tag":"span","props":{},"children":["自己看不在处罚条款里。往群里发就是在网上传播，条文没要求发几次，拘留 10 到 15 日，还可以再罚 5000 元以下，情节严重的判 2 年以下。卖「资源」挣钱…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/09-05"},"children":[{"tag":"strong","props":{},"children":["「兼职」要你用自己的卡收钱、取现、转账，不管给多少好处费都不做"]},{"tag":"span","props":{},"children":["这类兼职挣的是几百块，代价是留一份案底。有人带着身份证和 1 张银行卡去指定地点，配合转账取款，挣了 500 多元。检察院没起诉他，公安还是拘留 10 日、罚…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/09-06"},"children":[{"tag":"strong","props":{},"children":["有人拉你去「包装材料」贷款、按贷款额分你好处费，一个都不做"]},{"tag":"span","props":{},"children":["帮人「包装材料」去贷款、拿分成，按诈骗办。有个 126 人的团伙，把没工作的人包装成「优质客户」，在 80 多家银行网点骗贷 3000 多万元。出面签字的按贷款…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/09-07"},"children":[{"tag":"strong","props":{},"children":["捡到银行卡不取钱，捡到手机、钱包联系失主或交给警察，不揣走"]},{"tag":"span","props":{},"children":["捡到东西留着自己用，金额到了「数额较大」又不肯交出来，判 2 年以下，数额巨大的判 2 到 5 年。拿捡来的银行卡去 ATM 取钱更重，算冒用别人的信用卡，数额…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/09-08"},"children":[{"tag":"strong","props":{},"children":["优惠用自己的真实身份领，不买虚拟号批量注册小号，不靠漏洞重复领"]},{"tag":"span","props":{},"children":["用真实身份、一个号领一次券，不在处罚范围里。批量注册假用户、自己下单自己接单去多领，按诈骗办。骗到各省定的起点（3000 到 1 万元）判 3 年以下，到 3…"]}]}]}]},{"tag":"a","props":{"className":"life-text-link","href":"/book/09"},"children":["阅读整个主题：普通人容易踩的法律红线 ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"15","height":"15","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]}]}]},{"tag":"nav","props":{"className":"life-tabbar","aria-label":"主导航"},"children":[{"tag":"a","props":{"className":"","href":"/book"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"21","height":"21","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-book-open","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M12 7v14"},"children":[]},{"tag":"path","props":{"d":"M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z"},"children":[]}]},{"tag":"span","props":{},"children":["全书"]}]},{"tag":"a","props":{"className":"","href":"/top-50"},"children":[{"tag":"svg","props":{"xmln