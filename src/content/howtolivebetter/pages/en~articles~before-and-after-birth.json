img","props":{"src":"/sites/howtolivebetter/images/book-chapters/27-pregnancy-editorial.webp","srcSet":"/sites/howtolivebetter/images/book-chapters/27-pregnancy-editorial-thumb.webp 600w, /sites/howtolivebetter/images/book-chapters/27-pregnancy-editorial-md.webp 900w, /sites/howtolivebetter/images/book-chapters/27-pregnancy-editorial.webp 1200w","sizes":"(max-width: 760px) 100vw, 450px","alt":"","width":"1200","height":"800","fetchPriority":"high"},"children":[]}]},{"tag":"div","props":{"className":"life-longread-layout"},"children":[{"tag":"aside","props":{"className":"life-longread-toc"},"children":[{"tag":"details","props":{"open":true},"children":[{"tag":"summary","props":{},"children":["On this page"]},{"tag":"nav","props":{"aria-label":"On this page"},"children":[{"tag":"a","props":{"href":"#i-when-planning-a-pregnancy"},"children":["I. When planning a pregnancy"]},{"tag":"a","props":{"href":"#ii-after-pregnancy-before-birth"},"children":["II. After pregnancy, before birth"]},{"tag":"a","props":{"href":"#iii-during-hospital-birth"},"children":["III. During hospital birth"]},{"tag":"a","props":{"href":"#iv-before-discharge"},"children":["IV. Before discharge"]},{"tag":"a","props":{"href":"#v-the-first-month-after-birth"},"children":["V. The first month after birth"]},{"tag":"a","props":{"href":"#vi-from-one-month-through-the-first-birthday"},"children":["VI. From one month through the first birthday"]}]}]}]},{"tag":"div","props":{"className":"life-longread-main"},"children":[{"tag":"article","props":{"className":"life-article-body","lang":"en"},"children":[{"tag":"blockquote","props":{},"children":["\n",{"tag":"p","props":{},"children":["Unofficial English translation of ",{"tag":"a","props":{"href":"/articles/before-and-after-birth"},"children":["docs/孩子出生前后要办的事.md"]},". In case of discrepancies the Chinese original takes precedence."]},"\n"]},"\n",{"tag":"p","props":{},"children":["The book is split by topic; pregnancy, birth, and infant care are spread across several sections. This checklist orders them by time, from planning a pregnancy through the child’s first birthday. Each line states only what to do; why and how strong the evidence is are in the entry cited in parentheses. Start at the heading for the stage you are in."]},"\n",{"tag":"h2","props":{"id":"i-when-planning-a-pregnancy"},"children":["I. When planning a pregnancy"]},"\n",{"tag":"ol","props":{},"children":["\n",{"tag":"li","props":{},"children":["Take 0.4 mg folic acid daily, starting three months before conception. See ",{"tag":"a","props":{"href":"/en/book/27"},"children":["Section 27, item 1"]}," (folic acid)."]},"\n",{"tag":"li","props":{},"children":["Call social insurance or medical insurance once and ask whether maternity-insurance contribution months are sufficient. See ",{"tag":"a","props":{"href":"/en/book/27"},"children":["Section 27, item 11"]}," (maternity insurance)."]},"\n",{"tag":"li","props":{},"children":["Agree with household members that no one smokes indoors from now on. See ",{"tag":"a","props":{"href":"/en/book/02"},"children":["Section 2, item 2"]}," (no smoking at home or in the car)."]},"\n",{"tag":"li","props":{},"children":["If someone at home depends on your income, buy term life insurance for the earner first. See ",{"tag":"a","props":{"href":"/en/book/05"},"children":["Section 5, item 40"]}," (term life insurance)."]},"\n"]},"\n",{"tag":"h2","props":{"id":"ii-after-pregnancy-before-birth"},"children":["II. After pregnancy, before birth"]},"\n",{"tag":"ol","props":{},"children":["\n",{"tag":"li","props":{},"children":["Before week 13, register at a community health center for the Maternal and Child Health Handbook; free prenatal visits start there. See ",{"tag":"a","props":{"href":"/en/book/27"},"children":["Section 27, item 2"]}," (Maternal and Child Health Handbook)."]},"\n",{"tag":"li","props":{},"children":["At the first prenatal visit, test for HIV, syphilis, and hepatitis B; you do not pay for the tests. See ",{"tag":"a","props":{"href":"/en/book/27"},"children":["Section 27, item 3"]}," (HIV, syphilis, hepatitis B)."]},"\n",{"tag":"li","props":{},"children":["No smoking and no alcohol at all during pregnancy. See ",{"tag":"a","props":{"href":"/en/book/27"},"children":["Section 27, item 4"]}," (no cigarettes, no alcohol)."]},"\n",{"tag":"li","props":{},"children":["Tell your full medical history at prenatal visits. If you have high-risk factors for preeclampsia, let the doctor decide whether to start low-dose aspirin after week 12. See ",{"tag":"a","props":{"href":"/en/book/27"},"children":["Section 27, item 5"]}," (low-dose aspirin)."]},"\n",{"tag":"li","props":{},"children":["From week 24 onward, have gestational diabetes screening. See ",{"tag":"a","props":{"href":"/en/book/27"},"children":["Section 27, item 6"]}," (gestational diabetes screening)."]},"\n",{"tag":"li","props":{},"children":["After week 20 of pregnancy, do not take ibuprofen-type pain relievers on your own. See ",{"tag":"a","props":{"href":"/en/book/34"},"children":["Section 34, item 5"]}," (ibuprofen-type pain relievers)."]},"\n",{"tag":"li","props":{},"children":["Learn the “go to the hospital now” list and make sure others at home know it too. See ",{"tag":"a","props":{"href":"/en/book/27"},"children":["Section 27, item 7"]}," (go to the hospital now)."]},"\n",{"tag":"li","props":{},"children":["At prenatal visits, ask whether the hospital offers painless labor. See ",{"tag":"a","props":{"href":"/en/book/27"},"children":["Section 27, item 9"]}," (painless labor)."]},"\n",{"tag":"li","props":{},"children":["Without a medical indication, do not ask for a cesarean section. See ",{"tag":"a","props":{"href":"/en/book/27"},"children":["Section 27, item 10"]}," (cesarean section)."]},"\n",{"tag":"li","props":{},"children":["If you will deliver outside your insurance locality, ask in advance whether you need cross-region maternity filing. See ",{"tag":"a","props":{"href":"/en/book/27"},"children":["Section 27, item 11"]}," (maternity insurance)."]},"\n",{"tag":"li","props":{},"children":["Maternity leave is at least 98 days; up to 15 days may be taken before birth. See ",{"tag":"a","props":{"href":"/en/book/18"},"children":["Section 18, item 2"]}," (maternity leave)."]},"\n",{"tag":"li","props":{},"children":["If the employer cuts pay or moves you because of pregnancy, keep written notices and chat records. See ",{"tag":"a","props":{"href":"/en/book/18"},"children":["Section 18, item 3"]}," (no pay cut for pregnancy, birth, or nursing)."]},"\n",{"tag":"li","props":{},"children":["Borrow a crib and stroller first; buy second-hand if you cannot borrow. Do not buy a used car seat or mattress. See ",{"tag":"a","props":{"href":"/en/book/20"},"children":["Section 20, item 11"]}," (borrow, second-hand, new)."]},"\n",{"tag":"li","props":{},"children":["Try diapers in a small pack for a week before stocking up. See ",{"tag":"a","props":{"href":"/en/book/20"},"children":["Section 20, item 10"]}," (diapers)."]},"\n",{"tag":"li","props":{},"children":["Choose the baby’s name early and confirm the household-registration system can print the characters. See ",{"tag":"a","props":{"href":"/en/book/27"},"children":["Section 27, item 12"]}," (birth medical certificate)."]},"\n"]},"\n",{"tag":"h2","props":{"id":"iii-during-hospital-birth"},"children":["III. During hospital birth"]},"\n",{"tag":"ol","props":{},"children":["\n",{"tag":"li","props":{},"children":["If membranes rupture, lie flat where you are, elevate the hips, call 120; do not walk around. See ",{"tag":"a","props":{"href":"/en/book/27"},"children":["Section 27, item 8"]}," (ruptured membranes)."]},"\n",{"tag":"li","props":{},"children":["Start breastfeeding within the first hour after birth. See ",{"tag":"a","props":{"href":"/en/book/20"},"children":["Section 20, item 4"]}," (breastfeeding only)."]},"\n",{"tag":"li","props":{},"children":["Give the first hepatitis B vaccine dose within 24 hours of birth. If the mother is hepatitis B surface antigen positive, give hepatitis B immune globulin at the same time. See ",{"tag":"a","props":{"href":"/en/book/20"},"children":["Section 20, item 2"]}," (first hepatitis B dose)."]},"\n",{"tag":"li","props":{},"children":["Give the vitamin K injection. If birthing at home or at an informal facility, ask explicitly. See ",{"tag":"a","props":{"href":"/en/book/20"},"children":["Section 20, item 7"]}," (vitamin K injection)."]},"\n",{"tag":"li","props":{},"children":["Do not refuse heel-prick screening or hearing screening. Before signing consent, see which items are optional paid add-ons. See ",{"tag":"a","props":{"href":"/en/book/27"},"children":["Section 27, item 13"]}," (heel-prick and hearing screening)."]},"\n"]},"\n",{"tag":"h2","props":{"id":"iv-before-discharge"},"children":["IV. Before discharge"]},"\n",{"tag":"ol","props":{},"children":["\n",{"tag":"li","props":{},"children":["Complete the birth medical certificate; verify parents’ and child’s names and ID numbers character by character. See ",{"tag":"a","props":{"href":"/en/book/27"},"children":["Section 27, item 12"]}," (birth medical certificate)."]},"\n",{"tag":"li","props":{},"children":["Enroll the child in resident medical insurance online using the birth certificate; you do not need household registration first. If unsure, call 12393. See ",{"tag":"a","props":{"href":"/en/book/27"},"children":["Section 27, item 14"]}," (resident medical insurance)."]},"\n",{"tag":"li","props":{},"children":["Use a car seat on the way home: rear-facing under age one; do not hold the baby in your arms. See ",{"tag":"a","props":{"href":"/en/book/01"},"children":["Section 1, item 10"]}," (car seat)."]},"\n"]},"\n",{"tag":"h2","props":{"id":"v-the-first-month-after-birth"},"children":["V. The first month after birth"]},"\n",{"tag":"ol","props":{},"children":["\n",{"tag":"li","props":{},"children":["Register the birth at the police station within one month. See ",{"tag":"a","props":{"href":"/en/book/27"},"children":["Section 27, item 15"]}," (birth registration)."]},"\n",{"tag":"li","props":{},"children":["After household registration, apply for the child-rearing subsidy where the child is registered: 3,600 yuan per child per year. See ",{"tag":"a","props":{"href":"/en/book/18"},"children":["Section 18, item 1"]}," (child-rearing subsidy)."]},"\n",{"tag":"li","props":{},"children":["Put the baby to sleep on the back, on a firm surface, same room but not same bed; no soft bedding in the crib. See ",{"tag":"a","props":{"href":"/en/book/20"},"children":["Section 20, item 1"]}," (back to sleep)."]},"\n",{"tag":"li","props":{},"children":["For formula, mix with water at 70 °C or above; discard leftovers. See ",{"tag":"a","props":{"href":"/en/book/20"},"children":["Section 20, item 5"]}," (mixing formula)."]},"\n",{"tag":"li","props":{},"children":["If a child under three months reaches 38 °C, go to the hospital. See ",{"tag":"a","props":{"href":"/en/book/20"},"children":["Section 20, item 8"]}," (fever at 38 °C)."]},"\n",{"tag":"li","props":{},"children":["When you are about to lose control, put the baby in the crib and step away for a few minutes. See ",{"tag":"a","props":{"href":"/en/book/20"},"children":["Section 20, item 9"]}," (never shake a baby)."]},"\n",{"tag":"li","props":{},"children":["The mother’s “go to the hospital now” list still applies for one year after birth. See ",{"tag":"a","props":{"href":"/en/book/27"},"children":["Section 27, item 7"]}," (go to the hospital now)."]},"\n"]},"\n",{"tag":"h2","props":{"id":"vi-from-one-month-through-the-first-birthday"},"children":["VI. From one month through the first birthday"]},"\n",{"tag":"ol","props":{},"children":["\n",{"tag":"li","props":{},"children":["At 42 days postpartum, go for the check-up, which includes postpartum depression screening. See ",{"tag":"a","props":{"href":"/en/book/27"},"children":["Section 27, item 16"]}," (42-day postpartum visit)."]},"\n",{"tag":"li","props":{},"children":["Follow the immunization schedule at the clinic; DTaP starts at two months. See ",{"tag":"a","props":{"href":"/en/book/20"},"children":["Section 20, item 3"]}," (national immunization program)."]},"\n",{"tag":"li","props":{},"children":["Breastfeed only for the first six months; from six months add complementary foods with iron-rich animal foods daily. See ",{"tag":"a","props":{"href":"/en/book/20"},"children":["Section 20, item 4"]}," (complementary feeding from six months)."]},"\n",{"tag":"li","props":{},"children":["Do not give honey before age one. See ",{"tag":"a","props":{"href":"/en/book/20"},"children":["Section 20, item 6"]}," (honey)."]},"\n",{"tag":"li","props":{},"children":["With severe eczema or egg allergy, see a doctor before deciding whether to introduce peanut early. See ",{"tag":"a","props":{"href":"/en/book/20"},"children":["Section 20, item 12"]}," (do not avoid peanut entirely)."]},"\n",{"tag":"li","props":{},"children":["For colds in children under two, do not give combination cold medicines on your own. See ",{"tag":"a","props":{"href":"/en/book/34"},"children":["Section 34, item 4"]}," (combination cold medicines)."]},"\n",{"tag":"li","props":{},"children":["Install window and balcony limiters; screens are not fall protection. See ",{"tag":"a","props":{"href":"/en/book/01"},"children":["Section 1, item 11"]}," (window and balcony limiters)."]},"\n",{"tag":"li","props":{},"children":["No phones or tablets for children 0–3. See ",{"tag":"a","props":{"href":"/en/book/30"},"children":["Section 30, item 5"]}," (no screens)."]},"\n",{"tag":"li","props":{},"children":["After returning to work, if the child is under one year, you have one hour of nursing time per day. See ",{"tag":"a","props":{"href":"/en/book/18"},"children":["Section 18, item 3"]}," (nursing time)."]},"\n",{"tag":"li","props":{},"children":["Link your employee medical-savings account for family pooling so the child can use it for care and medicine. See ",{"tag":"a","props":{"href":"/en/book/05"},"chi