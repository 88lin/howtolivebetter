idth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-up-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M7 7h10v10"},"children":[]},{"tag":"path","props":{"d":"M7 17 17 7"},"children":[]}]}]}]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/en/book/09"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"Back to index"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["Legal pitfalls that ordinary people often overlook"]},{"tag":"div","props":{"data-ad-dock-host":"true"},"children":[]},{"tag":"nav","props":{"aria-label":"Chapter entries"},"children":[{"tag":"a","props":{"href":"/en/tip/09-01"},"children":[{"tag":"span","props":{},"children":["01"]},"Do not share unverified messages about disasters, epidemics, or police incidents in groups; do not photoshop images or use AI to generate fake scene pictures"]},{"tag":"a","props":{"href":"/en/tip/09-02"},"children":[{"tag":"span","props":{},"children":["02"]},"Do not post, share, or comment images, memes, or remarks that insult heroes and martyrs, nor make jokes about the national flag or anthem"]},{"tag":"a","props":{"href":"/en/tip/09-03"},"children":[{"tag":"span","props":{},"children":["03"]},"After viewing content on foreign websites, simply close the page — do not screenshot, share, repost, or discuss it in any groups or comment sections"]},{"tag":"a","props":{"href":"/en/tip/09-04"},"children":[{"tag":"span","props":{},"children":["04"]},"Watching porn alone is fine, but don’t post it in groups, sell “resources,” or create groups"]},{"tag":"a","props":{"href":"/en/tip/09-05"},"children":[{"tag":"span","props":{},"children":["05"]},"Part-time jobs that ask you to use your own card to receive payments, withdraw cash, or transfer money — no matter how much extra pay they offer, avoid them"]},{"tag":"a","props":{"href":"/en/tip/09-06"},"children":[{"tag":"span","props":{},"children":["06"]},"Some people try to get you to “package loan applicants” for them and offer a commission based on the loan amount — don’t fall for it"]},{"tag":"a","props":{"href":"/en/tip/09-07"},"children":[{"tag":"span","props":{},"children":["07"]},"Keeping found items and not using them for personal gain; returning lost phones, wallets, or cash to owners or police"]},{"tag":"a","props":{"href":"/en/tip/09-08"},"children":[{"tag":"span","props":{},"children":["08"]},"Use your real identity to claim discounts — don’t register fake accounts or exploit loopholes to get more"]},{"tag":"a","props":{"href":"/en/tip/09-09"},"children":[{"tag":"span","props":{},"children":["09"]},"Never throw anything from balconies or windows — cigarette butts, trash bags, and bottles all count"]},{"tag":"a","props":{"href":"/en/tip/09-10"},"children":[{"tag":"span","props":{},"children":["10"]},"Do not buy imitation guns, BB guns, or air rifles online; avoid “toy guns” of unknown origin"]},{"tag":"a","props":{"href":"/en/tip/09-11"},"children":[{"tag":"span","props":{},"children":["11"]},"Register drones with your real name first; never fly near airports, military zones, or restricted urban airspace, and don’t tamper with altitude limits"]},{"tag":"a","props":{"href":"/en/tip/09-12"},"children":[{"tag":"span","props":{},"children":["12"]},"Do not secretly film others, nor install cameras in rented apartments, homestays, or hotel rooms"]},{"tag":"a","props":{"href":"/en/tip/09-13"},"children":[{"tag":"span","props":{},"children":["13"]},"Mahjong and poker can be played — no rake, no banker role, no organizing paid games, no online gambling"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/en/tip/09-14","data-status":"active"},"children":[{"tag":"span","props":{},"children":["14"]},"Do not eat wild animals; do not buy, sell, or keep protected species as pets"]},{"tag":"a","props":{"href":"/en/tip/09-15"},"children":[{"tag":"span","props":{},"children":["15"]},"You cannot detain or confine someone to collect a debt, nor follow them home and refuse to leave"]},{"tag":"a","props":{"href":"/en/tip/09-16"},"children":[{"tag":"span","props":{},"children":["16"]},"Do not lend your ID card, do not use someone else’s ID card, and do not register, open accounts, or buy tickets using another person’s documents"]},{"tag":"a","props":{"href":"/en/tip/09-17"},"children":[{"tag":"span","props":{},"children":["17"]},"Cooperate when stopped or taken away by police — don’t push, hit, or grab their body cameras; especially if you’ve been drinking, stay calm"]},{"tag":"a","props":{"href":"/en/tip/09-18"},"children":[{"tag":"span","props":{},"children":["18"]},"Sexual relations with anyone under 14 are illegal; “she consented” is not a defense"]},{"tag":"a","props":{"href":"/en/tip/09-19"},"children":[{"tag":"span","props":{},"children":["19"]},"Do the math before you hit someone: detention, fines, and prison time"]},{"tag":"a","props":{"href":"/en/tip/09-20"},"children":[{"tag":"span","props":{},"children":["20"]},"If parents cannot care for their newborn, the only legal option is to register the adoption with the civil affairs bureau: paying someone to hand over the child may be prosecuted as child trafficking, while abandoning the child constitutes abandonment"]},{"tag":"a","props":{"href":"/en/tip/09-21"},"children":[{"tag":"span","props":{},"children":["21"]},"Don’t fabricate accidents or exaggerate damages to defraud insurance payouts: this is insurance fraud, and anyone helping you testify, assess damage, or repair your vehicle is equally liable"]},{"tag":"a","props":{"href":"/en/tip/09-22"},"children":[{"tag":"span","props":{},"children":["22"]},"Don’t sell your own organs, and don’t help others find donors: a kidney brings in just over $20,000, but the same kidney can be sold to a patient for $200,000. All proceeds are seized, plus a fine of 10–20 times the transaction amount"]},{"tag":"a","props":{"href":"/en/tip/09-23"},"children":[{"tag":"span","props":{},"children":["23"]},"Don’t engage in prostitution: the default penalty is 10–15 days in detention, not just a fine"]},{"tag":"a","props":{"href":"/en/tip/09-24"},"children":[{"tag":"span","props":{},"children":["24"]},"Distributing unauthorized Chinese-dubbed comics, pirated movies/TV shows, cloud storage links, and pirated e-books — even for free — is illegal; adding ads or charging membership fees can lead to criminal charges"]},{"tag":"a","props":{"href":"/en/tip/09-25"},"children":[{"tag":"span","props":{},"children":["25"]},"To publish or monetize fan works, first obtain permission from the original copyright holder, or replace the borrowed characters’ names and relationships with your own"]},{"tag":"a","props":{"href":"/en/tip/09-26"},"children":[{"tag":"span","props":{},"children":["26"]},"Do not buy and carry batons, stun devices, daggers, or pepper spray for self-defense; keeping them in your car also counts as carrying"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"Breadcrumb"},"children":[{"tag":"a","props":{"href":"/en/book"},"children":["Explore the book"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/en/book/09"},"children":["Chapter 9"," ·"," ","Legal pitfalls that ordinary people often overlook"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"09-14"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["14"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["Evidence"," ","A"]}]},{"tag":"h1","props":{"lang":"en"},"children":["Do not eat wild animals; do not buy, sell, or keep protected species as pets"]},{"tag":"p","props":{"lang":"en","className":"life-entry-summary"},"children":["If you eat a nationally protected animal, the animal will be confiscated and you will be fined 2 to 20 times its market value. Those who purchase, transport, or sell precious and endangered animals face up to 5 years in prison; repeat offenders may be sentenced to 5 to 10 years. However, this rule does not apply to animals bred in captivity: in one case, three breeders sold over 40 captive-bred rose-ringed parakeets worth less than 400 yuan total, and prosecutors chose not to press charges. This exemption does not cover animals caught in the wild or those with unclear origins."]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Cost"]},{"tag":"p","props":{},"children":["No cost involved. Only purchase pets that are legally sour…"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Benefit"]},{"tag":"p","props":{},"children":["Consuming or purchasing nationally protected wildlife results in confiscation of the animal and a fine of 2 to…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"Mark: Do not eat wild animals; do not buy, sell, or keep protected species as pets"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"Done"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"Plan to do"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"Save"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Share this tip"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Hide details"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Cost"]},{"tag":"p","props":{},"children":["No cost involved. Only purchase pets that are legally sourced and bred in captivity."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Benefit"]},{"tag":"p","props":{},"children":["Consuming or purchasing nationally protected wildlife results in confiscation of the animal and a fine of 2 to 20 times its value. Breeding such animals without a permit also leads to confiscation and a fine of 1 to 10 times the animal’s value. Illegal trade of protected species and their products carries up to 5 years in prison and financial penalties; repeat offenders face 5 to 10 years, and those committing especially serious violations may be sentenced to over 10 years. Hunting, buying, transporting, or selling other terrestrial wildlife for consumption is punishable by up to 3 years in prison if done on a large scale. A notable case: in 2021, three breeders sold over 40 captive-bred rose-ringed parakeets (a second-class protected species) worth less than 400 yuan total, and prosecutors decided not to prosecute. Since 2022, China’s top courts have clarified that animals bred in captivity at scale for pet trade generally do not constitute a crime nationwide."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Original sources"]},{"tag":"p","props":{"className":"life-citations"},"children":["全国人大常委会 (2022). 野生动物保护法（2022 年修订，第三十一、五十一、五十三条）. ",{"tag":"a","props":{"href":"https://www.mee.gov.cn/ywgz/fgbz/fl/202302/t20230220_1016885.shtml","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.mee.gov.cn/ywgz/fgbz/fl/202302/t20230220_1016885.shtml"]},"（生态环境部转载）；全国人大 (2020). 刑法（根据刑法修正案（十一）修正，第三百四十一条）. ",{"tag":"a","props":{"href":"https://jtgl.beijing.gov.cn/jgj/jgxx/flfg/fl/11033925/index.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://jtgl.beijing.gov.cn/jgj/jgxx/flfg/fl/11033925/index.html"]},"；全国人大常委会 (2020). 刑法修正案（十一）（第四十一条，即刑法第三百四十一条第三款）. ",{"tag":"a","props":{"href":"https://www.spp.gov.cn/zdgz/202012/t20201227_503682.shtml","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.spp.gov.cn/zdgz/202012/t20201227_503682.shtml"]},"；最高人民法院、最高人民检察院 (2022). 关于办理破坏野生动物资源刑事案件适用法律若干问题的解释（法释〔2022〕12 号，第十三条）. ",{"tag":"a","props":{"href":"https://www.spp.gov.cn/spp/xwfbh/wsfbt/202204/t20220407_553506.shtml","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.spp.gov.cn/spp/xwfbh/wsfbt/202204/t20220407_553506.shtml"]},"；最高人民检察院 (2023). 鹦鹉小案 民生大案. ",{"tag":"a","props":{"href":"https://www.spp.gov.cn/spp/zdgz/202302/t20230211_601023.shtml","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.spp.gov.cn/spp/zdgz/20