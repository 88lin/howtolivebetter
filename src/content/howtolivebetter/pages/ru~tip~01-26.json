:"path","props":{"d":"M18 20a6 6 0 0 0-12 0"},"children":[]},{"tag":"circle","props":{"cx":"12","cy":"10","r":"4"},"children":[]},{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},{"tag":"span","props":{},"children":["Войти"]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/ru/book/01"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"К содержанию"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["Как не умереть раньше времени"]},{"tag":"nav","props":{"aria-label":"Советы главы"},"children":[{"tag":"a","props":{"href":"/ru/tip/01-01"},"children":[{"tag":"span","props":{},"children":["01"]},"Пристегните ремень безопасности — как спереди, так и сзади"]},{"tag":"a","props":{"href":"/ru/tip/01-02"},"children":[{"tag":"span","props":{},"children":["02"]},"Надевание шлема при езде на мотоцикле и электровелосипеде"]},{"tag":"a","props":{"href":"/ru/tip/01-03"},"children":[{"tag":"span","props":{},"children":["03"]},"Установка дымовых извещателей; зимой в домах с отоплением углём или газом — ещё и извещателей на угарный газ"]},{"tag":"a","props":{"href":"/ru/tip/01-04"},"children":[{"tag":"span","props":{},"children":["04"]},"Заменяйте газовые шланги и плиты по истечении срока службы, не вносите изменения в трубопровод самостоятельно, а при навязчивых предложениях от газовой компании смело отказывайтесь"]},{"tag":"a","props":{"href":"/ru/tip/01-05"},"children":[{"tag":"span","props":{},"children":["05"]},"Не собирайте, не покупайте и не ешьте дикие грибы; никакие «народные способы» их распознавания не работают"]},{"tag":"a","props":{"href":"/ru/tip/01-06"},"children":[{"tag":"span","props":{},"children":["06"]},"Электровелосипеды нельзя везти в подъезды, в лифты и заряжать дома"]},{"tag":"a","props":{"href":"/ru/tip/01-07"},"children":[{"tag":"span","props":{},"children":["07"]},"Измерение давления и приём лекарств для его снижения до нормы"]},{"tag":"a","props":{"href":"/ru/tip/01-08"},"children":[{"tag":"span","props":{},"children":["08"]},"После 35 лет при наличии избыточного веса стоит сдать анализ на уровень глюкозы в крови; если результат в норме, повторять исследование раз в три года"]},{"tag":"a","props":{"href":"/ru/tip/01-09"},"children":[{"tag":"span","props":{},"children":["09"]},"Не превышать скорость и не садиться за руль в нетрезвом виде"]},{"tag":"a","props":{"href":"/ru/tip/01-10"},"children":[{"tag":"span","props":{},"children":["10"]},"Использование при поездках детских автокресел для детей младше 4 лет, а не держание их на руках"]},{"tag":"a","props":{"href":"/ru/tip/01-11"},"children":[{"tag":"span","props":{},"children":["11"]},"Установите ограничители на окна и балконы, если в доме есть дети; москитные сетки не являются защитой"]},{"tag":"a","props":{"href":"/ru/tip/01-12"},"children":[{"tag":"span","props":{},"children":["12"]},"Детей у воды нужно держать под присмотром; при катании на лодках и плавании в естественных водоемах следует надевать спасательные жилеты"]},{"tag":"a","props":{"href":"/ru/tip/01-13"},"children":[{"tag":"span","props":{},"children":["13"]},"Упражнения на равновесие и силу ног для людей старше 60 лет, а также модернизация ванной комнаты и лестниц в доме"]},{"tag":"a","props":{"href":"/ru/tip/01-14"},"children":[{"tag":"span","props":{},"children":["14"]},"Анализ на наличие антител к гепатиту B и вакцинация при их отсутствии"]},{"tag":"a","props":{"href":"/ru/tip/01-15"},"children":[{"tag":"span","props":{},"children":["15"]},"При уколе гвоздем, занозе или загрязнении раны землёй необходимо сразу обратиться за помощью и спросить, нужна ли прививка от столбняка"]},{"tag":"a","props":{"href":"/ru/tip/01-16"},"children":[{"tag":"span","props":{},"children":["16"]},"Чем раньше женщины получают вакцину против ВПЧ, тем лучше"]},{"tag":"a","props":{"href":"/ru/tip/01-17"},"children":[{"tag":"span","props":{},"children":["17"]},"Скрининг рака молочной железы для женщин: маммография каждые два года начиная с 40 лет"]},{"tag":"a","props":{"href":"/ru/tip/01-18"},"children":[{"tag":"span","props":{},"children":["18"]},"Женщинам старше 30 лет для скрининга рака шейки матки рекомендуется тестирование на ВПЧ"]},{"tag":"a","props":{"href":"/ru/tip/01-19"},"children":[{"tag":"span","props":{},"children":["19"]},"Скрининг колоректального рака с 45–50 лет: иммунохимический тест на скрытую кровь в кале или колоноскопия"]},{"tag":"a","props":{"href":"/ru/tip/01-20"},"children":[{"tag":"span","props":{},"children":["20"]},"Людям с сердечно-сосудистыми заболеваниями и пожилым людям стоит делать прививку от гриппа каждый год"]},{"tag":"a","props":{"href":"/ru/tip/01-21"},"children":[{"tag":"span","props":{},"children":["21"]},"Вакцинация против опоясывающего герпеса после 50 лет"]},{"tag":"a","props":{"href":"/ru/tip/01-22"},"children":[{"tag":"span","props":{},"children":["22"]},"Вакцинация против пневмококковой инфекции для людей старше 65 лет"]},{"tag":"a","props":{"href":"/ru/tip/01-23"},"children":[{"tag":"span","props":{},"children":["23"]},"Обследование на наличие хеликобактера пилори и его эрадикация"]},{"tag":"a","props":{"href":"/ru/tip/01-24"},"children":[{"tag":"span","props":{},"children":["24"]},"Тяжелым курильщикам раз в год следует делать низкодозовую КТ грудной клетки"]},{"tag":"a","props":{"href":"/ru/tip/01-25"},"children":[{"tag":"span","props":{},"children":["25"]},"При возникновении депрессии или суицидальных мыслей звоните по номеру 12356; дома не храните снотворные и пестициды"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/ru/tip/01-26","data-status":"active"},"children":[{"tag":"span","props":{},"children":["26"]},"Подготовьте огнетушитель, огнезащитное одеяло, респиратор для эвакуации и аптечку первой помощи, проверяя их раз в год"]},{"tag":"a","props":{"href":"/ru/tip/01-27"},"children":[{"tag":"span","props":{},"children":["27"]},"Появление в моче крови, видимой невооруженным глазом — даже если нет боли и даже если кровь исчезает на следующий день — требует обязательного обследования"]},{"tag":"a","props":{"href":"/ru/tip/01-28"},"children":[{"tag":"span","props":{},"children":["28"]},"Проблемы с эрекцией? Сначала проверьте сердечно-сосудистую систему, а не списывайте это лишь на «сексуальные трудности»"]},{"tag":"a","props":{"href":"/ru/tip/01-29"},"children":[{"tag":"span","props":{},"children":["29"]},"Снижение веса, отказ от курения и контроль уровня сахара и давления способствуют улучшению эректильной функции"]},{"tag":"a","props":{"href":"/ru/tip/01-30"},"children":[{"tag":"span","props":{},"children":["30"]},"Использование презервативов на протяжении всего полового акта, а также отказ от совместного использования игл"]},{"tag":"a","props":{"href":"/ru/tip/01-31"},"children":[{"tag":"span","props":{},"children":["31"]},"Пройдите тестирование на ВИЧ, если у вас были рискованные контакты: Центр по контролю заболеваний делает это бесплатно, а результаты остаются конфиденциальными"]},{"tag":"a","props":{"href":"/ru/tip/01-32"},"children":[{"tag":"span","props":{},"children":["32"]},"Как только возникла мысль о самоубийстве, сразу расскажите об этом близкому человеку и отдайте эти несколько десятков минут ему"]},{"tag":"a","props":{"href":"/ru/tip/01-33"},"children":[{"tag":"span","props":{},"children":["33"]},"Не стоит воспринимать «спасение жизни» как гарантию: при отравлении паракватом или угарным газом в отделении неотложной помощи удаётся спасти жизнь, но лёгкие и мозг часто повреждаются необратимо"]},{"tag":"a","props":{"href":"/ru/tip/01-34"},"children":[{"tag":"span","props":{},"children":["34"]},"Не стоит рассчитывать на быстрое выздоровление после падения с высоты: большинство пациентов, попавших в травматологическое отделение интенсивной терапии, выживают, но цена этого — годы жизни"]},{"tag":"a","props":{"href":"/ru/tip/01-35"},"children":[{"tag":"span","props":{},"children":["35"]},"Не стоит обменивать «отсутствие одной почки» на деньги: оставшаяся почка теперь выполняет работу за две, а 86% людей, продавших почку, позже отмечают ухудшение здоровья"]},{"tag":"a","props":{"href":"/ru/tip/01-36"},"children":[{"tag":"span","props":{},"children":["36"]},"Не подбирайте, не разбирайте и не продавайте металлические детали неизвестного происхождения; держитесь подальше от зон с предупреждающими знаками в виде клевера"]},{"tag":"a","props":{"href":"/ru/tip/01-37"},"children":[{"tag":"span","props":{},"children":["37"]},"Когда вы берете в долг, чтобы продолжить играть, и находитесь в подавленном состоянии, сначала позвоните по номеру 12356, а затем передайте свои банковские карты и пароли от платежных систем членам семьи для контроля"]},{"tag":"a","props":{"href":"/ru/tip/01-38"},"children":[{"tag":"span","props":{},"children":["38"]},"Для МСМ с высоким риском сексуального контакта: обращение в специализированные центры по вопросам ПКП (доконтактной профилактики) позволяет снизить риск заражения ВИЧ более чем на 70%"]},{"tag":"a","props":{"href":"/ru/tip/01-39"},"children":[{"tag":"span","props":{},"children":["39"]},"Женщинам 65 лет и старше сделайте рентгеновскую денситометрию (DXA); женщинам после менопаузы с факторами риска остеопороза не обязательно ждать 65 лет"]},{"tag":"a","props":{"href":"/ru/tip/01-40"},"children":[{"tag":"span","props":{},"children":["40"]},"При остеопорозе или переломе от лёгкого падения попросите врача назначить противоостеопоротические препараты и принимайте их, не заменяя лечение одними кальцием"]},{"tag":"a","props":{"href":"/ru/tip/01-41"},"children":[{"tag":"span","props":{},"children":["41"]},"Перед выходом на дикий лёд необходимо просверлить отверстия и измерить его толщину — не стоит выходить, если она меньше 15 см. Избегайте льда на реках и вблизи лунок для ловли рыбы"]},{"tag":"a","props":{"href":"/ru/tip/01-42"},"children":[{"tag":"span","props":{},"children":["42"]},"Перед работой с болгаркой установите кожух, наденьте защитные очки и лицевой щиток, держите ее двумя руками и не ставьте пильный диск для дерева"]},{"tag":"a","props":{"href":"/ru/tip/01-43"},"children":[{"tag":"span","props":{},"children":["43"]},"Прямо спросите человека, чьё состояние вызывает тревогу: «Ты думал о самоубийстве?» Вопрос не усиливает это желание"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"Навигация"},"children":[{"tag":"a","props":{"href":"/ru/book"},"children":["Книга"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/ru/book/01"},"children":["Глава 1"," ·"," ","Как не умереть раньше времени"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"01-26"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["26"]},{"tag":"span","props":{"className":"life-evidence grade-b"},"children":["Доказательства"," ","B"]}]},{"tag":"h1","props":{"lang":"ru"},"children":["Подготовьте огнетушитель, огнезащитное одеяло, респиратор для эвакуации и аптечку первой помощи, проверяя их раз в год"]},{"tag":"p","props":{"lang":"ru","className":"life-entry-summary"},"children":["Огнетушители, огнезащитные одеяла, респираторы для эвакуации и аптечки первой помощи входят в список из 11 предметов для домашней подготовки к чрезвычайным ситуациям, утвержденный Министерством по чрезвычайным ситуациям. Все это можно приобрести за несколько сотен юаней один раз. В исследованиях, где специалисты проводили дома консультации по безопасности, уровень травматизма снижался примерно на четверть."]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Затраты"]},{"tag":"p","props":{},"children":["Один огнетушитель, одно огнезащитное одеяло, по одному рес…"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Польза"]},{"tag":"p","props":{},"children":["В рекомендованном Министерством по чрезвычайным ситуациями списке из 11 предметов для домашней подготовки указ…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"Отметить: Подготовьте огнетушитель, огнезащитное одеяло, респиратор для эвакуации и аптечку первой помощи, проверяя их раз в год"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"Сделано"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"В планах"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"В избранное"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Поделиться советом"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Скрыть подробности"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Затраты"]},{"tag":"p","props":{},"children":["Один огнетушитель, одно огнезащитное одеяло, по одному респиратору на каждого члена семьи и одна аптечка первой помощи обойдутся примерно в несколько сотен юаней. Покупается всё это один раз, а дальше достаточно тратить всего десять минут в год на проверку."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Польза"]},{"tag":"p","props":{},"children":["В рекомендованном Министерством по чрезвычайным ситуациями списке из 11 предметов для домашней подготовки указано, что «огнетушители и огнезащитные одеяла» используются для «тушения пожара на ранней стадии», а также отмечено, что «огнезащитное одеяло можно накинуть на себя при эвакуации». «Респираторы для эвакуации» — это «противодымные респираторы для спасения жизни при пожаре». «Наружные медикаменты» включают «порошок для остановки кровотечения, пластыри, марлевые бинты и прочее для обработки ран». В метаанализе Cochrane были собраны данные по 98 исследованиям с участием 2 605 044 человек. В результате внедрения мер по повышению домашней безопасности уровень травматизма снизился до показателя IRR 0.89. Доверительный интервал составляет 95% CI от 0.78 до 1.01. В тех исследованиях, где специалисты проводили консультации на дому, уровень травматизма снижался примерно на 25% (IRR 0.75, 95% CI от 0.62 до 0.91)."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Первоисточники"]},{"tag":"p","props":{"className":"life-citations"},"children":["应急管理部 (2020). 全国基础版家庭应急物资储备建议清单. ",{"tag":"a","props":{"href":"https://www.mem.gov.cn/kp/shaq/202011/t20201129_372149.shtml","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.mem.gov.cn/kp/shaq/202011/t20201129_372149.shtml"]}," ; Kendrick D 等 (2012). Home safety education and provision of safety equipment for injury prevention. Cochrane Database of Systematic Reviews. ",{"tag":"a","props":{"href":"https://doi.org/10.1002/14651858.CD005014.pub3","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.1002/14651858.CD005014.pub3"]}," ; 武胜县市场监督管理局 (2025). 手提式灭火器、防火门（窗）、点型感温（烟）火灾探测器消费提示. ",{"tag":"a","props":{"href":"https://www.wusheng.gov.cn/gasylbzj/c109568/zzzq/content/content_1988424970198126592.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.wusheng.gov.cn/gasylbzj/c109568/zzzq/content/content_1988424970198126592.html"]}," ; 贵州省消防救援总队 (2025). 居家必备灭火毯 功能用法全攻略（转载北京消防）. ",{"tag":"a","props":{"href":"https://gz.119.gov.cn/xfkp/xfcs/202503/t20250313_87157898.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://gz.119.gov.cn/xfkp/xfcs/202503/t20250313_87157898.html"]}," ; NVWA (2014). Blusdekens oktober 2014（荷兰食品与消费品安全局检查报告，原页面已下线，链接为 2021 年 10 月 20 日的网页存档）. ",{"tag":"a","props":{"href":"https://web.archive.org/web/20211020154732/https://www.nvwa.nl/binaries/nvwa/documenten/consument/consumentenartikelen/non-food/overige-non-food/blusdekens-oktober-2014/Factsheet+Blusdekens+Oktober+2014.pdf","target":"_blank","rel":"noopener noreferrer"},"children":["https://web.archive.org/web/20211020154732/https://www.nvwa.nl/binaries/nvwa/documenten/consument/consumentenartikelen/non-food/overige-non-food/blusdekens-oktober-2014/Factsheet+Blusdekens+Oktober+2014.pdf"]}]},{"tag":"a","props":{"href":"https://www.mem.gov.cn/kp/shaq/202011/t20201129_372149.shtml","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Открыть источник"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Примечание автора"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["Спорный вопрос. В том же обзоре Cochrane при вмешательствах без выдачи оборудования частота травм была примерно на 20% ниже. Исходная оценка — IRR 0.78, 95% ДИ от 0.66 до 0.92. Группа, которой выдали оборудование, не показала лучших результатов. Травмы уменьшались главным образом благодаря обучению и изменениям обстановки во время визитов на дом, поэтому польза оборудования оценена как «средняя», а не «большая». Покупая огнетушитель, ищите знак CCC; у закачного огнетушителя стрелка должна находиться в зелёной зоне. Большинство противопожарных одеял изготовлены из стекловолокна: держитесь только за две вытяжные ленты и не трогайте полотно голыми руками. Применение такого одеяла при возгорании масла в сковороде тоже спорно: в 2014 году нидерландский регулятор проверил 22 марки, и при использовании обычным человеком ни одна не обеспечивала надёжного тушения. Если загорелось масло в сковороде, сначала выключите нагрев и накройте её крышкой. О дымовых извещателях и датчиках угарного газа см. пункт 3 этого раздела. О применении жгута — пункт 12 раздела 13. Как выбирать каждый предмет, где его хранить и через сколько лет менять, см. ",{"tag":"a","props":{"href":"/ru/articles/home-emergency-kit"},"children":["docs/家庭应急装备清单.md"]},"."]}]}]},{"tag":"section","props":{"