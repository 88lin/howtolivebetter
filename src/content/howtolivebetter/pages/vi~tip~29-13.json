ren":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Chi phí"]},{"tag":"p","props":{},"children":["Không tốn tiền, chỉ là làm rõ cái sổ sách này."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Lợi ích"]},{"tag":"p","props":{},"children":["Điều 44 của Luật Bảo hiểm quy định về những hợp đồng có điều kiện trả tiền bảo hiểm là khi người được bảo hiểm chết. Tính từ ngày hợp đồng được lập hoặc ngày hiệu lực của hợp đồng được khôi phục, nếu người được bảo hiểm tự sát trong vòng hai năm thì công ty bảo hiểm không phải trả tiền bảo hiểm. Trường hợp người được bảo hiểm tự sát khi chưa có năng lực hành vi dân sự, tức người mà pháp luật không công nhận chịu trách nhiệm cho hành vi của mình, thì không thuộc trường hợp trên. Trường hợp này công ty bảo hiểm phải hoàn lại giá trị tiền mặt của hợp đồng theo thỏa thuận, tức chỉ hoàn lại phần tiền mà hợp đồng cho hoàn lại, không trả mứn bảo hiểm. Mứn bảo hiểm của hợp đồng bảo hiểm nhân thọ thường ở mức hàng chục vạn tệ, vì vậy cỡ lợi ích được ghi là lớn. Khoản thứ ba của Điều 16 Quy định về bảo hiểm tai nạn lao động quy định: tự tàn tật hoặc tự sát thì không được công nhận là tai nạn lao động, cũng không được coi là tai nạn lao động. Ba khoản trợ cấp khi chết vì tai nạn lao động quy định ở Điều 39 vì thế mất trắng cả ba. Một là trợ cấp mai táng, trả bằng 6 tháng lương tháng bình quân của người lao động năm trước ở địa phương. Hai là trợ cấp hưu trí cho người được nuôi dưỡng. Ba là trợ cấp một lần khi chết vì tai nạn lao động, bằng 20 lần thu nhập khả dụng bình quân đầu tư dân của dân đô thị cả nước trong năm trước. Điều 1159 của Bộ luật Dân sự quy định: khi chia tài sản thì phải lấy tài sản để bù cho khoản thuế và nợ mà người đã mất có nghĩa vụ phải nộp theo pháp luật, tức lấy tài sản trước để trả thuế và trả nợ, phần còn lại mới chia. Điều 1161 quy định: người thừa kế trả nợ trong phạm vi giá trị thực tế của tài sản được thừa kế, tức chỉ lấy đúng phần được thừa kế ra trả, không phải bỏ thêm tiền của mình vào, và người từ bỏ thừa kế thì không phải chịu trách nhiệm trả nợ"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Nguồn gốc"]},{"tag":"p","props":{"className":"life-citations"},"children":["全国人大常委会 (2015 修正). 中华人民共和国保险法第四十四条. ",{"tag":"a","props":{"href":"https://flk.npc.gov.cn/detail?id=2c909fdd678bf17901678bf7c4060811","target":"_blank","rel":"noopener noreferrer"},"children":["https://flk.npc.gov.cn/detail?id=2c909fdd678bf17901678bf7c4060811"]},"；国务院 (2010 修订). 工伤保险条例（国务院令第 586 号）第十六条、第三十九条. ",{"tag":"a","props":{"href":"https://www.gov.cn/gongbao/content/2011/content_1778064.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/gongbao/content/2011/content_1778064.htm"]},"；全国人大 (2020). 中华人民共和国民法典第一千一百五十九条、第一千一百六十一条. ",{"tag":"a","props":{"href":"https://flk.npc.gov.cn/detail?id=ff808081729d1efe01729d50b5c500bf","target":"_blank","rel":"noopener noreferrer"},"children":["https://flk.npc.gov.cn/detail?id=ff808081729d1efe01729d50b5c500bf"]}]},{"tag":"a","props":{"href":"https://flk.npc.gov.cn/detail?id=2c909fdd678bf17901678bf7c4060811","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Liên kết mở nguồn"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Ghi chú sách"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["Ở đây chỉ tính đúng khoản tiền. Mục khác của phần này và của phần 1 nói về việc đừng đi tới bước đó. Điều 44 của Luật Bảo hiểm chỉ nói tới hai năm đầu, viết ra là để nêu đủ điều khoản chứ không phải để đưa ra một cái thời hạn. Cái giá sức khoẻ cho người nhà xem mục 4 của phần này (người có vợ chồng chết vì tự sát thì trong 5 năm đầu nguy cơ mắc rối loạn tâm thần mới cao hơn bảy đến tám mươi phần trăm). Ý nghĩ đó vừa xuất hiện thì làm gì xem mục 25 và 32 ở phần 1, di chứng sau khi cứu lại xem mục 33 ở phần 1. Tiêu chuẩn ba khoản tiền khi chết vì tai nạn lao động xem mục 15 ở phần 19. Thủ tục cụ thể cho tài sản thừa kế và nợ nợ xem mục 9 ở phần 25 (đi từng nơi một để lấy quỹ tích góp nhà ở và các quyền lợi bảo hiểm xã hội)"]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Ghi chú của tôi"]},{"tag":"button","props":{"type":"button"},"children":["Viết một lời nhắc cho chính bạn…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/vi/tip/29-12"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Trước"]},"Trong ba tháng đầu sau biến cố, mọi quyết định lớn không thể đảo ngược đều đẩy lùi"]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["Thêm trong chủ đề này"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/29-06"},"children":[{"tag":"strong","props":{},"children":["Không có người thân cũng không có bạn bè thì thay「người canh giữ bạn」bằng ba thứ: hàng xóm có vào được nhà bạn, danh sách thăm viếng của cộng đồng, và người liên hệ khẩn cấp trong điện thoại"]},{"tag":"span","props":{},"children":["Khi không có người thân cũng không có bạn bè, có hai việc phải lo: có…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/29-07"},"children":[{"tag":"strong","props":{},"children":["Sau khi cha mẹ qua đời, nói thật với con, để con dự lễ tang, đừng đưa con đi nơi khác để «đổi không khí»"]},{"tag":"span","props":{},"children":["Trẻ mất cha hoặc mẹ trước 18 tuổi, khi bước vào đầu tuổi trưởng thành…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/29-08"},"children":[{"tag":"strong","props":{},"children":["Nỗi buồn kéo dài quá nửa năm vẫn đứng yên, ngày nào cũng không nổi, thì đi đăng ký khoa tâm thần hoặc tâm lý lâm sàng"]},{"tag":"span","props":{},"children":["Cứ khoảng mười người trưởng thành mất người thân thì có một người bị …"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/29-09"},"children":[{"tag":"strong","props":{},"children":["Đừng vội trả tiền làm tư vấn đau buồn, xem trước nỗi buồn của mình có thật sự bị kẹt không (các triệu chứng ở mục 8)"]},{"tag":"span","props":{},"children":["Sắp xếp tâm lý trị liệu cho tất cả người mất người thân thì lợi ích r…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/29-10"},"children":[{"tag":"strong","props":{},"children":["Sau khi sống xa nhau hoặc ly hôn, đừng để bảo hiểm y tế bị gián đoạn, đừng dựa vào rượu để chịu đựng"]},{"tag":"span","props":{},"children":["Người sống xa nhau hoặc ly hôn có xác suất chết sớm cao hơn rõ rệt ng…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/29-11"},"children":[{"tag":"strong","props":{},"children":["Muốn có người đ