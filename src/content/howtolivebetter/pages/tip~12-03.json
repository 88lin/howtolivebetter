6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["成本"]},{"tag":"p","props":{"className":"life-citations"},"children":["登记在当地政务服务网上办，一次几个小时。开了有限公司之后每个月要记账报税，这是长期的开销：自己做花时间，请人代记账花钱，各地价格不同。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["收益"]},{"tag":"p","props":{"className":"life-citations"},"children":["个体工商户欠的债，要拿个人的钱和东西还，或者拿全家的钱和东西还。普通合伙企业的合伙人，对合伙企业的债承担无限连带责任。意思是欠多少还多少，还不完不算完。债主还可以只揪住其中一个人，要他还全部。有限合伙不一样，里面的有限合伙人只赔到自己答应出的那笔钱（以认缴出资为限）为止。有限责任公司的股东也是只赔到自己答应出的那笔钱（以认缴出资额为限）。但「有限」会在三种情况下失效。一是答应出的钱要在公司成立起 5 年内真交齐，公司还不上到期的债时，债主可以要求提前交。二是已经投进去又抽走的钱（抽逃出资）要还回来。三是拿公司当壳子躲债、严重损害债主利益，这时公司的债你个人要跟着一起还（承担连带责任）。只有一个股东的公司更严：要由这个股东自己证明公司的钱和他自己的钱是分开的。证明不了，公司的债他个人就要跟着一起还。法院主要看钱和账分没分开。股东随便用公司的钱又不记账，公司账和个人账不分，都算混在一起（全国，2024 年 7 月起）"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["来源"]},{"tag":"p","props":{"className":"life-citations"},"children":["全国人大 (2020). 民法典（第五十六条）. ",{"tag":"a","props":{"href":"https://www.spp.gov.cn/spp/fl/202006/t20200602_463888.shtml","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.spp.gov.cn/spp/fl/202006/t20200602_463888.shtml"]},"；全国人大常委会 (2006). 合伙企业法（2006 年修订，第二条）. ",{"tag":"a","props":{"href":"http://www.gov.cn/gongbao/content/2006/content_413955.htm","target":"_blank","rel":"noopener noreferrer"},"children":["http://www.gov.cn/gongbao/content/2006/content_413955.htm"]},"；全国人大常委会 (2023). 公司法（2023 年修订，第四、二十三、四十七、五十三、五十四条；第二十三条第三款：「只有一个股东的公司，股东不能证明公司财产独立于股东自己的财产的，应当对公司债务承担连带责任。」）. ",{"tag":"a","props":{"href":"https://www.gov.cn/yaowen/liebiao/202312/content_6923395.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/yaowen/liebiao/202312/content_6923395.htm"]},"；最高人民法院 (2019). 全国法院民商事审判工作会议纪要（第 10 点「人格混同」）：「最主要的表现是公司的财产与股东的财产是否混同且无法区分」「公司账簿与股东账簿不分，致使公司财产与股东财产无法区分的」. ",{"tag":"a","props":{"href":"https://www.court.gov.cn/zixun/xiangqing/199691.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.court.gov.cn/zixun/xiangqing/199691.html"]},""]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["原书备注"]},{"tag":"p","props":{"className":"life-citations"},"children":["公司账户和个人账户分开用，客户货款别收到个人卡上，公司的钱别付家里的开销，账目留全。注册资本别为了好看填大数。"]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["我的备注"]},{"tag":"button","props":{"type":"button"},"children":["写下对自己有用的提醒…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/tip/12-02"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["上一条"]},"不给公司贷款签个人担保，配偶更不要跟着签"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/tip/12-04"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["下一条"]},"不当挂名股东，不替人代持股权"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["本主题的其他建议"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/12-01"},"children":[{"tag":"strong","props":{},"children":["只拿亏得起的钱创业，不动家底、不借钱开张"]},{"tag":"span","props":{},"children":["个体户欠的钱，要拿你自己名下的钱和东西还。分不清是不是全家一起做的，就拿全家的财产还。开公司也不保险：公司还不上债的时候，你当初答应出、还没到期的那笔出资，债主…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/12-05"},"children":[{"tag":"strong","props":{},"children":["加盟前先查商务部备案，拿到书面披露，把「冷静期」写进合同"]},{"tag":"span","props":{},"children":["按规定，品牌方自己得先开 2 个直营店、经营满 1 年，签约后 15 日内还要去商务部门备案。签约前，它必须把加盟费、保证金怎么退、现有门店赚不赚钱等 12 项…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/12-06"},"children":[{"tag":"strong","props":{},"children":["注册前把名称、经营场所、经营范围和注册资本定下来，材料齐了当场就能领执照"]},{"tag":"span","props":{},"children":["登记本身不花钱，注册费 2015 年起就停征了，有人收钱，收的也不是登记费。要交的材料只有五项：申请书、身份或资格证明、经营场所文件、章程或合伙协议，加上法规另…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/12-07"},"children":[{"tag":"strong","props":{},"children":["要许可证的行当，证没下来不开张"]},{"tag":"span","props":{},"children":["没证就开张，由管这张证的部门按它的法规查处。连营业执照都没有、又没有专门罚则的，勒令停业、没收挣到的钱，再罚 1 万元以下。卖专营专卖的东西，或者做证券、期货、…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/12-08"},"children":[{"tag":"strong","props":{},"children":["做食品先看自己落在哪一档：生产和做餐饮要许可，只卖预包装的改备案，卖生鲜肉菜不用证"]},{"tag":"span","props":{},"children":["自己做东西去卖，像小吃店、卤味、烘焙、自制酱菜，都要办许可，小作坊和摊贩按本省的规矩办。只卖别人做好的整包装食品不用许可，到县级以上市场监管部门备案就行。卖生鲜…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/tip/12-09"},"children":[{"tag":"strong","props":{},"children":["装袋卖就是预包装食品：标签上生产日期、保质期、配料表一样都不能少"]},{"tag":"span","props":{},"children":["食品装进包装再卖，法律上就叫预包装食品，包装上必须有标签，而且有九项必须标，生产日期和保质期都在里面。散装食品也要标名称、日期和卖家的名称地址。该标的没标，货值…"]}]}]}]},{"tag":"a","props":{"className":"life-text-link","href":"/book/12"},"children":["阅读整个主题：创业与做生意：别把家底赔进去 ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg",