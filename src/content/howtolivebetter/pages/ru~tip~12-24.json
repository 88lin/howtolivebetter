sName":"life-ad-layout life-ad-layout-toc"},"children":[{"tag":"div","props":{"className":"life-ad-rail","data-dock-active":"false","style":{"top":"94px"}},"children":[{"tag":"div","props":{"className":"life-ad-dock","hidden":true},"children":[{"tag":"aside","props":{"className":"life-ad-space life-ad-space-sponsored life-ad-space-compact","data-ad-placement":"ad_dock","data-ad-group":"reading","data-ad-creative":"read_product","data-ad-ready":"false","aria-label":"Реклама · Рекомендация сообщества"},"children":[{"tag":"button","props":{"type":"button","className":"life-ad-dismiss","aria-label":"Закрыть рекламу"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-x","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M18 6 6 18"},"children":[]},{"tag":"path","props":{"d":"m6 6 12 12"},"children":[]}]}]},{"tag":"div","props":{"className":"life-ad-space-brand"},"children":[{"tag":"img","props":{"src":"/sites/howtolivebetter/images/shengcai/logo.png","width":"565","height":"144","alt":"Официальный логотип Shengcai Youshu","decoding":"async"},"children":[]}]},{"tag":"div","props":{"className":"life-ad-space-copy"},"children":[{"tag":"span","props":{"className":"life-ad-space-label"},"children":["Реклама · Рекомендация сообщества"]},{"tag":"strong","props":{},"children":["Могут ли ваши знания стать полезным продуктом?"]},{"tag":"p","props":{},"children":["От электронных книг до инструментов: как участники находят потребности и создают то, чем можно пользоваться."]}]},{"tag":"div","props":{"className":"life-ad-space-actions"},"children":[{"tag":"a","props":{"className":"life-ad-space-link","href":"/ru/shengcaiyoushu?sc_group=reading&sc_creative=read_product&sc_placement=ad_dock"},"children":["О сообществе и примерах",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"18","height":"18","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-up-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M7 7h10v10"},"children":[]},{"tag":"path","props":{"d":"M7 17 17 7"},"children":[]}]}]}]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/ru/book/12"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"К содержанию"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["Открытие бизнеса: как не потерять все сбережения"]},{"tag":"div","props":{"data-ad-dock-host":"true"},"children":[]},{"tag":"nav","props":{"aria-label":"Советы главы"},"children":[{"tag":"a","props":{"href":"/ru/tip/12-01"},"children":[{"tag":"span","props":{},"children":["01"]},"Инвестируйте только те средства, которые можете позволить себе потерять — не трогайте семейные сбережения и не берите кредиты"]},{"tag":"a","props":{"href":"/ru/tip/12-02"},"children":[{"tag":"span","props":{},"children":["02"]},"Не ставьте личную гарантию за компанию, а супругу тем более не вовлекайте"]},{"tag":"a","props":{"href":"/ru/tip/12-03"},"children":[{"tag":"span","props":{},"children":["03"]},"Правильный выбор формы бизнеса до открытия: при индивидуальном предпринимательстве и обычном партнерстве ответственность неограниченна, а в ООО она «ограничена»"]},{"tag":"a","props":{"href":"/ru/tip/12-04"},"children":[{"tag":"span","props":{},"children":["04"]},"Неправомерное включение в число акционеров — риск нести чужие долги"]},{"tag":"a","props":{"href":"/ru/tip/12-05"},"children":[{"tag":"span","props":{},"children":["05"]},"Перед подписанием договора проверьте наличие регистрации в Министерстве коммерции и получите письменную информацию; обязательно включите в договор условие о «периоде раздумий»"]},{"tag":"a","props":{"href":"/ru/tip/12-06"},"children":[{"tag":"span","props":{},"children":["06"]},"Перед регистрацией нужно определить название, место ведения бизнеса, сферу деятельности и размер уставного капитала — при наличии всех документов бизнес-лицензию выдадут сразу"]},{"tag":"a","props":{"href":"/ru/tip/12-07"},"children":[{"tag":"span","props":{},"children":["07"]},"Бизнес, требующий лицензии: начинать работу можно только после её получения"]},{"tag":"a","props":{"href":"/ru/tip/12-08"},"children":[{"tag":"span","props":{},"children":["08"]},"Определите, к какой категории вы относитесь: для производства продуктов питания и ресторанного бизнеса требуется разрешение, для продажи только готовой упакованной продукции достаточно регистрации, а для продажи свежих овощей и мяса разрешение не нужно"]},{"tag":"a","props":{"href":"/ru/tip/12-09"},"children":[{"tag":"span","props":{},"children":["09"]},"Упаковка продукта делает его предварительно упакованной пищевой продукцией: на этикетке обязательно указываются дата производства, срок годности и состав"]},{"tag":"a","props":{"href":"/ru/tip/12-10"},"children":[{"tag":"span","props":{},"children":["10"]},"На обычные продукты питания нельзя указывать, что они лечат болезни: это касается этикеток, инструкций, рекламы и текстов для прямых трансляций"]},{"tag":"a","props":{"href":"/ru/tip/12-11"},"children":[{"tag":"span","props":{},"children":["11"]},"В этой сфере действуют уголовные нормы: продажа мяса от больных животных или продукции с превышенным содержанием вредных веществ уже является преступлением; добавление в пищу токсичных и вредных веществ влечет наказание от 5 лет лишения свободы независимо от суммы оборота"]},{"tag":"a","props":{"href":"/ru/tip/12-12"},"children":[{"tag":"span","props":{},"children":["12"]},"После получения бизнес-лицензии возникает обязанность по подаче налоговой отчетности; даже при отсутствии дохода её нужно подавать с нуля (заполняя все поля нулями)"]},{"tag":"a","props":{"href":"/ru/tip/12-13"},"children":[{"tag":"span","props":{},"children":["13"]},"Счета-фактуры выписываются только по реальным сделкам; малые предприятия могут полностью освободиться от НДС"]},{"tag":"a","props":{"href":"/ru/tip/12-14"},"children":[{"tag":"span","props":{},"children":["14"]},"Мошенники выдают себя за сотрудников налоговой службы и требуют оплаты и подачи деклараций; на самом деле это обман. Официальные каналы для налоговых дел — электронная налоговая система и горячая линия 12366"]},{"tag":"a","props":{"href":"/ru/tip/12-15"},"children":[{"tag":"span","props":{},"children":["15"]},"При написании «задаток» вместо «предоплата» соблюдайте правила двойного возврата, четко пропишите размер неустойки, а предоставление отсрочки платежа рассматривайте как выдачу займа"]},{"tag":"a","props":{"href":"/ru/tip/12-16"},"children":[{"tag":"span","props":{},"children":["16"]},"Заключение письменного трудового договора в первый месяц работы и регистрация в соцстрахе в течение 30 дней"]},{"tag":"a","props":{"href":"/ru/tip/12-17"},"children":[{"tag":"span","props":{},"children":["17"]},"Зарплата выплачивается согласно договору и закону; повышения, займы и премии оформляются письменно"]},{"tag":"a","props":{"href":"/ru/tip/12-18"},"children":[{"tag":"span","props":{},"children":["18"]},"Продавать сначала, а потом производить: проверить спрос через предзаказы и мелкие заказы, прежде чем вкладывать средства в производство"]},{"tag":"a","props":{"href":"/ru/tip/12-19"},"children":[{"tag":"span","props":{},"children":["19"]},"Сначала сверяем образец с перечнем требований для массового производства, а потом приступаем к запуску"]},{"tag":"a","props":{"href":"/ru/tip/12-20"},"children":[{"tag":"span","props":{},"children":["20"]},"Сохраняйте документы и эти поставщика; не закупайте товары по цене, значительно ниже рыночной: если сотрудник привез подделку, ответственность несет руководитель"]},{"tag":"a","props":{"href":"/ru/tip/12-21"},"children":[{"tag":"span","props":{},"children":["21"]},"Для товаров, упаковки, этикеток и рекламных изображений нужно либо создавать графику самостоятельно, либо покупать лицензию; изменение цвета или добавление своего значка не считается «изменением»"]},{"tag":"a","props":{"href":"/ru/tip/12-22"},"children":[{"tag":"span","props":{},"children":["22"]},"Соблюдение установленных правил на рабочем месте и чёткое понимание ответственности при проявлении доброй воли вне этих рамок"]},{"tag":"a","props":{"href":"/ru/tip/12-23"},"children":[{"tag":"span","props":{},"children":["23"]},"Если убытки — действуйте по процедуре: при возможности проводите упрощённую ликвидацию, а если активы не покрывают долги — подавайте на банкротство, не оставляйте дело без внимания"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/ru/tip/12-24","data-status":"active"},"children":[{"tag":"span","props":{},"children":["24"]},"Прежде чем тратить деньги на аутсорсинг управления интернет-магазином, курсы по открытию магазина или схему «без собственного товара», выясните, потребуются ли дополнительные расходы и откуда возьмётся продажная статистика"]},{"tag":"a","props":{"href":"/ru/tip/12-25"},"children":[{"tag":"span","props":{},"children":["25"]},"Компании и индивидуальные предприниматели в Китае ежегодно с 1 января по 30 июня подают онлайн отчёт за прошлый год, даже без деятельности; отчёт бесплатен"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"Навигация"},"children":[{"tag":"a","props":{"href":"/ru/book"},"children":["Книга"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/ru/book/12"},"children":["Глава 12"," ·"," ","Открытие бизнеса: как не потерять все сбережения"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"12-24"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["24"]},{"tag":"span","props":{"className":"life-evidence grade-b"},"children":["Доказательства"," ","B"]}]},{"tag":"h1","props":{"lang":"ru"},"children":["Прежде чем тратить деньги на аутсорсинг управления интернет-магазином, курсы по открытию магазина или схему «без собственного товара», выясните, потребуются ли дополнительные расходы и откуда возьмётся продажная статистика"]},{"tag":"p","props":{"lang":"ru","className":"life-entry-summary"},"children":["В таких схемах сначала берут небольшую сумму, а затем под предлогом «премиум-пакетов», предоплаты за товар или «разморозки» счёта заставляют клиента вносить деньги снова и снова. Заказы и доходы в личном кабинете часто подделываются, а при попытке вывести средства выясняется, что это невозможно. Использование фейковых заказов для накрутки продаж — незаконно, и виновные в этом аутсорсеры подлежат наказанию."]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Затраты"]},{"tag":"p","props":{},"children":["Платить не нужно. Однако перед оплатой обязательно получит…"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Польза"]},{"tag":"p","props":{},"children":["Высший народный суд провинции Гуандун вынес решение по делу о подобном мошенничестве. Целых 55 человек, включа…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"Отметить: Прежде чем тратить деньги на аутсорсинг управления интернет-магазином, курсы по открытию магазина или схему «без собственного товара», выясните, потребуются ли дополнительные расходы и откуда возьмётся продажная статистика"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"Сделано"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"В планах"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"В избранное"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Поделиться советом"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Скрыть подробности"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Затраты"]},{"tag":"p","props":{},"children":["Платить не нужно. Однако перед оплатой обязательно получите три документа: письменный договор, полное официальное название компании и условия возврата денег. Оплату следует производить только той компании, которая указана в договоре, а не на личные счета. Сложнее всего удержаться от немедленной оплаты, когда вам показывают скриншоты «дохода в десятки тысяч в месяц у других учеников»."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Польза"]},{"tag":"p","props":{},"children":["Высший народный суд провинции Гуандун вынес решение по делу о подобном мошенничестве. Целых 55 человек, включая Цзян и Сюй, открыли несколько компаний в Гуанчжоу, Наньнине и Ханчжоу. Суд признал, что они «прекрасно понимали, что не обладают ни способностями, ни техническими условиями для аутсорсинга в электронной коммерции». Тем не менее они под видом обслуживания магазинов на Taobao обманули 7711 потерпевших, продавая им «пакеты услуг». В итоге было выманено более 52,99 млн юаней. Двух главных виновников приговорили к 14 и 13,5 годам лишения свободы по статье о мошенничестве. Суд отметил, что схема была продумана «до мелочей», а «многие жертвы попадались на неё по нескольку раз». В 2025 году департамент общественной безопасности провинции Цзянсу описал четыре этапа подобного мошенничества в сфере трансграничной электронной коммерции. Первый этап — публикация в соцсетях обещаний «без опыта» и «без необходимости закупать товар». Второй — добавление вас в друзья под видом «консультанта по управлению», после чего предлагается скачать определённую платформу. Третий — после открытия магазина появляется первый заказ, и вам предлагают оплатить себестоимость товара, ссылаясь на то, что деньги покупателя «заморожены» на платформе и разблокируются после получения товара. Затем в системе создаётся масса фейковых заказов, требующих от вас всё новых вложений. На четвёртом этапе, когда вы хотите вывести средства, вам сообщают о «нарушениях в аккаунте» или «технических работах», требуя оплатить «разморозку» и комиссию. В одном из случаев госпожа Чжан внесла более 900 тыс. юаней, а через три дня сайт перестал работать. Что касается накрутки заказов: одна компания-аутсорсер организовывала фиктивные групповые покупки для повышения рейтинга магазинов. Антимонопольная служба оштрафовала её на 100 тыс. юаней, а платформа удержала 50 тыс. юаней из гарантийного депозита; суд поддержал такое решение. В 2026 году Верховный народный суд включил это дело в список типичных примеров, отметив, что «фиктивные сделки и накрутка рейтингов прямо запрещены законом». В 2025 году Государственное управление по регулированию рынка также рассмотрело дело компании, продававшей программное обеспечение типа «одним кликом перенести магазин» и «одним кликом отправить заказ». Она автоматически копировала товарные данные с других платформ, за что была оштрафована на 530 тыс. юаней. Управление предупредило бизнес, что «запрещено применять схемы вроде „кражи магазина“ или „ведения бизнеса без собственного товара“». Выход из ситуации указан в Гражданском кодексе: если договор был подписан под влиянием обмана, вы можете обратиться в суд или арбитражную комиссию с требованием его аннулировать. Сделать это нужно в течение года с момента, когда вы узнали об обмане. После аннулирования договора все полученные от вас средства должны быть возвращены (по всей стране)."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Первоисточники"]},{"tag":"p","props":{"className":"life-citations"},"children":["广东省高级人民法院 (2023). 广东法院打击治理电信网络诈骗犯罪典型案例（案例三：蒋某、徐某等 55 人犯罪集团诈骗案）. ",{"tag":"a","props":{"href":"https://www.gdcourts.gov.cn/gsxx/quanweifabu/anlihuicui/content/post_1388464.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gdcourts.gov.cn/gsxx/quanweifabu/anlihuicui/content/post_1388464.html"]},"；江苏省公安厅 (2025). 防范提示：无货源跨境电商，当心有诈！. ",{"tag":"a","props":{"href":"https://gat.jiangsu.gov.cn/art/2025/2/13/art_89956_11491354.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://gat.jiangsu.gov.cn/art/2025/2/13/art_89956_11491354.html"]},"；最高人民法院 (2026). 最高人民法院发布依法规范平台经营、保护消费者合法权益典型案例（案例三：某代运营商诉某平台服务合同纠纷案）. ",{"tag":"a","props":{"href":"https://www.court.gov.cn/zixun/xiangqing/507691.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.court.gov.cn/zixun/xiangqing/507691.html"]},"；市场监管总局 (2025). 市场监管总局公布五起网络不正当竞争典型案例（案例一）. ",{"tag":"a","props":{"href":"https://www.samr.gov.cn/xw/zj/art/2025/art_0d043840ec9445a689496bcf30c94820.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.samr.gov.cn/xw/zj/art/2025/art_0d043840ec9445a689496bcf30c94820.html"]},"；全国人大 (2020). 民法典（第一百四十八、一百五十二、一百五十七条）. ",{"tag":"a","props":{"href":"https://www.spp.gov.cn/spp/fl/202006/t20200602_463888.shtml","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.spp.gov.cn/spp/fl/202006/t20200602_463888.shtml"]}]},{"tag":"a","props":{"href":"https://www.gdcourts.gov.cn/gsxx/quanweifabu/anlihuicui/content/post_1388464.html","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Открыть источник"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Примечание автора"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["Если видите фразы «без опыта», «без необходимости закупать товар», «малые вложения — большие доходы» или «гарантированная прибыль», немедленно остановитесь. Также прекратите действия, если вас просят вносить предоплату за товар на указанную ими платформу. Перед оплатой проверьте лицензию и историю штрафов компании в Национальной системе информации о кредитах предприятий. В договоре обязательно пропишите перечень услуг и условия возврата денег. Сохраните переписку, текст договора и скриншоты переводов. Если вы уже перевели средства, немедленно звоните на 110 или 96110, чтобы заблокировать транзакцию (см. раздел 8, пункт 2 «Блокировка мошеннических платежей»). Если аутсорсер действительно выполнил работу, но результат оказался слабым, скорее всего это спор о качестве услуг, решаемый через переговоры, жалобы или суд. Для аннулирования договора потребуется судебное разбирательство: стандартный срок рассмотрения дела — от 6 месяцев, оплата услуг адвоката ложится на вас, а ответчик может просто исчезнуть до вынесения решения. Если вам предлагают оплату под видом франчайзинга, сначала проверьте наличие регистрации в Министерстве коммерции по правилам из раздела 5. В любом случае основная выгода остаётся на вашей стороне. 〔52994000〕"]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Моя заметка"]},{"tag":"button","props":{"type":"button"},"children":["Запишите напоминание…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/ru/tip/12-23"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Предыдущий"]},"Если убытки — действуйте по процедуре: при возможности проводите упрощённую ликвидацию, а если активы не покрывают долги — подавайте на банкротство, не оставляйте дело без внимания"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/ru/tip/12-25"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Следующий"]},"Компании и индивидуальные предприниматели в Китае ежегодно с 1 января по 30 июня подают онлайн отчёт за прошлый год, даже без деятельности; отчёт бесплатен"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["Другие советы по этой теме"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/12-17"},"children":[{"tag":"strong","props":{},"children":["Зарплата выплачивается согласно договору и закону; повышения, займы и премии оформляются письменно"]},{"tag":"span","props":{},"children":["Зарплату нужно выплачивать вовремя и в полном объеме согласно договор…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/12-18"},"children":[{"tag":"strong","props":{},"children":["Продавать сначала, а потом производить: проверить спрос через предзаказы и мелкие заказы, прежде чем вкладывать средства в производство"]},{"tag":"span","props":{},"children":["В течение года наблюдали за 116 новыми итальянскими компаниями. Предп…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ru/tip/12-19"},"children":[{"tag":"strong","props":{},"children":["Сначала сверяем образец с перечнем требований для массового производства, а потом приступаем к запуску"]},{"tag":"span","props":{},"children":["Разница между прои