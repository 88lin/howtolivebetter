ook/01"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"目次に戻る"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["早死を避けるために"]},{"tag":"div","props":{"data-ad-dock-host":"true"},"children":[]},{"tag":"nav","props":{"aria-label":"この章のヒント"},"children":[{"tag":"a","props":{"href":"/ja/tip/01-01"},"children":[{"tag":"span","props":{},"children":["01"]},"シートベルトを着用しましょう、前席も後席も"]},{"tag":"a","props":{"href":"/ja/tip/01-02"},"children":[{"tag":"span","props":{},"children":["02"]},"バイクや電動自転車ではヘルメットを正しく着用し、あご紐を締める"]},{"tag":"a","props":{"href":"/ja/tip/01-03"},"children":[{"tag":"span","props":{},"children":["03"]},"煙感知器を設置する。冬場に室内で石炭やガスを使用する場合は、一酸化炭素警報器も併せて設置する"]},{"tag":"a","props":{"href":"/ja/tip/01-04"},"children":[{"tag":"span","props":{},"children":["04"]},"ガスホースとコンロは期限が来たら交換。配管の自作改造はNG。ガス会社による訪問販売は断ってOK"]},{"tag":"a","props":{"href":"/ja/tip/01-05"},"children":[{"tag":"span","props":{},"children":["05"]},"野生のキノコは採らない、買わない、食べない。「伝承の判別法」は一切通用しない"]},{"tag":"a","props":{"href":"/ja/tip/01-06"},"children":[{"tag":"span","props":{},"children":["06"]},"電動自転車を廊下に置かない、エレベーターに乗せない、室内で充電しない"]},{"tag":"a","props":{"href":"/ja/tip/01-07"},"children":[{"tag":"span","props":{},"children":["07"]},"血圧を測定し、高ければ薬を飲んで目標値まで下げる"]},{"tag":"a","props":{"href":"/ja/tip/01-08"},"children":[{"tag":"span","props":{},"children":["08"]},"35 歳以降、過体重であれば空腹時血糖を一度検査し、正常であっても3年ごとに再検査する"]},{"tag":"a","props":{"href":"/ja/tip/01-09"},"children":[{"tag":"span","props":{},"children":["09"]},"スピード超過や飲酒運転をしない"]},{"tag":"a","props":{"href":"/ja/tip/01-10"},"children":[{"tag":"span","props":{},"children":["10"]},"車に乗るときは4歳以下の子どもをチャイルドシートに座らせ、抱っこしない"]},{"tag":"a","props":{"href":"/ja/tip/01-11"},"children":[{"tag":"span","props":{},"children":["11"]},"お子さんがいる家庭は窓やベランダにストッパーを。網戸は防護策になりません"]},{"tag":"a","props":{"href":"/ja/tip/01-12"},"children":[{"tag":"span","props":{},"children":["12"]},"子供を水辺から目を離さない。ボートや水泳の際はライフジャケットを着用"]},{"tag":"a","props":{"href":"/ja/tip/01-13"},"children":[{"tag":"span","props":{},"children":["13"]},"60歳以上はバランス運動と脚力トレーニングを。自宅の浴室や階段を改修する"]},{"tag":"a","props":{"href":"/ja/tip/01-14"},"children":[{"tag":"span","props":{},"children":["14"]},"B型肝炎ウイルス抗体検査を受け、抗体がなければワクチンを接種する"]},{"tag":"a","props":{"href":"/ja/tip/01-15"},"children":[{"tag":"span","props":{},"children":["15"]},"釘や木刺による怪我、または傷口に土が付着した場合は、当日中に処置を行い、あわせて破傷風ワクチンの必要性を医師に確認する"]},{"tag":"a","props":{"href":"/ja/tip/01-16"},"children":[{"tag":"span","props":{},"children":["16"]},"女性のHPVワクチン接種は、早ければ早いほど良い"]},{"tag":"a","props":{"href":"/ja/tip/01-17"},"children":[{"tag":"span","props":{},"children":["17"]},"女性は40歳から乳がん検診を、2年に1度のマンモグラフィを"]},{"tag":"a","props":{"href":"/ja/tip/01-18"},"children":[{"tag":"span","props":{},"children":["18"]},"30歳以上の女性は子宮頸がん検診において、HPV検査を優先"]},{"tag":"a","props":{"href":"/ja/tip/01-19"},"children":[{"tag":"span","props":{},"children":["19"]},"45歳から50歳から大腸がん検診を開始、便潜血検査（FIT）または大腸内視鏡検査を行う"]},{"tag":"a","props":{"href":"/ja/tip/01-20"},"children":[{"tag":"span","props":{},"children":["20"]},"心血管疾患患者および高齢者は毎年インフルエンザワクチンを接種"]},{"tag":"a","props":{"href":"/ja/tip/01-21"},"children":[{"tag":"span","props":{},"children":["21"]},"50 歳以降の帯状疱疹ワクチン接種"]},{"tag":"a","props":{"href":"/ja/tip/01-22"},"children":[{"tag":"span","props":{},"children":["22"]},"65 歳以上への肺炎球菌ワクチン接種"]},{"tag":"a","props":{"href":"/ja/tip/01-23"},"children":[{"tag":"span","props":{},"children":["23"]},"ピロリ菌を検査し、陽性なら除菌する"]},{"tag":"a","props":{"href":"/ja/tip/01-24"},"children":[{"tag":"span","props":{},"children":["24"]},"重度の喫煙者は年に一度、低線量胸部CT検査を"]},{"tag":"a","props":{"href":"/ja/tip/01-25"},"children":[{"tag":"span","props":{},"children":["25"]},"抑うつ状態や自殺念慮がある時は 12356 に電話を。自宅に睡眠薬や農薬を常備しないこと"]},{"tag":"a","props":{"href":"/ja/tip/01-26"},"children":[{"tag":"span","props":{},"children":["26"]},"消火器、消火毯、避難用マスク、救急セットを揃え、年に一度点検する"]},{"tag":"a","props":{"href":"/ja/tip/01-27"},"children":[{"tag":"span","props":{},"children":["27"]},"尿に肉眼で確認できる血が混じった場合、たとえ痛みを感じず、翌日には止まったとしても、必ず一度検査を受けるべきです"]},{"tag":"a","props":{"href":"/ja/tip/01-28"},"children":[{"tag":"span","props":{},"children":["28"]},"勃起機能に問題を感じたら、まずは心血管系をチェック。単なる「性的な問題」と片付けないで"]},{"tag":"a","props":{"href":"/ja/tip/01-29"},"children":[{"tag":"span","props":{},"children":["29"]},"減量、禁煙、血圧・血糖のコントロールにより、勃起機能の改善が期待できる"]},{"tag":"a","props":{"href":"/ja/tip/01-30"},"children":[{"tag":"span","props":{},"children":["30"]},"性行為の際は常にコンドームを使用し、注射器を他人と共有しない"]},{"tag":"a","props":{"href":"/ja/tip/01-31"},"children":[{"tag":"span","props":{},"children":["31"]},"ハイリスクな行為があったらHIV検査を。CDC（疾病予防管理センター）は無料、結果は秘密厳守"]},{"tag":"a","props":{"href":"/ja/tip/01-32"},"children":[{"tag":"span","props":{},"children":["32"]},"自殺の衝動が浮かんだら、まずは身近な誰かに伝える。この数十分間をやり過ごすために。"]},{"tag":"a","props":{"href":"/ja/tip/01-33"},"children":[{"tag":"span","props":{},"children":["33"]},"「助かった」を「完治」と誤解しないこと：農薬の飲用やガス吸引後の救急医療で守れるのは命だけで、肺や脳は守れない"]},{"tag":"a","props":{"href":"/ja/tip/01-34"},"children":[{"tag":"span","props":{},"children":["34"]},"「数日寝れば治る」と高所からの転落を賭けないこと：外傷ICUに入院した人の多くは生き残るが、その代償は年単位で計算される"]},{"tag":"a","props":{"href":"/ja/tip/01-35"},"children":[{"tag":"span","props":{},"children":["35"]},"「腎が一つ減っても大丈夫」を金に変えないで：残った一つが二つ分の働きをしなければならず、腎を売った人の 86% が、後に健康状態が悪化したと回答している"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/ja/tip/01-36","data-status":"active"},"children":[{"tag":"span","props":{},"children":["36"]},"出所不明の金属部品は拾わない、分解しない、売らない。クローバーの警告マークがあるものは遠ざかること"]},{"tag":"a","props":{"href":"/ja/tip/01-37"},"children":[{"tag":"span","props":{},"children":["37"]},"ギャンブル依存で借金をしてまで続けてしまい、気分が落ち込み続けている時は、まず 12356 に電話し、銀行カードと決済パスワードを家族に管理してもらう"]},{"tag":"a","props":{"href":"/ja/tip/01-38"},"children":[{"tag":"span","props":{},"children":["38"]},"ハイリスクな性的行動のあるMSM（男性間性交渉者）へ：HIV予防薬（PrEP）の相談を。正しく服用すれば感染リスクを7割以上低減可能"]},{"tag":"a","props":{"href":"/ja/tip/01-39"},"children":[{"tag":"span","props":{},"children":["39"]},"65歳以上の女性は二重エネルギーX線吸収法による骨密度検査を。閉経後に骨粗鬆症のリスク因子がある場合は65歳を待つ必要はない"]},{"tag":"a","props":{"href":"/ja/tip/01-40"},"children":[{"tag":"span","props":{},"children":["40"]},"骨粗鬆症と診断された方、または軽い転倒で骨折した経験がある方は、医師に抗骨粗鬆症薬を処方してもらい、継続して服用してください。カルシウム補給だけで済ませてはいけません。"]},{"tag":"a","props":{"href":"/ja/tip/01-41"},"children":[{"tag":"span","props":{},"children":["41"]},"野外の氷の上へ行く前は穴を開けて厚さを確認。15cm未満は避けること。川の氷や氷の穴の周辺には近づかない"]},{"tag":"a","props":{"href":"/ja/tip/01-42"},"children":[{"tag":"span","props":{},"children":["42"]},"ディスクグラインダーは保護カバーを付け、保護眼鏡とフェイスシールドを着用し、両手で持つ。木工用のこ刃を付けて木を切らない"]},{"tag":"a","props":{"href":"/ja/tip/01-43"},"children":[{"tag":"span","props":{},"children":["43"]},"様子がおかしい身近な人に「自殺を考えたことはある？」と直接聞く。聞いたことで、その考えが強まるわけではない"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"現在地"},"children":[{"tag":"a","props":{"href":"/ja/book"},"children":["本を読む"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/ja/book/01"},"children":["第1章"," ·"," ","早死を避けるために"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"01-36"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["36"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["エビデンス"," ","A"]}]},{"tag":"h1","props":{"lang":"ja"},"children":["出所不明の金属部品は拾わない、分解しない、売らない。クローバーの警告マークがあるものは遠ざかること"]},{"tag":"p","props":{"lang":"ja","className":"life-entry-summary"},"children":["放射線には臭い、色、温度がありません。ほとんどの放射線源はただの金属の塊に見えるため、「見た目に問題がない」ことは判断基準になりません。一般人が遭遇する確率は極めて低く、放射線源1万個あたりの年間事故発生数は1件未満です。しかし、一度遭遇してしまうと取り返しのつかない事態になります。1987年にはブラジルで、廃院となった診療所の放射線治療器をスクラップとして解体した結果、4人が死亡しました。"]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["費用・手間"]},{"tag":"p","props":{},"children":["費用はかかりません。見慣れない金属製の円柱、鉛の容器、装置から取り外された部品を見かけたら、避けて通り、拾わず、分解…"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["効果"]},{"tag":"p","props":{},"children":["2025年現在、全国で約17.8万個の放射線源と35.5万台（セット）の放射線装置が使用されています。"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"記録する：出所不明の金属部品は拾わない、分解しない、売らない。クローバーの警告マークがあるものは遠ざかること"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"できている"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"やることに追加"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"お気に入り"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"このヒントを共有"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"詳細を閉じる"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["費用・手間"]},{"tag":"p","props":{},"children":["費用はかかりません。見慣れない金属製の円柱、鉛の容器、装置から取り外された部品を見かけたら、避けて通り、拾わず、分解せず、ポケットに入れないこと。"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["効果"]},{"tag":"p","props":{},"children":["2025年現在、全国で約17.8万個の放射線源と35.5万台（セット）の放射線装置が使用されています。放射線源による事故の年間発生率は、1万個あたり1件未満で安定しています。分類は以下の通りです。クラスI、IIの放射線源の紛失、盗難、制御不能は「重大放射線事故」となります。クラスIIIは「大規模放射線事故」です。クラスIV、Vの紛失、盗難、または人員が年間線量限度を超える被ばくをした場合は「一般放射線事故」となります。国内事例：2020年6月、寧夏鉄鋼集団の製鉄所における高炉配管改造プロジェクトでのγ線探傷作業中、クラスIIのイリジウム-192放射線源により作業員3人が被ばくしました。陳某某氏は左手にⅢ度の急性放射線皮膚損傷、劉某某氏は左手親指・人差し指がⅣ度、中指・薬指・小指がⅢ度、樊某某氏は左手にⅠ-II度の損傷を受けました。3人の被ばく線量はすべて国の標準で定められた線量限度を大幅に超えており、2つの責任主体は放射線安全許可証の取り消しと7万元の罰金処分を受けました。国際事例：1987年ブラジル、ゴイアニアにて、廃院の遠隔放射線治療器が解体され、内部から50.8 TBqのセシウム-137放射線源が取り出されました。その際、放射線源を封入していたカプセルが破損しました。約112,000人がモニタリングを受け、そのうち249人が体内または体外汚染を受けました。この249人のうち、129人が中等度から重度の汚染を受け、50人が厳重な医学的監視を必要としました。最終的に4人が死亡しました（国内／国際）"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["出典"]},{"tag":"p","props":{"className":"life-citations"},"children":["生态环境部 (2025). 2024 中国生态环境状况公报. ",{"tag":"a","props":{"href":"https://www.mee.gov.cn/ywgz/sthjjcgl/hjzljcypj/202506/t20250605_1120773.shtml","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.mee.gov.cn/ywgz/sthjjcgl/hjzljcypj/202506/t20250605_1120773.shtml"]},"；国家核安全局 (2026). 2025 年我国核与辐射安全监管工作成效. ",{"tag":"a","props":{"href":"https://nnsa.mee.gov.cn/tpxw/202601/t20260107_1140062.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://nnsa.mee.gov.cn/tpxw/202601/t20260107_1140062.html"]},"；生态环境部 (2021). 关于一起 γ 射线探伤作业违法违规造成辐射事故案件处理情况的通报. ",{"tag":"a","props":{"href":"https://www.mee.gov.cn/xxgk2018/xxgk/xxgk06/202101/t20210121_818216.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.mee.gov.cn/xxgk2018/xxgk/xxgk06/202101/t20210121_818216.html"]},"；国务院 (2019). 放射性同位素与射线装置安全和防护条例（2019 年修订，第三十四、四十二、六十八条）. ",{"tag":"a","props":{"href":"https://www.mee.gov.cn/ywgz/fgbz/xzfg/201909/t20190918_734315.shtml","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.mee.gov.cn/ywgz/fgbz/xzfg/201909/t20190918_734315.shtml"]},"；环境保护部 (2009). 关于建立放射性同位素与射线装置辐射事故分级处理和报告制度的通知（辐射事故分级标准）. ",{"tag":"a","props":{"href":"https://www.mee.gov.cn/gkml/zj/wj/200910/t20091022_172414.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.mee.gov.cn/gkml/zj/wj/200910/t20091022_172414.htm"]},"；International Atomic Energy Agency (1988). The Radiological Accident in Goiânia. IAEA, Vienna. ",{"tag":"a","props":{"href":"https://www-pub.iaea.org/MTCD/Publications/PDF/Pub815_web.pdf","target":"_blank","rel":"noopener noreferrer"},"children":["https://www-pub.iaea.org/MTCD/Publications/PDF/Pub815_web.pdf"]},"；王福如, 王进, 余宁乐, 等 (2019). 南京“5.7”放射源丢失事故受照者照后医学随访观察. 中华放射医学与防护杂志, 39(11), 859-863. ",{"tag":"a","props":{"href":"https://doi.org/10.3760/cma.j.issn.0254-5098.2019.11.011","target":"_blank","rel":"noopener noreferrer"},"children":["https://doi.org/10.3760/cma.j.issn.0254-5098.2019.11.011"]},"；中国环境报 (2014-05-15). 放射源丢失的48小时（徐小怗、邵艺、褚方樵、汤景茹）. ",{"tag":"a","props":{"href":"http://nnsa.mee.gov.cn/ztzl/haqshmhsh/hjbzl/202406/P020240624472937009953.pdf","target":"_blank","rel":"noopener noreferrer"},"children":["http://nnsa.mee.gov.cn/ztzl/haqshmhsh/hjbzl/202406/P020240624472937009953.pdf"]},"（网页存档 ",{"tag":"a","props":{"href":"https://web.archive.org/web/20261005044102/http://nnsa.mee.gov.cn/ztzl/haqshmhsh/hjbzl/202406/P020240624472937009953.pdf","target":"_blank","rel":"noopener noreferrer"},"children":["https://web.archive.org/web/20261005044102/http://nnsa.mee.gov.cn/ztzl/haqshmhsh/hjbzl/202406/P020240624472937009953.pdf"]},"）"]},{"tag":"a","props":{"href":"https://www.mee.gov.cn/ywgz/sthjjcgl/hjzljcypj/202506/t20250605_1120773.shtml","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["出典を開く"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["著者の注記"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["実際に見つけたら、離れ、場所を覚え、動かさず、110 に電話してください。条例は生態環境主管部門、公安部門、衛生主管部門への報告を求めています。有効な防護は距離と時間だけです。ポケットやビニール袋越しでも効果はありません。X 線装置や CT のように通電して放射線を発生させる装置は、電源を切れば放射能が残るわけではありません。本当に危険なのは装置内の密封放射線源です。病院の放射線治療装置、配管やボイラーの γ 線探傷装置、検層装置、レベル計には線源があります。外装を開ければ線源が露出しますが、見た目は普通の金属部品と変わりません。見分けられると思わず、出所不明の装置の部品は分解せず、売らず、家に持ち帰らないでください。中国でも、知らずに線源を拾った事例があります。2014 年 5 月、南京の化学工業園区の工場で、探傷作業中にイリジウム-192 の線源を紛失しました。倉庫管理者が巡回中に拾い、作業服のポケットに入れました。軽度の急性放射線障害と右脚の急性放射線皮膚障害と診断され、1 年入院し、数年後も両手に松葉杖が必要でした。別の作業員 2 人も見たと話し、そのうち 1 人は通勤中にネックレスだと思って拾い、見てから捨てました。紛失したのは天津宏迪工程检测发展有限公司です。公式の事故通知は見つかりませんでした。拾った人の病状は江蘇省疾病予防管理センターの医師による追跡論文に基づき、拾って捨てた話は『中国環境報』の記者の報道だけです。廃品回収、解体、金物、建設現場の仕事は一般の人よりリスクが高く、現場で三つ葉の放射線マークのある立入制限区域を見たら迂回してください。原発からの漏えいは別の種類の事故で、一般の人が遭遇する確率はさらに低いです。主な受益者はあなた自身と現場にいる家族です。"]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["自分のメモ"]},{"tag":"button","props":{"type":"button"},"children":["自分へのメモを書く…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/ja/tip/01-35"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["前へ"]},"「腎が一つ減っても大丈夫」を金に変えないで：残った一つが二つ分の働きをしなければならず、腎を売った人の 86% が、後に健康状態が悪化したと回答している"]}]},{"tag":"a","props":{"className":"life-tip-pager-link next","href":"/ja/tip/01-37"},"children":[{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["次へ"]},"ギャンブル依存で借金をしてまで続けてしまい、気分が落ち込み続けている時は、まず 12356 に電話し、銀行カードと決済パスワードを家族に管理してもらう"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["このテーマの他の提案"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/01-32"},"children":[{"tag":"strong","props":{},"children":["自殺の衝動が浮かんだら、まずは身近な誰かに伝える。この数十分間をやり過ごすために。"]},{"tag":"span","props":{},"children":["自殺未遂を経験した人の約半数が、衝動が生まれてから実行に移すまで 10 分以内であったと回答しており、耐え抜くべきなのはまさにこの数十分間…"]}]}]},{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/ja/tip/01-33"},"children":[{"tag":"strong","props":{},"children":["「助かった」を「完治」と誤解しないこと：農薬の飲用やガス吸引後の救急医療で守れるのは命だけで、肺や脳は守れない"]},{"tag":"span","props":{},"children":["パラコートには解毒剤がなく、服用した人の4割以上が救命できない。肺の炎症を引き起こして徐々に線維化させ、腎臓や肝臓にも損傷を与える。一酸