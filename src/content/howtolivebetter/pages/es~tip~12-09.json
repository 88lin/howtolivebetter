th":"18","height":"18","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-up-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M7 7h10v10"},"children":[]},{"tag":"path","props":{"d":"M7 17 17 7"},"children":[]}]}]}]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/es/book/12"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"Volver al índice"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["Emprender y hacer negocios: no pierdas el patrimonio familiar"]},{"tag":"div","props":{"data-ad-dock-host":"true"},"children":[]},{"tag":"nav","props":{"aria-label":"Consejos del capítulo"},"children":[{"tag":"a","props":{"href":"/es/tip/12-01"},"children":[{"tag":"span","props":{},"children":["01"]},"Emprende solo con dinero que puedas perder: no toques el patrimonio familiar ni pidas préstamos para arrancar"]},{"tag":"a","props":{"href":"/es/tip/12-02"},"children":[{"tag":"span","props":{},"children":["02"]},"No firmes garantías personales por los préstamos de la empresa, y tu cónyuge todavía menos"]},{"tag":"a","props":{"href":"/es/tip/12-03"},"children":[{"tag":"span","props":{},"children":["03"]},"Antes de abrir, elige bien la figura jurídica: el negocio individual y los socios colectivos pagan hasta el final, solo la sociedad limitada es «limitada»"]},{"tag":"a","props":{"href":"/es/tip/12-04"},"children":[{"tag":"span","props":{},"children":["04"]},"Ser accionista a nombre de otra persona sin aportar capital"]},{"tag":"a","props":{"href":"/es/tip/12-05"},"children":[{"tag":"span","props":{},"children":["05"]},"Antes de firmar una franquicia, comprueba el registro en el Ministerio de Comercio, exige la información por escrito y mete el «período de reflexión» en el contrato"]},{"tag":"a","props":{"href":"/es/tip/12-06"},"children":[{"tag":"span","props":{},"children":["06"]},"Antes de registrarte, deja fijados el nombre, el local, el objeto social y el capital: con los documentos completos, la licencia se entrega en el acto"]},{"tag":"a","props":{"href":"/es/tip/12-07"},"children":[{"tag":"span","props":{},"children":["07"]},"En los oficios que exigen licencia, no abras hasta que la licencia esté en la mano"]},{"tag":"a","props":{"href":"/es/tip/12-08"},"children":[{"tag":"span","props":{},"children":["08"]},"Con alimentos, primero mira en qué tramo caes: producir y servir comida pide licencia, vender solo envases cerrados se cambia por declaración previa, y la carne y las verduras frescas no necesitan licencia"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/es/tip/12-09","data-status":"active"},"children":[{"tag":"span","props":{},"children":["09"]},"Si lo pones en bolsa para venderlo, es un alimento preenvasado: en la etiqueta no puede faltar ni la fecha de producción, ni el plazo de consumo, ni la lista de ingredientes"]},{"tag":"a","props":{"href":"/es/tip/12-10"},"children":[{"tag":"span","props":{},"children":["10"]},"Un alimento normal no puede decir que cura enfermedades: la etiqueta, las instrucciones, la publicidad y los guiones de retransmisión en directo cuentan todos"]},{"tag":"a","props":{"href":"/es/tip/12-11"},"children":[{"tag":"span","props":{},"children":["11"]},"En el negocio de alimentos hay una línea penal: vender carne de animales muertos por enfermedad o fuera de límites basta para el delito, y con mezcla de sustancias tóxicas la pena arranca en 5 años sin mirar el importe"]},{"tag":"a","props":{"href":"/es/tip/12-12"},"children":[{"tag":"span","props":{},"children":["12"]},"Con la licencia en mano nacen obligaciones de declaración: aunque no haya ingresos, presenta la declaración en cero en plazo"]},{"tag":"a","props":{"href":"/es/tip/12-13"},"children":[{"tag":"span","props":{},"children":["13"]},"Emite facturas solo por operaciones reales, y como contribuyente pequeño aprovecha al máximo la franquicia de exención"]},{"tag":"a","props":{"href":"/es/tip/12-14"},"children":[{"tag":"span","props":{},"children":["14"]},"Quien se diga de la oficina de impuestos y te presione para pagar o declarar es un estafador: para trámites fiscales usa solo la oficina virtual y el 12366"]},{"tag":"a","props":{"href":"/es/tip/12-15"},"children":[{"tag":"span","props":{},"children":["15"]},"En el anticipo escribe «arras» (定金) y no «depósito» (订金), fija el monto de la pena convencional y revisa el plazo de crédito como si fuera un préstamo"]},{"tag":"a","props":{"href":"/es/tip/12-16"},"children":[{"tag":"span","props":{},"children":["16"]},"Firma el contrato escrito en el primer mes de contratar y haz el registro de seguridad social dentro de los 30 días"]},{"tag":"a","props":{"href":"/es/tip/12-17"},"children":[{"tag":"span","props":{},"children":["17"]},"Paga el salario según el contrato y la ley, y todo aumento, préstamo o bono por escrito"]},{"tag":"a","props":{"href":"/es/tip/12-18"},"children":[{"tag":"span","props":{},"children":["18"]},"Vende primero, produce después: valida con preventas y pedidos pequeños que hay compradores antes de invertir en producción"]},{"tag":"a","props":{"href":"/es/tip/12-19"},"children":[{"tag":"span","props":{},"children":["19"]},"Antes de hablar de arrancar la producción, pasa la muestra por la lista de verificación de producción en serie"]},{"tag":"a","props":{"href":"/es/tip/12-20"},"children":[{"tag":"span","props":{},"children":["20"]},"De cada lote guardado, conserva facturas y datos del proveedor; no compres nada cuyo precio de compra sea claramente inferior al de mercado: si el empleado trajo falsificaciones, el condenado es el jefe"]},{"tag":"a","props":{"href":"/es/tip/12-21"},"children":[{"tag":"span","props":{},"children":["21"]},"Los diseños en productos, empaques, etiquetas y publicidades: hazlos tú o compra la licencia; cambiar el color o añadir un icono no es «ya modificado»"]},{"tag":"a","props":{"href":"/es/tip/12-22"},"children":[{"tag":"span","props":{},"children":["22"]},"Actuar según los procedimientos en el puesto de trabajo; antes de ofrecer ayuda fuera de dichos procedimientos, reflexione sobre quién asume la responsabilidad"]},{"tag":"a","props":{"href":"/es/tip/12-23"},"children":[{"tag":"span","props":{},"children":["23"]},"Cuando se pierde dinero, hay que actuar según el procedimiento: si es posible, se realiza una cancelación simplificada; si las deudas superan el patrimonio, se acude a la quiebra; no se debe dejar el asunto sin atender"]},{"tag":"a","props":{"href":"/es/tip/12-24"},"children":[{"tag":"span","props":{},"children":["24"]},"Antes de pagar para que alguien gestione tu tienda online, de contratar cursos de apertura de tiendas o de optar por el modelo «sin inventario», averigua si habrá que pagar más adelante y de dónde provendrán las ventas"]},{"tag":"a","props":{"href":"/es/tip/12-25"},"children":[{"tag":"span","props":{},"children":["25"]},"Si tiene una empresa o es autónomo en China, presente por internet el informe del año anterior entre el 1 de enero y el 30 de junio, aunque no haya actividad; es gratuito"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"Ruta de navegación"},"children":[{"tag":"a","props":{"href":"/es/book"},"children":["Libro"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/es/book/12"},"children":["Cap