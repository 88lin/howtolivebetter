ound","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M18 20a6 6 0 0 0-12 0"},"children":[]},{"tag":"circle","props":{"cx":"12","cy":"10","r":"4"},"children":[]},{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},{"tag":"span","props":{},"children":["Đăng nhập để đồng bộ hóa"]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/vi/book/33"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"Quay lại mục lục"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["Sống sau khi bị khuyết tật"]},{"tag":"nav","props":{"aria-label":"Các mục trong chương"},"children":[{"tag":"a","props":{"href":"/vi/tip/33-01"},"children":[{"tag":"span","props":{},"children":["01"]},"Sau chấn thương tủy sống mà đột nhiên đau đầu dữ dội và ra mồ hôi: đỡ ngồi ngay lên, nới lỏng quần áo, đồng thời gọi 120"]},{"tag":"a","props":{"href":"/vi/tip/33-02"},"children":[{"tag":"span","props":{},"children":["02"]},"Mười năm đầu sau khi bị khuyết tật là giai đoạn nguy cơ tự tử cao, đừng tưởng chỉ cần nghĩ thoáng là xong"]},{"tag":"a","props":{"href":"/vi/tip/33-03"},"children":[{"tag":"span","props":{},"children":["03"]},"Nhập viện điều trị rối loạn tâm thần theo nguyên tắc tự nguyện, chỉ có hai trường hợp được làm mà không cần sự đồng ý của bản thân"]},{"tag":"a","props":{"href":"/vi/tip/33-04"},"children":[{"tag":"span","props":{},"children":["04"]},"Người chăm lâu dài người khuyết tật trong nhà, sức khỏe của chính mình cũng phải có người nhìn"]},{"tag":"a","props":{"href":"/vi/tip/33-05"},"children":[{"tag":"span","props":{},"children":["05"]},"Người ngồi xe lăn lâu thì đổi đệm ngồi sang loại giảm áp, mỗi ngày xem một lượt xương ngồi và xương cùng"]},{"tag":"a","props":{"href":"/vi/tip/33-06"},"children":[{"tag":"span","props":{},"children":["06"]},"Đừng mua các liệu pháp và thiết bị「chữa khỏi bại liệt, mù lòa, điếc」"]},{"tag":"a","props":{"href":"/vi/tip/33-07"},"children":[{"tag":"span","props":{},"children":["07"]},"Có giấy chứng nhận người khuyết tật rồi thì đến hội người khuyết tật cấp huyện hỏi trọn một lần các khoản trợ cấp"]},{"tag":"a","props":{"href":"/vi/tip/33-08"},"children":[{"tag":"span","props":{},"children":["08"]},"Trẻ dưới 7 tuổi có khuyết tật hoặc tự kỷ, đến hội người khuyết tật cấp huyện xin trợ giúp phục hồi chức năng"]},{"tag":"a","props":{"href":"/vi/tip/33-09"},"children":[{"tag":"span","props":{},"children":["09"]},"Lối đi, lan can và cải tạo phòng tắm trong nhà, có thể xin trợ cấp từ chính quyền cấp huyện trở lên"]},{"tag":"a","props":{"href":"/vi/tip/33-10"},"children":[{"tag":"span","props":{},"children":["10"]},"Khi tìm việc ở Trung Quốc, chủ động nói rõ mình có giấy chứng nhận khuyết tật; tuyển bạn có thể giúp doanh nghiệp bớt một khoản phải nộp"]},{"tag":"a","props":{"href":"/vi/tip/33-11"},"children":[{"tag":"span","props":{},"children":["11"]},"Thuế thu nhập cá nhân của người khuyết tật có thể được giảm, giảm bao nhiêu thì gọi điện hỏi cơ quan thuế tỉnh"]},{"tag":"a","props":{"href":"/vi/tip/33-12"},"children":[{"tag":"span","props":{},"children":["12"]},"Chó dẫn đường cho người mù được vào nơi công cộng và phương tiện giao thông công cộng, người mù đi xe buýt trong thành phố miễn phí"]},{"tag":"a","props":{"href":"/vi/tip/33-13"},"children":[{"tag":"span","props":{},"children":["13"]},"Thí sinh khuyết tật dự kỳ thi tuyển sinh đại học có thể xin biện pháp hỗ trợ hợp lý, dùng đề braille thì kéo dài thời gian thi thêm một nửa"]},{"tag":"a","props":{"href":"/vi/tip/33-14"},"children":[{"tag":"span","props":{},"children":["14"]},"Trẻ khuyết tật xin nhập học, nhà trường không được từ chối; trẻ không đến được trường thì phòng giáo dục sắp xếp giảng viên đến tận nhà"]},{"tag":"a","props":{"href":"/vi/tip/33-15"},"children":[{"tag":"span","props":{},"children":["15"]},"Mất hoặc không cử động được hai chi dưới bên phải vẫn thi được giấy phép lái xe, loại xe được phép lái gọi là C5"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/vi/tip/33-16","data-status":"active"},"children":[{"tag":"span","props":{},"children":["16"]},"Phục hồi chức năng làm ở cơ sở chính quy có khoa phục hồi chức năng, cường độ nghe người trị liệu, tập càng nặng càng không tốt"]},{"tag":"a","props":{"href":"/vi/tip/33-17"},"children":[{"tag":"span","props":{},"children":["17"]},"Nghe kém thì đi lắp máy trợ thính, lý do lắp là để nghe rõ, không phải để phòng chứng mất trí nhớ"]},{"tag":"a","props":{"href":"/vi/tip/33-18"},"children":[{"tag":"span","props":{},"children":["18"]},"Nói một người thành niên「không quản lý được việc của mình」thì phải xin tòa án công nhận, người nhà nói không tính"]},{"tag":"a","props":{"href":"/vi/tip/33-19"},"children":[{"tag":"span","props":{},"children":["19"]},"Người giám hộ của người thành niên được xác định theo thứ tự luật định; người được giám hộ gây hại cho người khác thì người giám hộ bồi thường"]},{"tag":"a","props":{"href":"/vi/tip/33-20"},"children":[{"tag":"span","props":{},"children":["20"]},"Bị từ chối tuyển, không được chuyển biên chế, bị trả lương thiếu vì khuyết tật thì có thể kiện, nhưng hãy tính chi phí trong quá trình trước"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"Breadcrumbs"},"children":[{"tag":"a","props":{"href":"/vi/book"},"children":["Khám phá cuốn sách"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/vi/book/33"},"children":["Chương 33"," ·"," ","Sống sau khi bị khuyết tật"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"33-16"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["16"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["Bằng chứng"," ","A"]}]},{"tag":"h1","props":{"lang":"vi"},"children":["Phục hồi chức năng làm ở cơ sở chính quy có khoa phục hồi chức năng, cường độ nghe người trị liệu, tập càng nặng càng không tốt"]},{"tag":"p","props":{"lang":"vi","className":"life-entry-summary"},"children":["Đưa người bệnh về nhà nằm chờ tự hồi phục là sai lầm thường gặp nhất. Sau đột quỵ, chăm sóc có tổ chức bởi nhóm đa chuyên ngành cho nhiều người hơn còn sống và còn ở được tại nhà sau một năm. Nhưng cũng đừng tự tăng cường độ, tập sớm hơn, nhiều hơn, nhiều lần hơn trong vòng 24 giờ đầu sau đột quỵ thì kết quả sau ba tháng lại kém hơn. Tập bao nhiêu, tập lúc nào thì nghe khoa phục hồi chức năng và người trị liệu."]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Chi phí"]},{"tag":"p","props":{},"children":["Nằm viện phục hồi chức năng mỗi ngày vài trăm tệ, phần tự…"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Lợi ích"]},{"tag":"p","props":{},"children":["Tổng quan hệ thống Cochrane đưa vào 29 thử nghiệm, 5902 người tham gia, so sánh chăm sóc có tổ chức trong khoa…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"Đánh dấu: Phục hồi chức năng làm ở cơ sở chính quy có khoa phục hồi chức năng, cường độ nghe người trị liệu, tập càng nặng càng không tốt"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"