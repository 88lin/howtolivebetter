entColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"Guardar"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Compartir consejo"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Ocultar detalles"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Coste"]},{"tag":"p","props":{},"children":["No cuesta dinero. Consulta una vez la lista de centros en la cuenta oficial de WeChat de la Administración Nacional de Seguridad Sanitaria y pregunta los precios en persona antes del tratamiento; lleva unos diez o quince minutos."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Beneficio"]},{"tag":"p","props":{},"children":["El anuncio de enero de 2024 de la Administración Nacional de Seguridad Sanitaria divide el coste de un implante convencional individual en tres partes. Primera: servicios médicos a precio cerrado. Incluyen consultas de todo el proceso, análisis bioquímicos e imágenes, colocación del implante y de la corona, escaneo, diseño y modelado. Excluyen extracción, limpieza periodontal, endodoncia, injerto óseo y trasplante de tejido blando. En los hospitales públicos de nivel III de todo el país, esos servicios no deben superar en principio 4500 yuanes por implante convencional; las zonas económicamente desarrolladas pueden ampliar el límite hasta un 20% según el aviso de regulación de 2022. Segunda: el implante. En la compra nacional conjunta de enero de 2023, los precios adjudicados iban de 548 a 1855 yuanes, con una media de algo más de 900. La autoridad sanitaria de Sichuan, que coordinó la compra, informó de que las marcas importadas caras bajaron de una mediana de compra de 5000 a unos 1850 yuanes, y las marcas más utilizadas de unos 1500 a unos 770. Tercera: la corona, entre 100 y 656 yuanes, con una media de algo más de 300. En una rueda de prensa del segundo semestre de 2023, la administración nacional dijo que las medidas locales se habían implantado a finales de abril y principios de mayo y el coste total había bajado de una media de 15.000 a unos 6000–7000 yuanes. Cobertura del seguro: un documento de 1999 del Ministerio de Trabajo y Seguridad Social y otros departamentos excluyó las prótesis dentales y la cirugía estética u ortopédica no funcional del seguro médico básico. En una respuesta de 2019 a una propuesta de la Conferencia Consultiva Política del Pueblo Chino, la administración nacional señaló que los tratamientos estéticos, incluida la restauración de dientes ausentes y la corrección, no se financian con el seguro; los tratamientos odontológicos terapéuticos no están excluidos a nivel nacional y generalmente se incluyen a nivel local (ámbito nacional, hasta octubre de 2026)."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Fuentes originales"]},{"tag":"p","props":{"className":"life-citations"},"children":["国家医疗保障局 (2024). 关于发布“承诺参与口腔种植价格治理医疗机构名单”等信息的公告（2024 年 1 月 12 日）. ",{"tag":"a","props":{"href":"https://www.nhsa.gov.cn/art/2024/1/12/art_109_11954.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.nhsa.gov.cn/art/2024/1/12/art_109_11954.html"]},"；国家医疗保障局 (2022). 关于开展口腔种植医疗服务收费和耗材价格专项治理的通知（医保发〔2022〕27 号，第四、六条）. ",{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/2022-09/08/content_5709065.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/zhengce/zhengceku/2022-09/08/content_5709065.htm"]},"；国家医疗保障局 (2023). 国家医保局举行 2023 年下半年例行新闻发布会（2023 年 9 月 22 日）. ",{"tag":"a","props":{"href":"https://www.nhsa.gov.cn/art/2023/9/22/art_14_11321.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.nhsa.gov.cn/art/2023/9/22/art_14_11321.html"]},"；四川省医疗保障局 (2023). 口腔种植体系统集中带量采购拟中选结果（2023 年 1 月 11 日）. ",{"tag":"a","props":{"href":"https://ylbzj.sc.gov.cn/scsybj/nc020100/2023/1/11/ac5565c7e0454890be086a2bc41f9acd.shtml","target":"_blank","rel":"noopener noreferrer"},"children":["https://ylbzj.sc.gov.cn/scsybj/nc020100/2023/1/11/ac5565c7e0454890be086a2bc41f9acd.shtml"]},"；劳动和社会保障部等 (1999). 关于印发城镇职工基本医疗保险诊疗项目管理、医疗服务设施范围和支付标准意见的通知（劳社部发〔1999〕22 号，附件一）. ",{"tag":"a","props":{"href":"https://policy.mofcom.gov.cn/claw/clawContent.shtml?id=39317","target":"_blank","rel":"noopener noreferrer"},"children":["https://policy.mofcom.gov.cn/claw/clawContent.shtml?id=39317"]},"；国家医疗保障局 (2019). 关于政协十三届全国委员会第二次会议第 4043 号提案答复的函. ",{"tag":"a","props":{"href":"https://www.nhsa.gov.cn/art/2019/12/3/art_26_2096.html","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.nhsa.gov.cn/art/2019/12/3/art_26_2096.html"]}]},{"tag":"a","props":{"href":"https://www.nhsa.gov.cn/art/2024/1/12/art_109_11954.html","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Abrir fuente"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Nota del autor"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["El límite de 4500 yuanes solo se aplica a hospitales públicos. Los centros privados fijan sus precios, pero el aviso de regulación les prohíbe atraer pacientes con «subvenciones» o «precios bajos» falsos o engañosos. El precio de un anuncio suele corresponder solo al implante; extracción, injertos y otros servicios fuera del paquete son donde aparecen extras. Antes de firmar, pide un presupuesto con el precio de cada concepto. La lista de centros que se comprometen a participar en la regulación aparece en la cuenta oficial de WeChat de la administración nacional. Si faltan uno o dos dientes, el implante no es necesariamente obligatorio: también hay prótesis fijas y removibles, cuyos precios no cambiaron con esta medida. Pregunta al médico qué opción te conviene. No hay una respuesta nacional única sobre pagar implantes con la cuenta personal del seguro de empleados: consulta a la autoridad local. Para compartir esa cuenta con familiares, consulta la sección 5, punto 13 (uso familiar compartido). Para saber por qué reponer dientes, consulta la sección 2, punto 10. El beneficio se considera medio: la bajada general procede de la política; este paso permite ahorrar sobre todo suplementos fuera del paquete y sobreprecios de centros caros, de varios miles de yuanes por diente."]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Mi nota"]},{"tag":"button","props":{"type":"button"},"children":["Escribe un recordatorio…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/es/tip/24-11"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Anterior"]},"Agradece al médico que te salvó con una carta de agradecimiento, una bandera de reconocimiento o la encuesta de satisfacción, no con un sobre rojo: la norma prohíbe bienes, no la gratitud"]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["Más en este tema"]},{"tag":"ul","props":{},"children":[{"tag":"li