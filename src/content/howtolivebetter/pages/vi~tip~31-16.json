t":"18","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-up-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M7 7h10v10"},"children":[]},{"tag":"path","props":{"d":"M7 17 17 7"},"children":[]}]}]}]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/vi/book/31"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"Quay lại mục lục"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["Sau mười tám tuổi có những con đường nào"]},{"tag":"div","props":{"data-ad-dock-host":"true"},"children":[]},{"tag":"nav","props":{"aria-label":"Các mục trong chương"},"children":[{"tag":"a","props":{"href":"/vi/tip/31-01"},"children":[{"tag":"span","props":{},"children":["01"]},"Đối chiếu điều kiện trước đã: yêu cầu về tuổi và trình độ của mười hai con đường đều được viết thành văn bản"]},{"tag":"a","props":{"href":"/vi/tip/31-02"},"children":[{"tag":"span","props":{},"children":["02"]},"Năm thứ mười tám tuổi phải đăng ký nghĩa vụ quân sự trước ngày 31 tháng 10; quân nhân lính nghĩa vụ nhập ngũ đúng hai năm"]},{"tag":"a","props":{"href":"/vi/tip/31-03"},"children":[{"tag":"span","props":{},"children":["03"]},"Sau khi được truy xuất mà từ chối nghĩa vụ quân sự thì trong hai năm không được xuất cảnh, không được học tiếp, và không vào được cơ quan công chức hay doanh nghiệp nhà nước"]},{"tag":"a","props":{"href":"/vi/tip/31-04"},"children":[{"tag":"span","props":{},"children":["04"]},"Hai điều thật nhất khi sinh viên đại học đi nghĩa vụ quân sự: học phí mỗi năm bù tối đa 20000 tệ, giữ học vị hai năm, và có một kế hoạch riêng cho tuyển sinh cao học"]},{"tag":"a","props":{"href":"/vi/tip/31-05"},"children":[{"tag":"span","props":{},"children":["05"]},"Sau khi giải ngũ chỉ có sáu trường hợp được chính quyền bố trí việc làm; người tự tìm việc phải đến đăng ký trong vòng 30 ngày"]},{"tag":"a","props":{"href":"/vi/tip/31-06"},"children":[{"tag":"span","props":{},"children":["06"]},"Ba khoản sau khi giải ngũ: tiền trở cấp một lần, thời gian phục vụ tính vào thâm niên công, và tự làm ăn thì mỗi năm giảm 20000 tệ thuế"]},{"tag":"a","props":{"href":"/vi/tip/31-07"},"children":[{"tag":"span","props":{},"children":["07"]},"Muốn vào hệ thống cơ quan công chức không chỉ có thi cao công chức: làm đủ hai năm ở chương trình phục vụ cơ sở thì dự được kế hoạch tuyển định hướng dành riêng cho 10% mỗi năm"]},{"tag":"a","props":{"href":"/vi/tip/31-08"},"children":[{"tag":"span","props":{},"children":["08"]},"Giáo viên vị trí đặc biệt hết hạn ba năm, đạt kết quả đánh giá và còn muốn ở lại thì phải được chuyển thành biên chế đúng thời hạn"]},{"tag":"a","props":{"href":"/vi/tip/31-09"},"children":[{"tag":"span","props":{},"children":["09"]},"Lính cứu hộ và nhân sự văn chứng quân đội là hai cửa tuyển công khai khác, ngưỡng thấp hơn thi công chức"]},{"tag":"a","props":{"href":"/vi/tip/31-10"},"children":[{"tag":"span","props":{},"children":["10"]},"Bằng cấp không phải việc mua một lần là xong: thi tự học không giới hạn tuổi cũng không xem trình độ đã học, thi lớn và đại học mở đều bổ sung được"]},{"tag":"a","props":{"href":"/vi/tip/31-11"},"children":[{"tag":"span","props":{},"children":["11"]},"Không vào cơ quan công chức thì làm việc linh hoạt: hưu trí và y tế phải tự tham gia bảo hiểm ở nơi làm việc, hạn chế về hộ khẩu đã được nới"]},{"tag":"a","props":{"href":"/vi/tip/31-12"},"children":[{"tag":"span","props":{},"children":["12"]},"Giao đồ ăn, chạy xe ô tô công nghệ, chở hàng trong thành phố: sàn trả phí bảo hiểm tai nạn lao động theo từng đơn, bạn không phải đóng"]},{"tag":"a","props":{"href":"/vi/tip/31-13"},"children":[{"tag":"span","props":{},"children":["13"]},"Hai con đường chốt được chỗ làm việc có biên chế ngay từ ngày điền nguyện vọng kỳ thi gaokao: sinh viên sư phạm có học phí và sinh viên y khoa định hướng, cái giá là thực hiện cam kết 6 năm"]},{"tag":"a","props":{"href":"/vi/tip/31-14"},"children":[{"tag":"span","props":{},"children":["14"]},"Muốn đi làm công ăn nước ngoài, trước hết tra công ty này có giấy phép hợp tác lao động ngoài biên giới không: công ty không được đòi bạn đặt tiền"]},{"tag":"a","props":{"href":"/vi/tip/31-15"},"children":[{"tag":"span","props":{},"children":["15"]},"Làm việc từ xa cho công ty nước ngoài ngay tại nhà, khoản tiền này theo luật thuế tính là thu nhập trong nước: thuế thu nhập cá nhân tự kê khai, tiền về nước đi theo khoản「thù lao lao động」"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/vi/tip/31-16","data-status":"active"},"children":[{"tag":"span","props":{},"children":["16"]},"Không vào cơ quan mà tự làm ăn, tiền khởi đầu hãy xem khoản vay bảo đảm khởi nghiệp: cá nhân tối đa 30 vạn, Nhà nước trợ một nửa lãi suất"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"Breadcrumbs"},"children":[{"tag":"a","props":{"href":"/vi/book"},"children":["Khám phá cuốn sách"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/vi/book/31"},"children":["Chương 31"," ·"," ","Sau mười tám tuổi có những con đường nào"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"31-16"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["16"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["Bằng chứng"," ","A"]}]},{"tag":"h1","props":{"lang":"vi"},"children":["Không vào cơ quan mà tự làm ăn, tiền khởi đầu hãy xem khoản vay bảo đảm khởi nghiệp: cá nhân tối đa 30 vạn, Nhà nước trợ một nửa lãi suất"]},{"tag":"p","props":{"lang":"vi","className":"life-entry-summary"},"children":["Nếu nhất định phải vay tiền để khởi đầu, hãy xem khoản có lãi suất được ngân sách trợ. Cá nhân vay tối đa 30 vạn tệ, dài nhất 3 năm, lãi suất do Nhà nước trợ một nửa. Có một điều kiện cứng hay bị bỏ qua: lúc nộp hồ sơ, bạn và người thân phối ngữu không được có khoản vay nào khác, trừ khoản vay học phí, tín dụng nhỏ cho hộ thoát nghèo, vay mua nhà, vay mua xe và các khoản vay tiêu dùng nhỏ dưới 5 vạn tệ."]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Chi phí"]},{"tag":"p","props":{},"children":["Không tốn tiền. Hỏi miễn phí. Trước hết chạy một lần cơ qu…"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Lợi ích"]},{"tag":"p","props":{},"children":["Điều kiện cho cá nhân nằm ở Điều sáu của《Quy chế quản lý quỹ tài chính phát triển tài chính bao trùm》《普惠金融发展专项…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"Đánh dấu: Không vào cơ quan mà tự làm ăn, tiền khởi đầu hãy xem khoản vay bảo đảm khởi nghiệp: cá nhân tối đa 30 vạn, Nhà nước trợ một nửa lãi suất"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"Hoàn tất"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"M13 6h8"},"children":[]},{"tag":"path","props":{"d":"M13 12h8"},"children":[]},{"tag":"path","props":{"d":"M13 18h8"},"children":[]}]},"Kế hoạch thực hiện"]},{"tag":"button","props":{"type":"button","className":"life-action favorite","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"},"children":[]}]},"Lưu"]}," ",{"tag":"button","props":{"type":"button","className":"social-share-trigger"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-share2 lucide-share-2","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"18","cy":"5","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"6","cy":"12","r":"3"},"children":[]},{"tag":"circle","props":{"cx":"18","cy":"19","r":"3"},"children":[]},{"tag":"line","props":{"x1":"8.59","x2":"15.42","y1":"13.51","y2":"17.49"},"children":[]},{"tag":"line","props":{"x1":"15.41","x2":"8.59","y1":"6.51","y2":"10.49"},"children":[]}]},"Chia sẻ mẹo này"]}]},{"tag":"button","props":{"type":"button","className":"life-detail-toggle","aria-expanded":"true"},"children":[{"tag":"span","props":{},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"currentColor","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle","aria-hidden":"true"},"children":[{"tag":"circle","props":{"cx":"12","cy":"12","r":"10"},"children":[]}]},"Ẩn chi tiết"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down rotated","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m6 9 6 6 6-6"},"children":[]}]}]},{"tag":"div","props":{"className":"life-entry-details"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Chi phí"]},{"tag":"p","props":{},"children":["Không tốn tiền. Hỏi miễn phí. Trước hết chạy một lần cơ quan bảo hiểm xã hội để thẩm định điều kiện, rồi làm thủ tục một lần ở tổ chức bảo đảm và một lần ở ngân hàng chi nhánh (ngân hàng cho vay). Chỗ khó là tiền vay cuối cùng vẫn phải trả."]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Lợi ích"]},{"tag":"p","props":{},"children":["Điều kiện cho cá nhân nằm ở Điều sáu của《Quy chế quản lý quỹ tài chính phát triển tài chính bao trùm》《普惠金融发展专项资金管理办法》（财金〔2023〕75 号）. Điều kiện thứ nhất là phải thuộc nhóm việc làm trọng điểm. Văn bản liệt kê người đã đăng ký thất nghiệp ở thành phố, người gặp khó khăn trong việc làm (kể cả người khuyết tật), cựu chiến binh, người vừa hết thời hạn hình sự. Còn có sinh viên, học viên tốt nghiệp (kể cả cán bộ làm việc ở nông thôn của trường đại học và sinh viên về nước du học), công nhân và người thất nghiệp ở doanh nghiệp cần giải phóng công suất thừa. Còn có nông dân về quê khởi nghiệp, chủ cửa hàng trực tuyến, hộ thoát nghèo, nông dân tự khởi nghiệp ở nông thôn và những người khác. Điều kiện thứ hai là không được có khoản vay nào khác:「除助学贷款、脱贫人口小额信贷、住房贷款、购车贷款、5 万元以下小额消费贷款（含信用卡消费）以外，申请人提交创业担保贷款申请时，本人及其配偶无其他贷款」, tức trừ khoản vay học phí, tín dụng nhỏ cho hộ thoát nghèo, vay mua nhà, vay mua xe và khoản vay tiêu dùng nhỏ dưới 5 vạn tệ (kể cả tiêu dùng bằng thẻ tín dụng), thì lúc người đề nghị nộp hồ sơ vay bảo đảm khởi nghiệp, bản thân người đó và người thân phối ngữu không có khoản vay nào khác. Điều chín:「对符合条件的创业担保贷款，财政部门给予贷款实际利率 50% 的财政贴息。对展期、逾期的创业担保贷款，财政部门原则上不予贴息」, tức với khoản vay bảo đảm khởi nghiệp đủ điều kiện, cơ quan tài chính trợ phần lãi bằng 50% lãi suất thực tế của khoản vay; với khoản vay được gia hạn hoặc quá hạn thì về nguyên tắc không trợ lãi. Trợ lãi nghĩa là Nhà nước trợ một nửa lãi suất. Gia hạn là đến hạn rồi kéo dài thêm, quá hạn là tới hạn không trả, hai trường hợp đó Nhà nước không trợ nữa. Điều mười: khoản vay bảo đảm khởi nghiệp dưới 10 vạn tệ mà cá nhân đề nghị thì về nguyên tắc bỏ yêu cầu bảo đảnh ngược, không cần tìm người khác hay dùng tài sản làm bảo đảm cho tổ chức bảo đảm. Điều mười một: khoản vay bảo đảm khởi nghiệp của cá nhân thuộc phạm vi hỗ trợ thưởng khuyến khích「额度不超过 30 万元，贷款期限不超过 3 年」, tức hạn mức không quá 30 vạn tệ, thời hạn vay không quá 3 năm. Người hợp tác kinh doanh thì có thể nâng mức, tối đa không quá 110% tổng hạn mức cá nhân. Trần lãi suất của khoản vay có hỗ trợ thưởng chia làm ba bậc: khu vực phía Đông là LPR+50BPs, khu vực trung và phía Tây là LPR+150BPs, khu vực thoát nghèo là LPR+250BPs. LPR là lãi suất định giá của thị trường tín dụng ngân hàng, BPs là đơn vị đo lãi suất, cộng thêm bao nhiêu thì lãi cao bấy nhiêu. Người「还款积极、带动就业能力强、创业项目好」thì sau khi đến hạn vẫn được nộp hồ sơ tiếp, tổng số lần không quá 3 lần. Điều tám: người đề nghị trước hết nộp hồ sơ thẩm định điều kiện với cơ quan bảo hiểm xã hội địa phương, rồi nộp hồ sơ với tổ chức bảo đảm và ngân hàng chi nhánh. Điều mười hai: được Hội đồng Nhà nước cấp tỉnh đồng ý thì các nơi có thể mở rộng phạm vi hỗ trợ, nâng hạn mức và tỷ lệ trợ lãi (toàn quốc)"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Nguồn gốc"]},{"tag":"p","props":{"className":"life-citations"},"children":["财政部 (2023). 关于印发《普惠金融发展专项资金管理办法》的通知（财金〔2023〕75 号，第六、八、九、十、十一、十二条）. ",{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/202309/content_6903691.htm","target":"_blank","rel":"noopener noreferrer"},"children":["https://www.gov.cn/zhengce/zhengceku/202309/content_6903691.htm"]}]},{"tag":"a","props":{"href":"https://www.gov.cn/zhengce/zhengceku/202309/content_6903691.htm","target":"_blank","rel":"noopener noreferrer","className":"life-source-link"},"children":["Liên kết mở nguồn"," ",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"13","height":"13","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Ghi chú sách"]},{"tag":"p","props":{"className":"life-citations"},"children":[{"tag":"span","props":{"className":"life-content-reference"},"children":["Nhà nước trợ một nửa lãi suất không làm thay đổi chuyện「tiền vay thì phải trả». Lập trường ở mục 1 ở phần 12 của sách này không đổi: khởi nghiệp thì chỉ lấy số tiền mà mất thì chịu được, không đụng vào vốn gia đình, không ký bảo đảm cá nhân cho khoản vay của công ty, người thân phối ngữu càng không ký theo. Nếu bạn đã quyết định sẽ vay, thì khoản vay chính sách loại này có lãi thấp nhất, đừng đụng vào tín dụng tiêu dùng và cho vay phi chính thức. Hạn mức và phạm vi áp dụng các tỉnh có thể nâng lên, thực tế được duyệt bao nhiêu thì theo cách nói năm đó của cơ quan bảo hiểm xã hội địa phương. Thông báo lúc dịch bệnh năm 2020 ghi「个人最高 20 万」là văn bản tạm thời, giờ hãy theo quy chế này. Mở cửa hàng thì đăng ký làm hộ kinh doanh cá thể hay lập công ty, giấy phép, kê khai thuế và rút lui, xem phần 12. Trợ cấp đào tạo, trợ cấp bảo hiểm xã hội và thực tập việc làm khi thất nghiệp, xem mục 13 ở phần 7 (trợ cấp đào tạo nghề)."]}]}]},{"tag":"div","props":{"className":"life-personal-note"},"children":[{"tag":"span","props":{"className":"life-detail-label"},"children":["Ghi chú của tôi"]},{"tag":"button","props":{"type":"button"},"children":["Viết một lời nhắc cho chính bạn…"]}]}]}]},{"tag":"nav","props":{"className":"life-tip-pager"},"children":[{"tag":"a","props":{"className":"life-tip-pager-link","href":"/vi/tip/31-15"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},{"tag":"span","props":{},"children":[{"tag":"small","props":{},"children":["Trước"]},"Làm việc từ xa cho công ty nước ngoài ngay tại nhà, khoản tiền này theo luật thuế tính là thu nhập trong nước: thuế thu nhập cá nhân tự kê khai, tiền về nước đi theo khoản「thù lao lao động」"]}]}]},{"tag":"section","props":{"className":"life-tip-related"},"children":[{"tag":"h2","props":{},"children":["Thêm trong chủ đề này"]},{"tag":"ul","props":{},"children":[{"tag":"li","props":{},"children":[{"tag":"a","props":{"href":"/vi/tip/31-09"},"children":[{"tag":"strong","props":{},"children":["Lính cứu hộ và nhân sự v