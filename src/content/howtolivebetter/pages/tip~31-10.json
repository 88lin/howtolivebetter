{"path":"/tip/31-10","title":"学历不是一锤子买卖：自考不限年龄和已受教育程度，成人高考和开放大学都能补 | HowToLiveBetter","description":"十八岁那年没读成书，后面还有三条正规通道：自考、成人高考、开放大学。自考不限年龄，也不看你原来读到哪一级，但全日制在校生不能报。成人高考要先有高中或者专科的毕业证。三条路都慢，但都不看你十八岁那年考成什么样。","lang":"zh","styles":["/sites/howtolivebetter/styles/bca54bebe9c1bd3b.css"],"bodyClass":"font-sans antialiased","nodes":[{"tag":"div","props":{"className":"life-site"},"children":[{"tag":"div","props":{"className":"life-header-slot","aria-hidden":"true"},"children":[]},{"tag":"header","props":{"className":"life-header"},"children":[{"tag":"div","props":{"className":"life-header-inner"},"children":[{"tag":"a","props":{"className":"life-brand","aria-label":"H ✳ HowToLiveBetter 首页","href":"/"},"children":[{"tag":"span","props":{"className":"life-brand-mark","aria-hidden":"true"},"children":["H",{"tag":"span","props":{},"children":["✳"]}]},{"tag":"span","props":{},"children":["HowToLive",{"tag":"span","props":{},"children":["Better"]}]}]},{"tag":"nav","props":{"className":"life-nav","aria-label":"主导航"},"children":[{"tag":"a","props":{"className":"life-nav-link","href":"/book"},"children":[{"tag":"span","props":{},"children":["阅读全书"]}]},{"tag":"a","props":{"className":"life-nav-link","href":"/top-50"},"children":[{"tag":"span","props":{},"children":["精选 50 条"]}]},{"tag":"a","props":{"className":"life-nav-link","href":"/daily"},"children":[{"tag":"span","props":{},"children":["每日任务"]}]},{"tag":"a","props":{"className":"life-nav-link","href":"/dashboard"},"children":[{"tag":"span","props":{},"children":["我的清单"]}]},{"tag":"button","props":{"type":"button","className":"life-nav-link life-nav-more","aria-haspopup":"menu","aria-expanded":"false"},"children":[{"tag":"span","props":{},"children":["更多"]},{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"15","height":"15","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-down","aria-hidden":"true"},"