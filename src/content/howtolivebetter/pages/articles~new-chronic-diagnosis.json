lassName":"life-longread"},"children":[{"tag":"a","props":{"className":"life-back-link active","href":"/articles","data-status":"active","aria-current":"page"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"全部长文"]},{"tag":"header","props":{"className":"life-longread-header"},"children":[{"tag":"div","props":{},"children":[{"tag":"div","props":{"className":"life-eyebrow"},"children":["深度长文"]},{"tag":"h1","props":{"lang":"zh"},"children":["刚确诊慢性病之后：头一周、头三个月和以后各做什么"]},{"tag":"p","props":{"lang":"zh"},"children":["刚确诊慢性病之后，按第一周、前三个月和病情稳定以后整理治疗、复查与日常生活。"]},{"tag":"a","props":{"className":"life-longread-chapter","href":"/book/16"},"children":["相关章节"," · ","得了慢性病之后怎么活",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M5 12h14"},"children":[]},{"tag":"path","props":{"d":"m12 5 7 7-7 7"},"children":[]}]}]}]},{"tag":"img","props":{"src":"/sites/howtolivebetter/images/book-chapters/16-chronic-care-editorial.webp","srcSet":"/sites/howtolivebetter/images/book-chapters/16-chronic-care-editorial-thumb.webp 600w, /sites/howtolivebetter/images/book-chapters/16-chronic-care-editorial-md.webp 900w, /sites/howtolivebetter/images/book-chapters/16-chronic-care-editorial.webp 1200w","sizes":"(max-width: 760px) 100vw, 450px","alt":"","width":"1200","height":"800","fetchPriority":"high"},"children":[]}]},{"tag":"div","props":{"className":"life-longread-layout"},"children":[{"tag":"aside","props":{"className":"life-longread-toc"},"children":[{"tag":"details","props":{"open":true},"children":[{"tag":"summary","props":{},"children":["本文目录"]},{"tag":"nav","props":{"aria-label":"本文目录"},"children":[{"tag":"a","props":{"href":"#确诊那一周"},"children":["确诊那一周"]},{"tag":"a","props":{"href":"#头三个月"},"children":["头三个月"]},{"tag":"a","props":{"href":"#病情稳定以后"},"children":["病情稳定以后"]}]}]}]},{"tag":"div","props":{"className":"life-longread-main"},"children":[{"tag":"article","props":{"className":"life-article-body","lang":"zh"},"children":[{"tag":"p","props":{},"children":["这份清单写给刚确诊高血压、糖尿病、高血脂、痛风这类慢性病的人。书里相关的条目分散在好几节，这里按时间先后排好。每一项只写该做的动作，后面跟着指路。为什么这么做、数字和出处，都在被指的那一条里。跟你的病对不上的项，跳过就行。"]},"\n",{"tag":"h2","props":{"id":"确诊那一周"},"children":["确诊那一周"]},"\n",{"tag":"ol","props":{},"children":["\n",{"tag":"li","props":{},"children":["病比较重的，拿报告那天找个人陪你去，回家别一个人待着。辞职、卖房这类事往后放。见",{"tag":"a","props":{"href":"/book/29#29-02","title":"被告知重病诊断的那一周，别一个人去拿报告，治疗以外的决定往后放"},"children":["第 29 节第 2 条"]},"（被告知重病诊断的那一周）。"]},"\n",{"tag":"li","props":{},"children":["医生让吃药，就从今天开始按医嘱吃，感觉好了也别停。见",{"tag":"a","props":{"href":"/book/16#16-01","title":"药按医嘱吃满，别感觉好了就停"},"children":["第 16 节第 1 条"]},"（药按医嘱吃满）。"]},"\n",{"tag":"li","props":{},"children":["高血压、高血脂的药要规律吃，别自己停。见",{"tag":"a","props":{"href":"/book/02#02-12","title":"有高血压、高血脂就按医嘱规律吃药，别自行停"},"children":["第 2 节第 12 条"]},"（有高血压、高血脂就按医嘱规律吃药）。"]},"\n",{"tag":"li","props":{},"children":["高血压的人买个电子血压计，在家量，降到达标为止。见",{"tag":"a","props":{"href":"/book/01#01-07","title":"量血压，高了就吃药降到达标"},"children":["第 1 节第 7 条"]},"（量血压，高了就吃药降到达标）。"]},"\n",{"tag":"li","props":{},"children":["开药的时候问医生，有没有集采的、通用名的药。见",{"tag":"a","props":{"href":"/book/05#05-12","title":"优先选通过一致性评价的仿制药和集采中选药"},"children":["第 5 节第 12 条"]},"（一致性评价的仿制药和集采中选药）。"]},"\n",{"tag":"li","props":{},"children":["确诊 2 型糖尿病，当时就去查一次散瞳眼底。1 型糖尿病从发病 5 年后开始查。见",{"tag":"a","props":{"href":"/book/16#16-07","title":"确诊糖尿病就去查一次眼底，之后按医生给的间隔查；每年查一次脚"},"children":["第 16 节第 7 条"]},"（确诊糖尿病就去查一次眼底）。"]},"\n",{"tag":"li","props":{},"children":["确诊痛风，就开始长期吃降尿酸药，把血尿酸压到 360 µmol/L 以下。见",{"tag":"a","props":{"href":"/book/16#16-09","title":"确诊痛风就长期吃降尿酸药，把血尿酸压到 360 µmol/L 以下并一直维持"},"children":["第 16 节第 9 条"]},"（确诊痛风就长期吃降尿酸药）。"]},"\n",{"tag":"li","props":{},"children":["汉族人用别嘌醇之前，问医生要不要先查 HLA-B*5801 这个基因型。见",{"tag":"a","props":{"href":"/book/16#16-09","title":"确诊痛风就长期吃降尿酸药，把血尿酸压到 360 µmol/L 以下并一直维持"},"children":["第 16 节第 9 条"]},"（确诊痛风就长期吃降尿酸药）。"]},"\n",{"tag":"li","props":{},"children":["体检只查出尿酸高、从来没痛过的，不算痛风，先别吃降尿酸药。见",{"tag":"a","props":{"href":"/book/06#06-19","title":"不要因为体检查出尿酸高、但从没痛过，就开始吃降尿酸药"},"children":["第 6 节第 19 条"]},"（体检查出尿酸高、但从没痛过）。"]},"\n",{"tag":"li","props":{},"children":["抽烟的人，定一个戒烟日，到那天一次停掉。见",{"tag":"a","props":{"href":"/book/02#02-04","title":"定一个戒烟日，到那天一次停掉，别先慢慢减"},"children":["第 2 节第 4 条"]},"（定一个戒烟日）。"]},"\n",{"tag":"li","props":{},"children":["戒烟别光靠忍，去戒烟门诊或者呼吸内科拿药。见",{"tag":"a","props":{"href":"/book/02#02-03","title":"戒烟别光靠忍，先去拿药：成功率能翻一倍多"},"children":["第 2 节第 3 条"]},"（戒烟别光靠忍，先去拿药）。"]},"\n"]},"\n",{"tag":"h2","props":{"id":"头三个月"},"children":["头三个月"]},"\n",{"tag":"ol","props":{},"children":["\n",{"tag":"li","props":{},"children":["准备一个本子。每次复查记下日期、指标、在吃的药和剂量。见",{"tag":"a","props":{"href":"/book/16#16-03","title":"复查按医生给的间隔做，把每次的指标记在同一个本子上"},"children":["第 16 节第 3 条"]},"（把每次的指标记在同一个本子上）。"]},"\n",{"tag":"li","props":{},"children":["每次看完病，把病历、化验单和影像自己存一份。见",{"tag":"a","props":{"href":"/book/24#24-05","title":"每次看完病，把病历、检查报告和影像自己存一份"},"children":["第 24 节第 5 条"]},"（病历、检查报告和影像自己存一份）。"]},"\n",{"tag":"li","props":{},"children":["在参保地办门诊慢特病认定。常去外地看病的，再办异地就医备案。见",{"tag":"a","props":{"href":"/book/16#16-02","title":"先办门诊慢特病认定再办异地备案，高血压、糖尿病、放化疗、透析、抗排异就能异地直接结算"},"children":["第 16 节第 2 条"]},"（先办门诊慢特病认定再办异地备案）。"]},"\n",{"tag":"li","props":{},"children":["家里人有职工医保的，请他办一次家庭共济绑定。他个人账户的钱就能给你看病买药。见",{"tag":"a","props":{"href":"/book/05#05-13","title":"在医保 App 上办一次家庭共济绑定，职工医保个人账户的钱就能给配偶、父母、子女看病买药"},"children":["第 5 节第 13 条"]},"（家庭共济绑定）。"]},"\n",{"tag":"li","props":{},"children":["在社区签家庭医生之前，先问清哪些进医保、哪些自费。见",{"tag":"a","props":{"href":"/book/16#16-06","title":"在社区签家庭医生之前，问清楚哪些进医保、哪些自费"},"children":["第 16 节第 6 条"]},"（签家庭医生之前问清楚）。"]},"\n",{"tag":"li","props":{},"children":["家里的盐换成低钠盐。肾功能不全、在吃保钾类药的人，先问医生。见",{"tag":"a","props":{"href":"/book/02#02-09","title":"把家里的食盐换成低钠盐（钾盐）"},"children":["第 2 节第 9 条"]},"（把家里的食盐换成低钠盐）。"]},"\n",{"tag":"li","props":{},"children":["开始每天走路。目标是 7000–8000 步，或者每周累计快走 150–300 分钟。见",{"tag":"a","props":{"href":"/book/02#02-11","title":"每天走到 7000–8000 步，或者每周累计快走 150–300 分钟"},"children":["第 2 节第 11 条"]},"（每天走到 7000–8000 步）。"]},"\n",{"tag":"li","props":{},"children":["少喝酒，能不喝就不喝。见",{"tag":"a","props":{"href":"/book/02#02-19","title":"少喝或不喝酒"},"children":["第 2 节第 19 条"]},"（少喝或不喝酒）。"]},"\n",{"tag":"li","props":{},"children":["每天都喝、一停就手抖心慌的人，别自己硬戒，先去医院。见",{"tag":"a","props":{"href":"/book/02#02-20","title":"每天都喝酒、一停就手抖心慌的人，别自己硬戒"},"children":["第 2 节第 20 条"]},"（一停就手抖心慌的人，别自己硬戒）。"]},"\n",{"tag":"li","props":{},"children":["有人劝你停药试偏方，别停。想吃补充剂，先告诉主治医生。见",{"tag":"a","props":{"href":"/book/16#16-04","title":"别为了试偏方、保健品停掉正规治疗"},"children":["第 16 节第 4 条"]},"（别为了试偏方、保健品停掉正规治疗）。"]},"\n",{"tag":"li","props":{},"children":["别花大钱买保健品、膏方来「调理身体」。见",{"tag":"a","props":{"href":"/book/06#06-10","title":"不要花大钱买保健品、膏方、滋补品来「调理身体」"},"children":["第 6 节第 10 条"]},"（不要花大钱买保健品、膏方、滋补品）。"]},"\n",{"tag":"li","props":{},"children":["痛风刚开始降尿酸，头 3 到 6 个月更容易发作。疼了按医嘱加抗炎药，别停降尿酸药。见",{"tag":"a","props":{"href":"/book/16#16-09","title":"确诊痛风就长期吃降尿酸药，把血尿酸压到 360 µmol/L 以下并一直维持"},"children":["第 16 节第 9 条"]},"（确诊痛风就长期吃降尿酸药）。"]},"\n",{"tag":"li","props":{},"children":["自己买感冒药、止痛药之前先看成分表，对乙酰氨基酚只能占一种。见",{"tag":"a","props":{"href":"/book/34#34-01","title":"同时吃两种感冒药或止痛药之前，先看成分表，对乙酰氨基酚只能占一种"},"children":["第 34 节第 1 条"]},"（先看成分表，对乙酰氨基酚只能占一种）。"]},"\n",{"tag":"li","props":{},"children":["在吃抗凝药或激素的人，吃布洛芬这类止痛药之前先问医生。见",{"tag":"a","props":{"href":"/book/34#34-03","title":"60 岁以上、胃出过血、在吃抗凝药或激素的人，吃布洛芬这类止痛药之前先问医生"},"children":["第 34 节第 3 条"]},"（吃布洛芬这类止痛药之前先问医生）。"]},"\n"]},"\n",{"tag":"h2","props":{"id":"病情稳定以后"},"children":["病情稳定以后"]},"\n",{"tag":"ol","props":{},"children":["\n",{"tag":"li","props":{},"children":["病情稳定、药也没换的，去社区一次开够 12 周的药。见",{"tag":"a","props":{"href":"/book/16#16-05","title":"病情稳定的慢性病，在社区医院一次可以开到 12 周的药"},"children":["第 16 节第 5 条"]},"（在社区医院一次可以开到 12 周的药）。"]},"\n",{"tag":"li","props":{},"children":["复查按医生给的间隔去，每次都记进同一个本子。见",{"tag":"a","props":{"href":"/book/16#16-03","title":"复查按医生给的间隔做，把每次的指标记在同一个本子上"},"children":["第 16 节第 3 条"]},"（复查按医生给的间隔做）。"]},"\n",{"tag":"li","props":{},"children":["换成集采药以后，盯住本子上的指标。真变差了去找医生，别自己停药。见",{"tag":"a","props":{"href":"/book/05#05-12","title":"优先选通过一致性评价的仿制药和集采中选药"},"children":["第 5 节第 12 条"]},"（优先选通过一致性评价的仿制药和集采中选药）。"]},"\n",{"tag":"li","props":{},"children":["糖尿病的人每年查一次脚，眼底按医生给的间隔查。见",{"tag":"a","props":{"href":"/book/16#16-07","title":"确诊糖尿病就去查一次眼底，之后按医生给的间隔查；每年查一次脚"},"children":["第 16 节第 7 条"]},"（确诊糖尿病就去查一次眼底，每年查一次脚）。"]},"\n",{"tag":"li","props":{},"children":["痛风的人尿酸达标以后也接着吃药，不能停。见",{"tag":"a","props":{"href":"/book/16#16-09","title":"确诊痛风就长期吃降尿酸药，把血尿酸压到 360 µmol/L 以下并一直维持"},"children":["第 16 节第 9 条"]},"（确诊痛风就长期吃降尿酸药）。"]},"\n",{"tag":"li","props":{},"children":["得过肾结石的，每天喝水 2.5–3 升，盐降到 6 克以内。见",{"tag":"a","props":{"href":"/book/16#16-08","title":"得过肾结石就把水喝到每天 2.5–3 升，盐降到 6 克以内"},"children":["第 16 节第 8 条"]},"（得过肾结石就把水喝到每天 2.5–3 升）。"]},"\n",{"tag":"li","props":{},"children":["有心血管病的人，每年秋天打一针流感疫苗。见",{"tag":"a","props":{"href":"/book/01#01-20","title":"有心血管病的人和老年人每年打流感疫苗"},"children":["第 1 节第 20 条"]},"（有心血管病的人和老年人每年打流感疫苗）。"]},"\n",{"tag":"li","props":{},"children":["常见病先在社区看。要住院就经社区逐级转诊上去，住院起付线接着算。见",{"tag":"a","props":{"href":"/book/24#24-01","title":"常见病先在社区看，经基层逐级转诊上去，住院起付线接着算"},"children":["第 24 节第 1 条"]},"（常见病先在社区看，经基层逐级转诊）。"]},"\n",{"tag":"li","props":{},"children":["能在基层看完的病别往上跑。同一个参保地里，每往上一级，报销比例约低 10 个百分点。见",{"tag":"a","props":{"href":"/book/24#24-02","title":"同一个统筹地区（医保参保地）里，级别越低报销比例越高，差距约 10 个百分点"},"children":["第 24 节第 2 条"]},"（级别越低报销比例越高）。"]},"\n",{"tag":"li","props":{},"children":["要去大医院看专科，走社区转诊或者医院的转诊中心，别找号贩子。见",{"tag":"a","props":{"href":"/book/24#24-03","title":"要去大医院，走基层转诊或者医院的转诊中心，别找号贩子"},"children":["第 24 节第 3 条"]},"（走基层转诊或者医院的转诊中心）。"]},"\n",{"tag":"li","props":{},"children":["打算去外省看病的，出发前先在本地问一句，报回来的钱可能比在家少一截。见",{"tag":"a","props":{"href":"/book/24#24-04","title":"跨省异地就医之前先在本地问一句，必要性原则上要副主任医师以上评估"},"children":["第 24 节第 4 条"]},"（跨省异地就医之前先在本地问一句）。"]},"\n"]},"\n"]},{"tag":"footer","props":{"className":"life-article-attribution"},"children":[{"tag":"p","props":{},"children":["本文转载自《高性价比人生指南》开源仓库，保留原文表达与待核实标记，最新内容以原作者仓库为准。"]},{"tag":"a","props":{"href":"https://github.com/eternity4719/HowToLiveBetter/blob/33362aff50f97f413b22ddfcdb355d2a536a5700/docs/%E5%88%9A%E7%A1%AE%E8%AF%8A%E6%85%A2%E6%80%A7%E7%97%85%E4%B9%8B%E5%90%8E.md","target":"_blank","rel":"noopener noreferrer"},"children":["查看来源版本 · 33362af",{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"14","height":"14","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-external-link","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M15 3h6v6"},"children":[]},{"tag":"path","props":{"d":"M10 14 21 3"},"children":[]},{"tag":"path","props":{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"},"children":[]}]}]},{"tag":"span","props":{},"children":["导入日期：2026-10-11"]},{"tag":"p","props":{},"children":["文中的条目链接按本站收录版本的对应主题对齐；原文编号可能与当前条目编号不同。"]}]},{"tag":"div","props":{"className":"life-quick-share"},"children":[{"tag":"button","props":{"type":"button"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-copy","aria-hidden":"true"},"children":[{"tag":"rect","props":{"width":"14","height":"14","x":"8","y":"8","rx":"2","ry":"2"},"children":[]},{"tag":