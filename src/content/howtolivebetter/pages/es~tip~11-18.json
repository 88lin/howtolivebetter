.w3.org/2000/svg","width":"18","height":"18","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-up-right","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M7 7h10v10"},"children":[]},{"tag":"path","props":{"d":"M7 17 17 7"},"children":[]}]}]}]}]}]}]},{"tag":"main","props":{"className":"life-reader life-tip-layout"},"children":[{"tag":"aside","props":{"className":"life-reader-sidebar life-tip-sidebar"},"children":[{"tag":"a","props":{"className":"life-back-link","href":"/es/book/11"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"m12 19-7-7 7-7"},"children":[]},{"tag":"path","props":{"d":"M19 12H5"},"children":[]}]},"Volver al índice"]},{"tag":"div","props":{"className":"life-sidebar-caption"},"children":["Las líneas rojas que los programadores y los técnicos suelen pisar"]},{"tag":"div","props":{"data-ad-dock-host":"true"},"children":[]},{"tag":"nav","props":{"aria-label":"Consejos del capítulo"},"children":[{"tag":"a","props":{"href":"/es/tip/11-01"},"children":[{"tag":"span","props":{},"children":["01"]},"Antes de actuar, pregunta: ¿denunciarán el fabricante, la plataforma o la empresa? Si te investigan penalmente, busca enseguida un abogado penalista"]},{"tag":"a","props":{"href":"/es/tip/11-02"},"children":[{"tag":"span","props":{},"children":["02"]},"No crees ni vendas trampas o ayudas para videojuegos, incluidas las de IA que «solo leen la pantalla sin tocar la memoria», ni versiones modificadas que añadan funciones a aplicaciones como WeChat"]},{"tag":"a","props":{"href":"/es/tip/11-03"},"children":[{"tag":"span","props":{},"children":["03"]},"No escribas ni vendas scripts de reventa de entradas, compras relámpago, pedidos falsos ni aprovechamiento de promociones, aunque sea solo «apretar botones de forma automatizada»"]},{"tag":"a","props":{"href":"/es/tip/11-04"},"children":[{"tag":"span","props":{},"children":["04"]},"Los rastreadores solo rastrean páginas públicas que no piden inicio de sesión; sin saltarse el antirrastreo, sin tocar datos personales, y los datos rastreados no se venden"]},{"tag":"a","props":{"href":"/es/tip/11-05"},"children":[{"tag":"span","props":{},"children":["05"]},"No aceptes encargos de desarrollo de Apps de juego, estafa o pornografía, ni montes canales de pago ni desbloquees cuentas para el «cliente»"]},{"tag":"a","props":{"href":"/es/tip/11-06"},"children":[{"tag":"span","props":{},"children":["06"]},"Al irte de la empresa entrega todas las cuentas y permisos; no borres bases de datos, no dejes puertas traseras, no cambies contraseñas para dejar el sistema bloqueado, aunque la empresa te deba dinero"]},{"tag":"a","props":{"href":"/es/tip/11-07"},"children":[{"tag":"span","props":{},"children":["07"]},"Al irte no te lleves el código fuente, las listas de clientes ni la documentación técnica; no los subas a una nube personal y no los reutilices en el siguiente empleo"]},{"tag":"a","props":{"href":"/es/tip/11-08"},"children":[{"tag":"span","props":{},"children":["08"]},"No ejecutes tus programas en ordenadores, servidores o cámaras ajenos, ni uses las máquinas de la empresa para minar criptomonedas"]},{"tag":"a","props":{"href":"/es/tip/11-09"},"children":[{"tag":"span","props":{},"children":["09"]},"Sin autorización por escrito, no testes los sistemas ajenos; ni las «buenas intenciones» ni el «aviso posterior» son motivo para quedar fuera del delito"]},{"tag":"a","props":{"href":"/es/tip/11-10"},"children":[{"tag":"span","props":{},"children":["10"]},"Reporta las vulnerabilidades conforme a las normas; antes del parche, ni detalles públicos, ni herramientas de explotación, ni entrega al extranjero"]},{"tag":"a","props":{"href":"/es/tip/11-11"},"children":[{"tag":"span","props":{},"children":["11"]},"No vendas herramientas para saltar el bloqueo ni cuentas de VPN, ni montes nodos de ese tipo para otros"]},{"tag":"a","props":{"href":"/es/tip/11-12"},"children":[{"tag":"span","props":{},"children":["12"]},"Si firmaste un pacto de no competencia, reclámalo por escrito cuando la empresa no pague la compensación mensual tras tu salida; si pasan 3 meses sin pagar puedes rescindirlo; en un puesto sin contacto con secretos comerciales puedes pedir que se declare que la cláusula no surte efecto"]},{"tag":"a","props":{"href":"/es/tip/11-13"},"children":[{"tag":"span","props":{},"children":["13"]},"El código escrito en horario de trabajo y con recursos de la empresa es de la empresa; tus proyectos de código abierto hazlos con tu tiempo y tus equipos, y no mezcles código de la empresa"]},{"tag":"a","props":{"href":"/es/tip/11-14"},"children":[{"tag":"span","props":{},"children":["14"]},"El uso de código abierto como GPL para crear productos: es obligatorio abrir el código o cambiar la licencia según lo exija la licencia; no se puede alegar que «nadie se entera»"]},{"tag":"a","props":{"href":"/es/tip/11-15"},"children":[{"tag":"span","props":{},"children":["15"]},"Una App solo recoge los datos personales que el negocio necesita de verdad; los menores de 14 años necesitan el consentimiento del tutor; la política de privacidad se escribe con claridad"]},{"tag":"a","props":{"href":"/es/tip/11-16"},"children":[{"tag":"span","props":{},"children":["16"]},"Antes de lanzar un sitio web o app, hay que registrarlo en el sistema ICP y conservar los registros durante al menos 6 meses según los requisitos de protección de niveles"]},{"tag":"a","props":{"href":"/es/tip/11-17"},"children":[{"tag":"span","props":{},"children":["17"]},"Antes de ofrecer al público un servicio de IA generativa, haz la evaluación de seguridad y el registro de algoritmo conforme a las normas, y marca el contenido generado"]},{"tag":"a","props":{"aria-current":"page","className":"active","href":"/es/tip/11-18","data-status":"active"},"children":[{"tag":"span","props":{},"children":["18"]},"No crees ni distribuyas herramientas que omitan o bloqueen automáticamente anuncios de otras aplicaciones: aunque sean gratuitas y no se conecten a internet, pueden constituir competencia desleal"]},{"tag":"a","props":{"href":"/es/tip/11-19"},"children":[{"tag":"span","props":{},"children":["19"]},"No montes un «intermediario de IA» para revender a bajo precio interfaces de modelos extranjeros: un responsable en Shanghái ya ha sido detenido penalmente"]}]}]},{"tag":"div","props":{"className":"life-tip-page"},"children":[{"tag":"nav","props":{"className":"life-tip-breadcrumb","aria-label":"Ruta de navegación"},"children":[{"tag":"a","props":{"href":"/es/book"},"children":["Libro"]},{"tag":"span","props":{"aria-hidden":"true"},"children":["/"]},{"tag":"a","props":{"href":"/es/book/11"},"children":["Capítulo 11"," ·"," ","Las líneas rojas que los programadores y los técnicos suelen pisar"]}]},{"tag":"article","props":{"className":"life-entry-card status-unmarked is-standalone","id":"11-18"},"children":[{"tag":"div","props":{"className":"life-entry-top"},"children":[{"tag":"span","props":{"className":"life-entry-number"},"children":["18"]},{"tag":"span","props":{"className":"life-evidence grade-a"},"children":["Evidencia"," ","A"]}]},{"tag":"h1","props":{"lang":"es"},"children":["No crees ni distribuyas herramientas que omitan o bloqueen automáticamente anuncios de otras aplicaciones: aunque sean gratuitas y no se conecten a internet, pueden constituir competencia desleal"]},{"tag":"p","props":{"lang":"es","className":"life-entry-summary"},"children":["Crear software para que los usuarios omitan o bloqueen anuncios de otras aplicaciones puede generar demandas por competencia desleal. No cobrar no garantiza quedar fuera: la ley incluye como operadores a personas que prestan servicios. Un navegador que bloqueaba por defecto anuncios iniciales de Mango TV pagó 800.000 yuanes. Una aplicación que permitía saltar directamente su anuncio de apertura pagó 80.000 yuanes por daños."]},{"tag":"div","props":{"className":"life-entry-impact"},"children":[{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Coste"]},{"tag":"p","props":{},"children":["No cuesta dinero. El coste es renunciar a una pequeña herr…"]}]},{"tag":"div","props":{},"children":[{"tag":"span","props":{},"children":["Beneficio"]},{"tag":"p","props":{},"children":["La ley prohíbe a los operadores usar medios técnicos para obstaculizar o alterar el funcionamiento normal de p…"]}]}]},{"tag":"div","props":{"className":"life-entry-actions","aria-label":"Marcar: No crees ni distribuyas herramientas que omitan o bloqueen automáticamente anuncios de otras aplicaciones: aunque sean gratuitas y no se conecten a internet, pueden constituir competencia desleal"},"children":[{"tag":"button","props":{"type":"button","className":"life-action done","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check","aria-hidden":"true"},"children":[{"tag":"path","props":{"d":"M20 6 9 17l-5-5"},"children":[]}]},"Hecho"]},{"tag":"button","props":{"type":"button","className":"life-action todo","aria-pressed":"false"},"children":[{"tag":"svg","props":{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-list-todo","aria-hidden":"true"},"children":[{"tag":"rect","props":{"x":"3","y":"5","width":"6","height":"6","rx":"1"},"children":[]},{"tag":"path","props":{"d":"m3 17 2 2 4-4"},"children":[]},{"tag":"path","props":{"d":"